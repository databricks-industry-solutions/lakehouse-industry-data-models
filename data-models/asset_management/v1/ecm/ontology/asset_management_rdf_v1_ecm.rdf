ind:underlyingName rdf:type rdf:Property ;
    rdfs:label 'Underlying Name' ;
    rdfs:comment 'Human-readable name of the underlying reference entity, index, or asset for the derivative contract.' ;
    rdfs:domain ind:OtcDerivative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uniqueProductIdentifier rdf:type rdf:Property ;
    rdfs:label 'Unique Product Identifier' ;
