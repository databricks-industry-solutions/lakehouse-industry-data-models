ind:platform rdf:type rdf:Property ;
    rdfs:label 'Platform' ;
    rdfs:comment 'Platform used for validation (e.g., Databricks).' ;
    rdfs:domain ind:ModelValidation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Validation Duration Seconds' ;
    rdfs:comment 'Total duration of the validation in seconds.' ;
