ind:presentationCurrency rdf:type rdf:Property ;
    rdfs:label 'Presentation Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which composite performance is presented to clients and in marketing materials.' ;
    rdfs:domain ind:Composite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskProfile rdf:type rdf:Property ;
    rdfs:label 'Risk Profile' ;
    rdfs:comment 'Risk classification of the composite based on expected volatility, leverage, and investment characteristics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceCompositeMembershipId rdf:type rdf:Property ;
    rdfs:label 'Performance Composite Membership Id' ;
    rdfs:comment 'Unique identifier for the composite membership record tracking portfolio inclusion in a GIPS composite for a specific measurement period.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:compositeDefinitionVersion rdf:type rdf:Property ;
    rdfs:label 'Composite Definition Version' ;
    rdfs:comment 'Version identifier of the composite definition document in effect during this membership period, supporting audit trail and compliance.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Approval Date' ;
    rdfs:comment 'The date on which the portfolios exclusion from the composite was formally approved by the investment committee or compliance team.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Exclusion Approved By' ;
    rdfs:comment 'Name or identifier of the individual or committee that approved the portfolios exclusion from the composite.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Approval Date' ;
    rdfs:comment 'The date on which the portfolios inclusion in the composite was formally approved by the investment committee or compliance team.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inclusionApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Inclusion Approved By' ;
    rdfs:comment 'Name or identifier of the individual or committee that approved the portfolios inclusion in the composite.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion End Date' ;
    rdfs:comment 'The date on which the portfolio was removed from the composite. Null if the portfolio remains an active member.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Start Date' ;
    rdfs:comment 'The date on which the portfolio was first included in the composite for performance measurement purposes.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumPortfolioSizeThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Portfolio Size Threshold' ;
    rdfs:comment 'The minimum NAV threshold required for a portfolio to be eligible for inclusion in the composite.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioNavAtExclusion rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav At Exclusion' ;
    rdfs:comment 'The portfolios net asset value at the time of exclusion from the composite, used for final weighting calculations.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioNavAtInclusion rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav At Inclusion' ;
    rdfs:comment 'The portfolios net asset value at the time of inclusion in the composite, used for weighting and size-based eligibility checks.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Portfolio Termination Date' ;
    rdfs:comment 'The date the portfolio was closed or terminated, marking the end of its lifecycle and composite membership.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordCurrentFlag rdf:type rdf:Property ;
    rdfs:label 'Record Current Flag' ;
    rdfs:comment 'Indicates whether this is the current active version of the composite membership record, supporting Type 2 slowly changing dimension logic.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordEffectiveFromTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Effective From Timestamp' ;
    rdfs:comment 'The timestamp from which this version of the composite membership record is effective, supporting temporal queries and historical analysis.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordEffectiveToTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Effective To Timestamp' ;
    rdfs:comment 'The timestamp until which this version of the composite membership record is effective. Null indicates the current active version.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:significantCashFlowThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Significant Cash Flow Threshold Pct' ;
    rdfs:comment 'The percentage threshold used to determine significant cash flows that trigger temporary exclusion from the composite.' ;
    rdfs:domain ind:PerformanceCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:blendComposition rdf:type rdf:Property ;
    rdfs:label 'Blend Composition' ;
    rdfs:comment 'Detailed description of the component benchmarks and their weights if this is a custom blended benchmark.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constituentCount rdf:type rdf:Property ;
    rdfs:label 'Constituent Count' ;
    rdfs:comment 'Number of securities or components included in the benchmark index.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:customBlendFlag rdf:type rdf:Property ;
    rdfs:label 'Custom Blend Flag' ;
    rdfs:comment 'Indicates whether the benchmark is a custom blended benchmark created internally rather than a standard market index.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataFeedFrequency rdf:type rdf:Property ;
    rdfs:label 'Data Feed Frequency' ;
    rdfs:comment 'Frequency at which benchmark data is updated from the source system.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceBenchmarkDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Benchmark Description' ;
    rdfs:comment 'Detailed narrative description of the benchmark, its construction methodology, and its intended use in performance measurement.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexTicker rdf:type rdf:Property ;
    rdfs:label 'Index Ticker' ;
    rdfs:comment 'Standard ticker or symbol used to identify the benchmark in market data systems.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodologyDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Methodology Document Reference' ;
    rdfs:comment 'Reference to the official methodology document or URL that describes the benchmark construction and maintenance rules.' ;
    rdfs:domain ind:PerformanceBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkReturnId rdf:type rdf:Property ;
    rdfs:label 'Benchmark Return Id' ;
    rdfs:comment 'Unique identifier for the benchmark return record. Primary key for this transactional performance measurement entity.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualizedReturn rdf:type rdf:Property ;
    rdfs:label 'Annualized Return' ;
    rdfs:comment 'The benchmark return annualized for periods longer or shorter than one year, expressed as a decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkVersion rdf:type rdf:Property ;
    rdfs:label 'Benchmark Version' ;
    rdfs:comment 'The version or vintage of the benchmark index used for this return calculation, capturing any index reconstitutions or methodology changes.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalGainAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Gain Amount' ;
    rdfs:comment 'The absolute capital appreciation or depreciation of the benchmark during the period, in base currency.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeReturn rdf:type rdf:Property ;
    rdfs:label 'Cumulative Return' ;
    rdfs:comment 'The cumulative return of the benchmark from inception or a specified start date to the period end, expressed as a decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyAdjustedReturn rdf:type rdf:Property ;
    rdfs:label 'Currency Adjusted Return' ;
    rdfs:comment 'The benchmark return adjusted for foreign exchange (FX) movements to reflect returns in the fund\'s base currency.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossReturn rdf:type rdf:Property ;
    rdfs:label 'Gross Return' ;
    rdfs:comment 'The benchmark return before deduction of any fees or expenses, expressed as a decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxDrawdown rdf:type rdf:Property ;
    rdfs:label 'Max Drawdown' ;
    rdfs:comment 'The largest peak-to-trough decline in the benchmark value during the measurement period, expressed as a negative decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netReturn rdf:type rdf:Property ;
    rdfs:label 'Net Return' ;
    rdfs:comment 'The benchmark return after deduction of applicable fees and expenses, expressed as a decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceReturn rdf:type rdf:Property ;
    rdfs:label 'Price Return' ;
    rdfs:comment 'The price-only return component of the benchmark, excluding income distributions, expressed as a decimal.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restatementReason rdf:type rdf:Property ;
    rdfs:label 'Restatement Reason' ;
    rdfs:comment 'Explanation for why the benchmark return was restated, if applicable.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Return Period End Date' ;
    rdfs:comment 'The end date of the measurement period for this benchmark return calculation.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Return Period Start Date' ;
    rdfs:comment 'The start date of the measurement period for this benchmark return calculation.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalReturn rdf:type rdf:Property ;
    rdfs:label 'Total Return' ;
    rdfs:comment 'The total return of the benchmark for the period, expressed as a decimal (e.g., 0.0523 for 5.23%). Includes price appreciation and income.' ;
    rdfs:domain ind:BenchmarkReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionResultId rdf:type rdf:Property ;
    rdfs:label 'Attribution Result Id' ;
    rdfs:comment 'Unique identifier for the performance attribution result record.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attributionModelId rdf:type rdf:Property ;
    rdfs:label 'Attribution Model Id' ;
    rdfs:comment 'Foreign key linking to performance.attribution_model. Business justification: Each attribution result is generated by a specific attribution model; linking ensures referential integrity and eliminates redundant string column.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AttributionModel .

ind:activeReturnPct rdf:type rdf:Property ;
    rdfs:label 'Active Return Pct' ;
    rdfs:comment 'Difference between portfolio return and benchmark return, representing total outperformance or underperformance.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEffectPct rdf:type rdf:Property ;
    rdfs:label 'Allocation Effect Pct' ;
    rdfs:comment 'Attribution effect from portfolio weight decisions relative to benchmark weights, measured in percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionLevel rdf:type rdf:Property ;
    rdfs:label 'Attribution Level' ;
    rdfs:comment 'The hierarchical level at which attribution effects are measured.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageMarketValue rdf:type rdf:Property ;
    rdfs:label 'Average Market Value' ;
    rdfs:comment 'Time-weighted average market value of the portfolio segment during the measurement period, in base currency.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkReturnPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Return Pct' ;
    rdfs:comment 'Total return of the benchmark for the measurement period, expressed as a percentage.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkSegmentReturnPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Segment Return Pct' ;
    rdfs:comment 'Return of this specific segment within the benchmark for the measurement period.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkWeightPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight Pct' ;
    rdfs:comment 'Average weight of this segment in the benchmark during the measurement period, expressed as a percentage.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationVersion rdf:type rdf:Property ;
    rdfs:label 'Calculation Version' ;
    rdfs:comment 'Version identifier of the attribution calculation engine or methodology used.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyEffectPct rdf:type rdf:Property ;
    rdfs:label 'Currency Effect Pct' ;
    rdfs:comment 'Attribution effect from foreign exchange movements on non-base currency holdings, measured in percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionEffectPct rdf:type rdf:Property ;
    rdfs:label 'Interaction Effect Pct' ;
    rdfs:comment 'Attribution effect from the interaction between allocation and selection decisions, measured in percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioReturnPct rdf:type rdf:Property ;
    rdfs:label 'Portfolio Return Pct' ;
    rdfs:comment 'Total return of the portfolio for the measurement period, expressed as a percentage.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioSegmentReturnPct rdf:type rdf:Property ;
    rdfs:label 'Portfolio Segment Return Pct' ;
    rdfs:comment 'Return of this specific segment within the portfolio for the measurement period.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedFlag rdf:type rdf:Property ;
    rdfs:label 'Published Flag' ;
    rdfs:comment 'Indicates whether this attribution result has been published to external stakeholders or beneficiaries.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segmentCode rdf:type rdf:Property ;
    rdfs:label 'Segment Code' ;
    rdfs:comment 'Standardized code identifying the segment or classification dimension.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentName rdf:type rdf:Property ;
    rdfs:label 'Segment Name' ;
    rdfs:comment 'Name of the portfolio segment or classification dimension for this attribution result.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentReturnDifferencePct rdf:type rdf:Property ;
    rdfs:label 'Segment Return Difference Pct' ;
    rdfs:comment 'Difference between portfolio segment return and benchmark segment return, expressed as percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selectionEffectPct rdf:type rdf:Property ;
    rdfs:label 'Selection Effect Pct' ;
    rdfs:comment 'Attribution effect from security selection decisions within each segment, measured in percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationMessage rdf:type rdf:Property ;
    rdfs:label 'Validation Message' ;
    rdfs:comment 'Detailed message describing validation findings, warnings, or errors for this attribution result.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightDifferencePct rdf:type rdf:Property ;
    rdfs:label 'Weight Difference Pct' ;
    rdfs:comment 'Difference between portfolio weight and benchmark weight for this segment, expressed as percentage points.' ;
    rdfs:domain ind:AttributionResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionSegmentId rdf:type rdf:Property ;
    rdfs:label 'Attribution Segment Id' ;
    rdfs:comment 'Unique identifier for the attribution segment record within a performance attribution run.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentSegmentAttributionSegmentId rdf:type rdf:Property ;
    rdfs:label 'Parent Segment Attribution Segment Id' ;
    rdfs:comment 'Reference to the parent segment in hierarchical attribution analysis, null for top-level segments.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AttributionSegment .

ind:activeReturn rdf:type rdf:Property ;
    rdfs:label 'Active Return' ;
    rdfs:comment 'The difference between portfolio return and benchmark return for this segment, expressed as a decimal fraction (portfolio return minus benchmark return).' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeWeight rdf:type rdf:Property ;
    rdfs:label 'Active Weight' ;
    rdfs:comment 'The difference between portfolio weight and benchmark weight for this segment, expressed as a decimal fraction (portfolio weight minus benchmark weight).' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationEffect rdf:type rdf:Property ;
    rdfs:label 'Allocation Effect' ;
    rdfs:comment 'The attribution effect resulting from differences in portfolio weight versus benchmark weight for this segment, expressed in basis points contribution to total portfolio return.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionMethod rdf:type rdf:Property ;
    rdfs:label 'Attribution Method' ;
    rdfs:comment 'The mathematical methodology used to calculate attribution effects for this segment (e.g., Brinson, Brinson-Fachler, Brinson-Hood-Beebower, Carino smoothing, or geometric linking).' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkWeightAverage rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight Average' ;
    rdfs:comment 'The average weight of this segment in the benchmark over the attribution period, typically calculated using daily or monthly averaging.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkWeightBegin rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight Begin' ;
    rdfs:comment 'The weight of this segment in the benchmark at the beginning of the attribution period, expressed as a decimal fraction of total benchmark value.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkWeightEnd rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight End' ;
    rdfs:comment 'The weight of this segment in the benchmark at the end of the attribution period, expressed as a decimal fraction of total benchmark value.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationRunIdentifier rdf:type rdf:Property ;
    rdfs:label 'Calculation Run Identifier' ;
    rdfs:comment 'The unique batch or run identifier from the source performance system that generated this attribution segment.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyEffect rdf:type rdf:Property ;
    rdfs:label 'Currency Effect' ;
    rdfs:comment 'The attribution effect resulting from currency movements and hedging decisions for this segment, expressed in basis points contribution to total portfolio return.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:informationRatioContribution rdf:type rdf:Property ;
    rdfs:label 'Information Ratio Contribution' ;
    rdfs:comment 'The contribution of this segment to the overall portfolio information ratio, calculated as active return divided by tracking error contribution.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionEffect rdf:type rdf:Property ;
    rdfs:label 'Interaction Effect' ;
    rdfs:comment 'The attribution effect resulting from the interaction between allocation and selection decisions, expressed in basis points contribution to total portfolio return.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isSyntheticSegment rdf:type rdf:Property ;
    rdfs:label 'Is Synthetic Segment' ;
    rdfs:comment 'Flag indicating whether this segment is a synthetic or derived segment created for analytical purposes rather than a natural portfolio grouping.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:localReturn rdf:type rdf:Property ;
    rdfs:label 'Local Return' ;
    rdfs:comment 'The return of the portfolio segment in local currency terms before currency translation effects, expressed as a decimal fraction.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodType rdf:type rdf:Property ;
    rdfs:label 'Period Type' ;
    rdfs:comment 'The frequency or type of the attribution period (daily, weekly, monthly, quarterly, annual, or custom date range).' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Portfolio Return' ;
    rdfs:comment 'The total return of the portfolio segment over the attribution period, expressed as a decimal fraction (e.g., 0.0523 for 5.23% return).' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioWeightAverage rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight Average' ;
    rdfs:comment 'The average weight of this segment in the portfolio over the attribution period, typically calculated using daily or monthly averaging.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioWeightBegin rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight Begin' ;
    rdfs:comment 'The weight of this segment in the portfolio at the beginning of the attribution period, expressed as a decimal fraction of total portfolio value.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioWeightEnd rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight End' ;
    rdfs:comment 'The weight of this segment in the portfolio at the end of the attribution period, expressed as a decimal fraction of total portfolio value.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:securityCountBenchmark rdf:type rdf:Property ;
    rdfs:label 'Security Count Benchmark' ;
    rdfs:comment 'The number of individual securities in the benchmark within this attribution segment.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:securityCountPortfolio rdf:type rdf:Property ;
    rdfs:label 'Security Count Portfolio' ;
    rdfs:comment 'The number of individual securities held in the portfolio within this attribution segment.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:segmentDimensionType rdf:type rdf:Property ;
    rdfs:label 'Segment Dimension Type' ;
    rdfs:comment 'The classification dimension by which this attribution segment is defined (e.g., sector, geography, asset class, factor, currency pair, or individual security).' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentDimensionValue rdf:type rdf:Property ;
    rdfs:label 'Segment Dimension Value' ;
    rdfs:comment 'The specific value within the dimension type (e.g., Technology for sector, North America for geography, Equities for asset class).' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentLevel rdf:type rdf:Property ;
    rdfs:label 'Segment Level' ;
    rdfs:comment 'The hierarchical level of this segment within the attribution tree structure, where 1 is top-level and higher numbers represent deeper drill-down levels.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:segmentMarketValueBegin rdf:type rdf:Property ;
    rdfs:label 'Segment Market Value Begin' ;
    rdfs:comment 'The market value of the portfolio segment at the beginning of the attribution period in base currency.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentMarketValueEnd rdf:type rdf:Property ;
    rdfs:label 'Segment Market Value End' ;
    rdfs:comment 'The market value of the portfolio segment at the end of the attribution period in base currency.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:segmentNetFlows rdf:type rdf:Property ;
    rdfs:label 'Segment Net Flows' ;
    rdfs:comment 'The net cash flows (contributions minus distributions) for this segment during the attribution period in base currency.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selectionEffect rdf:type rdf:Property ;
    rdfs:label 'Selection Effect' ;
    rdfs:comment 'The attribution effect resulting from differences in security selection or return within this segment versus the benchmark, expressed in basis points contribution to total portfolio return.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEffect rdf:type rdf:Property ;
    rdfs:label 'Total Effect' ;
    rdfs:comment 'The sum of allocation, selection, and interaction effects for this segment, representing the total contribution to excess return versus benchmark.' ;
    rdfs:domain ind:AttributionSegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingReturnId rdf:type rdf:Property ;
    rdfs:label 'Holding Return Id' ;
    rdfs:comment 'Unique identifier for the holding return record. Primary key for position-level return measurement within a portfolio for a specific period.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:attributionAllocationEffect rdf:type rdf:Property ;
    rdfs:label 'Attribution Allocation Effect' ;
    rdfs:comment 'Performance attribution effect from asset allocation decisions relative to benchmark weights.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionInteractionEffect rdf:type rdf:Property ;
    rdfs:label 'Attribution Interaction Effect' ;
    rdfs:comment 'Performance attribution interaction effect between allocation and selection decisions.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionSelectionEffect rdf:type rdf:Property ;
    rdfs:label 'Attribution Selection Effect' ;
    rdfs:comment 'Performance attribution effect from security selection decisions within asset classes.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginningPrice rdf:type rdf:Property ;
    rdfs:label 'Beginning Price' ;
    rdfs:comment 'Unit price or market price of the security at the start of the measurement period.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beginningQuantity rdf:type rdf:Property ;
    rdfs:label 'Beginning Quantity' ;
    rdfs:comment 'Quantity of units or shares held at the start of the measurement period.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionToPortfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Contribution To Portfolio Return' ;
    rdfs:comment 'The holdings contribution to the overall portfolio return, calculated as weight times return.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingPrice rdf:type rdf:Property ;
    rdfs:label 'Ending Price' ;
    rdfs:comment 'Unit price or market price of the security at the end of the measurement period.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endingQuantity rdf:type rdf:Property ;
    rdfs:label 'Ending Quantity' ;
    rdfs:comment 'Quantity of units or shares held at the end of the measurement period.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:excessReturn rdf:type rdf:Property ;
    rdfs:label 'Excess Return' ;
    rdfs:comment 'Holding return minus benchmark return, representing outperformance or underperformance.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxGainLoss rdf:type rdf:Property ;
    rdfs:label 'Fx Gain Loss' ;
    rdfs:comment 'Gain or loss attributable to foreign exchange rate movements during the period.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End Date' ;
    rdfs:comment 'Ending date of the return measurement period for this holding position.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start Date' ;
    rdfs:comment 'Beginning date of the return measurement period for this holding position.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Total Return Amount' ;
    rdfs:comment 'Absolute total return in currency units, combining income, realized and unrealized gains/losses.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Total Return Percent' ;
    rdfs:comment 'Total return expressed as a percentage of beginning market value.' ;
    rdfs:domain ind:HoldingReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:twr rdf:type rdf:Property ;
    rdfs:label 'Twr' ;
    rdfs:comment 'Time-weighted return for the holding, eliminating the impact of cash flows to measure investment performance.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privateAssetIrrId rdf:type rdf:Property ;
    rdfs:label 'Private Asset Irr Id' ;
    rdfs:comment 'Unique identifier for the private asset IRR calculation record.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkIrr rdf:type rdf:Property ;
    rdfs:label 'Benchmark Irr' ;
    rdfs:comment 'The IRR of the relevant benchmark or peer group for the same period, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:excessIrr rdf:type rdf:Property ;
    rdfs:label 'Excess Irr' ;
    rdfs:comment 'The difference between the investment IRR and the benchmark IRR, expressed as a decimal.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irr1Year rdf:type rdf:Property ;
    rdfs:label 'Irr 1 Year' ;
    rdfs:comment 'Annualized internal rate of return for the trailing 1-year period, expressed as a decimal.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irr3Year rdf:type rdf:Property ;
    rdfs:label 'Irr 3 Year' ;
    rdfs:comment 'Annualized internal rate of return for the trailing 3-year period, expressed as a decimal.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irr5Year rdf:type rdf:Property ;
    rdfs:label 'Irr 5 Year' ;
    rdfs:comment 'Annualized internal rate of return for the trailing 5-year period, expressed as a decimal.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jCurveStatus rdf:type rdf:Property ;
    rdfs:label 'J Curve Status' ;
    rdfs:comment 'The lifecycle stage of the investment relative to the typical J-curve pattern of private equity returns.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceStatus rdf:type rdf:Property ;
    rdfs:label 'Performance Status' ;
    rdfs:comment 'The status of this IRR calculation indicating whether it is final, preliminary, or subject to revision.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualValue rdf:type rdf:Property ;
    rdfs:label 'Residual Value' ;
    rdfs:comment 'Current unrealized (mark-to-market) value of the investment, in base currency.' ;
    rdfs:domain ind:PrivateAssetIrr ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowRecordId rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Record Id' ;
    rdfs:comment 'Unique identifier for the cash flow record. Primary key.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cashCapitalCallNoticeId rdf:type rdf:Property ;
    rdfs:label 'Cash Capital Call Notice Id' ;
    rdfs:comment 'Identifier of the capital call notice from the General Partner, applicable for private market drawdowns.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Notice .

ind:cashDistributionNoticeId rdf:type rdf:Property ;
    rdfs:label 'Cash Distribution Notice Id' ;
    rdfs:comment 'Identifier of the distribution notice from the General Partner, applicable for private market distributions.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Notice .

ind:originalCashFlowRecordId rdf:type rdf:Property ;
    rdfs:label 'Original Cash Flow Record Id' ;
    rdfs:comment 'Reference to the original cash flow record if this is a reversal or correction entry.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashFlowRecord .

ind:accountingDate rdf:type rdf:Property ;
    rdfs:label 'Accounting Date' ;
    rdfs:comment 'The date on which the cash flow is recognized in the accounting books, which may differ from cash flow date for accrual accounting.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bookingStatus rdf:type rdf:Property ;
    rdfs:label 'Booking Status' ;
    rdfs:comment 'Current status of the cash flow in the accounting system: pending settlement, booked, cancelled, or reversed.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashFlowDate rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Date' ;
    rdfs:comment 'The actual date on which the cash flow occurred or was settled.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cashFlowDirection rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Direction' ;
    rdfs:comment 'Indicates whether the cash flow is an inflow (receipt) or outflow (payment) from the portfolio perspective.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLargeCashFlow rdf:type rdf:Property ;
    rdfs:label 'Is Large Cash Flow' ;
    rdfs:comment 'Indicates whether the cash flow exceeds the threshold for large cash flow treatment under GIPS standards, requiring special performance calculation handling.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRealizedGain rdf:type rdf:Property ;
    rdfs:label 'Is Realized Gain' ;
    rdfs:comment 'Indicates whether the distribution includes realized capital gains from asset sales.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecallable rdf:type rdf:Property ;
    rdfs:label 'Is Recallable' ;
    rdfs:comment 'Indicates whether a distribution is subject to potential recall by the General Partner under the Limited Partnership Agreement.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReturnOfCapital rdf:type rdf:Property ;
    rdfs:label 'Is Return Of Capital' ;
    rdfs:comment 'Indicates whether the distribution represents a return of invested capital rather than income or gain.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:largeCashFlowThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Large Cash Flow Threshold Pct' ;
    rdfs:comment 'The percentage threshold of portfolio Net Asset Value (NAV) used to determine large cash flow classification.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceAttributionDate rdf:type rdf:Property ;
    rdfs:label 'Performance Attribution Date' ;
    rdfs:comment 'The date used for performance attribution and Money-Weighted Return (MWR) / Internal Rate of Return (IRR) calculations.' ;
    rdfs:domain ind:CashFlowRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemTimestamp rdf:type rdf:Property ;
    rdfs:label 'Source System Timestamp' ;
    rdfs:comment 'The timestamp when the cash flow record was created or last updated in the source system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pborSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Pbor Snapshot Id' ;
    rdfs:comment 'Unique identifier for the PBOR snapshot record. Primary key.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:custodyFee rdf:type rdf:Property ;
    rdfs:label 'Custody Fee' ;
    rdfs:comment 'Custodian and fund administration fees charged during the period.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dividendIncome rdf:type rdf:Property ;
    rdfs:label 'Dividend Income' ;
    rdfs:comment 'Dividend income received from equity holdings during the period.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossContributions rdf:type rdf:Property ;
    rdfs:label 'Gross Contributions' ;
    rdfs:comment 'Total cash and asset contributions received into the portfolio during the period.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossDistributions rdf:type rdf:Property ;
    rdfs:label 'Gross Distributions' ;
    rdfs:comment 'Total cash and asset distributions paid out from the portfolio during the period.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeEarned rdf:type rdf:Property ;
    rdfs:label 'Income Earned' ;
    rdfs:comment 'Total income earned during the period, including dividends, interest, and rental income.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netContributions rdf:type rdf:Property ;
    rdfs:label 'Net Contributions' ;
    rdfs:comment 'Net cash flow into the portfolio during the period, calculated as contributions minus distributions.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sectorAllocation rdf:type rdf:Property ;
    rdfs:label 'Sector Allocation' ;
    rdfs:comment 'Dominant sector or industry allocation within the portfolio at the snapshot date.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotStatus rdf:type rdf:Property ;
    rdfs:label 'Snapshot Status' ;
    rdfs:comment 'Current status of the PBOR snapshot in its lifecycle (preliminary, final, restated, archived).' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFees rdf:type rdf:Property ;
    rdfs:label 'Total Fees' ;
    rdfs:comment 'Total investment management fees, custody fees, and other expenses charged to the portfolio during the period.' ;
    rdfs:domain ind:PborSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:var95 rdf:type rdf:Property ;
    rdfs:label 'Var 95' ;
    rdfs:comment 'Value at Risk at 95% confidence level, representing maximum expected loss over a specified period.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gipsCompositeReportId rdf:type rdf:Property ;
    rdfs:label 'Gips Composite Report Id' ;
    rdfs:comment 'Unique identifier for the GIPS composite report record.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkAnnualReturnPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Annual Return Pct' ;
    rdfs:comment 'Annual return of the benchmark index for the reporting year, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkThreeYearStdDevPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Three Year Std Dev Pct' ;
    rdfs:comment 'Three-year annualized ex-post standard deviation of the benchmark returns, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeAnnualReturnPct rdf:type rdf:Property ;
    rdfs:label 'Composite Annual Return Pct' ;
    rdfs:comment 'Time-Weighted Return (TWR) for the composite for the reporting year, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeAumEndOfYear rdf:type rdf:Property ;
    rdfs:label 'Composite Aum End Of Year' ;
    rdfs:comment 'Total market value of assets in the composite at the end of the reporting year.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeCreationDate rdf:type rdf:Property ;
    rdfs:label 'Composite Creation Date' ;
    rdfs:comment 'Date when the composite was first established.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compositeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Composite Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which composite returns and AUM are reported.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeDispersionPct rdf:type rdf:Property ;
    rdfs:label 'Composite Dispersion Pct' ;
    rdfs:comment 'Measure of the spread of individual portfolio returns within the composite, typically asset-weighted standard deviation.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Composite Inception Date' ;
    rdfs:comment 'Date of the first full reporting period for the composite.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compositeStrategyType rdf:type rdf:Property ;
    rdfs:label 'Composite Strategy Type' ;
    rdfs:comment 'Primary asset class or investment strategy category of the composite.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Composite Termination Date' ;
    rdfs:comment 'Date when the composite was discontinued or merged, if applicable.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compositeThreeYearStdDevPct rdf:type rdf:Property ;
    rdfs:label 'Composite Three Year Std Dev Pct' ;
    rdfs:comment 'Three-year annualized ex-post standard deviation of the composite returns, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firmAumEndOfYear rdf:type rdf:Property ;
    rdfs:label 'Firm Aum End Of Year' ;
    rdfs:comment 'Total market value of all assets managed by the firm at the end of the reporting year.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gipsComplianceStatement rdf:type rdf:Property ;
    rdfs:label 'Gips Compliance Statement' ;
    rdfs:comment 'Official statement confirming the firm has complied with GIPS standards for this composite and reporting period.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossOfFeesReturnPct rdf:type rdf:Property ;
    rdfs:label 'Gross Of Fees Return Pct' ;
    rdfs:comment 'Composite return before deduction of investment management fees, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOfFeesReturnPct rdf:type rdf:Property ;
    rdfs:label 'Net Of Fees Return Pct' ;
    rdfs:comment 'Composite return after deduction of investment management fees, expressed as a percentage.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageOfFirmAssetsPct rdf:type rdf:Property ;
    rdfs:label 'Percentage Of Firm Assets Pct' ;
    rdfs:comment 'Composite AUM as a percentage of total firm AUM at the end of the reporting year.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportPreparationDate rdf:type rdf:Property ;
    rdfs:label 'Report Preparation Date' ;
    rdfs:comment 'Date when this GIPS composite report was prepared and finalized.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:useOfDerivativesFlag rdf:type rdf:Property ;
    rdfs:label 'Use Of Derivatives Flag' ;
    rdfs:comment 'Indicates whether the composite strategy uses derivative instruments.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:useOfLeverageFlag rdf:type rdf:Property ;
    rdfs:label 'Use Of Leverage Flag' ;
    rdfs:comment 'Indicates whether the composite strategy employs leverage or derivatives for investment purposes.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifierName rdf:type rdf:Property ;
    rdfs:label 'Verifier Name' ;
    rdfs:comment 'Name of the independent third-party firm that performed the GIPS verification.' ;
    rdfs:domain ind:GipsCompositeReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceFactorExposureId rdf:type rdf:Property ;
    rdfs:label 'Performance Factor Exposure Id' ;
    rdfs:comment 'Unique identifier for the performance factor exposure record.' ;
    rdfs:domain ind:PerformanceFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkExposureValue rdf:type rdf:Property ;
    rdfs:label 'Benchmark Exposure Value' ;
    rdfs:comment 'The benchmark\'s exposure to the same factor, used for relative performance attribution.' ;
    rdfs:domain ind:PerformanceFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityFlag rdf:type rdf:Property ;
    rdfs:label 'Quality Flag' ;
    rdfs:comment 'Indicates the data quality status of the factor exposure record.' ;
    rdfs:domain ind:PerformanceFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standardError rdf:type rdf:Property ;
    rdfs:label 'Standard Error' ;
    rdfs:comment 'The standard error of the factor exposure estimate, measuring estimation uncertainty.' ;
    rdfs:domain ind:PerformanceFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerGroupId rdf:type rdf:Property ;
    rdfs:label 'Peer Group Id' ;
    rdfs:comment 'Unique identifier for the peer group universe used for relative performance comparison.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PeerGroup .

ind:benchmarkComparisonFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Comparison Flag' ;
    rdfs:comment 'Indicates whether this peer group is used for formal benchmark-relative performance attribution and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peerGroupCode rdf:type rdf:Property ;
    rdfs:label 'Peer Group Code' ;
    rdfs:comment 'Short alphanumeric code or identifier for the peer group used in reporting systems and performance analytics.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceDescription rdf:type rdf:Property ;
    rdfs:label 'Data Source Description' ;
    rdfs:comment 'Description of the data sources and collection methodology used by the provider to gather peer group performance data.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalUsageNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Usage Notes' ;
    rdfs:comment 'Internal notes documenting how this peer group is used within the organization, which portfolios it applies to, and any usage guidelines.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Last Updated Date' ;
    rdfs:comment 'Date when the peer group definition, membership, or methodology was last updated by the provider.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:maximumAumThreshold rdf:type rdf:Property ;
    rdfs:label 'Maximum Aum Threshold' ;
    rdfs:comment 'Maximum AUM threshold for peer group inclusion, used to define size-based peer cohorts, expressed in the peer group currency.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAumThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Aum Threshold' ;
    rdfs:comment 'Minimum AUM required for an institutional investor to be included in the peer group universe, expressed in the peer group currency.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerGroupName rdf:type rdf:Property ;
    rdfs:label 'Peer Group Name' ;
    rdfs:comment 'Business name of the peer group universe (e.g., Global Pension Funds - Infrastructure, national Public Equities Large Cap).' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerGroupStatus rdf:type rdf:Property ;
    rdfs:label 'Peer Group Status' ;
    rdfs:comment 'Current operational status of the peer group indicating whether it is actively maintained and used for performance comparison.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerGroupType rdf:type rdf:Property ;
    rdfs:label 'Peer Group Type' ;
    rdfs:comment 'Classification of the type of institutional investors included in the peer group universe. [ENUM-REF-CANDIDATE: Institutional|Pension Fund|Sovereign Wealth Fund|Endowment|Foundation|Insurance|Mutual Fund|Hedge Fund|Private Equity Fund|Other — 10' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Provider Contact Email' ;
    rdfs:comment 'Primary email address for contacting the peer group provider for inquiries, data updates, or methodology questions.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerWebsiteUrl rdf:type rdf:Property ;
    rdfs:label 'Provider Website Url' ;
    rdfs:comment 'Website URL of the peer group provider where methodology documentation and peer group data can be accessed.' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quartileCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Quartile Calculation Method' ;
    rdfs:comment 'Methodology used to calculate quartile rankings within the peer group (e.g., interpolation method, discrete ranking).' ;
    rdfs:domain ind:PeerGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionEndDate rdf:type rdf:Property ;
    rdfs:label 'Subscription End Date' ;
    rdfs:comment 'Date when the organization subscription to this peer group ended or is scheduled to end.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subscriptionStartDate rdf:type rdf:Property ;
    rdfs:label 'Subscription Start Date' ;
    rdfs:comment 'Date when the organization began subscribing to or using this peer group for performance comparison and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peerGroupReturnId rdf:type rdf:Property ;
    rdfs:label 'Peer Group Return Id' ;
    rdfs:comment 'Unique identifier for the peer group return record.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bottomDecileReturn rdf:type rdf:Property ;
    rdfs:label 'Bottom Decile Return' ;
    rdfs:comment 'Maximum return threshold for the bottom 10% performers in the peer group for the measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Data As Of Date' ;
    rdfs:comment 'Date on which the peer group return data was sourced or published by the provider.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:meanReturn rdf:type rdf:Property ;
    rdfs:label 'Mean Return' ;
    rdfs:comment 'Arithmetic mean return of the peer group for the measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medianReturn rdf:type rdf:Property ;
    rdfs:label 'Median Return' ;
    rdfs:comment 'Median return of the peer group for the measurement period, expressed as a decimal (e.g., 0.0825 for 8.25%).' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfPeers rdf:type rdf:Property ;
    rdfs:label 'Number Of Peers' ;
    rdfs:comment 'Total count of peer entities included in the peer group universe for this measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peerGroupAumCurrency rdf:type rdf:Property ;
    rdfs:label 'Peer Group Aum Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the peer group AUM total (e.g., USD, EUR).' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerGroupAumTotal rdf:type rdf:Property ;
    rdfs:label 'Peer Group Aum Total' ;
    rdfs:comment 'Total Assets Under Management (AUM) across all peers in the group at the measurement period end date.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerGroupProvider rdf:type rdf:Property ;
    rdfs:label 'Peer Group Provider' ;
    rdfs:comment 'Source provider of the peer group data (CEM Benchmarking, Preqin, Mercer, or Internal).' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:percentile25thReturn rdf:type rdf:Property ;
    rdfs:label 'Percentile 25th Return' ;
    rdfs:comment 'Return at the 25th percentile of the peer group distribution for the measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile75thReturn rdf:type rdf:Property ;
    rdfs:label 'Percentile 75th Return' ;
    rdfs:comment 'Return at the 75th percentile of the peer group distribution for the measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:standardDeviation rdf:type rdf:Property ;
    rdfs:label 'Standard Deviation' ;
    rdfs:comment 'Standard deviation of returns within the peer group, measuring dispersion and risk.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:topDecileReturn rdf:type rdf:Property ;
    rdfs:label 'Top Decile Return' ;
    rdfs:comment 'Minimum return threshold for the top 10% performers in the peer group for the measurement period.' ;
    rdfs:domain ind:PeerGroupReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualizationFactor rdf:type rdf:Property ;
    rdfs:label 'Annualization Factor' ;
    rdfs:comment 'Factor used to annualize returns for this period (e.g., 252 for daily, 12 for monthly, 4 for quarterly, 1 for annual). Used in volatility and Sharpe ratio calculations.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Attribution Eligible Flag' ;
    rdfs:comment 'Indicates whether this period supports factor, sector, and geographic attribution analysis.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compositeEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Composite Eligible Flag' ;
    rdfs:comment 'Indicates whether this period is eligible for composite construction and aggregation under GIPS standards.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:returnPeriodDescription rdf:type rdf:Property ;
    rdfs:label 'Return Period Description' ;
    rdfs:comment 'Detailed business description of the return period, including calculation rules, use cases, and any special considerations for performance measurement.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:displaySequence rdf:type rdf:Property ;
    rdfs:label 'Display Sequence' ;
    rdfs:comment 'Numeric ordering for display in performance reports and dashboards. Lower numbers appear first.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:durationMonths rdf:type rdf:Property ;
    rdfs:label 'Duration Months' ;
    rdfs:comment 'Standard duration of the period in months. Used for rolling multi-year periods (e.g., 12 for rolling 1-year, 36 for rolling 3-year).' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:periodCode rdf:type rdf:Property ;
    rdfs:label 'Period Code' ;
    rdfs:comment 'Business identifier code for the return period (e.g., DAILY, MTD, QTD, YTD, ITD, R1Y, R3Y, R5Y, R10Y).' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodFrequency rdf:type rdf:Property ;
    rdfs:label 'Period Frequency' ;
    rdfs:comment 'Frequency classification of the return period: daily, weekly, monthly, quarterly, semi-annual, annual, multi-year, or inception. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|multi_year|inception — 8 candidates stripped; promote' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodName rdf:type rdf:Property ;
    rdfs:label 'Period Name' ;
    rdfs:comment 'Human-readable name of the return period (e.g., Daily, Month-to-Date, Quarter-to-Date, Fiscal Year, Calendar Year, Inception-to-Date, Rolling 1-Year, Rolling 3-Year).' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnPeriodStatus rdf:type rdf:Property ;
    rdfs:label 'Return Period Status' ;
    rdfs:comment 'Current lifecycle status of the return period definition: active for current use, inactive for temporarily disabled, deprecated for phased-out periods.' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rollingWindowMonths rdf:type rdf:Property ;
    rdfs:label 'Rolling Window Months' ;
    rdfs:comment 'Number of months in the rolling window for rolling period types (e.g., 12 for rolling 1-year, 36 for rolling 3-year, 60 for rolling 5-year, 120 for rolling 10-year).' ;
    rdfs:domain ind:ReturnPeriod ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationEffectEnabled rdf:type rdf:Property ;
    rdfs:label 'Allocation Effect Enabled' ;
    rdfs:comment 'Indicates whether the model calculates allocation effect (impact of portfolio weight decisions relative to benchmark).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Required Flag' ;
    rdfs:comment 'Indicates whether a benchmark is mandatory for attribution calculations using this model.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cashTreatmentMethod rdf:type rdf:Property ;
    rdfs:label 'Cash Treatment Method' ;
    rdfs:comment 'Defines how cash and cash equivalents are handled in the attribution calculation.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clientReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Client Reporting Flag' ;
    rdfs:comment 'Indicates whether this attribution model is used for beneficiary or client-facing performance reports.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:currencyEffectEnabled rdf:type rdf:Property ;
    rdfs:label 'Currency Effect Enabled' ;
    rdfs:comment 'Indicates whether the model isolates and calculates foreign exchange impact on returns.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:derivativeTreatmentMethod rdf:type rdf:Property ;
    rdfs:label 'Derivative Treatment Method' ;
    rdfs:comment 'Defines how derivative instruments are incorporated into attribution analysis (e.g., notional exposure, delta-adjusted, look-through to underlying).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorModelType rdf:type rdf:Property ;
    rdfs:label 'Factor Model Type' ;
    rdfs:comment 'The factor model framework used for factor-based attribution (e.g., Barra, Axioma, custom multi-factor model). Null if not factor-based.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicClassificationScheme rdf:type rdf:Property ;
    rdfs:label 'Geographic Classification Scheme' ;
    rdfs:comment 'The geographic taxonomy used for regional attribution analysis (e.g., MSCI country classification, custom regional groupings).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interactionEffectEnabled rdf:type rdf:Property ;
    rdfs:label 'Interaction Effect Enabled' ;
    rdfs:comment 'Indicates whether the model calculates interaction effect (combined impact of allocation and selection decisions).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalAnalyticsFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Analytics Flag' ;
    rdfs:comment 'Indicates whether this attribution model is used for internal investment decision-making and portfolio management analytics.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:multiPeriodLinkingMethod rdf:type rdf:Property ;
    rdfs:label 'Multi Period Linking Method' ;
    rdfs:comment 'The method used to link attribution effects across multiple time periods.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerTeam rdf:type rdf:Property ;
    rdfs:label 'Owner Team' ;
    rdfs:comment 'The business unit or team responsible for maintaining and governing this attribution model (e.g., Performance Analytics, Investment Risk).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorClassificationScheme rdf:type rdf:Property ;
    rdfs:label 'Sector Classification Scheme' ;
    rdfs:comment 'The industry or sector taxonomy used for attribution grouping (e.g., GICS, ICB, BICS, custom internal classification).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionEffectEnabled rdf:type rdf:Property ;
    rdfs:label 'Selection Effect Enabled' ;
    rdfs:comment 'Indicates whether the model calculates selection effect (impact of security selection within sectors or factors).' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:smoothingMethod rdf:type rdf:Property ;
    rdfs:label 'Smoothing Method' ;
    rdfs:comment 'Technique applied to smooth attribution effects over time or handle large cash flows (e.g., Modified Dietz smoothing). Null if no smoothing applied.' ;
    rdfs:domain ind:AttributionModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeHurdleId rdf:type rdf:Property ;
    rdfs:label 'Fee Hurdle Id' ;
    rdfs:comment 'Unique identifier for the fee hurdle record.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:catchUpProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Catch Up Provision Flag' ;
    rdfs:comment 'Indicates whether a catch-up provision exists allowing the General Partner (GP) to receive 100% of profits after the hurdle until the agreed profit split is achieved.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeAccrualMethod rdf:type rdf:Property ;
    rdfs:label 'Fee Accrual Method' ;
    rdfs:comment 'Indicates whether performance fees are accrued continuously or only upon realization of gains.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highWaterMark rdf:type rdf:Property ;
    rdfs:label 'High Water Mark' ;
    rdfs:comment 'The highest Net Asset Value (NAV) level previously achieved by the portfolio, used to ensure performance fees are only charged on new gains.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highWaterMarkDate rdf:type rdf:Property ;
    rdfs:label 'High Water Mark Date' ;
    rdfs:comment 'The date on which the current high water mark was established.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hurdleAdjustmentProvision rdf:type rdf:Property ;
    rdfs:label 'Hurdle Adjustment Provision' ;
    rdfs:comment 'Description of any provisions allowing for adjustment of the hurdle rate under specific circumstances (e.g., market conditions, regulatory changes).' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurdleStatus rdf:type rdf:Property ;
    rdfs:label 'Hurdle Status' ;
    rdfs:comment 'Current operational status of the fee hurdle arrangement.' ;
    rdfs:domain ind:FeeHurdle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCalculationDate rdf:type rdf:Property ;
    rdfs:label 'Last Calculation Date' ;
    rdfs:comment 'The most recent date on which the hurdle rate and performance fee calculation was performed for this arrangement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossCarryforwardFlag rdf:type rdf:Property ;
    rdfs:label 'Loss Carryforward Flag' ;
    rdfs:comment 'Indicates whether losses from prior periods can be carried forward to offset future gains before performance fees are calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextCalculationDate rdf:type rdf:Property ;
    rdfs:label 'Next Calculation Date' ;
    rdfs:comment 'The scheduled date for the next hurdle rate and performance fee calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:excessReturnId rdf:type rdf:Property ;
    rdfs:label 'Excess Return Id' ;
    rdfs:comment 'Unique identifier for the excess return record.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualizedExcessReturn rdf:type rdf:Property ;
    rdfs:label 'Annualized Excess Return' ;
    rdfs:comment 'Excess return annualized for periods shorter or longer than one year for comparability.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeExcessReturn rdf:type rdf:Property ;
    rdfs:label 'Cumulative Excess Return' ;
    rdfs:comment 'Compounded excess return over multiple periods, showing total alpha generation since inception or period start.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyAdjustedExcessReturn rdf:type rdf:Property ;
    rdfs:label 'Currency Adjusted Excess Return' ;
    rdfs:comment 'Excess return adjusted for foreign exchange effects to isolate investment decision impact.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossExcessReturn rdf:type rdf:Property ;
    rdfs:label 'Gross Excess Return' ;
    rdfs:comment 'Portfolio return minus benchmark return before deducting fees, representing alpha generation.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netExcessReturn rdf:type rdf:Property ;
    rdfs:label 'Net Excess Return' ;
    rdfs:comment 'Portfolio return minus benchmark return after deducting all fees, representing net alpha to beneficiaries.' ;
    rdfs:domain ind:ExcessReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyAttributionId rdf:type rdf:Property ;
    rdfs:label 'Currency Attribution Id' ;
    rdfs:comment 'Unique identifier for the currency attribution record.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeCurrencyWeight rdf:type rdf:Property ;
    rdfs:label 'Active Currency Weight' ;
    rdfs:comment 'Difference between portfolio and benchmark currency weights (portfolio weight minus benchmark weight), expressed as a decimal fraction.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyAllocationEffect rdf:type rdf:Property ;
    rdfs:label 'Currency Allocation Effect' ;
    rdfs:comment 'Performance impact from differences in currency weight allocation between portfolio and benchmark, expressed in basis points (bps).' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyInteractionEffect rdf:type rdf:Property ;
    rdfs:label 'Currency Interaction Effect' ;
    rdfs:comment 'Performance impact from the interaction between currency allocation and selection decisions, expressed in basis points (bps).' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencySelectionEffect rdf:type rdf:Property ;
    rdfs:label 'Currency Selection Effect' ;
    rdfs:comment 'Performance impact from currency return differences between portfolio and benchmark holdings, expressed in basis points (bps).' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardContractMtm rdf:type rdf:Property ;
    rdfs:label 'Forward Contract Mtm' ;
    rdfs:comment 'Mark-to-market value of foreign exchange forward contracts at period end, expressed in base currency.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardContractNotional rdf:type rdf:Property ;
    rdfs:label 'Forward Contract Notional' ;
    rdfs:comment 'Total notional value of foreign exchange forward contracts used for hedging this currency exposure.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxReturn rdf:type rdf:Property ;
    rdfs:label 'Fx Return' ;
    rdfs:comment 'Return attributable to foreign exchange rate movement during the measurement period, expressed as a decimal fraction.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxSpotRateBegin rdf:type rdf:Property ;
    rdfs:label 'Fx Spot Rate Begin' ;
    rdfs:comment 'Foreign exchange spot rate for the currency pair at the beginning of the measurement period.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxSpotRateEnd rdf:type rdf:Property ;
    rdfs:label 'Fx Spot Rate End' ;
    rdfs:comment 'Foreign exchange spot rate for the currency pair at the end of the measurement period.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgedExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Hedged Exposure Amount' ;
    rdfs:comment 'Market value of hedged currency exposure in base currency at period end.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgingContribution rdf:type rdf:Property ;
    rdfs:label 'Hedging Contribution' ;
    rdfs:comment 'Performance contribution from currency hedging activities for this currency pair, expressed in basis points (bps).' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCurrencyEffect rdf:type rdf:Property ;
    rdfs:label 'Total Currency Effect' ;
    rdfs:comment 'Total performance impact from all currency attribution components (allocation, selection, interaction), expressed in basis points (bps).' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unhedgedExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Unhedged Exposure Amount' ;
    rdfs:comment 'Market value of unhedged currency exposure in base currency at period end.' ;
    rdfs:domain ind:CurrencyAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalRunPerformanceCalculationRunId rdf:type rdf:Property ;
    rdfs:label 'Original Run Performance Calculation Run Id' ;
    rdfs:comment 'Reference to the original performance_calculation_run_id being restated, if this is a restatement run.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceCalculationRun .

ind:approvedByUser rdf:type rdf:Property ;
    rdfs:label 'Approved By User' ;
    rdfs:comment 'Username of the performance analyst or manager who approved the calculation results for publication.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:attributionCalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Attribution Calculation Flag' ;
    rdfs:comment 'Indicates whether performance attribution analysis (allocation, selection, interaction effects) was executed in this run.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkCalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Calculation Flag' ;
    rdfs:comment 'Indicates whether benchmark returns were calculated alongside portfolio returns in this run.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calculationType rdf:type rdf:Property ;
    rdfs:label 'Calculation Type' ;
    rdfs:comment 'Type of performance calculation executed: daily NAV, month-end, quarter-end, year-end, GIPS annual composite, or ad-hoc analysis.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeCount rdf:type rdf:Property ;
    rdfs:label 'Composite Count' ;
    rdfs:comment 'Number of GIPS composites calculated in this run, if applicable.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:errorLogReference rdf:type rdf:Property ;
    rdfs:label 'Error Log Reference' ;
    rdfs:comment 'Reference identifier or file path to detailed error log for this calculation run.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByProcess rdf:type rdf:Property ;
    rdfs:label 'Initiated By Process' ;
    rdfs:comment 'Process type that initiated the calculation: scheduled batch, manual request, API trigger, restatement, or data correction.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiatedByUser rdf:type rdf:Property ;
    rdfs:label 'Initiated By User' ;
    rdfs:comment 'Username or system account that triggered the calculation run.' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioCount rdf:type rdf:Property ;
    rdfs:label 'Portfolio Count' ;
    rdfs:comment 'Number of portfolios included in this calculation run batch.' ;
    rdfs:domain ind:Performance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:publicationFlag rdf:type rdf:Property ;
    rdfs:label 'Publication Flag' ;
    rdfs:comment 'Indicates whether results from this run have been published to external stakeholders (beneficiaries, regulators, board).' ;
    rdfs:domain ind:PerformanceCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:runIdentifier rdf:type rdf:Property ;
    rdfs:label 'Run Identifier' ;
    rdfs:comment 'Human-readable business identifier for the calculation run, typically formatted as YYYYMMDD-HH24MISS or similar batch reference code.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actualImpactPercent rdf:type rdf:Property ;
    rdfs:label 'Actual Impact Percent' ;
    rdfs:comment 'The actual percentage impact of the cash flow on the portfolio NAV, calculated as cash flow amount divided by portfolio NAV before.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowAmount rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Amount' ;
    rdfs:comment 'The monetary value of the significant cash flow in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionEndDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion End Date' ;
    rdfs:comment 'The date on which the portfolio is reinstated into the composite after the exclusion period ends.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Required Flag' ;
    rdfs:comment 'Indicates whether the portfolio must be temporarily excluded from the composite due to this significant cash flow per GIPS policy.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionStartDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Start Date' ;
    rdfs:comment 'The date from which the portfolio is excluded from the composite due to the significant cash flow.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyVersion rdf:type rdf:Property ;
    rdfs:label 'Policy Version' ;
    rdfs:comment 'The version of the firm\'s significant cash flow policy that was applied to this record.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioNavAfter rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav After' ;
    rdfs:comment 'The portfolio NAV immediately after the significant cash flow occurred.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioNavBefore rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav Before' ;
    rdfs:comment 'The portfolio NAV immediately before the significant cash flow occurred.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subPeriodCalculationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Sub Period Calculation Required Flag' ;
    rdfs:comment 'Indicates whether sub-period return calculations are required to isolate the impact of the significant cash flow on performance measurement.' ;
    rdfs:domain ind:SignificantCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dispersionId rdf:type rdf:Property ;
    rdfs:label 'Dispersion Id' ;
    rdfs:comment 'Unique identifier for the dispersion statistic record.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetWeightedDispersionFlag rdf:type rdf:Property ;
    rdfs:label 'Asset Weighted Dispersion Flag' ;
    rdfs:comment 'Indicates whether the dispersion calculation is asset-weighted or equal-weighted.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:beneficiaryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Reporting Flag' ;
    rdfs:comment 'Indicates whether this dispersion statistic is included in beneficiary performance reporting.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compositeAumBegin rdf:type rdf:Property ;
    rdfs:label 'Composite Aum Begin' ;
    rdfs:comment 'Total assets under management in the composite at the start of the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeAumEnd rdf:type rdf:Property ;
    rdfs:label 'Composite Aum End' ;
    rdfs:comment 'Total assets under management in the composite at the end of the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeReturn rdf:type rdf:Property ;
    rdfs:label 'Composite Return' ;
    rdfs:comment 'Asset-weighted return of the composite for the measurement period, used as reference for dispersion analysis.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumPortfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Maximum Portfolio Return' ;
    rdfs:comment 'Highest individual portfolio return within the composite for the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanPortfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Mean Portfolio Return' ;
    rdfs:comment 'Average return of all individual portfolios within the composite for the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measureType rdf:type rdf:Property ;
    rdfs:label 'Measure Type' ;
    rdfs:comment 'Statistical method used to calculate dispersion (e.g., standard deviation, range, interquartile range).' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medianPortfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Median Portfolio Return' ;
    rdfs:comment 'Median return of all individual portfolios within the composite for the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumPortfolioReturn rdf:type rdf:Property ;
    rdfs:label 'Minimum Portfolio Return' ;
    rdfs:comment 'Lowest individual portfolio return within the composite for the measurement period.' ;
    rdfs:domain ind:Dispersion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ldiReturnId rdf:type rdf:Property ;
    rdfs:label 'Ldi Return Id' ;
    rdfs:comment 'Unique identifier for the LDI return record. Primary key for the LDI return measurement.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Asset Return Amount' ;
    rdfs:comment 'Absolute return on LDI portfolio assets during the measurement period, including income and capital appreciation.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Asset Return Percent' ;
    rdfs:comment 'Percentage return on LDI portfolio assets during the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetValueBegin rdf:type rdf:Property ;
    rdfs:label 'Asset Value Begin' ;
    rdfs:comment 'Market value of LDI portfolio assets at the beginning of the measurement period.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetValueEnd rdf:type rdf:Property ;
    rdfs:label 'Asset Value End' ;
    rdfs:comment 'Market value of LDI portfolio assets at the end of the measurement period.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionAmount rdf:type rdf:Property ;
    rdfs:label 'Contribution Amount' ;
    rdfs:comment 'Total contributions made to the LDI portfolio during the measurement period.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountRateBegin rdf:type rdf:Property ;
    rdfs:label 'Discount Rate Begin' ;
    rdfs:comment 'Discount rate used to calculate present value of liabilities at the beginning of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountRateChange rdf:type rdf:Property ;
    rdfs:label 'Discount Rate Change' ;
    rdfs:comment 'Change in discount rate over the measurement period, expressed in basis points or decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountRateEnd rdf:type rdf:Property ;
    rdfs:label 'Discount Rate End' ;
    rdfs:comment 'Discount rate used to calculate present value of liabilities at the end of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationMismatch rdf:type rdf:Property ;
    rdfs:label 'Duration Mismatch' ;
    rdfs:comment 'Difference between asset duration and liability duration at the end of the measurement period, expressed in years.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedRatioBegin rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio Begin' ;
    rdfs:comment 'Ratio of asset value to liability value at the beginning of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedRatioChange rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio Change' ;
    rdfs:comment 'Change in funded ratio over the measurement period, calculated as ending funded ratio minus beginning funded ratio.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedRatioEnd rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio End' ;
    rdfs:comment 'Ratio of asset value to liability value at the end of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgingEffectiveness rdf:type rdf:Property ;
    rdfs:label 'Hedging Effectiveness' ;
    rdfs:comment 'Measure of how effectively the LDI portfolio hedged liability movements during the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgingRatioBegin rdf:type rdf:Property ;
    rdfs:label 'Hedging Ratio Begin' ;
    rdfs:comment 'Ratio of hedged interest rate exposure to total liability duration at the beginning of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgingRatioEnd rdf:type rdf:Property ;
    rdfs:label 'Hedging Ratio End' ;
    rdfs:comment 'Ratio of hedged interest rate exposure to total liability duration at the end of the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityBenchmarkReturn rdf:type rdf:Property ;
    rdfs:label 'Liability Benchmark Return' ;
    rdfs:comment 'Return of the liability benchmark index during the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Liability Return Amount' ;
    rdfs:comment 'Change in liability value driven by discount rate movements and actuarial assumptions during the measurement period.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Liability Return Percent' ;
    rdfs:comment 'Percentage change in liability value during the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityValueBegin rdf:type rdf:Property ;
    rdfs:label 'Liability Value Begin' ;
    rdfs:comment 'Present value of pension liabilities at the beginning of the measurement period, discounted using the applicable discount rate.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityValueEnd rdf:type rdf:Property ;
    rdfs:label 'Liability Value End' ;
    rdfs:comment 'Present value of pension liabilities at the end of the measurement period, discounted using the applicable discount rate.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surplusReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Surplus Return Amount' ;
    rdfs:comment 'Absolute change in surplus (assets minus liabilities) during the measurement period.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surplusReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Surplus Return Percent' ;
    rdfs:comment 'Percentage return on surplus during the measurement period, expressed as a decimal.' ;
    rdfs:domain ind:LdiReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeId rdf:type rdf:Property ;
    rdfs:label 'Notice Id' ;
    rdfs:comment 'Unique identifier for the performance notice record.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aumAtNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Aum At Notice Date' ;
    rdfs:comment 'Total assets under management in the portfolio at the time the performance notice was issued, in base currency.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managerResponseSummary rdf:type rdf:Property ;
    rdfs:label 'Manager Response Summary' ;
    rdfs:comment 'Summary of the external managers formal response to the performance notice, including key points from their remediation plan or explanation.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Mandate Termination Flag' ;
    rdfs:comment 'Indicates whether this performance notice resulted in termination of the external manager mandate.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:measurementPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Months' ;
    rdfs:comment 'Duration in months of the rolling performance measurement period, typically 12, 24, or 36 months per mandate agreement.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:noticeStatus rdf:type rdf:Property ;
    rdfs:label 'Notice Status' ;
    rdfs:comment 'Current lifecycle status of the performance notice in the remediation and resolution workflow. [ENUM-REF-CANDIDATE: draft|issued|acknowledged|under_review|remediation_in_progress|resolved|escalated|mandate_terminated — 8 candidates stripped; promote to' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeType rdf:type rdf:Property ;
    rdfs:label 'Notice Type' ;
    rdfs:comment 'Classification of the performance notice based on the nature of the breach or underperformance trigger.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Deadline Date' ;
    rdfs:comment 'Date by which the external manager must submit their remediation plan or corrective action response.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:thresholdReturn rdf:type rdf:Property ;
    rdfs:label 'Threshold Return' ;
    rdfs:comment 'Minimum acceptable excess return threshold defined in the mandate agreement, breach of which triggers a performance notice.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackingErrorActual rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Actual' ;
    rdfs:comment 'Actual tracking error measured over the period, representing the standard deviation of excess returns.' ;
    rdfs:domain ind:Notice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceExceptionId rdf:type rdf:Property ;
    rdfs:label 'Performance Exception Id' ;
    rdfs:comment 'Globally unique identifier for a performance exception record.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eventCompositeId rdf:type rdf:Property ;
    rdfs:label 'Event Composite Id' ;
    rdfs:comment 'Identifier of the composite affected by the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Composite .

ind:eventPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Event Portfolio Id' ;
    rdfs:comment 'Identifier of the portfolio affected by the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Portfolio .

ind:eventAffectedEntityName rdf:type rdf:Property ;
    rdfs:label 'Event Affected Entity Name' ;
    rdfs:comment 'Human-readable name of the affected entity.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventAffectedEntityType rdf:type rdf:Property ;
    rdfs:label 'Event Affected Entity Type' ;
    rdfs:comment 'Type of entity affected by the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventCategory rdf:type rdf:Property ;
    rdfs:label 'Event Category' ;
    rdfs:comment 'Broad category of the exception event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Event Created By' ;
    rdfs:comment 'Identifier of the user or process that created the record.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventExceptionCode rdf:type rdf:Property ;
    rdfs:label 'Event Exception Code' ;
    rdfs:comment 'Alphanumeric code representing the exception type.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventExceptionDescription rdf:type rdf:Property ;
    rdfs:label 'Event Exception Description' ;
    rdfs:comment 'Detailed description of the exception event.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventExceptionType rdf:type rdf:Property ;
    rdfs:label 'Event Exception Type' ;
    rdfs:comment 'Specific type of exception, e.g., price missing or valuation error.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Event Impact Description' ;
    rdfs:comment 'Description of the impact caused by the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventImpactLevel rdf:type rdf:Property ;
    rdfs:label 'Event Impact Level' ;
    rdfs:comment 'Level of impact of the exception on performance.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventMeasurementPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Event Measurement Period End Date' ;
    rdfs:comment 'End date of the measurement period for which the exception was identified.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventMeasurementPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Event Measurement Period Start Date' ;
    rdfs:comment 'Start date of the measurement period for which the exception was identified.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eventPayloadOrValue rdf:type rdf:Property ;
    rdfs:label 'Event Payload Or Value' ;
    rdfs:comment 'Raw payload or value associated with the exception, often JSON or descriptive text.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventPriority rdf:type rdf:Property ;
    rdfs:label 'Event Priority' ;
    rdfs:comment 'Priority assigned to the exception for resolution.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventResolvedBy rdf:type rdf:Property ;
    rdfs:label 'Event Resolved By' ;
    rdfs:comment 'Identifier of the user or system that resolved the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventResolvedFlag rdf:type rdf:Property ;
    rdfs:label 'Event Resolved Flag' ;
    rdfs:comment 'Flag indicating whether the exception has been resolved.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventResolvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Resolved Timestamp' ;
    rdfs:comment 'Timestamp when the exception was resolved.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventSeverity rdf:type rdf:Property ;
    rdfs:label 'Event Severity' ;
    rdfs:comment 'Severity level of the exception event.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSourceReference rdf:type rdf:Property ;
    rdfs:label 'Event Source Reference' ;
    rdfs:comment 'Identifier of the source record that generated the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Event Source System' ;
    rdfs:comment 'Name of the system that generated the exception. [ENUM-REF-CANDIDATE: SimCorp Dimension|BlackRock Aladdin|Bloomberg Terminal|State Street|eFront|DealCloud|MSCI|Charles River|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventSourceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Source Timestamp' ;
    rdfs:comment 'Timestamp of the event in the source system.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:eventThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Event Threshold Value' ;
    rdfs:comment 'Threshold value used to determine exception severity.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventTypeOrChannel rdf:type rdf:Property ;
    rdfs:label 'Event Type Or Channel' ;
    rdfs:comment 'Category of the exception event, e.g., price missing or FX rate stale.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Event Updated By' ;
    rdfs:comment 'Identifier of the user or process that last updated the record.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Event Variance Amount' ;
    rdfs:comment 'Monetary variance amount that triggered the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventVariancePercent rdf:type rdf:Property ;
    rdfs:label 'Event Variance Percent' ;
    rdfs:comment 'Percentage variance that triggered the exception.' ;
    rdfs:domain ind:PerformanceException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scenarioApplicationId rdf:type rdf:Property ;
    rdfs:label 'Scenario Application Id' ;
    rdfs:comment 'Primary key for the scenario_application association' ;
    rdfs:domain ind:ScenarioApplication ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeReturnAttributionId rdf:type rdf:Property ;
    rdfs:label 'Active Return Attribution Id' ;
    rdfs:comment 'Surrogate primary key for the active return attribution table.' ;
    rdfs:domain ind:ActiveReturnAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:factorReturnBps rdf:type rdf:Property ;
    rdfs:label 'Factor Return Bps' ;
    rdfs:comment 'The factor return bps of the active return attribution.' ;
    rdfs:domain ind:ActiveReturnAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sectorAllocationReturnBps rdf:type rdf:Property ;
    rdfs:label 'Sector Allocation Return Bps' ;
    rdfs:comment 'The sector allocation return bps of the active return attribution.' ;
    rdfs:domain ind:ActiveReturnAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:securitySelectionReturnBps rdf:type rdf:Property ;
    rdfs:label 'Security Selection Return Bps' ;
    rdfs:comment 'The security selection return bps of the active return attribution.' ;
    rdfs:domain ind:ActiveReturnAttribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aboAmount rdf:type rdf:Property ;
    rdfs:label 'Abo Amount' ;
    rdfs:comment 'The actuarial present value of pension benefits earned to date based on current salary levels, without projection of future salary increases.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialGainLoss rdf:type rdf:Property ;
    rdfs:label 'Actuarial Gain Loss' ;
    rdfs:comment 'The change in the PBO resulting from differences between actual experience and actuarial assumptions, or from changes in assumptions themselves.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuaryFirm rdf:type rdf:Property ;
    rdfs:label 'Actuary Firm' ;
    rdfs:comment 'The actuarial consulting firm that prepared the liability projection, if applicable.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuaryName rdf:type rdf:Property ;
    rdfs:label 'Actuary Name' ;
    rdfs:comment 'The name of the qualified actuary responsible for preparing and certifying the liability projection.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amortizationPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Years' ;
    rdfs:comment 'The number of years over which unfunded actuarial liabilities or surpluses are amortized through contribution adjustments.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benefitsPaid rdf:type rdf:Property ;
    rdfs:label 'Benefits Paid' ;
    rdfs:comment 'The total pension benefits paid to retirees and beneficiaries during the projection period, reducing the liability.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowYear1 rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Year 1' ;
    rdfs:comment 'Projected net benefit cash flow for year 1 of the projection horizon, used for liquidity planning and ALM.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowYear10 rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Year 10' ;
    rdfs:comment 'Projected net benefit cash flow for year 10 of the projection horizon, used for long-term liquidity planning.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowYear20 rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Year 20' ;
    rdfs:comment 'Projected net benefit cash flow for year 20 of the projection horizon, used for extended-term liquidity planning.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowYear30 rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Year 30' ;
    rdfs:comment 'Projected net benefit cash flow for year 30 of the projection horizon, used for ultra-long-term liquidity planning.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowYear5 rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Year 5' ;
    rdfs:comment 'Projected net benefit cash flow for year 5 of the projection horizon, used for medium-term liquidity planning.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionRateRequired rdf:type rdf:Property ;
    rdfs:label 'Contribution Rate Required' ;
    rdfs:comment 'The actuarially determined contribution rate required from employers and members to fund the projected benefit obligation over time.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disabilityRate rdf:type rdf:Property ;
    rdfs:label 'Disability Rate' ;
    rdfs:comment 'The assumed annual rate at which active members become disabled and eligible for disability benefits.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedRatio rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio' ;
    rdfs:comment 'The ratio of plan assets to the projected benefit obligation, expressed as a percentage, a key solvency and health metric for the pension fund.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedStatusAmount rdf:type rdf:Property ;
    rdfs:label 'Funded Status Amount' ;
    rdfs:comment 'The difference between plan assets and the projected benefit obligation, indicating surplus or deficit position.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestCost rdf:type rdf:Property ;
    rdfs:label 'Interest Cost' ;
    rdfs:comment 'The increase in the projected benefit obligation due to the passage of time, calculated by applying the discount rate to the beginning PBO.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityDurationYears rdf:type rdf:Property ;
    rdfs:label 'Liability Duration Years' ;
    rdfs:comment 'The weighted average duration of the liability cash flows, a key metric for Liability-Driven Investment (LDI) and duration matching strategies.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mortalityImprovementScale rdf:type rdf:Property ;
    rdfs:label 'Mortality Improvement Scale' ;
    rdfs:comment 'The scale used to project future improvements in mortality rates over time, such as CPM-B or MP-2021.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityTable rdf:type rdf:Property ;
    rdfs:label 'Mortality Table' ;
    rdfs:comment 'The mortality table used to estimate life expectancy and the duration of benefit payments, such as RP-2014 or Pri-2012.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalCostRate rdf:type rdf:Property ;
    rdfs:label 'Normal Cost Rate' ;
    rdfs:comment 'The portion of the contribution rate attributable to benefits earned in the current year, excluding amortization of past service costs.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pboAmount rdf:type rdf:Property ;
    rdfs:label 'Pbo Amount' ;
    rdfs:comment 'The actuarial present value of all future pension benefits earned to date, incorporating projected future salary increases and service credits.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectionHorizonYears rdf:type rdf:Property ;
    rdfs:label 'Projection Horizon Years' ;
    rdfs:comment 'The number of years into the future for which cash flows and liabilities are projected, typically ranging from 30 to 75 years for pension funds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryFilingDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Date' ;
    rdfs:comment 'The date on which the liability projection was filed with the regulatory authority.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryFilingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Status' ;
    rdfs:comment 'The status of the liability projection in the regulatory filing process with the national pension regulator or other pension regulators.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retirementAgeAssumption rdf:type rdf:Property ;
    rdfs:label 'Retirement Age Assumption' ;
    rdfs:comment 'The average assumed retirement age for active members, used to project the timing of benefit commencement.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryGrowthRate rdf:type rdf:Property ;
    rdfs:label 'Salary Growth Rate' ;
    rdfs:comment 'The assumed annual rate of salary increase used to project future benefit obligations for active members.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceCost rdf:type rdf:Property ;
    rdfs:label 'Service Cost' ;
    rdfs:comment 'The present value of pension benefits earned by active members during the current period, a key component of pension expense.' ;
    rdfs:domain ind:LiabilityProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuaryDesignation rdf:type rdf:Property ;
    rdfs:label 'Actuary Designation' ;
    rdfs:comment 'The professional designation of the lead actuary, such as Fellow of the Society of Actuaries (FSA).' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuaryFirmName rdf:type rdf:Property ;
    rdfs:label 'Actuary Firm Name' ;
    rdfs:comment 'The name of the actuarial consulting firm that performed the valuation.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetValuationMethod rdf:type rdf:Property ;
    rdfs:label 'Asset Valuation Method' ;
    rdfs:comment 'The method used to value plan assets for funding purposes, indicating whether market value, smoothed value, or fair value was applied.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageActiveMemberAge rdf:type rdf:Property ;
    rdfs:label 'Average Active Member Age' ;
    rdfs:comment 'The average age of active contributing members as of the valuation date, used for demographic analysis and liability projection.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averagePensionerAge rdf:type rdf:Property ;
    rdfs:label 'Average Pensioner Age' ;
    rdfs:comment 'The average age of retired members receiving pension benefits as of the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deferredMemberCount rdf:type rdf:Property ;
    rdfs:label 'Deferred Member Count' ;
    rdfs:comment 'The total number of deferred vested members (former employees with preserved benefits) included in the actuarial valuation as of the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:goingConcernDiscountRate rdf:type rdf:Property ;
    rdfs:label 'Going Concern Discount Rate' ;
    rdfs:comment 'The discount rate used to calculate the present value of future benefit payments on a going concern basis, typically based on expected long-term investment returns.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:goingConcernFundedRatio rdf:type rdf:Property ;
    rdfs:label 'Going Concern Funded Ratio' ;
    rdfs:comment 'The ratio of plan assets to going concern liabilities, expressed as a decimal. A value of 1.0000 indicates 100 percent funded status.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:goingConcernLiability rdf:type rdf:Property ;
    rdfs:label 'Going Concern Liability' ;
    rdfs:comment 'The present value of all accrued pension benefits calculated on a going concern basis, assuming the plan continues to operate indefinitely.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:goingConcernSurplusDeficit rdf:type rdf:Property ;
    rdfs:label 'Going Concern Surplus Deficit' ;
    rdfs:comment 'The difference between plan assets and going concern liabilities, indicating the funded status on a going concern basis. Positive values represent surplus; negative values represent deficit.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leadActuaryName rdf:type rdf:Property ;
    rdfs:label 'Lead Actuary Name' ;
    rdfs:comment 'The name of the lead actuary who signed and is responsible for the valuation report.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberContributionRate rdf:type rdf:Property ;
    rdfs:label 'Member Contribution Rate' ;
    rdfs:comment 'The member contribution rate as a percentage of pensionable payroll, representing the portion of pension funding contributed by plan members.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextRequiredValuationDate rdf:type rdf:Property ;
    rdfs:label 'Next Required Valuation Date' ;
    rdfs:comment 'The regulatory deadline date by which the next actuarial valuation must be performed.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportDocumentPath rdf:type rdf:Property ;
    rdfs:label 'Report Document Path' ;
    rdfs:comment 'The file path or document management system reference to the full actuarial valuation report.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retiredMemberCount rdf:type rdf:Property ;
    rdfs:label 'Retired Member Count' ;
    rdfs:comment 'The total number of retired members currently receiving pension benefits included in the actuarial valuation as of the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:salaryIncreaseAssumption rdf:type rdf:Property ;
    rdfs:label 'Salary Increase Assumption' ;
    rdfs:comment 'The assumed long-term rate of salary increases used to project future pensionable earnings for active members.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:solvencyDiscountRate rdf:type rdf:Property ;
    rdfs:label 'Solvency Discount Rate' ;
    rdfs:comment 'The discount rate used to calculate the present value of future benefit payments on a solvency basis, typically based on current annuity purchase rates or high-quality corporate bond yields.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:solvencyFundedRatio rdf:type rdf:Property ;
    rdfs:label 'Solvency Funded Ratio' ;
    rdfs:comment 'The ratio of plan assets to solvency liabilities, expressed as a decimal. A value of 1.0000 indicates 100 percent funded status on a solvency basis.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:solvencyLiability rdf:type rdf:Property ;
    rdfs:label 'Solvency Liability' ;
    rdfs:comment 'The present value of all accrued pension benefits calculated on a solvency basis, representing the cost to settle all obligations if the plan were to wind up on the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:solvencySurplusDeficit rdf:type rdf:Property ;
    rdfs:label 'Solvency Surplus Deficit' ;
    rdfs:comment 'The difference between plan assets and solvency liabilities, indicating the funded status on a solvency basis. Positive values represent surplus; negative values represent deficit.' ;
    rdfs:domain ind:ActuarialValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specialPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Special Payment Amount' ;
    rdfs:comment 'The total amount of special payments required to amortize any going concern or solvency deficit over the regulatory amortization period.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalMemberCount rdf:type rdf:Property ;
    rdfs:label 'Total Member Count' ;
    rdfs:comment 'The total number of all plan members (active, deferred, and retired) included in the actuarial valuation as of the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPlanAssetsMarketValue rdf:type rdf:Property ;
    rdfs:label 'Total Plan Assets Market Value' ;
    rdfs:comment 'The total market value of all pension plan assets as of the valuation date, representing the investment portfolio available to meet future obligations.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPlanAssetsSmoothedValue rdf:type rdf:Property ;
    rdfs:label 'Total Plan Assets Smoothed Value' ;
    rdfs:comment 'The smoothed or actuarial value of plan assets, which may differ from market value due to asset smoothing techniques used to reduce volatility in funding calculations.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:windUpLiability rdf:type rdf:Property ;
    rdfs:label 'Wind Up Liability' ;
    rdfs:comment 'The estimated cost to fully settle all pension obligations through annuity purchases or lump-sum payments if the plan were terminated on the valuation date.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetUniverseScope rdf:type rdf:Property ;
    rdfs:label 'Asset Universe Scope' ;
    rdfs:comment 'Description of the asset classes and investment universe included in the ALM model for portfolio construction and optimization, such as public equities, fixed income, real estate, infrastructure, private equity, and natural resources.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backTestingFrequency rdf:type rdf:Property ;
    rdfs:label 'Back Testing Frequency' ;
    rdfs:comment 'Frequency at which the ALM model predictions are back-tested against actual portfolio and liability outcomes to validate model accuracy and calibration.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitPaymentPattern rdf:type rdf:Property ;
    rdfs:label 'Benefit Payment Pattern' ;
    rdfs:comment 'Expected pattern of future benefit payments over time used in the ALM model: level for constant payments, increasing for growing obligations, decreasing for declining obligations, or custom for complex patterns.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:computationalRuntimeMinutes rdf:type rdf:Property ;
    rdfs:label 'Computational Runtime Minutes' ;
    rdfs:comment 'Typical runtime in minutes required to execute a full ALM model run including all scenarios and optimizations, used for capacity planning and scheduling.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceIntervalLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval Level' ;
    rdfs:comment 'Statistical confidence level used for reporting ALM model results and risk metrics, typically 0.9500 for 95 percent confidence or 0.9900 for 99 percent confidence.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Contribution Rate Assumption' ;
    rdfs:comment 'Assumed annual contribution rate as a percentage of payroll or fixed amount used in the ALM model for projecting future cash inflows from plan sponsors and members.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationMatchingStrategy rdf:type rdf:Property ;
    rdfs:label 'Duration Matching Strategy' ;
    rdfs:comment 'Strategy employed in the ALM model to align the duration of assets with the duration of liabilities to minimize interest rate risk exposure.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIntegrationApproach rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Approach' ;
    rdfs:comment 'Approach to incorporating ESG factors into the ALM model asset selection and portfolio construction: exclusion screening, best-in-class selection, thematic investing, impact investing, ESG integration, active engagement, or none.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationAssumptionRate rdf:type rdf:Property ;
    rdfs:label 'Inflation Assumption Rate' ;
    rdfs:comment 'Long-term inflation rate assumption used in the ALM model for indexing pension benefits and projecting real returns, expressed as a decimal proportion.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityConstraintPct rdf:type rdf:Property ;
    rdfs:label 'Liquidity Constraint Pct' ;
    rdfs:comment 'Minimum percentage of portfolio assets that must be maintained in liquid form to meet near-term benefit payment obligations, expressed as a decimal proportion.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelComplexityRating rdf:type rdf:Property ;
    rdfs:label 'Model Complexity Rating' ;
    rdfs:comment 'Qualitative assessment of the ALM model computational and conceptual complexity, used for governance oversight and resource allocation.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityAssumptionTable rdf:type rdf:Property ;
    rdfs:label 'Mortality Assumption Table' ;
    rdfs:comment 'Name or identifier of the mortality table used in the ALM model for projecting longevity risk and future benefit payments, such as RP-2014 or Pri-2012.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optimizationObjective rdf:type rdf:Property ;
    rdfs:label 'Optimization Objective' ;
    rdfs:comment 'Primary objective function that the ALM model optimizes, such as maximizing surplus, minimizing contribution volatility, maximizing risk-adjusted return, or minimizing funded status volatility.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Flag' ;
    rdfs:comment 'Indicates whether this ALM model configuration meets all applicable regulatory requirements and has been validated for compliance reporting purposes.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scenarioCount rdf:type rdf:Property ;
    rdfs:label 'Scenario Count' ;
    rdfs:comment 'Number of economic scenarios or simulation paths generated by the ALM model for stochastic or scenario-based analysis.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:softwarePlatform rdf:type rdf:Property ;
    rdfs:label 'Software Platform' ;
    rdfs:comment 'Name and version of the software platform or actuarial system used to implement and execute this ALM model, such as Aladdin, SimCorp, or proprietary in-house systems.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressTestScenarios rdf:type rdf:Property ;
    rdfs:label 'Stress Test Scenarios' ;
    rdfs:comment 'Comma-separated list or description of macroeconomic stress test scenarios applied in the ALM model, such as interest rate shocks, equity market crashes, inflation spikes, or credit spread widening.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetFundedRatio rdf:type rdf:Property ;
    rdfs:label 'Target Funded Ratio' ;
    rdfs:comment 'Target ratio of plan assets to actuarial liabilities that the ALM model aims to achieve or maintain, expressed as a decimal proportion where 1.00 represents 100 percent funded status.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Var Calculation Method' ;
    rdfs:comment 'Methodology used within the ALM model to calculate Value at Risk for portfolio risk assessment: historical simulation, parametric variance-covariance, Monte Carlo simulation, Cornish-Fisher expansion, or not applicable if VaR is not calculated.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Version Effective Timestamp' ;
    rdfs:comment 'Timestamp marking when this specific version of the ALM model configuration became effective, supporting temporal versioning and historical analysis.' ;
    rdfs:domain ind:AlmModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:almScenarioId rdf:type rdf:Property ;
    rdfs:label 'Alm Scenario Id' ;
    rdfs:comment 'Unique identifier for the ALM scenario run. Primary key.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:riskStressScenarioId rdf:type rdf:Property ;
    rdfs:label 'Risk Stress Scenario Id' ;
    rdfs:comment 'Foreign key linking to risk.stress_scenario. Business justification: ALM scenarios should reference standardized risk stress scenarios for integrated stress testing. Ensures actuarial and risk teams apply consistent shocks.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressScenario .

ind:assetDurationYears rdf:type rdf:Property ;
    rdfs:label 'Asset Duration Years' ;
    rdfs:comment 'Macaulay or modified duration of the asset portfolio under this scenario, measured in years.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitIndexationPercent rdf:type rdf:Property ;
    rdfs:label 'Benefit Indexation Percent' ;
    rdfs:comment 'Annual percentage increase applied to pension benefits in payment to reflect cost-of-living adjustments.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completion Timestamp' ;
    rdfs:comment 'Date and time when the scenario run finished processing, whether successfully or with errors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contributionRateAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Contribution Rate Assumption Percent' ;
    rdfs:comment 'Assumed employer and employee contribution rate as percentage of pensionable earnings for this scenario.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:convergenceTolerance rdf:type rdf:Property ;
    rdfs:label 'Convergence Tolerance' ;
    rdfs:comment 'Numerical tolerance threshold used to determine convergence of iterative ALM calculations.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationGapYears rdf:type rdf:Property ;
    rdfs:label 'Duration Gap Years' ;
    rdfs:comment 'Difference between asset duration and liability duration, indicating interest rate risk mismatch.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityReturnAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Equity Return Assumption Percent' ;
    rdfs:comment 'Assumed annual equity market return percentage used in this scenario for public equity asset class projections.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedRatioResultPercent rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio Result Percent' ;
    rdfs:comment 'Calculated funded status ratio (assets divided by liabilities) resulting from this scenario run.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:infrastructureReturnAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Return Assumption Percent' ;
    rdfs:comment 'Assumed annual return percentage for infrastructure asset class in this scenario projection.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longevityShockYears rdf:type rdf:Property ;
    rdfs:label 'Longevity Shock Years' ;
    rdfs:comment 'Number of years added to life expectancy assumptions to stress-test longevity risk impact on pension liabilities.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelVersionUsed rdf:type rdf:Property ;
    rdfs:label 'Model Version Used' ;
    rdfs:comment 'Specific version of the ALM model configuration used for this run, captured for auditability and reproducibility' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityAssumptionAdjustmentPercent rdf:type rdf:Property ;
    rdfs:label 'Mortality Assumption Adjustment Percent' ;
    rdfs:comment 'Percentage adjustment to baseline mortality tables used for liability projections in this scenario.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outputMetrics rdf:type rdf:Property ;
    rdfs:label 'Output Metrics' ;
    rdfs:comment 'JSON or structured text containing key output metrics from this scenario run, such as projected funded ratio, surplus/deficit, VaR, and duration gap under this scenario' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:privateEquityReturnAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Private Equity Return Assumption Percent' ;
    rdfs:comment 'Assumed annual return percentage for private equity asset class in this scenario projection.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realEstateReturnAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Real Estate Return Assumption Percent' ;
    rdfs:comment 'Assumed annual return percentage for real estate asset class in this scenario projection.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:salaryGrowthAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Salary Growth Assumption Percent' ;
    rdfs:comment 'Assumed annual salary escalation rate for active members used in liability projections.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scenarioDescription rdf:type rdf:Property ;
    rdfs:label 'Scenario Description' ;
    rdfs:comment 'Detailed narrative description of the scenario assumptions, purpose, and business context for this run.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioRunReference rdf:type rdf:Property ;
    rdfs:label 'Scenario Run Reference' ;
    rdfs:comment 'Unique identifier for this ALM scenario run record' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scenarioVersion rdf:type rdf:Property ;
    rdfs:label 'Scenario Version' ;
    rdfs:comment 'Version number of this scenario run, incremented when scenarios are re-run with updated assumptions.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stochasticPathCount rdf:type rdf:Property ;
    rdfs:label 'Stochastic Path Count' ;
    rdfs:comment 'Number of Monte Carlo simulation paths executed for stochastic scenario types.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:surplusDeficitAmount rdf:type rdf:Property ;
    rdfs:label 'Surplus Deficit Amount' ;
    rdfs:comment 'Net surplus or deficit amount (assets minus liabilities) calculated in this scenario, in base currency.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weight rdf:type rdf:Property ;
    rdfs:label 'Weight' ;
    rdfs:comment 'Probability weight assigned to this scenario for this specific ALM model run, used in expected value calculations. May differ from the scenario\'s default probability_weight based on model-specific assumptions.' ;
    rdfs:domain ind:AlmScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationMethodologyDocument rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology Document' ;
    rdfs:comment 'Reference to the internal or external document that describes the detailed methodology and assumptions used to construct this discount rate curve.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:convergenceTenorYears rdf:type rdf:Property ;
    rdfs:label 'Convergence Tenor Years' ;
    rdfs:comment 'The tenor in years at which the curve converges to the ultimate forward rate in extrapolation methodologies such as Smith-Wilson.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditQualityRating rdf:type rdf:Property ;
    rdfs:label 'Credit Quality Rating' ;
    rdfs:comment 'The minimum credit quality or rating category of the bonds used to construct the curve, relevant for IAS 19 high-quality corporate bond curves.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditSpreadAdjustmentBps rdf:type rdf:Property ;
    rdfs:label 'Credit Spread Adjustment Bps' ;
    rdfs:comment 'The credit spread adjustment in basis points applied to the base curve to reflect credit risk or regulatory requirements.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:curveConstructionDate rdf:type rdf:Property ;
    rdfs:label 'Curve Construction Date' ;
    rdfs:comment 'The date on which this discount rate curve was constructed or calibrated using market data.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:curveVersion rdf:type rdf:Property ;
    rdfs:label 'Curve Version' ;
    rdfs:comment 'Version identifier for this discount rate curve, used to track revisions and updates over time.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceReference rdf:type rdf:Property ;
    rdfs:label 'Data Source Reference' ;
    rdfs:comment 'Reference identifier or URL pointing to the specific market data source or dataset used to construct this curve.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extrapolationMethod rdf:type rdf:Property ;
    rdfs:label 'Extrapolation Method' ;
    rdfs:comment 'The method used to extend the curve beyond the longest explicitly defined tenor for long-duration liability matching.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidPointTenorYears rdf:type rdf:Property ;
    rdfs:label 'Liquid Point Tenor Years' ;
    rdfs:comment 'The maximum tenor in years up to which market data is considered sufficiently liquid and reliable for direct curve construction.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:liquidityPremiumBps rdf:type rdf:Property ;
    rdfs:label 'Liquidity Premium Bps' ;
    rdfs:comment 'The liquidity premium in basis points added to the curve to compensate for illiquidity in the underlying bond market.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchingAdjustmentBps rdf:type rdf:Property ;
    rdfs:label 'Matching Adjustment Bps' ;
    rdfs:comment 'The matching adjustment in basis points applied when assets and liabilities are closely matched, reducing discount rate volatility under certain regulatory regimes.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumTenorYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Tenor Years' ;
    rdfs:comment 'The longest maturity tenor in years for which a discount rate is explicitly defined or extrapolated in this curve.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumTenorYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Tenor Years' ;
    rdfs:comment 'The shortest maturity tenor in years for which a discount rate is explicitly defined in this curve.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceDataProvider rdf:type rdf:Property ;
    rdfs:label 'Source Data Provider' ;
    rdfs:comment 'The external vendor or internal system that supplied the underlying market data used to construct this curve, such as Bloomberg, Refinitiv, or internal treasury.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenorIncrementYears rdf:type rdf:Property ;
    rdfs:label 'Tenor Increment Years' ;
    rdfs:comment 'The standard interval in years between successive tenor points on the curve, such as 0.5 for semi-annual or 1.0 for annual.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termStructureType rdf:type rdf:Property ;
    rdfs:label 'Term Structure Type' ;
    rdfs:comment 'Indicates the rate convention used in the term structure: spot rates, forward rates, par yields, or zero-coupon rates.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ultimateForwardRate rdf:type rdf:Property ;
    rdfs:label 'Ultimate Forward Rate' ;
    rdfs:comment 'The long-term forward rate assumption used for extrapolation beyond the liquid point of the curve, expressed as a decimal rate.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volatilityAdjustmentBps rdf:type rdf:Property ;
    rdfs:label 'Volatility Adjustment Bps' ;
    rdfs:comment 'The volatility adjustment in basis points applied under certain regulatory frameworks to dampen the impact of short-term market volatility on liability valuations.' ;
    rdfs:domain ind:DiscountRateCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mortalityTableId rdf:type rdf:Property ;
    rdfs:label 'Mortality Table Id' ;
    rdfs:comment 'Unique identifier for the mortality table record. Primary key.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MortalityTable .

ind:primaryPredecessorTableMortalityTableId rdf:type rdf:Property ;
    rdfs:label 'Primary Predecessor Table Mortality Table Id' ;
    rdfs:comment 'Reference to the previous mortality table that this table supersedes or replaces.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MortalityTable .

ind:accountingStandardAlignment rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard Alignment' ;
    rdfs:comment 'Accounting standard or framework the mortality table is aligned with (e.g., IFRS, ASPE, US GAAP).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Adjustment Factor' ;
    rdfs:comment 'Scalar adjustment factor applied to base mortality rates to reflect plan-specific or population-specific experience (e.g., 0.95 for 5% mortality reduction).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ageRangeMaximum rdf:type rdf:Property ;
    rdfs:label 'Age Range Maximum' ;
    rdfs:comment 'Maximum age (in years) for which mortality rates are defined in the table.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ageRangeMinimum rdf:type rdf:Property ;
    rdfs:label 'Age Range Minimum' ;
    rdfs:comment 'Minimum age (in years) for which mortality rates are defined in the table.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blendPercentage rdf:type rdf:Property ;
    rdfs:label 'Blend Percentage' ;
    rdfs:comment 'Percentage weighting used when blending multiple mortality tables to create a custom table (expressed as percentage, e.g., 75.00 for 75%).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collarAdjustmentType rdf:type rdf:Property ;
    rdfs:label 'Collar Adjustment Type' ;
    rdfs:comment 'Indicates whether the table includes adjustments for white-collar, blue-collar, or mixed workforce mortality experience.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:credibilityWeighting rdf:type rdf:Property ;
    rdfs:label 'Credibility Weighting' ;
    rdfs:comment 'Credibility weight assigned to plan-specific experience versus standard table rates (0.0 to 1.0, where 1.0 is full credibility).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disabledMortalityFlag rdf:type rdf:Property ;
    rdfs:label 'Disabled Mortality Flag' ;
    rdfs:comment 'Indicates whether the table is designed for disabled or ill-health populations with higher mortality rates.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentationReference rdf:type rdf:Property ;
    rdfs:label 'Documentation Reference' ;
    rdfs:comment 'Reference to external documentation, research papers, or technical reports describing the mortality table in detail.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:genderApplicability rdf:type rdf:Property ;
    rdfs:label 'Gender Applicability' ;
    rdfs:comment 'Indicates whether the mortality table applies to male, female, unisex, or combined populations.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:generationalProjectionFlag rdf:type rdf:Property ;
    rdfs:label 'Generational Projection Flag' ;
    rdfs:comment 'Indicates whether the table supports generational mortality projections based on year of birth cohorts.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:healthyAnnuitantFlag rdf:type rdf:Property ;
    rdfs:label 'Healthy Annuitant Flag' ;
    rdfs:comment 'Indicates whether the table is designed for healthy annuitants (as opposed to disabled or ill-health populations).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:improvementScaleFlag rdf:type rdf:Property ;
    rdfs:label 'Improvement Scale Flag' ;
    rdfs:comment 'Indicates whether the table includes mortality improvement factors for generational projections.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:longevityRiskAdjustment rdf:type rdf:Property ;
    rdfs:label 'Longevity Risk Adjustment' ;
    rdfs:comment 'Additional adjustment factor applied to account for longevity risk or uncertainty in future mortality improvements.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodologyNotes rdf:type rdf:Property ;
    rdfs:label 'Methodology Notes' ;
    rdfs:comment 'Technical notes describing the actuarial methodology, smoothing techniques, or statistical models used to construct the table.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityBasis rdf:type rdf:Property ;
    rdfs:label 'Mortality Basis' ;
    rdfs:comment 'Underlying data source or experience study used to construct the mortality table (e.g., pension plan experience, population census data).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:populationSegment rdf:type rdf:Property ;
    rdfs:label 'Population Segment' ;
    rdfs:comment 'Specific population segment or cohort the mortality table is designed for (e.g., public sector employees, private sector, annuitants, pensioners).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationYear rdf:type rdf:Property ;
    rdfs:label 'Publication Year' ;
    rdfs:comment 'Year the mortality table was officially published or released by the source organization.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tableCode rdf:type rdf:Property ;
    rdfs:label 'Table Code' ;
    rdfs:comment 'Short alphanumeric code or identifier for the mortality table used in actuarial systems and calculations.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableName rdf:type rdf:Property ;
    rdfs:label 'Table Name' ;
    rdfs:comment 'Official name of the mortality table or improvement scale (e.g., RP-2014, Pri-2012, S3PMA).' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tableType rdf:type rdf:Property ;
    rdfs:label 'Table Type' ;
    rdfs:comment 'Classification of the mortality table indicating its purpose and application method in liability calculations.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageStatus rdf:type rdf:Property ;
    rdfs:label 'Usage Status' ;
    rdfs:comment 'Current usage status of the mortality table within the organizations actuarial valuation processes.' ;
    rdfs:domain ind:MortalityTable ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetLiabilityDuration rdf:type rdf:Property ;
    rdfs:label 'Asset Liability Duration' ;
    rdfs:comment 'Weighted average duration of assets versus liabilities, expressed in years.' ;
    rdfs:domain ind:AssumptionSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assumptionSetStatus rdf:type rdf:Property ;
    rdfs:label 'Assumption Set Status' ;
    rdfs:comment 'Current lifecycle status of the assumption set.' ;
    rdfs:domain ind:AssumptionSet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assumptionSetCode rdf:type rdf:Property ;
