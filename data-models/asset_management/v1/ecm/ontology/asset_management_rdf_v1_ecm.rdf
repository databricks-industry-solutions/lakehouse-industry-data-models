    rdfs:comment 'The month number (1-12) in which the issuers fiscal year ends for financial reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:headquartersAddress rdf:type rdf:Property ;
    rdfs:label 'Headquarters Address' ;
    rdfs:comment 'Full street address of the issuers principal executive offices and headquarters location.' ;
