ind:callPrice rdf:type rdf:Property ;
    rdfs:label 'Call Price' ;
    rdfs:comment 'Price at which the issuer may call (redeem early) the bond, expressed as percentage of par value.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callProtectionEndDate rdf:type rdf:Property ;
    rdfs:label 'Call Protection End Date' ;
    rdfs:comment 'Date after which the issuer may exercise call options; bonds are non-callable before this date.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:convexityToEvent rdf:type rdf:Property ;
    rdfs:label 'Convexity To Event' ;
    rdfs:comment 'Convexity calculated to this specific redemption event, measuring the curvature of price-yield relationship.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationToEvent rdf:type rdf:Property ;
    rdfs:label 'Duration To Event' ;
    rdfs:comment 'Modified duration calculated to this specific redemption event date, measuring interest rate sensitivity.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventDate rdf:type rdf:Property ;
    rdfs:label 'Event Date' ;
    rdfs:comment 'Date on which the maturity, call, put, or sinking fund redemption event is scheduled to occur.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exerciseDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Exercise Decision Date' ;
    rdfs:comment 'Date on which the decision to exercise or not exercise the call or put option was made.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exerciseStatus rdf:type rdf:Property ;
    rdfs:label 'Exercise Status' ;
    rdfs:comment 'Current status of the optional redemption right: pending decision, exercised, not exercised, expired, or cancelled.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Liquidity Impact Flag' ;
    rdfs:comment 'Indicates whether this redemption event has material impact on portfolio liquidity and cash management planning.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:makeWholeProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Make Whole Provision Flag' ;
    rdfs:comment 'Indicates whether a make-whole call provision applies, requiring the issuer to compensate investors for lost future interest.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:makeWholeSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Make Whole Spread Bps' ;
    rdfs:comment 'Spread in basis points over the reference treasury rate used to calculate the make-whole call price.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optionAdjustedSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Option Adjusted Spread Bps' ;
    rdfs:comment 'Option-adjusted spread in basis points, reflecting the credit spread after removing embedded option value.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optionalRedemptionFlag rdf:type rdf:Property ;
    rdfs:label 'Optional Redemption Flag' ;
    rdfs:comment 'Indicates whether the redemption is optional (call or put) versus mandatory (maturity or sinking fund).' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingPrincipalAfter rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal After' ;
    rdfs:comment 'Principal amount remaining outstanding after this redemption event is executed.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPrincipalBefore rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal Before' ;
    rdfs:comment 'Principal amount outstanding immediately before this redemption event.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfExercise rdf:type rdf:Property ;
    rdfs:label 'Probability Of Exercise' ;
    rdfs:comment 'Estimated probability (0-100%) that an optional call or put will be exercised, based on market conditions and analytics.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:putPrice rdf:type rdf:Property ;
    rdfs:label 'Put Price' ;
    rdfs:comment 'Price at which the investor may put (sell back) the bond to the issuer, expressed as percentage of par value.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionAmount rdf:type rdf:Property ;
    rdfs:label 'Redemption Amount' ;
    rdfs:comment 'Expected principal amount to be redeemed at this event, expressed in the security currency.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionPercentage rdf:type rdf:Property ;
    rdfs:label 'Redemption Percentage' ;
    rdfs:comment 'Percentage of the outstanding principal being redeemed at this event, used for partial redemptions.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionPrice rdf:type rdf:Property ;
    rdfs:label 'Redemption Price' ;
    rdfs:comment 'Price per unit (typically percentage of par) at which the security will be redeemed.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinvestmentRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Reinvestment Rate Assumption' ;
    rdfs:comment 'Assumed reinvestment rate for proceeds from this redemption event, used in yield and duration calculations.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinvestmentStrategy rdf:type rdf:Property ;
    rdfs:label 'Reinvestment Strategy' ;
    rdfs:comment 'Planned strategy for reinvesting proceeds from this redemption event.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleType rdf:type rdf:Property ;
    rdfs:label 'Schedule Type' ;
    rdfs:comment 'Type of redemption event: maturity (final redemption), call (issuer option), put (investor option), sinking fund (scheduled partial redemption), amortization (structured paydown), or prepayment (early unscheduled).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sinkingFundScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Sinking Fund Schedule Flag' ;
    rdfs:comment 'Indicates whether this event is part of a mandatory sinking fund schedule requiring periodic partial redemptions.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalProceeds rdf:type rdf:Property ;
    rdfs:label 'Total Proceeds' ;
    rdfs:comment 'Total cash proceeds expected from the redemption event, including principal and accrued interest.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldToEvent rdf:type rdf:Property ;
    rdfs:label 'Yield To Event' ;
    rdfs:comment 'Yield calculated assuming the bond is held until this specific redemption event occurs.' ;
    rdfs:domain ind:MaturitySchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultEventId rdf:type rdf:Property ;
    rdfs:label 'Default Event Id' ;
    rdfs:comment 'Unique identifier for the credit default event record.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedBondPositions rdf:type rdf:Property ;
    rdfs:label 'Affected Bond Positions' ;
    rdfs:comment 'Number of direct bond or fixed income security positions in the portfolio affected by this credit event.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:affectedCdsContracts rdf:type rdf:Property ;
    rdfs:label 'Affected Cds Contracts' ;
    rdfs:comment 'Number of credit default swap contracts in the portfolio directly affected by this credit event and subject to settlement or valuation adjustment.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auctionDate rdf:type rdf:Property ;
    rdfs:label 'Auction Date' ;
    rdfs:comment 'Date of the ISDA credit event auction used to determine the final recovery price for cash settlement of credit default swaps.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auctionFinalPrice rdf:type rdf:Property ;
    rdfs:label 'Auction Final Price' ;
    rdfs:comment 'Final recovery price determined by the ISDA credit event auction, expressed as a percentage of par value (e.g., 40.00 represents 40% recovery).' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contagionRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Contagion Risk Flag' ;
    rdfs:comment 'Indicates whether the credit event poses systemic or contagion risk to other portfolio holdings, counterparties, or market segments, requiring heightened monitoring.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditRatingAtEvent rdf:type rdf:Property ;
    rdfs:label 'Credit Rating At Event' ;
    rdfs:comment 'The credit rating assigned to the reference entity or obligation immediately prior to or at the time of the credit event, typically from S&P, Moody\'s, or Fitch.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dcDeterminationFlag rdf:type rdf:Property ;
    rdfs:label 'Dc Determination Flag' ;
    rdfs:comment 'Indicates whether the credit event was formally determined by an ISDA regional Determinations Committee (true) or identified through internal credit monitoring (false).' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dcRegion rdf:type rdf:Property ;
    rdfs:label 'Dc Region' ;
    rdfs:comment 'Geographic region of the ISDA Determinations Committee that issued the credit event determination: Americas, EMEA, Asia, Japan, or Australia/New Zealand.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Estimated Loss Amount' ;
    rdfs:comment 'Estimated monetary loss resulting from the credit event, calculated as exposure at default multiplied by loss given default.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventIdentifier rdf:type rdf:Property ;
    rdfs:label 'Event Identifier' ;
    rdfs:comment 'Externally-known unique identifier or reference number for this credit event, often assigned by ISDA Determinations Committee or market infrastructure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureAtDefault rdf:type rdf:Property ;
    rdfs:label 'Exposure At Default' ;
    rdfs:comment 'Total notional exposure to the reference entity or obligation at the time of the credit event, across all positions and instruments in the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureCurrency rdf:type rdf:Property ;
    rdfs:label 'Exposure Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the exposure at default amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Ic Notification Date' ;
    rdfs:comment 'Date on which the Investment Committee was formally notified of the credit event and its portfolio impact.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalCounselEngaged rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Engaged' ;
    rdfs:comment 'Indicates whether external legal counsel has been engaged to represent the fund\'s interests in bankruptcy proceedings, restructuring negotiations, or litigation related to this credit event.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossCurrency rdf:type rdf:Property ;
    rdfs:label 'Loss Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the estimated and realized loss amounts.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicInformationSource rdf:type rdf:Property ;
    rdfs:label 'Public Information Source' ;
    rdfs:comment 'Citation of the publicly available information source used to verify the credit event, as required by ISDA definitions (e.g., Bloomberg, Reuters, regulatory filing, court document).' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realizedLossAmount rdf:type rdf:Property ;
    rdfs:label 'Realized Loss Amount' ;
    rdfs:comment 'Actual realized loss after settlement, workout, or liquidation of the defaulted position. Null until final settlement is completed.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:restructuringType rdf:type rdf:Property ;
    rdfs:label 'Restructuring Type' ;
    rdfs:comment 'Type of restructuring clause applicable to the credit event: Modified Restructuring (Mod R), Modified Modified Restructuring (Mod Mod R), No Restructuring, or Full Restructuring. Relevant for restructuring credit events.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sovereignFlag rdf:type rdf:Property ;
    rdfs:label 'Sovereign Flag' ;
    rdfs:comment 'Indicates whether the credit event involves a sovereign government entity (true) or a corporate/financial institution entity (false).' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggerEventDescription rdf:type rdf:Property ;
    rdfs:label 'Trigger Event Description' ;
    rdfs:comment 'Detailed narrative description of the specific event or circumstances that triggered the credit event determination, including relevant facts and timeline.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workoutStrategy rdf:type rdf:Property ;
    rdfs:label 'Workout Strategy' ;
    rdfs:comment 'Summary of the planned or executed workout strategy for the defaulted position: hold for recovery, participate in restructuring, sell at market, legal action, or other approach.' ;
    rdfs:domain ind:DefaultEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sofrRateId rdf:type rdf:Property ;
    rdfs:label 'Sofr Rate Id' ;
    rdfs:comment 'Unique identifier for the SOFR rate record.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendar rdf:type rdf:Property ;
    rdfs:label 'Calendar' ;
    rdfs:comment 'Holiday calendar used to determine business days for SOFR rate publication and application.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fallbackRateFlag rdf:type rdf:Property ;
    rdfs:label 'Fallback Rate Flag' ;
    rdfs:comment 'Indicates whether this rate is being used as a fallback replacement for LIBOR (London Interbank Offered Rate) or another discontinued benchmark.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indexValue rdf:type rdf:Property ;
    rdfs:label 'Index Value' ;
    rdfs:comment 'Cumulative compounded SOFR index value used for calculating interest accruals on floating rate instruments.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile1 rdf:type rdf:Property ;
    rdfs:label 'Percentile 1' ;
    rdfs:comment 'First percentile of the rate distribution used in SOFR calculation, providing insight into rate dispersion.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile25 rdf:type rdf:Property ;
    rdfs:label 'Percentile 25' ;
    rdfs:comment 'Twenty-fifth percentile of the rate distribution used in SOFR calculation.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile75 rdf:type rdf:Property ;
    rdfs:label 'Percentile 75' ;
    rdfs:comment 'Seventy-fifth percentile of the rate distribution used in SOFR calculation.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile99 rdf:type rdf:Property ;
    rdfs:label 'Percentile 99' ;
    rdfs:comment 'Ninety-ninth percentile of the rate distribution used in SOFR calculation.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateBps rdf:type rdf:Property ;
    rdfs:label 'Rate Bps' ;
    rdfs:comment 'The SOFR rate expressed in basis points for fixed income analytics (e.g., 500 bps for 5%).' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateValue rdf:type rdf:Property ;
    rdfs:label 'Rate Value' ;
    rdfs:comment 'The published SOFR rate value expressed as a decimal percentage (e.g., 0.05 for 5%).' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionFlag rdf:type rdf:Property ;
    rdfs:label 'Revision Flag' ;
    rdfs:comment 'Indicates whether this rate has been revised after initial publication (True if revised, False if original).' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Revision Timestamp' ;
    rdfs:comment 'Timestamp of the most recent revision to this rate record, if applicable.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:source rdf:type rdf:Property ;
    rdfs:label 'Source' ;
    rdfs:comment 'Source system or vendor from which the SOFR rate was obtained (Federal Reserve, CME, Bloomberg, Refinitiv).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spreadToFedFunds rdf:type rdf:Property ;
    rdfs:label 'Spread To Fed Funds' ;
    rdfs:comment 'Spread in basis points between SOFR and the Federal Funds effective rate.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spreadToOis rdf:type rdf:Property ;
    rdfs:label 'Spread To Ois' ;
    rdfs:comment 'Spread in basis points between SOFR and the corresponding OIS rate, used for relative value analysis.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenorDays rdf:type rdf:Property ;
    rdfs:label 'Tenor Days' ;
    rdfs:comment 'Number of days in the tenor period for term SOFR rates (e.g., 30, 90, 180, 360).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:volumeBillionsUsd rdf:type rdf:Property ;
    rdfs:label 'Volume Billions Usd' ;
    rdfs:comment 'Total transaction volume in billions of USD underlying the SOFR calculation for overnight rates.' ;
    rdfs:domain ind:SofrRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditQualityMinimum rdf:type rdf:Property ;
    rdfs:label 'Credit Quality Minimum' ;
    rdfs:comment 'Minimum credit rating threshold for investments (e.g., BBB-, B+, unrated allowed).' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derivativesAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Derivatives Allowed Flag' ;
    rdfs:comment 'Indicates whether derivatives (CDS, interest rate swaps, options) are permitted within this mandate.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentReference rdf:type rdf:Property ;
    rdfs:label 'Document Reference' ;
    rdfs:comment 'Reference identifier or URL to the formal mandate documentation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMaximumYears rdf:type rdf:Property ;
    rdfs:label 'Duration Maximum Years' ;
    rdfs:comment 'Maximum allowable portfolio duration in years.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationMinimumYears rdf:type rdf:Property ;
    rdfs:label 'Duration Minimum Years' ;
    rdfs:comment 'Minimum allowable portfolio duration in years.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationTargetYears rdf:type rdf:Property ;
    rdfs:label 'Duration Target Years' ;
    rdfs:comment 'Target portfolio duration in years for interest rate risk management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgExclusionList rdf:type rdf:Property ;
    rdfs:label 'Esg Exclusion List' ;
    rdfs:comment 'Comma-separated list of sectors or activities excluded based on ESG criteria (e.g., tobacco, weapons, fossil fuels).' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicConcentrationLimitPct rdf:type rdf:Property ;
    rdfs:label 'Geographic Concentration Limit Pct' ;
    rdfs:comment 'Maximum percentage of portfolio that can be allocated to any single country or region.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hyAllocationMaximumPct rdf:type rdf:Property ;
    rdfs:label 'Hy Allocation Maximum Pct' ;
    rdfs:comment 'Maximum percentage of portfolio that can be high yield securities.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hyAllocationMinimumPct rdf:type rdf:Property ;
    rdfs:label 'Hy Allocation Minimum Pct' ;
    rdfs:comment 'Minimum percentage of portfolio that must be high yield securities.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:igAllocationMaximumPct rdf:type rdf:Property ;
    rdfs:label 'Ig Allocation Maximum Pct' ;
    rdfs:comment 'Maximum percentage of portfolio that can be investment grade rated securities.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:igAllocationMinimumPct rdf:type rdf:Property ;
    rdfs:label 'Ig Allocation Minimum Pct' ;
    rdfs:comment 'Minimum percentage of portfolio that must be investment grade rated securities.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leverageAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Leverage Allowed Flag' ;
    rdfs:comment 'Indicates whether leverage is permitted within this mandate.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leverageMaximumRatio rdf:type rdf:Property ;
    rdfs:label 'Leverage Maximum Ratio' ;
    rdfs:comment 'Maximum leverage ratio allowed (e.g., 1.5 means 150% gross exposure to NAV).' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Liquidity Threshold Pct' ;
    rdfs:comment 'Percentage of portfolio that must meet the liquidity requirement timeframe.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Allocation Amount' ;
    rdfs:comment 'Maximum investment amount constraint for this mandate in base currency.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Allocation Amount' ;
    rdfs:comment 'Minimum investment amount constraint for this mandate in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTargetReturnPct rdf:type rdf:Property ;
    rdfs:label 'Performance Target Return Pct' ;
    rdfs:comment 'Target annualized return objective for the mandate expressed as a percentage.' ;
    rdfs:domain ind:CreditMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTargetType rdf:type rdf:Property ;
