    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:highPrice rdf:type rdf:Property ;
    rdfs:label 'High Price' ;
    rdfs:comment 'Highest intraday price reached during the trading session.' ;
