    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:swapFarLegDate rdf:type rdf:Property ;
    rdfs:label 'Swap Far Leg Date' ;
    rdfs:comment 'Settlement date for the far leg of an FX swap transaction.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:swapNearLegDate rdf:type rdf:Property ;
    rdfs:label 'Swap Near Leg Date' ;
    rdfs:comment 'Settlement date for the near leg of an FX swap transaction.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradePurpose rdf:type rdf:Property ;
    rdfs:label 'Trade Purpose' ;
    rdfs:comment 'Business purpose for executing the FX trade: hedging currency exposure, funding investments, repatriating proceeds, managing liquidity, or settling obligations.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
