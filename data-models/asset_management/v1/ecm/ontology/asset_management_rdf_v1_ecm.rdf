    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:repoTransactionId rdf:type rdf:Property ;
    rdfs:label 'Repo Transaction Id' ;
    rdfs:comment 'System-generated unique identifier for the repo transaction record.' ;
    rdfs:domain ind:RepoTransaction ;
