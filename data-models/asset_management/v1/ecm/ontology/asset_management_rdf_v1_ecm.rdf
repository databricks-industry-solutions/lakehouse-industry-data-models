    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:apiEndpointUrl rdf:type rdf:Property ;
    rdfs:label 'Api Endpoint Url' ;
    rdfs:comment 'Base URL for the API endpoint used to retrieve pricing data from this source. Confidential for security purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassCoverage rdf:type rdf:Property ;
    rdfs:label 'Asset Class Coverage' ;
    rdfs:comment 'Comma-separated list of asset classes covered by this source (e.g., equities, fixed_income, derivatives, real_estate, private_equity).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authenticationMethod rdf:type rdf:Property ;
    rdfs:label 'Authentication Method' ;
    rdfs:comment 'Method used to authenticate with the quote source API for data retrieval.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessDaysCalendar rdf:type rdf:Property ;
    rdfs:label 'Business Days Calendar' ;
    rdfs:comment 'Reference to the holiday calendar used by this source to determine business days for pricing availability.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactName rdf:type rdf:Property ;
    rdfs:label 'Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the quote source provider for operational inquiries and escalations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currencyCoverage rdf:type rdf:Property ;
    rdfs:label 'Currency Coverage' ;
    rdfs:comment 'Comma-separated list of ISO 4217 currency codes for which this source provides pricing data (e.g., USD, EUR, GBP, JPY).' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cutOffTime rdf:type rdf:Property ;
    rdfs:label 'Cut Off Time' ;
    rdfs:comment 'Daily cut-off time (HH:MM format in source timezone) after which prices are considered next-day values for NAV calculation.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFeedFormat rdf:type rdf:Property ;
    rdfs:label 'Data Feed Format' ;
    rdfs:comment 'Technical format in which pricing data is received from this source. Used for integration and parsing configuration.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverage rdf:type rdf:Property ;
