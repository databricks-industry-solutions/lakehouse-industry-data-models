ind:processedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Processed By Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Margin call processing requires audit trail of which employee processed/approved the call. Critical for operational risk controls, regulatory compliance, and segregation of duties in' ;
    rdfs:domain ind:MarginCall ;
