ind:windowBefore rdf:type rdf:Property ;
    rdfs:label 'Window Before' ;
    rdfs:comment 'description' ;
    rdfs:domain ind:ScheduledActivityInstance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

