    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenantType rdf:type rdf:Property ;
    rdfs:label 'Tenant Type' ;
    rdfs:comment 'Classification of tenant by strategic importance and lease characteristics within the portfolio.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLeasedGlaSqft rdf:type rdf:Property ;
    rdfs:label 'Total Leased Gla Sqft' ;
    rdfs:comment 'The total gross leasable area in square feet currently leased by this tenant across all properties in the portfolio.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingName rdf:type rdf:Property ;
    rdfs:label 'Trading Name' ;
    rdfs:comment 'The commercial or trading name under which the tenant operates, if different from legal name.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realestateCapexProgramId rdf:type rdf:Property ;
    rdfs:label 'Realestate Capex Program Id' ;
    rdfs:comment 'Unique identifier for the capital expenditure program record.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RealestateCapexProgram .

ind:contractorId rdf:type rdf:Property ;
    rdfs:label 'Contractor Id' ;
    rdfs:comment 'Reference to the contractor or vendor entity responsible for executing the capital expenditure program.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contractor .

ind:actualCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Completion Date' ;
    rdfs:comment 'Actual date when all capital expenditure program activities were completed and the program was closed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
