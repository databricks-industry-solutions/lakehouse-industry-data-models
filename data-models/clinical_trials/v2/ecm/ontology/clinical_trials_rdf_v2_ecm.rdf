    rdfs:domain ind:WhodrugAtcLevel1 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcClassificationSystem rdf:type rdf:Property ;
    rdfs:label 'Atc Classification System' ;
    rdfs:comment 'Name of the classification system that governs this term, identifying it as the WHO Anatomical Therapeutic Chemical classification.' ;
    rdfs:domain ind:WhodrugAtcLevel1 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcLevel1Name rdf:type rdf:Property ;
    rdfs:label 'Atc Level1 Name' ;
    rdfs:comment 'Official textual name of the anatomical main group corresponding to the ATC level 1 code (e.g., Alimentary tract and metabolism).' ;
    rdfs:domain ind:WhodrugAtcLevel1 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:codeDescription rdf:type rdf:Property ;
    rdfs:label 'Code Description' ;
    rdfs:comment 'Extended descriptive text explaining the scope and therapeutic grouping covered by this ATC level 1 anatomical main group.' ;
    rdfs:domain ind:WhodrugAtcLevel1 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceAuthority rdf:type rdf:Property ;
    rdfs:label 'Source Authority' ;
    rdfs:comment 'Organization responsible for assigning and maintaining this ATC classification term, typically the WHO Collaborating Centre for Drug Statistics Methodology.' ;
    rdfs:domain ind:WhodrugAtcLevel1 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whodrugDictionaryVersion rdf:type rdf:Property ;
    rdfs:label 'Whodrug Dictionary Version' ;
    rdfs:comment 'Version of the WHODrug Global dictionary release from which this ATC level 1 term was sourced (e.g., WHODrug B3 format March 2024).' ;
    rdfs:domain ind:Terminology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whodrugAtcLevel2Id rdf:type rdf:Property ;
    rdfs:label 'Whodrug Atc Level2 Id' ;
    rdfs:comment 'Primary key for whodrug_atc_level2' ;
    rdfs:domain ind:Terminology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WhodrugAtcLevel2 .

ind:atcClassificationHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Atc Classification Hierarchy Level' ;
    rdfs:comment 'Numeric depth of this record within the five-level ATC hierarchy; fixed at 2 for therapeutic subgroup entries.' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:atcLanguageCode rdf:type rdf:Property ;
    rdfs:label 'Atc Language Code' ;
    rdfs:comment 'ISO 639-1 two-letter language code indicating the language of the therapeutic subgroup name and description (e.g., \'en\').' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcLevel2Name rdf:type rdf:Property ;
    rdfs:label 'Atc Level2 Name' ;
    rdfs:comment 'Human-readable name/description of the ATC Level 2 therapeutic subgroup (e.g., \'Diuretics\').' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOfficialWhoAssigned rdf:type rdf:Property ;
    rdfs:label 'Is Official Who Assigned' ;
    rdfs:comment 'Indicates whether this ATC Level 2 code was officially assigned by the WHO Collaborating Centre (true) versus a provisional or sponsor-assigned classification (false).' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisionNote rdf:type rdf:Property ;
    rdfs:label 'Revision Note' ;
    rdfs:comment 'Free-text note describing changes applied to this ATC Level 2 entry in the current dictionary release (e.g., name change, code reclassification).' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByAtcLevel2Code rdf:type rdf:Property ;
    rdfs:label 'Superseded By Atc Level2 Code' ;
    rdfs:comment 'The ATC Level 2 code that replaces this entry when it has been reclassified or merged; null if not superseded.' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:therapeuticSubgroupDescription rdf:type rdf:Property ;
    rdfs:label 'Therapeutic Subgroup Description' ;
    rdfs:comment 'Extended descriptive text explaining the scope and intended therapeutic use of medicinal products classified under this ATC Level 2 subgroup.' ;
    rdfs:domain ind:WhodrugAtcLevel2 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:whodrugAtcLevel3Id rdf:type rdf:Property ;
    rdfs:label 'Whodrug Atc Level3 Id' ;
    rdfs:comment 'Primary key for whodrug_atc_level3' ;
    rdfs:domain ind:Terminology ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:WhodrugAtcLevel3 .

ind:atcCodeHierarchyPath rdf:type rdf:Property ;
    rdfs:label 'Atc Code Hierarchy Path' ;
    rdfs:comment 'The concatenated ancestry path of ATC codes from level 1 through level 3 (e.g., A>A01>A01A) enabling hierarchical navigation.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcLevel3Name rdf:type rdf:Property ;
    rdfs:label 'Atc Level3 Name' ;
    rdfs:comment 'The human-readable textual description of the therapeutic/pharmacological subgroup represented by the ATC level 3 code.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:atcLevelNumber rdf:type rdf:Property ;
    rdfs:label 'Atc Level Number' ;
    rdfs:comment 'The numeric depth of this record within the ATC hierarchy; fixed to 3 for the therapeutic/pharmacological subgroup level.' ;
    rdfs:domain ind:Terminology ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:codingNotes rdf:type rdf:Property ;
    rdfs:label 'Coding Notes' ;
    rdfs:comment 'Free-text guidance or usage notes supporting consistent coding and interpretation of this ATC level 3 therapeutic subgroup.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dictionaryFormatType rdf:type rdf:Property ;
    rdfs:label 'Dictionary Format Type' ;
    rdfs:comment 'The WHODrug dictionary format in which the ATC classification is distributed, such as the B2, B3, or C3 format.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:medicinalProductCount rdf:type rdf:Property ;
    rdfs:label 'Medicinal Product Count' ;
    rdfs:comment 'The number of WHODrug medicinal products classified under this ATC level 3 subgroup within the current dictionary version.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:validUntilDate rdf:type rdf:Property ;
    rdfs:label 'Valid Until Date' ;
    rdfs:comment 'The date on which this ATC level 3 classification entry ceases to be effective; null when the entry remains current.' ;
    rdfs:domain ind:WhodrugAtcLevel3 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cdiscSubmissionValue rdf:type rdf:Property ;
