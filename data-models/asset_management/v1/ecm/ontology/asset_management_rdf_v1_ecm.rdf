    rdfs:comment 'Date when the financial statements were filed with regulatory authorities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financingCashFlow rdf:type rdf:Property ;
