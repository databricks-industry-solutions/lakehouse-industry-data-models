ind:assetCusip rdf:type rdf:Property ;
    rdfs:label 'Asset Cusip' ;
    rdfs:comment 'North American security identifier for the collateral asset, when applicable.' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPositionStatus rdf:type rdf:Property ;
    rdfs:label 'Collateral Position Status' ;
    rdfs:comment 'Current lifecycle state of the position (e.g., active, inactive, closed).' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPositionDescription rdf:type rdf:Property ;
    rdfs:label 'Collateral Position Description' ;
    rdfs:comment 'Free-form text providing additional context about the position.' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Eligible Flag' ;
    rdfs:comment 'True if the asset meets eligibility criteria for posting under the agreement.' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:label rdf:type rdf:Property ;
    rdfs:label 'Label' ;
    rdfs:comment 'Human-readable label describing the collateral position (e.g., "Cash Collateral for Counterparty X on 2023-10-01").' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netMarketValue rdf:type rdf:Property ;
    rdfs:label 'Net Market Value' ;
    rdfs:comment 'Market value after applying the haircut (market_value * (1-haircut_percent/100)).' ;
