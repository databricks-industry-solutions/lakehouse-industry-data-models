    rdfs:comment 'Flag indicating whether this tax lot is subject to wash sale rules disallowing loss deduction.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withholdingTax rdf:type rdf:Property ;
