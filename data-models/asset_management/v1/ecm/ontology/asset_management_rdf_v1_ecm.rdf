    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactPhone rdf:type rdf:Property ;
    rdfs:label 'Contact Phone' ;
    rdfs:comment 'Primary telephone number for official LPAC communications with the member.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseReimbursementEligible rdf:type rdf:Property ;
    rdfs:label 'Expense Reimbursement Eligible' ;
    rdfs:comment 'Indicates whether the member is eligible for reimbursement of travel and meeting-related expenses.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetingAttendanceRequired rdf:type rdf:Property ;
    rdfs:label 'Meeting Attendance Required' ;
    rdfs:comment 'Indicates whether the member is required to attend LPAC meetings per governance terms.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberName rdf:type rdf:Property ;
    rdfs:label 'Member Name' ;
    rdfs:comment 'Full name of the individual representing the LP on the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumAttendancePercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Attendance Percentage' ;
    rdfs:comment 'Minimum percentage of meetings the member must attend to maintain good standing, as defined in LPA.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:removalDate rdf:type rdf:Property ;
    rdfs:label 'Removal Date' ;
    rdfs:comment 'Date on which the member was removed from the advisory committee, if applicable.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:removalReason rdf:type rdf:Property ;
    rdfs:label 'Removal Reason' ;
    rdfs:comment 'Explanation or justification for the members removal from the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalEligible rdf:type rdf:Property ;
    rdfs:label 'Renewal Eligible' ;
    rdfs:comment 'Indicates whether the member is eligible for term renewal upon expiration.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:representationBasis rdf:type rdf:Property ;
    rdfs:label 'Representation Basis' ;
    rdfs:comment 'Criterion or basis on which the member was selected to represent LPs on the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resignationDate rdf:type rdf:Property ;
    rdfs:label 'Resignation Date' ;
    rdfs:comment 'Date on which the member formally resigned from the advisory committee, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:seatType rdf:type rdf:Property ;
    rdfs:label 'Seat Type' ;
    rdfs:comment 'Classification of the committee seat indicating voting rights and participation level.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termDurationYears rdf:type rdf:Property ;
    rdfs:label 'Term Duration Years' ;
    rdfs:comment 'Length of the committee term in years, typically defined in the LPA governance provisions.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termEndDate rdf:type rdf:Property ;
    rdfs:label 'Term End Date' ;
    rdfs:comment 'Scheduled expiration date of the members current term on the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:termStartDate rdf:type rdf:Property ;
    rdfs:label 'Term Start Date' ;
    rdfs:comment 'Effective start date of the members current term on the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:votingWeight rdf:type rdf:Property ;
    rdfs:label 'Voting Weight' ;
    rdfs:comment 'Proportional voting weight assigned to the member, typically expressed as a decimal fraction of total votes.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalAccountId rdf:type rdf:Property ;
    rdfs:label 'Capital Account Id' ;
    rdfs:comment 'Unique identifier for the LP capital account ledger record within a PE fund.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountStatus rdf:type rdf:Property ;
    rdfs:label 'Account Status' ;
    rdfs:comment 'Current lifecycle status of the capital account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carriedInterestAllocation rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Allocation' ;
    rdfs:comment 'Carried interest allocated to the GP from this LP capital account during the reporting period, subject to hurdle and waterfall provisions.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpAmount rdf:type rdf:Property ;
    rdfs:label 'Catch Up Amount' ;
    rdfs:comment 'Cumulative catch-up allocation to the GP after the preferred return threshold is met, per the LPA waterfall structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackObligation rdf:type rdf:Property ;
    rdfs:label 'Clawback Obligation' ;
    rdfs:comment 'Estimated clawback obligation owed by the LP to the fund if the fund were liquidated at current valuations, per waterfall calculations.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingBalance rdf:type rdf:Property ;
    rdfs:label 'Closing Balance' ;
    rdfs:comment 'Capital account balance at the end of the reporting period, calculated as opening balance plus contributions and income allocations minus distributions and expense allocations.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionsInPeriod rdf:type rdf:Property ;
    rdfs:label 'Contributions In Period' ;
    rdfs:comment 'Total capital called and contributed by the LP during the reporting period, including capital calls and recallable distributions.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDistributions rdf:type rdf:Property ;
    rdfs:label 'Cumulative Distributions' ;
    rdfs:comment 'Total distributions paid to the LP since fund inception, including return of capital and profit distributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionsInPeriod rdf:type rdf:Property ;
    rdfs:label 'Distributions In Period' ;
    rdfs:comment 'Total distributions paid to the LP during the reporting period, including return of capital and profit distributions.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxRateToCommitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Fx Rate To Commitment Currency' ;
    rdfs:comment 'Exchange rate applied to convert reporting currency amounts to commitment currency, if different.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isFinalStatement rdf:type rdf:Property ;
    rdfs:label 'Is Final Statement' ;
    rdfs:comment 'Indicates whether this is the final capital account statement upon fund liquidation and closure.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:k1IssuedDate rdf:type rdf:Property ;
    rdfs:label 'K1 Issued Date' ;
    rdfs:comment 'Date the Schedule K-1 tax form was issued to the LP for this capital account, applicable for US tax-reporting funds.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managementFeeAllocation rdf:type rdf:Property ;
    rdfs:label 'Management Fee Allocation' ;
    rdfs:comment 'Management fees charged to the LP capital account during the reporting period per the LPA terms.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIncomeAllocation rdf:type rdf:Property ;
    rdfs:label 'Net Income Allocation' ;
    rdfs:comment 'Net income or loss allocated to the LP capital account during the reporting period, reflecting the LPs share of fund performance.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openingBalance rdf:type rdf:Property ;
    rdfs:label 'Opening Balance' ;
    rdfs:comment 'Capital account balance at the beginning of the reporting period.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherExpensesAllocation rdf:type rdf:Property ;
    rdfs:label 'Other Expenses Allocation' ;
    rdfs:comment 'Other fund-level expenses allocated to the LP capital account during the period, excluding management fees.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnEarned rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Earned' ;
    rdfs:comment 'Cumulative preferred return earned by the LP to date, calculated based on the hurdle rate and capital account balance over time.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnThreshold rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Threshold' ;
    rdfs:comment 'Cumulative preferred return amount that must be achieved before carried interest is allocated to the GP, per the LPA hurdle rate.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recallableDistributions rdf:type rdf:Property ;
    rdfs:label 'Recallable Distributions' ;
    rdfs:comment 'Cumulative distributions subject to clawback provisions per the LPA, which may be recalled by the GP under certain conditions.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sideLetterTerms rdf:type rdf:Property ;
    rdfs:label 'Side Letter Terms' ;
    rdfs:comment 'Summary of any side letter provisions or special terms applicable to this LP capital account that differ from the standard LPA.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementDate rdf:type rdf:Property ;
    rdfs:label 'Statement Date' ;
    rdfs:comment 'Date the capital account statement was generated and issued to the LP.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxBasis rdf:type rdf:Property ;
    rdfs:label 'Tax Basis' ;
    rdfs:comment 'Tax basis of the LP capital account for tax reporting purposes, may differ from GAAP capital account balance.' ;
    rdfs:domain ind:CapitalAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFeeInvoiceId rdf:type rdf:Property ;
    rdfs:label 'Management Fee Invoice Id' ;
    rdfs:comment 'Unique identifier for the management fee invoice record.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:invoiceRecipientEntityId rdf:type rdf:Property ;
    rdfs:label 'Invoice Recipient Entity Id' ;
    rdfs:comment 'Reference to the LP entity (pension fund) that received and is responsible for paying this invoice.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:calculationMethodology rdf:type rdf:Property ;
    rdfs:label 'Calculation Methodology' ;
    rdfs:comment 'Description of the methodology used to calculate the management fee for this period, including any special provisions or adjustments per the LPA.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCenter rdf:type rdf:Property ;
    rdfs:label 'Cost Center' ;
    rdfs:comment 'Cost center or business unit to which this management fee is allocated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeFlag rdf:type rdf:Property ;
    rdfs:label 'Dispute Flag' ;
    rdfs:comment 'Indicates whether this invoice is under dispute by the LP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeReason rdf:type rdf:Property ;
    rdfs:label 'Dispute Reason' ;
    rdfs:comment 'Explanation of the reason for disputing this management fee invoice, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeBasis rdf:type rdf:Property ;
    rdfs:label 'Fee Basis' ;
    rdfs:comment 'The capital base on which the management fee rate is applied: committed capital, invested capital, Net Asset Value (NAV), cost basis, or hybrid structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Basis Amount' ;
    rdfs:comment 'The capital amount (in fund currency) on which the management fee rate is applied for this period.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feePeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Fee Period End Date' ;
    rdfs:comment 'End date of the period for which the management fee is being charged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feePeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Fee Period Start Date' ;
    rdfs:comment 'Start date of the period for which the management fee is being charged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeRate rdf:type rdf:Property ;
    rdfs:label 'Fee Rate' ;
    rdfs:comment 'The annualized management fee rate applied to the fee basis, expressed as a decimal (e.g., 0.0200 for 2.00%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Fee Amount' ;
    rdfs:comment 'The gross management fee amount calculated before any offsets or credits are applied.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Date' ;
    rdfs:comment 'Date on which the GP issued the management fee invoice.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:invoiceDocumentUri rdf:type rdf:Property ;
    rdfs:label 'Invoice Document Uri' ;
    rdfs:comment 'URI or file path to the original invoice document received from the GP.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Invoice Number' ;
    rdfs:comment 'Unique invoice number assigned by the General Partner (GP) for this management fee billing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFeeOffset rdf:type rdf:Property ;
    rdfs:label 'Monitoring Fee Offset' ;
    rdfs:comment 'Offset credit applied from monitoring fees received by the GP from portfolio companies, reducing the net management fee payable by the Limited Partner (LP).' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Net Fee Amount' ;
    rdfs:comment 'The net management fee amount payable by the LP after all offsets and credits have been applied.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherFeeOffset rdf:type rdf:Property ;
    rdfs:label 'Other Fee Offset' ;
    rdfs:comment 'Any other fee offsets or credits applied to reduce the net management fee payable by the LP.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReference rdf:type rdf:Property ;
    rdfs:label 'Payment Reference' ;
    rdfs:comment 'Reference number or transaction identifier for the payment made against this invoice.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionDate rdf:type rdf:Property ;
    rdfs:label 'Resolution Date' ;
    rdfs:comment 'Date on which the dispute was resolved.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionNotes rdf:type rdf:Property ;
    rdfs:label 'Resolution Notes' ;
    rdfs:comment 'Notes describing the outcome and resolution of the dispute.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalFeeOffset rdf:type rdf:Property ;
    rdfs:label 'Total Fee Offset' ;
    rdfs:comment 'Total of all fee offsets (monitoring, transaction, and other) applied to the gross management fee.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionFeeOffset rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Offset' ;
    rdfs:comment 'Offset credit applied from transaction fees received by the GP from portfolio companies, reducing the net management fee payable by the LP.' ;
    rdfs:domain ind:ManagementFeeInvoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privateequityBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Privateequity Benchmark Id' ;
    rdfs:comment 'Unique identifier for the privateequity_benchmark data product (auto-inserted during validation).' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedForReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Approved For Reporting Flag' ;
    rdfs:comment 'Indicates whether this benchmark has been approved by internal governance for use in official performance reporting to beneficiaries and regulators.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataLagQuarters rdf:type rdf:Property ;
    rdfs:label 'Data Lag Quarters' ;
    rdfs:comment 'Number of quarters of reporting lag inherent in the benchmark data due to fund reporting cycles.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataQualityRating rdf:type rdf:Property ;
    rdfs:label 'Data Quality Rating' ;
    rdfs:comment 'Internal assessment of the benchmark data quality based on completeness, accuracy, and timeliness.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceUrl rdf:type rdf:Property ;
    rdfs:label 'Data Source Url' ;
    rdfs:comment 'Web address or reference link to the providers official benchmark documentation and data access portal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCriteria rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria' ;
    rdfs:comment 'Specific criteria that disqualify funds from inclusion in the benchmark, such as non-standard fee structures or incomplete reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:family rdf:type rdf:Property ;
    rdfs:label 'Family' ;
    rdfs:comment 'Name of the broader benchmark family or suite to which this benchmark belongs, enabling grouping of related benchmarks.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundSizeCategory rdf:type rdf:Property ;
    rdfs:label 'Fund Size Category' ;
    rdfs:comment 'Size classification of funds included in the benchmark, such as Small (<$500M), Mid ($500M-$2B), Large (>$2B), or All Sizes.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionCriteria rdf:type rdf:Property ;
    rdfs:label 'Inclusion Criteria' ;
    rdfs:comment 'Specific criteria that funds must meet to be included in the benchmark universe, such as minimum fund size, reporting standards, or geographic domicile.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Update Date' ;
    rdfs:comment 'Date when the benchmark data was most recently updated by the provider.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseType rdf:type rdf:Property ;
    rdfs:label 'License Type' ;
    rdfs:comment 'Type of data license governing the use and distribution of benchmark data within the organization.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netOrGross rdf:type rdf:Property ;
    rdfs:label 'Net Or Gross' ;
    rdfs:comment 'Indicates whether benchmark returns are net of fees (Net) or gross of fees (Gross).' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfFunds rdf:type rdf:Property ;
    rdfs:label 'Number Of Funds' ;
    rdfs:comment 'Count of individual funds included in the benchmark calculation, indicating sample size and statistical robustness.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:primaryUseCase rdf:type rdf:Property ;
    rdfs:label 'Primary Use Case' ;
    rdfs:comment 'Primary business purpose for which this benchmark is used, such as performance attribution, manager selection, or portfolio construction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerName rdf:type rdf:Property ;
    rdfs:label 'Provider Name' ;
    rdfs:comment 'Organization that publishes and maintains the benchmark data. [ENUM-REF-CANDIDATE: Cambridge Associates|Preqin|Burgiss|MSCI|PitchBook|State Street|Custom — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicMarketIndex rdf:type rdf:Property ;
    rdfs:label 'Public Market Index' ;
    rdfs:comment 'Name of the public market index used for Public Market Equivalent (PME) calculations, such as S&P 500, MSCI World, or Russell 2000.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quartileAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Quartile Available Flag' ;
    rdfs:comment 'Indicates whether quartile breakdowns (top quartile, median, bottom quartile) are available for this benchmark.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restatementFlag rdf:type rdf:Property ;
    rdfs:label 'Restatement Flag' ;
    rdfs:comment 'Indicates whether historical benchmark data has been restated or revised by the provider.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:strategyFocus rdf:type rdf:Property ;
    rdfs:label 'Strategy Focus' ;
    rdfs:comment 'Investment strategy or sub-strategy focus of the benchmark, such as early-stage venture, mega-buyout, or sector-specific strategies.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorshipBiasAdjustedFlag rdf:type rdf:Property ;
    rdfs:label 'Survivorship Bias Adjusted Flag' ;
    rdfs:comment 'Indicates whether the benchmark has been adjusted to account for survivorship bias by including defunct or liquidated funds.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:updateFrequency rdf:type rdf:Property ;
    rdfs:label 'Update Frequency' ;
    rdfs:comment 'Frequency at which the benchmark provider publishes updated performance data.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageRestrictions rdf:type rdf:Property ;
    rdfs:label 'Usage Restrictions' ;
    rdfs:comment 'Any contractual or regulatory restrictions on how the benchmark data may be used, shared, or published.' ;
    rdfs:domain ind:PrivateequityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundOfFundsAllocationId rdf:type rdf:Property ;
    rdfs:label 'Fund Of Funds Allocation Id' ;
    rdfs:comment 'Unique identifier for the fund-of-funds allocation record.' ;
    rdfs:domain ind:FundOfFundsAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fofVehicleId rdf:type rdf:Property ;
    rdfs:label 'Fof Vehicle Id' ;
    rdfs:comment 'Reference to the fund-of-funds vehicle entity that this allocation represents.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FofVehicle .

ind:underlyingPeFundId rdf:type rdf:Property ;
    rdfs:label 'Underlying Pe Fund Id' ;
    rdfs:comment 'Reference to the underlying PE fund that the FoF vehicle allocates capital to.' ;
    rdfs:domain ind:FundOfFundsAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:allocationCurrency rdf:type rdf:Property ;
    rdfs:label 'Allocation Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the allocation commitment and cash flows.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Date' ;
    rdfs:comment 'Date when the FoF vehicle committed or allocated capital to the underlying PE fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Number' ;
    rdfs:comment 'Business identifier for the FoF allocation, used for operational tracking and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Status' ;
    rdfs:comment 'Current lifecycle status of the FoF allocation to the underlying fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationType rdf:type rdf:Property ;
    rdfs:label 'Allocation Type' ;
    rdfs:comment 'Classification of the FoF allocation strategy: primary fund commitment, secondary market purchase, or co-investment alongside the FoF.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
