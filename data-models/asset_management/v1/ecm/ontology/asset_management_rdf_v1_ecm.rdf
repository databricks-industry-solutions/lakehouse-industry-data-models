    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTeam rdf:type rdf:Property ;
    rdfs:label 'Coverage Team' ;
    rdfs:comment 'Name of the research team or desk responsible for ongoing analysis and monitoring of this coverage universe entry.' ;
