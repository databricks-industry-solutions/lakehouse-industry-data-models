ind:coverageEntityType rdf:type rdf:Property ;
    rdfs:label 'Coverage Entity Type' ;
    rdfs:comment 'Type of entity assigned for research coverage: issuer, sector, geography, asset class, external fund manager, or portfolio.' ;
    rdfs:domain ind:AnalystAssignment ;
