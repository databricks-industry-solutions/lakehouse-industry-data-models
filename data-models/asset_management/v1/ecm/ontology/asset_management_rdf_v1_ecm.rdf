# RDFS Schema for Business: Asset Management

@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix ind: <http://datamodel.lakehouse.org/business/asset_management#> .

# --- Root Business Class ---
ind:Business rdf:type rdfs:Class ;
    rdfs:label 'Business' ;
    rdfs:comment 'Root class for all business entities' .

# --- Specific Business: Asset Management ---
ind:AssetManagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Business ;
    rdfs:label 'Asset Management' ;
    rdfs:comment 'An institutional asset manager that invests pension assets on behalf of several participating pension plans. As a sophisticated institutional buy-side allocator, this company conducts deep, fundamental buy-side analysis across diversified asset classes—including public equities, private equity, real estate, infrastructure, natural resources, and credit investments—with a core focus on long-term risk-adjusted returns and capital preservation. Their investment analysis is highly rigorous, utilizing proprietary macroeconomic modeling, extensive operational and financial due diligence, and comprehensive Environmental, Social, and Governance (ESG) integration to evaluate direct investments, co-investments, and external fund managers. Because they manage long-duration liabilities for pension beneficiaries, their internal research teams leverage their massive scale and permanent capital advantage to originate off-market deals globally, stress-test macroeconomic sensitivities, and actively manage portfolio assets post-acquisition to unlock operational efficiency and sustainable value.' .

# --- Domain Classes ---
ind:Beneficiary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Beneficiary' ;
    rdfs:comment 'Single source of truth for all pension plan members and contributor pools, one per participating plan. Owns beneficiary identity, contribution history, entitlement records, demographic data, and member lifecycle from active' .

ind:Portfolio rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Portfolio' ;
    rdfs:comment 'Authoritative domain for investment portfolio structure and construction across all asset classes—public equities, private equity, real estate, infrastructure, natural resources, and credit.' .

ind:Equity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Equity' ;
    rdfs:comment 'Domain governing public equities investment operations including listed equity positions, equity research coverage, sector analysis, stock selection, and corporate actions.' .

ind:Privateequity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Privateequity' ;
    rdfs:comment 'Domain for private equity and co-investment operations including LP/GP fund structures, vintage year tracking, capital calls (drawdowns), distributions, J-Curve modeling, dry powder tracking, and carried interest waterfall calculations.' .

ind:Realestate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Realestate' ;
    rdfs:comment 'Domain for real estate investment operations including direct property holdings, REIT positions, real estate fund investments, and property-level asset management.' .

ind:Infrastructure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Infrastructure' ;
    rdfs:comment 'Domain for infrastructure investment operations covering direct infrastructure assets, infrastructure fund commitments, and greenfield/brownfield project investments.' .

ind:Naturalresource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Naturalresource' ;
    rdfs:comment 'Domain for natural resources and commodities investment operations including timberland, farmland, mining, energy, and commodity-linked fund investments. Owns resource asset records, production data, commodity price exposures, depletion schedules, and' .

ind:Credit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Credit' ;
    rdfs:comment 'Domain for credit and fixed income investment operations including investment grade (IG) bonds, high yield (HY), private credit, sovereign debt, and structured products.' .

ind:Deal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Deal' ;
    rdfs:comment 'Domain for deal origination, sourcing, and investment pipeline management covering both off-market and intermediated opportunities across all asset classes.' .

ind:Diligence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Diligence' ;
    rdfs:comment 'Domain for comprehensive investment due diligence processes including operational due diligence (ODD), financial due diligence (FDD), commercial due diligence (CDD), legal DD, and ESG DD conducted on prospective investments and external fund managers.' .

ind:Manager rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Manager' ;
    rdfs:comment 'Domain for external fund manager selection, mandate management, and ongoing manager oversight. Owns manager profiles, RFP processes, mandate terms (LPAs, SMAs, co-investment agreements), SLA tracking, manager performance evaluation, fee schedules, and' .

ind:Valuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Valuation' ;
    rdfs:comment 'Domain for asset valuation and NAV determination across liquid and illiquid asset classes. Owns mark-to-market (MTM) pricing, DCF models, WACC calculations, fair value hierarchies (Level 1/2/3), NAV/GAV computations, independent valuation agent' .

ind:Risk rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Risk' ;
    rdfs:comment 'Domain for enterprise risk management and macroeconomic stress testing including market risk (VaR, CVaR, DV01), liquidity risk, counterparty/credit risk, concentration risk, factor risk decomposition, scenario analysis, and sensitivity modeling.' .

ind:Esg rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Esg' ;
    rdfs:comment 'Domain for ESG integration, responsible investment stewardship, and sustainability reporting across the investment lifecycle. Owns ESG ratings (MSCI ESG), PRI reporting data, SFDR classifications, TCFD climate risk disclosures, GHG emissions tracking' .

ind:Trade rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Trade' ;
    rdfs:comment 'Domain for trade execution and settlement operations across all liquid asset classes—equities, fixed income, FX, and OTC derivatives. Owns order management (OMS/EMS via Charles River and Bloomberg AIM), trade blotter, execution details, T+2 settlement' .

ind:Treasury rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Treasury' ;
    rdfs:comment 'Domain for treasury operations, liquidity management, cash management, and FX hedging. Owns cash position records, liquidity forecasts, net contribution inflows, capital call funding workflows, FX forward/swap positions and hedge ratios, currency exposure' .

ind:Collateral rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Collateral' ;
    rdfs:comment 'Domain for collateral management and counterparty credit risk operations. Owns ISDA/CSA agreement records, margin call processing, collateral eligibility schedules, counterparty exposure tracking, LEI/BIC registry, credit limits, CCP clearing records, and' .

ind:Performance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Performance' ;
    rdfs:comment 'Domain for investment performance measurement and attribution analysis across all asset classes and portfolios. Owns TWR and MWR calculations, IRR, GIPS-compliant composite construction, benchmark-relative performance, factor/sector/geographic' .

ind:Actuarial rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Actuarial' ;
    rdfs:comment 'Domain for actuarial liability matching and liability-driven investment (LDI) operations. Owns actuarial liability projections, ALM models, discount rate curves, mortality assumptions, funded status calculations, contribution rate modeling, and duration' .

ind:Fee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Fee' ;
    rdfs:comment 'Domain for fee administration and carried interest management across all investment structures and external manager mandates. Owns management fee calculations, carried interest waterfall computations, hurdle rate tracking, clawback provisions, GP fee' .

ind:Research rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Research' ;
    rdfs:comment 'Domain for macroeconomic research, market data management, and proprietary investment modeling. Owns macroeconomic indicator libraries, economic scenario definitions, market data feeds (Bloomberg Terminal, FactSet), proprietary macro models, sector and' .

ind:Compliance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Compliance' ;
    rdfs:comment 'Domain for regulatory compliance, beneficiary reporting, and governance operations. Owns regulatory filing records (SEC, FCA, ESMA), KYC/AML documentation, trade reporting (EMIR, MiFID II), SFDR disclosures, LEI management, investment committee' .

ind:Shared rdf:type rdfs:Class ;
    rdfs:subClassOf ind:AssetManagement ;
    rdfs:label 'Shared' ;
    rdfs:comment 'Cross-domain shared reference entities (currency, UoM, calendar, classification) consolidated for Single Source of Truth (SSOT).' .

# --- Data Product Classes (Tables) ---
ind:Member rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member' ;
    rdfs:comment 'Core master record and single source of truth for every pension plan member across all four contributor pools (one per participating plan).' .

ind:ContributorPool rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Contributor Pool' ;
    rdfs:comment 'Reference entity defining the four distinct contributor pools managed by the fund: the participating plans. Each pool has its own legislative framework, benefit formula, contribution rate structure, actuarial assumptions' .

ind:MemberEnrollment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Enrollment' ;
    rdfs:comment 'Transactional record capturing the formal enrollment event when an individual joins a contributor pool as an active pension plan member. Records enrollment date, plan entry type (new hire, transfer-in, re-enrollment), eligibility verification outcome' .

ind:ContributionRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Contribution Record' ;
    rdfs:comment 'Transactional record of each periodic pension contribution made on behalf of or by a plan member. Captures employee contribution amount, employer contribution amount, contribution period (pay period), contribution type (regular, catch-up, voluntary' .

ind:PensionableService rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Pensionable Service' ;
    rdfs:comment 'Master record tracking the cumulative and period-level pensionable service credits accrued by a member. Records credited service years and months, service type (regular, buyback, transferred-in, military service credit), service period start and end' .

ind:Entitlement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Entitlement' ;
    rdfs:comment 'Master record and authoritative source for the calculated pension entitlement owed to a member at a given point in time or benefit trigger (retirement, death, termination).' .

ind:BenefitPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Benefit Payment' ;
    rdfs:comment 'Transactional record of each pension benefit payment disbursed to a member or beneficiary. Captures gross pension amount, applicable deductions (tax withholding, clawbacks, overpayment recovery), net payment amount, payment method (direct deposit' .

ind:MemberLifecycleEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Lifecycle Event' ;
    rdfs:comment 'Transactional record capturing significant lifecycle state transitions for a plan member: enrollment, active service, leave of absence, disability, deferred vesting, retirement commencement, death, and plan termination.' .

ind:DesignatedBeneficiary rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Designated Beneficiary' ;
    rdfs:comment 'Master record of the individuals designated by a plan member to receive survivor pension benefits or death-in-service lump sum payments. Stores beneficiary name, relationship to member (spouse, common-law partner, dependent child, estate), designation' .

ind:MemberAddress rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Address' ;
    rdfs:comment 'Master record of all physical and mailing addresses associated with a plan member, including residential address, mailing address, and employer address. Tracks address type, full address components (street, city, province/state, postal code, country)' .

ind:MemberContact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Contact' ;
    rdfs:comment 'Master record of contact information for a plan member including phone numbers, email addresses, and preferred communication channel. Stores contact type (mobile, home, work, email), contact value, is_primary flag, opt-in/opt-out preferences for digital' .

ind:ContributionRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Contribution Rate' ;
    rdfs:comment 'Reference entity defining the contribution rate schedules applicable to each contributor pool, including employee and employer rate tiers, effective date ranges, pensionable earnings thresholds, and the legislative or regulatory basis for each rate.' .

ind:ServiceBuyback rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Service Buyback' ;
    rdfs:comment 'Transactional record of a member\'s election to purchase additional pensionable service credits for prior periods of non-contributory service (e.g., maternity/parental leave, prior public-sector employment, military service).' .

ind:TransferIn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Transfer In' ;
    rdfs:comment 'Transactional record of pension assets or service credits transferred into the fund from another pension plan or retirement account on behalf of a member. Records the source plan name, transfer type (commuted value, service credit recognition), transfer' .

ind:TransferOut rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Transfer Out' ;
    rdfs:comment 'Transactional record of commuted value or pension credit transfers out of the fund when a member terminates employment before retirement and elects to transfer their accrued entitlement to another registered plan or locked-in retirement account.' .

ind:RetirementElection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Retirement Election' ;
    rdfs:comment 'Transactional record capturing a member\'s formal election to commence pension drawdown, including retirement date, retirement type (normal, early, deferred, disability), pension option elected (single life, joint and survivor, guaranteed period), survivor' .

ind:IndexationAdjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Indexation Adjustment' ;
    rdfs:comment 'Transactional record of annual cost-of-living indexation adjustments applied to pension benefit payments. Captures the indexation rate applied (typically CPI-linked per plan rules), effective date, prior benefit amount, adjusted benefit amount, and the' .

ind:SurvivorBenefit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Survivor Benefit' ;
    rdfs:comment 'Master record of survivor pension benefits established upon the death of a plan member or retiree. Stores the surviving beneficiary identity, survivor benefit type (survivor pension, death-in-service lump sum, children\'s benefit), benefit amount' .

ind:MemberStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Statement' ;
    rdfs:comment 'Transactional record representing the annual or on-demand pension statement issued to a plan member. Captures statement period, total pensionable service to date, projected pension at normal retirement age, accrued entitlement value, total contributions' .

ind:EmployerRemittance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Employer Remittance' ;
    rdfs:comment 'Transactional record of bulk contribution remittances submitted by participating employers (government departments, public agencies, other participating employers) to the fund on behalf of their employees.' .

ind:ParticipatingEmployer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Participating Employer' ;
    rdfs:comment 'Master record of all government departments, public agencies, and other participating employers.' .

ind:BenefitOption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Benefit Option' ;
    rdfs:comment 'Reference entity defining the menu of pension benefit options available to members at retirement within each contributor pool: single life annuity, joint and survivor annuity (50%, 60%, 66.67%, 100% survivor fractions), guaranteed period options, bridge' .

ind:OverpaymentRecovery rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Overpayment Recovery' ;
    rdfs:comment 'Transactional record tracking instances where benefit payments were made in excess of entitlement (due to death notification delays, calculation errors, or eligibility changes) and the subsequent recovery process.' .

ind:MemberDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Member Document' ;
    rdfs:comment 'Master record of official documents associated with a plan member\'s pension file: enrollment forms, beneficiary designation forms, retirement applications, marriage certificates, divorce orders (for pension division), disability certifications, death' .

ind:PensionDivisionOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Pension Division Order' ;
    rdfs:comment 'Transactional record of court-ordered pension division upon marriage breakdown, capturing the division order type (equalization payment, pension sharing, deferred division), effective date, division percentage or amount, former spouse identity, actuarial' .

ind:PensionPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Beneficiary ;
    rdfs:label 'Pension Plan' ;
    rdfs:comment 'Master reference table for pension_plan. Referenced by plan_id.' .

ind:Portfolio rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio' ;
    rdfs:comment 'Master record for each investment portfolio managed by the fund—the authoritative IBOR/ABOR portfolio entity maintained in SimCorp Dimension. Captures portfolio identity, mandate type (SAA/TAA), asset-class scope, base currency, inception date, regulatory' .

ind:Hierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Hierarchy' ;
    rdfs:comment 'Defines the parent-child structure across portfolio nodes, enabling composite/sleeve/sub-portfolio relationships in multi-asset, fund-of-funds, and sleeve-based mandates, plus consolidated reporting.' .

ind:PortfolioMandate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Mandate' ;
    rdfs:comment 'Authoritative master record for each investment mandate governing a portfolio or sleeve. Captures mandate type (internal, SMA, LP mandate, co-investment), investment universe constraints, permitted asset classes, geographic restrictions, currency hedging' .

ind:SaaTarget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Saa Target' ;
    rdfs:comment 'Strategic Asset Allocation (SAA) policy record defining long-term policy weights per asset class for a portfolio or fund, together with the realized actual weight for drift monitoring.' .

ind:TaaPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Taa Position' ;
    rdfs:comment 'Tactical Asset Allocation (TAA) position record capturing the current tactical over/underweight deviation from SAA targets for each asset class within a portfolio.' .

ind:Holding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Holding' ;
    rdfs:comment 'IBOR (Investment Book of Record) position record representing the authoritative current holding of a security or asset within a portfolio as of a given date.' .

ind:HoldingSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Holding Snapshot' ;
    rdfs:comment 'Point-in-time snapshot of portfolio holdings captured at end-of-day or month-end for historical analysis, regulatory reporting, and performance attribution.' .

ind:PortfolioBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Benchmark' ;
    rdfs:comment 'Authoritative benchmark registry AND portfolio-benchmark assignment record. Masters each investment benchmark assigned to portfolios—market indices (MSCI World, FTSE All-World, Bloomberg Aggregate), custom blended benchmarks, and liability benchmarks for' .

ind:BenchmarkAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Benchmark Assignment' ;
    rdfs:comment 'Association record linking a portfolio to its assigned benchmark(s) with effective date ranges, assignment type (primary, secondary, risk benchmark, liability benchmark), and weighting for blended benchmarks.' .

ind:AssetClassWeight rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Asset Class Weight' ;
    rdfs:comment 'Current actual asset class weight record for a portfolio as of a valuation date, capturing the realized allocation to each asset class (public equity, private equity, real estate, infrastructure, natural resources, credit, cash) expressed as a percentage' .

ind:RebalancingEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Rebalancing Event' ;
    rdfs:comment 'Transactional record capturing each portfolio rebalancing event triggered by drift from SAA/TAA targets or scheduled periodic rebalancing. Records trigger type (drift breach, scheduled, tactical decision, mandate change), target weights before and after' .

ind:Constraint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Constraint' ;
    rdfs:comment 'Business rule record defining investment constraints and guidelines applicable to a portfolio or mandate, as monitored in BlackRock Aladdin compliance engine.' .

ind:ConstraintBreach rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Constraint Breach' ;
    rdfs:comment 'Transactional record of each investment guideline or mandate constraint breach detected during pre-trade or post-trade compliance monitoring in BlackRock Aladdin or Charles River IMS.' .

ind:GipsComposite rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Gips Composite' ;
    rdfs:comment 'GIPS (Global Investment Performance Standards) composite master record grouping portfolios with similar investment mandates for standardized performance presentation.' .

ind:PortfolioCompositeMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Composite Membership' ;
    rdfs:comment 'Association record tracking the inclusion of individual portfolios within GIPS composites over time, with effective start and end dates, inclusion reason, and exclusion reason (if applicable).' .

ind:PortfolioCapitalCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Capital Commitment' ;
    rdfs:comment 'Record of capital committed to a portfolio or investment program from the pension fund\'s net contributions and asset allocation decisions. Captures committed amount, funded amount, unfunded (dry powder) balance, commitment currency, commitment date' .

ind:PortfolioNavRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Nav Record' ;
    rdfs:comment 'Net Asset Value (NAV) record for a portfolio as of a specific valuation date, representing the authoritative portfolio-level NAV as calculated by the fund administrator (State Street / Northern Trust) and reconciled against the IBOR.' .

ind:PortfolioCashFlow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Cash Flow' ;
    rdfs:comment 'Portfolio-level cash flow record capturing all inflows and outflows at the portfolio level including net contributions received, capital calls paid, distributions received, dividend and coupon income, management fees paid, FX settlements, and' .

ind:MandateHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Mandate History' ;
    rdfs:comment 'Audit history record tracking all changes to portfolio mandate parameters over time, including SAA target revisions, benchmark changes, constraint amendments, currency policy updates, and mandate scope expansions or restrictions.' .

ind:Sleeve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Sleeve' ;
    rdfs:comment 'Master record for a portfolio sleeve — a ring-fenced sub-allocation within a portfolio dedicated to a specific asset class, strategy, or manager mandate. Captures sleeve name, sleeve type (asset class sleeve, manager sleeve, strategy sleeve), target' .

ind:CurrencyExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Currency Exposure' ;
    rdfs:comment 'Portfolio-level currency exposure record capturing the unhedged and hedged foreign currency exposures as of a valuation date. Records base currency, foreign currency, gross exposure amount, hedge ratio, hedged notional, net unhedged exposure, and FX' .

ind:LiquidityBucket rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Liquidity Bucket' ;
    rdfs:comment 'Portfolio liquidity classification record bucketing holdings into liquidity tiers (T+0, T+1, T+2, T+5, T+30, T+90, T+180, illiquid/locked) based on instrument type, market depth, and redemption terms.' .

ind:PortfolioIcApproval rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Ic Approval' ;
    rdfs:comment 'Investment Committee (IC) approval record for portfolio-level decisions including SAA changes, new mandate approvals, rebalancing authorizations, benchmark changes, and capital commitment approvals.' .

ind:PortfolioAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Portfolio Allocation' ;
    rdfs:comment 'This association product represents the Allocation event between portfolio and opportunity. It captures the formal assignment of capital from a specific investment portfolio to a specific investment opportunity, including the percentage of the deal' .

ind:Asset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Asset' ;
    rdfs:comment 'Master reference table for asset. Referenced by asset_id.' .

ind:TaxLot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Portfolio ;
    rdfs:label 'Tax Lot' ;
    rdfs:comment 'Master reference table for tax_lot. Referenced by tax_lot_id.' .

ind:ListedSecurity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Listed Security' ;
    rdfs:comment 'Equity security master data for all exchange-traded equity instruments held or covered by the fund. Serves as the SSOT for equity instrument identity, capturing ISIN, CUSIP, SEDOL, ticker symbol, exchange listing, share class, par value, shares' .

ind:EquityPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Position' ;
    rdfs:comment 'IBOR equity position records representing the fund\'s current and historical holdings in listed equities at the portfolio-security-date level. Captures long/short indicator, quantity held, book cost, average cost basis, unrealized P&L, market value in' .

ind:EquityBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Benchmark' ;
    rdfs:comment 'Reference master for equity benchmark indices used in portfolio construction, performance attribution, and risk management. Captures benchmark name, index provider (MSCI, FTSE, S&P, Russell), benchmark code, currency, rebalancing frequency, weighting' .

ind:EquityBenchmarkConstituent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Benchmark Constituent' ;
    rdfs:comment 'Point-in-time constituent membership records for equity benchmark indices, capturing the weight of each security within a benchmark at a given rebalancing date.' .

ind:EquityCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Coverage' ;
    rdfs:comment 'Internal equity research coverage universe master, defining which listed securities are formally covered by the fund\'s internal equity research team. Captures coverage status (active, watch, dropped), assigned analyst, coverage initiation date, coverage' .

ind:ResearchNote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Research Note' ;
    rdfs:comment 'Internal equity research notes and investment theses produced by the fund\'s buy-side analysts for covered securities. Captures note type (initiation, update, earnings review, sector note, thematic), publication date, analyst, investment recommendation' .

ind:PriceHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Price History' ;
    rdfs:comment 'Daily end-of-day price and volume history for listed equity securities. Captures open, high, low, close, adjusted close (for corporate actions), total return index level, trading volume, VWAP, market capitalization, shares outstanding at date' .

ind:CorporateAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Corporate Action' ;
    rdfs:comment 'Corporate action event master for all equity securities in the coverage and position universe. Captures corporate action type (dividend, stock split, reverse split, rights issue, spin-off, merger, acquisition, delisting, name change, ticker change, bonus' .

ind:CorporateActionElection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Corporate Action Election' ;
    rdfs:comment 'Records of the fund\'s elections and responses to voluntary corporate actions (e.g., tender offers, rights subscriptions, merger consideration elections, dividend reinvestment elections).' .

ind:EquityFactorExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Factor Exposure' ;
    rdfs:comment 'Equity factor exposure records for securities and portfolios based on Barra and CAPM factor models. Captures factor model version (Barra GEM, USE, EUE), exposure date, factor name (market beta, size, value, momentum, quality, low volatility, growth' .

ind:EquitySectorClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Sector Classification' ;
    rdfs:comment 'Equity sector and industry classification master for listed securities using standard classification schemes. Captures classification scheme (GICS, ICB, NAICS, SIC), sector code, industry group code, industry code, sub-industry code, sector name, industry' .

ind:SecuritySectorMapping rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Security Sector Mapping' ;
    rdfs:comment 'Association table mapping listed equity securities to their sector and industry classifications under one or more classification schemes at a point in time. Captures the effective date, expiry date, primary classification flag, and classification source.' .

ind:StockSelection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Stock Selection' ;
    rdfs:comment 'Formal stock selection and portfolio-construction decision records produced by the equity investment team for securities in the coverage universe, bridging research output (research_note theses and valuation_model intrinsic values) to portfolio' .

ind:ValuationModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Valuation Model' ;
    rdfs:comment 'Proprietary equity valuation model records maintained by the internal research team for covered securities. Captures model type (DCF, DDM, EV/EBITDA, P/E relative, sum-of-parts, NAV-based), model version, valuation date, intrinsic value estimate' .

ind:EquityIssuer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Equity Issuer' ;
    rdfs:comment 'Corporate issuer master data for companies whose equity securities are held or covered by the fund. Captures legal entity name, LEI, headquarters country, incorporation jurisdiction, primary stock exchange, primary listing currency, parent company' .

ind:IssuerFinancials rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Issuer Financials' ;
    rdfs:comment 'Standardized fundamental financial data for equity issuers, capturing reported and consensus financial metrics used in equity analysis. Includes period type (annual, semi-annual, quarterly), reporting date, revenue, EBITDA, EBIT, net income, EPS (basic' .

ind:DividendRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Dividend Record' ;
    rdfs:comment 'Dividend income records for equity positions held by the fund, capturing declared dividends, accrued income, and received cash flows at the security-portfolio level.' .

ind:ProxyVotingRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Proxy Voting Record' ;
    rdfs:comment 'Records of the fund\'s proxy voting decisions and outcomes for shareholder meetings of equity holdings. Captures meeting type (AGM, EGM), meeting date, resolution number, resolution description, resolution category (director election, executive' .

ind:EngagementLog rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Engagement Log' ;
    rdfs:comment 'Records of the fund\'s direct engagement activities with equity issuers as part of active ownership and ESG stewardship. Captures engagement date, engagement type (letter, meeting, call, collaborative engagement), topic category (governance, climate' .

ind:ShortInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Short Interest' ;
    rdfs:comment 'Short interest and securities-lending data for equity positions, capturing both the fund\'s short positions and its stock-lending activity. Short-side fields: short position quantity, short position market value, settlement status, and compliance flags for' .

ind:Restriction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Restriction' ;
    rdfs:comment 'Investment restriction and compliance constraint records specific to equity securities and portfolios. Captures restriction type (regulatory, mandate, ESG exclusion, sanctions, internal policy), restricted security or issuer, restriction scope (buy, sell' .

ind:IndexRebalanceEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Index Rebalance Event' ;
    rdfs:comment 'Records of scheduled and ad-hoc index rebalancing events for equity benchmark indices tracked by the fund. Captures index provider, rebalancing type (quarterly, semi-annual, annual, ad-hoc), announcement date, effective date, additions list, deletions' .

ind:EarningsAnnouncement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Earnings Announcement' ;
    rdfs:comment 'Earnings announcement for a listed security including actual vs consensus EPS.' .

ind:PriceTargetEvaluation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Equity ;
    rdfs:label 'Price Target Evaluation' ;
    rdfs:comment 'Outcome of one research price target at its horizon.' .

ind:Fund rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Fund' ;
    rdfs:comment 'Master record for each private equity fund vehicle in which the pension fund holds an LP interest or manages as a GP. Captures fund name, vintage year, fund type (buyout, venture, growth, secondaries, FoF, co-invest), target size, hard cap, fund currency' .

ind:FundCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Fund Commitment' ;
    rdfs:comment 'Records the pension fund\'s LP capital commitment to a specific PE fund, including committed capital amount, commitment currency, commitment date, vintage year, commitment status (active, fully drawn, terminated), total paid-in capital (PIC), remaining' .

ind:PrivateequityCapitalCall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Privateequity Capital Call' ;
    rdfs:comment 'Transactional record of each capital call (drawdown notice) issued by a GP to the pension fund as LP. Captures call notice date, due date, call amount, call currency, call sequence number, call purpose (investment, management fees, fund expenses' .

ind:Distribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Distribution' ;
    rdfs:comment 'Transactional record of each cash or in-kind distribution received from a PE fund. Captures distribution notice date, payment date, distribution amount, distribution currency, distribution type (return of capital, realized gain, dividend, in-kind)' .

ind:Investment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Investment' ;
    rdfs:comment 'Master record for each direct private equity investment or fund-level portfolio company investment. Captures investment name, investment type (direct, co-invest, secondary, FoF), asset class sub-type (buyout, growth equity, venture, distressed), entry' .

ind:Coinvestment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Coinvestment' ;
    rdfs:comment 'Master record for co-investment opportunities where the pension fund invests directly alongside a GP in a specific portfolio company, outside the main fund vehicle.' .

ind:SecondaryTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Secondary Transaction' ;
    rdfs:comment 'Transactional record for secondary market purchases or sales of LP interests in PE funds. Captures transaction type (buy/sell), counterparty, fund interest being transacted, face value of commitment, purchase/sale price, discount or premium to NAV (%)' .

ind:LpaTerms rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Lpa Terms' ;
    rdfs:comment 'Structured record of the key economic and governance terms extracted from each Limited Partnership Agreement (LPA). Captures management fee rate, management fee basis (committed vs.' .

ind:CarriedInterestWaterfall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Carried Interest Waterfall' ;
    rdfs:comment 'Transactional record tracking the carried interest waterfall calculation for each PE fund at each reporting period. Captures total fund distributions to date, return of capital tranche, preferred return accrual, GP catch-up amount, carried interest earned' .

ind:Nav rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Nav' ;
    rdfs:comment 'Periodic NAV (Net Asset Value) record for each PE fund commitment and direct PE investment, capturing the GP-reported fair value, gross asset value (GAV), net asset value (NAV), unrealized value, realized value, total value (NAV + distributions), TVPI' .

ind:JcurveProjection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Jcurve Projection' ;
    rdfs:comment 'Forward-looking J-Curve cash flow projection model for each PE fund commitment, capturing projected capital call schedule by period, projected distribution schedule by period, projected NAV trajectory, expected IRR at various exit scenarios, break-even' .

ind:PortfolioCompany rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Portfolio Company' ;
    rdfs:comment 'Master record for each portfolio company held directly or indirectly through PE fund investments. Captures company name, LEI, jurisdiction of incorporation, sector (GICS), sub-sector, business description, revenue (latest), EBITDA (latest), enterprise' .

ind:GpEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Gp Entity' ;
    rdfs:comment 'Master record for each General Partner (GP) entity managing PE funds in which the pension fund is an LP. Captures GP legal name, LEI, domicile, AUM, fund count, strategy focus, key investment professionals, GP track record summary, GP ownership structure' .

ind:LpAdvisoryCommittee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Lp Advisory Committee' ;
    rdfs:comment 'Master record for LP Advisory Committee (LPAC) membership and governance for each PE fund. Captures fund reference, LPAC member name, member organization, seat type (voting, observer), appointment date, term expiry, conflict of interest disclosure status' .

ind:CapitalAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Capital Account' ;
    rdfs:comment 'LP capital account ledger record tracking the pension fund\'s running capital account balance within each PE fund. Captures opening balance, contributions in period, distributions in period, management fee allocations, carried interest allocations' .

ind:ManagementFeeInvoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Management Fee Invoice' ;
    rdfs:comment 'Transactional record for GP management fee invoices received against each PE fund commitment: invoice date, fee period, fee basis (committed/invested capital/NAV), fee rate applied, gross fee, fee offset credits (monitoring/transaction fees), net fee' .

ind:PrivateequityBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Privateequity Benchmark' ;
    rdfs:comment 'Reference data for PE performance benchmarks used to evaluate fund and portfolio performance. Captures benchmark name, benchmark provider (Cambridge Associates, Preqin, Burgiss, MSCI), benchmark type (pooled IRR, horizon IRR, PME), asset class scope' .

ind:FundOfFundsAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Fund Of Funds Allocation' ;
    rdfs:comment 'Master record for Fund-of-Funds (FoF) allocations where the pension fund invests in a FoF vehicle that in turn allocates to underlying PE funds. Captures FoF vehicle name, FoF manager, total FoF commitment, the pension fund\'s LP interest in the FoF' .

ind:PrivateequityCashFlow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Privateequity Cash Flow' ;
    rdfs:comment 'Granular transactional record of all cash flows associated with PE investments — capital calls, distributions, management fees, fund expenses, and recallable distributions.' .

ind:ValueCreationPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Value Creation Plan' ;
    rdfs:comment 'Master record for post-acquisition value creation plans for direct PE investments and co-investments. Captures investment reference, value creation theme (operational efficiency, revenue growth, M&A bolt-on, ESG improvement, management change' .

ind:GpReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Gp Report' ;
    rdfs:comment 'Transactional record for each GP quarterly or annual fund report received by the pension fund as LP. Captures report type (quarterly, annual, audited), reporting period, receipt date, GP fund NAV reported, portfolio company count, new investments in' .

ind:PrivateequityCoverage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Privateequity Coverage' ;
    rdfs:comment 'This association product represents the research coverage relationship between private equity funds and research reports. It captures which research publications are relevant to which fund vehicles, enabling investment professionals to retrieve all' .

ind:FofVehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Fof Vehicle' ;
    rdfs:comment 'Master reference table for fof_vehicle. Referenced by fof_vehicle_id.' .

ind:LpEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Privateequity ;
    rdfs:label 'Lp Entity' ;
    rdfs:comment 'Master reference table for lp_entity. Referenced by lp_entity_id.' .

ind:Property rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property' ;
    rdfs:comment 'Master record (SSOT) for each direct real estate asset held by the pension fund — commercial office, industrial/logistics, retail, residential, mixed-use, and specialty.' .

ind:PropertyValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Valuation' ;
    rdfs:comment 'Periodic valuation records for each property asset capturing appraised GAV, NAV, cap rate, discount rate, terminal cap rate, DCF-based valuation, independent appraiser details, valuation methodology (income approach, sales comparison, cost approach)' .

ind:NoiRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Noi Record' ;
    rdfs:comment 'Net Operating Income (NOI) records calculated at the property level on a periodic basis (monthly, quarterly, annual). Captures gross potential rent, effective gross income, vacancy and credit loss, operating expenses (property taxes, insurance' .

ind:Lease rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Lease' ;
    rdfs:comment 'Master record for each tenant lease agreement at a property, capturing tenant identity, leased premises (suite, floor, GLA), lease commencement and expiry dates, lease type (gross, net, triple-net, modified gross), base rent, rent escalation schedule' .

ind:LeaseRentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Lease Rent Schedule' ;
    rdfs:comment 'Detailed rent schedule for each lease, capturing all contractual rent payment periods, scheduled base rent amounts, rent step-up dates, CPI adjustment factors, effective rent per period, and cumulative rent to lease expiry.' .

ind:RentCollection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Rent Collection' ;
    rdfs:comment 'Transactional records of actual rent receipts collected from tenants against scheduled lease obligations. Captures invoice date, due date, payment received date, invoiced amount, received amount, arrears balance, payment method, and collection status' .

ind:Tenant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Tenant' ;
    rdfs:comment 'Master record for each tenant occupying space across the real estate portfolio. Captures tenant legal name, trading name, industry sector (GICS classification), credit rating, LEI, KYC/AML status, parent entity, number of leases, total leased GLA, anchor' .

ind:RealestateCapexProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Realestate Capex Program' ;
    rdfs:comment 'Capital expenditure program records for post-acquisition value creation initiatives at the property level. Captures program name, type (repositioning, refurbishment, development, ESG retrofit, tenant improvement), approved budget, committed spend, actual' .

ind:CapexExpenditure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Capex Expenditure' ;
    rdfs:comment 'Individual capital expenditure transaction records within an approved capex program. Captures expenditure date, vendor/contractor, work order reference, expenditure category (hard costs, soft costs, FF&E, contingency), invoiced amount, approved amount' .

ind:RealestateDebtFacility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Realestate Debt Facility' ;
    rdfs:comment 'Property-level debt financing records capturing mortgage and construction loan facilities secured against real estate assets. Captures lender identity, facility type (senior mortgage, mezzanine, construction loan, revolving credit), facility limit, drawn' .

ind:LtvDscrCovenant rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Ltv Dscr Covenant' ;
    rdfs:comment 'Periodic LTV (Loan-to-Value) and DSCR (Debt Service Coverage Ratio) covenant compliance records calculated at the property and debt facility level. Captures measurement date, current property GAV, outstanding debt balance, calculated LTV ratio, LTV' .

ind:ReitPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Reit Position' ;
    rdfs:comment 'Master record for listed REIT (Real Estate Investment Trust) positions held within the real estate allocation. Captures REIT name, ISIN, CUSIP, SEDOL, exchange, REIT sector (office, industrial, retail, residential, diversified, specialty), number of units' .

ind:ReFundCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Re Fund Commitment' ;
    rdfs:comment 'Commitment records for real estate fund investments (closed-end real estate funds, open-end core funds, value-add funds, opportunistic funds) where the pension fund acts as an LP.' .

ind:ReCapitalCall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Re Capital Call' ;
    rdfs:comment 'Capital call (drawdown) transaction records issued by real estate fund GPs to the pension fund as LP. Captures call notice date, due date, call amount, call purpose (acquisition, capex, fees, expenses), cumulative paid-in capital post-call, fund' .

ind:ReDistribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Re Distribution' ;
    rdfs:comment 'Distribution transaction records received from real estate fund GPs representing return of capital, income distributions, and carried interest waterfalls. Captures distribution date, distribution type (income, return of capital, recapitalisation, carried' .

ind:PropertyAcquisition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Acquisition' ;
    rdfs:comment 'Transaction record for each direct property acquisition executed by the pension fund. Captures acquisition date, purchase price, transaction costs (stamp duty, legal, advisory), financing structure (equity/debt split), acquisition yield (initial yield' .

ind:PropertyDisposal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Disposal' ;
    rdfs:comment 'Transaction record for each direct property disposal (sale, partial sale, recapitalisation) executed by the pension fund. Captures disposal date, gross sale price, transaction costs, net proceeds, book value at disposal, realised gain/loss, exit cap rate' .

ind:OccupancyRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Occupancy Record' ;
    rdfs:comment 'Periodic occupancy and vacancy tracking records at the property and tenancy level. Captures measurement date, total GLA, occupied GLA, vacant GLA, physical occupancy rate, economic occupancy rate, vacancy type (structural, transitional, development)' .

ind:PropertyOperatingExpense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Operating Expense' ;
    rdfs:comment 'Detailed operating-expense line records that roll up into the property-level NOI ledger (noi_record). Captures expense date, category (property tax, insurance, utilities, maintenance, cleaning, security, management fee, leasing commission), vendor' .

ind:JvStructure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Jv Structure' ;
    rdfs:comment 'Joint venture (JV) and co-investment structure records for properties held through partnership vehicles. Captures JV entity name, legal structure (LP, LLC, trust, REIT), pension fund ownership percentage, co-investor identities and ownership percentages' .

ind:PropertyInsurance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Insurance' ;
    rdfs:comment 'Insurance policy records for each property asset covering property damage, liability, business interruption, and environmental risk. Captures insurer name, policy number, coverage type, insured value, annual premium, policy inception and expiry dates' .

ind:EsgPropertyAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Esg Property Assessment' ;
    rdfs:comment 'ESG and sustainability assessment records at the property level capturing environmental certifications (LEED, BREEAM, NABERS, ENERGY STAR), GHG emissions (Scope 1, 2, 3), energy intensity (kWh/sqm), water intensity, waste diversion rate, green lease' .

ind:AssetBusinessPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Asset Business Plan' ;
    rdfs:comment 'Annual asset business plan records for each directly held property, capturing the strategic asset management plan approved by the investment committee. Includes target NOI for the plan year, leasing strategy (target tenants, target rents, incentive' .

ind:PropertyAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Property Allocation' ;
    rdfs:comment 'This association product represents the allocation of direct real estate property ownership across investment portfolios. It captures the ownership stake, effective period, and allocation strategy for each portfolio-property combination.' .

ind:BudgetLineItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Realestate ;
    rdfs:label 'Budget Line Item' ;
    rdfs:comment 'Master reference table for budget_line_item. Referenced by budget_line_item_id.' .

ind:InfraAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infra Asset' ;
    rdfs:comment 'Master record for direct infrastructure assets owned or co-owned by the pension fund, including toll roads, airports, ports, pipelines, utilities, energy transmission networks, water treatment facilities, and social infrastructure.' .

ind:InfraFundCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infra Fund Commitment' ;
    rdfs:comment 'Master record for the pension fund\'s LP commitments to infrastructure-focused closed-end funds and open-end vehicles managed by external GPs. Captures fund name, GP entity, vintage year, committed capital (e.g., EUR/USD), drawn capital (PIC), unfunded' .

ind:ConcessionAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Concession Agreement' ;
    rdfs:comment 'Master record for concession, license, or franchise agreements governing the right to operate regulated infrastructure assets. Captures concession grantor (government or regulatory body), concession term start and end dates, regulated return mechanism' .

ind:RegulatedReturnModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Regulated Return Model' ;
    rdfs:comment 'Master record for the regulatory asset base (RAB) and allowed-return model applicable to regulated infrastructure assets, including the history of regulatory price determinations.' .

ind:ProjectInvestment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Project Investment' ;
    rdfs:comment 'Master record for greenfield and brownfield infrastructure project investments, capturing project name, development stage (pre-construction, construction, operational ramp-up, steady-state), project type (PPP, PFI, availability-payment, merchant), total' .

ind:InfrastructureCapitalCall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Capital Call' ;
    rdfs:comment 'Transactional record of capital call (drawdown) notices received from infrastructure fund GPs or issued for direct co-investments. Captures call notice date, due date, called amount, cumulative PIC to date, call purpose (investment, fees, expenses' .

ind:DistributionEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Distribution Event' ;
    rdfs:comment 'Transactional record of cash distributions received from infrastructure fund GPs or direct asset operating entities. Captures distribution date, distribution amount, distribution type (return of capital, income, recallable capital, carried interest), DPI' .

ind:CashflowProjection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Cashflow Projection' ;
    rdfs:comment 'Transactional record of long-duration cash flow projections for direct infrastructure assets and project investments, capturing projection scenario (base, upside, downside, stress), projection date, forecast period (annual/quarterly), projected revenue' .

ind:InfrastructureAssetValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Asset Valuation' ;
    rdfs:comment 'Transactional record of periodic fair value assessments for direct infrastructure assets, capturing valuation date, valuation methodology (DCF, EV/EBITDA comparable, RAB multiple, independent appraisal), discount rate applied (WACC), terminal value' .

ind:InfrastructureDebtFacility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Debt Facility' ;
    rdfs:comment 'Master record for project-level and asset-level debt financing facilities associated with infrastructure investments, capturing lender name, facility type (senior secured, mezzanine, subordinated, green bond, infrastructure bond), facility amount, drawn' .

ind:CoInvestment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Co Investment' ;
    rdfs:comment 'Master record for infrastructure co-investment transactions where the pension fund invests alongside a GP or lead sponsor in a specific asset or project, outside of a fund vehicle.' .

ind:TariffSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Tariff Schedule' ;
    rdfs:comment 'Master record for tariff, toll, and user-charge schedules applicable to revenue-generating infrastructure assets, capturing tariff effective date, tariff category (vehicle class, passenger type, commodity type), base tariff rate, inflation escalation' .

ind:InfrastructureCapexProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Capex Program' ;
    rdfs:comment 'Master record for capital expenditure programs associated with infrastructure assets, capturing capex program name, type (maintenance capex, growth capex, regulatory capex, environmental upgrade), total approved budget, expenditure to date, forecast' .

ind:AvailabilityPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Availability Payment' ;
    rdfs:comment 'Transactional record of availability payment receipts for PPP/PFI infrastructure assets where revenue is based on asset availability rather than usage. Captures payment period, contracted availability payment amount, actual availability achieved' .

ind:AssetOwnership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Asset Ownership' ;
    rdfs:comment 'Association record capturing the ownership and co-investment structure of each infrastructure asset: the pension fund\'s direct and co-invest equity stakes, co-investor and lead-sponsor stakes, GP carried-interest entitlement, and minority partner' .

ind:RegulatoryReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Regulatory Review' ;
    rdfs:comment 'Transactional record of regulatory price reviews and determinations for regulated infrastructure assets, capturing review type (periodic determination, interim review, appeal), regulator name, review submission date, draft determination date, final' .

ind:ConstructionMilestone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Construction Milestone' ;
    rdfs:comment 'Transactional record of construction and development milestones for greenfield and brownfield project investments, capturing milestone name, milestone type (financial close, construction start, mechanical completion, commissioning, COD), planned date' .

ind:FundNavReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Fund Nav Report' ;
    rdfs:comment 'Transactional record of periodic NAV reports received from external infrastructure fund GPs, capturing reporting period, reported NAV (total fund and fund\'s LP share), unrealized gain/loss, realized proceeds in period, management fee accrual, carried' .

ind:InsurancePolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Insurance Policy' ;
    rdfs:comment 'Master record for insurance policies covering direct infrastructure assets, capturing insurer name, policy type (property all-risk, business interruption, third-party liability, political risk, construction all-risk, environmental liability), insured' .

ind:OperatorContract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Operator Contract' ;
    rdfs:comment 'Master record for operational and management contracts with third-party operators, O&M contractors, and asset managers engaged to run infrastructure assets post-acquisition.' .

ind:InfrastructureIcApproval rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Ic Approval' ;
    rdfs:comment 'Transactional record of Investment Committee approvals for infrastructure investments, capturing IC meeting date, investment name, approval type (initial approval, final approval, follow-on, disposal), approved commitment amount, approved structure' .

ind:AssetDisposition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Asset Disposition' ;
    rdfs:comment 'Transactional record of full or partial dispositions (exits) of direct infrastructure assets or secondary sales of fund LP interests, capturing disposition date, buyer name, sale structure (full exit, partial sell-down, secondary LP sale, IPO/listing)' .

ind:InfrastructureSectorClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Infrastructure Sector Classification' ;
    rdfs:comment 'Reference data for infrastructure sector and sub-sector classification taxonomy used to categorize assets and fund commitments. Captures sector name (Transport, Energy, Utilities, Social, Digital, Natural Resources), sub-sector (toll roads, airports' .

ind:CapitalCallNoticeDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Capital Call Notice Document' ;
    rdfs:comment 'Master reference table for capital_call_notice_document. Referenced by notice_document_id.' .

ind:DistributionNoticeDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Distribution Notice Document' ;
    rdfs:comment 'Master reference table for distribution_notice_document. Referenced by distribution_notice_document_id.' .

ind:OwnershipAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Infrastructure ;
    rdfs:label 'Ownership Agreement' ;
    rdfs:comment 'Master reference table for ownership_agreement. Referenced by ownership_agreement_id.' .

ind:ResourceAsset rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Asset' ;
    rdfs:comment 'SSOT for natural resource asset identity within the naturalresource domain. Master record for each physical resource asset held by the pension fund: timberland parcels, farmland tracts, mining concessions, energy assets (upstream oil & gas, renewables)' .

ind:ResourceHolding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Holding' ;
    rdfs:comment 'SSOT for the pension fund\'s economic interest in each natural resource vehicle — both direct asset holdings and LP/fund commitments. Tracks committed capital, invested capital (PIC), remaining unfunded commitment (dry powder), ownership percentage' .

ind:ProductionRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Production Record' ;
    rdfs:comment 'Operational production data captured at the asset level on a periodic basis (monthly/quarterly). Records physical output volumes for each resource type: timber harvest volumes (m³/MBF), crop yields (bushels/tonnes), mineral extraction tonnage, oil & gas' .

ind:CommodityExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Commodity Exposure' ;
    rdfs:comment 'Tracks the fund\'s commodity price exposure arising from natural resource holdings. Captures commodity type (lumber, wheat, corn, soy, crude oil, natural gas, copper, gold, iron ore), notional exposure in USD, exposure as % of AUM, benchmark commodity' .

ind:DepletionSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Depletion Schedule' ;
    rdfs:comment 'Asset-level depletion, amortization, and depreciation schedule for wasting natural resource assets. Captures depletion method (unit-of-production, straight-line, declining balance), total proven reserves at acquisition, cumulative depletion to date' .

ind:ReserveEstimate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Reserve Estimate' ;
    rdfs:comment 'Proven, probable, and possible (3P) reserve estimates for extractive resource assets (mining, oil & gas). Captures reserve category (1P/2P/3P per SPE-PRMS or JORC standards), commodity type, estimated recoverable quantity, unit of measure, effective date' .

ind:ResourceValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Valuation' ;
    rdfs:comment 'Periodic fair value and NAV determination records for natural resource assets, capturing valuation methodology (DCF, comparable transaction, NAV, appraisal), discount rate (WACC), terminal value assumptions, commodity price deck used, inflation' .

ind:CapitalEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Capital Event' ;
    rdfs:comment 'Records all capital flow events for natural resource holdings including capital calls (drawdowns), distributions (return of capital, income distributions), recallable distributions, and capital recycling events.' .

ind:OperatorAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Operator Agreement' ;
    rdfs:comment 'Master record for operating agreements, joint venture agreements, and management contracts governing natural resource assets. Captures operator/JV partner name, LEI, agreement type (operating agreement, JV, farm-out, royalty agreement, offtake agreement)' .

ind:RoyaltyObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Royalty Obligation' ;
    rdfs:comment 'Tracks royalty, overriding royalty interest (ORRI), net profits interest (NPI), and government royalty obligations attached to natural resource assets. Captures royalty type, royalty rate (%), royalty holder (government, private landowner, indigenous' .

ind:RoyaltyPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Royalty Payment' ;
    rdfs:comment 'Transactional record of each royalty payment disbursed against a royalty obligation. Captures payment date, payment period covered, production volume basis, commodity price applied, gross revenue base, royalty rate applied, payment amount (local currency' .

ind:LandParcel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Land Parcel' ;
    rdfs:comment 'Geospatial and legal description master record for land parcels underlying timberland, farmland, and surface rights of mining/energy assets. Captures parcel identifier (legal land description, cadastral reference), total area (hectares), land use' .

ind:EnvironmentalPermit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Environmental Permit' ;
    rdfs:comment 'Registry of environmental, operating, and extraction permits required for natural resource asset operations. Captures permit type (environmental assessment, extraction license, water use, emissions, land clearing), issuing regulatory authority, permit' .

ind:CarbonCredit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Carbon Credit' ;
    rdfs:comment 'Tracks carbon credits, carbon offsets, and REDD+ credits generated by or associated with natural resource assets (particularly timberland and farmland). Captures credit type (voluntary, compliance, REDD+, afforestation), registry (Gold Standard, Verra' .

ind:OfftakeAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Offtake Agreement' ;
    rdfs:comment 'Master record for offtake agreements and commodity sales contracts governing the sale of production output from natural resource assets. Captures counterparty name, LEI, commodity type, contract volume (annual/total), pricing mechanism (fixed, floating' .

ind:CommodityPriceDeck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Commodity Price Deck' ;
    rdfs:comment 'Reference price deck for commodities used in DCF valuation, budget forecasting, and stress testing of natural resource assets. Captures commodity type, scenario (base/bull/bear/stress), price per unit by horizon (short/medium/long-term), currency' .

ind:ResourceBudget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Budget' ;
    rdfs:comment 'Annual operating and capital expenditure budget for each natural resource asset. Captures budget year, budget type (opex, capex, sustaining capex, growth capex, reclamation/closure), budget amount by category, approved production volume targets, commodity' .

ind:ReclamationLiability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Reclamation Liability' ;
    rdfs:comment 'Asset retirement obligation (ARO) and site reclamation liability records for mining, oil & gas, and other extractive resource assets. Captures estimated reclamation cost (undiscounted), discount rate applied, present value of ARO, accretion expense per' .

ind:ResourceFundCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Fund Commitment' ;
    rdfs:comment 'Commitment record for natural resource fund investments where the pension fund participates as an LP in a dedicated natural resource fund (timberland fund, farmland fund, commodity fund, energy fund).' .

ind:ResourceCashflow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Cashflow' ;
    rdfs:comment 'Periodic cash flow records at the asset level capturing all cash inflows and outflows from natural resource operations. Includes revenue from commodity sales, royalty payments, operating expenses, capital expenditures, reclamation fund contributions' .

ind:OperationalIncident rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Operational Incident' ;
    rdfs:comment 'Records operational incidents, disruptions, and force majeure events affecting natural resource asset operations. Captures incident type (weather event, equipment failure, regulatory shutdown, labor dispute, environmental spill, wildfire, flood), incident' .

ind:HarvestPlan rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Harvest Plan' ;
    rdfs:comment 'Timber and agricultural harvest planning records for timberland and farmland assets. Captures plan year, harvest area (hectares), planned harvest volume by species/crop type, harvest method (clear-cut, selective, sustainable yield), planned harvest dates' .

ind:CarbonProject rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Carbon Project' ;
    rdfs:comment 'Master reference table for carbon_project. Referenced by project_id.' .

ind:ResourceVehicle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Naturalresource ;
    rdfs:label 'Resource Vehicle' ;
    rdfs:comment 'Master reference table for resource_vehicle. Referenced by resource_vehicle_id.' .

ind:FixedIncomeSecurity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Fixed Income Security' ;
    rdfs:comment 'Master record for all fixed income and credit instruments held or monitored by the pension fund, including investment grade (IG) bonds, high yield (HY) bonds, sovereign debt, T-Bills, SOFR-linked instruments, private credit notes, and structured products' .

ind:CreditPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Position' ;
    rdfs:comment 'IBOR-authoritative record of the pension fund\'s current and historical holdings in all credit and fixed income instruments across portfolios. Captures long/short positions, face value, book cost, market value (MTM), accrued interest, settlement date' .

ind:CouponSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Coupon Schedule' ;
    rdfs:comment 'Forward-looking cash-flow schedule for each fixed income security, capturing all scheduled coupon payment dates, coupon amounts, coupon rates (fixed or floating), reference rate (SOFR, LIBOR), spread over reference rate, ex-dividend/record/payment dates' .

ind:CouponPayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Coupon Payment' ;
    rdfs:comment 'Transactional record of actual coupon cash receipts and accruals for fixed income holdings, capturing payment date, coupon amount received, accrued interest at settlement, withholding tax applied, currency, FX rate used for conversion, and reconciliation' .

ind:DurationConvexity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Duration Convexity' ;
    rdfs:comment 'Daily interest-rate sensitivity metrics for each fixed income security and portfolio: modified duration, Macaulay duration, effective duration, convexity, DV01 (dollar value of a basis point), PV01, and key rate durations (KRDs) across the yield curve.' .

ind:Rating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Rating' ;
    rdfs:comment 'SSOT for credit ratings and their full history for fixed income issuers and individual securities, from rating agencies (Moody\'s, S&P, Fitch) and internal credit assessment.' .

ind:RatingAction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Rating Action' ;
    rdfs:comment 'Transactional event record capturing each rating change, watch placement, or outlook revision for a rated issuer or security. Records the effective date, prior rating, new rating, rating agency, action type (upgrade, downgrade, CreditWatch' .

ind:CdsPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Cds Position' ;
    rdfs:comment 'Master and position record for credit default swap (CDS) contracts held by the pension fund, capturing reference entity, reference obligation, CDS tenor, notional amount, protection bought/sold flag, CDS spread (running coupon in bps), upfront payment' .

ind:CdsMarketData rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Cds Market Data' ;
    rdfs:comment 'Time-series of CDS market data for reference entities and indices (CDX, iTraxx), capturing CDS spread by tenor (1Y, 3Y, 5Y, 7Y, 10Y), upfront points, implied probability of default (PD), recovery rate assumption, and pricing date.' .

ind:PrivateCreditInvestment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Private Credit Investment' ;
    rdfs:comment 'Master record for direct private credit investments including senior secured loans, mezzanine debt, unitranche facilities, distressed debt, and infrastructure debt originated or acquired by the pension fund.' .

ind:PrivateCreditDrawdown rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Private Credit Drawdown' ;
    rdfs:comment 'Transactional record of capital drawdown events on private credit facilities, capturing drawdown date, drawdown amount, cumulative drawn balance, purpose of drawdown, applicable interest rate at drawdown, and funding source.' .

ind:PrivateCreditRepayment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Private Credit Repayment' ;
    rdfs:comment 'Transactional record of principal repayments, amortization payments, and prepayments on private credit investments, capturing repayment date, principal amount repaid, prepayment premium (if any), remaining outstanding balance, and repayment type' .

ind:CovenantMonitoring rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Covenant Monitoring' ;
    rdfs:comment 'Operational record tracking financial covenant compliance for private credit investments, capturing covenant type (leverage ratio, interest coverage ratio, LTV, DSCR, minimum liquidity), covenant threshold, actual measured value, measurement date' .

ind:StructuredProduct rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Structured Product' ;
    rdfs:comment 'Master record for structured credit instruments including asset-backed securities (ABS), mortgage-backed securities (MBS), collateralized loan obligations (CLO), collateralized debt obligations (CDO), and covered bonds.' .

ind:SovereignDebtHolding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Sovereign Debt Holding' ;
    rdfs:comment 'Master record for sovereign and quasi-sovereign debt holdings including government bonds, treasury bills (T-Bills), inflation-linked bonds (ILBs/TIPS), agency bonds, and supranational debt (World Bank, EIB).' .

ind:CreditYieldCurve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Yield Curve' ;
    rdfs:comment 'Reference data store for benchmark yield curves used in fixed income valuation and risk analytics, capturing curve type (government, swap, SOFR, OIS, credit spread curve), currency, tenor points, zero rates, par rates, forward rates, discount factors, and' .

ind:BenchmarkIndex rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Benchmark Index' ;
    rdfs:comment 'Reference master for fixed income benchmark indices used for performance attribution, portfolio construction, and mandate compliance (e.g., Bloomberg Global Aggregate, Bloomberg US Corporate IG, ICE BofA HY, FTSE WGBI, Bloomberg EM USD Aggregate).' .

ind:CreditBenchmarkConstituent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Benchmark Constituent' ;
    rdfs:comment 'Time-series record of securities comprising each fixed income benchmark index at each rebalancing date, capturing security ISIN, index weight, market value contribution, duration contribution, yield contribution, sector classification, country, and rating' .

ind:CreditIssuer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Issuer' ;
    rdfs:comment 'Master record for corporate and sovereign debt issuers covered by the pension fund\'s credit investment universe, capturing issuer legal name, LEI, parent entity, country of domicile, country of risk, industry sector (GICS/ICB), issuer type (corporate' .

ind:MaturitySchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Maturity Schedule' ;
    rdfs:comment 'Forward-looking maturity and redemption schedule for the fixed income portfolio, capturing each security\'s maturity date, call dates (for callable bonds), put dates (for putable bonds), sinking fund schedule, expected redemption amount, and redemption' .

ind:DefaultEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Default Event' ;
    rdfs:comment 'Transactional record of credit events (as defined under ISDA) affecting issuers or reference entities in the portfolio, including bankruptcy, failure to pay, restructuring, obligation acceleration, repudiation/moratorium, and governmental intervention.' .

ind:SofrRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Sofr Rate' ;
    rdfs:comment 'Reference data time-series for SOFR (Secured Overnight Financing Rate) and related overnight/term rates (SOFR compounded in arrears, Term SOFR 1M/3M/6M/12M, SOFR OIS rates) published by the Federal Reserve Bank of New York and CME.' .

ind:CreditMandate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Mandate' ;
    rdfs:comment 'Master record defining the investment mandate parameters and constraints for each credit portfolio or sub-portfolio managed by the pension fund, capturing mandate name, asset class scope (IG, HY, private credit, sovereign, structured), minimum/maximum' .

ind:SpreadAnalytics rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Spread Analytics' ;
    rdfs:comment 'Daily yield and spread analytics for each fixed income security and position, capturing yield to maturity (YTM), yield to worst (YTW), yield to call, current yield, option-adjusted spread (OAS), Z-spread, G-spread, asset-swap spread (ASW), I-spread, and' .

ind:CreditAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Credit Allocation' ;
    rdfs:comment 'This association product represents the Collateral Allocation between credit_position and collateral_position. It captures the operational record of how collateral assets are pledged or allocated against credit exposures for margin, regulatory, and risk' .

ind:AmortizationSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Amortization Schedule' ;
    rdfs:comment 'Master reference table for amortization_schedule. Referenced by amortization_schedule_id.' .

ind:PrivateCreditFacility rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Credit ;
    rdfs:label 'Private Credit Facility' ;
    rdfs:comment 'Master reference table for private_credit_facility. Referenced by private_credit_facility_id.' .

ind:Opportunity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Opportunity' ;
    rdfs:comment 'Core master record (SSOT) for every investment opportunity entering the pipeline—off-market/proprietary, GP-introduced, or intermediated—across all asset classes.' .

ind:PipelineStage rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Pipeline Stage' ;
    rdfs:comment 'Reference taxonomy defining the ordered stages of the deal pipeline lifecycle—from initial screening through IC approval and closing. Captures stage code, stage name, stage sequence order, minimum dwell days, required deliverables checklist, stage' .

ind:StageTransition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Stage Transition' ;
    rdfs:comment 'Transactional audit record capturing every pipeline-gate event for an opportunity—both mechanical stage advances and formal go/no-go screening decisions. Records the opportunity, prior stage, new stage, transition date/timestamp, approving' .

ind:Nda rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Nda' ;
    rdfs:comment 'Master record for Non-Disclosure Agreements executed in connection with deal origination and due diligence. Captures NDA type (mutual/one-way), counterparty legal entity, execution date, expiry date, governing law jurisdiction, NDA status (draft' .

ind:Loi rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Loi' ;
    rdfs:comment 'Master record for Letters of Intent issued during deal origination and early negotiation. Captures LOI type (binding/non-binding), issuance date, expiry date, indicative enterprise value, indicative equity value, proposed deal structure, exclusivity' .

ind:TermSheet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Term Sheet' ;
    rdfs:comment 'Master record for term sheets negotiated during deal structuring. Captures term sheet version, issuance date, counterparty, proposed deal structure (equity/debt/hybrid), indicative valuation basis, key economic terms (purchase price, EBITDA multiple, IRR' .

ind:InvestmentMemo rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Investment Memo' ;
    rdfs:comment 'Master record for Investment Memoranda (IM) prepared for IC submission. Captures IM version, preparation date, lead author, asset class, deal type, target company/asset name, recommended deal structure, proposed commitment amount, target IRR, target MOIC' .

ind:DealIcSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Ic Submission' ;
    rdfs:comment 'Transactional record capturing each formal Investment Committee (IC) submission for deal approval. Records the opportunity, investment memo version, submission date, IC meeting date, IC type (preliminary/full/special), requested commitment amount' .

ind:DealIcCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Ic Condition' ;
    rdfs:comment 'Master record for conditions attached to IC approvals. Captures the IC submission, condition description, condition type (pre-close, post-close, ongoing covenant), condition owner, due date, condition status (open, satisfied, waived, breached)' .

ind:Team rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Team' ;
    rdfs:comment 'Association record capturing the deal team composition for each opportunity. Records the opportunity, team member employee reference, role on deal (lead, associate, analyst, legal counsel, ESG advisor, external advisor), assignment start date, assignment' .

ind:OriginationSource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Origination Source' ;
    rdfs:comment 'Reference master for external deal parties—origination sources, intermediaries, and their individual contacts—across the pipeline. Captures source/party type (proprietary/off-market, GP-introduced, investment bank, broker, co-investor referral, management' .

ind:TargetEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Target Entity' ;
    rdfs:comment 'Master record for the target company, asset, or fund that is the subject of a deal opportunity. Captures target legal name, target type (operating company, real asset, infrastructure asset, fund, co-investment vehicle), jurisdiction of incorporation, LEI' .

ind:DealValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Valuation' ;
    rdfs:comment 'Transactional record capturing indicative valuation estimates produced during deal origination and screening—prior to formal valuation domain ownership post-IC approval.' .

ind:DealCapitalCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Capital Commitment' ;
    rdfs:comment 'Master record for the capital commitment approved and reserved for a deal at IC approval. Captures the opportunity, IC submission reference, approved commitment amount, commitment currency, commitment type (equity, debt, co-invest, fund commitment)' .

ind:PpmReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Ppm Review' ;
    rdfs:comment 'Master record for Private Placement Memorandum (PPM) reviews conducted during fund manager and co-investment screening. Captures the opportunity, PPM document version, review date, reviewer, fund strategy summary, GP track record assessment, fee structure' .

ind:ScreeningDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Screening Decision' ;
    rdfs:comment 'Transactional record capturing the formal screening decision made at each pipeline gate review. Records the opportunity, screening date, screening type (initial/full), screening committee members, decision outcome (proceed, hold, decline), decline reason' .

ind:DealDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Document' ;
    rdfs:comment 'Master record for all deal-related documents managed within the deal pipeline. Captures document type (NDA, LOI, term sheet, IM, PPM, financial model, legal opinion, management presentation, data room index), document title, document version, upload date' .

ind:ExclusivityAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Exclusivity Agreement' ;
    rdfs:comment 'Master record for exclusivity agreements negotiated with sellers or GPs during deal execution. Captures the opportunity, counterparty, exclusivity start date, exclusivity end date, exclusivity scope description, break fee amount, break fee currency' .

ind:Milestone rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Milestone' ;
    rdfs:comment 'Transactional record tracking key milestones in the deal execution timeline. Captures the opportunity, milestone type (NDA signed, LOI issued, exclusivity granted, DD commenced, IC submission, IC approval, SPA signed, regulatory filing, financial close)' .

ind:CoInvestAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Co Invest Allocation' ;
    rdfs:comment 'Master record for co-investment allocations offered to or accepted from co-investors alongside the pension fund\'s direct investment. Captures the opportunity, co-investor entity name, co-investor LEI, allocated co-invest amount, co-invest currency' .

ind:DealFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Fee' ;
    rdfs:comment 'Transactional record for fees incurred during deal origination and execution—including advisory fees, break fees, arrangement fees, legal fees, and due diligence costs.' .

ind:DealContact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Contact' ;
    rdfs:comment 'Master record for external contacts associated with a deal opportunity—including sell-side advisors, management teams, GP representatives, legal counsel, and intermediaries.' .

ind:DealCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Deal ;
    rdfs:label 'Deal Check' ;
    rdfs:comment 'This association product represents the Compliance Check event between an investment opportunity and a compliance rule. It captures the operational record of each compliance verification performed during the deal pipeline process.' .

ind:DdEngagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Engagement' ;
    rdfs:comment 'Master record for a formal due diligence engagement initiated on a prospective investment, co-investment, or external fund manager. Captures the DD type (ODD, FDD, CDD, Legal, ESG, or combined), the target entity under review, engagement status, lead' .

ind:DdWorkstream rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Workstream' ;
    rdfs:comment 'Represents a distinct functional workstream within a DD engagement — Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Tax DD.' .

ind:DdChecklist rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Checklist' ;
    rdfs:comment 'Standardized or customized DD checklist template assigned to a workstream within a DD engagement. Captures the checklist version, applicable asset class (private equity, real estate, infrastructure, credit, etc.), workstream type, total item count' .

ind:DdChecklistItem rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Checklist Item' ;
    rdfs:comment 'Individual line-item within a DD checklist representing a specific information request, verification task, or diligence question. Tracks item category, question text, response status (open, received, satisfactory, escalated), assigned analyst, due date' .

ind:DdFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Finding' ;
    rdfs:comment 'Formal finding or issue identified during any DD workstream. Captures finding type (financial, operational, legal, ESG, commercial), severity rating (critical, major, minor, informational), description, root cause, potential financial impact, recommended' .

ind:DdRiskAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Risk Assessment' ;
    rdfs:comment 'Consolidated risk assessment record produced at the conclusion of a DD engagement or workstream. Captures overall risk rating, individual risk dimension scores (financial, operational, legal, ESG, market, management quality), key risk factors, mitigants' .

ind:AdvisorEngagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Advisor Engagement' ;
    rdfs:comment 'Master record for a third-party advisor or specialist firm engaged to support a DD workstream — e.g., legal counsel, accounting firm (FDD), technical consultant (infrastructure/real estate), environmental consultant (ESG/natural resources), or commercial' .

ind:AdvisorReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Advisor Report' ;
    rdfs:comment 'Formal report or deliverable submitted by a third-party advisor as part of a DD engagement. Captures report type (legal opinion, FDD report, ODD report, environmental assessment, technical report, CDD report), submission date, report version, key' .

ind:OddAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Odd Assessment' ;
    rdfs:comment 'Operational Due Diligence (ODD) assessment record specific to external fund manager evaluations. Captures operational infrastructure quality ratings across key ODD dimensions: governance and organizational structure, technology and systems, valuation' .

ind:FddAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Fdd Assessment' ;
    rdfs:comment 'Financial Due Diligence (FDD) assessment record capturing the financial analysis of a target investment or fund manager. Tracks quality of earnings (QoE) findings, EBITDA normalization adjustments, working capital analysis, net debt reconciliation' .

ind:CddAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Cdd Assessment' ;
    rdfs:comment 'Commercial Due Diligence (CDD) assessment record evaluating the market position, competitive dynamics, and commercial viability of a target investment. Captures market size and growth assessment, competitive positioning, customer concentration analysis' .

ind:EsgDdAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Esg Dd Assessment' ;
    rdfs:comment 'ESG-specific due diligence assessment conducted as part of the investment DD process. Captures ESG materiality screening results, environmental risk factors (GHG emissions, climate transition risk, physical risk), social risk factors (labor practices' .

ind:LegalDdAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Legal Dd Assessment' ;
    rdfs:comment 'Legal due diligence assessment record capturing the legal review of a target investment or fund manager. Tracks corporate structure review, title and ownership verification, material contract review (LPA terms, SPA, key commercial agreements), litigation' .

ind:DiligenceIcSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Diligence Ic Submission' ;
    rdfs:comment 'Investment Committee (IC) submission package record representing the formal presentation of a DD-completed investment opportunity to the IC for approval. Captures submission date, IC meeting date, investment type, recommended commitment amount, deal' .

ind:DiligenceIcCondition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Diligence Ic Condition' ;
    rdfs:comment 'Individual condition or requirement attached to an IC approval decision. Captures condition type (legal, financial, ESG, operational, regulatory), condition description, responsible party for resolution, target resolution date, actual resolution date, and' .

ind:NdaRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Nda Record' ;
    rdfs:comment 'Non-Disclosure Agreement (NDA) record executed with a target company, fund manager, or intermediary as part of the deal origination and DD process. Captures counterparty name, LEI, NDA type (mutual, one-way), execution date, expiry date, governing law' .

ind:DataRoomAccess rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Data Room Access' ;
    rdfs:comment 'Record of virtual data room (VDR) access granted to the investment team for a specific DD engagement. Captures VDR platform (e.g., Intralinks, Datasite, Ansarada), access grant date, access expiry date, document categories available, number of documents' .

ind:ManagementInterview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Management Interview' ;
    rdfs:comment 'Record of a formal qualitative information-gathering engagement conducted during DD — covering both management interviews/site visits with the target and reference checks with third-party referees.' .

ind:ReferenceCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Reference Check' ;
    rdfs:comment 'Record of a reference check conducted on a target company\'s management team or an external fund manager\'s investment professionals. Captures referee name, referee organization, referee relationship to subject, check date, topics covered, key feedback' .

ind:DdDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Document' ;
    rdfs:comment 'Metadata registry record for a document received, generated, or reviewed during a DD engagement (CIM, PPM, audited financials, legal opinion, technical report, ESG disclosure, management presentation, data room file).' .

ind:DdStatusEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Status Event' ;
    rdfs:comment 'Audit trail of status transitions for a DD engagement or workstream throughout its lifecycle. Captures the prior status, new status, transition timestamp, triggering event description, and the analyst or system that triggered the change.' .

ind:KycAmlRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Kyc Aml Record' ;
    rdfs:comment 'Know Your Customer (KYC) and Anti-Money Laundering (AML) screening record conducted on a counterparty, target company, fund manager, or beneficial owner as part of the DD and onboarding process.' .

ind:DdAdvisorCost rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Dd Advisor Cost' ;
    rdfs:comment 'Cost and fee-accrual record for a third-party advisor engagement within a DD engagement. Captures the advisor_engagement reference, fee type (fixed, capped, hourly, success-based), budgeted amount, accrued-to-date, invoiced amount, paid amount, currency' .

ind:Assessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Diligence ;
    rdfs:label 'Assessment' ;
    rdfs:comment 'This association product represents the compliance assessment event between a due diligence engagement and a compliance rule. It captures the outcome of evaluating a specific DD engagement against a specific compliance monitoring rule.' .

ind:GpProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Gp Profile' ;
    rdfs:comment 'Master SSOT record for each external General Partner (GP), sub-advisor, or Fund-of-Funds manager relationship. Captures manager identity, legal entity details, LEI, domicile, AUM, strategy focus, vintage coverage, and operational status, PLUS the' .

ind:ManagerMandate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Manager Mandate' ;
    rdfs:comment 'Authoritative record of each investment mandate awarded to an external manager, covering mandate type (LP fund commitment, SMA, co-investment agreement, FoF), asset class, strategy, target allocation, benchmark, investment guidelines, and contractual term' .

ind:Rfp rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Rfp' ;
    rdfs:comment 'Tracks each Request for Proposal (RFP) or Request for Information (RFI) issued to external managers during the manager selection process. Records RFP type, asset class, strategy sought, issuance date, response deadline, evaluation criteria weighting' .

ind:RfpResponse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Rfp Response' ;
    rdfs:comment 'Captures each manager\'s formal response to an RFP, including submission date, proposed strategy details, proposed fee schedule, track record summary, team composition, AUM at time of submission, and evaluation scores assigned by the internal selection' .

ind:MandateTerm rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Mandate Term' ;
    rdfs:comment 'Authoritative SSOT for the economic and governance terms of each mandate: management fee basis points (tiered by AUM band), carried interest rate, hurdle/preferred return, high-water mark, clawback terms, fee base (committed vs invested capital), fee' .

ind:MandateAmendment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Mandate Amendment' ;
    rdfs:comment 'Records each formal amendment to an existing mandate, capturing amendment date, amendment type (fee renegotiation, guideline change, term extension, side letter), the specific clause modified, prior value, revised value, and approval authority.' .

ind:ManagerContact rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Manager Contact' ;
    rdfs:comment 'Master record for key personnel at each external manager firm, including portfolio managers, investor relations contacts, compliance officers, and operations contacts.' .

ind:FeeSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Fee Schedule' ;
    rdfs:comment 'Defines the fee structure applicable to each mandate or manager relationship, including management fee tiers (basis points by AUM band), carried interest percentage, preferred return hurdle, fee calculation frequency, fee base (committed vs.' .

ind:Evaluation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Evaluation' ;
    rdfs:comment 'Records periodic qualitative and quantitative evaluations of each external manager, covering investment process assessment, team stability, operational infrastructure, risk management quality, ESG integration maturity, and overall conviction rating.' .

ind:RiskAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Risk Assessment' ;
    rdfs:comment 'Captures structured risk assessments of each external manager covering operational risk (ODD findings), key-man risk, concentration risk, counterparty risk, regulatory risk, and reputational risk.' .

ind:SlaAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Sla Agreement' ;
    rdfs:comment 'SSOT for all service-level commitments and individual reporting obligations between the pension fund and each external manager or fund administrator. Covers reporting delivery timelines and line-item obligations (NAV, capital account statements, audited' .

ind:SlaBreach rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Sla Breach' ;
    rdfs:comment 'Transactional record of each SLA breach event by an external manager, capturing breach date, SLA obligation breached, severity classification, root cause, manager response, remediation plan, and resolution date.' .

ind:Watchlist rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Watchlist' ;
    rdfs:comment 'Tracks external managers placed on formal internal watch-list status due to performance concerns, key-man departures, regulatory investigations, ODD findings, or strategic misalignment.' .

ind:Meeting rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Meeting' ;
    rdfs:comment 'Records all formal interactions with external managers including annual reviews, quarterly update calls, on-site due diligence visits, LPAC meetings, and ad-hoc escalation meetings.' .

ind:CoInvestRight rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Co Invest Right' ;
    rdfs:comment 'Master record of co-investment rights negotiated within each LP mandate, specifying the co-investment allocation right (percentage or dollar cap), notice period for co-invest opportunities, approval process, exclusivity window, and historical utilization.' .

ind:LpacMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Lpac Membership' ;
    rdfs:comment 'Tracks the pension fund\'s Limited Partner Advisory Committee (LPAC) membership positions across all LP fund mandates, including seat type (voting, observer), appointment date, term expiry, representative assigned, and LPAC meeting attendance record.' .

ind:Strategy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Strategy' ;
    rdfs:comment 'Reference classification of investment strategies offered by external managers, including strategy name, asset class, sub-strategy type (buyout, venture, growth, distressed, core real estate, value-add, infrastructure greenfield, etc.), geographic focus' .

ind:ManagerDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Manager Document' ;
    rdfs:comment 'Catalog of all legal and operational documents associated with each manager relationship, including executed LPAs, side letters, NDAs, PPMs, subscription agreements, audited financial statements, DDQs (Due Diligence Questionnaires), and regulatory' .

ind:Kyc rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Kyc' ;
    rdfs:comment 'Records KYC (Know Your Customer) and AML (Anti-Money Laundering) due diligence completed for each external manager entity, including beneficial ownership verification, sanctions screening results, PEP checks, source of funds confirmation, and regulatory' .

ind:EsgProfile rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Esg Profile' ;
    rdfs:comment 'Captures the ESG credentials and responsible investment profile of each external manager, including PRI signatory status, SFDR article classification, TCFD alignment, proprietary ESG policy documentation, GHG reporting capability, exclusion list' .

ind:ManagerBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Manager Benchmark' ;
    rdfs:comment 'Defines the performance benchmarks assigned to each mandate or manager strategy, including benchmark name, benchmark provider, benchmark index code, benchmark currency, benchmark calculation methodology, and effective date range.' .

ind:ReportingObligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Reporting Obligation' ;
    rdfs:comment 'Defines the specific reporting obligations each external manager must fulfill under their mandate, including report type (capital account statement, audited financials, quarterly investor letter, ESG report, ILPA data template), delivery frequency' .

ind:ReportReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Manager ;
    rdfs:label 'Report Receipt' ;
    rdfs:comment 'Transactional log of each manager report received, recording report type, reporting period covered, receipt date, delivery channel, completeness check result, data quality flags, and processing status.' .

ind:ValuationAssetValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Asset Valuation' ;
    rdfs:comment 'Core master record and authoritative SSOT for the concluded fair value of an individual investment asset at a specific valuation date, across ALL asset classes (public equity, private equity, infrastructure, real estate, natural resources, credit).' .

ind:ValuationNavRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Nav Record' ;
    rdfs:comment 'Authoritative NAV (Net Asset Value) and GAV (Gross Asset Value) record for a fund, portfolio, or investment vehicle at a specific valuation date. Captures total gross asset value, total liabilities, net asset value, NAV per unit/share, number of units' .

ind:Cycle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Cycle' ;
    rdfs:comment 'Master record defining a scheduled valuation cycle or reporting period for a portfolio, fund, or asset class. Captures cycle type (monthly, quarterly, annual), cycle start and end dates, valuation reference date, cycle status (open, in-progress' .

ind:DcfModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Dcf Model' ;
    rdfs:comment 'Proprietary Discounted Cash Flow (DCF) model record for an investment asset or portfolio company. Stores model version, projection horizon (years), terminal growth rate, WACC (Weighted Average Cost of Capital), discount rate, projected free cash flow' .

ind:WaccCalculation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Wacc Calculation' ;
    rdfs:comment 'Record of a WACC (Weighted Average Cost of Capital) calculation performed for a specific asset, portfolio company, or investment vehicle at a point in time.' .

ind:FairValueHierarchy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Fair Value Hierarchy' ;
    rdfs:comment 'Reference classification record defining the IFRS 13 / ASC 820 fair value hierarchy levels applied to asset valuations. Captures hierarchy level (Level 1 — quoted prices in active markets, Level 2 — observable inputs, Level 3 — unobservable/model-based' .

ind:IndepValuationEngagement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Indep Valuation Engagement' ;
    rdfs:comment 'Master record for an engagement with an independent external valuation agent or appraiser (including licensed real estate appraisers) for a specific asset or portfolio.' .

ind:Adjustment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Adjustment' ;
    rdfs:comment 'Record of a specific valuation adjustment applied to a base asset valuation. Captures adjustment type (liquidity discount, control premium, minority discount, credit risk adjustment, FX translation adjustment, model overlay), adjustment amount, adjustment' .

ind:MarketPriceSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Market Price Snapshot' ;
    rdfs:comment 'Point-in-time market price record for a liquid security or instrument sourced from Bloomberg, FactSet, or exchange feeds. Captures ISIN, CUSIP, SEDOL, instrument type, exchange, bid price, ask price, mid price, last traded price, closing price, price' .

ind:ComparableTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Comparable Transaction' ;
    rdfs:comment 'Record of a market comparable transaction used as a valuation reference for an illiquid asset. Captures the comparable company or asset name, transaction date, transaction type (M&A, secondary sale, IPO, recapitalization), enterprise value, EBITDA' .

ind:Methodology rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Methodology' ;
    rdfs:comment 'Reference record defining approved valuation methodologies available for use across asset classes. Captures methodology name (DCF, EV/EBITDA multiple, NAV, broker quote, recent transaction price, replacement cost, income capitalization), applicable asset' .

ind:ValuationPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Policy' ;
    rdfs:comment 'Master record for the firm\'s formal valuation policy governing fair value determination across asset classes. Captures policy version, effective date, expiry date, asset class scope, approved methodologies, hierarchy level assignment rules, independent' .

ind:ValuationReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Review' ;
    rdfs:comment 'Record of a formal valuation review or challenge event conducted by the Valuation Committee, IC (Investment Committee), or external auditor for a specific asset valuation or NAV record.' .

ind:PrivateAssetValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Private Asset Valuation' ;
    rdfs:comment 'Specialized valuation record for illiquid private market assets (private equity, infrastructure, real estate, natural resources) where observable market prices are unavailable.' .

ind:BrokerQuote rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Broker Quote' ;
    rdfs:comment 'Record of a broker or dealer price quote obtained for a security or instrument as a Level 2 pricing input. Captures instrument identifier (ISIN/CUSIP/SEDOL), broker/dealer name, LEI, quote date, bid price, ask price, mid price, quote type (indicative' .

ind:ValuationYieldCurve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Yield Curve' ;
    rdfs:comment 'Reference record for a yield curve or discount rate curve used in fixed income and DCF valuations. Captures curve name, curve type (government, swap, credit spread, OAS), currency, reference date, tenor points (3M, 6M, 1Y, 2Y, 5Y, 10Y, 30Y), corresponding' .

ind:ValuationFxRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Fx Rate' ;
    rdfs:comment 'Reference record for foreign exchange (FX) rates used in multi-currency asset valuations and NAV translation. Captures base currency, quote currency, spot rate, forward rate (1M, 3M, 6M, 12M), rate date, rate source (Bloomberg, WM/Reuters fixing), and' .

ind:NavLiability rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Nav Liability' ;
    rdfs:comment 'Record of liabilities deducted in the NAV computation for a fund or investment vehicle. Captures liability type (management fees payable, carried interest accrual, redemptions payable, borrowings, derivatives MTM liability, tax provisions), liability' .

ind:Input rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Input' ;
    rdfs:comment 'Granular record of a specific quantitative input used in an asset valuation model. Captures input name (revenue growth rate, terminal growth rate, cap rate, NOI, LTV, DSCR, occupancy rate, commodity price), input value, input unit, source (internal model' .

ind:Sensitivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Sensitivity' ;
    rdfs:comment 'Record of a sensitivity analysis run against a valuation model, capturing how the concluded fair value changes under alternative input assumptions. Captures the base case value, sensitivity variable (WACC, terminal growth rate, exit multiple, cap rate)' .

ind:RealEstateAppraisal rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Real Estate Appraisal' ;
    rdfs:comment 'Specialized appraisal record for direct real estate holdings capturing property-level valuation outputs from licensed appraisers. Captures property identifier, appraiser firm, appraisal date, appraisal methodology (income capitalization, discounted cash' .

ind:InfrastructureValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Infrastructure Valuation' ;
    rdfs:comment 'Specialized valuation record for direct infrastructure assets (toll roads, airports, utilities, pipelines, renewable energy) capturing infrastructure-specific valuation metrics.' .

ind:CreditInstrumentValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Credit Instrument Valuation' ;
    rdfs:comment 'Valuation record for credit and fixed income instruments including IG bonds, HY bonds, private credit, and sovereign debt. Captures instrument identifier (ISIN/CUSIP), face value, clean price, dirty price, accrued interest, YTM (Yield to Maturity), OAS' .

ind:PriceException rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Price Exception' ;
    rdfs:comment 'Operational data-quality exception record raised during a valuation cycle when a price or NAV input fails a validation tolerance — stale price, missing price, price move beyond threshold, source disagreement (Bloomberg vs broker quote), or NAV' .

ind:ExclusionScreening rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Exclusion Screening' ;
    rdfs:comment 'This association product represents the Exclusion Screening event between an asset valuation and an exclusion list entry. It captures the compliance screening process where each investment asset is checked against the fund\'s exclusion policies.' .

ind:ComplianceRequirement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Compliance Requirement' ;
    rdfs:comment 'This association product represents the compliance contract between a valuation methodology and a compliance rule. It captures which regulatory and internal rules each valuation methodology must adhere to, along with the compliance status, effective' .

ind:FilingInclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Filing Inclusion' ;
    rdfs:comment 'This association product represents the inclusion of a specific asset valuation in a regulatory filing. It captures the regulatory disclosure relationship between valuations and filings, tracking which valuations were reported to which regulatory' .

ind:QuoteSource rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Quote Source' ;
    rdfs:comment 'Master reference table for quote_source. Referenced by quote_source_id.' .

ind:ValuationDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Valuation ;
    rdfs:label 'Valuation Document' ;
    rdfs:comment 'Master reference table for valuation_document. Referenced by document_id.' .

ind:Limit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Limit' ;
    rdfs:comment 'Master registry of enterprise risk limits and thresholds governing investment exposures across all asset classes and portfolios. Captures limit type (VaR, CVaR, DV01, concentration, leverage, liquidity), limit value, breach tolerance bands, escalation' .

ind:Factor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Factor' ;
    rdfs:comment 'Master catalog of systematic risk factors used in factor-based risk decomposition and attribution across the investment portfolio. Covers equity style factors (value, momentum, quality, size, low-volatility), fixed income factors (duration, spread' .

ind:Model rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Model' ;
    rdfs:comment 'Master registry of quantitative risk models deployed across the enterprise for VaR, CVaR, factor risk, and stress testing. Records model name, model type (historical simulation, Monte Carlo, parametric), confidence level, lookback window, asset class' .

ind:StressScenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Stress Scenario' ;
    rdfs:comment 'Master catalog of macroeconomic and market stress scenarios used for portfolio stress testing and sensitivity analysis. Each scenario defines a named event (e.g., 2008 GFC, COVID-19 shock, rate hike +300bps, oil price collapse), scenario type (historical' .

ind:VarCalculation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Var Calculation' ;
    rdfs:comment 'Transactional record of each Value-at-Risk (VaR) and Conditional Value-at-Risk (CVaR) calculation run performed against a portfolio or position set. Captures calculation date, portfolio scope, risk model used, confidence level (95%, 99%), holding period' .

ind:RiskFactorExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Risk Factor Exposure' ;
    rdfs:comment 'Transactional record of a portfolio\'s or security\'s exposure to each systematic risk factor at a point in time, as computed by the risk model (MSCI Barra or BlackRock Aladdin).' .

ind:StressTestResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Stress Test Result' ;
    rdfs:comment 'Transactional record of the output from a stress test run applying a defined stress scenario to a portfolio or position set. Captures scenario applied, portfolio scope, stressed P&L impact (absolute and % of NAV), stressed VaR, stressed CVaR, asset class' .

ind:LimitBreach rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Limit Breach' ;
    rdfs:comment 'Transactional record of each risk limit breach event detected during daily or intraday risk monitoring. Captures the breached limit, breach date and time, breached metric value vs limit threshold, breach severity (warning, soft breach, hard breach)' .

ind:RiskCounterpartyExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Risk Counterparty Exposure' ;
    rdfs:comment 'Transactional record of gross and net credit exposure to each counterparty across all OTC derivatives, repo agreements, securities lending, and unsettled trades.' .

ind:ConcentrationExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Concentration Exposure' ;
    rdfs:comment 'Transactional record of portfolio concentration risk measurements across multiple dimensions: single issuer, sector/industry, geography, asset class, currency, and counterparty.' .

ind:Dv01Sensitivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Dv01 Sensitivity' ;
    rdfs:comment 'Transactional record of DV01 (Dollar Value of a Basis Point) and broader interest rate sensitivity measures for fixed income and rate-sensitive positions. Captures position or portfolio identifier, DV01 amount, duration (modified, effective, key-rate)' .

ind:LiquidityRiskAssessment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Liquidity Risk Assessment' ;
    rdfs:comment 'Transactional record of portfolio liquidity risk assessments measuring the ability to liquidate positions within defined time horizons without material market impact.' .

ind:FxRiskExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Fx Risk Exposure' ;
    rdfs:comment 'Transactional record of foreign exchange risk exposures across the investment portfolio, capturing unhedged and hedged currency positions by currency pair.' .

ind:Attribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Attribution' ;
    rdfs:comment 'Transactional record of risk attribution decomposing total portfolio risk (active risk / tracking error) into contributing sources: factor risk, specific risk, asset class risk, geographic risk, and currency risk.' .

ind:SensitivityAnalysis rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Sensitivity Analysis' ;
    rdfs:comment 'Transactional record of sensitivity analysis runs measuring portfolio or position value changes in response to defined single-factor shocks (e.g., equity market -10%, credit spreads +100bps, oil price -30%, inflation +50bps).' .

ind:RiskReview rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Risk Review' ;
    rdfs:comment 'Master record of formal periodic risk reviews conducted by the Risk Management team covering portfolio-level risk assessment, limit compliance status, emerging risk identification, and risk governance actions.' .

ind:LimitAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Limit Assignment' ;
    rdfs:comment 'Association record linking risk limits to specific portfolios, mandates, asset classes, or investment strategies. Captures the risk limit, the entity it applies to (portfolio, fund, asset class, manager mandate), effective start and end dates, assigned' .

ind:FactorReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Factor Return' ;
    rdfs:comment 'Transactional record of realized risk factor returns over defined periods, used for historical simulation VaR, factor model calibration, and performance attribution.' .

ind:CreditRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'Master record of external credit ratings assigned to issuers and instruments held in the portfolio, sourced from rating agencies (S&P, Moody\'s, Fitch) and internal credit assessment.' .

ind:RiskException rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Risk Exception' ;
    rdfs:comment 'Transactional record of formally approved exceptions to risk limits or investment policy constraints, where a portfolio is permitted to operate outside standard limits for a defined period.' .

ind:CorrelationMatrix rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Correlation Matrix' ;
    rdfs:comment 'Transactional record of asset class and factor correlation matrices used in portfolio risk calculations. Captures matrix type (asset class, factor, currency), the set of assets or factors included, correlation coefficients, estimation methodology (rolling' .

ind:AppetiteStatement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Appetite Statement' ;
    rdfs:comment 'Master record of the enterprise Risk Appetite Statement (RAS) defining the board-approved risk tolerance levels across risk categories: market risk, credit risk, liquidity risk, concentration risk, operational risk, and ESG risk.' .

ind:ModelValidation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Model Validation' ;
    rdfs:comment 'Transactional record of risk model validation and backtesting activities required for model risk governance (model risk management guidance / SR 11-7 style). Captures the risk model validated, validation type (initial, periodic, backtest, benchmarking), validation date' .

ind:ScenarioRequirement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Scenario Requirement' ;
    rdfs:comment 'This association product represents the contractual requirement linking stress scenarios to compliance obligations. It captures which stress scenarios must be executed to satisfy which regulatory or policy obligations, along with execution tracking and' .

ind:CalculationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Calculation Run' ;
    rdfs:comment 'Master reference table for calculation_run. Referenced by calculation_run_id.' .

ind:StressTestRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Stress Test Run' ;
    rdfs:comment 'Master reference table for stress_test_run. Referenced by stress_test_run_id.' .

ind:ValidationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Validation Run' ;
    rdfs:comment 'Master reference table for validation_run. Referenced by validation_run_id.' .

ind:FactorIcObservation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Factor Ic Observation' ;
    rdfs:comment 'Information coefficient of a factor signal, computed by the quant research team; one row per factor, period, holding period and sector.' .

ind:FactorSignalPrediction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Factor Signal Prediction' ;
    rdfs:comment 'One directional prediction of a factor signal for one security.' .

ind:StrategyBacktestResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Strategy Backtest Result' ;
    rdfs:comment 'Simulated performance of a candidate strategy, one row per strategy, vintage and period.' .

ind:FactorIcCorrelation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Risk ;
    rdfs:label 'Factor Ic Correlation' ;
    rdfs:comment 'Pairwise correlation of two factors information coefficients, one row per factor pair and period.' .

ind:IssuerEsgRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Issuer Esg Rating' ;
    rdfs:comment 'Master record of ESG ratings assigned to investable issuers (corporates, sovereigns, real assets) sourced primarily from MSCI ESG Ratings and supplemented by internal assessments.' .

ind:Framework rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Framework' ;
    rdfs:comment 'Reference catalogue of ESG frameworks, standards, and regulatory regimes adopted by the fund (PRI, SFDR, TCFD, UNGC, SASB, GRI, TNFD). Stores framework code, full name, governing body, applicable jurisdiction, version, effective date, and mandatory vs.' .

ind:EsgPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Esg Policy' ;
    rdfs:comment 'Master record of the fund\'s responsible investment policies and ESG integration mandates—including the Responsible Investment Policy, Exclusion Policy, Proxy Voting Policy, and Engagement Policy.' .

ind:ExclusionList rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Exclusion List' ;
    rdfs:comment 'Master record of securities, issuers, sectors, and geographies formally excluded from the investable universe under the fund\'s Exclusion Policy. Captures exclusion type (norm-based, sector-based, product-based), exclusion reason (controversial weapons' .

ind:SfdrClassification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Sfdr Classification' ;
    rdfs:comment 'Master record of SFDR (Sustainable Finance Disclosure Regulation) product-level classifications for each fund vehicle and mandate managed or invested in. Stores Article classification (6, 8, or 9), classification rationale, which Principal Adverse Impact' .

ind:TcfdDisclosure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Tcfd Disclosure' ;
    rdfs:comment 'Transactional record of annual TCFD (Task Force on Climate-related Financial Disclosures) climate risk disclosure submissions. Captures reporting period, governance narrative, strategy narrative, risk management narrative, physical risk exposure summary' .

ind:GhgEmissionRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Ghg Emission Record' ;
    rdfs:comment 'Transactional record of greenhouse gas (GHG) emissions data collected at the portfolio holding or asset level. Captures Scope 1, Scope 2 (location-based and market-based), and Scope 3 emissions in tCO2e, data source (reported vs.' .

ind:ClimateScenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Climate Scenario' ;
    rdfs:comment 'Reference catalogue of climate transition and physical risk scenarios used in stress testing and TCFD disclosures. Stores scenario name (e.g., NGFS Net Zero 2050, IEA SDS, RCP 2.6/4.5/8.5), scenario type (transition vs.' .

ind:EngagementActivity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Engagement Activity' ;
    rdfs:comment 'Transactional record of stewardship engagement interactions between the fund and investee companies or external managers. Captures engagement type (direct, collaborative, escalation), engagement topic (climate, board diversity, executive pay, supply' .

ind:EngagementObjective rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Engagement Objective' ;
    rdfs:comment 'Master record of structured engagement objectives and milestones set for each investee company or manager engagement program. Captures objective description, target ESG issue (E/S/G pillar), SMART milestone definition, target completion date, priority' .

ind:ProxyVoteRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Proxy Vote Record' ;
    rdfs:comment 'SSOT transactional record of proxy voting decisions cast at investee company shareholder meetings, including meeting date, resolution category, vote direction, and rationale. Governed by proxy_vote_policy guidelines.' .

ind:PriReportingSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Pri Reporting Submission' ;
    rdfs:comment 'Transactional record of annual PRI (Principles for Responsible Investment) Assessment submissions. Captures reporting year, module name (Strategy & Governance, Listed Equity, Private Equity, Real Estate, Infrastructure, Fixed Income), indicator code' .

ind:Controversy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Controversy' ;
    rdfs:comment 'Master record of ESG controversies, adverse-media events, and the resulting watch/escalation status flagged against investee companies or fund managers. Captures controversy type (environmental incident, labor violation, governance failure' .

ind:DueDiligence rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Due Diligence' ;
    rdfs:comment 'Transactional record of ESG due diligence assessments conducted during investment evaluation for new deals, co-investments, and external manager selections.' .

ind:KpiTarget rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Kpi Target' ;
    rdfs:comment 'Master record of ESG key performance indicator (KPI) targets set at the portfolio, asset class, or individual holding level. Captures KPI name, KPI category (carbon intensity, board diversity %, renewable energy %, water intensity, employee safety rate)' .

ind:KpiMeasurement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Kpi Measurement' ;
    rdfs:comment 'Transactional record of periodic ESG KPI actuals measured against targets at the holding or portfolio level. Captures measurement date, KPI reference, actual value, unit of measure, variance from target, data source, measurement methodology, data quality' .

ind:IntegrationChecklist rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Integration Checklist' ;
    rdfs:comment 'Transactional record of ESG integration checklist completions embedded within the investment lifecycle (deal screening, IC memo, annual review). Captures checklist type (pre-investment screening, annual monitoring, exit review), completion date' .

ind:NetZeroCommitment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Net Zero Commitment' ;
    rdfs:comment 'Master record of the fund\'s net-zero commitments and interim decarbonization targets at the total portfolio and asset class level. Captures commitment name, commitment standard (NZAOA, SBTi, IIGCC NZIF), base year emissions, interim target year, interim' .

ind:EsgBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Esg Benchmark' ;
    rdfs:comment 'Reference catalogue of ESG benchmarks and indices used for portfolio ESG performance comparison. Captures benchmark name, benchmark provider (MSCI, FTSE Russell, S&P), benchmark type (ESG Leaders, Paris-Aligned, Climate Transition, Best-in-Class)' .

ind:DataProvider rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Data Provider' ;
    rdfs:comment 'Reference master of external ESG data vendors and rating agencies contracted by the fund. Captures provider name (MSCI ESG, RepRisk, Sustainalytics, ISS ESG, CDP, Bloomberg ESG), data products subscribed, coverage universe (asset class, geography, issuer' .

ind:WatchList rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Watch List' ;
    rdfs:comment 'Master record of issuers, funds, or managers placed on formal ESG watch or review status due to deteriorating ESG ratings, controversy escalation, or policy breaches.' .

ind:ResponsibleInvestmentReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Responsible Investment Report' ;
    rdfs:comment 'Transactional record of formal responsible investment (RI) reports published by the fund for external stakeholders—beneficiaries, regulators, and the public.' .

ind:PaiIndicator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Pai Indicator' ;
    rdfs:comment 'Transactional/reference record of Principal Adverse Impact (PAI) indicator values tracked per issuer and per reporting period under SFDR Article 7 and the PAI Statement.' .

ind:TaxonomyAlignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Esg ;
    rdfs:label 'Taxonomy Alignment' ;
    rdfs:comment 'Record of EU Taxonomy eligibility and alignment at the economic-activity / holding level. Captures environmental objective (climate mitigation, adaptation, water, circular economy, pollution, biodiversity), eligible revenue/capex/opex %, aligned %' .

ind:Order rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Order' ;
    rdfs:comment 'Core order management record representing an investment order originating from portfolio managers via Charles River IMS or Bloomberg AIM across all liquid asset classes (equities, fixed income, FX, OTC derivatives).' .

ind:OrderAllocation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Order Allocation' ;
    rdfs:comment 'Broker and account allocation record that splits a parent order across multiple portfolios, accounts, or sub-mandates. Captures the allocation quantity, allocated notional, target portfolio, allocation percentage, allocation status, and the broker or' .

ind:Execution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Execution' ;
    rdfs:comment 'Trade execution record capturing the actual fill details from the market or execution venue. Represents a single execution event against a parent order, including executed price, executed quantity, execution timestamp, execution venue (exchange, ECN' .

ind:Blotter rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Blotter' ;
    rdfs:comment 'Consolidated intraday trade blotter record aggregating all executed trades across asset classes for a given trading day. Serves as the authoritative daily trade register for the investment book of record (IBOR).' .

ind:SettlementInstruction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Settlement Instruction' ;
    rdfs:comment 'Settlement instruction record governing the delivery and payment mechanics for a trade. Captures settlement date (T+2 standard or contractual), settlement method (DVP, FOP, DFP), settlement currency, custodian account, depository (DTC, Euroclear' .

ind:SettlementFail rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Settlement Fail' ;
    rdfs:comment 'Record of a settlement failure event where a trade did not settle on the contractual settlement date. Captures fail date, fail reason code (insufficient securities, cash shortfall, counterparty fail, SSI mismatch), fail duration in days, buy-in risk flag' .

ind:Confirmation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Confirmation' ;
    rdfs:comment 'Trade confirmation record representing the bilateral agreement between the pension fund and its counterparty confirming trade economics. Captures confirmation type (electronic via SWIFT/FIX, verbal, written), confirmation status (unconfirmed, matched' .

ind:Instrument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Instrument' ;
    rdfs:comment 'Master reference record for all tradeable financial instruments across asset classes—equities, fixed income, FX, and OTC derivatives. Serves as the SSOT for instrument identity within the trade domain.' .

ind:Broker rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Broker' ;
    rdfs:comment 'Master record for approved broker-dealers and execution counterparties used for trade execution across all asset classes. Captures broker legal name, LEI, BIC, regulatory registration numbers (FCA, SEC), approved asset classes, execution capabilities' .

ind:BrokerCommission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Broker Commission' ;
    rdfs:comment 'Record of commission and transaction cost charges payable to a broker for trade execution services. Captures commission amount, commission rate (bps), commission type (explicit, soft dollar, research payment), trade reference, settlement currency, payment' .

ind:StandingSettlementInstruction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Standing Settlement Instruction' ;
    rdfs:comment 'Standard Settlement Instruction master record defining the standing settlement details for a counterparty and instrument combination. Captures SSI version, effective date, expiry date, counterparty LEI, custodian BIC, depository account number, settlement' .

ind:FxTrade rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Fx Trade' ;
    rdfs:comment 'Foreign exchange trade record capturing spot, forward, and swap FX transactions executed to fund investments, repatriate proceeds, or hedge currency exposure.' .

ind:OtcDerivative rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Otc Derivative' ;
    rdfs:comment 'OTC derivative trade record for bilaterally negotiated derivative contracts including interest rate swaps, credit default swaps (CDS), total return swaps, and equity derivatives.' .

ind:CcpClearing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Ccp Clearing' ;
    rdfs:comment 'Central counterparty clearing record for exchange-traded and cleared OTC derivatives submitted to a CCP (e.g., LCH, CME Clearing, Eurex). Captures CCP name, clearing member, cleared trade reference, initial margin requirement, variation margin, clearing' .

ind:ExecutionVenue rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Execution Venue' ;
    rdfs:comment 'Master reference record for approved execution venues including regulated markets (exchanges), multilateral trading facilities (MTFs), systematic internalisers (SIs), and OTC bilateral venues.' .

ind:Amendment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Amendment' ;
    rdfs:comment 'Record of a post-trade amendment or correction applied to an executed trade. Captures amendment type (price correction, quantity adjustment, settlement date change, counterparty correction), original trade reference, amended field name, old value, new' .

ind:StatusHistory rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Status History' ;
    rdfs:comment 'Immutable trade audit and lifecycle trail capturing every change to a trade from order creation through settlement. Records both (a) status transitions — status_from, status_to, triggering event (execution, confirmation, settlement, cancellation), system' .

ind:TransactionCost rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Transaction Cost' ;
    rdfs:comment 'Comprehensive transaction cost SSOT capturing ALL explicit and implicit costs for a trade execution — including broker commission (with commission type: explicit, soft dollar, research payment, and soft-dollar research credit allocation per MiFID II' .

ind:AlgoOrder rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Algo Order' ;
    rdfs:comment 'Algorithmic execution order record capturing the parameters and performance of algorithmic trading strategies used to execute large orders with minimal market impact.' .

ind:CustodyAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Custody Account' ;
    rdfs:comment 'Master record for custody accounts held at custodian banks (State Street, Northern Trust) used to hold securities and cash on behalf of the pension fund\'s portfolios.' .

ind:InstrumentExclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Instrument Exclusion' ;
    rdfs:comment 'This association product represents the application of an exclusion policy to a specific financial instrument. It captures the compliance relationship between ESG exclusion lists and tradeable instruments in the pension fund\'s investable universe.' .

ind:NettingSetInclusion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Netting Set Inclusion' ;
    rdfs:comment 'This association product represents the inclusion of an OTC derivative trade within a netting agreement for exposure calculation and close-out netting purposes.' .

ind:TradeCheck rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Trade Check' ;
    rdfs:comment 'This association product represents the pre-trade compliance check event between an investment order and a compliance rule. It captures the result of validating each order against applicable compliance rules before execution, including the check outcome' .

ind:Custodian rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Custodian' ;
    rdfs:comment 'Master reference table for custodian. Referenced by custodian_id.' .

ind:AllocationGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Allocation Group' ;
    rdfs:comment 'Master reference table for allocation_group. Referenced by allocation_group_id.' .

ind:ClearingHouse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Trade ;
    rdfs:label 'Clearing House' ;
    rdfs:comment 'Master reference table for clearing_house. Referenced by clearing_house_id.' .

ind:CashPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Cash Position' ;
    rdfs:comment 'Authoritative IBOR/ABOR cash position record for each currency account held at custodians (State Street / Northern Trust). Captures intraday and end-of-day cash balances, projected cash, ledger cash, and custody cash across all fund entities and currency' .

ind:CashAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Cash Account' ;
    rdfs:comment 'Master record for each cash and settlement account maintained at custodian banks (State Street, Northern Trust) and internal treasury accounts. Captures account number, BIC/SWIFT, IBAN, correspondent bank details, currency, account type (settlement' .

ind:LiquidityForecast rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Liquidity Forecast' ;
    rdfs:comment 'Forward-looking liquidity projection records covering short-term (T+1 to T+30), medium-term (T+30 to T+90), and long-term (T+90 to T+365) horizons. Aggregates expected net contribution inflows from beneficiary pools (several participating plans' .

ind:NetContributionInflow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Net Contribution Inflow' ;
    rdfs:comment 'Records of net pension contributions received from each beneficiary pool (one per participating plan) representing the primary source of investable capital.' .

ind:CapitalCallFunding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Capital Call Funding' ;
    rdfs:comment 'Operational records tracking the funding workflow for private market capital calls (drawdowns) issued by GPs across private equity, infrastructure, real estate, and natural resources funds.' .

ind:FxPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Fx Position' ;
    rdfs:comment 'Master record of the fund\'s aggregate foreign exchange exposure by currency pair, capturing spot exposure, forward hedge notional, net open exposure, hedge ratio, and target hedge ratio per currency.' .

ind:FxForward rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Fx Forward' ;
    rdfs:comment 'Transactional record for each FX forward contract executed to hedge currency exposure arising from non-base-currency investments. Captures trade date, value date, maturity date, buy currency, sell currency, notional amount, forward rate, spot rate at inception' .

ind:FxSwap rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Fx Swap' ;
    rdfs:comment 'Transactional record for FX swap contracts used to roll FX forward hedges or manage short-term currency liquidity needs. Captures near leg and far leg details (dates, rates, notionals), currency pair, counterparty, ISDA agreement reference, purpose (hedge' .

ind:HedgeProgram rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Hedge Program' ;
    rdfs:comment 'Master record defining the FX hedging program parameters for each currency or asset class exposure. Captures target hedge ratio, permitted hedge ratio band (min/max), hedging instruments allowed (forwards, swaps, options), rebalancing trigger thresholds' .

ind:HedgeEffectiveness rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Hedge Effectiveness' ;
    rdfs:comment 'Periodic assessment records of FX hedge effectiveness under IFRS 9 hedge accounting requirements. Captures assessment date, hedge program reference, hedging instrument, hedged item, prospective effectiveness test method (regression, dollar-offset)' .

ind:ShortTermInstrument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Short Term Instrument' ;
    rdfs:comment 'Master record for short-term liquidity instruments held in the treasury portfolio including T-Bills, SOFR-linked instruments, commercial paper, bankers acceptances, and money market fund units.' .

ind:StInstrumentTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'St Instrument Transaction' ;
    rdfs:comment 'Transactional records for purchases, maturities, sales, and rollovers of short-term liquidity instruments (T-Bills, SOFR-linked, commercial paper). Captures transaction type, trade date, settlement date, instrument reference, face value, consideration' .

ind:CashTransfer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Cash Transfer' ;
    rdfs:comment 'Operational record for each internal and external cash movement initiated by treasury, including inter-account and overnight/threshold-triggered sweeps, custodian-to-custodian transfers, capital call wire payments, distribution receipts, and FX settlement' .

ind:CashReconciliation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Cash Reconciliation' ;
    rdfs:comment 'Daily reconciliation records comparing internal IBOR cash positions (SimCorp Dimension) against custodian-reported cash balances (State Street / Northern Trust) by account and currency.' .

ind:TreasuryFxRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Treasury Fx Rate' ;
    rdfs:comment 'Reference data table for official FX spot rates and forward points by currency pair and tenor, sourced from Bloomberg. Captures rate date, currency pair, spot rate, bid/ask spread, forward points by tenor (1W, 1M, 3M, 6M, 1Y), rate source, and rate type' .

ind:CounterpartyLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Counterparty Limit' ;
    rdfs:comment 'Treasury counterparty credit limit records defining the maximum permissible exposure to each bank or dealer counterparty for FX forwards, FX swaps, and short-term instrument transactions.' .

ind:TreasuryCounterpartyExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Treasury Counterparty Exposure' ;
    rdfs:comment 'Daily mark-to-market counterparty exposure records aggregating all outstanding FX forward, FX swap, and short-term instrument positions with each treasury counterparty.' .

ind:LiquidityReservePolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Liquidity Reserve Policy' ;
    rdfs:comment 'Master record defining the liquidity reserve policy parameters governing minimum cash buffer requirements, liquidity tier classifications, and stress liquidity thresholds.' .

ind:CashFlowEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Cash Flow Event' ;
    rdfs:comment 'Granular record of each expected or actual cash flow event feeding into the liquidity forecast, including scheduled capital calls, LP distributions received, coupon and dividend receipts, bond maturities, FX hedge settlements, management fee payments' .

ind:BankAccountSsi rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Bank Account Ssi' ;
    rdfs:comment 'Standard Settlement Instructions (SSI) reference records for each custodian bank account and counterparty settlement account used in treasury operations. Captures account name, account number, BIC/SWIFT code, IBAN, correspondent bank details, currency' .

ind:FxHedgeRebalance rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Fx Hedge Rebalance' ;
    rdfs:comment 'Operational records capturing each FX hedge rebalancing event triggered when currency exposures drift outside the permitted hedge ratio band defined in the hedge program.' .

ind:TreasuryPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Treasury Policy' ;
    rdfs:comment 'Master record defining the treasury investment mandate and operating parameters approved by the Investment Committee. Captures mandate version, effective date, permitted instrument types, maximum maturity for short-term instruments, counterparty' .

ind:SofrBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Sofr Benchmark' ;
    rdfs:comment 'Reference data for SOFR (Secured Overnight Financing Rate) and related overnight/term benchmark rates used to price SOFR-linked short-term instruments, calculate floating rate accruals, and benchmark treasury portfolio returns.' .

ind:DistributionReceipt rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Distribution Receipt' ;
    rdfs:comment 'Records of cash distributions received from private market fund investments (private equity, infrastructure, real estate, natural resources) including return of capital, realized gain distributions, income distributions, and recallable distributions.' .

ind:SweepInstruction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Sweep Instruction' ;
    rdfs:comment 'Automated and manual cash sweep instruction records governing the movement of excess cash from operating accounts into short-term liquidity instruments or between custodian accounts.' .

ind:GpBankAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Treasury ;
    rdfs:label 'Gp Bank Account' ;
    rdfs:comment 'Master reference table for gp_bank_account. Referenced by gp_bank_account_id.' .

ind:Counterparty rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Counterparty' ;
    rdfs:comment 'Master record for each counterparty entity in the pension fund\'s collateral and OTC derivatives ecosystem, including banks, broker-dealers, CCPs, and custodians.' .

ind:IsdaMaster rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Isda Master' ;
    rdfs:comment 'Master record for each ISDA Master Agreement executed between the pension fund and a counterparty. Captures agreement version (1992 or 2002 ISDA), execution date, governing law jurisdiction, default provisions, termination event clauses, close-out netting' .

ind:Csa rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Csa' ;
    rdfs:comment 'Master record for each Credit Support Annex (CSA) attached to an ISDA Master Agreement. Stores CSA type (English Law, New York Law, ISDA 2016 VM CSA), threshold amounts, minimum transfer amounts (MTA), independent amounts (IA), eligible collateral' .

ind:NettingAgreement rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Netting Agreement' ;
    rdfs:comment 'Master record for each bilateral netting agreement (close-out netting or payment netting) executed with a counterparty. Captures netting type (close-out, payment, novation), governing law, effective date, product scope (rates, FX, credit, equity' .

ind:EligibilitySchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Eligibility Schedule' ;
    rdfs:comment 'Defines the collateral eligibility criteria and haircut schedules applicable under each CSA or CCP clearing membership. Stores eligible asset classes (government bonds, agency bonds, cash, equities, money market funds), currency eligibility, minimum' .

ind:CreditLimit rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Credit Limit' ;
    rdfs:comment 'Master record defining the approved counterparty credit exposure limits set by the Investment Committee or Risk Committee for each counterparty. Stores limit type (pre-settlement, settlement, issuer, aggregate), limit currency, approved limit amount' .

ind:Exposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Exposure' ;
    rdfs:comment 'Daily counterparty exposure record capturing gross and net MTM exposure per counterparty across all OTC derivative netting sets. Stores valuation date, gross positive exposure (GPE), net exposure after netting, collateral held, net exposure after' .

ind:MarginCall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Margin Call' ;
    rdfs:comment 'Transactional record of each margin call issued or received in the collateral management workflow. Captures call date, call direction (call issued / call received), margin type (VM — Variation Margin or IM — Initial Margin), call amount, call currency' .

ind:MarginDispute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Margin Dispute' ;
    rdfs:comment 'Transactional record of each margin call dispute raised by either party. Captures dispute date, disputing party, disputed amount, dispute reason (valuation difference, eligibility disagreement, haircut dispute), resolution status (open, resolved' .

ind:Posting rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Posting' ;
    rdfs:comment 'Transactional record of each collateral posting or return instruction executed to satisfy a margin call. Captures posting date, posting direction (posted / received / returned), asset type (cash, government bond, agency bond, equity), ISIN/CUSIP of posted' .

ind:CollateralPosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Collateral Position' ;
    rdfs:comment 'Daily snapshot of the collateral inventory held or pledged with each counterparty or CCP, representing the current collateral book of record. Stores position date, counterparty or CCP, asset ISIN/CUSIP, asset type, nominal quantity, market value, haircut' .

ind:CcpMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Ccp Membership' ;
    rdfs:comment 'Master record for each Central Counterparty (CCP) clearing membership held by the pension fund or its clearing broker. Stores CCP name (LCH, Eurex, CME, ICE), membership type (direct clearing member, client clearing), clearing broker LEI, cleared product' .

ind:SimmCalculation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Simm Calculation' ;
    rdfs:comment 'Transactional record of each ISDA SIMM (Standard Initial Margin Model) calculation performed for bilateral uncleared OTC derivatives under EMIR UMR (Uncleared Margin Rules).' .

ind:RepoTransaction rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Repo Transaction' ;
    rdfs:comment 'Transactional record of each repurchase agreement (repo) or reverse repo executed for collateral transformation, liquidity management, or securities financing.' .

ind:SecuritiesLending rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Securities Lending' ;
    rdfs:comment 'Transactional record of each securities lending transaction where the pension fund lends securities from its portfolio in exchange for collateral. Captures loan open date, recall date, return date, lent security ISIN/CUSIP, quantity lent, collateral type' .

ind:Substitution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Substitution' ;
    rdfs:comment 'Transactional record of each collateral substitution request and execution, where previously posted collateral is replaced with an alternative eligible asset.' .

ind:CreditLimitBreach rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Credit Limit Breach' ;
    rdfs:comment 'Transactional record of each credit limit breach event where counterparty exposure exceeds an approved credit limit. Captures breach date, counterparty, limit type breached, approved limit amount, actual exposure at breach, breach magnitude (amount and' .

ind:EmirTradeReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Emir Trade Report' ;
    rdfs:comment 'Transactional record of each EMIR trade reporting submission for OTC derivative transactions to a registered Trade Repository (TR). Captures report date, UTI (Unique Trade Identifier), UPI (Unique Product Identifier), counterparty LEI, reporting' .

ind:SsiRegistry rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Ssi Registry' ;
    rdfs:comment 'Master registry of Standard Settlement Instructions (SSIs) for each counterparty and asset type combination used in collateral settlement. Stores counterparty LEI, asset type, currency, custodian BIC, account number, settlement platform (Euroclear' .

ind:CounterpartyRating rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Counterparty Rating' ;
    rdfs:comment 'Tracks the credit ratings assigned to each counterparty by external rating agencies (Moody\'s, S&P, Fitch) and internal credit assessment. Stores rating agency, rating type (long-term, short-term, outlook), rating value, rating date, prior rating, rating' .

ind:Recall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Recall' ;
    rdfs:comment 'Transactional record of each collateral recall instruction issued to retrieve previously posted collateral from a counterparty. Captures recall date, asset ISIN/CUSIP, quantity recalled, recall reason (trade maturity, rebalancing, substitution' .

ind:CounterpartyStressResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Counterparty Stress Result' ;
    rdfs:comment 'This association product represents the stress test result for a specific counterparty under a specific stress scenario. It captures the quantified impact of applying a macroeconomic or market stress scenario to a counterparty\'s exposure, including' .

ind:CollateralAccount rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Collateral ;
    rdfs:label 'Collateral Account' ;
    rdfs:comment 'Master reference table for collateral_account. Referenced by collateral_account_id.' .

ind:PortfolioReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Portfolio Return' ;
    rdfs:comment 'Core transactional record of calculated portfolio-level returns for each measurement period. Stores both Time-Weighted Return (TWR) and Money-Weighted Return (MWR/IRR), plus benchmark-relative metrics (gross and net-of-fee excess return, information' .

ind:Composite rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Composite' ;
    rdfs:comment 'Master record for each GIPS-compliant composite grouping portfolios with similar investment mandates and objectives. Defines composite construction rules, inclusion/exclusion criteria, composite inception date, benchmark assignment, and composite-level' .

ind:PerformanceCompositeMembership rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Performance Composite Membership' ;
    rdfs:comment 'Transactional association record tracking which portfolios are included in each GIPS composite for each measurement period. Captures inclusion start date, exclusion date, reason for exclusion (e.g., significant cash flow, mandate change), and the' .

ind:PerformanceBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Performance Benchmark' ;
    rdfs:comment 'Master record for each performance benchmark used across portfolios, composites, and mandates. Stores benchmark name, benchmark type (absolute return, market index, custom blended, liability-relative), index provider (e.g., MSCI, Bloomberg, FTSE)' .

ind:BenchmarkReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Benchmark Return' ;
    rdfs:comment 'Transactional record of benchmark-level returns for each measurement period, aligned to the same periodicity as portfolio returns. Captures benchmark total return, price return, income return, and currency-adjusted return.' .

ind:AttributionResult rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Attribution Result' ;
    rdfs:comment 'Core transactional record storing the results of a performance attribution run for one portfolio and measurement period. Captures total active return decomposed into allocation, selection, interaction, and currency effects using Brinson-Hood-Beebower' .

ind:AttributionSegment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Attribution Segment' ;
    rdfs:comment 'Transactional record capturing attribution effects at a single segment of an attribution run. A segment is defined by a dimension (sector, geography, asset class, factor, or currency pair) and carries portfolio weight, benchmark weight, portfolio return' .

ind:HoldingReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Holding Return' ;
    rdfs:comment 'Transactional record of security-level or position-level return contributions within a portfolio for a given measurement period. Captures beginning market value, ending market value, income received, realized gain/loss, unrealized gain/loss, total return' .

ind:PrivateAssetIrr rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Private Asset Irr' ;
    rdfs:comment 'Transactional record of IRR (Internal Rate of Return), MOIC (Multiple on Invested Capital), TVPI, DPI, and RVPI calculations for private market investments including private equity, real estate, infrastructure, natural resources, and credit.' .

ind:CashFlowRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Cash Flow Record' ;
    rdfs:comment 'Transactional record of all cash flows used in MWR and IRR calculations, including capital calls (drawdowns), distributions, income receipts, management fee payments, and net contributions from beneficiaries.' .

ind:PborSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Pbor Snapshot' ;
    rdfs:comment 'Master record representing the Performance Book of Record (PBOR) snapshot for each portfolio at each valuation date. Captures total portfolio market value (GAV and NAV), accrued income, unrealized gain/loss, realized gain/loss, net contributions for the' .

ind:GipsCompositeReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Gips Composite Report' ;
    rdfs:comment 'Transactional record representing the annual GIPS-compliant composite presentation prepared for each composite and reporting year. Captures composite annual return, benchmark annual return, composite 3-year annualized standard deviation, benchmark 3-year' .

ind:PerformanceFactorExposure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Performance Factor Exposure' ;
    rdfs:comment 'Transactional record of portfolio-level factor exposures used in factor-based performance attribution. Captures exposure to systematic risk factors (e.g., market beta, size, value, momentum, quality, low volatility, duration, credit spread) sourced from' .

ind:PeerGroup rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Peer Group' ;
    rdfs:comment 'Master record defining peer group universes used for relative performance comparison. Captures peer group name, peer group provider (e.g., CEM Benchmarking, Preqin, Mercer), asset class scope, peer group inception date, and methodology description.' .

ind:PeerGroupReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Peer Group Return' ;
    rdfs:comment 'Transactional record of peer group return statistics for each measurement period, including median return, 25th percentile, 75th percentile, top decile, bottom decile, and number of peers in the universe. Sourced from CEM Benchmarking, Preqin, and Mercer.' .

ind:ReturnPeriod rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Return Period' ;
    rdfs:comment 'Reference entity defining the standard measurement periods used across all performance calculations: daily, monthly, quarterly, fiscal year, calendar year, inception-to-date, rolling 1-year, rolling 3-year, rolling 5-year, rolling 10-year.' .

ind:AttributionModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Attribution Model' ;
    rdfs:comment 'Reference master record defining the attribution methodologies configured for use across portfolios and asset classes. Captures model name (e.g., Brinson-Hood-Beebower, Brinson-Fachler, factor-based, fixed income attribution), model type, currency' .

ind:FeeHurdle rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Fee Hurdle' ;
    rdfs:comment 'Master record defining the performance fee hurdle rate and high-water mark parameters applicable to each portfolio or mandate for performance fee calculation purposes.' .

ind:ExcessReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Excess Return' ;
    rdfs:comment 'Transactional record of benchmark-relative excess return (alpha) for each portfolio and measurement period. Captures gross excess return, net-of-fee excess return, currency-adjusted excess return, information ratio, tracking error, and Sharpe ratio.' .

ind:CurrencyAttribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Currency Attribution' ;
    rdfs:comment 'Transactional record capturing the currency effect component of performance attribution for each portfolio and measurement period. Stores currency allocation effect, currency selection effect, and hedging contribution broken down by currency pair.' .

ind:PerformanceCalculationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Performance Calculation Run' ;
    rdfs:comment 'Transactional record of each performance calculation batch execution, capturing run date, calculation type (daily NAV, month-end, quarter-end, GIPS annual), portfolios included, source system (SimCorp Dimension, eFront), calculation status (pending' .

ind:SignificantCashFlow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Significant Cash Flow' ;
    rdfs:comment 'Transactional record identifying significant external cash flows that trigger portfolio exclusion from GIPS composites or require sub-period return calculations.' .

ind:Dispersion rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Dispersion' ;
    rdfs:comment 'Transactional record of internal dispersion statistics for each GIPS composite and annual period, measuring the spread of individual portfolio returns within the composite.' .

ind:LdiReturn rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Ldi Return' ;
    rdfs:comment 'Transactional record of liability-relative performance for the fund\'s LDI (Liability-Driven Investment) portfolios. Captures funded ratio change, liability return (discount rate-driven), asset return, surplus return, hedging ratio effectiveness, and' .

ind:Notice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Notice' ;
    rdfs:comment 'Transactional record of formal performance notices issued to external managers when their mandate performance falls below agreed thresholds (e.g., underperformance vs. benchmark over rolling 3-year period, breach of tracking error band).' .

ind:PerformanceException rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Performance Exception' ;
    rdfs:comment 'Transactional record of performance data-quality exceptions and reconciliation breaks raised during a performance_calculation_run — e.g., PBOR-vs-ABOR market value variance beyond tolerance, missing security price, stale FX rate, negative or outlier TWR' .

ind:ScenarioApplication rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Scenario Application' ;
    rdfs:comment 'This association product represents the application of economic scenarios to GIPS-compliant composites for stress testing, ALM modeling, and Investment Committee presentations.' .

ind:ActiveReturnAttribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Performance ;
    rdfs:label 'Active Return Attribution' ;
    rdfs:comment 'Barra-style decomposition of active return; one row per portfolio, sector, factor and period.' .

ind:LiabilityProjection rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Liability Projection' ;
    rdfs:comment 'Core master record of actuarial liability projections for each contributor pool (one per participating plan). Captures projected benefit obligation (PBO), accumulated benefit obligation (ABO), projected cash flows by year' .

ind:ActuarialValuation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Actuarial Valuation' ;
    rdfs:comment 'Formal actuarial valuation record representing a full triennial or interim valuation of the pension fund AND the authoritative funded-status-at-date snapshot derived from it.' .

ind:AlmModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Alm Model' ;
    rdfs:comment 'Master record for each Asset-Liability Management (ALM) model configuration maintained by the actuarial team. Captures model name, model version, model type (deterministic, stochastic, scenario-based), liability benchmark used, asset universe in scope' .

ind:AlmScenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Alm Scenario' ;
    rdfs:comment 'Transactional record of each ALM scenario run executed against an ALM model. Captures scenario name, scenario type (base case, stress, reverse stress, stochastic path), interest rate shock applied, inflation shock, equity return assumption, credit spread' .

ind:DiscountRateCurve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Discount Rate Curve' ;
    rdfs:comment 'Master record for each discount rate curve used to value pension liabilities. Captures curve name, curve type (regulator-prescribed, IAS 19 corporate bond yield, risk-free, custom blend), effective date, currency, term structure (spot rates by tenor from 1Y to' .

ind:MortalityTable rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Mortality Table' ;
    rdfs:comment 'Master record for each mortality table or improvement scale used in actuarial liability calculations. Captures table name, table type (base mortality, improvement scale, generational projection), source (RP-2014, Pri-2012, custom blend)' .

ind:AssumptionSet rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Assumption Set' ;
    rdfs:comment 'Master record defining a complete, versioned, effective-dated set of actuarial assumptions used in a liability valuation or ALM run. Captures assumption set name, effective date, discount_rate_curve reference, mortality_table reference, inflation rate' .

ind:FundedStatus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Funded Status' ;
    rdfs:comment 'Transactional record capturing the funded status of the pension fund at a specific measurement date. Captures measurement date, total actuarial liability (going-concern and solvency bases), total market value of assets, funded ratio (assets/liabilities)' .

ind:ContributionRateModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Contribution Rate Model' ;
    rdfs:comment 'Master record for each contribution rate model defining the required employer and employee contribution rates for a contributor pool. Captures model name, contributor pool, effective date, normal cost rate (employer), normal cost rate (employee), special' .

ind:SpecialPaymentSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Special Payment Schedule' ;
    rdfs:comment 'Master record for each special payment (deficit amortization payment) schedule established to eliminate a solvency or going-concern deficiency. Captures schedule name, deficiency type (solvency, going-concern), total deficiency amount, amortization period' .

ind:LdiStrategy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Ldi Strategy' ;
    rdfs:comment 'Master record for each Liability-Driven Investment (LDI) strategy defined by the actuarial and investment teams. Captures strategy name, strategy type (full hedge, partial hedge, dynamic de-risking), liability hedge ratio target, interest rate hedge' .

ind:LdiHedgePosition rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Ldi Hedge Position' ;
    rdfs:comment 'Transactional record capturing the current LDI hedge position for a given strategy and measurement date. Captures strategy reference, measurement date, nominal hedge notional, interest rate DV01 of liabilities, interest rate DV01 of hedge portfolio' .

ind:LiabilityCashFlow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Liability Cash Flow' ;
    rdfs:comment 'Transactional record of disaggregated projected liability by contributor pool, segment, and year, derived from the actuarial liability projection. Captures projection date, contributor pool, segment type (active, deferred, retiree, survivor), projection' .

ind:SaaConstraint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Saa Constraint' ;
    rdfs:comment 'Master record defining actuarially-derived constraints on the Strategic Asset Allocation (SAA) imposed by liability characteristics. Captures constraint name, constraint type (minimum duration, maximum equity allocation, minimum real asset allocation' .

ind:ExperienceStudy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Experience Study' ;
    rdfs:comment 'Master record for each actuarial experience study conducted to compare actual plan experience against assumed experience. Captures study name, study period (start/end date), experience type (mortality, termination, retirement, disability, salary)' .

ind:GainLoss rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Gain Loss' ;
    rdfs:comment 'Transactional record capturing actuarial gains and losses arising from differences between actual and assumed experience in each valuation period. Captures measurement date, gain/loss type (demographic, economic, asset return, assumption change)' .

ind:DeRiskingTrigger rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'De Risking Trigger' ;
    rdfs:comment 'Master record defining funded-status-based de-risking triggers that automatically adjust the LDI hedge ratio or asset allocation glide path. Captures trigger name, trigger type (funded ratio threshold, interest rate level, surplus amount), trigger' .

ind:DeRiskingEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'De Risking Event' ;
    rdfs:comment 'Transactional record of each de-risking trigger breach event and the resulting portfolio action taken. Captures trigger reference, breach date, funded ratio at breach, trigger threshold breached, action mandated, action taken date, hedge ratio before' .

ind:IndexationPolicy rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Indexation Policy' ;
    rdfs:comment 'Master record defining the benefit indexation policy for each contributor pool, governing how pension benefits are adjusted for inflation (cost-of-living adjustments).' .

ind:PlanAmendment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Plan Amendment' ;
    rdfs:comment 'Master record of each formal pension plan amendment that modifies benefit terms, contribution rates, eligibility criteria, or indexation provisions. Captures amendment date, amendment type (benefit improvement, benefit reduction, contribution change' .

ind:ActuarialReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Actuarial Report' ;
    rdfs:comment 'Master record for each formal actuarial report produced by the internal or external actuarial team. Captures report name, report type (valuation report, experience study, ALM study, contribution rate review, regulatory filing, ad hoc analysis), reporting' .

ind:LiabilitySegment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Actuarial ;
    rdfs:label 'Liability Segment' ;
    rdfs:comment 'Master record defining the segmentation of total pension liabilities for ALM and LDI purposes. Captures segment name, segment type (active members, deferred members, retirees, survivors), contributor pool, total liability amount, duration of segment' .

ind:ManagementFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Management Fee' ;
    rdfs:comment 'Master record defining the management fee arrangement for each external manager mandate or internal investment structure. Captures the fee basis (AUM percentage, flat fee, tiered), applicable rate schedule, fee calculation frequency (monthly, quarterly' .

ind:CarriedInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Carried Interest' ;
    rdfs:comment 'Master record for each carried interest arrangement negotiated with a GP/external manager across PE, infrastructure, real estate, and natural resources structures.' .

ind:Waterfall rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Waterfall' ;
    rdfs:comment 'Master record defining the distribution waterfall structure for a private markets fund or co-investment vehicle. Captures waterfall type (European whole-fund vs American deal-by-deal), tier sequence, hurdle rate per tier, carry percentage per tier' .

ind:WaterfallTier rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Waterfall Tier' ;
    rdfs:comment 'Reference entity defining each sequential tier within a distribution waterfall structure. Captures tier sequence number, tier type (return of capital, preferred return/hurdle, GP catch-up, carried interest split), LP allocation percentage, GP allocation' .

ind:HurdleRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Hurdle Rate' ;
    rdfs:comment 'Master record tracking the preferred return (hurdle rate) applicable to each carried interest arrangement or fund structure. Captures hurdle rate percentage, compounding frequency (simple vs compound), hurdle basis (committed capital vs invested capital' .

ind:ClawbackProvision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Clawback Provision' ;
    rdfs:comment 'Master record for GP clawback provisions embedded within carried interest arrangements. Captures clawback trigger conditions (GP over-distribution relative to final fund IRR), maximum clawback amount, clawback escrow percentage, clawback calculation' .

ind:ClawbackEvent rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Clawback Event' ;
    rdfs:comment 'Transactional record of a clawback event triggered against a GP when carried interest distributions exceed the GP\'s entitlement based on final fund performance.' .

ind:Accrual rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Accrual' ;
    rdfs:comment 'Transactional record of periodic fee accruals computed for management fees, carried interest, and other investment-related fees. Captures accrual period (start/end date), fee type, accrual basis (AUM, NAV, committed capital), accrual rate applied, gross' .

ind:Payment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Payment' ;
    rdfs:comment 'Transactional record of actual fee payments disbursed to external managers, GPs, or service providers. Captures payment date, fee type (management fee, carried interest, transaction fee, monitoring fee), gross payment amount, withholding tax deducted, net' .

ind:Invoice rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Invoice' ;
    rdfs:comment 'Transactional record of fee invoices received from external managers or GPs for management fees, monitoring fees, and other mandate-related charges. Captures invoice date, invoice number, invoicing entity (GP/manager LEI), invoice period, fee type' .

ind:TransactionFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Transaction Fee' ;
    rdfs:comment 'Transactional record of deal-level transaction fees charged by GPs or advisors in connection with private market investment transactions (acquisition fees, disposition fees, financing fees, monitoring fees).' .

ind:GpFeeRebate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Gp Fee Rebate' ;
    rdfs:comment 'Master record tracking GP fee rebates and offsets applied to management fees as required under LPA terms. Captures rebate type (transaction fee offset, monitoring fee offset, advisory fee offset), rebate percentage per LPA, gross rebate amount earned in' .

ind:CarryDistribution rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Carry Distribution' ;
    rdfs:comment 'Transactional record of carried interest distributions paid to a GP following a realized investment event (exit, recapitalization, IPO). Captures distribution date, fund/vehicle reference, realized proceeds, return of capital amount, preferred return' .

ind:CarryEscrow rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Carry Escrow' ;
    rdfs:comment 'Master record tracking carried interest escrow accounts established to protect LP interests against potential clawback obligations. Captures escrow account reference, GP counterparty, escrow amount held, escrow percentage (of gross carry distributions)' .

ind:FeeBenchmark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Fee Benchmark' ;
    rdfs:comment 'Master record of external manager fee benchmarks used to assess the competitiveness of management fee and carried interest terms across the fund\'s manager universe.' .

ind:RateSchedule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Rate Schedule' ;
    rdfs:comment 'Reference entity defining tiered fee rate schedules applied during fee computation. Captures rate schedule name, fee type, AUM/NAV tier breakpoints, applicable fee rate per tier (bps), blended rate calculation method, currency, and effective/expiry dates.' .

ind:FeeCalculationRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Fee Calculation Run' ;
    rdfs:comment 'Transactional record of each periodic fee calculation run executed for management fees, carried interest, or other investment-related fees. Captures calculation run date, fee type, calculation period, AUM/NAV basis used, rate applied, gross fee computed' .

ind:Dispute rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Dispute' ;
    rdfs:comment 'Transactional record of fee disputes raised against external managers or GPs regarding incorrect fee calculations, unauthorized charges, or LPA non-compliance.' .

ind:Waiver rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Waiver' ;
    rdfs:comment 'Transactional record of management fee waivers or reductions granted by a GP to the fund, typically in connection with co-investment rights, LPAC participation, or large commitment size.' .

ind:MonitoringFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Monitoring Fee' ;
    rdfs:comment 'Master record for portfolio company monitoring fees charged by GPs to investee companies post-acquisition. Captures monitoring fee structure (annual flat fee vs percentage of EBITDA), fee amount, billing frequency, LPA offset provision (percentage' .

ind:OrganizationalExpense rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Organizational Expense' ;
    rdfs:comment 'Transactional record of fund organizational and formation expenses charged to the fund or LP during fund launch, including legal fees, placement agent fees, regulatory filing costs, and fund formation costs.' .

ind:PlacementFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Placement Fee' ;
    rdfs:comment 'Transactional record of placement agent fees paid in connection with fund capital raising activities. Captures placement agent identity, fee basis (percentage of committed capital), fee amount, payment date, retrocession arrangement (whether placement fee' .

ind:TransparencyReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Transparency Report' ;
    rdfs:comment 'Transactional record of periodic fee transparency disclosures prepared for beneficiaries, regulators, and governance bodies. Captures reporting period, total management fees paid (by asset class and manager), total carried interest paid, total transaction' .

ind:IncentiveFee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'Incentive Fee' ;
    rdfs:comment 'Master record for performance-based incentive fee arrangements applicable to external managers operating under SMA or liquid alternatives mandates. Captures incentive fee rate (percentage of outperformance), high-water mark provision, benchmark reference' .

ind:HighWaterMark rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Fee ;
    rdfs:label 'High Water Mark' ;
    rdfs:comment 'Master record tracking the high-water mark (HWM) level for each incentive fee arrangement on liquid strategy mandates. Captures current HWM NAV level, HWM reset date, cumulative underperformance deficit (loss carryforward), last crystallization date, last' .

ind:MacroIndicator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Macro Indicator' ;
    rdfs:comment 'Master library of macroeconomic indicators tracked and maintained by the research team, including GDP growth rates, inflation indices (CPI, PPI), unemployment rates, central bank policy rates, yield curves, PMI, credit spreads, and commodity price' .

ind:MacroIndicatorObservation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Macro Indicator Observation' ;
    rdfs:comment 'Transactional time-series records of macroeconomic indicator values, covering both observed/reported actuals and external consensus estimates, keyed to a macro_indicator at a point in time (daily, monthly, quarterly, annual).' .

ind:EconomicScenario rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Economic Scenario' ;
    rdfs:comment 'Master record of named macroeconomic scenarios defined and maintained by the research team for use in portfolio stress testing, ALM modeling, and IC presentations.' .

ind:ScenarioAssumption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Scenario Assumption' ;
    rdfs:comment 'Detailed assumption records associated with each economic scenario, specifying the projected values or shocks applied to individual macroeconomic indicators within that scenario.' .

ind:MarketDataFeed rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Market Data Feed' ;
    rdfs:comment 'Master catalogue of market data feed subscriptions and configurations managed by the research domain, covering Bloomberg Terminal, FactSet, Preqin, PitchBook, and MSCI data services.' .

ind:MarketDataSnapshot rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Market Data Snapshot' ;
    rdfs:comment 'Transactional silver-layer store of normalized inbound market data values captured from external feeds at a point in time for a given security, index, instrument, or currency pair.' .

ind:MacroModel rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Macro Model' ;
    rdfs:comment 'Master record of proprietary macroeconomic models developed and maintained by the research team. Captures model name, model type (DCF, factor model, yield curve model, regression, Monte Carlo), asset class applicability, model version, methodology' .

ind:MacroModelRun rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Macro Model Run' ;
    rdfs:comment 'Transactional record of each execution of a proprietary macro model, capturing the run date, input scenario reference, model version used, key output values (e.g., projected GDP, implied equity risk premium, fair value estimate, WACC), run status, and' .

ind:ResearchReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Research Report' ;
    rdfs:comment 'Master record of formal research publications produced by the internal research team across all publication types — sector, country/regional, thematic, asset-class, and macro outlooks plus IC-supporting investment memoranda.' .

ind:SectorOutlook rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Sector Outlook' ;
    rdfs:comment 'Master record of formal sector and industry outlook assessments produced by the research team, covering GICS sectors and sub-industries relevant to the fund\'s equity, credit, and private markets portfolios.' .

ind:CountryOutlook rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Country Outlook' ;
    rdfs:comment 'Master record of country and regional economic outlook assessments maintained by the research team, covering sovereign credit quality, political risk, regulatory environment, currency outlook, growth trajectory, and investment climate ratings.' .

ind:ThematicResearch rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Thematic Research' ;
    rdfs:comment 'Master record of long-horizon thematic investment research produced by the research team covering structural trends relevant to the fund\'s long-duration mandate — e.g., energy transition, digital infrastructure, demographic shifts, deglobalization, AI' .

ind:CoverageUniverse rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Coverage Universe' ;
    rdfs:comment 'Master record defining the research team\'s formally covered universe of issuers, sectors, geographies, and asset classes across ALL asset classes — including private markets, credit, and real assets — distinct from equity.coverage which is listed-equity' .

ind:AnalystAssignment rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Analyst Assignment' ;
    rdfs:comment 'Transactional record of research analyst assignments to coverage entities (issuers, sectors, geographies, asset classes) within the research coverage universe.' .

ind:IcResearchPack rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Ic Research Pack' ;
    rdfs:comment 'Master record of research packages formally prepared and submitted to the Investment Committee (IC) in support of investment decisions. Captures IC meeting reference, investment opportunity reference, pack type (new investment, follow-on, divestment' .

ind:MarketConsensus rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Market Consensus' ;
    rdfs:comment 'Transactional records of external market consensus estimates and forecasts collected from Bloomberg, FactSet, and sell-side aggregators for key macroeconomic indicators and security-level metrics (EPS, revenue, EBITDA, target price).' .

ind:ResearchYieldCurve rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Research Yield Curve' ;
    rdfs:comment 'Master record of yield curve definitions tracked by the research team across sovereign and credit markets, including government yield curves (US Treasury, UK Gilts, German Bunds), swap curves (SOFR, SONIA), and credit spread curves by rating bucket (IG' .

ind:YieldCurvePoint rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Yield Curve Point' ;
    rdfs:comment 'Transactional time-series records of yield curve data points at specific tenors and observation dates. Captures yield curve reference, tenor (3M, 6M, 1Y, 2Y, 5Y, 10Y, 20Y, 30Y), observed yield or spread (bps), observation date, and data source.' .

ind:ResearchFxRate rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Research Fx Rate' ;
    rdfs:comment 'Transactional records of foreign exchange (FX) spot and forward rates captured from Bloomberg and treasury systems for all currency pairs relevant to the fund\'s global investment portfolio.' .

ind:AssetClassOutlook rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Asset Class Outlook' ;
    rdfs:comment 'Master record of formal asset class outlook assessments produced by the research team covering all asset classes in the fund\'s SAA: public equities, private equity, real estate, infrastructure, natural resources, credit (IG, HY, private credit), and' .

ind:CapitalMarketAssumption rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Capital Market Assumption' ;
    rdfs:comment 'Master record of long-term capital market assumptions (CMAs) formally adopted by the research team for use in SAA optimization, ALM modeling, and actuarial liability matching.' .

ind:Calendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Calendar' ;
    rdfs:comment 'Master record of the research team\'s planned publication and event calendar, including scheduled macro indicator releases (e.g., CPI release dates, central bank meeting dates, earnings seasons), planned research report publication dates, IC presentation' .

ind:DataVendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Research ;
    rdfs:label 'Data Vendor' ;
    rdfs:comment 'Reference master of external market data and research data vendors contracted by the fund, including Bloomberg, FactSet, Preqin, PitchBook, MSCI, and Refinitiv.' .

ind:RegulatoryFiling rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Regulatory Filing' ;
    rdfs:comment 'Master record for each formal regulatory filing submitted to governing bodies (SEC, FCA, ESMA, IOSCO). Captures filing type, regulatory authority, reporting period, submission date, filing status (draft, submitted, acknowledged, accepted, rejected)' .

ind:FilingSubmission rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Filing Submission' ;
    rdfs:comment 'Transactional record of each individual submission event for a regulatory filing, capturing submission timestamp, submission method (portal, XBRL, API, manual), submitted by (officer/system), submission status, acknowledgement receipt reference, regulator' .

ind:RegulatoryCalendar rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Regulatory Calendar' ;
    rdfs:comment 'Authoritative register of every compliance obligation the pension fund must fulfil and its scheduled due dates across all jurisdictions and regulations. Captures obligation name, obligation type (regulatory reporting, disclosure, certification, record' .

ind:Rule rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Rule' ;
    rdfs:comment 'Master record defining each compliance monitoring rule configured in the rules engine (sourced from BlackRock Aladdin and Charles River IMS compliance modules).' .

ind:RuleBreach rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Rule Breach' ;
    rdfs:comment 'Operational record of each compliance rule breach detected by the rules engine (Aladdin, Charles River IMS), tracked through its full breach-to-resolution lifecycle.' .

ind:BreachRemediation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Breach Remediation' ;
    rdfs:comment 'Transactional record tracking the remediation workflow for each compliance rule breach. Captures remediation plan description, assigned officer, target remediation date, remediation actions taken (trade reversal, position reduction, waiver request, policy' .

ind:KycRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Kyc Record' ;
    rdfs:comment 'Master KYC (Know Your Customer) and AML (Anti-Money Laundering) compliance record for each counterparty, external manager, co-investor, or institutional relationship managed by the pension fund.' .

ind:SanctionsScreening rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Sanctions Screening' ;
    rdfs:comment 'Transactional record of each sanctions and PEP screening event conducted against a counterparty, issuer, manager, or individual. Captures screening date, screened entity name and LEI, screening list(s) applied (OFAC, UN, EU, HMT), screening result (clear' .

ind:TradeReport rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Trade Report' ;
    rdfs:comment 'Transactional record of each trade report submitted to a trade repository under EMIR or MiFID II transaction reporting obligations. Captures trade report reference, reporting regime (EMIR, MiFID II), trade repository (DTCC, REGIS-TR), UTI (Unique Trade' .

ind:LeiRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Lei Record' ;
    rdfs:comment 'Master record for each Legal Entity Identifier (LEI) managed or tracked by the pension fund, covering the fund itself, its subsidiaries, SPVs, and key counterparties.' .

ind:IcGovernanceRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Ic Governance Record' ;
    rdfs:comment 'Master record for each Investment Committee (IC) governance session managed via Diligent/BoardEffect. Captures IC meeting date, meeting type (regular IC, special IC, sub-committee), quorum status, agenda items, attendees and roles, decisions made' .

ind:IcDecision rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Ic Decision' ;
    rdfs:comment 'Transactional record of each formal Investment Committee decision made during an IC governance session. Captures decision date, IC session reference, decision subject (investment approval, mandate change, SAA revision, policy exception), decision type' .

ind:ConflictOfInterest rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Conflict Of Interest' ;
    rdfs:comment 'Master record of declared conflicts of interest by investment professionals, committee members, and officers of the pension fund. Captures declarant name and role, conflict type (personal investment, related party, board membership, prior employment)' .

ind:PolicyDocument rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Policy Document' ;
    rdfs:comment 'Master record for each internal compliance policy, investment policy statement, or regulatory procedure document maintained by the compliance function. Captures policy name, policy category (investment policy, AML policy, ESG policy, trading policy' .

ind:PolicyException rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Policy Exception' ;
    rdfs:comment 'Transactional record of each formal exception granted to a compliance policy or investment guideline. Captures exception request date, policy or rule being excepted, exception requestor, business justification, exception type (temporary, permanent' .

ind:RegulatoryChange rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Regulatory Change' ;
    rdfs:comment 'Master record tracking regulatory changes, new regulations, and amendments to existing rules that impact the pension fund\'s operations. Captures regulation name, issuing authority (SEC, FCA, ESMA), change type (new regulation, amendment, guidance' .

ind:RegulatoryExam rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Regulatory Exam' ;
    rdfs:comment 'Master record for each regulatory examination, inspection, or supervisory review conducted by a regulatory authority (SEC, FCA, ESMA) against the pension fund.' .

ind:ExamFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Exam Finding' ;
    rdfs:comment 'Transactional record of each finding or observation raised by a regulatory examiner during a supervisory examination. Captures finding reference, examination reference, finding category (deficiency, observation, recommendation, violation), finding' .

ind:BeneficiaryDisclosure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Beneficiary Disclosure' ;
    rdfs:comment 'Transactional record of each formal disclosure or regulatory report issued to pension beneficiaries, contributor pools, or sponsoring employers. Captures disclosure type (annual pension statement, benefit entitlement notice, plan amendment notice, SFDR' .

ind:AuditFinding rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Audit Finding' ;
    rdfs:comment 'Transactional record of each internal or external audit finding raised against the compliance, investment, or operational functions of the pension fund. Captures audit type (internal audit, external audit, SOC 2, ISO 27001), audit period, finding category' .

ind:PersonalAccountDealing rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Personal Account Dealing' ;
    rdfs:comment 'Transactional record of personal account dealing (PAD) disclosures and pre-clearance requests submitted by investment staff and officers. Captures employee name and role, security identifier (ISIN/CUSIP), transaction type (buy, sell, short), proposed' .

ind:RegulatoryAuthority rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'Reference master of all regulatory authorities and governing bodies with jurisdiction over the pension fund\'s operations. Captures authority name (SEC, FCA, ESMA, IOSCO, local pension regulator), authority type (prudential, conduct, market' .

ind:Obligation rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Obligation' ;
    rdfs:comment 'Master record defining each specific compliance obligation the pension fund must fulfill under applicable regulations, internal policies, or mandate terms.' .

ind:SfdrDisclosure rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Sfdr Disclosure' ;
    rdfs:comment 'Master record of SFDR (Sustainable Finance Disclosure Regulation) product-level and entity-level disclosures prepared and filed by the pension fund. Captures disclosure type (entity-level PAI statement, product-level pre-contractual, periodic report)' .

ind:GipsComplianceRecord rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Gips Compliance Record' ;
    rdfs:comment 'Master record tracking the pension fund\'s GIPS (Global Investment Performance Standards) compliance status at the composite and firm level. Captures GIPS compliance assertion date, compliance scope (firm-wide, composite-specific), composite reference' .

ind:Certification rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Compliance ;
    rdfs:label 'Certification' ;
    rdfs:comment 'Transactional record of periodic compliance certifications completed by investment staff, officers, and committee members. Captures certification type (annual compliance attestation, AML training completion, code of ethics acknowledgement, GIPS compliance' .

ind:Actor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Actor' ;
    rdfs:comment 'Master reference table for actor. ' .

ind:Employee rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Employee' ;
    rdfs:comment 'Master reference table for employee. ' .

ind:LegalEntity rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Legal Entity' ;
    rdfs:comment 'Master reference table for legal_entity. Referenced by legal_entity_id.' .

ind:Document rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Document' ;
    rdfs:comment 'Master reference table for document. Referenced by confirmation_document_id.' .

ind:FundAdministrator rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Fund Administrator' ;
    rdfs:comment 'Master reference table for fund_administrator. Referenced by administrator_id.' .

ind:Vendor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Vendor' ;
    rdfs:comment 'Master reference table for vendor. Referenced by vendor_id.' .

ind:Auditor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Auditor' ;
    rdfs:comment 'Master reference table for auditor. Referenced by auditor_id.' .

ind:Contract rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Contract' ;
    rdfs:comment 'Master reference table for contract. Referenced by contract_id.' .

ind:Contractor rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Contractor' ;
    rdfs:comment 'Master reference table for contractor. Referenced by contractor_id.' .

ind:Department rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Department' ;
    rdfs:comment 'Master reference table for department. Referenced by department_id.' .

ind:LoanServicer rdf:type rdfs:Class ;
    rdfs:subClassOf ind:Shared ;
    rdfs:label 'Loan Servicer' ;
    rdfs:comment 'Master reference table for loan_servicer. Referenced by servicer_id.' .

# --- Attribute Properties ---
ind:memberId rdf:type rdf:Property ;
    rdfs:label 'Member Id' ;
    rdfs:comment 'Globally unique identifier for the member record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Member .

ind:actorId rdf:type rdf:Property ;
    rdfs:label 'Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Members are pension beneficiaries (plan members and participating employers) who are actors in the system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:contributorPoolId rdf:type rdf:Property ;
    rdfs:label 'Contributor Pool Id' ;
    rdfs:comment 'Foreign key linking to beneficiary.contributor_pool. Business justification: Member has denormalized contributor_pool STRING field. Adding FK to contributor_pool table normalizes this relationship.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ContributorPool .

ind:employeeId rdf:type rdf:Property ;
    rdfs:label 'Employee Id' ;
