ind:compensationAmount rdf:type rdf:Property ;
    rdfs:label 'Compensation Amount' ;
    rdfs:comment 'Annual or per-meeting compensation paid to the member for advisory committee service, if applicable.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compensationCurrency rdf:type rdf:Property ;
    rdfs:label 'Compensation Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the compensation amount.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Agreement Date' ;
    rdfs:comment 'Date on which the member signed the confidentiality or non-disclosure agreement.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:confidentialityAgreementSigned rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Agreement Signed' ;
    rdfs:comment 'Indicates whether the member has executed the required confidentiality or non-disclosure agreement.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Conflict Disclosure Date' ;
    rdfs:comment 'Date on which the member submitted their conflict of interest disclosure.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conflictOfInterestDescription rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Description' ;
    rdfs:comment 'Detailed description of any disclosed conflicts of interest affecting the members advisory role.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictOfInterestDisclosed rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Disclosed' ;
    rdfs:comment 'Indicates whether the member has disclosed any conflicts of interest as required by governance policies.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactEmail rdf:type rdf:Property ;
    rdfs:label 'Contact Email' ;
    rdfs:comment 'Primary email address for official LPAC communications with the member.' ;
