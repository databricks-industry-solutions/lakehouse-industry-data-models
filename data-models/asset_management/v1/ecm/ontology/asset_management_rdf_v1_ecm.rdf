    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionSource rdf:type rdf:Property ;
    rdfs:label 'Position Source' ;
    rdfs:comment 'Origin of the data feed (internal system vs external market data).' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportableFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable Flag' ;
    rdfs:comment 'True if the position must be reported under EMIR or similar regulations.' ;
    rdfs:domain ind:CollateralPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearedProduct rdf:type rdf:Property ;
    rdfs:label 'Cleared Product' ;
    rdfs:comment 'Asset class or product category cleared under the membership.' ;
    rdfs:domain ind:CcpMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingBrokerLei rdf:type rdf:Property ;
