ind:isOpen rdf:type rdf:Property ;
    rdfs:label 'Is Open' ;
    rdfs:comment 'Indicates whether the repo transaction is currently open (true) or closed (false).' ;
    rdfs:domain ind:RepoTransaction ;
    rdf:type owl:DatatypeProperty ;
