ind:reportingDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Date' ;
    rdfs:comment 'Date when the financial results were officially reported or filed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revenue rdf:type rdf:Property ;
    rdfs:label 'Revenue' ;
    rdfs:comment 'Total revenue or net sales for the reporting period, in reporting currency.' ;
    rdfs:domain ind:IssuerFinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sharesOutstandingBasic rdf:type rdf:Property ;
    rdfs:label 'Shares Outstanding Basic' ;
    rdfs:comment 'Weighted average number of basic shares outstanding during the period.' ;
