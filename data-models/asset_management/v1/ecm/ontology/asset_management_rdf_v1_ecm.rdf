ind:lastExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Last Execution Date' ;
    rdfs:comment 'Date when this stress scenario was last executed specifically for this compliance obligation. Tracks execution history per obligation.' ;
    rdfs:domain ind:ScenarioRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextRequiredDate rdf:type rdf:Property ;
    rdfs:label 'Next Required Date' ;
    rdfs:comment 'The next date by which this stress scenario must be executed for this compliance obligation, based on filing frequency and regulatory requirements.' ;
    rdfs:domain ind:ScenarioRequirement ;
    rdf:type owl:DatatypeProperty ;
