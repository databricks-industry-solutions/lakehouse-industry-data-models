    rdfs:comment 'Quality assessment indicator for the price record, used for data governance and reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dividendAmount rdf:type rdf:Property ;
    rdfs:label 'Dividend Amount' ;
    rdfs:comment 'Cash dividend per share paid on the price date, if applicable.' ;
