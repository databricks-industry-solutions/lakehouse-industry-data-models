    rdfs:comment 'Total withholding tax deducted from income payments on this tax lot.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldAtAcquisition rdf:type rdf:Property ;
    rdfs:label 'Yield At Acquisition' ;
    rdfs:comment 'Yield to maturity or yield at the time of acquisition for fixed income tax lots.' ;
