    rdfs:domain ind:ResearchNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchStatus rdf:type rdf:Property ;
    rdfs:label 'Research Status' ;
    rdfs:comment 'Current lifecycle status of the research note in the publication workflow. [ENUM-REF-CANDIDATE: draft|peer_review|compliance_review|approved|published|archived|withdrawn — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueEstimateCurrentYear rdf:type rdf:Property ;
