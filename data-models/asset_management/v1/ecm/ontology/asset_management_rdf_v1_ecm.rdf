    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceCode rdf:type rdf:Property ;
    rdfs:label 'Source Code' ;
    rdfs:comment 'Standardized alphanumeric code uniquely identifying the quote source within the organization. Used for system integrations and reporting.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stalenessThresholdHours rdf:type rdf:Property ;
    rdfs:label 'Staleness Threshold Hours' ;
    rdfs:comment 'Maximum number of hours a price from this source can be considered valid before requiring refresh or escalation.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:quoteSourceStatus rdf:type rdf:Property ;
    rdfs:label 'Quote Source Status' ;
    rdfs:comment 'Current operational status of the quote source. Only active sources are used in production valuation processes.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsBidAskSpread rdf:type rdf:Property ;
    rdfs:label 'Supports Bid Ask Spread' ;
    rdfs:comment 'Indicates whether the source provides both bid and ask prices enabling spread analysis for liquidity assessment.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsHistoricalPrices rdf:type rdf:Property ;
    rdfs:label 'Supports Historical Prices' ;
    rdfs:comment 'Indicates whether the source provides access to historical pricing data for back-testing and performance attribution.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:timezone rdf:type rdf:Property ;
    rdfs:label 'Timezone' ;
    rdfs:comment 'IANA timezone identifier for the quote source (e.g., America/New_York, Europe/London). Used for timestamp normalization.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:toleranceThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Tolerance Threshold Percent' ;
    rdfs:comment 'Maximum acceptable percentage deviation from prior price before triggering price challenge workflow.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedByAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewed By Analyst Employee Id' ;
    rdfs:comment 'Reference to the senior analyst or manager who reviewed and approved the valuation.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded Document Id' ;
    rdfs:comment 'Reference to the prior valuation document that this document supersedes.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:capitalizationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Capitalization Rate Percent' ;
    rdfs:comment 'Cap rate used in real estate and infrastructure valuations to convert income to value.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:controlPremiumPercent rdf:type rdf:Property ;
    rdfs:label 'Control Premium Percent' ;
    rdfs:comment 'Premium applied to reflect controlling interest in the valued entity.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveUntilDate rdf:type rdf:Property ;
    rdfs:label 'Effective Until Date' ;
    rdfs:comment 'Date until which this valuation document remains valid before requiring update or supersession.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossAssetValue rdf:type rdf:Property ;
    rdfs:label 'Gross Asset Value' ;
    rdfs:comment 'Total gross asset value before deduction of liabilities, fees, and carried interest as determined in the valuation.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:illiquidityDiscountPercent rdf:type rdf:Property ;
    rdfs:label 'Illiquidity Discount Percent' ;
    rdfs:comment 'Discount applied to reflect lack of marketability for private or illiquid assets.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isAudited rdf:type rdf:Property ;
    rdfs:label 'Is Audited' ;
    rdfs:comment 'Indicates whether the valuation has been reviewed or audited by external auditors.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIndependentValuation rdf:type rdf:Property ;
    rdfs:label 'Is Independent Valuation' ;
    rdfs:comment 'Indicates whether the valuation was performed by an independent third-party valuation agent.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMaterialChange rdf:type rdf:Property ;
    rdfs:label 'Is Material Change' ;
    rdfs:comment 'Indicates whether this valuation reflects a material change from the prior valuation period.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextValuationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Valuation Due Date' ;
    rdfs:comment 'Scheduled date for the next periodic valuation update of the asset.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:valuationChangePercent rdf:type rdf:Property ;
    rdfs:label 'Valuation Change Percent' ;
    rdfs:comment 'Percentage change in fair value from the prior valuation period.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Valuation Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the valuation is denominated.' ;
    rdfs:domain ind:ValuationDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitId rdf:type rdf:Property ;
    rdfs:label 'Limit Id' ;
    rdfs:comment 'Unique identifier for the risk limit record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Limit .

ind:breachCountYtd rdf:type rdf:Property ;
    rdfs:label 'Breach Count Ytd' ;
    rdfs:comment 'Number of times this limit has been breached in the current calendar year.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachToleranceLower rdf:type rdf:Property ;
    rdfs:label 'Breach Tolerance Lower' ;
    rdfs:comment 'Lower threshold defining the soft breach tolerance band below the limit value, triggering monitoring alerts before hard breach.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachToleranceUpper rdf:type rdf:Property ;
    rdfs:label 'Breach Tolerance Upper' ;
    rdfs:comment 'Upper threshold defining the soft breach tolerance band above the limit value, triggering monitoring alerts before hard breach.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitCode rdf:type rdf:Property ;
    rdfs:label 'Limit Code' ;
    rdfs:comment 'Business-assigned unique code identifying the limit for operational reference and reporting.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationProcedure rdf:type rdf:Property ;
    rdfs:label 'Escalation Procedure' ;
    rdfs:comment 'Documented procedure and workflow to be followed when the limit is breached, including notification and approval requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitStatus rdf:type rdf:Property ;
    rdfs:label 'Limit Status' ;
    rdfs:comment 'Current lifecycle status of the risk limit indicating whether it is actively enforced, suspended, expired, awaiting approval, or retired.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitType rdf:type rdf:Property ;
    rdfs:label 'Limit Type' ;
    rdfs:comment 'Category of risk limit: Value at Risk (VaR), Conditional Value at Risk (CVaR), Dollar Value of 01 (DV01), concentration, leverage, or liquidity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitName rdf:type rdf:Property ;
    rdfs:label 'Limit Name' ;
    rdfs:comment 'Human-readable name describing the purpose and scope of the risk limit.' ;
    rdfs:domain ind:Limit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskSystemSource rdf:type rdf:Property ;
    rdfs:label 'Risk System Source' ;
    rdfs:comment 'Source system from which the limit and its monitoring data originate: BlackRock Aladdin, MSCI Barra, SimCorp Dimension, or internal risk platform.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Time Horizon Days' ;
    rdfs:comment 'Time horizon in days over which the risk metric is calculated, commonly 1-day or 10-day for VaR.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:utilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Utilization Percentage' ;
    rdfs:comment 'Current utilization of the limit expressed as a percentage of the limit value, calculated as (current exposure / limit value) * 100.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factorId rdf:type rdf:Property ;
    rdfs:label 'Factor Id' ;
    rdfs:comment 'Unique identifier for the systematic risk factor in the master catalog.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Factor .

ind:annualizedVolatilityPct rdf:type rdf:Property ;
    rdfs:label 'Annualized Volatility Pct' ;
    rdfs:comment 'Annualized standard deviation of the factor returns, expressed as a percentage, representing the factors historical volatility.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkIndexCode rdf:type rdf:Property ;
    rdfs:label 'Benchmark Index Code' ;
    rdfs:comment 'Code of the benchmark index or universe against which this factor is constructed or measured (e.g., MSCI ACWI, Bloomberg Barclays Aggregate).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorCode rdf:type rdf:Property ;
    rdfs:label 'Factor Code' ;
    rdfs:comment 'Standardized alphanumeric code uniquely identifying the factor across risk systems (e.g., VAL_FACTOR, MOM_FACTOR, DUR_FACTOR).' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlationToMarket rdf:type rdf:Property ;
    rdfs:label 'Correlation To Market' ;
    rdfs:comment 'Correlation coefficient between the factor returns and the broad market index returns, ranging from -1 to +1.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factorDescription rdf:type rdf:Property ;
    rdfs:label 'Factor Description' ;
    rdfs:comment 'Detailed business description of the factor, its economic rationale, and how it captures systematic risk or return drivers.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorStatus rdf:type rdf:Property ;
    rdfs:label 'Factor Status' ;
    rdfs:comment 'Current lifecycle status of the factor in the catalog (active, deprecated, under review, pending approval).' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorType rdf:type rdf:Property ;
    rdfs:label 'Factor Type' ;
    rdfs:comment 'Classification of the factor by its construction methodology (style, statistical, macroeconomic, fundamental, technical).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:informationRatio rdf:type rdf:Property ;
    rdfs:label 'Information Ratio' ;
    rdfs:comment 'Ratio of active return to tracking error, measuring the factors risk-adjusted outperformance relative to a benchmark.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isProprietary rdf:type rdf:Property ;
    rdfs:label 'Is Proprietary' ;
    rdfs:comment 'Indicates whether the factor is a proprietary internal model (True) or sourced from an external vendor (False).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:loadingInterpretation rdf:type rdf:Property ;
    rdfs:label 'Loading Interpretation' ;
    rdfs:comment 'Business interpretation guidance for positive and negative factor exposures (e.g., positive loading indicates value tilt, negative indicates growth tilt).' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxDrawdownPct rdf:type rdf:Property ;
    rdfs:label 'Max Drawdown Pct' ;
    rdfs:comment 'Largest peak-to-trough decline in the factors cumulative return history, expressed as a percentage.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnHistoryEndDate rdf:type rdf:Property ;
    rdfs:label 'Return History End Date' ;
    rdfs:comment 'Most recent date for which historical factor return data is available.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:returnHistoryStartDate rdf:type rdf:Property ;
    rdfs:label 'Return History Start Date' ;
    rdfs:comment 'Earliest date for which historical factor return data is available.' ;
    rdfs:domain ind:Factor ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sharpeRatio rdf:type rdf:Property ;
    rdfs:label 'Sharpe Ratio' ;
    rdfs:comment 'Risk-adjusted return metric for the factor, calculated as excess return over risk-free rate divided by volatility.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageInStressTesting rdf:type rdf:Property ;
    rdfs:label 'Usage In Stress Testing' ;
    rdfs:comment 'Indicates whether this factor is used in macroeconomic stress testing and scenario analysis (True) or not (False).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:usageInVarCalculation rdf:type rdf:Property ;
    rdfs:label 'Usage In Var Calculation' ;
    rdfs:comment 'Indicates whether this factor is included in the portfolio Value at Risk (VaR) calculation (True) or excluded (False).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendorModelName rdf:type rdf:Property ;
    rdfs:label 'Vendor Model Name' ;
    rdfs:comment 'Name of the vendor risk model or factor library from which this factor is sourced (e.g., Barra Global Equity Model, Aladdin Risk Model).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vendorModelVersion rdf:type rdf:Property ;
    rdfs:label 'Vendor Model Version' ;
    rdfs:comment 'Version identifier of the vendor risk model or factor library.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:backtestingFrequency rdf:type rdf:Property ;
    rdfs:label 'Backtesting Frequency' ;
    rdfs:comment 'Frequency at which model performance is validated against actual outcomes.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentationUrl rdf:type rdf:Property ;
    rdfs:label 'Documentation Url' ;
    rdfs:comment 'URL or file path to the detailed model documentation, methodology paper, or validation report.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorModelFlag rdf:type rdf:Property ;
    rdfs:label 'Factor Model Flag' ;
    rdfs:comment 'Indicates whether the model uses factor decomposition for risk attribution.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBacktestDate rdf:type rdf:Property ;
    rdfs:label 'Last Backtest Date' ;
    rdfs:comment 'Date when the most recent backtesting validation was performed.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastCalibrationDate rdf:type rdf:Property ;
    rdfs:label 'Last Calibration Date' ;
    rdfs:comment 'Date when the model parameters were last recalibrated using updated historical data.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:limitations rdf:type rdf:Property ;
    rdfs:label 'Limitations' ;
    rdfs:comment 'Known limitations, assumptions, or constraints of the model that users should be aware of.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackWindowDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Window Days' ;
    rdfs:comment 'Number of historical days used for model calibration and calculation.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:owner rdf:type rdf:Property ;
    rdfs:label 'Owner' ;
    rdfs:comment 'Name or identifier of the business unit or individual responsible for the model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approved Flag' ;
    rdfs:comment 'Indicates whether the model has been approved by regulatory authorities for capital adequacy or reporting purposes.' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskMeasure rdf:type rdf:Property ;
    rdfs:label 'Risk Measure' ;
    rdfs:comment 'Primary risk metric calculated by this model (VaR = Value at Risk, CVaR = Conditional Value at Risk, DV01 = Dollar Value of 01).' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simulationCount rdf:type rdf:Property ;
    rdfs:label 'Simulation Count' ;
    rdfs:comment 'Number of Monte Carlo simulations or scenarios executed per model run; applicable to Monte Carlo and scenario-based models.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stressTestFlag rdf:type rdf:Property ;
    rdfs:label 'Stress Test Flag' ;
    rdfs:comment 'Indicates whether the model is used for macroeconomic stress testing and scenario analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vendor rdf:type rdf:Property ;
    rdfs:label 'Vendor' ;
    rdfs:comment 'Name of the external vendor or system providing the model (e.g., BlackRock Aladdin, MSCI RiskMetrics, Barra, internal proprietary).' ;
    rdfs:domain ind:Model ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByScenarioStressScenarioId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Scenario Stress Scenario Id' ;
    rdfs:comment 'Reference to the stress scenario that supersedes this one if deprecated. Null if current.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressScenario .

ind:commodityShockPercent rdf:type rdf:Property ;
    rdfs:label 'Commodity Shock Percent' ;
    rdfs:comment 'Percentage change in commodity prices (e.g., oil, natural gas, metals). Positive for price increases, negative for decreases.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyDefaultRatePercent rdf:type rdf:Property ;
    rdfs:label 'Counterparty Default Rate Percent' ;
    rdfs:comment 'Assumed percentage of counterparties that default under the scenario.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditSpreadShockBps rdf:type rdf:Property ;
    rdfs:label 'Credit Spread Shock Bps' ;
    rdfs:comment 'Widening or tightening of credit spreads in basis points (bps). Positive for widening, negative for tightening.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cvarConfidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Cvar Confidence Level Percent' ;
    rdfs:comment 'Confidence level used for CVaR (Expected Shortfall) calculations under this scenario (e.g., 95.00, 99.00). Null if not applicable.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityShockPercent rdf:type rdf:Property ;
    rdfs:label 'Equity Shock Percent' ;
    rdfs:comment 'Percentage change applied to equity markets in this scenario (e.g., -40.0000 for 40% decline). Positive for gains, negative for losses.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalScenarioCode rdf:type rdf:Property ;
    rdfs:label 'External Scenario Code' ;
    rdfs:comment 'Identifier used by the external vendor or regulatory body for this scenario. Null for internal scenarios.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxShockPercent rdf:type rdf:Property ;
    rdfs:label 'Fx Shock Percent' ;
    rdfs:comment 'Percentage change in foreign exchange rates (e.g., domestic currency depreciation or appreciation). Positive for appreciation, negative for depreciation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdpShockPercent rdf:type rdf:Property ;
    rdfs:label 'Gdp Shock Percent' ;
    rdfs:comment 'Percentage change in GDP growth rate under the scenario (e.g., -5.0000 for 5% contraction).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:historicalEventDate rdf:type rdf:Property ;
    rdfs:label 'Historical Event Date' ;
    rdfs:comment 'Date of the historical event if the scenario is based on a past crisis (e.g., 2008-09-15 for Lehman collapse). Null for hypothetical scenarios.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indicatorWeight rdf:type rdf:Property ;
    rdfs:label 'Indicator Weight' ;
    rdfs:comment 'Relative weight or importance of this indicator\'s shock in the overall scenario impact calculation. Used for weighted stress metrics. Identified in detection phase.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inflationShockPercent rdf:type rdf:Property ;
    rdfs:label 'Inflation Shock Percent' ;
    rdfs:comment 'Percentage point change in inflation rate (e.g., +3.0000 for 3 percentage point increase in inflation).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRateShockBps rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Shock Bps' ;
    rdfs:comment 'Parallel shift in interest rates expressed in basis points (bps). Positive for rate increases, negative for decreases (e.g., +300 for 3% hike).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isBaseline rdf:type rdf:Property ;
    rdfs:label 'Is Baseline' ;
    rdfs:comment 'Flag indicating whether this is a baseline (no-stress) scenario used for comparison. True if baseline, False otherwise.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryRequired rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Required' ;
    rdfs:comment 'Flag indicating whether this scenario is mandated by a regulatory authority. True if required, False if discretionary.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liquidityShockDescription rdf:type rdf:Property ;
    rdfs:label 'Liquidity Shock Description' ;
    rdfs:comment 'Narrative description of liquidity stress conditions (e.g., bid-ask spreads widen 10x, redemption surge 20%, funding markets freeze).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:probabilityAssessment rdf:type rdf:Property ;
    rdfs:label 'Probability Assessment' ;
    rdfs:comment 'Qualitative assessment of the likelihood of the scenario occurring: very low, low, medium, high, very high, or not assessed.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realEstateShockPercent rdf:type rdf:Property ;
    rdfs:label 'Real Estate Shock Percent' ;
    rdfs:comment 'Percentage change in real estate valuations. Positive for appreciation, negative for depreciation.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryRatePercent rdf:type rdf:Property ;
    rdfs:label 'Recovery Rate Percent' ;
    rdfs:comment 'Assumed recovery rate on defaulted exposures (e.g., 40.0000 for 40% recovery).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatorySource rdf:type rdf:Property ;
    rdfs:label 'Regulatory Source' ;
    rdfs:comment 'Name of the regulatory body or framework that mandated this scenario (e.g., EBA, CCAR). Null for internal scenarios.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioCategory rdf:type rdf:Property ;
    rdfs:label 'Scenario Category' ;
    rdfs:comment 'Broad category of the stress event: market shock, credit event, liquidity crisis, macroeconomic downturn, geopolitical, operational, climate, pandemic, or cyber.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioCode rdf:type rdf:Property ;
    rdfs:label 'Scenario Code' ;
    rdfs:comment 'Unique business identifier code for the stress scenario (e.g., GFC_2008, COVID_SHOCK, RATE_HIKE_300).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioName rdf:type rdf:Property ;
    rdfs:label 'Scenario Name' ;
    rdfs:comment 'Human-readable name of the stress scenario (e.g., 2008 Global Financial Crisis, COVID-19 Market Shock, Oil Price Collapse).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioNarrative rdf:type rdf:Property ;
    rdfs:label 'Scenario Narrative' ;
    rdfs:comment 'Detailed narrative describing the scenario storyline, including macroeconomic context, triggering events, and transmission channels.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioStatus rdf:type rdf:Property ;
    rdfs:label 'Scenario Status' ;
    rdfs:comment 'Current lifecycle status of the stress scenario: draft (under development), active (approved for use), archived (historical reference), deprecated (no longer used), or under review (pending approval).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shockDirection rdf:type rdf:Property ;
    rdfs:label 'Shock Direction' ;
    rdfs:comment 'Direction of the shock: increase (positive shock), decrease (negative shock), or unchanged (indicator held constant). Identified in detection phase.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shockMagnitude rdf:type rdf:Property ;
    rdfs:label 'Shock Magnitude' ;
    rdfs:comment 'The magnitude of the shock applied to this indicator in this scenario, expressed in the indicator\'s native unit (percent, basis points, index points). Identified in detection phase.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shockMagnitudeDescription rdf:type rdf:Property ;
    rdfs:label 'Shock Magnitude Description' ;
    rdfs:comment 'Narrative description of the magnitude and nature of the stress shock (e.g., equity markets down 40%, credit spreads widen 500 bps, GDP contracts 5%).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizonMonths rdf:type rdf:Property ;
    rdfs:label 'Time Horizon Months' ;
    rdfs:comment 'Duration over which the stress scenario unfolds, expressed in months (e.g., 3, 6, 12, 24).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unemploymentShockPercent rdf:type rdf:Property ;
    rdfs:label 'Unemployment Shock Percent' ;
    rdfs:comment 'Percentage point change in unemployment rate (e.g., +5.0000 for 5 percentage point increase).' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageCount rdf:type rdf:Property ;
    rdfs:label 'Usage Count' ;
    rdfs:comment 'Number of times this scenario has been used in stress testing runs. Incremented with each execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varConfidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Var Confidence Level Percent' ;
    rdfs:comment 'Confidence level used for VaR calculations under this scenario (e.g., 95.00, 99.00). Null if not applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volatilityShockPercent rdf:type rdf:Property ;
    rdfs:label 'Volatility Shock Percent' ;
    rdfs:comment 'Percentage change in market volatility (e.g., VIX increase). Positive for volatility spike, negative for compression.' ;
    rdfs:domain ind:StressScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varCalculationId rdf:type rdf:Property ;
    rdfs:label 'Var Calculation Id' ;
    rdfs:comment 'Unique identifier for each VaR calculation run. Primary key for the var_calculation product.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:VarCalculation .

ind:calculationRunId rdf:type rdf:Property ;
    rdfs:label 'Calculation Run Id' ;
    rdfs:comment 'Business identifier for the calculation batch or run, used for grouping related VaR calculations executed together.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CalculationRun .

ind:backtestingExceptions rdf:type rdf:Property ;
    rdfs:label 'Backtesting Exceptions' ;
    rdfs:comment 'Number of times actual losses exceeded the VaR estimate during the backtesting period, used to assess model accuracy.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:backtestingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Backtesting Period End' ;
    rdfs:comment 'End date of the backtesting period used to validate the VaR model accuracy against actual portfolio returns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:backtestingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Backtesting Period Start' ;
    rdfs:comment 'Start date of the backtesting period used to validate the VaR model accuracy against actual portfolio returns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Calculation Duration Seconds' ;
    rdfs:comment 'Time taken to complete the VaR calculation, measured in seconds, used for performance monitoring.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correlationMatrixVersion rdf:type rdf:Property ;
    rdfs:label 'Correlation Matrix Version' ;
    rdfs:comment 'Version identifier of the correlation matrix used in parametric VaR calculations, tracking model updates over time.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cvarAmount rdf:type rdf:Property ;
    rdfs:label 'Cvar Amount' ;
    rdfs:comment 'The calculated CVaR or Expected Shortfall, representing the expected loss given that the loss exceeds the VaR threshold.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decompositionAvailable rdf:type rdf:Property ;
    rdfs:label 'Decomposition Available' ;
    rdfs:comment 'Indicates whether detailed risk factor decomposition or contribution analysis is available for this VaR calculation.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diversificationBenefit rdf:type rdf:Property ;
    rdfs:label 'Diversification Benefit' ;
    rdfs:comment 'Reduction in VaR due to portfolio diversification, calculated as the difference between sum of individual VaRs and portfolio VaR.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:historicalLookbackDays rdf:type rdf:Property ;
    rdfs:label 'Historical Lookback Days' ;
    rdfs:comment 'Number of historical days of market data used in the VaR calculation, typically 250 to 500 trading days.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:incrementalRiskCharge rdf:type rdf:Property ;
    rdfs:label 'Incremental Risk Charge' ;
    rdfs:comment 'Additional capital charge for default and migration risk in the trading book, complementing VaR measures.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityHorizonDays rdf:type rdf:Property ;
    rdfs:label 'Liquidity Horizon Days' ;
    rdfs:comment 'Estimated time in days required to liquidate the portfolio positions without significant market impact, used for liquidity-adjusted VaR.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketDataSource rdf:type rdf:Property ;
    rdfs:label 'Market Data Source' ;
    rdfs:comment 'Primary source of market data used for the VaR calculation, such as Bloomberg, Reuters, or internal pricing systems.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioValue rdf:type rdf:Property ;
    rdfs:label 'Portfolio Value' ;
    rdfs:comment 'The total market value of the portfolio at the calculation date, serving as the base for VaR percentage calculations.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionCount rdf:type rdf:Property ;
    rdfs:label 'Position Count' ;
    rdfs:comment 'Total number of positions or securities included in the portfolio for this VaR calculation.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryCapitalMultiplier rdf:type rdf:Property ;
    rdfs:label 'Regulatory Capital Multiplier' ;
    rdfs:comment 'Multiplier applied to VaR for regulatory capital calculation purposes, typically ranging from 3.0 to 4.0 based on backtesting results.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskFactorCount rdf:type rdf:Property ;
    rdfs:label 'Risk Factor Count' ;
    rdfs:comment 'Number of distinct risk factors or market variables considered in the VaR model, such as equity indices, interest rates, FX rates.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:simulationIterations rdf:type rdf:Property ;
    rdfs:label 'Simulation Iterations' ;
    rdfs:comment 'Number of simulation paths or iterations used in Monte Carlo VaR calculations, typically 10,000 or more.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stressVarAmount rdf:type rdf:Property ;
    rdfs:label 'Stress Var Amount' ;
    rdfs:comment 'VaR calculated using a stressed historical period, typically a 12-month period of significant financial stress.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varAmount rdf:type rdf:Property ;
    rdfs:label 'Var Amount' ;
    rdfs:comment 'The calculated VaR amount representing the maximum expected loss at the specified confidence level over the holding period.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varCurrency rdf:type rdf:Property ;
    rdfs:label 'Var Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the VaR amount is denominated.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varPercentage rdf:type rdf:Property ;
    rdfs:label 'Var Percentage' ;
    rdfs:comment 'VaR amount expressed as a percentage of total portfolio value, calculated as VaR amount divided by portfolio value.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volatilityAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Volatility Adjustment Factor' ;
    rdfs:comment 'Scaling factor applied to historical volatility estimates to account for current market conditions or regime changes.' ;
    rdfs:domain ind:VarCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskFactorId rdf:type rdf:Property ;
    rdfs:label 'Risk Factor Id' ;
    rdfs:comment 'Identifier of the systematic risk factor to which exposure is measured (e.g., market factor, size factor, value factor, momentum, sector, country, currency).' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Factor .

ind:asOfDate rdf:type rdf:Property ;
    rdfs:label 'As Of Date' ;
    rdfs:comment 'The business date for which this factor exposure snapshot is calculated. Represents the valuation date of the underlying positions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benchmarkExposure rdf:type rdf:Property ;
    rdfs:label 'Benchmark Exposure' ;
    rdfs:comment 'The factor exposure of the portfolios benchmark index. Used to calculate active exposure and tracking error contribution.' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionToRiskPercentage rdf:type rdf:Property ;
    rdfs:label 'Contribution To Risk Percentage' ;
    rdfs:comment 'The percentage of total portfolio risk attributable to this factor exposure. Sum across all factors equals 100%.' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cvarContribution rdf:type rdf:Property ;
    rdfs:label 'Cvar Contribution' ;
    rdfs:comment 'The contribution of this factor exposure to the portfolios Conditional Value at Risk (CVaR or Expected Shortfall), in base currency.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Exposure Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code in which the exposure value is denominated (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureDirection rdf:type rdf:Property ;
    rdfs:label 'Exposure Direction' ;
    rdfs:comment 'The directional bias of the factor exposure: long (positive exposure), short (negative exposure), or neutral (near-zero exposure).' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposurePercentage rdf:type rdf:Property ;
    rdfs:label 'Exposure Percentage' ;
    rdfs:comment 'The factor exposure expressed as a percentage of total portfolio risk or NAV. Facilitates relative comparison across factors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isMaterialExposure rdf:type rdf:Property ;
    rdfs:label 'Is Material Exposure' ;
    rdfs:comment 'Boolean flag indicating whether this factor exposure exceeds the materiality threshold defined in the risk policy (True) or not (False).' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Limit Breach Flag' ;
    rdfs:comment 'Boolean flag indicating whether this factor exposure breaches the defined risk limit (True) or is within limits (False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitUtilizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Limit Utilization Percentage' ;
    rdfs:comment 'The percentage of the risk limit consumed by this factor exposure. Values over 100% indicate a breach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedExposureValue rdf:type rdf:Property ;
    rdfs:label 'Stressed Exposure Value' ;
    rdfs:comment 'The factor exposure value under the applied stress scenario. Nullable for baseline exposures.' ;
    rdfs:domain ind:RiskFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackingErrorContribution rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Contribution' ;
    rdfs:comment 'The contribution of this factor exposure to the portfolios tracking error versus its benchmark, expressed in basis points.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varContribution rdf:type rdf:Property ;
    rdfs:label 'Var Contribution' ;
    rdfs:comment 'The contribution of this factor exposure to the portfolios total Value at Risk (VaR), in base currency.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressTestResultId rdf:type rdf:Property ;
    rdfs:label 'Stress Test Result Id' ;
    rdfs:comment 'Unique identifier for the stress test result record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressTestResult .

ind:hedgeProgramId rdf:type rdf:Property ;
    rdfs:label 'Hedge Program Id' ;
    rdfs:comment 'Foreign key linking to the hedge program being stress tested' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HedgeProgram .

ind:performanceCalculationRunId rdf:type rdf:Property ;
    rdfs:label 'Performance Calculation Run Id' ;
    rdfs:comment 'Foreign key linking to performance.performance_calculation_run. Business justification: Stress tests use baseline NAV from performance calculations. Pension funds require traceability from stressed results to the specific performance run that established' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceCalculationRun .

ind:stressTestRunId rdf:type rdf:Property ;
    rdfs:label 'Stress Test Run Id' ;
    rdfs:comment 'Identifier of the parent stress test execution run that generated this result.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressTestRun .

ind:baseCvar rdf:type rdf:Property ;
    rdfs:label 'Base Cvar' ;
    rdfs:comment 'Conditional Value at Risk (expected shortfall) of the portfolio before applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseNav rdf:type rdf:Property ;
    rdfs:label 'Base Nav' ;
    rdfs:comment 'Net Asset Value of the portfolio before applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseVar rdf:type rdf:Property ;
    rdfs:label 'Base Var' ;
    rdfs:comment 'Value at Risk of the portfolio before applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyExposureChange rdf:type rdf:Property ;
    rdfs:label 'Counterparty Exposure Change' ;
    rdfs:comment 'Change in aggregate counterparty credit exposure resulting from the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectivenessUnderStress rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Under Stress' ;
    rdfs:comment 'Assessment of whether the hedging relationship would remain effective under the stress scenario conditions, per IFRS 9 hedge accounting requirements. Determines if hedge accounting treatment could be maintained.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorContributionSummary rdf:type rdf:Property ;
    rdfs:label 'Factor Contribution Summary' ;
    rdfs:comment 'Summary of key risk factor contributions to the stressed P&L (e.g., equity factor, interest rate factor, credit spread factor).' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityImpactDays rdf:type rdf:Property ;
    rdfs:label 'Liquidity Impact Days' ;
    rdfs:comment 'Estimated number of days required to liquidate the stressed positions under the scenario conditions, reflecting liquidity risk.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:positionQuantity rdf:type rdf:Property ;
    rdfs:label 'Position Quantity' ;
    rdfs:comment 'The quantity of the instrument held at calculation date. Required to calculate stressed P&L from per-unit impact.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalanceTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Rebalance Trigger Flag' ;
    rdfs:comment 'Indicates whether the stress scenario would cause the hedge ratio to breach the permitted band (min/max hedge ratio) and trigger a mandatory rebalancing event for this hedge program.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryScenarioFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Scenario Flag' ;
    rdfs:comment 'Indicates whether this stress test was performed to satisfy a regulatory requirement (True) or for internal risk management purposes (False).' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:resultTimestamp rdf:type rdf:Property ;
    rdfs:label 'Result Timestamp' ;
    rdfs:comment 'Date and time when the stress test result was calculated and recorded.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scenarioImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Scenario Impact Amount' ;
    rdfs:comment 'The calculated mark-to-market or P&L impact of applying this stress scenario to this hedge program, expressed in the fund\'s base currency. Positive values indicate gains, negative values indicate losses under the stress scenario.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivity rdf:type rdf:Property ;
    rdfs:label 'Sensitivity' ;
    rdfs:comment 'The sensitivity of this instrument to the scenario shocks. For equities this may be beta, for bonds duration/convexity, for derivatives delta/gamma. Captures how the instrument responds to the scenario factors.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shockValue rdf:type rdf:Property ;
    rdfs:label 'Shock Value' ;
    rdfs:comment 'The specific shock value applied to this instrument under this scenario. May differ from scenario-level defaults based on instrument characteristics (e.g., sector-specific equity shocks, credit-rating-specific spread shocks).' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedCvar rdf:type rdf:Property ;
    rdfs:label 'Stressed Cvar' ;
    rdfs:comment 'Conditional Value at Risk (expected shortfall) of the portfolio after applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedMarketValue rdf:type rdf:Property ;
    rdfs:label 'Stressed Market Value' ;
    rdfs:comment 'The market value of the position in base currency after applying the scenario stress shocks.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedNav rdf:type rdf:Property ;
    rdfs:label 'Stressed Nav' ;
    rdfs:comment 'Net Asset Value of the portfolio after applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedPnl rdf:type rdf:Property ;
    rdfs:label 'Stressed Pnl' ;
    rdfs:comment 'The calculated profit and loss impact for this instrument under this scenario, expressed in base currency. Represents the contribution of this position to total portfolio stress loss.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedPnlAbsolute rdf:type rdf:Property ;
    rdfs:label 'Stressed Pnl Absolute' ;
    rdfs:comment 'Absolute change in portfolio value resulting from the stress scenario (stressed NAV minus base NAV), in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedPnlPercentage rdf:type rdf:Property ;
    rdfs:label 'Stressed Pnl Percentage' ;
    rdfs:comment 'Percentage change in portfolio value resulting from the stress scenario, expressed as a decimal (e.g., -0.1250 for -12.50%).' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedVar rdf:type rdf:Property ;
    rdfs:label 'Stressed Var' ;
    rdfs:comment 'Value at Risk of the portfolio after applying the stress scenario, in the reporting currency.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:testExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Test Execution Date' ;
    rdfs:comment 'Date on which this stress test was executed. Required for audit trail and regulatory reporting of when stress tests were performed.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testStatus rdf:type rdf:Property ;
    rdfs:label 'Test Status' ;
    rdfs:comment 'Lifecycle status of this stress test record, tracking progression from execution through review and approval for regulatory reporting.' ;
    rdfs:domain ind:StressTestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Acknowledged By Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Breach acknowledgment must be traceable for escalation procedures. Pension funds require documented accountability for who acknowledged each limit breach per risk governance.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:triggeringOrderId rdf:type rdf:Property ;
    rdfs:label 'Triggering Order Id' ;
    rdfs:comment 'Foreign key linking to trade.order. Business justification: Pre-trade compliance and breach remediation require linking breaches to triggering orders. Risk teams must identify which orders caused limit violations for regulatory reporting (AIFMD, UCITS)' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:breachCode rdf:type rdf:Property ;
    rdfs:label 'Breach Code' ;
    rdfs:comment 'Unique business identifier code for the breach event, used for tracking and reporting.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Breach Duration Minutes' ;
    rdfs:comment 'Duration in minutes that the breach persisted before returning to compliance or being remediated.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachMagnitude rdf:type rdf:Property ;
    rdfs:label 'Breach Magnitude' ;
    rdfs:comment 'Absolute difference between the breached metric value and the limit threshold.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachTimestamp rdf:type rdf:Property ;
    rdfs:label 'Breach Timestamp' ;
    rdfs:comment 'Date and time when the limit breach was first detected by the risk monitoring system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breachedMetricValue rdf:type rdf:Property ;
    rdfs:label 'Breached Metric Value' ;
    rdfs:comment 'Actual value of the risk metric at the time of breach detection.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:detectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Detection Timestamp' ;
    rdfs:comment 'Date and time when the breach was identified and logged by the risk system, may differ from breach timestamp if detected retrospectively.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intradayBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Intraday Breach Flag' ;
    rdfs:comment 'Indicates whether the breach occurred during intraday monitoring versus end-of-day monitoring.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitThresholdValue rdf:type rdf:Property ;
    rdfs:label 'Limit Threshold Value' ;
    rdfs:comment 'The threshold value of the limit that was breached, captured at time of breach for audit trail.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remediatedBy rdf:type rdf:Property ;
    rdfs:label 'Remediated By' ;
    rdfs:comment 'Name or identifier of the portfolio manager or trader who executed the remediation action.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Remediation Timestamp' ;
    rdfs:comment 'Date and time when remediation action was completed and the breach was resolved.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskMetricType rdf:type rdf:Property ;
    rdfs:label 'Risk Metric Type' ;
    rdfs:comment 'Type of risk metric that breached the limit such as Value at Risk (VaR), Conditional Value at Risk (CVaR), Dollar Value of 01 (DV01), concentration, or liquidity.' ;
    rdfs:domain ind:LimitBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCounterpartyExposureId rdf:type rdf:Property ;
    rdfs:label 'Risk Counterparty Exposure Id' ;
    rdfs:comment 'Unique identifier for each counterparty exposure record in the risk management system.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:csaId rdf:type rdf:Property ;
    rdfs:label 'Csa Id' ;
    rdfs:comment 'Foreign key linking to collateral.csa. Business justification: CSA terms (thresholds, minimum transfer amounts) directly impact collateral-adjusted exposure calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Csa .

ind:nettingAgreementId rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Id' ;
    rdfs:comment 'Foreign key linking to collateral.netting_agreement. Business justification: Netting agreements directly reduce counterparty exposure through close-out netting. Pension fund risk teams must calculate net exposure using actual netting agreement terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NettingAgreement .

ind:otcDerivativeId rdf:type rdf:Property ;
    rdfs:label 'Otc Derivative Id' ;
    rdfs:comment 'Foreign key linking to trade.otc_derivative. Business justification: Counterparty credit exposure calculations must link to underlying OTC derivatives for CVA/DVA computation, EMIR reporting, and ISDA CSA margin calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OtcDerivative .

ind:collateralAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Agreement Flag' ;
    rdfs:comment 'Indicates whether a collateral support agreement is in place with the counterparty.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralAgreementType rdf:type rdf:Property ;
    rdfs:label 'Collateral Agreement Type' ;
    rdfs:comment 'The type of collateral support agreement governing margin and collateral exchange with the counterparty.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralHeldAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Held Amount' ;
    rdfs:comment 'The market value of collateral held from the counterparty to mitigate credit exposure, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralPostedAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Posted Amount' ;
    rdfs:comment 'The market value of collateral posted to the counterparty, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concentrationLimitUtilization rdf:type rdf:Property ;
    rdfs:label 'Concentration Limit Utilization' ;
    rdfs:comment 'The percentage of the counterparty concentration limit currently utilized by this exposure, expressed as a decimal.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyCreditRating rdf:type rdf:Property ;
    rdfs:label 'Counterparty Credit Rating' ;
    rdfs:comment 'The external credit rating assigned to the counterparty by a recognized rating agency. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR — 11 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditValuationAdjustment rdf:type rdf:Property ;
    rdfs:label 'Credit Valuation Adjustment' ;
    rdfs:comment 'The market value adjustment to reflect counterparty credit risk in OTC derivative valuations.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debitValuationAdjustment rdf:type rdf:Property ;
    rdfs:label 'Debit Valuation Adjustment' ;
    rdfs:comment 'The market value adjustment to reflect own credit risk in OTC derivative valuations.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveMaturityYears rdf:type rdf:Property ;
    rdfs:label 'Effective Maturity Years' ;
    rdfs:comment 'The effective maturity of the exposure in years, used in regulatory capital calculations.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedExposure rdf:type rdf:Property ;
    rdfs:label 'Expected Exposure' ;
    rdfs:comment 'The mean of the probability distribution of exposure at a future date, used in credit valuation adjustment calculations.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:independentAmount rdf:type rdf:Property ;
    rdfs:label 'Independent Amount' ;
    rdfs:comment 'The fixed collateral amount required to be posted regardless of mark-to-market exposure, providing additional credit protection.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Margin Threshold Amount' ;
    rdfs:comment 'The exposure threshold below which no collateral is required to be posted under the collateral agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumTransferAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Transfer Amount' ;
    rdfs:comment 'The minimum collateral amount that must be transferred in any single margin call under the collateral agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nettingAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Flag' ;
    rdfs:comment 'Indicates whether a legally enforceable netting agreement is in place with the counterparty.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nettingAgreementType rdf:type rdf:Property ;
    rdfs:label 'Netting Agreement Type' ;
    rdfs:comment 'The type of master netting agreement governing the exposure relationship with the counterparty.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Netting Benefit Amount' ;
    rdfs:comment 'The reduction in exposure achieved through legally enforceable netting agreements, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:potentialFutureExposure rdf:type rdf:Property ;
    rdfs:label 'Potential Future Exposure' ;
    rdfs:comment 'The estimated maximum exposure that could arise in the future due to market movements, calculated using simulation models.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfDefault rdf:type rdf:Property ;
    rdfs:label 'Probability Of Default' ;
    rdfs:comment 'The estimated likelihood that the counterparty will default within a one-year horizon, expressed as a decimal.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskWeight rdf:type rdf:Property ;
    rdfs:label 'Risk Weight' ;
    rdfs:comment 'The regulatory risk weight applied to this exposure for capital adequacy calculations, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskWeightedExposure rdf:type rdf:Property ;
    rdfs:label 'Risk Weighted Exposure' ;
    rdfs:comment 'The exposure amount multiplied by the applicable risk weight, used in regulatory capital calculations.' ;
    rdfs:domain ind:RiskCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wrongWayRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Wrong Way Risk Flag' ;
    rdfs:comment 'Indicates whether this exposure exhibits wrong-way risk, where exposure increases when counterparty creditworthiness deteriorates.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concentrationExposureId rdf:type rdf:Property ;
    rdfs:label 'Concentration Exposure Id' ;
    rdfs:comment 'Unique identifier for the concentration exposure measurement record.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concentrationDimension rdf:type rdf:Property ;
    rdfs:label 'Concentration Dimension' ;
    rdfs:comment 'The dimension along which concentration risk is being measured: single issuer, sector/industry, geography, asset class, currency, or counterparty.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dimensionValue rdf:type rdf:Property ;
    rdfs:label 'Dimension Value' ;
    rdfs:comment 'The specific value within the concentration dimension being measured, such as issuer name, sector code, country code, asset class name, currency code, or counterparty identifier.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Required Flag' ;
    rdfs:comment 'Boolean indicator of whether the concentration exposure breach requires escalation to senior management or Investment Committee (IC) per governance policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exposureAmount rdf:type rdf:Property ;
    rdfs:label 'Exposure Amount' ;
    rdfs:comment 'The total monetary exposure to the specified concentration dimension value, expressed in the portfolio base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitThreshold rdf:type rdf:Property ;
    rdfs:label 'Limit Threshold' ;
    rdfs:comment 'The maximum allowable concentration exposure percentage as defined by the risk limit framework for this dimension and value.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lookThroughFlag rdf:type rdf:Property ;
    rdfs:label 'Look Through Flag' ;
    rdfs:comment 'Boolean indicator of whether the concentration calculation includes look-through analysis of underlying holdings in fund-of-funds or commingled vehicles.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:navBase rdf:type rdf:Property ;
    rdfs:label 'Nav Base' ;
    rdfs:comment 'The total portfolio Net Asset Value (NAV) or Assets Under Management (AUM) used as the denominator for calculating exposure percentage.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nettingAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Netting Applied Flag' ;
    rdfs:comment 'Boolean indicator of whether long and short positions were netted in the concentration exposure calculation, or if gross exposure was used.' ;
    rdfs:domain ind:ConcentrationExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dv01SensitivityId rdf:type rdf:Property ;
    rdfs:label 'Dv01 Sensitivity Id' ;
    rdfs:comment 'Unique identifier for the DV01 sensitivity record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Dv01Sensitivity .

ind:securityInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Security Instrument Id' ;
    rdfs:comment 'Reference to the underlying security or instrument for which interest rate sensitivity is calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Instrument .

ind:aggregationLevel rdf:type rdf:Property ;
    rdfs:label 'Aggregation Level' ;
    rdfs:comment 'The level at which DV01 sensitivity is aggregated: individual position, portfolio, strategy, or total fund.' ;
    rdfs:domain ind:Dv01Sensitivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeAdjustedFlag rdf:type rdf:Property ;
    rdfs:label 'Hedge Adjusted Flag' ;
    rdfs:comment 'Indicates whether the DV01 calculation reflects hedging positions or is gross of hedges.' ;
    rdfs:domain ind:Dv01Sensitivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shockSizeBps rdf:type rdf:Property ;
    rdfs:label 'Shock Size Bps' ;
    rdfs:comment 'The size of the interest rate shock applied in the calculation, typically 1 basis point for DV01.' ;
    rdfs:domain ind:Dv01Sensitivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yieldCurveDate rdf:type rdf:Property ;
    rdfs:label 'Yield Curve Date' ;
    rdfs:comment 'The effective date of the yield curve used in the sensitivity calculation.' ;
    rdfs:domain ind:Dv01Sensitivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liquidityRiskAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Liquidity Risk Assessment Id' ;
    rdfs:comment 'Unique identifier for the liquidity risk assessment record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidityRiskAssessment .

ind:assessedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assessed By Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Liquidity assessments require documented assessor for audit trails. Pension funds must track which analyst performed each liquidity risk assessment.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:liabilityCashFlowId rdf:type rdf:Property ;
    rdfs:label 'Liability Cash Flow Id' ;
    rdfs:comment 'Foreign key linking to actuarial.liability_cash_flow. Business justification: Pension liquidity assessments must evaluate asset liquidity against projected benefit payments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiabilityCashFlow .

ind:significantCashFlowId rdf:type rdf:Property ;
    rdfs:label 'Significant Cash Flow Id' ;
    rdfs:comment 'Foreign key linking to performance.significant_cash_flow. Business justification: Pension funds must assess liquidity risk considering significant cash flows (beneficiary payments, large redemptions).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SignificantCashFlow .

ind:assessmentCode rdf:type rdf:Property ;
    rdfs:label 'Assessment Code' ;
    rdfs:comment 'Externally-known unique business identifier for this liquidity risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concentrationRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Concentration Risk Flag' ;
    rdfs:comment 'Indicates whether concentration risk was identified that could impair liquidity.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:daysToLiquidate rdf:type rdf:Property ;
    rdfs:label 'Days To Liquidate' ;
    rdfs:comment 'Estimated number of days required to liquidate the portfolio without exceeding market impact thresholds.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingLiquidityRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Funding Liquidity Risk Flag' ;
    rdfs:comment 'Indicates whether funding liquidity risk was identified in meeting capital calls or obligations.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:illiquidAssetsValue rdf:type rdf:Property ;
    rdfs:label 'Illiquid Assets Value' ;
    rdfs:comment 'Total value of assets classified as illiquid within the specified time horizon.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidAssetsValue rdf:type rdf:Property ;
    rdfs:label 'Liquid Assets Value' ;
    rdfs:comment 'Total value of assets classified as liquid within the specified time horizon.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidationScenario rdf:type rdf:Property ;
    rdfs:label 'Liquidation Scenario' ;
    rdfs:comment 'Market condition scenario under which the liquidity assessment is performed.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityCoverageRatio rdf:type rdf:Property ;
    rdfs:label 'Liquidity Coverage Ratio' ;
    rdfs:comment 'Ratio of high-quality liquid assets to net cash outflows over the stress period.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityRatio rdf:type rdf:Property ;
    rdfs:label 'Liquidity Ratio' ;
    rdfs:comment 'Ratio of liquid assets to total portfolio NAV, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketImpactCostBps rdf:type rdf:Property ;
    rdfs:label 'Market Impact Cost Bps' ;
    rdfs:comment 'Estimated market impact cost of liquidating positions, expressed in basis points.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Measurement Timestamp' ;
    rdfs:comment 'Precise timestamp when the liquidity risk measurement was captured.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:navCurrency rdf:type rdf:Property ;
    rdfs:label 'Nav Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the portfolio NAV.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPortfolioNav rdf:type rdf:Property ;
    rdfs:label 'Total Portfolio Nav' ;
    rdfs:comment 'Total Net Asset Value of the portfolio at the time of assessment.' ;
    rdfs:domain ind:LiquidityRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxRiskExposureId rdf:type rdf:Property ;
    rdfs:label 'Fx Risk Exposure Id' ;
    rdfs:comment 'Unique identifier for the foreign exchange risk exposure record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxRiskExposure .

ind:fxPositionId rdf:type rdf:Property ;
    rdfs:label 'Fx Position Id' ;
    rdfs:comment 'Foreign key linking to treasury.fx_position. Business justification: FX risk exposure measurements must reference the underlying treasury FX position being assessed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxPosition .

ind:hedgeFxTradeId rdf:type rdf:Property ;
    rdfs:label 'Hedge Fx Trade Id' ;
    rdfs:comment 'Foreign key linking to trade.fx_trade. Business justification: Currency hedging programs require linking FX exposures to hedge trades. Pension funds with global mandates track hedge effectiveness per IAS 39/IFRS 9 and need exposure-to-hedge trade linkage' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxTrade .

ind:cvar1day99pct rdf:type rdf:Property ;
    rdfs:label 'Cvar 1day 99pct' ;
    rdfs:comment 'One-day Conditional Value at Risk (expected shortfall) at 99% confidence level for the foreign exchange exposure.' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureBaseCurrencyEquivalent rdf:type rdf:Property ;
    rdfs:label 'Exposure Base Currency Equivalent' ;
    rdfs:comment 'Net foreign exchange exposure translated into the base currency using the spot exchange rate at measurement date.' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectiveness rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness' ;
    rdfs:comment 'Measure of how effectively the hedging instruments offset the foreign exchange exposure, expressed as a ratio (0.0000 to 1.0000).' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeNotionalAmount rdf:type rdf:Property ;
    rdfs:label 'Hedge Notional Amount' ;
    rdfs:comment 'Notional amount of foreign exchange hedging instruments (forwards, swaps, options) applied to offset the exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatio rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio' ;
    rdfs:comment 'Proportion of gross exposure that is hedged, calculated as hedge notional divided by gross exposure (0.0000 to 1.0000).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressedExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Stressed Exposure Amount' ;
    rdfs:comment 'Foreign exchange exposure amount under the applied stress scenario, expressed in base currency.' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:var1day99pct rdf:type rdf:Property ;
    rdfs:label 'Var 1day 99pct' ;
    rdfs:comment 'One-day Value at Risk at 99% confidence level for the foreign exchange exposure, representing potential loss in base currency.' ;
    rdfs:domain ind:FxRiskExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volatility rdf:type rdf:Property ;
    rdfs:label 'Volatility' ;
    rdfs:comment 'Historical or implied volatility of the currency pair, expressed as an annualized standard deviation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionId rdf:type rdf:Property ;
    rdfs:label 'Attribution Id' ;
    rdfs:comment 'Unique identifier for the risk attribution record.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeRisk rdf:type rdf:Property ;
    rdfs:label 'Active Risk' ;
    rdfs:comment 'Active risk or tracking error relative to benchmark, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationRisk rdf:type rdf:Property ;
    rdfs:label 'Allocation Risk' ;
    rdfs:comment 'Portion of active risk attributable to asset allocation decisions across asset classes or sectors, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetClassRisk rdf:type rdf:Property ;
    rdfs:label 'Asset Class Risk' ;
    rdfs:comment 'Portion of total risk attributable to asset class allocation decisions, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:attributionType rdf:type rdf:Property ;
    rdfs:label 'Attribution Type' ;
    rdfs:comment 'Type of risk attribution analysis performed.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:betaToBenchmark rdf:type rdf:Property ;
    rdfs:label 'Beta To Benchmark' ;
    rdfs:comment 'Beta coefficient measuring systematic risk of this component relative to the benchmark.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:componentVar rdf:type rdf:Property ;
    rdfs:label 'Component Var' ;
    rdfs:comment 'Component VaR representing the standalone risk contribution of this attribution component, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyRisk rdf:type rdf:Property ;
    rdfs:label 'Currency Risk' ;
    rdfs:comment 'Portion of total risk attributable to foreign exchange exposures, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decompositionLevel rdf:type rdf:Property ;
    rdfs:label 'Decomposition Level' ;
    rdfs:comment 'Granularity level at which risk attribution is decomposed.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorRisk rdf:type rdf:Property ;
    rdfs:label 'Factor Risk' ;
    rdfs:comment 'Portion of total risk attributable to systematic factor exposures, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRisk rdf:type rdf:Property ;
    rdfs:label 'Geographic Risk' ;
    rdfs:comment 'Portion of total risk attributable to geographic or regional exposures, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interactionRisk rdf:type rdf:Property ;
    rdfs:label 'Interaction Risk' ;
    rdfs:comment 'Portion of active risk attributable to the interaction between allocation and selection decisions, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginalVar rdf:type rdf:Property ;
    rdfs:label 'Marginal Var' ;
    rdfs:comment 'Marginal contribution to portfolio VaR from a small change in this risk component, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskCurrency rdf:type rdf:Property ;
    rdfs:label 'Risk Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which risk metrics are expressed.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorRisk rdf:type rdf:Property ;
    rdfs:label 'Sector Risk' ;
    rdfs:comment 'Portion of total risk attributable to sector allocation and selection, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:selectionRisk rdf:type rdf:Property ;
    rdfs:label 'Selection Risk' ;
    rdfs:comment 'Portion of active risk attributable to security selection decisions within asset classes or sectors, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:specificRisk rdf:type rdf:Property ;
    rdfs:label 'Specific Risk' ;
    rdfs:comment 'Portion of total risk attributable to idiosyncratic or security-specific sources, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:styleRisk rdf:type rdf:Property ;
    rdfs:label 'Style Risk' ;
    rdfs:comment 'Portion of total risk attributable to investment style factors such as value, growth, momentum, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRisk rdf:type rdf:Property ;
    rdfs:label 'Total Risk' ;
    rdfs:comment 'Total portfolio risk measured as standard deviation of returns, expressed in percentage terms.' ;
    rdfs:domain ind:Attribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivityAnalysisId rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Id' ;
    rdfs:comment 'Unique identifier for the sensitivity analysis run record.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analysisCode rdf:type rdf:Property ;
    rdfs:label 'Analysis Code' ;
    rdfs:comment 'Business identifier code for the sensitivity analysis run, used for reporting and tracking.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisName rdf:type rdf:Property ;
    rdfs:label 'Analysis Name' ;
    rdfs:comment 'Descriptive name of the sensitivity analysis run for business user identification.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisStatus rdf:type rdf:Property ;
    rdfs:label 'Analysis Status' ;
    rdfs:comment 'Current lifecycle status of the sensitivity analysis run.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analysisType rdf:type rdf:Property ;
    rdfs:label 'Analysis Type' ;
    rdfs:comment 'Classification of the sensitivity analysis methodology applied.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:convexityImpact rdf:type rdf:Property ;
    rdfs:label 'Convexity Impact' ;
    rdfs:comment 'Impact on portfolio convexity resulting from the sensitivity shock.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cvarImpact rdf:type rdf:Property ;
    rdfs:label 'Cvar Impact' ;
    rdfs:comment 'Change in portfolio Conditional Value at Risk resulting from the sensitivity shock.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationImpact rdf:type rdf:Property ;
    rdfs:label 'Duration Impact' ;
    rdfs:comment 'Impact on portfolio duration resulting from the sensitivity shock, measured in years.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Timestamp' ;
    rdfs:comment 'Date and time when the sensitivity analysis was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:riskFactorCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Factor Category' ;
    rdfs:comment 'High-level classification of the risk factor being analyzed. [ENUM-REF-CANDIDATE: equity|interest_rate|credit_spread|fx|commodity|volatility|inflation|macro — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shockType rdf:type rdf:Property ;
    rdfs:label 'Shock Type' ;
    rdfs:comment 'Type of shock applied to the risk factor: absolute change, relative change, basis points, or percentage.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shockedValue rdf:type rdf:Property ;
    rdfs:label 'Shocked Value' ;
    rdfs:comment 'Portfolio or position value after the sensitivity shock is applied.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueChange rdf:type rdf:Property ;
    rdfs:label 'Value Change' ;
    rdfs:comment 'Absolute change in portfolio or position value resulting from the sensitivity shock.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Value Change Percentage' ;
    rdfs:comment 'Percentage change in portfolio or position value resulting from the sensitivity shock.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varImpact rdf:type rdf:Property ;
    rdfs:label 'Var Impact' ;
    rdfs:comment 'Change in portfolio Value at Risk resulting from the sensitivity shock.' ;
    rdfs:domain ind:SensitivityAnalysis ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskReviewId rdf:type rdf:Property ;
    rdfs:label 'Risk Review Id' ;
    rdfs:comment 'Unique identifier for the risk review record.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionItems rdf:type rdf:Property ;
    rdfs:label 'Action Items' ;
    rdfs:comment 'Specific action items assigned to responsible parties with target completion dates.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskReviewCode rdf:type rdf:Property ;
    rdfs:label 'Risk Review Code' ;
    rdfs:comment 'Business identifier for the risk review following format RR-YYYY-NNNNNN where YYYY is year and NNNNNN is sequence number.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalBreachCount rdf:type rdf:Property ;
    rdfs:label 'Critical Breach Count' ;
    rdfs:comment 'Number of critical-severity risk limit breaches identified during the review period.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cvar95Amount rdf:type rdf:Property ;
    rdfs:label 'Cvar 95 Amount' ;
    rdfs:comment 'Conditional Value at Risk (expected shortfall) at 95 percent confidence level as of the review date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataQualityIssues rdf:type rdf:Property ;
    rdfs:label 'Data Quality Issues' ;
    rdfs:comment 'Description of any data quality issues or gaps encountered during the review that may affect conclusions.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emergingRiskCount rdf:type rdf:Property ;
    rdfs:label 'Emerging Risk Count' ;
    rdfs:comment 'Number of new or emerging risks identified during this review that require monitoring or action.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:limitBreachCount rdf:type rdf:Property ;
    rdfs:label 'Limit Breach Count' ;
    rdfs:comment 'Number of risk limit breaches identified during the review period.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:previousRiskRating rdf:type rdf:Property ;
    rdfs:label 'Previous Risk Rating' ;
    rdfs:comment 'Risk rating from the prior review period for comparison and trend analysis.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendations rdf:type rdf:Property ;
    rdfs:label 'Recommendations' ;
    rdfs:comment 'Recommended actions and risk mitigation measures proposed by the review team.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskRatingChange rdf:type rdf:Property ;
    rdfs:label 'Risk Rating Change' ;
    rdfs:comment 'Direction of change in risk rating compared to the previous review period.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskReviewDate rdf:type rdf:Property ;
    rdfs:label 'Risk Review Date' ;
    rdfs:comment 'Date on which the formal risk review was conducted or completed.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Risk Review Status' ;
    rdfs:comment 'Current lifecycle status of the risk review process.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskReviewType rdf:type rdf:Property ;
    rdfs:label 'Risk Review Type' ;
    rdfs:comment 'Category of risk review conducted: portfolio-level, counterparty-specific, concentration analysis, market risk, liquidity risk, or operational risk.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressTestResult rdf:type rdf:Property ;
    rdfs:label 'Stress Test Result' ;
    rdfs:comment 'Summary outcome of the stress test scenario including projected losses or impacts.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressTestScenarioApplied rdf:type rdf:Property ;
    rdfs:label 'Stress Test Scenario Applied' ;
    rdfs:comment 'Name or identifier of the macroeconomic stress test scenario applied during this review.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamMembers rdf:type rdf:Property ;
    rdfs:label 'Team Members' ;
    rdfs:comment 'Comma-separated list of team members who participated in conducting the risk review.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:var95Amount rdf:type rdf:Property ;
    rdfs:label 'Var 95 Amount' ;
    rdfs:comment 'Value at Risk calculated at 95 percent confidence level as of the review date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:var99Amount rdf:type rdf:Property ;
    rdfs:label 'Var 99 Amount' ;
    rdfs:comment 'Value at Risk calculated at 99 percent confidence level as of the review date.' ;
    rdfs:domain ind:RiskReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Limit Assignment Id' ;
    rdfs:comment 'Unique identifier for the limit assignment record linking risk limits to portfolios, mandates, asset classes, or investment strategies.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned By Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Limit assignments need documented assigner for governance. Pension funds track who assigned limits to portfolios/strategies for accountability and audit.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assignedLimitValue rdf:type rdf:Property ;
    rdfs:label 'Assigned Limit Value' ;
    rdfs:comment 'The specific limit threshold value assigned to this entity, which may differ from the base limit definition to accommodate entity-specific risk tolerance.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentCode rdf:type rdf:Property ;
    rdfs:label 'Assignment Code' ;
    rdfs:comment 'Business identifier code for the limit assignment used for operational reference and reporting.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Date' ;
    rdfs:comment 'Date on which this limit assignment was created and recorded in the system.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentPriority rdf:type rdf:Property ;
    rdfs:label 'Assignment Priority' ;
    rdfs:comment 'Priority ranking of this assignment when multiple overlapping limits apply to the same entity, with lower numbers indicating higher priority.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentRationale rdf:type rdf:Property ;
    rdfs:label 'Assignment Rationale' ;
    rdfs:comment 'Business justification and reasoning for assigning this specific limit to this entity, including risk considerations and strategic context.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:autoRemediationFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Remediation Flag' ;
    rdfs:comment 'Indicates whether automated remediation actions are enabled for breaches of this limit assignment.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:limitCurrency rdf:type rdf:Property ;
    rdfs:label 'Limit Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the assigned limit value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitUnit rdf:type rdf:Property ;
    rdfs:label 'Limit Unit' ;
    rdfs:comment 'Unit of measure for the assigned limit such as currency amount, percentage, basis points, or Value at Risk (VaR) units.' ;
    rdfs:domain ind:LimitAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorReturnId rdf:type rdf:Property ;
    rdfs:label 'Factor Return Id' ;
    rdfs:comment 'Unique identifier for the factor return record.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isMaterialFactor rdf:type rdf:Property ;
    rdfs:label 'Is Material Factor' ;
    rdfs:comment 'Indicates whether this factor is considered material to portfolio risk based on contribution thresholds.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:observationCount rdf:type rdf:Property ;
    rdfs:label 'Observation Count' ;
    rdfs:comment 'The number of data points or observations used in calculating this factor return.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:returnPercentage rdf:type rdf:Property ;
    rdfs:label 'Return Percentage' ;
    rdfs:comment 'The realized return of the risk factor expressed as a percentage for reporting purposes.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnPeriodType rdf:type rdf:Property ;
    rdfs:label 'Return Period Type' ;
    rdfs:comment 'The time period granularity for this factor return observation.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnValue rdf:type rdf:Property ;
    rdfs:label 'Return Value' ;
    rdfs:comment 'The realized return of the risk factor for the specified period, expressed as a decimal (e.g., 0.0125 for 1.25%).' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageInAttribution rdf:type rdf:Property ;
    rdfs:label 'Usage In Attribution' ;
    rdfs:comment 'Indicates whether this factor return is used in performance attribution analysis.' ;
    rdfs:domain ind:FactorReturn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eclCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Ecl Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the expected credit loss amount.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalRatingOverride rdf:type rdf:Property ;
    rdfs:label 'Internal Rating Override' ;
    rdfs:comment 'Internal credit assessment that overrides or supplements the external rating, if applicable.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalRatingRationale rdf:type rdf:Property ;
    rdfs:label 'Internal Rating Rationale' ;
    rdfs:comment 'Rationale for internal rating override or adjustment, documenting the basis for deviation from external rating.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isSolicitedRating rdf:type rdf:Property ;
    rdfs:label 'Is Solicited Rating' ;
    rdfs:comment 'Indicates whether the rating was solicited by the issuer (true) or unsolicited (false).' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossGivenDefaultPct rdf:type rdf:Property ;
    rdfs:label 'Loss Given Default Pct' ;
    rdfs:comment 'Estimated loss given default associated with the credit rating, expressed as a percentage of exposure at default.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfDefaultPct rdf:type rdf:Property ;
    rdfs:label 'Probability Of Default Pct' ;
    rdfs:comment 'Estimated probability of default associated with the credit rating, expressed as a percentage.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ratingActionDate rdf:type rdf:Property ;
    rdfs:label 'Rating Action Date' ;
    rdfs:comment 'Date when the rating agency took action (affirmed, upgraded, downgraded, or withdrew the rating).' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingActionType rdf:type rdf:Property ;
    rdfs:label 'Rating Action Type' ;
    rdfs:comment 'Type of rating action taken: new assignment, affirmation, upgrade, downgrade, withdrawal, or suspension.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingChangeNotches rdf:type rdf:Property ;
    rdfs:label 'Rating Change Notches' ;
    rdfs:comment 'Number of notches the rating changed in the most recent action (positive for upgrades, negative for downgrades).' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingNotch rdf:type rdf:Property ;
    rdfs:label 'Rating Notch' ;
    rdfs:comment 'Numeric notch representation of the rating for quantitative analysis, where higher values indicate better credit quality.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingSourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Rating Source Identifier' ;
    rdfs:comment 'Unique identifier of the rating record in the source system.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Rating Source System' ;
    rdfs:comment 'Source system from which the credit rating data was obtained (e.g., Bloomberg, Aladdin, vendor feed).' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingValue rdf:type rdf:Property ;
    rdfs:label 'Rating Value' ;
    rdfs:comment 'The actual credit rating value assigned by the rating agency (e.g., AAA, Aa1, BBB+, B-, CCC).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskWeightPct rdf:type rdf:Property ;
    rdfs:label 'Risk Weight Pct' ;
    rdfs:comment 'Regulatory risk weight percentage assigned based on the credit rating for capital adequacy calculations.' ;
    rdfs:domain ind:CreditRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskExceptionId rdf:type rdf:Property ;
    rdfs:label 'Risk Exception Id' ;
    rdfs:comment 'Unique identifier for the risk exception record.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:requestedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Requested By Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Exception requests must track the requestor for governance. Pension funds require documented accountability for who initiated each risk exception request.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:businessRationale rdf:type rdf:Property ;
    rdfs:label 'Business Rationale' ;
    rdfs:comment 'Detailed business justification for requesting the exception, including strategic context and expected benefits.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationDays rdf:type rdf:Property ;
    rdfs:label 'Duration Days' ;
    rdfs:comment 'Number of calendar days for which the exception is valid.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exceptionCode rdf:type rdf:Property ;
    rdfs:label 'Exception Code' ;
    rdfs:comment 'Business identifier code for the exception, typically formatted as three-letter prefix followed by six-digit sequence.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionName rdf:type rdf:Property ;
    rdfs:label 'Exception Name' ;
    rdfs:comment 'Short descriptive name of the risk exception for identification and reporting purposes.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationMeasures rdf:type rdf:Property ;
    rdfs:label 'Mitigation Measures' ;
    rdfs:comment 'Specific risk mitigation actions or controls that will be implemented while the exception is active.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalLimitValue rdf:type rdf:Property ;
    rdfs:label 'Original Limit Value' ;
    rdfs:comment 'The standard limit value that is being temporarily waived or exceeded.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestDate rdf:type rdf:Property ;
    rdfs:label 'Request Date' ;
    rdfs:comment 'Date when the exception was formally requested.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revocationDate rdf:type rdf:Property ;
    rdfs:label 'Revocation Date' ;
    rdfs:comment 'Date when the exception was revoked prior to its scheduled expiry.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revokedBy rdf:type rdf:Property ;
    rdfs:label 'Revoked By' ;
    rdfs:comment 'Name or identifier of the individual or authority who revoked the exception.' ;
    rdfs:domain ind:RiskException ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlationMatrixId rdf:type rdf:Property ;
    rdfs:label 'Correlation Matrix Id' ;
    rdfs:comment 'Unique identifier for the correlation matrix record.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByMatrixCorrelationMatrixId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Matrix Correlation Matrix Id' ;
    rdfs:comment 'Reference to the newer correlation matrix that replaces this one when status changes to superseded.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorrelationMatrix .

ind:adjustmentAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Adjustment Applied Flag' ;
    rdfs:comment 'Indicates whether numerical adjustments were applied to ensure positive definiteness or stability.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adjustmentMethod rdf:type rdf:Property ;
    rdfs:label 'Adjustment Method' ;
    rdfs:comment 'Method used to adjust the matrix such as eigenvalue flooring, nearest correlation matrix, or Higham algorithm.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageCorrelation rdf:type rdf:Property ;
    rdfs:label 'Average Correlation' ;
    rdfs:comment 'Mean of all pairwise correlation coefficients in the matrix, used for summary risk assessment.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:decayFactor rdf:type rdf:Property ;
    rdfs:label 'Decay Factor' ;
    rdfs:comment 'Exponential decay factor applied in weighted correlation estimation to give more weight to recent observations.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dimensionCount rdf:type rdf:Property ;
    rdfs:label 'Dimension Count' ;
    rdfs:comment 'Number of assets, factors, or entities included in the correlation matrix.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:estimationMethodology rdf:type rdf:Property ;
    rdfs:label 'Estimation Methodology' ;
    rdfs:comment 'Statistical method used to estimate correlations such as rolling window, exponentially weighted moving average, or shrinkage estimator.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixCode rdf:type rdf:Property ;
    rdfs:label 'Matrix Code' ;
    rdfs:comment 'Business identifier code for the correlation matrix used in risk calculations and reporting.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixDeterminant rdf:type rdf:Property ;
    rdfs:label 'Matrix Determinant' ;
    rdfs:comment 'Determinant of the correlation matrix used to assess matrix invertibility and numerical stability.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matrixName rdf:type rdf:Property ;
    rdfs:label 'Matrix Name' ;
    rdfs:comment 'Descriptive name of the correlation matrix for business user identification.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixStatus rdf:type rdf:Property ;
    rdfs:label 'Matrix Status' ;
    rdfs:comment 'Current lifecycle status of the correlation matrix in the risk management system.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matrixType rdf:type rdf:Property ;
    rdfs:label 'Matrix Type' ;
    rdfs:comment 'Type of correlation matrix indicating the dimension being correlated.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumCorrelation rdf:type rdf:Property ;
    rdfs:label 'Maximum Correlation' ;
    rdfs:comment 'Highest correlation coefficient in the matrix indicating strongest positive relationship.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCorrelation rdf:type rdf:Property ;
    rdfs:label 'Minimum Correlation' ;
    rdfs:comment 'Lowest correlation coefficient in the matrix indicating strongest negative relationship.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:observationFrequency rdf:type rdf:Property ;
    rdfs:label 'Observation Frequency' ;
    rdfs:comment 'Frequency of return observations used in correlation estimation.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positiveDefiniteFlag rdf:type rdf:Property ;
    rdfs:label 'Positive Definite Flag' ;
    rdfs:comment 'Indicates whether the correlation matrix is positive definite, a mathematical requirement for valid covariance matrices.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shrinkageIntensity rdf:type rdf:Property ;
    rdfs:label 'Shrinkage Intensity' ;
    rdfs:comment 'Intensity parameter for shrinkage estimator used to stabilize correlation estimates by blending sample and target matrices.' ;
    rdfs:domain ind:CorrelationMatrix ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appetiteStatementId rdf:type rdf:Property ;
    rdfs:label 'Appetite Statement Id' ;
    rdfs:comment 'Unique identifier for the risk appetite statement record.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByStatementAppetiteStatementId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Statement Appetite Statement Id' ;
    rdfs:comment 'Identifier of the risk appetite statement that supersedes this version, establishing version lineage and audit trail.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AppetiteStatement .

ind:climateScenarioAlignment rdf:type rdf:Property ;
    rdfs:label 'Climate Scenario Alignment' ;
    rdfs:comment 'Description of alignment with climate-related financial risk scenarios, such as Task Force on Climate-related Financial Disclosures (TCFD) scenarios or net-zero transition pathways.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalReferenceCode rdf:type rdf:Property ;
    rdfs:label 'External Reference Code' ;
    rdfs:comment 'Unique identifier for this risk appetite statement in the external source system, enabling cross-system reconciliation and lineage tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityMatchingConsideration rdf:type rdf:Property ;
    rdfs:label 'Liability Matching Consideration' ;
    rdfs:comment 'Description of how this risk appetite statement considers the pension funds long-duration liability profile and Asset-Liability Management (ALM) constraints.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskCategory rdf:type rdf:Property ;
    rdfs:label 'Risk Category' ;
    rdfs:comment 'Primary risk category that this appetite statement addresses, aligned with enterprise risk taxonomy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskModelName rdf:type rdf:Property ;
    rdfs:label 'Risk Model Name' ;
    rdfs:comment 'Name of the risk model or system used to measure exposure against this appetite statement, such as Aladdin, RiskMetrics, or Barra.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskModelVersion rdf:type rdf:Property ;
    rdfs:label 'Risk Model Version' ;
    rdfs:comment 'Version identifier of the risk model used for measurement, ensuring consistency and auditability of risk calculations.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskSubcategory rdf:type rdf:Property ;
    rdfs:label 'Risk Subcategory' ;
    rdfs:comment 'Detailed subcategory within the primary risk category, such as equity risk, interest rate risk, or counterparty credit risk.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementCode rdf:type rdf:Property ;
    rdfs:label 'Statement Code' ;
    rdfs:comment 'Externally-known unique business identifier for the risk appetite statement, typically used in board materials and regulatory filings.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementName rdf:type rdf:Property ;
    rdfs:label 'Statement Name' ;
    rdfs:comment 'Human-readable name or title of the risk appetite statement, typically reflecting the fiscal year or strategic planning period.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementVersion rdf:type rdf:Property ;
    rdfs:label 'Statement Version' ;
    rdfs:comment 'Version number of the risk appetite statement, incremented with each board-approved revision.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressScenarioAlignment rdf:type rdf:Property ;
    rdfs:label 'Stress Scenario Alignment' ;
    rdfs:comment 'Description of how this risk appetite statement is calibrated or validated against enterprise stress testing scenarios and macroeconomic sensitivity analysis.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetThreshold rdf:type rdf:Property ;
    rdfs:label 'Target Threshold' ;
    rdfs:comment 'Target or preferred level of risk exposure, typically lower than the tolerance threshold, representing the desired operating range.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceCurrency rdf:type rdf:Property ;
    rdfs:label 'Tolerance Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code when tolerance threshold is expressed in monetary terms.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:toleranceMetric rdf:type rdf:Property ;
    rdfs:label 'Tolerance Metric' ;
    rdfs:comment 'The specific risk metric or measure used to quantify risk tolerance, such as Value at Risk (VaR), Conditional Value at Risk (CVaR), or tracking error.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:toleranceThreshold rdf:type rdf:Property ;
    rdfs:label 'Tolerance Threshold' ;
    rdfs:comment 'Numeric threshold value representing the maximum acceptable level of risk for the specified metric, expressed in the unit defined by tolerance unit.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceUnit rdf:type rdf:Property ;
    rdfs:label 'Tolerance Unit' ;
    rdfs:comment 'Unit of measure for the tolerance threshold value, such as currency, percentage, basis points, or ratio.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:warningThreshold rdf:type rdf:Property ;
    rdfs:label 'Warning Threshold' ;
    rdfs:comment 'Early warning threshold that triggers heightened monitoring and management attention before tolerance threshold is breached.' ;
    rdfs:domain ind:AppetiteStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelValidationId rdf:type rdf:Property ;
