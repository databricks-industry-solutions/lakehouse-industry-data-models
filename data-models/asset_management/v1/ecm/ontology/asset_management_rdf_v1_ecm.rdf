    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageTier rdf:type rdf:Property ;
    rdfs:label 'Coverage Tier' ;
    rdfs:comment 'Priority tier assigned to the coverage universe entry, reflecting depth of research effort and strategic importance to portfolio construction.' ;
