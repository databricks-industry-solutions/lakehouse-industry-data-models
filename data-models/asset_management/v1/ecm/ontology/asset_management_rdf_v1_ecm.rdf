    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lowEstimate rdf:type rdf:Property ;
    rdfs:label 'Low Estimate' ;
    rdfs:comment 'Lowest analyst estimate for the specified metric and period.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:meanEstimate rdf:type rdf:Property ;
    rdfs:label 'Mean Estimate' ;
    rdfs:comment 'Arithmetic mean of all analyst estimates for the specified metric and period.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:medianEstimate rdf:type rdf:Property ;
    rdfs:label 'Median Estimate' ;
    rdfs:comment 'Median value of all analyst estimates for the specified metric and period.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proprietaryAdjustment rdf:type rdf:Property ;
    rdfs:label 'Proprietary Adjustment' ;
    rdfs:comment 'Internal adjustment applied to the external consensus estimate based on proprietary research or modeling.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionDirection rdf:type rdf:Property ;
    rdfs:label 'Revision Direction' ;
    rdfs:comment 'Direction of the most recent revision to the consensus estimate relative to the prior period.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionMagnitude rdf:type rdf:Property ;
    rdfs:label 'Revision Magnitude' ;
    rdfs:comment 'Magnitude of the most recent revision to the consensus estimate, expressed as a percentage change.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellCount rdf:type rdf:Property ;
    rdfs:label 'Sell Count' ;
    rdfs:comment 'Number of analysts with a sell or underperform recommendation.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:staleThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Stale Threshold Days' ;
    rdfs:comment 'Number of days after which the consensus estimate is considered stale and requires refresh.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastUpdateTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Update Timestamp' ;
    rdfs:comment 'Timestamp of the most recent data refresh for this yield curve.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:modelIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Model Integration Flag' ;
    rdfs:comment 'Indicates whether this yield curve is integrated into proprietary macroeconomic or valuation models.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryDataSource rdf:type rdf:Property ;
    rdfs:label 'Primary Data Source' ;
    rdfs:comment 'Primary vendor or system from which the yield curve data is sourced.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskFreeRateProxyFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Free Rate Proxy Flag' ;
    rdfs:comment 'Indicates whether this curve is used as a proxy for the risk-free rate in WACC and DCF calculations.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tenorRangeMaxYears rdf:type rdf:Property ;
    rdfs:label 'Tenor Range Max Years' ;
    rdfs:comment 'Longest maturity tenor available on the yield curve, expressed in years.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenorRangeMinYears rdf:type rdf:Property ;
    rdfs:label 'Tenor Range Min Years' ;
    rdfs:comment 'Shortest maturity tenor available on the yield curve, expressed in years.' ;
    rdfs:domain ind:ResearchYieldCurve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldCurvePointId rdf:type rdf:Property ;
    rdfs:label 'Yield Curve Point Id' ;
    rdfs:comment 'Unique identifier for the yield curve point observation record.' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByYieldCurvePointId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Yield Curve Point Id' ;
    rdfs:comment 'Reference to the yield curve point record that supersedes this one, if this record has been corrected or revised.' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:YieldCurvePoint .

ind:discountFactor rdf:type rdf:Property ;
    rdfs:label 'Discount Factor' ;
    rdfs:comment 'The discount factor at this tenor, used for present value calculations in fixed income analytics.' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isInterpolated rdf:type rdf:Property ;
    rdfs:label 'Is Interpolated' ;
    rdfs:comment 'Indicates whether this yield curve point was interpolated (True) or directly observed (False).' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketSegment rdf:type rdf:Property ;
    rdfs:label 'Market Segment' ;
    rdfs:comment 'The market segment this yield curve represents: government, corporate, municipal, sovereign, or swap market.' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yieldBps rdf:type rdf:Property ;
    rdfs:label 'Yield Bps' ;
    rdfs:comment 'The observed yield expressed in basis points for fixed income analytics (e.g., 325 bps for 3.25%).' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldRate rdf:type rdf:Property ;
    rdfs:label 'Yield Rate' ;
    rdfs:comment 'The observed yield or interest rate at this tenor, expressed as a decimal (e.g., 0.0325 for 3.25%).' ;
    rdfs:domain ind:YieldCurvePoint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:askRate rdf:type rdf:Property ;
    rdfs:label 'Ask Rate' ;
    rdfs:comment 'The rate at which the market is willing to sell the base currency, expressed in quote currency units.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkRateFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Rate Flag' ;
    rdfs:comment 'Indicates whether this FX rate is designated as the official benchmark rate used for portfolio valuation and Net Asset Value (NAV) calculation.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bidRate rdf:type rdf:Property ;
    rdfs:label 'Bid Rate' ;
    rdfs:comment 'The rate at which the market is willing to buy the base currency, expressed in quote currency units.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:centralBankRateFlag rdf:type rdf:Property ;
    rdfs:label 'Central Bank Rate Flag' ;
    rdfs:comment 'Indicates whether this rate is sourced directly from a central bank official fixing or reference rate.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:crossRateCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Cross Rate Calculation Method' ;
    rdfs:comment 'Description of the methodology used to derive cross rates when direct market quotes are unavailable, ensuring transparency in valuation.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataLineageReference rdf:type rdf:Property ;
    rdfs:label 'Data Lineage Reference' ;
    rdfs:comment 'Identifier or reference linking this FX rate observation to its upstream source system batch or feed ingestion event for audit trail purposes.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardTenor rdf:type rdf:Property ;
    rdfs:label 'Forward Tenor' ;
    rdfs:comment 'The time period until the forward contract settlement date, expressed in standard market convention (e.g., 1M, 3M, 6M, 1Y).' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hedging Eligible Flag' ;
    rdfs:comment 'Indicates whether this currency pair is approved for use in the funds foreign exchange hedging program.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:midRate rdf:type rdf:Property ;
    rdfs:label 'Mid Rate' ;
    rdfs:comment 'The midpoint between the bid and ask rates, commonly used for valuation and performance measurement purposes.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quoteConvention rdf:type rdf:Property ;
    rdfs:label 'Quote Convention' ;
    rdfs:comment 'The market convention used for quoting the currency pair, indicating whether it follows direct, indirect, or cross-rate methodology.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradingSession rdf:type rdf:Property ;
    rdfs:label 'Trading Session' ;
    rdfs:comment 'The geographic trading session or market center during which the FX rate was observed.' ;
    rdfs:domain ind:ResearchFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Asset Employee Id' ;
    rdfs:comment 'Reference to the senior research analyst responsible for authoring and owning the outlook assessment.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assetPeerReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Asset Peer Reviewer Employee Id' ;
    rdfs:comment 'Reference to the senior analyst or research director who conducted the peer review of the outlook assessment.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByOutlookAssetClassOutlookId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Outlook Asset Class Outlook Id' ;
    rdfs:comment 'Reference to the subsequent outlook assessment that supersedes this version, enabling version lineage tracking.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetClassOutlook .

ind:allocationDeltaPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Delta Percentage' ;
    rdfs:comment 'Recommended change in allocation percentage, calculated as target allocation minus current allocation.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentAllocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Current Allocation Percentage' ;
    rdfs:comment 'Current portfolio allocation percentage to the asset class at the time of outlook publication.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedReturnPercentage rdf:type rdf:Property ;
    rdfs:label 'Expected Return Percentage' ;
    rdfs:comment 'Projected annualized return for the asset class over the outlook horizon, expressed as a percentage.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedVolatilityPercentage rdf:type rdf:Property ;
    rdfs:label 'Expected Volatility Percentage' ;
    rdfs:comment 'Projected annualized volatility (standard deviation of returns) for the asset class, expressed as a percentage.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentOpportunities rdf:type rdf:Property ;
    rdfs:label 'Investment Opportunities' ;
    rdfs:comment 'Specific investment themes, strategies, or opportunities identified within the asset class for portfolio construction.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outlookIdentifier rdf:type rdf:Property ;
    rdfs:label 'Outlook Identifier' ;
    rdfs:comment 'Business-readable identifier for the outlook assessment, typically combining asset class and publication period.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationMetric rdf:type rdf:Property ;
    rdfs:label 'Valuation Metric' ;
    rdfs:comment 'Primary valuation metric used for assessment, such as Price-to-Earnings (P/E), Yield to Maturity (YTM), or Net Operating Income (NOI) yield.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationMetricValue rdf:type rdf:Property ;
    rdfs:label 'Valuation Metric Value' ;
    rdfs:comment 'Current value of the primary valuation metric at the time of outlook publication.' ;
    rdfs:domain ind:AssetClassOutlook ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByAssumptionId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Assumption Id' ;
    rdfs:comment 'Reference to the capital market assumption ID that supersedes this assumption, enabling version control and historical tracking of assumption evolution.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalMarketAssumption .

ind:assumptionCode rdf:type rdf:Property ;
    rdfs:label 'Assumption Code' ;
    rdfs:comment 'Short code or identifier for the capital market assumption set, used for reference in investment committee (IC) materials and system integration.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assumptionOwner rdf:type rdf:Property ;
    rdfs:label 'Assumption Owner' ;
    rdfs:comment 'Name or identifier of the research team member or analyst responsible for maintaining and updating this capital market assumption.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlationCoefficient rdf:type rdf:Property ;
    rdfs:label 'Correlation Coefficient' ;
    rdfs:comment 'The expected correlation coefficient between this asset class and a reference benchmark or other asset classes, ranging from -1 to +1, used in portfolio diversification analysis.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inflationAssumptionPercentage rdf:type rdf:Property ;
    rdfs:label 'Inflation Assumption Percentage' ;
    rdfs:comment 'The long-term expected inflation rate assumption, expressed as a percentage, used to calculate real returns and for liability-driven investment (LDI) modeling.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realReturnPercentage rdf:type rdf:Property ;
    rdfs:label 'Real Return Percentage' ;
    rdfs:comment 'The expected return adjusted for inflation, expressed as a percentage, representing the purchasing power growth of the investment over the time horizon.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskFreeRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Risk Free Rate Percentage' ;
    rdfs:comment 'The assumed risk-free rate of return, typically based on government bond yields such as Treasury bills (T-Bills) or Secured Overnight Financing Rate (SOFR), expressed as a percentage.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskPremiumBps rdf:type rdf:Property ;
    rdfs:label 'Risk Premium Bps' ;
    rdfs:comment 'The expected risk premium over the risk-free rate, expressed in basis points (bps), representing the additional return required for bearing investment risk.' ;
    rdfs:domain ind:CapitalMarketAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calendarId rdf:type rdf:Property ;
    rdfs:label 'Calendar Id' ;
    rdfs:comment 'Unique identifier for the research calendar entry.' ;
    rdfs:domain ind:Calendar ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:parentEventCalendarId rdf:type rdf:Property ;
