ind:estimateType rdf:type rdf:Property ;
    rdfs:label 'Estimate Type' ;
    rdfs:comment 'Type of consensus estimate being captured (e.g., earnings per share, revenue, EBITDA, target price, macroeconomic indicator). [ENUM-REF-CANDIDATE: eps|revenue|ebitda|target_price|gdp|inflation|interest_rate|unemployment|credit_spread|fx_rate — 10' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastPeriod rdf:type rdf:Property ;
    rdfs:label 'Forecast Period' ;
    rdfs:comment 'Time period to which the consensus estimate applies (e.g., Q1 2024, FY 2025, 12M forward).' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highEstimate rdf:type rdf:Property ;
    rdfs:label 'High Estimate' ;
    rdfs:comment 'Highest analyst estimate for the specified metric and period.' ;
