    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Compliance Document Reference' ;
    rdfs:comment 'Identifier of the regulatory compliance document linked to this membership.' ;
    rdfs:domain ind:CcpMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialMarginRequirement rdf:type rdf:Property ;
    rdfs:label 'Initial Margin Requirement' ;
    rdfs:comment 'Initial margin amount required by the CCP for this membership.' ;
    rdfs:domain ind:CcpMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastFeeAssessedDate rdf:type rdf:Property ;
    rdfs:label 'Last Fee Assessed Date' ;
    rdfs:comment 'Date when the most recent membership fee was assessed.' ;
    rdfs:domain ind:CcpMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:variationMarginRequirement rdf:type rdf:Property ;
    rdfs:label 'Variation Margin Requirement' ;
    rdfs:comment 'Daily variation margin amount that must be posted to the CCP.' ;
    rdfs:domain ind:CcpMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:simmCalculationId rdf:type rdf:Property ;
    rdfs:label 'Simm Calculation Id' ;
    rdfs:comment 'Unique system-generated identifier for the SIMM calculation record.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calculationNumber rdf:type rdf:Property ;
    rdfs:label 'Calculation Number' ;
    rdfs:comment 'External business identifier or reference number assigned to the SIMM calculation.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Calculation Source System' ;
    rdfs:comment 'System that performed the SIMM calculation (e.g., Aladdin, In-house engine).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidenceInterval rdf:type rdf:Property ;
    rdfs:label 'Confidence Interval' ;
    rdfs:comment 'Statistical confidence interval associated with the margin estimate.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inputDataHash rdf:type rdf:Property ;
    rdfs:label 'Input Data Hash' ;
    rdfs:comment 'Cryptographic hash of the raw input data set used for reproducibility.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marginAdjustment rdf:type rdf:Property ;
    rdfs:label 'Margin Adjustment' ;
    rdfs:comment 'Any manual or regulatory adjustments applied to the margin.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marginCallDate rdf:type rdf:Property ;
    rdfs:label 'Margin Call Date' ;
    rdfs:comment 'Date by which the margin call should be satisfied.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marginCallRequired rdf:type rdf:Property ;
    rdfs:label 'Margin Call Required' ;
    rdfs:comment 'True if a margin call must be issued based on the calculation result.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marginFactor rdf:type rdf:Property ;
    rdfs:label 'Margin Factor' ;
    rdfs:comment 'Multiplicative factor used in the margin calculation (e.g., scaling for stress scenarios).' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
