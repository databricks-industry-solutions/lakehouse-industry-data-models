ind:dateTypeCodelistTermId rdf:type rdf:Property ;
    rdfs:label 'Date Type Codelist Term Id' ;
    rdfs:comment 'add column date_type_codelist_term_id (BIGINT) with FK to datamanagement.codelist_term.codelist_term_id — governance_date types should reference controlled terminology' ;
    rdfs:domain ind:GovernanceDate ;
