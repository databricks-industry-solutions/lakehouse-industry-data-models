ind:industrySectorName rdf:type rdf:Property ;
    rdfs:label 'Industry Sector Name' ;
    rdfs:comment 'The human-readable name of the GICS industry sector in which the tenant operates.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfLeases rdf:type rdf:Property ;
    rdfs:label 'Number Of Leases' ;
    rdfs:comment 'The total count of active lease agreements held by this tenant across the portfolio.' ;
