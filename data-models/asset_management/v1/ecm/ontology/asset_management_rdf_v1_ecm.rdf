    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskClass rdf:type rdf:Property ;
    rdfs:label 'Risk Class' ;
    rdfs:comment 'Primary risk class of the underlying exposure (e.g., interest rate, credit).' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityCount rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Count' ;
    rdfs:comment 'Number of individual risk factor sensitivities processed in the calculation.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:simmCalculationStatus rdf:type rdf:Property ;
    rdfs:label 'Simm Calculation Status' ;
    rdfs:comment 'Current processing status of the SIMM calculation.' ;
    rdfs:domain ind:SimmCalculation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRiskWeight rdf:type rdf:Property ;
