    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noteType rdf:type rdf:Property ;
    rdfs:label 'Note Type' ;
    rdfs:comment 'Classification of the research note by purpose and content type. [ENUM-REF-CANDIDATE: initiation|update|earnings_review|sector_note|thematic|downgrade|upgrade — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ResearchNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peRatioForward rdf:type rdf:Property ;
    rdfs:label 'Pe Ratio Forward' ;
