    rdfs:range xsd:decimal .

ind:originalSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Original Settlement Date' ;
    rdfs:comment 'The original settlement date before amendment, captured for audit trail purposes.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originalValue rdf:type rdf:Property ;
    rdfs:label 'Original Value' ;
    rdfs:comment 'The original value of the field before the amendment was applied.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reasonCode rdf:type rdf:Property ;
    rdfs:label 'Reason Code' ;
    rdfs:comment 'Standardized code indicating the business reason for the amendment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reasonDescription rdf:type rdf:Property ;
    rdfs:label 'Reason Description' ;
    rdfs:comment 'Detailed free-text explanation of why the amendment was necessary.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Status' ;
    rdfs:comment 'Status of regulatory reporting submission for this amendment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Timestamp' ;
    rdfs:comment 'Date and time when the amendment was reported to regulatory authorities.' ;
    rdfs:domain ind:Amendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:statusHistoryId rdf:type rdf:Property ;
    rdfs:label 'Status History Id' ;
    rdfs:comment 'Unique identifier for each status transition record in the trade lifecycle audit trail.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggeringUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Triggering User Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Trade status transitions require audit trails showing which employee triggered each change.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:amendmentFlag rdf:type rdf:Property ;
    rdfs:label 'Amendment Flag' ;
    rdfs:comment 'Indicates whether this status transition was triggered by a trade amendment.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cancellationFlag rdf:type rdf:Property ;
    rdfs:label 'Cancellation Flag' ;
    rdfs:comment 'Indicates whether this status transition represents a trade cancellation event.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:correctionFlag rdf:type rdf:Property ;
    rdfs:label 'Correction Flag' ;
    rdfs:comment 'Indicates whether this status transition was triggered by a trade correction.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:errorCode rdf:type rdf:Property ;
    rdfs:label 'Error Code' ;
    rdfs:comment 'System or business error code if the status transition represents a failure or rejection.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sequence Number' ;
    rdfs:comment 'Sequential order of this status transition within the trades complete lifecycle.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:statusFrom rdf:type rdf:Property ;
    rdfs:label 'Status From' ;
    rdfs:comment 'The previous status of the trade before this transition occurred. [ENUM-REF-CANDIDATE: new|pending|executed|confirmed|allocated|settled|cancelled|rejected — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statusTo rdf:type rdf:Property ;
    rdfs:label 'Status To' ;
    rdfs:comment 'The new status of the trade after this transition occurred. [ENUM-REF-CANDIDATE: new|pending|executed|confirmed|allocated|settled|cancelled|rejected — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeValue rdf:type rdf:Property ;
    rdfs:label 'Trade Value' ;
    rdfs:comment 'The total monetary value of the trade at this status transition point.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transitionEvent rdf:type rdf:Property ;
    rdfs:label 'Transition Event' ;
    rdfs:comment 'The business event that triggered this status change. [ENUM-REF-CANDIDATE: order_created|execution_received|trade_confirmed|allocation_completed|settlement_completed|trade_cancelled|trade_rejected|amendment_applied|correction_applied — 9 candidates' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReason rdf:type rdf:Property ;
    rdfs:label 'Transition Reason' ;
    rdfs:comment 'Business reason or explanation for the status change.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringSystem rdf:type rdf:Property ;
    rdfs:label 'Triggering System' ;
    rdfs:comment 'The source system that initiated or recorded this status transition.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringUser rdf:type rdf:Property ;
    rdfs:label 'Triggering User' ;
    rdfs:comment 'The user or service account that triggered this status change.' ;
    rdfs:domain ind:StatusHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionCostId rdf:type rdf:Property ;
    rdfs:label 'Transaction Cost Id' ;
    rdfs:comment 'Unique identifier for the transaction cost record.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clearingFee rdf:type rdf:Property ;
    rdfs:label 'Clearing Fee' ;
    rdfs:comment 'Fee charged by the central counterparty or clearing house for trade clearing.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Amount' ;
    rdfs:comment 'Total cost amount for this transaction cost component in the cost currency.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costBps rdf:type rdf:Property ;
    rdfs:label 'Cost Bps' ;
    rdfs:comment 'Transaction cost expressed in basis points relative to trade notional value.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCalculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Cost Calculation Timestamp' ;
    rdfs:comment 'Date and time when the transaction cost was calculated and recorded.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:costReference rdf:type rdf:Property ;
    rdfs:label 'Cost Reference' ;
    rdfs:comment 'External reference number or identifier for this transaction cost record.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeFee rdf:type rdf:Property ;
    rdfs:label 'Exchange Fee' ;
    rdfs:comment 'Fee charged by the trading venue or exchange for trade execution.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionPrice rdf:type rdf:Property ;
    rdfs:label 'Execution Price' ;
    rdfs:comment 'Actual price at which the trade was executed.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxConversionCost rdf:type rdf:Property ;
    rdfs:label 'Fx Conversion Cost' ;
    rdfs:comment 'Cost incurred for currency conversion related to cross-border trade settlement.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Market Impact Amount' ;
    rdfs:comment 'Estimated cost due to the trades impact on market price during execution.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:opportunityCostAmount rdf:type rdf:Property ;
    rdfs:label 'Opportunity Cost Amount' ;
    rdfs:comment 'Cost of unfilled or partially filled orders representing missed investment opportunities.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementFee rdf:type rdf:Property ;
    rdfs:label 'Settlement Fee' ;
    rdfs:comment 'Fee charged by custodian or settlement agent for trade settlement processing.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slippageAmount rdf:type rdf:Property ;
    rdfs:label 'Slippage Amount' ;
    rdfs:comment 'Difference between expected execution price and actual execution price.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:softDollarAllocation rdf:type rdf:Property ;
    rdfs:label 'Soft Dollar Allocation' ;
    rdfs:comment 'Portion of commission allocated to soft dollar research payments per MiFID II unbundling.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spreadAmount rdf:type rdf:Property ;
    rdfs:label 'Spread Amount' ;
    rdfs:comment 'Cost attributed to the bid-ask spread at time of execution.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timingCostAmount rdf:type rdf:Property ;
    rdfs:label 'Timing Cost Amount' ;
    rdfs:comment 'Cost attributed to delay between order decision and execution.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Trade Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the trade notional value.' ;
    rdfs:domain ind:TransactionCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algoOrderId rdf:type rdf:Property ;
    rdfs:label 'Algo Order Id' ;
    rdfs:comment 'Unique identifier for the algorithmic execution order record.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:algoOrderStatus rdf:type rdf:Property ;
    rdfs:label 'Algo Order Status' ;
    rdfs:comment 'Current lifecycle status of the algorithmic order execution. [ENUM-REF-CANDIDATE: New|Pending|Active|Paused|Completed|Cancelled|Rejected|Expired — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algoProvider rdf:type rdf:Property ;
    rdfs:label 'Algo Provider' ;
    rdfs:comment 'Name of the algorithmic trading platform or service provider executing the order.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algoStrategyType rdf:type rdf:Property ;
    rdfs:label 'Algo Strategy Type' ;
    rdfs:comment 'Type of algorithmic trading strategy employed to execute the order with minimal market impact.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:algoVersion rdf:type rdf:Property ;
    rdfs:label 'Algo Version' ;
    rdfs:comment 'Version identifier of the algorithmic strategy used for execution, for audit and performance tracking.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:childOrderCount rdf:type rdf:Property ;
    rdfs:label 'Child Order Count' ;
    rdfs:comment 'Total number of child orders generated by the algorithmic strategy to execute the parent order.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:darkPoolParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Dark Pool Participation Flag' ;
    rdfs:comment 'Indicates whether the algorithmic strategy is permitted to route orders to dark pools and alternative trading systems.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:endTime rdf:type rdf:Property ;
    rdfs:label 'End Time' ;
    rdfs:comment 'Scheduled end time for the algorithmic execution window in HH:MM:SS format.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionStyle rdf:type rdf:Property ;
    rdfs:label 'Execution Style' ;
    rdfs:comment 'Trading style parameter controlling the aggressiveness of the algorithmic execution strategy.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationShortfallBps rdf:type rdf:Property ;
    rdfs:label 'Implementation Shortfall Bps' ;
    rdfs:comment 'Total cost of execution in basis points including market impact, timing cost, and opportunity cost.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxParticipationRate rdf:type rdf:Property ;
    rdfs:label 'Max Participation Rate' ;
    rdfs:comment 'Maximum percentage of market volume that the algorithmic strategy may consume to avoid excessive market impact.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxSliceQuantity rdf:type rdf:Property ;
    rdfs:label 'Max Slice Quantity' ;
    rdfs:comment 'Maximum quantity that may be sent in a single child order slice by the algorithmic strategy.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minFillQuantity rdf:type rdf:Property ;
    rdfs:label 'Min Fill Quantity' ;
    rdfs:comment 'Minimum quantity that must be filled in each child order execution to avoid excessive fragmentation.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderQuantity rdf:type rdf:Property ;
    rdfs:label 'Order Quantity' ;
    rdfs:comment 'Total quantity of the instrument to be executed via the algorithmic strategy.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participationRateTarget rdf:type rdf:Property ;
    rdfs:label 'Participation Rate Target' ;
    rdfs:comment 'Target participation rate as a percentage of market volume for POV algorithmic strategies.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceLimitOffsetBps rdf:type rdf:Property ;
    rdfs:label 'Price Limit Offset Bps' ;
    rdfs:comment 'Price tolerance in basis points from the benchmark or limit price that the algorithmic strategy may deviate.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slippageBps rdf:type rdf:Property ;
    rdfs:label 'Slippage Bps' ;
    rdfs:comment 'Measured slippage in basis points between the average execution price and the benchmark price.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:startTime rdf:type rdf:Property ;
    rdfs:label 'Start Time' ;
    rdfs:comment 'Scheduled start time for the algorithmic execution window in HH:MM:SS format.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:urgencyLevel rdf:type rdf:Property ;
    rdfs:label 'Urgency Level' ;
    rdfs:comment 'Priority level indicating how aggressively the algorithmic strategy should pursue execution.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueRestrictionList rdf:type rdf:Property ;
    rdfs:label 'Venue Restriction List' ;
    rdfs:comment 'Comma-separated list of Market Identifier Codes (MIC) for venues that are restricted or preferred for this algorithmic order.' ;
    rdfs:domain ind:AlgoOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountClosureDate rdf:type rdf:Property ;
    rdfs:label 'Account Closure Date' ;
    rdfs:comment 'The date when the custody account was closed, if applicable.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountCurrency rdf:type rdf:Property ;
    rdfs:label 'Account Currency' ;
    rdfs:comment 'The base currency in which the custody account is denominated (ISO 4217 three-letter code).' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountManagerEmail rdf:type rdf:Property ;
    rdfs:label 'Account Manager Email' ;
    rdfs:comment 'Email address of the custodian relationship manager for operational communications.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountManagerName rdf:type rdf:Property ;
    rdfs:label 'Account Manager Name' ;
    rdfs:comment 'Name of the relationship manager or account officer at the custodian bank responsible for this account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountManagerPhone rdf:type rdf:Property ;
    rdfs:label 'Account Manager Phone' ;
    rdfs:comment 'Phone number of the custodian relationship manager for urgent operational matters.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountName rdf:type rdf:Property ;
    rdfs:label 'Account Name' ;
    rdfs:comment 'The legal name or title of the custody account as registered with the custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountOpeningDate rdf:type rdf:Property ;
    rdfs:label 'Account Opening Date' ;
    rdfs:comment 'The date when the custody account was opened with the custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountType rdf:type rdf:Property ;
    rdfs:label 'Account Type' ;
    rdfs:comment 'Classification of the custody account based on its purpose and structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualCustodyFeeBps rdf:type rdf:Property ;
    rdfs:label 'Annual Custody Fee Bps' ;
    rdfs:comment 'The annual custody fee charged by the custodian, expressed in basis points of Assets Under Administration (AUA).' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficialOwnerName rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Name' ;
    rdfs:comment 'The legal name of the beneficial owner of the assets held in this custody account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashSweepAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Cash Sweep Account Flag' ;
    rdfs:comment 'Indicates whether uninvested cash in this account is automatically swept to a designated cash management vehicle.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Account Flag' ;
    rdfs:comment 'Indicates whether this custody account is designated for holding collateral for derivatives or securities financing transactions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:custodyFeeScheduleCode rdf:type rdf:Property ;
    rdfs:label 'Custody Fee Schedule Code' ;
    rdfs:comment 'Reference code for the fee schedule applicable to this custody account.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reconciliation Date' ;
    rdfs:comment 'The date of the most recent successful reconciliation of this custody account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastStatementDate rdf:type rdf:Property ;
    rdfs:label 'Last Statement Date' ;
    rdfs:comment 'The date of the most recent custody account statement received from the custodian.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nomineeName rdf:type rdf:Property ;
    rdfs:label 'Nominee Name' ;
    rdfs:comment 'The name of the nominee entity under which securities are registered, if applicable.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omnibusAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Omnibus Account Flag' ;
    rdfs:comment 'Indicates whether this is an omnibus account holding assets for multiple underlying beneficial owners.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reconciliationFrequency rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Frequency' ;
    rdfs:comment 'The frequency at which holdings and cash balances in this custody account are reconciled with internal records.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safekeepingAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Safekeeping Account Number' ;
    rdfs:comment 'The safekeeping or depository account number where securities are held.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securitiesLendingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Securities Lending Eligible Flag' ;
    rdfs:comment 'Indicates whether securities held in this account are eligible for securities lending programs.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:segregatedAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Segregated Account Flag' ;
    rdfs:comment 'Indicates whether assets in this account are held in a segregated manner separate from the custodians own assets.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:serviceLevelAgreementTier rdf:type rdf:Property ;
    rdfs:label 'Service Level Agreement Tier' ;
    rdfs:comment 'The service tier or SLA level applicable to this custody account.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeePerTrade rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Per Trade' ;
    rdfs:comment 'The per-transaction fee charged by the custodian for trade settlement services.' ;
    rdfs:domain ind:CustodyAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instrumentExclusionId rdf:type rdf:Property ;
    rdfs:label 'Instrument Exclusion Id' ;
    rdfs:comment 'Unique identifier for this instrument-exclusion relationship record. Primary key.' ;
    rdfs:domain ind:InstrumentExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:instrumentExclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Instrument Exclusion Status' ;
    rdfs:comment 'Current status of this exclusion application: active (exclusion enforced), pending_divestment (in process of selling), divested (fully exited), waived (exception granted).' ;
    rdfs:domain ind:InstrumentExclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingSetInclusionId rdf:type rdf:Property ;
    rdfs:label 'Netting Set Inclusion Id' ;
    rdfs:comment 'Unique system-generated identifier for the netting set inclusion record' ;
    rdfs:domain ind:NettingSetInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:eligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Eligibility Status' ;
    rdfs:comment 'Current eligibility status of the trade for netting under this agreement based on product scope, legal enforceability, and agreement terms' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionDate rdf:type rdf:Property ;
    rdfs:label 'Exclusion Date' ;
    rdfs:comment 'Date on which the trade was removed from the netting set, null if currently included' ;
    rdfs:domain ind:NettingSetInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposureContribution rdf:type rdf:Property ;
    rdfs:label 'Exposure Contribution' ;
    rdfs:comment 'The trade\'s contribution to the netted exposure calculation under this netting agreement, expressed in the agreement\'s base currency' ;
    rdfs:domain ind:NettingSetInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inclusionDate rdf:type rdf:Property ;
    rdfs:label 'Inclusion Date' ;
    rdfs:comment 'Date on which the OTC derivative trade was added to the netting set under this agreement' ;
    rdfs:domain ind:NettingSetInclusion ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradeCheckId rdf:type rdf:Property ;
    rdfs:label 'Trade Check Id' ;
    rdfs:comment 'Primary key for the check association' ;
    rdfs:domain ind:TradeCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:result rdf:type rdf:Property ;
    rdfs:label 'Result' ;
    rdfs:comment 'Outcome of the compliance check indicating whether the order passed, failed, or triggered a warning for this rule' ;
    rdfs:domain ind:TradeCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:apiIntegrationStatus rdf:type rdf:Property ;
    rdfs:label 'Api Integration Status' ;
    rdfs:comment 'Status of API-based integration for real-time position and transaction data feeds.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aumThresholdUsd rdf:type rdf:Property ;
    rdfs:label 'Aum Threshold Usd' ;
    rdfs:comment 'Minimum assets under management threshold in USD required by the custodian for service eligibility.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Contract Effective Date' ;
    rdfs:comment 'Date when the current custody agreement became legally effective.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Contract Expiry Date' ;
    rdfs:comment 'Date when the current custody agreement is scheduled to expire or requires renewal.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:custodianType rdf:type rdf:Property ;
    rdfs:label 'Custodian Type' ;
    rdfs:comment 'Classification of custodian by service model and market coverage scope.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceCoverageUsd rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage Usd' ;
    rdfs:comment 'Total insurance coverage amount in USD protecting client assets held by the custodian.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isQualifiedCustodian rdf:type rdf:Property ;
    rdfs:label 'Is Qualified Custodian' ;
    rdfs:comment 'Indicates whether the custodian meets qualified custodian requirements under SEC Rule 206(4)-2.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSystemicallyImportant rdf:type rdf:Property ;
    rdfs:label 'Is Systemically Important' ;
    rdfs:comment 'Indicates whether the custodian is designated as a systemically important financial institution (SIFI).' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDueDiligenceDate rdf:type rdf:Property ;
    rdfs:label 'Last Due Diligence Date' ;
    rdfs:comment 'Date of the most recent operational due diligence review conducted on the custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextDueDiligenceDate rdf:type rdf:Property ;
    rdfs:label 'Next Due Diligence Date' ;
    rdfs:comment 'Scheduled date for the next operational due diligence review of the custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registeredAddress rdf:type rdf:Property ;
    rdfs:label 'Registered Address' ;
    rdfs:comment 'Official registered business address of the custodian institution for legal and regulatory correspondence.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory License Number' ;
    rdfs:comment 'License or registration number issued by the regulatory authority authorizing custody services.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementCutOffTime rdf:type rdf:Property ;
    rdfs:label 'Settlement Cut Off Time' ;
    rdfs:comment 'Daily deadline time for submitting settlement instructions to the custodian in local timezone.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianStatus rdf:type rdf:Property ;
    rdfs:label 'Custodian Status' ;
    rdfs:comment 'Current operational status of the custodian relationship for trade settlement purposes.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Supported Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset classes the custodian can hold and settle (equities, fixed income, FX, derivatives).' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportedMarkets rdf:type rdf:Property ;
    rdfs:label 'Supported Markets' ;
    rdfs:comment 'Comma-separated list of market codes or regions where the custodian provides settlement services.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportsCorporateActions rdf:type rdf:Property ;
    rdfs:label 'Supports Corporate Actions' ;
    rdfs:comment 'Indicates whether the custodian processes corporate actions (dividends, splits, mergers) on behalf of clients.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsFxExecution rdf:type rdf:Property ;
    rdfs:label 'Supports Fx Execution' ;
    rdfs:comment 'Indicates whether the custodian provides foreign exchange execution services for settlement.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsProxyVoting rdf:type rdf:Property ;
    rdfs:label 'Supports Proxy Voting' ;
    rdfs:comment 'Indicates whether the custodian facilitates proxy voting services for equity holdings.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportsSecuritiesLending rdf:type rdf:Property ;
    rdfs:label 'Supports Securities Lending' ;
    rdfs:comment 'Indicates whether the custodian offers securities lending program services.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:swiftConnectivityStatus rdf:type rdf:Property ;
    rdfs:label 'Swift Connectivity Status' ;
    rdfs:comment 'Status of SWIFT messaging connectivity for automated settlement instruction transmission.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeeUsd rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Usd' ;
    rdfs:comment 'Standard per-transaction settlement fee in USD charged by the custodian.' ;
    rdfs:domain ind:Custodian ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:departmentId rdf:type rdf:Property ;
    rdfs:label 'Department Id' ;
    rdfs:comment 'Reference to the trading desk responsible for executing orders for this allocation group.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Department .

ind:accountCount rdf:type rdf:Property ;
    rdfs:label 'Account Count' ;
    rdfs:comment 'Number of investment accounts currently assigned to this allocation group.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowsPartialFills rdf:type rdf:Property ;
    rdfs:label 'Allows Partial Fills' ;
    rdfs:comment 'Indicates whether the allocation group accepts partial order fills for distribution.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:autoRebalanceEnabled rdf:type rdf:Property ;
    rdfs:label 'Auto Rebalance Enabled' ;
    rdfs:comment 'Indicates whether automatic rebalancing is enabled for accounts in this allocation group.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cashBufferPercent rdf:type rdf:Property ;
    rdfs:label 'Cash Buffer Percent' ;
    rdfs:comment 'Percentage of portfolio value to maintain as cash buffer for liquidity management.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationGroupDescription rdf:type rdf:Property ;
    rdfs:label 'Allocation Group Description' ;
    rdfs:comment 'Detailed description of the allocation group purpose, investment mandate, and allocation rules.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:driftTolerancePercent rdf:type rdf:Property ;
    rdfs:label 'Drift Tolerance Percent' ;
    rdfs:comment 'Maximum percentage deviation from target weights before triggering rebalancing.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalSystemCode rdf:type rdf:Property ;
    rdfs:label 'External System Code' ;
    rdfs:comment 'Identifier used by external systems or counterparties to reference this allocation group.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupCode rdf:type rdf:Property ;
    rdfs:label 'Group Code' ;
    rdfs:comment 'Business identifier code used to reference the allocation group in trading systems and order management platforms.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:groupType rdf:type rdf:Property ;
    rdfs:label 'Group Type' ;
    rdfs:comment 'Classification of the allocation group by its functional purpose in the investment process.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDefaultGroup rdf:type rdf:Property ;
    rdfs:label 'Is Default Group' ;
    rdfs:comment 'Indicates whether this allocation group is the default for unassigned orders.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isModelPortfolio rdf:type rdf:Property ;
    rdfs:label 'Is Model Portfolio' ;
    rdfs:comment 'Indicates whether this allocation group represents a model portfolio for rebalancing purposes.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumAllocationQuantity rdf:type rdf:Property ;
    rdfs:label 'Minimum Allocation Quantity' ;
    rdfs:comment 'Minimum number of shares or units that can be allocated to any single account within the group.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationGroupName rdf:type rdf:Property ;
    rdfs:label 'Allocation Group Name' ;
    rdfs:comment 'Human-readable name of the allocation group used for display and reporting purposes.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:omsSystemCode rdf:type rdf:Property ;
    rdfs:label 'Oms System Code' ;
    rdfs:comment 'Code identifying this allocation group in the Order Management System (Charles River or Bloomberg AIM).' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresPreTradeCompliance rdf:type rdf:Property ;
    rdfs:label 'Requires Pre Trade Compliance' ;
    rdfs:comment 'Indicates whether orders for this group must pass pre-trade compliance checks.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roundingLotSize rdf:type rdf:Property ;
    rdfs:label 'Rounding Lot Size' ;
    rdfs:comment 'Standard lot size used for rounding allocations to tradeable quantities.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:roundingMethod rdf:type rdf:Property ;
    rdfs:label 'Rounding Method' ;
    rdfs:comment 'Method used to round fractional shares or units during the allocation process.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationGroupStatus rdf:type rdf:Property ;
    rdfs:label 'Allocation Group Status' ;
    rdfs:comment 'Current lifecycle status of the allocation group indicating its operational availability.' ;
    rdfs:domain ind:AllocationGroup ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingBrokerId rdf:type rdf:Property ;
    rdfs:label 'Clearing Broker Id' ;
    rdfs:comment 'Reference to the clearing broker used for indirect clearing access, if applicable.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Broker .

ind:centralBankMoneySettlement rdf:type rdf:Property ;
    rdfs:label 'Central Bank Money Settlement' ;
    rdfs:comment 'Indicates whether settlement occurs in central bank money rather than commercial bank money.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearingHouseType rdf:type rdf:Property ;
    rdfs:label 'Clearing House Type' ;
    rdfs:comment 'Classification of clearing house: CCP (Central Counterparty), CSD (Central Securities Depository), ICSD (International CSD), hybrid, or other.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingMoodys rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Moodys' ;
    rdfs:comment 'Current credit rating assigned to the clearing house by Moody\'s Investors Service.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultFundContributionRequired rdf:type rdf:Property ;
    rdfs:label 'Default Fund Contribution Required' ;
    rdfs:comment 'Indicates whether clearing members must contribute to a mutualized default fund.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultSettlementCycle rdf:type rdf:Property ;
    rdfs:label 'Default Settlement Cycle' ;
    rdfs:comment 'Standard settlement cycle for cleared trades (e.g., T+0, T+1, T+2).' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultWaterfallPosition rdf:type rdf:Property ;
    rdfs:label 'Default Waterfall Position' ;
    rdfs:comment 'Position of clearing house capital in the default waterfall sequence (1=first loss, higher=later).' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emirTier rdf:type rdf:Property ;
    rdfs:label 'Emir Tier' ;
    rdfs:comment 'EMIR classification tier for third-country CCPs (Tier 1 or Tier 2) or not applicable for EU-based CCPs.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interoperabilityLinks rdf:type rdf:Property ;
    rdfs:label 'Interoperability Links' ;
    rdfs:comment 'Comma-separated list of other clearing houses with which interoperability agreements exist.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marginMethodology rdf:type rdf:Property ;
    rdfs:label 'Margin Methodology' ;
    rdfs:comment 'Primary margin calculation methodology used by the clearing house.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:membershipEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Membership Effective Date' ;
    rdfs:comment 'Date when the pension funds clearing membership or access became effective.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:membershipTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Membership Termination Date' ;
    rdfs:comment 'Date when the pension funds clearing membership or access was terminated, if applicable.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:membershipType rdf:type rdf:Property ;
    rdfs:label 'Membership Type' ;
    rdfs:comment 'Type of clearing access: direct clearing member, indirect via clearing broker, or sponsored access.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nettingCapability rdf:type rdf:Property ;
    rdfs:label 'Netting Capability' ;
    rdfs:comment 'Indicates whether the clearing house supports multilateral netting of obligations.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operationalHoursEnd rdf:type rdf:Property ;
    rdfs:label 'Operational Hours End' ;
    rdfs:comment 'Daily operational end time in HH:MM format (local time zone).' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalHoursStart rdf:type rdf:Property ;
    rdfs:label 'Operational Hours Start' ;
    rdfs:comment 'Daily operational start time in HH:MM format (local time zone).' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pfmiCompliant rdf:type rdf:Property ;
    rdfs:label 'Pfmi Compliant' ;
    rdfs:comment 'Indicates whether the clearing house is compliant with CPMI-IOSCO Principles for Financial Market Infrastructures.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:qccpStatus rdf:type rdf:Property ;
    rdfs:label 'Qccp Status' ;
    rdfs:comment 'Indicates whether the clearing house qualifies as a QCCP under Basel III capital requirements.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:realTimeGrossSettlement rdf:type rdf:Property ;
    rdfs:label 'Real Time Gross Settlement' ;
    rdfs:comment 'Indicates whether the clearing house supports real-time gross settlement processing.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recoveryPlanAvailable rdf:type rdf:Property ;
    rdfs:label 'Recovery Plan Available' ;
    rdfs:comment 'Indicates whether the clearing house has a published recovery and resolution plan.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:settlementCurrencyCodes rdf:type rdf:Property ;
    rdfs:label 'Settlement Currency Codes' ;
    rdfs:comment 'Comma-separated ISO 4217 currency codes supported for settlement (e.g., USD,EUR,GBP,JPY).' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:skinInTheGameAmount rdf:type rdf:Property ;
    rdfs:label 'Skin In The Game Amount' ;
    rdfs:comment 'Amount of the clearing houses own capital committed to the default waterfall, in base currency.' ;
    rdfs:domain ind:ClearingHouse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityReservePolicyId rdf:type rdf:Property ;
    rdfs:label 'Liquidity Reserve Policy Id' ;
    rdfs:comment 'Foreign key linking to treasury.liquidity_reserve_policy. Business justification: Cash positions are measured against liquidity reserve policy requirements. Links position to applicable policy.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidityReservePolicy .

ind:sofrBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Sofr Benchmark Id' ;
    rdfs:comment 'Foreign key linking to treasury.sofr_benchmark. Business justification: Cash position interest rates are derived from SOFR; linking provides a direct reference to the benchmark.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SofrBenchmark .

ind:availableBalance rdf:type rdf:Property ;
    rdfs:label 'Available Balance' ;
    rdfs:comment 'The cash balance available for immediate use, net of pending settlements, holds, and reserved amounts.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankIdentifierCode rdf:type rdf:Property ;
    rdfs:label 'Bank Identifier Code' ;
    rdfs:comment 'The SWIFT BIC code of the custodian bank branch holding this cash account, used for international wire transfers and settlement instructions.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalCallPending rdf:type rdf:Property ;
    rdfs:label 'Capital Call Pending' ;
    rdfs:comment 'Total value of capital calls issued by private equity, infrastructure, or real estate fund managers that are pending funding from this cash account.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodyBalance rdf:type rdf:Property ;
    rdfs:label 'Custody Balance' ;
    rdfs:comment 'The cash balance reported by the custodian bank (State Street or Northern Trust), representing the external source of truth for reconciliation.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionPending rdf:type rdf:Property ;
    rdfs:label 'Distribution Pending' ;
    rdfs:comment 'Total value of distributions from private market investments or fund managers that are expected to be received into this cash account.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxHedgeRatio rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Ratio' ;
    rdfs:comment 'The proportion of this currency exposure that is hedged through FX forwards or swaps, expressed as a decimal (e.g., 0.8500 for 85 percent hedged).' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCurrent rdf:type rdf:Property ;
    rdfs:label 'Is Current' ;
    rdfs:comment 'Indicates whether this is the current active version of the cash position record, supporting slowly changing dimension queries.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ledgerBalance rdf:type rdf:Property ;
    rdfs:label 'Ledger Balance' ;
    rdfs:comment 'The accounting book balance as recorded in the internal general ledger, representing the official accounting position before reconciliation adjustments.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netContributionInflow rdf:type rdf:Property ;
    rdfs:label 'Net Contribution Inflow' ;
    rdfs:comment 'The net cash inflow from pension contributions (member and employer contributions minus benefit payments) received during the reporting period.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdraftLimit rdf:type rdf:Property ;
    rdfs:label 'Overdraft Limit' ;
    rdfs:comment 'The maximum negative balance permitted by the custodian for this account, representing the intraday credit facility available.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pendingSettlementsInflow rdf:type rdf:Property ;
    rdfs:label 'Pending Settlements Inflow' ;
    rdfs:comment 'Total value of incoming cash settlements not yet reflected in the custody balance, including trade settlements, dividend receipts, and capital distributions.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pendingSettlementsOutflow rdf:type rdf:Property ;
    rdfs:label 'Pending Settlements Outflow' ;
    rdfs:comment 'Total value of outgoing cash settlements not yet reflected in the custody balance, including trade purchases, capital calls, and fee payments.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Position Timestamp' ;
    rdfs:comment 'The precise timestamp when this cash position snapshot was captured, supporting intraday position tracking.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:projectedBalance rdf:type rdf:Property ;
    rdfs:label 'Projected Balance' ;
    rdfs:comment 'The forecasted end-of-day cash balance incorporating known future cash flows, capital calls, and scheduled settlements.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationDifference rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Difference' ;
    rdfs:comment 'The variance between ledger balance and custody balance, representing unreconciled items requiring investigation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingCurrencyFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency Flag' ;
    rdfs:comment 'Indicates whether this cash position is denominated in the funds base reporting currency, used for performance and NAV (Net Asset Value) calculation.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reservedAmount rdf:type rdf:Property ;
    rdfs:label 'Reserved Amount' ;
    rdfs:comment 'Cash amount reserved or earmarked for specific purposes such as collateral requirements, margin calls, or committed capital calls, not available for general use.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sweepAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Sweep Account Flag' ;
    rdfs:comment 'Indicates whether this account participates in automated cash sweep programs to optimize interest income on idle cash balances.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:zeroBalanceAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Zero Balance Account Flag' ;
    rdfs:comment 'Indicates whether this is a zero balance account that automatically transfers excess cash to or from a master concentration account.' ;
    rdfs:domain ind:CashPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bankAccountSsiId rdf:type rdf:Property ;
    rdfs:label 'Bank Account Ssi Id' ;
    rdfs:comment 'Reference to the standard settlement instructions template used for automated payment routing from this account.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccountSsi .

ind:csaAgreementCsaId rdf:type rdf:Property ;
    rdfs:label 'Csa Agreement Csa Id' ;
    rdfs:comment 'Reference to the ISDA Credit Support Annex agreement governing collateral held in this account.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Csa .

ind:ssiTemplateBankAccountSsiId rdf:type rdf:Property ;
    rdfs:label 'Ssi Template Bank Account Ssi Id' ;
    rdfs:comment 'Reference to the standard settlement instructions template used for automated payment routing from this account.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BankAccountSsi .

ind:sweepTargetAccountId rdf:type rdf:Property ;
    rdfs:label 'Sweep Target Account Id' ;
    rdfs:comment 'Reference to the target cash account for automated sweep transactions.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:abaRoutingNumber rdf:type rdf:Property ;
    rdfs:label 'Aba Routing Number' ;
    rdfs:comment 'Nine-digit ABA routing transit number for domestic US wire transfers and ACH transactions.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountClosedDate rdf:type rdf:Property ;
    rdfs:label 'Account Closed Date' ;
    rdfs:comment 'Date when the cash account was closed or terminated, if applicable.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountOpenedDate rdf:type rdf:Property ;
    rdfs:label 'Account Opened Date' ;
    rdfs:comment 'Date when the cash account was originally opened with the custodian.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accountOwnership rdf:type rdf:Property ;
    rdfs:label 'Account Ownership' ;
    rdfs:comment 'Ownership structure of the account: internal treasury, external custodian-held, pooled with other funds, or segregated for specific mandate.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accountPurpose rdf:type rdf:Property ;
    rdfs:label 'Account Purpose' ;
    rdfs:comment 'Detailed business purpose or use case for this cash account (e.g., trade settlement, capital call funding, dividend collection, FX hedging collateral).' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:balanceReportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Balance Reporting Frequency' ;
    rdfs:comment 'Frequency at which the custodian provides balance updates for this account.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bicSwiftCode rdf:type rdf:Property ;
    rdfs:label 'Bic Swift Code' ;
    rdfs:comment 'BIC/SWIFT code identifying the custodian bank and branch for international wire transfers and settlement instructions.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correspondentBankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Correspondent Bank Account Number' ;
    rdfs:comment 'Account number held at the correspondent bank for settlement routing.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correspondentBankBic rdf:type rdf:Property ;
    rdfs:label 'Correspondent Bank Bic' ;
    rdfs:comment 'BIC/SWIFT code of the correspondent bank for routing international payments.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correspondentBankName rdf:type rdf:Property ;
    rdfs:label 'Correspondent Bank Name' ;
    rdfs:comment 'Name of the correspondent or intermediary bank used for settlement routing, if applicable.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:iban rdf:type rdf:Property ;
    rdfs:label 'Iban' ;
    rdfs:comment 'International Bank Account Number for cross-border settlement and identification, primarily used in European and international transactions.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestBearingFlag rdf:type rdf:Property ;
    rdfs:label 'Interest Bearing Flag' ;
    rdfs:comment 'Indicates whether this cash account earns interest on positive balances.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Calculation Method' ;
    rdfs:comment 'Day count convention used for interest accrual calculation (Actual/360, Actual/365, 30/360, Actual/Actual).' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRateBps rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Bps' ;
    rdfs:comment 'Current interest rate applied to the account, expressed in basis points (1 bps = 0.01%).' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalGlAccountCode rdf:type rdf:Property ;
    rdfs:label 'Internal Gl Account Code' ;
    rdfs:comment 'Internal general ledger account code in Oracle Financials or corporate accounting system mapped to this cash account.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastActivityDate rdf:type rdf:Property ;
    rdfs:label 'Last Activity Date' ;
    rdfs:comment 'Date of the most recent transaction or balance change in this account.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumBalanceRequirement rdf:type rdf:Property ;
    rdfs:label 'Minimum Balance Requirement' ;
    rdfs:comment 'Minimum balance that must be maintained in the account to avoid fees or restrictions, in the account currency.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overdraftAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Overdraft Allowed Flag' ;
    rdfs:comment 'Indicates whether the account is permitted to have a negative balance (overdraft facility).' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overdraftLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Overdraft Limit Amount' ;
    rdfs:comment 'Maximum negative balance permitted on this account, in the account currency.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sweepArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Sweep Arrangement Flag' ;
    rdfs:comment 'Indicates whether this account participates in an automated cash sweep arrangement to optimize liquidity.' ;
    rdfs:domain ind:CashAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sweepThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Sweep Threshold Amount' ;
    rdfs:comment 'Balance threshold above which excess cash is automatically swept to the target account.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityForecastId rdf:type rdf:Property ;
    rdfs:label 'Liquidity Forecast Id' ;
    rdfs:comment 'Unique identifier for the liquidity forecast record.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidityForecast .

ind:supersededByForecastLiquidityForecastId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Forecast Liquidity Forecast Id' ;
    rdfs:comment 'Reference to the subsequent liquidity forecast that supersedes this forecast, enabling version tracking and audit trail.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidityForecast .

ind:capitalCallFundingAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Call Funding Amount' ;
    rdfs:comment 'Projected capital call drawdowns from private equity, infrastructure, real estate, and other illiquid commitments requiring cash funding during the forecast period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingCashPositionAmount rdf:type rdf:Property ;
    rdfs:label 'Closing Cash Position Amount' ;
    rdfs:comment 'The projected ending cash and cash equivalents balance at the end of the forecast period, calculated as opening position plus net inflows minus net outflows.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralMovementNetAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Movement Net Amount' ;
    rdfs:comment 'Net cash impact from collateral posting and return requirements for derivatives, securities lending, and repo transactions.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionInflowAmount rdf:type rdf:Property ;
    rdfs:label 'Distribution Inflow Amount' ;
    rdfs:comment 'Projected cash distributions from private market investments, including dividends, interest, and capital returns during the forecast period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Expense Amount' ;
    rdfs:comment 'Projected cash outflows for investment management fees, custody fees, advisory fees, and carried interest payments during the forecast period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Forecast Confidence Level' ;
    rdfs:comment 'The assessed confidence level in the accuracy of the forecast, based on data quality, market volatility, and assumption reliability.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastHorizonEndDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Horizon End Date' ;
    rdfs:comment 'The end date of the forecast projection period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastHorizonStartDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Horizon Start Date' ;
    rdfs:comment 'The start date of the forecast projection period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastMethodology rdf:type rdf:Property ;
    rdfs:label 'Forecast Methodology' ;
    rdfs:comment 'Description of the methodology and assumptions used to prepare the liquidity forecast, including statistical models, historical trends, and expert judgment.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Forecast Reference Number' ;
    rdfs:comment 'Business identifier for the liquidity forecast, used for external reference and reporting.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastScenario rdf:type rdf:Property ;
    rdfs:label 'Forecast Scenario' ;
    rdfs:comment 'The scenario assumption under which the liquidity forecast is prepared, enabling stress testing and sensitivity analysis.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastStatus rdf:type rdf:Property ;
    rdfs:label 'Forecast Status' ;
    rdfs:comment 'Current lifecycle status of the liquidity forecast in the approval and publication workflow.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastType rdf:type rdf:Property ;
    rdfs:label 'Forecast Type' ;
    rdfs:comment 'Classification of the forecast by time horizon and purpose: short-term (T+1 to T+30), medium-term (T+30 to T+90), long-term (T+90 to T+365), strategic, tactical, or operational.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxHedgeSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Settlement Amount' ;
    rdfs:comment 'Projected cash flows from foreign exchange forward and swap settlements used for currency hedging during the forecast period.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquiditySurplusDeficitAmount rdf:type rdf:Property ;
    rdfs:label 'Liquidity Surplus Deficit Amount' ;
    rdfs:comment 'The projected surplus (positive) or deficit (negative) relative to the minimum liquidity threshold, indicating whether additional funding or investment actions are required.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumLiquidityThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Liquidity Threshold Amount' ;
    rdfs:comment 'The minimum cash balance required to meet operational needs, regulatory requirements, and risk management policies.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netContributionInflowAmount rdf:type rdf:Property ;
    rdfs:label 'Net Contribution Inflow Amount' ;
    rdfs:comment 'Projected net contributions from beneficiary pools (one per participating plan) during the forecast period, net of benefit payments and withdrawals.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:openingCashPositionAmount rdf:type rdf:Property ;
    rdfs:label 'Opening Cash Position Amount' ;
    rdfs:comment 'The starting cash and cash equivalents balance at the beginning of the forecast period, aggregated across all custody accounts and treasury instruments.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationalExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Operational Expense Amount' ;
    rdfs:comment 'Projected cash outflows for operational expenses including payroll, technology, facilities, and administrative costs.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherInflowAmount rdf:type rdf:Property ;
    rdfs:label 'Other Inflow Amount' ;
    rdfs:comment 'Projected cash inflows from other sources not categorized above, including tax refunds, legal settlements, and miscellaneous receipts.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherOutflowAmount rdf:type rdf:Property ;
    rdfs:label 'Other Outflow Amount' ;
    rdfs:comment 'Projected cash outflows for other purposes not categorized above, including tax payments, legal settlements, and miscellaneous disbursements.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publishedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Published Timestamp' ;
    rdfs:comment 'The date and time when the liquidity forecast was published and made available to stakeholders.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:shortTermInvestmentMaturityAmount rdf:type rdf:Property ;
    rdfs:label 'Short Term Investment Maturity Amount' ;
    rdfs:comment 'Projected cash inflows from maturing short-term liquidity instruments such as Treasury Bills (T-Bills), commercial paper, and SOFR-linked instruments.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortTermInvestmentPurchaseAmount rdf:type rdf:Property ;
    rdfs:label 'Short Term Investment Purchase Amount' ;
    rdfs:comment 'Projected cash outflows for purchasing short-term liquidity instruments to manage excess cash.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeSettlementNetAmount rdf:type rdf:Property ;
    rdfs:label 'Trade Settlement Net Amount' ;
    rdfs:comment 'Net cash impact from expected trade settlements across public equities, fixed income, and derivatives, calculated as settlement inflows minus outflows.' ;
    rdfs:domain ind:LiquidityForecast ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Contribution Period End' ;
    rdfs:comment 'End date of the payroll or contribution period covered by this inflow.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contributionPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Contribution Period Start' ;
    rdfs:comment 'Start date of the payroll or contribution period covered by this inflow.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:custodyAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Custody Account Number' ;
    rdfs:comment 'Account number at the custody platform where the contribution was received.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Contribution Amount' ;
    rdfs:comment 'Total contribution amount received before any deductions or adjustments.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Liquidity Reserve Amount' ;
    rdfs:comment 'Amount of the net contribution held in short-term liquidity instruments for cash management purposes.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityReserveFlag rdf:type rdf:Property ;
    rdfs:label 'Liquidity Reserve Flag' ;
    rdfs:comment 'Indicates whether a portion of this contribution was held in liquidity reserves (T-Bills, SOFR-linked instruments) rather than immediately allocated.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Net Contribution Amount' ;
    rdfs:comment 'Net investable capital after all deductions, representing the amount available for allocation to investment strategies.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remittanceMethod rdf:type rdf:Property ;
    rdfs:label 'Remittance Method' ;
    rdfs:comment 'The payment method or channel through which the contribution was received.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittingInstitutionBic rdf:type rdf:Property ;
    rdfs:label 'Remitting Institution Bic' ;
    rdfs:comment 'BIC or SWIFT code of the remitting financial institution.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittingInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Remitting Institution Name' ;
    rdfs:comment 'Name of the financial institution or employer that remitted the contribution.' ;
    rdfs:domain ind:NetContributionInflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalCallFundingId rdf:type rdf:Property ;
    rdfs:label 'Capital Call Funding Id' ;
    rdfs:comment 'Unique identifier for the capital call funding record.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalCallFunding .

ind:confirmationDocumentId rdf:type rdf:Property ;
    rdfs:label 'Confirmation Document Id' ;
    rdfs:comment 'Reference to the payment confirmation document received from the General Partner (GP) or custodian bank.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Document .

ind:fundInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Fund Investment Id' ;
    rdfs:comment 'Reference to the private market fund investment that issued this capital call.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:fxForwardId rdf:type rdf:Property ;
    rdfs:label 'Fx Forward Id' ;
    rdfs:comment 'Foreign key linking to treasury.fx_forward. Business justification: Capital call funding with FX hedge applied should link to the specific FX forward used for hedging.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxForward .

ind:fxHedgeInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Instrument Id' ;
    rdfs:comment 'Reference to the foreign exchange forward or swap instrument used to hedge this capital call funding.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Instrument .

ind:gpBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Gp Bank Account Id' ;
    rdfs:comment 'Reference to the General Partner (GP) bank account receiving the capital call funding.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpBankAccount .

ind:sourceCashAccountId rdf:type rdf:Property ;
    rdfs:label 'Source Cash Account Id' ;
    rdfs:comment 'Reference to the internal cash account from which the capital call funding was sourced.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:approvalWorkflowReference rdf:type rdf:Property ;
    rdfs:label 'Approval Workflow Reference' ;
    rdfs:comment 'Reference to the internal approval workflow instance for this capital call funding.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:callAmountRequested rdf:type rdf:Property ;
    rdfs:label 'Call Amount Requested' ;
    rdfs:comment 'Total capital amount requested by the General Partner (GP) in the fund currency.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callPurposeDescription rdf:type rdf:Property ;
    rdfs:label 'Call Purpose Description' ;
    rdfs:comment 'Business purpose or investment use case for the capital call as stated by the General Partner (GP).' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingAmountBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Funding Amount Base Currency' ;
    rdfs:comment 'Capital call funding amount converted to the pension fund base currency for accounting.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Funding Approval Date' ;
    rdfs:comment 'Date the capital call funding was approved by internal treasury or investment committee.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundingExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Funding Execution Date' ;
    rdfs:comment 'Date the capital call funding payment was executed and sent to the General Partner (GP).' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundingPriority rdf:type rdf:Property ;
    rdfs:label 'Funding Priority' ;
    rdfs:comment 'Internal priority level assigned to this capital call funding based on strategic importance and liquidity constraints.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Funding Settlement Date' ;
    rdfs:comment 'Date the capital call funding payment settled in the General Partner (GP) account per confirmation.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fxHedgeAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Applied Flag' ;
    rdfs:comment 'Indicates whether a foreign exchange hedge instrument was used to mitigate currency risk for this funding.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gpAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Gp Account Number' ;
    rdfs:comment 'Bank account number of the General Partner (GP) receiving the capital call funding.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpSwiftBicCode rdf:type rdf:Property ;
    rdfs:label 'Gp Swift Bic Code' ;
    rdfs:comment 'SWIFT Bank Identifier Code (BIC) for the General Partner (GP) receiving bank.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquiditySource rdf:type rdf:Property ;
    rdfs:label 'Liquidity Source' ;
    rdfs:comment 'Source of liquidity used to fund the capital call within the pension fund treasury operations.' ;
    rdfs:domain ind:CapitalCallFunding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPostedBase rdf:type rdf:Property ;
    rdfs:label 'Collateral Posted Base' ;
    rdfs:comment 'Total collateral posted to counterparties under Credit Support Annex (CSA) agreements for FX derivative positions in this currency pair.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralReceivedBase rdf:type rdf:Property ;
    rdfs:label 'Collateral Received Base' ;
    rdfs:comment 'Total collateral received from counterparties under CSA agreements for FX derivative positions in this currency pair.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyConcentrationPct rdf:type rdf:Property ;
    rdfs:label 'Counterparty Concentration Pct' ;
    rdfs:comment 'Percentage of total hedge notional concentrated with the largest single counterparty for this currency pair, used for counterparty risk monitoring.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dv01Base rdf:type rdf:Property ;
    rdfs:label 'Dv01 Base' ;
    rdfs:comment 'Sensitivity of the FX position value to a 1 basis point move in the exchange rate, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'Forward Hedge Notional Base' ;
    rdfs:comment 'Aggregate notional amount of FX forward contracts used to hedge exposure, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectivenessRatio rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Ratio' ;
    rdfs:comment 'Measure of hedge effectiveness per IFRS 9, calculated as the ratio of hedge instrument value change to hedged item value change.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioActual rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Actual' ;
    rdfs:comment 'Current hedge ratio expressed as a decimal, calculated as total hedge notional divided by spot exposure (e.g., 0.9500 represents 95% hedged).' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Target' ;
    rdfs:comment 'Strategic target hedge ratio as defined by treasury policy for this currency pair, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioVariance rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Variance' ;
    rdfs:comment 'Difference between actual and target hedge ratios, indicating over-hedging (positive) or under-hedging (negative).' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mtmValueBase rdf:type rdf:Property ;
    rdfs:label 'Mtm Value Base' ;
    rdfs:comment 'Current mark-to-market valuation of all FX hedging instruments for this currency pair, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOpenExposureBase rdf:type rdf:Property ;
    rdfs:label 'Net Open Exposure Base' ;
    rdfs:comment 'Net unhedged FX exposure after accounting for all hedging instruments, calculated as spot exposure minus total hedge notional.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextScheduledRebalanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Scheduled Rebalance Date' ;
    rdfs:comment 'Planned date for the next periodic hedge rebalancing review per treasury calendar.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optionHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'Option Hedge Notional Base' ;
    rdfs:comment 'Aggregate notional amount of FX option contracts used to hedge exposure, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionOwner rdf:type rdf:Property ;
    rdfs:label 'Position Owner' ;
    rdfs:comment 'Name or identifier of the treasury desk or portfolio manager responsible for managing this FX position.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalanceRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Rebalance Required Flag' ;
    rdfs:comment 'Indicator whether the position requires rebalancing to bring actual hedge ratio back within target tolerance bands.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebalanceThresholdBreachDate rdf:type rdf:Property ;
    rdfs:label 'Rebalance Threshold Breach Date' ;
    rdfs:comment 'Date when the hedge ratio variance first exceeded the policy-defined tolerance threshold, triggering rebalance requirement.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spotExposureBase rdf:type rdf:Property ;
    rdfs:label 'Spot Exposure Base' ;
    rdfs:comment 'Total unhedged foreign exchange exposure in base currency terms arising from underlying asset holdings.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:swapHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'Swap Hedge Notional Base' ;
    rdfs:comment 'Aggregate notional amount of FX swap contracts used to hedge exposure, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'Total Hedge Notional Base' ;
    rdfs:comment 'Sum of all FX hedging instrument notionals (forwards, swaps, options) in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedPnlBase rdf:type rdf:Property ;
    rdfs:label 'Unrealized Pnl Base' ;
    rdfs:comment 'Unrealized gain or loss on FX hedging instruments since inception, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:var1day95pctBase rdf:type rdf:Property ;
    rdfs:label 'Var 1day 95pct Base' ;
    rdfs:comment 'One-day Value at Risk at 95% confidence level for the net open FX exposure, expressed in base currency.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAvgForwardRate rdf:type rdf:Property ;
    rdfs:label 'Weighted Avg Forward Rate' ;
    rdfs:comment 'Notional-weighted average forward rate across all outstanding FX forward hedge contracts for this currency pair.' ;
    rdfs:domain ind:FxPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isdaMasterAgreementIsdaMasterId rdf:type rdf:Property ;
    rdfs:label 'Isda Master Agreement Isda Master Id' ;
    rdfs:comment 'Reference to the ISDA Master Agreement governing the legal terms of this derivative transaction.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IsdaMaster .

ind:nettingSetNettingAgreementId rdf:type rdf:Property ;
    rdfs:label 'Netting Set Netting Agreement Id' ;
    rdfs:comment 'Identifier for the group of transactions with the same counterparty that are subject to close-out netting under the ISDA agreement.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NettingAgreement .

ind:treasuryFxRateId rdf:type rdf:Property ;
    rdfs:label 'Treasury Fx Rate Id' ;
    rdfs:comment 'Foreign key linking to treasury.treasury_fx_rate. Business justification: FX forward contracts reference the applicable treasury FX rate for pricing; linking ensures rate consistency.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreasuryFxRate .

ind:bookingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Booking Timestamp' ;
    rdfs:comment 'Date and time when the forward contract was recorded in the treasury management system.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:buyAmount rdf:type rdf:Property ;
    rdfs:label 'Buy Amount' ;
    rdfs:comment 'Notional amount of the currency being purchased, denominated in the buy currency.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyCurrency rdf:type rdf:Property ;
    rdfs:label 'Buy Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the currency being purchased in the forward contract.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:centralCounterpartyName rdf:type rdf:Property ;
    rdfs:label 'Central Counterparty Name' ;
    rdfs:comment 'Name of the central clearing house if the contract is centrally cleared.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardRate rdf:type rdf:Property ;
    rdfs:label 'Forward Rate' ;
    rdfs:comment 'Agreed exchange rate at which the currency pair will be exchanged on the value date, expressed as units of sell currency per unit of buy currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectivenessTestMethod rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Test Method' ;
    rdfs:comment 'Methodology used to assess whether the hedge relationship qualifies for hedge accounting treatment.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mtmValuationDate rdf:type rdf:Property ;
    rdfs:label 'Mtm Valuation Date' ;
    rdfs:comment 'Date as of which the mark-to-market value was last calculated.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sellAmount rdf:type rdf:Property ;
    rdfs:label 'Sell Amount' ;
    rdfs:comment 'Notional amount of the currency being sold, denominated in the sell currency.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellCurrency rdf:type rdf:Property ;
    rdfs:label 'Sell Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the currency being sold in the forward contract.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAccountBuy rdf:type rdf:Property ;
    rdfs:label 'Settlement Account Buy' ;
    rdfs:comment 'Bank account or custody account identifier where the purchased currency will be received upon settlement.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementAccountSell rdf:type rdf:Property ;
    rdfs:label 'Settlement Account Sell' ;
    rdfs:comment 'Bank account or custody account identifier from which the sold currency will be debited upon settlement.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spotRateAtInception rdf:type rdf:Property ;
    rdfs:label 'Spot Rate At Inception' ;
    rdfs:comment 'Market spot exchange rate for the currency pair at the time the forward contract was executed.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeConfirmationDate rdf:type rdf:Property ;
    rdfs:label 'Trade Confirmation Date' ;
    rdfs:comment 'Date on which the trade confirmation was received and validated by both parties.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradingDesk rdf:type rdf:Property ;
    rdfs:label 'Trading Desk' ;
    rdfs:comment 'Internal treasury or trading desk responsible for executing and managing this FX forward contract.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underlyingExposureType rdf:type rdf:Property ;
    rdfs:label 'Underlying Exposure Type' ;
    rdfs:comment 'Nature of the currency exposure being hedged, such as foreign equity investment, private equity commitment, real estate acquisition, or infrastructure asset.' ;
    rdfs:domain ind:FxForward ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uniqueTransactionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Unique Transaction Identifier' ;
    rdfs:comment 'Globally unique identifier for the transaction as required by regulatory reporting frameworks.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxSwapId rdf:type rdf:Property ;
    rdfs:label 'Fx Swap Id' ;
    rdfs:comment 'Unique identifier for the FX swap transaction record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxSwap .

ind:isdaAgreementIsdaMasterId rdf:type rdf:Property ;
    rdfs:label 'Isda Agreement Isda Master Id' ;
    rdfs:comment 'Reference to the master ISDA agreement governing this FX swap transaction, establishing legal terms and credit support arrangements.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IsdaMaster .

ind:csaApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Csa Applicable Flag' ;
    rdfs:comment 'Indicates whether a Credit Support Annex is in place for this swap, governing collateral posting requirements.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:farLegBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Far Leg Base Amount' ;
    rdfs:comment 'Notional amount of the base currency exchanged in the far leg of the swap.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:farLegDate rdf:type rdf:Property ;
    rdfs:label 'Far Leg Date' ;
    rdfs:comment 'Settlement date for the second leg of the FX swap, typically the later of the two exchange dates, reversing the near leg transaction.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:farLegDirection rdf:type rdf:Property ;
    rdfs:label 'Far Leg Direction' ;
    rdfs:comment 'Direction of the base currency transaction in the far leg: opposite of near leg direction to complete the swap structure.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:farLegExchangeRate rdf:type rdf:Property ;
    rdfs:label 'Far Leg Exchange Rate' ;
    rdfs:comment 'The agreed FX rate applied to the far leg transaction, expressed as quote currency per unit of base currency.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:farLegQuoteAmount rdf:type rdf:Property ;
    rdfs:label 'Far Leg Quote Amount' ;
    rdfs:comment 'Notional amount of the quote currency exchanged in the far leg of the swap.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:farLegSettlementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Far Leg Settlement Timestamp' ;
    rdfs:comment 'Actual timestamp when the far leg cash flows were settled through the custody account.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:hedgedItemReference rdf:type rdf:Property ;
    rdfs:label 'Hedged Item Reference' ;
    rdfs:comment 'Business reference to the underlying exposure being hedged (e.g., foreign equity position, private equity commitment, infrastructure asset), linking the swap to its economic purpose.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mtmCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Mtm Currency Code' ;
    rdfs:comment 'The currency in which the mark-to-market value is expressed, typically the funds base currency.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nearLegBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Near Leg Base Amount' ;
    rdfs:comment 'Notional amount of the base currency exchanged in the near leg of the swap.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nearLegDate rdf:type rdf:Property ;
    rdfs:label 'Near Leg Date' ;
    rdfs:comment 'Settlement date for the first leg of the FX swap, typically the earlier of the two exchange dates.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nearLegDirection rdf:type rdf:Property ;
    rdfs:label 'Near Leg Direction' ;
    rdfs:comment 'Direction of the base currency transaction in the near leg: buy indicates purchasing base currency, sell indicates selling base currency.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nearLegExchangeRate rdf:type rdf:Property ;
    rdfs:label 'Near Leg Exchange Rate' ;
    rdfs:comment 'The agreed FX rate applied to the near leg transaction, expressed as quote currency per unit of base currency.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nearLegQuoteAmount rdf:type rdf:Property ;
    rdfs:label 'Near Leg Quote Amount' ;
    rdfs:comment 'Notional amount of the quote currency exchanged in the near leg of the swap.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nearLegSettlementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Near Leg Settlement Timestamp' ;
    rdfs:comment 'Actual timestamp when the near leg cash flows were settled through the custody account.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:quoteCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Quote Currency Code' ;
    rdfs:comment 'The quote currency in the FX swap pair, representing the counter-currency used to price the base currency.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reporting Timestamp' ;
    rdfs:comment 'Timestamp when this FX swap transaction was reported to the trade repository, meeting EMIR T+1 reporting requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:swapPoints rdf:type rdf:Property ;
    rdfs:label 'Swap Points' ;
    rdfs:comment 'The difference between the far leg and near leg exchange rates, representing the interest rate differential between the two currencies over the swap tenor.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:swapReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Swap Reference Number' ;
    rdfs:comment 'External business identifier for the FX swap contract, used for operational reference and reconciliation with counterparties and custody platforms.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swapStatus rdf:type rdf:Property ;
    rdfs:label 'Swap Status' ;
    rdfs:comment 'Current lifecycle status of the FX swap transaction in the trade execution and settlement workflow.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swapType rdf:type rdf:Property ;
    rdfs:label 'Swap Type' ;
    rdfs:comment 'Classification of the FX swap purpose: hedge roll extends existing FX forward hedges, liquidity management addresses short-term currency needs, collateral adjustment manages margin requirements, tactical positioning captures opportunistic currency views.' ;
    rdfs:domain ind:FxSwap ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varLimitId rdf:type rdf:Property ;
    rdfs:label 'Var Limit Id' ;
    rdfs:comment 'Foreign key linking to risk.limit. Business justification: Hedge programs operate within VaR and DV01 risk limits. Business process: Hedge program compliance monitoring requires checking program exposures against approved risk limits for governance and' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Limit .

ind:collateralPostingThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Posting Threshold Amount' ;
    rdfs:comment 'Minimum mark-to-market (MTM) exposure amount that triggers collateral posting under Credit Support Annex (CSA) agreements.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyConcentrationLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Counterparty Concentration Limit Percent' ;
    rdfs:comment 'Maximum percentage of total hedge notional that can be allocated to a single counterparty, enforcing diversification.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectivenessTestFrequency rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Test Frequency' ;
    rdfs:comment 'Frequency at which hedge effectiveness testing is performed for accounting and compliance purposes.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Alignment Flag' ;
    rdfs:comment 'Indicates whether the hedging program incorporates ESG considerations or aligns with responsible investment principles.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedgeAccountingTreatment rdf:type rdf:Property ;
    rdfs:label 'Hedge Accounting Treatment' ;
    rdfs:comment 'Accounting classification under IFRS 9 or equivalent standard for hedge effectiveness and financial reporting.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgedCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Hedged Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code representing the foreign currency exposure being hedged.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastEffectivenessTestDate rdf:type rdf:Property ;
    rdfs:label 'Last Effectiveness Test Date' ;
    rdfs:comment 'Most recent date on which hedge effectiveness testing was performed for accounting compliance.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastEffectivenessTestResult rdf:type rdf:Property ;
    rdfs:label 'Last Effectiveness Test Result' ;
    rdfs:comment 'Outcome of the most recent hedge effectiveness test, determining continued eligibility for hedge accounting treatment.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumHedgeRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Maximum Hedge Ratio Percent' ;
    rdfs:comment 'Upper bound of the permitted hedge ratio band. Triggers rebalancing if actual hedge ratio exceeds this threshold.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumTimeToMaturityDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Time To Maturity Days' ;
    rdfs:comment 'Maximum tenor in days for hedging instruments under this program, limiting long-dated exposure and roll risk.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumHedgeRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Minimum Hedge Ratio Percent' ;
    rdfs:comment 'Lower bound of the permitted hedge ratio band. Triggers rebalancing if actual hedge ratio falls below this threshold.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumTimeToMaturityDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Time To Maturity Days' ;
    rdfs:comment 'Minimum tenor in days for hedging instruments under this program, ensuring alignment with liquidity and funding horizons.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:permittedInstruments rdf:type rdf:Property ;
    rdfs:label 'Permitted Instruments' ;
    rdfs:comment 'Comma-separated list of derivative instruments permitted under this program (e.g., FX forwards, FX swaps, currency options, cross-currency swaps).' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Program Inception Date' ;
    rdfs:comment 'Date on which the hedging program was first established and became operational.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programObjective rdf:type rdf:Property ;
    rdfs:label 'Program Objective' ;
    rdfs:comment 'Strategic objective of the hedging program, such as reducing currency volatility, protecting NAV, or stabilizing cash flows.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Program Reference Code' ;
    rdfs:comment 'Business-facing unique reference code for the hedging program, typically formatted as HP-{CURRENCY}-{YEAR}.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Program Termination Date' ;
    rdfs:comment 'Date on which the hedging program was formally terminated or is scheduled to terminate. Null for active programs.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rebalancingTriggerThresholdBps rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Trigger Threshold Bps' ;
    rdfs:comment 'Deviation threshold in basis points from the target hedge ratio that triggers a rebalancing action.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryReportingRequirement rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Requirement' ;
    rdfs:comment 'Applicable regulatory reporting obligations for this hedging program (e.g., EMIR trade reporting, MiFID II transaction reporting).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskLimitVarAmount rdf:type rdf:Property ;
    rdfs:label 'Risk Limit Var Amount' ;
    rdfs:comment 'Maximum Value at Risk (VaR) permitted for the hedging program, expressed in base currency, as a risk management constraint.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rollStrategy rdf:type rdf:Property ;
    rdfs:label 'Roll Strategy' ;
    rdfs:comment 'Strategy for rolling maturing hedge positions into new contracts to maintain continuous hedge coverage.' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetHedgeRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Target Hedge Ratio Percent' ;
    rdfs:comment 'Strategic target hedge ratio expressed as a percentage of the total foreign currency exposure (e.g., 50.00 means 50% of exposure is hedged).' ;
    rdfs:domain ind:HedgeProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectivenessId rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Id' ;
    rdfs:comment 'Unique identifier for the hedge effectiveness assessment record.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hedgingInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Hedging Instrument Id' ;
    rdfs:comment 'Reference to the derivative or financial instrument used as the hedging instrument in this hedge relationship.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Instrument .

ind:reviewedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewed By User Employee Id' ;
    rdfs:comment 'Reference to the senior treasury or finance user who reviewed the hedge effectiveness assessment.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assessmentMethodologyDescription rdf:type rdf:Property ;
    rdfs:label 'Assessment Methodology Description' ;
    rdfs:comment 'Detailed narrative describing the specific methodology, assumptions, and data sources used to perform the hedge effectiveness assessment.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Period End Date' ;
    rdfs:comment 'The end date of the period covered by this hedge effectiveness assessment.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Period Start Date' ;
    rdfs:comment 'The start date of the period covered by this hedge effectiveness assessment.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Assessment Reference Number' ;
    rdfs:comment 'Business identifier for the hedge effectiveness assessment, used for external reporting and audit trails.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalTermsMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Terms Match Flag' ;
    rdfs:comment 'Indicates whether the critical terms of the hedging instrument and hedged item match, supporting a qualitative assessment of effectiveness.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discontinuationDate rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Date' ;
    rdfs:comment 'The date on which hedge accounting was discontinued for this hedge relationship, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:discontinuationFlag rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Flag' ;
    rdfs:comment 'Indicates whether hedge accounting has been discontinued for this hedge relationship.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discontinuationReason rdf:type rdf:Property ;
    rdfs:label 'Discontinuation Reason' ;
    rdfs:comment 'Business explanation for why hedge accounting was discontinued, such as failure to meet effectiveness criteria or hedge objective no longer valid.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dollarOffsetRatio rdf:type rdf:Property ;
    rdfs:label 'Dollar Offset Ratio' ;
    rdfs:comment 'The ratio of cumulative change in fair value of the hedging instrument to cumulative change in fair value of the hedged item, used in dollar-offset method.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectivenessRatio rdf:type rdf:Property ;
    rdfs:label 'Effectiveness Ratio' ;
    rdfs:comment 'Quantitative ratio measuring the degree of offset between changes in fair value or cash flows of the hedging instrument and the hedged item, typically expressed as a percentage.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalAuditorReviewedFlag rdf:type rdf:Property ;
    rdfs:label 'External Auditor Reviewed Flag' ;
    rdfs:comment 'Indicates whether this hedge effectiveness assessment has been reviewed by external auditors as part of financial statement audit.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hedgeAccountingModel rdf:type rdf:Property ;
    rdfs:label 'Hedge Accounting Model' ;
    rdfs:comment 'The type of hedge accounting model applied under IFRS 9: fair value hedge, cash flow hedge, or net investment hedge.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeRelationshipDesignationDate rdf:type rdf:Property ;
    rdfs:label 'Hedge Relationship Designation Date' ;
    rdfs:comment 'The date on which the hedge relationship was formally designated for hedge accounting purposes.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hedgedItemFairValueChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Hedged Item Fair Value Change Amount' ;
    rdfs:comment 'The change in fair value of the hedged item during the assessment period, used to calculate effectiveness.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgedItemType rdf:type rdf:Property ;
    rdfs:label 'Hedged Item Type' ;
    rdfs:comment 'Classification of the risk exposure being hedged in this hedge relationship.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgingInstrumentFairValueChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Hedging Instrument Fair Value Change Amount' ;
    rdfs:comment 'The change in fair value of the hedging instrument during the assessment period, used to calculate effectiveness.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ineffectivenessAmount rdf:type rdf:Property ;
    rdfs:label 'Ineffectiveness Amount' ;
    rdfs:comment 'The portion of the hedge that is deemed ineffective and must be recognized immediately in profit or loss under IFRS 9.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextAssessmentDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Assessment Due Date' ;
    rdfs:comment 'The scheduled date for the next periodic hedge effectiveness assessment, typically quarterly or as required by policy.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:prospectiveEffectivenessResult rdf:type rdf:Property ;
    rdfs:label 'Prospective Effectiveness Result' ;
    rdfs:comment 'Outcome of the prospective hedge effectiveness test indicating whether the hedge is expected to be highly effective.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:prospectiveTestMethod rdf:type rdf:Property ;
    rdfs:label 'Prospective Test Method' ;
    rdfs:comment 'The quantitative or qualitative method used to assess prospective hedge effectiveness.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regressionRSquared rdf:type rdf:Property ;
    rdfs:label 'Regression R Squared' ;
    rdfs:comment 'The coefficient of determination from regression analysis, measuring the proportion of variance in the hedged item explained by the hedging instrument.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regressionSlope rdf:type rdf:Property ;
    rdfs:label 'Regression Slope' ;
    rdfs:comment 'The slope coefficient from regression analysis, indicating the sensitivity of the hedged item to changes in the hedging instrument.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retrospectiveEffectivenessResult rdf:type rdf:Property ;
    rdfs:label 'Retrospective Effectiveness Result' ;
    rdfs:comment 'Outcome of the retrospective hedge effectiveness test indicating whether the hedge was highly effective during the assessment period.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retrospectiveTestMethod rdf:type rdf:Property ;
    rdfs:label 'Retrospective Test Method' ;
    rdfs:comment 'The quantitative or qualitative method used to assess retrospective hedge effectiveness.' ;
    rdfs:domain ind:HedgeEffectiveness ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortTermInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Short Term Instrument Id' ;
    rdfs:comment 'Unique identifier for the short-term liquidity instrument record.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ShortTermInstrument .

ind:approvalUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approval User Employee Id' ;
    rdfs:comment 'Identifier of the user who approved the investment in the short-term instrument.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:benchmarkRateType rdf:type rdf:Property ;
    rdfs:label 'Benchmark Rate Type' ;
    rdfs:comment 'Reference rate or benchmark to which the instrument yield is linked, such as SOFR or fixed rate.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponRatePercent rdf:type rdf:Property ;
    rdfs:label 'Coupon Rate Percent' ;
    rdfs:comment 'Annual interest rate paid by the instrument, expressed as a percentage of face value.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentMarketValueAmount rdf:type rdf:Property ;
    rdfs:label 'Current Market Value Amount' ;
    rdfs:comment 'Current mark-to-market valuation of the instrument based on latest pricing.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:daysToMaturity rdf:type rdf:Property ;
    rdfs:label 'Days To Maturity' ;
    rdfs:comment 'Number of calendar days remaining until the instrument reaches maturity.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Compliant Flag' ;
    rdfs:comment 'Indicates whether the instrument meets the pension fund ESG investment criteria and responsible investment standards.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:faceValueAmount rdf:type rdf:Property ;
    rdfs:label 'Face Value Amount' ;
    rdfs:comment 'Par or face value of the instrument that will be repaid at maturity.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instrumentCreditRating rdf:type rdf:Property ;
    rdfs:label 'Instrument Credit Rating' ;
    rdfs:comment 'Specific credit rating assigned to this instrument issuance by rating agencies.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Instrument Reference Number' ;
    rdfs:comment 'External business identifier or reference number assigned to the short-term instrument by the treasury system or custodian.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentStatus rdf:type rdf:Property ;
    rdfs:label 'Instrument Status' ;
    rdfs:comment 'Current lifecycle status of the short-term instrument position.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerCreditRating rdf:type rdf:Property ;
    rdfs:label 'Issuer Credit Rating' ;
    rdfs:comment 'Credit rating assigned to the issuer by major rating agencies, indicating creditworthiness.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseDate rdf:type rdf:Property ;
    rdfs:label 'Purchase Date' ;
    rdfs:comment 'Date on which the short-term instrument was acquired by the treasury portfolio.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:purchasePriceAmount rdf:type rdf:Property ;
    rdfs:label 'Purchase Price Amount' ;
    rdfs:comment 'Total amount paid to acquire the instrument, including any premium or discount.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spreadOverBenchmarkBps rdf:type rdf:Property ;
    rdfs:label 'Spread Over Benchmark Bps' ;
    rdfs:comment 'Additional yield spread over the benchmark rate, expressed in basis points.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unrealizedGainLossAmount rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss Amount' ;
    rdfs:comment 'Difference between current market value and purchase price, representing unrealized profit or loss.' ;
    rdfs:domain ind:ShortTermInstrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldToMaturityPercent rdf:type rdf:Property ;
    rdfs:label 'Yield To Maturity Percent' ;
    rdfs:comment 'Annualized rate of return if the instrument is held to maturity, accounting for purchase price and coupon payments.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stInstrumentTransactionId rdf:type rdf:Property ;
    rdfs:label 'St Instrument Transaction Id' ;
    rdfs:comment 'Unique identifier for the short-term instrument transaction record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StInstrumentTransaction .

ind:considerationAmount rdf:type rdf:Property ;
    rdfs:label 'Consideration Amount' ;
    rdfs:comment 'Total cash amount paid or received for the transaction, excluding fees and accrued interest.' ;
    rdfs:domain ind:StInstrumentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalTransactionReference rdf:type rdf:Property ;
    rdfs:label 'External Transaction Reference' ;
    rdfs:comment 'Transaction identifier assigned by the external counterparty, broker, or custodian system for reconciliation purposes.' ;
    rdfs:domain ind:StInstrumentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementLocation rdf:type rdf:Property ;
    rdfs:label 'Settlement Location' ;
    rdfs:comment 'Name of the central securities depository or settlement system where the transaction settles.' ;
    rdfs:domain ind:StInstrumentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Amount' ;
    rdfs:comment 'Fees charged by brokers, custodians, or intermediaries for executing and settling the transaction.' ;
    rdfs:domain ind:StInstrumentTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:destinationAccountCashAccountId rdf:type rdf:Property ;
    rdfs:label 'Destination Account Cash Account Id' ;
    rdfs:comment 'Identifier of the cash account to which funds are being transferred.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:destinationCustodianId rdf:type rdf:Property ;
    rdfs:label 'Destination Custodian Id' ;
    rdfs:comment 'Identifier of the custodian or banking institution holding the destination account.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Custodian .

ind:distributionReceiptId rdf:type rdf:Property ;
    rdfs:label 'Distribution Receipt Id' ;
    rdfs:comment 'Foreign key linking to treasury.distribution_receipt. Business justification: Cash transfers receiving distributions should link to the distribution_receipt record.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionReceipt .

ind:initiatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Initiated By User Employee Id' ;
    rdfs:comment 'Identifier of the treasury user who initiated the cash transfer request.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:marginCallId rdf:type rdf:Property ;
    rdfs:label 'Margin Call Id' ;
    rdfs:comment 'Foreign key linking to collateral.margin_call. Business justification: Cash transfers are initiated to satisfy margin calls under CSA agreements. Direct linkage enables audit trail from margin call to funding execution, essential for collateral operations' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarginCall .

ind:primaryCashAccountId rdf:type rdf:Property ;
    rdfs:label 'Primary Cash Account Id' ;
    rdfs:comment 'Identifier of the cash account from which funds are being transferred.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:relatedFxHedgeHedgeProgramId rdf:type rdf:Property ;
    rdfs:label 'Related Fx Hedge Hedge Program Id' ;
    rdfs:comment 'Identifier of the FX forward or swap position being settled through this cash transfer.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HedgeProgram .

ind:relatedTradeBlotterId rdf:type rdf:Property ;
    rdfs:label 'Related Trade Blotter Id' ;
    rdfs:comment 'Identifier of the trade execution that requires this cash transfer for settlement purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Blotter .

ind:reversedTransferCashTransferId rdf:type rdf:Property ;
    rdfs:label 'Reversed Transfer Cash Transfer Id' ;
    rdfs:comment 'Identifier of the original cash transfer that this transfer reverses.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashTransfer .

ind:sourceCustodianId rdf:type rdf:Property ;
    rdfs:label 'Source Custodian Id' ;
    rdfs:comment 'Identifier of the custodian or banking institution holding the source account.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Custodian .

ind:destinationAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Destination Account Number' ;
    rdfs:comment 'External account number of the destination cash account as maintained by the custodian or banking institution.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:destinationCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Destination Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code of the destination account for FX transfers.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initiationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Initiation Timestamp' ;
    rdfs:comment 'Date and time when the cash transfer was initiated by treasury operations.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:intermediaryBankBic rdf:type rdf:Property ;
    rdfs:label 'Intermediary Bank Bic' ;
    rdfs:comment 'SWIFT Bank Identifier Code of any intermediary bank involved in routing the transfer.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryBankName rdf:type rdf:Property ;
    rdfs:label 'Intermediary Bank Name' ;
    rdfs:comment 'Name of the intermediary bank used for routing the transfer between source and destination institutions.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netTransferAmount rdf:type rdf:Property ;
    rdfs:label 'Net Transfer Amount' ;
    rdfs:comment 'Net monetary amount transferred after deducting all fees and adjustments.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:purposeDescription rdf:type rdf:Property ;
    rdfs:label 'Purpose Description' ;
    rdfs:comment 'Detailed business purpose or reason for the cash transfer, such as capital call funding for Fund XYZ or distribution receipt from ABC Investment.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceInformation rdf:type rdf:Property ;
    rdfs:label 'Remittance Information' ;
    rdfs:comment 'Unstructured payment reference information provided to the beneficiary for reconciliation purposes.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Confirmation Number' ;
    rdfs:comment 'Confirmation reference number provided by the custodian or banking institution upon successful settlement.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Source Account Number' ;
    rdfs:comment 'External account number of the source cash account as maintained by the custodian or banking institution.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Source Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code of the source account for FX transfers.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Transfer Currency Code' ;
    rdfs:comment 'Three-letter ISO currency code of the transfer amount (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transfer Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this cash transfer for tracking and reconciliation purposes.' ;
    rdfs:domain ind:CashTransfer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashReconciliationId rdf:type rdf:Property ;
    rdfs:label 'Cash Reconciliation Id' ;
    rdfs:comment 'Unique identifier for the cash reconciliation record.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoReconciledFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Reconciled Flag' ;
    rdfs:comment 'Indicates whether the reconciliation was automatically matched by system rules without manual intervention.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closingBalanceVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Closing Balance Variance Amount' ;
    rdfs:comment 'Difference between IBOR and custodian closing balances (IBOR minus custodian).' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianClosingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Custodian Closing Balance Amount' ;
    rdfs:comment 'Closing cash balance reported by custodian (State Street or Northern Trust) at end of reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianFileReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Custodian File Received Timestamp' ;
    rdfs:comment 'Timestamp when custodian cash position file was received and loaded into reconciliation system.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:custodianOpeningBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Custodian Opening Balance Amount' ;
    rdfs:comment 'Opening cash balance reported by custodian (State Street or Northern Trust) at start of reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianStatementDate rdf:type rdf:Property ;
    rdfs:label 'Custodian Statement Date' ;
    rdfs:comment 'Date of the custodian statement used for reconciliation, may differ from reconciliation date due to reporting lag.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:custodianStatementReference rdf:type rdf:Property ;
    rdfs:label 'Custodian Statement Reference' ;
    rdfs:comment 'Custodian-provided statement or report reference number used as source for custodian balances.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Custodian Transaction Count' ;
    rdfs:comment 'Number of cash transactions reported by custodian for the reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Difference Amount' ;
    rdfs:comment 'Variance attributed to custody fees, transaction fees, or other charges recorded differently.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxRevaluationDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Fx Revaluation Difference Amount' ;
    rdfs:comment 'Variance attributed to foreign exchange revaluation methodology differences between IBOR and custodian.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:iborClosingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ibor Closing Balance Amount' ;
    rdfs:comment 'Closing cash balance from internal IBOR system (SimCorp Dimension) at end of reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:iborExtractTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ibor Extract Timestamp' ;
    rdfs:comment 'Timestamp when IBOR cash position data was extracted from SimCorp Dimension for reconciliation.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:iborOpeningBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Ibor Opening Balance Amount' ;
    rdfs:comment 'Opening cash balance from internal IBOR system (SimCorp Dimension) at start of reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:iborTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Ibor Transaction Count' ;
    rdfs:comment 'Number of cash transactions recorded in IBOR system for the reconciliation date.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestAccrualDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Accrual Difference Amount' ;
    rdfs:comment 'Variance attributed to interest accrual calculation differences between IBOR and custodian.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:manualAdjustmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Adjustment Required Flag' ;
    rdfs:comment 'Indicates whether manual journal entries or adjustments are required to resolve the variance.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:matchedTransactionAmount rdf:type rdf:Property ;
    rdfs:label 'Matched Transaction Amount' ;
    rdfs:comment 'Total value of successfully matched transactions between IBOR and custodian.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:matchedTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Matched Transaction Count' ;
    rdfs:comment 'Number of transactions successfully matched between IBOR and custodian records.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:openingBalanceVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Opening Balance Variance Amount' ;
    rdfs:comment 'Difference between IBOR and custodian opening balances (IBOR minus custodian).' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Reference Number' ;
    rdfs:comment 'Business identifier for the reconciliation record, typically system-generated or custodian-provided reference.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reconciliationRunTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Run Timestamp' ;
    rdfs:comment 'Timestamp when the automated reconciliation matching process was executed.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reconciliationType rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Type' ;
    rdfs:comment 'Classification of the reconciliation by frequency and business purpose.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Settlement Difference Amount' ;
    rdfs:comment 'Variance attributed to settlement timing or DVP processing differences.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timingDifferenceAmount rdf:type rdf:Property ;
    rdfs:label 'Timing Difference Amount' ;
    rdfs:comment 'Variance attributed to timing differences in transaction recording between IBOR and custodian systems.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tolerance Threshold Amount' ;
    rdfs:comment 'Maximum acceptable variance amount before escalation is required, defined by treasury policy.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceThresholdBps rdf:type rdf:Property ;
    rdfs:label 'Tolerance Threshold Bps' ;
    rdfs:comment 'Maximum acceptable variance in basis points relative to account balance before escalation is required.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unexplainedVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Unexplained Variance Amount' ;
    rdfs:comment 'Remaining variance after all identified reconciling items have been accounted for.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unmatchedCustodianTransactionAmount rdf:type rdf:Property ;
    rdfs:label 'Unmatched Custodian Transaction Amount' ;
    rdfs:comment 'Total value of custodian transactions with no corresponding IBOR record.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unmatchedCustodianTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Unmatched Custodian Transaction Count' ;
    rdfs:comment 'Number of custodian transactions with no corresponding IBOR record.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unmatchedIborTransactionAmount rdf:type rdf:Property ;
    rdfs:label 'Unmatched Ibor Transaction Amount' ;
    rdfs:comment 'Total value of IBOR transactions with no corresponding custodian record.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unmatchedIborTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Unmatched Ibor Transaction Count' ;
    rdfs:comment 'Number of IBOR transactions with no corresponding custodian record.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:withinToleranceFlag rdf:type rdf:Property ;
    rdfs:label 'Within Tolerance Flag' ;
    rdfs:comment 'Indicates whether the reconciliation variance is within acceptable tolerance thresholds.' ;
    rdfs:domain ind:CashReconciliation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByRateTreasuryFxRateId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rate Treasury Fx Rate Id' ;
    rdfs:comment 'Reference to the treasury FX rate record that supersedes this rate, enabling navigation through rate history and audit trail of rate changes.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreasuryFxRate .

ind:crossRateFlag rdf:type rdf:Property ;
    rdfs:label 'Cross Rate Flag' ;
    rdfs:comment 'Boolean flag indicating whether this rate is a cross rate calculated from two USD pairs rather than a directly quoted market rate (e.g., EUR/JPY derived from EUR/USD and USD/JPY).' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective End Timestamp' ;
    rdfs:comment 'Timestamp until which this FX rate remains effective, after which it is superseded by a newer rate. Null for currently active rates, supporting temporal validity and rate history.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:effectiveStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Start Timestamp' ;
    rdfs:comment 'Timestamp from which this FX rate becomes effective for valuation and hedge accounting purposes, supporting temporal validity and historical rate reconstruction.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:fixingTime rdf:type rdf:Property ;
    rdfs:label 'Fixing Time' ;
    rdfs:comment 'The standard market fixing time for this rate (e.g., 4:00 PM London, 10:00 AM New York), used for benchmark rate determination and hedge accounting compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:forwardPoints1m rdf:type rdf:Property ;
    rdfs:label 'Forward Points 1m' ;
    rdfs:comment 'Forward points for one-month tenor, used to calculate the one-month forward FX rate for hedging monthly cash flows, capital calls, and distributions.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardPoints1w rdf:type rdf:Property ;
    rdfs:label 'Forward Points 1w' ;
    rdfs:comment 'Forward points for one-week tenor, representing the interest rate differential between the two currencies. Added to spot rate to derive the one-week forward rate for hedging short-term FX exposure.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardPoints1y rdf:type rdf:Property ;
    rdfs:label 'Forward Points 1y' ;
    rdfs:comment 'Forward points for one-year tenor, used to calculate the one-year forward FX rate for hedging annual exposures and long-term strategic currency hedges.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardPoints3m rdf:type rdf:Property ;
    rdfs:label 'Forward Points 3m' ;
    rdfs:comment 'Forward points for three-month tenor, used to calculate the three-month forward FX rate for hedging quarterly exposures and medium-term currency risk.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardPoints6m rdf:type rdf:Property ;
    rdfs:label 'Forward Points 6m' ;
    rdfs:comment 'Forward points for six-month tenor, used to calculate the six-month forward FX rate for hedging semi-annual exposures and medium-term currency positions.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inversionFlag rdf:type rdf:Property ;
    rdfs:label 'Inversion Flag' ;
    rdfs:comment 'Boolean flag indicating whether this rate has been inverted from the source systems native quotation to match internal portfolio reporting convention (e.g., converting EUR/USD to USD/EUR).' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketConvention rdf:type rdf:Property ;
    rdfs:label 'Market Convention' ;
    rdfs:comment 'Indicates whether the rate follows direct quotation (domestic currency per unit of foreign currency) or indirect quotation (foreign currency per unit of domestic currency) convention.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateQualityFlag rdf:type rdf:Property ;
    rdfs:label 'Rate Quality Flag' ;
    rdfs:comment 'Data quality indicator for the FX rate: verified for confirmed rates, unverified for preliminary rates, estimated for interpolated or calculated rates, or stale for rates exceeding freshness threshold.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rateReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Rate Reference Code' ;
    rdfs:comment 'Unique business identifier for this FX rate observation, typically combining currency pair, rate date, and source identifier for external reference and reconciliation.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateSourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Rate Source Identifier' ;
    rdfs:comment 'The unique identifier or ticker symbol used by the source system to reference this FX rate (e.g., Bloomberg ticker USDCAD Curncy), enabling traceability and reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateTimestamp rdf:type rdf:Property ;
    rdfs:label 'Rate Timestamp' ;
    rdfs:comment 'Precise timestamp when the FX rate was observed or published by the source system, including time zone information for intraday rate tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:spotAskRate rdf:type rdf:Property ;
    rdfs:label 'Spot Ask Rate' ;
    rdfs:comment 'The ask (offer) side of the spot FX rate, representing the rate at which the market maker will sell the base currency. Used for bid-ask spread analysis and transaction cost estimation.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spotBidRate rdf:type rdf:Property ;
    rdfs:label 'Spot Bid Rate' ;
    rdfs:comment 'The bid side of the spot FX rate, representing the rate at which the market maker will buy the base currency. Used for bid-ask spread analysis and transaction cost estimation.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spotMidRate rdf:type rdf:Property ;
    rdfs:label 'Spot Mid Rate' ;
    rdfs:comment 'The mid-point between bid and ask spot rates, calculated as the average of bid and ask. Commonly used for portfolio valuation and performance reporting.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triangulationMethod rdf:type rdf:Property ;
    rdfs:label 'Triangulation Method' ;
    rdfs:comment 'Description of the calculation method used for cross rates, specifying the intermediate currency pairs and mathematical operations applied to derive the rate.' ;
    rdfs:domain ind:TreasuryFxRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageContext rdf:type rdf:Property ;
    rdfs:label 'Usage Context' ;
    rdfs:comment 'Description of the intended usage context for this rate (e.g., portfolio valuation, hedge accounting, settlement, performance reporting), supporting appropriate rate selection for different business processes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volatility30d rdf:type rdf:Property ;
    rdfs:label 'Volatility 30d' ;
    rdfs:comment 'Thirty-day historical volatility of the currency pair expressed as an annualized percentage, used for risk assessment, VaR calculations, and option pricing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyLimitId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Limit Id' ;
    rdfs:comment 'Unique identifier for the treasury counterparty credit limit record.' ;
    rdfs:domain ind:Treasury ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CounterpartyLimit .

ind:riskLimitId rdf:type rdf:Property ;
    rdfs:label 'Risk Limit Id' ;
    rdfs:comment 'Foreign key linking to risk.limit. Business justification: Treasury counterparty limits must align with enterprise risk limit framework. Business process: Integrated limit monitoring ensures treasury limits are consistent with board-approved risk appetite' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Limit .

ind:availableAmount rdf:type rdf:Property ;
    rdfs:label 'Available Amount' ;
    rdfs:comment 'Remaining available limit capacity, calculated as limit amount minus utilized amount.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachAction rdf:type rdf:Property ;
    rdfs:label 'Breach Action' ;
    rdfs:comment 'Automated action to be taken when the limit is breached: block new trades, alert only, require approval for new trades, or reduce exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Required Flag' ;
    rdfs:comment 'Indicates whether collateral posting is required under a Credit Support Annex (CSA) for transactions under this limit.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concentrationLimitFlag rdf:type rdf:Property ;
    rdfs:label 'Concentration Limit Flag' ;
    rdfs:comment 'Indicates whether this limit is subject to additional concentration risk controls due to the counterparty\'s systemic importance.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentScope rdf:type rdf:Property ;
    rdfs:label 'Instrument Scope' ;
    rdfs:comment 'The treasury instrument types covered by this limit: FX forwards, FX swaps, FX spot, repo, reverse repo, money market instruments, or all instruments. [ENUM-REF-CANDIDATE: fx_forward|fx_swap|fx_spot|repo|reverse_repo|money_market|all_instruments — 7' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalRiskClassification rdf:type rdf:Property ;
    rdfs:label 'Internal Risk Classification' ;
    rdfs:comment 'Internal risk classification assigned to the counterparty based on credit quality, systemic importance, and concentration risk.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitAmount rdf:type rdf:Property ;
    rdfs:label 'Limit Amount' ;
    rdfs:comment 'Maximum permissible exposure amount to the counterparty, expressed in the limit currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:limitCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Limit Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the limit amount is denominated.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Limit Reference Number' ;
    rdfs:comment 'Business identifier for the counterparty limit record, used for external communication and audit trails.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRatingThreshold rdf:type rdf:Property ;
    rdfs:label 'Minimum Rating Threshold' ;
    rdfs:comment 'Minimum acceptable credit rating for the counterparty; limit is suspended if rating falls below this threshold.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdBreachPercentage rdf:type rdf:Property ;
    rdfs:label 'Threshold Breach Percentage' ;
    rdfs:comment 'Utilization percentage threshold at which a breach alert is triggered and new transactions may be blocked.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdWarningPercentage rdf:type rdf:Property ;
    rdfs:label 'Threshold Warning Percentage' ;
    rdfs:comment 'Utilization percentage threshold at which a warning alert is triggered to treasury management.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilizedAmount rdf:type rdf:Property ;
    rdfs:label 'Utilized Amount' ;
    rdfs:comment 'Current exposure amount utilized against the limit, calculated from outstanding positions and pending settlements.' ;
    rdfs:domain ind:CounterpartyLimit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:treasuryCounterpartyExposureId rdf:type rdf:Property ;
    rdfs:label 'Treasury Counterparty Exposure Id' ;
    rdfs:comment 'Unique identifier for the treasury counterparty exposure record.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditValuationAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Valuation Adjustment Amount' ;
    rdfs:comment 'Adjustment to the fair value of derivative positions to account for counterparty credit risk.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:csaAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Csa Agreement Flag' ;
    rdfs:comment 'Indicates whether a Credit Support Annex is in place with this counterparty for collateral management.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:csaMinimumTransferAmount rdf:type rdf:Property ;
    rdfs:label 'Csa Minimum Transfer Amount' ;
    rdfs:comment 'Minimum amount of collateral that must be transferred in a single movement under the CSA.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Exposure Limit Amount' ;
    rdfs:comment 'Maximum approved credit exposure limit for this counterparty as set by the Investment Committee or risk policy.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxForwardCount rdf:type rdf:Property ;
    rdfs:label 'Fx Forward Count' ;
    rdfs:comment 'Number of outstanding FX forward contracts with this counterparty.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxSwapCount rdf:type rdf:Property ;
    rdfs:label 'Fx Swap Count' ;
    rdfs:comment 'Number of outstanding FX swap contracts with this counterparty.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:grossMtmExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Mtm Exposure Amount' ;
    rdfs:comment 'Total mark-to-market value of all positions with the counterparty before netting and collateral adjustments.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossNotionalAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Notional Amount' ;
    rdfs:comment 'Total notional value of all outstanding positions with the counterparty before netting.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastCollateralCallDate rdf:type rdf:Property ;
    rdfs:label 'Last Collateral Call Date' ;
    rdfs:comment 'Date of the most recent collateral call or margin call with this counterparty.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netCreditExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Net Credit Exposure Amount' ;
    rdfs:comment 'Final net credit exposure after netting and collateral adjustments, representing true counterparty credit risk.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netMtmExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Net Mtm Exposure Amount' ;
    rdfs:comment 'Net mark-to-market exposure after applying bilateral netting but before collateral adjustments.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextCollateralReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Collateral Review Date' ;
    rdfs:comment 'Scheduled date for the next collateral position review with this counterparty.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:potentialFutureExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Potential Future Exposure Amount' ;
    rdfs:comment 'Estimated maximum exposure that could arise in the future due to market movements, calculated using risk models.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryCapitalChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Regulatory Capital Charge Amount' ;
    rdfs:comment 'Regulatory capital requirement associated with this counterparty exposure under Basel III or local prudential rules.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Risk Weight Percentage' ;
    rdfs:comment 'Basel III risk weight applied to this counterparty exposure for regulatory capital calculation.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Settlement Risk Flag' ;
    rdfs:comment 'Indicates whether settlement risk exists due to non-delivery-versus-payment settlement arrangements.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:shortTermInstrumentCount rdf:type rdf:Property ;
    rdfs:label 'Short Term Instrument Count' ;
    rdfs:comment 'Number of outstanding short-term liquidity instruments with this counterparty.' ;
    rdfs:domain ind:TreasuryCounterpartyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundedStatusId rdf:type rdf:Property ;
    rdfs:label 'Funded Status Id' ;
    rdfs:comment 'Foreign key linking to actuarial.funded_status. Business justification: Liquidity reserve requirements vary based on plan funded status - underfunded plans require larger buffers for potential special contributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundedStatus .

ind:supersededByPolicyLiquidityReservePolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Policy Liquidity Reserve Policy Id' ;
    rdfs:comment 'Identifier of the liquidity reserve policy that supersedes this policy; nullable if current.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiquidityReservePolicy .

ind:capitalCallReservePercentage rdf:type rdf:Property ;
    rdfs:label 'Capital Call Reserve Percentage' ;
    rdfs:comment 'Percentage of unfunded capital commitments to be held as liquidity reserve for capital call funding.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralBufferPercentage rdf:type rdf:Property ;
    rdfs:label 'Collateral Buffer Percentage' ;
    rdfs:comment 'Percentage buffer for collateral posting requirements under derivative and repo agreements.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionReservePercentage rdf:type rdf:Property ;
    rdfs:label 'Distribution Reserve Percentage' ;
    rdfs:comment 'Percentage of expected beneficiary distributions to be held as liquidity reserve.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleInstrumentTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Instrument Types' ;
    rdfs:comment 'Comma-separated list of eligible short-term liquidity instrument types under this policy. [ENUM-REF-CANDIDATE: t_bills|sofr_linked|commercial_paper|repo|money_market_funds|bank_deposits|government_bonds — promote to reference product]' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Amount' ;
    rdfs:comment 'Absolute liquidity shortfall amount that triggers escalation to senior management or Investment Committee (IC).' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxHedgeSettlementReserveDays rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Settlement Reserve Days' ;
    rdfs:comment 'Number of days of FX hedge settlement exposure to be covered by liquidity reserves.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:liquidityTierClassification rdf:type rdf:Property ;
    rdfs:label 'Liquidity Tier Classification' ;
    rdfs:comment 'Classification of liquidity assets into tiers based on quality and convertibility to cash.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumCashBufferAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Cash Buffer Amount' ;
    rdfs:comment 'Minimum absolute cash reserve amount required to be maintained under this policy.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCashBufferPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Cash Buffer Percentage' ;
    rdfs:comment 'Minimum cash reserve expressed as a percentage of Assets Under Management (AUM) or net contributions.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumLiquidityCoverageRatio rdf:type rdf:Property ;
    rdfs:label 'Minimum Liquidity Coverage Ratio' ;
    rdfs:comment 'Minimum acceptable liquidity coverage ratio below which escalation procedures are triggered.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netStableFundingRatioTarget rdf:type rdf:Property ;
    rdfs:label 'Net Stable Funding Ratio Target' ;
    rdfs:comment 'Target ratio of available stable funding to required stable funding over a one-year horizon.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyDocumentUri rdf:type rdf:Property ;
    rdfs:label 'Policy Document Uri' ;
    rdfs:comment 'URI or file path to the formal policy document for this liquidity reserve policy.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Reference Number' ;
    rdfs:comment 'Externally-known unique reference number for the liquidity reserve policy.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalancingTriggerThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Trigger Threshold Percentage' ;
    rdfs:comment 'Percentage deviation from target liquidity levels that triggers rebalancing action.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortTermInstrumentMaturityLimitDays rdf:type rdf:Property ;
    rdfs:label 'Short Term Instrument Maturity Limit Days' ;
    rdfs:comment 'Maximum maturity in days for short-term liquidity instruments eligible under this policy.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stressLiquidityThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Stress Liquidity Threshold Amount' ;
    rdfs:comment 'Minimum cash reserve required under stress scenario conditions.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressScenarioType rdf:type rdf:Property ;
    rdfs:label 'Stress Scenario Type' ;
    rdfs:comment 'Type of stress scenario for which the stress liquidity threshold is calibrated.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetLiquidityCoverageRatio rdf:type rdf:Property ;
    rdfs:label 'Target Liquidity Coverage Ratio' ;
    rdfs:comment 'Target ratio of high-quality liquid assets to net cash outflows over a 30-day stress period.' ;
    rdfs:domain ind:LiquidityReservePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualFlag rdf:type rdf:Property ;
    rdfs:label 'Actual Flag' ;
    rdfs:comment 'Boolean indicator of whether this cash flow event has actually occurred and settled, versus being a forecast or expectation.' ;
    rdfs:domain ind:CashFlowEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:beneficiaryAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Address Line1' ;
    rdfs:comment 'First line of the beneficiary or account holder address for settlement documentation.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Address Line2' ;
    rdfs:comment 'Second line of the beneficiary or account holder address for settlement documentation.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryCity rdf:type rdf:Property ;
    rdfs:label 'Beneficiary City' ;
    rdfs:comment 'City of the beneficiary or account holder address.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryCountryCode rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Country Code' ;
    rdfs:comment 'Three-letter ISO country code of the beneficiary or account holder address.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryPostalCode rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the beneficiary or account holder address.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryStateProvince rdf:type rdf:Property ;
    rdfs:label 'Beneficiary State Province' ;
    rdfs:comment 'State or province of the beneficiary or account holder address.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultSsiFlag rdf:type rdf:Property ;
    rdfs:label 'Default Ssi Flag' ;
    rdfs:comment 'Indicates whether this SSI is the default instruction for the given custodian, currency, and asset class combination.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Last Verified Date' ;
    rdfs:comment 'Date when this SSI was last verified or confirmed with the custodian or counterparty for accuracy and operational readiness.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextVerificationDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Verification Due Date' ;
    rdfs:comment 'Date by which the next verification of this SSI record must be completed.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:safekeepingAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Safekeeping Account Flag' ;
    rdfs:comment 'Indicates whether this account is used for safekeeping of securities versus cash settlement only.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ssiReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Ssi Reference Number' ;
    rdfs:comment 'Unique business reference number for this SSI record, used for operational identification and communication.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiType rdf:type rdf:Property ;
    rdfs:label 'Ssi Type' ;
    rdfs:comment 'Classification of the SSI record by its operational purpose.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Verification Frequency Days' ;
    rdfs:comment 'Number of days between required verifications of this SSI record to ensure ongoing accuracy and compliance.' ;
    rdfs:domain ind:BankAccountSsi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxHedgeRebalanceId rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Rebalance Id' ;
    rdfs:comment 'Unique identifier for the FX hedge rebalancing event.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Executed By User Employee Id' ;
    rdfs:comment 'Reference to the treasury user who executed the rebalancing trades in the market.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualHedgeRatioAfter rdf:type rdf:Property ;
    rdfs:label 'Actual Hedge Ratio After' ;
    rdfs:comment 'Actual hedge ratio achieved after the rebalancing execution, expressed as a decimal proportion.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualHedgeRatioBefore rdf:type rdf:Property ;
    rdfs:label 'Actual Hedge Ratio Before' ;
    rdfs:comment 'Actual hedge ratio calculated immediately before the rebalancing event, expressed as a decimal proportion.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralImpactBase rdf:type rdf:Property ;
    rdfs:label 'Collateral Impact Base' ;
    rdfs:comment 'Net change in collateral posted or received as a result of the rebalancing, expressed in base currency.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionRate rdf:type rdf:Property ;
    rdfs:label 'Execution Rate' ;
    rdfs:comment 'Weighted average exchange rate at which the rebalancing trades were executed.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:existingHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'Existing Hedge Notional Base' ;
    rdfs:comment 'Total notional value of existing hedge instruments in base currency before rebalancing.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureAmountBase rdf:type rdf:Property ;
    rdfs:label 'Exposure Amount Base' ;
    rdfs:comment 'Total currency exposure in base currency terms at the time of rebalancing trigger.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lowerThresholdBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Lower Threshold Breach Flag' ;
    rdfs:comment 'Indicates whether the rebalancing was triggered by the hedge ratio falling below the lower permitted band.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mtmImpactBase rdf:type rdf:Property ;
    rdfs:label 'Mtm Impact Base' ;
    rdfs:comment 'Immediate mark-to-market profit or loss impact from the rebalancing trades, expressed in base currency.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newHedgeNotionalBase rdf:type rdf:Property ;
    rdfs:label 'New Hedge Notional Base' ;
    rdfs:comment 'Total notional value of hedge instruments after rebalancing execution, expressed in base currency.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalanceActionType rdf:type rdf:Property ;
    rdfs:label 'Rebalance Action Type' ;
    rdfs:comment 'Classification of the hedging action taken to restore the hedge ratio to target.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalanceCostBase rdf:type rdf:Property ;
    rdfs:label 'Rebalance Cost Base' ;
    rdfs:comment 'Total transaction cost incurred for executing the rebalancing, including spreads and fees, in base currency.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalanceNotionalAmountBase rdf:type rdf:Property ;
    rdfs:label 'Rebalance Notional Amount Base' ;
    rdfs:comment 'Notional amount of hedge instruments added or removed during rebalancing, expressed in base currency.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalanceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Rebalance Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this rebalancing event for tracking and audit purposes.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalanceTriggerType rdf:type rdf:Property ;
    rdfs:label 'Rebalance Trigger Type' ;
    rdfs:comment 'Classification of the event or condition that triggered this rebalancing action.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spotRateAtTrigger rdf:type rdf:Property ;
    rdfs:label 'Spot Rate At Trigger' ;
    rdfs:comment 'Market spot exchange rate for the currency pair at the time the rebalancing was triggered.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetHedgeRatio rdf:type rdf:Property ;
    rdfs:label 'Target Hedge Ratio' ;
    rdfs:comment 'Policy-defined target hedge ratio that the rebalancing aims to achieve, expressed as a decimal proportion.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggerTimestamp rdf:type rdf:Property ;
    rdfs:label 'Trigger Timestamp' ;
    rdfs:comment 'Date and time when the rebalancing trigger condition was detected and the event was initiated.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:upperThresholdBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Upper Threshold Breach Flag' ;
    rdfs:comment 'Indicates whether the rebalancing was triggered by the hedge ratio exceeding the upper permitted band.' ;
    rdfs:domain ind:FxHedgeRebalance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:treasuryPolicyId rdf:type rdf:Property ;
    rdfs:label 'Treasury Policy Id' ;
    rdfs:comment 'Primary key for policy' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByMandateTreasuryPolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Mandate Treasury Policy Id' ;
    rdfs:comment 'Reference to the subsequent treasury mandate policy that replaces this version, enabling version lineage tracking.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TreasuryPolicy .

ind:approvedCounterpartyList rdf:type rdf:Property ;
    rdfs:label 'Approved Counterparty List' ;
    rdfs:comment 'Comma-separated list of counterparties approved for Foreign Exchange (FX) forward, swap, and derivative transactions under this mandate, subject to Know Your Customer (KYC) and Anti-Money Laundering (AML) compliance.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedCustodianList rdf:type rdf:Property ;
    rdfs:label 'Approved Custodian List' ;
    rdfs:comment 'Comma-separated list of custodian institutions approved for treasury cash account management and settlement under this mandate, such as State Street and Northern Trust.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralMinimumTransferAmount rdf:type rdf:Property ;
    rdfs:label 'Collateral Minimum Transfer Amount' ;
    rdfs:comment 'Minimum collateral transfer amount required under Credit Support Annex (CSA) agreements to reduce operational friction, denominated in base currency.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyConcentrationLimitPct rdf:type rdf:Property ;
    rdfs:label 'Counterparty Concentration Limit Pct' ;
    rdfs:comment 'Maximum percentage of total treasury assets that may be allocated to a single counterparty, expressed in basis points (bps) to manage concentration risk.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dv01LimitAmount rdf:type rdf:Property ;
    rdfs:label 'Dv01 Limit Amount' ;
    rdfs:comment 'Maximum Dollar Value of Zero One (DV01) interest rate sensitivity permitted for treasury fixed income holdings, denominated in base currency.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleCollateralTypes rdf:type rdf:Property ;
    rdfs:label 'Eligible Collateral Types' ;
    rdfs:comment 'Comma-separated list of collateral asset types acceptable for posting under this mandate, such as cash, government bonds, Investment Grade (IG) corporate bonds, and money market instruments.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxHedgeRatioTargetPct rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Ratio Target Pct' ;
    rdfs:comment 'Target hedge ratio for Foreign Exchange (FX) exposure management, expressed as a percentage of total foreign currency exposure to be hedged.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxHedgeRatioTolerancePct rdf:type rdf:Property ;
    rdfs:label 'Fx Hedge Ratio Tolerance Pct' ;
    rdfs:comment 'Allowable deviation from the target Foreign Exchange (FX) hedge ratio before rebalancing is required, expressed in percentage points.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandateReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Mandate Reference Number' ;
    rdfs:comment 'Externally-known business identifier for the treasury mandate policy, used in Investment Committee (IC) documentation and governance records.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumMaturityDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Maturity Days' ;
    rdfs:comment 'Maximum allowable maturity in days for short-term liquidity instruments under this treasury mandate, ensuring alignment with liquidity requirements.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumCreditRating rdf:type rdf:Property ;
    rdfs:label 'Minimum Credit Rating' ;
    rdfs:comment 'Minimum Investment Grade (IG) credit rating required for counterparties and issuers of short-term instruments, as per rating agency standards.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedInstrumentTypes rdf:type rdf:Property ;
    rdfs:label 'Permitted Instrument Types' ;
    rdfs:comment 'Comma-separated list of short-term investment instruments authorized under this mandate, such as Treasury Bills (T-Bills), Secured Overnight Financing Rate (SOFR) linked instruments, commercial paper, and money market funds.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required Flag' ;
    rdfs:comment 'Indicates whether transactions under this mandate require regulatory reporting to the national pension regulator, European Market Infrastructure Regulation (EMIR), or other governing bodies.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varLimit1day95pctAmount rdf:type rdf:Property ;
    rdfs:label 'Var Limit 1day 95pct Amount' ;
    rdfs:comment 'Maximum one-day Value at Risk (VaR) at ninety-five percent confidence level permitted for treasury portfolio, denominated in base currency.' ;
    rdfs:domain ind:TreasuryPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededBySofrBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Sofr Benchmark Id' ;
    rdfs:comment 'Reference to the sofr_benchmark_id that supersedes this record if this rate was revised.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SofrBenchmark .

ind:benchmarkAdministrator rdf:type rdf:Property ;
    rdfs:label 'Benchmark Administrator' ;
    rdfs:comment 'Name of the official administrator publishing this rate (Federal Reserve Bank of New York for SOFR).' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkRegulationCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Regulation Compliant Flag' ;
    rdfs:comment 'Indicates whether this rate complies with EU Benchmark Regulation (BMR) and IOSCO Principles for Financial Benchmarks.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:calendarCode rdf:type rdf:Property ;
    rdfs:label 'Calendar Code' ;
    rdfs:comment 'Three-letter code identifying the business day calendar used (e.g., USD for U.S. Federal Reserve calendar).' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compoundingIndex rdf:type rdf:Property ;
    rdfs:label 'Compounding Index' ;
    rdfs:comment 'Cumulative compounding index value used for calculating interest on SOFR-linked floating rate instruments.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexBaseDate rdf:type rdf:Property ;
    rdfs:label 'Index Base Date' ;
    rdfs:comment 'The reference date from which the SOFR compounding index is calculated (typically April 2, 2018).' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:percentile25th rdf:type rdf:Property ;
    rdfs:label 'Percentile 25th' ;
    rdfs:comment 'The 25th percentile rate from the distribution of underlying repo transactions, used for rate dispersion analysis.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentile75th rdf:type rdf:Property ;
    rdfs:label 'Percentile 75th' ;
    rdfs:comment 'The 75th percentile rate from the distribution of underlying repo transactions, used for rate dispersion analysis.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateValueBps rdf:type rdf:Property ;
    rdfs:label 'Rate Value Bps' ;
    rdfs:comment 'The SOFR rate expressed in basis points (bps) for precision in spread calculations (e.g., 532.0000 bps for 5.32%).' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateValuePercent rdf:type rdf:Property ;
    rdfs:label 'Rate Value Percent' ;
    rdfs:comment 'The published SOFR rate expressed as an annualized percentage (e.g., 5.32 for 5.32% per annum).' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateVolatilityBps rdf:type rdf:Property ;
    rdfs:label 'Rate Volatility Bps' ;
    rdfs:comment 'Standard deviation or volatility measure of the SOFR rate over the calculation period, expressed in basis points.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCount rdf:type rdf:Property ;
    rdfs:label 'Transaction Count' ;
    rdfs:comment 'Number of individual repo transactions included in the SOFR calculation for this date.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transactionVolumeUsd rdf:type rdf:Property ;
    rdfs:label 'Transaction Volume Usd' ;
    rdfs:comment 'Total notional volume in USD of overnight Treasury repo transactions used to calculate this SOFR rate.' ;
    rdfs:domain ind:SofrBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Validation Timestamp' ;
    rdfs:comment 'Timestamp when automated validation checks were last performed on this rate record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:distributionNoticeId rdf:type rdf:Property ;
    rdfs:label 'Distribution Notice Id' ;
    rdfs:comment 'Foreign key linking to performance.notice. Business justification: Distribution processing workflow: Treasury receives distributions announced via GP notices. Parallel to existing capital_call_funding→notice link.' ;
    rdfs:domain ind:DistributionReceipt ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Notice .

ind:distributionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Distribution Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code of the distribution amount as paid by the General Partner (GP).' ;
    rdfs:domain ind:DistributionReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Distribution Reference Number' ;
    rdfs:comment 'External reference number or identifier provided by the General Partner (GP) or fund administrator for this distribution.' ;
    rdfs:domain ind:DistributionReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpiContribution rdf:type rdf:Property ;
    rdfs:label 'Dpi Contribution' ;
    rdfs:comment 'Contribution of this distribution to the cumulative Distributions to Paid-In (DPI) multiple for the fund investment, calculated as distribution amount divided by Paid-In Capital (PIC).' ;
    rdfs:domain ind:DistributionReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeAmount rdf:type rdf:Property ;
    rdfs:label 'Income Amount' ;
    rdfs:comment 'Portion of the distribution classified as income (dividends, interest, rental income, royalties) from underlying portfolio assets, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Posted Timestamp' ;
    rdfs:comment 'Date and time when the distribution receipt was posted to the Investment Book of Record (IBOR) in SimCorp Dimension or Aladdin, in ISO 8601 format with timezone.' ;
    rdfs:domain ind:DistributionReceipt ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sweepInstructionId rdf:type rdf:Property ;
    rdfs:label 'Sweep Instruction Id' ;
    rdfs:comment 'Unique identifier for the cash sweep instruction record.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ssiRegistryId rdf:type rdf:Property ;
    rdfs:label 'Ssi Registry Id' ;
    rdfs:comment 'Reference to the standard settlement instructions template used for this sweep.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SsiRegistry .

ind:targetCashAccountId rdf:type rdf:Property ;
    rdfs:label 'Target Cash Account Id' ;
    rdfs:comment 'Reference to the destination cash account or liquidity instrument account receiving swept funds.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:custodianConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Custodian Confirmation Number' ;
    rdfs:comment 'Confirmation reference number provided by the custodian bank for the executed sweep.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Executed Timestamp' ;
    rdfs:comment 'Date and time when the sweep instruction was executed and funds movement initiated.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionTime rdf:type rdf:Property ;
    rdfs:label 'Execution Time' ;
    rdfs:comment 'Scheduled time of day for sweep execution in HH:MM format, applicable for time-based automated sweeps.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:instructionDate rdf:type rdf:Property ;
    rdfs:label 'Instruction Date' ;
    rdfs:comment 'Business date when the sweep instruction was created or issued.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:instructionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Instruction Reference Number' ;
    rdfs:comment 'Externally visible unique reference number for the sweep instruction used for tracking and reconciliation.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentMaturityDate rdf:type rdf:Property ;
    rdfs:label 'Instrument Maturity Date' ;
    rdfs:comment 'Maturity date of the short-term liquidity instrument purchased with swept funds.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liquidityInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Liquidity Instrument Type' ;
    rdfs:comment 'Type of short-term liquidity instrument into which excess cash is swept. [ENUM-REF-CANDIDATE: money_market_fund|treasury_bill|commercial_paper|repo|overnight_deposit|term_deposit|sofr_linked — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSweepAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Sweep Amount' ;
    rdfs:comment 'Minimum monetary amount required for a sweep to be executed; sweeps below this threshold are not processed.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settledTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settled Timestamp' ;
    rdfs:comment 'Date and time when the sweep transaction was settled and funds transfer completed.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:sweepAmount rdf:type rdf:Property ;
    rdfs:label 'Sweep Amount' ;
    rdfs:comment 'Monetary amount of cash being swept from the source account to the target account or instrument.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sweepFrequency rdf:type rdf:Property ;
    rdfs:label 'Sweep Frequency' ;
    rdfs:comment 'Scheduled frequency at which automated sweep instructions are evaluated and executed.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sweepPriority rdf:type rdf:Property ;
    rdfs:label 'Sweep Priority' ;
    rdfs:comment 'Execution priority ranking for this sweep instruction when multiple sweeps compete for available cash.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Target Balance Amount' ;
    rdfs:comment 'Desired balance to be maintained in the source account after sweep execution; excess above this level is swept.' ;
    rdfs:domain ind:SweepInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Threshold Amount' ;
    rdfs:comment 'Minimum balance threshold that triggers an automated sweep when exceeded in the source account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accountClosingDate rdf:type rdf:Property ;
    rdfs:label 'Account Closing Date' ;
    rdfs:comment 'Date when the bank account was closed. Null if account remains open.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankBranchCode rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Code' ;
    rdfs:comment 'Routing or sort code identifying the specific branch within the banking network.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankBranchName rdf:type rdf:Property ;
    rdfs:label 'Bank Branch Name' ;
    rdfs:comment 'Name of the specific branch of the financial institution servicing this account.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactEmail rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Email' ;
    rdfs:comment 'Email address for the primary bank contact managing this account relationship.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankContactPhone rdf:type rdf:Property ;
    rdfs:label 'Bank Contact Phone' ;
    rdfs:comment 'Phone number for the primary bank contact managing this account relationship.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankCountryCode rdf:type rdf:Property ;
    rdfs:label 'Bank Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the bank account is domiciled.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankName rdf:type rdf:Property ;
    rdfs:label 'Bank Name' ;
    rdfs:comment 'Legal name of the financial institution where the account is held.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankRelationshipManager rdf:type rdf:Property ;
    rdfs:label 'Bank Relationship Manager' ;
    rdfs:comment 'Name of the relationship manager at the financial institution servicing this account.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dailyTransactionLimit rdf:type rdf:Property ;
    rdfs:label 'Daily Transaction Limit' ;
    rdfs:comment 'Maximum aggregate transaction amount permitted per day on this account.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRateBasisPoints rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Basis Points' ;
    rdfs:comment 'Interest rate applied to account balances expressed in basis points.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isCapitalCallAccount rdf:type rdf:Property ;
    rdfs:label 'Is Capital Call Account' ;
    rdfs:comment 'Indicates whether this account is designated for receiving capital call contributions from LPs.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isDistributionAccount rdf:type rdf:Property ;
    rdfs:label 'Is Distribution Account' ;
    rdfs:comment 'Indicates whether this account is designated for making distributions to limited partners.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFxHedgingAccount rdf:type rdf:Property ;
    rdfs:label 'Is Fx Hedging Account' ;
    rdfs:comment 'Indicates whether this account is used for foreign exchange hedging transactions.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSweepEnabled rdf:type rdf:Property ;
    rdfs:label 'Is Sweep Enabled' ;
    rdfs:comment 'Indicates whether automatic cash sweep functionality is enabled for liquidity optimization.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Primary Signatory Name' ;
    rdfs:comment 'Name of the primary authorized signatory for transactions on this bank account.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondarySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Secondary Signatory Name' ;
    rdfs:comment 'Name of the secondary authorized signatory for dual-signature requirements.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatureThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Signature Threshold Amount' ;
    rdfs:comment 'Transaction amount threshold above which dual signatures are required for authorization.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:singleTransactionLimit rdf:type rdf:Property ;
    rdfs:label 'Single Transaction Limit' ;
    rdfs:comment 'Maximum amount permitted for a single transaction on this account.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:swiftBicCode rdf:type rdf:Property ;
    rdfs:label 'Swift Bic Code' ;
    rdfs:comment 'SWIFT/BIC code identifying the financial institution holding this account for international wire transfers.' ;
    rdfs:domain ind:GpBankAccount ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:blacklistReason rdf:type rdf:Property ;
    rdfs:label 'Blacklist Reason' ;
    rdfs:comment 'Reason for blacklisting the counterparty, if applicable.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classification rdf:type rdf:Property ;
    rdfs:label 'Classification' ;
    rdfs:comment 'Business classification indicating internal, external, or affiliated relationship.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Eligible Flag' ;
    rdfs:comment 'Indicates whether the counterparty is eligible to post collateral under firm policy.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterpartyStatus rdf:type rdf:Property ;
    rdfs:label 'Counterparty Status' ;
    rdfs:comment 'Current operational status of the counterparty.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'Country Of Incorporation' ;
    rdfs:comment 'Country where the counterparty is legally incorporated. [ENUM-REF-CANDIDATE: USA|CAN|GBR|FRA|DEU|JPN|AUS|CHN|... — promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditLimit rdf:type rdf:Property ;
    rdfs:label 'Credit Limit' ;
    rdfs:comment 'Maximum credit exposure approved for the counterparty.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureLimit rdf:type rdf:Property ;
    rdfs:label 'Exposure Limit' ;
    rdfs:comment 'Maximum aggregate exposure allowed for the counterparty across all trades.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isBlacklisted rdf:type rdf:Property ;
    rdfs:label 'Is Blacklisted' ;
    rdfs:comment 'Indicates whether the counterparty is on the internal blacklist.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCentralCounterparty rdf:type rdf:Property ;
    rdfs:label 'Is Central Counterparty' ;
    rdfs:comment 'True if the counterparty functions as a Central Counterparty.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isClearingMember rdf:type rdf:Property ;
    rdfs:label 'Is Clearing Member' ;
    rdfs:comment 'True if the counterparty is a clearing member of a CCP.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastRatingDate rdf:type rdf:Property ;
    rdfs:label 'Last Rating Date' ;
    rdfs:comment 'Date of the most recent risk rating assignment.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marginCallThreshold rdf:type rdf:Property ;
    rdfs:label 'Margin Call Threshold' ;
    rdfs:comment 'Exposure percentage at which a margin call is triggered.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryContactAddress rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Address' ;
    rdfs:comment 'Mailing address for the primary contact of the counterparty.' ;
    rdfs:domain ind:Counterparty ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxIdentifier rdf:type rdf:Property ;
    rdfs:label 'Tax Identifier' ;
    rdfs:comment 'Tax identification number of the counterparty for jurisdictional tax reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentIndicator rdf:type rdf:Property ;
    rdfs:label 'Amendment Indicator' ;
    rdfs:comment 'True if the agreement has been amended since original execution.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closeOutNettingProvision rdf:type rdf:Property ;
    rdfs:label 'Close Out Netting Provision' ;
    rdfs:comment 'Text describing the close-out netting rules applicable to the agreement.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralEligibility rdf:type rdf:Property ;
    rdfs:label 'Collateral Eligibility' ;
    rdfs:comment 'Indicates whether the agreement permits collateral posting and its scope.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyBic rdf:type rdf:Property ;
    rdfs:label 'Counterparty Bic' ;
    rdfs:comment 'BIC of the counterparty\'s primary banking relationship.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditSupportAnnexReference rdf:type rdf:Property ;
    rdfs:label 'Credit Support Annex Reference' ;
    rdfs:comment 'Identifier of the associated Credit Support Annex governing collateral terms.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultProvision rdf:type rdf:Property ;
    rdfs:label 'Default Provision' ;
    rdfs:comment 'Text of the provision outlining events of default and remedies.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earlyTerminationRights rdf:type rdf:Property ;
    rdfs:label 'Early Termination Rights' ;
    rdfs:comment 'Description of any rights allowing early termination of the agreement.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isdaMasterStatus rdf:type rdf:Property ;
    rdfs:label 'Isda Master Status' ;
    rdfs:comment 'Current lifecycle state of the ISDA Master Agreement.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marginCallFrequency rdf:type rdf:Property ;
    rdfs:label 'Margin Call Frequency' ;
    rdfs:comment 'How often margin calls are required under the agreement.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marginCurrency rdf:type rdf:Property ;
    rdfs:label 'Margin Currency' ;
    rdfs:comment 'ISO 4217 currency code for the margin threshold amount.' ;
    rdfs:domain ind:Collateral ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationEventClauses rdf:type rdf:Property ;
    rdfs:label 'Termination Event Clauses' ;
    rdfs:comment 'Key clauses that define events triggering termination of the agreement.' ;
    rdfs:domain ind:IsdaMaster ;
    rdf:type owl:DatatypeProperty ;
