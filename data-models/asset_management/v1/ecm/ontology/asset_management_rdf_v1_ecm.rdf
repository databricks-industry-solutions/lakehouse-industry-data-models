    rdfs:range xsd:string .

ind:gicsIndustryGroup rdf:type rdf:Property ;
    rdfs:label 'Gics Industry Group' ;
    rdfs:comment 'GICS level 2 industry group classification of the issuer.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gicsSector rdf:type rdf:Property ;
    rdfs:label 'Gics Sector' ;
    rdfs:comment 'GICS level 1 sector classification of the issuer.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gicsSubIndustry rdf:type rdf:Property ;
    rdfs:label 'Gics Sub Industry' ;
    rdfs:comment 'GICS level 4 sub-industry classification of the issuer.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Investment Restriction Flag' ;
    rdfs:comment 'Indicates whether the security is subject to internal investment restrictions or exclusions.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:listingCountry rdf:type rdf:Property ;
    rdfs:label 'Listing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary exchange jurisdiction.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:listingDate rdf:type rdf:Property ;
    rdfs:label 'Listing Date' ;
    rdfs:comment 'Date on which the security was first listed on the primary exchange.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:listingStatus rdf:type rdf:Property ;
    rdfs:label 'Listing Status' ;
    rdfs:comment 'Current trading and listing status of the security on the primary exchange.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotSize rdf:type rdf:Property ;
    rdfs:label 'Lot Size' ;
    rdfs:comment 'Minimum trading unit or board lot size required by the exchange for this security.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketCapDate rdf:type rdf:Property ;
    rdfs:label 'Market Cap Date' ;
    rdfs:comment 'Date as of which the market capitalization is calculated.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketCapitalization rdf:type rdf:Property ;
    rdfs:label 'Market Capitalization' ;
    rdfs:comment 'Total market value of outstanding shares, calculated as shares outstanding multiplied by current market price, in trading currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:msciConstituentFlag rdf:type rdf:Property ;
    rdfs:label 'Msci Constituent Flag' ;
    rdfs:comment 'Indicates whether the security is a constituent of any MSCI index.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parValue rdf:type rdf:Property ;
    rdfs:label 'Par Value' ;
    rdfs:comment 'Nominal or face value per share as stated in the corporate charter, in the issuers reporting currency.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Par Value Currency' ;
    rdfs:comment 'ISO 4217 3-letter currency code for the par value denomination.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceMultiplier rdf:type rdf:Property ;
    rdfs:label 'Price Multiplier' ;
    rdfs:comment 'Multiplier applied to quoted price to determine actual contract value, typically 1.0 for equities.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryExchange rdf:type rdf:Property ;
    rdfs:label 'Primary Exchange' ;
    rdfs:comment 'Name of the primary stock exchange where the security is listed and primarily traded.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchRating rdf:type rdf:Property ;
    rdfs:label 'Research Rating' ;
    rdfs:comment 'Internal research teams investment recommendation rating for the security.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchRatingDate rdf:type rdf:Property ;
    rdfs:label 'Research Rating Date' ;
    rdfs:comment 'Date on which the current research rating was assigned.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:restrictionReason rdf:type rdf:Property ;
    rdfs:label 'Restriction Reason' ;
    rdfs:comment 'Explanation of why the security is restricted, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reutersRic rdf:type rdf:Property ;
    rdfs:label 'Reuters Ric' ;
    rdfs:comment 'Reuters-specific instrument identifier code.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityType rdf:type rdf:Property ;
    rdfs:label 'Security Type' ;
    rdfs:comment 'Classification of the equity instrument type.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shareClass rdf:type rdf:Property ;
    rdfs:label 'Share Class' ;
    rdfs:comment 'Designation of the share class (e.g., Class A, Class B, Ordinary) indicating voting rights and dividend entitlements.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sharesOutstanding rdf:type rdf:Property ;
    rdfs:label 'Shares Outstanding' ;
    rdfs:comment 'Total number of shares currently issued and outstanding as reported by the issuer.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sharesOutstandingDate rdf:type rdf:Property ;
    rdfs:label 'Shares Outstanding Date' ;
    rdfs:comment 'Date as of which the shares outstanding figure is accurate.' ;
    rdfs:domain ind:ListedSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tradingCurrency rdf:type rdf:Property ;
    rdfs:label 'Trading Currency' ;
    rdfs:comment 'ISO 4217 3-letter currency code in which the security is quoted and traded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votingRights rdf:type rdf:Property ;
    rdfs:label 'Voting Rights' ;
    rdfs:comment 'Voting rights associated with this share class.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityPositionId rdf:type rdf:Property ;
    rdfs:label 'Equity Position Id' ;
    rdfs:comment 'Unique identifier for the equity position record in the Investment Book of Record (IBOR).' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquityPosition .

ind:custodyAccountId rdf:type rdf:Property ;
    rdfs:label 'Custody Account Id' ;
    rdfs:comment 'Foreign key linking to trade.custody_account. Business justification: Position custody mapping – tracks which custody account holds each position for reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CustodyAccount .

ind:instrumentId rdf:type rdf:Property ;
    rdfs:label 'Instrument Id' ;
    rdfs:comment 'Foreign key linking to trade.instrument. Business justification: Position-to-instrument mapping – aligns equity positions with the trade-domain instrument for cross-domain analytics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Instrument .

ind:managerMandateId rdf:type rdf:Property ;
    rdfs:label 'Manager Mandate Id' ;
    rdfs:comment 'Foreign key linking to manager.manager_mandate. Business justification: Position-level reporting requires linking each equity position to the manager mandate that owns the portfolio, enabling mandate-level performance attribution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ManagerMandate .

ind:riskFactorExposureId rdf:type rdf:Property ;
    rdfs:label 'Risk Factor Exposure Id' ;
    rdfs:comment 'Foreign key linking to risk.risk_factor_exposure. Business justification: Position-level risk attribution reports require mapping each equity position to its risk factor exposure record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskFactorExposure .

ind:traderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Trader Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Position entry workflow requires linking the trader who executed the trade to the employee record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accruedDividend rdf:type rdf:Property ;
    rdfs:label 'Accrued Dividend' ;
    rdfs:comment 'Dividend income accrued but not yet received for this position in base currency.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Active Weight Percent' ;
    rdfs:comment 'Difference between portfolio weight and benchmark weight; indicates over or underweight position.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageCostPerShare rdf:type rdf:Property ;
    rdfs:label 'Average Cost Per Share' ;
    rdfs:comment 'Weighted average cost basis per share in the positions local currency.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight Percent' ;
    rdfs:comment 'Weight of this security in the portfolios benchmark index expressed as a percentage.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beta rdf:type rdf:Property ;
    rdfs:label 'Beta' ;
    rdfs:comment 'Measure of the securitys volatility relative to the market benchmark per Capital Asset Pricing Model (CAPM).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bookCostBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Book Cost Base Currency' ;
    rdfs:comment 'Total original acquisition cost of the position in the portfolios base currency.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Custodian Account Number' ;
    rdfs:comment 'Account number at the custodian bank where the equity position is held.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dividendYieldPercent rdf:type rdf:Property ;
    rdfs:label 'Dividend Yield Percent' ;
    rdfs:comment 'Annualized dividend yield of the security expressed as a percentage of market price.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeClassification rdf:type rdf:Property ;
    rdfs:label 'Income Classification' ;
    rdfs:comment 'Tax classification of dividend income from this position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastTradeDate rdf:type rdf:Property ;
    rdfs:label 'Last Trade Date' ;
    rdfs:comment 'Date of the most recent trade that affected this position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lendingEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Lending Eligible Flag' ;
    rdfs:comment 'Indicates whether the position is eligible for securities lending programs.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketCapitalizationTier rdf:type rdf:Property ;
    rdfs:label 'Market Capitalization Tier' ;
    rdfs:comment 'Classification of the equity by market capitalization size.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketValueLocalCurrency rdf:type rdf:Property ;
    rdfs:label 'Market Value Local Currency' ;
    rdfs:comment 'Total market value of the position in the securitys local trading currency.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight Percent' ;
    rdfs:comment 'Weight of this position in the total portfolio expressed as a percentage of Net Asset Value (NAV).' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:positionStatus rdf:type rdf:Property ;
    rdfs:label 'Position Status' ;
    rdfs:comment 'Current lifecycle status of the equity position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionType rdf:type rdf:Property ;
    rdfs:label 'Position Type' ;
    rdfs:comment 'Indicates whether the position is a long holding or a short sale.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceToEarningsRatio rdf:type rdf:Property ;
    rdfs:label 'Price To Earnings Ratio' ;
    rdfs:comment 'Ratio of market price per share to earnings per share; valuation metric.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sectorClassification rdf:type rdf:Property ;
    rdfs:label 'Sector Classification' ;
    rdfs:comment 'Industry sector classification of the equity security per GICS or equivalent taxonomy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votingRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Voting Rights Flag' ;
    rdfs:comment 'Indicates whether the equity position carries shareholder voting rights.' ;
    rdfs:domain ind:EquityPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creatorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Creator Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Benchmark creation process requires linking the creator to the employee record.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:administratorLei rdf:type rdf:Property ;
    rdfs:label 'Administrator Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier of the benchmark administrator.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseDate rdf:type rdf:Property ;
    rdfs:label 'Base Date' ;
    rdfs:comment 'Inception date of the benchmark index from which historical performance is calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baseValue rdf:type rdf:Property ;
    rdfs:label 'Base Value' ;
    rdfs:comment 'Initial index level set at the base date (typically 100 or 1000).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkStatus rdf:type rdf:Property ;
    rdfs:label 'Benchmark Status' ;
    rdfs:comment 'Current operational status of the benchmark index.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationFrequency rdf:type rdf:Property ;
    rdfs:label 'Calculation Frequency' ;
    rdfs:comment 'Frequency at which the benchmark index level is calculated and published.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cappingMethodology rdf:type rdf:Property ;
    rdfs:label 'Capping Methodology' ;
    rdfs:comment 'Description of any maximum weight limits applied to individual constituents or sectors.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryIsoCode rdf:type rdf:Property ;
    rdfs:label 'Country Iso Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for single-country benchmarks.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dividendTreatment rdf:type rdf:Property ;
    rdfs:label 'Dividend Treatment' ;
    rdfs:comment 'How dividends are treated in the benchmark calculation methodology.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIntegration rdf:type rdf:Property ;
    rdfs:label 'Esg Integration' ;
    rdfs:comment 'Indicates whether the benchmark incorporates ESG screening or tilting criteria.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgMethodology rdf:type rdf:Property ;
    rdfs:label 'Esg Methodology' ;
    rdfs:comment 'Description of ESG screening, exclusion, or integration approach applied to the benchmark.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factsheetUrl rdf:type rdf:Property ;
    rdfs:label 'Factsheet Url' ;
    rdfs:comment 'Web link to the current benchmark factsheet or summary document.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeFloatAdjustment rdf:type rdf:Property ;
    rdfs:label 'Free Float Adjustment' ;
    rdfs:comment 'Indicates whether constituent weights are adjusted for publicly available shares only.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographicScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Scope' ;
    rdfs:comment 'Geographic coverage of the equity markets included in the benchmark.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgedCurrency rdf:type rdf:Property ;
    rdfs:label 'Hedged Currency' ;
    rdfs:comment 'Target currency for currency-hedged versions of the benchmark index.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexProvider rdf:type rdf:Property ;
    rdfs:label 'Index Provider' ;
    rdfs:comment 'Organization that calculates and publishes the benchmark index. [ENUM-REF-CANDIDATE: MSCI|FTSE|S&P|Russell|Bloomberg|Dow Jones|Stoxx|Nasdaq — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalBenchmarkFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Benchmark Flag' ;
    rdfs:comment 'Indicates whether this is a custom benchmark constructed internally rather than a third-party published index.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketCapRange rdf:type rdf:Property ;
    rdfs:label 'Market Cap Range' ;
    rdfs:comment 'Market capitalization segment targeted by the benchmark index.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodologyUrl rdf:type rdf:Property ;
    rdfs:label 'Methodology Url' ;
    rdfs:comment 'Web link to the official index methodology document published by the provider.' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfConstituents rdf:type rdf:Property ;
    rdfs:label 'Number Of Constituents' ;
    rdfs:comment 'Total count of equity securities included in the benchmark index.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reconstitutionMonth rdf:type rdf:Property ;
    rdfs:label 'Reconstitution Month' ;
    rdfs:comment 'Primary month in which annual or semi-annual index reconstitution occurs. [ENUM-REF-CANDIDATE: January|February|March|April|May|June|July|August|September|October|November|December — 12 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EquityBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:region rdf:type rdf:Property ;
    rdfs:label 'Region' ;
    rdfs:comment 'Primary geographic region covered by the benchmark (e.g., North America, Europe, Asia Pacific).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnType rdf:type rdf:Property ;
    rdfs:label 'Return Type' ;
    rdfs:comment 'Calculation method for index returns: price-only, net dividends, or gross dividends.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ricCode rdf:type rdf:Property ;
    rdfs:label 'Ric Code' ;
    rdfs:comment 'Refinitiv Reuters Instrument Code identifying the benchmark index.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:styleFactor rdf:type rdf:Property ;
    rdfs:label 'Style Factor' ;
    rdfs:comment 'Investment style or factor exposure emphasized by the benchmark index. [ENUM-REF-CANDIDATE: Value|Growth|Blend|Quality|Momentum|Low Volatility|Dividend|Multi-Factor — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usagePurpose rdf:type rdf:Property ;
    rdfs:label 'Usage Purpose' ;
    rdfs:comment 'Primary use case for this benchmark within the organization (e.g., performance attribution, portfolio construction, risk management, SAA reference).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightingMethodology rdf:type rdf:Property ;
    rdfs:label 'Weighting Methodology' ;
    rdfs:comment 'Method used to weight constituent securities within the benchmark index. [ENUM-REF-CANDIDATE: Market Cap|Float-Adjusted Market Cap|Equal Weight|Fundamental|Factor|Risk-Based|Custom — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityBenchmarkConstituentId rdf:type rdf:Property ;
    rdfs:label 'Equity Benchmark Constituent Id' ;
    rdfs:comment 'Unique identifier for the equity benchmark constituent record.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:additionDate rdf:type rdf:Property ;
    rdfs:label 'Addition Date' ;
    rdfs:comment 'Date on which the security was first added to the benchmark index.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:adjustedMarketCapitalization rdf:type rdf:Property ;
    rdfs:label 'Adjusted Market Capitalization' ;
    rdfs:comment 'Market capitalization adjusted for free float and other index-specific factors, used as the basis for weight calculation in free-float weighted indices.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageDailyValueTraded rdf:type rdf:Property ;
    rdfs:label 'Average Daily Value Traded' ;
    rdfs:comment 'Average monetary value of shares traded daily over a specified lookback period, used for liquidity assessment.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cappingFactor rdf:type rdf:Property ;
    rdfs:label 'Capping Factor' ;
    rdfs:comment 'Factor applied to limit the maximum weight of any single constituent, used in capped index methodologies.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constituentStatus rdf:type rdf:Property ;
    rdfs:label 'Constituent Status' ;
    rdfs:comment 'Current lifecycle status of the constituent membership within the benchmark index.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constituentWeight rdf:type rdf:Property ;
    rdfs:label 'Constituent Weight' ;
    rdfs:comment 'Weight of the security within the benchmark index expressed as a decimal proportion, typically summing to 1.0 across all constituents at a given effective date.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constituentWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Constituent Weight Percent' ;
    rdfs:comment 'Weight of the security within the benchmark index expressed as a percentage, typically summing to 100 across all constituents.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corporateActionAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Corporate Action Adjustment Flag' ;
    rdfs:comment 'Indicates whether this constituent record reflects an adjustment due to a corporate action such as stock split, dividend, or merger.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deletionDate rdf:type rdf:Property ;
    rdfs:label 'Deletion Date' ;
    rdfs:comment 'Date on which the security was removed from the benchmark index, null if still a constituent.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deletionReason rdf:type rdf:Property ;
    rdfs:label 'Deletion Reason' ;
    rdfs:comment 'Reason code explaining why the security was removed from the benchmark index. [ENUM-REF-CANDIDATE: merger|acquisition|delisting|bankruptcy|rebalance|size_threshold|liquidity_threshold — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expirationDate rdf:type rdf:Property ;
    rdfs:label 'Expiration Date' ;
    rdfs:comment 'Date on which this constituent membership ended or will end, null if currently active in the benchmark.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:freeFloatFactor rdf:type rdf:Property ;
    rdfs:label 'Free Float Factor' ;
    rdfs:comment 'Proportion of shares available for public trading, used to adjust market capitalization for free-float weighting methodologies.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gicsIndustryCode rdf:type rdf:Property ;
    rdfs:label 'Gics Industry Code' ;
    rdfs:comment 'Six-digit GICS industry code providing third-level industry classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gicsIndustryGroupCode rdf:type rdf:Property ;
    rdfs:label 'Gics Industry Group Code' ;
    rdfs:comment 'Four-digit GICS industry group code providing second-level industry classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gicsSectorCode rdf:type rdf:Property ;
    rdfs:label 'Gics Sector Code' ;
    rdfs:comment 'Two-digit GICS sector code classifying the security at the highest industry hierarchy level.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gicsSubIndustryCode rdf:type rdf:Property ;
    rdfs:label 'Gics Sub Industry Code' ;
    rdfs:comment 'Eight-digit GICS sub-industry code providing the most granular industry classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexDivisor rdf:type rdf:Property ;
    rdfs:label 'Index Divisor' ;
    rdfs:comment 'Divisor value used in index calculation to maintain index continuity across corporate actions and rebalancing events.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexProviderCode rdf:type rdf:Property ;
    rdfs:label 'Index Provider Code' ;
    rdfs:comment 'Code or identifier of the organization that publishes and maintains the benchmark index.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityScore rdf:type rdf:Property ;
    rdfs:label 'Liquidity Score' ;
    rdfs:comment 'Quantitative measure of the securitys trading liquidity used in index eligibility and weighting decisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceAtRebalance rdf:type rdf:Property ;
    rdfs:label 'Price At Rebalance' ;
    rdfs:comment 'Closing price of the security on the effective date used for weight calculation and rebalancing.' ;
    rdfs:domain ind:EquityBenchmarkConstituent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalanceFrequency rdf:type rdf:Property ;
    rdfs:label 'Rebalance Frequency' ;
    rdfs:comment 'Frequency at which the benchmark index rebalances constituent weights and membership.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityCoverageId rdf:type rdf:Property ;
    rdfs:label 'Equity Coverage Id' ;
    rdfs:comment 'Unique identifier for the equity research coverage record.' ;
