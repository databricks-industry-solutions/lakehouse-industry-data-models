    rdfs:comment 'Date when the current data license agreement expires. Triggers renewal workflow notifications.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minimumQuoteSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Quote Size' ;
    rdfs:comment 'Minimum notional or quantity threshold for which quotes from this source are considered representative of market prices.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingMethodology rdf:type rdf:Property ;
