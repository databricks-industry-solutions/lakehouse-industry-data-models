ind:coveragePriority rdf:type rdf:Property ;
    rdfs:label 'Coverage Priority' ;
    rdfs:comment 'Priority tier of the coverage assignment reflecting strategic importance and research intensity: tier 1 core, tier 2 standard, tier 3 monitoring, watchlist, or opportunistic.' ;
    rdfs:domain ind:AnalystAssignment ;
