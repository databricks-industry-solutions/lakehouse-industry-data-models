ind:equityCoverageStatus rdf:type rdf:Property ;
    rdfs:label 'Equity Coverage Status' ;
    rdfs:comment 'Current status of research coverage for this security.' ;
    rdfs:domain ind:EquityCoverage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityCoverageType rdf:type rdf:Property ;
    rdfs:label 'Equity Coverage Type' ;
    rdfs:comment 'Classification of the depth and scope of research coverage provided.' ;
