    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:onboardingDate rdf:type rdf:Property ;
    rdfs:label 'Onboarding Date' ;
    rdfs:comment 'The date on which the tenant was first onboarded into the real estate portfolio management system.' ;
    rdfs:domain ind:AssetManagement ;
