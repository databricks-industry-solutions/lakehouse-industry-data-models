    rdfs:comment 'Human-readable name/text of the ATC level 4 chemical, therapeutic or pharmacological subgroup associated with the ATC code.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Source Release Date' ;
    rdfs:comment 'Official release date of the WHODrug dictionary version from which this ATC level 4 record was ingested.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:whodrugCode rdf:type rdf:Property ;
