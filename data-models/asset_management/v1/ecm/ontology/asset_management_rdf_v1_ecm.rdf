    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deathDate rdf:type rdf:Property ;
    rdfs:label 'Death Date' ;
    rdfs:comment 'Date of death of the beneficiary, if applicable.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:designationDate rdf:type rdf:Property ;
    rdfs:label 'Designation Date' ;
    rdfs:comment 'Date the beneficiary was designated by the member.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emailAddress rdf:type rdf:Property ;
    rdfs:label 'Email Address' ;
    rdfs:comment 'Primary email address of the beneficiary.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isDisabledDependent rdf:type rdf:Property ;
    rdfs:label 'Is Disabled Dependent' ;
    rdfs:comment 'Indicates if beneficiary is a disabled dependent.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFullTimeStudent rdf:type rdf:Property ;
    rdfs:label 'Is Full Time Student' ;
    rdfs:comment 'Indicates if beneficiary is a full-time student.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verification Date' ;
    rdfs:comment 'Date when KYC verification was completed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kycVerified rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified' ;
    rdfs:comment 'Flag indicating if beneficiary has passed KYC checks.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lumpSumAmount rdf:type rdf:Property ;
    rdfs:label 'Lump Sum Amount' ;
    rdfs:comment 'One-time lump sum payment amount to the beneficiary.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maritalStatus rdf:type rdf:Property ;
    rdfs:label 'Marital Status' ;
    rdfs:comment 'Marital status of the beneficiary.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentEndDate rdf:type rdf:Property ;
    rdfs:label 'Payment End Date' ;
    rdfs:comment 'End date of benefit payments.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentStartDate rdf:type rdf:Property ;
    rdfs:label 'Payment Start Date' ;
    rdfs:comment 'Start date of benefit payments.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipType rdf:type rdf:Property ;
    rdfs:label 'Relationship Type' ;
    rdfs:comment 'Nature of the beneficiary\'s relationship to the plan member.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remarriageTerminationFlag rdf:type rdf:Property ;
    rdfs:label 'Remarriage Termination Flag' ;
    rdfs:comment 'Flag indicating termination due to remarriage.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spouseDob rdf:type rdf:Property ;
    rdfs:label 'Spouse Dob' ;
    rdfs:comment 'Date of birth of the beneficiary\'s spouse.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:spouseName rdf:type rdf:Property ;
    rdfs:label 'Spouse Name' ;
    rdfs:comment 'Full name of the beneficiary\'s spouse, if applicable.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spouseNationalIdentifier rdf:type rdf:Property ;
    rdfs:label 'Spouse National Identifier' ;
    rdfs:comment 'National ID of the beneficiary\'s spouse.' ;
    rdfs:domain ind:DesignatedBeneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithholdingRate rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Rate' ;
    rdfs:comment 'Rate of tax withheld from benefit payments.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberAddressId rdf:type rdf:Property ;
    rdfs:label 'Member Address Id' ;
    rdfs:comment 'Unique surrogate identifier for each member address record within the pension fund member address master.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:addressFormatType rdf:type rdf:Property ;
    rdfs:label 'Address Format Type' ;
    rdfs:comment 'Identifies the address format convention applied to this record, enabling correct rendering of address components for correspondence in different countries.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressLine3 rdf:type rdf:Property ;
    rdfs:label 'Address Line 3' ;
    rdfs:comment 'Tertiary address line used for additional delivery instructions, care-of designations, or rural route information where required.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressNotes rdf:type rdf:Property ;
    rdfs:label 'Address Notes' ;
    rdfs:comment 'Free-text field for additional address delivery instructions, special handling notes, or contextual information not captured in structured address fields.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressSource rdf:type rdf:Property ;
    rdfs:label 'Address Source' ;
    rdfs:comment 'Identifies the originating channel or system through which this address was captured (e.g., member self-service portal, employer HR submission, plan administrator entry).' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressStatus rdf:type rdf:Property ;
    rdfs:label 'Address Status' ;
    rdfs:comment 'Current lifecycle status of the address record. Active indicates the address is in use; undeliverable indicates returned mail; superseded indicates replaced by a newer record.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:addressType rdf:type rdf:Property ;
    rdfs:label 'Address Type' ;
    rdfs:comment 'Classifies the functional purpose of the address record (e.g., residential home address, mailing/correspondence address, employer workplace address). [ENUM-REF-CANDIDATE: residential|mailing|employer|temporary|seasonal|overseas — promote to reference' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:careOfName rdf:type rdf:Property ;
    rdfs:label 'Care Of Name' ;
    rdfs:comment 'Name of the individual or entity at the address to whom correspondence should be directed on behalf of the member (e.g., legal guardian, power of attorney, estate trustee).' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentRecordedDate rdf:type rdf:Property ;
    rdfs:label 'Consent Recorded Date' ;
    rdfs:comment 'Date on which the member\'s consent to use this address for correspondence and data processing was recorded. Supports GDPR and applicable privacy law consent management obligations.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contributorPool rdf:type rdf:Property ;
    rdfs:label 'Contributor Pool' ;
    rdfs:comment 'Identifies the pension contributor pool to which the member belongs (one per participating plan). Supports pool-specific correspondence and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPointBarcode rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Barcode' ;
    rdfs:comment 'Standardized postal delivery point barcode assigned by postal authority (USPS DPBC) to uniquely identify the physical delivery point. Supports automated mail sorting.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotMail rdf:type rdf:Property ;
    rdfs:label 'Do Not Mail' ;
    rdfs:comment 'Indicates that physical correspondence must not be sent to this address per member instruction, legal order, or returned mail policy. Overrides standard mailing workflows.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotMailReason rdf:type rdf:Property ;
    rdfs:label 'Do Not Mail Reason' ;
    rdfs:comment 'Reason code explaining why physical correspondence is suppressed for this address. Supports compliance audit trails and member communication management.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTo rdf:type rdf:Property ;
    rdfs:label 'Effective To' ;
    rdfs:comment 'Date on which this address record ceases to be valid. Null indicates the address is currently active. Enables historical address tracking for audit and compliance.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employerDepartment rdf:type rdf:Property ;
    rdfs:label 'Employer Department' ;
    rdfs:comment 'Government department, ministry, or organizational unit within the employer associated with the employer address. Supports employer-level reporting and contribution reconciliation.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerName rdf:type rdf:Property ;
    rdfs:label 'Employer Name' ;
    rdfs:comment 'Name of the employer associated with an employer address type. Applicable when address_type is employer; identifies the government department or agency where the member is employed.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:foreignAddressFlag rdf:type rdf:Property ;
    rdfs:label 'Foreign Address Flag' ;
    rdfs:comment 'Indicates whether this address is located outside the home country. Triggers additional regulatory, tax withholding, and foreign pension payment processing requirements.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMailingPreferred rdf:type rdf:Property ;
    rdfs:label 'Is Mailing Preferred' ;
    rdfs:comment 'Indicates whether this address is the member\'s preferred address for all pension correspondence, benefit statements, and regulatory notices.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimary rdf:type rdf:Property ;
    rdfs:label 'Is Primary' ;
    rdfs:comment 'Indicates whether this address is the primary address of its type for the member. Only one address per address type per member should be flagged as primary at any time.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:languagePreference rdf:type rdf:Property ;
    rdfs:label 'Language Preference' ;
    rdfs:comment 'Preferred official language for correspondence sent to this address (for example English or French). Supports language-of-correspondence obligations.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:latitude rdf:type rdf:Property ;
    rdfs:label 'Latitude' ;
    rdfs:comment 'Geographic latitude coordinate of the address in decimal degrees (WGS 84). Supports geospatial analytics, regional benefit distribution analysis, and member demographic mapping.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:longitude rdf:type rdf:Property ;
    rdfs:label 'Longitude' ;
    rdfs:comment 'Geographic longitude coordinate of the address in decimal degrees (WGS 84). Supports geospatial analytics, regional benefit distribution analysis, and member demographic mapping.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:poBox rdf:type rdf:Property ;
    rdfs:label 'Po Box' ;
    rdfs:comment 'Post office box number for members who receive mail at a PO Box rather than a civic street address. Used as an alternative delivery point.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ruralRoute rdf:type rdf:Property ;
    rdfs:label 'Rural Route' ;
    rdfs:comment 'Rural route or rural delivery route designator for members residing in rural areas not served by standard civic addressing (e.g., RR 2, SS 1).' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemCode rdf:type rdf:Property ;
    rdfs:label 'Source System Code' ;
    rdfs:comment 'Identifies the operational system of record from which this address record originated (e.g., SimCorp Dimension, SAP SuccessFactors, member self-service portal). Supports data lineage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemRef rdf:type rdf:Property ;
    rdfs:label 'Source System Ref' ;
    rdfs:comment 'The native identifier or record key assigned to this address in the originating source system (e.g., SimCorp party address ID, SAP SuccessFactors address sequence). Supports reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:standardizedAddress rdf:type rdf:Property ;
    rdfs:label 'Standardized Address' ;
    rdfs:comment 'Full address formatted according to postal authority standards (e.g., USPS or Royal Mail) as a single concatenated string. Generated post-verification for mail production and deduplication.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdictionCode rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction Code' ;
    rdfs:comment 'Tax jurisdiction code derived from the address location, used to determine applicable withholding tax rates and reporting obligations for pension benefit payments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:undeliverableDate rdf:type rdf:Property ;
    rdfs:label 'Undeliverable Date' ;
    rdfs:comment 'Date on which correspondence sent to this address was returned as undeliverable. Triggers member address update workflow and suppresses further mailings.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:undeliverableReason rdf:type rdf:Property ;
    rdfs:label 'Undeliverable Reason' ;
    rdfs:comment 'Reason code from postal authority or courier indicating why correspondence was returned undeliverable. Supports member tracing and address remediation workflows.' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationDate rdf:type rdf:Property ;
    rdfs:label 'Verification Date' ;
    rdfs:comment 'Date on which the address was last validated against a postal authority or third-party address verification service. Supports data quality monitoring.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationSource rdf:type rdf:Property ;
    rdfs:label 'Verification Source' ;
    rdfs:comment 'Identifies the system or method used to verify the address (e.g., USPS CASS, Royal Mail PAF, manual review). [ENUM-REF-CANDIDATE: usps_cass|royal_mail_paf|manual|member_self_service|employer_submission|third_party — promote to reference' ;
    rdfs:domain ind:MemberAddress ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStatus rdf:type rdf:Property ;
    rdfs:label 'Verification Status' ;
    rdfs:comment 'Indicates the outcome of address validation against postal authority databases (e.g., USPS CASS, Royal Mail PAF). Supports data quality management and undeliverable mail reduction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberContactId rdf:type rdf:Property ;
    rdfs:label 'Member Contact Id' ;
    rdfs:comment 'Unique surrogate identifier for each member contact record within the pension fund member contact master.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bounceCount rdf:type rdf:Property ;
    rdfs:label 'Bounce Count' ;
    rdfs:comment 'Cumulative number of delivery failures or bounces recorded against this contact record. Used to determine when to deactivate or flag a contact for re-verification.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:communicationFrequencyPref rdf:type rdf:Property ;
    rdfs:label 'Communication Frequency Pref' ;
    rdfs:comment 'Member\'s stated preference for how frequently they wish to receive communications via this contact channel. Governs outbound notification scheduling.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentEvidenceRef rdf:type rdf:Property ;
    rdfs:label 'Consent Evidence Ref' ;
    rdfs:comment 'Reference identifier or document locator for the consent evidence record (e.g., form ID, call recording reference) supporting the opt-in or opt-out decision.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentSource rdf:type rdf:Property ;
    rdfs:label 'Consent Source' ;
    rdfs:comment 'Channel or mechanism through which the member\'s communication consent was captured (e.g., member portal, paper form, call centre, employer submission).' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactStatus rdf:type rdf:Property ;
    rdfs:label 'Contact Status' ;
    rdfs:comment 'Current lifecycle status of the contact record indicating whether it is active, inactive, unverified, bounced (for email), or opted out by the member.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactSubtype rdf:type rdf:Property ;
    rdfs:label 'Contact Subtype' ;
    rdfs:comment 'Further classification of the contact record indicating its relationship context such as personal, business, emergency, legal guardian, or power of attorney.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactType rdf:type rdf:Property ;
    rdfs:label 'Contact Type' ;
    rdfs:comment 'Classification of the contact channel or medium (e.g., mobile, home phone, work phone, email, fax, postal address). [ENUM-REF-CANDIDATE: mobile|home_phone|work_phone|email|fax|postal_address — promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contactValue rdf:type rdf:Property ;
    rdfs:label 'Contact Value' ;
    rdfs:comment 'The actual contact detail for the given contact type (e.g., phone number, email address, or postal address string). Classified as restricted PII.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataRetentionCategory rdf:type rdf:Property ;
    rdfs:label 'Data Retention Category' ;
    rdfs:comment 'Retention classification applied to this contact record determining the applicable data retention schedule per regulatory and pension plan rules.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:doNotContact rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact' ;
    rdfs:comment 'Hard suppression flag indicating the member has explicitly requested no communications via this contact channel. Overrides all other opt-in preferences.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:doNotContactReason rdf:type rdf:Property ;
    rdfs:label 'Do Not Contact Reason' ;
    rdfs:comment 'Reason code explaining why the do-not-contact flag has been set (e.g., member request, legal hold, deceased, regulatory order). Required for compliance audit.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveFromDate rdf:type rdf:Property ;
    rdfs:label 'Effective From Date' ;
    rdfs:comment 'Date from which this contact record is considered valid and active for the member. Supports bi-temporal modelling of contact history for regulatory audit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveToDate rdf:type rdf:Property ;
    rdfs:label 'Effective To Date' ;
    rdfs:comment 'Date on which this contact record ceased to be valid. Null for currently active records. Supports bi-temporal history and superseded contact tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:emailDomain rdf:type rdf:Property ;
    rdfs:label 'Email Domain' ;
    rdfs:comment 'Domain portion of the email address (e.g., gmail.com, gov.uk) extracted for deliverability analytics and employer affiliation inference. Null for non-email contact types.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gdprLawfulBasis rdf:type rdf:Property ;
    rdfs:label 'Gdpr Lawful Basis' ;
    rdfs:comment 'GDPR Article 6 lawful basis under which this contact data is processed. Required for members subject to GDPR jurisdiction (e.g., UK, EU residents).' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isVerified rdf:type rdf:Property ;
    rdfs:label 'Is Verified' ;
    rdfs:comment 'Indicates whether this contact detail has been verified through a formal verification process (e.g., email confirmation link, phone OTP, postal confirmation letter).' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastBounceDate rdf:type rdf:Property ;
    rdfs:label 'Last Bounce Date' ;
    rdfs:comment 'Most recent date on which a communication attempt via this contact channel resulted in a delivery failure or bounce. Used to trigger contact re-verification workflows.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUsedDate rdf:type rdf:Property ;
    rdfs:label 'Last Used Date' ;
    rdfs:comment 'Most recent date on which this contact channel was used to successfully communicate with the member (e.g., statement delivered, notification sent). Supports contact hygiene.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optInDate rdf:type rdf:Property ;
    rdfs:label 'Opt In Date' ;
    rdfs:comment 'Date on which the member provided explicit consent to receive digital communications via this contact channel. Required for regulatory consent audit trail.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:optInDigital rdf:type rdf:Property ;
    rdfs:label 'Opt In Digital' ;
    rdfs:comment 'Indicates whether the member has opted in to receive digital communications (email, SMS) via this contact. Required for CASL and GDPR consent tracking.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:optOutDate rdf:type rdf:Property ;
    rdfs:label 'Opt Out Date' ;
    rdfs:comment 'Date on which the member withdrew consent or opted out of digital communications via this contact channel. Null if the member has not opted out.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:phoneCountryDialCode rdf:type rdf:Property ;
    rdfs:label 'Phone Country Dial Code' ;
    rdfs:comment 'International telephone country dialling prefix (e.g., +1, +44) applicable when contact_type is a phone-based channel. Null for non-phone contact types.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:phoneExtension rdf:type rdf:Property ;
    rdfs:label 'Phone Extension' ;
    rdfs:comment 'Internal telephone extension number appended to the main phone number for work phone contact types. Null for mobile, home, or non-phone contact types.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredChannel rdf:type rdf:Property ;
    rdfs:label 'Preferred Channel' ;
    rdfs:comment 'Indicates whether this contact record represents the member\'s preferred communication channel across all contact types for outbound member communications.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:purgeEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Purge Eligible Date' ;
    rdfs:comment 'Date on or after which this contact record is eligible for deletion or anonymisation under the applicable data retention schedule. Null if retention period has not elapsed.' ;
    rdfs:domain ind:MemberContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:verificationMethod rdf:type rdf:Property ;
    rdfs:label 'Verification Method' ;
    rdfs:comment 'Method used to verify the contact detail (e.g., email confirmation link, SMS one-time password, postal letter, call centre agent confirmation). Null if not yet verified.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionRateId rdf:type rdf:Property ;
    rdfs:label 'Contribution Rate Id' ;
    rdfs:comment 'Unique surrogate identifier for a contribution rate schedule record within the pension fund system.' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialValuationYear rdf:type rdf:Property ;
    rdfs:label 'Actuarial Valuation Year' ;
    rdfs:comment 'The year of the actuarial valuation report that determined or last confirmed this contribution rate, linking the rate to its actuarial basis.' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:earningsThresholdLower rdf:type rdf:Property ;
    rdfs:label 'Earnings Threshold Lower' ;
    rdfs:comment 'The lower bound of the pensionable earnings band (in the plan currency) to which this rate tier applies. Null or zero indicates no lower bound.' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earningsThresholdUpper rdf:type rdf:Property ;
    rdfs:label 'Earnings Threshold Upper' ;
    rdfs:comment 'The upper bound of the pensionable earnings band (in the plan currency) to which this rate tier applies. Null indicates no upper cap (top tier).' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateCode rdf:type rdf:Property ;
    rdfs:label 'Rate Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this contribution rate schedule, used in regulatory filings and system integrations.' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateName rdf:type rdf:Property ;
    rdfs:label 'Rate Name' ;
    rdfs:comment 'Human-readable name describing the contribution rate schedule (e.g., \'Plan 1 Tier 1 Employee Rate 2024\').' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratePercent rdf:type rdf:Property ;
    rdfs:label 'Rate Percent' ;
    rdfs:comment 'The contribution rate expressed as a decimal percentage of pensionable earnings (e.g., 0.0895 = 8.95%). This is the principal quantitative fact of the rate schedule.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rateStatus rdf:type rdf:Property ;
    rdfs:label 'Rate Status' ;
    rdfs:comment 'Current lifecycle status of the rate schedule: active (in force), pending (approved but not yet effective), superseded (replaced by a newer schedule), or withdrawn.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateTier rdf:type rdf:Property ;
    rdfs:label 'Rate Tier' ;
    rdfs:comment 'Tier label or band designation within a tiered rate structure (e.g., \'Tier 1\', \'Tier 2\', \'Tier 3\') based on pensionable earnings thresholds. [ENUM-REF-CANDIDATE: tier_1|tier_2|tier_3|tier_4|tier_5|tier_6|tier_7 — promote to reference product]' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rateType rdf:type rdf:Property ;
    rdfs:label 'Rate Type' ;
    rdfs:comment 'Indicates whether this rate applies to the employee (member) contribution, the employer  contribution, or a combined rate.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByRateCode rdf:type rdf:Property ;
    rdfs:label 'Superseded By Rate Code' ;
    rdfs:comment 'The rate_code of the successor contribution rate schedule that replaced this record when rate_status is superseded. Null if not superseded.' ;
    rdfs:domain ind:ContributionRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceBuybackId rdf:type rdf:Property ;
    rdfs:label 'Service Buyback Id' ;
    rdfs:comment 'Unique surrogate identifier for a service buyback election record. Primary key for this transactional entity.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assumptionSetId rdf:type rdf:Property ;
    rdfs:label 'Assumption Set Id' ;
    rdfs:comment 'Foreign key linking to actuarial.assumption_set. Business justification: Service buyback actuarial costs are calculated using specific discount rates and mortality assumptions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssumptionSet .

ind:actuarialCostAmount rdf:type rdf:Property ;
    rdfs:label 'Actuarial Cost Amount' ;
    rdfs:comment 'Total actuarially determined cost for the member to purchase the specified service credits, calculated by the pension fund\'s actuaries based on age, salary, and service factors.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialCostBasis rdf:type rdf:Property ;
    rdfs:label 'Actuarial Cost Basis' ;
    rdfs:comment 'Actuarial methodology used to calculate the buyback cost: prospective (future benefit cost), retrospective (past contributions with interest), or blended.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Actuarial Cost Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the actuarial cost amount is denominated (e.g., USD, GBP).' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialValuationDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Valuation Date' ;
    rdfs:comment 'The reference date used by the actuary to calculate the cost of the buyback, reflecting salary and demographic assumptions as of that date.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:applicationReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Application Received Timestamp' ;
    rdfs:comment 'Exact date and time the member\'s buyback application was received and recorded in the pension administration system.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:buybackReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Buyback Reference Number' ;
    rdfs:comment 'Externally-known unique alphanumeric reference number assigned to this buyback election, used in member correspondence and administrative processing.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buybackStatus rdf:type rdf:Property ;
    rdfs:label 'Buyback Status' ;
    rdfs:comment 'Current lifecycle status of the buyback election, tracking progression from member application through actuarial costing, payment, and credit posting. [ENUM-REF-CANDIDATE: pending|approved|in_progress|completed|cancelled|rejected — promote to reference' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationDate rdf:type rdf:Property ;
    rdfs:label 'Cancellation Date' ;
    rdfs:comment 'Date on which the buyback election was cancelled, either by member withdrawal or administrative rejection. Null if not cancelled.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancellationReason rdf:type rdf:Property ;
    rdfs:label 'Cancellation Reason' ;
    rdfs:comment 'Reason code for cancellation of the buyback election, used for administrative reporting and member communication. [ENUM-REF-CANDIDATE: member_withdrawal|payment_default|ineligibility_determined|plan_rule_change|administrative_error|other — promote to' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completionDate rdf:type rdf:Property ;
    rdfs:label 'Completion Date' ;
    rdfs:comment 'Date on which all buyback payments were received in full and the pensionable service credits were formally posted to the member\'s record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionDate rdf:type rdf:Property ;
    rdfs:label 'Election Date' ;
    rdfs:comment 'The date on which the member formally elected to purchase additional pensionable service credits, establishing the effective date for actuarial cost calculation.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verification Date' ;
    rdfs:comment 'Date on which the member\'s eligibility for the buyback was formally verified and confirmed by the pension administration team.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eligibilityVerified rdf:type rdf:Property ;
    rdfs:label 'Eligibility Verified' ;
    rdfs:comment 'Indicates whether the member\'s eligibility for this buyback has been formally verified by the pension administration team against plan rules and service records.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glAccountCode rdf:type rdf:Property ;
    rdfs:label 'Gl Account Code' ;
    rdfs:comment 'Oracle Financials GL account code to which the buyback contribution receipts are posted for pension fund accounting and financial reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:installmentAmount rdf:type rdf:Property ;
    rdfs:label 'Installment Amount' ;
    rdfs:comment 'Amount of each periodic installment payment when the member elects an installment payment plan for the buyback.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:installmentCount rdf:type rdf:Property ;
    rdfs:label 'Installment Count' ;
    rdfs:comment 'Total number of installment payments agreed upon when the member elects an installment payment method for the buyback. Null if lump sum.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:installmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Installment Frequency' ;
    rdfs:comment 'Frequency of installment payments when the member elects a periodic payment plan for the buyback cost.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestAccruedAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Accrued Amount' ;
    rdfs:comment 'Total interest accrued on the outstanding buyback balance to date, added to the member\'s obligation when payment is deferred beyond the election date.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRate rdf:type rdf:Property ;
    rdfs:label 'Interest Rate' ;
    rdfs:comment 'Annual interest rate applied to deferred or installment buyback payments, as prescribed by plan rules or actuarial assumptions (e.g., based on SOFR or plan-specific rate).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberAgeAtElection rdf:type rdf:Property ;
    rdfs:label 'Member Age At Election' ;
    rdfs:comment 'Member\'s age in years (to two decimal places) at the time of the buyback election, a key actuarial input for cost determination.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Member Contribution Amount' ;
    rdfs:comment 'Total amount the member is required to contribute (employee share) toward the buyback cost, net of any employer or government subsidy.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance Amount' ;
    rdfs:comment 'Remaining unpaid balance on the buyback cost, calculated as actuarial cost minus total paid amount. Drives collection and reminder workflows.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Payment Deadline Date' ;
    rdfs:comment 'Final date by which the member must complete all buyback payments to secure the pensionable service credits, as stipulated in the buyback agreement.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Pension Adjustment Amount' ;
    rdfs:comment 'Pension Adjustment amount reported to tax authorities reflecting the value of the pension benefit accrued through the buyback, reducing the member\'s tax-advantaged contribution room.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorServiceEndDate rdf:type rdf:Property ;
    rdfs:label 'Prior Service End Date' ;
    rdfs:comment 'End date of the prior non-contributory service period being purchased as pensionable service credits.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorServiceStartDate rdf:type rdf:Property ;
    rdfs:label 'Prior Service Start Date' ;
    rdfs:comment 'Start date of the prior non-contributory service period being purchased as pensionable service credits.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorServiceType rdf:type rdf:Property ;
    rdfs:label 'Prior Service Type' ;
    rdfs:comment 'Classification of the non-contributory prior service period being purchased, determining eligibility rules and actuarial cost methodology. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryUsedForCosting rdf:type rdf:Property ;
    rdfs:label 'Salary Used For Costing' ;
    rdfs:comment 'Annual salary figure used as the basis for actuarial cost calculation of the buyback, typically the member\'s salary at the election date or a plan-defined reference salary.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceCreditPostedDate rdf:type rdf:Property ;
    rdfs:label 'Service Credit Posted Date' ;
    rdfs:comment 'Date on which the purchased pensionable service credits were officially recorded in the member\'s service history, updating entitlement calculations.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceCreditsPurchasedYears rdf:type rdf:Property ;
    rdfs:label 'Service Credits Purchased Years' ;
    rdfs:comment 'Total number of pensionable service years being purchased through this buyback election, expressed as a decimal fraction of a year.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemReference rdf:type rdf:Property ;
    rdfs:label 'Source System Reference' ;
    rdfs:comment 'Identifier of the originating pension administration system record (e.g., SimCorp Dimension member record ID) from which this buyback data was sourced.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Reference' ;
    rdfs:comment 'Reference identifier for supporting documentation (e.g., leave records, prior employment verification, military service records) submitted with the buyback application.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxReceiptIssued rdf:type rdf:Property ;
    rdfs:label 'Tax Receipt Issued' ;
    rdfs:comment 'Indicates whether a tax receipt (e.g., pension adjustment or retirement contribution receipt) has been issued to the member for the buyback payment.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReceiptYear rdf:type rdf:Property ;
    rdfs:label 'Tax Receipt Year' ;
    rdfs:comment 'Tax year for which the buyback tax receipt was issued to the member, used for annual tax reporting and reconciliation.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Paid Amount' ;
    rdfs:comment 'Cumulative amount received from the member to date against the total buyback cost, used to track payment progress and outstanding balance.' ;
    rdfs:domain ind:ServiceBuyback ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferInId rdf:type rdf:Property ;
    rdfs:label 'Transfer In Id' ;
    rdfs:comment 'Unique surrogate identifier for each pension transfer-in transaction record within the fund.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amlScreened rdf:type rdf:Property ;
    rdfs:label 'Aml Screened' ;
    rdfs:comment 'Indicates whether the transfer-in has been screened against AML/CTF watchlists and sanctions lists as required by the financial intelligence unit and FATF standards.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commutedValue rdf:type rdf:Property ;
    rdfs:label 'Commuted Value' ;
    rdfs:comment 'Actuarially determined lump-sum present value of the member\'s accrued pension entitlement from the source plan, as calculated per actuarial standards body standards.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAuthorityApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Approval Date' ;
    rdfs:comment 'Date on which the tax authority granted approval for the transfer-in, where such approval was required.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxAuthorityApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Approval Reference' ;
    rdfs:comment 'Reference number issued by the tax authority confirming approval of the transfer-in transaction.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAuthorityApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Tax Authority Approval Required' ;
    rdfs:comment 'Indicates whether the tax authority approval is required for this transfer-in, typically applicable for past service pension adjustments exceeding thresholds.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:custodianReference rdf:type rdf:Property ;
    rdfs:label 'Custodian Reference' ;
    rdfs:comment 'Reference number assigned by the fund\'s custodian (State Street / Northern Trust) to the settlement of the transfer-in receipt.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountRate rdf:type rdf:Property ;
    rdfs:label 'Discount Rate' ;
    rdfs:comment 'Annualized discount rate applied by the source plan actuary to calculate the commuted value of the member\'s accrued pension benefit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveDate rdf:type rdf:Property ;
    rdfs:label 'Effective Date' ;
    rdfs:comment 'The date from which the transferred service credits or assets are recognized as effective within the receiving pension plan for benefit entitlement purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fxRate rdf:type rdf:Property ;
    rdfs:label 'Fx Rate' ;
    rdfs:comment 'Exchange rate applied to convert the transfer amount from the transfer currency to the base currency on the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPostingReference rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Reference' ;
    rdfs:comment 'Reference to the General Ledger (GL) journal entry in Oracle Financials recording the receipt of the transfer-in assets in the fund\'s accounting books.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentEarningsAmount rdf:type rdf:Property ;
    rdfs:label 'Investment Earnings Amount' ;
    rdfs:comment 'Portion of the transferred amount attributable to accumulated investment earnings on contributions in the source plan.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lockedInFlag rdf:type rdf:Property ;
    rdfs:label 'Locked In Flag' ;
    rdfs:comment 'Indicates whether the transferred assets are subject to locked-in restrictions under applicable pension legislation, preventing early withdrawal.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberConsentDate rdf:type rdf:Property ;
    rdfs:label 'Member Consent Date' ;
    rdfs:comment 'Date on which the member provided written consent authorizing the transfer-in from the source plan to the receiving fund.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pastServicePensionAdjustment rdf:type rdf:Property ;
    rdfs:label 'Past Service Pension Adjustment' ;
    rdfs:comment 'Past Service Pension Adjustment amount arising from the recognition of prior service credits, reducing the member\'s available tax-advantaged contribution room.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionAdjustmentReversal rdf:type rdf:Property ;
    rdfs:label 'Pension Adjustment Reversal' ;
    rdfs:comment 'Pension Adjustment Reversal amount reported to the tax authority when a member terminates from the source DB plan, restoring tax-advantaged contribution room.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portabilityElectionType rdf:type rdf:Property ;
    rdfs:label 'Portability Election Type' ;
    rdfs:comment 'Indicates whether the member elected to transfer the full commuted value or only a partial amount from the source plan.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receiptDate rdf:type rdf:Property ;
    rdfs:label 'Receipt Date' ;
    rdfs:comment 'The date on which the fund physically received the transferred assets or funds from the source plan, as confirmed by the custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceNumber rdf:type rdf:Property ;
    rdfs:label 'Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this transfer-in transaction, used for reconciliation with the source plan and custodian.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReason rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason' ;
    rdfs:comment 'Reason code or description explaining why the transfer-in was rejected or cancelled, populated only when transfer_status is rejected or cancelled.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceCreditYears rdf:type rdf:Property ;
    rdfs:label 'Service Credit Years' ;
    rdfs:comment 'Number of years of pensionable service credited to the member in the receiving plan as a result of this transfer-in, expressed as a decimal.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:simcorpTransactionReference rdf:type rdf:Property ;
    rdfs:label 'Simcorp Transaction Reference' ;
    rdfs:comment 'Transaction identifier assigned by SimCorp Dimension (ABOR/Investment Accounting module) upon posting of the transfer-in receipt.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanAdministrator rdf:type rdf:Property ;
    rdfs:label 'Source Plan Administrator' ;
    rdfs:comment 'Name of the plan administrator or financial institution responsible for the source pension plan from which assets are being transferred.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanConfirmationRef rdf:type rdf:Property ;
    rdfs:label 'Source Plan Confirmation Ref' ;
    rdfs:comment 'Reference number or document identifier from the source plan administrator confirming the release and transfer of the member\'s pension entitlement.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Source Plan Jurisdiction' ;
    rdfs:comment 'Regulatory jurisdiction governing the source pension plan (e.g., CAN, ON, BC, FED) under which the transfer is being executed.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanName rdf:type rdf:Property ;
    rdfs:label 'Source Plan Name' ;
    rdfs:comment 'Full legal name of the pension plan or retirement account from which the assets or service credits are being transferred.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Source Plan Registration Number' ;
    rdfs:comment 'Government-issued registration number of the source pension plan as assigned by the tax authority or applicable regulator.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcePlanType rdf:type rdf:Property ;
    rdfs:label 'Source Plan Type' ;
    rdfs:comment 'Classification of the originating plan: Defined Benefit (DB), Defined Contribution (DC), individual retirement account, group retirement savings plan, or profit-sharing plan.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Withheld Amount' ;
    rdfs:comment 'Amount of withholding tax deducted from the transfer by the source plan administrator prior to remittance, if applicable.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferAmount rdf:type rdf:Property ;
    rdfs:label 'Transfer Amount' ;
    rdfs:comment 'Gross monetary value of the assets transferred into the fund from the source plan, expressed in the transfer currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferAmountBaseEquivalent rdf:type rdf:Property ;
    rdfs:label 'Transfer Amount Base Equivalent' ;
    rdfs:comment 'Gross monetary value of the transfer-in converted to national Dollars (Base Currency) at the applicable FX rate on the valuation date, used for fund-level reporting.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferCurrency rdf:type rdf:Property ;
    rdfs:label 'Transfer Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the currency in which the transfer amount is denominated (e.g., USD).' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferDate rdf:type rdf:Property ;
    rdfs:label 'Transfer Date' ;
    rdfs:comment 'The date on which the transfer-in transaction was formally initiated and submitted by the source plan administrator.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferMethod rdf:type rdf:Property ;
    rdfs:label 'Transfer Method' ;
    rdfs:comment 'Mechanism by which the transfer assets were physically remitted to the fund: wire transfer, cheque, in-kind asset transfer, or electronic funds transfer (EFT).' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferStatus rdf:type rdf:Property ;
    rdfs:label 'Transfer Status' ;
    rdfs:comment 'Current lifecycle state of the transfer-in transaction from initiation through to final receipt and posting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferType rdf:type rdf:Property ;
    rdfs:label 'Transfer Type' ;
    rdfs:comment 'Classification of the transfer-in by mechanism: commuted value from a defined benefit plan, service credit recognition, retirement savings account conversion, direct plan-to-plan transfer, or group transfer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Date' ;
    rdfs:comment 'The date used to determine the commuted value or asset value of the transferred pension entitlement from the source plan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingStatus rdf:type rdf:Property ;
    rdfs:label 'Vesting Status' ;
    rdfs:comment 'Vesting status of the member\'s entitlement in the source plan at the time of transfer, determining the transferable benefit amount.' ;
    rdfs:domain ind:TransferIn ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferOutId rdf:type rdf:Property ;
    rdfs:label 'Transfer Out Id' ;
    rdfs:comment 'Unique surrogate identifier for each pension transfer-out transaction record within the fund\'s IBOR/ABOR system.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accruedServiceYears rdf:type rdf:Property ;
    rdfs:label 'Accrued Service Years' ;
    rdfs:comment 'The total years of pensionable service accrued by the member as at the termination date, used as the basis for the commuted value actuarial calculation.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amlCleared rdf:type rdf:Property ;
    rdfs:label 'Aml Cleared' ;
    rdfs:comment 'Indicates whether the transfer-out transaction has passed the required Anti-Money Laundering (AML) and Know Your Customer (KYC) screening prior to fund disbursement.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amlReviewDate rdf:type rdf:Property ;
    rdfs:label 'Aml Review Date' ;
    rdfs:comment 'The date on which the Anti-Money Laundering (AML) and KYC review was completed for this transfer-out transaction.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baseCurrencyAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Amount' ;
    rdfs:comment 'The total commuted value transfer amount expressed in the fund\'s base currency (Base Currency), after applying the applicable FX rate for cross-currency transfers.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bestAverageSalary rdf:type rdf:Property ;
    rdfs:label 'Best Average Salary' ;
    rdfs:comment 'The member\'s best average salary figure used in the defined benefit formula to determine the accrued pension entitlement underlying the commuted value calculation.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutedValueAmount rdf:type rdf:Property ;
    rdfs:label 'Commuted Value Amount' ;
    rdfs:comment 'The actuarially determined commuted value (CV) of the member\'s accrued pension entitlement as at the valuation date, representing the lump-sum equivalent of the deferred pension.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electionDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Election Deadline Date' ;
    rdfs:comment 'The statutory or plan-rule deadline by which the member must elect the transfer-out option; failure to elect by this date may result in a deferred pension default.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:initiatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Initiated Timestamp' ;
    rdfs:comment 'The date and time when the transfer-out transaction was first created in the pension administration system, serving as the primary audit creation timestamp.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isCrossBorder rdf:type rdf:Property ;
    rdfs:label 'Is Cross Border' ;
    rdfs:comment 'Indicates whether the transfer-out involves a cross-border remittance to a foreign registered pension plan, triggering additional regulatory and FX requirements.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberConsentRef rdf:type rdf:Property ;
    rdfs:label 'Member Consent Ref' ;
    rdfs:comment 'Reference to the signed member consent or election form authorizing the transfer-out, stored in the document management system for audit and compliance purposes.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mortalityTableCode rdf:type rdf:Property ;
    rdfs:label 'Mortality Table Code' ;
    rdfs:comment 'The actuarial mortality table code (e.g., RP-2014, UP-94) used in the commuted value calculation to project member life expectancy.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingCountryCode rdf:type rdf:Property ;
    rdfs:label 'Receiving Country Code' ;
    rdfs:comment 'The ISO 3166-1 alpha-3 country code of the jurisdiction where the receiving registered plan is domiciled, required for cross-border transfer regulatory reporting.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingInstitutionLei rdf:type rdf:Property ;
    rdfs:label 'Receiving Institution Lei' ;
    rdfs:comment 'The 20-character ISO 17442 Legal Entity Identifier (LEI) of the receiving financial institution, used for counterparty identification and regulatory reporting.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Receiving Institution Name' ;
    rdfs:comment 'The name of the financial institution or pension plan administrator receiving the transferred commuted value funds on behalf of the member.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingPlanNumber rdf:type rdf:Property ;
    rdfs:label 'Receiving Plan Number' ;
    rdfs:comment 'The account or plan registration number at the receiving institution to which the commuted value funds are directed. Classified as confidential financial data.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:receivingPlanType rdf:type rdf:Property ;
    rdfs:label 'Receiving Plan Type' ;
    rdfs:comment 'Type of registered plan or account to which the commuted value is being transferred (e.g., locked-in retirement account, another pension plan). [ENUM-REF-CANDIDATE: IRA|locked_in_account|DC_PLAN|DB_PLAN|foreign_pension — promote to reference product]' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredTransferAmount rdf:type rdf:Property ;
    rdfs:label 'Registered Transfer Amount' ;
    rdfs:comment 'The portion of the commuted value transferred on a tax-sheltered basis directly into the member\'s registered receiving plan (locked-in account, another pension plan, etc.), net of any taxable portion.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryFilingRef rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Ref' ;
    rdfs:comment 'The reference number of the regulatory filing or notification submitted to the applicable pension regulator (e.g., the national pension regulator) in connection with this transfer-out.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementInstructionsRef rdf:type rdf:Property ;
    rdfs:label 'Settlement Instructions Ref' ;
    rdfs:comment 'Reference to the Standard Settlement Instructions (SSI) on file for the receiving institution, used to route the wire transfer or EFT payment accurately.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxSlipIssued rdf:type rdf:Property ;
    rdfs:label 'Tax Slip Issued' ;
    rdfs:comment 'Indicates whether the required tax reporting slip (e.g., an annual pension income slip) has been issued to the member for the taxable portion of the commuted value transfer.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxSlipYear rdf:type rdf:Property ;
    rdfs:label 'Tax Slip Year' ;
    rdfs:comment 'The tax year for which the tax reporting slip is issued to the member, corresponding to the calendar year in which the commuted value transfer was executed.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taxablePortionAmount rdf:type rdf:Property ;
    rdfs:label 'Taxable Portion Amount' ;
    rdfs:comment 'The portion of the commuted value that exceeds the registered plan contribution room and is subject to withholding tax, payable directly to the member.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationDate rdf:type rdf:Property ;
    rdfs:label 'Termination Date' ;
    rdfs:comment 'The date on which the member\'s pensionable employment ended, triggering eligibility for the transfer-out option under the plan rules.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transferReason rdf:type rdf:Property ;
    rdfs:label 'Transfer Reason' ;
    rdfs:comment 'The reason code for the transfer-out, indicating whether the member voluntarily resigned, was involuntarily terminated, or is transferring between registered plans.' ;
    rdfs:domain ind:TransferOut ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount' ;
    rdfs:comment 'The amount of income tax withheld at source on the taxable portion of the commuted value transfer, remitted to the relevant tax authority on behalf of the member.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementElectionId rdf:type rdf:Property ;
    rdfs:label 'Retirement Election Id' ;
    rdfs:comment 'Unique surrogate identifier for the retirement election record. Primary key for the retirement_election data product in the beneficiary domain.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:beneficiaryId rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Id' ;
    rdfs:comment 'Reference to the pension plan member (beneficiary) who submitted this retirement election. Links to the beneficiary master record.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DesignatedBeneficiary .

ind:survivorDesignatedBeneficiaryId rdf:type rdf:Property ;
    rdfs:label 'Survivor Designated Beneficiary Id' ;
    rdfs:comment 'Reference to the designated survivor or beneficiary record who will receive survivor pension benefits upon the member\'s death under the elected pension option.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DesignatedBeneficiary .

ind:administratorNotes rdf:type rdf:Property ;
    rdfs:label 'Administrator Notes' ;
    rdfs:comment 'Free-text notes entered by the pension administrator during review and processing of the retirement election, capturing exceptions, clarifications, or special circumstances.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedDate rdf:type rdf:Property ;
    rdfs:label 'Approved Date' ;
    rdfs:comment 'The date on which the retirement election was formally approved by the pension administrator, triggering commencement of benefit payment processing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bankAccountReference rdf:type rdf:Property ;
    rdfs:label 'Bank Account Reference' ;
    rdfs:comment 'Masked or tokenized reference to the member\'s bank account designated for direct deposit of pension payments. Full account details held in secure payment system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bestAverageEarnings rdf:type rdf:Property ;
    rdfs:label 'Best Average Earnings' ;
    rdfs:comment 'The member\'s highest average pensionable earnings over the defined averaging period (typically best 5 years), used as the salary base in the defined benefit pension formula.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bridgeBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Bridge Benefit Amount' ;
    rdfs:comment 'Annual amount of the bridge benefit payable to the member until state pension eligibility, if bridge benefit was elected. Ceases at the bridge benefit end date.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bridgeBenefitElected rdf:type rdf:Property ;
    rdfs:label 'Bridge Benefit Elected' ;
    rdfs:comment 'Indicates whether the member elected to receive a bridge benefit (temporary supplement payable until state pension eligibility age) as part of their retirement package.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeBenefitEndDate rdf:type rdf:Property ;
    rdfs:label 'Bridge Benefit End Date' ;
    rdfs:comment 'The date on which the bridge benefit ceases, typically when the member reaches state pension eligibility age (age 65) or upon earlier death.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commutationAmount rdf:type rdf:Property ;
    rdfs:label 'Commutation Amount' ;
    rdfs:comment 'The lump-sum transfer value amount elected by the member for commutation of a portion of their defined benefit pension entitlement.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationElected rdf:type rdf:Property ;
    rdfs:label 'Commutation Elected' ;
    rdfs:comment 'Indicates whether the member elected to commute a portion of their pension to a lump-sum transfer value, reducing the ongoing annuity amount.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disabilityCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Disability Certification Date' ;
    rdfs:comment 'The date on which the member\'s disability was formally certified by a qualified medical authority, required for disability retirement type elections.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:earlyRetirementReductionRate rdf:type rdf:Property ;
    rdfs:label 'Early Retirement Reduction Rate' ;
    rdfs:comment 'The actuarial reduction rate applied per year of early retirement before the normal retirement age, expressed as a decimal (e.g., 0.0300 for 3% per year).' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveRetirementDate rdf:type rdf:Property ;
    rdfs:label 'Effective Retirement Date' ;
    rdfs:comment 'The date on which the member\'s active service ends and pension drawdown commences. Used as the anchor date for actuarial liability calculations and first payment determination.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionChannel rdf:type rdf:Property ;
    rdfs:label 'Election Channel' ;
    rdfs:comment 'The channel through which the member submitted the retirement election: online member portal, paper form, in-person at a service centre, or telephone.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionFormVersion rdf:type rdf:Property ;
    rdfs:label 'Election Form Version' ;
    rdfs:comment 'Version identifier of the retirement election form used by the member, ensuring the correct plan rules and options were presented at the time of election.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Election Received Date' ;
    rdfs:comment 'The date the pension administrator physically or electronically received the completed retirement election form from the member.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:electionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Election Reference Number' ;
    rdfs:comment 'Externally-known unique business reference number assigned to this retirement election, used in member correspondence and administrative processing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionStatus rdf:type rdf:Property ;
    rdfs:label 'Election Status' ;
    rdfs:comment 'Current workflow lifecycle state of the retirement election from initial submission through administrative approval or rejection.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionSubmittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Election Submitted Timestamp' ;
    rdfs:comment 'Date and time when the member formally submitted the retirement election to the pension administrator. Principal business event timestamp for this transaction.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:firstPaymentDate rdf:type rdf:Property ;
    rdfs:label 'First Payment Date' ;
    rdfs:comment 'The scheduled date of the first pension benefit payment to the member following retirement election approval.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossAnnualPension rdf:type rdf:Property ;
    rdfs:label 'Gross Annual Pension' ;
    rdfs:comment 'The calculated gross annual pension benefit payable to the member before any reductions, indexation, or survivor benefit adjustments.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:guaranteedPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Guaranteed Period Years' ;
    rdfs:comment 'Number of years for which pension payments are guaranteed regardless of the member\'s death, applicable when the guaranteed period pension option is elected (e.g., 5, 10, 15 years).' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isIrrevocable rdf:type rdf:Property ;
    rdfs:label 'Is Irrevocable' ;
    rdfs:comment 'Indicates whether the retirement election has been finalized and is irrevocable. Once set to true, the pension option and retirement date cannot be changed.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberAgeAtRetirement rdf:type rdf:Property ;
    rdfs:label 'Member Age At Retirement' ;
    rdfs:comment 'The member\'s age in whole years as of the effective retirement date. Used for actuarial factor selection and early retirement penalty determination.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:memberConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Member Consent Obtained' ;
    rdfs:comment 'Indicates whether the member provided informed consent to the pension option elected, including acknowledgement of irrevocability and survivor benefit implications.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Member Date Of Birth' ;
    rdfs:comment 'The member\'s date of birth, required for actuarial age verification, normal retirement age eligibility determination, and benefit calculation.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionableServiceYears rdf:type rdf:Property ;
    rdfs:label 'Pensionable Service Years' ;
    rdfs:comment 'Total years of pensionable service credited to the member at the time of retirement election, including any purchased or transferred service. Core input to benefit formula.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reducedAnnualPension rdf:type rdf:Property ;
    rdfs:label 'Reduced Annual Pension' ;
    rdfs:comment 'The annual pension amount after applying any early retirement actuarial reduction factors or pension option reduction for survivor benefits.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retirementType rdf:type rdf:Property ;
    rdfs:label 'Retirement Type' ;
    rdfs:comment 'Classification of the retirement basis: normal age retirement, early retirement, deferred retirement, disability retirement, or involuntary separation. Drives entitlement calculation rules.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spousalConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Spousal Consent Obtained' ;
    rdfs:comment 'Indicates whether spousal or common-law partner consent was obtained for the pension option elected, as required by pension legislation when waiving survivor benefits.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:survivorDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Survivor Date Of Birth' ;
    rdfs:comment 'Date of birth of the designated survivor, required for actuarial reduction factor calculation when a joint and survivor pension option is elected.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxWithholdingCode rdf:type rdf:Property ;
    rdfs:label 'Tax Withholding Code' ;
    rdfs:comment 'The tax withholding instruction code applied to pension payments, reflecting the member\'s elected withholding rate or exemption status for income tax purposes.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferDestination rdf:type rdf:Property ;
    rdfs:label 'Transfer Destination' ;
    rdfs:comment 'The registered account or vehicle to which the commuted lump-sum transfer value is directed (e.g., retirement savings account, locked-in account, retirement income fund). Applicable only when commutation is elected.' ;
    rdfs:domain ind:RetirementElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexationAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Indexation Adjustment Id' ;
    rdfs:comment 'Unique surrogate identifier for each indexation adjustment record applied to a pension benefit payment. Primary key for this transactional entity.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:macroIndicatorId rdf:type rdf:Property ;
    rdfs:label 'Macro Indicator Id' ;
    rdfs:comment 'Foreign key linking to research.macro_indicator. Business justification: Annual pension indexation process requires linking adjustments to the specific CPI/inflation macro indicator used.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MacroIndicator .

ind:supersededByAdjustmentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Adjustment Id' ;
    rdfs:comment 'Reference to the replacement indexation adjustment record that supersedes this one in the event of a correction or recalculation. Null if this record is current and active.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Adjustment .

ind:actuarialBasisCode rdf:type rdf:Property ;
    rdfs:label 'Actuarial Basis Code' ;
    rdfs:comment 'Code identifying the actuarial valuation basis or methodology under which this indexation adjustment was calculated, linking to the applicable actuarial assumptions set. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustedBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Adjusted Benefit Amount' ;
    rdfs:comment 'The gross annual or monthly pension benefit amount payable to the beneficiary after this indexation adjustment is applied. Represents the new benefit entitlement post-adjustment.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Adjustment Amount' ;
    rdfs:comment 'The absolute monetary increase (or decrease) in the benefit payment resulting from this indexation adjustment. Equals adjusted_benefit_amount minus prior_benefit_amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reference Number' ;
    rdfs:comment 'Externally-known unique business reference number assigned to this indexation adjustment event, used for audit trails, member communications, and regulatory reporting.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentStatus rdf:type rdf:Property ;
    rdfs:label 'Adjustment Status' ;
    rdfs:comment 'Current lifecycle state of the indexation adjustment record, tracking workflow from initial calculation through approval, application, and any subsequent reversal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adjustmentYear rdf:type rdf:Property ;
    rdfs:label 'Adjustment Year' ;
    rdfs:comment 'The calendar year for which this indexation adjustment is applicable (e.g., 2024). Used for annual reporting, actuarial valuations, and regulatory submissions.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:announcementDate rdf:type rdf:Property ;
    rdfs:label 'Announcement Date' ;
    rdfs:comment 'The date on which the indexation rate for the applicable period was officially announced or published by the plan administrator or governing authority.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appliedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Applied Timestamp' ;
    rdfs:comment 'The precise date and time at which the indexation adjustment was applied to the beneficiary\'s benefit payment record in the system of record (SimCorp Dimension).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:costCentreCode rdf:type rdf:Property ;
    rdfs:label 'Cost Centre Code' ;
    rdfs:comment 'The organizational cost centre code to which the incremental pension liability cost from this indexation adjustment is allocated for management accounting and budget reporting.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cpiMeasureUsed rdf:type rdf:Property ;
    rdfs:label 'Cpi Measure Used' ;
    rdfs:comment 'The specific Consumer Price Index (CPI) measure used to derive the indexation rate, as defined in the plan rules (e.g., All-Items CPI, Core CPI). Determines the inflation benchmark.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexationCapRate rdf:type rdf:Property ;
    rdfs:label 'Indexation Cap Rate' ;
    rdfs:comment 'The maximum indexation rate permitted under the plan rules for this adjustment cycle, expressed as a decimal. Constrains the applied rate when CPI exceeds the plan-defined ceiling.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationFloorRate rdf:type rdf:Property ;
    rdfs:label 'Indexation Floor Rate' ;
    rdfs:comment 'The minimum indexation rate permitted under the plan rules for this adjustment cycle, expressed as a decimal. Protects beneficiaries from negative adjustments in deflationary periods.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isRateCapped rdf:type rdf:Property ;
    rdfs:label 'Is Rate Capped' ;
    rdfs:comment 'Indicates whether the applied indexation rate was constrained by the plan-defined cap (True) or reflects the full CPI-derived rate (False). Supports actuarial and regulatory analysis.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRateFloored rdf:type rdf:Property ;
    rdfs:label 'Is Rate Floored' ;
    rdfs:comment 'Indicates whether the applied indexation rate was constrained by the plan-defined floor (True) or reflects the full CPI-derived rate (False). Supports actuarial and regulatory analysis.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liabilityImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Liability Impact Amount' ;
    rdfs:comment 'The estimated change in the present value of the defined benefit obligation (DBO) attributable to this indexation adjustment, used for actuarial liability matching and ALM reporting.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationDate rdf:type rdf:Property ;
    rdfs:label 'Notification Date' ;
    rdfs:comment 'The date on which the beneficiary was formally notified of this indexation adjustment. Null if notification has not yet been sent.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notificationSent rdf:type rdf:Property ;
    rdfs:label 'Notification Sent' ;
    rdfs:comment 'Indicates whether a formal notification of this indexation adjustment has been sent to the beneficiary (True) or is pending (False). Supports member communication compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Benefit Amount' ;
    rdfs:comment 'The gross annual or monthly pension benefit amount payable to the beneficiary immediately before this indexation adjustment is applied. Denominated in the plan\'s base currency.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorCpiValue rdf:type rdf:Property ;
    rdfs:label 'Prior Cpi Value' ;
    rdfs:comment 'The CPI index value from the prior reference period used as the base for computing the year-over-year indexation rate. Enables rate derivation validation.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceCpiPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reference Cpi Period End' ;
    rdfs:comment 'The end date of the CPI measurement period used to calculate the indexation rate, as specified in the plan rules (e.g., September of the current year).' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referenceCpiPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reference Cpi Period Start' ;
    rdfs:comment 'The start date of the CPI measurement period used to calculate the indexation rate, as specified in the plan rules (e.g., October of the prior year).' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referenceCpiValue rdf:type rdf:Property ;
    rdfs:label 'Reference Cpi Value' ;
    rdfs:comment 'The actual CPI index value for the reference period used to compute the indexation rate. Provides the inflation input for audit and actuarial validation purposes.' ;
    rdfs:domain ind:IndexationAdjustment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Flag' ;
    rdfs:comment 'Indicates whether this indexation adjustment record is required to be included in regulatory submissions to the national pension regulator or other applicable pension regulators (True) or is excluded (False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reversalDate rdf:type rdf:Property ;
    rdfs:label 'Reversal Date' ;
    rdfs:comment 'The date on which this indexation adjustment was reversed or cancelled, if applicable. Null for adjustments that have not been reversed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reversalReason rdf:type rdf:Property ;
    rdfs:label 'Reversal Reason' ;
    rdfs:comment 'Free-text description of the reason for reversing or cancelling this indexation adjustment, populated only when adjustment_status is \'reversed\' or \'cancelled\'. Supports audit and compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source System Reference Code' ;
    rdfs:comment 'The native identifier of this indexation adjustment record in the originating source system (e.g., SimCorp Dimension transaction ID), enabling lineage tracing and reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorBenefitId rdf:type rdf:Property ;
    rdfs:label 'Survivor Benefit Id' ;
    rdfs:comment 'Unique system-generated identifier for the survivor benefit record. Primary key for this entity.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialPresentValue rdf:type rdf:Property ;
    rdfs:label 'Actuarial Present Value' ;
    rdfs:comment 'Actuarially calculated present value of the total projected survivor benefit obligation, used for LDI, ALM, and IFRS IAS 19 defined benefit liability reporting.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitFraction rdf:type rdf:Property ;
    rdfs:label 'Benefit Fraction' ;
    rdfs:comment 'The fraction of the member\'s pension entitlement payable to the survivor (e.g., 0.60 for 60% survivor pension). Defined by plan rules and LPA terms.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benefitReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Benefit Reference Number' ;
    rdfs:comment 'Externally-known unique alphanumeric reference number assigned to this survivor benefit record, used in member correspondence and regulatory reporting.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Status' ;
    rdfs:comment 'Current lifecycle status of the survivor benefit: pending (awaiting approval), active (in payment), suspended, terminated, or expired.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossAnnualBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Annual Benefit Amount' ;
    rdfs:comment 'The gross annual survivor pension or benefit amount payable before any deductions, expressed in the plan\'s base currency. Core financial obligation for LDI and ALM.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Last Payment Date' ;
    rdfs:comment 'Date of the most recent survivor benefit payment made to the beneficiary. Used for payment reconciliation and cash management monitoring.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:memberDeathDate rdf:type rdf:Property ;
    rdfs:label 'Member Death Date' ;
    rdfs:comment 'The date of death of the plan member or retiree that triggered the survivor benefit entitlement. Principal business event date for this record.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netAnnualBenefitAmount rdf:type rdf:Property ;
    rdfs:label 'Net Annual Benefit Amount' ;
    rdfs:comment 'The net annual survivor benefit amount payable after applicable deductions (e.g., tax withholding, offsets). Used for cash flow planning and beneficiary payment processing.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Next Payment Date' ;
    rdfs:comment 'Date of the next scheduled survivor benefit payment. Used for liquidity planning, cash management, and treasury forecasting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentCountryCode rdf:type rdf:Property ;
    rdfs:label 'Payment Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the country to which survivor benefit payments are remitted. Relevant for FX hedging, withholding tax, and cross-border regulatory compliance.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Plan Document Reference' ;
    rdfs:comment 'Reference to the governing pension plan document, LPA, or trust deed that defines the survivor benefit rules applicable to this record.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Created Timestamp' ;
    rdfs:comment 'Timestamp when this survivor benefit record was first created in the data platform. Audit trail for data lineage and regulatory compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordUpdatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Record Updated Timestamp' ;
    rdfs:comment 'Timestamp when this survivor benefit record was most recently modified in the data platform. Supports audit trail, change tracking, and data quality monitoring.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:survivorFullName rdf:type rdf:Property ;
    rdfs:label 'Survivor Full Name' ;
    rdfs:comment 'Full legal name of the surviving beneficiary as recorded on official documentation. Used for payment processing, correspondence, and regulatory reporting.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorNationalIdentifier rdf:type rdf:Property ;
    rdfs:label 'Survivor National Identifier' ;
    rdfs:comment 'Government-issued national identification number (e.g., SSN in the US, NI number in the UK) of the surviving beneficiary. Required for tax reporting and KYC compliance.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorRelationshipType rdf:type rdf:Property ;
    rdfs:label 'Survivor Relationship Type' ;
    rdfs:comment 'The legal relationship of the surviving beneficiary to the deceased member: spouse, common-law partner, dependent child, disabled dependent, or other dependent. Determines eligibility rules.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalPaidToDate rdf:type rdf:Property ;
    rdfs:label 'Total Paid To Date' ;
    rdfs:comment 'Cumulative gross amount of survivor benefit payments disbursed to the beneficiary from commencement to the most recent payment date. Used for liability tracking and audit.' ;
    rdfs:domain ind:SurvivorBenefit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberStatementId rdf:type rdf:Property ;
    rdfs:label 'Member Statement Id' ;
    rdfs:comment 'Unique surrogate identifier for each pension member statement record in the Silver layer lakehouse.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accrualRate rdf:type rdf:Property ;
    rdfs:label 'Accrual Rate' ;
    rdfs:comment 'The annual benefit accrual rate applied to the member\'s pensionable salary per year of service (e.g., 0.020000 = 2% per year of service).' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accruedPensionAnnualAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Pension Annual Amount' ;
    rdfs:comment 'The annual pension entitlement accrued by the member as at the statement period end date, expressed in the plan currency.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:acknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgement Date' ;
    rdfs:comment 'The date on which the member formally acknowledged receipt of this pension statement, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitFormulaType rdf:type rdf:Property ;
    rdfs:label 'Benefit Formula Type' ;
    rdfs:comment 'The type of pension benefit formula applicable to this member\'s plan, determining how the accrued entitlement is calculated.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buybackServiceYears rdf:type rdf:Property ;
    rdfs:label 'Buyback Service Years' ;
    rdfs:comment 'Total years of prior service purchased (bought back) by the member to increase pensionable service, as at the statement period end date.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Delivery Channel' ;
    rdfs:comment 'The channel through which this pension statement was delivered to the member (e.g., postal mail, secure member portal, email).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryDate rdf:type rdf:Property ;
    rdfs:label 'Delivery Date' ;
    rdfs:comment 'The date on which the pension statement was successfully delivered to the member via the designated delivery channel.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disabilityBenefitEligible rdf:type rdf:Property ;
    rdfs:label 'Disability Benefit Eligible' ;
    rdfs:comment 'Indicates whether the member is eligible for disability pension benefits under the applicable plan rules at the time of statement generation.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earlyRetirementEligibleDate rdf:type rdf:Property ;
    rdfs:label 'Early Retirement Eligible Date' ;
    rdfs:comment 'The earliest date on which the member becomes eligible for unreduced early retirement benefits under the plan rules.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employerContributionsCumulative rdf:type rdf:Property ;
    rdfs:label 'Employer Contributions Cumulative' ;
    rdfs:comment 'Total cumulative employer pension contributions credited on behalf of the member since plan entry date.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionsYtd rdf:type rdf:Property ;
    rdfs:label 'Employer Contributions Ytd' ;
    rdfs:comment 'Total employer pension contributions credited on behalf of the member during the current statement period.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:generatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Generated Timestamp' ;
    rdfs:comment 'The exact date and time when this statement record was first created in the system, serving as the audit creation timestamp.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:issueDate rdf:type rdf:Property ;
    rdfs:label 'Issue Date' ;
    rdfs:comment 'The date on which the pension statement was formally issued and made available to the member.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leaveWithoutPayServiceYears rdf:type rdf:Property ;
    rdfs:label 'Leave Without Pay Service Years' ;
    rdfs:comment 'Total years of leave without pay periods that are excluded from or included in pensionable service, as determined by plan rules.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberAcknowledged rdf:type rdf:Property ;
    rdfs:label 'Member Acknowledged' ;
    rdfs:comment 'Indicates whether the member has formally acknowledged receipt of this pension statement via the member portal or written confirmation.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberContributionsCumulative rdf:type rdf:Property ;
    rdfs:label 'Member Contributions Cumulative' ;
    rdfs:comment 'Total cumulative employee pension contributions made by the member since plan entry date, used for benefit entitlement and transfer value calculations.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberContributionsYtd rdf:type rdf:Property ;
    rdfs:label 'Member Contributions Ytd' ;
    rdfs:comment 'Total employee pension contributions made by the member during the current statement period.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberLifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Member Lifecycle Status' ;
    rdfs:comment 'Current status of the member within the pension plan lifecycle at the time of statement generation.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalRetirementDate rdf:type rdf:Property ;
    rdfs:label 'Normal Retirement Date' ;
    rdfs:comment 'The projected date at which the member reaches normal retirement age under the applicable plan rules, used for benefit projection calculations.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionableSalary rdf:type rdf:Property ;
    rdfs:label 'Pensionable Salary' ;
    rdfs:comment 'The member\'s annual pensionable salary as at the statement period end date, used as the basis for benefit accrual and contribution calculations.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionableServiceYtdYears rdf:type rdf:Property ;
    rdfs:label 'Pensionable Service Ytd Years' ;
    rdfs:comment 'Pensionable service accrued during the current statement period only, used to reconcile annual service increments.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodEndDate rdf:type rdf:Property ;
    rdfs:label 'Period End Date' ;
    rdfs:comment 'The last day of the reporting period covered by this pension statement (e.g., December 31 of the statement year).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:periodStartDate rdf:type rdf:Property ;
    rdfs:label 'Period Start Date' ;
    rdfs:comment 'The first day of the reporting period covered by this pension statement (e.g., January 1 of the statement year).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planEntryDate rdf:type rdf:Property ;
    rdfs:label 'Plan Entry Date' ;
    rdfs:comment 'The date on which the member first enrolled in the pension plan, used as the anchor for pensionable service calculations.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectedPensionAtNra rdf:type rdf:Property ;
    rdfs:label 'Projected Pension At Nra' ;
    rdfs:comment 'Estimated annual pension benefit the member is projected to receive at normal retirement age, based on current service and salary assumptions.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Disclosure Flag' ;
    rdfs:comment 'Indicates whether this statement satisfies a mandatory regulatory disclosure obligation under applicable pension legislation or the national pension regulator guidance.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:statementNumber rdf:type rdf:Property ;
    rdfs:label 'Statement Number' ;
    rdfs:comment 'Externally visible unique reference number assigned to this pension statement, used for member correspondence and audit trail.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementStatus rdf:type rdf:Property ;
    rdfs:label 'Statement Status' ;
    rdfs:comment 'Current lifecycle state of the statement from draft generation through member delivery and acknowledgement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:statementType rdf:type rdf:Property ;
    rdfs:label 'Statement Type' ;
    rdfs:comment 'Classifies the nature of the statement issued to the member. [ENUM-REF-CANDIDATE: annual|on_demand|retirement_estimate|termination|death_benefit — promote to reference product]' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorBenefitEligible rdf:type rdf:Property ;
    rdfs:label 'Survivor Benefit Eligible' ;
    rdfs:comment 'Indicates whether the member has a designated beneficiary eligible for survivor pension benefits under the plan rules.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:survivorPensionAnnualAmount rdf:type rdf:Property ;
    rdfs:label 'Survivor Pension Annual Amount' ;
    rdfs:comment 'The estimated annual survivor pension payable to the designated beneficiary upon the member\'s death, based on accrued entitlement.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferValue rdf:type rdf:Property ;
    rdfs:label 'Transfer Value' ;
    rdfs:comment 'The commuted or actuarial transfer value of the member\'s accrued pension entitlement as at the statement date, used for portability and termination scenarios.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voluntaryAdditionalContributionsYtd rdf:type rdf:Property ;
    rdfs:label 'Voluntary Additional Contributions Ytd' ;
    rdfs:comment 'Total voluntary additional contributions (VACs) made by the member during the statement period to purchase additional pensionable service.' ;
    rdfs:domain ind:MemberStatement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerRemittanceId rdf:type rdf:Property ;
    rdfs:label 'Employer Remittance Id' ;
    rdfs:comment 'Unique surrogate identifier for each employer remittance record in the pension fund system. Primary key for the employer_remittance data product.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cashAccountId rdf:type rdf:Property ;
    rdfs:label 'Cash Account Id' ;
    rdfs:comment 'Identifier of the employer\'s bank account from which the remittance funds were transferred. Links to the counterparty bank account registry for settlement and KYC/AML compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:fundBankAccountId rdf:type rdf:Property ;
    rdfs:label 'Fund Bank Account Id' ;
    rdfs:comment 'Identifier of the pension fund\'s designated bank account into which the remittance was received. Supports cash management, treasury reconciliation, and NAV determination.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:participatingEmployerId rdf:type rdf:Property ;
    rdfs:label 'Participating Employer Id' ;
    rdfs:comment 'Identifier of the participating employer (government department, public agencies, other participating employers) submitting the bulk contribution remittance on behalf of their employees.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ParticipatingEmployer .

ind:reversalReferenceEmployerRemittanceId rdf:type rdf:Property ;
    rdfs:label 'Reversal Reference Employer Remittance Id' ;
    rdfs:comment 'Identifier of the original remittance record that this record reverses or corrects. Populated only for remittance_type = reversal or adjustment. Supports audit trail and double-entry accounting.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EmployerRemittance .

ind:ruleBreachId rdf:type rdf:Property ;
    rdfs:label 'Rule Breach Id' ;
    rdfs:comment 'Foreign key linking to compliance.rule_breach. Business justification: Late or incorrect employer remittances trigger compliance breaches per pension legislation. Funds must track remittance violations for regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RuleBreach .

ind:approvedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approved Timestamp' ;
    rdfs:comment 'Date and time at which the remittance was formally approved and accepted by the pension fund operations team. Marks the transition from under_review to accepted status.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:arrearsAmount rdf:type rdf:Property ;
    rdfs:label 'Arrears Amount' ;
    rdfs:comment 'Amount included in this remittance to cover contributions that were due in prior periods but not previously remitted. Supports arrears tracking and actuarial liability reconciliation.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bankReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Bank Reference Number' ;
    rdfs:comment 'Reference number assigned by the employer\'s bank or payment processor for the funds transfer associated with this remittance. Used for bank reconciliation and settlement confirmation.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysLate rdf:type rdf:Property ;
    rdfs:label 'Days Late' ;
    rdfs:comment 'Number of calendar days by which the remittance submission exceeded the due date. Used to calculate interest on arrears and late penalties per plan rules.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dueDate rdf:type rdf:Property ;
    rdfs:label 'Due Date' ;
    rdfs:comment 'Contractual or regulatory deadline by which the employer was required to submit the remittance. Used to calculate late submission penalties and interest charges.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employerContactEmail rdf:type rdf:Property ;
    rdfs:label 'Employer Contact Email' ;
    rdfs:comment 'Email address of the employer\'s designated contact for this remittance submission. Used for automated acknowledgement, rejection notices, and reconciliation exception communications.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerContactName rdf:type rdf:Property ;
    rdfs:label 'Employer Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the employer responsible for submitting and managing this remittance. Used for exception follow-up and operational communications.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'File Reference Number' ;
    rdfs:comment 'Reference number of the source data file or batch upload submitted by the employer containing the remittance details. Supports data lineage, reprocessing, and dispute resolution.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestOnArrearsAmount rdf:type rdf:Property ;
    rdfs:label 'Interest On Arrears Amount' ;
    rdfs:comment 'Interest charges levied on late or arrears contributions included in this remittance. Calculated per plan rules or regulatory prescribed rates on overdue contribution balances.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isLateSubmission rdf:type rdf:Property ;
    rdfs:label 'Is Late Submission' ;
    rdfs:comment 'Flag indicating whether the remittance was submitted after the regulatory or plan-mandated due date. Triggers late penalty assessment and regulatory reporting obligations.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Penalty Amount' ;
    rdfs:comment 'Monetary penalty assessed against the employer for late submission of the remittance, calculated per plan rules or regulatory prescribed rates. Tracked separately from interest on arrears.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberCount rdf:type rdf:Property ;
    rdfs:label 'Member Count' ;
    rdfs:comment 'Number of active plan members (beneficiaries) covered by this remittance batch. Used to validate completeness of the submission against employer headcount records.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:payrollPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Payroll Period End Date' ;
    rdfs:comment 'End date of the payroll period covered by this remittance. Together with payroll_period_start_date, defines the contribution window for liability matching and actuarial calculations.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:payrollPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Payroll Period Start Date' ;
    rdfs:comment 'Start date of the payroll period covered by this remittance. Defines the contribution window for which employee and employer contributions are being remitted.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Received Timestamp' ;
    rdfs:comment 'Exact date and time the remittance was received and recorded by the pension fund system. Serves as the principal business event timestamp for audit and SLA tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reconciliationDate rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Date' ;
    rdfs:comment 'Date on which the remittance was successfully reconciled against bank receipts and member contribution records. Null if reconciliation is pending or in exception.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationStatus rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Status' ;
    rdfs:comment 'Status of the cash and contribution reconciliation process for this remittance. Tracks whether the received funds have been matched to the employer\'s submission data and member-level records.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for rejection or partial acceptance of the remittance submission. Populated when remittance_status is rejected or partially_accepted.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Rejection Reason Description' ;
    rdfs:comment 'Free-text description providing additional context for the rejection or exception raised against this remittance. Supports employer communication and dispute resolution workflows.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceChannel rdf:type rdf:Property ;
    rdfs:label 'Remittance Channel' ;
    rdfs:comment 'Channel through which the employer submitted the remittance data to the fund. Supports operational analytics on submission quality, SLA compliance, and digital adoption tracking.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Remittance Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to the remittance submission by the employer or payroll system. Used for reconciliation and audit trail across fund and employer records.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceStatus rdf:type rdf:Property ;
    rdfs:label 'Remittance Status' ;
    rdfs:comment 'Current lifecycle status of the remittance submission. Tracks workflow from initial submission through fund acceptance, rejection, or reversal. [ENUM-REF-CANDIDATE: submitted|under_review|accepted|rejected|partially_accepted|reversed — promote to' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceType rdf:type rdf:Property ;
    rdfs:label 'Remittance Type' ;
    rdfs:comment 'Classification of the remittance submission. Regular denotes scheduled payroll-cycle contributions; supplemental covers off-cycle top-ups; adjustment corrects prior submissions; arrears covers late contributions; reversal cancels a prior remittance.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionDate rdf:type rdf:Property ;
    rdfs:label 'Submission Date' ;
    rdfs:comment 'The date on which the employer formally submitted the remittance to the pension fund. Used to assess timeliness against regulatory and plan deadlines.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalRemittanceAmount rdf:type rdf:Property ;
    rdfs:label 'Total Remittance Amount' ;
    rdfs:comment 'Net total amount remitted in this submission, equal to the sum of employee contributions, employer contributions, voluntary contributions, arrears, interest on arrears, and adjustments. Primary monetary fact for the transaction.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueDate rdf:type rdf:Property ;
    rdfs:label 'Value Date' ;
    rdfs:comment 'The date on which the remitted funds are credited to the pension fund account and become available for investment. Aligns with settlement conventions (e.g., T+2) and cash management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceAmount rdf:type rdf:Property ;
    rdfs:label 'Variance Amount' ;
    rdfs:comment 'Difference between the expected contribution amount (per member records) and the actual amount remitted by the employer. Non-zero values trigger exception handling and employer follow-up.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:voluntaryContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Voluntary Contribution Amount' ;
    rdfs:comment 'Total of any additional voluntary contributions (AVCs) included in this remittance batch beyond mandatory contribution rates. Supports member-level benefit entitlement calculations.' ;
    rdfs:domain ind:EmployerRemittance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kycRecordId rdf:type rdf:Property ;
    rdfs:label 'Kyc Record Id' ;
    rdfs:comment 'Foreign key linking to compliance.kyc_record. Business justification: Pension funds must perform KYC due diligence on participating employers per AML/CFT regulations. Employer verification is mandatory before accepting contributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KycRecord .

ind:regulatoryAuthorityId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_authority. Business justification: Employers operate under jurisdiction-specific pension regulators. Multi-jurisdictional pension funds must track which authority governs each employer for compliance reporting' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryAuthority .

ind:activeMemberCount rdf:type rdf:Property ;
    rdfs:label 'Active Member Count' ;
    rdfs:comment 'Current number of active contributing members employed by this employer and enrolled in the pension plan. Used for actuarial liability estimation and contribution forecasting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amlRiskRating rdf:type rdf:Property ;
    rdfs:label 'Aml Risk Rating' ;
    rdfs:comment 'AML/CTF risk classification assigned to this employer based on KYC due diligence. Governs enhanced due diligence requirements and monitoring frequency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitFormulaCode rdf:type rdf:Property ;
    rdfs:label 'Benefit Formula Code' ;
    rdfs:comment 'Code referencing the specific benefit accrual formula applicable to members of this employer. Links to the plan rules governing final average earnings, accrual rates, and indexation.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bicCode rdf:type rdf:Property ;
    rdfs:label 'Bic Code' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code (BIC/SWIFT) of the employer\'s remittance bank. Used for settlement routing and Standard Settlement Instructions (SSI) validation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectiveAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Collective Agreement Reference' ;
    rdfs:comment 'Reference number or identifier of the collective bargaining agreement governing employment terms for this employer\'s pension-eligible members. Impacts benefit entitlements.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionRemittanceFrequency rdf:type rdf:Property ;
    rdfs:label 'Contribution Remittance Frequency' ;
    rdfs:comment 'Frequency at which this employer remits pension contributions to the fund. Governs cash flow forecasting, reconciliation schedules, and late payment monitoring.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSharingAgreement rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement' ;
    rdfs:comment 'Indicates whether a formal data sharing agreement is in place between the pension fund and this employer, governing the exchange of member and payroll data.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataSharingAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Data Sharing Agreement Date' ;
    rdfs:comment 'Date on which the current data sharing agreement between the pension fund and this employer was executed. Used for agreement renewal tracking and compliance audits.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:employeeContributionRate rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Rate' ;
    rdfs:comment 'Standard employee contribution rate applicable to members employed by this employer, expressed as a decimal fraction of pensionable earnings. May vary by member tier.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerCode rdf:type rdf:Property ;
    rdfs:label 'Employer Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the participating employer by the pension plan administrator. Used as the primary operational identifier across payroll and contribution systems.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employerContributionRate rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Rate' ;
    rdfs:comment 'Contractual employer contribution rate expressed as a decimal fraction of pensionable earnings (e.g., 0.095000 = 9.5%). Defined in the plan participation agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerType rdf:type rdf:Property ;
    rdfs:label 'Employer Type' ;
    rdfs:comment 'Classification of the participating employer by organizational category within the pension framework. [ENUM-REF-CANDIDATE: government_department|public_agency|municipal_employer|other_employer|municipal_entity|other —' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyCompliant rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Compliant' ;
    rdfs:comment 'Indicates whether the employer has acknowledged and complies with the pension fund\'s ESG and responsible investment policy requirements for participating employers.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycReviewDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Review Date' ;
    rdfs:comment 'Date of the most recent KYC/AML review completed for this employer. Drives periodic refresh scheduling per FATF requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lateRemittanceCount rdf:type rdf:Property ;
    rdfs:label 'Late Remittance Count' ;
    rdfs:comment 'Cumulative count of late contribution remittances recorded for this employer in the current plan year. Used for SLA monitoring, penalty assessment, and compliance reporting.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:legalName rdf:type rdf:Property ;
    rdfs:label 'Legal Name' ;
    rdfs:comment 'Full legal registered name of the participating employer organization (e.g., government department, public agency, or other participating employer).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lei rdf:type rdf:Property ;
    rdfs:label 'Lei' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier assigned to the employer for regulatory reporting and counterparty identification purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalRetirementAge rdf:type rdf:Property ;
    rdfs:label 'Normal Retirement Age' ;
    rdfs:comment 'Standard retirement age applicable to members employed by this employer under the plan rules. Used for actuarial liability projections and LDI/ALM modeling.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outstandingContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Contribution Amount' ;
    rdfs:comment 'Total value of pension contributions currently outstanding (unpaid or unreconciled) from this employer. Critical for cash management, actuarial funding, and regulatory compliance.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:participationAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Participation Agreement Date' ;
    rdfs:comment 'Date on which the participation agreement was signed by both the employer and the pension fund. Establishes the legal basis for contribution obligations.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:participationAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Participation Agreement Number' ;
    rdfs:comment 'Unique reference number of the formal participation agreement executed between the pension fund and this employer. Governs all rights and obligations of plan participation.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:participationStatus rdf:type rdf:Property ;
    rdfs:label 'Participation Status' ;
    rdfs:comment 'Current lifecycle status of the employer\'s participation in the pension plan. Drives contribution processing, reporting obligations, and member enrollment eligibility.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payrollSystemCode rdf:type rdf:Property ;
    rdfs:label 'Payroll System Code' ;
    rdfs:comment 'Identifier used by the employer\'s payroll system to reference this employer entity. Enables automated reconciliation of contribution remittances from payroll source systems.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionablePayrollAmount rdf:type rdf:Property ;
    rdfs:label 'Pensionable Payroll Amount' ;
    rdfs:comment 'Total annual pensionable payroll (in plan currency) for this employer as of the most recent reporting period. Basis for contribution rate application and actuarial valuation.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Email' ;
    rdfs:comment 'Official email address of the employer\'s primary pension plan contact. Used for contribution notices, capital call communications, and regulatory correspondence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactName rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Name' ;
    rdfs:comment 'Full name of the designated primary contact person at the employer responsible for pension plan administration and contribution remittance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Phone' ;
    rdfs:comment 'Primary telephone number for the employer\'s pension plan contact. Used for urgent contribution and member enrollment communications.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line1' ;
    rdfs:comment 'First line of the employer\'s official registered address. Used for regulatory correspondence, contribution notices, and KYC/AML verification.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line2' ;
    rdfs:comment 'Second line of the employer\'s official registered address (suite, floor, unit). Supplements the primary address line for complete postal identification.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredCity rdf:type rdf:Property ;
    rdfs:label 'Registered City' ;
    rdfs:comment 'City of the employer\'s official registered address. Used for geographic segmentation, regulatory reporting, and contribution remittance routing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredPostalCode rdf:type rdf:Property ;
    rdfs:label 'Registered Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the employer\'s official registered address. Required for contribution remittance and regulatory correspondence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remittanceDueDay rdf:type rdf:Property ;
    rdfs:label 'Remittance Due Day' ;
    rdfs:comment 'Calendar day of the month (1–31) by which contribution remittances must be received from this employer. Used for SLA monitoring and late payment penalty calculations.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:shortName rdf:type rdf:Property ;
    rdfs:label 'Short Name' ;
    rdfs:comment 'Abbreviated or commonly used operating name of the participating employer, used in reports and system displays where full legal name is impractical.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Vesting Period Years' ;
    rdfs:comment 'Minimum years of service required for members of this employer to become fully vested in the pension benefit. Governs entitlement calculations and member lifecycle management.' ;
    rdfs:domain ind:ParticipatingEmployer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialBasisEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Actuarial Basis Effective Date' ;
    rdfs:comment 'Date from which the current actuarial basis (mortality table and assumptions) referenced by actuarial_basis_code became effective for this benefit option. Supports liability valuation versioning.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benefitOptionStatus rdf:type rdf:Property ;
    rdfs:label 'Benefit Option Status' ;
    rdfs:comment 'Current lifecycle status of the benefit option. Inactive or deprecated options may still apply to members who elected them historically. Grandfathered options are closed to new elections.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bridgeBenefitEligible rdf:type rdf:Property ;
    rdfs:label 'Bridge Benefit Eligible' ;
    rdfs:comment 'Indicates whether this benefit option includes a bridge benefit component, which supplements pension income until the member reaches the state pension eligibility age.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bridgeBenefitEndAge rdf:type rdf:Property ;
    rdfs:label 'Bridge Benefit End Age' ;
    rdfs:comment 'Age at which the bridge benefit component ceases (typically 65, aligned with state pension eligibility). Null if bridge_benefit_eligible is false.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commutationAllowed rdf:type rdf:Property ;
    rdfs:label 'Commutation Allowed' ;
    rdfs:comment 'Indicates whether a lump-sum commutation (partial or full conversion of the annuity to a present value cash payment) is permitted under this benefit option. Subject to applicable tax law limits.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commutationMaxPct rdf:type rdf:Property ;
    rdfs:label 'Commutation Max Pct' ;
    rdfs:comment 'Maximum percentage of the pension\'s actuarial present value that may be commuted to a lump sum under this option (e.g., 0.2500 = 25%). Null if commutation_allowed is false.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deathBenefitType rdf:type rdf:Property ;
    rdfs:label 'Death Benefit Type' ;
    rdfs:comment 'Type of death benefit payable if the member dies before or after pension commencement under this option. Drives beneficiary designation requirements and actuarial reserve calculations.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultOption rdf:type rdf:Property ;
    rdfs:label 'Default Option' ;
    rdfs:comment 'Indicates whether this benefit option is the plan default applied when a member does not make an explicit election within the election window. Typically the joint and survivor annuity for married members.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:earlyRetirementReduction rdf:type rdf:Property ;
    rdfs:label 'Early Retirement Reduction' ;
    rdfs:comment 'Indicates whether an actuarial reduction applies to the pension amount when this option is elected before the member\'s unreduced retirement age. Relevant for early retirement planning analytics.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electionIrrevocable rdf:type rdf:Property ;
    rdfs:label 'Election Irrevocable' ;
    rdfs:comment 'Indicates whether the member\'s election of this benefit option is irrevocable once made. True for most annuity forms post-commencement. Drives member counselling and governance requirements.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:electionWindowDays rdf:type rdf:Property ;
    rdfs:label 'Election Window Days' ;
    rdfs:comment 'Number of days prior to the member\'s retirement date within which this benefit option must be elected. Governs member communication timelines and plan administration workflows.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expiryDate rdf:type rdf:Property ;
    rdfs:label 'Expiry Date' ;
    rdfs:comment 'Date on which this benefit option was closed to new elections. Null if the option remains open. Supports grandfathering logic and liability-driven investment (LDI) horizon analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indexationCapPct rdf:type rdf:Property ;
    rdfs:label 'Indexation Cap Pct' ;
    rdfs:comment 'Maximum annual indexation rate applied to pension payments under this option (e.g., 0.0800 = 8% cap). Null if indexation_type is full_cpi or none. Used in actuarial liability modelling and LDI stress testing.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationFloorPct rdf:type rdf:Property ;
    rdfs:label 'Indexation Floor Pct' ;
    rdfs:comment 'Minimum annual indexation rate guaranteed under this option (e.g., 0.0000 = no negative indexation). Null if indexation_type is none. Relevant for liability-driven investment (LDI) and actuarial liability matching.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ldiLiabilityCategory rdf:type rdf:Property ;
    rdfs:label 'Ldi Liability Category' ;
    rdfs:comment 'Classification of the pension liability stream generated by this benefit option for liability-driven investment (LDI) and asset-liability management (ALM) purposes. Drives duration matching and hedging strategy.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxRetirementAge rdf:type rdf:Property ;
    rdfs:label 'Max Retirement Age' ;
    rdfs:comment 'Maximum age by which a member must commence this benefit option. Typically aligned with tax-law mandatory commencement rules (e.g., a statutory maximum age). Null if no upper bound applies.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memberFacingDescription rdf:type rdf:Property ;
    rdfs:label 'Member Facing Description' ;
    rdfs:comment 'Plain-language description of this benefit option as presented in member communications, pension statements, and retirement counselling materials. Supports member education and disclosure obligations.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minRetirementAge rdf:type rdf:Property ;
    rdfs:label 'Min Retirement Age' ;
    rdfs:comment 'Minimum age at which a member is eligible to elect this benefit option. Varies by contributor pool and option type (e.g., early retirement options may have different thresholds).' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minServiceYears rdf:type rdf:Property ;
    rdfs:label 'Min Service Years' ;
    rdfs:comment 'Minimum years of pensionable service required for a member to be eligible to elect this benefit option. Used in eligibility screening during retirement counselling.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:optionCode rdf:type rdf:Property ;
    rdfs:label 'Option Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying the benefit option within the pension plan (e.g., SLA, JSA_50, JSA_100, GP5, BRIDGE). Used in member communications and plan documents.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionName rdf:type rdf:Property ;
    rdfs:label 'Option Name' ;
    rdfs:comment 'Human-readable name of the benefit option as presented to plan members (e.g., \'Single Life Annuity\', \'Joint and Survivor 60% Annuity\', \'Bridge Benefit\', \'Guaranteed Period 10-Year\').' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:optionType rdf:type rdf:Property ;
    rdfs:label 'Option Type' ;
    rdfs:comment 'High-level classification of the benefit option structure. Drives actuarial valuation methodology and member eligibility rules. [ENUM-REF-CANDIDATE: promote to reference product if additional types are added]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTiming rdf:type rdf:Property ;
    rdfs:label 'Payment Timing' ;
    rdfs:comment 'Indicates whether pension payments under this option are made at the beginning (in advance) or end (in arrears) of each payment period. Affects actuarial present value calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionAdjustmentApplicable rdf:type rdf:Property ;
    rdfs:label 'Pension Adjustment Applicable' ;
    rdfs:comment 'Indicates whether a Pension Adjustment (PA) must be reported on the member\'s annual tax slip slip for years in which this benefit option accrues. Relevant for registered pension plan tax compliance reporting.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:planTextReference rdf:type rdf:Property ;
    rdfs:label 'Plan Text Reference' ;
    rdfs:comment 'Reference to the specific section or clause in the pension plan text or legislation that governs this benefit option (e.g., \'a section of the governing plan statute\'). Supports regulatory audit.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reductionFactorPct rdf:type rdf:Property ;
    rdfs:label 'Reduction Factor Pct' ;
    rdfs:comment 'Actuarially determined reduction applied to the member\'s base pension amount when electing this option, expressed as a decimal (e.g., 0.050000 = 5% reduction for joint and survivor coverage). Derived from actuarial tables.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryApprovalRef rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Ref' ;
    rdfs:comment 'Reference number or identifier for the regulatory approval or registration of this benefit option with the applicable pension regulator (e.g. registration number). Supports compliance and audit trails.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sortOrder rdf:type rdf:Property ;
    rdfs:label 'Sort Order' ;
    rdfs:comment 'Integer controlling the display sequence of benefit options in member-facing portals, retirement counselling tools, and administrative systems. Lower values appear first.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spousalConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Spousal Consent Required' ;
    rdfs:comment 'Indicates whether spousal or common-law partner consent is required for the member to elect this option. Typically required when waiving joint and survivor coverage. Regulatory compliance field.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:survivorFractionPct rdf:type rdf:Property ;
    rdfs:label 'Survivor Fraction Pct' ;
    rdfs:comment 'For joint and survivor annuity options, the fraction of the member\'s pension payable to the surviving spouse or beneficiary upon the member\'s death (e.g., 0.5000, 0.6000, 0.6667, 1.0000). Null for non-joint options.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxTreatmentCode rdf:type rdf:Property ;
    rdfs:label 'Tax Treatment Code' ;
    rdfs:comment 'Code identifying the income tax treatment applicable to pension payments under this option (e.g., \'REGISTERED_PENSION_PLAN_RPP\', \'retirement_account_transfer\'). Aligns with tax authority reporting requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferValueEligible rdf:type rdf:Property ;
    rdfs:label 'Transfer Value Eligible' ;
    rdfs:comment 'Indicates whether a member electing this option is eligible to receive a transfer value (commuted value transferred to a locked-in retirement account) instead of the annuity. Typically available before pension commencement.' ;
    rdfs:domain ind:BenefitOption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overpaymentRecoveryId rdf:type rdf:Property ;
    rdfs:label 'Overpayment Recovery Id' ;
    rdfs:comment 'Unique surrogate identifier for each overpayment recovery record in the pension fund beneficiary domain.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualRecoveryEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual Recovery End Date' ;
    rdfs:comment 'Date on which the recovery was fully completed or formally closed, whether through full repayment, write-off, or legal settlement.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amountRecoveredToDate rdf:type rdf:Property ;
    rdfs:label 'Amount Recovered To Date' ;
    rdfs:comment 'Cumulative amount successfully recovered from the beneficiary or their estate as of the most recent update to this record.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:caseNotes rdf:type rdf:Property ;
    rdfs:label 'Case Notes' ;
    rdfs:comment 'Free-text notes recorded by the case owner documenting key events, member communications, and decisions throughout the recovery lifecycle.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:caseOwner rdf:type rdf:Property ;
    rdfs:label 'Case Owner' ;
    rdfs:comment 'Name or employee identifier of the pension administration officer assigned as the primary owner of this recovery case.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionDate rdf:type rdf:Property ;
    rdfs:label 'Detection Date' ;
    rdfs:comment 'Date on which the overpayment was first identified, either through system reconciliation, audit, or member notification.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disputeDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Date' ;
    rdfs:comment 'Date on which the beneficiary formally raised a dispute against the overpayment recovery claim.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeOutcome rdf:type rdf:Property ;
    rdfs:label 'Dispute Outcome' ;
    rdfs:comment 'Outcome of the formal dispute process, indicating whether the recovery claim was upheld, partially upheld, dismissed, or withdrawn.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeRaised rdf:type rdf:Property ;
    rdfs:label 'Dispute Raised' ;
    rdfs:comment 'Indicates whether the beneficiary or their estate has formally disputed the overpayment claim or the recovery amount.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Date' ;
    rdfs:comment 'Date on which the dispute was formally resolved, either in favour of the fund or the beneficiary.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estateClaimReference rdf:type rdf:Property ;
    rdfs:label 'Estate Claim Reference' ;
    rdfs:comment 'Reference number for the claim filed against the deceased beneficiary\'s estate for recovery of overpaid pension benefits.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedRecoveryEndDate rdf:type rdf:Property ;
    rdfs:label 'Expected Recovery End Date' ;
    rdfs:comment 'Projected date by which the full net recoverable amount is expected to be collected based on the agreed recovery plan.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossOverpaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Overpayment Amount' ;
    rdfs:comment 'Total gross amount paid to the beneficiary in excess of their entitlement over the overpayment period, before any adjustments or recoveries.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hardshipWaiverAmount rdf:type rdf:Property ;
    rdfs:label 'Hardship Waiver Amount' ;
    rdfs:comment 'Amount of the overpayment formally waived due to the beneficiary\'s demonstrated financial hardship, reducing the net recoverable balance.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hardshipWaiverGranted rdf:type rdf:Property ;
    rdfs:label 'Hardship Waiver Granted' ;
    rdfs:comment 'Indicates whether a financial hardship waiver has been granted to the beneficiary, reducing or suspending the recovery obligation.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instalmentAmount rdf:type rdf:Property ;
    rdfs:label 'Instalment Amount' ;
    rdfs:comment 'Periodic instalment amount agreed with the beneficiary for repayment of the overpayment, applicable when recovery method is instalment plan.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instalmentFrequency rdf:type rdf:Property ;
    rdfs:label 'Instalment Frequency' ;
    rdfs:comment 'Frequency at which recovery instalments are scheduled to be deducted or received from the beneficiary.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalActionDate rdf:type rdf:Property ;
    rdfs:label 'Legal Action Date' ;
    rdfs:comment 'Date on which formal legal proceedings were initiated to recover the outstanding overpayment balance.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalActionInitiated rdf:type rdf:Property ;
    rdfs:label 'Legal Action Initiated' ;
    rdfs:comment 'Indicates whether formal legal proceedings have been initiated to recover the overpayment from the beneficiary or their estate.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:memberNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Member Notification Date' ;
    rdfs:comment 'Date on which the beneficiary was formally notified of the overpayment and the fund\'s intent to recover the amount.' ;
    rdfs:domain ind:Beneficiary ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netRecoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Net Recoverable Amount' ;
    rdfs:comment 'Net amount the fund is entitled to recover from the beneficiary after tax adjustments, representing the actual recovery target.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notificationChannel rdf:type rdf:Property ;
    rdfs:label 'Notification Channel' ;
    rdfs:comment 'Channel through which the overpayment notification was communicated to the beneficiary or their legal representative.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outstandingBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Balance' ;
    rdfs:comment 'Remaining amount yet to be recovered, calculated as net recoverable amount minus amount recovered to date.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overpaymentCause rdf:type rdf:Property ;
    rdfs:label 'Overpayment Cause' ;
    rdfs:comment 'Root cause category explaining why the benefit was paid in excess of entitlement. [ENUM-REF-CANDIDATE: death_notification_delay|calculation_error|eligibility_change|duplicate_payment|rate_error|other — promote to reference product]' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overpaymentEndDate rdf:type rdf:Property ;
    rdfs:label 'Overpayment End Date' ;
    rdfs:comment 'Date on which the overpayment ceased, either because the benefit was corrected, suspended, or the member\'s entitlement was updated.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overpaymentStartDate rdf:type rdf:Property ;
    rdfs:label 'Overpayment Start Date' ;
    rdfs:comment 'Date from which the benefit payments began to exceed the member\'s entitlement, marking the beginning of the overpayment period.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overpaymentType rdf:type rdf:Property ;
    rdfs:label 'Overpayment Type' ;
    rdfs:comment 'Classification of the benefit type that was overpaid, distinguishing pension, survivor, disability, or lump-sum payments.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryMethod rdf:type rdf:Property ;
    rdfs:label 'Recovery Method' ;
    rdfs:comment 'Mechanism by which the overpayment is being recovered, such as deduction from ongoing benefit, lump-sum repayment, or estate claim.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Recovery Reference Number' ;
    rdfs:comment 'Externally-visible unique reference number assigned to this overpayment recovery case, used in member correspondence and audit trails.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryStartDate rdf:type rdf:Property ;
    rdfs:label 'Recovery Start Date' ;
    rdfs:comment 'Date on which the recovery process formally commenced, i.e., when the first deduction or repayment was initiated.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recoveryStatus rdf:type rdf:Property ;
    rdfs:label 'Recovery Status' ;
    rdfs:comment 'Current lifecycle state of the overpayment recovery case. [ENUM-REF-CANDIDATE: identified|notified|in_recovery|disputed|recovered|written_off|suspended — promote to reference product]' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReportDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Report Date' ;
    rdfs:comment 'Date on which this overpayment recovery case was reported to the relevant regulatory authority, where reporting is required.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Required' ;
    rdfs:comment 'Indicates whether this overpayment recovery case must be reported to a regulatory body such as Pension regulator or a local pension regulator.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsibleTeam rdf:type rdf:Property ;
    rdfs:label 'Responsible Team' ;
    rdfs:comment 'Internal team or department responsible for managing and progressing this overpayment recovery case.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simcorpCaseReference rdf:type rdf:Property ;
    rdfs:label 'Simcorp Case Reference' ;
    rdfs:comment 'Reference identifier for this overpayment recovery case as recorded in SimCorp Dimension ABOR/Investment Accounting module.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Adjustment Amount' ;
    rdfs:comment 'Tax withheld or adjustments applied to the gross overpayment amount, reflecting net recoverable amount after tax treatment.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffAmount rdf:type rdf:Property ;
    rdfs:label 'Write Off Amount' ;
    rdfs:comment 'Portion of the net recoverable amount formally written off as irrecoverable, approved per the fund\'s write-off policy.' ;
    rdfs:domain ind:OverpaymentRecovery ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffDate rdf:type rdf:Property ;
    rdfs:label 'Write Off Date' ;
    rdfs:comment 'Date on which the write-off of the irrecoverable overpayment amount was formally approved and recorded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:writeOffReason rdf:type rdf:Property ;
    rdfs:label 'Write Off Reason' ;
    rdfs:comment 'Reason for writing off the irrecoverable balance, such as deceased with no estate, financial hardship, or statute-barred debt.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberDocumentId rdf:type rdf:Property ;
    rdfs:label 'Member Document Id' ;
    rdfs:comment 'Unique surrogate identifier for each member document record in the pension file management system. Primary key for the member_document entity.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Document Id' ;
    rdfs:comment 'Reference to the newer member_document record that replaces this document when a member submits an updated version (e.g., revised beneficiary designation). Null if not superseded.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MemberDocument .

ind:accessRestrictionLevel rdf:type rdf:Property ;
    rdfs:label 'Access Restriction Level' ;
    rdfs:comment 'Operational access control level specifying which staff roles may view or process this document. Enforced by the document management system\'s role-based access control (RBAC) configuration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryDesignationFlag rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Designation Flag' ;
    rdfs:comment 'Indicates whether this document constitutes or amends a beneficiary designation for death benefit purposes. Triggers update of the beneficiary entitlement record upon acceptance.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:certifiedCopyFlag rdf:type rdf:Property ;
    rdfs:label 'Certified Copy Flag' ;
    rdfs:comment 'Indicates whether the document is a certified true copy authenticated by a notary, commissioner of oaths, or equivalent authority. Relevant for legal admissibility in pension division proceedings.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:containsPhiFlag rdf:type rdf:Property ;
    rdfs:label 'Contains Phi Flag' ;
    rdfs:comment 'Indicates whether the document contains protected health information (PHI) such as medical diagnoses or disability assessments. Triggers enhanced access restrictions and audit logging.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:containsPiiFlag rdf:type rdf:Property ;
    rdfs:label 'Contains Pii Flag' ;
    rdfs:comment 'Indicates whether the document contains personally identifiable information (PII) subject to privacy legislation. Drives access controls, masking requirements, and breach notification obligations.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataClassification rdf:type rdf:Property ;
    rdfs:label 'Data Classification' ;
    rdfs:comment 'Information security classification of the document content per the fund\'s data governance policy: restricted (PII/PHI), confidential (sensitive business), internal, or public.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:digitalRepositoryPath rdf:type rdf:Property ;
    rdfs:label 'Digital Repository Path' ;
    rdfs:comment 'Logical path or URI to the document\'s digital file in the pension fund\'s secure document management system or content repository. Confidential due to system access sensitivity.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disabilityCertificationType rdf:type rdf:Property ;
    rdfs:label 'Disability Certification Type' ;
    rdfs:comment 'For disability-related documents, classifies whether this is an initial certification, a periodic renewal, or a termination of disability status. Not applicable for non-disability documents.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentCategory rdf:type rdf:Property ;
    rdfs:label 'Document Category' ;
    rdfs:comment 'Broad grouping of the document for records management and retrieval: identity (ID proofs), entitlement (benefit rights), legal_order (court orders), medical (disability/death), financial (contribution/payment), administrative (forms/applications).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentDate rdf:type rdf:Property ;
    rdfs:label 'Document Date' ;
    rdfs:comment 'The official date appearing on the document itself (e.g., date of signing, date of issuance by a court or authority). Distinct from the date the document was received by the fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:documentDescription rdf:type rdf:Property ;
    rdfs:label 'Document Description' ;
    rdfs:comment 'Free-text narrative describing the content, purpose, or special circumstances of the document, used by pension administrators for context during file review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLanguage rdf:type rdf:Property ;
    rdfs:label 'Document Language' ;
    rdfs:comment 'ISO 639-1 or 639-2 language code of the document\'s primary language (e.g., \'en\' for English, \'fr\' for French). Determines translation requirements for multilingual pension administration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Document Reference Number' ;
    rdfs:comment 'Externally-known unique alphanumeric reference number assigned to the document upon receipt or generation, used for correspondence and audit trail purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStatus rdf:type rdf:Property ;
    rdfs:label 'Document Status' ;
    rdfs:comment 'Current lifecycle state of the document within the pension file workflow: received upon intake, under_review during verification, verified/accepted once validated, rejected if invalid, superseded if replaced, archived for closed files.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentTitle rdf:type rdf:Property ;
    rdfs:label 'Document Title' ;
    rdfs:comment 'Human-readable title or name of the document as it appears on the physical or digital record (e.g., \'Retirement Application Form – Plan 1\').' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentType rdf:type rdf:Property ;
    rdfs:label 'Document Type' ;
    rdfs:comment 'Classification of the document by its business purpose (e.g., enrollment_form, beneficiary_designation, retirement_application, marriage_certificate, divorce_order, disability_certification, death_certificate, power_of_attorney, transfer_request).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileFormat rdf:type rdf:Property ;
    rdfs:label 'File Format' ;
    rdfs:comment 'Digital file format of the stored document (e.g., PDF, TIFF, JPEG). Relevant for long-term preservation standards and accessibility compliance in pension records management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeKb rdf:type rdf:Property ;
    rdfs:label 'File Size Kb' ;
    rdfs:comment 'Size of the digital document file in kilobytes. Used for storage capacity planning and to flag unusually large or small files that may indicate scanning quality issues.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuingAuthority rdf:type rdf:Property ;
    rdfs:label 'Issuing Authority' ;
    rdfs:comment 'Name of the government body, court, institution, or organization that issued or certified the document (e.g., \'a family court\', \'the plan administrator\', \'a participating employer\').' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingCountry rdf:type rdf:Property ;
    rdfs:label 'Issuing Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction that issued the document. Required for foreign documents subject to apostille or notarization requirements.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuingJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Issuing Jurisdiction' ;
    rdfs:comment 'Province, state, or sub-national jurisdiction of the issuing authority where applicable (e.g., \'New York\', \'California\'). Relevant for pension division orders and legal documents.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memberNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Member Notified Flag' ;
    rdfs:comment 'Indicates whether the member has been formally notified of the document\'s acceptance, rejection, or any required follow-up action. Supports SLA compliance and member communication tracking.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notarizedFlag rdf:type rdf:Property ;
    rdfs:label 'Notarized Flag' ;
    rdfs:comment 'Indicates whether the document has been notarized or certified by a commissioner of oaths. Must be True before processing for document types where requires_notarization is True.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalDocumentFlag rdf:type rdf:Property ;
    rdfs:label 'Original Document Flag' ;
    rdfs:comment 'Indicates whether the document on file is the original (True) or a certified copy, notarized copy, or digital scan (False). Originals may be required for certain legal proceedings.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pageCount rdf:type rdf:Property ;
    rdfs:label 'Page Count' ;
    rdfs:comment 'Total number of pages in the document. Used for completeness verification during intake — a document with fewer pages than expected may be flagged as incomplete.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pensionDivisionFlag rdf:type rdf:Property ;
    rdfs:label 'Pension Division Flag' ;
    rdfs:comment 'Indicates whether this document relates to a pension division order (e.g., divorce decree or domestic relations order splitting pension entitlement). Triggers actuarial recalculation workflows.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:receivedDate rdf:type rdf:Property ;
    rdfs:label 'Received Date' ;
    rdfs:comment 'The date on which the pension fund received the document from the member, legal authority, or third party. Used for SLA tracking and regulatory timeliness compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:requiresNotarization rdf:type rdf:Property ;
    rdfs:label 'Requires Notarization' ;
    rdfs:comment 'Indicates whether the document type requires notarization or commissioner of oaths certification per plan rules or regulatory requirements before it can be actioned.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retentionCategory rdf:type rdf:Property ;
    rdfs:label 'Retention Category' ;
    rdfs:comment 'Records retention classification determining how long the document must be kept per regulatory and plan rules: permanent (e.g., death certificates), long_term (e.g., retirement applications), standard, or short_term.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retentionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Retention Expiry Date' ;
    rdfs:comment 'The date after which the document may be destroyed or anonymized in accordance with the fund\'s records retention schedule and applicable privacy regulations. Null for permanent records.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewNotes rdf:type rdf:Property ;
    rdfs:label 'Review Notes' ;
    rdfs:comment 'Free-text notes recorded by the pension administrator during document review, capturing deficiencies, follow-up actions required, or rationale for rejection. Confidential internal record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageMedium rdf:type rdf:Property ;
    rdfs:label 'Storage Medium' ;
    rdfs:comment 'Indicates whether the document is stored as a physical paper record, a digital file, or both. Drives records management, retention scheduling, and disaster recovery procedures.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionChannel rdf:type rdf:Property ;
    rdfs:label 'Submission Channel' ;
    rdfs:comment 'The channel through which the member or authorized party submitted the document to the pension fund (e.g., mail, in-person at a service centre, secure member portal, fax).' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:translatedFlag rdf:type rdf:Property ;
    rdfs:label 'Translated Flag' ;
    rdfs:comment 'Indicates whether a certified translation of the document exists on file (True). Required when the original document is in a language other than the plan\'s official administrative languages.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:verifiedDate rdf:type rdf:Property ;
    rdfs:label 'Verified Date' ;
    rdfs:comment 'The date on which a pension administrator or authorized officer completed verification and authentication of the document\'s authenticity and completeness.' ;
    rdfs:domain ind:MemberDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionDivisionOrderId rdf:type rdf:Property ;
    rdfs:label 'Pension Division Order Id' ;
    rdfs:comment 'Unique surrogate identifier for the pension division order record within the pension fund system.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialCommutedValue rdf:type rdf:Property ;
    rdfs:label 'Actuarial Commuted Value' ;
    rdfs:comment 'The actuarially determined present value (commuted value) of the pension entitlement subject to division as at the actuarial valuation date.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialReportReference rdf:type rdf:Property ;
    rdfs:label 'Actuarial Report Reference' ;
    rdfs:comment 'Reference number or identifier of the actuarial valuation report supporting the commuted value calculation used in the division order.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appealFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Flag' ;
    rdfs:comment 'Indicates whether the pension division order is currently under appeal or subject to a legal challenge that may affect its implementation.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Resolution Date' ;
    rdfs:comment 'The date on which any appeal or legal challenge to the pension division order was resolved, enabling final implementation to proceed.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:courtJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Court Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the court order was issued, governing applicable family law and pension division legislation.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtName rdf:type rdf:Property ;
    rdfs:label 'Court Name' ;
    rdfs:comment 'Name of the court or tribunal that issued the pension division order (e.g., a family court, Family Division).' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:courtOrderDate rdf:type rdf:Property ;
    rdfs:label 'Court Order Date' ;
    rdfs:comment 'The date on which the court issued the pension division order, representing the principal real-world event date of the legal instrument.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:divisionAmount rdf:type rdf:Property ;
    rdfs:label 'Division Amount' ;
    rdfs:comment 'The fixed monetary amount of the pension entitlement or equalization payment allocated to the former spouse where a fixed-amount division method is specified.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:divisionMethod rdf:type rdf:Property ;
    rdfs:label 'Division Method' ;
    rdfs:comment 'The method by which the pension entitlement is divided: percentage of pension credit, fixed monetary amount, actuarial present value, or pension credit split.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divisionPercentage rdf:type rdf:Property ;
    rdfs:label 'Division Percentage' ;
    rdfs:comment 'The percentage of the pension credit or pension benefit allocated to the former spouse under the division order, expressed as a decimal (e.g., 0.500000 = 50%).' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:formerSpouseDateOfBirth rdf:type rdf:Property ;
    rdfs:label 'Former Spouse Date Of Birth' ;
    rdfs:comment 'Date of birth of the former spouse, required for actuarial valuation of the divided pension entitlement and survivor benefit calculations.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:formerSpouseFullName rdf:type rdf:Property ;
    rdfs:label 'Former Spouse Full Name' ;
    rdfs:comment 'Full legal name of the former spouse or domestic partner who is the beneficiary of the pension division order as identified in the court instrument.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formerSpouseGender rdf:type rdf:Property ;
    rdfs:label 'Former Spouse Gender' ;
    rdfs:comment 'Gender of the former spouse as recorded for actuarial mortality table selection and survivor benefit entitlement determination.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formerSpouseNationalIdentifier rdf:type rdf:Property ;
    rdfs:label 'Former Spouse National Identifier' ;
    rdfs:comment 'Government-issued national identification number (e.g., SSN, NIN) of the former spouse for identity verification and tax reporting purposes.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:implementationDate rdf:type rdf:Property ;
    rdfs:label 'Implementation Date' ;
    rdfs:comment 'The date on which the pension division order was operationally implemented in the pension administration system, adjusting the member\'s benefit entitlement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isIndexationShared rdf:type rdf:Property ;
    rdfs:label 'Is Indexation Shared' ;
    rdfs:comment 'Indicates whether the pension indexation (cost-of-living adjustment) applicable to the divided pension benefit is shared with the former spouse.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSurvivorBenefitAffected rdf:type rdf:Property ;
    rdfs:label 'Is Survivor Benefit Affected' ;
    rdfs:comment 'Indicates whether the pension division order affects the survivor benefit entitlement of the former spouse under the plan rules.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalCounselReference rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Reference' ;
    rdfs:comment 'Reference identifier or name of the legal counsel or law firm representing the pension fund in the division proceedings, for case management purposes.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marriageBreakdownDate rdf:type rdf:Property ;
    rdfs:label 'Marriage Breakdown Date' ;
    rdfs:comment 'The date of marriage breakdown or separation as legally established, used to determine the pension credit accrued during the marriage period for division purposes.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marriageDate rdf:type rdf:Property ;
    rdfs:label 'Marriage Date' ;
    rdfs:comment 'The date of marriage or commencement of domestic partnership, establishing the start of the period over which pension credits are subject to division.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:orderNotes rdf:type rdf:Property ;
    rdfs:label 'Order Notes' ;
    rdfs:comment 'Free-text notes capturing special conditions, legal qualifications, or administrative remarks associated with the pension division order.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Order Reference Number' ;
    rdfs:comment 'Externally assigned court order reference number or file number uniquely identifying the legal instrument governing the pension division.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderStatus rdf:type rdf:Property ;
    rdfs:label 'Order Status' ;
    rdfs:comment 'Current lifecycle status of the pension division order, tracking progression from receipt through implementation or cancellation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderType rdf:type rdf:Property ;
    rdfs:label 'Order Type' ;
    rdfs:comment 'Classification of the court-ordered pension division mechanism: equalization payment, pension sharing, deferred division, lump-sum transfer, or annuity split.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentTransferDate rdf:type rdf:Property ;
    rdfs:label 'Payment Transfer Date' ;
    rdfs:comment 'The date on which the equalization payment or lump-sum transfer was executed to the former spouse\'s designated account or retirement savings account/locked-in account.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionCreditEndDate rdf:type rdf:Property ;
    rdfs:label 'Pension Credit End Date' ;
    rdfs:comment 'The end date of the pension credit accrual period subject to division, typically aligned with the marriage breakdown date.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pensionCreditStartDate rdf:type rdf:Property ;
    rdfs:label 'Pension Credit Start Date' ;
    rdfs:comment 'The start date of the pension credit accrual period subject to division, typically aligned with the marriage date or plan membership commencement.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemRecordCode rdf:type rdf:Property ;
    rdfs:label 'Source System Record Code' ;
    rdfs:comment 'The native record identifier assigned by the source pension administration system, enabling lineage tracing and reconciliation with the system of record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferAccountReference rdf:type rdf:Property ;
    rdfs:label 'Transfer Account Reference' ;
    rdfs:comment 'Masked or tokenized account reference at the destination financial institution to which the equalization payment or pension credit transfer is directed.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferDestinationType rdf:type rdf:Property ;
    rdfs:label 'Transfer Destination Type' ;
    rdfs:comment 'The type of vehicle to which the divided pension entitlement or equalization payment is transferred (e.g., individual retirement account, locked-in account, cash, another pension plan).' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferInstitutionName rdf:type rdf:Property ;
    rdfs:label 'Transfer Institution Name' ;
    rdfs:comment 'Name of the financial institution or pension plan to which the divided entitlement or equalization payment is transferred on behalf of the former spouse.' ;
    rdfs:domain ind:PensionDivisionOrder ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accrualRatePct rdf:type rdf:Property ;
    rdfs:label 'Accrual Rate Pct' ;
    rdfs:comment 'Annual rate at which pension benefits accrue per year of credited service for defined benefit plans.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actuarialValuationFrequency rdf:type rdf:Property ;
    rdfs:label 'Actuarial Valuation Frequency' ;
    rdfs:comment 'How often the plan undergoes formal actuarial valuation for funding assessment.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:colaCapPct rdf:type rdf:Property ;
    rdfs:label 'Cola Cap Pct' ;
    rdfs:comment 'Maximum annual percentage increase allowed for cost of living adjustments.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costOfLivingAdjustmentType rdf:type rdf:Property ;
    rdfs:label 'Cost Of Living Adjustment Type' ;
    rdfs:comment 'Method for adjusting pension benefits to account for inflation post-retirement.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianName rdf:type rdf:Property ;
    rdfs:label 'Custodian Name' ;
    rdfs:comment 'Name of the financial institution providing custody services for plan assets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionPlanDescription rdf:type rdf:Property ;
    rdfs:label 'Pension Plan Description' ;
    rdfs:comment 'Detailed narrative description of the pension plan terms, features, and provisions.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earlyRetirementAge rdf:type rdf:Property ;
    rdfs:label 'Early Retirement Age' ;
    rdfs:comment 'Minimum age at which members may elect early retirement with reduced benefits.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:employeeContributionRatePct rdf:type rdf:Property ;
    rdfs:label 'Employee Contribution Rate Pct' ;
    rdfs:comment 'Standard percentage of salary that employees contribute to the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:employerContributionRatePct rdf:type rdf:Property ;
    rdfs:label 'Employer Contribution Rate Pct' ;
    rdfs:comment 'Standard percentage of salary that the employer contributes to the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgIntegrationLevel rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Level' ;
    rdfs:comment 'Degree to which ESG factors are incorporated into investment decision-making.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundingPolicy rdf:type rdf:Property ;
    rdfs:label 'Funding Policy' ;
    rdfs:comment 'Approach used to fund pension liabilities and maintain plan solvency.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentStrategy rdf:type rdf:Property ;
    rdfs:label 'Investment Strategy' ;
    rdfs:comment 'Overall investment approach governing asset allocation for the pension fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionCountryCode rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code indicating the legal jurisdiction governing the plan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastActuarialValuationDate rdf:type rdf:Property ;
    rdfs:label 'Last Actuarial Valuation Date' ;
    rdfs:comment 'Date of the most recent completed actuarial valuation of the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lumpSumOptionAvailable rdf:type rdf:Property ;
    rdfs:label 'Lump Sum Option Available' ;
    rdfs:comment 'Indicates whether members can elect a lump sum payment instead of annuity at retirement.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumPensionableEarnings rdf:type rdf:Property ;
    rdfs:label 'Maximum Pensionable Earnings' ;
    rdfs:comment 'Annual earnings cap above which contributions and benefits do not accrue.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumServiceYears rdf:type rdf:Property ;
    rdfs:label 'Maximum Service Years' ;
    rdfs:comment 'Maximum years of service that can be credited toward pension benefit calculation.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumServiceYears rdf:type rdf:Property ;
    rdfs:label 'Minimum Service Years' ;
    rdfs:comment 'Minimum years of credited service required to qualify for pension benefits.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Modified Timestamp' ;
    rdfs:comment 'Timestamp when the pension plan record was last updated in the system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:pensionPlanName rdf:type rdf:Property ;
    rdfs:label 'Pension Plan Name' ;
    rdfs:comment 'Official registered name of the pension plan as filed with regulatory authorities.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextActuarialValuationDate rdf:type rdf:Property ;
    rdfs:label 'Next Actuarial Valuation Date' ;
    rdfs:comment 'Scheduled date for the next actuarial valuation of the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planAdministratorName rdf:type rdf:Property ;
    rdfs:label 'Plan Administrator Name' ;
    rdfs:comment 'Name of the organization or individual responsible for plan administration.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planCode rdf:type rdf:Property ;
    rdfs:label 'Plan Code' ;
    rdfs:comment 'External business identifier code for the pension plan used in regulatory filings and member communications.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portabilityAllowed rdf:type rdf:Property ;
    rdfs:label 'Portability Allowed' ;
    rdfs:comment 'Indicates whether members can transfer accrued benefits to another pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recordKeeperName rdf:type rdf:Property ;
    rdfs:label 'Record Keeper Name' ;
    rdfs:comment 'Name of the service provider maintaining participant records and account balances.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationNumber rdf:type rdf:Property ;
    rdfs:label 'Registration Number' ;
    rdfs:comment 'Official registration number assigned by the pension regulatory authority.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:salaryAveragingPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Salary Averaging Period Years' ;
    rdfs:comment 'Number of years used to calculate average salary for benefit determination.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sponsorType rdf:type rdf:Property ;
    rdfs:label 'Sponsor Type' ;
    rdfs:comment 'Category of employer or organization sponsoring the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionPlanStatus rdf:type rdf:Property ;
    rdfs:label 'Pension Plan Status' ;
    rdfs:comment 'Current lifecycle status of the pension plan indicating operational state.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:survivorBenefitPct rdf:type rdf:Property ;
    rdfs:label 'Survivor Benefit Pct' ;
    rdfs:comment 'Percentage of pension benefit payable to surviving spouse or beneficiary.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetFundingRatioPct rdf:type rdf:Property ;
    rdfs:label 'Target Funding Ratio Pct' ;
    rdfs:comment 'Target ratio of plan assets to liabilities as defined by funding policy.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalActiveMembers rdf:type rdf:Property ;
    rdfs:label 'Total Active Members' ;
    rdfs:comment 'Current count of active contributing members enrolled in the pension plan.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalDeferredMembers rdf:type rdf:Property ;
    rdfs:label 'Total Deferred Members' ;
    rdfs:comment 'Count of members with deferred benefits who are no longer actively contributing.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalPensioners rdf:type rdf:Property ;
    rdfs:label 'Total Pensioners' ;
    rdfs:comment 'Count of retired members currently receiving pension benefit payments.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trusteeName rdf:type rdf:Property ;
    rdfs:label 'Trustee Name' ;
    rdfs:comment 'Name of the trustee or trust company holding plan assets in fiduciary capacity.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionPlanType rdf:type rdf:Property ;
    rdfs:label 'Pension Plan Type' ;
    rdfs:comment 'Classification of the pension plan structure determining benefit calculation methodology.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Vesting Period Months' ;
    rdfs:comment 'Number of months of service required for members to become fully vested in employer contributions.' ;
    rdfs:domain ind:PensionPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actuarialValuationId rdf:type rdf:Property ;
    rdfs:label 'Actuarial Valuation Id' ;
    rdfs:comment 'Foreign key linking to actuarial.actuarial_valuation. Business justification: Portfolio reports are compared to actuarial valuations; FK supports generation of regulatory reports.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ActuarialValuation .

ind:almModelId rdf:type rdf:Property ;
    rdfs:label 'Alm Model Id' ;
    rdfs:comment 'Foreign key linking to actuarial.alm_model. Business justification: Portfolio selects an ALM model for asset-liability matching; ALM model selection is a formal business decision documented in the portfolio policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AlmModel .

ind:assetClassOutlookId rdf:type rdf:Property ;
    rdfs:label 'Asset Class Outlook Id' ;
    rdfs:comment 'Foreign key linking to research.asset_class_outlook. Business justification: Portfolio asset allocation decisions reference asset class outlooks for expected returns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetClassOutlook .

ind:capitalMarketAssumptionId rdf:type rdf:Property ;
    rdfs:label 'Capital Market Assumption Id' ;
    rdfs:comment 'Foreign key linking to research.capital_market_assumption. Business justification: Portfolio valuation uses capital market assumptions for discount rates and risk premiums.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalMarketAssumption .

ind:compositeId rdf:type rdf:Property ;
    rdfs:label 'Composite Id' ;
    rdfs:comment 'Reference to the GIPS composite that this portfolio belongs to for aggregated performance reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Composite .

ind:countryOutlookId rdf:type rdf:Property ;
    rdfs:label 'Country Outlook Id' ;
    rdfs:comment 'Foreign key linking to research.country_outlook. Business justification: Portfolio geographic allocation decisions reference country outlooks for risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CountryOutlook .

ind:createdByActorId rdf:type rdf:Property ;
    rdfs:label 'Created By Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Audit trail requires linking portfolio creator to the actor who performed the action.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:createdByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Created By User Employee Id' ;
    rdfs:comment 'User identifier of the person who created this portfolio record in the system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:custodianId rdf:type rdf:Property ;
    rdfs:label 'Custodian Id' ;
    rdfs:comment 'Reference to the external custodian bank (State Street, Northern Trust) responsible for safekeeping portfolio assets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Custodian .

ind:economicScenarioId rdf:type rdf:Property ;
    rdfs:label 'Economic Scenario Id' ;
    rdfs:comment 'Foreign key linking to research.economic_scenario. Business justification: Portfolio strategy documents reference a macroeconomic scenario for scenario analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EconomicScenario .

ind:equityBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Equity Benchmark Id' ;
    rdfs:comment 'Reference to the primary benchmark index used for performance comparison and tracking error measurement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquityBenchmark .

ind:gpProfileId rdf:type rdf:Property ;
    rdfs:label 'Gp Profile Id' ;
    rdfs:comment 'Reference to the internal portfolio manager or investment team responsible for managing this portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:ldiStrategyId rdf:type rdf:Property ;
    rdfs:label 'Ldi Strategy Id' ;
    rdfs:comment 'Foreign key linking to actuarial.ldi_strategy. Business justification: Portfolio may adopt an LDI strategy for hedging; FK links portfolio to the strategy used.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LdiStrategy .

ind:legalEntityId rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Id' ;
    rdfs:comment 'Reference to the legal entity that owns or sponsors this portfolio. Used for regulatory reporting and legal documentation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LegalEntity .

ind:macroModelRunId rdf:type rdf:Property ;
    rdfs:label 'Macro Model Run Id' ;
    rdfs:comment 'Foreign key linking to research.macro_model_run. Business justification: Portfolio risk assessment uses macro model run projections to set target returns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MacroModelRun .

ind:managerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Manager Employee Id' ;
    rdfs:comment 'Reference to the internal portfolio manager or investment team responsible for managing this portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:modifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Modified By User Employee Id' ;
    rdfs:comment 'User identifier of the person who last modified this portfolio record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:sectorOutlookId rdf:type rdf:Property ;
    rdfs:label 'Sector Outlook Id' ;
    rdfs:comment 'Foreign key linking to research.sector_outlook. Business justification: Portfolio sector allocation decisions reference sector outlooks for investment guidance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SectorOutlook .

ind:valuationPolicyId rdf:type rdf:Property ;
    rdfs:label 'Valuation Policy Id' ;
    rdfs:comment 'Foreign key linking to valuation.valuation_policy. Business justification: Valuation governance requires each portfolio to reference its governing valuation policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ValuationPolicy .

ind:accountingBasis rdf:type rdf:Property ;
    rdfs:label 'Accounting Basis' ;
    rdfs:comment 'Accounting standard used for portfolio valuation and financial reporting. International Financial Reporting Standards (IFRS), Generally Accepted Accounting Principles (GAAP), local GAAP, or statutory.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassScope rdf:type rdf:Property ;
    rdfs:label 'Asset Class Scope' ;
    rdfs:comment 'Primary asset class or multi-asset scope that defines the investment universe for this portfolio. [ENUM-REF-CANDIDATE: multi_asset|public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|cash — 9 candidates stripped' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseCurrency rdf:type rdf:Property ;
    rdfs:label 'Base Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code representing the portfolio\'s base reporting currency for valuation and performance measurement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closureDate rdf:type rdf:Property ;
    rdfs:label 'Closure Date' ;
    rdfs:comment 'Date when the portfolio was closed or terminated. Null for active portfolios.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:portfolioCode rdf:type rdf:Property ;
    rdfs:label 'Portfolio Code' ;
    rdfs:comment 'Externally-known unique business identifier for the portfolio, used across systems and reporting. Typically alphanumeric code assigned at inception.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioDescription rdf:type rdf:Property ;
    rdfs:label 'Portfolio Description' ;
    rdfs:comment 'Detailed narrative description of the portfolio\'s investment strategy, objectives, and unique characteristics.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgFramework rdf:type rdf:Property ;
    rdfs:label 'Esg Framework' ;
    rdfs:comment 'Primary ESG framework or standard applied to this portfolio. Principles for Responsible Investment (PRI), Task Force on Climate-related Financial Disclosures (TCFD), Sustainable Finance Disclosure Regulation (SFDR), UN Global Compact (UNGC), Sustainable' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIntegrationFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Flag' ;
    rdfs:comment 'Indicates whether Environmental, Social, and Governance (ESG) factors are systematically integrated into the investment process for this portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionListAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Applied Flag' ;
    rdfs:comment 'Indicates whether an ESG exclusion list (e.g., tobacco, weapons, fossil fuels) is applied to investment decisions for this portfolio.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gipsCompliantFlag rdf:type rdf:Property ;
    rdfs:label 'Gips Compliant Flag' ;
    rdfs:comment 'Indicates whether the portfolio\'s performance reporting is compliant with Global Investment Performance Standards (GIPS).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inceptionDate rdf:type rdf:Property ;
    rdfs:label 'Inception Date' ;
    rdfs:comment 'Date when the portfolio was established and began accepting investments. Used as the start date for performance measurement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentCommitteeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Investment Committee Approval Date' ;
    rdfs:comment 'Date when the Investment Committee formally approved the establishment or material changes to this portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentPolicyVersion rdf:type rdf:Property ;
    rdfs:label 'Investment Policy Version' ;
    rdfs:comment 'Version number of the Investment Policy Statement governing this portfolio\'s investment guidelines and constraints.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastRebalanceDate rdf:type rdf:Property ;
    rdfs:label 'Last Rebalance Date' ;
    rdfs:comment 'Date of the most recent portfolio rebalancing event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leverageLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Leverage Limit Percent' ;
    rdfs:comment 'Maximum allowable leverage ratio for the portfolio expressed as a percentage. Defines borrowing and derivative exposure constraints.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityRequirementDays rdf:type rdf:Property ;
    rdfs:label 'Liquidity Requirement Days' ;
    rdfs:comment 'Minimum number of days of liquidity that must be maintained in the portfolio to meet redemption and operational cash needs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mandateType rdf:type rdf:Property ;
    rdfs:label 'Mandate Type' ;
    rdfs:comment 'Investment mandate governing the portfolio strategy. Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), Liability-Driven Investment (LDI), or other mandate types.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioName rdf:type rdf:Property ;
    rdfs:label 'Portfolio Name' ;
    rdfs:comment 'Human-readable name of the investment portfolio, used for display and reporting purposes.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextRebalanceDate rdf:type rdf:Property ;
    rdfs:label 'Next Rebalance Date' ;
    rdfs:comment 'Scheduled date for the next portfolio rebalancing event based on rebalancing frequency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Performance Calculation Method' ;
    rdfs:comment 'Method used to calculate portfolio returns. Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), or simple return.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioStatus rdf:type rdf:Property ;
    rdfs:label 'Portfolio Status' ;
    rdfs:comment 'Current lifecycle status of the portfolio indicating whether it is actively managed, suspended, closed, or in liquidation.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioType rdf:type rdf:Property ;
    rdfs:label 'Portfolio Type' ;
    rdfs:comment 'Classification of the portfolio by its investment mandate and purpose within the fund structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalancingFrequency rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Frequency' ;
    rdfs:comment 'Scheduled frequency at which the portfolio is rebalanced to maintain target asset allocation weights. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|event_driven — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryClassification rdf:type rdf:Property ;
    rdfs:label 'Regulatory Classification' ;
    rdfs:comment 'Regulatory classification of the portfolio under applicable financial regulations. Undertakings for Collective Investment in Transferable Securities (UCITS), Alternative Investment Fund (AIF), pension fund, insurance-linked, sovereign wealth, endowment' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Reporting Frequency' ;
    rdfs:comment 'Frequency at which formal performance and valuation reports are generated for this portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskToleranceLevel rdf:type rdf:Property ;
    rdfs:label 'Risk Tolerance Level' ;
    rdfs:comment 'Risk appetite classification for the portfolio, defining acceptable volatility and drawdown thresholds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Target Return Percent' ;
    rdfs:comment 'Target annualized return objective for the portfolio expressed as a percentage. Used for performance evaluation and strategic planning.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Status' ;
    rdfs:comment 'Tax treatment classification for the portfolio, determining how investment income and gains are taxed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingErrorLimitBps rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Limit Bps' ;
    rdfs:comment 'Maximum allowable tracking error versus the benchmark, expressed in basis points. Used for active risk management.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationFrequency rdf:type rdf:Property ;
    rdfs:label 'Valuation Frequency' ;
    rdfs:comment 'Frequency at which Net Asset Value (NAV) is calculated for the portfolio. Critical for performance measurement and investor reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Var Limit Percent' ;
    rdfs:comment 'Maximum allowable Value at Risk (VaR) for the portfolio expressed as a percentage of Net Asset Value (NAV). Used for risk constraint monitoring.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hierarchyId rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Id' ;
    rdfs:comment 'Unique identifier for the portfolio hierarchy relationship record.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:childPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Child Portfolio Id' ;
    rdfs:comment 'Identifier of the child portfolio node in the hierarchy structure.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Portfolio .

ind:parentPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Parent Portfolio Id' ;
    rdfs:comment 'Identifier of the parent portfolio node in the hierarchy structure.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Portfolio .

ind:portfolioBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Benchmark Id' ;
    rdfs:comment 'Identifier of the benchmark assigned to measure performance of this hierarchical relationship or child portfolio within the parent context.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioBenchmark .

ind:allocationMethod rdf:type rdf:Property ;
    rdfs:label 'Allocation Method' ;
    rdfs:comment 'Methodology used to determine the allocation weight of the child portfolio within the parent structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationWeight rdf:type rdf:Property ;
    rdfs:label 'Allocation Weight' ;
    rdfs:comment 'Proportional weight or percentage of the child portfolio within the parent portfolio, expressed as a decimal where 1.0 equals 100 percent.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalAuthority rdf:type rdf:Property ;
    rdfs:label 'Approval Authority' ;
    rdfs:comment 'Name or role of the individual or committee that approved the establishment or modification of this hierarchical relationship.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consolidationRule rdf:type rdf:Property ;
    rdfs:label 'Consolidation Rule' ;
    rdfs:comment 'Rule governing how the child portfolio positions and performance are consolidated into the parent portfolio for reporting and analytics.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintDescription rdf:type rdf:Property ;
    rdfs:label 'Constraint Description' ;
    rdfs:comment 'Detailed textual description of specific constraints or restrictions applied to the parent-child portfolio relationship.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintType rdf:type rdf:Property ;
    rdfs:label 'Constraint Type' ;
    rdfs:comment 'Classification of constraints applied to the hierarchical relationship governing allocation limits and investment restrictions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hierarchyType rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Type' ;
    rdfs:comment 'Classification of the hierarchical relationship type between parent and child portfolios.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Reference' ;
    rdfs:comment 'Reference number or identifier of the Investment Committee decision or memorandum approving this hierarchical structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isActive rdf:type rdf:Property ;
    rdfs:label 'Is Active' ;
    rdfs:comment 'Boolean indicator of whether this hierarchical relationship is currently active and operational.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Hierarchy Level' ;
    rdfs:comment 'Numeric depth level of the child node within the overall portfolio hierarchy tree structure, with 1 representing the top level.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:path rdf:type rdf:Property ;
    rdfs:label 'Path' ;
    rdfs:comment 'Full hierarchical path from root to current node, typically represented as a delimited string of portfolio identifiers for traversal and querying.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceAttributionFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Attribution Flag' ;
    rdfs:comment 'Indicator whether the child portfolio performance should be attributed separately within parent portfolio performance analytics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relationshipName rdf:type rdf:Property ;
    rdfs:label 'Relationship Name' ;
    rdfs:comment 'Business-friendly name describing the nature of the parent-child portfolio relationship.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipStatus rdf:type rdf:Property ;
    rdfs:label 'Relationship Status' ;
    rdfs:comment 'Current lifecycle state of the parent-child portfolio hierarchical relationship.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Inclusion Flag' ;
    rdfs:comment 'Indicator whether the child portfolio should be included in consolidated parent portfolio reporting and performance attribution.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saaTargetWeight rdf:type rdf:Property ;
    rdfs:label 'Saa Target Weight' ;
    rdfs:comment 'Long-term strategic target allocation weight for the child portfolio within the parent portfolio structure, expressed as a decimal.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taaAdjustment rdf:type rdf:Property ;
    rdfs:label 'Taa Adjustment' ;
    rdfs:comment 'Short-term tactical adjustment to the strategic allocation weight, expressed as a decimal deviation from the SAA target.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceBandLower rdf:type rdf:Property ;
    rdfs:label 'Tolerance Band Lower' ;
    rdfs:comment 'Lower boundary of the acceptable allocation weight range before rebalancing is triggered, expressed as a decimal.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceBandUpper rdf:type rdf:Property ;
    rdfs:label 'Tolerance Band Upper' ;
    rdfs:comment 'Upper boundary of the acceptable allocation weight range before rebalancing is triggered, expressed as a decimal.' ;
    rdfs:domain ind:Hierarchy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioMandateId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Mandate Id' ;
    rdfs:comment 'Unique identifier for the investment mandate governing a portfolio or sleeve.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioMandate .

ind:performanceBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Performance Benchmark Id' ;
    rdfs:comment 'Reference to the primary benchmark index used to measure mandate performance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PerformanceBenchmark .

ind:benchmarkIndexId rdf:type rdf:Property ;
    rdfs:label 'Benchmark Index Id' ;
    rdfs:comment 'Reference to the primary benchmark index used to measure mandate performance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenchmarkIndex .

ind:exclusionListId rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Id' ;
    rdfs:comment 'Reference to the ESG exclusion list defining prohibited investments such as tobacco, weapons, or fossil fuels.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExclusionList .

ind:concentrationLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Concentration Limit Percent' ;
    rdfs:comment 'Maximum percentage of portfolio value that may be invested in a single issuer or security.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyHedgingPolicy rdf:type rdf:Property ;
    rdfs:label 'Currency Hedging Policy' ;
    rdfs:comment 'Mandate policy for foreign exchange risk management: fully hedged, partially hedged, unhedged, or dynamic based on market conditions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derivativesPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Derivatives Permitted Flag' ;
    rdfs:comment 'Indicates whether the mandate permits the use of derivative instruments for hedging or investment purposes.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentUri rdf:type rdf:Property ;
    rdfs:label 'Document Uri' ;
    rdfs:comment 'Reference to the location of the legal mandate document such as investment management agreement or limited partnership agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStructure rdf:type rdf:Property ;
    rdfs:label 'Fee Structure' ;
    rdfs:comment 'Description of the fee arrangement for the mandate including management fees, performance fees, and hurdle rates.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRestrictions rdf:type rdf:Property ;
    rdfs:label 'Geographic Restrictions' ;
    rdfs:comment 'Geographic constraints on investments, specified as permitted or excluded regions and countries using ISO 3166-1 alpha-3 codes.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highWaterMarkFlag rdf:type rdf:Property ;
    rdfs:label 'High Water Mark Flag' ;
    rdfs:comment 'Indicates whether performance fees are subject to a high water mark provision requiring recovery of prior losses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hurdleRatePercent rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Percent' ;
    rdfs:comment 'Minimum return threshold that must be achieved before performance fees are charged. Null if not applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentCommitteeCode rdf:type rdf:Property ;
    rdfs:label 'Investment Committee Code' ;
    rdfs:comment 'Reference to the investment committee responsible for governance and approval of mandate investments.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:investmentObjective rdf:type rdf:Property ;
    rdfs:label 'Investment Objective' ;
    rdfs:comment 'Primary investment goal of the mandate such as capital preservation, income generation, growth, or total return.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Review Date' ;
    rdfs:comment 'Date when the mandate was last reviewed by the investment committee or governance body.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:leveragePermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Leverage Permitted Flag' ;
    rdfs:comment 'Indicates whether the mandate permits the use of leverage or borrowing to enhance returns.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementFeeBps rdf:type rdf:Property ;
    rdfs:label 'Management Fee Bps' ;
    rdfs:comment 'Annual management fee charged on assets under management expressed in basis points.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mandateCode rdf:type rdf:Property ;
    rdfs:label 'Mandate Code' ;
    rdfs:comment 'Externally-known unique business identifier for the mandate, used in operational systems and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateName rdf:type rdf:Property ;
    rdfs:label 'Mandate Name' ;
    rdfs:comment 'Human-readable name of the investment mandate for business user identification and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateStatus rdf:type rdf:Property ;
    rdfs:label 'Mandate Status' ;
    rdfs:comment 'Current lifecycle state of the mandate indicating whether it is operational, suspended, terminated, or awaiting approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxLeverageRatio rdf:type rdf:Property ;
    rdfs:label 'Max Leverage Ratio' ;
    rdfs:comment 'Maximum permitted leverage ratio expressed as total assets divided by net assets. Null if leverage not permitted.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minCreditRating rdf:type rdf:Property ;
    rdfs:label 'Min Credit Rating' ;
    rdfs:comment 'Minimum acceptable credit rating for fixed income investments using standard rating agency notation.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Review Date' ;
    rdfs:comment 'Date when the mandate is scheduled for next review by the investment committee or governance body.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceFeePercent rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Percent' ;
    rdfs:comment 'Performance-based fee as a percentage of returns above the hurdle rate. Null if not applicable.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:permittedAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Permitted Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset classes allowed under the mandate: public equities, private equity, real estate, infrastructure, natural resources, credit, fixed income.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskTolerance rdf:type rdf:Property ;
    rdfs:label 'Risk Tolerance' ;
    rdfs:comment 'Acceptable level of investment risk for the mandate ranging from conservative to very aggressive.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Sector Limit Percent' ;
    rdfs:comment 'Maximum percentage of portfolio value that may be invested in a single industry sector.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortSellingPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Short Selling Permitted Flag' ;
    rdfs:comment 'Indicates whether the mandate permits short selling of securities.' ;
    rdfs:domain ind:PortfolioMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saaTargetId rdf:type rdf:Property ;
    rdfs:label 'Saa Target Id' ;
    rdfs:comment 'Unique identifier for the strategic asset allocation target record.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SaaTarget .

ind:creditBenchmarkIndexId rdf:type rdf:Property ;
    rdfs:label 'Credit Benchmark Index Id' ;
    rdfs:comment 'Foreign key linking to credit.benchmark_index. Business justification: SAA targets for credit asset classes require direct reference to credit benchmarks (Bloomberg Aggregate, ICE BofA) for policy weight calibration and performance attribution.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenchmarkIndex .

ind:lastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User Employee Id' ;
    rdfs:comment 'Identifier of the user or system process that last modified this SAA target record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:saaEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Saa Employee Id' ;
    rdfs:comment 'Identifier of the user or system process that created this SAA target record.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:saaLastModifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Saa Last Modified By User Employee Id' ;
    rdfs:comment 'Identifier of the user or system process that last modified this SAA target record.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Actual Weight Percent' ;
    rdfs:comment 'Current realized weight of this asset class as a percentage of total portfolio, used for drift monitoring and rebalancing decisions.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetClassCode rdf:type rdf:Property ;
    rdfs:label 'Asset Class Code' ;
    rdfs:comment 'Standardized code identifying the asset class (e.g., PUBLIC_EQUITY, PRIVATE_EQUITY, REAL_ESTATE, INFRASTRUCTURE, NATURAL_RESOURCES, CREDIT, FIXED_INCOME).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassName rdf:type rdf:Property ;
    rdfs:label 'Asset Class Name' ;
    rdfs:comment 'Human-readable name of the asset class for reporting and display purposes.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlationGroupCode rdf:type rdf:Property ;
    rdfs:label 'Correlation Group Code' ;
    rdfs:comment 'Code identifying the correlation group for portfolio optimization and diversification analysis (e.g., EQUITY_GROUP, FIXED_INCOME_GROUP).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionPolicyAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Policy Applied Flag' ;
    rdfs:comment 'Indicates whether negative screening or exclusion policies apply to investments within this asset class.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Expected Return Percent' ;
    rdfs:comment 'Long-term expected annualized return assumption for this asset class used in ALM modeling and strategic planning.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedVolatilityPercent rdf:type rdf:Property ;
    rdfs:label 'Expected Volatility Percent' ;
    rdfs:comment 'Long-term expected annualized volatility (standard deviation) assumption for this asset class used in risk modeling.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicConstraintCode rdf:type rdf:Property ;
    rdfs:label 'Geographic Constraint Code' ;
    rdfs:comment 'Geographic investment scope constraint for this asset class allocation (e.g., GLOBAL, DEVELOPED, EMERGING).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastModifiedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Modified Timestamp' ;
    rdfs:comment 'Timestamp of the most recent modification to this SAA target record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:liquidityClassification rdf:type rdf:Property ;
    rdfs:label 'Liquidity Classification' ;
    rdfs:comment 'Classification of the asset class liquidity profile for cash management and liability matching purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Maximum Weight Percent' ;
    rdfs:comment 'Upper bound constraint for this asset class allocation as defined in the investment policy, triggering rebalancing if breached.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Minimum Weight Percent' ;
    rdfs:comment 'Lower bound constraint for this asset class allocation as defined in the investment policy, triggering rebalancing if breached.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Policy Weight Percent' ;
    rdfs:comment 'Long-term strategic policy target weight for this asset class as a percentage of total portfolio (e.g., 25.00000 for 25%).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rationaleNotes rdf:type rdf:Property ;
    rdfs:label 'Rationale Notes' ;
    rdfs:comment 'Free-text explanation of the strategic rationale and Investment Committee considerations supporting this asset allocation target.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalancingThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Threshold Percent' ;
    rdfs:comment 'Tolerance band around policy weight; drift exceeding this threshold triggers rebalancing review (e.g., +/- 2.00000%).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewFrequencyCode rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Code' ;
    rdfs:comment 'Scheduled frequency for reviewing and potentially updating this SAA target (e.g., ANNUAL, QUARTERLY).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:saaTargetStatus rdf:type rdf:Property ;
    rdfs:label 'Saa Target Status' ;
    rdfs:comment 'Current lifecycle status of this SAA target record (ACTIVE for in-force targets, SUPERSEDED for replaced targets).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subAssetClassCode rdf:type rdf:Property ;
    rdfs:label 'Sub Asset Class Code' ;
    rdfs:comment 'Granular sub-classification within the asset class (e.g., DEVELOPED_EQUITY, EMERGING_EQUITY, CORE_REAL_ESTATE, VALUE_ADD_REAL_ESTATE).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subAssetClassName rdf:type rdf:Property ;
    rdfs:label 'Sub Asset Class Name' ;
    rdfs:comment 'Human-readable name of the sub-asset class for detailed reporting.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tacticalAdjustmentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Tactical Adjustment Allowed Flag' ;
    rdfs:comment 'Indicates whether tactical asset allocation (TAA) deviations from this strategic target are permitted within governance limits.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tacticalAdjustmentLimitPercent rdf:type rdf:Property ;
    rdfs:label 'Tactical Adjustment Limit Percent' ;
    rdfs:comment 'Maximum permitted tactical deviation from policy weight as a percentage (e.g., +/- 3.00000%), if tactical adjustments are allowed.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Target Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the SAA target is denominated (e.g., USD, GBP).' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightDriftPercent rdf:type rdf:Property ;
    rdfs:label 'Weight Drift Percent' ;
    rdfs:comment 'Difference between actual weight and policy weight (actual minus policy), indicating allocation drift requiring rebalancing consideration.' ;
    rdfs:domain ind:SaaTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taaPositionId rdf:type rdf:Property ;
    rdfs:label 'Taa Position Id' ;
    rdfs:comment 'Unique identifier for the tactical asset allocation position record.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Amount' ;
    rdfs:comment 'The actual dollar value of holdings in this asset class as of the position date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualDeviationPercent rdf:type rdf:Property ;
    rdfs:label 'Actual Deviation Percent' ;
    rdfs:comment 'The actual deviation from the TAA target weight, calculated as actual weight minus TAA target weight.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalStatus rdf:type rdf:Property ;
    rdfs:label 'Approval Status' ;
    rdfs:comment 'Approval status of the TAA position by the Investment Committee.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkCode rdf:type rdf:Property ;
    rdfs:label 'Benchmark Code' ;
    rdfs:comment 'Code identifying the benchmark index used to measure performance for this asset class.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkName rdf:type rdf:Property ;
    rdfs:label 'Benchmark Name' ;
    rdfs:comment 'Human-readable name of the benchmark index for this asset class.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comments rdf:type rdf:Property ;
    rdfs:label 'Comments' ;
    rdfs:comment 'Additional notes or commentary regarding the tactical asset allocation position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:positionDate rdf:type rdf:Property ;
    rdfs:label 'Position Date' ;
    rdfs:comment 'The business date as of which this tactical asset allocation position is effective.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rebalancingRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Required Flag' ;
    rdfs:comment 'Indicates whether the actual deviation exceeds the rebalancing thresholds and action is required.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebalancingThresholdLowerPercent rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Threshold Lower Percent' ;
    rdfs:comment 'The lower bound deviation threshold that triggers a rebalancing action for this asset class.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalancingThresholdUpperPercent rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Threshold Upper Percent' ;
    rdfs:comment 'The upper bound deviation threshold that triggers a rebalancing action for this asset class.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskBudgetPercent rdf:type rdf:Property ;
    rdfs:label 'Risk Budget Percent' ;
    rdfs:comment 'The percentage of total portfolio risk budget allocated to this asset class under the TAA framework.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saaTargetAmount rdf:type rdf:Property ;
    rdfs:label 'Saa Target Amount' ;
    rdfs:comment 'The dollar value corresponding to the SAA target weight for this asset class.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saaTargetWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Saa Target Weight Percent' ;
    rdfs:comment 'The long-term strategic asset allocation target weight for this asset class, expressed as a percentage of total portfolio value.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taaDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Taa Decision Date' ;
    rdfs:comment 'The date on which the Investment Committee approved the current TAA target weight for this asset class.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taaDeviationPercent rdf:type rdf:Property ;
    rdfs:label 'Taa Deviation Percent' ;
    rdfs:comment 'The tactical over or underweight deviation from the SAA target, calculated as TAA target weight minus SAA target weight.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taaHorizonMonths rdf:type rdf:Property ;
    rdfs:label 'Taa Horizon Months' ;
    rdfs:comment 'The expected time horizon in months for which the tactical position is intended to be maintained.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:taaPositionStatus rdf:type rdf:Property ;
    rdfs:label 'Taa Position Status' ;
    rdfs:comment 'Current lifecycle status of the tactical asset allocation position.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taaRationale rdf:type rdf:Property ;
    rdfs:label 'Taa Rationale' ;
    rdfs:comment 'Brief description of the macroeconomic or market view justifying the tactical deviation from SAA.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taaReviewDate rdf:type rdf:Property ;
    rdfs:label 'Taa Review Date' ;
    rdfs:comment 'The scheduled date for the next Investment Committee review of this tactical position.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taaTargetAmount rdf:type rdf:Property ;
    rdfs:label 'Taa Target Amount' ;
    rdfs:comment 'The dollar value corresponding to the TAA target weight for this asset class.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taaTargetWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Taa Target Weight Percent' ;
    rdfs:comment 'The current tactical asset allocation target weight for this asset class, reflecting short-to-medium term market views and deviations from SAA.' ;
    rdfs:domain ind:TaaPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingId rdf:type rdf:Property ;
    rdfs:label 'Holding Id' ;
    rdfs:comment 'Unique identifier for the holding position record in the Investment Book of Record (IBOR).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Holding .

ind:counterpartyId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Id' ;
    rdfs:comment 'Reference to the custodian bank or fund administrator holding the security on behalf of the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:fairValueHierarchyId rdf:type rdf:Property ;
    rdfs:label 'Fair Value Hierarchy Id' ;
    rdfs:comment 'Foreign key linking to valuation.fair_value_hierarchy. Business justification: IFRS 13/ASC 820 fair value disclosure requires Level 1/2/3 classification per holding. Pension funds must report fair value hierarchy in financial statements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FairValueHierarchy .

ind:infraAssetId rdf:type rdf:Property ;
    rdfs:label 'Infra Asset Id' ;
    rdfs:comment 'Foreign key linking to infrastructure.infra_asset. Business justification: Pension funds hold direct infrastructure assets. Holdings must reference infra_asset for NAV calculation, performance attribution, and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InfraAsset .

ind:listedSecurityId rdf:type rdf:Property ;
    rdfs:label 'Listed Security Id' ;
    rdfs:comment 'Reference to the security or asset held in this position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ListedSecurity .

ind:propertyId rdf:type rdf:Property ;
    rdfs:label 'Property Id' ;
    rdfs:comment 'Foreign key linking to realestate.property. Business justification: Direct real estate holdings require property linkage for NAV calculation, performance attribution, and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Property .

ind:sleeveId rdf:type rdf:Property ;
    rdfs:label 'Sleeve Id' ;
    rdfs:comment 'Foreign key linking to portfolio.sleeve. Business justification: Holdings can be allocated to specific sleeves within a portfolio. Pension funds commonly organize holdings by sleeve (equity sleeve, fixed income sleeve, alternatives sleeve).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Sleeve .

ind:accountNumber rdf:type rdf:Property ;
    rdfs:label 'Account Number' ;
    rdfs:comment 'The custodian account number where the security is held.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accruedIncomeBase rdf:type rdf:Property ;
    rdfs:label 'Accrued Income Base' ;
    rdfs:comment 'The income earned but not yet received on the holding (e.g., accrued interest, dividends) in base currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accruedIncomeLocal rdf:type rdf:Property ;
    rdfs:label 'Accrued Income Local' ;
    rdfs:comment 'The income earned but not yet received on the holding in local currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetClass rdf:type rdf:Property ;
    rdfs:label 'Asset Class' ;
    rdfs:comment 'The primary asset class classification of the holding for strategic asset allocation (SAA) and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Base Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code for the portfolios base reporting currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkWeight rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight' ;
    rdfs:comment 'The target weight of this security in the portfolios assigned benchmark, expressed as a decimal (e.g., 0.025 for 2.5%).' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralFlag rdf:type rdf:Property ;
    rdfs:label 'Collateral Flag' ;
    rdfs:comment 'Indicates whether the holding is pledged as collateral for derivatives, securities lending, or repo transactions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Commitment Amount' ;
    rdfs:comment 'For private market investments, the total committed capital to the fund or co-investment, representing dry powder.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costBase rdf:type rdf:Property ;
    rdfs:label 'Cost Base' ;
    rdfs:comment 'The total acquisition cost of the holding in base currency, used for gain/loss calculation.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costLocal rdf:type rdf:Property ;
    rdfs:label 'Cost Local' ;
    rdfs:comment 'The total acquisition cost of the holding in the local trading currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgRating rdf:type rdf:Property ;
    rdfs:label 'Esg Rating' ;
    rdfs:comment 'The ESG rating or score assigned to the holding by an external provider (e.g., MSCI, Sustainalytics) for responsible investment reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Flag' ;
    rdfs:comment 'Indicates whether the holding is subject to ESG exclusion criteria or is on a restricted list for responsible investment compliance.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:holdingStatus rdf:type rdf:Property ;
    rdfs:label 'Holding Status' ;
    rdfs:comment 'The current lifecycle status of the holding position in the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeType rdf:type rdf:Property ;
    rdfs:label 'Income Type' ;
    rdfs:comment 'The type of income generated by this holding for performance attribution and tax reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentType rdf:type rdf:Property ;
    rdfs:label 'Investment Type' ;
    rdfs:comment 'The structure of the investment: direct ownership, co-investment alongside a GP, fund commitment (LP), or secondary market purchase.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastValuationDate rdf:type rdf:Property ;
    rdfs:label 'Last Valuation Date' ;
    rdfs:comment 'The date on which the holding was last valued, particularly relevant for illiquid private market assets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lendingFlag rdf:type rdf:Property ;
    rdfs:label 'Lending Flag' ;
    rdfs:comment 'Indicates whether the holding is currently on loan under a securities lending program.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:localCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Local Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code for the securitys trading currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketValueBase rdf:type rdf:Property ;
    rdfs:label 'Market Value Base' ;
    rdfs:comment 'The current market value of the holding in base currency, calculated as quantity multiplied by market price.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValueLocal rdf:type rdf:Property ;
    rdfs:label 'Market Value Local' ;
    rdfs:comment 'The current market value of the holding in the local trading currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioWeight rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight' ;
    rdfs:comment 'The actual weight of this holding in the portfolio, calculated as market value divided by total portfolio NAV.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantity rdf:type rdf:Property ;
    rdfs:label 'Quantity' ;
    rdfs:comment 'The number of units, shares, or notional amount of the security held in this position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalancingFlag rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Flag' ;
    rdfs:comment 'Indicates whether the holding is currently flagged for rebalancing to align with strategic or tactical asset allocation targets.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictedFlag rdf:type rdf:Property ;
    rdfs:label 'Restricted Flag' ;
    rdfs:comment 'Indicates whether the holding is subject to trading restrictions (e.g., lock-up period, regulatory restriction, insider trading blackout).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:restrictionEndDate rdf:type rdf:Property ;
    rdfs:label 'Restriction End Date' ;
    rdfs:comment 'The date on which trading restrictions on the holding are lifted, if applicable.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:settlementDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Date' ;
    rdfs:comment 'The date on which the most recent transaction affecting this holding was settled (T+2 or other convention).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subAssetClass rdf:type rdf:Property ;
    rdfs:label 'Sub Asset Class' ;
    rdfs:comment 'The secondary or granular asset class classification for tactical asset allocation (TAA) and detailed reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLotMethod rdf:type rdf:Property ;
    rdfs:label 'Tax Lot Method' ;
    rdfs:comment 'The method used to track cost basis for tax reporting and realized gain/loss calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeDate rdf:type rdf:Property ;
    rdfs:label 'Trade Date' ;
    rdfs:comment 'The date on which the most recent transaction affecting this holding was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unfundedCommitment rdf:type rdf:Property ;
    rdfs:label 'Unfunded Commitment' ;
    rdfs:comment 'The remaining uncalled committed capital for private market investments, representing future capital call exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitCostBase rdf:type rdf:Property ;
    rdfs:label 'Unit Cost Base' ;
    rdfs:comment 'The average cost per unit of the security in base currency, used for cost basis and performance attribution.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitCostLocal rdf:type rdf:Property ;
    rdfs:label 'Unit Cost Local' ;
    rdfs:comment 'The average cost per unit of the security in the local trading currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedGainLossBase rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss Base' ;
    rdfs:comment 'The difference between market value and cost in base currency, representing unrealized profit or loss on the position.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedGainLossLocal rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss Local' ;
    rdfs:comment 'The difference between market value and cost in local currency.' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationLevel rdf:type rdf:Property ;
    rdfs:label 'Valuation Level' ;
    rdfs:comment 'The IFRS 13 fair value hierarchy level (Level 1: quoted prices, Level 2: observable inputs, Level 3: unobservable inputs).' ;
    rdfs:domain ind:Holding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationSource rdf:type rdf:Property ;
    rdfs:label 'Valuation Source' ;
    rdfs:comment 'The source or method used to determine the market value of the holding, critical for illiquid private assets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vintageYear rdf:type rdf:Property ;
    rdfs:label 'Vintage Year' ;
    rdfs:comment 'For private equity and private market funds, the year in which the fund held its initial closing and began investing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holdingSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Holding Snapshot Id' ;
    rdfs:comment 'Unique identifier for the holding snapshot record. Primary key.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:HoldingSnapshot .

ind:marketPriceSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Market Price Snapshot Id' ;
    rdfs:comment 'Foreign key linking to valuation.market_price_snapshot. Business justification: Daily mark-to-market process requires linking holding snapshots to market prices.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarketPriceSnapshot .

ind:accruedIncomeBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Accrued Income Base Currency' ;
    rdfs:comment 'The accrued interest, dividends, or other income earned but not yet received on the holding, in base currency.' ;
    rdfs:domain ind:HoldingSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonIntensity rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity' ;
    rdfs:comment 'The greenhouse gas emissions intensity of the security or issuer, typically measured in tonnes of CO2 equivalent per million dollars of revenue.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commitmentAmountBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Commitment Amount Base Currency' ;
    rdfs:comment 'The total capital commitment made to the investment, applicable to private equity, infrastructure, and other capital call structures, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countryOfRisk rdf:type rdf:Property ;
    rdfs:label 'Country Of Risk' ;
    rdfs:comment 'The three-letter ISO 3166-1 alpha-3 country code representing the primary country exposure or risk of the security.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponRate rdf:type rdf:Property ;
    rdfs:label 'Coupon Rate' ;
    rdfs:comment 'The annual interest rate paid on a fixed income security, expressed as a percentage. Null for non-interest-bearing securities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditRating rdf:type rdf:Property ;
    rdfs:label 'Credit Rating' ;
    rdfs:comment 'The credit quality rating assigned to the security by a recognized rating agency such as Moody\'s, S&P, or Fitch.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cusip rdf:type rdf:Property ;
    rdfs:label 'Cusip' ;
    rdfs:comment 'The nine-character alphanumeric code identifying North American securities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationYears rdf:type rdf:Property ;
    rdfs:label 'Duration Years' ;
    rdfs:comment 'The weighted average time to receive the cash flows from the security, measuring interest rate sensitivity. Applicable to fixed income holdings.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fairValueLevel rdf:type rdf:Property ;
    rdfs:label 'Fair Value Level' ;
    rdfs:comment 'The IFRS 13 fair value hierarchy level: Level 1 for quoted prices in active markets, Level 2 for observable inputs, Level 3 for unobservable inputs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isin rdf:type rdf:Property ;
    rdfs:label 'Isin' ;
    rdfs:comment 'The 12-character alphanumeric code that uniquely identifies the security internationally.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerLei rdf:type rdf:Property ;
    rdfs:label 'Issuer Lei' ;
    rdfs:comment 'The 20-character ISO 17442 Legal Entity Identifier of the security issuer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerName rdf:type rdf:Property ;
    rdfs:label 'Issuer Name' ;
    rdfs:comment 'The name of the entity that issued the security.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketPrice rdf:type rdf:Property ;
    rdfs:label 'Market Price' ;
    rdfs:comment 'The market price per unit of the security at the snapshot date, in the security\'s trading currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValueBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Market Value Base Currency' ;
    rdfs:comment 'The total market value of the holding position in the portfolio base currency at the snapshot date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maturityDate rdf:type rdf:Property ;
    rdfs:label 'Maturity Date' ;
    rdfs:comment 'The date on which the principal amount of a fixed income security becomes due and payable. Null for equities and perpetual instruments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sectorCode rdf:type rdf:Property ;
    rdfs:label 'Sector Code' ;
    rdfs:comment 'The industry sector classification code of the security, typically following GICS, ICB, or internal taxonomy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Security Currency Code' ;
    rdfs:comment 'The three-letter ISO 4217 currency code in which the security is denominated and traded.' ;
    rdfs:domain ind:HoldingSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityName rdf:type rdf:Property ;
    rdfs:label 'Security Name' ;
    rdfs:comment 'The full legal or common name of the security held in the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sedol rdf:type rdf:Property ;
    rdfs:label 'Sedol' ;
    rdfs:comment 'The seven-character identification code assigned to securities trading on the London Stock Exchange and other UK markets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:snapshotDate rdf:type rdf:Property ;
    rdfs:label 'Snapshot Date' ;
    rdfs:comment 'The business date for which this holding snapshot was captured, typically end-of-day or month-end.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:snapshotTimestamp rdf:type rdf:Property ;
    rdfs:label 'Snapshot Timestamp' ;
    rdfs:comment 'The precise timestamp when the holding snapshot was captured in the source system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tickerSymbol rdf:type rdf:Property ;
    rdfs:label 'Ticker Symbol' ;
    rdfs:comment 'The abbreviated trading symbol used to uniquely identify publicly traded securities on an exchange.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCostBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Total Cost Base Currency' ;
    rdfs:comment 'The total acquisition cost of the holding position in the portfolio base currency.' ;
    rdfs:domain ind:HoldingSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unfundedCommitmentBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Unfunded Commitment Base Currency' ;
    rdfs:comment 'The remaining uncalled capital commitment available for future capital calls, in base currency. Also known as dry powder.' ;
    rdfs:domain ind:HoldingSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitCostBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Unit Cost Base Currency' ;
    rdfs:comment 'The average cost per unit of the holding expressed in the portfolio base currency.' ;
    rdfs:domain ind:HoldingSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedGainLossBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss Base Currency' ;
    rdfs:comment 'The unrealized profit or loss on the holding position, calculated as market value minus total cost in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightPercent rdf:type rdf:Property ;
    rdfs:label 'Weight Percent' ;
    rdfs:comment 'The percentage weight of this holding within the total portfolio market value at the snapshot date.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ytm rdf:type rdf:Property ;
    rdfs:label 'Ytm' ;
    rdfs:comment 'The total return anticipated on a bond if held until maturity, expressed as an annual percentage rate.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:supersededByBenchmarkPortfolioBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Benchmark Portfolio Benchmark Id' ;
    rdfs:comment 'Reference to the portfolio benchmark assignment that replaced this one, if superseded; null if still active or not replaced.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioBenchmark .

ind:assignmentEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Effective Date' ;
    rdfs:comment 'Date from which this benchmark assignment becomes effective for performance measurement and reporting.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Assignment End Date' ;
    rdfs:comment 'Date on which this benchmark assignment ceases to be effective; null for open-ended assignments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignmentReason rdf:type rdf:Property ;
    rdfs:label 'Assignment Reason' ;
    rdfs:comment 'Business rationale or justification for assigning this benchmark to the portfolio (e.g., strategic asset allocation change, mandate requirement, regulatory compliance).' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assignment Status' ;
    rdfs:comment 'Current lifecycle status of the benchmark assignment to the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkCategory rdf:type rdf:Property ;
    rdfs:label 'Benchmark Category' ;
    rdfs:comment 'High-level asset class category that the benchmark represents. [ENUM-REF-CANDIDATE: equity|fixed_income|real_estate|infrastructure|private_equity|multi_asset|alternative — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkDescription rdf:type rdf:Property ;
    rdfs:label 'Benchmark Description' ;
    rdfs:comment 'Detailed textual description of the benchmark methodology, composition, and investment universe.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkType rdf:type rdf:Property ;
    rdfs:label 'Benchmark Type' ;
    rdfs:comment 'Classification of the benchmark: market index (published third-party), custom blend (internally constructed), liability benchmark (actuarial liability proxy), peer group (universe comparison), or absolute return (fixed target).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currency rdf:type rdf:Property ;
    rdfs:label 'Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the benchmark is denominated (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:customBlendDefinition rdf:type rdf:Property ;
    rdfs:label 'Custom Blend Definition' ;
    rdfs:comment 'Detailed specification of component benchmarks and weights for custom blended benchmarks; null for standard market indices.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSource rdf:type rdf:Property ;
    rdfs:label 'Data Source' ;
    rdfs:comment 'System or vendor from which benchmark return and composition data is sourced (e.g., Bloomberg, MSCI, FactSet, SimCorp, Internal).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geography rdf:type rdf:Property ;
    rdfs:label 'Geography' ;
    rdfs:comment 'Geographic scope or regional focus of the benchmark. [ENUM-REF-CANDIDATE: global|developed_markets|emerging_markets|north_america|europe|asia_pacific|usa|other — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Date' ;
    rdfs:comment 'Date on which the Investment Committee approved this benchmark assignment or change.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:identifier rdf:type rdf:Property ;
    rdfs:label 'Identifier' ;
    rdfs:comment 'External standard identifier for the benchmark such as Bloomberg Ticker, ISIN, or SEDOL where applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPrimaryBenchmark rdf:type rdf:Property ;
    rdfs:label 'Is Primary Benchmark' ;
    rdfs:comment 'Indicates whether this is the primary benchmark for the portfolio; true if primary, false if secondary or supplemental.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastModifiedBy rdf:type rdf:Property ;
    rdfs:label 'Last Modified By' ;
    rdfs:comment 'User identifier or name of the person who last modified this portfolio benchmark assignment record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityMatchingFlag rdf:type rdf:Property ;
    rdfs:label 'Liability Matching Flag' ;
    rdfs:comment 'Indicates whether this benchmark is designed to match actuarial liability cash flows for Liability-Driven Investment (LDI) purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceFeeBenchmarkFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Benchmark Flag' ;
    rdfs:comment 'Indicates whether this benchmark is used as the hurdle rate for calculating performance-based fees or carried interest.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:provider rdf:type rdf:Property ;
    rdfs:label 'Provider' ;
    rdfs:comment 'Name of the organization that publishes or maintains the benchmark (e.g., MSCI, FTSE Russell, Bloomberg, S&P Dow Jones, Internal).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Return Calculation Method' ;
    rdfs:comment 'Methodology used to calculate benchmark returns (e.g., Time-Weighted Return, Money-Weighted Return, Total Return including dividends, Price Return only).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingErrorTargetBps rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Target Bps' ;
    rdfs:comment 'Target tracking error in basis points that the portfolio is expected to maintain relative to this benchmark.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:version rdf:type rdf:Property ;
    rdfs:label 'Version' ;
    rdfs:comment 'Version identifier for the benchmark methodology or composition, used to track changes over time.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volatilityPercent rdf:type rdf:Property ;
    rdfs:label 'Volatility Percent' ;
    rdfs:comment 'Annualized standard deviation of benchmark returns, expressed as a percentage, representing historical volatility.' ;
    rdfs:domain ind:PortfolioBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:createdBy rdf:type rdf:Property ;
    rdfs:label 'Created By' ;
    rdfs:comment 'User identifier or name of the person who created this portfolio benchmark assignment record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Benchmark Assignment Id' ;
    rdfs:comment 'Unique identifier for the benchmark assignment record. Primary key for this entity.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByAssignmentBenchmarkAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Assignment Benchmark Assignment Id' ;
    rdfs:comment 'Reference to the benchmark assignment record that replaces this one, used to maintain assignment lineage when benchmarks are changed.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BenchmarkAssignment .

ind:assignmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assignment Notes' ;
    rdfs:comment 'Free-text field for additional context, special instructions, or documentation related to this benchmark assignment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentSource rdf:type rdf:Property ;
    rdfs:label 'Assignment Source' ;
    rdfs:comment 'Origin or authority that determined this benchmark assignment, indicating who or what process established the relationship.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentType rdf:type rdf:Property ;
    rdfs:label 'Assignment Type' ;
    rdfs:comment 'Classification of the benchmark assignment role: primary (main performance benchmark), secondary (alternative comparison), risk (risk measurement), liability (ALM matching), composite (blended), or custom (special purpose).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignmentWeight rdf:type rdf:Property ;
    rdfs:label 'Assignment Weight' ;
    rdfs:comment 'Weighting factor for this benchmark in blended benchmark calculations, expressed as a decimal (e.g., 0.60 for 60%). Sum of weights across all active assignments for a portfolio should equal 1.0.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyHedgingFlag rdf:type rdf:Property ;
    rdfs:label 'Currency Hedging Flag' ;
    rdfs:comment 'Indicates whether the benchmark returns for this assignment reflect currency hedging adjustments to match portfolio hedging strategy.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:customBenchmarkFlag rdf:type rdf:Property ;
    rdfs:label 'Custom Benchmark Flag' ;
    rdfs:comment 'Indicates whether this is a custom-constructed benchmark specific to this portfolio rather than a standard market index.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingFlag rdf:type rdf:Property ;
    rdfs:label 'Reporting Flag' ;
    rdfs:comment 'Indicates whether this benchmark assignment should be included in client and regulatory reporting packages.' ;
    rdfs:domain ind:BenchmarkAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trackingErrorLimit rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Limit' ;
    rdfs:comment 'Maximum allowable tracking error (standard deviation of return differences) between portfolio and benchmark, expressed in basis points. Used for risk monitoring and compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetClassWeightId rdf:type rdf:Property ;
    rdfs:label 'Asset Class Weight Id' ;
    rdfs:comment 'Unique identifier for the asset class weight record.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:activeWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Active Weight Percentage' ;
    rdfs:comment 'The difference between portfolio actual weight and benchmark weight, expressed in percentage points, indicating active positioning versus benchmark.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Benchmark Weight Percentage' ;
    rdfs:comment 'The weight of this asset class in the composite benchmark index used for performance comparison, expressed as a percentage.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calculationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Calculation Timestamp' ;
    rdfs:comment 'The precise date and time when this asset class weight was calculated by the portfolio management system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:contributionToReturn rdf:type rdf:Property ;
    rdfs:label 'Contribution To Return' ;
    rdfs:comment 'The contribution of this asset class to total portfolio return for the period, calculated as weight multiplied by asset class return, expressed as a percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:deviationFromTarget rdf:type rdf:Property ;
    rdfs:label 'Deviation From Target' ;
    rdfs:comment 'The difference between actual weight and target weight, expressed in percentage points (actual minus target), indicating over or under allocation.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Effective Weight Percentage' ;
    rdfs:comment 'The effective allocation weight including unfunded commitments, calculated as (market value plus unfunded commitments) divided by (total portfolio value plus total unfunded commitments), expressed as a percentage.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Esg Weight Percentage' ;
    rdfs:comment 'The percentage of this asset class that is invested in holdings meeting ESG criteria or responsible investment standards.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValue rdf:type rdf:Property ;
    rdfs:label 'Market Value' ;
    rdfs:comment 'The total market value of holdings in this asset class as of the valuation date, in the portfolio base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedBy rdf:type rdf:Property ;
    rdfs:label 'Modified By' ;
    rdfs:comment 'The user identifier or system process that last modified this asset class weight record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfHoldings rdf:type rdf:Property ;
    rdfs:label 'Number Of Holdings' ;
    rdfs:comment 'The count of distinct investment positions within this asset class as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorPeriodWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Prior Period Weight Percentage' ;
    rdfs:comment 'The asset class weight percentage from the previous valuation period, used for period-over-period comparison and drift analysis.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalancingThresholdLower rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Threshold Lower' ;
    rdfs:comment 'The lower bound threshold percentage below which the asset class weight triggers a rebalancing action per portfolio policy.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalancingThresholdUpper rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Threshold Upper' ;
    rdfs:comment 'The upper bound threshold percentage above which the asset class weight triggers a rebalancing action per portfolio policy.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingPeriod rdf:type rdf:Property ;
    rdfs:label 'Reporting Period' ;
    rdfs:comment 'The reporting period to which this weight record belongs, formatted as YYYY-QN for quarterly, YYYY-MNN for monthly, or YYYY-YYYY for annual.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tacticalWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Tactical Weight Percentage' ;
    rdfs:comment 'The tactical asset allocation (TAA) target weight for this asset class reflecting short-term market views and adjustments, expressed as a percentage.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetWeightPercentage rdf:type rdf:Property ;
    rdfs:label 'Target Weight Percentage' ;
    rdfs:comment 'The strategic asset allocation (SAA) target weight for this asset class as defined by the investment policy, expressed as a percentage.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unfundedCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Unfunded Commitment Amount' ;
    rdfs:comment 'The total uncalled committed capital (dry powder) for this asset class, applicable primarily to private markets investments, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Weight Calculation Method' ;
    rdfs:comment 'The methodology used to calculate the asset class weight (market value, net asset value, fair value, or cost basis).' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Weight Change Percentage' ;
    rdfs:comment 'The change in asset class weight from prior period to current period, expressed in percentage points, indicating allocation drift.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightPercentage rdf:type rdf:Property ;
    rdfs:label 'Weight Percentage' ;
    rdfs:comment 'The actual allocation weight of this asset class within the portfolio, expressed as a percentage of total portfolio value (e.g., 25.500000 represents 25.5%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightStatus rdf:type rdf:Property ;
    rdfs:label 'Weight Status' ;
    rdfs:comment 'Categorical status indicating whether the asset class weight is within policy range, overweight, underweight, or at target relative to strategic allocation.' ;
    rdfs:domain ind:AssetClassWeight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalancingEventId rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Event Id' ;
    rdfs:comment 'Unique identifier for the portfolio rebalancing event. Primary key.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Approval Required Flag' ;
    rdfs:comment 'Indicates whether Investment Committee (IC) or senior management approval was required before executing this rebalancing event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvalTimestamp rdf:type rdf:Property ;
    rdfs:label 'Approval Timestamp' ;
    rdfs:comment 'Date and time when the rebalancing event received formal approval to proceed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:carbonFootprintPost rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint Post' ;
    rdfs:comment 'Total carbon footprint of the portfolio after rebalancing, used to assess climate impact of the rebalancing decision.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonFootprintPre rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint Pre' ;
    rdfs:comment 'Total carbon footprint of the portfolio before rebalancing, measured in tonnes of CO2 equivalent per million invested.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashRequirement rdf:type rdf:Property ;
    rdfs:label 'Cash Requirement' ;
    rdfs:comment 'Minimum cash or liquid asset requirement that must be maintained post-rebalancing to meet near-term liability obligations, in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:driftPercentage rdf:type rdf:Property ;
    rdfs:label 'Drift Percentage' ;
    rdfs:comment 'Percentage deviation from target allocation that triggered the rebalancing, measured in basis points or percentage points.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:driftThresholdBreached rdf:type rdf:Property ;
    rdfs:label 'Drift Threshold Breached' ;
    rdfs:comment 'Indicates whether the rebalancing was triggered by a breach of the Strategic Asset Allocation (SAA) or Tactical Asset Allocation (TAA) drift threshold.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgImpactAssessed rdf:type rdf:Property ;
    rdfs:label 'Esg Impact Assessed' ;
    rdfs:comment 'Indicates whether the rebalancing event included an assessment of Environmental, Social, and Governance (ESG) impact on the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgScorePost rdf:type rdf:Property ;
    rdfs:label 'Esg Score Post' ;
    rdfs:comment 'Aggregate ESG score of the portfolio after the rebalancing event, used to measure ESG improvement or degradation.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgScorePre rdf:type rdf:Property ;
    rdfs:label 'Esg Score Pre' ;
    rdfs:comment 'Aggregate ESG score of the portfolio before the rebalancing event, typically on a 0-100 scale.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedMarketImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Market Impact' ;
    rdfs:comment 'Estimated cost of market impact from executing large rebalancing trades, measured in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTaxImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Tax Impact' ;
    rdfs:comment 'Estimated tax liability or benefit resulting from the rebalancing trades, including capital gains taxes, in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventNumber rdf:type rdf:Property ;
    rdfs:label 'Event Number' ;
    rdfs:comment 'Business identifier for the rebalancing event, formatted as REB-YYYYMMDD-NNNNNN for external reference and audit trails.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventTimestamp rdf:type rdf:Property ;
    rdfs:label 'Event Timestamp' ;
    rdfs:comment 'Date and time when the rebalancing event was initiated or triggered.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution End Timestamp' ;
    rdfs:comment 'Date and time when all trades for the rebalancing event were completed and settled.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Execution Start Timestamp' ;
    rdfs:comment 'Date and time when trade execution for the rebalancing event commenced.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:executionStrategy rdf:type rdf:Property ;
    rdfs:label 'Execution Strategy' ;
    rdfs:comment 'Trading execution strategy employed for the rebalancing trades to minimize market impact and transaction costs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityConstraintApplied rdf:type rdf:Property ;
    rdfs:label 'Liquidity Constraint Applied' ;
    rdfs:comment 'Indicates whether liquidity constraints were applied during the rebalancing to ensure sufficient cash for liability payments.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postRebalancingNav rdf:type rdf:Property ;
    rdfs:label 'Post Rebalancing Nav' ;
    rdfs:comment 'Total Net Asset Value of the portfolio immediately after the rebalancing event, in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postTradeVar rdf:type rdf:Property ;
    rdfs:label 'Post Trade Var' ;
    rdfs:comment 'Portfolio Value at Risk (VaR) calculated after the rebalancing event, used to assess risk impact.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preRebalancingNav rdf:type rdf:Property ;
    rdfs:label 'Pre Rebalancing Nav' ;
    rdfs:comment 'Total Net Asset Value of the portfolio immediately before the rebalancing event, in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preTradeVar rdf:type rdf:Property ;
    rdfs:label 'Pre Trade Var' ;
    rdfs:comment 'Portfolio Value at Risk (VaR) calculated before the rebalancing event, used for risk comparison.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebalancingNotes rdf:type rdf:Property ;
    rdfs:label 'Rebalancing Notes' ;
    rdfs:comment 'Free-text field for portfolio managers to document additional context, rationale, or special considerations for this rebalancing event.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentPerformed rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Performed' ;
    rdfs:comment 'Indicates whether a pre-trade risk assessment was conducted before executing the rebalancing event.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scheduledRebalancingFlag rdf:type rdf:Property ;
    rdfs:label 'Scheduled Rebalancing Flag' ;
    rdfs:comment 'Indicates whether this rebalancing event was part of a scheduled periodic rebalancing cycle (e.g., quarterly, annual).' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:systemSource rdf:type rdf:Property ;
    rdfs:label 'System Source' ;
    rdfs:comment 'Name of the source system that generated or recorded this rebalancing event (e.g., SimCorp Dimension, BlackRock Aladdin).' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAllocationType rdf:type rdf:Property ;
    rdfs:label 'Target Allocation Type' ;
    rdfs:comment 'Indicates whether the rebalancing targets Strategic Asset Allocation (SAA) or Tactical Asset Allocation (TAA) weights.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxOptimizationApplied rdf:type rdf:Property ;
    rdfs:label 'Tax Optimization Applied' ;
    rdfs:comment 'Indicates whether tax-loss harvesting or other tax optimization strategies were applied during the rebalancing event.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalTradesExecuted rdf:type rdf:Property ;
    rdfs:label 'Total Trades Executed' ;
    rdfs:comment 'Number of individual trade orders executed as part of this rebalancing event across all asset classes.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalTransactionCost rdf:type rdf:Property ;
    rdfs:label 'Total Transaction Cost' ;
    rdfs:comment 'Aggregate transaction costs incurred during the rebalancing, including brokerage fees, commissions, and market impact costs, in base currency.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackingErrorPost rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Post' ;
    rdfs:comment 'Tracking error of the portfolio relative to its benchmark after the rebalancing event, expressed as a percentage.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trackingErrorPre rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Pre' ;
    rdfs:comment 'Tracking error of the portfolio relative to its benchmark before the rebalancing event, expressed as a percentage.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCostBps rdf:type rdf:Property ;
    rdfs:label 'Transaction Cost Bps' ;
    rdfs:comment 'Total transaction cost expressed as basis points of the portfolio NAV, used for cost efficiency analysis.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggerDescription rdf:type rdf:Property ;
    rdfs:label 'Trigger Description' ;
    rdfs:comment 'Detailed narrative explaining the specific reason or condition that triggered this rebalancing event.' ;
    rdfs:domain ind:RebalancingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerType rdf:type rdf:Property ;
    rdfs:label 'Trigger Type' ;
    rdfs:comment 'Classification of the event that triggered the rebalancing action.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintId rdf:type rdf:Property ;
    rdfs:label 'Constraint Id' ;
    rdfs:comment 'Unique identifier for the investment constraint record.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Constraint .

ind:breachCount rdf:type rdf:Property ;
    rdfs:label 'Breach Count' ;
    rdfs:comment 'Cumulative number of times this constraint has been breached since inception.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachSeverity rdf:type rdf:Property ;
    rdfs:label 'Breach Severity' ;
    rdfs:comment 'Classification of the impact level when this constraint is violated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationMethod rdf:type rdf:Property ;
    rdfs:label 'Calculation Method' ;
    rdfs:comment 'Technical specification of how the constraint metric is computed from portfolio positions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintCategory rdf:type rdf:Property ;
    rdfs:label 'Constraint Category' ;
    rdfs:comment 'Classification of the constraint source indicating whether it originates from regulation, mandate terms, internal policy, or risk framework.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintCode rdf:type rdf:Property ;
    rdfs:label 'Constraint Code' ;
    rdfs:comment 'Business identifier code for the constraint rule, used for reference in compliance monitoring systems.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintStatus rdf:type rdf:Property ;
    rdfs:label 'Constraint Status' ;
    rdfs:comment 'Current lifecycle state of the constraint rule.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingMinimum rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Minimum' ;
    rdfs:comment 'Minimum acceptable credit rating for fixed income investments subject to this constraint.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgScoreMinimum rdf:type rdf:Property ;
    rdfs:label 'Esg Score Minimum' ;
    rdfs:comment 'Minimum ESG score required for investments under this constraint.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographyCode rdf:type rdf:Property ;
    rdfs:label 'Geography Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country or region code when constraint is geography-specific.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastBreachDate rdf:type rdf:Property ;
    rdfs:label 'Last Breach Date' ;
    rdfs:comment 'Most recent date on which this constraint was breached.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mandateClauseReference rdf:type rdf:Property ;
    rdfs:label 'Mandate Clause Reference' ;
    rdfs:comment 'Reference to the specific clause in the investment mandate document that defines this constraint.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumValue rdf:type rdf:Property ;
    rdfs:label 'Maximum Value' ;
    rdfs:comment 'Upper bound of the constraint range when threshold type is range-based.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumValue rdf:type rdf:Property ;
    rdfs:label 'Minimum Value' ;
    rdfs:comment 'Lower bound of the constraint range when threshold type is range-based.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringFrequency rdf:type rdf:Property ;
    rdfs:label 'Monitoring Frequency' ;
    rdfs:comment 'Cadence at which compliance with this constraint is evaluated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:constraintName rdf:type rdf:Property ;
    rdfs:label 'Constraint Name' ;
    rdfs:comment 'Human-readable name describing the constraint rule.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRecipients rdf:type rdf:Property ;
    rdfs:label 'Notification Recipients' ;
    rdfs:comment 'Comma-separated list of roles or individuals to be notified upon breach.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRequired rdf:type rdf:Property ;
    rdfs:label 'Notification Required' ;
    rdfs:comment 'Indicates whether stakeholders must be notified when this constraint is breached.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAllowed rdf:type rdf:Property ;
    rdfs:label 'Override Allowed' ;
    rdfs:comment 'Indicates whether this constraint can be temporarily overridden with appropriate authorization.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Override Authority Level' ;
    rdfs:comment 'Minimum authority level required to approve an override of this constraint. [ENUM-REF-CANDIDATE: portfolio_manager|chief_investment_officer|investment_committee|board|none — promote to reference product]' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reference' ;
    rdfs:comment 'Citation of the regulatory rule or guideline that mandates this constraint.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Remediation Period Days' ;
    rdfs:comment 'Number of business days allowed to remediate a breach before escalation.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleDescription rdf:type rdf:Property ;
    rdfs:label 'Rule Description' ;
    rdfs:comment 'Detailed textual description of the constraint rule and its business rationale.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope rdf:type rdf:Property ;
    rdfs:label 'Scope' ;
    rdfs:comment 'Level at which the constraint is applied within the portfolio hierarchy. [ENUM-REF-CANDIDATE: portfolio|asset_class|sector|issuer|security|counterparty|geography — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdCurrency rdf:type rdf:Property ;
    rdfs:label 'Threshold Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code when threshold is expressed in monetary terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdType rdf:type rdf:Property ;
    rdfs:label 'Threshold Type' ;
    rdfs:comment 'Type of threshold defining whether the constraint sets a floor, ceiling, or bounded range.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdUnit rdf:type rdf:Property ;
    rdfs:label 'Threshold Unit' ;
    rdfs:comment 'Unit of measure for the threshold value indicating whether it is expressed as percentage, basis points, currency amount, count, or ratio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdValue rdf:type rdf:Property ;
    rdfs:label 'Threshold Value' ;
    rdfs:comment 'Numeric value representing the constraint limit or target.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tolerancePercentage rdf:type rdf:Property ;
    rdfs:label 'Tolerance Percentage' ;
    rdfs:comment 'Allowable deviation from the threshold before a breach is triggered, expressed as percentage.' ;
    rdfs:domain ind:Constraint ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constraintBreachId rdf:type rdf:Property ;
    rdfs:label 'Constraint Breach Id' ;
    rdfs:comment 'Unique identifier for the constraint breach record. Primary key.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constraintRuleId rdf:type rdf:Property ;
    rdfs:label 'Constraint Rule Id' ;
    rdfs:comment 'Reference to the specific constraint rule or guideline that was breached.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rule .

ind:positionHoldingId rdf:type rdf:Property ;
    rdfs:label 'Position Holding Id' ;
    rdfs:comment 'Reference to the specific position that triggered the breach, if applicable.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Holding .

ind:acknowledgedBy rdf:type rdf:Property ;
    rdfs:label 'Acknowledged By' ;
    rdfs:comment 'Name or identifier of the individual who acknowledged the breach.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acknowledgedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Acknowledged Timestamp' ;
    rdfs:comment 'Date and time when the breach was formally acknowledged by compliance or portfolio management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualValue rdf:type rdf:Property ;
    rdfs:label 'Actual Value' ;
    rdfs:comment 'The actual measured value at the time of breach detection.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachAmount rdf:type rdf:Property ;
    rdfs:label 'Breach Amount' ;
    rdfs:comment 'The magnitude of the breach, calculated as the difference between actual value and threshold value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachDetectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Breach Detected Timestamp' ;
    rdfs:comment 'Date and time when the compliance monitoring system first detected the breach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breachNotes rdf:type rdf:Property ;
    rdfs:label 'Breach Notes' ;
    rdfs:comment 'Free-text field for additional context, commentary, or analysis related to the breach.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachOccurrenceTimestamp rdf:type rdf:Property ;
    rdfs:label 'Breach Occurrence Timestamp' ;
    rdfs:comment 'Date and time when the breach actually occurred in the portfolio, which may differ from detection time.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:breachPercentage rdf:type rdf:Property ;
    rdfs:label 'Breach Percentage' ;
    rdfs:comment 'The breach amount expressed as a percentage of the threshold, indicating relative severity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:breachReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Breach Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this breach for tracking and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachStatus rdf:type rdf:Property ;
    rdfs:label 'Breach Status' ;
    rdfs:comment 'Current lifecycle status of the breach in the compliance workflow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachType rdf:type rdf:Property ;
    rdfs:label 'Breach Type' ;
    rdfs:comment 'Classification of when the breach was detected in the trade lifecycle.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectedBySystem rdf:type rdf:Property ;
    rdfs:label 'Detected By System' ;
    rdfs:comment 'Name of the compliance monitoring system that detected the breach, such as BlackRock Aladdin or Charles River IMS.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:detectionMethod rdf:type rdf:Property ;
    rdfs:label 'Detection Method' ;
    rdfs:comment 'Method by which the breach was detected, indicating whether it was automated or manual.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalatedToIc rdf:type rdf:Property ;
    rdfs:label 'Escalated To Ic' ;
    rdfs:comment 'Indicates whether the breach was escalated to the Investment Committee for review and decision.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Escalation Timestamp' ;
    rdfs:comment 'Date and time when the breach was escalated to higher authority or the Investment Committee.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatorReportDate rdf:type rdf:Property ;
    rdfs:label 'Regulator Report Date' ;
    rdfs:comment 'Date on which the breach was reported to the regulatory authority.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reportable' ;
    rdfs:comment 'Indicates whether this breach must be reported to regulatory authorities such as SEC, or FCA.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Remediated Timestamp' ;
    rdfs:comment 'Date and time when the breach was successfully remediated and the portfolio returned to compliance.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:remediationAction rdf:type rdf:Property ;
    rdfs:label 'Remediation Action' ;
    rdfs:comment 'Description of the corrective action taken or planned to remediate the breach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationDeadline rdf:type rdf:Property ;
    rdfs:label 'Remediation Deadline' ;
    rdfs:comment 'Target date by which the breach must be remediated according to policy or regulatory requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportedToRegulator rdf:type rdf:Property ;
    rdfs:label 'Reported To Regulator' ;
    rdfs:comment 'Indicates whether the breach has been formally reported to the applicable regulatory body.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sector rdf:type rdf:Property ;
    rdfs:label 'Sector' ;
    rdfs:comment 'Industry sector classification of the security or investment involved in the breach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Security Identifier' ;
    rdfs:comment 'Unique identifier of the security involved in the breach, such as ISIN, CUSIP, or SEDOL.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityLevel rdf:type rdf:Property ;
    rdfs:label 'Severity Level' ;
    rdfs:comment 'Assessed severity or materiality of the breach for risk management and escalation purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Unit Of Measure' ;
    rdfs:comment 'The unit in which threshold and actual values are expressed. [ENUM-REF-CANDIDATE: percent|bps|currency|shares|units|days|years|ratio — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved By' ;
    rdfs:comment 'Name or identifier of the authority who approved the waiver.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Expiry Date' ;
    rdfs:comment 'Date on which the granted waiver expires and the constraint becomes enforceable again.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverGranted rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted' ;
    rdfs:comment 'Indicates whether a formal waiver or exception was granted for this breach by the Investment Committee or compliance authority.' ;
    rdfs:domain ind:ConstraintBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverReason rdf:type rdf:Property ;
    rdfs:label 'Waiver Reason' ;
    rdfs:comment 'Business justification or rationale for granting a waiver, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gipsCompositeId rdf:type rdf:Property ;
    rdfs:label 'Gips Composite Id' ;
    rdfs:comment 'Unique identifier for the GIPS composite record.' ;
    rdfs:domain ind:Portfolio ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GipsComposite .

ind:compositeAum rdf:type rdf:Property ;
    rdfs:label 'Composite Aum' ;
    rdfs:comment 'Total market value of all assets under management within the composite as of the most recent valuation date, expressed in base currency.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:compositeCode rdf:type rdf:Property ;
    rdfs:label 'Composite Code' ;
    rdfs:comment 'Internal unique code or identifier assigned to the composite for system reference and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeCreationMethod rdf:type rdf:Property ;
    rdfs:label 'Composite Creation Method' ;
    rdfs:comment 'Method used to aggregate individual portfolio returns into the composite return (asset-weighted or equal-weighted).' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeDefinition rdf:type rdf:Property ;
    rdfs:label 'Composite Definition' ;
    rdfs:comment 'Formal definition and inclusion criteria that determine which portfolios are eligible for inclusion in the composite.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeDescription rdf:type rdf:Property ;
    rdfs:label 'Composite Description' ;
    rdfs:comment 'Detailed description of the composite investment strategy, mandate, and portfolio characteristics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeDispersionMeasure rdf:type rdf:Property ;
    rdfs:label 'Composite Dispersion Measure' ;
    rdfs:comment 'Statistical measure used to assess the variability of individual portfolio returns within the composite (e.g., standard deviation, range).' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeManagerName rdf:type rdf:Property ;
    rdfs:label 'Composite Manager Name' ;
    rdfs:comment 'Name of the investment manager or team responsible for managing portfolios within the composite.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeName rdf:type rdf:Property ;
    rdfs:label 'Composite Name' ;
    rdfs:comment 'Official name of the GIPS composite used for performance presentation and client reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeNotes rdf:type rdf:Property ;
    rdfs:label 'Composite Notes' ;
    rdfs:comment 'Additional notes, disclosures, or commentary regarding the composite structure, performance, or special considerations.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeStatus rdf:type rdf:Property ;
    rdfs:label 'Composite Status' ;
    rdfs:comment 'Current lifecycle status of the composite indicating whether it is actively maintained for performance reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeType rdf:type rdf:Property ;
    rdfs:label 'Composite Type' ;
    rdfs:comment 'Classification of the composite based on portfolio management discretion and structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:derivativesUsageFlag rdf:type rdf:Property ;
    rdfs:label 'Derivatives Usage Flag' ;
    rdfs:comment 'Indicates whether portfolios within the composite are permitted to use derivative instruments for hedging or investment purposes.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgStrategyDescription rdf:type rdf:Property ;
    rdfs:label 'Esg Strategy Description' ;
    rdfs:comment 'Description of the ESG integration approach, screening criteria, and responsible investment practices applied to the composite.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeScheduleDescription rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Description' ;
    rdfs:comment 'Description of the fee structure and schedule applicable to portfolios within the composite, including management fees and performance fees.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicFocus rdf:type rdf:Property ;
    rdfs:label 'Geographic Focus' ;
    rdfs:comment 'Primary geographic region or market focus of the composite investment strategy (e.g., global, North America, emerging markets).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossOfFeesFlag rdf:type rdf:Property ;
    rdfs:label 'Gross Of Fees Flag' ;
    rdfs:comment 'Indicates whether composite performance is presented gross of investment management fees (True) or net of fees (False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastExaminationDate rdf:type rdf:Property ;
    rdfs:label 'Last Examination Date' ;
    rdfs:comment 'Date of the most recent independent performance examination or verification, if applicable.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Last Updated By' ;
    rdfs:comment 'User identifier or name of the individual who most recently updated the composite record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leverageFlag rdf:type rdf:Property ;
    rdfs:label 'Leverage Flag' ;
    rdfs:comment 'Indicates whether portfolios within the composite are permitted to use leverage or borrowing to enhance returns.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minimumPortfolioSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Portfolio Size' ;
    rdfs:comment 'Minimum asset value threshold required for a portfolio to be included in the composite, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOfFeesFlag rdf:type rdf:Property ;
    rdfs:label 'Net Of Fees Flag' ;
    rdfs:comment 'Indicates whether composite performance is presented net of investment management fees (True) or gross of fees (False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:numberOfPortfolios rdf:type rdf:Property ;
    rdfs:label 'Number Of Portfolios' ;
    rdfs:comment 'Count of individual portfolios currently included in the composite.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceExaminationFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Examination Flag' ;
    rdfs:comment 'Indicates whether the composite performance has been independently verified or examined by a third-party auditor in accordance with GIPS standards.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sectorFocus rdf:type rdf:Property ;
    rdfs:label 'Sector Focus' ;
    rdfs:comment 'Primary industry sector or economic sector focus of the composite investment strategy, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:threeYearExPostStandardDeviation rdf:type rdf:Property ;
    rdfs:label 'Three Year Ex Post Standard Deviation' ;
    rdfs:comment 'Annualized three-year ex-post standard deviation of composite returns, expressed as a percentage, used to measure historical volatility.' ;
    rdfs:domain ind:GipsComposite ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationMethodology rdf:type rdf:Property ;
    rdfs:label 'Valuation Methodology' ;
    rdfs:comment 'Description of the valuation approach and methodology used for portfolio assets within the composite (e.g., fair value, mark-to-market, DCF for private assets).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioCompositeMembershipId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Composite Membership Id' ;
    rdfs:comment 'Unique identifier for the portfolio composite membership association record.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Employee Id' ;
    rdfs:comment 'Identifier of the compliance officer or investment committee member who approved the composite membership assignment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:gipsComplianceRecordId rdf:type rdf:Property ;
    rdfs:label 'Gips Compliance Record Id' ;
    rdfs:comment 'Foreign key linking to compliance.gips_compliance_record. Business justification: Portfolio composite membership must reference the GIPS compliance record for the composite to enforce compliance reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GipsComplianceRecord .

ind:auditTrailReference rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Reference' ;
    rdfs:comment 'Reference identifier linking to detailed audit trail records for this composite membership assignment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkAssignmentOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Assignment Override Flag' ;
    rdfs:comment 'Indicates whether the portfolio uses a different benchmark than the composite\'s primary benchmark.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carveOutCashAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Carve Out Cash Allocation Method' ;
    rdfs:comment 'Method used to allocate cash to the carve-out portfolio if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carveOutFlag rdf:type rdf:Property ;
    rdfs:label 'Carve Out Flag' ;
    rdfs:comment 'Indicates whether the portfolio is a carve-out segment from a larger multi-strategy portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceNotes rdf:type rdf:Property ;
    rdfs:label 'Compliance Notes' ;
    rdfs:comment 'Free-text notes documenting compliance considerations, exceptions, or special circumstances related to the composite membership.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compositeAssignmentDate rdf:type rdf:Property ;
    rdfs:label 'Composite Assignment Date' ;
    rdfs:comment 'Date when the portfolio was formally assigned to the composite by the investment committee or compliance team.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:compositeDefinitionComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Composite Definition Compliance Flag' ;
    rdfs:comment 'Indicates whether the portfolio meets all criteria defined in the composite\'s investment mandate and strategy.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:discretionaryFlag rdf:type rdf:Property ;
    rdfs:label 'Discretionary Flag' ;
    rdfs:comment 'Indicates whether the portfolio was managed on a discretionary basis during the membership period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveEndDate rdf:type rdf:Property ;
    rdfs:label 'Effective End Date' ;
    rdfs:comment 'Date when the portfolio was removed from the composite, null if currently active.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:effectiveStartDate rdf:type rdf:Property ;
    rdfs:label 'Effective Start Date' ;
    rdfs:comment 'Date when the portfolio was first included in the composite.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for removing the portfolio from the composite, null if not excluded. [ENUM-REF-CANDIDATE: mandate_change|strategy_drift|closure|transfer|non_discretionary|regulatory|client_request — 7 candidates stripped; promote' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why the portfolio was excluded from the composite.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePayingFlag rdf:type rdf:Property ;
    rdfs:label 'Fee Paying Flag' ;
    rdfs:comment 'Indicates whether the portfolio pays management fees during the membership period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inclusionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Inclusion Reason Code' ;
    rdfs:comment 'Standardized code indicating the reason for including the portfolio in the composite.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inclusionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Inclusion Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of why the portfolio was included in the composite.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketValueAtExclusion rdf:type rdf:Property ;
    rdfs:label 'Market Value At Exclusion' ;
    rdfs:comment 'Total market value of the portfolio at the time of exclusion from the composite, in base currency, null if still active.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValueAtInclusion rdf:type rdf:Property ;
    rdfs:label 'Market Value At Inclusion' ;
    rdfs:comment 'Total market value of the portfolio at the time of inclusion in the composite, in base currency.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumAssetThresholdMetFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Asset Threshold Met Flag' ;
    rdfs:comment 'Indicates whether the portfolio meets the minimum asset size requirement for composite inclusion.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portfolioInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Portfolio Inception Date' ;
    rdfs:comment 'Date when the portfolio was first established, used to determine eligibility for composite inclusion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:significantCashFlowFlag rdf:type rdf:Property ;
    rdfs:label 'Significant Cash Flow Flag' ;
    rdfs:comment 'Indicates whether the portfolio experienced significant cash flows during the membership period that may affect composite performance.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:temporaryExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Temporary Exclusion Flag' ;
    rdfs:comment 'Indicates whether the portfolio was temporarily excluded from the composite due to significant cash flows or other transient conditions.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:weightInCompositePercent rdf:type rdf:Property ;
    rdfs:label 'Weight In Composite Percent' ;
    rdfs:comment 'Percentage weight of the portfolio within the composite based on market value, used for performance calculation.' ;
    rdfs:domain ind:PortfolioCompositeMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioCapitalCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Capital Commitment Id' ;
    rdfs:comment 'Unique identifier for the capital commitment record. Primary key for the portfolio capital commitment entity.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ddEngagementId rdf:type rdf:Property ;
    rdfs:label 'Dd Engagement Id' ;
    rdfs:comment 'Foreign key linking to diligence.dd_engagement. Business justification: Pension fund capital commitments to PE/infrastructure funds require completed due diligence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdEngagement .

ind:dealCapitalCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Deal Capital Commitment Id' ;
    rdfs:comment 'Foreign key linking to deal.deal_capital_commitment. Business justification: Commitment lifecycle reconciliation requires linking portfolio-stage commitments to their deal-stage predecessors. Audit trail from IC approval through funding depends on this.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealCapitalCommitment .

ind:fundId rdf:type rdf:Property ;
    rdfs:label 'Fund Id' ;
    rdfs:comment 'Reference to the pension fund or contributor pool making the capital commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:infraFundCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Infra Fund Commitment Id' ;
    rdfs:comment 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Portfolio-level capital commitments to infrastructure funds must link to infra_fund_commitment for unfunded commitment tracking, capital call forecasting, and SAA' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InfraFundCommitment .

ind:opportunityId rdf:type rdf:Property ;
    rdfs:label 'Opportunity Id' ;
    rdfs:comment 'Foreign key linking to deal.opportunity. Business justification: Deal attribution reporting requires tracing portfolio commitments to originating opportunities. Investment performance analysis by deal vintage and sourcing channel depends on this link.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opportunity .

ind:reFundCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Re Fund Commitment Id' ;
    rdfs:comment 'Foreign key linking to realestate.re_fund_commitment. Business justification: Pension funds track commitments to real estate funds alongside PE funds. Links portfolio-level commitment tracking to RE fund details for consolidated unfunded commitment' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReFundCommitment .

ind:baseCurrencyCommittedAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Committed Amount' ;
    rdfs:comment 'Committed amount converted to the pension fund base reporting currency at commitment date Foreign Exchange (FX) rate.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseCurrencyFundedAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Funded Amount' ;
    rdfs:comment 'Funded amount converted to the pension fund base reporting currency using historical Foreign Exchange (FX) rates at each funding date.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseCurrencyUnfundedAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Unfunded Amount' ;
    rdfs:comment 'Unfunded amount converted to the pension fund base reporting currency at current Foreign Exchange (FX) rate.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterestPercent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Percent' ;
    rdfs:comment 'Percentage of profits above the hurdle rate that the General Partner (GP) receives as performance-based compensation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Commitment Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the capital commitment is denominated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentDate rdf:type rdf:Property ;
    rdfs:label 'Commitment Date' ;
    rdfs:comment 'Date on which the capital commitment was formally made and documented, typically the Limited Partnership Agreement (LPA) signing date or Investment Committee (IC) approval date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commitmentNotes rdf:type rdf:Property ;
    rdfs:label 'Commitment Notes' ;
    rdfs:comment 'Free-text field for additional context, special terms, conditions, or Investment Committee (IC) stipulations related to the commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Commitment Period End Date' ;
    rdfs:comment 'Date after which no new capital calls can be issued, typically defined in the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commitmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Commitment Period Start Date' ;
    rdfs:comment 'Date from which capital calls can begin to be issued against this commitment.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commitmentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Commitment Reference Number' ;
    rdfs:comment 'External business identifier for the capital commitment, used in legal documents and Investment Committee (IC) materials.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentStatus rdf:type rdf:Property ;
    rdfs:label 'Commitment Status' ;
    rdfs:comment 'Current lifecycle state of the capital commitment from approval through funding completion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentType rdf:type rdf:Property ;
    rdfs:label 'Commitment Type' ;
    rdfs:comment 'Classification of the capital commitment by investment structure and timing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Amount' ;
    rdfs:comment 'Total capital amount committed to the portfolio or investment program, representing the maximum obligation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Name' ;
    rdfs:comment 'Legal name of the General Partner (GP), fund manager, or investment vehicle receiving the capital commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgClassification rdf:type rdf:Property ;
    rdfs:label 'Esg Classification' ;
    rdfs:comment 'Environmental, Social, and Governance (ESG) classification or rating of the investment program per Sustainable Finance Disclosure Regulation (SFDR) or internal ESG framework.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedFundTermYears rdf:type rdf:Property ;
    rdfs:label 'Expected Fund Term Years' ;
    rdfs:comment 'Expected total duration of the fund or investment program in years, including investment period and harvest period.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extensionOptionsYears rdf:type rdf:Property ;
    rdfs:label 'Extension Options Years' ;
    rdfs:comment 'Number of additional years the fund term can be extended beyond the base term, as permitted by the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundedAmount rdf:type rdf:Property ;
    rdfs:label 'Funded Amount' ;
    rdfs:comment 'Cumulative capital amount that has been called and funded to date through capital calls or drawdowns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalEntityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Identifier' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier (LEI) of the investment vehicle or counterparty receiving the commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Lpa Document Reference' ;
    rdfs:comment 'Document management system reference or identifier for the executed Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Lpa Execution Date' ;
    rdfs:comment 'Date on which the Limited Partnership Agreement (LPA) or equivalent legal commitment document was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managementFeePercent rdf:type rdf:Property ;
    rdfs:label 'Management Fee Percent' ;
    rdfs:comment 'Annual management fee percentage charged by the General Partner (GP) on committed or invested capital.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleInvestmentFlag rdf:type rdf:Property ;
    rdfs:label 'Responsible Investment Flag' ;
    rdfs:comment 'Indicates whether the commitment is designated as a responsible investment under Principles for Responsible Investment (PRI) framework.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:saaTargetAllocationPercent rdf:type rdf:Property ;
    rdfs:label 'Saa Target Allocation Percent' ;
    rdfs:comment 'Target allocation percentage for this commitment within the overall Strategic Asset Allocation (SAA) framework.' ;
    rdfs:domain ind:PortfolioCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Target Irr Percent' ;
    rdfs:comment 'Target net Internal Rate of Return (IRR) percentage for the investment program as stated in the Investment Memorandum (IM).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetMoic rdf:type rdf:Property ;
    rdfs:label 'Target Moic' ;
    rdfs:comment 'Target Multiple on Invested Capital (MOIC) for the investment program, representing expected total value divided by invested capital.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unfundedAmount rdf:type rdf:Property ;
    rdfs:label 'Unfunded Amount' ;
    rdfs:comment 'Remaining uncalled capital commitment available for future drawdowns, commonly referred to as dry powder in private markets.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioNavRecordId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav Record Id' ;
    rdfs:comment 'Unique identifier for the NAV record. Primary key for this entity.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationNavRecordId rdf:type rdf:Property ;
    rdfs:label 'Valuation Nav Record Id' ;
    rdfs:comment 'Foreign key linking to valuation.valuation_nav_record. Business justification: NAV reconciliation process requires linking portfolio NAV records to valuation-calculated NAVs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ValuationNavRecord .

ind:accruedExpenses rdf:type rdf:Property ;
    rdfs:label 'Accrued Expenses' ;
    rdfs:comment 'The total accrued expenses deducted in the NAV calculation, such as management fees and administrative costs.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accruedIncome rdf:type rdf:Property ;
    rdfs:label 'Accrued Income' ;
    rdfs:comment 'The total accrued income included in the NAV calculation, such as interest and dividends earned but not yet received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:administratorName rdf:type rdf:Property ;
    rdfs:label 'Administrator Name' ;
    rdfs:comment 'The name of the fund administrator responsible for calculating and reporting the NAV.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashAndEquivalents rdf:type rdf:Property ;
    rdfs:label 'Cash And Equivalents' ;
    rdfs:comment 'The total value of cash and cash equivalents held in the portfolio as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributions rdf:type rdf:Property ;
    rdfs:label 'Contributions' ;
    rdfs:comment 'The total contributions or capital inflows into the portfolio during the valuation period.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributions rdf:type rdf:Property ;
    rdfs:label 'Distributions' ;
    rdfs:comment 'The total distributions or capital outflows from the portfolio during the valuation period.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fiscalQuarter rdf:type rdf:Property ;
    rdfs:label 'Fiscal Quarter' ;
    rdfs:comment 'The fiscal quarter within the fiscal year to which this NAV record belongs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fiscalYear rdf:type rdf:Property ;
    rdfs:label 'Fiscal Year' ;
    rdfs:comment 'The fiscal year to which this NAV record belongs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxImpact rdf:type rdf:Property ;
    rdfs:label 'Fx Impact' ;
    rdfs:comment 'The impact of foreign exchange rate movements on the NAV during the valuation period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gavAmount rdf:type rdf:Property ;
    rdfs:label 'Gav Amount' ;
    rdfs:comment 'The total gross asset value before deducting liabilities, representing the sum of all portfolio holdings at market value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFeeAccrual rdf:type rdf:Property ;
    rdfs:label 'Management Fee Accrual' ;
    rdfs:comment 'The accrued management fees payable to external managers or internal management, deducted from NAV.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navAmount rdf:type rdf:Property ;
    rdfs:label 'Nav Amount' ;
    rdfs:comment 'The total net asset value of the portfolio as of the valuation date, representing total assets minus total liabilities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Nav Change Amount' ;
    rdfs:comment 'The absolute change in NAV from the prior valuation date to the current valuation date.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Nav Change Percentage' ;
    rdfs:comment 'The percentage change in NAV from the prior valuation date to the current valuation date.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navPerUnit rdf:type rdf:Property ;
    rdfs:label 'Nav Per Unit' ;
    rdfs:comment 'The NAV per unit or share, calculated as total NAV divided by total units outstanding.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navStatus rdf:type rdf:Property ;
    rdfs:label 'Nav Status' ;
    rdfs:comment 'The status of the NAV record indicating whether it is preliminary, final, restated, or adjusted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:payables rdf:type rdf:Property ;
    rdfs:label 'Payables' ;
    rdfs:comment 'The total value of payables, including pending settlements and other amounts owed by the portfolio.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceFeeAccrual rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Accrual' ;
    rdfs:comment 'The accrued performance fees or carried interest payable to external managers, deducted from NAV.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorNavAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Nav Amount' ;
    rdfs:comment 'The NAV amount from the previous valuation date, used for period-over-period comparison.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:receivables rdf:type rdf:Property ;
    rdfs:label 'Receivables' ;
    rdfs:comment 'The total value of receivables, including pending settlements and other amounts due to the portfolio.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalAssets rdf:type rdf:Property ;
    rdfs:label 'Total Assets' ;
    rdfs:comment 'The total market value of all assets held in the portfolio as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalLiabilities rdf:type rdf:Property ;
    rdfs:label 'Total Liabilities' ;
    rdfs:comment 'The total value of all liabilities and obligations of the portfolio as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unfundedCommitments rdf:type rdf:Property ;
    rdfs:label 'Unfunded Commitments' ;
    rdfs:comment 'The total value of unfunded capital commitments to private equity, infrastructure, and other illiquid investments.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitsOutstanding rdf:type rdf:Property ;
    rdfs:label 'Units Outstanding' ;
    rdfs:comment 'The total number of units or shares outstanding as of the valuation date.' ;
    rdfs:domain ind:PortfolioNavRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:variancePercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Percentage' ;
    rdfs:comment 'The variance expressed as a percentage of the total NAV.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioCashFlowId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Cash Flow Id' ;
    rdfs:comment 'Unique identifier for the cash flow record.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionId rdf:type rdf:Property ;
    rdfs:label 'Distribution Id' ;
    rdfs:comment 'Foreign key linking to privateequity.distribution. Business justification: PE distributions create portfolio cash inflows. Linking enables reconciliation between GP distribution notices and portfolio cash records - essential for cash management, NAV' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Distribution .

ind:investmentId rdf:type rdf:Property ;
    rdfs:label 'Investment Id' ;
    rdfs:comment 'Reference to the specific investment or position that generated or received this cash flow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:privateequityCapitalCallId rdf:type rdf:Property ;
    rdfs:label 'Privateequity Capital Call Id' ;
    rdfs:comment 'Foreign key linking to privateequity.privateequity_capital_call. Business justification: Capital calls create portfolio cash outflows. Linking enables reconciliation of GP call notices with portfolio cash movements - critical for liquidity forecasting' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PrivateequityCapitalCall .

ind:accountingPeriod rdf:type rdf:Property ;
    rdfs:label 'Accounting Period' ;
    rdfs:comment 'The accounting period in YYYY-MM format to which this cash flow is attributed for financial reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accrualDate rdf:type rdf:Property ;
    rdfs:label 'Accrual Date' ;
    rdfs:comment 'The date on which the cash flow was accrued for accounting purposes, distinct from settlement date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amount rdf:type rdf:Property ;
    rdfs:label 'Amount' ;
    rdfs:comment 'The monetary amount of the cash flow in the portfolio base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCenterCode rdf:type rdf:Property ;
    rdfs:label 'Cost Center Code' ;
    rdfs:comment 'The cost center or business unit code for internal allocation and management reporting of fees and expenses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioCashFlowDescription rdf:type rdf:Property ;
    rdfs:label 'Portfolio Cash Flow Description' ;
    rdfs:comment 'Detailed narrative description of the cash flow transaction including purpose and context.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowDirection rdf:type rdf:Property ;
    rdfs:label 'Flow Direction' ;
    rdfs:comment 'Indicates whether the cash flow is an inflow into the portfolio or an outflow from the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:flowType rdf:type rdf:Property ;
    rdfs:label 'Flow Type' ;
    rdfs:comment 'Classification of the cash flow transaction type indicating the nature of the inflow or outflow. [ENUM-REF-CANDIDATE: contribution|distribution|capital_call|dividend|coupon|fee|fx_settlement|rebalancing|redemption|other — 10 candidates stripped; promote' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isExternal rdf:type rdf:Property ;
    rdfs:label 'Is External' ;
    rdfs:comment 'Boolean flag indicating whether the cash flow is external to the portfolio or an internal reallocation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSignificant rdf:type rdf:Property ;
    rdfs:label 'Is Significant' ;
    rdfs:comment 'Boolean flag indicating whether the cash flow exceeds the significance threshold for performance calculation adjustments per GIPS standards.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originalAmount rdf:type rdf:Property ;
    rdfs:label 'Original Amount' ;
    rdfs:comment 'The cash flow amount in its original transaction currency before any foreign exchange conversion.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Original Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the original transaction amount before conversion.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioCashFlowStatus rdf:type rdf:Property ;
    rdfs:label 'Portfolio Cash Flow Status' ;
    rdfs:comment 'Current lifecycle status of the cash flow transaction indicating its processing state.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reclaimEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Reclaim Eligible Flag' ;
    rdfs:comment 'Boolean flag indicating whether the withholding tax on this cash flow is eligible for reclaim under applicable tax treaties.' ;
    rdfs:domain ind:PortfolioCashFlow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:significanceThresholdPercent rdf:type rdf:Property ;
    rdfs:label 'Significance Threshold Percent' ;
    rdfs:comment 'The percentage threshold used to determine if this cash flow is significant relative to portfolio NAV for performance calculation purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxTreatment rdf:type rdf:Property ;
    rdfs:label 'Tax Treatment' ;
    rdfs:comment 'Classification of the tax treatment applicable to this cash flow for tax reporting and compliance purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionDate rdf:type rdf:Property ;
    rdfs:label 'Transaction Date' ;
    rdfs:comment 'The date on which the cash flow transaction occurred or was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionReference rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference' ;
    rdfs:comment 'External reference number or identifier for the cash flow transaction from the source system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxRatePercent rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Rate Percent' ;
    rdfs:comment 'The withholding tax rate percentage applied to the cash flow transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandateHistoryId rdf:type rdf:Property ;
    rdfs:label 'Mandate History Id' ;
    rdfs:comment 'Unique identifier for each mandate history audit record tracking changes to portfolio mandate parameters over time.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mandateNewBenchmarkPortfolioBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Mandate New Benchmark Portfolio Benchmark Id' ;
    rdfs:comment 'Reference to the benchmark assignment that became effective with this change, supporting performance measurement and attribution reporting.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioBenchmark .

ind:mandatePortfolioBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Mandate Portfolio Benchmark Id' ;
    rdfs:comment 'Reference to the benchmark assignment that was in effect before this change, enabling audit trail of benchmark transitions for performance attribution analysis.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioBenchmark .

ind:supersededByHistoryMandateHistoryId rdf:type rdf:Property ;
    rdfs:label 'Superseded By History Mandate History Id' ;
    rdfs:comment 'Reference to the subsequent mandate history record that replaced this change, enabling navigation through the complete audit trail of mandate parameter evolution.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MandateHistory .

ind:changeEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Change Effective Date' ;
    rdfs:comment 'Date when the mandate parameter change became effective and binding for portfolio management and reporting purposes.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:changeImpactAssessment rdf:type rdf:Property ;
    rdfs:label 'Change Impact Assessment' ;
    rdfs:comment 'Analysis of the expected impact of this mandate change on portfolio construction, risk profile, performance attribution, and operational processes, supporting Investment Committee (IC) decision-making.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeNotes rdf:type rdf:Property ;
    rdfs:label 'Change Notes' ;
    rdfs:comment 'Additional commentary, context, and operational details regarding this mandate parameter change, capturing institutional knowledge and supporting future audit reviews.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeReason rdf:type rdf:Property ;
    rdfs:label 'Change Reason' ;
    rdfs:comment 'Business rationale and justification for the mandate parameter change, including strategic drivers, regulatory requirements, or Investment Committee (IC) directives.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeStatus rdf:type rdf:Property ;
    rdfs:label 'Change Status' ;
    rdfs:comment 'Current lifecycle status of the mandate change: proposed for review, approved by Investment Committee (IC), implemented in portfolio management systems, superseded by subsequent change, or cancelled before implementation.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeType rdf:type rdf:Property ;
    rdfs:label 'Change Type' ;
    rdfs:comment 'Classification of the mandate change event: Strategic Asset Allocation (SAA) target revision, benchmark assignment change, investment constraint amendment, currency hedging policy update, mandate scope expansion, or mandate scope restriction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newAssetClassScope rdf:type rdf:Property ;
    rdfs:label 'New Asset Class Scope' ;
    rdfs:comment 'Permitted asset classes and investment universe that became effective with this change, defining eligible public equities, private equity, real estate, infrastructure, natural resources, and credit investments.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newConstraintType rdf:type rdf:Property ;
    rdfs:label 'New Constraint Type' ;
    rdfs:comment 'Classification of the investment constraint that became effective with this change, such as concentration limit, sector exposure cap, credit quality floor, or liquidity requirement.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newConstraintValue rdf:type rdf:Property ;
    rdfs:label 'New Constraint Value' ;
    rdfs:comment 'Specific parameter value or threshold of the investment constraint that became effective with this change, stored as text to accommodate various constraint formats.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newCurrencyPolicy rdf:type rdf:Property ;
    rdfs:label 'New Currency Policy' ;
    rdfs:comment 'Foreign exchange (FX) hedging policy and currency exposure management approach that became effective with this change, including hedging ratios and permitted instruments.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newEsgFramework rdf:type rdf:Property ;
    rdfs:label 'New Esg Framework' ;
    rdfs:comment 'Environmental, Social, and Governance (ESG) integration framework and responsible investment approach that became effective with this change, including Principles for Responsible Investment (PRI) commitments and exclusion policies.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newRebalancingFrequency rdf:type rdf:Property ;
    rdfs:label 'New Rebalancing Frequency' ;
    rdfs:comment 'Portfolio rebalancing schedule and frequency that became effective with this change, defining how often Strategic Asset Allocation (SAA) targets are restored through trading activity.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newSaaTargetWeight rdf:type rdf:Property ;
    rdfs:label 'New Saa Target Weight' ;
    rdfs:comment 'Strategic Asset Allocation (SAA) target weight percentage that became effective with this change, expressed as decimal proportion for portfolio construction and rebalancing.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newToleranceBandLower rdf:type rdf:Property ;
    rdfs:label 'New Tolerance Band Lower' ;
    rdfs:comment 'Lower boundary of the Strategic Asset Allocation (SAA) tolerance band that became effective with this change, expressed as decimal proportion below target weight for rebalancing triggers.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:newToleranceBandUpper rdf:type rdf:Property ;
    rdfs:label 'New Tolerance Band Upper' ;
    rdfs:comment 'Upper boundary of the Strategic Asset Allocation (SAA) tolerance band that became effective with this change, expressed as decimal proportion above target weight for rebalancing triggers.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousAssetClassScope rdf:type rdf:Property ;
    rdfs:label 'Previous Asset Class Scope' ;
    rdfs:comment 'Permitted asset classes and investment universe that was in effect before this change, defining eligible public equities, private equity, real estate, infrastructure, natural resources, and credit investments.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousConstraintType rdf:type rdf:Property ;
    rdfs:label 'Previous Constraint Type' ;
    rdfs:comment 'Classification of the investment constraint that was in effect before this change, such as concentration limit, sector exposure cap, credit quality floor, or liquidity requirement.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousConstraintValue rdf:type rdf:Property ;
    rdfs:label 'Previous Constraint Value' ;
    rdfs:comment 'Specific parameter value or threshold of the investment constraint that was in effect before this change, stored as text to accommodate various constraint formats.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousCurrencyPolicy rdf:type rdf:Property ;
    rdfs:label 'Previous Currency Policy' ;
    rdfs:comment 'Foreign exchange (FX) hedging policy and currency exposure management approach that was in effect before this change, including hedging ratios and permitted instruments.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousEsgFramework rdf:type rdf:Property ;
    rdfs:label 'Previous Esg Framework' ;
    rdfs:comment 'Environmental, Social, and Governance (ESG) integration framework and responsible investment approach that was in effect before this change, including Principles for Responsible Investment (PRI) commitments and exclusion policies.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousRebalancingFrequency rdf:type rdf:Property ;
    rdfs:label 'Previous Rebalancing Frequency' ;
    rdfs:comment 'Portfolio rebalancing schedule and frequency that was in effect before this change, defining how often Strategic Asset Allocation (SAA) targets are restored through trading activity.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousSaaTargetWeight rdf:type rdf:Property ;
    rdfs:label 'Previous Saa Target Weight' ;
    rdfs:comment 'Strategic Asset Allocation (SAA) target weight percentage that was in effect before this change, expressed as decimal proportion for audit and rebalancing analysis.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousToleranceBandLower rdf:type rdf:Property ;
    rdfs:label 'Previous Tolerance Band Lower' ;
    rdfs:comment 'Lower boundary of the Strategic Asset Allocation (SAA) tolerance band that was in effect before this change, expressed as decimal proportion below target weight.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousToleranceBandUpper rdf:type rdf:Property ;
    rdfs:label 'Previous Tolerance Band Upper' ;
    rdfs:comment 'Upper boundary of the Strategic Asset Allocation (SAA) tolerance band that was in effect before this change, expressed as decimal proportion above target weight.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Trigger Flag' ;
    rdfs:comment 'Indicator whether this mandate change was triggered by regulatory requirements, such as the national pension regulator, directives, Sustainable Finance Disclosure Regulation (SFDR) compliance, or pension regulation updates.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stakeholderNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Notification Date' ;
    rdfs:comment 'Date when beneficiaries, external managers, custodians, and other stakeholders were formally notified of this mandate parameter change, supporting transparency and communication requirements.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supersededDate rdf:type rdf:Property ;
    rdfs:label 'Superseded Date' ;
    rdfs:comment 'Date when this mandate change was replaced or overridden by a subsequent mandate parameter revision, establishing temporal validity for historical analysis.' ;
    rdfs:domain ind:MandateHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditMandateId rdf:type rdf:Property ;
    rdfs:label 'Credit Mandate Id' ;
    rdfs:comment 'Foreign key linking to credit.credit_mandate. Business justification: Credit sleeves within multi-asset portfolios require dedicated credit mandates specifying duration limits, credit quality minimums, and sector constraints.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditMandate .

ind:peFundId rdf:type rdf:Property ;
    rdfs:label 'Pe Fund Id' ;
    rdfs:comment 'Foreign key linking to privateequity.fund. Business justification: Portfolio sleeves allocate to specific PE funds for sub-portfolio construction. Investment teams track PE fund exposure within sleeves for rebalancing decisions and asset allocation' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:actualAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Allocation Amount' ;
    rdfs:comment 'Current actual allocation amount in base currency for this sleeve.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualAllocationWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Actual Allocation Weight Percent' ;
    rdfs:comment 'Current actual allocation weight as a percentage of the parent portfolio.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sleeveCode rdf:type rdf:Property ;
    rdfs:label 'Sleeve Code' ;
    rdfs:comment 'Externally-known unique business code for the sleeve, used for reporting and operational reference.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sleeveDescription rdf:type rdf:Property ;
    rdfs:label 'Sleeve Description' ;
    rdfs:comment 'Detailed textual description of the sleeves purpose, strategy, and investment objectives.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sleeveName rdf:type rdf:Property ;
    rdfs:label 'Sleeve Name' ;
    rdfs:comment 'Human-readable name of the sleeve, describing its purpose or strategy.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sleeveStatus rdf:type rdf:Property ;
    rdfs:label 'Sleeve Status' ;
    rdfs:comment 'Current lifecycle status of the sleeve.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sleeveType rdf:type rdf:Property ;
    rdfs:label 'Sleeve Type' ;
    rdfs:comment 'Classification of the sleeve by its organizational purpose: asset class sleeve, strategy sleeve, manager sleeve, geographic sleeve, sector sleeve, or thematic sleeve.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyName rdf:type rdf:Property ;
    rdfs:label 'Strategy Name' ;
    rdfs:comment 'Name of the investment strategy employed within this sleeve (e.g., value, growth, core-plus, opportunistic).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taaAdjustmentWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Taa Adjustment Weight Percent' ;
    rdfs:comment 'Tactical Asset Allocation (TAA) adjustment applied to the Strategic Asset Allocation (SAA) target weight, expressed as percentage points.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetAllocationAmount rdf:type rdf:Property ;
    rdfs:label 'Target Allocation Amount' ;
    rdfs:comment 'Target allocation amount in base currency for this sleeve as per Strategic Asset Allocation (SAA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetAllocationWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Target Allocation Weight Percent' ;
    rdfs:comment 'Target allocation weight as a percentage of the parent portfolio, per Strategic Asset Allocation (SAA).' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceBandLowerPercent rdf:type rdf:Property ;
    rdfs:label 'Tolerance Band Lower Percent' ;
    rdfs:comment 'Lower bound of the tolerance band for allocation weight, expressed as percentage points below target.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:toleranceBandUpperPercent rdf:type rdf:Property ;
    rdfs:label 'Tolerance Band Upper Percent' ;
    rdfs:comment 'Upper bound of the tolerance band for allocation weight, expressed as percentage points above target.' ;
    rdfs:domain ind:Sleeve ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currencyExposureId rdf:type rdf:Property ;
    rdfs:label 'Currency Exposure Id' ;
    rdfs:comment 'Unique identifier for the currency exposure record.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hedgeCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Hedge Counterparty Id' ;
    rdfs:comment 'Reference to the counterparty providing the hedging instruments for this currency exposure.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:dataSourceRecordReference rdf:type rdf:Property ;
    rdfs:label 'Data Source Record Reference' ;
    rdfs:comment 'The unique identifier of this currency exposure record in the source system.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Data Source System' ;
    rdfs:comment 'The operational system from which the currency exposure data was sourced, such as SimCorp Dimension, Aladdin, or State Street.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dv01Amount rdf:type rdf:Property ;
    rdfs:label 'Dv01 Amount' ;
    rdfs:comment 'The sensitivity of the currency exposure to a one basis point change in foreign exchange rates, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureStatus rdf:type rdf:Property ;
    rdfs:label 'Exposure Status' ;
    rdfs:comment 'Current status of the currency exposure record in the portfolio monitoring lifecycle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureType rdf:type rdf:Property ;
    rdfs:label 'Exposure Type' ;
    rdfs:comment 'Classification of the currency exposure: transaction exposure from cash flows, translation exposure from asset valuation, or economic exposure from market conditions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:foreignCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Foreign Currency Code' ;
    rdfs:comment 'The foreign currency to which the portfolio has exposure, expressed as ISO 4217 three-letter code.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxForwardRate rdf:type rdf:Property ;
    rdfs:label 'Fx Forward Rate' ;
    rdfs:comment 'The forward exchange rate used for hedging contracts, if applicable.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxSpotRate rdf:type rdf:Property ;
    rdfs:label 'Fx Spot Rate' ;
    rdfs:comment 'The spot exchange rate between the foreign currency and base currency as of the valuation date.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicRegion rdf:type rdf:Property ;
    rdfs:label 'Geographic Region' ;
    rdfs:comment 'The geographic region or market where the foreign currency exposure originates.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Exposure Amount' ;
    rdfs:comment 'Total unhedged exposure to the foreign currency before any hedging instruments are applied, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeCostBps rdf:type rdf:Property ;
    rdfs:label 'Hedge Cost Bps' ;
    rdfs:comment 'The annualized cost of hedging the foreign currency exposure, expressed in basis points.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeEffectivenessPercent rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Percent' ;
    rdfs:comment 'The effectiveness of the hedging strategy in offsetting foreign currency risk, measured as a percentage.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Hedge Instrument Type' ;
    rdfs:comment 'The type of derivative or hedging instrument used to manage the foreign currency exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeMaturityDate rdf:type rdf:Property ;
    rdfs:label 'Hedge Maturity Date' ;
    rdfs:comment 'The maturity or expiration date of the hedging instruments covering this currency exposure.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hedgeRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Percent' ;
    rdfs:comment 'The percentage of gross foreign currency exposure that is hedged through FX derivatives or other hedging instruments.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgedNotionalAmount rdf:type rdf:Property ;
    rdfs:label 'Hedged Notional Amount' ;
    rdfs:comment 'The notional amount of foreign currency exposure covered by hedging instruments, expressed in base currency.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mtmGainLossAmount rdf:type rdf:Property ;
    rdfs:label 'Mtm Gain Loss Amount' ;
    rdfs:comment 'The unrealized gain or loss on the currency exposure due to foreign exchange rate movements since the prior valuation date, expressed in base currency.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netExposureAmount rdf:type rdf:Property ;
    rdfs:label 'Net Exposure Amount' ;
    rdfs:comment 'The residual unhedged foreign currency exposure after hedging instruments are applied, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Breach Flag' ;
    rdfs:comment 'Indicates whether the current currency exposure exceeds the policy limit.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Policy Limit Amount' ;
    rdfs:comment 'The maximum allowable foreign currency exposure for this currency as defined by the investment policy, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizedGainLossAmount rdf:type rdf:Property ;
    rdfs:label 'Realized Gain Loss Amount' ;
    rdfs:comment 'The realized gain or loss from settled foreign currency transactions during the reporting period, expressed in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressTestImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Stress Test Impact Amount' ;
    rdfs:comment 'The estimated impact on portfolio value under the stress test scenario, expressed in base currency.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stressTestScenario rdf:type rdf:Property ;
    rdfs:label 'Stress Test Scenario' ;
    rdfs:comment 'The stress test scenario applied to assess the impact of extreme foreign exchange rate movements on this exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Var Contribution Amount' ;
    rdfs:comment 'The contribution of this currency exposure to the overall portfolio Value at Risk, expressed in base currency.' ;
    rdfs:domain ind:CurrencyExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityBucketId rdf:type rdf:Property ;
    rdfs:label 'Liquidity Bucket Id' ;
    rdfs:comment 'Unique identifier for the liquidity bucket classification record.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averageDailyVolume rdf:type rdf:Property ;
    rdfs:label 'Average Daily Volume' ;
    rdfs:comment 'Average daily trading volume for the security over the measurement period, used to assess liquidity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bidAskSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Bid Ask Spread Bps' ;
    rdfs:comment 'The bid-ask spread expressed in basis points, indicating transaction cost and liquidity tightness.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bucketWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Bucket Weight Percent' ;
    rdfs:comment 'The cumulative weight of all holdings in this liquidity tier as a percentage of total portfolio value.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classificationDate rdf:type rdf:Property ;
    rdfs:label 'Classification Date' ;
    rdfs:comment 'The date on which this liquidity classification was determined.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:classificationMethodology rdf:type rdf:Property ;
    rdfs:label 'Classification Methodology' ;
    rdfs:comment 'The methodology or framework used to determine the liquidity classification (internal model, vendor model, regulatory framework).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationSource rdf:type rdf:Property ;
    rdfs:label 'Classification Source' ;
    rdfs:comment 'The source of the liquidity classification determination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationStatus rdf:type rdf:Property ;
    rdfs:label 'Classification Status' ;
    rdfs:comment 'Current status of the liquidity classification record in its lifecycle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedLiquidationDays rdf:type rdf:Property ;
    rdfs:label 'Estimated Liquidation Days' ;
    rdfs:comment 'Estimated number of days required to fully liquidate the position without significant market impact.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gateProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Gate Provision Flag' ;
    rdfs:comment 'Indicates whether the investment is subject to gate provisions that can restrict redemptions during stressed market conditions.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:haircutPercent rdf:type rdf:Property ;
    rdfs:label 'Haircut Percent' ;
    rdfs:comment 'The haircut percentage applied to the market value for liquidity calculations, reflecting potential value loss in rapid liquidation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hqlaCategory rdf:type rdf:Property ;
    rdfs:label 'Hqla Category' ;
    rdfs:comment 'The HQLA category classification (Level 1, Level 2A, Level 2B, or Non-HQLA) under Basel III.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hqlaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Hqla Eligible Flag' ;
    rdfs:comment 'Indicates whether the holding qualifies as a High-Quality Liquid Asset under Basel III Liquidity Coverage Ratio (LCR) requirements.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:instrumentType rdf:type rdf:Property ;
    rdfs:label 'Instrument Type' ;
    rdfs:comment 'The specific instrument type of the security (equity, bond, derivative, fund unit, real asset).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidationCostPercent rdf:type rdf:Property ;
    rdfs:label 'Liquidation Cost Percent' ;
    rdfs:comment 'Estimated cost of liquidation expressed as a percentage of market value, including transaction costs and market impact.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityTier rdf:type rdf:Property ;
    rdfs:label 'Liquidity Tier' ;
    rdfs:comment 'The liquidity tier classification indicating the time horizon for converting the holding to cash without significant price impact. [ENUM-REF-CANDIDATE: T+0|T+1|T+2|T+5|T+30|T+90|T+180|illiquid|locked — promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityTierCode rdf:type rdf:Property ;
    rdfs:label 'Liquidity Tier Code' ;
    rdfs:comment 'Internal code representing the liquidity tier for system processing and reporting.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityTierDescription rdf:type rdf:Property ;
    rdfs:label 'Liquidity Tier Description' ;
    rdfs:comment 'Detailed description of the liquidity tier classification and its business meaning.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockUpPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Lock Up Period End Date' ;
    rdfs:comment 'The date on which any lock-up or restriction on redemption expires, after which the holding becomes more liquid.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketDepthIndicator rdf:type rdf:Property ;
    rdfs:label 'Market Depth Indicator' ;
    rdfs:comment 'Qualitative assessment of the market depth and trading volume available for this holding.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Override Approval Date' ;
    rdfs:comment 'Date on which the liquidity classification override was approved.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overrideApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Override Approved By' ;
    rdfs:comment 'Name or identifier of the individual who approved the liquidity classification override.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideFlag rdf:type rdf:Property ;
    rdfs:label 'Override Flag' ;
    rdfs:comment 'Indicates whether the liquidity classification was manually overridden from the system-generated classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideReason rdf:type rdf:Property ;
    rdfs:label 'Override Reason' ;
    rdfs:comment 'Business justification for any manual override of the liquidity classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redemptionNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Redemption Notice Days' ;
    rdfs:comment 'Number of days advance notice required to redeem or liquidate the holding, applicable to private markets and fund investments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reviewFrequencyDays rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Days' ;
    rdfs:comment 'The frequency in days at which this liquidity classification should be reviewed and updated.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sidePocketFlag rdf:type rdf:Property ;
    rdfs:label 'Side Pocket Flag' ;
    rdfs:comment 'Indicates whether the holding is held in a side pocket, making it illiquid until realization.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stressScenarioTier rdf:type rdf:Property ;
    rdfs:label 'Stress Scenario Tier' ;
    rdfs:comment 'The liquidity tier classification under stressed market conditions, used for stress testing and scenario analysis.' ;
    rdfs:domain ind:LiquidityBucket ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioIcApprovalId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Ic Approval Id' ;
    rdfs:comment 'Unique identifier for the Investment Committee approval record for portfolio-level decisions.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coinvestmentId rdf:type rdf:Property ;
    rdfs:label 'Coinvestment Id' ;
    rdfs:comment 'Foreign key linking to privateequity.coinvestment. Business justification: Co-investments require separate IC approval with distinct terms. Linking approval to coinvestment record enables governance tracking, fee analysis, and performance attribution for' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Coinvestment .

ind:diligenceIcSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Diligence Ic Submission Id' ;
    rdfs:comment 'Foreign key linking to diligence.diligence_ic_submission. Business justification: Portfolio IC approvals for new investments reference the diligence IC submission that cleared the investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiligenceIcSubmission .

ind:icMeetingId rdf:type rdf:Property ;
    rdfs:label 'Ic Meeting Id' ;
    rdfs:comment 'Reference to the specific Investment Committee meeting where this approval was granted or denied.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Meeting .

ind:peInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Pe Investment Id' ;
    rdfs:comment 'Foreign key linking to privateequity.investment. Business justification: IC approvals for direct PE investments require linking to the specific investment record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:approvalReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Approval Reference Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this Investment Committee approval for tracking and audit purposes.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalType rdf:type rdf:Property ;
    rdfs:label 'Approval Type' ;
    rdfs:comment 'Category of portfolio-level decision requiring Investment Committee approval. [ENUM-REF-CANDIDATE: saa_change|taa_adjustment|mandate_approval|benchmark_change|rebalancing_authorization|capital_commitment|policy_exception — 7 candidates stripped; promote' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Commitment Amount' ;
    rdfs:comment 'Total capital commitment amount requiring Investment Committee approval, if applicable to this decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalCommitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Capital Commitment Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the capital commitment amount.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:chairApprovalFlag rdf:type rdf:Property ;
    rdfs:label 'Chair Approval Flag' ;
    rdfs:comment 'Indicates whether the Investment Committee Chair formally approved the decision.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Status' ;
    rdfs:comment 'Status of compliance department review of the proposal prior to Investment Committee consideration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsOfApproval rdf:type rdf:Property ;
    rdfs:label 'Conditions Of Approval' ;
    rdfs:comment 'Specific conditions, restrictions, or requirements attached to the Investment Committee approval, if any.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionDate rdf:type rdf:Property ;
    rdfs:label 'Decision Date' ;
    rdfs:comment 'Date when the Investment Committee formally rendered its decision on this portfolio matter.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:decisionStatus rdf:type rdf:Property ;
    rdfs:label 'Decision Status' ;
    rdfs:comment 'Current status of the Investment Committee decision on this portfolio matter.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deferralReason rdf:type rdf:Property ;
    rdfs:label 'Deferral Reason' ;
    rdfs:comment 'Explanation for why the Investment Committee deferred the decision to a future meeting, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedReturnImpactPercent rdf:type rdf:Property ;
    rdfs:label 'Expected Return Impact Percent' ;
    rdfs:comment 'Projected impact on portfolio expected return resulting from the proposed change, expressed as a percentage.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedRiskImpactPercent rdf:type rdf:Property ;
    rdfs:label 'Expected Risk Impact Percent' ;
    rdfs:comment 'Projected impact on portfolio risk level resulting from the proposed change, expressed as a percentage.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Im Document Reference' ;
    rdfs:comment 'Reference identifier for the Investment Memorandum document supporting this Investment Committee submission.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Legal Review Status' ;
    rdfs:comment 'Status of legal department review of the proposal prior to Investment Committee consideration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingDate rdf:type rdf:Property ;
    rdfs:label 'Meeting Date' ;
    rdfs:comment 'Date of the Investment Committee meeting where this portfolio decision was reviewed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:policyExceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Flag' ;
    rdfs:comment 'Indicates whether this approval involves an exception to established investment policy guidelines.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:policyExceptionRationale rdf:type rdf:Property ;
    rdfs:label 'Policy Exception Rationale' ;
    rdfs:comment 'Detailed justification for requesting an exception to investment policy, if applicable.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalSummary rdf:type rdf:Property ;
    rdfs:label 'Proposal Summary' ;
    rdfs:comment 'Executive summary of the portfolio proposal outlining key objectives, rationale, and expected outcomes.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposalTitle rdf:type rdf:Property ;
    rdfs:label 'Proposal Title' ;
    rdfs:comment 'Concise title or name of the portfolio proposal submitted for Investment Committee approval.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedBenchmarkCode rdf:type rdf:Property ;
    rdfs:label 'Proposed Benchmark Code' ;
    rdfs:comment 'Code or identifier of the proposed new benchmark for the portfolio, if this approval involves a benchmark change.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedMandateType rdf:type rdf:Property ;
    rdfs:label 'Proposed Mandate Type' ;
    rdfs:comment 'Type of investment mandate being proposed for approval, if this approval involves a new or modified mandate.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedSaaChangeDescription rdf:type rdf:Property ;
    rdfs:label 'Proposed Saa Change Description' ;
    rdfs:comment 'Detailed description of proposed changes to Strategic Asset Allocation targets, if applicable to this approval.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedTaaChangeDescription rdf:type rdf:Property ;
    rdfs:label 'Proposed Taa Change Description' ;
    rdfs:comment 'Detailed description of proposed Tactical Asset Allocation adjustments, if applicable to this approval.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:quorumMetFlag rdf:type rdf:Property ;
    rdfs:label 'Quorum Met Flag' ;
    rdfs:comment 'Indicates whether the required quorum of Investment Committee members was present for the decision to be valid.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskAssessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Summary' ;
    rdfs:comment 'Summary of risk analysis conducted on the proposed portfolio change, including impact on portfolio risk metrics and stress test results.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategicRationale rdf:type rdf:Property ;
    rdfs:label 'Strategic Rationale' ;
    rdfs:comment 'Strategic justification for the proposed portfolio change, including alignment with long-term investment objectives and liability-driven investment strategy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingAnalysisReference rdf:type rdf:Property ;
    rdfs:label 'Supporting Analysis Reference' ;
    rdfs:comment 'Reference to supporting analytical materials, models, or research reports submitted with the proposal.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trackingErrorImpactBps rdf:type rdf:Property ;
    rdfs:label 'Tracking Error Impact Bps' ;
    rdfs:comment 'Projected change in tracking error relative to benchmark resulting from the proposed portfolio change, measured in basis points.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varImpactPercent rdf:type rdf:Property ;
    rdfs:label 'Var Impact Percent' ;
    rdfs:comment 'Projected change in portfolio Value at Risk resulting from the proposed change, expressed as a percentage.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:votesAbstained rdf:type rdf:Property ;
    rdfs:label 'Votes Abstained' ;
    rdfs:comment 'Number of Investment Committee members who abstained from voting on the proposal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesAgainst rdf:type rdf:Property ;
    rdfs:label 'Votes Against' ;
    rdfs:comment 'Number of Investment Committee members who voted against the proposal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votesInFavor rdf:type rdf:Property ;
    rdfs:label 'Votes In Favor' ;
    rdfs:comment 'Number of Investment Committee members who voted in favor of the proposal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:votingOutcomeSummary rdf:type rdf:Property ;
    rdfs:label 'Voting Outcome Summary' ;
    rdfs:comment 'Summary of Investment Committee voting results including votes in favor, against, and abstentions.' ;
    rdfs:domain ind:PortfolioIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portfolioAllocationId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Allocation Id' ;
    rdfs:comment 'Primary key for the allocation association' ;
    rdfs:domain ind:PortfolioAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:percentage rdf:type rdf:Property ;
    rdfs:label 'Percentage' ;
    rdfs:comment 'Percentage of the total opportunity investment amount allocated to this portfolio. Sum of percentages across all portfolios for one opportunity should equal 100%.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioAllocationDate rdf:type rdf:Property ;
    rdfs:label 'Portfolio Allocation Date' ;
    rdfs:comment 'Date when the allocation was formally approved and recorded. Used for tracking allocation timing relative to deal close.' ;
    rdfs:domain ind:PortfolioAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:portfolioAllocationStatus rdf:type rdf:Property ;
    rdfs:label 'Portfolio Allocation Status' ;
    rdfs:comment 'Current lifecycle status of the allocation in the approval workflow. Tracks progression from proposal through IC approval to funding.' ;
    rdfs:domain ind:PortfolioAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rationale rdf:type rdf:Property ;
    rdfs:label 'Rationale' ;
    rdfs:comment 'Business justification for why this portfolio was selected to participate in this opportunity. Documents strategic fit, mandate alignment, and capacity considerations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetId rdf:type rdf:Property ;
    rdfs:label 'Asset Id' ;
    rdfs:comment 'Primary key for asset' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Asset .

ind:equityIssuerId rdf:type rdf:Property ;
    rdfs:label 'Equity Issuer Id' ;
    rdfs:comment 'Reference to the entity that issued or originated the asset for counterparty risk management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquityIssuer .

ind:acquisitionDate rdf:type rdf:Property ;
    rdfs:label 'Acquisition Date' ;
    rdfs:comment 'Date when the pension fund first acquired or invested in this asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetSubType rdf:type rdf:Property ;
    rdfs:label 'Asset Sub Type' ;
    rdfs:comment 'Granular classification providing detailed categorization within the asset type for specialized analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetType rdf:type rdf:Property ;
    rdfs:label 'Asset Type' ;
    rdfs:comment 'Secondary classification within the asset class defining the specific instrument or investment structure type.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bloombergTicker rdf:type rdf:Property ;
    rdfs:label 'Bloomberg Ticker' ;
    rdfs:comment 'Bloomberg terminal ticker symbol used for market data retrieval and trading operations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookValue rdf:type rdf:Property ;
    rdfs:label 'Book Value' ;
    rdfs:comment 'Historical cost basis or amortized cost of the asset for accounting and performance measurement purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countryOfDomicile rdf:type rdf:Property ;
    rdfs:label 'Country Of Domicile' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the asset issuer or entity is legally domiciled.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetDescription rdf:type rdf:Property ;
    rdfs:label 'Asset Description' ;
    rdfs:comment 'Detailed narrative description of the asset including key terms and investment characteristics.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgScore rdf:type rdf:Property ;
    rdfs:label 'Esg Score' ;
    rdfs:comment 'Composite ESG rating score reflecting environmental, social, and governance risk factors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exchangeCode rdf:type rdf:Property ;
    rdfs:label 'Exchange Code' ;
    rdfs:comment 'Market Identifier Code (MIC) of the primary exchange where the asset is traded per ISO 10383.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fairValueHierarchy rdf:type rdf:Property ;
    rdfs:label 'Fair Value Hierarchy' ;
    rdfs:comment 'IFRS 13 fair value hierarchy classification based on observability of valuation inputs.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryGroup rdf:type rdf:Property ;
    rdfs:label 'Industry Group' ;
    rdfs:comment 'GICS industry group classification providing more granular sector categorization for analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isHedged rdf:type rdf:Property ;
    rdfs:label 'Is Hedged' ;
    rdfs:comment 'Indicates whether the asset position has associated currency or interest rate hedging in place.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isListed rdf:type rdf:Property ;
    rdfs:label 'Is Listed' ;
    rdfs:comment 'Indicates whether the asset is publicly listed and traded on a recognized exchange.' ;
    rdfs:domain ind:Asset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetName rdf:type rdf:Property ;
    rdfs:label 'Asset Name' ;
    rdfs:comment 'Human-readable name or title of the asset as recognized in investment operations and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notionalValue rdf:type rdf:Property ;
    rdfs:label 'Notional Value' ;
    rdfs:comment 'Face value or notional principal amount for derivatives and fixed income instruments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage' ;
    rdfs:comment 'Percentage of total ownership or equity stake held in the asset, relevant for private investments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetStatus rdf:type rdf:Property ;
    rdfs:label 'Asset Status' ;
    rdfs:comment 'Current lifecycle state of the asset indicating its operational status within the portfolio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitPrice rdf:type rdf:Property ;
    rdfs:label 'Unit Price' ;
    rdfs:comment 'Current price per unit or share of the asset used for valuation calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitsHeld rdf:type rdf:Property ;
    rdfs:label 'Units Held' ;
    rdfs:comment 'Quantity of units, shares, or contracts held for the asset position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldToMaturity rdf:type rdf:Property ;
    rdfs:label 'Yield To Maturity' ;
    rdfs:comment 'Total return anticipated on a bond if held until maturity, expressed as an annual percentage rate.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxLotId rdf:type rdf:Property ;
    rdfs:label 'Tax Lot Id' ;
    rdfs:comment 'Primary key for tax_lot' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TaxLot .

ind:executionId rdf:type rdf:Property ;
    rdfs:label 'Execution Id' ;
    rdfs:comment 'Reference to the original trade transaction that created this tax lot.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Execution .

ind:acquisitionPrice rdf:type rdf:Property ;
    rdfs:label 'Acquisition Price' ;
    rdfs:comment 'Price per unit at which the position was originally acquired.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustedCostBasis rdf:type rdf:Property ;
    rdfs:label 'Adjusted Cost Basis' ;
    rdfs:comment 'Cost basis adjusted for corporate actions, return of capital, wash sales, and other tax adjustments.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationMethod rdf:type rdf:Property ;
    rdfs:label 'Amortization Method' ;
    rdfs:comment 'Method used for amortizing bond premium or accreting discount for tax purposes.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:closeDate rdf:type rdf:Property ;
    rdfs:label 'Close Date' ;
    rdfs:comment 'Date when the tax lot was fully closed through sale or other disposition.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closePrice rdf:type rdf:Property ;
    rdfs:label 'Close Price' ;
    rdfs:comment 'Price per unit at which the tax lot was closed or disposed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corporateActionAdjusted rdf:type rdf:Property ;
    rdfs:label 'Corporate Action Adjusted' ;
    rdfs:comment 'Flag indicating whether this tax lot has been adjusted for corporate actions such as splits or mergers.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costBasis rdf:type rdf:Property ;
    rdfs:label 'Cost Basis' ;
