ind:meetingType rdf:type rdf:Property ;
    rdfs:label 'Meeting Type' ;
    rdfs:comment 'Type of shareholder meeting: Annual General Meeting (AGM), Extraordinary General Meeting (EGM), Special, Class, Adjourned, or Written Consent.' ;
