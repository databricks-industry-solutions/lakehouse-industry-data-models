    rdfs:range xsd:integer .

ind:icEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Ic Employee Id' ;
    rdfs:comment 'Reference to the primary investment analyst or research professional responsible for preparing this research pack.' ;
    rdfs:domain ind:IcResearchPack ;
