Project {
  database_type: 'Databricks Unity Catalog'
  Note: 'Lakehouse data model for Asset Management - Version 9'
}

Table beneficiary.member {
  member_id varchar [pk, note: 'Globally unique identifier for the member record.']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Members are pension beneficiaries (plan members and participating employers) who are actors in the system.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Member has denormalized contributor_pool STRING field. Adding FK to contributor_pool table normalizes this relationship.']
  employee_id varchar [note: 'Identifier of the user who created the record.']
  membership_status_updated_by_user_employee_id varchar [note: 'Identifier of the user who updated the membership status.']
  pension_plan_id varchar [note: 'Identifier of the investment plan the member is enrolled in.']
  updated_by_user_employee_id varchar [note: 'Identifier of the user who last updated the record.']
  address_line_1 varchar [note: 'Primary address line.']
  address_line_2 varchar [note: 'Secondary address line.']
  city varchar [note: 'City of residence.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code.']
  created_by_user_department varchar [note: 'Department of the user who created the record.']
  created_by_user_email varchar [note: 'Email of the user who created the record.']
  created_by_user_location varchar [note: 'Physical location of the user who created the record.']
  created_by_user_name varchar [note: 'Name of the user who created the record.']
  created_by_user_role varchar [note: 'Role of the user who created the record.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  date_of_birth date [note: 'Member\'s date of birth.']
  email varchar [note: 'Primary email address for communication.']
  full_name varchar [note: 'Full legal name of the member.']
  gender varchar [note: 'Member\'s gender.']
  membership_end_date date [note: 'Date the membership ended or is scheduled to end.']
  membership_start_date date [note: 'Date the member joined the plan.']
  membership_status varchar [note: 'Current lifecycle status of the member.']
  membership_status_effective_date date [note: 'Date the current status became effective.']
  membership_status_expiry_date date [note: 'Date the current status will expire.']
  membership_status_reason varchar [note: 'Reason for the current membership status.']
  membership_status_updated_by_user_department varchar [note: 'Department of the user who updated the membership status.']
  membership_status_updated_by_user_email varchar [note: 'Email of the user who updated the membership status.']
  membership_status_updated_by_user_location varchar [note: 'Physical location of the user who updated the membership status.']
  membership_status_updated_by_user_name varchar [note: 'Name of the user who updated the membership status.']
  membership_status_updated_by_user_role varchar [note: 'Role of the user who updated the membership status.']
  membership_status_updated_timestamp timestamp [note: 'Timestamp when the membership status was last updated.']
  national_identifier varchar [note: 'Government issued national ID number.']
  number varchar [note: 'Unique member number assigned by the pension fund.']
  phone_number varchar [note: 'Primary contact phone number.']
  plan_status varchar [note: 'Current status of the investment plan.']
  plan_type varchar [note: 'Type of investment plan.']
  postal_code varchar [note: 'Postal or ZIP code.']
  province_state varchar [note: 'Province or state of residence.']
  updated_by_user_department varchar [note: 'Department of the user who last updated the record.']
  updated_by_user_email varchar [note: 'Email of the user who last updated the record.']
  updated_by_user_location varchar [note: 'Physical location of the user who last updated the record.']
  updated_by_user_name varchar [note: 'Name of the user who last updated the record.']
  updated_by_user_role varchar [note: 'Role of the user who last updated the record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent record update.']

  Note: 'Core master record and single source of truth for every pension plan member across all four contributor pools (one per participating plan).'
}

Table beneficiary.contributor_pool {
  contributor_pool_id varchar [pk, note: 'Unique identifier for the contributor pool.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Contributor pools represent plan-level contribution structures; linking to portfolio associates the pool with its investment portfolio.']
  actuarial_assumptions varchar [note: 'Actuarial assumptions used for the contributor pool.']
  approval_date date [note: 'Date when the contributor pool was approved.']
  approved_by varchar [note: 'Identifier of the approver for the pool.']
  benefit_formula varchar [note: 'Benefit calculation formula for the pool.']
  contribution_frequency varchar [note: 'Frequency of contributions for the pool.']
  contribution_rate decimal(10,4) [note: 'Standard contribution rate applied to the pool.']
  contribution_rate_structure varchar [note: 'Structure of contribution rates applied to the pool.']
  contributor_pool_code varchar [note: 'Alphanumeric code that uniquely identifies the contributor pool.']
  contributor_pool_description varchar [note: 'Narrative description of the contributor pool.']
  contributor_pool_name varchar [note: 'Human-readable name of the contributor pool.']
  contributor_pool_status varchar [note: 'Current lifecycle status of the contributor pool.']
  contributor_pool_type varchar [note: 'Classification of the contributor pool (e.g., one of the participating plans).']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  currency_code varchar [note: 'ISO 4217 currency code for the pool.']
  effective_from date [note: 'Date when the contributor pool becomes effective.']
  effective_until date [note: 'Date when the contributor pool ceases to be effective.']
  employment_category varchar [note: 'Employment category of contributors in the pool.']
  gazette_reference varchar [note: 'Gazette reference for the contributor pool.']
  indexation_basis varchar [note: 'Basis for indexation adjustments.']
  indexation_rate decimal(10,4) [note: 'Rate applied for indexation adjustments.']
  is_mandatory boolean [note: 'Indicates if contributions are mandatory.']
  is_tax_deductible boolean [note: 'Indicates if contributions are tax deductible.']
  jurisdiction_code varchar [note: 'ISO 3166-1 alpha-3 code of the jurisdiction.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  legislative_authority varchar [note: 'Authority responsible for the legislative framework.']
  legislative_framework varchar [note: 'Legislative framework governing the contributor pool.']
  max_pensionable_earnings decimal(15,2) [note: 'Maximum earnings subject to pension contributions.']
  min_pensionable_earnings decimal(15,2) [note: 'Minimum earnings subject to pension contributions.']
  notes varchar [note: 'Additional notes or remarks about the pool.']
  plan_type varchar [note: 'Type of plan associated with the pool.']
  rate_description varchar [note: 'Description of the contribution rate applied.']
  regulatory_basis varchar [note: 'Regulatory basis for the contributor pool.']
  service_category varchar [note: 'Service category of contributors in the pool.']
  version_number varchar [note: 'Version number for the contributor pool record.']

  Note: 'Reference entity defining the four distinct contributor pools managed by the fund: the participating plans. Each pool has its own legislative framework, benefit formula, contribution rate structure, actuarial assumptions'
}

Table beneficiary.member_enrollment {
  member_enrollment_id varchar [pk, note: 'Unique identifier for the member enrollment transaction.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Member enrollment has contributor_pool_code STRING but no FK. Enrollment is into a specific contributor pool. Adding FK normalizes this.']
  member_id varchar [note: 'Identifier of the member being enrolled.']
  pension_plan_id varchar [note: 'Identifier of the contributor pool or plan associated with the enrollment.']
  created_timestamp timestamp [note: 'Timestamp when the enrollment record was first created.']
  eligibility_verification_outcome varchar [note: 'Result of the eligibility verification process for the enrollment.']
  enrollment_date date [note: 'Date when the member enrollment was initiated.']
  enrollment_fee_amount decimal(18,2) [note: 'Monetary amount charged for the enrollment process.']
  enrollment_reference_number varchar [note: 'External reference number assigned to the enrollment event.']
  enrollment_source_system_code varchar [note: 'Code identifying the system that captured the enrollment. [ENUM-REF-CANDIDATE: SimCorp|Aladdin|Bloomberg|StateStreet|eFront|DealCloud|MSCI|CharlesRiver|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]']
  enrollment_source_system_device varchar [note: 'Device identifier used to capture the enrollment record.']
  enrollment_source_system_ip varchar [note: 'IP address of the system or user that captured the enrollment.']
  enrollment_source_system_location varchar [note: 'Geographic location of the system or user that captured the enrollment.']
  enrollment_source_system_name varchar [note: 'Human-readable name of the source system that captured the enrollment.']
  enrollment_source_system_reference_code varchar [note: 'Unique identifier within the source system for the enrollment record.']
  enrollment_source_system_reference_date date [note: 'Date associated with the source system reference for the enrollment.']
  enrollment_source_system_reference_description varchar [note: 'Description of the source system reference for the enrollment.']
  enrollment_source_system_reference_status varchar [note: 'Status of the source system reference for the enrollment.']
  enrollment_source_system_reference_type varchar [note: 'Type of reference used within the source system for the enrollment record.']
  enrollment_source_system_reference_value decimal(18,2) [note: 'Value of the reference within the source system for the enrollment record.']
  enrollment_source_system_user varchar [note: 'Identifier of the user or process that created the enrollment record.']
  enrollment_source_system_version varchar [note: 'Version of the source system used to capture the enrollment.']
  enrollment_status varchar [note: 'Current status of the enrollment process.']
  enrollment_type varchar [note: 'Type of enrollment event: new hire, transfer in, or re-enrollment.']
  fee_currency varchar [note: 'ISO 4217 currency code for the enrollment fee.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the enrollment record.']

  Note: 'Transactional record capturing the formal enrollment event when an individual joins a contributor pool as an active pension plan member. Records enrollment date, plan entry type (new hire, transfer-in, re-enrollment), eligibility verification outcome'
}

Table beneficiary.contribution_record {
  contribution_record_id varchar [pk, note: 'Unique identifier for the contribution record.']
  contributor_pool_id varchar [note: 'Identifier for the contributor pool (e.g., one of the participating plans) associated with the contribution.']
  member_id varchar [note: 'Identifier for the plan member associated with the contribution.']
  net_contribution_inflow_id varchar [note: 'Foreign key linking to treasury.net_contribution_inflow. Business justification: Links each contribution record to the treasury inflow for audit and reconciliation of member contributions.']
  pension_plan_id varchar [note: 'Identifier for the investment plan under which the contribution is made.']
  approval_date date [note: 'Date when the contribution was approved.']
  approved_by varchar [note: 'Identifier of the user who approved the contribution.']
  contribution_approval_status varchar [note: 'Approval status of the contribution record.']
  contribution_batch_code varchar [note: 'Identifier for the batch in which the contribution was processed.']
  contribution_created_timestamp timestamp [note: 'Timestamp when the contribution record was first created.']
  contribution_currency_code varchar [note: 'ISO 4217 currency code for the contribution amounts.']
  contribution_date timestamp [note: 'Timestamp when the contribution was recorded.']
  contribution_fee_amount decimal(18,2) [note: 'Fee charged for processing the contribution.']
  contribution_fee_currency_code varchar [note: 'ISO 4217 currency code for the fee amounts.']
  contribution_fee_rate decimal(5,4) [note: 'Rate applied to calculate the contribution fee.']
  contribution_fee_type varchar [note: 'Classification of the fee applied to the contribution.']
  contribution_frequency varchar [note: 'Frequency at which the contribution is made.']
  contribution_method varchar [note: 'Mechanism used to transfer the contribution funds.']
  contribution_period_end_date date [note: 'End date of the contribution period (pay period).']
  contribution_period_start_date date [note: 'Start date of the contribution period (pay period).']
  contribution_reference_number varchar [note: 'External reference number for the contribution transaction.']
  contribution_source varchar [note: 'Originating system or channel for the contribution.']
  contribution_source_system_code varchar [note: 'Code of the system that originated the contribution record.']
  contribution_source_system_name varchar [note: 'Name of the system that originated the contribution record.']
  contribution_source_system_reference_code varchar [note: 'Reference ID in the source system for the contribution record.']
  contribution_source_system_user varchar [note: 'User in the source system who created the contribution record.']
  contribution_source_system_version varchar [note: 'Version of the source system that created the contribution record.']
  contribution_status varchar [note: 'Current lifecycle status of the contribution record.']
  contribution_tax_amount decimal(18,2) [note: 'Tax amount applied to the contribution.']
  contribution_tax_code varchar [note: 'Tax code used for the contribution.']
  contribution_tax_rate decimal(5,4) [note: 'Tax rate applied to the contribution.']
  contribution_type varchar [note: 'Classification of the contribution (e.g., regular, catch‑up).']
  contribution_updated_timestamp timestamp [note: 'Timestamp when the contribution record was last updated.']
  employee_contribution_amount decimal(18,2) [note: 'Amount contributed by the employee for the period.']
  employer_contribution_amount decimal(18,2) [note: 'Amount contributed by the employer for the period.']
  total_contribution_amount decimal(18,2) [note: 'Sum of employee and employer contributions for the period.']

  Note: 'Transactional record of each periodic pension contribution made on behalf of or by a plan member. Captures employee contribution amount, employer contribution amount, contribution period (pay period), contribution type (regular, catch-up, voluntary'
}

Table beneficiary.pensionable_service {
  pensionable_service_id varchar [pk, note: 'Unique identifier for the pensionable service record.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Pensionable service records have contributor_pool STRING. Service credits are accrued under a specific contributor pool\'s rules. FK normalizes this.']
  indexation_policy_id varchar [note: 'Unique identifier for the pension plan.']
  member_id varchar [note: 'Unique identifier for the member in the pension fund.']
  pension_plan_id varchar [note: 'Unique identifier for the pension plan.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Service years are calculated per plan; linking to portfolio ensures correct service year attribution for pension calculations.']
  cumulative_service_months varchar [note: 'Total months of service credited to date.']
  cumulative_service_years varchar [note: 'Total years of service credited to date.']
  period_service_months varchar [note: 'Months of service credited in the current period.']
  period_service_years varchar [note: 'Years of service credited in the current period.']
  service_credits_approval_by varchar [note: 'Identifier of the approver for the service credits.']
  service_credits_approval_date date [note: 'Date when the service credits were approved.']
  service_credits_contributor_pool_code varchar [note: 'Code of the contributor pool for the service credits.']
  service_credits_created_by_user varchar [note: 'User who created the service credit record.']
  service_credits_created_timestamp timestamp [note: 'Timestamp when the service credit record was created.']
  service_credits_effective_from date [note: 'Effective start date of the service credits.']
  service_credits_effective_until date [note: 'Effective end date of the service credits.']
  service_credits_lifetime_status varchar [note: 'Lifetime status of the service credits.']
  service_credits_months varchar [note: 'Months of service credits recorded for the period.']
  service_credits_notes varchar [note: 'Additional notes regarding the service credits.']
  service_credits_plan_type varchar [note: 'Type of plan associated with the service credits.']
  service_credits_reason varchar [note: 'Reason for the service credit entry.']
  service_credits_source_system varchar [note: 'System that originated the service credit record.']
  service_credits_source_system_device varchar [note: 'Device used to enter the record in the source system.']
  service_credits_source_system_ip varchar [note: 'IP address of the source system at record entry.']
  service_credits_source_system_location varchar [note: 'Physical location of the source system at record entry.']
  service_credits_source_system_name varchar [note: 'Name of the source system for the service credit.']
  service_credits_source_system_reference varchar [note: 'Description of the reference in the source system.']
  service_credits_source_system_reference_code varchar [note: 'Reference ID in the source system for the service credit.']
  service_credits_source_system_reference_date date [note: 'Date of the reference in the source system.']
  service_credits_source_system_reference_status varchar [note: 'Status of the reference in the source system.']
  service_credits_source_system_reference_type varchar [note: 'Type of reference in the source system.']
  service_credits_source_system_reference_value decimal(18,2) [note: 'Value of the reference in the source system.']
  service_credits_source_system_user varchar [note: 'User who entered the record in the source system.']
  service_credits_source_system_version varchar [note: 'Version of the source system used.']
  service_credits_status varchar [note: 'Lifecycle status of the service credits.']
  service_credits_updated_by_user varchar [note: 'User who last updated the service credit record.']
  service_credits_updated_timestamp timestamp [note: 'Timestamp when the service credit record was last updated.']
  service_credits_years varchar [note: 'Years of service credits recorded for the period.']
  service_end_date date [note: 'Date when the pensionable service period ends.']
  service_start_date date [note: 'Date when the pensionable service period begins.']
  service_status varchar [note: 'Current lifecycle status of the service record.']
  service_type varchar [note: 'Category of pensionable service credit.']

  Note: 'Master record tracking the cumulative and period-level pensionable service credits accrued by a member. Records credited service years and months, service type (regular, buyback, transferred-in, military service credit), service period start and end'
}

Table beneficiary.entitlement {
  entitlement_id varchar [pk, note: 'Unique identifier for the entitlement record.']
  benefit_option_id varchar [note: 'Identifier of the benefit option selected.']
  contributor_pool_id varchar [note: 'Identifier linking the entitlement to the contributor pool.']
  designated_beneficiary_id varchar [note: 'Identifier of the survivor receiving the benefit.']
  entitlement_member_id varchar [note: 'Identifier linking the entitlement to the member.']
  entitlement_survivor_member_id varchar [note: 'Identifier of the survivor receiving the benefit.']
  pension_plan_id varchar [note: 'Identifier linking the entitlement to the investment plan.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Entitlement calculations depend on plan parameters; linking to portfolio provides the necessary plan context for benefit determination.']
  actuarial_basis varchar [note: 'Actuarial basis applied to the entitlement calculation.']
  benefit_amount decimal(18,2) [note: 'Gross monetary amount of the entitlement.']
  benefit_currency varchar [note: 'Currency of the benefit amount.']
  benefit_end_date date [note: 'Date when benefit payments cease.']
  benefit_frequency varchar [note: 'Payment frequency of the entitlement.']
  benefit_start_date date [note: 'Date when benefit payments commence.']
  calculation_method_code varchar [note: 'Code indicating the calculation methodology used.']
  created_timestamp timestamp [note: 'Timestamp when the entitlement record was created.']
  effective_from date [note: 'Date when the entitlement becomes effective.']
  effective_until date [note: 'Date when the entitlement expires or ends.']
  entitlement_status varchar [note: 'Current status of the entitlement.']
  entitlement_type varchar [note: 'Type of entitlement trigger.']
  guarantee_period_months varchar [note: 'Number of months the benefit is guaranteed.']
  indexation_rate decimal(5,4) [note: 'Annual indexation rate applied to the benefit.']
  indexation_type varchar [note: 'Method used for indexation.']
  number varchar [note: 'External reference number for the entitlement.']
  survivor_benefit_percentage decimal(5,2) [note: 'Percentage of the benefit allocated to the survivor.']
  survivor_relationship varchar [note: 'Relationship of the survivor to the member.']
  updated_timestamp timestamp [note: 'Timestamp when the entitlement record was last updated.']

  Note: 'Master record and authoritative source for the calculated pension entitlement owed to a member at a given point in time or benefit trigger (retirement, death, termination).'
}

Table beneficiary.benefit_payment {
  benefit_payment_id varchar [pk, note: 'Unique identifier for the benefit payment transaction.']
  cash_transfer_id varchar [note: 'Foreign key linking to treasury.cash_transfer. Business justification: Associates each benefit payment with the actual cash transfer for settlement and reporting.']
  designated_beneficiary_id varchar [note: 'Identifier linking the payment to the pension plan member.']
  entitlement_id varchar [note: 'Foreign key linking to beneficiary.entitlement. Business justification: Benefit payments are disbursed against a calculated entitlement. This FK links the payment to the specific entitlement record it satisfies.']
  member_id varchar [note: 'Identifier linking the payment to the pension plan member.']
  clawback_amount decimal(18,2) [note: 'Amount recovered due to overpayment or error.']
  currency_code varchar [note: 'ISO 4217 currency code for the payment amounts.']
  gross_amount decimal(18,2) [note: 'Total payment amount before deductions.']
  net_amount decimal(18,2) [note: 'Net amount paid to the beneficiary after deductions.']
  overpayment_recovery_amount decimal(18,2) [note: 'Amount recovered from an overpayment event.']
  payment_approval_by varchar [note: 'Identifier of the approver of the payment.']
  payment_approval_date timestamp [note: 'Timestamp when the payment was approved.']
  payment_approval_status varchar [note: 'Approval status of the payment transaction.']
  payment_channel varchar [note: 'Interface through which the payment was processed.']
  payment_date date [note: 'Date the payment was issued to the beneficiary.']
  payment_dispute_amount decimal(18,2) [note: 'Amount involved in the dispute.']
  payment_dispute_currency varchar [note: 'Currency of the disputed amount.']
  payment_dispute_date date [note: 'Date the dispute was raised.']
  payment_dispute_reason varchar [note: 'Reason for the payment dispute.']
  payment_dispute_status varchar [note: 'Status of any dispute related to the payment.']
  payment_frequency varchar [note: 'Frequency of recurring payments.']
  payment_frequency_end_date date [note: 'End date of the payment frequency schedule.']
  payment_frequency_interval varchar [note: 'Number of units between recurring payments.']
  payment_frequency_last_paid_date date [note: 'Date of the most recent payment in the frequency schedule.']
  payment_frequency_next_due_amount decimal(18,2) [note: 'Amount scheduled for the next recurring payment.']
  payment_frequency_next_due_channel varchar [note: 'Interface for the next scheduled payment.']
  payment_frequency_next_due_date date [note: 'Next scheduled payment date in the frequency schedule.']
  payment_frequency_next_due_method varchar [note: 'Instrument for the next scheduled payment.']
  payment_frequency_next_due_status varchar [note: 'Status of the next scheduled payment.']
  payment_frequency_start_date date [note: 'Start date of the payment frequency schedule.']
  payment_method varchar [note: 'Instrument used to deliver the payment.']
  payment_notes varchar [note: 'Free text notes related to the payment transaction.']
  payment_reference_number varchar [note: 'Internal reference used to track the payment transaction.']
  payment_settlement_amount decimal(18,2) [note: 'Amount settled to the beneficiary.']
  payment_settlement_channel varchar [note: 'Interface used for settlement.']
  payment_settlement_date date [note: 'Date the payment was settled.']
  payment_settlement_method varchar [note: 'Instrument used for settlement.']
  payment_settlement_notes varchar [note: 'Free text notes related to settlement.']
  payment_settlement_reference varchar [note: 'Reference for the settlement transaction.']
  payment_settlement_status varchar [note: 'Status of the payment settlement process.']
  payment_status varchar [note: 'Current status of the payment transaction.']
  payment_time timestamp [note: 'Timestamp of the payment issuance.']
  record_audit_created timestamp [note: 'Timestamp when the record was first created.']
  record_audit_updated timestamp [note: 'Timestamp when the record was last updated.']
  tax_withholding_amount decimal(18,2) [note: 'Amount withheld for taxes from the gross payment.']

  Note: 'Transactional record of each pension benefit payment disbursed to a member or beneficiary. Captures gross pension amount, applicable deductions (tax withholding, clawbacks, overpayment recovery), net payment amount, payment method (direct deposit'
}

Table beneficiary.member_lifecycle_event {
  member_lifecycle_event_id varchar [pk, note: 'Unique identifier for the member lifecycle event record.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Lifecycle events occur within a contributor pool context. Normalizing event_contributor_pool_code STRING to FK.']
  member_id varchar [note: 'Identifier linking the event to the member (beneficiary) record.']
  pension_plan_id varchar [note: 'Identifier linking the event to the investment plan record.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Lifecycle events such as retirement or transfer are plan-specific; linking to portfolio supports event-driven plan updates.']
  event_approval_by varchar [note: 'Identifier of the approver.']
  event_approval_date timestamp [note: 'Timestamp when the event was approved.']
  event_approval_document_reference varchar [note: 'Reference to the approval documentation.']
  event_approval_status varchar [note: 'Approval status of the event (if applicable).']
  event_created_by_user varchar [note: 'User who created the event record.']
  event_created_timestamp timestamp [note: 'Timestamp when the event record was first created.']
  event_description varchar [note: 'Detailed narrative describing the event.']
  event_end_date date [note: 'Date when the lifecycle event concluded or is expected to conclude.']
  event_member_age_at_event varchar [note: 'Age of the member at the time of the event.']
  event_member_service_years varchar [note: 'Total service years of the member at the time of the event.']
  event_notes varchar [note: 'Additional notes or remarks about the event.']
  event_plan_type varchar [note: 'Type of investment plan associated with the event.']
  event_reason_code varchar [note: 'Code representing the reason for the event.']
  event_reason_description varchar [note: 'Narrative description of the event reason.']
  event_source_system_code varchar [note: 'Code of the system that originated the event record.']
  event_source_system_device varchar [note: 'Device used in the source system during event creation.']
  event_source_system_ip varchar [note: 'IP address of the source system during event creation.']
  event_source_system_location varchar [note: 'Physical location of the source system during event creation.']
  event_source_system_name varchar [note: 'Name of the originating system.']
  event_source_system_reference_code varchar [note: 'Identifier of the referenced object in the source system.']
  event_source_system_reference_date date [note: 'Date of the referenced object in the source system.']
  event_source_system_reference_description varchar [note: 'Description of the referenced object in the source system.']
  event_source_system_reference_status varchar [note: 'Status of the referenced object in the source system.']
  event_source_system_reference_type varchar [note: 'Type of the referenced object in the source system.']
  event_source_system_reference_value decimal(18,2) [note: 'Value of the referenced object in the source system.']
  event_source_system_user varchar [note: 'User who performed the action in the source system.']
  event_source_system_version varchar [note: 'Version of the originating system.']
  event_start_date date [note: 'Date when the lifecycle event commenced.']
  event_status varchar [note: 'Current status of the event in its lifecycle.']
  event_subtype varchar [note: 'Specific subtype of the event for finer granularity.']
  event_type varchar [note: 'Category of lifecycle event (e.g., enrollment, retirement, death). [ENUM-REF-CANDIDATE: enrollment|active_service|leave_of_absence|disability|deferred_vesting|retirement_commencement|death|plan_termination — promote to reference product]']
  event_updated_by_user varchar [note: 'User who last updated the event record.']
  event_updated_timestamp timestamp [note: 'Timestamp when the event record was last updated.']

  Note: 'Transactional record capturing significant lifecycle state transitions for a plan member: enrollment, active service, leave of absence, disability, deferred vesting, retirement commencement, death, and plan termination.'
}

Table beneficiary.designated_beneficiary {
  designated_beneficiary_id varchar [pk, note: 'Unique identifier for the designated beneficiary record.']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Designated beneficiaries (survivors, dependents) receiving death/survivor benefits are actors requiring KYC verification, tax reporting (annual tax slips), and payment processing.']
  member_id varchar [note: 'Identifier of the plan member who designated the beneficiary.']
  address_line_1 varchar [note: 'Primary address line of the beneficiary.']
  address_line_2 varchar [note: 'Secondary address line of the beneficiary.']
  bank_account_number varchar [note: 'Beneficiary\'s bank account number for payments.']
  beneficiary_fraction_pct decimal(5,2) [note: 'Fraction of benefit allocated to the beneficiary.']
  beneficiary_name varchar [note: 'Full legal name of the designated beneficiary.']
  beneficiary_status varchar [note: 'Current lifecycle status of the beneficiary record.']
  benefit_amount decimal(18,2) [note: 'Monetary amount of the benefit payment.']
  benefit_commencement_date date [note: 'Date when benefit payments commence.']
  benefit_termination_date date [note: 'Date when benefit payments terminate.']
  benefit_type varchar [note: 'Type of benefit payment to the beneficiary.']
  children_benefit_age_limit varchar [note: 'Maximum age for child beneficiaries to receive benefits.']
  city varchar [note: 'City of the beneficiary\'s address.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the beneficiary\'s address.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  currency_code varchar [note: 'ISO 4217 currency code for the benefit amount.']
  date_of_birth date [note: 'Date of birth of the designated beneficiary.']
  death_cause_category varchar [note: 'Category of cause of death.']
  death_certificate_reference varchar [note: 'Reference to the death certificate document.']
  death_date date [note: 'Date of death of the beneficiary, if applicable.']
  designation_date date [note: 'Date the beneficiary was designated by the member.']
  email_address varchar [note: 'Primary email address of the beneficiary.']
  gender varchar [note: 'Gender of the beneficiary.']
  guarantee_period_months varchar [note: 'Guarantee period in months for the benefit.']
  is_disabled_dependent boolean [note: 'Indicates if beneficiary is a disabled dependent.']
  is_full_time_student boolean [note: 'Indicates if beneficiary is a full-time student.']
  kyc_verification_date date [note: 'Date when KYC verification was completed.']
  kyc_verified boolean [note: 'Flag indicating if beneficiary has passed KYC checks.']
  last_updated_timestamp timestamp [note: 'Timestamp of the last update to the record.']
  lump_sum_amount decimal(18,2) [note: 'One-time lump sum payment amount to the beneficiary.']
  marital_status varchar [note: 'Marital status of the beneficiary.']
  national_identifier varchar [note: 'Government issued national identification number.']
  payment_end_date date [note: 'End date of benefit payments.']
  payment_frequency varchar [note: 'Frequency of benefit payments.']
  payment_method varchar [note: 'Method used to disburse benefit payments.']
  payment_start_date date [note: 'Start date of benefit payments.']
  phone_number varchar [note: 'Primary phone number of the beneficiary.']
  postal_code varchar [note: 'Postal code of the beneficiary\'s address.']
  province_state varchar [note: 'Province or state of the beneficiary\'s address.']
  relationship_type varchar [note: 'Nature of the beneficiary\'s relationship to the plan member.']
  remarriage_termination_flag boolean [note: 'Flag indicating termination due to remarriage.']
  spouse_dob date [note: 'Date of birth of the beneficiary\'s spouse.']
  spouse_name varchar [note: 'Full name of the beneficiary\'s spouse, if applicable.']
  spouse_national_identifier varchar [note: 'National ID of the beneficiary\'s spouse.']
  tax_withholding_rate decimal(5,2) [note: 'Rate of tax withheld from benefit payments.']

  Note: 'Master record of the individuals designated by a plan member to receive survivor pension benefits or death-in-service lump sum payments. Stores beneficiary name, relationship to member (spouse, common-law partner, dependent child, estate), designation'
}

Table beneficiary.member_address {
  member_address_id varchar [pk, note: 'Unique surrogate identifier for each member address record within the pension fund member address master.']
  member_id varchar [note: 'Reference to the pension plan member to whom this address belongs. Links address to the beneficiary master record.']
  address_format_type varchar [note: 'Identifies the address format convention applied to this record, enabling correct rendering of address components for correspondence in different countries.']
  address_line_1 varchar [note: 'Primary street address line including street number, street name, and street type (e.g., 123 Main Street). First line of the civic address.']
  address_line_2 varchar [note: 'Secondary address line for suite, apartment, unit, floor, or building designator supplementing the primary street address line.']
  address_line_3 varchar [note: 'Tertiary address line used for additional delivery instructions, care-of designations, or rural route information where required.']
  address_notes varchar [note: 'Free-text field for additional address delivery instructions, special handling notes, or contextual information not captured in structured address fields.']
  address_source varchar [note: 'Identifies the originating channel or system through which this address was captured (e.g., member self-service portal, employer HR submission, plan administrator entry).']
  address_status varchar [note: 'Current lifecycle status of the address record. Active indicates the address is in use; undeliverable indicates returned mail; superseded indicates replaced by a newer record.']
  address_type varchar [note: 'Classifies the functional purpose of the address record (e.g., residential home address, mailing/correspondence address, employer workplace address). [ENUM-REF-CANDIDATE: residential|mailing|employer|temporary|seasonal|overseas — promote to reference']
  care_of_name varchar [note: 'Name of the individual or entity at the address to whom correspondence should be directed on behalf of the member (e.g., legal guardian, power of attorney, estate trustee).']
  city varchar [note: 'Municipality or city name component of the address. Used for geographic segmentation, regional reporting, and correspondence routing.']
  consent_recorded_date date [note: 'Date on which the member\'s consent to use this address for correspondence and data processing was recorded. Supports GDPR and applicable privacy law consent management obligations.']
  contributor_pool varchar [note: 'Identifies the pension contributor pool to which the member belongs (one per participating plan). Supports pool-specific correspondence and regulatory reporting.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 three-letter country code for the address (e.g., CAN, USA, GBR). Supports international member correspondence and regulatory jurisdiction determination.']
  created_timestamp timestamp [note: 'Timestamp when this address record was first created in the system. Supports audit trail, data lineage, and regulatory record-keeping requirements.']
  delivery_point_barcode varchar [note: 'Standardized postal delivery point barcode assigned by postal authority (USPS DPBC) to uniquely identify the physical delivery point. Supports automated mail sorting.']
  do_not_mail boolean [note: 'Indicates that physical correspondence must not be sent to this address per member instruction, legal order, or returned mail policy. Overrides standard mailing workflows.']
  do_not_mail_reason varchar [note: 'Reason code explaining why physical correspondence is suppressed for this address. Supports compliance audit trails and member communication management.']
  effective_from date [note: 'Date from which this address record is considered valid and active for the member. Supports temporal address history and point-in-time reporting.']
  effective_to date [note: 'Date on which this address record ceases to be valid. Null indicates the address is currently active. Enables historical address tracking for audit and compliance.']
  employer_department varchar [note: 'Government department, ministry, or organizational unit within the employer associated with the employer address. Supports employer-level reporting and contribution reconciliation.']
  employer_name varchar [note: 'Name of the employer associated with an employer address type. Applicable when address_type is employer; identifies the government department or agency where the member is employed.']
  foreign_address_flag boolean [note: 'Indicates whether this address is located outside the home country. Triggers additional regulatory, tax withholding, and foreign pension payment processing requirements.']
  is_mailing_preferred boolean [note: 'Indicates whether this address is the member\'s preferred address for all pension correspondence, benefit statements, and regulatory notices.']
  is_primary boolean [note: 'Indicates whether this address is the primary address of its type for the member. Only one address per address type per member should be flagged as primary at any time.']
  language_preference varchar [note: 'Preferred official language for correspondence sent to this address (for example English or French). Supports language-of-correspondence obligations.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this address record. Supports change tracking, audit compliance, and data freshness monitoring.']
  latitude double [note: 'Geographic latitude coordinate of the address in decimal degrees (WGS 84). Supports geospatial analytics, regional benefit distribution analysis, and member demographic mapping.']
  longitude double [note: 'Geographic longitude coordinate of the address in decimal degrees (WGS 84). Supports geospatial analytics, regional benefit distribution analysis, and member demographic mapping.']
  po_box varchar [note: 'Post office box number for members who receive mail at a PO Box rather than a civic street address. Used as an alternative delivery point.']
  postal_code varchar [note: 'Postal or ZIP code component of the address. Format varies by country (e.g., UK SW1A 1AA, US 12345). Used for mail delivery and geographic analysis.']
  province_state varchar [note: 'Province, state, or territory component of the address using standard two-letter postal abbreviation (e.g., ON, BC, NY). Supports regional liability and regulatory reporting.']
  rural_route varchar [note: 'Rural route or rural delivery route designator for members residing in rural areas not served by standard civic addressing (e.g., RR 2, SS 1).']
  source_system_code varchar [note: 'Identifies the operational system of record from which this address record originated (e.g., SimCorp Dimension, SAP SuccessFactors, member self-service portal). Supports data lineage.']
  source_system_ref varchar [note: 'The native identifier or record key assigned to this address in the originating source system (e.g., SimCorp party address ID, SAP SuccessFactors address sequence). Supports reconciliation.']
  standardized_address varchar [note: 'Full address formatted according to postal authority standards (e.g., USPS or Royal Mail) as a single concatenated string. Generated post-verification for mail production and deduplication.']
  tax_jurisdiction_code varchar [note: 'Tax jurisdiction code derived from the address location, used to determine applicable withholding tax rates and reporting obligations for pension benefit payments.']
  undeliverable_date date [note: 'Date on which correspondence sent to this address was returned as undeliverable. Triggers member address update workflow and suppresses further mailings.']
  undeliverable_reason varchar [note: 'Reason code from postal authority or courier indicating why correspondence was returned undeliverable. Supports member tracing and address remediation workflows.']
  verification_date date [note: 'Date on which the address was last validated against a postal authority or third-party address verification service. Supports data quality monitoring.']
  verification_source varchar [note: 'Identifies the system or method used to verify the address (e.g., USPS CASS, Royal Mail PAF, manual review). [ENUM-REF-CANDIDATE: usps_cass|royal_mail_paf|manual|member_self_service|employer_submission|third_party — promote to reference']
  verification_status varchar [note: 'Indicates the outcome of address validation against postal authority databases (e.g., USPS CASS, Royal Mail PAF). Supports data quality management and undeliverable mail reduction.']

  Note: 'Master record of all physical and mailing addresses associated with a plan member, including residential address, mailing address, and employer address. Tracks address type, full address components (street, city, province/state, postal code, country)'
}

Table beneficiary.member_contact {
  member_contact_id varchar [pk, note: 'Unique surrogate identifier for each member contact record within the pension fund member contact master.']
  member_id varchar [note: 'Reference to the pension plan member to whom this contact record belongs. Links contact details to the beneficiary master.']
  bounce_count varchar [note: 'Cumulative number of delivery failures or bounces recorded against this contact record. Used to determine when to deactivate or flag a contact for re-verification.']
  communication_frequency_pref varchar [note: 'Member\'s stated preference for how frequently they wish to receive communications via this contact channel. Governs outbound notification scheduling.']
  consent_evidence_ref varchar [note: 'Reference identifier or document locator for the consent evidence record (e.g., form ID, call recording reference) supporting the opt-in or opt-out decision.']
  consent_source varchar [note: 'Channel or mechanism through which the member\'s communication consent was captured (e.g., member portal, paper form, call centre, employer submission).']
  contact_status varchar [note: 'Current lifecycle status of the contact record indicating whether it is active, inactive, unverified, bounced (for email), or opted out by the member.']
  contact_subtype varchar [note: 'Further classification of the contact record indicating its relationship context such as personal, business, emergency, legal guardian, or power of attorney.']
  contact_type varchar [note: 'Classification of the contact channel or medium (e.g., mobile, home phone, work phone, email, fax, postal address). [ENUM-REF-CANDIDATE: mobile|home_phone|work_phone|email|fax|postal_address — promote to reference product]']
  contact_value decimal(18,2) [note: 'The actual contact detail for the given contact type (e.g., phone number, email address, or postal address string). Classified as restricted PII.']
  contributor_pool varchar [note: 'Pension contributor pool to which the member belongs (one per participating plan). Drives communication regulatory requirements and plan rules.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code associated with this contact record, used for international dialling prefix resolution and regulatory jurisdiction determination.']
  created_timestamp timestamp [note: 'Timestamp when this contact record was first created in the system. Supports audit trail and data lineage requirements per GDPR.']
  data_retention_category varchar [note: 'Retention classification applied to this contact record determining the applicable data retention schedule per regulatory and pension plan rules.']
  do_not_contact boolean [note: 'Hard suppression flag indicating the member has explicitly requested no communications via this contact channel. Overrides all other opt-in preferences.']
  do_not_contact_reason varchar [note: 'Reason code explaining why the do-not-contact flag has been set (e.g., member request, legal hold, deceased, regulatory order). Required for compliance audit.']
  effective_from_date date [note: 'Date from which this contact record is considered valid and active for the member. Supports bi-temporal modelling of contact history for regulatory audit.']
  effective_to_date date [note: 'Date on which this contact record ceased to be valid. Null for currently active records. Supports bi-temporal history and superseded contact tracking.']
  email_domain varchar [note: 'Domain portion of the email address (e.g., gmail.com, gov.uk) extracted for deliverability analytics and employer affiliation inference. Null for non-email contact types.']
  gdpr_lawful_basis varchar [note: 'GDPR Article 6 lawful basis under which this contact data is processed. Required for members subject to GDPR jurisdiction (e.g., UK, EU residents).']
  is_primary boolean [note: 'Indicates whether this contact record is the primary contact method for the member within its contact type. Only one record per contact type per member should be flagged true.']
  is_verified boolean [note: 'Indicates whether this contact detail has been verified through a formal verification process (e.g., email confirmation link, phone OTP, postal confirmation letter).']
  language_preference varchar [note: 'Member\'s preferred language for communications via this contact channel, expressed as a BCP 47 language tag (e.g., en-US, fr-FR). Supports multilingual regulatory obligations.']
  last_bounce_date date [note: 'Most recent date on which a communication attempt via this contact channel resulted in a delivery failure or bounce. Used to trigger contact re-verification workflows.']
  last_used_date date [note: 'Most recent date on which this contact channel was used to successfully communicate with the member (e.g., statement delivered, notification sent). Supports contact hygiene.']
  notes varchar [note: 'Free-text operational notes recorded by pension administration staff regarding this contact record (e.g., member requested contact update via call centre on specific date).']
  opt_in_date date [note: 'Date on which the member provided explicit consent to receive digital communications via this contact channel. Required for regulatory consent audit trail.']
  opt_in_digital boolean [note: 'Indicates whether the member has opted in to receive digital communications (email, SMS) via this contact. Required for CASL and GDPR consent tracking.']
  opt_out_date date [note: 'Date on which the member withdrew consent or opted out of digital communications via this contact channel. Null if the member has not opted out.']
  phone_country_dial_code varchar [note: 'International telephone country dialling prefix (e.g., +1, +44) applicable when contact_type is a phone-based channel. Null for non-phone contact types.']
  phone_extension varchar [note: 'Internal telephone extension number appended to the main phone number for work phone contact types. Null for mobile, home, or non-phone contact types.']
  preferred_channel boolean [note: 'Indicates whether this contact record represents the member\'s preferred communication channel across all contact types for outbound member communications.']
  purge_eligible_date date [note: 'Date on or after which this contact record is eligible for deletion or anonymisation under the applicable data retention schedule. Null if retention period has not elapsed.']
  source_system_ref varchar [note: 'Unique identifier of this contact record in the originating source system (e.g., SAP SuccessFactors person contact ID). Enables lineage tracing and reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this contact record. Used for change detection, audit trail, and incremental data pipeline processing.']
  verification_date date [note: 'Date on which the contact detail was successfully verified. Null if the contact has not been verified or verification is pending.']
  verification_method varchar [note: 'Method used to verify the contact detail (e.g., email confirmation link, SMS one-time password, postal letter, call centre agent confirmation). Null if not yet verified.']

  Note: 'Master record of contact information for a plan member including phone numbers, email addresses, and preferred communication channel. Stores contact type (mobile, home, work, email), contact value, is_primary flag, opt-in/opt-out preferences for digital'
}

Table beneficiary.contribution_rate {
  contribution_rate_id varchar [pk, note: 'Unique surrogate identifier for a contribution rate schedule record within the pension fund system.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Contribution_rate defines a rate for a specific contributor pool; linking to contributor_pool ensures referential integrity and removes the redundant contributor_pool string']
  actuarial_valuation_year varchar [note: 'The year of the actuarial valuation report that determined or last confirmed this contribution rate, linking the rate to its actuarial basis.']
  approval_date date [note: 'The date on which this contribution rate schedule was formally approved by the relevant governing authority or Investment Committee.']
  approved_by varchar [note: 'Name or identifier of the authority, committee, or official who approved this contribution rate schedule (e.g., \'plan sponsor\', \'IC Resolution 2024-07\').']
  contribution_frequency varchar [note: 'The payroll frequency at which contributions are deducted and remitted under this rate schedule (e.g., bi-weekly, monthly).']
  created_timestamp timestamp [note: 'The timestamp when this contribution rate record was first created in the system, used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the earnings thresholds and monetary fields on this rate schedule (e.g., USD).']
  earnings_threshold_lower decimal(18,2) [note: 'The lower bound of the pensionable earnings band (in the plan currency) to which this rate tier applies. Null or zero indicates no lower bound.']
  earnings_threshold_upper decimal(18,2) [note: 'The upper bound of the pensionable earnings band (in the plan currency) to which this rate tier applies. Null indicates no upper cap (top tier).']
  effective_from date [note: 'The date from which this contribution rate schedule becomes binding and applicable to member payroll deductions.']
  effective_until date [note: 'The date on which this contribution rate schedule ceases to be applicable. Null indicates the schedule is open-ended and currently in force.']
  employment_category varchar [note: 'The employment category of members to which this rate applies, as different employment categories may attract different contribution rates.']
  gazette_reference varchar [note: 'The official government gazette or regulatory publication reference number where this rate was published or enacted (e.g., \'Federal Register Vol. 89 No. 12\').']
  indexation_basis varchar [note: 'The basis on which this contribution rate is indexed or adjusted over time: CPI (Consumer Price Index), fixed increment, negotiated, or none.']
  indexation_rate decimal(8,6) [note: 'The annual indexation rate applied to adjust the contribution rate or earnings thresholds, expressed as a decimal (e.g., 0.02 = 2%). Null if indexation_basis is none.']
  is_mandatory boolean [note: 'Indicates whether participation and contribution at this rate is mandatory (True) or voluntary/optional (False) for eligible members.']
  is_tax_deductible boolean [note: 'Indicates whether contributions made at this rate are tax-deductible for the member under applicable income tax legislation.']
  jurisdiction_code varchar [note: 'ISO 3166-1 alpha-2 or alpha-3 country/province code identifying the jurisdiction under whose laws this contribution rate is governed (e.g., \'CAN\').']
  last_updated_timestamp timestamp [note: 'The timestamp when this contribution rate record was most recently modified, supporting change tracking and audit compliance.']
  legislative_authority varchar [note: 'The specific act, regulation, or statutory instrument that mandates or authorises this contribution rate (e.g., \'the governing plan statute\', \'the governing plan statute\').']
  max_pensionable_earnings decimal(18,2) [note: 'The annual maximum pensionable earnings cap (in currency_code) above which contributions are not required under this rate schedule.']
  min_pensionable_earnings decimal(18,2) [note: 'The annual minimum pensionable earnings floor (in currency_code) below which contributions are not required under this rate schedule.']
  plan_type varchar [note: 'The type of pension plan to which this rate schedule applies: defined benefit (DB), defined contribution (DC), or hybrid.']
  rate_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this contribution rate schedule, used in regulatory filings and system integrations.']
  rate_description varchar [note: 'Free-text description providing additional context about the rate schedule, including any special conditions, exceptions, or transitional provisions.']
  rate_name varchar [note: 'Human-readable name describing the contribution rate schedule (e.g., \'Plan 1 Tier 1 Employee Rate 2024\').']
  rate_percent decimal(8,6) [note: 'The contribution rate expressed as a decimal percentage of pensionable earnings (e.g., 0.0895 = 8.95%). This is the principal quantitative fact of the rate schedule.']
  rate_status varchar [note: 'Current lifecycle status of the rate schedule: active (in force), pending (approved but not yet effective), superseded (replaced by a newer schedule), or withdrawn.']
  rate_tier varchar [note: 'Tier label or band designation within a tiered rate structure (e.g., \'Tier 1\', \'Tier 2\', \'Tier 3\') based on pensionable earnings thresholds. [ENUM-REF-CANDIDATE: tier_1|tier_2|tier_3|tier_4|tier_5|tier_6|tier_7 — promote to reference product]']
  rate_type varchar [note: 'Indicates whether this rate applies to the employee (member) contribution, the employer  contribution, or a combined rate.']
  regulatory_basis varchar [note: 'The regulatory framework, actuarial valuation report, or government directive that provides the basis for setting this rate (e.g., \'Actuarial Report 2022 — the national pension regulator\').']
  service_category varchar [note: 'The service category applicable to this rate (e.g., regular service, reserve service, secondment, leave without pay), which may affect the applicable rate.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this rate schedule was sourced (e.g., \'SIMCORP\', \'ORACLE_FIN\', \'MANUAL\').']
  superseded_by_rate_code varchar [note: 'The rate_code of the successor contribution rate schedule that replaced this record when rate_status is superseded. Null if not superseded.']
  version_number varchar [note: 'Monotonically increasing version number for this rate schedule record, supporting audit trail and temporal versioning of rate changes.']

  Note: 'Reference entity defining the contribution rate schedules applicable to each contributor pool, including employee and employer rate tiers, effective date ranges, pensionable earnings thresholds, and the legislative or regulatory basis for each rate.'
}

Table beneficiary.service_buyback {
  service_buyback_id varchar [pk, note: 'Unique surrogate identifier for a service buyback election record. Primary key for this transactional entity.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Service buyback actuarial costs are calculated using specific discount rates and mortality assumptions.']
  contributor_pool_id varchar [note: 'Reference to the contributor pool (one per participating plan) under which this buyback election is filed.']
  member_id varchar [note: 'Reference to the pension plan member who elected to purchase additional pensionable service credits via this buyback transaction.']
  pension_plan_id varchar [note: 'Reference to the specific pension plan under which the service buyback is being processed.']
  actuarial_cost_amount decimal(18,2) [note: 'Total actuarially determined cost for the member to purchase the specified service credits, calculated by the pension fund\'s actuaries based on age, salary, and service factors.']
  actuarial_cost_basis varchar [note: 'Actuarial methodology used to calculate the buyback cost: prospective (future benefit cost), retrospective (past contributions with interest), or blended.']
  actuarial_cost_currency varchar [note: 'ISO 4217 three-letter currency code in which the actuarial cost amount is denominated (e.g., USD, GBP).']
  actuarial_valuation_date date [note: 'The reference date used by the actuary to calculate the cost of the buyback, reflecting salary and demographic assumptions as of that date.']
  application_received_timestamp timestamp [note: 'Exact date and time the member\'s buyback application was received and recorded in the pension administration system.']
  approval_date date [note: 'Date on which the buyback election was formally approved by the pension administration authority following eligibility and actuarial review.']
  approved_by varchar [note: 'Name or identifier of the pension administration officer who approved the buyback election after eligibility verification and actuarial costing.']
  buyback_reference_number varchar [note: 'Externally-known unique alphanumeric reference number assigned to this buyback election, used in member correspondence and administrative processing.']
  buyback_status varchar [note: 'Current lifecycle status of the buyback election, tracking progression from member application through actuarial costing, payment, and credit posting. [ENUM-REF-CANDIDATE: pending|approved|in_progress|completed|cancelled|rejected — promote to reference']
  cancellation_date date [note: 'Date on which the buyback election was cancelled, either by member withdrawal or administrative rejection. Null if not cancelled.']
  cancellation_reason varchar [note: 'Reason code for cancellation of the buyback election, used for administrative reporting and member communication. [ENUM-REF-CANDIDATE: member_withdrawal|payment_default|ineligibility_determined|plan_rule_change|administrative_error|other — promote to']
  completion_date date [note: 'Date on which all buyback payments were received in full and the pensionable service credits were formally posted to the member\'s record.']
  election_date date [note: 'The date on which the member formally elected to purchase additional pensionable service credits, establishing the effective date for actuarial cost calculation.']
  eligibility_verification_date date [note: 'Date on which the member\'s eligibility for the buyback was formally verified and confirmed by the pension administration team.']
  eligibility_verified boolean [note: 'Indicates whether the member\'s eligibility for this buyback has been formally verified by the pension administration team against plan rules and service records.']
  employer_contribution_amount decimal(18,2) [note: 'Employer\'s share of the buyback cost, if applicable under the plan rules or collective agreement, credited alongside the member\'s own contribution.']
  gl_account_code varchar [note: 'Oracle Financials GL account code to which the buyback contribution receipts are posted for pension fund accounting and financial reporting purposes.']
  installment_amount decimal(18,2) [note: 'Amount of each periodic installment payment when the member elects an installment payment plan for the buyback.']
  installment_count varchar [note: 'Total number of installment payments agreed upon when the member elects an installment payment method for the buyback. Null if lump sum.']
  installment_frequency varchar [note: 'Frequency of installment payments when the member elects a periodic payment plan for the buyback cost.']
  interest_accrued_amount decimal(18,2) [note: 'Total interest accrued on the outstanding buyback balance to date, added to the member\'s obligation when payment is deferred beyond the election date.']
  interest_rate decimal(8,6) [note: 'Annual interest rate applied to deferred or installment buyback payments, as prescribed by plan rules or actuarial assumptions (e.g., based on SOFR or plan-specific rate).']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this buyback record, supporting audit trail and change tracking requirements.']
  member_age_at_election decimal(5,2) [note: 'Member\'s age in years (to two decimal places) at the time of the buyback election, a key actuarial input for cost determination.']
  member_contribution_amount decimal(18,2) [note: 'Total amount the member is required to contribute (employee share) toward the buyback cost, net of any employer or government subsidy.']
  notes varchar [note: 'Free-text field for pension administration staff to record relevant notes, exceptions, or special circumstances related to this buyback election.']
  outstanding_balance_amount decimal(18,2) [note: 'Remaining unpaid balance on the buyback cost, calculated as actuarial cost minus total paid amount. Drives collection and reminder workflows.']
  payment_deadline_date date [note: 'Final date by which the member must complete all buyback payments to secure the pensionable service credits, as stipulated in the buyback agreement.']
  payment_method varchar [note: 'Method elected by the member to fund the buyback cost, such as lump sum, installment plan, payroll deduction, retirement account transfer, or pension transfer.']
  pension_adjustment_amount decimal(18,2) [note: 'Pension Adjustment amount reported to tax authorities reflecting the value of the pension benefit accrued through the buyback, reducing the member\'s tax-advantaged contribution room.']
  prior_service_end_date date [note: 'End date of the prior non-contributory service period being purchased as pensionable service credits.']
  prior_service_start_date date [note: 'Start date of the prior non-contributory service period being purchased as pensionable service credits.']
  prior_service_type varchar [note: 'Classification of the non-contributory prior service period being purchased, determining eligibility rules and actuarial cost methodology. [ENUM-REF-CANDIDATE']
  salary_used_for_costing decimal(18,2) [note: 'Annual salary figure used as the basis for actuarial cost calculation of the buyback, typically the member\'s salary at the election date or a plan-defined reference salary.']
  service_credit_posted_date date [note: 'Date on which the purchased pensionable service credits were officially recorded in the member\'s service history, updating entitlement calculations.']
  service_credits_purchased_years decimal(6,4) [note: 'Total number of pensionable service years being purchased through this buyback election, expressed as a decimal fraction of a year.']
  source_system_reference varchar [note: 'Identifier of the originating pension administration system record (e.g., SimCorp Dimension member record ID) from which this buyback data was sourced.']
  supporting_document_reference varchar [note: 'Reference identifier for supporting documentation (e.g., leave records, prior employment verification, military service records) submitted with the buyback application.']
  tax_receipt_issued boolean [note: 'Indicates whether a tax receipt (e.g., pension adjustment or retirement contribution receipt) has been issued to the member for the buyback payment.']
  tax_receipt_year varchar [note: 'Tax year for which the buyback tax receipt was issued to the member, used for annual tax reporting and reconciliation.']
  total_paid_amount decimal(18,2) [note: 'Cumulative amount received from the member to date against the total buyback cost, used to track payment progress and outstanding balance.']

  Note: 'Transactional record of a member\'s election to purchase additional pensionable service credits for prior periods of non-contributory service (e.g., maternity/parental leave, prior public-sector employment, military service).'
}

Table beneficiary.transfer_in {
  transfer_in_id varchar [pk, note: 'Unique surrogate identifier for each pension transfer-in transaction record within the fund.']
  cash_transfer_id varchar [note: 'Foreign key linking to treasury.cash_transfer. Business justification: Links member transfer‑in records to the treasury transfer for reconciliation of incoming cash.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Transfer-in records specify which contributor pool the member is joining. Normalizing STRING to FK.']
  designated_beneficiary_id varchar [note: 'Reference to the pension plan member on whose behalf the transfer-in is being received.']
  member_id varchar [note: 'Reference to the pension plan member on whose behalf the transfer-in is being received.']
  pension_plan_id varchar [note: 'Foreign key linking to beneficiary.pension_plan. Business justification: Transfer-in records represent pension assets transferred INTO a specific pension plan. The plan_id FK is essential for tracking which plan receives the transfer.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Transfers into a plan require portfolio context for valuation and accounting.']
  actuarial_basis varchar [note: 'Description of the actuarial assumptions and methodology used to calculate the commuted value, including discount rate, mortality table, and projection basis.']
  aml_screened boolean [note: 'Indicates whether the transfer-in has been screened against AML/CTF watchlists and sanctions lists as required by the financial intelligence unit and FATF standards.']
  commuted_value decimal(20,4) [note: 'Actuarially determined lump-sum present value of the member\'s accrued pension entitlement from the source plan, as calculated per actuarial standards body standards.']
  tax_authority_approval_date date [note: 'Date on which the tax authority granted approval for the transfer-in, where such approval was required.']
  tax_authority_approval_reference varchar [note: 'Reference number issued by the tax authority confirming approval of the transfer-in transaction.']
  tax_authority_approval_required boolean [note: 'Indicates whether the tax authority approval is required for this transfer-in, typically applicable for past service pension adjustments exceeding thresholds.']
  created_timestamp timestamp [note: 'Timestamp when this transfer-in record was first created in the system, used for audit trail and data lineage purposes.']
  custodian_reference varchar [note: 'Reference number assigned by the fund\'s custodian (State Street / Northern Trust) to the settlement of the transfer-in receipt.']
  discount_rate decimal(8,6) [note: 'Annualized discount rate applied by the source plan actuary to calculate the commuted value of the member\'s accrued pension benefit.']
  effective_date date [note: 'The date from which the transferred service credits or assets are recognized as effective within the receiving pension plan for benefit entitlement purposes.']
  employer_contribution_amount decimal(20,4) [note: 'Portion of the transferred amount attributable to employer contributions in the source plan, relevant for vesting and tax treatment determination.']
  fx_rate decimal(18,8) [note: 'Exchange rate applied to convert the transfer amount from the transfer currency to the base currency on the valuation date.']
  gl_posting_reference varchar [note: 'Reference to the General Ledger (GL) journal entry in Oracle Financials recording the receipt of the transfer-in assets in the fund\'s accounting books.']
  investment_earnings_amount decimal(20,4) [note: 'Portion of the transferred amount attributable to accumulated investment earnings on contributions in the source plan.']
  kyc_verified boolean [note: 'Indicates whether KYC identity verification has been completed for the member in connection with this transfer-in, per AML/CTF obligations.']
  locked_in_flag boolean [note: 'Indicates whether the transferred assets are subject to locked-in restrictions under applicable pension legislation, preventing early withdrawal.']
  member_consent_date date [note: 'Date on which the member provided written consent authorizing the transfer-in from the source plan to the receiving fund.']
  member_contribution_amount decimal(20,4) [note: 'Portion of the transferred amount attributable to the member\'s own contributions in the source plan, used for tax and benefit entitlement calculations.']
  notes varchar [note: 'Free-text field for additional administrative notes, exceptions, or special handling instructions related to this transfer-in transaction.']
  past_service_pension_adjustment decimal(20,4) [note: 'Past Service Pension Adjustment amount arising from the recognition of prior service credits, reducing the member\'s available tax-advantaged contribution room.']
  pension_adjustment_reversal decimal(20,4) [note: 'Pension Adjustment Reversal amount reported to the tax authority when a member terminates from the source DB plan, restoring tax-advantaged contribution room.']
  portability_election_type varchar [note: 'Indicates whether the member elected to transfer the full commuted value or only a partial amount from the source plan.']
  prior_service_end_date date [note: 'End date of the prior service period being recognized through this transfer-in, marking the boundary of the credited service block.']
  prior_service_start_date date [note: 'Start date of the prior service period being recognized through this transfer-in, used to establish the member\'s pensionable service history.']
  receipt_date date [note: 'The date on which the fund physically received the transferred assets or funds from the source plan, as confirmed by the custodian.']
  reference_number varchar [note: 'Externally-known unique reference number assigned to this transfer-in transaction, used for reconciliation with the source plan and custodian.']
  rejection_reason varchar [note: 'Reason code or description explaining why the transfer-in was rejected or cancelled, populated only when transfer_status is rejected or cancelled.']
  service_credit_years decimal(8,4) [note: 'Number of years of pensionable service credited to the member in the receiving plan as a result of this transfer-in, expressed as a decimal.']
  simcorp_transaction_reference varchar [note: 'Transaction identifier assigned by SimCorp Dimension (ABOR/Investment Accounting module) upon posting of the transfer-in receipt.']
  source_plan_administrator varchar [note: 'Name of the plan administrator or financial institution responsible for the source pension plan from which assets are being transferred.']
  source_plan_confirmation_ref varchar [note: 'Reference number or document identifier from the source plan administrator confirming the release and transfer of the member\'s pension entitlement.']
  source_plan_jurisdiction varchar [note: 'Regulatory jurisdiction governing the source pension plan (e.g., CAN, ON, BC, FED) under which the transfer is being executed.']
  source_plan_name varchar [note: 'Full legal name of the pension plan or retirement account from which the assets or service credits are being transferred.']
  source_plan_registration_number varchar [note: 'Government-issued registration number of the source pension plan as assigned by the tax authority or applicable regulator.']
  source_plan_type varchar [note: 'Classification of the originating plan: Defined Benefit (DB), Defined Contribution (DC), individual retirement account, group retirement savings plan, or profit-sharing plan.']
  tax_withheld_amount decimal(20,4) [note: 'Amount of withholding tax deducted from the transfer by the source plan administrator prior to remittance, if applicable.']
  transfer_amount decimal(20,4) [note: 'Gross monetary value of the assets transferred into the fund from the source plan, expressed in the transfer currency.']
  transfer_amount_base_equivalent decimal(20,4) [note: 'Gross monetary value of the transfer-in converted to national Dollars (Base Currency) at the applicable FX rate on the valuation date, used for fund-level reporting.']
  transfer_currency varchar [note: 'ISO 4217 three-letter currency code of the currency in which the transfer amount is denominated (e.g., USD).']
  transfer_date date [note: 'The date on which the transfer-in transaction was formally initiated and submitted by the source plan administrator.']
  transfer_method varchar [note: 'Mechanism by which the transfer assets were physically remitted to the fund: wire transfer, cheque, in-kind asset transfer, or electronic funds transfer (EFT).']
  transfer_status varchar [note: 'Current lifecycle state of the transfer-in transaction from initiation through to final receipt and posting.']
  transfer_type varchar [note: 'Classification of the transfer-in by mechanism: commuted value from a defined benefit plan, service credit recognition, retirement savings account conversion, direct plan-to-plan transfer, or group transfer.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this transfer-in record, supporting audit trail, change tracking, and incremental data loading.']
  valuation_date date [note: 'The date used to determine the commuted value or asset value of the transferred pension entitlement from the source plan.']
  vesting_status varchar [note: 'Vesting status of the member\'s entitlement in the source plan at the time of transfer, determining the transferable benefit amount.']

  Note: 'Transactional record of pension assets or service credits transferred into the fund from another pension plan or retirement account on behalf of a member. Records the source plan name, transfer type (commuted value, service credit recognition), transfer'
}

Table beneficiary.transfer_out {
  transfer_out_id varchar [pk, note: 'Unique surrogate identifier for each pension transfer-out transaction record within the fund\'s IBOR/ABOR system.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Commuted value calculations for pension transfers require specific actuarial assumptions (discount rate, mortality table).']
  cash_transfer_id varchar [note: 'Foreign key linking to treasury.cash_transfer. Business justification: Links member transfer‑out records to the treasury transfer for reconciliation of outgoing cash.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Transfer-out records specify which contributor pool the member is leaving. Normalizing STRING to FK.']
  member_id varchar [note: 'Reference to the pension plan member (beneficiary) initiating the transfer-out of their accrued entitlement upon termination of employment.']
  pension_plan_id varchar [note: 'Reference to the pension plan (one per participating plan) from which the transfer-out is being processed.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Transfers out of a plan need portfolio context for tax and settlement calculations.']
  accrued_service_years decimal(8,4) [note: 'The total years of pensionable service accrued by the member as at the termination date, used as the basis for the commuted value actuarial calculation.']
  aml_cleared boolean [note: 'Indicates whether the transfer-out transaction has passed the required Anti-Money Laundering (AML) and Know Your Customer (KYC) screening prior to fund disbursement.']
  aml_review_date date [note: 'The date on which the Anti-Money Laundering (AML) and KYC review was completed for this transfer-out transaction.']
  approval_date date [note: 'The date on which the transfer-out was formally approved by the pension administration team following actuarial valuation and compliance review.']
  approved_by varchar [note: 'The identifier or name of the pension administration officer who approved the transfer-out transaction, supporting governance and audit trail requirements.']
  base_currency_amount decimal(20,4) [note: 'The total commuted value transfer amount expressed in the fund\'s base currency (Base Currency), after applying the applicable FX rate for cross-currency transfers.']
  best_average_salary decimal(18,4) [note: 'The member\'s best average salary figure used in the defined benefit formula to determine the accrued pension entitlement underlying the commuted value calculation.']
  commuted_value_amount decimal(20,4) [note: 'The actuarially determined commuted value (CV) of the member\'s accrued pension entitlement as at the valuation date, representing the lump-sum equivalent of the deferred pension.']
  currency_code varchar [note: 'The ISO 4217 three-letter currency code in which the commuted value and transfer amounts are denominated (e.g., USD).']
  discount_rate decimal(10,6) [note: 'The actuarial discount rate (as a decimal) applied in the commuted value calculation to present-value the projected pension cash flows, per actuarial standards.']
  election_date date [note: 'The date on which the member formally elected to transfer their commuted value or pension credit out of the fund rather than defer or take an annuity.']
  election_deadline_date date [note: 'The statutory or plan-rule deadline by which the member must elect the transfer-out option; failure to elect by this date may result in a deferred pension default.']
  fx_rate decimal(18,8) [note: 'The FX rate applied to convert the transfer amount to the fund\'s base currency where the receiving plan is denominated in a foreign currency.']
  gl_account_code varchar [note: 'The General Ledger (GL) account code in Oracle Financials to which the commuted value transfer disbursement is posted for fund accounting and liability reduction.']
  initiated_timestamp timestamp [note: 'The date and time when the transfer-out transaction was first created in the pension administration system, serving as the primary audit creation timestamp.']
  is_cross_border boolean [note: 'Indicates whether the transfer-out involves a cross-border remittance to a foreign registered pension plan, triggering additional regulatory and FX requirements.']
  last_updated_timestamp timestamp [note: 'The date and time when the transfer-out record was most recently modified, supporting audit trail and data lineage requirements.']
  member_consent_ref varchar [note: 'Reference to the signed member consent or election form authorizing the transfer-out, stored in the document management system for audit and compliance purposes.']
  mortality_table_code varchar [note: 'The actuarial mortality table code (e.g., RP-2014, UP-94) used in the commuted value calculation to project member life expectancy.']
  notes varchar [note: 'Free-text field for pension administration officers to record exceptions, special circumstances, or supplementary information relevant to this transfer-out transaction.']
  payment_method varchar [note: 'The method by which the commuted value funds are remitted to the receiving institution or directly to the member for the taxable portion.']
  receiving_country_code varchar [note: 'The ISO 3166-1 alpha-3 country code of the jurisdiction where the receiving registered plan is domiciled, required for cross-border transfer regulatory reporting.']
  receiving_institution_lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier (LEI) of the receiving financial institution, used for counterparty identification and regulatory reporting.']
  receiving_institution_name varchar [note: 'The name of the financial institution or pension plan administrator receiving the transferred commuted value funds on behalf of the member.']
  receiving_plan_number varchar [note: 'The account or plan registration number at the receiving institution to which the commuted value funds are directed. Classified as confidential financial data.']
  receiving_plan_type varchar [note: 'Type of registered plan or account to which the commuted value is being transferred (e.g., locked-in retirement account, another pension plan). [ENUM-REF-CANDIDATE: IRA|locked_in_account|DC_PLAN|DB_PLAN|foreign_pension — promote to reference product]']
  reference_number varchar [note: 'Externally-known unique business reference number assigned to this transfer-out transaction, used in member correspondence and regulatory filings.']
  registered_transfer_amount decimal(20,4) [note: 'The portion of the commuted value transferred on a tax-sheltered basis directly into the member\'s registered receiving plan (locked-in account, another pension plan, etc.), net of any taxable portion.']
  regulatory_filing_ref varchar [note: 'The reference number of the regulatory filing or notification submitted to the applicable pension regulator (e.g., the national pension regulator) in connection with this transfer-out.']
  settlement_instructions_ref varchar [note: 'Reference to the Standard Settlement Instructions (SSI) on file for the receiving institution, used to route the wire transfer or EFT payment accurately.']
  source_system_ref varchar [note: 'The unique transaction identifier assigned by the originating pension administration or ABOR system (e.g., SimCorp Dimension) for reconciliation and data lineage tracing.']
  tax_slip_issued boolean [note: 'Indicates whether the required tax reporting slip (e.g., an annual pension income slip) has been issued to the member for the taxable portion of the commuted value transfer.']
  tax_slip_year varchar [note: 'The tax year for which the tax reporting slip is issued to the member, corresponding to the calendar year in which the commuted value transfer was executed.']
  taxable_portion_amount decimal(20,4) [note: 'The portion of the commuted value that exceeds the registered plan contribution room and is subject to withholding tax, payable directly to the member.']
  termination_date date [note: 'The date on which the member\'s pensionable employment ended, triggering eligibility for the transfer-out option under the plan rules.']
  transfer_date date [note: 'The actual date on which the commuted value funds were transferred out of the fund to the receiving registered plan or locked-in retirement account.']
  transfer_reason varchar [note: 'The reason code for the transfer-out, indicating whether the member voluntarily resigned, was involuntarily terminated, or is transferring between registered plans.']
  transfer_status varchar [note: 'Current lifecycle state of the transfer-out transaction from initiation through to completion or cancellation. [ENUM-REF-CANDIDATE: initiated|pending_valuation|approved|funds_transferred|completed|cancelled|on_hold — promote to reference product]']
  transfer_type varchar [note: 'Classification of the transfer-out by the nature of the entitlement being transferred: commuted value of accrued pension, pension credit portability, or lump-sum commuted value.']
  valuation_date date [note: 'The actuarial valuation date used to calculate the commuted value (CV) of the member\'s accrued pension entitlement for transfer purposes.']
  withholding_tax_amount decimal(20,4) [note: 'The amount of income tax withheld at source on the taxable portion of the commuted value transfer, remitted to the relevant tax authority on behalf of the member.']

  Note: 'Transactional record of commuted value or pension credit transfers out of the fund when a member terminates employment before retirement and elects to transfer their accrued entitlement to another registered plan or locked-in retirement account.'
}

Table beneficiary.retirement_election {
  retirement_election_id varchar [pk, note: 'Unique surrogate identifier for the retirement election record. Primary key for the retirement_election data product in the beneficiary domain.']
  beneficiary_id varchar [note: 'Reference to the pension plan member (beneficiary) who submitted this retirement election. Links to the beneficiary master record.']
  benefit_option_id varchar [note: 'Foreign key linking to beneficiary.benefit_option. Business justification: Retirement election captures the member\'s chosen pension option. The pension_option STRING should be normalized to FK to benefit_option table which defines available options.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Retirement elections are made under a specific contributor pool. The STRING field should be normalized to FK.']
  designated_beneficiary_id varchar [note: 'Reference to the designated survivor or beneficiary record who will receive survivor pension benefits upon the member\'s death under the elected pension option.']
  member_id varchar [note: 'Reference to the pension plan member (beneficiary) who submitted this retirement election. Links to the beneficiary master record.']
  pension_plan_id varchar [note: 'Reference to the pension plan under which this retirement election is made (e.g., the participating plans plan).']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Retirement elections are plan-specific; linking to portfolio supports election processing and benefit payout.']
  survivor_designated_beneficiary_id varchar [note: 'Reference to the designated survivor or beneficiary record who will receive survivor pension benefits upon the member\'s death under the elected pension option.']
  administrator_notes varchar [note: 'Free-text notes entered by the pension administrator during review and processing of the retirement election, capturing exceptions, clarifications, or special circumstances.']
  approved_date date [note: 'The date on which the retirement election was formally approved by the pension administrator, triggering commencement of benefit payment processing.']
  bank_account_reference varchar [note: 'Masked or tokenized reference to the member\'s bank account designated for direct deposit of pension payments. Full account details held in secure payment system.']
  best_average_earnings decimal(18,2) [note: 'The member\'s highest average pensionable earnings over the defined averaging period (typically best 5 years), used as the salary base in the defined benefit pension formula.']
  bridge_benefit_amount decimal(18,2) [note: 'Annual amount of the bridge benefit payable to the member until state pension eligibility, if bridge benefit was elected. Ceases at the bridge benefit end date.']
  bridge_benefit_elected boolean [note: 'Indicates whether the member elected to receive a bridge benefit (temporary supplement payable until state pension eligibility age) as part of their retirement package.']
  bridge_benefit_end_date date [note: 'The date on which the bridge benefit ceases, typically when the member reaches state pension eligibility age (age 65) or upon earlier death.']
  commutation_amount decimal(18,2) [note: 'The lump-sum transfer value amount elected by the member for commutation of a portion of their defined benefit pension entitlement.']
  commutation_elected boolean [note: 'Indicates whether the member elected to commute a portion of their pension to a lump-sum transfer value, reducing the ongoing annuity amount.']
  created_timestamp timestamp [note: 'Date and time when this retirement election record was first created in the system of record.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this retirement election record (e.g., USD, GBP).']
  disability_certification_date date [note: 'The date on which the member\'s disability was formally certified by a qualified medical authority, required for disability retirement type elections.']
  early_retirement_reduction_rate decimal(7,4) [note: 'The actuarial reduction rate applied per year of early retirement before the normal retirement age, expressed as a decimal (e.g., 0.0300 for 3% per year).']
  effective_retirement_date date [note: 'The date on which the member\'s active service ends and pension drawdown commences. Used as the anchor date for actuarial liability calculations and first payment determination.']
  election_channel varchar [note: 'The channel through which the member submitted the retirement election: online member portal, paper form, in-person at a service centre, or telephone.']
  election_form_version varchar [note: 'Version identifier of the retirement election form used by the member, ensuring the correct plan rules and options were presented at the time of election.']
  election_received_date date [note: 'The date the pension administrator physically or electronically received the completed retirement election form from the member.']
  election_reference_number varchar [note: 'Externally-known unique business reference number assigned to this retirement election, used in member correspondence and administrative processing.']
  election_status varchar [note: 'Current workflow lifecycle state of the retirement election from initial submission through administrative approval or rejection.']
  election_submitted_timestamp timestamp [note: 'Date and time when the member formally submitted the retirement election to the pension administrator. Principal business event timestamp for this transaction.']
  first_payment_date date [note: 'The scheduled date of the first pension benefit payment to the member following retirement election approval.']
  gross_annual_pension decimal(18,2) [note: 'The calculated gross annual pension benefit payable to the member before any reductions, indexation, or survivor benefit adjustments.']
  guaranteed_period_years varchar [note: 'Number of years for which pension payments are guaranteed regardless of the member\'s death, applicable when the guaranteed period pension option is elected (e.g., 5, 10, 15 years).']
  indexation_type varchar [note: 'The type of cost-of-living indexation applied to the pension: full CPI, partial CPI, fixed rate, or none. Determines how the pension is adjusted annually for inflation.']
  is_irrevocable boolean [note: 'Indicates whether the retirement election has been finalized and is irrevocable. Once set to true, the pension option and retirement date cannot be changed.']
  last_updated_timestamp timestamp [note: 'Date and time when this retirement election record was most recently modified, supporting audit trail and change tracking requirements.']
  member_age_at_retirement varchar [note: 'The member\'s age in whole years as of the effective retirement date. Used for actuarial factor selection and early retirement penalty determination.']
  member_consent_obtained boolean [note: 'Indicates whether the member provided informed consent to the pension option elected, including acknowledgement of irrevocability and survivor benefit implications.']
  member_date_of_birth date [note: 'The member\'s date of birth, required for actuarial age verification, normal retirement age eligibility determination, and benefit calculation.']
  payment_frequency varchar [note: 'The frequency at which pension benefit payments are disbursed to the member (typically monthly for defined benefit pension plans).']
  payment_method varchar [note: 'The method by which pension benefit payments are disbursed to the member: direct deposit (EFT), cheque, or wire transfer.']
  pensionable_service_years decimal(6,4) [note: 'Total years of pensionable service credited to the member at the time of retirement election, including any purchased or transferred service. Core input to benefit formula.']
  reduced_annual_pension decimal(18,2) [note: 'The annual pension amount after applying any early retirement actuarial reduction factors or pension option reduction for survivor benefits.']
  rejection_reason varchar [note: 'The reason code or description explaining why a retirement election was rejected, required for member communication and resubmission guidance.']
  retirement_type varchar [note: 'Classification of the retirement basis: normal age retirement, early retirement, deferred retirement, disability retirement, or involuntary separation. Drives entitlement calculation rules.']
  spousal_consent_obtained boolean [note: 'Indicates whether spousal or common-law partner consent was obtained for the pension option elected, as required by pension legislation when waiving survivor benefits.']
  survivor_benefit_percentage decimal(5,2) [note: 'The percentage of the member\'s pension payable to the designated survivor upon the member\'s death, as elected under the joint and survivor or guaranteed period option (e.g., 50%, 60%, 66.67%).']
  survivor_date_of_birth date [note: 'Date of birth of the designated survivor, required for actuarial reduction factor calculation when a joint and survivor pension option is elected.']
  survivor_relationship varchar [note: 'The legal relationship of the designated survivor to the retiring member, determining eligibility for survivor pension benefits under plan rules.']
  tax_withholding_code varchar [note: 'The tax withholding instruction code applied to pension payments, reflecting the member\'s elected withholding rate or exemption status for income tax purposes.']
  transfer_destination varchar [note: 'The registered account or vehicle to which the commuted lump-sum transfer value is directed (e.g., retirement savings account, locked-in account, retirement income fund). Applicable only when commutation is elected.']

  Note: 'Transactional record capturing a member\'s formal election to commence pension drawdown, including retirement date, retirement type (normal, early, deferred, disability), pension option elected (single life, joint and survivor, guaranteed period), survivor'
}

Table beneficiary.indexation_adjustment {
  indexation_adjustment_id varchar [pk, note: 'Unique surrogate identifier for each indexation adjustment record applied to a pension benefit payment. Primary key for this transactional entity.']
  benefit_payment_id varchar [note: 'Reference to the specific pension benefit payment record to which this indexation adjustment is applied. Links to the benefit payment transactional entity.']
  designated_beneficiary_id varchar [note: 'Reference to the pension plan member whose benefit payment is subject to this indexation adjustment. Links to the beneficiary master record.']
  indexation_policy_id varchar [note: 'Foreign key linking to actuarial.indexation_policy. Business justification: Indexation adjustments apply specific indexation policies to adjust pension benefits.']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: Annual pension indexation process requires linking adjustments to the specific CPI/inflation macro indicator used.']
  member_id varchar [note: 'Reference to the pension plan member whose benefit payment is subject to this indexation adjustment. Links to the beneficiary master record.']
  pension_plan_id varchar [note: 'Reference to the pension plan (e.g., one of the participating plans) under which this indexation adjustment is processed.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Indexation adjustments are applied per plan; linking to portfolio ensures correct adjustment application.']
  superseded_by_adjustment_id varchar [note: 'Reference to the replacement indexation adjustment record that supersedes this one in the event of a correction or recalculation. Null if this record is current and active.']
  actuarial_basis_code varchar [note: 'Code identifying the actuarial valuation basis or methodology under which this indexation adjustment was calculated, linking to the applicable actuarial assumptions set. [ENUM-REF-CANDIDATE: promote to reference product]']
  adjusted_benefit_amount decimal(18,2) [note: 'The gross annual or monthly pension benefit amount payable to the beneficiary after this indexation adjustment is applied. Represents the new benefit entitlement post-adjustment.']
  adjustment_amount decimal(18,2) [note: 'The absolute monetary increase (or decrease) in the benefit payment resulting from this indexation adjustment. Equals adjusted_benefit_amount minus prior_benefit_amount.']
  adjustment_reference_number varchar [note: 'Externally-known unique business reference number assigned to this indexation adjustment event, used for audit trails, member communications, and regulatory reporting.']
  adjustment_status varchar [note: 'Current lifecycle state of the indexation adjustment record, tracking workflow from initial calculation through approval, application, and any subsequent reversal.']
  adjustment_year varchar [note: 'The calendar year for which this indexation adjustment is applicable (e.g., 2024). Used for annual reporting, actuarial valuations, and regulatory submissions.']
  announcement_date date [note: 'The date on which the indexation rate for the applicable period was officially announced or published by the plan administrator or governing authority.']
  applied_timestamp timestamp [note: 'The precise date and time at which the indexation adjustment was applied to the beneficiary\'s benefit payment record in the system of record (SimCorp Dimension).']
  approval_date date [note: 'The date on which the indexation adjustment was formally approved by the plan administrator or governing authority prior to application to beneficiary payments.']
  approved_by varchar [note: 'The name or identifier of the plan administrator, governance body, or authorized officer who approved this indexation adjustment for application.']
  benefit_frequency varchar [note: 'The payment frequency of the pension benefit to which this indexation adjustment applies, determining whether the amounts represent monthly, quarterly, or annual figures.']
  cost_centre_code varchar [note: 'The organizational cost centre code to which the incremental pension liability cost from this indexation adjustment is allocated for management accounting and budget reporting.']
  cpi_measure_used varchar [note: 'The specific Consumer Price Index (CPI) measure used to derive the indexation rate, as defined in the plan rules (e.g., All-Items CPI, Core CPI). Determines the inflation benchmark.']
  created_timestamp timestamp [note: 'The date and time when this indexation adjustment record was first created in the system, supporting audit trail and data lineage requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the benefit amounts are denominated (e.g., USD for US Dollar). Supports multi-currency beneficiary scenarios.']
  effective_date date [note: 'The date on which the indexation adjustment takes effect and the adjusted benefit amount becomes payable to the beneficiary. Typically January 1 of the adjustment year.']
  gl_account_code varchar [note: 'The General Ledger (GL) account code in Oracle Financials to which the incremental benefit cost from this indexation adjustment is posted for corporate accounting and financial reporting.']
  indexation_cap_rate decimal(10,6) [note: 'The maximum indexation rate permitted under the plan rules for this adjustment cycle, expressed as a decimal. Constrains the applied rate when CPI exceeds the plan-defined ceiling.']
  indexation_floor_rate decimal(10,6) [note: 'The minimum indexation rate permitted under the plan rules for this adjustment cycle, expressed as a decimal. Protects beneficiaries from negative adjustments in deflationary periods.']
  indexation_rate decimal(10,6) [note: 'The annual cost-of-living indexation rate applied to the benefit payment, expressed as a decimal (e.g., 0.032100 for 3.21%). Typically derived from the applicable CPI measure per plan rules.']
  indexation_type varchar [note: 'Classification of the indexation mechanism applied, indicating whether the adjustment is fully CPI-linked, partially CPI-linked, a fixed rate, an ad hoc adjustment, or nil.']
  is_rate_capped boolean [note: 'Indicates whether the applied indexation rate was constrained by the plan-defined cap (True) or reflects the full CPI-derived rate (False). Supports actuarial and regulatory analysis.']
  is_rate_floored boolean [note: 'Indicates whether the applied indexation rate was constrained by the plan-defined floor (True) or reflects the full CPI-derived rate (False). Supports actuarial and regulatory analysis.']
  last_updated_timestamp timestamp [note: 'The date and time when this indexation adjustment record was most recently modified, supporting audit trail and change management requirements.']
  liability_impact_amount decimal(18,2) [note: 'The estimated change in the present value of the defined benefit obligation (DBO) attributable to this indexation adjustment, used for actuarial liability matching and ALM reporting.']
  notes varchar [note: 'Free-text field for additional commentary, exceptions, or contextual information related to this indexation adjustment, recorded by the plan administrator or actuary.']
  notification_date date [note: 'The date on which the beneficiary was formally notified of this indexation adjustment. Null if notification has not yet been sent.']
  notification_sent boolean [note: 'Indicates whether a formal notification of this indexation adjustment has been sent to the beneficiary (True) or is pending (False). Supports member communication compliance.']
  plan_type varchar [note: 'The contributor pool or pension plan type to which the beneficiary belongs, identifying the applicable indexation rules and CPI linkage formula for the adjustment.']
  prior_benefit_amount decimal(18,2) [note: 'The gross annual or monthly pension benefit amount payable to the beneficiary immediately before this indexation adjustment is applied. Denominated in the plan\'s base currency.']
  prior_cpi_value decimal(12,4) [note: 'The CPI index value from the prior reference period used as the base for computing the year-over-year indexation rate. Enables rate derivation validation.']
  reference_cpi_period_end date [note: 'The end date of the CPI measurement period used to calculate the indexation rate, as specified in the plan rules (e.g., September of the current year).']
  reference_cpi_period_start date [note: 'The start date of the CPI measurement period used to calculate the indexation rate, as specified in the plan rules (e.g., October of the prior year).']
  reference_cpi_value decimal(12,4) [note: 'The actual CPI index value for the reference period used to compute the indexation rate. Provides the inflation input for audit and actuarial validation purposes.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this indexation adjustment record is required to be included in regulatory submissions to the national pension regulator or other applicable pension regulators (True) or is excluded (False).']
  reversal_date date [note: 'The date on which this indexation adjustment was reversed or cancelled, if applicable. Null for adjustments that have not been reversed.']
  reversal_reason varchar [note: 'Free-text description of the reason for reversing or cancelling this indexation adjustment, populated only when adjustment_status is \'reversed\' or \'cancelled\'. Supports audit and compliance.']
  source_system_code varchar [note: 'Identifies the operational system of record from which this indexation adjustment record originated (e.g., SimCorp Dimension, State Street Administration Platform, Oracle Financials, or manual entry).']
  source_system_reference_code varchar [note: 'The native identifier of this indexation adjustment record in the originating source system (e.g., SimCorp Dimension transaction ID), enabling lineage tracing and reconciliation.']

  Note: 'Transactional record of annual cost-of-living indexation adjustments applied to pension benefit payments. Captures the indexation rate applied (typically CPI-linked per plan rules), effective date, prior benefit amount, adjusted benefit amount, and the'
}

Table beneficiary.survivor_benefit {
  survivor_benefit_id varchar [pk, note: 'Unique system-generated identifier for the survivor benefit record. Primary key for this entity.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Survivor benefits are governed by contributor pool rules. Normalizing the STRING field to FK.']
  designated_beneficiary_id varchar [note: 'Reference to the surviving beneficiary (spouse, dependent, or child) who is entitled to receive this benefit.']
  member_id varchar [note: 'Reference to the deceased plan member or retiree whose death triggered this survivor benefit entitlement.']
  pension_plan_id varchar [note: 'Foreign key linking to beneficiary.pension_plan. Business justification: Survivor benefits are established under a specific pension plan with its own rules. Adding plan_id FK links the benefit to its governing plan.']
  survivor_designated_beneficiary_id varchar [note: 'Reference to the surviving beneficiary (spouse, dependent, or child) who is entitled to receive this benefit.']
  actuarial_present_value decimal(22,4) [note: 'Actuarially calculated present value of the total projected survivor benefit obligation, used for LDI, ALM, and IFRS IAS 19 defined benefit liability reporting.']
  approval_date date [note: 'Date on which the survivor benefit was formally approved by the pension administration team or Investment Committee governance process.']
  approved_by varchar [note: 'Name or identifier of the pension administrator or governance authority who approved the survivor benefit entitlement.']
  bank_account_reference varchar [note: 'Masked or tokenized reference to the survivor\'s bank account used for direct deposit payments. Full account details held in the secure payment system (State Street/Northern Trust).']
  benefit_commencement_date date [note: 'The date on which the survivor benefit payments commence. Marks the effective start of the benefit obligation for actuarial and liability-matching purposes.']
  benefit_fraction decimal(6,4) [note: 'The fraction of the member\'s pension entitlement payable to the survivor (e.g., 0.60 for 60% survivor pension). Defined by plan rules and LPA terms.']
  benefit_reference_number varchar [note: 'Externally-known unique alphanumeric reference number assigned to this survivor benefit record, used in member correspondence and regulatory reporting.']
  benefit_status varchar [note: 'Current lifecycle status of the survivor benefit: pending (awaiting approval), active (in payment), suspended, terminated, or expired.']
  benefit_termination_date date [note: 'The date on which the survivor benefit ceases (e.g., upon remarriage, death of survivor, or age-out of children\'s benefit). Null if benefit is open-ended.']
  benefit_type varchar [note: 'Classification of the survivor benefit: survivor pension (ongoing annuity to spouse), death-in-service lump sum, children\'s benefit, dependent pension, or continuation pension.']
  children_benefit_age_limit varchar [note: 'Maximum age (in years) up to which a dependent child is eligible to receive the children\'s benefit. Typically 18 or 25 if in full-time education. Null for non-children benefit types.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the survivor benefit is denominated and paid (e.g., GBP, USD).']
  death_cause_category varchar [note: 'Broad categorization of the cause of death, which may affect benefit type, amount, or eligibility (e.g., service-related death may trigger enhanced lump sum for some member categories).']
  death_certificate_reference varchar [note: 'Reference number of the official death certificate submitted to substantiate the survivor benefit claim. Required for KYC/AML compliance and benefit eligibility verification.']
  discount_rate decimal(8,6) [note: 'The discount rate (expressed as a decimal) used in the actuarial present value calculation of the survivor benefit obligation, per IAS 19 high-quality corporate bond yield methodology.']
  gross_annual_benefit_amount decimal(18,4) [note: 'The gross annual survivor pension or benefit amount payable before any deductions, expressed in the plan\'s base currency. Core financial obligation for LDI and ALM.']
  guarantee_period_months varchar [note: 'Number of months for which the survivor benefit is guaranteed to be paid regardless of the survivor\'s death. Relevant for actuarial valuation of minimum payment obligations.']
  indexation_rate decimal(8,6) [note: 'Annual indexation rate applied to the survivor benefit where a fixed rate applies (expressed as a decimal, e.g., 0.02 for 2%). Null if CPI-linked or no indexation.']
  indexation_type varchar [note: 'Type of cost-of-living indexation applied to the survivor benefit: full CPI, partial CPI, fixed annual rate, or none. Critical for actuarial liability projection.']
  is_disabled_dependent boolean [note: 'Indicates whether the surviving beneficiary qualifies as a disabled dependent, which may result in lifetime benefit eligibility regardless of age limits.']
  is_full_time_student boolean [note: 'Indicates whether the surviving dependent child is enrolled as a full-time student, which may extend the children\'s benefit eligibility beyond the standard age limit.']
  kyc_verification_date date [note: 'Date on which the KYC identity verification for the surviving beneficiary was completed and confirmed.']
  kyc_verified boolean [note: 'Indicates whether the surviving beneficiary has completed the required KYC identity verification process prior to benefit payment commencement.']
  last_payment_date date [note: 'Date of the most recent survivor benefit payment made to the beneficiary. Used for payment reconciliation and cash management monitoring.']
  lump_sum_amount decimal(18,4) [note: 'One-time lump sum death-in-service payment amount, if applicable. Null for ongoing pension-type benefits. Relevant for death-in-service and certain service-related benefit types.']
  member_death_date date [note: 'The date of death of the plan member or retiree that triggered the survivor benefit entitlement. Principal business event date for this record.']
  net_annual_benefit_amount decimal(18,4) [note: 'The net annual survivor benefit amount payable after applicable deductions (e.g., tax withholding, offsets). Used for cash flow planning and beneficiary payment processing.']
  next_payment_date date [note: 'Date of the next scheduled survivor benefit payment. Used for liquidity planning, cash management, and treasury forecasting.']
  notes varchar [note: 'Free-text administrative notes recorded by pension administrators regarding special circumstances, exceptions, or case-specific details for this survivor benefit.']
  payment_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the country to which survivor benefit payments are remitted. Relevant for FX hedging, withholding tax, and cross-border regulatory compliance.']
  payment_frequency varchar [note: 'Frequency at which the survivor benefit is paid to the beneficiary: monthly, quarterly, semi-annual, annual, or one-time (for lump sum).']
  payment_method varchar [note: 'Method by which the survivor benefit is disbursed to the beneficiary: direct deposit (EFT), cheque, or wire transfer. Drives treasury and cash management operations.']
  plan_document_reference varchar [note: 'Reference to the governing pension plan document, LPA, or trust deed that defines the survivor benefit rules applicable to this record.']
  record_created_timestamp timestamp [note: 'Timestamp when this survivor benefit record was first created in the data platform. Audit trail for data lineage and regulatory compliance.']
  record_updated_timestamp timestamp [note: 'Timestamp when this survivor benefit record was most recently modified in the data platform. Supports audit trail, change tracking, and data quality monitoring.']
  remarriage_termination_flag boolean [note: 'Indicates whether the survivor benefit is subject to termination upon the surviving spouse\'s remarriage, as defined by the applicable plan rules.']
  source_system_code varchar [note: 'Identifier of this survivor benefit record in the originating pension administration system (e.g., SimCorp Dimension or State Street fund administration platform).']
  survivor_date_of_birth date [note: 'Date of birth of the surviving beneficiary. Used for actuarial life expectancy calculations, benefit duration estimation, and children\'s benefit age-out determination.']
  survivor_full_name varchar [note: 'Full legal name of the surviving beneficiary as recorded on official documentation. Used for payment processing, correspondence, and regulatory reporting.']
  survivor_national_identifier varchar [note: 'Government-issued national identification number (e.g., SSN in the US, NI number in the UK) of the surviving beneficiary. Required for tax reporting and KYC compliance.']
  survivor_relationship_type varchar [note: 'The legal relationship of the surviving beneficiary to the deceased member: spouse, common-law partner, dependent child, disabled dependent, or other dependent. Determines eligibility rules.']
  tax_withholding_rate decimal(6,4) [note: 'Applicable income tax withholding rate applied to the survivor benefit payments (expressed as a decimal). Determined by jurisdiction and survivor\'s tax elections.']
  total_paid_to_date decimal(22,4) [note: 'Cumulative gross amount of survivor benefit payments disbursed to the beneficiary from commencement to the most recent payment date. Used for liability tracking and audit.']
  valuation_date date [note: 'The date as of which the actuarial present value of the survivor benefit was last calculated. Required for IFRS IAS 19 and regulatory actuarial reporting.']

  Note: 'Master record of survivor pension benefits established upon the death of a plan member or retiree. Stores the surviving beneficiary identity, survivor benefit type (survivor pension, death-in-service lump sum, children\'s benefit), benefit amount'
}

Table beneficiary.member_statement {
  member_statement_id varchar [pk, note: 'Unique surrogate identifier for each pension member statement record in the Silver layer lakehouse.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Member statements are issued per contributor pool. Normalizing STRING to FK.']
  member_id varchar [note: 'Reference to the pension plan member for whom this statement is issued. Links to the beneficiary master record.']
  pension_plan_id varchar [note: 'Reference to the pension plan (e.g., one of the participating plans) under which this statement is generated.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Statements are generated per plan; linking to portfolio ensures accurate portfolio-level statement generation.']
  accrual_rate decimal(8,6) [note: 'The annual benefit accrual rate applied to the member\'s pensionable salary per year of service (e.g., 0.020000 = 2% per year of service).']
  accrued_pension_annual_amount decimal(18,2) [note: 'The annual pension entitlement accrued by the member as at the statement period end date, expressed in the plan currency.']
  acknowledgement_date date [note: 'The date on which the member formally acknowledged receipt of this pension statement, if applicable.']
  actuarial_valuation_date date [note: 'The reference date of the actuarial valuation used to derive projected pension amounts and transfer values on this statement.']
  benefit_formula_type varchar [note: 'The type of pension benefit formula applicable to this member\'s plan, determining how the accrued entitlement is calculated.']
  best_average_salary decimal(18,2) [note: 'The highest average pensionable salary over the qualifying period (typically best 5 consecutive years) used in the defined benefit pension formula.']
  buyback_service_years decimal(6,4) [note: 'Total years of prior service purchased (bought back) by the member to increase pensionable service, as at the statement period end date.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts on this statement are denominated (e.g., USD, GBP).']
  date_of_birth date [note: 'Date of birth of the pension plan member, used for actuarial calculations, normal retirement age determination, and benefit projections.']
  delivery_channel varchar [note: 'The channel through which this pension statement was delivered to the member (e.g., postal mail, secure member portal, email).']
  delivery_date date [note: 'The date on which the pension statement was successfully delivered to the member via the designated delivery channel.']
  disability_benefit_eligible boolean [note: 'Indicates whether the member is eligible for disability pension benefits under the applicable plan rules at the time of statement generation.']
  discount_rate decimal(8,6) [note: 'The actuarial discount rate applied in the present value calculation of projected pension benefits and transfer value on this statement.']
  early_retirement_eligible_date date [note: 'The earliest date on which the member becomes eligible for unreduced early retirement benefits under the plan rules.']
  employer_contributions_cumulative decimal(18,2) [note: 'Total cumulative employer pension contributions credited on behalf of the member since plan entry date.']
  employer_contributions_ytd decimal(18,2) [note: 'Total employer pension contributions credited on behalf of the member during the current statement period.']
  generated_timestamp timestamp [note: 'The exact date and time when this statement record was first created in the system, serving as the audit creation timestamp.']
  indexation_rate decimal(8,6) [note: 'The annual cost-of-living adjustment (COLA) or indexation rate applied to the member\'s pension entitlement for the statement period.']
  issue_date date [note: 'The date on which the pension statement was formally issued and made available to the member.']
  last_updated_timestamp timestamp [note: 'The date and time when this statement record was most recently modified, supporting audit trail and change tracking.']
  leave_without_pay_service_years decimal(6,4) [note: 'Total years of leave without pay periods that are excluded from or included in pensionable service, as determined by plan rules.']
  member_acknowledged boolean [note: 'Indicates whether the member has formally acknowledged receipt of this pension statement via the member portal or written confirmation.']
  member_contributions_cumulative decimal(18,2) [note: 'Total cumulative employee pension contributions made by the member since plan entry date, used for benefit entitlement and transfer value calculations.']
  member_contributions_ytd decimal(18,2) [note: 'Total employee pension contributions made by the member during the current statement period.']
  member_lifecycle_status varchar [note: 'Current status of the member within the pension plan lifecycle at the time of statement generation.']
  normal_retirement_date date [note: 'The projected date at which the member reaches normal retirement age under the applicable plan rules, used for benefit projection calculations.']
  pensionable_salary decimal(18,2) [note: 'The member\'s annual pensionable salary as at the statement period end date, used as the basis for benefit accrual and contribution calculations.']
  pensionable_service_years decimal(6,4) [note: 'Total years of pensionable service accrued by the member as at the statement period end date, expressed as a decimal (e.g., 15.5000 years).']
  pensionable_service_ytd_years decimal(6,4) [note: 'Pensionable service accrued during the current statement period only, used to reconcile annual service increments.']
  period_end_date date [note: 'The last day of the reporting period covered by this pension statement (e.g., December 31 of the statement year).']
  period_start_date date [note: 'The first day of the reporting period covered by this pension statement (e.g., January 1 of the statement year).']
  plan_entry_date date [note: 'The date on which the member first enrolled in the pension plan, used as the anchor for pensionable service calculations.']
  projected_pension_at_nra decimal(18,2) [note: 'Estimated annual pension benefit the member is projected to receive at normal retirement age, based on current service and salary assumptions.']
  regulatory_disclosure_flag boolean [note: 'Indicates whether this statement satisfies a mandatory regulatory disclosure obligation under applicable pension legislation or the national pension regulator guidance.']
  source_system_reference varchar [note: 'The originating system identifier for this statement record (e.g., SimCorp Dimension statement batch reference or State Street administration platform ID).']
  statement_number varchar [note: 'Externally visible unique reference number assigned to this pension statement, used for member correspondence and audit trail.']
  statement_status varchar [note: 'Current lifecycle state of the statement from draft generation through member delivery and acknowledgement.']
  statement_type varchar [note: 'Classifies the nature of the statement issued to the member. [ENUM-REF-CANDIDATE: annual|on_demand|retirement_estimate|termination|death_benefit — promote to reference product]']
  survivor_benefit_eligible boolean [note: 'Indicates whether the member has a designated beneficiary eligible for survivor pension benefits under the plan rules.']
  survivor_pension_annual_amount decimal(18,2) [note: 'The estimated annual survivor pension payable to the designated beneficiary upon the member\'s death, based on accrued entitlement.']
  transfer_value decimal(18,2) [note: 'The commuted or actuarial transfer value of the member\'s accrued pension entitlement as at the statement date, used for portability and termination scenarios.']
  voluntary_additional_contributions_ytd decimal(18,2) [note: 'Total voluntary additional contributions (VACs) made by the member during the statement period to purchase additional pensionable service.']

  Note: 'Transactional record representing the annual or on-demand pension statement issued to a plan member. Captures statement period, total pensionable service to date, projected pension at normal retirement age, accrued entitlement value, total contributions'
}

Table beneficiary.employer_remittance {
  employer_remittance_id varchar [pk, note: 'Unique surrogate identifier for each employer remittance record in the pension fund system. Primary key for the employer_remittance data product.']
  cash_account_id varchar [note: 'Identifier of the employer\'s bank account from which the remittance funds were transferred. Links to the counterparty bank account registry for settlement and KYC/AML compliance.']
  contributor_pool_id varchar [note: 'Identifier of the beneficiary contributor pool (one per participating plan) to which this remittance applies. Links remittance to the correct liability pool.']
  fund_bank_account_id varchar [note: 'Identifier of the pension fund\'s designated bank account into which the remittance was received. Supports cash management, treasury reconciliation, and NAV determination.']
  participating_employer_id varchar [note: 'Identifier of the participating employer (government department, public agencies, other participating employers) submitting the bulk contribution remittance on behalf of their employees.']
  pension_plan_id varchar [note: 'Identifier of the specific pension plan under which this remittance is submitted. Supports multi-plan fund structures covering distinct beneficiary groups.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Remittances are submitted to a specific plan; linking to portfolio enables correct remittance allocation and reconciliation.']
  reversal_reference_employer_remittance_id varchar [note: 'Identifier of the original remittance record that this record reverses or corrects. Populated only for remittance_type = reversal or adjustment. Supports audit trail and double-entry accounting.']
  rule_breach_id varchar [note: 'Foreign key linking to compliance.rule_breach. Business justification: Late or incorrect employer remittances trigger compliance breaches per pension legislation. Funds must track remittance violations for regulatory reporting.']
  adjustment_amount decimal(20,4) [note: 'Net adjustment amount applied to this remittance to correct prior period over- or under-remittances. May be positive (top-up) or negative (credit/refund). Supports reconciliation workflows.']
  approved_by varchar [note: 'Name or identifier of the fund operations staff member who approved the acceptance of this remittance after review. Supports governance and four-eyes control requirements.']
  approved_timestamp timestamp [note: 'Date and time at which the remittance was formally approved and accepted by the pension fund operations team. Marks the transition from under_review to accepted status.']
  arrears_amount decimal(20,4) [note: 'Amount included in this remittance to cover contributions that were due in prior periods but not previously remitted. Supports arrears tracking and actuarial liability reconciliation.']
  bank_reference_number varchar [note: 'Reference number assigned by the employer\'s bank or payment processor for the funds transfer associated with this remittance. Used for bank reconciliation and settlement confirmation.']
  cost_centre_code varchar [note: 'Oracle Financials cost centre code associated with the employer or contributor pool for internal fund accounting and expense allocation purposes.']
  created_timestamp timestamp [note: 'Timestamp when this remittance record was first created in the pension fund data system. Supports audit trail and data lineage requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the remittance amounts (e.g., USD, GBP). Required for multi-currency fund operations and FX hedging reconciliation.']
  days_late varchar [note: 'Number of calendar days by which the remittance submission exceeded the due date. Used to calculate interest on arrears and late penalties per plan rules.']
  due_date date [note: 'Contractual or regulatory deadline by which the employer was required to submit the remittance. Used to calculate late submission penalties and interest charges.']
  employee_contribution_amount decimal(20,4) [note: 'Gross total of all employee (member) contributions included in this remittance batch, in the remittance currency. Represents the aggregate deducted from member salaries for the payroll period.']
  employer_contact_email varchar [note: 'Email address of the employer\'s designated contact for this remittance submission. Used for automated acknowledgement, rejection notices, and reconciliation exception communications.']
  employer_contact_name varchar [note: 'Name of the primary contact person at the employer responsible for submitting and managing this remittance. Used for exception follow-up and operational communications.']
  employer_contribution_amount decimal(20,4) [note: 'Gross total of employer-side contributions included in this remittance batch, in the remittance currency. Represents the employer\'s matching or defined contribution obligation for the payroll period.']
  file_reference_number varchar [note: 'Reference number of the source data file or batch upload submitted by the employer containing the remittance details. Supports data lineage, reprocessing, and dispute resolution.']
  gl_account_code varchar [note: 'Oracle Financials General Ledger account code to which this remittance is posted. Ensures correct accounting treatment of contribution receipts in the fund\'s ABOR (Accounting Book of Record).']
  interest_on_arrears_amount decimal(20,4) [note: 'Interest charges levied on late or arrears contributions included in this remittance. Calculated per plan rules or regulatory prescribed rates on overdue contribution balances.']
  is_late_submission boolean [note: 'Flag indicating whether the remittance was submitted after the regulatory or plan-mandated due date. Triggers late penalty assessment and regulatory reporting obligations.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this remittance record. Tracks changes through the review, acceptance, and reconciliation lifecycle.']
  late_penalty_amount decimal(20,4) [note: 'Monetary penalty assessed against the employer for late submission of the remittance, calculated per plan rules or regulatory prescribed rates. Tracked separately from interest on arrears.']
  member_count varchar [note: 'Number of active plan members (beneficiaries) covered by this remittance batch. Used to validate completeness of the submission against employer headcount records.']
  notes varchar [note: 'Free-text operational notes recorded by fund staff regarding this remittance, such as special handling instructions, employer communications, or exception context not captured in structured fields.']
  payment_method varchar [note: 'Mechanism used by the employer to transfer the remittance funds to the pension fund. Determines settlement timing, reconciliation process, and applicable SSI (Standard Settlement Instructions).']
  payroll_period_end_date date [note: 'End date of the payroll period covered by this remittance. Together with payroll_period_start_date, defines the contribution window for liability matching and actuarial calculations.']
  payroll_period_start_date date [note: 'Start date of the payroll period covered by this remittance. Defines the contribution window for which employee and employer contributions are being remitted.']
  received_timestamp timestamp [note: 'Exact date and time the remittance was received and recorded by the pension fund system. Serves as the principal business event timestamp for audit and SLA tracking.']
  reconciliation_date date [note: 'Date on which the remittance was successfully reconciled against bank receipts and member contribution records. Null if reconciliation is pending or in exception.']
  reconciliation_status varchar [note: 'Status of the cash and contribution reconciliation process for this remittance. Tracks whether the received funds have been matched to the employer\'s submission data and member-level records.']
  rejection_reason_code varchar [note: 'Standardized code indicating the reason for rejection or partial acceptance of the remittance submission. Populated when remittance_status is rejected or partially_accepted.']
  rejection_reason_description varchar [note: 'Free-text description providing additional context for the rejection or exception raised against this remittance. Supports employer communication and dispute resolution workflows.']
  remittance_channel varchar [note: 'Channel through which the employer submitted the remittance data to the fund. Supports operational analytics on submission quality, SLA compliance, and digital adoption tracking.']
  remittance_reference_number varchar [note: 'Externally-known unique reference number assigned to the remittance submission by the employer or payroll system. Used for reconciliation and audit trail across fund and employer records.']
  remittance_status varchar [note: 'Current lifecycle status of the remittance submission. Tracks workflow from initial submission through fund acceptance, rejection, or reversal. [ENUM-REF-CANDIDATE: submitted|under_review|accepted|rejected|partially_accepted|reversed — promote to']
  remittance_type varchar [note: 'Classification of the remittance submission. Regular denotes scheduled payroll-cycle contributions; supplemental covers off-cycle top-ups; adjustment corrects prior submissions; arrears covers late contributions; reversal cancels a prior remittance.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this remittance record originated (e.g., SimCorp Dimension, Oracle Financials, Employer Portal). Supports data lineage and ABOR/IBOR reconciliation.']
  submission_date date [note: 'The date on which the employer formally submitted the remittance to the pension fund. Used to assess timeliness against regulatory and plan deadlines.']
  total_remittance_amount decimal(20,4) [note: 'Net total amount remitted in this submission, equal to the sum of employee contributions, employer contributions, voluntary contributions, arrears, interest on arrears, and adjustments. Primary monetary fact for the transaction.']
  value_date date [note: 'The date on which the remitted funds are credited to the pension fund account and become available for investment. Aligns with settlement conventions (e.g., T+2) and cash management.']
  variance_amount decimal(20,4) [note: 'Difference between the expected contribution amount (per member records) and the actual amount remitted by the employer. Non-zero values trigger exception handling and employer follow-up.']
  voluntary_contribution_amount decimal(20,4) [note: 'Total of any additional voluntary contributions (AVCs) included in this remittance batch beyond mandatory contribution rates. Supports member-level benefit entitlement calculations.']

  Note: 'Transactional record of bulk contribution remittances submitted by participating employers (government departments, public agencies, other participating employers) to the fund on behalf of their employees.'
}

Table beneficiary.participating_employer {
  participating_employer_id varchar [pk, note: 'Unique surrogate identifier for the participating employer record within the pension plan. Primary key for this master party entity.']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Participating employers (government departments, public agencies) are organizational actors.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Participating employers belong to a specific contributor pool (one per participating plan). Normalizing STRING to FK.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: Pension funds must perform KYC due diligence on participating employers per AML/CFT regulations. Employer verification is mandatory before accepting contributions.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Employers operate under jurisdiction-specific pension regulators. Multi-jurisdictional pension funds must track which authority governs each employer for compliance reporting']
  active_member_count varchar [note: 'Current number of active contributing members employed by this employer and enrolled in the pension plan. Used for actuarial liability estimation and contribution forecasting.']
  aml_risk_rating varchar [note: 'AML/CTF risk classification assigned to this employer based on KYC due diligence. Governs enhanced due diligence requirements and monitoring frequency.']
  bank_account_reference varchar [note: 'Masked or tokenized reference to the employer\'s designated bank account used for contribution remittances. Full account details held in the treasury system.']
  benefit_formula_code varchar [note: 'Code referencing the specific benefit accrual formula applicable to members of this employer. Links to the plan rules governing final average earnings, accrual rates, and indexation.']
  bic_code varchar [note: 'ISO 9362 Bank Identifier Code (BIC/SWIFT) of the employer\'s remittance bank. Used for settlement routing and Standard Settlement Instructions (SSI) validation.']
  collective_agreement_reference varchar [note: 'Reference number or identifier of the collective bargaining agreement governing employment terms for this employer\'s pension-eligible members. Impacts benefit entitlements.']
  contribution_remittance_frequency varchar [note: 'Frequency at which this employer remits pension contributions to the fund. Governs cash flow forecasting, reconciliation schedules, and late payment monitoring.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the employer\'s primary operating country. Used for regulatory reporting and cross-border contribution tracking.']
  created_timestamp timestamp [note: 'Timestamp when this participating employer record was first created in the system. Supports audit trail, data lineage, and regulatory record-keeping requirements.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the employer\'s contribution and payroll amounts (e.g., USD, GBP). Supports multi-currency contribution reconciliation.']
  data_sharing_agreement boolean [note: 'Indicates whether a formal data sharing agreement is in place between the pension fund and this employer, governing the exchange of member and payroll data.']
  data_sharing_agreement_date date [note: 'Date on which the current data sharing agreement between the pension fund and this employer was executed. Used for agreement renewal tracking and compliance audits.']
  effective_date date [note: 'Date from which the current participation terms, contribution rates, and plan rules became effective for this employer.']
  employee_contribution_rate decimal(8,6) [note: 'Standard employee contribution rate applicable to members employed by this employer, expressed as a decimal fraction of pensionable earnings. May vary by member tier.']
  employer_code varchar [note: 'Unique alphanumeric code assigned to the participating employer by the pension plan administrator. Used as the primary operational identifier across payroll and contribution systems.']
  employer_contribution_rate decimal(8,6) [note: 'Contractual employer contribution rate expressed as a decimal fraction of pensionable earnings (e.g., 0.095000 = 9.5%). Defined in the plan participation agreement.']
  employer_type varchar [note: 'Classification of the participating employer by organizational category within the pension framework. [ENUM-REF-CANDIDATE: government_department|public_agency|municipal_employer|other_employer|municipal_entity|other —']
  enrollment_date date [note: 'Date on which the employer was formally enrolled as a participating employer in the pension plan. Marks the start of contribution and reporting obligations.']
  esg_policy_compliant boolean [note: 'Indicates whether the employer has acknowledged and complies with the pension fund\'s ESG and responsible investment policy requirements for participating employers.']
  jurisdiction_code varchar [note: 'ISO 3166-2 subdivision code (or 3-letter country code) representing the primary regulatory jurisdiction governing this employer\'s pension obligations.']
  kyc_review_date date [note: 'Date of the most recent KYC/AML review completed for this employer. Drives periodic refresh scheduling per FATF requirements.']
  kyc_verified boolean [note: 'Indicates whether the employer has completed the required KYC/AML verification process. Mandatory for onboarding and ongoing regulatory compliance.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this participating employer record. Used for change tracking, data freshness monitoring, and audit compliance.']
  late_remittance_count varchar [note: 'Cumulative count of late contribution remittances recorded for this employer in the current plan year. Used for SLA monitoring, penalty assessment, and compliance reporting.']
  legal_name varchar [note: 'Full legal registered name of the participating employer organization (e.g., government department, public agency, or other participating employer).']
  lei varchar [note: '20-character ISO 17442 Legal Entity Identifier assigned to the employer for regulatory reporting and counterparty identification purposes.']
  normal_retirement_age varchar [note: 'Standard retirement age applicable to members employed by this employer under the plan rules. Used for actuarial liability projections and LDI/ALM modeling.']
  notes varchar [note: 'Free-text field for plan administrators to record material observations, exceptions, or contextual information about this employer\'s participation that is not captured in structured fields.']
  outstanding_contribution_amount decimal(20,2) [note: 'Total value of pension contributions currently outstanding (unpaid or unreconciled) from this employer. Critical for cash management, actuarial funding, and regulatory compliance.']
  participation_agreement_date date [note: 'Date on which the participation agreement was signed by both the employer and the pension fund. Establishes the legal basis for contribution obligations.']
  participation_agreement_number varchar [note: 'Unique reference number of the formal participation agreement executed between the pension fund and this employer. Governs all rights and obligations of plan participation.']
  participation_status varchar [note: 'Current lifecycle status of the employer\'s participation in the pension plan. Drives contribution processing, reporting obligations, and member enrollment eligibility.']
  payroll_system_code varchar [note: 'Identifier used by the employer\'s payroll system to reference this employer entity. Enables automated reconciliation of contribution remittances from payroll source systems.']
  pensionable_payroll_amount decimal(20,2) [note: 'Total annual pensionable payroll (in plan currency) for this employer as of the most recent reporting period. Basis for contribution rate application and actuarial valuation.']
  plan_type varchar [note: 'Type of pension plan applicable to this employer\'s members. Determines benefit calculation methodology, actuarial assumptions, and LDI/ALM treatment.']
  primary_contact_email varchar [note: 'Official email address of the employer\'s primary pension plan contact. Used for contribution notices, capital call communications, and regulatory correspondence.']
  primary_contact_name varchar [note: 'Full name of the designated primary contact person at the employer responsible for pension plan administration and contribution remittance.']
  primary_contact_phone varchar [note: 'Primary telephone number for the employer\'s pension plan contact. Used for urgent contribution and member enrollment communications.']
  registered_address_line1 varchar [note: 'First line of the employer\'s official registered address. Used for regulatory correspondence, contribution notices, and KYC/AML verification.']
  registered_address_line2 varchar [note: 'Second line of the employer\'s official registered address (suite, floor, unit). Supplements the primary address line for complete postal identification.']
  registered_city varchar [note: 'City of the employer\'s official registered address. Used for geographic segmentation, regulatory reporting, and contribution remittance routing.']
  registered_postal_code varchar [note: 'Postal or ZIP code of the employer\'s official registered address. Required for contribution remittance and regulatory correspondence.']
  remittance_due_day varchar [note: 'Calendar day of the month (1–31) by which contribution remittances must be received from this employer. Used for SLA monitoring and late payment penalty calculations.']
  short_name varchar [note: 'Abbreviated or commonly used operating name of the participating employer, used in reports and system displays where full legal name is impractical.']
  termination_date date [note: 'Date on which the employer\'s participation in the pension plan was formally terminated. Null if participation is still active.']
  vesting_period_years decimal(5,2) [note: 'Minimum years of service required for members of this employer to become fully vested in the pension benefit. Governs entitlement calculations and member lifecycle management.']

  Note: 'Master record of all government departments, public agencies, and other participating employers.'
}

Table beneficiary.benefit_option {
  benefit_option_id varchar [pk, note: 'Unique surrogate identifier for a pension benefit option available to members at retirement. Primary key for the benefit_option reference entity.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Benefit options are defined per contributor pool. The contributor_pool_code STRING should be normalized to a FK.']
  actuarial_basis_code varchar [note: 'Code identifying the actuarial assumptions basis (mortality table, discount rate set, and valuation methodology) used to calculate reduction factors and transfer values for this option (e.g., \'RP2014_SCALE_MP_2021\').']
  actuarial_basis_effective_date date [note: 'Date from which the current actuarial basis (mortality table and assumptions) referenced by actuarial_basis_code became effective for this benefit option. Supports liability valuation versioning.']
  benefit_option_status varchar [note: 'Current lifecycle status of the benefit option. Inactive or deprecated options may still apply to members who elected them historically. Grandfathered options are closed to new elections.']
  bridge_benefit_eligible boolean [note: 'Indicates whether this benefit option includes a bridge benefit component, which supplements pension income until the member reaches the state pension eligibility age.']
  bridge_benefit_end_age decimal(4,1) [note: 'Age at which the bridge benefit component ceases (typically 65, aligned with state pension eligibility). Null if bridge_benefit_eligible is false.']
  commutation_allowed boolean [note: 'Indicates whether a lump-sum commutation (partial or full conversion of the annuity to a present value cash payment) is permitted under this benefit option. Subject to applicable tax law limits.']
  commutation_max_pct decimal(5,4) [note: 'Maximum percentage of the pension\'s actuarial present value that may be commuted to a lump sum under this option (e.g., 0.2500 = 25%). Null if commutation_allowed is false.']
  created_timestamp timestamp [note: 'Timestamp when this benefit option record was first created in the system of record. Supports data lineage, audit trail, and regulatory record-keeping requirements.']
  death_benefit_type varchar [note: 'Type of death benefit payable if the member dies before or after pension commencement under this option. Drives beneficiary designation requirements and actuarial reserve calculations.']
  default_option boolean [note: 'Indicates whether this benefit option is the plan default applied when a member does not make an explicit election within the election window. Typically the joint and survivor annuity for married members.']
  early_retirement_reduction boolean [note: 'Indicates whether an actuarial reduction applies to the pension amount when this option is elected before the member\'s unreduced retirement age. Relevant for early retirement planning analytics.']
  early_retirement_reduction_rate decimal(6,5) [note: 'Annual actuarial reduction rate applied per year of early retirement before the unreduced retirement age (e.g., 0.03000 = 3% per year). Null if early_retirement_reduction is false.']
  effective_date date [note: 'Date from which this benefit option became available for member election within the applicable contributor pool. Used for eligibility determination and actuarial liability calculations.']
  election_irrevocable boolean [note: 'Indicates whether the member\'s election of this benefit option is irrevocable once made. True for most annuity forms post-commencement. Drives member counselling and governance requirements.']
  election_window_days varchar [note: 'Number of days prior to the member\'s retirement date within which this benefit option must be elected. Governs member communication timelines and plan administration workflows.']
  expiry_date date [note: 'Date on which this benefit option was closed to new elections. Null if the option remains open. Supports grandfathering logic and liability-driven investment (LDI) horizon analysis.']
  guaranteed_period_years varchar [note: 'Number of years for which pension payments are guaranteed regardless of the member\'s survival (e.g., 5, 10, 15 years). Applicable only to guaranteed period options. Null for non-guaranteed options.']
  indexation_cap_pct decimal(5,4) [note: 'Maximum annual indexation rate applied to pension payments under this option (e.g., 0.0800 = 8% cap). Null if indexation_type is full_cpi or none. Used in actuarial liability modelling and LDI stress testing.']
  indexation_floor_pct decimal(5,4) [note: 'Minimum annual indexation rate guaranteed under this option (e.g., 0.0000 = no negative indexation). Null if indexation_type is none. Relevant for liability-driven investment (LDI) and actuarial liability matching.']
  indexation_type varchar [note: 'Type of cost-of-living indexation applied to pension payments under this option. Full CPI = 100% of Consumer Price Index; Partial CPI = capped or floored CPI; Fixed Rate = predetermined annual increase; None = flat payment.']
  ldi_liability_category varchar [note: 'Classification of the pension liability stream generated by this benefit option for liability-driven investment (LDI) and asset-liability management (ALM) purposes. Drives duration matching and hedging strategy.']
  max_retirement_age decimal(4,1) [note: 'Maximum age by which a member must commence this benefit option. Typically aligned with tax-law mandatory commencement rules (e.g., a statutory maximum age). Null if no upper bound applies.']
  member_facing_description varchar [note: 'Plain-language description of this benefit option as presented in member communications, pension statements, and retirement counselling materials. Supports member education and disclosure obligations.']
  min_retirement_age decimal(4,1) [note: 'Minimum age at which a member is eligible to elect this benefit option. Varies by contributor pool and option type (e.g., early retirement options may have different thresholds).']
  min_service_years decimal(5,2) [note: 'Minimum years of pensionable service required for a member to be eligible to elect this benefit option. Used in eligibility screening during retirement counselling.']
  option_code varchar [note: 'Externally-known alphanumeric code uniquely identifying the benefit option within the pension plan (e.g., SLA, JSA_50, JSA_100, GP5, BRIDGE). Used in member communications and plan documents.']
  option_name varchar [note: 'Human-readable name of the benefit option as presented to plan members (e.g., \'Single Life Annuity\', \'Joint and Survivor 60% Annuity\', \'Bridge Benefit\', \'Guaranteed Period 10-Year\').']
  option_type varchar [note: 'High-level classification of the benefit option structure. Drives actuarial valuation methodology and member eligibility rules. [ENUM-REF-CANDIDATE: promote to reference product if additional types are added]']
  payment_frequency varchar [note: 'Frequency at which pension payments are disbursed to the member under this option. Monthly is standard for most pension plans.']
  payment_timing varchar [note: 'Indicates whether pension payments under this option are made at the beginning (in advance) or end (in arrears) of each payment period. Affects actuarial present value calculations.']
  pension_adjustment_applicable boolean [note: 'Indicates whether a Pension Adjustment (PA) must be reported on the member\'s annual tax slip slip for years in which this benefit option accrues. Relevant for registered pension plan tax compliance reporting.']
  plan_text_reference varchar [note: 'Reference to the specific section or clause in the pension plan text or legislation that governs this benefit option (e.g., \'a section of the governing plan statute\'). Supports regulatory audit.']
  reduction_factor_pct decimal(7,6) [note: 'Actuarially determined reduction applied to the member\'s base pension amount when electing this option, expressed as a decimal (e.g., 0.050000 = 5% reduction for joint and survivor coverage). Derived from actuarial tables.']
  regulatory_approval_ref varchar [note: 'Reference number or identifier for the regulatory approval or registration of this benefit option with the applicable pension regulator (e.g. registration number). Supports compliance and audit trails.']
  sort_order varchar [note: 'Integer controlling the display sequence of benefit options in member-facing portals, retirement counselling tools, and administrative systems. Lower values appear first.']
  spousal_consent_required boolean [note: 'Indicates whether spousal or common-law partner consent is required for the member to elect this option. Typically required when waiving joint and survivor coverage. Regulatory compliance field.']
  survivor_fraction_pct decimal(5,4) [note: 'For joint and survivor annuity options, the fraction of the member\'s pension payable to the surviving spouse or beneficiary upon the member\'s death (e.g., 0.5000, 0.6000, 0.6667, 1.0000). Null for non-joint options.']
  tax_treatment_code varchar [note: 'Code identifying the income tax treatment applicable to pension payments under this option (e.g., \'REGISTERED_PENSION_PLAN_RPP\', \'retirement_account_transfer\'). Aligns with tax authority reporting requirements.']
  transfer_value_eligible boolean [note: 'Indicates whether a member electing this option is eligible to receive a transfer value (commuted value transferred to a locked-in retirement account) instead of the annuity. Typically available before pension commencement.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this benefit option record. Used for change detection, data synchronisation, and audit trail maintenance across the lakehouse silver layer.']

  Note: 'Reference entity defining the menu of pension benefit options available to members at retirement within each contributor pool: single life annuity, joint and survivor annuity (50%, 60%, 66.67%, 100% survivor fractions), guaranteed period options, bridge'
}

Table beneficiary.overpayment_recovery {
  overpayment_recovery_id varchar [pk, note: 'Unique surrogate identifier for each overpayment recovery record in the pension fund beneficiary domain.']
  benefit_payment_id varchar [note: 'Reference to the original benefit payment transaction that resulted in the overpayment.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Overpayment recovery records have contributor_pool STRING. Recovery rules may vary by pool. Normalizing to FK.']
  designated_beneficiary_id varchar [note: 'Reference to the pension plan member who received the overpayment. Links to the beneficiary master record.']
  member_id varchar [note: 'Reference to the pension plan member who received the overpayment. Links to the beneficiary master record.']
  rule_breach_id varchar [note: 'Foreign key linking to compliance.rule_breach. Business justification: Overpayments often constitute compliance breaches requiring formal tracking. Pension regulators require breach documentation for overpayment incidents.']
  actual_recovery_end_date date [note: 'Date on which the recovery was fully completed or formally closed, whether through full repayment, write-off, or legal settlement.']
  amount_recovered_to_date decimal(18,2) [note: 'Cumulative amount successfully recovered from the beneficiary or their estate as of the most recent update to this record.']
  case_notes varchar [note: 'Free-text notes recorded by the case owner documenting key events, member communications, and decisions throughout the recovery lifecycle.']
  case_owner varchar [note: 'Name or employee identifier of the pension administration officer assigned as the primary owner of this recovery case.']
  created_timestamp timestamp [note: 'Timestamp when this overpayment recovery record was first created in the system, used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts on this overpayment recovery record (e.g., USD, GBP).']
  detection_date date [note: 'Date on which the overpayment was first identified, either through system reconciliation, audit, or member notification.']
  dispute_date date [note: 'Date on which the beneficiary formally raised a dispute against the overpayment recovery claim.']
  dispute_outcome varchar [note: 'Outcome of the formal dispute process, indicating whether the recovery claim was upheld, partially upheld, dismissed, or withdrawn.']
  dispute_raised boolean [note: 'Indicates whether the beneficiary or their estate has formally disputed the overpayment claim or the recovery amount.']
  dispute_resolution_date date [note: 'Date on which the dispute was formally resolved, either in favour of the fund or the beneficiary.']
  estate_claim_reference varchar [note: 'Reference number for the claim filed against the deceased beneficiary\'s estate for recovery of overpaid pension benefits.']
  expected_recovery_end_date date [note: 'Projected date by which the full net recoverable amount is expected to be collected based on the agreed recovery plan.']
  gl_account_code varchar [note: 'Oracle Financials GL account code to which the overpayment recovery transaction is posted for accounting and financial reporting.']
  gross_overpayment_amount decimal(18,2) [note: 'Total gross amount paid to the beneficiary in excess of their entitlement over the overpayment period, before any adjustments or recoveries.']
  hardship_waiver_amount decimal(18,2) [note: 'Amount of the overpayment formally waived due to the beneficiary\'s demonstrated financial hardship, reducing the net recoverable balance.']
  hardship_waiver_granted boolean [note: 'Indicates whether a financial hardship waiver has been granted to the beneficiary, reducing or suspending the recovery obligation.']
  instalment_amount decimal(18,2) [note: 'Periodic instalment amount agreed with the beneficiary for repayment of the overpayment, applicable when recovery method is instalment plan.']
  instalment_frequency varchar [note: 'Frequency at which recovery instalments are scheduled to be deducted or received from the beneficiary.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this overpayment recovery record, supporting audit trail and change tracking requirements.']
  legal_action_date date [note: 'Date on which formal legal proceedings were initiated to recover the outstanding overpayment balance.']
  legal_action_initiated boolean [note: 'Indicates whether formal legal proceedings have been initiated to recover the overpayment from the beneficiary or their estate.']
  member_notification_date date [note: 'Date on which the beneficiary was formally notified of the overpayment and the fund\'s intent to recover the amount.']
  net_recoverable_amount decimal(18,2) [note: 'Net amount the fund is entitled to recover from the beneficiary after tax adjustments, representing the actual recovery target.']
  notification_channel varchar [note: 'Channel through which the overpayment notification was communicated to the beneficiary or their legal representative.']
  outstanding_balance decimal(18,2) [note: 'Remaining amount yet to be recovered, calculated as net recoverable amount minus amount recovered to date.']
  overpayment_cause varchar [note: 'Root cause category explaining why the benefit was paid in excess of entitlement. [ENUM-REF-CANDIDATE: death_notification_delay|calculation_error|eligibility_change|duplicate_payment|rate_error|other — promote to reference product]']
  overpayment_end_date date [note: 'Date on which the overpayment ceased, either because the benefit was corrected, suspended, or the member\'s entitlement was updated.']
  overpayment_start_date date [note: 'Date from which the benefit payments began to exceed the member\'s entitlement, marking the beginning of the overpayment period.']
  overpayment_type varchar [note: 'Classification of the benefit type that was overpaid, distinguishing pension, survivor, disability, or lump-sum payments.']
  recovery_method varchar [note: 'Mechanism by which the overpayment is being recovered, such as deduction from ongoing benefit, lump-sum repayment, or estate claim.']
  recovery_reference_number varchar [note: 'Externally-visible unique reference number assigned to this overpayment recovery case, used in member correspondence and audit trails.']
  recovery_start_date date [note: 'Date on which the recovery process formally commenced, i.e., when the first deduction or repayment was initiated.']
  recovery_status varchar [note: 'Current lifecycle state of the overpayment recovery case. [ENUM-REF-CANDIDATE: identified|notified|in_recovery|disputed|recovered|written_off|suspended — promote to reference product]']
  regulatory_report_date date [note: 'Date on which this overpayment recovery case was reported to the relevant regulatory authority, where reporting is required.']
  regulatory_reporting_required boolean [note: 'Indicates whether this overpayment recovery case must be reported to a regulatory body such as Pension regulator or a local pension regulator.']
  responsible_team varchar [note: 'Internal team or department responsible for managing and progressing this overpayment recovery case.']
  simcorp_case_reference varchar [note: 'Reference identifier for this overpayment recovery case as recorded in SimCorp Dimension ABOR/Investment Accounting module.']
  tax_adjustment_amount decimal(18,2) [note: 'Tax withheld or adjustments applied to the gross overpayment amount, reflecting net recoverable amount after tax treatment.']
  write_off_amount decimal(18,2) [note: 'Portion of the net recoverable amount formally written off as irrecoverable, approved per the fund\'s write-off policy.']
  write_off_date date [note: 'Date on which the write-off of the irrecoverable overpayment amount was formally approved and recorded.']
  write_off_reason varchar [note: 'Reason for writing off the irrecoverable balance, such as deceased with no estate, financial hardship, or statute-barred debt.']

  Note: 'Transactional record tracking instances where benefit payments were made in excess of entitlement (due to death notification delays, calculation errors, or eligibility changes) and the subsequent recovery process.'
}

Table beneficiary.member_document {
  member_document_id varchar [pk, note: 'Unique surrogate identifier for each member document record in the pension file management system. Primary key for the member_document entity.']
  member_id varchar [note: 'Reference to the pension plan member whose file this document belongs to. Links the document to the beneficiary master record.']
  pension_plan_id varchar [note: 'Reference to the pension plan (one per participating plan) under which this document was filed.']
  superseded_by_document_id varchar [note: 'Reference to the newer member_document record that replaces this document when a member submits an updated version (e.g., revised beneficiary designation). Null if not superseded.']
  access_restriction_level varchar [note: 'Operational access control level specifying which staff roles may view or process this document. Enforced by the document management system\'s role-based access control (RBAC) configuration.']
  beneficiary_designation_flag boolean [note: 'Indicates whether this document constitutes or amends a beneficiary designation for death benefit purposes. Triggers update of the beneficiary entitlement record upon acceptance.']
  certified_copy_flag boolean [note: 'Indicates whether the document is a certified true copy authenticated by a notary, commissioner of oaths, or equivalent authority. Relevant for legal admissibility in pension division proceedings.']
  contains_phi_flag boolean [note: 'Indicates whether the document contains protected health information (PHI) such as medical diagnoses or disability assessments. Triggers enhanced access restrictions and audit logging.']
  contains_pii_flag boolean [note: 'Indicates whether the document contains personally identifiable information (PII) subject to privacy legislation. Drives access controls, masking requirements, and breach notification obligations.']
  created_timestamp timestamp [note: 'The timestamp when this member document record was first created in the pension administration system. Serves as the audit trail creation marker per data governance standards.']
  data_classification varchar [note: 'Information security classification of the document content per the fund\'s data governance policy: restricted (PII/PHI), confidential (sensitive business), internal, or public.']
  digital_repository_path varchar [note: 'Logical path or URI to the document\'s digital file in the pension fund\'s secure document management system or content repository. Confidential due to system access sensitivity.']
  disability_certification_type varchar [note: 'For disability-related documents, classifies whether this is an initial certification, a periodic renewal, or a termination of disability status. Not applicable for non-disability documents.']
  document_category varchar [note: 'Broad grouping of the document for records management and retrieval: identity (ID proofs), entitlement (benefit rights), legal_order (court orders), medical (disability/death), financial (contribution/payment), administrative (forms/applications).']
  document_date date [note: 'The official date appearing on the document itself (e.g., date of signing, date of issuance by a court or authority). Distinct from the date the document was received by the fund.']
  document_description varchar [note: 'Free-text narrative describing the content, purpose, or special circumstances of the document, used by pension administrators for context during file review.']
  document_language varchar [note: 'ISO 639-1 or 639-2 language code of the document\'s primary language (e.g., \'en\' for English, \'fr\' for French). Determines translation requirements for multilingual pension administration.']
  document_reference_number varchar [note: 'Externally-known unique alphanumeric reference number assigned to the document upon receipt or generation, used for correspondence and audit trail purposes.']
  document_status varchar [note: 'Current lifecycle state of the document within the pension file workflow: received upon intake, under_review during verification, verified/accepted once validated, rejected if invalid, superseded if replaced, archived for closed files.']
  document_title varchar [note: 'Human-readable title or name of the document as it appears on the physical or digital record (e.g., \'Retirement Application Form – Plan 1\').']
  document_type varchar [note: 'Classification of the document by its business purpose (e.g., enrollment_form, beneficiary_designation, retirement_application, marriage_certificate, divorce_order, disability_certification, death_certificate, power_of_attorney, transfer_request).']
  effective_date date [note: 'The date from which the document\'s instructions or legal effect become operative for pension entitlement purposes (e.g., effective date of a beneficiary designation change or pension division order).']
  expiry_date date [note: 'The date on which the document ceases to be valid or requires renewal (e.g., a temporary disability certification or a power of attorney with a defined term). Null for permanent documents.']
  file_format varchar [note: 'Digital file format of the stored document (e.g., PDF, TIFF, JPEG). Relevant for long-term preservation standards and accessibility compliance in pension records management.']
  file_size_kb varchar [note: 'Size of the digital document file in kilobytes. Used for storage capacity planning and to flag unusually large or small files that may indicate scanning quality issues.']
  issuing_authority varchar [note: 'Name of the government body, court, institution, or organization that issued or certified the document (e.g., \'a family court\', \'the plan administrator\', \'a participating employer\').']
  issuing_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction that issued the document. Required for foreign documents subject to apostille or notarization requirements.']
  issuing_jurisdiction varchar [note: 'Province, state, or sub-national jurisdiction of the issuing authority where applicable (e.g., \'New York\', \'California\'). Relevant for pension division orders and legal documents.']
  last_updated_timestamp timestamp [note: 'The timestamp of the most recent modification to this member document record. Used for change data capture (CDC), audit trails, and data lineage in the Databricks Silver layer.']
  member_notification_date date [note: 'The date on which the member was formally notified of the document processing outcome. Used to measure compliance with regulatory notification timelines.']
  member_notified_flag boolean [note: 'Indicates whether the member has been formally notified of the document\'s acceptance, rejection, or any required follow-up action. Supports SLA compliance and member communication tracking.']
  notarized_flag boolean [note: 'Indicates whether the document has been notarized or certified by a commissioner of oaths. Must be True before processing for document types where requires_notarization is True.']
  original_document_flag boolean [note: 'Indicates whether the document on file is the original (True) or a certified copy, notarized copy, or digital scan (False). Originals may be required for certain legal proceedings.']
  page_count varchar [note: 'Total number of pages in the document. Used for completeness verification during intake — a document with fewer pages than expected may be flagged as incomplete.']
  pension_division_flag boolean [note: 'Indicates whether this document relates to a pension division order (e.g., divorce decree or domestic relations order splitting pension entitlement). Triggers actuarial recalculation workflows.']
  received_date date [note: 'The date on which the pension fund received the document from the member, legal authority, or third party. Used for SLA tracking and regulatory timeliness compliance.']
  rejection_reason varchar [note: 'Standardized reason code or description explaining why a document was rejected (e.g., \'illegible scan\', \'missing signature\', \'expired certification\'). Populated only when document_status is rejected.']
  requires_notarization boolean [note: 'Indicates whether the document type requires notarization or commissioner of oaths certification per plan rules or regulatory requirements before it can be actioned.']
  retention_category varchar [note: 'Records retention classification determining how long the document must be kept per regulatory and plan rules: permanent (e.g., death certificates), long_term (e.g., retirement applications), standard, or short_term.']
  retention_expiry_date date [note: 'The date after which the document may be destroyed or anonymized in accordance with the fund\'s records retention schedule and applicable privacy regulations. Null for permanent records.']
  review_notes varchar [note: 'Free-text notes recorded by the pension administrator during document review, capturing deficiencies, follow-up actions required, or rationale for rejection. Confidential internal record.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this document record was ingested into the Databricks Silver layer (e.g., SimCorp Dimension, eFront, Oracle Financials, member portal).']
  storage_medium varchar [note: 'Indicates whether the document is stored as a physical paper record, a digital file, or both. Drives records management, retention scheduling, and disaster recovery procedures.']
  submission_channel varchar [note: 'The channel through which the member or authorized party submitted the document to the pension fund (e.g., mail, in-person at a service centre, secure member portal, fax).']
  translated_flag boolean [note: 'Indicates whether a certified translation of the document exists on file (True). Required when the original document is in a language other than the plan\'s official administrative languages.']
  verified_date date [note: 'The date on which a pension administrator or authorized officer completed verification and authentication of the document\'s authenticity and completeness.']
  version_number varchar [note: 'Version identifier for the document, incremented when a new version supersedes a prior one (e.g., updated beneficiary designation form). Supports document lineage tracking.']

  Note: 'Master record of official documents associated with a plan member\'s pension file: enrollment forms, beneficiary designation forms, retirement applications, marriage certificates, divorce orders (for pension division), disability certifications, death'
}

Table beneficiary.pension_division_order {
  pension_division_order_id varchar [pk, note: 'Unique surrogate identifier for the pension division order record within the pension fund system.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: Pension division orders apply to benefits under a specific contributor pool. Normalizing STRING to FK.']
  designated_beneficiary_id varchar [note: 'Reference to the pension plan member (contributor) whose pension entitlement is subject to the court-ordered division.']
  member_id varchar [note: 'Reference to the pension plan member (contributor) whose pension entitlement is subject to the court-ordered division.']
  pension_plan_id varchar [note: 'Foreign key linking to beneficiary.pension_plan. Business justification: Pension division orders divide benefits under a specific pension plan. Adding plan_id FK for proper linkage.']
  actuarial_commuted_value decimal(18,4) [note: 'The actuarially determined present value (commuted value) of the pension entitlement subject to division as at the actuarial valuation date.']
  actuarial_report_reference varchar [note: 'Reference number or identifier of the actuarial valuation report supporting the commuted value calculation used in the division order.']
  actuarial_valuation_date date [note: 'The reference date used by the actuary to calculate the commuted value or present value of the pension entitlement subject to division.']
  appeal_flag boolean [note: 'Indicates whether the pension division order is currently under appeal or subject to a legal challenge that may affect its implementation.']
  appeal_resolution_date date [note: 'The date on which any appeal or legal challenge to the pension division order was resolved, enabling final implementation to proceed.']
  court_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the court order was issued, governing applicable family law and pension division legislation.']
  court_name varchar [note: 'Name of the court or tribunal that issued the pension division order (e.g., a family court, Family Division).']
  court_order_date date [note: 'The date on which the court issued the pension division order, representing the principal real-world event date of the legal instrument.']
  created_timestamp timestamp [note: 'The timestamp at which this pension division order record was first created in the data platform, providing the audit trail creation marker.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to the division amount or equalization payment (e.g., USD, GBP).']
  division_amount decimal(18,4) [note: 'The fixed monetary amount of the pension entitlement or equalization payment allocated to the former spouse where a fixed-amount division method is specified.']
  division_method varchar [note: 'The method by which the pension entitlement is divided: percentage of pension credit, fixed monetary amount, actuarial present value, or pension credit split.']
  division_percentage decimal(8,6) [note: 'The percentage of the pension credit or pension benefit allocated to the former spouse under the division order, expressed as a decimal (e.g., 0.500000 = 50%).']
  effective_date date [note: 'The date from which the pension division order takes operational effect on the member\'s pension entitlement and benefit calculations.']
  expiry_date date [note: 'The date on which the pension division order ceases to have effect, if applicable (e.g., upon death of former spouse or full equalization payment).']
  former_spouse_date_of_birth date [note: 'Date of birth of the former spouse, required for actuarial valuation of the divided pension entitlement and survivor benefit calculations.']
  former_spouse_full_name varchar [note: 'Full legal name of the former spouse or domestic partner who is the beneficiary of the pension division order as identified in the court instrument.']
  former_spouse_gender varchar [note: 'Gender of the former spouse as recorded for actuarial mortality table selection and survivor benefit entitlement determination.']
  former_spouse_national_identifier varchar [note: 'Government-issued national identification number (e.g., SSN, NIN) of the former spouse for identity verification and tax reporting purposes.']
  implementation_date date [note: 'The date on which the pension division order was operationally implemented in the pension administration system, adjusting the member\'s benefit entitlement.']
  is_indexation_shared boolean [note: 'Indicates whether the pension indexation (cost-of-living adjustment) applicable to the divided pension benefit is shared with the former spouse.']
  is_survivor_benefit_affected boolean [note: 'Indicates whether the pension division order affects the survivor benefit entitlement of the former spouse under the plan rules.']
  last_updated_timestamp timestamp [note: 'The timestamp at which this pension division order record was most recently modified in the data platform, supporting audit trail and change tracking.']
  legal_counsel_reference varchar [note: 'Reference identifier or name of the legal counsel or law firm representing the pension fund in the division proceedings, for case management purposes.']
  marriage_breakdown_date date [note: 'The date of marriage breakdown or separation as legally established, used to determine the pension credit accrued during the marriage period for division purposes.']
  marriage_date date [note: 'The date of marriage or commencement of domestic partnership, establishing the start of the period over which pension credits are subject to division.']
  order_notes varchar [note: 'Free-text notes capturing special conditions, legal qualifications, or administrative remarks associated with the pension division order.']
  order_reference_number varchar [note: 'Externally assigned court order reference number or file number uniquely identifying the legal instrument governing the pension division.']
  order_status varchar [note: 'Current lifecycle status of the pension division order, tracking progression from receipt through implementation or cancellation.']
  order_type varchar [note: 'Classification of the court-ordered pension division mechanism: equalization payment, pension sharing, deferred division, lump-sum transfer, or annuity split.']
  payment_transfer_date date [note: 'The date on which the equalization payment or lump-sum transfer was executed to the former spouse\'s designated account or retirement savings account/locked-in account.']
  pension_credit_end_date date [note: 'The end date of the pension credit accrual period subject to division, typically aligned with the marriage breakdown date.']
  pension_credit_start_date date [note: 'The start date of the pension credit accrual period subject to division, typically aligned with the marriage date or plan membership commencement.']
  plan_type varchar [note: 'The type of pension plan governing the member\'s entitlement subject to division, determining the applicable actuarial methodology.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which this pension division order record was sourced (e.g., pension administration platform).']
  source_system_record_code varchar [note: 'The native record identifier assigned by the source pension administration system, enabling lineage tracing and reconciliation with the system of record.']
  transfer_account_reference varchar [note: 'Masked or tokenized account reference at the destination financial institution to which the equalization payment or pension credit transfer is directed.']
  transfer_destination_type varchar [note: 'The type of vehicle to which the divided pension entitlement or equalization payment is transferred (e.g., individual retirement account, locked-in account, cash, another pension plan).']
  transfer_institution_name varchar [note: 'Name of the financial institution or pension plan to which the divided entitlement or equalization payment is transferred on behalf of the former spouse.']
  withholding_tax_amount decimal(18,4) [note: 'The amount of income tax withheld at source on the equalization payment or lump-sum transfer as required by applicable tax legislation.']

  Note: 'Transactional record of court-ordered pension division upon marriage breakdown, capturing the division order type (equalization payment, pension sharing, deferred division), effective date, division percentage or amount, former spouse identity, actuarial'
}

Table beneficiary.pension_plan {
  pension_plan_id varchar [pk, note: 'Primary key for pension_plan']
  accrual_rate_pct decimal(5,4) [note: 'Annual rate at which pension benefits accrue per year of credited service for defined benefit plans.']
  actuarial_valuation_frequency varchar [note: 'How often the plan undergoes formal actuarial valuation for funding assessment.']
  benefit_formula_type varchar [note: 'Method used to calculate pension benefits based on salary and service history.']
  cola_cap_pct decimal(5,4) [note: 'Maximum annual percentage increase allowed for cost of living adjustments.']
  cost_of_living_adjustment_type varchar [note: 'Method for adjusting pension benefits to account for inflation post-retirement.']
  created_timestamp timestamp [note: 'Timestamp when the pension plan record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the plans base reporting currency.']
  custodian_name varchar [note: 'Name of the financial institution providing custody services for plan assets.']
  disability_benefit_eligible boolean [note: 'Indicates whether the plan provides disability pension benefits to eligible members.']
  early_retirement_age varchar [note: 'Minimum age at which members may elect early retirement with reduced benefits.']
  effective_date date [note: 'Date when the pension plan became legally effective and binding for participants.']
  employee_contribution_rate_pct decimal(5,4) [note: 'Standard percentage of salary that employees contribute to the pension plan.']
  employer_contribution_rate_pct decimal(5,4) [note: 'Standard percentage of salary that the employer contributes to the pension plan.']
  esg_integration_level varchar [note: 'Degree to which ESG factors are incorporated into investment decision-making.']
  funding_policy varchar [note: 'Approach used to fund pension liabilities and maintain plan solvency.']
  investment_strategy varchar [note: 'Overall investment approach governing asset allocation for the pension fund.']
  jurisdiction_country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the legal jurisdiction governing the plan.']
  last_actuarial_valuation_date date [note: 'Date of the most recent completed actuarial valuation of the pension plan.']
  lump_sum_option_available boolean [note: 'Indicates whether members can elect a lump sum payment instead of annuity at retirement.']
  maximum_pensionable_earnings decimal(18,2) [note: 'Annual earnings cap above which contributions and benefits do not accrue.']
  maximum_service_years varchar [note: 'Maximum years of service that can be credited toward pension benefit calculation.']
  minimum_service_years varchar [note: 'Minimum years of credited service required to qualify for pension benefits.']
  modified_timestamp timestamp [note: 'Timestamp when the pension plan record was last updated in the system.']
  next_actuarial_valuation_date date [note: 'Scheduled date for the next actuarial valuation of the pension plan.']
  normal_retirement_age varchar [note: 'Standard age at which members can retire with full unreduced benefits under the plan.']
  pension_plan_description varchar [note: 'Detailed narrative description of the pension plan terms, features, and provisions.']
  pension_plan_name varchar [note: 'Official registered name of the pension plan as filed with regulatory authorities.']
  pension_plan_status varchar [note: 'Current lifecycle status of the pension plan indicating operational state.']
  pension_plan_type varchar [note: 'Classification of the pension plan structure determining benefit calculation methodology.']
  plan_administrator_name varchar [note: 'Name of the organization or individual responsible for plan administration.']
  plan_code varchar [note: 'External business identifier code for the pension plan used in regulatory filings and member communications.']
  portability_allowed boolean [note: 'Indicates whether members can transfer accrued benefits to another pension plan.']
  record_keeper_name varchar [note: 'Name of the service provider maintaining participant records and account balances.']
  registration_number varchar [note: 'Official registration number assigned by the pension regulatory authority.']
  salary_averaging_period_years varchar [note: 'Number of years used to calculate average salary for benefit determination.']
  sponsor_type varchar [note: 'Category of employer or organization sponsoring the pension plan.']
  survivor_benefit_pct decimal(5,4) [note: 'Percentage of pension benefit payable to surviving spouse or beneficiary.']
  target_funding_ratio_pct decimal(5,4) [note: 'Target ratio of plan assets to liabilities as defined by funding policy.']
  termination_date date [note: 'Date when the pension plan was or will be terminated. Null for active open-ended plans.']
  total_active_members varchar [note: 'Current count of active contributing members enrolled in the pension plan.']
  total_deferred_members varchar [note: 'Count of members with deferred benefits who are no longer actively contributing.']
  total_pensioners varchar [note: 'Count of retired members currently receiving pension benefit payments.']
  trustee_name varchar [note: 'Name of the trustee or trust company holding plan assets in fiduciary capacity.']
  vesting_period_months varchar [note: 'Number of months of service required for members to become fully vested in employer contributions.']

  Note: 'Master reference table for pension_plan. Referenced by plan_id.'
}

Table portfolio.portfolio {
  portfolio_id varchar [pk, note: 'Unique identifier for the investment portfolio. Primary key for the portfolio entity in the Investment Book of Record (IBOR).']
  actuarial_valuation_id varchar [note: 'Foreign key linking to actuarial.actuarial_valuation. Business justification: Portfolio reports are compared to actuarial valuations; FK supports generation of regulatory reports.']
  alm_model_id varchar [note: 'Foreign key linking to actuarial.alm_model. Business justification: Portfolio selects an ALM model for asset‑liability matching; ALM model selection is a formal business decision documented in the portfolio policy.']
  asset_class_outlook_id varchar [note: 'Foreign key linking to research.asset_class_outlook. Business justification: Portfolio asset allocation decisions reference asset class outlooks for expected returns.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Portfolio uses a specific assumption set for valuation and risk‑analysis; assumption set selection is a named process in the ALM framework.']
  capital_market_assumption_id varchar [note: 'Foreign key linking to research.capital_market_assumption. Business justification: Portfolio valuation uses capital market assumptions for discount rates and risk premiums.']
  composite_id varchar [note: 'Reference to the GIPS composite that this portfolio belongs to for aggregated performance reporting.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Portfolio geographic allocation decisions reference country outlooks for risk assessment.']
  created_by_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Audit trail requires linking portfolio creator to the actor who performed the action.']
  created_by_user_employee_id varchar [note: 'User identifier of the person who created this portfolio record in the system.']
  custodian_id varchar [note: 'Reference to the external custodian bank (State Street, Northern Trust) responsible for safekeeping portfolio assets.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Portfolio strategy documents reference a macroeconomic scenario for scenario analysis.']
  employee_id varchar [note: 'User identifier of the person who last modified this portfolio record.']
  equity_benchmark_id varchar [note: 'Reference to the primary benchmark index used for performance comparison and tracking error measurement.']
  gp_profile_id varchar [note: 'Reference to the internal portfolio manager or investment team responsible for managing this portfolio.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: Portfolio may adopt an LDI strategy for hedging; FK links portfolio to the strategy used.']
  legal_entity_id varchar [note: 'Reference to the legal entity that owns or sponsors this portfolio. Used for regulatory reporting and legal documentation.']
  macro_model_run_id varchar [note: 'Foreign key linking to research.macro_model_run. Business justification: Portfolio risk assessment uses macro model run projections to set target returns.']
  manager_employee_id varchar [note: 'Reference to the internal portfolio manager or investment team responsible for managing this portfolio.']
  modified_by_user_employee_id varchar [note: 'User identifier of the person who last modified this portfolio record.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Portfolio sector allocation decisions reference sector outlooks for investment guidance.']
  valuation_policy_id varchar [note: 'Foreign key linking to valuation.valuation_policy. Business justification: Valuation governance requires each portfolio to reference its governing valuation policy.']
  accounting_basis varchar [note: 'Accounting standard used for portfolio valuation and financial reporting. International Financial Reporting Standards (IFRS), Generally Accepted Accounting Principles (GAAP), local GAAP, or statutory.']
  asset_class_scope varchar [note: 'Primary asset class or multi-asset scope that defines the investment universe for this portfolio. [ENUM-REF-CANDIDATE: multi_asset|public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|cash — 9 candidates stripped']
  base_currency varchar [note: 'Three-letter ISO 4217 currency code representing the portfolio\'s base reporting currency for valuation and performance measurement.']
  closure_date date [note: 'Date when the portfolio was closed or terminated. Null for active portfolios.']
  created_timestamp timestamp [note: 'Timestamp when this portfolio record was first created in the system. Used for audit trail and data lineage.']
  data_classification varchar [note: 'Data sensitivity classification level for this portfolio record, determining access controls and handling requirements.']
  esg_framework varchar [note: 'Primary ESG framework or standard applied to this portfolio. Principles for Responsible Investment (PRI), Task Force on Climate-related Financial Disclosures (TCFD), Sustainable Finance Disclosure Regulation (SFDR), UN Global Compact (UNGC), Sustainable']
  esg_integration_flag boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) factors are systematically integrated into the investment process for this portfolio.']
  exclusion_list_applied_flag boolean [note: 'Indicates whether an ESG exclusion list (e.g., tobacco, weapons, fossil fuels) is applied to investment decisions for this portfolio.']
  gips_compliant_flag boolean [note: 'Indicates whether the portfolio\'s performance reporting is compliant with Global Investment Performance Standards (GIPS).']
  inception_date date [note: 'Date when the portfolio was established and began accepting investments. Used as the start date for performance measurement.']
  investment_committee_approval_date date [note: 'Date when the Investment Committee formally approved the establishment or material changes to this portfolio.']
  investment_policy_version varchar [note: 'Version number of the Investment Policy Statement governing this portfolio\'s investment guidelines and constraints.']
  last_rebalance_date date [note: 'Date of the most recent portfolio rebalancing event.']
  leverage_limit_percent decimal(8,4) [note: 'Maximum allowable leverage ratio for the portfolio expressed as a percentage. Defines borrowing and derivative exposure constraints.']
  liquidity_requirement_days varchar [note: 'Minimum number of days of liquidity that must be maintained in the portfolio to meet redemption and operational cash needs.']
  mandate_type varchar [note: 'Investment mandate governing the portfolio strategy. Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), Liability-Driven Investment (LDI), or other mandate types.']
  modified_timestamp timestamp [note: 'Timestamp when this portfolio record was last modified. Used for audit trail and change tracking.']
  next_rebalance_date date [note: 'Scheduled date for the next portfolio rebalancing event based on rebalancing frequency.']
  performance_calculation_method varchar [note: 'Method used to calculate portfolio returns. Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), or simple return.']
  portfolio_code varchar [note: 'Externally-known unique business identifier for the portfolio, used across systems and reporting. Typically alphanumeric code assigned at inception.']
  portfolio_description varchar [note: 'Detailed narrative description of the portfolio\'s investment strategy, objectives, and unique characteristics.']
  portfolio_name varchar [note: 'Human-readable name of the investment portfolio, used for display and reporting purposes.']
  portfolio_status varchar [note: 'Current lifecycle status of the portfolio indicating whether it is actively managed, suspended, closed, or in liquidation.']
  portfolio_type varchar [note: 'Classification of the portfolio by its investment mandate and purpose within the fund structure.']
  rebalancing_frequency varchar [note: 'Scheduled frequency at which the portfolio is rebalanced to maintain target asset allocation weights. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|event_driven — 7 candidates stripped; promote to reference product]']
  regulatory_classification varchar [note: 'Regulatory classification of the portfolio under applicable financial regulations. Undertakings for Collective Investment in Transferable Securities (UCITS), Alternative Investment Fund (AIF), pension fund, insurance-linked, sovereign wealth, endowment']
  reporting_frequency varchar [note: 'Frequency at which formal performance and valuation reports are generated for this portfolio.']
  risk_tolerance_level varchar [note: 'Risk appetite classification for the portfolio, defining acceptable volatility and drawdown thresholds.']
  target_return_percent decimal(8,4) [note: 'Target annualized return objective for the portfolio expressed as a percentage. Used for performance evaluation and strategic planning.']
  tax_status varchar [note: 'Tax treatment classification for the portfolio, determining how investment income and gains are taxed.']
  tracking_error_limit_bps varchar [note: 'Maximum allowable tracking error versus the benchmark, expressed in basis points. Used for active risk management.']
  valuation_frequency varchar [note: 'Frequency at which Net Asset Value (NAV) is calculated for the portfolio. Critical for performance measurement and investor reporting.']
  var_limit_percent decimal(8,4) [note: 'Maximum allowable Value at Risk (VaR) for the portfolio expressed as a percentage of Net Asset Value (NAV). Used for risk constraint monitoring.']

  Note: 'Master record for each investment portfolio managed by the fund—the authoritative IBOR/ABOR portfolio entity maintained in SimCorp Dimension. Captures portfolio identity, mandate type (SAA/TAA), asset-class scope, base currency, inception date, regulatory'
}

Table portfolio.hierarchy {
  hierarchy_id varchar [pk, note: 'Unique identifier for the portfolio hierarchy relationship record.']
  child_portfolio_id varchar [note: 'Identifier of the child portfolio node in the hierarchy structure.']
  parent_portfolio_id varchar [note: 'Identifier of the parent portfolio node in the hierarchy structure.']
  portfolio_benchmark_id varchar [note: 'Identifier of the benchmark assigned to measure performance of this hierarchical relationship or child portfolio within the parent context.']
  allocation_method varchar [note: 'Methodology used to determine the allocation weight of the child portfolio within the parent structure.']
  allocation_weight decimal(18,8) [note: 'Proportional weight or percentage of the child portfolio within the parent portfolio, expressed as a decimal where 1.0 equals 100 percent.']
  approval_authority varchar [note: 'Name or role of the individual or committee that approved the establishment or modification of this hierarchical relationship.']
  approval_date date [note: 'Date when the hierarchical relationship was formally approved by the designated authority.']
  consolidation_rule varchar [note: 'Rule governing how the child portfolio positions and performance are consolidated into the parent portfolio for reporting and analytics.']
  constraint_description varchar [note: 'Detailed textual description of specific constraints or restrictions applied to the parent-child portfolio relationship.']
  constraint_type varchar [note: 'Classification of constraints applied to the hierarchical relationship governing allocation limits and investment restrictions.']
  created_timestamp timestamp [note: 'Timestamp when this hierarchy relationship record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the allocation weight and consolidation calculations are denominated.']
  effective_date date [note: 'Date when the hierarchical relationship between parent and child portfolios becomes active and operational.']
  hierarchy_level varchar [note: 'Numeric depth level of the child node within the overall portfolio hierarchy tree structure, with 1 representing the top level.']
  hierarchy_type varchar [note: 'Classification of the hierarchical relationship type between parent and child portfolios.']
  ic_approval_reference varchar [note: 'Reference number or identifier of the Investment Committee decision or memorandum approving this hierarchical structure.']
  is_active boolean [note: 'Boolean indicator of whether this hierarchical relationship is currently active and operational.']
  last_rebalance_date date [note: 'Most recent date when the allocation weight between parent and child portfolios was rebalanced.']
  modified_timestamp timestamp [note: 'Timestamp when this hierarchy relationship record was last modified or updated.']
  next_rebalance_date date [note: 'Scheduled date for the next rebalancing review of the allocation weight between parent and child portfolios.']
  notes varchar [note: 'Free-form text field for additional comments, rationale, or context regarding the hierarchical relationship.']
  path varchar [note: 'Full hierarchical path from root to current node, typically represented as a delimited string of portfolio identifiers for traversal and querying.']
  performance_attribution_flag boolean [note: 'Indicator whether the child portfolio performance should be attributed separately within parent portfolio performance analytics.']
  rebalancing_frequency varchar [note: 'Scheduled frequency at which the allocation weight between parent and child portfolios is reviewed and rebalanced. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|annual|event_driven|none — 7 candidates stripped; promote to reference product]']
  relationship_name varchar [note: 'Business-friendly name describing the nature of the parent-child portfolio relationship.']
  relationship_status varchar [note: 'Current lifecycle state of the parent-child portfolio hierarchical relationship.']
  reporting_inclusion_flag boolean [note: 'Indicator whether the child portfolio should be included in consolidated parent portfolio reporting and performance attribution.']
  saa_target_weight decimal(18,8) [note: 'Long-term strategic target allocation weight for the child portfolio within the parent portfolio structure, expressed as a decimal.']
  sort_order varchar [note: 'Numeric sequence used to control the display order of child portfolios within the same parent for reporting and user interface presentation.']
  source_system_code varchar [note: 'Unique identifier of this hierarchy record in the source operational system for traceability and reconciliation.']
  taa_adjustment decimal(18,8) [note: 'Short-term tactical adjustment to the strategic allocation weight, expressed as a decimal deviation from the SAA target.']
  termination_date date [note: 'Date when the hierarchical relationship between parent and child portfolios ceases to be active, nullable for ongoing relationships.']
  tolerance_band_lower decimal(18,8) [note: 'Lower boundary of the acceptable allocation weight range before rebalancing is triggered, expressed as a decimal.']
  tolerance_band_upper decimal(18,8) [note: 'Upper boundary of the acceptable allocation weight range before rebalancing is triggered, expressed as a decimal.']

  Note: 'Defines the parent-child structure across portfolio nodes, enabling composite/sleeve/sub-portfolio relationships in multi-asset, fund-of-funds, and sleeve-based mandates, plus consolidated reporting.'
}

Table portfolio.portfolio_mandate {
  portfolio_mandate_id varchar [pk, note: 'Unique identifier for the investment mandate governing a portfolio or sleeve.']
  benchmark_index_id varchar [note: 'Reference to the primary benchmark index used to measure mandate performance.']
  custodian_id varchar [note: 'Reference to the custodian bank responsible for safekeeping of mandate assets.']
  employee_id varchar [note: 'Reference to the primary portfolio manager responsible for executing the mandate strategy.']
  exclusion_list_id varchar [note: 'Reference to the ESG exclusion list defining prohibited investments such as tobacco, weapons, or fossil fuels.']
  gp_profile_id varchar [note: 'Reference to the primary portfolio manager responsible for executing the mandate strategy.']
  legal_entity_id varchar [note: 'Reference to the legal entity under which the mandate is established and operated.']
  performance_benchmark_id varchar [note: 'Reference to the primary benchmark index used to measure mandate performance.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Portfolio mandate belongs to a portfolio; linking provides parent‑child relationship and enables navigation from mandate to portfolio.']
  approved_timestamp timestamp [note: 'Timestamp when the mandate was formally approved by the investment committee. Null if pending approval.']
  base_currency varchar [note: 'Primary reporting currency for the mandate using ISO 4217 three-letter currency code.']
  concentration_limit_percent decimal(8,4) [note: 'Maximum percentage of portfolio value that may be invested in a single issuer or security.']
  created_timestamp timestamp [note: 'Timestamp when the mandate record was first created in the system.']
  currency_hedging_policy varchar [note: 'Mandate policy for foreign exchange risk management: fully hedged, partially hedged, unhedged, or dynamic based on market conditions.']
  derivatives_permitted_flag boolean [note: 'Indicates whether the mandate permits the use of derivative instruments for hedging or investment purposes.']
  document_uri varchar [note: 'Reference to the location of the legal mandate document such as investment management agreement or limited partnership agreement.']
  esg_integration_level varchar [note: 'Degree of ESG factor integration in investment decisions: none, basic screening, fully integrated, thematic ESG, or impact investing.']
  fee_structure varchar [note: 'Description of the fee arrangement for the mandate including management fees, performance fees, and hurdle rates.']
  geographic_restrictions varchar [note: 'Geographic constraints on investments, specified as permitted or excluded regions and countries using ISO 3166-1 alpha-3 codes.']
  high_water_mark_flag boolean [note: 'Indicates whether performance fees are subject to a high water mark provision requiring recovery of prior losses.']
  hurdle_rate_percent decimal(8,4) [note: 'Minimum return threshold that must be achieved before performance fees are charged. Null if not applicable.']
  inception_date date [note: 'Date when the mandate became effective and investment activity commenced.']
  investment_committee_code varchar [note: 'Reference to the investment committee responsible for governance and approval of mandate investments.']
  investment_objective varchar [note: 'Primary investment goal of the mandate such as capital preservation, income generation, growth, or total return.']
  last_review_date date [note: 'Date when the mandate was last reviewed by the investment committee or governance body.']
  leverage_permitted_flag boolean [note: 'Indicates whether the mandate permits the use of leverage or borrowing to enhance returns.']
  liquidity_requirement_days varchar [note: 'Minimum number of days within which a specified percentage of the portfolio must be liquidatable to meet cash flow needs.']
  management_fee_bps varchar [note: 'Annual management fee charged on assets under management expressed in basis points.']
  mandate_code varchar [note: 'Externally-known unique business identifier for the mandate, used in operational systems and reporting.']
  mandate_name varchar [note: 'Human-readable name of the investment mandate for business user identification and reporting.']
  mandate_status varchar [note: 'Current lifecycle state of the mandate indicating whether it is operational, suspended, terminated, or awaiting approval.']
  mandate_type varchar [note: 'Classification of the mandate structure: internal discretionary, separately managed account, limited partner mandate, co-investment, fund of funds, or direct investment.']
  max_leverage_ratio decimal(8,4) [note: 'Maximum permitted leverage ratio expressed as total assets divided by net assets. Null if leverage not permitted.']
  min_credit_rating varchar [note: 'Minimum acceptable credit rating for fixed income investments using standard rating agency notation.']
  modified_timestamp timestamp [note: 'Timestamp when the mandate record was last modified in the system.']
  next_review_date date [note: 'Date when the mandate is scheduled for next review by the investment committee or governance body.']
  performance_fee_percent decimal(8,4) [note: 'Performance-based fee as a percentage of returns above the hurdle rate. Null if not applicable.']
  permitted_asset_classes varchar [note: 'Comma-separated list of asset classes allowed under the mandate: public equities, private equity, real estate, infrastructure, natural resources, credit, fixed income.']
  rebalancing_frequency varchar [note: 'Frequency at which the portfolio is rebalanced to maintain target asset allocation. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|event_driven — 7 candidates stripped; promote to reference product]']
  regulatory_classification varchar [note: 'Regulatory classification of the mandate for compliance and reporting purposes such as UCITS, AIFMD, or pension fund mandate.']
  reporting_frequency varchar [note: 'Frequency at which performance reports are generated for the mandate.']
  risk_tolerance varchar [note: 'Acceptable level of investment risk for the mandate ranging from conservative to very aggressive.']
  sector_limit_percent decimal(8,4) [note: 'Maximum percentage of portfolio value that may be invested in a single industry sector.']
  short_selling_permitted_flag boolean [note: 'Indicates whether the mandate permits short selling of securities.']
  target_return_percent decimal(8,4) [note: 'Annualized target return objective for the mandate expressed as a percentage.']
  termination_date date [note: 'Date when the mandate was terminated or is scheduled to terminate. Null for active mandates.']
  tracking_error_limit_bps varchar [note: 'Maximum allowable tracking error versus benchmark expressed in basis points. Null if not applicable.']
  var_limit_percent decimal(8,4) [note: 'Maximum allowable Value at Risk expressed as a percentage of portfolio value. Null if not applicable.']

  Note: 'Authoritative master record for each investment mandate governing a portfolio or sleeve. Captures mandate type (internal, SMA, LP mandate, co-investment), investment universe constraints, permitted asset classes, geographic restrictions, currency hedging'
}

Table portfolio.saa_target {
  saa_target_id varchar [pk, note: 'Unique identifier for the strategic asset allocation target record.']
  credit_benchmark_index_id varchar [note: 'Foreign key linking to credit.benchmark_index. Business justification: SAA targets for credit asset classes require direct reference to credit benchmarks (Bloomberg Aggregate, ICE BofA) for policy weight calibration and performance attribution.']
  employee_id varchar [note: 'Identifier of the user or system process that created this SAA target record.']
  last_modified_by_user_employee_id varchar [note: 'Identifier of the user or system process that last modified this SAA target record.']
  portfolio_benchmark_id varchar [note: 'Reference to the market benchmark index used to evaluate performance of this asset class allocation.']
  portfolio_id varchar [note: 'Reference to the portfolio or fund to which this SAA target applies.']
  saa_employee_id varchar [note: 'Identifier of the user or system process that created this SAA target record.']
  saa_last_modified_by_user_employee_id varchar [note: 'Identifier of the user or system process that last modified this SAA target record.']
  actual_weight_percent decimal(8,5) [note: 'Current realized weight of this asset class as a percentage of total portfolio, used for drift monitoring and rebalancing decisions.']
  approval_authority varchar [note: 'Name or identifier of the governance body that approved this SAA target (e.g., Investment Committee, Board of Directors).']
  approval_date date [note: 'Date on which the Investment Committee formally approved this SAA target.']
  asset_class_code varchar [note: 'Standardized code identifying the asset class (e.g., PUBLIC_EQUITY, PRIVATE_EQUITY, REAL_ESTATE, INFRASTRUCTURE, NATURAL_RESOURCES, CREDIT, FIXED_INCOME).']
  asset_class_name varchar [note: 'Human-readable name of the asset class for reporting and display purposes.']
  correlation_group_code varchar [note: 'Code identifying the correlation group for portfolio optimization and diversification analysis (e.g., EQUITY_GROUP, FIXED_INCOME_GROUP).']
  created_timestamp timestamp [note: 'Timestamp when this SAA target record was first created in the system.']
  effective_date date [note: 'Date from which this SAA target becomes active and applicable for portfolio management and compliance monitoring.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are formally integrated into investment decisions for this asset class allocation.']
  exclusion_policy_applied_flag boolean [note: 'Indicates whether negative screening or exclusion policies apply to investments within this asset class.']
  expected_return_percent decimal(8,5) [note: 'Long-term expected annualized return assumption for this asset class used in ALM modeling and strategic planning.']
  expected_volatility_percent decimal(8,5) [note: 'Long-term expected annualized volatility (standard deviation) assumption for this asset class used in risk modeling.']
  expiry_date date [note: 'Date on which this SAA target ceases to be active; nullable for open-ended targets subject to periodic review.']
  geographic_constraint_code varchar [note: 'Geographic investment scope constraint for this asset class allocation (e.g., GLOBAL, DEVELOPED, EMERGING).']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this SAA target record.']
  last_review_date date [note: 'Date of the most recent Investment Committee or governance review of this SAA target.']
  liquidity_classification varchar [note: 'Classification of the asset class liquidity profile for cash management and liability matching purposes.']
  maximum_weight_percent decimal(8,5) [note: 'Upper bound constraint for this asset class allocation as defined in the investment policy, triggering rebalancing if breached.']
  minimum_weight_percent decimal(8,5) [note: 'Lower bound constraint for this asset class allocation as defined in the investment policy, triggering rebalancing if breached.']
  next_review_date date [note: 'Scheduled date for the next formal review of this SAA target by the Investment Committee.']
  policy_weight_percent decimal(8,5) [note: 'Long-term strategic policy target weight for this asset class as a percentage of total portfolio (e.g., 25.00000 for 25%).']
  rationale_notes varchar [note: 'Free-text explanation of the strategic rationale and Investment Committee considerations supporting this asset allocation target.']
  rebalancing_threshold_percent decimal(8,5) [note: 'Tolerance band around policy weight; drift exceeding this threshold triggers rebalancing review (e.g., +/- 2.00000%).']
  review_frequency_code varchar [note: 'Scheduled frequency for reviewing and potentially updating this SAA target (e.g., ANNUAL, QUARTERLY).']
  saa_target_status varchar [note: 'Current lifecycle status of this SAA target record (ACTIVE for in-force targets, SUPERSEDED for replaced targets).']
  sub_asset_class_code varchar [note: 'Granular sub-classification within the asset class (e.g., DEVELOPED_EQUITY, EMERGING_EQUITY, CORE_REAL_ESTATE, VALUE_ADD_REAL_ESTATE).']
  sub_asset_class_name varchar [note: 'Human-readable name of the sub-asset class for detailed reporting.']
  tactical_adjustment_allowed_flag boolean [note: 'Indicates whether tactical asset allocation (TAA) deviations from this strategic target are permitted within governance limits.']
  tactical_adjustment_limit_percent decimal(8,5) [note: 'Maximum permitted tactical deviation from policy weight as a percentage (e.g., +/- 3.00000%), if tactical adjustments are allowed.']
  target_currency_code varchar [note: 'ISO 4217 three-letter currency code in which the SAA target is denominated (e.g., USD, GBP).']
  version_number varchar [note: 'Sequential version number for this SAA target, incremented with each approved revision to maintain audit trail.']
  weight_drift_percent decimal(8,5) [note: 'Difference between actual weight and policy weight (actual minus policy), indicating allocation drift requiring rebalancing consideration.']

  Note: 'Strategic Asset Allocation (SAA) policy record defining long-term policy weights per asset class for a portfolio or fund, together with the realized actual weight for drift monitoring.'
}

Table portfolio.taa_position {
  taa_position_id varchar [pk, note: 'Unique identifier for the tactical asset allocation position record.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this tactical asset allocation position belongs.']
  saa_target_id varchar [note: 'Foreign key linking to portfolio.saa_target. Business justification: TAA positions represent tactical deviations from SAA targets. Explicit FK creates direct linkage between tactical positions and their strategic benchmarks, enabling deviation analysis']
  actual_amount decimal(20,2) [note: 'The actual dollar value of holdings in this asset class as of the position date.']
  actual_deviation_percent decimal(10,6) [note: 'The actual deviation from the TAA target weight, calculated as actual weight minus TAA target weight.']
  actual_weight_percent decimal(10,6) [note: 'The actual current weight of this asset class in the portfolio, expressed as a percentage of total portfolio value.']
  approval_status varchar [note: 'Approval status of the TAA position by the Investment Committee.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee member or authority who approved the TAA position.']
  asset_class_code varchar [note: 'Standardized code identifying the asset class (e.g., PUBLIC_EQUITY, PRIVATE_EQUITY, REAL_ESTATE, INFRASTRUCTURE, NATURAL_RESOURCES, CREDIT, FIXED_INCOME).']
  asset_class_name varchar [note: 'Human-readable name of the asset class for reporting and display purposes.']
  benchmark_code varchar [note: 'Code identifying the benchmark index used to measure performance for this asset class.']
  benchmark_name varchar [note: 'Human-readable name of the benchmark index for this asset class.']
  comments varchar [note: 'Additional notes or commentary regarding the tactical asset allocation position.']
  created_timestamp timestamp [note: 'The date and time when this TAA position record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the position amounts are denominated.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are formally integrated into the investment process for this asset class.']
  expected_return_percent decimal(10,6) [note: 'The expected annualized return for this asset class over the TAA horizon, as estimated by the investment team.']
  expected_volatility_percent decimal(10,6) [note: 'The expected annualized volatility (standard deviation of returns) for this asset class over the TAA horizon.']
  last_updated_timestamp timestamp [note: 'The date and time when this TAA position record was most recently modified.']
  liquidity_classification varchar [note: 'Classification of the asset class based on its liquidity profile for cash management and rebalancing purposes.']
  position_date date [note: 'The business date as of which this tactical asset allocation position is effective.']
  rebalancing_required_flag boolean [note: 'Indicates whether the actual deviation exceeds the rebalancing thresholds and action is required.']
  rebalancing_threshold_lower_percent decimal(10,6) [note: 'The lower bound deviation threshold that triggers a rebalancing action for this asset class.']
  rebalancing_threshold_upper_percent decimal(10,6) [note: 'The upper bound deviation threshold that triggers a rebalancing action for this asset class.']
  risk_budget_percent decimal(10,6) [note: 'The percentage of total portfolio risk budget allocated to this asset class under the TAA framework.']
  saa_target_amount decimal(20,2) [note: 'The dollar value corresponding to the SAA target weight for this asset class.']
  saa_target_weight_percent decimal(10,6) [note: 'The long-term strategic asset allocation target weight for this asset class, expressed as a percentage of total portfolio value.']
  sub_asset_class_code varchar [note: 'Granular sub-classification within the asset class (e.g., DEVELOPED_EQUITY, EMERGING_EQUITY, CORE_REAL_ESTATE, VALUE_ADD_REAL_ESTATE).']
  sub_asset_class_name varchar [note: 'Human-readable name of the sub-asset class for detailed reporting.']
  taa_decision_date date [note: 'The date on which the Investment Committee approved the current TAA target weight for this asset class.']
  taa_deviation_percent decimal(10,6) [note: 'The tactical over or underweight deviation from the SAA target, calculated as TAA target weight minus SAA target weight.']
  taa_horizon_months varchar [note: 'The expected time horizon in months for which the tactical position is intended to be maintained.']
  taa_position_status varchar [note: 'Current lifecycle status of the tactical asset allocation position.']
  taa_rationale varchar [note: 'Brief description of the macroeconomic or market view justifying the tactical deviation from SAA.']
  taa_review_date date [note: 'The scheduled date for the next Investment Committee review of this tactical position.']
  taa_target_amount decimal(20,2) [note: 'The dollar value corresponding to the TAA target weight for this asset class.']
  taa_target_weight_percent decimal(10,6) [note: 'The current tactical asset allocation target weight for this asset class, reflecting short-to-medium term market views and deviations from SAA.']

  Note: 'Tactical Asset Allocation (TAA) position record capturing the current tactical over/underweight deviation from SAA targets for each asset class within a portfolio.'
}

Table portfolio.holding {
  holding_id varchar [pk, note: 'Unique identifier for the holding position record in the Investment Book of Record (IBOR).']
  counterparty_id varchar [note: 'Reference to the custodian bank or fund administrator holding the security on behalf of the portfolio.']
  custodian_id varchar [note: 'Reference to the custodian bank or fund administrator holding the security on behalf of the portfolio.']
  fair_value_hierarchy_id varchar [note: 'Foreign key linking to valuation.fair_value_hierarchy. Business justification: IFRS 13/ASC 820 fair value disclosure requires Level 1/2/3 classification per holding. Pension funds must report fair value hierarchy in financial statements.']
  infra_asset_id varchar [note: 'Foreign key linking to infrastructure.infra_asset. Business justification: Pension funds hold direct infrastructure assets. Holdings must reference infra_asset for NAV calculation, performance attribution, and regulatory reporting.']
  listed_security_id varchar [note: 'Reference to the security or asset held in this position.']
  portfolio_id varchar [note: 'Reference to the portfolio that owns this holding position.']
  property_id varchar [note: 'Foreign key linking to realestate.property. Business justification: Direct real estate holdings require property linkage for NAV calculation, performance attribution, and regulatory reporting.']
  sleeve_id varchar [note: 'Foreign key linking to portfolio.sleeve. Business justification: Holdings can be allocated to specific sleeves within a portfolio. Pension funds commonly organize holdings by sleeve (equity sleeve, fixed income sleeve, alternatives sleeve).']
  account_number varchar [note: 'The custodian account number where the security is held.']
  accrued_income_base decimal(28,2) [note: 'The income earned but not yet received on the holding (e.g., accrued interest, dividends) in base currency.']
  accrued_income_local decimal(28,2) [note: 'The income earned but not yet received on the holding in local currency.']
  asset_class varchar [note: 'The primary asset class classification of the holding for strategic asset allocation (SAA) and reporting purposes.']
  base_currency_code varchar [note: 'The three-letter ISO 4217 currency code for the portfolios base reporting currency.']
  benchmark_weight decimal(10,6) [note: 'The target weight of this security in the portfolios assigned benchmark, expressed as a decimal (e.g., 0.025 for 2.5%).']
  collateral_flag boolean [note: 'Indicates whether the holding is pledged as collateral for derivatives, securities lending, or repo transactions.']
  commitment_amount decimal(28,2) [note: 'For private market investments, the total committed capital to the fund or co-investment, representing dry powder.']
  cost_base decimal(28,2) [note: 'The total acquisition cost of the holding in base currency, used for gain/loss calculation.']
  cost_local decimal(28,2) [note: 'The total acquisition cost of the holding in the local trading currency.']
  created_timestamp timestamp [note: 'The timestamp when this holding record was first created in the IBOR system.']
  esg_rating varchar [note: 'The ESG rating or score assigned to the holding by an external provider (e.g., MSCI, Sustainalytics) for responsible investment reporting.']
  exclusion_flag boolean [note: 'Indicates whether the holding is subject to ESG exclusion criteria or is on a restricted list for responsible investment compliance.']
  fx_rate decimal(18,8) [note: 'The exchange rate used to convert local currency values to base currency as of the position date.']
  holding_status varchar [note: 'The current lifecycle status of the holding position in the portfolio.']
  income_type varchar [note: 'The type of income generated by this holding for performance attribution and tax reporting.']
  investment_type varchar [note: 'The structure of the investment: direct ownership, co-investment alongside a GP, fund commitment (LP), or secondary market purchase.']
  last_valuation_date date [note: 'The date on which the holding was last valued, particularly relevant for illiquid private market assets.']
  lending_flag boolean [note: 'Indicates whether the holding is currently on loan under a securities lending program.']
  liquidity_classification varchar [note: 'The liquidity profile of the holding for liquidity risk management and cash flow forecasting.']
  local_currency_code varchar [note: 'The three-letter ISO 4217 currency code for the securitys trading currency.']
  market_value_base decimal(28,2) [note: 'The current market value of the holding in base currency, calculated as quantity multiplied by market price.']
  market_value_local decimal(28,2) [note: 'The current market value of the holding in the local trading currency.']
  portfolio_weight decimal(10,6) [note: 'The actual weight of this holding in the portfolio, calculated as market value divided by total portfolio NAV.']
  position_date date [note: 'The business date as of which this holding position is recorded in the IBOR.']
  quantity decimal(28,8) [note: 'The number of units, shares, or notional amount of the security held in this position.']
  rebalancing_flag boolean [note: 'Indicates whether the holding is currently flagged for rebalancing to align with strategic or tactical asset allocation targets.']
  restricted_flag boolean [note: 'Indicates whether the holding is subject to trading restrictions (e.g., lock-up period, regulatory restriction, insider trading blackout).']
  restriction_end_date date [note: 'The date on which trading restrictions on the holding are lifted, if applicable.']
  settlement_date date [note: 'The date on which the most recent transaction affecting this holding was settled (T+2 or other convention).']
  sub_asset_class varchar [note: 'The secondary or granular asset class classification for tactical asset allocation (TAA) and detailed reporting.']
  tax_lot_method varchar [note: 'The method used to track cost basis for tax reporting and realized gain/loss calculation.']
  trade_date date [note: 'The date on which the most recent transaction affecting this holding was executed.']
  unfunded_commitment decimal(28,2) [note: 'The remaining uncalled committed capital for private market investments, representing future capital call exposure.']
  unit_cost_base decimal(28,8) [note: 'The average cost per unit of the security in base currency, used for cost basis and performance attribution.']
  unit_cost_local decimal(28,8) [note: 'The average cost per unit of the security in the local trading currency.']
  unrealized_gain_loss_base decimal(28,2) [note: 'The difference between market value and cost in base currency, representing unrealized profit or loss on the position.']
  unrealized_gain_loss_local decimal(28,2) [note: 'The difference between market value and cost in local currency.']
  updated_timestamp timestamp [note: 'The timestamp when this holding record was last modified in the IBOR system.']
  valuation_level varchar [note: 'The IFRS 13 fair value hierarchy level (Level 1: quoted prices, Level 2: observable inputs, Level 3: unobservable inputs).']
  valuation_source varchar [note: 'The source or method used to determine the market value of the holding, critical for illiquid private assets.']
  vintage_year varchar [note: 'For private equity and private market funds, the year in which the fund held its initial closing and began investing.']

  Note: 'IBOR (Investment Book of Record) position record representing the authoritative current holding of a security or asset within a portfolio as of a given date.'
}

Table portfolio.holding_snapshot {
  holding_snapshot_id varchar [pk, note: 'Unique identifier for the holding snapshot record. Primary key.']
  custodian_id varchar [note: 'Reference to the custodian bank or institution holding the security on behalf of the portfolio.']
  infra_asset_id varchar [note: 'Foreign key linking to infrastructure.infra_asset. Business justification: Point-in-time infrastructure holding snapshots needed for GIPS-compliant performance reporting, historical NAV reconciliation, and regulatory filings requiring asset-level position']
  listed_security_id varchar [note: 'Reference to the security or investment instrument held in the portfolio.']
  market_price_snapshot_id varchar [note: 'Foreign key linking to valuation.market_price_snapshot. Business justification: Daily mark-to-market process requires linking holding snapshots to market prices.']
  portfolio_benchmark_id varchar [note: 'Reference to the benchmark index against which this holding\'s performance is measured.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this holding belongs.']
  account_number varchar [note: 'The custodian account number where the security is held.']
  accrued_income_base_currency decimal(28,2) [note: 'The accrued interest, dividends, or other income earned but not yet received on the holding, in base currency.']
  asset_class varchar [note: 'The primary asset class classification of the holding: public equity, private equity, real estate, infrastructure, natural resources, or credit.']
  base_currency_code varchar [note: 'The three-letter ISO 4217 currency code representing the portfolio\'s base currency for valuation.']
  carbon_intensity decimal(18,4) [note: 'The greenhouse gas emissions intensity of the security or issuer, typically measured in tonnes of CO2 equivalent per million dollars of revenue.']
  commitment_amount_base_currency decimal(28,2) [note: 'The total capital commitment made to the investment, applicable to private equity, infrastructure, and other capital call structures, in base currency.']
  country_of_risk varchar [note: 'The three-letter ISO 3166-1 alpha-3 country code representing the primary country exposure or risk of the security.']
  coupon_rate decimal(8,4) [note: 'The annual interest rate paid on a fixed income security, expressed as a percentage. Null for non-interest-bearing securities.']
  credit_rating varchar [note: 'The credit quality rating assigned to the security by a recognized rating agency such as Moody\'s, S&P, or Fitch.']
  cusip varchar [note: 'The nine-character alphanumeric code identifying North American securities.']
  duration_years decimal(8,4) [note: 'The weighted average time to receive the cash flows from the security, measuring interest rate sensitivity. Applicable to fixed income holdings.']
  esg_rating varchar [note: 'The ESG rating or score assigned to the security by an external provider such as MSCI, Sustainalytics, or internal assessment.']
  fair_value_level varchar [note: 'The IFRS 13 fair value hierarchy level: Level 1 for quoted prices in active markets, Level 2 for observable inputs, Level 3 for unobservable inputs.']
  fx_rate decimal(18,8) [note: 'The exchange rate used to convert the security currency to the portfolio base currency at the snapshot date.']
  holding_status varchar [note: 'Current lifecycle status of the holding position.']
  investment_strategy varchar [note: 'The investment strategy or mandate under which this holding was acquired, such as growth, value, core, opportunistic, or distressed.']
  isin varchar [note: 'The 12-character alphanumeric code that uniquely identifies the security internationally.']
  issuer_lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier of the security issuer.']
  issuer_name varchar [note: 'The name of the entity that issued the security.']
  liquidity_classification varchar [note: 'The liquidity profile of the holding: liquid for publicly traded securities, semi-liquid for restricted or thinly traded assets, illiquid for private investments.']
  market_price decimal(28,8) [note: 'The market price per unit of the security at the snapshot date, in the security\'s trading currency.']
  market_value_base_currency decimal(28,2) [note: 'The total market value of the holding position in the portfolio base currency at the snapshot date.']
  maturity_date date [note: 'The date on which the principal amount of a fixed income security becomes due and payable. Null for equities and perpetual instruments.']
  quantity decimal(28,8) [note: 'The number of units, shares, or nominal amount of the security held at the snapshot date.']
  record_created_timestamp timestamp [note: 'The timestamp when this holding snapshot record was first created in the Investment Book of Record (IBOR) system.']
  record_updated_timestamp timestamp [note: 'The timestamp when this holding snapshot record was last modified in the Investment Book of Record (IBOR) system.']
  sector_code varchar [note: 'The industry sector classification code of the security, typically following GICS, ICB, or internal taxonomy.']
  security_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the security is denominated and traded.']
  security_name varchar [note: 'The full legal or common name of the security held in the portfolio.']
  sedol varchar [note: 'The seven-character identification code assigned to securities trading on the London Stock Exchange and other UK markets.']
  snapshot_date date [note: 'The business date for which this holding snapshot was captured, typically end-of-day or month-end.']
  snapshot_timestamp timestamp [note: 'The precise timestamp when the holding snapshot was captured in the source system.']
  ticker_symbol varchar [note: 'The abbreviated trading symbol used to uniquely identify publicly traded securities on an exchange.']
  total_cost_base_currency decimal(28,2) [note: 'The total acquisition cost of the holding position in the portfolio base currency.']
  unfunded_commitment_base_currency decimal(28,2) [note: 'The remaining uncalled capital commitment available for future capital calls, in base currency. Also known as dry powder.']
  unit_cost_base_currency decimal(28,8) [note: 'The average cost per unit of the holding expressed in the portfolio base currency.']
  unrealized_gain_loss_base_currency decimal(28,2) [note: 'The unrealized profit or loss on the holding position, calculated as market value minus total cost in base currency.']
  valuation_source varchar [note: 'The source or method used to determine the market value of the holding: market price, broker quote, internal model, third-party appraisal, or Net Asset Value (NAV).']
  vintage_year varchar [note: 'The year in which the first capital commitment was made to a private equity, infrastructure, or real estate fund.']
  weight_percent decimal(8,4) [note: 'The percentage weight of this holding within the total portfolio market value at the snapshot date.']
  ytm decimal(8,4) [note: 'The total return anticipated on a bond if held until maturity, expressed as an annual percentage rate.']

  Note: 'Point-in-time snapshot of portfolio holdings captured at end-of-day or month-end for historical analysis, regulatory reporting, and performance attribution.'
}

Table portfolio.portfolio_benchmark {
  portfolio_benchmark_id varchar [pk, note: 'Unique identifier for the portfolio benchmark assignment record.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this benchmark is assigned.']
  superseded_by_benchmark_portfolio_benchmark_id varchar [note: 'Reference to the portfolio benchmark assignment that replaced this one, if superseded; null if still active or not replaced.']
  assignment_effective_date date [note: 'Date from which this benchmark assignment becomes effective for performance measurement and reporting.']
  assignment_end_date date [note: 'Date on which this benchmark assignment ceases to be effective; null for open-ended assignments.']
  assignment_reason varchar [note: 'Business rationale or justification for assigning this benchmark to the portfolio (e.g., strategic asset allocation change, mandate requirement, regulatory compliance).']
  assignment_status varchar [note: 'Current lifecycle status of the benchmark assignment to the portfolio.']
  benchmark_category varchar [note: 'High-level asset class category that the benchmark represents. [ENUM-REF-CANDIDATE: equity|fixed_income|real_estate|infrastructure|private_equity|multi_asset|alternative — 7 candidates stripped; promote to reference product]']
  benchmark_code varchar [note: 'Unique alphanumeric code identifying the benchmark (e.g., MSCI_WORLD, FTSE_ALL_WORLD, CUSTOM_BLEND_01).']
  benchmark_description varchar [note: 'Detailed textual description of the benchmark methodology, composition, and investment universe.']
  benchmark_name varchar [note: 'Full descriptive name of the benchmark (e.g., MSCI World Index, Bloomberg Barclays Global Aggregate Bond Index).']
  benchmark_type varchar [note: 'Classification of the benchmark: market index (published third-party), custom blend (internally constructed), liability benchmark (actuarial liability proxy), peer group (universe comparison), or absolute return (fixed target).']
  created_timestamp timestamp [note: 'Date and time when this portfolio benchmark assignment record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the benchmark is denominated (e.g., USD, EUR, GBP).']
  custom_blend_definition varchar [note: 'Detailed specification of component benchmarks and weights for custom blended benchmarks; null for standard market indices.']
  data_source varchar [note: 'System or vendor from which benchmark return and composition data is sourced (e.g., Bloomberg, MSCI, FactSet, SimCorp, Internal).']
  esg_integration_flag boolean [note: 'Indicates whether the benchmark incorporates Environmental, Social, and Governance (ESG) criteria or screens.']
  geography varchar [note: 'Geographic scope or regional focus of the benchmark. [ENUM-REF-CANDIDATE: global|developed_markets|emerging_markets|north_america|europe|asia_pacific|usa|other — 9 candidates stripped; promote to reference product]']
  ic_approval_date date [note: 'Date on which the Investment Committee approved this benchmark assignment or change.']
  ic_approval_reference varchar [note: 'Reference number or identifier of the Investment Committee decision or meeting minutes approving this benchmark assignment.']
  identifier varchar [note: 'External standard identifier for the benchmark such as Bloomberg Ticker, ISIN, or SEDOL where applicable.']
  inception_date date [note: 'Date on which the benchmark was first published or calculated by the provider.']
  is_primary_benchmark boolean [note: 'Indicates whether this is the primary benchmark for the portfolio; true if primary, false if secondary or supplemental.']
  last_modified_by varchar [note: 'User identifier or name of the person who last modified this portfolio benchmark assignment record.']
  last_modified_timestamp timestamp [note: 'Date and time when this portfolio benchmark assignment record was last updated.']
  liability_matching_flag boolean [note: 'Indicates whether this benchmark is designed to match actuarial liability cash flows for Liability-Driven Investment (LDI) purposes.']
  performance_fee_benchmark_flag boolean [note: 'Indicates whether this benchmark is used as the hurdle rate for calculating performance-based fees or carried interest.']
  provider varchar [note: 'Name of the organization that publishes or maintains the benchmark (e.g., MSCI, FTSE Russell, Bloomberg, S&P Dow Jones, Internal).']
  rebalancing_frequency varchar [note: 'Frequency at which the benchmark composition is rebalanced by the provider or internally. [ENUM-REF-CANDIDATE: daily|monthly|quarterly|semi_annual|annual|event_driven|none — 7 candidates stripped; promote to reference product]']
  regulatory_reporting_flag boolean [note: 'Indicates whether this benchmark assignment is required for regulatory or statutory reporting purposes.']
  return_calculation_method varchar [note: 'Methodology used to calculate benchmark returns (e.g., Time-Weighted Return, Money-Weighted Return, Total Return including dividends, Price Return only).']
  tracking_error_target_bps varchar [note: 'Target tracking error in basis points that the portfolio is expected to maintain relative to this benchmark.']
  version varchar [note: 'Version identifier for the benchmark methodology or composition, used to track changes over time.']
  volatility_percent decimal(5,2) [note: 'Annualized standard deviation of benchmark returns, expressed as a percentage, representing historical volatility.']
  weight_percent decimal(5,2) [note: 'Percentage weight of this benchmark in a blended benchmark scenario; 100.00 for single benchmark assignments.']
  created_by varchar [note: 'User identifier or name of the person who created this portfolio benchmark assignment record.']

  Note: 'Authoritative benchmark registry AND portfolio-benchmark assignment record. Masters each investment benchmark assigned to portfolios—market indices (MSCI World, FTSE All-World, Bloomberg Aggregate), custom blended benchmarks, and liability benchmarks for'
}

Table portfolio.benchmark_assignment {
  benchmark_assignment_id varchar [pk, note: 'Unique identifier for the benchmark assignment record. Primary key for this entity.']
  portfolio_benchmark_id varchar [note: 'Reference to the benchmark being assigned to the portfolio.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this benchmark is assigned.']
  superseded_by_assignment_benchmark_assignment_id varchar [note: 'Reference to the benchmark assignment record that replaces this one, used to maintain assignment lineage when benchmarks are changed.']
  approval_date date [note: 'Date on which the benchmark assignment was formally approved by the Investment Committee or authorized governance body.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved this benchmark assignment.']
  assignment_notes varchar [note: 'Free-text field for additional context, special instructions, or documentation related to this benchmark assignment.']
  assignment_reason varchar [note: 'Business rationale for assigning this benchmark to the portfolio, such as strategic asset allocation alignment, liability matching, or regulatory requirement.']
  assignment_source varchar [note: 'Origin or authority that determined this benchmark assignment, indicating who or what process established the relationship.']
  assignment_status varchar [note: 'Current lifecycle status of the benchmark assignment indicating whether it is currently in effect.']
  assignment_type varchar [note: 'Classification of the benchmark assignment role: primary (main performance benchmark), secondary (alternative comparison), risk (risk measurement), liability (ALM matching), composite (blended), or custom (special purpose).']
  assignment_weight decimal(10,6) [note: 'Weighting factor for this benchmark in blended benchmark calculations, expressed as a decimal (e.g., 0.60 for 60%). Sum of weights across all active assignments for a portfolio should equal 1.0.']
  created_timestamp timestamp [note: 'Timestamp when this benchmark assignment record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which benchmark returns are calculated and reported for this assignment.']
  currency_hedging_flag boolean [note: 'Indicates whether the benchmark returns for this assignment reflect currency hedging adjustments to match portfolio hedging strategy.']
  custom_benchmark_flag boolean [note: 'Indicates whether this is a custom-constructed benchmark specific to this portfolio rather than a standard market index.']
  effective_from_date date [note: 'Date from which this benchmark assignment becomes effective for performance measurement and reporting.']
  effective_to_date date [note: 'Date on which this benchmark assignment ceases to be effective. Null indicates an open-ended assignment.']
  last_review_date date [note: 'Date of the most recent review of this benchmark assignment for continued appropriateness and alignment with portfolio objectives.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this benchmark assignment record.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this benchmark assignment.']
  performance_attribution_flag boolean [note: 'Indicates whether this benchmark assignment should be used for performance attribution analysis and decomposition of active returns.']
  rebalancing_frequency varchar [note: 'Frequency at which the benchmark composition or weighting is reviewed and potentially adjusted for this assignment.']
  reporting_flag boolean [note: 'Indicates whether this benchmark assignment should be included in client and regulatory reporting packages.']
  tracking_error_limit decimal(8,4) [note: 'Maximum allowable tracking error (standard deviation of return differences) between portfolio and benchmark, expressed in basis points. Used for risk monitoring and compliance.']
  version_number varchar [note: 'Version number of this benchmark assignment record, incremented with each modification to track assignment history.']

  Note: 'Association record linking a portfolio to its assigned benchmark(s) with effective date ranges, assignment type (primary, secondary, risk benchmark, liability benchmark), and weighting for blended benchmarks.'
}

Table portfolio.asset_class_weight {
  asset_class_weight_id varchar [pk, note: 'Unique identifier for the asset class weight record.']
  portfolio_id varchar [note: 'Reference to the portfolio for which this asset class weight is recorded.']
  active_weight_percentage decimal(10,6) [note: 'The difference between portfolio actual weight and benchmark weight, expressed in percentage points, indicating active positioning versus benchmark.']
  approval_status varchar [note: 'The approval workflow status of this weight record, indicating whether it has been reviewed and approved by investment operations or portfolio management.']
  approved_by varchar [note: 'The name or identifier of the individual who approved this asset class weight record.']
  approved_timestamp timestamp [note: 'The date and time when this asset class weight record was approved.']
  asset_class_code varchar [note: 'Standardized code representing the asset class category (e.g., PE for Private Equity, RE for Real Estate, INFRA for Infrastructure).']
  asset_class_name varchar [note: 'Full descriptive name of the asset class (e.g., Public Equity, Private Equity, Real Estate, Infrastructure, Natural Resources, Credit, Cash and Equivalents).']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the portfolio base currency in which market value and weights are denominated.']
  benchmark_weight_percentage decimal(10,6) [note: 'The weight of this asset class in the composite benchmark index used for performance comparison, expressed as a percentage.']
  calculation_timestamp timestamp [note: 'The precise date and time when this asset class weight was calculated by the portfolio management system.']
  comments varchar [note: 'Free-text field for portfolio managers or analysts to record notes, explanations, or context regarding this asset class weight or any deviations from policy.']
  contribution_to_return decimal(10,6) [note: 'The contribution of this asset class to total portfolio return for the period, calculated as weight multiplied by asset class return, expressed as a percentage.']
  created_timestamp timestamp [note: 'The date and time when this asset class weight record was first created in the system.']
  data_source varchar [note: 'The system or platform from which this asset class weight data was sourced (e.g., SimCorp Dimension, BlackRock Aladdin, State Street).']
  deviation_from_target decimal(10,6) [note: 'The difference between actual weight and target weight, expressed in percentage points (actual minus target), indicating over or under allocation.']
  effective_weight_percentage decimal(10,6) [note: 'The effective allocation weight including unfunded commitments, calculated as (market value plus unfunded commitments) divided by (total portfolio value plus total unfunded commitments), expressed as a percentage.']
  esg_weight_percentage decimal(10,6) [note: 'The percentage of this asset class that is invested in holdings meeting ESG criteria or responsible investment standards.']
  is_active boolean [note: 'Boolean flag indicating whether this is the current active weight record for the portfolio and asset class combination (True if current, False if historical).']
  liquidity_classification varchar [note: 'Classification of the asset class based on liquidity characteristics (liquid for public markets, illiquid for private markets, semi-liquid for hybrid).']
  market_value decimal(20,2) [note: 'The total market value of holdings in this asset class as of the valuation date, in the portfolio base currency.']
  modified_by varchar [note: 'The user identifier or system process that last modified this asset class weight record.']
  modified_timestamp timestamp [note: 'The date and time when this asset class weight record was last modified.']
  number_of_holdings varchar [note: 'The count of distinct investment positions within this asset class as of the valuation date.']
  prior_period_weight_percentage decimal(10,6) [note: 'The asset class weight percentage from the previous valuation period, used for period-over-period comparison and drift analysis.']
  rebalancing_required_flag boolean [note: 'Boolean indicator whether the current weight deviation exceeds policy thresholds and requires rebalancing action (True if rebalancing needed, False otherwise).']
  rebalancing_threshold_lower decimal(10,6) [note: 'The lower bound threshold percentage below which the asset class weight triggers a rebalancing action per portfolio policy.']
  rebalancing_threshold_upper decimal(10,6) [note: 'The upper bound threshold percentage above which the asset class weight triggers a rebalancing action per portfolio policy.']
  reporting_period varchar [note: 'The reporting period to which this weight record belongs, formatted as YYYY-QN for quarterly, YYYY-MNN for monthly, or YYYY-YYYY for annual.']
  tactical_weight_percentage decimal(10,6) [note: 'The tactical asset allocation (TAA) target weight for this asset class reflecting short-term market views and adjustments, expressed as a percentage.']
  target_weight_percentage decimal(10,6) [note: 'The strategic asset allocation (SAA) target weight for this asset class as defined by the investment policy, expressed as a percentage.']
  unfunded_commitment_amount decimal(20,2) [note: 'The total uncalled committed capital (dry powder) for this asset class, applicable primarily to private markets investments, in base currency.']
  valuation_date date [note: 'The date on which this asset class weight was calculated and recorded.']
  weight_calculation_method varchar [note: 'The methodology used to calculate the asset class weight (market value, net asset value, fair value, or cost basis).']
  weight_change_percentage decimal(10,6) [note: 'The change in asset class weight from prior period to current period, expressed in percentage points, indicating allocation drift.']
  weight_percentage decimal(10,6) [note: 'The actual allocation weight of this asset class within the portfolio, expressed as a percentage of total portfolio value (e.g., 25.500000 represents 25.5%).']
  weight_status varchar [note: 'Categorical status indicating whether the asset class weight is within policy range, overweight, underweight, or at target relative to strategic allocation.']
  created_by varchar [note: 'The user identifier or system process that created this asset class weight record.']

  Note: 'Current actual asset class weight record for a portfolio as of a valuation date, capturing the realized allocation to each asset class (public equity, private equity, real estate, infrastructure, natural resources, credit, cash) expressed as a percentage'
}

Table portfolio.rebalancing_event {
  rebalancing_event_id varchar [pk, note: 'Unique identifier for the portfolio rebalancing event. Primary key.']
  portfolio_id varchar [note: 'Reference to the portfolio being rebalanced.']
  approval_required_flag boolean [note: 'Indicates whether Investment Committee (IC) or senior management approval was required before executing this rebalancing event.']
  approval_timestamp timestamp [note: 'Date and time when the rebalancing event received formal approval to proceed.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee member or authorized approver who approved the rebalancing event.']
  base_currency varchar [note: 'Three-letter ISO 4217 currency code representing the portfolio base currency for NAV and allocation calculations.']
  carbon_footprint_post decimal(18,2) [note: 'Total carbon footprint of the portfolio after rebalancing, used to assess climate impact of the rebalancing decision.']
  carbon_footprint_pre decimal(18,2) [note: 'Total carbon footprint of the portfolio before rebalancing, measured in tonnes of CO2 equivalent per million invested.']
  cash_requirement decimal(18,2) [note: 'Minimum cash or liquid asset requirement that must be maintained post-rebalancing to meet near-term liability obligations, in base currency.']
  created_timestamp timestamp [note: 'Date and time when this rebalancing event record was first created in the system.']
  drift_percentage decimal(10,4) [note: 'Percentage deviation from target allocation that triggered the rebalancing, measured in basis points or percentage points.']
  drift_threshold_breached boolean [note: 'Indicates whether the rebalancing was triggered by a breach of the Strategic Asset Allocation (SAA) or Tactical Asset Allocation (TAA) drift threshold.']
  esg_impact_assessed boolean [note: 'Indicates whether the rebalancing event included an assessment of Environmental, Social, and Governance (ESG) impact on the portfolio.']
  esg_score_post decimal(5,2) [note: 'Aggregate ESG score of the portfolio after the rebalancing event, used to measure ESG improvement or degradation.']
  esg_score_pre decimal(5,2) [note: 'Aggregate ESG score of the portfolio before the rebalancing event, typically on a 0-100 scale.']
  estimated_market_impact decimal(18,2) [note: 'Estimated cost of market impact from executing large rebalancing trades, measured in base currency.']
  estimated_tax_impact decimal(18,2) [note: 'Estimated tax liability or benefit resulting from the rebalancing trades, including capital gains taxes, in base currency.']
  event_number varchar [note: 'Business identifier for the rebalancing event, formatted as REB-YYYYMMDD-NNNNNN for external reference and audit trails.']
  event_status varchar [note: 'Current lifecycle status of the rebalancing event in the execution workflow.']
  event_timestamp timestamp [note: 'Date and time when the rebalancing event was initiated or triggered.']
  execution_end_timestamp timestamp [note: 'Date and time when all trades for the rebalancing event were completed and settled.']
  execution_start_timestamp timestamp [note: 'Date and time when trade execution for the rebalancing event commenced.']
  execution_strategy varchar [note: 'Trading execution strategy employed for the rebalancing trades to minimize market impact and transaction costs.']
  liquidity_constraint_applied boolean [note: 'Indicates whether liquidity constraints were applied during the rebalancing to ensure sufficient cash for liability payments.']
  post_rebalancing_nav decimal(20,2) [note: 'Total Net Asset Value of the portfolio immediately after the rebalancing event, in base currency.']
  post_trade_var decimal(18,2) [note: 'Portfolio Value at Risk (VaR) calculated after the rebalancing event, used to assess risk impact.']
  pre_rebalancing_nav decimal(20,2) [note: 'Total Net Asset Value of the portfolio immediately before the rebalancing event, in base currency.']
  pre_trade_var decimal(18,2) [note: 'Portfolio Value at Risk (VaR) calculated before the rebalancing event, used for risk comparison.']
  rebalancing_frequency varchar [note: 'Scheduled frequency of rebalancing for this portfolio as defined in the investment mandate.']
  rebalancing_notes varchar [note: 'Free-text field for portfolio managers to document additional context, rationale, or special considerations for this rebalancing event.']
  risk_assessment_performed boolean [note: 'Indicates whether a pre-trade risk assessment was conducted before executing the rebalancing event.']
  scheduled_rebalancing_flag boolean [note: 'Indicates whether this rebalancing event was part of a scheduled periodic rebalancing cycle (e.g., quarterly, annual).']
  settlement_date date [note: 'Date on which all rebalancing trades are expected to settle, typically T+2 for equities.']
  system_source varchar [note: 'Name of the source system that generated or recorded this rebalancing event (e.g., SimCorp Dimension, BlackRock Aladdin).']
  target_allocation_type varchar [note: 'Indicates whether the rebalancing targets Strategic Asset Allocation (SAA) or Tactical Asset Allocation (TAA) weights.']
  tax_optimization_applied boolean [note: 'Indicates whether tax-loss harvesting or other tax optimization strategies were applied during the rebalancing event.']
  total_trades_executed varchar [note: 'Number of individual trade orders executed as part of this rebalancing event across all asset classes.']
  total_transaction_cost decimal(18,2) [note: 'Aggregate transaction costs incurred during the rebalancing, including brokerage fees, commissions, and market impact costs, in base currency.']
  tracking_error_post decimal(10,4) [note: 'Tracking error of the portfolio relative to its benchmark after the rebalancing event, expressed as a percentage.']
  tracking_error_pre decimal(10,4) [note: 'Tracking error of the portfolio relative to its benchmark before the rebalancing event, expressed as a percentage.']
  transaction_cost_bps decimal(8,2) [note: 'Total transaction cost expressed as basis points of the portfolio NAV, used for cost efficiency analysis.']
  trigger_description varchar [note: 'Detailed narrative explaining the specific reason or condition that triggered this rebalancing event.']
  trigger_type varchar [note: 'Classification of the event that triggered the rebalancing action.']
  updated_timestamp timestamp [note: 'Date and time when this rebalancing event record was last modified in the system.']

  Note: 'Transactional record capturing each portfolio rebalancing event triggered by drift from SAA/TAA targets or scheduled periodic rebalancing. Records trigger type (drift breach, scheduled, tactical decision, mandate change), target weights before and after'
}

Table portfolio.constraint {
  constraint_id varchar [pk, note: 'Unique identifier for the investment constraint record.']
  portfolio_benchmark_id varchar [note: 'Reference to the benchmark used for relative constraint calculations.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this constraint applies.']
  portfolio_mandate_id varchar [note: 'Reference to the investment mandate governing this constraint.']
  approval_date date [note: 'Date on which the constraint was formally approved.']
  approval_status varchar [note: 'Governance approval state of the constraint before it becomes enforceable.']
  approved_by varchar [note: 'Name or identifier of the authority who approved this constraint.']
  asset_class varchar [note: 'Asset class to which this constraint applies when scope is asset-class-specific. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|cash — promote to reference product]']
  breach_count varchar [note: 'Cumulative number of times this constraint has been breached since inception.']
  breach_severity varchar [note: 'Classification of the impact level when this constraint is violated.']
  calculation_method varchar [note: 'Technical specification of how the constraint metric is computed from portfolio positions.']
  constraint_category varchar [note: 'Classification of the constraint source indicating whether it originates from regulation, mandate terms, internal policy, or risk framework.']
  constraint_code varchar [note: 'Business identifier code for the constraint rule, used for reference in compliance monitoring systems.']
  constraint_name varchar [note: 'Human-readable name describing the constraint rule.']
  constraint_status varchar [note: 'Current lifecycle state of the constraint rule.']
  constraint_type varchar [note: 'Category of investment constraint defining the nature of the restriction. [ENUM-REF-CANDIDATE: asset_allocation|concentration|liquidity|credit_quality|duration|leverage|exposure|sector|geography|esg — 10 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this constraint record was first created in the system.']
  credit_rating_minimum varchar [note: 'Minimum acceptable credit rating for fixed income investments subject to this constraint.']
  effective_date date [note: 'Date from which this constraint becomes active and enforceable.']
  esg_score_minimum decimal(5,2) [note: 'Minimum ESG score required for investments under this constraint.']
  expiry_date date [note: 'Date on which this constraint ceases to be active, nullable for perpetual constraints.']
  geography_code varchar [note: 'ISO 3166-1 alpha-3 country or region code when constraint is geography-specific.']
  last_breach_date date [note: 'Most recent date on which this constraint was breached.']
  mandate_clause_reference varchar [note: 'Reference to the specific clause in the investment mandate document that defines this constraint.']
  maximum_value decimal(18,6) [note: 'Upper bound of the constraint range when threshold type is range-based.']
  minimum_value decimal(18,6) [note: 'Lower bound of the constraint range when threshold type is range-based.']
  modified_by varchar [note: 'User or system identifier that last modified this constraint record.']
  modified_timestamp timestamp [note: 'Timestamp when this constraint record was last modified.']
  monitoring_frequency varchar [note: 'Cadence at which compliance with this constraint is evaluated.']
  notes varchar [note: 'Free-text field for additional context, exceptions, or special instructions related to this constraint.']
  notification_recipients varchar [note: 'Comma-separated list of roles or individuals to be notified upon breach.']
  notification_required boolean [note: 'Indicates whether stakeholders must be notified when this constraint is breached.']
  override_allowed boolean [note: 'Indicates whether this constraint can be temporarily overridden with appropriate authorization.']
  override_authority_level varchar [note: 'Minimum authority level required to approve an override of this constraint. [ENUM-REF-CANDIDATE: portfolio_manager|chief_investment_officer|investment_committee|board|none — promote to reference product]']
  regulatory_reference varchar [note: 'Citation of the regulatory rule or guideline that mandates this constraint.']
  remediation_period_days varchar [note: 'Number of business days allowed to remediate a breach before escalation.']
  rule_description varchar [note: 'Detailed textual description of the constraint rule and its business rationale.']
  scope varchar [note: 'Level at which the constraint is applied within the portfolio hierarchy. [ENUM-REF-CANDIDATE: portfolio|asset_class|sector|issuer|security|counterparty|geography — 7 candidates stripped; promote to reference product]']
  sector_code varchar [note: 'Industry sector code when constraint is sector-specific.']
  threshold_currency varchar [note: 'ISO 4217 three-letter currency code when threshold is expressed in monetary terms.']
  threshold_type varchar [note: 'Type of threshold defining whether the constraint sets a floor, ceiling, or bounded range.']
  threshold_unit varchar [note: 'Unit of measure for the threshold value indicating whether it is expressed as percentage, basis points, currency amount, count, or ratio.']
  threshold_value decimal(18,6) [note: 'Numeric value representing the constraint limit or target.']
  tolerance_percentage decimal(5,2) [note: 'Allowable deviation from the threshold before a breach is triggered, expressed as percentage.']
  created_by varchar [note: 'User or system identifier that created this constraint record.']

  Note: 'Business rule record defining investment constraints and guidelines applicable to a portfolio or mandate, as monitored in BlackRock Aladdin compliance engine.'
}

Table portfolio.constraint_breach {
  constraint_breach_id varchar [pk, note: 'Unique identifier for the constraint breach record. Primary key.']
  constraint_id varchar [note: 'Reference to the specific constraint rule or guideline that was breached.']
  constraint_rule_id varchar [note: 'Reference to the specific constraint rule or guideline that was breached.']
  holding_id varchar [note: 'Reference to the specific position that triggered the breach, if applicable.']
  portfolio_id varchar [note: 'Reference to the portfolio in which the breach occurred.']
  portfolio_mandate_id varchar [note: 'Reference to the investment mandate or guideline framework under which the breach was detected.']
  position_holding_id varchar [note: 'Reference to the specific position that triggered the breach, if applicable.']
  acknowledged_by varchar [note: 'Name or identifier of the individual who acknowledged the breach.']
  acknowledged_timestamp timestamp [note: 'Date and time when the breach was formally acknowledged by compliance or portfolio management.']
  actual_value decimal(18,6) [note: 'The actual measured value at the time of breach detection.']
  asset_class varchar [note: 'The asset class associated with the breach, such as public equities, private equity, real estate, infrastructure, natural resources, or credit.']
  breach_amount decimal(18,6) [note: 'The magnitude of the breach, calculated as the difference between actual value and threshold value.']
  breach_detected_timestamp timestamp [note: 'Date and time when the compliance monitoring system first detected the breach.']
  breach_notes varchar [note: 'Free-text field for additional context, commentary, or analysis related to the breach.']
  breach_occurrence_timestamp timestamp [note: 'Date and time when the breach actually occurred in the portfolio, which may differ from detection time.']
  breach_percentage decimal(10,4) [note: 'The breach amount expressed as a percentage of the threshold, indicating relative severity.']
  breach_reference_number varchar [note: 'Externally-known unique reference number assigned to this breach for tracking and reporting purposes.']
  breach_status varchar [note: 'Current lifecycle status of the breach in the compliance workflow.']
  breach_type varchar [note: 'Classification of when the breach was detected in the trade lifecycle.']
  constraint_category varchar [note: 'High-level category of the investment constraint that was breached. [ENUM-REF-CANDIDATE: asset_allocation|concentration|liquidity|credit_quality|duration|leverage|esg|sector|geography|currency — 10 candidates stripped; promote to reference product]']
  constraint_description varchar [note: 'Detailed description of the constraint rule, including its purpose and parameters.']
  created_timestamp timestamp [note: 'Date and time when this breach record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for monetary breach amounts, if applicable.']
  detected_by_system varchar [note: 'Name of the compliance monitoring system that detected the breach, such as BlackRock Aladdin or Charles River IMS.']
  detection_method varchar [note: 'Method by which the breach was detected, indicating whether it was automated or manual.']
  escalated_to_ic boolean [note: 'Indicates whether the breach was escalated to the Investment Committee for review and decision.']
  escalation_timestamp timestamp [note: 'Date and time when the breach was escalated to higher authority or the Investment Committee.']
  geography varchar [note: 'Three-letter ISO country code representing the geographic exposure associated with the breach.']
  issuer_name varchar [note: 'Name of the issuer or counterparty associated with the breached position.']
  last_updated_timestamp timestamp [note: 'Date and time when this breach record was last modified.']
  regulator_report_date date [note: 'Date on which the breach was reported to the regulatory authority.']
  regulatory_reportable boolean [note: 'Indicates whether this breach must be reported to regulatory authorities such as SEC, or FCA.']
  remediated_timestamp timestamp [note: 'Date and time when the breach was successfully remediated and the portfolio returned to compliance.']
  remediation_action varchar [note: 'Description of the corrective action taken or planned to remediate the breach.']
  remediation_deadline date [note: 'Target date by which the breach must be remediated according to policy or regulatory requirements.']
  reported_to_regulator boolean [note: 'Indicates whether the breach has been formally reported to the applicable regulatory body.']
  sector varchar [note: 'Industry sector classification of the security or investment involved in the breach.']
  security_identifier varchar [note: 'Unique identifier of the security involved in the breach, such as ISIN, CUSIP, or SEDOL.']
  security_name varchar [note: 'Human-readable name of the security or investment involved in the breach.']
  severity_level varchar [note: 'Assessed severity or materiality of the breach for risk management and escalation purposes.']
  threshold_value decimal(18,6) [note: 'The maximum or minimum limit defined by the constraint rule.']
  unit_of_measure varchar [note: 'The unit in which threshold and actual values are expressed. [ENUM-REF-CANDIDATE: percent|bps|currency|shares|units|days|years|ratio — 8 candidates stripped; promote to reference product]']
  waiver_approved_by varchar [note: 'Name or identifier of the authority who approved the waiver.']
  waiver_expiry_date date [note: 'Date on which the granted waiver expires and the constraint becomes enforceable again.']
  waiver_granted boolean [note: 'Indicates whether a formal waiver or exception was granted for this breach by the Investment Committee or compliance authority.']
  waiver_reason varchar [note: 'Business justification or rationale for granting a waiver, if applicable.']

  Note: 'Transactional record of each investment guideline or mandate constraint breach detected during pre-trade or post-trade compliance monitoring in BlackRock Aladdin or Charles River IMS.'
}

Table portfolio.gips_composite {
  gips_composite_id varchar [pk, note: 'Unique identifier for the GIPS composite record.']
  asset_class varchar [note: 'Primary asset class or investment category that defines the composite strategy (e.g., public equities, private equity, real estate, infrastructure, credit).']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the base currency for composite performance reporting and valuation.']
  benchmark_code varchar [note: 'Standard identifier or ticker symbol for the benchmark index (e.g., Bloomberg ticker, ISIN).']
  benchmark_name varchar [note: 'Name of the primary benchmark index used for performance comparison and attribution analysis.']
  composite_aum decimal(20,2) [note: 'Total market value of all assets under management within the composite as of the most recent valuation date, expressed in base currency.']
  composite_code varchar [note: 'Internal unique code or identifier assigned to the composite for system reference and reporting.']
  composite_creation_method varchar [note: 'Method used to aggregate individual portfolio returns into the composite return (asset-weighted or equal-weighted).']
  composite_definition varchar [note: 'Formal definition and inclusion criteria that determine which portfolios are eligible for inclusion in the composite.']
  composite_description varchar [note: 'Detailed description of the composite investment strategy, mandate, and portfolio characteristics.']
  composite_dispersion_measure varchar [note: 'Statistical measure used to assess the variability of individual portfolio returns within the composite (e.g., standard deviation, range).']
  composite_manager_name varchar [note: 'Name of the investment manager or team responsible for managing portfolios within the composite.']
  composite_name varchar [note: 'Official name of the GIPS composite used for performance presentation and client reporting.']
  composite_notes varchar [note: 'Additional notes, disclosures, or commentary regarding the composite structure, performance, or special considerations.']
  composite_status varchar [note: 'Current lifecycle status of the composite indicating whether it is actively maintained for performance reporting.']
  composite_type varchar [note: 'Classification of the composite based on portfolio management discretion and structure.']
  created_timestamp timestamp [note: 'Timestamp when the composite record was first created in the system.']
  derivatives_usage_flag boolean [note: 'Indicates whether portfolios within the composite are permitted to use derivative instruments for hedging or investment purposes.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are systematically integrated into the investment decision-making process for portfolios within the composite.']
  esg_strategy_description varchar [note: 'Description of the ESG integration approach, screening criteria, and responsible investment practices applied to the composite.']
  fee_schedule_description varchar [note: 'Description of the fee structure and schedule applicable to portfolios within the composite, including management fees and performance fees.']
  geographic_focus varchar [note: 'Primary geographic region or market focus of the composite investment strategy (e.g., global, North America, emerging markets).']
  gross_of_fees_flag boolean [note: 'Indicates whether composite performance is presented gross of investment management fees (True) or net of fees (False).']
  inception_date date [note: 'Date when the composite was first created and began tracking performance.']
  investment_strategy varchar [note: 'Detailed investment strategy or mandate that defines the composite including geographic focus, sector focus, and investment approach.']
  last_examination_date date [note: 'Date of the most recent independent performance examination or verification, if applicable.']
  last_updated_by varchar [note: 'User identifier or name of the individual who most recently updated the composite record.']
  last_updated_timestamp timestamp [note: 'Timestamp when the composite record was most recently modified or updated.']
  leverage_flag boolean [note: 'Indicates whether portfolios within the composite are permitted to use leverage or borrowing to enhance returns.']
  minimum_portfolio_size decimal(18,2) [note: 'Minimum asset value threshold required for a portfolio to be included in the composite, expressed in base currency.']
  net_of_fees_flag boolean [note: 'Indicates whether composite performance is presented net of investment management fees (True) or gross of fees (False).']
  number_of_portfolios varchar [note: 'Count of individual portfolios currently included in the composite.']
  performance_examination_flag boolean [note: 'Indicates whether the composite performance has been independently verified or examined by a third-party auditor in accordance with GIPS standards.']
  reporting_frequency varchar [note: 'Frequency at which composite performance is calculated and reported to stakeholders.']
  return_calculation_method varchar [note: 'Method used to calculate composite returns: Time-Weighted Return (TWR), Money-Weighted Return (MWR), or Internal Rate of Return (IRR).']
  sector_focus varchar [note: 'Primary industry sector or economic sector focus of the composite investment strategy, if applicable.']
  termination_date date [note: 'Date when the composite was closed or terminated, if applicable. Null for active composites.']
  three_year_ex_post_standard_deviation decimal(8,4) [note: 'Annualized three-year ex-post standard deviation of composite returns, expressed as a percentage, used to measure historical volatility.']
  valuation_methodology varchar [note: 'Description of the valuation approach and methodology used for portfolio assets within the composite (e.g., fair value, mark-to-market, DCF for private assets).']
  created_by varchar [note: 'User identifier or name of the individual who created the composite record.']

  Note: 'GIPS (Global Investment Performance Standards) composite master record grouping portfolios with similar investment mandates for standardized performance presentation.'
}

Table portfolio.portfolio_composite_membership {
  portfolio_composite_membership_id varchar [pk, note: 'Unique identifier for the portfolio composite membership association record.']
  approved_by_user_employee_id varchar [note: 'Identifier of the compliance officer or investment committee member who approved the composite membership assignment.']
  composite_id varchar [note: 'Identifier of the GIPS composite to which the portfolio is assigned.']
  employee_id varchar [note: 'Identifier of the compliance officer or investment committee member who approved the composite membership assignment.']
  gips_compliance_record_id varchar [note: 'Foreign key linking to compliance.gips_compliance_record. Business justification: Portfolio composite membership must reference the GIPS compliance record for the composite to enforce compliance reporting.']
  gips_composite_id varchar [note: 'Foreign key linking to portfolio.gips_composite. Business justification: portfolio_composite_membership tracks which portfolios belong to which GIPS composites.']
  portfolio_id varchar [note: 'Identifier of the individual portfolio included in the composite.']
  approval_timestamp timestamp [note: 'Date and time when the composite membership assignment was formally approved.']
  audit_trail_reference varchar [note: 'Reference identifier linking to detailed audit trail records for this composite membership assignment.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the portfolio\'s base currency during the membership period.']
  benchmark_assignment_override_flag boolean [note: 'Indicates whether the portfolio uses a different benchmark than the composite\'s primary benchmark.']
  carve_out_cash_allocation_method varchar [note: 'Method used to allocate cash to the carve-out portfolio if applicable.']
  carve_out_flag boolean [note: 'Indicates whether the portfolio is a carve-out segment from a larger multi-strategy portfolio.']
  compliance_notes varchar [note: 'Free-text notes documenting compliance considerations, exceptions, or special circumstances related to the composite membership.']
  composite_assignment_date date [note: 'Date when the portfolio was formally assigned to the composite by the investment committee or compliance team.']
  composite_definition_compliance_flag boolean [note: 'Indicates whether the portfolio meets all criteria defined in the composite\'s investment mandate and strategy.']
  discretionary_flag boolean [note: 'Indicates whether the portfolio was managed on a discretionary basis during the membership period.']
  effective_end_date date [note: 'Date when the portfolio was removed from the composite, null if currently active.']
  effective_start_date date [note: 'Date when the portfolio was first included in the composite.']
  exclusion_reason_code varchar [note: 'Standardized code indicating the reason for removing the portfolio from the composite, null if not excluded. [ENUM-REF-CANDIDATE: mandate_change|strategy_drift|closure|transfer|non_discretionary|regulatory|client_request — 7 candidates stripped; promote']
  exclusion_reason_description varchar [note: 'Detailed narrative explanation of why the portfolio was excluded from the composite.']
  fee_paying_flag boolean [note: 'Indicates whether the portfolio pays management fees during the membership period.']
  inclusion_reason_code varchar [note: 'Standardized code indicating the reason for including the portfolio in the composite.']
  inclusion_reason_description varchar [note: 'Detailed narrative explanation of why the portfolio was included in the composite.']
  last_review_date date [note: 'Date when the portfolio\'s composite membership was last reviewed for continued compliance with composite criteria.']
  market_value_at_exclusion decimal(20,2) [note: 'Total market value of the portfolio at the time of exclusion from the composite, in base currency, null if still active.']
  market_value_at_inclusion decimal(20,2) [note: 'Total market value of the portfolio at the time of inclusion in the composite, in base currency.']
  membership_status varchar [note: 'Current status of the portfolio\'s membership in the composite.']
  minimum_asset_threshold_met_flag boolean [note: 'Indicates whether the portfolio meets the minimum asset size requirement for composite inclusion.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the portfolio\'s composite membership eligibility.']
  performance_calculation_method varchar [note: 'Method used to calculate the portfolio\'s performance contribution to the composite.']
  portfolio_inception_date date [note: 'Date when the portfolio was first established, used to determine eligibility for composite inclusion.']
  record_created_timestamp timestamp [note: 'Date and time when this composite membership record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Date and time when this composite membership record was last modified.']
  significant_cash_flow_flag boolean [note: 'Indicates whether the portfolio experienced significant cash flows during the membership period that may affect composite performance.']
  source_system_code varchar [note: 'Code identifying the operational system of record from which the composite membership data originated.']
  temporary_exclusion_flag boolean [note: 'Indicates whether the portfolio was temporarily excluded from the composite due to significant cash flows or other transient conditions.']
  weight_in_composite_percent decimal(10,6) [note: 'Percentage weight of the portfolio within the composite based on market value, used for performance calculation.']

  Note: 'Association record tracking the inclusion of individual portfolios within GIPS composites over time, with effective start and end dates, inclusion reason, and exclusion reason (if applicable).'
}

Table portfolio.portfolio_capital_commitment {
  portfolio_capital_commitment_id varchar [pk, note: 'Unique identifier for the capital commitment record. Primary key for the portfolio capital commitment entity.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: Pension fund capital commitments to PE/infrastructure funds require completed due diligence.']
  deal_capital_commitment_id varchar [note: 'Foreign key linking to deal.deal_capital_commitment. Business justification: Commitment lifecycle reconciliation requires linking portfolio-stage commitments to their deal-stage predecessors. Audit trail from IC approval through funding depends on this.']
  fund_id varchar [note: 'Reference to the pension fund or contributor pool making the capital commitment.']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Portfolio-level capital commitments to infrastructure funds must link to infra_fund_commitment for unfunded commitment tracking, capital call forecasting, and SAA']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Deal attribution reporting requires tracing portfolio commitments to originating opportunities. Investment performance analysis by deal vintage and sourcing channel depends on this link.']
  portfolio_id varchar [note: 'Reference to the portfolio or investment program receiving the capital commitment.']
  re_fund_commitment_id varchar [note: 'Foreign key linking to realestate.re_fund_commitment. Business justification: Pension funds track commitments to real estate funds alongside PE funds. Links portfolio-level commitment tracking to RE fund details for consolidated unfunded commitment']
  asset_class varchar [note: 'Primary asset class category for which the capital is committed.']
  base_currency_committed_amount decimal(20,2) [note: 'Committed amount converted to the pension fund base reporting currency at commitment date Foreign Exchange (FX) rate.']
  base_currency_funded_amount decimal(20,2) [note: 'Funded amount converted to the pension fund base reporting currency using historical Foreign Exchange (FX) rates at each funding date.']
  base_currency_unfunded_amount decimal(20,2) [note: 'Unfunded amount converted to the pension fund base reporting currency at current Foreign Exchange (FX) rate.']
  carried_interest_percent decimal(5,2) [note: 'Percentage of profits above the hurdle rate that the General Partner (GP) receives as performance-based compensation.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code in which the capital commitment is denominated.']
  commitment_date date [note: 'Date on which the capital commitment was formally made and documented, typically the Limited Partnership Agreement (LPA) signing date or Investment Committee (IC) approval date.']
  commitment_notes varchar [note: 'Free-text field for additional context, special terms, conditions, or Investment Committee (IC) stipulations related to the commitment.']
  commitment_period_end_date date [note: 'Date after which no new capital calls can be issued, typically defined in the Limited Partnership Agreement (LPA).']
  commitment_period_start_date date [note: 'Date from which capital calls can begin to be issued against this commitment.']
  commitment_reference_number varchar [note: 'External business identifier for the capital commitment, used in legal documents and Investment Committee (IC) materials.']
  commitment_status varchar [note: 'Current lifecycle state of the capital commitment from approval through funding completion.']
  commitment_type varchar [note: 'Classification of the capital commitment by investment structure and timing.']
  committed_amount decimal(20,2) [note: 'Total capital amount committed to the portfolio or investment program, representing the maximum obligation.']
  counterparty_name varchar [note: 'Legal name of the General Partner (GP), fund manager, or investment vehicle receiving the capital commitment.']
  created_timestamp timestamp [note: 'Timestamp when this capital commitment record was first created in the system.']
  esg_classification varchar [note: 'Environmental, Social, and Governance (ESG) classification or rating of the investment program per Sustainable Finance Disclosure Regulation (SFDR) or internal ESG framework.']
  expected_fund_term_years varchar [note: 'Expected total duration of the fund or investment program in years, including investment period and harvest period.']
  extension_options_years varchar [note: 'Number of additional years the fund term can be extended beyond the base term, as permitted by the Limited Partnership Agreement (LPA).']
  funded_amount decimal(20,2) [note: 'Cumulative capital amount that has been called and funded to date through capital calls or drawdowns.']
  geographic_focus varchar [note: 'Primary geographic region or market focus for the committed capital deployment.']
  hurdle_rate_percent decimal(5,2) [note: 'Minimum return threshold percentage that must be achieved before General Partner (GP) carried interest is earned, also known as preferred return.']
  ic_approval_date date [note: 'Date on which the Investment Committee (IC) formally approved the capital commitment.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) meeting minutes or resolution approving the commitment.']
  investment_strategy varchar [note: 'Detailed description of the investment strategy, mandate, or thesis for which the capital is committed.']
  last_modified_by varchar [note: 'User identifier or name of the person who last modified this capital commitment record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this capital commitment record was last updated or modified.']
  legal_entity_identifier varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the investment vehicle or counterparty receiving the commitment.']
  lpa_document_reference varchar [note: 'Document management system reference or identifier for the executed Limited Partnership Agreement (LPA).']
  lpa_execution_date date [note: 'Date on which the Limited Partnership Agreement (LPA) or equivalent legal commitment document was executed.']
  management_fee_percent decimal(5,2) [note: 'Annual management fee percentage charged by the General Partner (GP) on committed or invested capital.']
  responsible_investment_flag boolean [note: 'Indicates whether the commitment is designated as a responsible investment under Principles for Responsible Investment (PRI) framework.']
  saa_target_allocation_percent decimal(5,2) [note: 'Target allocation percentage for this commitment within the overall Strategic Asset Allocation (SAA) framework.']
  sector_focus varchar [note: 'Primary industry sector or sub-sector focus for the committed capital deployment.']
  target_irr_percent decimal(5,2) [note: 'Target net Internal Rate of Return (IRR) percentage for the investment program as stated in the Investment Memorandum (IM).']
  target_moic decimal(5,2) [note: 'Target Multiple on Invested Capital (MOIC) for the investment program, representing expected total value divided by invested capital.']
  unfunded_amount decimal(20,2) [note: 'Remaining uncalled capital commitment available for future drawdowns, commonly referred to as dry powder in private markets.']
  vintage_year varchar [note: 'Calendar year in which the capital commitment was made, used for cohort analysis and performance benchmarking in private markets.']
  created_by varchar [note: 'User identifier or name of the person who created this capital commitment record.']

  Note: 'Record of capital committed to a portfolio or investment program from the pension fund\'s net contributions and asset allocation decisions. Captures committed amount, funded amount, unfunded (dry powder) balance, commitment currency, commitment date'
}

Table portfolio.portfolio_nav_record {
  portfolio_nav_record_id varchar [pk, note: 'Unique identifier for the NAV record. Primary key for this entity.']
  portfolio_id varchar [note: 'Reference to the portfolio for which this NAV is calculated.']
  valuation_nav_record_id varchar [note: 'Foreign key linking to valuation.valuation_nav_record. Business justification: NAV reconciliation process requires linking portfolio NAV records to valuation-calculated NAVs.']
  accrued_expenses decimal(20,4) [note: 'The total accrued expenses deducted in the NAV calculation, such as management fees and administrative costs.']
  accrued_income decimal(20,4) [note: 'The total accrued income included in the NAV calculation, such as interest and dividends earned but not yet received.']
  administrator_name varchar [note: 'The name of the fund administrator responsible for calculating and reporting the NAV.']
  approval_status varchar [note: 'The approval status of the NAV record by authorized personnel or investment committee.']
  approval_timestamp timestamp [note: 'The date and time when the NAV record was approved.']
  approved_by varchar [note: 'The name or identifier of the person who approved the NAV record.']
  calculation_method varchar [note: 'The methodology used to calculate the NAV, such as mark-to-market, fair value, or administrator-reported.']
  cash_and_equivalents decimal(20,4) [note: 'The total value of cash and cash equivalents held in the portfolio as of the valuation date.']
  contributions decimal(20,4) [note: 'The total contributions or capital inflows into the portfolio during the valuation period.']
  created_timestamp timestamp [note: 'The date and time when this NAV record was first created in the lakehouse.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the NAV is denominated.']
  distributions decimal(20,4) [note: 'The total distributions or capital outflows from the portfolio during the valuation period.']
  fiscal_quarter varchar [note: 'The fiscal quarter within the fiscal year to which this NAV record belongs.']
  fiscal_year varchar [note: 'The fiscal year to which this NAV record belongs.']
  fx_impact decimal(20,4) [note: 'The impact of foreign exchange rate movements on the NAV during the valuation period.']
  gav_amount decimal(20,4) [note: 'The total gross asset value before deducting liabilities, representing the sum of all portfolio holdings at market value.']
  is_active boolean [note: 'Indicates whether this NAV record is the current active record or has been superseded by a restatement.']
  management_fee_accrual decimal(20,4) [note: 'The accrued management fees payable to external managers or internal management, deducted from NAV.']
  modified_timestamp timestamp [note: 'The date and time when this NAV record was last modified in the lakehouse.']
  nav_amount decimal(20,4) [note: 'The total net asset value of the portfolio as of the valuation date, representing total assets minus total liabilities.']
  nav_change_amount decimal(20,4) [note: 'The absolute change in NAV from the prior valuation date to the current valuation date.']
  nav_change_percentage decimal(10,6) [note: 'The percentage change in NAV from the prior valuation date to the current valuation date.']
  nav_per_unit decimal(20,6) [note: 'The NAV per unit or share, calculated as total NAV divided by total units outstanding.']
  nav_status varchar [note: 'The status of the NAV record indicating whether it is preliminary, final, restated, or adjusted.']
  notes varchar [note: 'Additional notes or comments regarding the NAV calculation, variances, or special circumstances.']
  payables decimal(20,4) [note: 'The total value of payables, including pending settlements and other amounts owed by the portfolio.']
  performance_fee_accrual decimal(20,4) [note: 'The accrued performance fees or carried interest payable to external managers, deducted from NAV.']
  prior_nav_amount decimal(20,4) [note: 'The NAV amount from the previous valuation date, used for period-over-period comparison.']
  receivables decimal(20,4) [note: 'The total value of receivables, including pending settlements and other amounts due to the portfolio.']
  reconciliation_status varchar [note: 'The status of the reconciliation process between administrator NAV and internal IBOR NAV.']
  reporting_period varchar [note: 'The frequency or period for which this NAV is reported, such as daily, monthly, or quarterly.']
  source_system_code varchar [note: 'The unique identifier of this NAV record in the source system.']
  total_assets decimal(20,4) [note: 'The total market value of all assets held in the portfolio as of the valuation date.']
  total_liabilities decimal(20,4) [note: 'The total value of all liabilities and obligations of the portfolio as of the valuation date.']
  unfunded_commitments decimal(20,4) [note: 'The total value of unfunded capital commitments to private equity, infrastructure, and other illiquid investments.']
  units_outstanding decimal(20,6) [note: 'The total number of units or shares outstanding as of the valuation date.']
  valuation_date date [note: 'The date as of which the NAV is calculated and reported.']
  valuation_source varchar [note: 'The source system or party that provided the NAV calculation, such as fund administrator, IBOR, or custodian.']
  variance_amount decimal(20,4) [note: 'The difference between administrator-reported NAV and internal IBOR NAV, if any.']
  variance_percentage decimal(10,6) [note: 'The variance expressed as a percentage of the total NAV.']

  Note: 'Net Asset Value (NAV) record for a portfolio as of a specific valuation date, representing the authoritative portfolio-level NAV as calculated by the fund administrator (State Street / Northern Trust) and reconciled against the IBOR.'
}

Table portfolio.portfolio_cash_flow {
  portfolio_cash_flow_id varchar [pk, note: 'Unique identifier for the cash flow record.']
  cash_account_id varchar [note: 'Reference to the bank account used for the cash flow transaction.']
  counterparty_id varchar [note: 'Reference to the counterparty entity involved in the cash flow transaction such as custodian, broker, or fund manager.']
  distribution_id varchar [note: 'Foreign key linking to privateequity.distribution. Business justification: PE distributions create portfolio cash inflows. Linking enables reconciliation between GP distribution notices and portfolio cash records - essential for cash management, NAV']
  fund_id varchar [note: 'Reference to the beneficiary fund pool that contributed or received this cash flow.']
  infra_asset_id varchar [note: 'Foreign key linking to infrastructure.infra_asset. Business justification: Cash flows (distributions, dividends) from direct infrastructure investments require infra_asset reference for cash flow attribution, IRR calculation, and liability matching']
  investment_id varchar [note: 'Reference to the specific investment or position that generated or received this cash flow.']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Deal-level cash flow attribution enables performance measurement by deal vintage and sourcing channel.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this cash flow belongs.']
  privateequity_capital_call_id varchar [note: 'Foreign key linking to privateequity.privateequity_capital_call. Business justification: Capital calls create portfolio cash outflows. Linking enables reconciliation of GP call notices with portfolio cash movements - critical for liquidity forecasting']
  property_id varchar [note: 'Foreign key linking to realestate.property. Business justification: Property-level cash flows (NOI distributions, capex funding, disposition proceeds) must be tracked at portfolio level for liquidity management and performance attribution.']
  accounting_period varchar [note: 'The accounting period in YYYY-MM format to which this cash flow is attributed for financial reporting.']
  accrual_date date [note: 'The date on which the cash flow was accrued for accounting purposes, distinct from settlement date.']
  amount decimal(20,4) [note: 'The monetary amount of the cash flow in the portfolio base currency.']
  approval_date date [note: 'The date on which the cash flow transaction was approved for execution.']
  approval_status varchar [note: 'The approval workflow status for cash flows requiring authorization before execution.']
  approved_by varchar [note: 'The name or identifier of the user who approved the cash flow transaction.']
  asset_class varchar [note: 'The asset class category to which this cash flow is attributed for portfolio allocation and reporting purposes. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|cash|multi_asset — 8 candidates stripped']
  cost_center_code varchar [note: 'The cost center or business unit code for internal allocation and management reporting of fees and expenses.']
  created_timestamp timestamp [note: 'The timestamp when this cash flow record was first created in the data platform.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cash flow amount.']
  custodian_reference varchar [note: 'The custodian-provided reference or confirmation number for the cash flow transaction.']
  flow_direction varchar [note: 'Indicates whether the cash flow is an inflow into the portfolio or an outflow from the portfolio.']
  flow_type varchar [note: 'Classification of the cash flow transaction type indicating the nature of the inflow or outflow. [ENUM-REF-CANDIDATE: contribution|distribution|capital_call|dividend|coupon|fee|fx_settlement|rebalancing|redemption|other — 10 candidates stripped; promote']
  fx_rate decimal(18,8) [note: 'The exchange rate applied to convert the original currency amount to the portfolio base currency.']
  gl_account_code varchar [note: 'The general ledger account code to which this cash flow is posted in the accounting system.']
  is_active boolean [note: 'Boolean flag indicating whether this cash flow record is currently active or has been logically deleted or superseded.']
  is_external boolean [note: 'Boolean flag indicating whether the cash flow is external to the portfolio or an internal reallocation.']
  is_significant boolean [note: 'Boolean flag indicating whether the cash flow exceeds the significance threshold for performance calculation adjustments per GIPS standards.']
  modified_timestamp timestamp [note: 'The timestamp when this cash flow record was last modified or updated in the data platform.']
  notes varchar [note: 'Additional free-text notes or comments regarding the cash flow transaction for operational or audit purposes.']
  original_amount decimal(20,4) [note: 'The cash flow amount in its original transaction currency before any foreign exchange conversion.']
  original_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the original transaction amount before conversion.']
  payment_method varchar [note: 'The payment instrument or mechanism used to execute the cash flow transaction.']
  portfolio_cash_flow_description varchar [note: 'Detailed narrative description of the cash flow transaction including purpose and context.']
  portfolio_cash_flow_status varchar [note: 'Current lifecycle status of the cash flow transaction indicating its processing state.']
  reclaim_eligible_flag boolean [note: 'Boolean flag indicating whether the withholding tax on this cash flow is eligible for reclaim under applicable tax treaties.']
  reconciliation_date date [note: 'The date on which the cash flow was successfully reconciled with external records.']
  reconciliation_status varchar [note: 'The reconciliation status indicating whether the cash flow has been matched and verified against custodian or bank statements.']
  settlement_date date [note: 'The date on which the cash flow was settled and funds were transferred.']
  significance_threshold_percent decimal(5,2) [note: 'The percentage threshold used to determine if this cash flow is significant relative to portfolio NAV for performance calculation purposes.']
  source_system_code varchar [note: 'The unique identifier for this cash flow record in the source operational system.']
  tax_treatment varchar [note: 'Classification of the tax treatment applicable to this cash flow for tax reporting and compliance purposes.']
  transaction_date date [note: 'The date on which the cash flow transaction occurred or was executed.']
  transaction_reference varchar [note: 'External reference number or identifier for the cash flow transaction from the source system.']
  value_date date [note: 'The effective date for valuation and performance calculation purposes, used in time-weighted return calculations.']
  withholding_tax_amount decimal(20,4) [note: 'The amount of withholding tax deducted from the cash flow at source, if applicable.']
  withholding_tax_rate_percent decimal(5,2) [note: 'The withholding tax rate percentage applied to the cash flow transaction.']

  Note: 'Portfolio-level cash flow record capturing all inflows and outflows at the portfolio level including net contributions received, capital calls paid, distributions received, dividend and coupon income, management fees paid, FX settlements, and'
}

Table portfolio.mandate_history {
  mandate_history_id varchar [pk, note: 'Unique identifier for each mandate history audit record tracking changes to portfolio mandate parameters over time.']
  mandate_new_benchmark_portfolio_benchmark_id varchar [note: 'Reference to the benchmark assignment that became effective with this change, supporting performance measurement and attribution reporting.']
  mandate_portfolio_benchmark_id varchar [note: 'Reference to the benchmark assignment that was in effect before this change, enabling audit trail of benchmark transitions for performance attribution analysis.']
  portfolio_id varchar [note: 'Reference to the portfolio whose mandate parameters were changed in this history record.']
  portfolio_mandate_id varchar [note: 'Foreign key linking to portfolio.portfolio_mandate. Business justification: mandate_history tracks changes to portfolio mandates over time. It currently has portfolio_id but lacks a direct FK to the specific portfolio_mandate being tracked.']
  superseded_by_history_mandate_history_id varchar [note: 'Reference to the subsequent mandate history record that replaced this change, enabling navigation through the complete audit trail of mandate parameter evolution.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee (IC) member or approval authority who authorized this mandate parameter change, supporting governance and accountability requirements.']
  change_effective_date date [note: 'Date when the mandate parameter change became effective and binding for portfolio management and reporting purposes.']
  change_impact_assessment varchar [note: 'Analysis of the expected impact of this mandate change on portfolio construction, risk profile, performance attribution, and operational processes, supporting Investment Committee (IC) decision-making.']
  change_notes varchar [note: 'Additional commentary, context, and operational details regarding this mandate parameter change, capturing institutional knowledge and supporting future audit reviews.']
  change_reason varchar [note: 'Business rationale and justification for the mandate parameter change, including strategic drivers, regulatory requirements, or Investment Committee (IC) directives.']
  change_status varchar [note: 'Current lifecycle status of the mandate change: proposed for review, approved by Investment Committee (IC), implemented in portfolio management systems, superseded by subsequent change, or cancelled before implementation.']
  change_type varchar [note: 'Classification of the mandate change event: Strategic Asset Allocation (SAA) target revision, benchmark assignment change, investment constraint amendment, currency hedging policy update, mandate scope expansion, or mandate scope restriction.']
  created_timestamp timestamp [note: 'Timestamp when this mandate history record was first created in the data platform, supporting data lineage and audit trail requirements.']
  ic_approval_date date [note: 'Date when the Investment Committee (IC) formally approved this mandate parameter change, establishing governance audit trail and authorization for implementation.']
  ic_approval_reference varchar [note: 'Investment Committee (IC) meeting reference number or Investment Memorandum (IM) identifier documenting the formal approval of this mandate change for governance and audit purposes.']
  implementation_date date [note: 'Date when the mandate parameter change was operationally implemented in portfolio management systems, Investment Book of Record (IBOR), and compliance monitoring platforms.']
  modified_timestamp timestamp [note: 'Timestamp when this mandate history record was last modified in the data platform, tracking updates to change status, approval information, or implementation details.']
  new_asset_class_scope varchar [note: 'Permitted asset classes and investment universe that became effective with this change, defining eligible public equities, private equity, real estate, infrastructure, natural resources, and credit investments.']
  new_constraint_type varchar [note: 'Classification of the investment constraint that became effective with this change, such as concentration limit, sector exposure cap, credit quality floor, or liquidity requirement.']
  new_constraint_value decimal(18,2) [note: 'Specific parameter value or threshold of the investment constraint that became effective with this change, stored as text to accommodate various constraint formats.']
  new_currency_policy varchar [note: 'Foreign exchange (FX) hedging policy and currency exposure management approach that became effective with this change, including hedging ratios and permitted instruments.']
  new_esg_framework varchar [note: 'Environmental, Social, and Governance (ESG) integration framework and responsible investment approach that became effective with this change, including Principles for Responsible Investment (PRI) commitments and exclusion policies.']
  new_rebalancing_frequency varchar [note: 'Portfolio rebalancing schedule and frequency that became effective with this change, defining how often Strategic Asset Allocation (SAA) targets are restored through trading activity.']
  new_saa_target_weight decimal(10,6) [note: 'Strategic Asset Allocation (SAA) target weight percentage that became effective with this change, expressed as decimal proportion for portfolio construction and rebalancing.']
  new_tolerance_band_lower decimal(10,6) [note: 'Lower boundary of the Strategic Asset Allocation (SAA) tolerance band that became effective with this change, expressed as decimal proportion below target weight for rebalancing triggers.']
  new_tolerance_band_upper decimal(10,6) [note: 'Upper boundary of the Strategic Asset Allocation (SAA) tolerance band that became effective with this change, expressed as decimal proportion above target weight for rebalancing triggers.']
  previous_asset_class_scope varchar [note: 'Permitted asset classes and investment universe that was in effect before this change, defining eligible public equities, private equity, real estate, infrastructure, natural resources, and credit investments.']
  previous_constraint_type varchar [note: 'Classification of the investment constraint that was in effect before this change, such as concentration limit, sector exposure cap, credit quality floor, or liquidity requirement.']
  previous_constraint_value decimal(18,2) [note: 'Specific parameter value or threshold of the investment constraint that was in effect before this change, stored as text to accommodate various constraint formats.']
  previous_currency_policy varchar [note: 'Foreign exchange (FX) hedging policy and currency exposure management approach that was in effect before this change, including hedging ratios and permitted instruments.']
  previous_esg_framework varchar [note: 'Environmental, Social, and Governance (ESG) integration framework and responsible investment approach that was in effect before this change, including Principles for Responsible Investment (PRI) commitments and exclusion policies.']
  previous_rebalancing_frequency varchar [note: 'Portfolio rebalancing schedule and frequency that was in effect before this change, defining how often Strategic Asset Allocation (SAA) targets are restored through trading activity.']
  previous_saa_target_weight decimal(10,6) [note: 'Strategic Asset Allocation (SAA) target weight percentage that was in effect before this change, expressed as decimal proportion for audit and rebalancing analysis.']
  previous_tolerance_band_lower decimal(10,6) [note: 'Lower boundary of the Strategic Asset Allocation (SAA) tolerance band that was in effect before this change, expressed as decimal proportion below target weight.']
  previous_tolerance_band_upper decimal(10,6) [note: 'Upper boundary of the Strategic Asset Allocation (SAA) tolerance band that was in effect before this change, expressed as decimal proportion above target weight.']
  regulatory_reference varchar [note: 'Citation of the specific regulatory requirement, the national pension regulator, guideline, or pension regulation that necessitated this mandate parameter change.']
  regulatory_trigger_flag boolean [note: 'Indicator whether this mandate change was triggered by regulatory requirements, such as the national pension regulator, directives, Sustainable Finance Disclosure Regulation (SFDR) compliance, or pension regulation updates.']
  source_system_code varchar [note: 'Unique identifier of this mandate history record in the source operational system, enabling traceability and reconciliation with upstream systems of record.']
  stakeholder_notification_date date [note: 'Date when beneficiaries, external managers, custodians, and other stakeholders were formally notified of this mandate parameter change, supporting transparency and communication requirements.']
  superseded_date date [note: 'Date when this mandate change was replaced or overridden by a subsequent mandate parameter revision, establishing temporal validity for historical analysis.']
  version_number varchar [note: 'Sequential version number of the mandate parameter set, incrementing with each approved change to support version control and audit trail reconstruction.']

  Note: 'Audit history record tracking all changes to portfolio mandate parameters over time, including SAA target revisions, benchmark changes, constraint amendments, currency policy updates, and mandate scope expansions or restrictions.'
}

Table portfolio.sleeve {
  sleeve_id varchar [pk, note: 'Unique identifier for the portfolio sleeve record.']
  composite_id varchar [note: 'Reference to the performance composite to which this sleeve belongs for Global Investment Performance Standards (GIPS) reporting.']
  credit_mandate_id varchar [note: 'Foreign key linking to credit.credit_mandate. Business justification: Credit sleeves within multi-asset portfolios require dedicated credit mandates specifying duration limits, credit quality minimums, and sector constraints.']
  employee_id varchar [note: 'Reference to the external manager or internal team responsible for managing this sleeve.']
  gp_profile_id varchar [note: 'Reference to the external manager or internal team responsible for managing this sleeve.']
  pe_fund_id varchar [note: 'Foreign key linking to privateequity.fund. Business justification: Portfolio sleeves allocate to specific PE funds for sub-portfolio construction. Investment teams track PE fund exposure within sleeves for rebalancing decisions and asset allocation']
  portfolio_benchmark_id varchar [note: 'Reference to the benchmark index used to measure performance of this sleeve.']
  portfolio_id varchar [note: 'Reference to the parent portfolio to which this sleeve belongs.']
  actual_allocation_amount decimal(20,2) [note: 'Current actual allocation amount in base currency for this sleeve.']
  actual_allocation_weight_percent decimal(7,4) [note: 'Current actual allocation weight as a percentage of the parent portfolio.']
  approval_authority varchar [note: 'Name or role of the authority that approved the establishment or modification of this sleeve (e.g., Investment Committee, CIO).']
  asset_class_code varchar [note: 'Primary asset class code assigned to this sleeve (e.g., public equities, private equity, real estate, infrastructure, natural resources, credit).']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the base currency for this sleeve.']
  created_timestamp timestamp [note: 'Timestamp when this sleeve record was first created in the system.']
  effective_from_date date [note: 'Date from which the current sleeve configuration is effective.']
  effective_to_date date [note: 'Date until which the current sleeve configuration is effective; null for open-ended sleeves.']
  esg_framework varchar [note: 'Name of the Environmental, Social, and Governance (ESG) framework applied to this sleeve (e.g., PRI, TCFD, SFDR).']
  esg_integration_flag boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) criteria are integrated into the investment process for this sleeve.']
  exclusion_list_applied_flag boolean [note: 'Indicates whether an investment exclusion list (e.g., tobacco, weapons, fossil fuels) is applied to this sleeve.']
  gips_compliant_flag boolean [note: 'Indicates whether this sleeve is managed and reported in compliance with Global Investment Performance Standards (GIPS).']
  ic_approval_date date [note: 'Date when the Investment Committee (IC) approved the establishment or modification of this sleeve.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) approval decision related to this sleeve.']
  inception_date date [note: 'Date when the sleeve was established and became operational.']
  last_rebalance_date date [note: 'Date when the sleeve was last rebalanced.']
  leverage_limit_percent decimal(7,4) [note: 'Maximum allowable leverage for this sleeve, expressed as a percentage of Net Asset Value (NAV).']
  liquidity_requirement_days varchar [note: 'Minimum number of days within which the sleeve must be able to liquidate positions to meet cash requirements.']
  modified_timestamp timestamp [note: 'Timestamp when this sleeve record was last modified.']
  next_rebalance_date date [note: 'Scheduled date for the next rebalancing of this sleeve.']
  notes varchar [note: 'Additional operational or administrative notes related to the sleeve.']
  performance_attribution_flag boolean [note: 'Indicates whether performance attribution analysis is performed at the sleeve level.']
  performance_calculation_method varchar [note: 'Method used to calculate performance for this sleeve: Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), or Multiple on Invested Capital (MOIC).']
  rebalancing_frequency varchar [note: 'Scheduled frequency at which this sleeve is reviewed and rebalanced.']
  rebalancing_required_flag boolean [note: 'Indicates whether rebalancing is currently required based on threshold breach or scheduled review.']
  rebalancing_threshold_lower_percent decimal(7,4) [note: 'Lower threshold percentage that triggers rebalancing action when actual weight falls below this level.']
  rebalancing_threshold_upper_percent decimal(7,4) [note: 'Upper threshold percentage that triggers rebalancing action when actual weight exceeds this level.']
  reporting_inclusion_flag boolean [note: 'Indicates whether this sleeve is included in consolidated portfolio reporting and performance attribution.']
  risk_budget_percent decimal(7,4) [note: 'Percentage of the total portfolio risk budget allocated to this sleeve.']
  sleeve_code varchar [note: 'Externally-known unique business code for the sleeve, used for reporting and operational reference.']
  sleeve_description varchar [note: 'Detailed textual description of the sleeves purpose, strategy, and investment objectives.']
  sleeve_name varchar [note: 'Human-readable name of the sleeve, describing its purpose or strategy.']
  sleeve_status varchar [note: 'Current lifecycle status of the sleeve.']
  sleeve_type varchar [note: 'Classification of the sleeve by its organizational purpose: asset class sleeve, strategy sleeve, manager sleeve, geographic sleeve, sector sleeve, or thematic sleeve.']
  source_system_code varchar [note: 'Unique identifier for this sleeve in the source system.']
  strategy_name varchar [note: 'Name of the investment strategy employed within this sleeve (e.g., value, growth, core-plus, opportunistic).']
  sub_asset_class_code varchar [note: 'Granular sub-asset class code for further classification within the primary asset class.']
  taa_adjustment_weight_percent decimal(7,4) [note: 'Tactical Asset Allocation (TAA) adjustment applied to the Strategic Asset Allocation (SAA) target weight, expressed as percentage points.']
  target_allocation_amount decimal(20,2) [note: 'Target allocation amount in base currency for this sleeve as per Strategic Asset Allocation (SAA).']
  target_allocation_weight_percent decimal(7,4) [note: 'Target allocation weight as a percentage of the parent portfolio, per Strategic Asset Allocation (SAA).']
  termination_date date [note: 'Date when the sleeve was closed or terminated.']
  tolerance_band_lower_percent decimal(7,4) [note: 'Lower bound of the tolerance band for allocation weight, expressed as percentage points below target.']
  tolerance_band_upper_percent decimal(7,4) [note: 'Upper bound of the tolerance band for allocation weight, expressed as percentage points above target.']
  tracking_error_limit_bps varchar [note: 'Maximum allowable tracking error for this sleeve relative to its benchmark, expressed in basis points.']
  var_limit_percent decimal(7,4) [note: 'Maximum allowable Value at Risk (VaR) for this sleeve, expressed as a percentage of sleeve value.']

  Note: 'Master record for a portfolio sleeve — a ring-fenced sub-allocation within a portfolio dedicated to a specific asset class, strategy, or manager mandate. Captures sleeve name, sleeve type (asset class sleeve, manager sleeve, strategy sleeve), target'
}

Table portfolio.currency_exposure {
  currency_exposure_id varchar [pk, note: 'Unique identifier for the currency exposure record.']
  hedge_counterparty_id varchar [note: 'Reference to the counterparty providing the hedging instruments for this currency exposure.']
  portfolio_id varchar [note: 'Reference to the portfolio for which currency exposure is measured.']
  approval_date date [note: 'The date on which the currency exposure or hedging strategy was approved.']
  approval_status varchar [note: 'The approval status of the currency exposure record or hedging strategy by the Investment Committee or risk management team.']
  approved_by varchar [note: 'The name or identifier of the individual or committee that approved the currency exposure or hedging strategy.']
  asset_class_code varchar [note: 'The asset class contributing to the foreign currency exposure, such as equities, fixed income, real estate, or private equity.']
  base_currency_code varchar [note: 'The reporting currency of the portfolio, expressed as ISO 4217 three-letter code.']
  comments varchar [note: 'Additional notes or commentary regarding the currency exposure, hedging strategy, or policy breaches.']
  created_timestamp timestamp [note: 'The timestamp when the currency exposure record was first created in the system.']
  data_source_record_reference varchar [note: 'The unique identifier of this currency exposure record in the source system.']
  data_source_system varchar [note: 'The operational system from which the currency exposure data was sourced, such as SimCorp Dimension, Aladdin, or State Street.']
  dv01_amount decimal(20,2) [note: 'The sensitivity of the currency exposure to a one basis point change in foreign exchange rates, expressed in base currency.']
  exposure_status varchar [note: 'Current status of the currency exposure record in the portfolio monitoring lifecycle.']
  exposure_type varchar [note: 'Classification of the currency exposure: transaction exposure from cash flows, translation exposure from asset valuation, or economic exposure from market conditions.']
  foreign_currency_code varchar [note: 'The foreign currency to which the portfolio has exposure, expressed as ISO 4217 three-letter code.']
  fx_forward_rate decimal(18,6) [note: 'The forward exchange rate used for hedging contracts, if applicable.']
  fx_spot_rate decimal(18,6) [note: 'The spot exchange rate between the foreign currency and base currency as of the valuation date.']
  geographic_region varchar [note: 'The geographic region or market where the foreign currency exposure originates.']
  gross_exposure_amount decimal(20,2) [note: 'Total unhedged exposure to the foreign currency before any hedging instruments are applied, expressed in base currency.']
  hedge_cost_bps decimal(8,2) [note: 'The annualized cost of hedging the foreign currency exposure, expressed in basis points.']
  hedge_effectiveness_percent decimal(5,2) [note: 'The effectiveness of the hedging strategy in offsetting foreign currency risk, measured as a percentage.']
  hedge_instrument_type varchar [note: 'The type of derivative or hedging instrument used to manage the foreign currency exposure.']
  hedge_maturity_date date [note: 'The maturity or expiration date of the hedging instruments covering this currency exposure.']
  hedge_ratio_percent decimal(5,2) [note: 'The percentage of gross foreign currency exposure that is hedged through FX derivatives or other hedging instruments.']
  hedged_notional_amount decimal(20,2) [note: 'The notional amount of foreign currency exposure covered by hedging instruments, expressed in base currency.']
  last_modified_by varchar [note: 'The user or system that last modified the currency exposure record.']
  last_modified_timestamp timestamp [note: 'The timestamp when the currency exposure record was last updated.']
  mtm_gain_loss_amount decimal(20,2) [note: 'The unrealized gain or loss on the currency exposure due to foreign exchange rate movements since the prior valuation date, expressed in base currency.']
  net_exposure_amount decimal(20,2) [note: 'The residual unhedged foreign currency exposure after hedging instruments are applied, expressed in base currency.']
  policy_breach_flag boolean [note: 'Indicates whether the current currency exposure exceeds the policy limit.']
  policy_limit_amount decimal(20,2) [note: 'The maximum allowable foreign currency exposure for this currency as defined by the investment policy, expressed in base currency.']
  realized_gain_loss_amount decimal(20,2) [note: 'The realized gain or loss from settled foreign currency transactions during the reporting period, expressed in base currency.']
  rebalancing_required_flag boolean [note: 'Indicates whether rebalancing or additional hedging is required to bring the exposure within policy limits.']
  reporting_frequency varchar [note: 'The frequency at which currency exposure is measured and reported for this portfolio.']
  stress_test_impact_amount decimal(20,2) [note: 'The estimated impact on portfolio value under the stress test scenario, expressed in base currency.']
  stress_test_scenario varchar [note: 'The stress test scenario applied to assess the impact of extreme foreign exchange rate movements on this exposure.']
  valuation_date date [note: 'The date on which the currency exposure is measured and reported.']
  var_contribution_amount decimal(20,2) [note: 'The contribution of this currency exposure to the overall portfolio Value at Risk, expressed in base currency.']

  Note: 'Portfolio-level currency exposure record capturing the unhedged and hedged foreign currency exposures as of a valuation date. Records base currency, foreign currency, gross exposure amount, hedge ratio, hedged notional, net unhedged exposure, and FX'
}

Table portfolio.liquidity_bucket {
  liquidity_bucket_id varchar [pk, note: 'Unique identifier for the liquidity bucket classification record.']
  holding_snapshot_id varchar [note: 'Reference to the specific holding snapshot being classified for liquidity.']
  listed_security_id varchar [note: 'Reference to the security being classified for liquidity analysis.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this liquidity classification applies.']
  asset_class varchar [note: 'The asset class of the holding being classified (public equities, private equity, real estate, infrastructure, natural resources, credit).']
  average_daily_volume decimal(18,2) [note: 'Average daily trading volume for the security over the measurement period, used to assess liquidity.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the portfolios base currency.']
  bid_ask_spread_bps decimal(10,2) [note: 'The bid-ask spread expressed in basis points, indicating transaction cost and liquidity tightness.']
  bucket_weight_percent decimal(8,4) [note: 'The cumulative weight of all holdings in this liquidity tier as a percentage of total portfolio value.']
  classification_date date [note: 'The date on which this liquidity classification was determined.']
  classification_methodology varchar [note: 'The methodology or framework used to determine the liquidity classification (internal model, vendor model, regulatory framework).']
  classification_source varchar [note: 'The source of the liquidity classification determination.']
  classification_status varchar [note: 'Current status of the liquidity classification record in its lifecycle.']
  created_timestamp timestamp [note: 'Timestamp when this liquidity classification record was first created in the system.']
  effective_from_date date [note: 'The date from which this liquidity classification becomes effective.']
  effective_to_date date [note: 'The date until which this liquidity classification remains effective, null for current classifications.']
  estimated_liquidation_days varchar [note: 'Estimated number of days required to fully liquidate the position without significant market impact.']
  gate_provision_flag boolean [note: 'Indicates whether the investment is subject to gate provisions that can restrict redemptions during stressed market conditions.']
  haircut_percent decimal(8,4) [note: 'The haircut percentage applied to the market value for liquidity calculations, reflecting potential value loss in rapid liquidation.']
  hqla_category varchar [note: 'The HQLA category classification (Level 1, Level 2A, Level 2B, or Non-HQLA) under Basel III.']
  hqla_eligible_flag boolean [note: 'Indicates whether the holding qualifies as a High-Quality Liquid Asset under Basel III Liquidity Coverage Ratio (LCR) requirements.']
  instrument_type varchar [note: 'The specific instrument type of the security (equity, bond, derivative, fund unit, real asset).']
  last_review_date date [note: 'The date on which this liquidity classification was last reviewed.']
  liquidation_cost_percent decimal(8,4) [note: 'Estimated cost of liquidation expressed as a percentage of market value, including transaction costs and market impact.']
  liquidity_tier varchar [note: 'The liquidity tier classification indicating the time horizon for converting the holding to cash without significant price impact. [ENUM-REF-CANDIDATE: T+0|T+1|T+2|T+5|T+30|T+90|T+180|illiquid|locked — promote to reference product]']
  liquidity_tier_code varchar [note: 'Internal code representing the liquidity tier for system processing and reporting.']
  liquidity_tier_description varchar [note: 'Detailed description of the liquidity tier classification and its business meaning.']
  lock_up_period_end_date date [note: 'The date on which any lock-up or restriction on redemption expires, after which the holding becomes more liquid.']
  market_depth_indicator varchar [note: 'Qualitative assessment of the market depth and trading volume available for this holding.']
  market_value_base_currency decimal(20,2) [note: 'Current market value of the holding in the portfolios base currency, used for liquidity weighting.']
  modified_timestamp timestamp [note: 'Timestamp when this liquidity classification record was last modified.']
  next_review_date date [note: 'The scheduled date for the next review of this liquidity classification.']
  notes varchar [note: 'Additional notes or comments regarding the liquidity classification, including special considerations or assumptions.']
  override_approval_date date [note: 'Date on which the liquidity classification override was approved.']
  override_approved_by varchar [note: 'Name or identifier of the individual who approved the liquidity classification override.']
  override_flag boolean [note: 'Indicates whether the liquidity classification was manually overridden from the system-generated classification.']
  override_reason varchar [note: 'Business justification for any manual override of the liquidity classification.']
  redemption_notice_days varchar [note: 'Number of days advance notice required to redeem or liquidate the holding, applicable to private markets and fund investments.']
  regulatory_classification varchar [note: 'Liquidity classification as defined by regulatory frameworks such as Basel III or local pension regulations.']
  review_frequency_days varchar [note: 'The frequency in days at which this liquidity classification should be reviewed and updated.']
  side_pocket_flag boolean [note: 'Indicates whether the holding is held in a side pocket, making it illiquid until realization.']
  source_system_code varchar [note: 'The unique identifier for this liquidity classification record in the source system.']
  stress_scenario_tier varchar [note: 'The liquidity tier classification under stressed market conditions, used for stress testing and scenario analysis.']
  weight_percent decimal(8,4) [note: 'The weight of this holding as a percentage of total portfolio value, used for liquidity concentration analysis.']

  Note: 'Portfolio liquidity classification record bucketing holdings into liquidity tiers (T+0, T+1, T+2, T+5, T+30, T+90, T+180, illiquid/locked) based on instrument type, market depth, and redemption terms.'
}

Table portfolio.portfolio_ic_approval {
  portfolio_ic_approval_id varchar [pk, note: 'Unique identifier for the Investment Committee approval record for portfolio-level decisions.']
  coinvestment_id varchar [note: 'Foreign key linking to privateequity.coinvestment. Business justification: Co-investments require separate IC approval with distinct terms. Linking approval to coinvestment record enables governance tracking, fee analysis, and performance attribution for']
  diligence_ic_submission_id varchar [note: 'Foreign key linking to diligence.diligence_ic_submission. Business justification: Portfolio IC approvals for new investments reference the diligence IC submission that cleared the investment.']
  ic_meeting_id varchar [note: 'Reference to the specific Investment Committee meeting where this approval was granted or denied.']
  pe_fund_id varchar [note: 'Foreign key linking to privateequity.fund. Business justification: Investment Committee approvals for PE fund commitments must reference the specific fund.']
  pe_investment_id varchar [note: 'Foreign key linking to privateequity.investment. Business justification: IC approvals for direct PE investments require linking to the specific investment record.']
  portfolio_id varchar [note: 'Reference to the portfolio subject to this Investment Committee approval decision.']
  approval_reference_number varchar [note: 'Externally-known unique reference number assigned to this Investment Committee approval for tracking and audit purposes.']
  approval_type varchar [note: 'Category of portfolio-level decision requiring Investment Committee approval. [ENUM-REF-CANDIDATE: saa_change|taa_adjustment|mandate_approval|benchmark_change|rebalancing_authorization|capital_commitment|policy_exception — 7 candidates stripped; promote']
  approved_by varchar [note: 'Name or identifier of the Investment Committee Chair or authorized signatory who approved the decision.']
  capital_commitment_amount decimal(20,2) [note: 'Total capital commitment amount requiring Investment Committee approval, if applicable to this decision.']
  capital_commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the capital commitment amount.']
  chair_approval_flag boolean [note: 'Indicates whether the Investment Committee Chair formally approved the decision.']
  compliance_review_status varchar [note: 'Status of compliance department review of the proposal prior to Investment Committee consideration.']
  conditions_of_approval varchar [note: 'Specific conditions, restrictions, or requirements attached to the Investment Committee approval, if any.']
  created_timestamp timestamp [note: 'Timestamp when this Investment Committee approval record was first created in the system.']
  decision_date date [note: 'Date when the Investment Committee formally rendered its decision on this portfolio matter.']
  decision_status varchar [note: 'Current status of the Investment Committee decision on this portfolio matter.']
  deferral_reason varchar [note: 'Explanation for why the Investment Committee deferred the decision to a future meeting, if applicable.']
  effective_date date [note: 'Date from which the approved portfolio change becomes effective and operational.']
  esg_framework varchar [note: 'Name of the ESG framework or standard applied in evaluating this portfolio proposal.']
  esg_integration_flag boolean [note: 'Indicates whether the proposed portfolio change incorporates Environmental, Social, and Governance integration requirements.']
  expected_return_impact_percent decimal(10,4) [note: 'Projected impact on portfolio expected return resulting from the proposed change, expressed as a percentage.']
  expected_risk_impact_percent decimal(10,4) [note: 'Projected impact on portfolio risk level resulting from the proposed change, expressed as a percentage.']
  expiry_date date [note: 'Date when the Investment Committee approval expires and requires renewal or review, if applicable.']
  im_document_reference varchar [note: 'Reference identifier for the Investment Memorandum document supporting this Investment Committee submission.']
  legal_review_status varchar [note: 'Status of legal department review of the proposal prior to Investment Committee consideration.']
  meeting_date date [note: 'Date of the Investment Committee meeting where this portfolio decision was reviewed.']
  modified_timestamp timestamp [note: 'Timestamp when this Investment Committee approval record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next Investment Committee review of this portfolio matter, if deferred or requiring periodic review.']
  policy_exception_flag boolean [note: 'Indicates whether this approval involves an exception to established investment policy guidelines.']
  policy_exception_rationale varchar [note: 'Detailed justification for requesting an exception to investment policy, if applicable.']
  proposal_summary varchar [note: 'Executive summary of the portfolio proposal outlining key objectives, rationale, and expected outcomes.']
  proposal_title varchar [note: 'Concise title or name of the portfolio proposal submitted for Investment Committee approval.']
  proposed_benchmark_code varchar [note: 'Code or identifier of the proposed new benchmark for the portfolio, if this approval involves a benchmark change.']
  proposed_mandate_type varchar [note: 'Type of investment mandate being proposed for approval, if this approval involves a new or modified mandate.']
  proposed_saa_change_description varchar [note: 'Detailed description of proposed changes to Strategic Asset Allocation targets, if applicable to this approval.']
  proposed_taa_change_description varchar [note: 'Detailed description of proposed Tactical Asset Allocation adjustments, if applicable to this approval.']
  quorum_met_flag boolean [note: 'Indicates whether the required quorum of Investment Committee members was present for the decision to be valid.']
  rebalancing_threshold_lower_percent decimal(10,4) [note: 'Lower tolerance band threshold triggering portfolio rebalancing, if this approval involves rebalancing parameters.']
  rebalancing_threshold_upper_percent decimal(10,4) [note: 'Upper tolerance band threshold triggering portfolio rebalancing, if this approval involves rebalancing parameters.']
  rejection_reason varchar [note: 'Detailed explanation for why the Investment Committee rejected the proposal, if applicable.']
  risk_assessment_summary varchar [note: 'Summary of risk analysis conducted on the proposed portfolio change, including impact on portfolio risk metrics and stress test results.']
  strategic_rationale varchar [note: 'Strategic justification for the proposed portfolio change, including alignment with long-term investment objectives and liability-driven investment strategy.']
  submission_date date [note: 'Date when the proposal was formally submitted to the Investment Committee for review.']
  supporting_analysis_reference varchar [note: 'Reference to supporting analytical materials, models, or research reports submitted with the proposal.']
  tracking_error_impact_bps decimal(10,2) [note: 'Projected change in tracking error relative to benchmark resulting from the proposed portfolio change, measured in basis points.']
  var_impact_percent decimal(10,4) [note: 'Projected change in portfolio Value at Risk resulting from the proposed change, expressed as a percentage.']
  votes_abstained varchar [note: 'Number of Investment Committee members who abstained from voting on the proposal.']
  votes_against varchar [note: 'Number of Investment Committee members who voted against the proposal.']
  votes_in_favor varchar [note: 'Number of Investment Committee members who voted in favor of the proposal.']
  voting_outcome_summary varchar [note: 'Summary of Investment Committee voting results including votes in favor, against, and abstentions.']

  Note: 'Investment Committee (IC) approval record for portfolio-level decisions including SAA changes, new mandate approvals, rebalancing authorizations, benchmark changes, and capital commitment approvals.'
}

Table portfolio.portfolio_allocation {
  portfolio_allocation_id varchar [pk, note: 'Primary key for the allocation association']
  opportunity_id varchar [note: 'Foreign key linking to the investment opportunity being allocated']
  portfolio_id varchar [note: 'Foreign key linking to the investment portfolio receiving the allocation']
  percentage decimal(8,4) [note: 'Percentage of the total opportunity investment amount allocated to this portfolio. Sum of percentages across all portfolios for one opportunity should equal 100%.']
  portfolio_allocation_date date [note: 'Date when the allocation was formally approved and recorded. Used for tracking allocation timing relative to deal close.']
  portfolio_allocation_status varchar [note: 'Current lifecycle status of the allocation in the approval workflow. Tracks progression from proposal through IC approval to funding.']
  rationale varchar [note: 'Business justification for why this portfolio was selected to participate in this opportunity. Documents strategic fit, mandate alignment, and capacity considerations.']

  Note: 'This association product represents the Allocation event between portfolio and opportunity. It captures the formal assignment of capital from a specific investment portfolio to a specific investment opportunity, including the percentage of the deal'
}

Table portfolio.asset {
  asset_id varchar [pk, note: 'Primary key for asset']
  custodian_id varchar [note: 'Reference to the custodian bank or institution holding the asset on behalf of the pension fund.']
  equity_issuer_id varchar [note: 'Reference to the entity that issued or originated the asset for counterparty risk management.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for performance comparison and attribution analysis.']
  acquisition_date date [note: 'Date when the pension fund first acquired or invested in this asset.']
  asset_class varchar [note: 'Primary classification of the asset by broad investment category for portfolio construction and risk management.']
  asset_description varchar [note: 'Detailed narrative description of the asset including key terms and investment characteristics.']
  asset_name varchar [note: 'Human-readable name or title of the asset as recognized in investment operations and reporting.']
  asset_status varchar [note: 'Current lifecycle state of the asset indicating its operational status within the portfolio.']
  asset_sub_type varchar [note: 'Granular classification providing detailed categorization within the asset type for specialized analysis.']
  asset_type varchar [note: 'Secondary classification within the asset class defining the specific instrument or investment structure type.']
  bloomberg_ticker varchar [note: 'Bloomberg terminal ticker symbol used for market data retrieval and trading operations.']
  book_value decimal(18,4) [note: 'Historical cost basis or amortized cost of the asset for accounting and performance measurement purposes.']
  carbon_intensity decimal(12,4) [note: 'Tonnes of CO2 equivalent emissions per million dollars of revenue for climate risk assessment.']
  country_of_domicile varchar [note: 'ISO 3166-1 alpha-3 country code where the asset issuer or entity is legally domiciled.']
  country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary country of risk exposure for the asset.']
  coupon_rate decimal(8,5) [note: 'Annual interest rate paid on fixed income securities expressed as a percentage of face value.']
  credit_rating varchar [note: 'Credit quality rating assigned by major rating agencies (S&P, Moodys, Fitch) for fixed income assets.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code representing the assets base or denomination currency.']
  cusip varchar [note: '9-character alphanumeric identifier for North American securities assigned by CUSIP Global Services.']
  duration_years decimal(8,4) [note: 'Measure of interest rate sensitivity indicating the percentage price change for a 1% change in yield.']
  esg_score decimal(5,2) [note: 'Composite ESG rating score reflecting environmental, social, and governance risk factors.']
  exchange_code varchar [note: 'Market Identifier Code (MIC) of the primary exchange where the asset is traded per ISO 10383.']
  fair_value_hierarchy varchar [note: 'IFRS 13 fair value hierarchy classification based on observability of valuation inputs.']
  identifier varchar [note: 'Primary external business identifier used to reference the asset across systems and counterparties.']
  inception_date date [note: 'Date when the asset was first issued or created in the market.']
  industry_group varchar [note: 'GICS industry group classification providing more granular sector categorization for analysis.']
  investment_strategy varchar [note: 'Strategic classification indicating the investment approach or mandate under which the asset is held.']
  is_hedged boolean [note: 'Indicates whether the asset position has associated currency or interest rate hedging in place.']
  is_listed boolean [note: 'Indicates whether the asset is publicly listed and traded on a recognized exchange.']
  isin varchar [note: '12-character alphanumeric code that uniquely identifies a security per ISO 6166 standard.']
  liquidity_classification varchar [note: 'Classification of asset liquidity based on expected time to convert to cash without significant price impact.']
  market_value decimal(18,4) [note: 'Current fair market value of the asset position in the base currency as of the latest valuation date.']
  maturity_date date [note: 'Date when the asset matures or expires, applicable to fixed income and derivative instruments.']
  notes varchar [note: 'Free-form notes and comments from investment professionals regarding the asset.']
  notional_value decimal(18,4) [note: 'Face value or notional principal amount for derivatives and fixed income instruments.']
  ownership_percentage decimal(8,5) [note: 'Percentage of total ownership or equity stake held in the asset, relevant for private investments.']
  regulatory_classification varchar [note: 'Classification for regulatory reporting purposes such as Solvency II or pension fund regulations.']
  sector varchar [note: 'Global Industry Classification Standard (GICS) sector or equivalent industry classification for the asset.']
  sedol varchar [note: '7-character alphanumeric identifier for securities traded on the London Stock Exchange and other exchanges.']
  tax_lot_method varchar [note: 'Cost basis method used for tax reporting when disposing of asset positions.']
  unit_price decimal(18,6) [note: 'Current price per unit or share of the asset used for valuation calculations.']
  units_held decimal(18,6) [note: 'Quantity of units, shares, or contracts held for the asset position.']
  valuation_date date [note: 'Date of the most recent valuation or pricing update for the asset.']
  valuation_methodology varchar [note: 'Method used to determine the fair value of the asset per accounting and regulatory standards.']
  yield_to_maturity decimal(8,5) [note: 'Total return anticipated on a bond if held until maturity, expressed as an annual percentage rate.']

  Note: 'Master reference table for asset. Referenced by asset_id.'
}

Table portfolio.tax_lot {
  tax_lot_id varchar [pk, note: 'Primary key for tax_lot']
  cash_account_id varchar [note: 'Reference to the investment account associated with this tax lot.']
  custodian_id varchar [note: 'Reference to the custodian bank or institution holding the assets for this tax lot.']
  execution_id varchar [note: 'Reference to the original trade transaction that created this tax lot.']
  listed_security_id varchar [note: 'Reference to the security or instrument held in this tax lot.']
  portfolio_id varchar [note: 'Reference to the investment portfolio that holds this tax lot position.']
  accrued_income decimal(18,4) [note: 'Accrued but unpaid income such as interest or dividends associated with this tax lot.']
  acquisition_date date [note: 'Date when the position was originally acquired for tax lot tracking and holding period calculation.']
  acquisition_price decimal(18,8) [note: 'Price per unit at which the position was originally acquired.']
  adjusted_cost_basis decimal(18,4) [note: 'Cost basis adjusted for corporate actions, return of capital, wash sales, and other tax adjustments.']
  amortization_method varchar [note: 'Method used for amortizing bond premium or accreting discount for tax purposes.']
  asset_class varchar [note: 'Broad asset class category for the tax lot such as equity, fixed income, real estate, private equity, infrastructure, or natural resources.']
  close_date date [note: 'Date when the tax lot was fully closed through sale or other disposition.']
  close_price decimal(18,8) [note: 'Price per unit at which the tax lot was closed or disposed.']
  corporate_action_adjusted boolean [note: 'Flag indicating whether this tax lot has been adjusted for corporate actions such as splits or mergers.']
  cost_basis decimal(18,4) [note: 'Total original cost basis of the tax lot including acquisition price and transaction costs for tax reporting.']
  cost_basis_method varchar [note: 'Method used to calculate cost basis for tax purposes such as FIFO, LIFO, HIFO, specific identification, or average cost.']
  coupon_rate decimal(8,5) [note: 'Annual coupon rate as a percentage for fixed income securities in this tax lot.']
  created_timestamp timestamp [note: 'Timestamp when this tax lot record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the tax lot monetary values.']
  holding_period_days varchar [note: 'Number of days the position has been held from acquisition date for holding period determination.']
  holding_period_type varchar [note: 'Tax classification of holding period as short-term (one year or less) or long-term (more than one year).']
  income_received decimal(18,4) [note: 'Total income received from this tax lot including dividends, interest, and distributions.']
  local_currency_code varchar [note: 'ISO 4217 currency code of the original transaction currency if different from base currency.']
  lot_reference_number varchar [note: 'External business reference number uniquely identifying this tax lot for reporting and reconciliation.']
  lot_type varchar [note: 'Classification of the tax lot position type indicating long, short, or covered positions.']
  market_value decimal(18,4) [note: 'Current market value of the remaining position in the tax lot based on latest pricing.']
  maturity_date date [note: 'Maturity date for fixed income securities held in this tax lot.']
  original_units decimal(18,6) [note: 'Original number of units, shares, or par value acquired when the tax lot was opened.']
  realized_gain_loss decimal(18,4) [note: 'Total realized gain or loss from disposed units in this tax lot.']
  settlement_date date [note: 'Date when the acquisition trade settled and ownership was legally transferred.']
  source_system varchar [note: 'Name of the operational system from which this tax lot record originated.']
  tax_jurisdiction varchar [note: 'Country or jurisdiction code governing the tax treatment of this lot.']
  tax_lot_status varchar [note: 'Current lifecycle status of the tax lot indicating whether the position is open, closed, or partially disposed.']
  trade_date date [note: 'Date when the acquisition trade was executed in the market.']
  transaction_costs decimal(18,4) [note: 'Total transaction costs including commissions and fees incurred when acquiring this tax lot.']
  units_disposed decimal(18,6) [note: 'Total number of units that have been sold or disposed from this tax lot.']
  units_held decimal(18,6) [note: 'Current number of units, shares, or par value remaining in the tax lot after any partial dispositions.']
  unrealized_gain_loss decimal(18,4) [note: 'Difference between current market value and adjusted cost basis representing unrealized profit or loss.']
  updated_timestamp timestamp [note: 'Timestamp when this tax lot record was last modified.']
  wash_sale_adjustment decimal(18,4) [note: 'Amount of disallowed loss added to cost basis due to wash sale rules.']
  wash_sale_indicator boolean [note: 'Flag indicating whether this tax lot is subject to wash sale rules disallowing loss deduction.']
  withholding_tax decimal(18,4) [note: 'Total withholding tax deducted from income payments on this tax lot.']
  yield_at_acquisition decimal(8,5) [note: 'Yield to maturity or yield at the time of acquisition for fixed income tax lots.']

  Note: 'Master reference table for tax_lot. Referenced by tax_lot_id.'
}

Table equity.listed_security {
  listed_security_id varchar [pk, note: 'Unique identifier for the listed equity security. Primary key.']
  bloomberg_ticker varchar [note: 'Bloomberg-specific ticker identifier including exchange suffix.']
  coverage_analyst varchar [note: 'Name of the internal equity research analyst assigned to cover this security.']
  created_timestamp timestamp [note: 'Timestamp when this security master record was first created in the system.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities.']
  data_source varchar [note: 'Name of the primary external data provider or system of record for this security master data.']
  delisting_date date [note: 'Date on which the security was delisted from the primary exchange, if applicable.']
  dividend_frequency varchar [note: 'Frequency with which the issuer typically pays dividends to shareholders.']
  esg_rating varchar [note: 'Current ESG rating assigned by the funds primary ESG rating provider.']
  esg_rating_date date [note: 'Date as of which the ESG rating is current.']
  exchange_mic varchar [note: 'ISO 10383 4-character code identifying the primary exchange.']
  factset_entity_code varchar [note: 'FactSet permanent identifier for the security entity.']
  gics_industry varchar [note: 'GICS level 3 industry classification of the issuer.']
  gics_industry_group varchar [note: 'GICS level 2 industry group classification of the issuer.']
  gics_sector varchar [note: 'GICS level 1 sector classification of the issuer.']
  gics_sub_industry varchar [note: 'GICS level 4 sub-industry classification of the issuer.']
  investment_restriction_flag boolean [note: 'Indicates whether the security is subject to internal investment restrictions or exclusions.']
  isin varchar [note: 'ISO 6166 12-character alphanumeric code uniquely identifying the security globally.']
  issuer_lei varchar [note: 'ISO 17442 20-character alphanumeric code uniquely identifying the issuing legal entity.']
  issuer_name varchar [note: 'Legal name of the corporation or entity that issued the equity security.']
  listing_country varchar [note: 'ISO 3166-1 alpha-3 country code of the primary exchange jurisdiction.']
  listing_date date [note: 'Date on which the security was first listed on the primary exchange.']
  listing_status varchar [note: 'Current trading and listing status of the security on the primary exchange.']
  lot_size varchar [note: 'Minimum trading unit or board lot size required by the exchange for this security.']
  market_cap_date date [note: 'Date as of which the market capitalization is calculated.']
  market_capitalization decimal(20,2) [note: 'Total market value of outstanding shares, calculated as shares outstanding multiplied by current market price, in trading currency.']
  msci_constituent_flag boolean [note: 'Indicates whether the security is a constituent of any MSCI index.']
  par_value decimal(18,4) [note: 'Nominal or face value per share as stated in the corporate charter, in the issuers reporting currency.']
  par_value_currency varchar [note: 'ISO 4217 3-letter currency code for the par value denomination.']
  price_multiplier decimal(10,4) [note: 'Multiplier applied to quoted price to determine actual contract value, typically 1.0 for equities.']
  primary_exchange varchar [note: 'Name of the primary stock exchange where the security is listed and primarily traded.']
  research_rating varchar [note: 'Internal research teams investment recommendation rating for the security.']
  research_rating_date date [note: 'Date on which the current research rating was assigned.']
  restriction_reason varchar [note: 'Explanation of why the security is restricted, if applicable.']
  reuters_ric varchar [note: 'Reuters-specific instrument identifier code.']
  security_name varchar [note: 'Full legal name of the equity security as registered with the issuer and exchange.']
  security_type varchar [note: 'Classification of the equity instrument type.']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  share_class varchar [note: 'Designation of the share class (e.g., Class A, Class B, Ordinary) indicating voting rights and dividend entitlements.']
  shares_outstanding varchar [note: 'Total number of shares currently issued and outstanding as reported by the issuer.']
  shares_outstanding_date date [note: 'Date as of which the shares outstanding figure is accurate.']
  ticker_symbol varchar [note: 'Exchange-specific trading symbol used to identify the security on the listing exchange.']
  trading_currency varchar [note: 'ISO 4217 3-letter currency code in which the security is quoted and traded.']
  updated_timestamp timestamp [note: 'Timestamp when this security master record was last modified.']
  voting_rights varchar [note: 'Voting rights associated with this share class.']

  Note: 'Equity security master data for all exchange-traded equity instruments held or covered by the fund. Serves as the SSOT for equity instrument identity, capturing ISIN, CUSIP, SEDOL, ticker symbol, exchange listing, share class, par value, shares'
}

Table equity.equity_position {
  equity_position_id varchar [pk, note: 'Unique identifier for the equity position record in the Investment Book of Record (IBOR).']
  custody_account_id varchar [note: 'Foreign key linking to trade.custody_account. Business justification: Position custody mapping – tracks which custody account holds each position for reporting.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Position‑to‑instrument mapping – aligns equity positions with the trade‑domain instrument for cross‑domain analytics.']
  listed_security_id varchar [note: 'Reference to the equity security master record for this position.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Position-level reporting requires linking each equity position to the manager mandate that owns the portfolio, enabling mandate-level performance attribution.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding this equity position.']
  risk_factor_exposure_id varchar [note: 'Foreign key linking to risk.risk_factor_exposure. Business justification: Position‑level risk attribution reports require mapping each equity position to its risk factor exposure record.']
  trader_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Position entry workflow requires linking the trader who executed the trade to the employee record.']
  accrued_dividend decimal(18,2) [note: 'Dividend income accrued but not yet received for this position in base currency.']
  acquisition_date date [note: 'Date when the position was originally established in the portfolio.']
  active_weight_percent decimal(8,4) [note: 'Difference between portfolio weight and benchmark weight; indicates over or underweight position.']
  average_cost_per_share decimal(18,4) [note: 'Weighted average cost basis per share in the positions local currency.']
  base_currency_code varchar [note: 'ISO 4217 3-letter currency code for the portfolios base reporting currency.']
  benchmark_weight_percent decimal(8,4) [note: 'Weight of this security in the portfolios benchmark index expressed as a percentage.']
  beta decimal(8,4) [note: 'Measure of the securitys volatility relative to the market benchmark per Capital Asset Pricing Model (CAPM).']
  book_cost_base_currency decimal(18,2) [note: 'Total original acquisition cost of the position in the portfolios base currency.']
  country_of_domicile varchar [note: 'ISO 3166-1 alpha-3 country code where the issuing company is legally domiciled.']
  country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary country exposure for risk reporting.']
  created_timestamp timestamp [note: 'System timestamp when this position record was first created in the IBOR.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities.']
  custodian_account_number varchar [note: 'Account number at the custodian bank where the equity position is held.']
  data_source_system varchar [note: 'Name of the upstream system of record that provided this position data.']
  dividend_yield_percent decimal(8,4) [note: 'Annualized dividend yield of the security expressed as a percentage of market price.']
  esg_score decimal(5,2) [note: 'Composite ESG rating score for the security from external ESG data provider.']
  exchange_code varchar [note: 'ISO 10383 4-character code identifying the primary exchange where the security is listed.']
  fx_rate decimal(18,8) [note: 'Exchange rate used to convert local currency to base currency as of position date.']
  income_classification varchar [note: 'Tax classification of dividend income from this position.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the equity security.']
  last_trade_date date [note: 'Date of the most recent trade that affected this position.']
  lending_eligible_flag boolean [note: 'Indicates whether the position is eligible for securities lending programs.']
  local_currency_code varchar [note: 'ISO 4217 3-letter currency code for the securitys trading currency.']
  market_capitalization_tier varchar [note: 'Classification of the equity by market capitalization size.']
  market_price decimal(18,4) [note: 'Current market price per share in the securitys local trading currency as of position date.']
  market_value_base_currency decimal(18,2) [note: 'Total market value of the position converted to the portfolios base currency.']
  market_value_local_currency decimal(18,2) [note: 'Total market value of the position in the securitys local trading currency.']
  portfolio_weight_percent decimal(8,4) [note: 'Weight of this position in the total portfolio expressed as a percentage of Net Asset Value (NAV).']
  position_date date [note: 'The business date for which this equity position snapshot is recorded.']
  position_status varchar [note: 'Current lifecycle status of the equity position.']
  position_type varchar [note: 'Indicates whether the position is a long holding or a short sale.']
  price_to_earnings_ratio decimal(10,2) [note: 'Ratio of market price per share to earnings per share; valuation metric.']
  quantity decimal(18,4) [note: 'Number of shares or units held in the equity position; negative for short positions.']
  restricted_flag boolean [note: 'Indicates whether the position is subject to trading restrictions or lock-up periods.']
  sector_classification varchar [note: 'Industry sector classification of the equity security per GICS or equivalent taxonomy.']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  settlement_date date [note: 'Most recent settlement date for transactions affecting this position.']
  tax_lot_method varchar [note: 'Method used for tax lot accounting and cost basis calculation.']
  ticker_symbol varchar [note: 'Exchange trading symbol for the equity security.']
  unrealized_gain_loss_base_currency decimal(18,2) [note: 'Difference between market value and book cost in base currency; represents mark-to-market profit or loss.']
  updated_timestamp timestamp [note: 'System timestamp when this position record was last modified.']
  valuation_source varchar [note: 'Source of the market price used for position valuation.']
  voting_rights_flag boolean [note: 'Indicates whether the equity position carries shareholder voting rights.']

  Note: 'IBOR equity position records representing the fund\'s current and historical holdings in listed equities at the portfolio-security-date level. Captures long/short indicator, quantity held, book cost, average cost basis, unrealized P&L, market value in'
}

Table equity.equity_benchmark {
  equity_benchmark_id varchar [pk, note: 'Unique identifier for the equity benchmark index record.']
  creator_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Benchmark creation process requires linking the creator to the employee record.']
  administrator_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the benchmark administrator.']
  base_currency varchar [note: 'Original calculation currency of the benchmark before any currency conversion.']
  base_date date [note: 'Inception date of the benchmark index from which historical performance is calculated.']
  base_value decimal(18,4) [note: 'Initial index level set at the base date (typically 100 or 1000).']
  benchmark_code varchar [note: 'Unique alphanumeric code identifying the benchmark index (e.g., SPX, MXWO, RTSI).']
  benchmark_name varchar [note: 'Full official name of the equity benchmark index.']
  benchmark_status varchar [note: 'Current operational status of the benchmark index.']
  benchmark_type varchar [note: 'Classification of the benchmark by scope and construction methodology. [ENUM-REF-CANDIDATE: Broad Market|Regional|Country|Sector|Style|Factor|ESG|Custom — 8 candidates stripped; promote to reference product]']
  bloomberg_ticker varchar [note: 'Bloomberg terminal ticker symbol for the benchmark index.']
  calculation_frequency varchar [note: 'Frequency at which the benchmark index level is calculated and published.']
  capping_methodology varchar [note: 'Description of any maximum weight limits applied to individual constituents or sectors.']
  country_iso_code varchar [note: 'ISO 3166-1 alpha-3 country code for single-country benchmarks.']
  created_timestamp timestamp [note: 'Timestamp when this benchmark record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the benchmark is denominated.']
  data_source varchar [note: 'System or vendor from which benchmark data is sourced (e.g., Bloomberg, MSCI, FactSet).']
  dividend_treatment varchar [note: 'How dividends are treated in the benchmark calculation methodology.']
  effective_date date [note: 'Date from which this benchmark record is effective for use in portfolio management and reporting.']
  esg_integration boolean [note: 'Indicates whether the benchmark incorporates ESG screening or tilting criteria.']
  esg_methodology varchar [note: 'Description of ESG screening, exclusion, or integration approach applied to the benchmark.']
  factsheet_url varchar [note: 'Web link to the current benchmark factsheet or summary document.']
  free_float_adjustment boolean [note: 'Indicates whether constituent weights are adjusted for publicly available shares only.']
  geographic_scope varchar [note: 'Geographic coverage of the equity markets included in the benchmark.']
  hedged_currency varchar [note: 'Target currency for currency-hedged versions of the benchmark index.']
  index_provider varchar [note: 'Organization that calculates and publishes the benchmark index. [ENUM-REF-CANDIDATE: MSCI|FTSE|S&P|Russell|Bloomberg|Dow Jones|Stoxx|Nasdaq — 8 candidates stripped; promote to reference product]']
  internal_benchmark_flag boolean [note: 'Indicates whether this is a custom benchmark constructed internally rather than a third-party published index.']
  is_hedged boolean [note: 'Indicates whether the benchmark includes currency hedging to a target currency.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the benchmark index.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this benchmark record.']
  market_cap_range varchar [note: 'Market capitalization segment targeted by the benchmark index.']
  methodology_url varchar [note: 'Web link to the official index methodology document published by the provider.']
  notes varchar [note: 'Free-text field for additional comments, usage guidance, or special considerations for this benchmark.']
  number_of_constituents varchar [note: 'Total count of equity securities included in the benchmark index.']
  rebalancing_frequency varchar [note: 'Frequency at which the benchmark index composition and weights are reconstituted. [ENUM-REF-CANDIDATE: Daily|Weekly|Monthly|Quarterly|Semi-Annual|Annual|Event-Driven — 7 candidates stripped; promote to reference product]']
  reconstitution_month varchar [note: 'Primary month in which annual or semi-annual index reconstitution occurs. [ENUM-REF-CANDIDATE: January|February|March|April|May|June|July|August|September|October|November|December — 12 candidates stripped; promote to reference product]']
  region varchar [note: 'Primary geographic region covered by the benchmark (e.g., North America, Europe, Asia Pacific).']
  regulatory_classification varchar [note: 'Regulatory designation under applicable benchmark regulations (e.g., EU BMR critical, significant, non-significant).']
  return_type varchar [note: 'Calculation method for index returns: price-only, net dividends, or gross dividends.']
  ric_code varchar [note: 'Refinitiv Reuters Instrument Code identifying the benchmark index.']
  sector_focus varchar [note: 'Specific GICS sector or industry group if the benchmark is sector-specific.']
  style_factor varchar [note: 'Investment style or factor exposure emphasized by the benchmark index. [ENUM-REF-CANDIDATE: Value|Growth|Blend|Quality|Momentum|Low Volatility|Dividend|Multi-Factor — 8 candidates stripped; promote to reference product]']
  termination_date date [note: 'Date on which this benchmark was discontinued or replaced, if applicable.']
  usage_purpose varchar [note: 'Primary use case for this benchmark within the organization (e.g., performance attribution, portfolio construction, risk management, SAA reference).']
  version_number varchar [note: 'Version number of the benchmark record for change tracking and audit purposes.']
  weighting_methodology varchar [note: 'Method used to weight constituent securities within the benchmark index. [ENUM-REF-CANDIDATE: Market Cap|Float-Adjusted Market Cap|Equal Weight|Fundamental|Factor|Risk-Based|Custom — 7 candidates stripped; promote to reference product]']

  Note: 'Reference master for equity benchmark indices used in portfolio construction, performance attribution, and risk management. Captures benchmark name, index provider (MSCI, FTSE, S&P, Russell), benchmark code, currency, rebalancing frequency, weighting'
}

Table equity.equity_benchmark_constituent {
  equity_benchmark_constituent_id varchar [pk, note: 'Unique identifier for the equity benchmark constituent record.']
  equity_benchmark_id varchar [note: 'Reference to the parent equity benchmark index to which this constituent belongs.']
  listed_security_id varchar [note: 'Reference to the equity security that is a constituent of the benchmark.']
  addition_date date [note: 'Date on which the security was first added to the benchmark index.']
  adjusted_market_capitalization decimal(20,2) [note: 'Market capitalization adjusted for free float and other index-specific factors, used as the basis for weight calculation in free-float weighted indices.']
  average_daily_value_traded decimal(20,2) [note: 'Average monetary value of shares traded daily over a specified lookback period, used for liquidity assessment.']
  average_daily_volume varchar [note: 'Average number of shares traded daily over a specified lookback period, used for liquidity assessment.']
  capping_factor decimal(8,6) [note: 'Factor applied to limit the maximum weight of any single constituent, used in capped index methodologies.']
  constituent_status varchar [note: 'Current lifecycle status of the constituent membership within the benchmark index.']
  constituent_weight decimal(18,10) [note: 'Weight of the security within the benchmark index expressed as a decimal proportion, typically summing to 1.0 across all constituents at a given effective date.']
  constituent_weight_percent decimal(8,5) [note: 'Weight of the security within the benchmark index expressed as a percentage, typically summing to 100 across all constituents.']
  corporate_action_adjustment_flag boolean [note: 'Indicates whether this constituent record reflects an adjustment due to a corporate action such as stock split, dividend, or merger.']
  country_of_domicile varchar [note: 'Three-letter ISO 3166 country code representing the legal domicile of the issuer.']
  country_of_risk varchar [note: 'Three-letter ISO 3166 country code representing the primary country of economic risk exposure for the issuer.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the security is denominated and priced.']
  cusip varchar [note: 'Committee on Uniform Securities Identification Procedures code identifying North American securities.']
  data_source varchar [note: 'System or vendor from which the constituent data was sourced, such as Bloomberg, MSCI, FTSE Russell, or internal calculation.']
  deletion_date date [note: 'Date on which the security was removed from the benchmark index, null if still a constituent.']
  deletion_reason varchar [note: 'Reason code explaining why the security was removed from the benchmark index. [ENUM-REF-CANDIDATE: merger|acquisition|delisting|bankruptcy|rebalance|size_threshold|liquidity_threshold — 7 candidates stripped; promote to reference product]']
  effective_date date [note: 'Date on which this constituent membership and weight became effective, typically aligned with benchmark rebalancing dates.']
  expiration_date date [note: 'Date on which this constituent membership ended or will end, null if currently active in the benchmark.']
  free_float_factor decimal(8,6) [note: 'Proportion of shares available for public trading, used to adjust market capitalization for free-float weighting methodologies.']
  gics_industry_code varchar [note: 'Six-digit GICS industry code providing third-level industry classification.']
  gics_industry_group_code varchar [note: 'Four-digit GICS industry group code providing second-level industry classification.']
  gics_sector_code varchar [note: 'Two-digit GICS sector code classifying the security at the highest industry hierarchy level.']
  gics_sub_industry_code varchar [note: 'Eight-digit GICS sub-industry code providing the most granular industry classification.']
  index_divisor decimal(20,10) [note: 'Divisor value used in index calculation to maintain index continuity across corporate actions and rebalancing events.']
  index_provider_code varchar [note: 'Code or identifier of the organization that publishes and maintains the benchmark index.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the equity security globally.']
  issuer_name varchar [note: 'Legal name of the company or entity that issued the equity security.']
  liquidity_score decimal(10,4) [note: 'Quantitative measure of the securitys trading liquidity used in index eligibility and weighting decisions.']
  market_capitalization decimal(20,2) [note: 'Total market capitalization of the security at the effective date, calculated as shares outstanding multiplied by price.']
  price_at_rebalance decimal(18,6) [note: 'Closing price of the security on the effective date used for weight calculation and rebalancing.']
  rebalance_frequency varchar [note: 'Frequency at which the benchmark index rebalances constituent weights and membership.']
  record_created_timestamp timestamp [note: 'Timestamp when this constituent record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this constituent record was last modified in the system.']
  security_name varchar [note: 'Full legal name of the equity security as recognized by the benchmark provider.']
  sedol varchar [note: 'Stock Exchange Daily Official List code identifying the security, primarily used in UK and Irish markets.']
  shares_outstanding varchar [note: 'Number of shares of the security outstanding at the effective date, used in market capitalization weighting calculations.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the security at the time of constituent membership.']
  weighting_methodology varchar [note: 'Methodology used by the index provider to calculate constituent weights within the benchmark.']

  Note: 'Point-in-time constituent membership records for equity benchmark indices, capturing the weight of each security within a benchmark at a given rebalancing date.'
}

Table equity.equity_coverage {
  equity_coverage_id varchar [pk, note: 'Unique identifier for the equity research coverage record.']
  analyst_employee_id varchar [note: 'Reference to the lead equity research analyst assigned to this coverage.']
  employee_id varchar [note: 'Reference to the lead equity research analyst assigned to this coverage.']
  listed_security_id varchar [note: 'Reference to the listed equity security under coverage.']
  active_flag boolean [note: 'Indicates whether this coverage record is currently active and valid for operational use.']
  analyst_name varchar [note: 'Full name of the lead equity research analyst responsible for this coverage.']
  benchmark_index varchar [note: 'Primary equity benchmark index against which this securitys performance is evaluated.']
  conviction_level varchar [note: 'Analysts conviction level in the investment thesis and rating for this coverage.']
  country_of_domicile varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the issuers legal domicile.']
  created_timestamp timestamp [note: 'Timestamp when this coverage record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  data_source varchar [note: 'Primary external data provider or system of record for market data and analytics on this security.']
  equity_coverage_status varchar [note: 'Current status of research coverage for this security.']
  equity_coverage_type varchar [note: 'Classification of the depth and scope of research coverage provided.']
  esg_coverage_flag boolean [note: 'Indicates whether dedicated ESG analysis is included in the research coverage for this security.']
  esg_rating varchar [note: 'Internal or third-party ESG rating assigned to the covered security.']
  geographic_region varchar [note: 'Primary geographic region of the issuers operations and listing.']
  industry_group varchar [note: 'Industry group classification within the sector per GICS or internal taxonomy.']
  initiation_date date [note: 'Date when formal research coverage of this security was initiated.']
  investment_rating varchar [note: 'Current internal investment recommendation rating for the covered security.']
  isin varchar [note: 'ISO 6166 twelve-character alphanumeric code uniquely identifying the covered security.']
  issuer_name varchar [note: 'Legal name of the corporate entity issuing the covered equity security.']
  last_review_date date [note: 'Date of the most recent formal research review or report publication for this coverage.']
  market_cap_tier varchar [note: 'Market capitalization tier classification of the covered security.']
  next_review_date date [note: 'Scheduled date for the next formal research review or report update.']
  position_held_flag boolean [note: 'Indicates whether the fund currently holds an active position in this covered security.']
  primary_exchange varchar [note: 'Primary stock exchange where the security is listed and traded.']
  rating_effective_date date [note: 'Date when the current investment rating became effective.']
  rationale varchar [note: 'Brief explanation of the strategic rationale for including this security in the research coverage universe.']
  record_version varchar [note: 'Version number of this coverage record for change tracking and audit purposes.']
  research_priority varchar [note: 'Priority tier assigned to this coverage within the research teams portfolio allocation.']
  sector_classification varchar [note: 'Primary industry sector classification of the covered security per GICS or internal taxonomy.']
  security_name varchar [note: 'Full legal name of the equity security under coverage.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on London Stock Exchange and other UK exchanges.']
  target_price decimal(18,4) [note: 'Analyst twelve-month forward target price for the covered security in local currency.']
  target_price_currency varchar [note: 'Three-letter ISO 4217 currency code for the target price.']
  termination_date date [note: 'Date when research coverage of this security was formally terminated or dropped.']
  termination_reason varchar [note: 'Explanation for why coverage was terminated or dropped if coverage status is dropped or suspended.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the covered equity security.']
  updated_by varchar [note: 'User identifier of the person or system that last updated this coverage record.']
  updated_timestamp timestamp [note: 'Timestamp when this coverage record was last modified.']

  Note: 'Internal equity research coverage universe master, defining which listed securities are formally covered by the fund\'s internal equity research team. Captures coverage status (active, watch, dropped), assigned analyst, coverage initiation date, coverage'
}

Table equity.research_note {
  research_note_id varchar [pk, note: 'Unique identifier for the equity research note record.']
  compliance_reviewer_employee_id varchar [note: 'Reference to the compliance officer who reviewed and approved this research note.']
  employee_id varchar [note: 'Reference to the buy-side analyst who authored this research note.']
  listed_security_id varchar [note: 'Reference to the equity security covered by this research note.']
  peer_review_analyst_employee_id varchar [note: 'Reference to the senior analyst or peer who reviewed this research note for quality assurance.']
  research_compliance_reviewer_employee_id varchar [note: 'Reference to the compliance officer who reviewed and approved this research note.']
  research_employee_id varchar [note: 'Reference to the buy-side analyst who authored this research note.']
  research_peer_review_analyst_employee_id varchar [note: 'Reference to the senior analyst or peer who reviewed this research note for quality assurance.']
  superseded_by_note_research_note_id varchar [note: 'Reference to the newer research note that supersedes this one, if applicable.']
  archived_date date [note: 'Date when the research note was moved to archived status.']
  archived_flag boolean [note: 'Indicates whether the research note has been archived and is no longer actively maintained.']
  compliance_review_date date [note: 'Date when the research note was reviewed and approved by compliance for conflicts and regulatory adherence.']
  conviction_level varchar [note: 'Analysts confidence level in the investment thesis and recommendation.']
  created_timestamp timestamp [note: 'Timestamp when the research note record was first created in the system.']
  dcf_terminal_growth_rate_percent decimal(5,2) [note: 'Perpetual growth rate assumption used in DCF terminal value calculation, expressed as a percentage.']
  dcf_wacc_percent decimal(5,2) [note: 'Weighted average cost of capital used in DCF valuation model, expressed as a percentage.']
  distribution_scope varchar [note: 'Defines the internal audience and access level for this research note.']
  document_url varchar [note: 'Internal storage location or URL for the full research note document.']
  earnings_estimate_current_year decimal(18,4) [note: 'Analysts earnings per share estimate for the current fiscal year.']
  earnings_estimate_next_year decimal(18,4) [note: 'Analysts earnings per share estimate for the next fiscal year.']
  esg_assessment_summary varchar [note: 'Narrative summary of ESG considerations and their impact on the investment thesis.']
  esg_score decimal(5,2) [note: 'Internal or third-party ESG rating for the covered security, used in responsible investment integration.']
  ev_ebitda_ratio decimal(8,2) [note: 'Enterprise value to EBITDA multiple used or cited in the valuation analysis.']
  executive_summary varchar [note: 'Brief summary of the investment thesis, key findings, and recommendation for quick reference.']
  investment_horizon_months varchar [note: 'Time horizon in months over which the target price and recommendation apply.']
  investment_recommendation varchar [note: 'The analysts formal investment recommendation for the covered security. [ENUM-REF-CANDIDATE: strong_buy|buy|hold|reduce|sell|under_review|not_rated — 7 candidates stripped; promote to reference product]']
  key_catalysts varchar [note: 'Summary of expected near-term events or developments that could drive price movement.']
  key_risks varchar [note: 'Summary of principal investment risks and downside scenarios identified by the analyst.']
  last_modified_timestamp timestamp [note: 'Timestamp when the research note record was last updated or revised.']
  note_type varchar [note: 'Classification of the research note by purpose and content type. [ENUM-REF-CANDIDATE: initiation|update|earnings_review|sector_note|thematic|downgrade|upgrade — 7 candidates stripped; promote to reference product]']
  pe_ratio_forward decimal(8,2) [note: 'Forward-looking price-to-earnings multiple used or cited in the valuation analysis.']
  prior_recommendation varchar [note: 'The previous investment recommendation before this research note, if this is an update or change. [ENUM-REF-CANDIDATE: strong_buy|buy|hold|reduce|sell|under_review|not_rated — 7 candidates stripped; promote to reference product]']
  prior_target_price decimal(18,4) [note: 'The previous target price before this research note, if this is an update or change.']
  publication_date date [note: 'Date when the research note was officially published and distributed internally.']
  publication_timestamp timestamp [note: 'Precise timestamp when the research note was published to internal systems.']
  recommendation_change_reason varchar [note: 'Explanation of why the recommendation or target price was changed from the prior view.']
  research_status varchar [note: 'Current lifecycle status of the research note in the publication workflow. [ENUM-REF-CANDIDATE: draft|peer_review|compliance_review|approved|published|archived|withdrawn — 7 candidates stripped; promote to reference product]']
  revenue_estimate_current_year decimal(18,2) [note: 'Analysts revenue estimate for the current fiscal year in the securitys reporting currency.']
  revenue_estimate_next_year decimal(18,2) [note: 'Analysts revenue estimate for the next fiscal year in the securitys reporting currency.']
  sector_focus varchar [note: 'Primary industry sector or sub-sector that is the focus of this research note.']
  target_price decimal(18,4) [note: 'Analysts price target for the security over the stated investment horizon.']
  target_price_currency varchar [note: 'Three-letter ISO 4217 currency code for the target price.']
  thematic_tag varchar [note: 'Cross-sector investment theme or macro trend addressed in the research note.']
  title varchar [note: 'Headline or title of the research note summarizing the key thesis or topic.']
  valuation_methodology varchar [note: 'Primary valuation approach used to derive the target price and investment thesis.']
  version_number varchar [note: 'Sequential version number for tracking revisions and updates to the research note.']
  withdrawal_reason varchar [note: 'Explanation of why the research note was withdrawn from circulation.']
  withdrawn_flag boolean [note: 'Indicates whether the research note has been withdrawn due to errors or material changes.']
  word_count varchar [note: 'Total word count of the research note document for content depth tracking.']

  Note: 'Internal equity research notes and investment theses produced by the fund\'s buy-side analysts for covered securities. Captures note type (initiation, update, earnings review, sector note, thematic), publication date, analyst, investment recommendation'
}

Table equity.price_history {
  price_history_id varchar [pk, note: 'Unique identifier for each daily price history record.']
  listed_security_id varchar [note: 'Foreign key reference to the equity security master record.']
  adjusted_close_price decimal(18,4) [note: 'Closing price adjusted for corporate actions including dividends, stock splits, and rights offerings to enable accurate historical return calculations.']
  ask_price decimal(18,4) [note: 'Lowest ask price at market close, representing the price sellers are willing to accept.']
  batch_reference varchar [note: 'Identifier of the ETL batch process that loaded this price record, supporting data lineage and troubleshooting.']
  bid_ask_spread decimal(18,4) [note: 'Difference between ask price and bid price, indicating market liquidity and transaction cost.']
  bid_price decimal(18,4) [note: 'Highest bid price at market close, representing the price buyers are willing to pay.']
  close_price decimal(18,4) [note: 'Official closing price of the security at market close on the price date.']
  corporate_action_flag boolean [note: 'Indicates whether a corporate action (dividend, split, merger, etc.) occurred on the price date affecting price continuity.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which prices are denominated.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities.']
  data_quality_flag boolean [note: 'Quality assessment indicator for the price record, used for data governance and reconciliation.']
  dividend_amount decimal(18,4) [note: 'Cash dividend per share paid on the price date, if applicable.']
  exchange_code varchar [note: 'Market Identifier Code (MIC) of the exchange where the security is traded.']
  high_price decimal(18,4) [note: 'Highest intraday price reached during the trading session.']
  is_trading_day boolean [note: 'Indicates whether the price date was an active trading day for the exchange.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the equity security.']
  low_price decimal(18,4) [note: 'Lowest intraday price reached during the trading session.']
  market_cap decimal(20,2) [note: 'Total market value of the company calculated as closing price multiplied by shares outstanding at the price date.']
  open_price decimal(18,4) [note: 'Opening price of the security at market open on the price date.']
  previous_close_price decimal(18,4) [note: 'Official closing price from the prior trading session for day-over-day comparison.']
  price_change decimal(18,4) [note: 'Absolute change in price from previous close to current close.']
  price_change_percent decimal(10,6) [note: 'Percentage change in price from previous close to current close expressed as a decimal.']
  price_date date [note: 'Business date for which the price data is recorded (end-of-day).']
  price_source varchar [note: 'Data vendor or system from which the price data was sourced (e.g., Bloomberg, FactSet, exchange feed).']
  price_type varchar [note: 'Classification of the price data quality and source authority.']
  record_created_timestamp timestamp [note: 'System timestamp when the price history record was first created in the lakehouse.']
  record_updated_timestamp timestamp [note: 'System timestamp when the price history record was last modified, supporting audit trail and data lineage.']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  shares_outstanding varchar [note: 'Total number of shares issued and outstanding as of the price date, used for market capitalization and per-share calculations.']
  split_factor decimal(10,6) [note: 'Stock split or reverse split adjustment factor applied on the price date (e.g., 2.0 for 2-for-1 split, 0.5 for 1-for-2 reverse split).']
  ticker_symbol varchar [note: 'Exchange-specific ticker symbol for the equity security.']
  total_return_index decimal(18,6) [note: 'Cumulative total return index level assuming reinvestment of all dividends and distributions, used for performance attribution.']
  trading_status varchar [note: 'Status of trading activity for the security on the price date.']
  turnover_value decimal(20,2) [note: 'Total monetary value of shares traded during the session, calculated as volume multiplied by price.']
  volume varchar [note: 'Total number of shares traded during the trading session.']
  vwap decimal(18,4) [note: 'Volume-weighted average price of all trades executed during the trading session, used for execution quality assessment.']

  Note: 'Daily end-of-day price and volume history for listed equity securities. Captures open, high, low, close, adjusted close (for corporate actions), total return index level, trading volume, VWAP, market capitalization, shares outstanding at date'
}

Table equity.corporate_action {
  corporate_action_id varchar [pk, note: 'Unique identifier for the corporate action event record.']
  listed_security_id varchar [note: 'Reference to the equity security subject to this corporate action.']
  action_status varchar [note: 'Current lifecycle status of the corporate action: announced, confirmed, pending execution, executed, cancelled, or expired.']
  action_type varchar [note: 'Classification of the corporate action event: dividend, stock split, reverse split, rights issue, spin-off, merger, acquisition, delisting, name change, ticker change, or bonus issue.']
  announcement_date date [note: 'Date on which the corporate action was publicly announced by the issuer.']
  corporate_action_description varchar [note: 'Detailed narrative description of the corporate action event, including business rationale and shareholder impact.']
  country_of_issue varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the country in which the security is issued.']
  created_timestamp timestamp [note: 'Timestamp when this corporate action record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  data_quality_flag boolean [note: 'Indicator of the data quality status for this corporate action record: verified, pending review, incomplete, or error.']
  dividend_amount decimal(18,4) [note: 'Cash dividend amount per share declared by the issuer, expressed in the dividend currency.']
  dividend_currency varchar [note: 'Three-letter ISO 4217 currency code in which the dividend is denominated.']
  dividend_type varchar [note: 'Classification of dividend: ordinary (regular), special (one-time), interim (mid-year), or final (year-end).']
  effective_date date [note: 'Date on which the corporate action becomes effective, such as the date a merger closes or a name change takes effect.']
  ex_date date [note: 'Date on or after which a security trades without the right to receive the corporate action benefit; critical for determining entitlement.']
  exchange_code varchar [note: 'Four-character ISO 10383 Market Identifier Code for the exchange on which the security is listed.']
  impact_on_nav_flag boolean [note: 'Boolean flag indicating whether this corporate action has a material impact on portfolio Net Asset Value calculation.']
  isin varchar [note: 'ISO 6166 twelve-character alphanumeric code uniquely identifying the security subject to the corporate action.']
  issuer_lei varchar [note: 'Twenty-character ISO 17442 Legal Entity Identifier uniquely identifying the issuer of the security.']
  issuer_name varchar [note: 'Legal name of the company or entity issuing the corporate action.']
  mandatory_voluntary_flag boolean [note: 'Indicates whether the corporate action is mandatory (automatic for all shareholders) or voluntary (requires shareholder election).']
  new_cusip varchar [note: 'CUSIP assigned to the security after a corporate action that changes the security identifier.']
  new_isin varchar [note: 'ISIN assigned to the security after a corporate action that changes the security identifier, such as a merger, spin-off, or name change.']
  new_security_name varchar [note: 'New legal name of the security or issuer after a name change, merger, or acquisition.']
  new_sedol varchar [note: 'SEDOL assigned to the security after a corporate action that changes the security identifier.']
  new_ticker varchar [note: 'New exchange trading symbol assigned to the security after a ticker change or corporate restructuring.']
  notification_sent_flag boolean [note: 'Boolean flag indicating whether portfolio managers and investment teams have been notified of this corporate action.']
  payment_date date [note: 'Date on which the corporate action benefit (dividend, distribution, or new securities) is paid or delivered to entitled shareholders.']
  position_adjustment_required_flag boolean [note: 'Boolean flag indicating whether portfolio position records must be adjusted to reflect this corporate action.']
  processed_timestamp timestamp [note: 'Timestamp when the corporate action event was processed and applied to portfolio positions and accounting records.']
  record_date date [note: 'Date on which shareholders must be registered on the company books to be entitled to the corporate action benefit.']
  rights_ratio_from decimal(18,6) [note: 'Number of existing shares required to receive the rights entitlement; for a 1-for-5 rights issue, this value is 5.']
  rights_ratio_to decimal(18,6) [note: 'Number of new shares offered per the existing share entitlement; for a 1-for-5 rights issue, this value is 1.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  source_reference_code varchar [note: 'Unique identifier or reference number assigned to the corporate action event by the source system or data provider.']
  split_ratio_from decimal(18,6) [note: 'Numerator of the stock split ratio representing the number of old shares; for a 2-for-1 split, this value is 1.']
  split_ratio_to decimal(18,6) [note: 'Denominator of the stock split ratio representing the number of new shares; for a 2-for-1 split, this value is 2.']
  subscription_currency varchar [note: 'Three-letter ISO 4217 currency code in which the subscription price is denominated.']
  subscription_price decimal(18,4) [note: 'Price per share at which entitled shareholders may subscribe to new shares in a rights issue.']
  tax_treatment_code varchar [note: 'Code representing the tax treatment applicable to the corporate action benefit, such as qualified dividend or return of capital.']
  ticker varchar [note: 'Exchange trading symbol for the security at the time of the corporate action.']
  updated_timestamp timestamp [note: 'Timestamp when this corporate action record was last modified.']
  withholding_tax_rate decimal(5,4) [note: 'Default withholding tax rate applied to the corporate action benefit, expressed as a decimal (e.g., 0.15 for 15%).']

  Note: 'Corporate action event master for all equity securities in the coverage and position universe. Captures corporate action type (dividend, stock split, reverse split, rights issue, spin-off, merger, acquisition, delisting, name change, ticker change, bonus'
}

Table equity.corporate_action_election {
  corporate_action_election_id varchar [pk, note: 'Unique identifier for the corporate action election record.']
  corporate_action_id varchar [note: 'Reference to the underlying corporate action event to which this election applies.']
  corporate_employee_id varchar [note: 'Reference to the portfolio manager who made or authorized the election decision.']
  corporate_trader_employee_id varchar [note: 'Reference to the trader who submitted the election instruction.']
  counterparty_id varchar [note: 'Reference to the custodian bank processing the corporate action election.']
  custodian_counterparty_id varchar [note: 'Reference to the custodian bank processing the corporate action election.']
  employee_id varchar [note: 'Reference to the user who last modified this election record.']
  equity_position_id varchar [note: 'Reference to the equity position for which this election is made.']
  holding_id varchar [note: 'Foreign key linking to portfolio.holding. Business justification: Corporate action elections (dividends, rights issues, mergers) directly impact portfolio holdings.']
  listed_security_id varchar [note: 'Reference to the equity security subject to the corporate action.']
  portfolio_id varchar [note: 'Reference to the portfolio holding the position subject to this election.']
  portfolio_manager_employee_id varchar [note: 'Reference to the portfolio manager who made or authorized the election decision.']
  trader_employee_id varchar [note: 'Reference to the trader who submitted the election instruction.']
  accounting_entry_reference varchar [note: 'Reference to the accounting entry recording the financial impact of the election.']
  actual_quantity_processed decimal(18,4) [note: 'Actual number of shares processed after proration or partial acceptance.']
  agent_contact_email varchar [note: 'Email address of the corporate action agent for election inquiries.']
  agent_name varchar [note: 'Name of the corporate action agent or transfer agent managing the event.']
  cancellation_reason varchar [note: 'Reason for cancellation if the election was withdrawn before execution.']
  cash_consideration_amount decimal(18,2) [note: 'Total cash amount expected to be received for the elected quantity.']
  cash_consideration_currency varchar [note: 'Three-letter ISO currency code for cash consideration.']
  consideration_type varchar [note: 'Type of consideration to be received in exchange for the elected shares.']
  created_timestamp timestamp [note: 'Date and time when this election record was first created in the system.']
  custodian_reference_number varchar [note: 'Unique reference number assigned by the custodian to this election instruction.']
  elected_quantity decimal(18,4) [note: 'Number of shares or units for which the election is being made.']
  election_confirmation_timestamp timestamp [note: 'Date and time when the election was confirmed by the custodian or agent.']
  election_deadline_date date [note: 'Final date by which the election must be submitted to the custodian or agent.']
  election_option_code varchar [note: 'Code representing the specific option chosen by the fund from available alternatives.']
  election_option_description varchar [note: 'Detailed description of the elected option including terms and consideration.']
  election_percentage decimal(5,2) [note: 'Percentage of eligible position being elected for participation.']
  election_rationale varchar [note: 'Business rationale and investment thesis supporting the election decision.']
  election_reference_number varchar [note: 'External reference number assigned to this election by the fund or custodian.']
  election_status varchar [note: 'Current lifecycle status of the election instruction. [ENUM-REF-CANDIDATE: draft|submitted|confirmed|executed|cancelled|expired|rejected — 7 candidates stripped; promote to reference product]']
  election_submission_timestamp timestamp [note: 'Date and time when the election instruction was submitted to the custodian or agent.']
  election_type varchar [note: 'Type of voluntary corporate action election being made.']
  eligible_quantity decimal(18,4) [note: 'Total number of shares or units eligible for participation in the corporate action.']
  execution_date date [note: 'Date on which the corporate action election was executed and settled.']
  ic_approval_date date [note: 'Date on which the Investment Committee approved the election decision.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the IC approval decision.']
  investment_committee_approval_required boolean [note: 'Indicates whether IC approval was required for this election decision.']
  last_modified_timestamp timestamp [note: 'Date and time when this election record was last updated.']
  net_cash_proceeds decimal(18,2) [note: 'Net cash amount received after deducting withholding taxes and fees.']
  notes varchar [note: 'Additional notes or comments regarding the election decision or processing.']
  payment_date date [note: 'Date on which cash or stock consideration is expected to be received.']
  proration_factor decimal(8,6) [note: 'Factor applied when the corporate action is oversubscribed and elections are prorated.']
  rejection_reason varchar [note: 'Reason provided by custodian or agent if the election was rejected.']
  stock_consideration_isin varchar [note: 'ISIN of the security to be received as stock consideration.']
  stock_consideration_quantity decimal(18,4) [note: 'Number of shares expected to be received as stock consideration.']
  tax_treatment_code varchar [note: 'Code indicating the expected tax treatment of the consideration received.']
  withholding_tax_rate decimal(5,2) [note: 'Applicable withholding tax rate percentage on cash consideration.']

  Note: 'Records of the fund\'s elections and responses to voluntary corporate actions (e.g., tender offers, rights subscriptions, merger consideration elections, dividend reinvestment elections).'
}

Table equity.equity_factor_exposure {
  equity_factor_exposure_id varchar [pk, note: 'Unique identifier for the factor exposure record.']
  equity_benchmark_id varchar [note: 'Reference to the benchmark index used for relative factor exposure analysis. Null if absolute exposure only.']
  factor_model_id varchar [note: 'Reference to the factor model used for exposure calculation.']
  listed_security_id varchar [note: 'Reference to the equity security for which factor exposures are calculated.']
  portfolio_id varchar [note: 'Reference to the portfolio for which factor exposures are calculated. Null if exposure is at security level only.']
  active_exposure decimal(18,6) [note: 'The difference between portfolio factor exposure and benchmark factor exposure, representing active positioning relative to benchmark.']
  adjustment_reason varchar [note: 'Explanation for any manual adjustments or overrides applied to the calculated factor exposure. Null if no adjustments made.']
  approval_timestamp timestamp [note: 'Timestamp when the factor exposure record was approved for use in risk reporting and portfolio management.']
  approved_by varchar [note: 'Name or identifier of the risk analyst or portfolio manager who approved the factor exposure calculation or adjustment.']
  beta_to_market decimal(18,6) [note: 'The beta coefficient representing the sensitivity of the security or portfolio to market movements. Core metric in CAPM (Capital Asset Pricing Model).']
  calculation_method varchar [note: 'Methodology used to calculate the factor exposure: regression analysis, covariance matrix, portfolio optimization, or performance attribution.']
  calculation_timestamp timestamp [note: 'Timestamp when the factor exposure calculation was performed.']
  comments varchar [note: 'Free-text comments or notes regarding the factor exposure calculation, data quality issues, or analytical insights.']
  confidence_level decimal(5,2) [note: 'Confidence level for the factor exposure calculation, typically expressed as a percentage such as 95% or 99%.']
  contribution_to_risk decimal(18,6) [note: 'The contribution of this factor exposure to the overall portfolio risk, measured in percentage or basis points (bps).']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which factor returns and exposures are denominated.']
  data_source varchar [note: 'Source system or vendor providing the factor exposure data, such as MSCI Barra, Bloomberg, FactSet, BlackRock Aladdin, or internal calculation.']
  exposure_date date [note: 'The date for which the factor exposure is calculated and reported.']
  exposure_percentile decimal(5,2) [note: 'Percentile rank of the factor exposure relative to peer universe or historical distribution. Range 0 to 100.']
  exposure_value decimal(18,6) [note: 'Numeric value representing the magnitude of exposure to the factor. Standardized exposure score, typically z-score normalized.']
  exposure_weight decimal(18,6) [note: 'Portfolio weight applied to the security when calculating portfolio-level factor exposure. Null for security-level exposures.']
  factor_category varchar [note: 'Classification of the factor into broad categories: style factors, industry factors, country factors, currency factors, market factors, or macroeconomic factors.']
  factor_model_version varchar [note: 'Version identifier of the factor model used, such as Barra GEM4, USE4, EUE3, or CAPM variant.']
  factor_name varchar [note: 'Name of the risk factor, such as market beta, size, value, momentum, quality, low volatility, growth, leverage, liquidity, earnings yield, or sector-specific factors.']
  factor_return decimal(18,6) [note: 'The return attributed to this factor over the exposure period, expressed as a percentage or decimal.']
  factor_volatility decimal(18,6) [note: 'The volatility or standard deviation of the factor return, representing the risk associated with the factor itself.']
  frequency varchar [note: 'Frequency at which factor exposures are calculated and reported: daily, weekly, monthly, or quarterly.']
  is_active boolean [note: 'Indicates whether this factor exposure record is currently active and should be used in risk reporting and analytics.']
  lookback_period_days varchar [note: 'Number of days of historical data used in the factor exposure calculation, such as 60, 90, 252, or 504 days.']
  marginal_contribution_to_risk decimal(18,6) [note: 'Marginal contribution to total portfolio risk from this factor exposure, representing the change in risk if exposure changes by one unit.']
  outlier_flag boolean [note: 'Indicates whether the factor exposure value is identified as a statistical outlier requiring review or adjustment.']
  p_value decimal(18,6) [note: 'Probability value indicating the statistical significance of the factor exposure. Values below 0.05 typically indicate significance at 95% confidence level.']
  quality_score decimal(5,2) [note: 'Data quality score for the factor exposure calculation, ranging from 0 to 100, based on data completeness, timeliness, and model fit.']
  r_squared decimal(18,6) [note: 'Coefficient of determination indicating the proportion of variance in security returns explained by the factor model. Range 0 to 1.']
  record_created_timestamp timestamp [note: 'Timestamp when this factor exposure record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this factor exposure record was last updated or modified.']
  t_statistic decimal(18,6) [note: 'Statistical t-statistic measuring the significance of the factor exposure. Values above 2 or below -2 typically indicate statistical significance.']

  Note: 'Equity factor exposure records for securities and portfolios based on Barra and CAPM factor models. Captures factor model version (Barra GEM, USE, EUE), exposure date, factor name (market beta, size, value, momentum, quality, low volatility, growth'
}

Table equity.equity_sector_classification {
  equity_sector_classification_id varchar [pk, note: 'Unique identifier for the sector classification record.']
  listed_security_id varchar [note: 'Reference to the equity security being classified.']
  analyst_override_flag boolean [note: 'Indicates whether internal investment analysts have overridden the standard classification for portfolio management purposes.']
  benchmark_inclusion_flag boolean [note: 'Indicates whether this classification is used for benchmark index inclusion and sector allocation decisions.']
  classification_confidence_score decimal(5,2) [note: 'Confidence level or quality score assigned by the classification provider, typically 0-100 percent.']
  classification_methodology varchar [note: 'Description of the methodology or criteria used to assign the classification.']
  classification_notes varchar [note: 'Free-text notes or comments regarding special considerations, edge cases, or analyst observations for this classification.']
  classification_scheme varchar [note: 'Standard classification taxonomy used for sector categorization.']
  classification_source varchar [note: 'Data provider or system that supplied the classification data.']
  classification_status varchar [note: 'Current lifecycle status of this classification assignment.']
  classification_version varchar [note: 'Version or edition of the classification scheme applied.']
  created_timestamp timestamp [note: 'Timestamp when this classification record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  data_quality_flag boolean [note: 'Indicator of the data quality and verification status of this classification record.']
  effective_date date [note: 'Date from which this sector classification becomes effective for the security.']
  expiration_date date [note: 'Date on which this sector classification ceases to be effective, null for current classifications.']
  industry_code varchar [note: 'Third-level industry classification code within the industry group.']
  industry_group_code varchar [note: 'Second-level industry group classification code within the sector.']
  industry_group_name varchar [note: 'Human-readable name of the industry group.']
  industry_name varchar [note: 'Human-readable name of the industry.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the security.']
  last_modified_by varchar [note: 'User or system identifier that last modified this classification record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this classification record was last updated.']
  last_review_date date [note: 'Date when this classification was last reviewed or validated by internal data stewards or analysts.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this classification.']
  override_justification varchar [note: 'Business rationale provided by analysts for classification override decisions.']
  previous_sector_code varchar [note: 'Prior sector code before reclassification, null for initial classifications.']
  previous_sub_industry_code varchar [note: 'Prior sub-industry code before reclassification, null for initial classifications.']
  primary_classification_flag boolean [note: 'Indicates whether this is the primary sector classification for the security when multiple schemes are used.']
  reclassification_reason varchar [note: 'Business rationale for any change in sector classification, such as merger, business model shift, or scheme update.']
  revenue_percentage decimal(5,2) [note: 'Percentage of company revenue derived from this sector or sub-industry, used for multi-sector companies.']
  sector_code varchar [note: 'Top-level sector classification code within the chosen scheme.']
  sector_name varchar [note: 'Human-readable name of the top-level sector.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  sub_industry_code varchar [note: 'Fourth-level sub-industry classification code providing the most granular categorization.']
  sub_industry_name varchar [note: 'Human-readable name of the sub-industry.']
  created_by varchar [note: 'User or system identifier that created this classification record.']

  Note: 'Equity sector and industry classification master for listed securities using standard classification schemes. Captures classification scheme (GICS, ICB, NAICS, SIC), sector code, industry group code, industry code, sub-industry code, sector name, industry'
}

Table equity.security_sector_mapping {
  security_sector_mapping_id varchar [pk, note: 'Unique identifier for the security sector mapping record.']
  listed_security_id varchar [note: 'Reference to the equity security being classified.']
  benchmark_alignment_flag boolean [note: 'Indicates whether this classification aligns with the sector classification used in the portfolios primary benchmark index.']
  benchmark_sector_code varchar [note: 'Sector code as defined by the benchmark index provider for comparison and attribution purposes.']
  carbon_intensity_sector varchar [note: 'Sector grouping used for greenhouse gas emissions and carbon intensity analysis.']
  classification_confidence_score decimal(5,2) [note: 'Numeric score representing the confidence or quality of the classification assignment, typically expressed as a percentage.']
  classification_notes varchar [note: 'Free-text field capturing additional context, commentary, or special considerations regarding the sector classification.']
  classification_scheme varchar [note: 'Industry classification standard used for sector assignment. GICS (Global Industry Classification Standard), ICB (Industry Classification Benchmark), TRBC (Thomson Reuters Business Classification), BICS (Bloomberg Industry Classification System), NAICS']
  classification_source varchar [note: 'Data provider or system that supplied the sector classification, such as Bloomberg, MSCI, FactSet, or internal research.']
  classification_source_identifier varchar [note: 'Unique identifier or reference code from the classification source system.']
  classification_status varchar [note: 'Current lifecycle status of the sector mapping record.']
  classification_version varchar [note: 'Version or edition of the classification scheme applied, as schemes evolve over time.']
  created_timestamp timestamp [note: 'Date and time when this sector mapping record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  data_quality_flag boolean [note: 'Indicator of the data quality status for this classification record.']
  effective_date date [note: 'Date from which this sector classification becomes valid and applicable for the security.']
  esg_sector_classification varchar [note: 'Sector classification specific to ESG analysis frameworks, which may differ from financial sector classifications.']
  expiry_date date [note: 'Date on which this sector classification ceases to be valid, nullable for current classifications.']
  industry_code varchar [note: 'Code representing the industry, a further sub-classification within the industry group.']
  industry_group_code varchar [note: 'Code representing the industry group, a sub-classification within the sector.']
  industry_group_name varchar [note: 'Human-readable name of the industry group classification.']
  industry_name varchar [note: 'Human-readable name of the industry classification.']
  internal_sector_code varchar [note: 'Proprietary internal sector classification code used for portfolio construction and risk management.']
  internal_sector_name varchar [note: 'Human-readable name of the internal sector classification.']
  isin varchar [note: 'ISO 6166 twelve-character alphanumeric code uniquely identifying the security.']
  last_updated_timestamp timestamp [note: 'Date and time when this sector mapping record was most recently modified.']
  last_verification_date date [note: 'Date when the sector classification was last verified or reviewed by internal teams.']
  manual_override_flag boolean [note: 'Indicates whether the classification was manually overridden by internal research or portfolio management teams.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the sector classification.']
  override_by_user varchar [note: 'Username or identifier of the analyst or portfolio manager who performed the manual override.']
  override_reason varchar [note: 'Explanation for manual override of the sector classification, capturing internal research rationale.']
  override_timestamp timestamp [note: 'Date and time when the manual override was applied.']
  primary_classification_flag boolean [note: 'Indicates whether this is the primary sector classification for the security when multiple schemes or classifications are assigned.']
  reclassification_reason varchar [note: 'Business rationale or trigger for sector reclassification, such as corporate action, scheme update, or business model change.']
  regulatory_sector_classification varchar [note: 'Sector classification required for regulatory reporting to SEC, or other governing bodies.']
  sector_code varchar [note: 'Numeric or alphanumeric code representing the sector within the classification scheme.']
  sector_name varchar [note: 'Human-readable name of the sector classification.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  sub_industry_code varchar [note: 'Code representing the most granular sub-industry classification level.']
  sub_industry_name varchar [note: 'Human-readable name of the sub-industry classification.']

  Note: 'Association table mapping listed equity securities to their sector and industry classifications under one or more classification schemes at a point in time. Captures the effective date, expiry date, primary classification flag, and classification source.'
}

Table equity.stock_selection {
  stock_selection_id varchar [pk, note: 'Unique identifier for the stock selection decision record.']
  analyst_employee_id varchar [note: 'Reference to the equity analyst who authored this stock selection recommendation.']
  employee_id varchar [note: 'Reference to the equity analyst who authored this stock selection recommendation.']
  listed_security_id varchar [note: 'Reference to the equity security being evaluated for selection.']
  portfolio_id varchar [note: 'Reference to the target portfolio for which this stock selection decision applies.']
  research_note_id varchar [note: 'Reference to the underlying equity research note that supports this selection decision.']
  valuation_model_id varchar [note: 'Reference to the valuation model used to derive intrinsic value for this selection.']
  active_weight_percent decimal(8,5) [note: 'Recommended active weight relative to benchmark, calculated as target weight minus benchmark weight.']
  benchmark_weight_percent decimal(8,5) [note: 'Weight of the equity security in the relevant benchmark index as a percentage.']
  beta decimal(6,4) [note: 'Beta coefficient measuring the equity securitys systematic risk relative to the market benchmark.']
  conviction_level varchar [note: 'Analysts confidence level in the stock selection recommendation based on research quality and market conditions.']
  country_of_risk varchar [note: 'Three-letter ISO country code representing the primary country of economic risk exposure.']
  created_timestamp timestamp [note: 'Timestamp when this stock selection record was first created in the system.']
  current_market_price decimal(18,4) [note: 'Market price of the equity security at the time of the selection decision.']
  cusip varchar [note: 'CUSIP identifier for the equity security, primarily used in North American markets.']
  decision_date date [note: 'Date on which the stock selection decision was formally made by the equity investment team.']
  dividend_yield_percent decimal(6,4) [note: 'Current dividend yield of the equity security as a percentage of market price.']
  effective_date date [note: 'Date from which the stock selection decision becomes effective for portfolio construction and trading.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors were formally integrated into the stock selection decision process.']
  esg_score decimal(5,2) [note: 'ESG rating score for the equity security from the designated ESG data provider.']
  expected_return_percent decimal(8,4) [note: 'Expected total return percentage over the investment horizon, including capital appreciation and dividends.']
  expiry_date date [note: 'Date on which the stock selection decision expires and requires review or renewal.']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved this stock selection decision.']
  ic_approval_required_flag boolean [note: 'Indicates whether this stock selection decision requires formal Investment Committee approval before implementation.']
  implementation_date date [note: 'Date on which the stock selection decision was fully implemented into the portfolio through trade execution.']
  implementation_status varchar [note: 'Status of the execution and implementation of the stock selection decision into the portfolio.']
  intrinsic_value decimal(18,4) [note: 'Calculated intrinsic value per share derived from the valuation model, representing fundamental fair value.']
  investment_horizon_months varchar [note: 'Time horizon in months over which the stock selection recommendation applies.']
  investment_thesis_summary varchar [note: 'Concise summary of the core investment thesis supporting the stock selection decision.']
  isin varchar [note: 'International Securities Identification Number for the equity security under selection.']
  key_catalysts varchar [note: 'Identified catalysts expected to drive price movement toward the target price.']
  key_risks varchar [note: 'Primary risks that could prevent the investment thesis from materializing.']
  last_modified_timestamp timestamp [note: 'Timestamp when this stock selection record was last modified.']
  market_capitalization_tier varchar [note: 'Market capitalization size classification of the equity security.']
  price_to_earnings_ratio decimal(8,2) [note: 'Price-to-earnings ratio of the equity security at the time of selection decision.']
  recommendation varchar [note: 'Formal investment recommendation for the equity security relative to portfolio construction objectives.']
  sector_classification varchar [note: 'Industry sector classification of the equity security per standard taxonomy.']
  security_name varchar [note: 'Full legal name of the equity security issuer.']
  sedol varchar [note: 'SEDOL identifier for the equity security, primarily used in UK and European markets.']
  selection_decision_code varchar [note: 'Unique business identifier for this stock selection decision, used for external reference and audit trails.']
  selection_status varchar [note: 'Current lifecycle status of the stock selection decision within the investment approval workflow.']
  style_factor varchar [note: 'Primary investment style factor characterizing the equity security.']
  target_position_value_base_currency decimal(18,2) [note: 'Recommended absolute position value for the equity security in the portfolios base currency.']
  target_price decimal(18,4) [note: 'Analyst target price for the equity security over the investment horizon.']
  target_weight_percent decimal(8,5) [note: 'Recommended portfolio weight for the equity security as a percentage of total portfolio value.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the equity security.']
  upside_downside_percent decimal(8,4) [note: 'Expected percentage return from current market price to target price, representing potential upside or downside.']

  Note: 'Formal stock selection and portfolio-construction decision records produced by the equity investment team for securities in the coverage universe, bridging research output (research_note theses and valuation_model intrinsic values) to portfolio'
}

Table equity.valuation_model {
  valuation_model_id varchar [pk, note: 'Unique identifier for the proprietary equity valuation model record maintained by the internal research team.']
  analyst_employee_id varchar [note: 'Reference to the internal research analyst responsible for building and maintaining this valuation model.']
  employee_id varchar [note: 'Reference to the internal research analyst responsible for building and maintaining this valuation model.']
  listed_security_id varchar [note: 'Reference to the equity security being valued in this model.']
  approval_date date [note: 'Date when the valuation model was formally approved for use in investment decision-making.']
  approved_by varchar [note: 'Name or identifier of the senior analyst or investment committee member who approved the valuation model for use.']
  capex_percent_of_revenue decimal(10,4) [note: 'Capital expenditure as a percentage of revenue, used to estimate reinvestment needs in DCF models.']
  comparable_multiple_type varchar [note: 'Type of valuation multiple used: EV/EBITDA, P/E, P/B, EV/Sales, PEG, or other industry-specific metric. [ENUM-REF-CANDIDATE: EV/EBITDA|P/E|P/B|EV/Sales|PEG|EV/EBIT|P/S|Dividend Yield — promote to reference product]']
  comparable_multiple_value decimal(18,4) [note: 'Valuation multiple derived from comparable companies or transactions, such as EV/EBITDA or P/E ratio.']
  created_timestamp timestamp [note: 'Timestamp when the valuation model record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code in which the intrinsic value estimate is denominated.']
  cusip varchar [note: 'CUSIP identifier for the equity security, primarily used in North American markets.']
  data_source varchar [note: 'Primary data source or system from which financial data and market information for the model were obtained.']
  discount_rate_percent decimal(10,6) [note: 'Weighted Average Cost of Capital or required rate of return used to discount future cash flows in DCF models.']
  ebitda_margin_percent decimal(10,4) [note: 'EBITDA as a percentage of revenue, representing operational profitability assumption in the model.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors have been explicitly integrated into the valuation model assumptions and risk assessment.']
  forecast_period_years varchar [note: 'Number of years for which explicit cash flow or earnings forecasts are modeled before terminal value.']
  intrinsic_value_estimate decimal(18,4) [note: 'Calculated fair value per share based on the valuation model methodology and assumptions.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the equity security being valued.']
  key_assumptions varchar [note: 'Summary of critical assumptions underpinning the valuation model, including macroeconomic, industry, and company-specific factors.']
  key_risks varchar [note: 'Summary of principal risks that could cause actual outcomes to differ materially from the valuation model estimates.']
  last_review_date date [note: 'Date when the valuation model was last reviewed and updated by the research analyst.']
  model_confidence_level varchar [note: 'Analyst assessment of confidence in the valuation model output based on data quality, assumption robustness, and market conditions.']
  model_documentation_url varchar [note: 'Link to detailed model documentation, investment memorandum, or research report supporting the valuation.']
  model_notes varchar [note: 'Additional commentary, caveats, or qualitative observations from the analyst regarding the valuation model.']
  model_status varchar [note: 'Current lifecycle status of the valuation model indicating whether it is actively maintained or archived.']
  model_type varchar [note: 'Type of valuation methodology applied: Discounted Cash Flow, Dividend Discount Model, Enterprise Value to EBITDA multiple, Price-to-Earnings relative, Sum-of-Parts, Net Asset Value-based, or other.']
  model_version varchar [note: 'Version identifier for the valuation model, tracking iterations and updates to methodology or assumptions.']
  net_margin_percent decimal(10,4) [note: 'Net income as a percentage of revenue, representing bottom-line profitability assumption.']
  next_review_date date [note: 'Scheduled date for the next periodic review and update of the valuation model.']
  peer_group_median_multiple decimal(18,4) [note: 'Median valuation multiple of the selected peer group used for relative valuation benchmarking.']
  recommendation varchar [note: 'Analyst investment recommendation based on the valuation model output and qualitative assessment. [ENUM-REF-CANDIDATE: Strong Buy|Buy|Hold|Reduce|Sell|Under Review|Not Rated — 7 candidates stripped; promote to reference product]']
  research_team varchar [note: 'Name of the internal research team or sector coverage group responsible for this valuation model.']
  revenue_cagr_percent decimal(10,4) [note: 'Compound annual growth rate of revenue assumed over the forecast period.']
  scenario_analysis_flag boolean [note: 'Indicates whether scenario analysis has been performed to model bull, base, and bear case valuation outcomes.']
  sedol varchar [note: 'SEDOL identifier for the equity security, primarily used in UK and Irish markets.']
  sensitivity_analysis_flag boolean [note: 'Indicates whether sensitivity analysis has been performed to assess valuation impact of key assumption changes.']
  target_price decimal(18,4) [note: 'Analyst target price per share for the security, typically representing expected price at a future horizon.']
  target_price_horizon_months varchar [note: 'Time horizon in months over which the target price is expected to be achieved.']
  terminal_growth_rate_percent decimal(10,6) [note: 'Perpetual growth rate assumption applied in the terminal value calculation for DCF models.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the equity security.']
  updated_timestamp timestamp [note: 'Timestamp when the valuation model record was last modified or updated.']
  upside_downside_percent decimal(10,4) [note: 'Percentage difference between target price and current market price, indicating expected return potential.']
  valuation_date date [note: 'As-of date for which the intrinsic value estimate is calculated.']
  working_capital_percent_of_revenue decimal(10,4) [note: 'Working capital requirement as a percentage of revenue, used to estimate cash flow adjustments.']

  Note: 'Proprietary equity valuation model records maintained by the internal research team for covered securities. Captures model type (DCF, DDM, EV/EBITDA, P/E relative, sum-of-parts, NAV-based), model version, valuation date, intrinsic value estimate'
}

Table equity.equity_issuer {
  equity_issuer_id varchar [pk, note: 'Unique identifier for the corporate issuer entity whose equity securities are held or covered by the fund.']
  parent_issuer_equity_issuer_id varchar [note: 'Reference to the ultimate parent company issuer if this issuer is a subsidiary within a corporate group structure.']
  accounting_standard varchar [note: 'The primary accounting standard framework used by the issuer for financial statement preparation and reporting.']
  auditor_name varchar [note: 'The name of the external audit firm responsible for auditing the issuers financial statements.']
  carbon_intensity decimal(12,2) [note: 'Greenhouse gas emissions intensity measured as tonnes of CO2 equivalent per million USD revenue, used for climate risk assessment.']
  ceo_name varchar [note: 'Full name of the current Chief Executive Officer leading the issuers executive management team.']
  cfo_name varchar [note: 'Full name of the current Chief Financial Officer responsible for the issuers financial management and reporting.']
  coverage_initiation_date date [note: 'The date on which the pension fund initiated research coverage and monitoring of this equity issuer.']
  coverage_status varchar [note: 'Current status of the pension funds research coverage and monitoring activity for this issuer.']
  created_timestamp timestamp [note: 'The timestamp when this issuer master data record was first created in the system.']
  credit_rating_fitch varchar [note: 'The current long-term issuer credit rating assigned by Fitch Ratings agency.']
  credit_rating_moody varchar [note: 'The current long-term issuer credit rating assigned by Moodys Investors Service rating agency.']
  credit_rating_sp varchar [note: 'The current long-term issuer credit rating assigned by Standard and Poors rating agency.']
  data_source varchar [note: 'The source system or data provider from which this issuer master data record was obtained or last updated.']
  employee_count varchar [note: 'Total number of full-time equivalent employees working for the issuer globally as of the most recent reporting period.']
  fiscal_year_end_day varchar [note: 'The day of the month on which the issuers fiscal year ends for financial reporting purposes.']
  fiscal_year_end_month varchar [note: 'The month number (1-12) in which the issuers fiscal year ends for financial reporting purposes.']
  gics_industry_code varchar [note: 'Six-digit GICS industry code providing detailed classification of the issuers specific industry segment.']
  gics_industry_group_code varchar [note: 'Four-digit GICS industry group code providing more granular classification of the issuers business activities.']
  gics_sector_code varchar [note: 'Two-digit GICS sector code classifying the issuers primary business activity at the highest industry classification level.']
  gics_sub_industry_code varchar [note: 'Eight-digit GICS sub-industry code providing the most granular classification of the issuers business activities.']
  headquarters_address varchar [note: 'Full street address of the issuers principal executive offices and headquarters location.']
  headquarters_city varchar [note: 'The city where the issuers principal executive offices and headquarters are located.']
  headquarters_country_code varchar [note: 'ISO 3166-1 alpha-3 country code representing the location of the issuers principal executive offices.']
  incorporation_country_code varchar [note: 'ISO 3166-1 alpha-3 country code representing the jurisdiction where the issuer is legally incorporated.']
  incorporation_date date [note: 'The date on which the issuer was legally incorporated or established in its jurisdiction.']
  investment_grade_flag boolean [note: 'Boolean indicator of whether the issuer holds investment grade credit ratings (BBB-/Baa3 or higher) from major rating agencies.']
  investor_relations_email varchar [note: 'Primary email contact for investor relations inquiries and shareholder communications.']
  investor_relations_phone varchar [note: 'Primary telephone contact number for investor relations department and shareholder inquiries.']
  issuer_status varchar [note: 'Current operational and market status of the issuer reflecting its lifecycle state. [ENUM-REF-CANDIDATE: active|inactive|merged|acquired|delisted|bankrupt|liquidated — 7 candidates stripped; promote to reference product]']
  issuer_type varchar [note: 'Classification of the issuer entity type indicating its legal and organizational structure. [ENUM-REF-CANDIDATE: public_corporation|private_corporation|government_entity|supranational|reit|trust|partnership — 7 candidates stripped; promote to reference']
  legal_name varchar [note: 'The official registered legal name of the corporate issuer as recorded in incorporation documents.']
  lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier uniquely identifying the issuer in global financial markets.']
  market_capitalization_tier varchar [note: 'Classification of the issuer based on total market capitalization size for portfolio construction and benchmark alignment.']
  msci_esg_rating varchar [note: 'The MSCI ESG rating assessing the issuers management of financially relevant environmental, social, and governance risks. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC — 7 candidates stripped; promote to reference product]']
  net_zero_commitment_flag boolean [note: 'Boolean indicator of whether the issuer has made a public commitment to achieve net zero greenhouse gas emissions by a target date.']
  net_zero_target_year varchar [note: 'The calendar year by which the issuer has committed to achieve net zero greenhouse gas emissions, if applicable.']
  primary_exchange_code varchar [note: 'Market Identifier Code (MIC) of the primary stock exchange where the issuers equity securities are listed and traded.']
  primary_listing_currency_code varchar [note: 'ISO 4217 three-letter currency code in which the issuers primary listed equity securities are denominated and traded.']
  primary_listing_ticker varchar [note: 'The ticker symbol under which the issuers equity securities trade on the primary exchange.']
  record_version varchar [note: 'Version number tracking the number of updates made to this issuer master data record for change management and audit purposes.']
  short_name varchar [note: 'Commonly used abbreviated or trading name of the issuer for operational and reporting purposes.']
  sustainalytics_esg_risk_score decimal(5,2) [note: 'Sustainalytics ESG Risk Score measuring the magnitude of unmanaged ESG risks facing the issuer (0-100 scale, higher is riskier).']
  ultimate_parent_lei varchar [note: 'The Legal Entity Identifier of the ultimate parent entity at the top of the corporate ownership hierarchy.']
  updated_by varchar [note: 'The user identifier or system process that performed the most recent update to this issuer master data record.']
  updated_timestamp timestamp [note: 'The timestamp when this issuer master data record was most recently updated or modified.']
  website_url varchar [note: 'The primary corporate website URL for the issuer providing investor relations and company information.']

  Note: 'Corporate issuer master data for companies whose equity securities are held or covered by the fund. Captures legal entity name, LEI, headquarters country, incorporation jurisdiction, primary stock exchange, primary listing currency, parent company'
}

Table equity.issuer_financials {
  issuer_financials_id varchar [pk, note: 'Unique identifier for the issuer financial record.']
  listed_security_id varchar [note: 'Reference to the equity security for which financial data is reported.']
  capital_expenditures decimal(20,2) [note: 'Cash spent on property, plant, equipment, and intangible assets during the period, in reporting currency.']
  cash_and_equivalents decimal(20,2) [note: 'Cash and highly liquid short-term investments as of period end, in reporting currency.']
  cost_of_revenue decimal(20,2) [note: 'Direct costs attributable to revenue generation, in reporting currency.']
  created_timestamp timestamp [note: 'Timestamp when this financial record was first created in the system.']
  cusip varchar [note: 'CUSIP identifier for North American securities.']
  data_provider varchar [note: 'Name of the financial data vendor or source providing this financial information.']
  data_quality_flag boolean [note: 'Indicator of data quality and verification status.']
  data_source_type varchar [note: 'Classification of the financial data source: reported actuals, analyst consensus estimates, restated figures, or preliminary results.']
  depreciation_amortization decimal(20,2) [note: 'Total depreciation and amortization expense for the period, in reporting currency.']
  dividends_paid decimal(20,2) [note: 'Total cash dividends paid to shareholders during the period, in reporting currency.']
  ebit decimal(20,2) [note: 'Operating income or earnings before interest and taxes, in reporting currency.']
  ebitda decimal(20,2) [note: 'Earnings before interest, taxes, depreciation, and amortization, in reporting currency.']
  eps_basic decimal(10,4) [note: 'Basic earnings per share calculated as net income divided by weighted average shares outstanding.']
  eps_diluted decimal(10,4) [note: 'Diluted earnings per share accounting for potential dilution from convertible securities and options.']
  filing_date date [note: 'Date when the financial statements were filed with regulatory authorities.']
  financing_cash_flow decimal(20,2) [note: 'Net cash provided by or used in financing activities for the period, in reporting currency.']
  fiscal_period_type varchar [note: 'Type of reporting period for the financial data.']
  fiscal_quarter varchar [note: 'Fiscal quarter within the year, if applicable (1-4).']
  fiscal_year varchar [note: 'Fiscal year for which the financial data is reported.']
  free_cash_flow decimal(20,2) [note: 'Operating cash flow minus capital expenditures, in reporting currency.']
  gross_profit decimal(20,2) [note: 'Revenue minus cost of revenue, in reporting currency.']
  income_tax_expense decimal(20,2) [note: 'Total income tax expense for the period, in reporting currency.']
  interest_expense decimal(20,2) [note: 'Total interest expense on debt and other obligations, in reporting currency.']
  interest_income decimal(20,2) [note: 'Interest income earned on cash, investments, and receivables, in reporting currency.']
  investing_cash_flow decimal(20,2) [note: 'Net cash used in investing activities for the period, in reporting currency.']
  isin varchar [note: 'ISO 6166 International Securities Identification Number for the equity security.']
  issuer_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the issuer.']
  issuer_name varchar [note: 'Legal name of the issuing company or entity.']
  net_income decimal(20,2) [note: 'Net income attributable to common shareholders after all expenses and taxes, in reporting currency.']
  operating_cash_flow decimal(20,2) [note: 'Net cash provided by operating activities for the period, in reporting currency.']
  operating_expenses decimal(20,2) [note: 'Total operating expenses including selling, general, and administrative expenses, in reporting currency.']
  other_income_expense decimal(20,2) [note: 'Non-operating income and expenses not classified elsewhere, in reporting currency.']
  period_end_date date [note: 'End date of the fiscal reporting period.']
  pretax_income decimal(20,2) [note: 'Income before income tax expense, in reporting currency.']
  reporting_currency_code varchar [note: 'ISO 4217 three-letter currency code in which financial figures are reported.']
  reporting_date date [note: 'Date when the financial results were officially reported or filed.']
  revenue decimal(20,2) [note: 'Total revenue or net sales for the reporting period, in reporting currency.']
  sedol varchar [note: 'SEDOL identifier for securities traded on London Stock Exchange and other exchanges.']
  shares_outstanding_basic decimal(18,2) [note: 'Weighted average number of basic shares outstanding during the period.']
  shares_outstanding_diluted decimal(18,2) [note: 'Weighted average number of diluted shares outstanding including potential dilutive securities.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the equity security.']
  total_assets decimal(20,2) [note: 'Total assets on the balance sheet as of period end, in reporting currency.']
  total_debt decimal(20,2) [note: 'Total short-term and long-term debt outstanding as of period end, in reporting currency.']
  total_equity decimal(20,2) [note: 'Total shareholders equity as of period end, in reporting currency.']
  total_liabilities decimal(20,2) [note: 'Total liabilities on the balance sheet as of period end, in reporting currency.']

  Note: 'Standardized fundamental financial data for equity issuers, capturing reported and consensus financial metrics used in equity analysis. Includes period type (annual, semi-annual, quarterly), reporting date, revenue, EBITDA, EBIT, net income, EPS (basic'
}

Table equity.dividend_record {
  dividend_record_id varchar [pk, note: 'Unique identifier for the dividend income record.']
  corporate_action_id varchar [note: 'External reference identifier for the corporate action event from the data provider or custodian.']
  equity_position_id varchar [note: 'Reference to the specific equity position record associated with this dividend.']
  listed_security_id varchar [note: 'Reference to the equity security that declared the dividend.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding the equity position that generated this dividend.']
  accrual_date date [note: 'Date on which the dividend income was accrued in the fund accounting records, typically the ex-dividend date.']
  base_currency_code varchar [note: 'ISO 4217 three-letter code for the fund reporting base currency.']
  country_of_domicile varchar [note: 'ISO 3166-1 alpha-3 country code of the legal jurisdiction where the issuer is incorporated.']
  country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary country where the issuer operates and generates revenue.']
  created_timestamp timestamp [note: 'Timestamp when this dividend record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  custodian_account_number varchar [note: 'Account number at the custodian bank where the dividend cash was received.']
  custodian_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the custodian bank that received and processed the dividend payment.']
  data_source varchar [note: 'System or vendor that provided the dividend corporate action data, such as Bloomberg, custodian feed, or internal research.']
  declaration_date date [note: 'Date on which the issuer board of directors announced the dividend payment.']
  dividend_currency_code varchar [note: 'ISO 4217 three-letter currency code in which the dividend is declared and paid.']
  dividend_frequency varchar [note: 'Typical frequency at which the issuer pays dividends: annual, semi-annual, quarterly, monthly, or irregular.']
  dividend_rate_per_share decimal(18,6) [note: 'Declared dividend amount per share in the dividend currency.']
  dividend_status varchar [note: 'Current lifecycle status of the dividend: declared by issuer, accrued in accounting, paid and received, cancelled by issuer, or pending settlement.']
  dividend_type varchar [note: 'Classification of the dividend payment: ordinary recurring dividend, special one-time dividend, interim mid-year payment, final year-end payment, liquidating distribution, or return of capital.']
  ex_dividend_date date [note: 'First trading date on which the security trades without the dividend entitlement; positions held before this date are entitled to the dividend.']
  fx_rate decimal(18,8) [note: 'Exchange rate used to convert dividend amounts from dividend currency to base currency, expressed as base currency per unit of dividend currency.']
  fx_rate_date date [note: 'Date on which the FX rate was observed or fixed for currency conversion.']
  gross_dividend_amount_base decimal(18,2) [note: 'Total gross dividend income converted to the fund base currency before withholding taxes.']
  gross_dividend_amount_local decimal(18,2) [note: 'Total gross dividend income in the dividend currency before any withholding taxes or fees.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the equity security.']
  net_dividend_amount_base decimal(18,2) [note: 'Net dividend income received after withholding tax, converted to the fund base currency.']
  net_dividend_amount_local decimal(18,2) [note: 'Net dividend income received after withholding tax deduction, in the dividend currency.']
  notes varchar [note: 'Free-text field for additional commentary, exceptions, or special handling instructions related to this dividend record.']
  payment_date date [note: 'Date on which the dividend cash is distributed to entitled shareholders.']
  quantity_held decimal(18,4) [note: 'Number of shares held in the portfolio on the record date that are entitled to receive the dividend.']
  record_date date [note: 'Date on which shareholders must be registered on the issuer books to receive the dividend payment.']
  record_version varchar [note: 'Version number incremented with each update to support change tracking and audit history.']
  reinvestment_flag boolean [note: 'Indicates whether the dividend was reinvested into additional shares of the security rather than received as cash.']
  sector_classification varchar [note: 'Industry sector classification of the equity issuer using GICS, ICB, or internal taxonomy.']
  security_name varchar [note: 'Full legal name of the equity security issuer.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  settlement_date date [note: 'Date on which the dividend cash was actually received and settled in the fund custody account.']
  tax_reclaim_amount_local decimal(18,2) [note: 'Estimated or actual amount of withholding tax eligible for reclaim in the dividend currency.']
  tax_reclaim_eligible_flag boolean [note: 'Indicates whether the fund is eligible to reclaim a portion of the withheld tax under applicable tax treaties.']
  tax_reclaim_status varchar [note: 'Current status of the tax reclaim process: not applicable, pending initiation, submitted to tax authority, approved for payment, cash received, or rejected.']
  ticker_symbol varchar [note: 'Exchange trading symbol for the equity security.']
  updated_timestamp timestamp [note: 'Timestamp when this dividend record was last modified.']
  withholding_tax_amount_base decimal(18,2) [note: 'Withholding tax amount converted to the fund base currency.']
  withholding_tax_amount_local decimal(18,2) [note: 'Absolute amount of tax withheld at source in the dividend currency.']
  withholding_tax_rate_percent decimal(5,2) [note: 'Percentage rate of tax withheld at source by the issuer jurisdiction on the gross dividend.']

  Note: 'Dividend income records for equity positions held by the fund, capturing declared dividends, accrued income, and received cash flows at the security-portfolio level.'
}

Table equity.proxy_voting_record {
  proxy_voting_record_id varchar [pk, note: 'Unique identifier for the proxy voting record.']
  employee_id varchar [note: 'Reference to the responsible investment or ESG analyst who reviewed the resolution.']
  listed_security_id varchar [note: 'Reference to the equity security for which the proxy vote was cast.']
  portfolio_id varchar [note: 'Reference to the portfolio holding the equity position at the time of the vote.']
  responsible_investment_analyst_employee_id varchar [note: 'Reference to the responsible investment or ESG analyst who reviewed the resolution.']
  ballot_reference varchar [note: 'Unique identifier for the ballot or resolution within the meeting.']
  cusip varchar [note: 'CUSIP identifier for the equity security.']
  custodian_account_number varchar [note: 'Account number at the custodian bank for the portfolio holding the shares.']
  custodian_name varchar [note: 'Name of the custodian bank holding the shares and facilitating the proxy voting process.']
  disclosure_required_flag boolean [note: 'Indicates whether the vote must be disclosed publicly or to beneficiaries under regulatory or policy requirements.']
  esg_relevance_flag boolean [note: 'Indicates whether the resolution has material Environmental, Social, or Governance (ESG) implications.']
  esg_theme varchar [note: 'Primary ESG theme associated with the resolution (e.g., Climate Change, Board Diversity, Executive Pay, Human Rights).']
  fund_vote_decision varchar [note: 'Actual voting decision made by the pension fund: For, Against, Abstain, Withhold, Do Not Vote, or Take No Action.']
  isin varchar [note: 'International Securities Identification Number for the equity security.']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer company.']
  issuer_name varchar [note: 'Legal name of the company issuing the equity security.']
  management_recommendation varchar [note: 'Voting recommendation provided by the company management: For, Against, Abstain, or No Recommendation.']
  meeting_country_code varchar [note: 'Three-letter ISO country code for the jurisdiction where the meeting was held.']
  meeting_date date [note: 'Date on which the shareholder meeting was held.']
  meeting_location varchar [note: 'Physical or virtual location where the shareholder meeting was held.']
  meeting_outcome varchar [note: 'Final outcome of the resolution vote: Passed, Failed, Withdrawn, Postponed, or Pending.']
  meeting_type varchar [note: 'Type of shareholder meeting: Annual General Meeting (AGM), Extraordinary General Meeting (EGM), Special, Class, Adjourned, or Written Consent.']
  policy_alignment_flag boolean [note: 'Indicates whether the funds vote aligned with its internal proxy voting policy guidelines.']
  proxy_advisor_name varchar [note: 'Name of the proxy advisory firm providing the voting recommendation.']
  proxy_advisor_recommendation varchar [note: 'Voting recommendation provided by the external proxy advisory firm (e.g., ISS, Glass Lewis): For, Against, Abstain, or No Recommendation.']
  proxy_service_provider varchar [note: 'Name of the third-party proxy voting service provider or platform used to manage and submit votes.']
  record_created_timestamp timestamp [note: 'Date and time when this proxy voting record was first created in the system.']
  record_date date [note: 'Date on which shareholders must be registered to be eligible to vote at the meeting.']
  record_updated_timestamp timestamp [note: 'Date and time when this proxy voting record was last updated.']
  resolution_category varchar [note: 'Classification of the resolution type: Director Election, Executive Compensation, Audit, Capital Structure, Merger and Acquisition, Shareholder Proposal, Governance, Environmental Social and Governance (ESG), or Other.']
  resolution_description varchar [note: 'Full text or summary description of the resolution being voted upon.']
  resolution_number varchar [note: 'Sequential number or code assigned to the resolution on the meeting agenda.']
  resolution_sub_category varchar [note: 'Detailed sub-classification of the resolution within the primary category.']
  sedol varchar [note: 'SEDOL identifier for the equity security.']
  shares_entitled decimal(18,4) [note: 'Total number of shares held by the fund that were entitled to vote on the record date.']
  shares_voted decimal(18,4) [note: 'Number of shares voted by the fund on this resolution.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the equity security.']
  vote_approved_by varchar [note: 'Name or identifier of the individual or committee who approved the voting decision.']
  vote_approved_timestamp timestamp [note: 'Date and time when the voting decision was formally approved.']
  vote_confirmation_number varchar [note: 'Confirmation or reference number provided by the proxy service provider upon successful vote submission.']
  vote_rationale varchar [note: 'Explanation or justification for the funds voting decision, particularly when deviating from policy or advisor recommendations.']
  vote_review_status varchar [note: 'Status of internal review and approval process for the vote: Pending, Reviewed, Approved, or Escalated.']
  vote_submission_method varchar [note: 'Method by which the vote was submitted: Electronic, Paper, Proxy Card, Custodian, or Third-Party Platform.']
  vote_submission_timestamp timestamp [note: 'Date and time when the vote was submitted to the proxy service provider or custodian.']
  votes_abstain_percent decimal(8,4) [note: 'Percentage of total votes abstained from the resolution across all shareholders.']
  votes_against_percent decimal(8,4) [note: 'Percentage of total votes cast against the resolution across all shareholders.']
  votes_for_percent decimal(8,4) [note: 'Percentage of total votes cast in favor of the resolution across all shareholders.']
  voting_power_percent decimal(8,4) [note: 'Percentage of total outstanding shares represented by the funds vote.']

  Note: 'Records of the fund\'s proxy voting decisions and outcomes for shareholder meetings of equity holdings. Captures meeting type (AGM, EGM), meeting date, resolution number, resolution description, resolution category (director election, executive'
}

Table equity.engagement_log {
  engagement_log_id varchar [pk, note: 'Unique identifier for the engagement log record.']
  employee_id varchar [note: 'Reference to the internal analyst or stewardship team member who led the engagement.']
  engagement_controversy_id varchar [note: 'Reference to a related ESG controversy record that triggered or informed the engagement.']
  engagement_related_controversy_id varchar [note: 'Reference to a related ESG controversy record that triggered or informed the engagement.']
  lead_analyst_employee_id varchar [note: 'Reference to the internal analyst or stewardship team member who led the engagement.']
  listed_security_id varchar [note: 'Reference to the equity security that is the subject of this engagement.']
  related_proxy_vote_proxy_voting_record_id varchar [note: 'Reference to a related proxy vote record if the engagement is connected to a voting decision.']
  related_proxy_voting_record_id varchar [note: 'Reference to a related proxy vote record if the engagement is connected to a voting decision.']
  active_flag boolean [note: 'Indicates whether the engagement log record is currently active or has been archived.']
  collaborative_partner_names varchar [note: 'Names of other institutional investors or organizations that participated in collaborative engagement.']
  confidentiality_level varchar [note: 'Confidentiality classification of the engagement record and associated documentation.']
  country_of_domicile varchar [note: 'ISO 3166-1 alpha-3 country code representing the issuers country of legal domicile.']
  created_timestamp timestamp [note: 'Timestamp when the engagement log record was first created in the system.']
  data_source varchar [note: 'Source system or application from which the engagement log record originated.']
  document_reference_url varchar [note: 'URL or file path to supporting documentation or correspondence related to the engagement.']
  engagement_date date [note: 'Date on which the engagement activity occurred.']
  engagement_duration_minutes varchar [note: 'Duration of the engagement activity measured in minutes.']
  engagement_mode varchar [note: 'Mode of engagement indicating whether conducted directly or through collaborative channels.']
  engagement_notes varchar [note: 'Detailed internal notes and observations from the engagement activity.']
  engagement_objective varchar [note: 'Stated objective or goal the fund seeks to achieve through this engagement.']
  engagement_status varchar [note: 'Current status of the engagement in its lifecycle.']
  engagement_type varchar [note: 'Type or format of the engagement activity conducted with the issuer.']
  escalation_date date [note: 'Date on which escalation action was taken or is planned.']
  escalation_level varchar [note: 'Level of escalation applied or planned if engagement objectives are not met.']
  esg_pillar varchar [note: 'Primary ESG pillar that the engagement topic falls under.']
  follow_up_date date [note: 'Scheduled date for follow-up engagement or review of issuer progress.']
  follow_up_required_flag boolean [note: 'Indicates whether follow-up engagement or monitoring is required.']
  issuer_contact_email varchar [note: 'Email address of the issuer contact person for follow-up communication.']
  issuer_contact_name varchar [note: 'Name of the primary contact person at the issuer organization engaged with.']
  issuer_contact_title varchar [note: 'Job title or role of the issuer contact person engaged with.']
  issuer_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the issuer being engaged.']
  issuer_name varchar [note: 'Legal name of the company or entity being engaged with.']
  lead_analyst_name varchar [note: 'Full name of the lead analyst or stewardship professional responsible for the engagement.']
  market_cap_tier varchar [note: 'Market capitalization tier of the issuer at the time of engagement.']
  meeting_format varchar [note: 'Format or medium through which the engagement was conducted.']
  meeting_location varchar [note: 'Physical or virtual location where the engagement meeting took place.']
  milestone_achieved varchar [note: 'Description of any specific milestone or commitment achieved through the engagement.']
  milestone_date date [note: 'Date on which the engagement milestone was achieved or committed to by the issuer.']
  outcome varchar [note: 'Outcome or result achieved from the engagement activity.']
  outcome_description varchar [note: 'Detailed narrative description of the engagement outcome and any commitments received from the issuer.']
  position_held_flag boolean [note: 'Indicates whether the fund held an equity position in the issuer at the time of engagement.']
  public_disclosure_flag boolean [note: 'Indicates whether this engagement activity is publicly disclosed in stewardship reporting.']
  record_version varchar [note: 'Version number of the engagement log record for audit and change tracking purposes.']
  sector_classification varchar [note: 'Industry sector classification of the issuer being engaged.']
  topic_category varchar [note: 'Primary thematic category of the engagement topic addressed. [ENUM-REF-CANDIDATE: governance|climate|environmental|social|strategy|risk_management|executive_compensation — 7 candidates stripped; promote to reference product]']
  topic_detail varchar [note: 'Detailed description of the specific topic or issue discussed during the engagement.']
  updated_by varchar [note: 'User identifier or name of the person who last updated the engagement log record.']
  updated_timestamp timestamp [note: 'Timestamp when the engagement log record was last updated.']

  Note: 'Records of the fund\'s direct engagement activities with equity issuers as part of active ownership and ESG stewardship. Captures engagement date, engagement type (letter, meeting, call, collaborative engagement), topic category (governance, climate'
}

Table equity.short_interest {
  short_interest_id varchar [pk, note: 'Unique identifier for the short interest record.']
  listed_security_id varchar [note: 'Reference to the equity security that is shorted or lent.']
  portfolio_id varchar [note: 'Reference to the portfolio holding the short position or lending the security.']
  activity_type varchar [note: 'Type of short interest activity: short position held by the fund, securities lending activity, or both.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code for the funds base reporting currency.']
  borrowing_cost_accrued decimal(18,2) [note: 'Accrued borrowing cost incurred to date on short positions, in base currency.']
  borrowing_cost_rate_bps decimal(8,2) [note: 'Annual cost rate paid to borrow securities for short positions, expressed in basis points.']
  collateral_type varchar [note: 'Type of collateral received for securities lending: cash, government bonds, corporate bonds, equities, or mixed.']
  collateral_value_received decimal(18,2) [note: 'Market value of collateral received from the borrower for lent securities, in base currency.']
  compliance_breach_reason varchar [note: 'Description of the compliance breach if the compliance flag is false.']
  compliance_flag boolean [note: 'Indicates whether the short or lending position complies with internal investment policy and regulatory limits.']
  counterparty_lei varchar [note: 'Legal Entity Identifier of the counterparty for the short position or securities lending transaction.']
  counterparty_name varchar [note: 'Legal name of the counterparty broker or lending agent.']
  cusip varchar [note: 'CUSIP identifier for North American securities.']
  custodian_account_number varchar [note: 'Account number at the custodian bank where the short or lending position is held.']
  custodian_lei varchar [note: 'Legal Entity Identifier of the custodian bank holding the position.']
  exchange_code varchar [note: 'Market Identifier Code (MIC) of the primary exchange where the security is traded.']
  fx_rate decimal(18,8) [note: 'Exchange rate used to convert local currency values to base currency.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the equity security.']
  lending_fee_accrued decimal(18,2) [note: 'Accrued lending fee income earned to date on lent securities, in base currency.']
  lending_fee_rate_bps decimal(8,2) [note: 'Annual fee rate earned on securities lending, expressed in basis points.']
  lent_market_value_base decimal(18,2) [note: 'Market value of lent securities in the funds base reporting currency.']
  lent_market_value_local decimal(18,2) [note: 'Market value of lent securities in local trading currency.']
  lent_quantity decimal(18,4) [note: 'Number of shares lent out under securities lending arrangements.']
  loan_maturity_date date [note: 'Scheduled maturity or recall date for the securities lending arrangement; null for open-ended loans.']
  loan_start_date date [note: 'Date on which the securities lending arrangement commenced.']
  local_currency_code varchar [note: 'ISO 4217 three-letter currency code for the local trading currency of the security.']
  position_date date [note: 'Business date for which the short interest or lending position is reported.']
  recall_date date [note: 'Date on which lent securities were recalled by the lender.']
  record_created_timestamp timestamp [note: 'Timestamp when this short interest record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this short interest record was last updated.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this position must be reported to regulatory authorities under short interest disclosure rules.']
  return_date date [note: 'Date on which borrowed or lent securities were returned.']
  sedol varchar [note: 'SEDOL identifier for securities traded on London Stock Exchange and other exchanges.']
  settlement_date date [note: 'Date on which the short sale or securities lending transaction settled.']
  settlement_status varchar [note: 'Current settlement status of the short or lending transaction.']
  short_cost_basis decimal(18,2) [note: 'Original proceeds received when the short position was established, in base currency.']
  short_position_market_value_base decimal(18,2) [note: 'Market value of the short position in the funds base reporting currency.']
  short_position_market_value_local decimal(18,2) [note: 'Market value of the short position in the local trading currency.']
  short_position_quantity decimal(18,4) [note: 'Number of shares held in a short position by the fund.']
  ticker_symbol varchar [note: 'Exchange ticker symbol for the equity security.']
  trade_date date [note: 'Date on which the short sale or lending transaction was executed.']
  unrealized_gain_loss_short decimal(18,2) [note: 'Unrealized profit or loss on the short position in base currency.']
  valuation_source varchar [note: 'Source system or vendor providing the market price used for valuation (e.g., Bloomberg, Reuters, custodian).']

  Note: 'Short interest and securities-lending data for equity positions, capturing both the fund\'s short positions and its stock-lending activity. Short-side fields: short position quantity, short position market value, settlement status, and compliance flags for'
}

Table equity.restriction {
  restriction_id varchar [pk, note: 'Unique identifier for the investment restriction record.']
  listed_security_id varchar [note: 'Reference to the specific security subject to restriction, if applicable.']
  portfolio_id varchar [note: 'Reference to the portfolio subject to this restriction.']
  active_flag boolean [note: 'Indicates whether this restriction record is currently active and enforceable.']
  approval_date date [note: 'Date when this restriction was formally approved.']
  approved_by varchar [note: 'User or authority who approved this restriction for enforcement.']
  asset_class varchar [note: 'Asset class subject to this restriction, if applicable. [ENUM-REF-CANDIDATE: equity|fixed_income|private_equity|real_estate|infrastructure|natural_resources|credit|cash — 8 candidates stripped; promote to reference product]']
  breach_notification_required_flag boolean [note: 'Indicates whether a breach of this restriction requires formal notification to stakeholders or regulators.']
  breach_tolerance_percent decimal(5,2) [note: 'Allowable tolerance percentage before a breach is triggered.']
  comments varchar [note: 'Additional free-text comments or notes regarding this restriction.']
  compliance_system_flag boolean [note: 'Indicates whether this restriction is actively enforced by automated compliance monitoring systems.']
  country_iso_code varchar [note: 'Three-letter ISO country code for geographic restriction, if applicable.']
  created_timestamp timestamp [note: 'Timestamp when this restriction record was first created.']
  effective_date date [note: 'Date when the restriction becomes enforceable.']
  esg_criteria varchar [note: 'ESG criteria or exclusion rationale for this restriction, if applicable.']
  expiration_date date [note: 'Date when the restriction ceases to be enforceable, if applicable.']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer subject to restriction.']
  last_review_date date [note: 'Date when this restriction was last reviewed for continued relevance and accuracy.']
  mandate_reference varchar [note: 'Reference to the investment mandate or Limited Partnership Agreement (LPA) clause imposing this restriction.']
  monitoring_frequency varchar [note: 'Frequency at which compliance with this restriction is monitored.']
  next_review_date date [note: 'Scheduled date for the next review of this restriction.']
  notification_recipient_list varchar [note: 'Comma-separated list of roles or individuals to be notified upon breach.']
  override_allowed_flag boolean [note: 'Indicates whether this restriction can be overridden with appropriate approval.']
  override_approval_level varchar [note: 'Required approval authority level for override: Chief Investment Officer (CIO), Chief Risk Officer (CRO), Investment Committee (IC), Board, or none.']
  policy_document_reference varchar [note: 'Reference to the policy document or regulation defining this restriction.']
  rationale varchar [note: 'Business or regulatory rationale for imposing this restriction.']
  regulatory_authority varchar [note: 'Name of the regulatory body mandating this restriction, if applicable.']
  restriction_code varchar [note: 'Internal code uniquely identifying this restriction rule within the compliance framework.']
  restriction_level varchar [note: 'Hierarchical level at which the restriction applies: fund, portfolio, security, issuer, sector, country, or asset class. [ENUM-REF-CANDIDATE: fund|portfolio|security|issuer|sector|country|asset_class — 7 candidates stripped; promote to reference product]']
  restriction_name varchar [note: 'Human-readable name or title of the restriction rule.']
  restriction_status varchar [note: 'Current lifecycle status of the restriction rule.']
  restriction_type varchar [note: 'Category of restriction: regulatory, mandate, ESG exclusion, sanctions, internal policy, or concentration limit.']
  sanctions_list varchar [note: 'Name of the sanctions list or watchlist triggering this restriction, if applicable.']
  scope varchar [note: 'Scope of the restriction: buy, sell, hold, trade, or all activities.']
  sector_classification varchar [note: 'Industry sector subject to this restriction, if applicable.']
  threshold_unit varchar [note: 'Unit of measure for the threshold value: percent, absolute value, shares, weight, or exposure.']
  threshold_value decimal(18,4) [note: 'Numeric threshold or limit value for the restriction, if applicable.']
  updated_by varchar [note: 'User or system that last updated this restriction record.']
  updated_timestamp timestamp [note: 'Timestamp when this restriction record was last updated.']
  created_by varchar [note: 'User or system that created this restriction record.']

  Note: 'Investment restriction and compliance constraint records specific to equity securities and portfolios. Captures restriction type (regulatory, mandate, ESG exclusion, sanctions, internal policy), restricted security or issuer, restriction scope (buy, sell'
}

Table equity.index_rebalance_event {
  index_rebalance_event_id varchar [pk, note: 'Unique identifier for the index rebalancing event record.']
  compliance_reviewer_employee_id varchar [note: 'Identifier of the compliance officer who reviewed this rebalancing event.']
  employee_id varchar [note: 'Identifier of the compliance officer who reviewed this rebalancing event.']
  equity_benchmark_id varchar [note: 'Reference to the equity benchmark index being rebalanced.']
  active_flag boolean [note: 'Indicates whether this rebalancing event record is currently active and valid.']
  announcement_date date [note: 'Date when the index provider publicly announced the rebalancing changes.']
  announcement_document_url varchar [note: 'Web link to the official rebalancing announcement document published by the index provider.']
  announcement_timestamp timestamp [note: 'Precise date and time when the rebalancing announcement was published.']
  benchmark_code varchar [note: 'Standard code or ticker symbol identifying the benchmark index.']
  benchmark_name varchar [note: 'Full name of the benchmark index undergoing rebalancing.']
  capping_applied_flag boolean [note: 'Indicates whether constituent weight capping rules were applied during rebalancing.']
  compliance_review_date date [note: 'Date when internal compliance review of the rebalancing event was completed.']
  compliance_review_required_flag boolean [note: 'Indicates whether internal compliance review is required before trading on this rebalancing.']
  constituent_list_url varchar [note: 'Web link to the detailed list of additions, deletions, and weight changes.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for monetary values in this rebalancing event.']
  data_source varchar [note: 'System or vendor from which the rebalancing event data was sourced.']
  effective_date date [note: 'Date when the rebalancing changes become effective in the index composition.']
  effective_timestamp timestamp [note: 'Precise date and time when the rebalancing changes take effect.']
  esg_criteria_applied_flag boolean [note: 'Indicates whether ESG screening or criteria were applied in this rebalancing.']
  estimated_trading_volume decimal(20,2) [note: 'Projected total trading volume in base currency required to implement rebalancing.']
  estimated_turnover_percent decimal(5,2) [note: 'Projected portfolio turnover percentage resulting from the rebalancing changes.']
  free_float_minimum_percent decimal(5,2) [note: 'Minimum free float percentage required for a security to be eligible for inclusion.']
  impact_assessment_summary varchar [note: 'Internal summary of the expected portfolio impact from this rebalancing event.']
  index_provider varchar [note: 'Organization that administers and maintains the benchmark index. [ENUM-REF-CANDIDATE: MSCI|S&P Dow Jones|FTSE Russell|Bloomberg|Solactive|Stoxx|Nasdaq|Other — 8 candidates stripped; promote to reference product]']
  liquidity_threshold decimal(20,2) [note: 'Minimum average daily trading volume or turnover required for index inclusion.']
  market_cap_cutoff decimal(20,2) [note: 'Minimum market capitalization threshold applied for index inclusion eligibility.']
  maximum_constituent_weight_percent decimal(5,2) [note: 'Maximum allowable weight for any single constituent after capping rules are applied.']
  methodology_version varchar [note: 'Version identifier of the index methodology applied for this rebalancing.']
  number_of_additions varchar [note: 'Count of securities added to the index during this rebalancing event.']
  number_of_deletions varchar [note: 'Count of securities removed from the index during this rebalancing event.']
  number_of_weight_changes varchar [note: 'Count of existing constituents with modified index weights.']
  portfolio_exposure_flag boolean [note: 'Indicates whether the pension fund holds positions that are affected by this rebalancing.']
  rebalance_rationale varchar [note: 'Business reason or trigger for the rebalancing event as stated by the index provider.']
  rebalance_status varchar [note: 'Current lifecycle state of the rebalancing event.']
  rebalance_type varchar [note: 'Classification of the rebalancing event based on schedule and trigger.']
  record_created_timestamp timestamp [note: 'Date and time when this rebalancing event record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Date and time when this rebalancing event record was last modified.']
  record_version varchar [note: 'Version number of this rebalancing event record for change tracking and audit purposes.']
  review_period_end_date date [note: 'End date of the data observation period used to determine rebalancing changes.']
  review_period_start_date date [note: 'Start date of the data observation period used to determine rebalancing changes.']
  sector_rebalance_flag boolean [note: 'Indicates whether sector classification changes are part of this rebalancing event.']
  total_constituents_post_rebalance varchar [note: 'Total number of securities in the index after rebalancing is complete.']
  trading_strategy_recommendation varchar [note: 'Internal recommendation for how to execute trades in response to the rebalancing event.']
  updated_by varchar [note: 'User or system identifier that last modified this rebalancing event record.']

  Note: 'Records of scheduled and ad-hoc index rebalancing events for equity benchmark indices tracked by the fund. Captures index provider, rebalancing type (quarterly, semi-annual, annual, ad-hoc), announcement date, effective date, additions list, deletions'
}

Table equity.earnings_announcement {
  earnings_announcement_id varchar [pk, note: 'Unique identifier for the earnings announcement record.']
  issuer_financials_id varchar [note: 'Reference to equity.issuer_financials.issuer_financials_id.']
  listed_security_id varchar [note: 'Reference to equity.listed_security.listed_security_id.']
  market_consensus_id varchar [note: 'Reference to research.market_consensus.market_consensus_id.']
  actual_eps decimal(18,6) [note: 'Actual reported earnings per share for the earnings announcement.']
  announcement_date date [note: 'Date on which the earnings announcement was made.']
  consensus_eps decimal(18,6) [note: 'Consensus analyst estimate for earnings per share for this earnings announcement.']
  eps_basis varchar [note: 'Basis used for the EPS figure reported in the earnings announcement (e.g., GAAP, non-GAAP, diluted, basic).']
  fiscal_quarter varchar [note: 'The fiscal quarter of the earnings announcement.']
  fiscal_year varchar [note: 'The fiscal year of the earnings announcement.']

  Note: 'Earnings announcement for a listed security including actual vs consensus EPS.'
}

Table equity.price_target_evaluation {
  price_target_evaluation_id varchar [pk, note: 'Surrogate primary key.']
  research_note_id varchar [note: 'FK to equity.research_note, the note that issued the target.']
  evaluation_date date [note: 'Evaluation date.']
  horizon_days varchar [note: 'Evaluation horizon in days: 90, 180, 365.']
  issue_price decimal(18,6) [note: 'Security price on the notes publication date.']
  realized_price decimal(18,6) [note: 'Security price at the horizon, same currency as the target.']

  Note: 'Outcome of one research price target at its horizon.'
}

Table privateequity.fund {
  fund_id varchar [pk, note: 'Unique identifier for the fund data product (auto-inserted during validation).']
  actor_id varchar [note: 'Reference to the custodian bank or institution holding the funds assets and cash.']
  auditor_id varchar [note: 'Reference to the external audit firm responsible for annual financial statement audits of the fund.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Funds use climate scenarios for stress testing and risk assessment.']
  controversy_id varchar [note: 'Foreign key linking to esg.controversy. Business justification: Funds track controversies affecting portfolio companies for risk management.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Fund uses a specific economic scenario for risk modeling and projections, a core part of investment strategy.']
  employee_id varchar [note: 'Reference to the third-party fund administrator responsible for NAV calculation, capital call processing, and LP reporting.']
  engagement_activity_id varchar [note: 'Foreign key linking to esg.engagement_activity. Business justification: Funds record engagement activities with investees to drive ESG outcomes.']
  engagement_objective_id varchar [note: 'Foreign key linking to esg.engagement_objective. Business justification: Funds set specific engagement objectives for ESG improvement.']
  esg_benchmark_id varchar [note: 'Foreign key linking to esg.esg_benchmark. Business justification: Funds benchmark ESG performance against industry standards.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Each fund follows an ESG policy that sets integration level and compliance requirements.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Funds maintain exclusion lists of securities or sectors to avoid for ESG compliance.']
  fund_administrator_id varchar [note: 'Reference to the third-party fund administrator responsible for NAV calculation, capital call processing, and LP reporting.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity responsible for managing the fund and making investment decisions.']
  macro_model_run_id varchar [note: 'Foreign key linking to research.macro_model_run. Business justification: Macro model runs provide scenario projections used in fund valuation and stress testing.']
  master_fund_id varchar [note: 'Reference to the master fund if this is a feeder fund in a master-feeder structure.']
  risk_model_id varchar [note: 'Foreign key linking to risk.model. Business justification: Fund risk model FK required for VaR calculation and regulatory reporting.']
  stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: Fund stress scenario FK needed for scenario‑based VaR and capital adequacy testing.']
  tcfd_disclosure_id varchar [note: 'Foreign key linking to esg.tcfd_disclosure. Business justification: Funds file TCF disclosures for their portfolio, requiring a link to the disclosure record.']
  benchmark_index varchar [note: 'The primary performance benchmark or peer group index used to evaluate fund performance (e.g., Cambridge Associates PE Index, Preqin Buyout Index).']
  carried_interest_rate decimal(5,4) [note: 'The performance fee rate (carry) paid to the GP from fund profits after the hurdle rate is achieved, expressed as a decimal percentage.']
  catch_up_rate decimal(5,4) [note: 'The percentage of profits allocated to the GP after the hurdle is met and before the carried interest split, allowing GP to catch up to its target carry percentage.']
  clawback_provision boolean [note: 'Indicates whether the LPA includes a clawback provision requiring the GP to return excess carried interest if final fund performance falls below the hurdle.']
  created_timestamp timestamp [note: 'The timestamp when this fund record was first created in the system.']
  currency varchar [note: 'The base currency in which the fund is denominated and reports Net Asset Value (NAV), using ISO 4217 three-letter currency code.']
  domicile_country varchar [note: 'The country of legal domicile or incorporation for the fund vehicle, using ISO 3166-1 alpha-3 country code.']
  domicile_jurisdiction varchar [note: 'The specific legal jurisdiction or state within the domicile country where the fund is registered (e.g., Delaware, Cayman Islands).']
  esg_strategy varchar [note: 'Description of the funds Environmental, Social, and Governance (ESG) integration approach, responsible investment policies, and sustainability commitments.']
  extension_options_years varchar [note: 'The number of additional years the fund term may be extended beyond the base term, subject to GP discretion or LP approval per LPA.']
  final_close_date date [note: 'The date of the funds final capital close when fundraising concluded and no further LP commitments are accepted.']
  first_close_date date [note: 'The date of the funds initial capital close when the first Limited Partner (LP) commitments were accepted and the fund began operations.']
  fund_name varchar [note: 'The full legal name of the private equity fund as registered in the Limited Partnership Agreement (LPA).']
  fund_status varchar [note: 'Current lifecycle stage of the fund: fundraising (capital raising), investing (deployment period), harvesting (realization period), liquidated (fully exited), or dissolved.']
  fund_type varchar [note: 'Classification of the private equity fund strategy: buyout, venture capital, growth equity, secondaries, fund-of-funds (FoF), or co-investment vehicle.']
  hard_cap decimal(18,2) [note: 'The maximum total capital commitment amount the fund is permitted to accept from LPs, as specified in the PPM or LPA.']
  hurdle_rate decimal(5,4) [note: 'The minimum annualized Internal Rate of Return (IRR) that LPs must achieve before the GP is entitled to carried interest, expressed as a decimal percentage.']
  identifier varchar [note: 'External unique identifier or code assigned by the General Partner (GP) or administrator for the fund vehicle.']
  inception_date date [note: 'The date on which the fund was legally established or the Limited Partnership Agreement (LPA) was executed.']
  investment_period_end_date date [note: 'The date on which the funds investment period concludes, after which new investments are generally prohibited per LPA terms.']
  investment_period_start_date date [note: 'The date on which the funds investment period commenced, typically aligned with first close or final close per LPA terms.']
  investment_strategy varchar [note: 'Narrative description of the funds investment strategy, including target sectors, geographies, deal sizes, and value creation approach.']
  is_evergreen boolean [note: 'Indicates whether the fund is an evergreen (open-ended) structure with no fixed termination date, allowing continuous capital raising and redemptions.']
  is_feeder_fund boolean [note: 'Indicates whether this fund is a feeder vehicle that channels LP capital into a master fund structure.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the fund vehicle, used for regulatory reporting and counterparty identification.']
  management_fee_basis varchar [note: 'The basis on which the management fee is calculated: committed capital (during investment period), invested capital (post-investment period), or Net Asset Value (NAV).']
  management_fee_rate decimal(5,4) [note: 'The annual management fee rate charged by the GP, expressed as a decimal percentage of committed or invested capital per LPA terms.']
  maximum_investment_size decimal(18,2) [note: 'The maximum equity check size for individual portfolio company investments, typically expressed as a percentage of total commitments or absolute amount.']
  minimum_investment_size decimal(18,2) [note: 'The minimum equity check size for individual portfolio company investments, as specified in the funds investment guidelines.']
  reporting_frequency varchar [note: 'The frequency at which the fund provides formal performance and portfolio reports to Limited Partners (LPs).']
  sfdr_classification varchar [note: 'EU SFDR classification: Article 6 (no sustainability focus), Article 8 (promotes ESG characteristics), or Article 9 (sustainable investment objective).']
  short_name varchar [note: 'Abbreviated or common name used internally for reporting and operational reference.']
  target_fund_size decimal(18,2) [note: 'The target total capital commitment amount the General Partner (GP) aims to raise from Limited Partners (LPs) during fundraising.']
  target_geographies varchar [note: 'Comma-separated list of target geographic regions or countries for fund investments (e.g., North America, Europe, Asia-Pacific).']
  target_sectors varchar [note: 'Comma-separated list of target industry sectors or verticals the fund focuses on for investment (e.g., technology, healthcare, industrials).']
  term_years varchar [note: 'The total contractual life of the fund in years as specified in the LPA, typically 10-12 years with extension options.']
  termination_date date [note: 'The actual or expected date on which the fund will be dissolved and all assets liquidated, including any extensions exercised.']
  total_commitments decimal(18,2) [note: 'The aggregate capital commitment amount pledged by all Limited Partners (LPs) to the fund, representing total dry powder available for capital calls.']
  updated_timestamp timestamp [note: 'The timestamp when this fund record was last modified in the system.']
  valuation_policy varchar [note: 'Summary of the funds valuation methodology for portfolio company holdings, including frequency and approach (e.g., IPEV Guidelines, ASC 820 Fair Value).']
  vintage_year varchar [note: 'The year in which the fund held its first capital close and began investment operations. Critical for performance benchmarking and cohort analysis.']
  waterfall_structure varchar [note: 'The carried interest distribution methodology: European (whole-fund basis), American (deal-by-deal basis), or hybrid.']

  Note: 'Master record for each private equity fund vehicle in which the pension fund holds an LP interest or manages as a GP. Captures fund name, vintage year, fund type (buyout, venture, growth, secondaries, FoF, co-invest), target size, hard cap, fund currency'
}

Table privateequity.fund_commitment {
  fund_commitment_id varchar [pk, note: 'Unique identifier for the Limited Partner (LP) capital commitment record to a private equity fund.']
  gp_entity_id varchar [note: 'Reference to the General Partner managing the fund.']
  gp_gp_entity_id varchar [note: 'Reference to the General Partner managing the fund.']
  pe_fund_id varchar [note: 'Reference to the private equity fund receiving the commitment.']
  carried_interest_rate_percent decimal(5,4) [note: 'Performance fee percentage paid to the GP after the hurdle rate is achieved, typically 20% of profits above the hurdle.']
  catch_up_rate_percent decimal(5,4) [note: 'Percentage of distributions allocated to the GP after the hurdle is met to bring their total carry to the target rate, typically 80%.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code in which the commitment is denominated.']
  commitment_date date [note: 'Date on which the pension fund executed the commitment to the private equity fund, typically the LPA signature date.']
  commitment_number varchar [note: 'External business identifier for the commitment, often referenced in Limited Partnership Agreement (LPA) and capital call notices.']
  commitment_status varchar [note: 'Current state of the commitment in its lifecycle from active through fully drawn or terminated.']
  commitment_type varchar [note: 'Classification of the commitment structure: primary fund commitment, secondary purchase, co-investment, or fund-of-funds.']
  committed_capital_amount decimal(18,2) [note: 'Total capital amount the pension fund committed to invest in the fund over its investment period, subject to capital calls.']
  created_timestamp timestamp [note: 'System timestamp when this commitment record was first created in the data platform.']
  dpi_multiple decimal(8,4) [note: 'Cash-on-cash return metric calculated as Total Distributions / Paid-In Capital, representing realized value.']
  esg_classification varchar [note: 'SFDR classification of the funds ESG integration: Article 6 (no ESG focus), Article 8 (promotes ESG), Article 9 (sustainable objective).']
  extension_options_count varchar [note: 'Number of one-year extension periods available to the GP beyond the base fund term, typically requiring LP approval.']
  final_close_date date [note: 'Date of the funds final capital close, after which no additional LP commitments are accepted.']
  first_close_date date [note: 'Date of the funds initial capital close when the fund began operations and investment activity.']
  fund_strategy varchar [note: 'Primary investment strategy of the fund: buyout, growth equity, venture capital, distressed, real assets, or infrastructure.']
  fund_term_years varchar [note: 'Total duration of the fund from first close to final liquidation, typically 10-12 years with extension options per the LPA.']
  geographic_focus varchar [note: 'Primary geographic region or country focus of the funds investment mandate.']
  hurdle_rate_percent decimal(5,4) [note: 'Minimum annualized return threshold that LPs must achieve before the GP earns carried interest, typically 8%.']
  investment_period_end_date date [note: 'Date when the funds investment period concludes, after which capital calls are typically limited to follow-on investments and fees.']
  investment_period_start_date date [note: 'Date when the fund begins its investment period during which capital calls for new investments are permitted per the LPA.']
  irr_percent decimal(8,4) [note: 'Annualized time-weighted return on the commitment, calculated using cash flow timing and current NAV.']
  key_person_clause_flag boolean [note: 'Indicates whether the LPA includes key person provisions that suspend investment period if key investment professionals depart.']
  last_capital_call_date date [note: 'Date of the most recent capital call notice issued by the GP for this commitment.']
  last_distribution_date date [note: 'Date of the most recent distribution received from the fund.']
  management_fee_rate_percent decimal(5,4) [note: 'Annual management fee rate charged by the GP, typically 1.5-2.0% of committed capital during investment period and NAV thereafter.']
  modified_timestamp timestamp [note: 'System timestamp when this commitment record was last updated in the data platform.']
  moic_multiple decimal(8,4) [note: 'Gross return multiple calculated as (Distributions + NAV) / Paid-In Capital, synonymous with TVPI.']
  most_favored_nation_flag boolean [note: 'Indicates whether the commitment includes Most Favored Nation rights to receive terms granted to other LPs.']
  nav_amount decimal(18,2) [note: 'Current fair value of the pension funds remaining investment in the fund, representing unrealized value.']
  no_fault_divorce_flag boolean [note: 'Indicates whether LPs have the right to remove the GP without cause under specified voting thresholds.']
  ownership_percentage decimal(7,4) [note: 'Pension funds percentage ownership stake in the fund, calculated as commitment amount divided by total fund size.']
  paid_in_capital_amount decimal(18,2) [note: 'Cumulative capital amount drawn down by the General Partner (GP) through capital calls to date.']
  remaining_commitment_amount decimal(18,2) [note: 'Uncalled committed capital available for future capital calls, also known as dry powder.']
  rvpi_multiple decimal(8,4) [note: 'Unrealized value metric calculated as NAV / Paid-In Capital, representing remaining investment value.']
  sector_focus varchar [note: 'Primary industry sector or sectors targeted by the funds investment strategy.']
  side_letter_flag boolean [note: 'Indicates whether a side letter agreement with special terms or rights exists for this commitment.']
  target_fund_size_amount decimal(18,2) [note: 'Total capital the fund aims to raise from all Limited Partners (LPs), representing the funds target size.']
  termination_date date [note: 'Date on which the commitment was terminated or the fund was fully liquidated.']
  total_distributions_amount decimal(18,2) [note: 'Cumulative distributions received from the fund to date, including return of capital and realized gains.']
  tvpi_multiple decimal(8,4) [note: 'Performance metric calculated as (Distributions + NAV) / Paid-In Capital, representing total value creation.']
  valuation_date date [note: 'Date as of which the NAV, TVPI, DPI, RVPI, and IRR metrics were calculated, typically quarter-end.']
  vintage_year varchar [note: 'Calendar year in which the fund held its first close and began making investments, used for cohort performance benchmarking.']
  waterfall_structure_type varchar [note: 'Distribution waterfall methodology: American (deal-by-deal carry), European (whole-fund carry), or Hybrid.']

  Note: 'Records the pension fund\'s LP capital commitment to a specific PE fund, including committed capital amount, commitment currency, commitment date, vintage year, commitment status (active, fully drawn, terminated), total paid-in capital (PIC), remaining'
}

Table privateequity.privateequity_capital_call {
  privateequity_capital_call_id varchar [pk, note: 'Unique identifier for the capital call record. Primary key for the capital call transaction.']
  deal_opportunity_id varchar [note: 'Reference to the specific private equity deal or investment transaction for which capital is being called.']
  fund_commitment_id varchar [note: 'Reference to the Limited Partner (LP) commitment record against which this capital call is drawn.']
  fund_id varchar [note: 'Reference to the private equity fund issuing the capital call.']
  gp_entity_id varchar [note: 'Foreign key linking to privateequity.gp_entity. Business justification: Capital call records have denormalized GP contact fields (gp_contact_name, gp_contact_email, gp_contact_phone).']
  opportunity_id varchar [note: 'Reference to the specific private equity deal or investment transaction for which capital is being called.']
  portfolio_company_id varchar [note: 'Reference to the portfolio company receiving the investment funded by this capital call.']
  settlement_instruction_id varchar [note: 'Reference to the treasury payment instruction record used to execute the capital call funding.']
  call_amount decimal(18,2) [note: 'Total amount requested from the Limited Partner (LP) in this capital call, denominated in call currency.']
  call_currency varchar [note: 'Three-letter ISO 4217 currency code for the capital call amount.']
  call_document_url varchar [note: 'Link to the official capital call notice document stored in the document management system.']
  call_due_date date [note: 'Date by which the Limited Partner (LP) must fund the capital call amount to the fund.']
  call_notice_date date [note: 'Date on which the General Partner (GP) issued the capital call notice to Limited Partners (LPs).']
  call_notice_number varchar [note: 'Unique business identifier assigned by the General Partner (GP) to this capital call notice.']
  call_purpose varchar [note: 'Primary purpose for which the capital is being called by the General Partner (GP). [ENUM-REF-CANDIDATE: investment|management_fee|fund_expense|organizational_expense|bridge_financing|follow_on_investment|co_investment — 7 candidates stripped; promote to']
  call_sequence_number varchar [note: 'Sequential number of this capital call within the fund lifecycle, starting from 1 for the first drawdown.']
  call_status varchar [note: 'Current lifecycle status of the capital call from issuance through funding completion.']
  call_type varchar [note: 'Classification of the capital call based on urgency and timing characteristics.']
  cancellation_reason varchar [note: 'Narrative explanation for why the capital call was cancelled by the General Partner (GP).']
  cancelled_date date [note: 'Date on which the capital call was cancelled by the General Partner (GP).']
  cancelled_flag boolean [note: 'Indicates whether this capital call has been cancelled by the General Partner (GP) prior to funding.']
  created_timestamp timestamp [note: 'Timestamp when this capital call record was first created in the system.']
  default_interest_accrued decimal(18,2) [note: 'Total default interest accrued on unfunded or late capital call amounts.']
  default_interest_rate decimal(5,4) [note: 'Annual interest rate applied to late or unfunded capital call amounts as specified in the Limited Partnership Agreement (LPA).']
  excuse_approval_status varchar [note: 'Status of the General Partner (GP) decision on the Limited Partner (LP) excuse request.']
  excuse_request_flag boolean [note: 'Indicates whether the Limited Partner (LP) has requested an excuse or deferral from funding this capital call.']
  excuse_request_reason varchar [note: 'Narrative explanation provided by the Limited Partner (LP) for requesting excuse or deferral from the capital call.']
  fund_expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to fund-level operating expenses such as legal, audit, and administrative costs.']
  funded_amount decimal(18,2) [note: 'Actual amount funded by the Limited Partner (LP) in response to this capital call, may differ from call amount if partially funded.']
  funded_date date [note: 'Date on which the Limited Partner (LP) transferred funds to the fund in response to the capital call.']
  investment_amount decimal(18,2) [note: 'Portion of the capital call allocated to direct investment activities, excluding fees and expenses.']
  investment_description varchar [note: 'Narrative description of the underlying investment or purpose for which capital is being called.']
  lp_acknowledgement_date date [note: 'Date on which the Limited Partner (LP) formally acknowledged the capital call notice.']
  lp_acknowledgement_flag boolean [note: 'Indicates whether the Limited Partner (LP) has formally acknowledged receipt of the capital call notice.']
  management_fee_amount decimal(18,2) [note: 'Portion of the capital call allocated to General Partner (GP) management fees as per Limited Partnership Agreement (LPA).']
  modified_timestamp timestamp [note: 'Timestamp when this capital call record was last modified in the system.']
  notes varchar [note: 'Additional free-text notes or comments related to this capital call for internal reference.']
  notice_method varchar [note: 'Method by which the General Partner (GP) delivered the capital call notice to the Limited Partner (LP).']
  notice_received_date date [note: 'Date on which the Limited Partner (LP) acknowledged receipt of the capital call notice.']
  organizational_expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to one-time fund formation and organizational expenses.']
  payment_reference_number varchar [note: 'Bank wire or payment system reference number for the capital call funding transaction.']
  settlement_account_number varchar [note: 'Bank account number to which the Limited Partner (LP) must transfer the capital call funds.']
  settlement_bank_bic varchar [note: 'Bank Identifier Code (BIC) or SWIFT code for the settlement bank receiving capital call funds.']
  settlement_bank_name varchar [note: 'Name of the bank holding the settlement account for capital call funding.']
  unfunded_amount decimal(18,2) [note: 'Outstanding amount not yet funded by the Limited Partner (LP), calculated as call amount minus funded amount.']

  Note: 'Transactional record of each capital call (drawdown notice) issued by a GP to the pension fund as LP. Captures call notice date, due date, call amount, call currency, call sequence number, call purpose (investment, management fees, fund expenses'
}

Table privateequity.distribution {
  distribution_id varchar [pk, note: 'Unique identifier for the private equity fund distribution transaction.']
  approved_by_user_employee_id varchar [note: 'User identifier of the investment operations or treasury staff member who approved the distribution transaction.']
  employee_id varchar [note: 'User identifier of the investment operations or treasury staff member who approved the distribution transaction.']
  fund_commitment_id varchar [note: 'Foreign key linking to privateequity.fund_commitment. Business justification: Distributions are currently linked only at fund level. Adding fund_commitment_id enables LP-specific distribution tracking, which is essential for pension fund operations where']
  fund_id varchar [note: 'Reference to the private equity fund or co-investment vehicle making the distribution.']
  gp_entity_id varchar [note: 'Foreign key linking to privateequity.gp_entity. Business justification: Distribution records have denormalized GP entity data (gp_entity_name, gp_lei). Adding FK to gp_entity normalizes this relationship. GP entity details can be retrieved via JOIN.']
  underlying_investment_id varchar [note: 'Reference to the specific portfolio company or direct investment that generated the distribution.']
  accounting_period varchar [note: 'Fiscal period (quarter or month) in which the distribution is recognized for accounting and performance reporting purposes (format: YYYY-QN or YYYY-MM).']
  amount decimal(18,2) [note: 'Gross distribution amount in the distribution currency before any withholding taxes or fees.']
  amount_base_currency decimal(18,2) [note: 'Distribution amount converted to the pension fund\'s base reporting currency using the effective date foreign exchange (FX) rate.']
  approval_timestamp timestamp [note: 'Date and time when the distribution transaction was approved by the internal investment operations or treasury team.']
  cumulative_distributions_to_date decimal(18,2) [note: 'Total cumulative distributions received by the Limited Partner (LP) from the fund inception through this distribution, used for Distributions to Paid-In (DPI) calculation.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the distribution was denominated and paid.']
  custodian_reference_number varchar [note: 'Unique transaction reference number assigned by the custodian bank for the distribution settlement.']
  distribution_status varchar [note: 'Current lifecycle status of the distribution transaction in the settlement and accounting workflow.']
  distribution_type varchar [note: 'Classification of the distribution by its economic nature: return of capital, realized gain, dividend income, interest income, in-kind asset transfer, or recallable distribution subject to clawback.']
  document_uri varchar [note: 'Uniform Resource Identifier (URI) or file path to the distribution notice document stored in the document management system.']
  dpi_ratio decimal(8,4) [note: 'Ratio of cumulative distributions to cumulative capital called, calculated as of this distribution date, measuring cash-on-cash return realized to date.']
  effective_date date [note: 'Date on which the distribution is effective for accounting and Net Asset Value (NAV) calculation purposes.']
  fx_rate decimal(12,6) [note: 'Foreign exchange rate used to convert the distribution amount from distribution currency to base currency.']
  in_kind_asset_description varchar [note: 'Description of the asset transferred in-kind if the distribution type is in-kind (e.g., publicly traded shares, real estate, infrastructure asset).']
  in_kind_asset_fair_value decimal(18,2) [note: 'Fair market value of the in-kind asset at the distribution effective date, used for accounting and Net Asset Value (NAV) purposes.']
  in_kind_asset_quantity decimal(18,4) [note: 'Quantity or number of units of the in-kind asset transferred (e.g., number of shares, square meters of real estate).']
  irr_contribution decimal(8,4) [note: 'Contribution of this distribution to the fund\'s cumulative Internal Rate of Return (IRR) calculation, expressed as a percentage.']
  lp_commitment_amount decimal(18,2) [note: 'Total capital commitment made by the Limited Partner (LP) to the fund, used to calculate distribution ratios and Distributions to Paid-In (DPI) metrics.']
  memo varchar [note: 'Free-text memo or commentary provided by the General Partner (GP) explaining the distribution context, source, and any special conditions.']
  moic_contribution decimal(8,4) [note: 'Contribution of this distribution to the fund\'s cumulative Multiple on Invested Capital (MOIC) calculation.']
  nav_impact_amount decimal(18,2) [note: 'Impact of the distribution on the fund\'s Net Asset Value (NAV) as of the effective date, typically a reduction equal to the distribution amount.']
  net_distribution_amount decimal(18,2) [note: 'Net distribution amount received by the Limited Partner (LP) after withholding taxes and any applicable fees.']
  notice_date date [note: 'Date on which the General Partner (GP) issued the distribution notice to Limited Partners (LPs).']
  notice_number varchar [note: 'External reference number assigned by the General Partner (GP) to the distribution notice document.']
  payment_date date [note: 'Actual date on which the distribution cash or in-kind assets were received by the Limited Partner (LP).']
  recallable_expiry_date date [note: 'Date after which the distribution is no longer subject to clawback or recall provisions.']
  recallable_flag boolean [note: 'Indicates whether the distribution is subject to potential clawback or recall under the Limited Partnership Agreement (LPA) terms.']
  record_created_timestamp timestamp [note: 'Date and time when the distribution record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Date and time when the distribution record was last modified in the system.']
  settlement_account_number varchar [note: 'Bank account number or custody account identifier to which the distribution was credited.']
  settlement_bank_bic varchar [note: 'Bank Identifier Code (BIC) or SWIFT code of the receiving bank for the distribution payment.']
  source_event varchar [note: 'Type of underlying transaction or event that triggered the distribution (e.g., exit, initial public offering, dividend, refinancing). [ENUM-REF-CANDIDATE: exit|ipo|dividend|interest|refinancing|partial_sale|recapitalization|liquidation — 8 candidates']
  source_system_code varchar [note: 'Unique identifier of the distribution transaction in the source operational system for data lineage and reconciliation.']
  tax_jurisdiction varchar [note: 'Three-letter ISO country code of the jurisdiction in which withholding tax was applied.']
  tax_treaty_applicable_flag boolean [note: 'Indicates whether a bilateral tax treaty was applied to reduce the withholding tax rate on the distribution.']
  vintage_year varchar [note: 'Year in which the fund held its initial closing and began making capital calls, used for J-Curve analysis and performance benchmarking.']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted at source by the fund jurisdiction or underlying investment jurisdiction.']
  withholding_tax_rate decimal(5,4) [note: 'Percentage rate of withholding tax applied to the distribution, expressed as a decimal (e.g., 0.15 for 15%).']

  Note: 'Transactional record of each cash or in-kind distribution received from a PE fund. Captures distribution notice date, payment date, distribution amount, distribution currency, distribution type (return of capital, realized gain, dividend, in-kind)'
}

Table privateequity.investment {
  investment_id varchar [pk, note: 'Unique identifier for the investment data product (auto-inserted during validation).']
  deal_opportunity_id varchar [note: 'Reference to the origination deal record that led to this investment, linking to the deal pipeline and due diligence process.']
  fund_id varchar [note: 'Reference to the parent private equity fund or co-investment vehicle that holds this investment.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) or external manager entity managing this investment.']
  investment_gp_entity_id varchar [note: 'Reference to the General Partner (GP) or external manager entity managing this investment.']
  investment_gp_gp_entity_id varchar [note: 'FK to privateequity.gp_entity']
  opportunity_id varchar [note: 'Reference to the origination deal record that led to this investment, linking to the deal pipeline and due diligence process.']
  portfolio_company_id varchar [note: 'Reference to the underlying portfolio company or asset entity in which capital is invested.']
  research_report_id varchar [note: 'Foreign key linking to research.report. Business justification: Investment decisions are supported by specific research reports that justify the investment thesis.']
  risk_model_id varchar [note: 'Foreign key linking to risk.model. Business justification: Investment risk model FK needed for portfolio risk aggregation and performance attribution.']
  asset_class varchar [note: 'High-level asset class designation, typically private equity, but may include hybrid classifications for cross-asset investments.']
  carried_interest_rate decimal(5,4) [note: 'Percentage of profits allocated to the General Partner (GP) as performance-based compensation, typically after the hurdle rate is achieved.']
  commitment_amount decimal(18,2) [note: 'Total capital amount committed by the Limited Partner (LP) to the investment or fund, representing the maximum callable capital.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the commitment amount.']
  commitment_date date [note: 'Date on which the Limited Partner (LP) formally committed capital to the investment or fund, establishing the legal obligation.']
  created_timestamp timestamp [note: 'Timestamp when this investment record was first created in the system.']
  distributions_received decimal(18,2) [note: 'Cumulative cash distributions returned to the Limited Partner (LP) from the investment, including realized gains and income.']
  dpi decimal(10,4) [note: 'Multiple of cumulative distributions divided by paid-in capital, measuring realized cash-on-cash return.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors were formally integrated into the investment due diligence and decision-making process.']
  esg_rating varchar [note: 'ESG rating or score assigned to the investment, reflecting environmental, social, and governance performance and risk assessment.']
  exit_date date [note: 'Date on which the investment was fully exited or realized, marking the end of the holding period.']
  final_close_date date [note: 'Date of the final closing of the fund, after which no additional Limited Partners (LPs) may join and total commitments are finalized.']
  first_close_date date [note: 'Date of the first closing of the fund or investment vehicle, marking the initial capital commitment milestone.']
  fund_size decimal(18,2) [note: 'Total capital raised by the fund at final close, representing the aggregate commitments from all Limited Partners (LPs).']
  fund_term_years varchar [note: 'Total term of the fund in years, including investment period and harvest period, as defined in the Limited Partnership Agreement (LPA).']
  geography varchar [note: 'Primary geographic region or country of the investment, using three-letter ISO country codes or regional groupings.']
  hurdle_rate decimal(5,4) [note: 'Minimum annualized return threshold that must be achieved before the General Partner (GP) earns carried interest, expressed as a decimal percentage.']
  investment_date date [note: 'Date on which the investment was executed and capital was deployed into the portfolio company or fund.']
  investment_name varchar [note: 'Business name or title of the private equity investment, typically the portfolio company name or fund name.']
  investment_status varchar [note: 'Current lifecycle status of the investment: committed but not yet funded, actively held, partially or fully exited, or written off.']
  investment_type varchar [note: 'Classification of the investment structure: direct investment, co-investment alongside a General Partner (GP), secondary market purchase, or fund-of-funds (FoF) commitment.']
  irr decimal(10,4) [note: 'Annualized time-weighted rate of return on the investment, calculated using cash flows and Net Asset Value (NAV), expressed as a decimal.']
  last_updated_timestamp timestamp [note: 'Timestamp when this investment record was most recently modified.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the General Partner (GP), expressed as a decimal percentage of committed or invested capital.']
  moic decimal(10,4) [note: 'Total value divided by paid-in capital, representing the gross multiple of capital returned and remaining, synonymous with Total Value to Paid-In (TVPI).']
  nav decimal(18,2) [note: 'Current fair market value of the investment as of the most recent valuation date, representing unrealized value.']
  nav_date date [note: 'As-of date for the reported Net Asset Value (NAV), typically the end of the most recent reporting quarter.']
  ownership_percentage decimal(5,2) [note: 'Percentage equity ownership stake held in the portfolio company or fund, expressed as a decimal percentage.']
  paid_in_capital decimal(18,2) [note: 'Cumulative capital called and paid by the Limited Partner (LP) to date, representing actual cash deployed into the investment.']
  period_end_date date [note: 'Date marking the end of the investment period during which the General Partner (GP) may make new investments, as defined in the Limited Partnership Agreement (LPA).']
  rvpi decimal(10,4) [note: 'Multiple of current Net Asset Value (NAV) divided by paid-in capital, representing unrealized value remaining in the investment.']
  sector varchar [note: 'Primary industry sector of the portfolio company or investment focus area, aligned with GICS or internal sector taxonomy.']
  strategy varchar [note: 'Private equity strategy classification: buyout, growth equity, venture capital, distressed debt, mezzanine financing, or turnaround.']
  sub_sector varchar [note: 'Detailed sub-sector or industry vertical within the primary sector, providing granular classification for portfolio analysis.']
  total_value decimal(18,2) [note: 'Sum of distributions received plus current Net Asset Value (NAV), representing the total realized and unrealized value of the investment.']
  tvpi decimal(10,4) [note: 'Multiple of total value divided by paid-in capital, a key performance metric indicating total return on invested capital.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future capital calls, also known as dry powder.']
  valuation_method varchar [note: 'Methodology used to determine the fair value of the investment, such as Discounted Cash Flow (DCF), comparable company analysis, or recent transaction price.']
  vintage_year varchar [note: 'The calendar year in which the fund was raised or the investment was first committed, used for cohort performance analysis and J-Curve modeling.']

  Note: 'Master record for each direct private equity investment or fund-level portfolio company investment. Captures investment name, investment type (direct, co-invest, secondary, FoF), asset class sub-type (buyout, growth equity, venture, distressed), entry'
}

Table privateequity.coinvestment {
  coinvestment_id varchar [pk, note: 'Unique identifier for the co-investment opportunity record. Primary key.']
  deal_opportunity_id varchar [note: 'Reference to the origination deal pipeline record from which this co-investment opportunity emerged.']
  gp_fund_id varchar [note: 'Reference to the main GP fund vehicle alongside which this co-investment is being made.']
  opportunity_id varchar [note: 'Reference to the origination deal pipeline record from which this co-investment opportunity emerged.']
  portfolio_company_id varchar [note: 'Reference to the underlying portfolio company or asset being co-invested into.']
  actual_exit_date date [note: 'Actual date on which the co-investment position was fully exited and realized.']
  asset_class varchar [note: 'Primary asset class category of the co-investment for strategic asset allocation and portfolio construction purposes.']
  coinvestment_code varchar [note: 'External business identifier or deal code used for reporting and communication with the GP and internal stakeholders.']
  coinvestment_name varchar [note: 'Business name or title of the co-investment opportunity, typically including the portfolio company name and vintage year.']
  coinvestment_status varchar [note: 'Current lifecycle status of the co-investment opportunity from initial pipeline through exit. [ENUM-REF-CANDIDATE: pipeline|due_diligence|ic_review|approved|committed|funded|active|exited|declined — 9 candidates stripped; promote to reference product]']
  commitment_amount decimal(18,2) [note: 'Total capital commitment amount pledged by the pension fund for this co-investment opportunity in base currency.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the commitment amount.']
  created_timestamp timestamp [note: 'System timestamp when this co-investment record was first created in the system.']
  distributions_received decimal(18,2) [note: 'Cumulative cash distributions received from the co-investment to date in base currency.']
  dpi decimal(10,4) [note: 'Cash-on-cash return multiple calculated as cumulative distributions divided by paid-in capital.']
  entry_ebitda_multiple decimal(10,2) [note: 'Valuation multiple at entry calculated as enterprise value divided by trailing or forward EBITDA.']
  entry_valuation decimal(18,2) [note: 'Enterprise value or equity valuation of the portfolio company at the time of initial investment in base currency.']
  esg_integration_level varchar [note: 'Degree to which ESG factors were integrated into the investment decision and ongoing monitoring.']
  esg_rating varchar [note: 'ESG risk rating or score assigned to the portfolio company based on due diligence assessment. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|not_rated — 10 candidates stripped; promote to reference product]']
  exit_proceeds decimal(18,2) [note: 'Total cash proceeds realized from the exit of the co-investment in base currency.']
  exit_type varchar [note: 'Method or transaction type through which the co-investment was exited or is expected to be exited.']
  expected_exit_date date [note: 'Projected or target date for full exit from the co-investment position.']
  expected_hold_period_years varchar [note: 'Anticipated investment holding period in years from initial funding to expected exit.']
  final_close_date date [note: 'Date on which the co-investment commitment was finalized and legally binding.']
  first_capital_call_date date [note: 'Date of the initial capital call or drawdown notice for this co-investment.']
  geography varchar [note: 'Primary geographic region or country where the portfolio company operates or where the investment is domiciled.']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved the co-investment opportunity.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the IC meeting minutes or resolution approving this co-investment.']
  investment_structure varchar [note: 'Capital structure layer or instrument type through which the co-investment is made.']
  investment_thesis varchar [note: 'Summary of the strategic rationale and value creation hypothesis supporting the co-investment decision.']
  investment_type varchar [note: 'Classification of the co-investment structure indicating whether it is a direct co-invest, syndicated deal, club arrangement, or secondary transaction.']
  irr decimal(10,4) [note: 'Annualized time-weighted return percentage calculated from cash flows and current NAV, expressed as a decimal.']
  lead_investment_professional varchar [note: 'Name or identifier of the internal investment team member responsible for originating and managing this co-investment.']
  modified_timestamp timestamp [note: 'System timestamp when this co-investment record was last updated or modified.']
  moic decimal(10,4) [note: 'Total return multiple calculated as total value divided by total invested capital, synonymous with TVPI in co-investment context.']
  nav decimal(18,2) [note: 'Current fair market value of the co-investment position as of the latest valuation date in base currency.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership stake in the portfolio company acquired through this co-investment.']
  paid_in_capital decimal(18,2) [note: 'Cumulative capital called and funded to date through capital calls or drawdown notices in base currency.']
  realized_gain_loss decimal(18,2) [note: 'Net realized profit or loss from the co-investment calculated as exit proceeds minus paid-in capital in base currency.']
  rvpi decimal(10,4) [note: 'Unrealized value multiple calculated as current NAV divided by paid-in capital.']
  sector varchar [note: 'Industry sector or vertical of the underlying portfolio company being co-invested into, aligned with GICS or internal taxonomy.']
  target_irr decimal(10,4) [note: 'Underwritten or target IRR percentage established at investment approval, expressed as a decimal.']
  target_moic decimal(10,4) [note: 'Underwritten or target MOIC multiple established at investment approval.']
  tvpi decimal(10,4) [note: 'Performance multiple calculated as the sum of distributions and NAV divided by paid-in capital.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future capital calls, also known as dry powder.']
  valuation_date date [note: 'As-of date for the most recent NAV valuation of the co-investment position.']
  vintage_year varchar [note: 'Calendar year in which the co-investment commitment was made, used for cohort analysis and J-Curve modeling.']

  Note: 'Master record for co-investment opportunities where the pension fund invests directly alongside a GP in a specific portfolio company, outside the main fund vehicle.'
}

Table privateequity.secondary_transaction {
  secondary_transaction_id varchar [pk, note: 'Unique identifier for the secondary market transaction of Limited Partner (LP) interests in private equity funds.']
  counterparty_id varchar [note: 'Identifier of the counterparty entity (buyer or seller) on the opposite side of this secondary transaction.']
  fund_commitment_id varchar [note: 'Foreign key linking to privateequity.fund_commitment. Business justification: Secondary transactions involve buying/selling LP interests which are tracked at the fund_commitment level.']
  fund_id varchar [note: 'Identifier of the private equity fund whose LP interest is being transacted in the secondary market.']
  gp_entity_id varchar [note: 'Foreign key linking to privateequity.gp_entity. Business justification: Secondary transactions have denormalized gp_name attribute. Adding FK to gp_entity normalizes this and allows proper tracking of which GP manages the fund being transacted.']
  broker_fee_amount decimal(18,2) [note: 'Fee paid to the broker or intermediary for facilitating the secondary transaction.']
  broker_intermediary_name varchar [note: 'Name of the broker, advisor, or intermediary who facilitated the secondary transaction, if applicable.']
  created_by_user varchar [note: 'User identifier of the person who created this secondary transaction record.']
  created_timestamp timestamp [note: 'Timestamp when this secondary transaction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this secondary transaction.']
  discount_premium_to_nav_percent decimal(8,4) [note: 'Percentage discount (negative) or premium (positive) of the transaction price relative to the NAV at transaction date, calculated as ((transaction_price - nav_at_transaction) / nav_at_transaction) * 100.']
  dpi_at_transaction decimal(8,4) [note: 'Distributions to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, representing realized returns.']
  effective_date date [note: 'Date from which the buyer assumes economic ownership of the LP interest, including rights to future distributions and obligations for future capital calls.']
  face_value_commitment decimal(18,2) [note: 'Original committed capital amount of the LP interest being transacted, representing the full commitment value before any capital calls or distributions.']
  fund_strategy varchar [note: 'Investment strategy classification of the underlying private equity fund whose LP interest is being transacted.']
  gp_consent_date date [note: 'Date on which General Partner consent was formally received for the secondary transaction.']
  gp_consent_received_flag boolean [note: 'Indicates whether General Partner consent was obtained for this secondary transaction if required.']
  gp_consent_required_flag boolean [note: 'Indicates whether General Partner consent was required for this secondary transaction per the Limited Partnership Agreement terms.']
  investment_committee_approval_date date [note: 'Date on which the Investment Committee formally approved the secondary transaction.']
  investment_committee_memo_reference varchar [note: 'Reference identifier for the Investment Committee memorandum documenting the rationale and approval for the secondary transaction.']
  irr_at_transaction_percent decimal(8,4) [note: 'Internal Rate of Return of the LP interest calculated at the time of the secondary transaction, reflecting historical performance up to transaction date.']
  last_modified_by_user varchar [note: 'User identifier of the person who last modified this secondary transaction record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this secondary transaction record was last updated in the system.']
  legal_advisor_name varchar [note: 'Name of the legal advisor or law firm engaged to support the secondary transaction due diligence and documentation.']
  legal_fee_amount decimal(18,2) [note: 'Legal fees incurred for the secondary transaction including due diligence, documentation review, and closing support.']
  nav_at_transaction decimal(18,2) [note: 'Net Asset Value of the LP interest at the time of the secondary transaction, used as the baseline for discount or premium calculation.']
  portfolio_allocation_strategy varchar [note: 'Strategic rationale for the secondary transaction within the broader portfolio allocation framework (e.g., rebalancing, liquidity management, vintage diversification).']
  regulatory_reporting_flag boolean [note: 'Indicates whether this secondary transaction requires regulatory reporting to SEC, or other governing bodies.']
  rvpi_at_transaction decimal(8,4) [note: 'Residual Value to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, representing unrealized value.']
  settlement_date date [note: 'Date on which the secondary transaction settled, including transfer of LP interest and payment of consideration.']
  total_transaction_costs decimal(18,2) [note: 'Aggregate of all costs incurred in executing the secondary transaction including broker fees, legal fees, and other transaction expenses.']
  transaction_date date [note: 'Date on which the secondary transaction was executed and agreed upon by both parties.']
  transaction_notes varchar [note: 'Free-text field capturing additional context, special terms, or conditions associated with the secondary transaction.']
  transaction_price decimal(18,2) [note: 'Actual purchase or sale price paid for the LP interest in the secondary transaction.']
  transaction_reference_number varchar [note: 'External reference number or deal code assigned to this secondary transaction for tracking and reporting purposes.']
  transaction_status varchar [note: 'Current lifecycle status of the secondary transaction from initiation through settlement or cancellation.']
  transaction_type varchar [note: 'Indicates whether this is a purchase (buy) or sale (sell) of LP interests in the secondary market.']
  tvpi_at_transaction decimal(8,4) [note: 'Total Value to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, calculated as (distributions + NAV) / paid-in capital.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment (dry powder) associated with the LP interest at the time of the secondary transaction.']
  vintage_year varchar [note: 'Year in which the underlying private equity fund held its initial closing and began making investments, critical for J-Curve analysis and performance benchmarking.']

  Note: 'Transactional record for secondary market purchases or sales of LP interests in PE funds. Captures transaction type (buy/sell), counterparty, fund interest being transacted, face value of commitment, purchase/sale price, discount or premium to NAV (%)'
}

Table privateequity.lpa_terms {
  lpa_terms_id varchar [pk, note: 'Unique identifier for the LPA terms record. Primary key for the LPA terms entity.']
  fund_id varchar [note: 'Reference to the private equity fund to which these LPA terms apply.']
  gp_entity_id varchar [note: 'Reference to the General Partner legal entity managing the fund.']
  advisory_committee_flag boolean [note: 'Indicates whether the LPA establishes a Limited Partner Advisory Committee for governance and conflict resolution.']
  amendment_number varchar [note: 'Sequential number of amendments to the original LPA, starting at 0 for original and incrementing with each amendment.']
  audit_requirement_flag boolean [note: 'Indicates whether the LPA requires annual audited financial statements prepared by independent auditor.']
  carried_interest_rate_pct decimal(5,4) [note: 'Percentage of profits allocated to the GP as performance incentive, typically 20% (carry).']
  catch_up_rate_pct decimal(5,4) [note: 'Percentage of distributions allocated to GP after hurdle is met to catch up to target carry split, typically 80-100%.']
  clawback_provision_flag boolean [note: 'Indicates whether the LPA includes a clawback provision requiring GP to return excess carried interest at fund termination.']
  co_investment_right_flag boolean [note: 'Indicates whether LPs have the right to participate in co-investment opportunities alongside the fund.']
  created_timestamp timestamp [note: 'Timestamp when this LPA terms record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the fund\'s base currency (e.g., USD, EUR, GBP).']
  esg_policy_description varchar [note: 'Textual description of ESG policies, exclusions, or responsible investment commitments specified in the LPA.']
  esg_policy_flag boolean [note: 'Indicates whether the LPA includes specific ESG investment policies or exclusions that the GP must follow.']
  extension_option_years varchar [note: 'Number of years by which the fund term may be extended at GP discretion, typically 1-2 one-year extensions.']
  fund_domicile varchar [note: 'Legal domicile or jurisdiction where the fund is established and registered.']
  fund_term_years varchar [note: 'Total duration of the fund in years as specified in the LPA, typically 10-12 years for private equity funds.']
  geographic_restriction varchar [note: 'Geographic investment mandate or restrictions specified in the LPA (e.g., North America, Europe, Global).']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of the LPA (e.g., Delaware, Cayman Islands).']
  gp_commitment_amount decimal(18,2) [note: 'Total capital amount committed by the GP to the fund, demonstrating alignment of interest with LPs.']
  gp_commitment_pct decimal(5,4) [note: 'GP commitment expressed as percentage of total fund commitments, typically 1-5%.']
  hurdle_rate_pct decimal(5,4) [note: 'Minimum annualized return threshold (preferred return) that LPs must achieve before GP receives carried interest, typically 8%.']
  hurdle_type varchar [note: 'Type of hurdle rate structure: hard (GP only receives carry on returns above hurdle), soft (GP receives catch-up), or none.']
  investment_concentration_limit_pct decimal(5,4) [note: 'Maximum percentage of fund capital that may be invested in a single portfolio company, typically 15-25%.']
  investment_period_years varchar [note: 'Duration in years during which the GP may make new investments, typically 3-5 years from fund inception.']
  key_person_clause_flag boolean [note: 'Indicates whether the LPA includes key person provisions that trigger restrictions if key investment professionals depart.']
  key_person_names varchar [note: 'Comma-separated list of key persons named in the LPA whose departure may trigger key person provisions.']
  leverage_limit_multiple decimal(5,2) [note: 'Maximum debt-to-equity or debt-to-EBITDA multiple permitted for portfolio company investments.']
  lpa_document_reference varchar [note: 'External reference number or identifier for the signed LPA document in the document management system.']
  lpa_effective_date date [note: 'Date from which the LPA terms become effective and operational.']
  lpa_execution_date date [note: 'Date on which the LPA was executed and became legally binding.']
  lpa_terms_status varchar [note: 'Current lifecycle status of the LPA terms record: active, amended, superseded by new version, or terminated.']
  management_fee_basis varchar [note: 'Basis on which management fees are calculated: committed capital, invested capital, NAV, or hybrid structure.']
  management_fee_rate_pct decimal(5,4) [note: 'Annual management fee rate charged by the GP, expressed as a percentage. Typically 1.5-2.0% during investment period.']
  management_fee_step_down_date date [note: 'Date at which management fee rate or basis changes, typically at end of investment period.']
  most_favored_nation_clause_flag boolean [note: 'Indicates whether the LPA includes MFN provisions ensuring LPs receive terms no less favorable than other LPs.']
  no_fault_divorce_clause_flag boolean [note: 'Indicates whether LPs have the right to remove the GP without cause, typically requiring supermajority vote.']
  post_investment_fee_rate_pct decimal(5,4) [note: 'Reduced management fee rate applicable after the investment period ends, typically 1.0-1.5%.']
  recycling_limit_pct decimal(5,4) [note: 'Maximum percentage of distributions that may be recycled into new investments, typically 10-20% of commitments.']
  recycling_provision_flag boolean [note: 'Indicates whether the LPA permits recycling of early distributions back into new investments during investment period.']
  removal_threshold_pct decimal(5,4) [note: 'Percentage of LP votes required to remove the GP, typically 66.67% or 75% supermajority.']
  reporting_frequency varchar [note: 'Frequency at which the GP must provide financial and portfolio reports to LPs as specified in the LPA.']
  sector_restriction varchar [note: 'Industry sector focus or restrictions specified in the LPA (e.g., technology, healthcare, industrials).']
  transfer_restriction_type varchar [note: 'Type of restriction on LP ability to transfer fund interests: prohibited, requires GP consent, ROFR, or free transfer.']
  updated_timestamp timestamp [note: 'Timestamp when this LPA terms record was last modified in the system.']
  waterfall_structure varchar [note: 'Distribution waterfall methodology: American (deal-by-deal), European (whole-fund), or hybrid structure.']

  Note: 'Structured record of the key economic and governance terms extracted from each Limited Partnership Agreement (LPA). Captures management fee rate, management fee basis (committed vs.'
}

Table privateequity.carried_interest_waterfall {
  carried_interest_waterfall_id varchar [pk, note: 'Unique identifier for the carried interest waterfall calculation record. Primary key.']
  pe_fund_id varchar [note: 'Reference to the private equity fund for which this waterfall calculation applies.']
  approval_date date [note: 'Date on which this waterfall calculation was formally approved and finalized.']
  approved_by varchar [note: 'Name or identifier of the individual or committee who approved this waterfall calculation for finalization.']
  calculation_date date [note: 'The reporting period date or valuation date as of which this carried interest waterfall was calculated.']
  calculation_method varchar [note: 'Description of the specific calculation methodology or formula applied for this waterfall, including any LPA-specific nuances.']
  calculation_notes varchar [note: 'Free-text notes documenting assumptions, adjustments, or special circumstances affecting this waterfall calculation.']
  calculation_status varchar [note: 'Current lifecycle status of this waterfall calculation indicating whether it is draft, preliminary, final, revised, or superseded.']
  carry_accrued_unpaid decimal(20,2) [note: 'Carried interest earned but not yet distributed to the GP, representing the accrued liability.']
  carry_distributed decimal(20,2) [note: 'Cumulative carried interest amount actually distributed to the GP to date.']
  carry_earned decimal(20,2) [note: 'Total carried interest earned by the GP based on the waterfall calculation as of the calculation date.']
  carry_rate decimal(5,4) [note: 'The GP profit share percentage (e.g., 0.2000 for 20%) applied to profits after preferred return and catch-up are satisfied.']
  clawback_provision_flag boolean [note: 'Indicates whether the LPA includes a clawback provision requiring GP to return excess carry if final fund performance falls below hurdle.']
  clawback_reserve decimal(20,2) [note: 'Amount reserved or withheld from GP distributions to cover potential clawback obligations at fund termination.']
  created_timestamp timestamp [note: 'Timestamp when this waterfall calculation record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which all monetary amounts in this waterfall calculation are denominated.']
  dpi decimal(10,4) [note: 'Multiple representing cumulative distributions divided by paid-in capital, measuring realized returns.']
  gp_catchup_amount decimal(20,2) [note: 'Cumulative amount distributed to GP during the catch-up phase after LPs receive return of capital and preferred return.']
  gp_catchup_rate decimal(5,4) [note: 'The percentage of distributions allocated to GP during the catch-up phase to bring GP to its target carried interest share.']
  gp_profit_share decimal(20,2) [note: 'Cumulative profit distributions allocated to GP including catch-up and carried interest.']
  irr decimal(10,6) [note: 'The annualized effective compounded return rate of the fund, calculated using cash flows and NAV as of the calculation date.']
  lp_profit_share decimal(20,2) [note: 'Cumulative profit distributions allocated to LPs after return of capital and preferred return, net of GP carry.']
  modified_timestamp timestamp [note: 'Timestamp when this waterfall calculation record was last modified or recalculated.']
  nav decimal(20,2) [note: 'Current net asset value of the fund representing the fair value of remaining investments less liabilities.']
  preferred_return_accrued decimal(20,2) [note: 'Cumulative preferred return amount accrued to LPs based on the hurdle rate applied to outstanding capital over time.']
  preferred_return_paid decimal(20,2) [note: 'Cumulative preferred return amount distributed to LPs to date, satisfying the hurdle before GP catch-up.']
  preferred_return_rate decimal(5,4) [note: 'The hurdle rate (expressed as decimal, e.g., 0.0800 for 8%) that LPs must achieve before GP participates in carried interest.']
  return_of_capital decimal(20,2) [note: 'The portion of total distributions allocated to returning LP contributed capital before profit sharing begins.']
  rvpi decimal(10,4) [note: 'Multiple representing remaining NAV divided by paid-in capital, measuring unrealized value.']
  total_contributions decimal(20,2) [note: 'Cumulative capital contributions (Paid-In Capital / PIC) called from LPs to date for this fund.']
  total_distributions decimal(20,2) [note: 'Cumulative distributions paid to LPs and GP from the fund to date, including return of capital and profits.']
  tvpi decimal(10,4) [note: 'Multiple representing total value (distributions plus NAV) divided by paid-in capital, used to assess overall fund performance.']
  waterfall_type varchar [note: 'The carried interest distribution methodology: American (deal-by-deal), European (whole-fund), or hybrid structure as defined in the LPA.']

  Note: 'Transactional record tracking the carried interest waterfall calculation for each PE fund at each reporting period. Captures total fund distributions to date, return of capital tranche, preferred return accrual, GP catch-up amount, carried interest earned'
}

Table privateequity.nav {
  nav_id varchar [pk, note: 'Unique identifier for the nav data product (auto-inserted during validation).']
  fund_commitment_id varchar [note: 'Reference to the LP fund commitment or direct PE investment for which this NAV is reported.']
  gp_report_id varchar [note: 'Reference identifier for the source GP report document from which this NAV data was extracted.']
  amount decimal(20,2) [note: 'The net asset value of the LP interest or direct investment as of the valuation date, representing fair value of the investment net of liabilities.']
  audit_opinion varchar [note: 'The auditors opinion on the funds financial statements, if this NAV is from an audited period.']
  audited_flag boolean [note: 'Indicates whether this NAV has been audited by an independent auditor as part of the funds annual audit process.']
  auditor_name varchar [note: 'The name of the independent auditor who audited the funds financial statements and NAV, if applicable.']
  base_currency_amount decimal(20,2) [note: 'The NAV amount converted to the LPs base currency using the FX rate to base, for consolidated portfolio reporting.']
  carried_interest_accrued decimal(20,2) [note: 'The cumulative carried interest accrued by the GP as of the valuation date, subject to hurdle rate and waterfall provisions.']
  comments varchar [note: 'Free-text field for additional notes, qualifications, or context regarding this NAV record, such as GP commentary or internal observations.']
  data_source_system varchar [note: 'The operational system from which this NAV record was sourced, such as eFront, Aladdin, or manual entry.']
  distributions_received decimal(20,2) [note: 'The cumulative cash distributions received by the LP from the fund or investment to date.']
  dpi decimal(10,4) [note: 'The ratio of distributions received to paid-in capital, representing the cash-on-cash return. Calculated as distributions divided by paid-in capital.']
  fair_value_hierarchy_level varchar [note: 'The IFRS 13 fair value hierarchy level classification for this NAV valuation, indicating the observability of inputs used.']
  fund_age_years decimal(6,2) [note: 'The number of years since the funds first closing or investment date, calculated as of the valuation date.']
  fx_rate_to_base decimal(18,8) [note: 'The exchange rate used to convert the NAV reporting currency to the LPs base currency as of the valuation date.']
  gav_amount decimal(20,2) [note: 'The gross asset value of the fund or investment before deducting liabilities, representing the total fair value of underlying assets.']
  gp_report_received_date date [note: 'The date on which the GP capital account statement or NAV report was received by the LP.']
  irr_since_inception decimal(10,6) [note: 'The annualized internal rate of return from the first capital call to the valuation date, representing time-weighted performance.']
  is_current_record boolean [note: 'Flag indicating whether this is the current active version of the NAV record for the given fund commitment and valuation date.']
  j_curve_phase varchar [note: 'The current phase of the funds J-curve lifecycle, indicating whether it is in investment, harvesting, mature, or liquidation phase.']
  management_fee_accrued decimal(20,2) [note: 'The cumulative management fees accrued and charged to the LP capital account as of the valuation date.']
  moic decimal(10,4) [note: 'The multiple of invested capital returned, equivalent to TVPI. Represents total value as a multiple of paid-in capital.']
  nav_status varchar [note: 'The status of this NAV record, indicating whether it is preliminary, final, audited, or has been adjusted or restated.']
  number_of_portfolio_companies varchar [note: 'The count of active portfolio companies or investments held by the fund as of the valuation date.']
  other_expenses_accrued decimal(20,2) [note: 'Other fund-level expenses accrued and allocated to the LP capital account, excluding management fees and carried interest.']
  paid_in_capital decimal(20,2) [note: 'The cumulative capital called and funded by the LP to date, representing the total invested capital.']
  realized_value decimal(20,2) [note: 'The cumulative proceeds from exits, sales, and distributions received to date from the investment.']
  record_created_timestamp timestamp [note: 'The timestamp when this NAV record was first created in the data platform.']
  record_effective_from_date date [note: 'The date from which this version of the NAV record is effective, supporting slowly changing dimension type 2 historization.']
  record_effective_to_date date [note: 'The date until which this version of the NAV record is effective, supporting slowly changing dimension type 2 historization. Null indicates current record.']
  record_updated_timestamp timestamp [note: 'The timestamp when this NAV record was last updated in the data platform.']
  reporting_currency varchar [note: 'Three-letter ISO 4217 currency code in which the NAV is reported by the GP.']
  reporting_period_end_date date [note: 'The end date of the reporting period covered by this NAV statement, aligning with GP reporting cycles.']
  rvpi decimal(10,4) [note: 'The ratio of unrealized value to paid-in capital, representing the remaining value still held. Calculated as unrealized value divided by paid-in capital.']
  total_commitment decimal(20,2) [note: 'The total capital commitment made by the LP to the fund or investment, representing the maximum callable amount.']
  total_value decimal(20,2) [note: 'The sum of unrealized value and realized value, representing the total value generated by the investment to date.']
  tvpi decimal(10,4) [note: 'The ratio of total value to paid-in capital, representing the multiple of invested capital generated. Calculated as total value divided by paid-in capital.']
  unfunded_commitment decimal(20,2) [note: 'The remaining uncalled capital commitment, also known as dry powder, available for future capital calls.']
  unrealized_value decimal(20,2) [note: 'The fair value of investments still held in the portfolio, not yet realized through exit or distribution.']
  valuation_adjustment_amount decimal(20,2) [note: 'Any adjustment made to the GP-reported NAV by the LP for internal valuation policy, risk overlay, or fair value hierarchy alignment.']
  valuation_adjustment_reason varchar [note: 'Explanation for any valuation adjustment applied by the LP, documenting the rationale for deviation from GP-reported NAV.']
  valuation_date date [note: 'The as-of date for this NAV valuation, typically quarter-end or month-end as reported by the GP.']
  valuation_method varchar [note: 'The primary valuation methodology used by the GP to determine fair value for this reporting period.']
  valuation_source varchar [note: 'The source of the valuation, indicating whether it is GP-reported, independently valued, or internally estimated.']
  vintage_year varchar [note: 'The year in which the fund held its first closing or the direct investment was made, used for cohort analysis and J-curve modeling.']

  Note: 'Periodic NAV (Net Asset Value) record for each PE fund commitment and direct PE investment, capturing the GP-reported fair value, gross asset value (GAV), net asset value (NAV), unrealized value, realized value, total value (NAV + distributions), TVPI'
}

Table privateequity.jcurve_projection {
  jcurve_projection_id varchar [pk, note: 'Unique identifier for the J-Curve projection record. Primary key for this entity.']
  approved_by_employee_id varchar [note: 'Reference to the senior investment professional or Investment Committee (IC) member who approved this projection.']
  employee_id varchar [note: 'Reference to the analyst or investment professional who created or approved this projection.']
  fund_commitment_id varchar [note: 'Reference to the private equity fund commitment for which this J-Curve projection is modeled.']
  jcurve_approved_by_employee_id varchar [note: 'Reference to the senior investment professional or Investment Committee (IC) member who approved this projection.']
  jcurve_employee_id varchar [note: 'Reference to the analyst or investment professional who created or approved this projection.']
  approval_date date [note: 'The date on which this projection was formally approved for use in investment decision-making or reporting.']
  assumed_carried_interest_rate decimal(6,4) [note: 'The carried interest (carry) rate assumed in this projection, expressed as a decimal (e.g., 0.20 for 20%).']
  assumed_management_fee_rate decimal(6,4) [note: 'The annual management fee rate assumed in this projection, expressed as a decimal (e.g., 0.0150 for 1.50%).']
  benchmark_cohort varchar [note: 'The benchmark cohort or peer group used as a reference for this projection (e.g., Global Buyout 2020 Vintage, North America VC 2019-2021).']
  breakeven_period_months varchar [note: 'The number of months from fund inception until the cumulative distributions equal cumulative capital called, marking the J-Curve inflection point.']
  capital_call_frequency varchar [note: 'The expected frequency pattern of capital calls (drawdowns) in this projection: monthly, quarterly, semi-annual, annual, or irregular.']
  catch_up_provision varchar [note: 'Description of the catch-up provision in the waterfall structure, if applicable (e.g., 100% catch-up until GP receives 20% of total profits).']
  committed_capital_amount decimal(20,2) [note: 'The total capital amount committed by the Limited Partner (LP) to this fund, representing the maximum callable capital.']
  committed_capital_currency varchar [note: 'Three-letter ISO 4217 currency code for the committed capital amount (e.g., USD, EUR, GBP).']
  created_timestamp timestamp [note: 'The timestamp when this J-Curve projection record was first created in the system.']
  distribution_frequency varchar [note: 'The expected frequency pattern of distributions in this projection: monthly, quarterly, semi-annual, annual, or irregular.']
  fund_term_years varchar [note: 'The total expected term of the fund in years, including investment period and harvest period.']
  hurdle_rate decimal(6,4) [note: 'The preferred return threshold that must be achieved before carried interest is paid to the General Partner (GP), expressed as a decimal (e.g., 0.08 for 8%).']
  investment_period_years varchar [note: 'The number of years during which the General Partner (GP) can make new investments, typically 3-5 years.']
  key_assumptions varchar [note: 'Summary of key assumptions underlying this projection (e.g., exit multiples, holding periods, macroeconomic conditions, sector performance).']
  model_run_date date [note: 'The date on which this J-Curve projection model was executed and results were generated.']
  model_version varchar [note: 'Version identifier of the J-Curve projection model or tool used to generate this projection.']
  notes varchar [note: 'Free-text field for additional notes, commentary, or context regarding this J-Curve projection.']
  peak_negative_nav_amount decimal(20,2) [note: 'The maximum negative NAV position expected during the J-Curve trough, representing the deepest point of unrealized loss.']
  peak_negative_nav_period varchar [note: 'The period number (in months or quarters) at which the peak negative NAV is expected to occur.']
  projected_dpi decimal(10,4) [note: 'The projected Distributions to Paid-In multiple, calculated as Distributions / Capital Called, representing realized cash returns.']
  projected_final_nav decimal(20,2) [note: 'The expected Net Asset Value (NAV) at the end of the projection period, representing unrealized value remaining.']
  projected_gross_irr decimal(10,4) [note: 'The projected gross Internal Rate of Return before management fees and carried interest, expressed as a decimal (e.g., 0.15 for 15%).']
  projected_moic decimal(10,4) [note: 'The projected Multiple on Invested Capital, representing the total value multiple expected from the investment.']
  projected_net_irr decimal(10,4) [note: 'The projected net Internal Rate of Return after management fees and carried interest, expressed as a decimal (e.g., 0.12 for 12%).']
  projected_rvpi decimal(10,4) [note: 'The projected Residual Value to Paid-In multiple, calculated as NAV / Capital Called, representing unrealized value remaining.']
  projected_total_capital_called decimal(20,2) [note: 'The total amount of capital expected to be called (drawn down) over the life of the fund based on this projection scenario.']
  projected_total_distributions decimal(20,2) [note: 'The total amount of distributions expected to be returned to the Limited Partner (LP) over the life of the fund.']
  projected_tvpi decimal(10,4) [note: 'The projected Total Value to Paid-In multiple, calculated as (Distributions + NAV) / Capital Called, representing total value creation.']
  projection_confidence_level varchar [note: 'Qualitative assessment of confidence in this projection: high (based on strong data), medium (moderate uncertainty), or low (highly uncertain).']
  projection_end_date date [note: 'The date at which the J-Curve projection concludes, typically aligned with the expected fund liquidation date.']
  projection_methodology varchar [note: 'Description of the methodology used to generate this J-Curve projection (e.g., historical cohort analysis, GP-provided forecast, Monte Carlo simulation).']
  projection_name varchar [note: 'Business-friendly name or label for this J-Curve projection scenario (e.g., Base Case, Optimistic, Pessimistic).']
  projection_start_date date [note: 'The date from which the J-Curve projection begins, typically the fund commitment date or first capital call date.']
  projection_status varchar [note: 'Current lifecycle status of the J-Curve projection: draft, approved for use, active, superseded by newer version, or archived.']
  projection_version varchar [note: 'Version identifier for this projection, enabling tracking of revisions over time (e.g., v1.0, v2.1, Q1-2024).']
  scenario_type varchar [note: 'Classification of the projection scenario: base case, optimistic, pessimistic, stress test, or custom.']
  sensitivity_analysis_performed boolean [note: 'Indicates whether sensitivity analysis has been performed on this projection to test robustness under varying assumptions.']
  stress_test_scenario varchar [note: 'Description of the stress test scenario applied, if this is a stress projection (e.g., 2008 Financial Crisis, COVID-19 Pandemic, Recession).']
  updated_timestamp timestamp [note: 'The timestamp when this J-Curve projection record was last modified in the system.']
  vintage_year varchar [note: 'The year in which the fund commitment was made, used for cohort analysis and benchmarking.']

  Note: 'Forward-looking J-Curve cash flow projection model for each PE fund commitment, capturing projected capital call schedule by period, projected distribution schedule by period, projected NAV trajectory, expected IRR at various exit scenarios, break-even'
}

Table privateequity.portfolio_company {
  portfolio_company_id varchar [pk, note: 'Unique identifier for the portfolio company record.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Country outlooks inform risk assessment and strategic decisions for portfolio companies.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: ESG rating of each portfolio company is required for investment decisions and reporting.']
  board_representation boolean [note: 'Indicates whether the pension fund holds a board seat or observer rights at the portfolio company.']
  business_description varchar [note: 'Detailed narrative describing the portfolio company\'s business model, operations, products, services, and competitive positioning.']
  carbon_footprint_tonnes decimal(18,2) [note: 'Total greenhouse gas emissions attributable to the portfolio company, measured in tonnes of CO2 equivalent.']
  co_investors varchar [note: 'Comma-separated list of other institutional investors participating in the investment alongside the pension fund.']
  company_name varchar [note: 'Full legal name of the portfolio company as registered in its jurisdiction of incorporation.']
  created_timestamp timestamp [note: 'Timestamp when the portfolio company record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the base currency for all monetary amounts in this record.']
  current_fair_value decimal(18,2) [note: 'Most recent mark-to-market valuation of the pension fund\'s stake in the portfolio company, in base currency.']
  ebitda_latest decimal(18,2) [note: 'Most recent annual or trailing twelve-month EBITDA reported by the portfolio company, in base currency.']
  employee_count varchar [note: 'Total number of employees working for the portfolio company as of the most recent reporting date.']
  enterprise_value decimal(18,2) [note: 'Total enterprise value of the portfolio company including equity and net debt, in base currency.']
  esg_rating varchar [note: 'ESG rating assigned to the portfolio company by an external rating agency or internal assessment framework. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C — 9 candidates stripped; promote to reference product]']
  esg_score decimal(5,2) [note: 'Numeric ESG score assigned to the portfolio company, typically on a 0-100 scale.']
  exit_date date [note: 'Date when the pension fund fully exited its position in the portfolio company, if applicable.']
  exit_type varchar [note: 'Method by which the pension fund exited the investment, if realized.']
  financials_as_of_date date [note: 'Date to which the latest revenue and EBITDA figures correspond.']
  fund_name varchar [note: 'Name of the private equity fund through which the portfolio company is held, if applicable.']
  gics_industry_code varchar [note: 'Six-digit GICS industry code providing detailed industry classification.']
  gics_industry_group_code varchar [note: 'Four-digit GICS industry group code providing sub-sector classification.']
  gics_sector_code varchar [note: 'Two-digit GICS sector code classifying the company\'s primary industry sector.']
  gics_sub_industry_code varchar [note: 'Eight-digit GICS sub-industry code providing the most granular industry classification.']
  headquarters_city varchar [note: 'City where the portfolio company\'s headquarters is located.']
  headquarters_country varchar [note: 'Three-letter ISO country code representing the location of the portfolio company\'s headquarters.']
  initial_investment_date date [note: 'Date when the pension fund first invested in the portfolio company.']
  investment_committee_approval_date date [note: 'Date when the pension fund\'s Investment Committee approved the initial investment in the portfolio company.']
  investment_stage varchar [note: 'Stage of the company at the time of investment indicating maturity and risk profile.']
  investment_status varchar [note: 'Current lifecycle status of the investment in the portfolio company.']
  investment_thesis varchar [note: 'Summary of the strategic rationale and value creation plan that justified the investment in the portfolio company.']
  investment_type varchar [note: 'Classification of how the portfolio company is held: direct investment, co-investment alongside a GP, through a fund, or via secondary transaction.']
  irr decimal(5,2) [note: 'Annualized internal rate of return on the investment in the portfolio company, expressed as a percentage.']
  jurisdiction_of_incorporation varchar [note: 'Three-letter ISO country code representing the legal jurisdiction where the company is incorporated.']
  key_risks varchar [note: 'Summary of the principal risks identified during due diligence and ongoing monitoring of the portfolio company.']
  last_updated_timestamp timestamp [note: 'Timestamp when the portfolio company record was most recently modified.']
  lead_investor varchar [note: 'Name of the lead investor or General Partner (GP) in the deal, if applicable.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier uniquely identifying the portfolio company globally.']
  moic decimal(5,2) [note: 'Ratio of total value (distributions plus current fair value) to total invested capital, measuring investment return multiple.']
  ownership_percentage decimal(5,2) [note: 'Percentage of equity ownership held by the pension fund in the portfolio company, expressed as a decimal (e.g., 25.50 for 25.5%).']
  revenue_latest decimal(18,2) [note: 'Most recent annual or trailing twelve-month revenue reported by the portfolio company, in base currency.']
  total_distributions_received decimal(18,2) [note: 'Cumulative cash distributions received by the pension fund from the portfolio company, including dividends and exit proceeds, in base currency.']
  total_invested_capital decimal(18,2) [note: 'Cumulative amount of capital invested by the pension fund in the portfolio company across all rounds and capital calls, in base currency.']
  valuation_date date [note: 'Date of the most recent fair value assessment for the portfolio company holding.']
  vintage_year varchar [note: 'Year in which the initial investment or fund commitment was made, used for cohort analysis and J-Curve modeling.']
  website_url varchar [note: 'Official website URL of the portfolio company.']

  Note: 'Master record for each portfolio company held directly or indirectly through PE fund investments. Captures company name, LEI, jurisdiction of incorporation, sector (GICS), sub-sector, business description, revenue (latest), EBITDA (latest), enterprise'
}

Table privateequity.gp_entity {
  gp_entity_id varchar [pk, note: 'Unique identifier for the General Partner entity record.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Required for compliance reporting: each GP entity must be linked to a manager profile to track regulatory and performance attribution.']
  active_fund_count varchar [note: 'Number of funds in active investment period or still holding portfolio assets.']
  aum_as_of_date date [note: 'Date as of which the total AUM figure was reported or calculated.']
  aum_currency varchar [note: 'ISO 4217 three-letter currency code for the reported AUM figure.']
  average_fund_irr decimal(8,4) [note: 'Average net IRR across all realized and partially realized funds managed by this GP, expressed as a decimal.']
  average_fund_moic decimal(8,4) [note: 'Average MOIC across all realized and partially realized funds managed by this GP.']
  created_timestamp timestamp [note: 'Timestamp when this GP entity record was first created in the system.']
  domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code where the GP entity is legally domiciled.']
  domicile_jurisdiction varchar [note: 'Specific legal jurisdiction or state within the domicile country where the GP is registered.']
  entity_type varchar [note: 'Legal structure type of the General Partner entity.']
  esg_rating varchar [note: 'ESG rating or score assigned to the General Partner by third-party rating agencies.']
  fund_count varchar [note: 'Total number of private equity funds currently managed by this General Partner.']
  gp_entity_status varchar [note: 'Current operational status of the General Partner entity in the pension fund\'s records.']
  headquarters_address varchar [note: 'Full street address of the General Partner\'s headquarters office.']
  headquarters_city varchar [note: 'City where the General Partner\'s headquarters is located.']
  headquarters_postal_code varchar [note: 'Postal or ZIP code of the General Partner\'s headquarters location.']
  inception_date date [note: 'Date when the General Partner entity was originally established or incorporated.']
  investment_team_size varchar [note: 'Total number of investment professionals employed by the General Partner.']
  key_investment_professionals varchar [note: 'Comma-separated list of key investment professionals and senior partners at the GP firm.']
  kyc_completion_date date [note: 'Date when the most recent KYC review was completed and approved.']
  kyc_expiry_date date [note: 'Date when the current KYC approval expires and requires renewal.']
  kyc_status varchar [note: 'Current status of the Know Your Customer due diligence process for this GP entity.']
  legal_name varchar [note: 'Full legal name of the General Partner entity as registered with regulatory authorities.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier uniquely identifying the GP entity globally.']
  ownership_structure varchar [note: 'Classification of the General Partner\'s ownership and organizational structure.']
  parent_organization varchar [note: 'Name of the parent or holding company if the GP is part of a larger organization.']
  pri_signatory boolean [note: 'Indicates whether the GP is a signatory to the UN Principles for Responsible Investment.']
  primary_contact_email varchar [note: 'Email address of the primary contact person for Limited Partner communications.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the General Partner for LP relations.']
  primary_contact_phone varchar [note: 'Telephone number of the primary contact person at the General Partner.']
  primary_regulator varchar [note: 'Name of the primary financial regulatory authority overseeing the General Partner.']
  primary_strategy varchar [note: 'Primary private equity investment strategy focus of the General Partner.']
  registration_number varchar [note: 'Official company registration or incorporation number issued by the domicile jurisdiction.']
  regulatory_status varchar [note: 'Current regulatory registration status of the GP with relevant financial authorities.']
  relationship_end_date date [note: 'Date when the pension fund\'s Limited Partner relationship with this GP ended, if applicable.']
  relationship_start_date date [note: 'Date when the pension fund first established a Limited Partner relationship with this GP.']
  risk_rating varchar [note: 'Internal risk rating assigned to the General Partner based on operational and counterparty risk assessment.']
  secondary_strategy varchar [note: 'Secondary or complementary investment strategy pursued by the General Partner, if applicable.']
  short_name varchar [note: 'Abbreviated or commonly used name for the General Partner entity.']
  target_geographies varchar [note: 'Comma-separated list of geographic regions or countries the GP focuses on for investments.']
  target_sectors varchar [note: 'Comma-separated list of industry sectors the GP typically targets for investment.']
  total_aum decimal(20,2) [note: 'Total assets under management across all funds managed by this General Partner, in USD.']
  total_employee_count varchar [note: 'Total number of employees across all functions at the General Partner firm.']
  track_record_summary varchar [note: 'Narrative summary of the GP\'s historical performance track record and key achievements.']
  updated_timestamp timestamp [note: 'Timestamp when this GP entity record was last modified.']
  website_url varchar [note: 'Official website URL of the General Partner firm.']

  Note: 'Master record for each General Partner (GP) entity managing PE funds in which the pension fund is an LP. Captures GP legal name, LEI, domicile, AUM, fund count, strategy focus, key investment professionals, GP track record summary, GP ownership structure'
}

Table privateequity.lp_advisory_committee {
  lp_advisory_committee_id varchar [pk, note: 'Unique identifier for the LP Advisory Committee membership record.']
  lp_entity_id varchar [note: 'Foreign key linking to privateequity.lp_entity. Business justification: LPAC members are LP investors in the fund. The member_organization and member_organization_lei fields are denormalized LP entity data.']
  pe_fund_id varchar [note: 'Reference to the private equity fund for which this LPAC membership applies.']
  alternate_member_name varchar [note: 'Name of the designated alternate who may represent the member in their absence.']
  appointment_authority varchar [note: 'Name or title of the entity or individual who appointed the member to the advisory committee.']
  appointment_date date [note: 'Date on which the member was formally appointed to the LP Advisory Committee.']
  committee_role varchar [note: 'Specific leadership or functional role held by the member within the advisory committee structure.']
  compensation_amount decimal(18,2) [note: 'Annual or per-meeting compensation paid to the member for advisory committee service, if applicable.']
  compensation_currency varchar [note: 'ISO 4217 three-letter currency code for the compensation amount.']
  confidentiality_agreement_date date [note: 'Date on which the member signed the confidentiality or non-disclosure agreement.']
  confidentiality_agreement_signed boolean [note: 'Indicates whether the member has executed the required confidentiality or non-disclosure agreement.']
  conflict_disclosure_date date [note: 'Date on which the member submitted their conflict of interest disclosure.']
  conflict_of_interest_description varchar [note: 'Detailed description of any disclosed conflicts of interest affecting the members advisory role.']
  conflict_of_interest_disclosed boolean [note: 'Indicates whether the member has disclosed any conflicts of interest as required by governance policies.']
  contact_email varchar [note: 'Primary email address for official LPAC communications with the member.']
  contact_phone varchar [note: 'Primary telephone number for official LPAC communications with the member.']
  created_timestamp timestamp [note: 'Timestamp when this LPAC membership record was first created in the system.']
  expense_reimbursement_eligible boolean [note: 'Indicates whether the member is eligible for reimbursement of travel and meeting-related expenses.']
  meeting_attendance_required boolean [note: 'Indicates whether the member is required to attend LPAC meetings per governance terms.']
  member_name varchar [note: 'Full name of the individual representing the LP on the advisory committee.']
  membership_status varchar [note: 'Current status of the members participation on the advisory committee.']
  minimum_attendance_percentage decimal(5,2) [note: 'Minimum percentage of meetings the member must attend to maintain good standing, as defined in LPA.']
  notes varchar [note: 'Additional free-text notes or comments regarding the members advisory committee participation.']
  removal_date date [note: 'Date on which the member was removed from the advisory committee, if applicable.']
  removal_reason varchar [note: 'Explanation or justification for the members removal from the advisory committee.']
  renewal_eligible boolean [note: 'Indicates whether the member is eligible for term renewal upon expiration.']
  representation_basis varchar [note: 'Criterion or basis on which the member was selected to represent LPs on the advisory committee.']
  resignation_date date [note: 'Date on which the member formally resigned from the advisory committee, if applicable.']
  seat_type varchar [note: 'Classification of the committee seat indicating voting rights and participation level.']
  term_duration_years decimal(4,2) [note: 'Length of the committee term in years, typically defined in the LPA governance provisions.']
  term_end_date date [note: 'Scheduled expiration date of the members current term on the advisory committee.']
  term_start_date date [note: 'Effective start date of the members current term on the advisory committee.']
  updated_timestamp timestamp [note: 'Timestamp when this LPAC membership record was last modified in the system.']
  voting_rights boolean [note: 'Indicates whether the member holds voting rights on advisory committee matters.']
  voting_weight decimal(5,4) [note: 'Proportional voting weight assigned to the member, typically expressed as a decimal fraction of total votes.']

  Note: 'Master record for LP Advisory Committee (LPAC) membership and governance for each PE fund. Captures fund reference, LPAC member name, member organization, seat type (voting, observer), appointment date, term expiry, conflict of interest disclosure status'
}

Table privateequity.capital_account {
  capital_account_id varchar [pk, note: 'Unique identifier for the LP capital account ledger record within a PE fund.']
  employee_id varchar [note: 'Reference to the fund administrator responsible for maintaining and reporting this capital account.']
  fund_administrator_id varchar [note: 'Reference to the fund administrator responsible for maintaining and reporting this capital account.']
  lp_entity_id varchar [note: 'Reference to the limited partner entity holding this capital account.']
  pe_fund_id varchar [note: 'Reference to the private equity fund in which this capital account exists.']
  account_number varchar [note: 'External account number assigned by the GP or fund administrator to this LP capital account.']
  account_status varchar [note: 'Current lifecycle status of the capital account.']
  carried_interest_allocation decimal(20,2) [note: 'Carried interest allocated to the GP from this LP capital account during the reporting period, subject to hurdle and waterfall provisions.']
  catch_up_amount decimal(20,2) [note: 'Cumulative catch-up allocation to the GP after the preferred return threshold is met, per the LPA waterfall structure.']
  clawback_obligation decimal(20,2) [note: 'Estimated clawback obligation owed by the LP to the fund if the fund were liquidated at current valuations, per waterfall calculations.']
  closing_balance decimal(20,2) [note: 'Capital account balance at the end of the reporting period, calculated as opening balance plus contributions and income allocations minus distributions and expense allocations.']
  commitment_amount decimal(20,2) [note: 'Total capital commitment made by the LP to the fund, representing the maximum callable capital.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code for the commitment amount.']
  contributions_in_period decimal(20,2) [note: 'Total capital called and contributed by the LP during the reporting period, including capital calls and recallable distributions.']
  created_timestamp timestamp [note: 'Timestamp when this capital account record was first created in the system.']
  cumulative_distributions decimal(20,2) [note: 'Total distributions paid to the LP since fund inception, including return of capital and profit distributions.']
  distributions_in_period decimal(20,2) [note: 'Total distributions paid to the LP during the reporting period, including return of capital and profit distributions.']
  dpi decimal(10,4) [note: 'Realization multiple calculated as cumulative distributions divided by paid-in capital, measuring cash returned to the LP.']
  fx_rate_to_commitment_currency decimal(15,8) [note: 'Exchange rate applied to convert reporting currency amounts to commitment currency, if different.']
  irr decimal(10,6) [note: 'Annualized internal rate of return for the LP capital account, calculated using cash flow timing and NAV.']
  is_final_statement boolean [note: 'Indicates whether this is the final capital account statement upon fund liquidation and closure.']
  k1_issued_date date [note: 'Date the Schedule K-1 tax form was issued to the LP for this capital account, applicable for US tax-reporting funds.']
  management_fee_allocation decimal(20,2) [note: 'Management fees charged to the LP capital account during the reporting period per the LPA terms.']
  nav decimal(20,2) [note: 'Current net asset value of the LP capital account, representing the fair value of the LPs residual interest in the fund.']
  net_income_allocation decimal(20,2) [note: 'Net income or loss allocated to the LP capital account during the reporting period, reflecting the LPs share of fund performance.']
  notes varchar [note: 'Free-text notes or commentary from the GP or administrator regarding this capital account statement.']
  opening_balance decimal(20,2) [note: 'Capital account balance at the beginning of the reporting period.']
  other_expenses_allocation decimal(20,2) [note: 'Other fund-level expenses allocated to the LP capital account during the period, excluding management fees.']
  ownership_percentage decimal(7,6) [note: 'LP ownership percentage in the fund, calculated as LP commitment divided by total fund commitments.']
  paid_in_capital decimal(20,2) [note: 'Cumulative capital called and contributed by the LP since fund inception.']
  period_end_date date [note: 'End date of the reporting period for this capital account statement.']
  period_start_date date [note: 'Start date of the reporting period for this capital account statement.']
  preferred_return_earned decimal(20,2) [note: 'Cumulative preferred return earned by the LP to date, calculated based on the hurdle rate and capital account balance over time.']
  preferred_return_threshold decimal(20,2) [note: 'Cumulative preferred return amount that must be achieved before carried interest is allocated to the GP, per the LPA hurdle rate.']
  recallable_distributions decimal(20,2) [note: 'Cumulative distributions subject to clawback provisions per the LPA, which may be recalled by the GP under certain conditions.']
  reporting_currency varchar [note: 'ISO 4217 three-letter currency code in which this capital account statement is reported.']
  rvpi decimal(10,4) [note: 'Unrealized multiple calculated as NAV divided by paid-in capital, measuring remaining value held in the fund.']
  side_letter_terms varchar [note: 'Summary of any side letter provisions or special terms applicable to this LP capital account that differ from the standard LPA.']
  statement_date date [note: 'Date the capital account statement was generated and issued to the LP.']
  tax_basis decimal(20,2) [note: 'Tax basis of the LP capital account for tax reporting purposes, may differ from GAAP capital account balance.']
  tvpi decimal(10,4) [note: 'Total value multiple calculated as the sum of cumulative distributions and NAV divided by paid-in capital, measuring total return.']
  unfunded_commitment decimal(20,2) [note: 'Remaining uncalled capital commitment available for future capital calls, calculated as commitment amount minus paid-in capital.']
  updated_timestamp timestamp [note: 'Timestamp when this capital account record was last modified in the system.']
  valuation_date date [note: 'As-of date for the NAV and fair value measurements reported in this capital account statement.']

  Note: 'LP capital account ledger record tracking the pension fund\'s running capital account balance within each PE fund. Captures opening balance, contributions in period, distributions in period, management fee allocations, carried interest allocations'
}

Table privateequity.management_fee_invoice {
  management_fee_invoice_id varchar [pk, note: 'Unique identifier for the management fee invoice record.']
  fund_id varchar [note: 'Reference to the PE fund commitment against which this management fee invoice was issued.']
  gp_entity_id varchar [note: 'Reference to the GP entity that issued this management fee invoice.']
  invoice_recipient_entity_id varchar [note: 'Reference to the LP entity (pension fund) that received and is responsible for paying this invoice.']
  approval_date date [note: 'Date on which the invoice was approved for payment.']
  approval_status varchar [note: 'Internal approval status of the invoice before payment authorization.']
  approved_by varchar [note: 'Name or identifier of the individual who approved the invoice for payment.']
  calculation_methodology varchar [note: 'Description of the methodology used to calculate the management fee for this period, including any special provisions or adjustments per the LPA.']
  cost_center varchar [note: 'Cost center or business unit to which this management fee is allocated.']
  created_timestamp timestamp [note: 'Timestamp when this invoice record was first created in the data platform.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the management fee is denominated.']
  dispute_date date [note: 'Date on which the dispute was raised by the LP.']
  dispute_flag boolean [note: 'Indicates whether this invoice is under dispute by the LP.']
  dispute_reason varchar [note: 'Explanation of the reason for disputing this management fee invoice, if applicable.']
  due_date date [note: 'Date by which the net management fee amount is due for payment to the GP.']
  fee_basis varchar [note: 'The capital base on which the management fee rate is applied: committed capital, invested capital, Net Asset Value (NAV), cost basis, or hybrid structure.']
  fee_basis_amount decimal(20,2) [note: 'The capital amount (in fund currency) on which the management fee rate is applied for this period.']
  fee_period_end_date date [note: 'End date of the period for which the management fee is being charged.']
  fee_period_start_date date [note: 'Start date of the period for which the management fee is being charged.']
  fee_rate decimal(6,4) [note: 'The annualized management fee rate applied to the fee basis, expressed as a decimal (e.g., 0.0200 for 2.00%).']
  gl_account_code varchar [note: 'General ledger account code to which this management fee expense is posted.']
  gross_fee_amount decimal(18,2) [note: 'The gross management fee amount calculated before any offsets or credits are applied.']
  invoice_date date [note: 'Date on which the GP issued the management fee invoice.']
  invoice_document_uri varchar [note: 'URI or file path to the original invoice document received from the GP.']
  invoice_number varchar [note: 'Unique invoice number assigned by the General Partner (GP) for this management fee billing.']
  monitoring_fee_offset decimal(18,2) [note: 'Offset credit applied from monitoring fees received by the GP from portfolio companies, reducing the net management fee payable by the Limited Partner (LP).']
  net_fee_amount decimal(18,2) [note: 'The net management fee amount payable by the LP after all offsets and credits have been applied.']
  notes varchar [note: 'Additional notes or comments related to this management fee invoice.']
  other_fee_offset decimal(18,2) [note: 'Any other fee offsets or credits applied to reduce the net management fee payable by the LP.']
  payment_date date [note: 'Actual date on which the management fee payment was made to the GP.']
  payment_reference varchar [note: 'Reference number or transaction identifier for the payment made against this invoice.']
  payment_status varchar [note: 'Current payment status of the management fee invoice.']
  proration_factor decimal(6,4) [note: 'Factor applied to prorate the management fee for partial periods (e.g., 0.5000 for half-year), expressed as a decimal.']
  resolution_date date [note: 'Date on which the dispute was resolved.']
  resolution_notes varchar [note: 'Notes describing the outcome and resolution of the dispute.']
  source_system_code varchar [note: 'Unique identifier of this invoice record in the source operational system.']
  total_fee_offset decimal(18,2) [note: 'Total of all fee offsets (monitoring, transaction, and other) applied to the gross management fee.']
  transaction_fee_offset decimal(18,2) [note: 'Offset credit applied from transaction fees received by the GP from portfolio companies, reducing the net management fee payable by the LP.']
  updated_timestamp timestamp [note: 'Timestamp when this invoice record was last updated in the data platform.']

  Note: 'Transactional record for GP management fee invoices received against each PE fund commitment: invoice date, fee period, fee basis (committed/invested capital/NAV), fee rate applied, gross fee, fee offset credits (monitoring/transaction fees), net fee'
}

Table privateequity.privateequity_benchmark {
  equity_benchmark_id varchar [pk, note: 'Primary key for benchmark']
  privateequity_benchmark_id varchar [pk, note: 'Unique identifier for the privateequity_benchmark data product (auto-inserted during validation).']
  approved_for_reporting_flag boolean [note: 'Indicates whether this benchmark has been approved by internal governance for use in official performance reporting to beneficiaries and regulators.']
  asset_class varchar [note: 'Primary asset class category that the benchmark covers.']
  benchmark_code varchar [note: 'Short code or ticker symbol identifying the benchmark.']
  benchmark_description varchar [note: 'Detailed textual description of the benchmark scope, methodology, inclusion criteria, and intended use cases.']
  benchmark_name varchar [note: 'Full name of the private equity benchmark used for performance comparison.']
  benchmark_status varchar [note: 'Current operational status of the benchmark indicating whether it is actively maintained and published.']
  benchmark_type varchar [note: 'Methodology used to calculate benchmark returns. Pooled Internal Rate of Return (IRR), Horizon IRR, Public Market Equivalent (PME), modified PME, Kaplan-Schoar PME, or Direct Alpha.']
  created_timestamp timestamp [note: 'Timestamp when this benchmark record was first created in the system.']
  currency varchar [note: 'ISO 4217 three-letter currency code in which benchmark returns are denominated.']
  data_lag_quarters varchar [note: 'Number of quarters of reporting lag inherent in the benchmark data due to fund reporting cycles.']
  data_quality_rating varchar [note: 'Internal assessment of the benchmark data quality based on completeness, accuracy, and timeliness.']
  data_source_url varchar [note: 'Web address or reference link to the providers official benchmark documentation and data access portal.']
  effective_date date [note: 'Date from which this benchmark record is effective and valid for use in performance comparisons.']
  exclusion_criteria varchar [note: 'Specific criteria that disqualify funds from inclusion in the benchmark, such as non-standard fee structures or incomplete reporting.']
  expiration_date date [note: 'Date after which this benchmark record is no longer valid or has been superseded by a newer version.']
  family varchar [note: 'Name of the broader benchmark family or suite to which this benchmark belongs, enabling grouping of related benchmarks.']
  fund_size_category varchar [note: 'Size classification of funds included in the benchmark, such as Small (<$500M), Mid ($500M-$2B), Large (>$2B), or All Sizes.']
  geographic_scope varchar [note: 'Geographic coverage of the benchmark using ISO 3166-1 alpha-3 country codes or regional identifiers (e.g., USA, GBR, Global, North America, Europe, Asia-Pacific).']
  inception_date date [note: 'Date when the benchmark was first established or when data collection began.']
  inclusion_criteria varchar [note: 'Specific criteria that funds must meet to be included in the benchmark universe, such as minimum fund size, reporting standards, or geographic domicile.']
  last_modified_timestamp timestamp [note: 'Timestamp when this benchmark record was most recently modified or updated.']
  last_update_date date [note: 'Date when the benchmark data was most recently updated by the provider.']
  license_type varchar [note: 'Type of data license governing the use and distribution of benchmark data within the organization.']
  net_or_gross varchar [note: 'Indicates whether benchmark returns are net of fees (Net) or gross of fees (Gross).']
  notes varchar [note: 'Additional free-text notes, comments, or special considerations related to the benchmark usage or interpretation.']
  number_of_funds varchar [note: 'Count of individual funds included in the benchmark calculation, indicating sample size and statistical robustness.']
  primary_use_case varchar [note: 'Primary business purpose for which this benchmark is used, such as performance attribution, manager selection, or portfolio construction.']
  provider_name varchar [note: 'Organization that publishes and maintains the benchmark data. [ENUM-REF-CANDIDATE: Cambridge Associates|Preqin|Burgiss|MSCI|PitchBook|State Street|Custom — 7 candidates stripped; promote to reference product]']
  public_market_index varchar [note: 'Name of the public market index used for Public Market Equivalent (PME) calculations, such as S&P 500, MSCI World, or Russell 2000.']
  quartile_available_flag boolean [note: 'Indicates whether quartile breakdowns (top quartile, median, bottom quartile) are available for this benchmark.']
  restatement_flag boolean [note: 'Indicates whether historical benchmark data has been restated or revised by the provider.']
  return_calculation_method varchar [note: 'Detailed methodology for calculating returns, including cash flow timing assumptions, valuation frequency, and aggregation approach.']
  sector_focus varchar [note: 'Industry sector or sectors covered by the benchmark, such as Technology, Healthcare, Industrials, or All Sectors.']
  strategy_focus varchar [note: 'Investment strategy or sub-strategy focus of the benchmark, such as early-stage venture, mega-buyout, or sector-specific strategies.']
  survivorship_bias_adjusted_flag boolean [note: 'Indicates whether the benchmark has been adjusted to account for survivorship bias by including defunct or liquidated funds.']
  update_frequency varchar [note: 'Frequency at which the benchmark provider publishes updated performance data.']
  usage_restrictions varchar [note: 'Any contractual or regulatory restrictions on how the benchmark data may be used, shared, or published.']
  version_number varchar [note: 'Version identifier for the benchmark methodology or data series, enabling tracking of changes over time.']
  vintage_year varchar [note: 'The fund commitment year that this benchmark represents. Used to compare funds of the same vintage cohort.']
  weighting_methodology varchar [note: 'Method used to weight individual fund contributions to the benchmark, such as equal-weighted, capital-weighted, or commitment-weighted.']

  Note: 'Reference data for PE performance benchmarks used to evaluate fund and portfolio performance. Captures benchmark name, benchmark provider (Cambridge Associates, Preqin, Burgiss, MSCI), benchmark type (pooled IRR, horizon IRR, PME), asset class scope'
}

Table privateequity.fund_of_funds_allocation {
  fund_of_funds_allocation_id varchar [pk, note: 'Unique identifier for the fund-of-funds allocation record.']
  fof_vehicle_id varchar [note: 'Reference to the fund-of-funds vehicle entity that this allocation represents.']
  gp_entity_id varchar [note: 'Reference to the external manager entity responsible for managing the FoF vehicle.']
  gp_profile_id varchar [note: 'Reference to the external manager entity responsible for managing the FoF vehicle.']
  underlying_pe_fund_id varchar [note: 'Reference to the underlying PE fund that the FoF vehicle allocates capital to.']
  allocation_currency varchar [note: 'Three-letter ISO 4217 currency code for the allocation commitment and cash flows.']
  allocation_date date [note: 'Date when the FoF vehicle committed or allocated capital to the underlying PE fund.']
  allocation_number varchar [note: 'Business identifier for the FoF allocation, used for operational tracking and reporting.']
  allocation_status varchar [note: 'Current lifecycle status of the FoF allocation to the underlying fund.']
  allocation_type varchar [note: 'Classification of the FoF allocation strategy: primary fund commitment, secondary market purchase, or co-investment alongside the FoF.']
  carried_interest_rate_percent decimal(5,4) [note: 'Performance fee rate (carry) earned by the FoF manager on profits above the hurdle rate, expressed as a percentage.']
  created_timestamp timestamp [note: 'Timestamp when this allocation record was first created in the system.']
  dpi_multiple decimal(8,4) [note: 'Realization multiple calculated as cumulative distributions divided by paid-in capital, measuring cash-on-cash return.']
  esg_classification varchar [note: 'ESG classification or rating of the underlying PE fund, reflecting its responsible investment approach and sustainability integration.']
  final_close_date date [note: 'Date of the underlying PE fund\'s final capital close, after which no new commitments are accepted.']
  first_close_date date [note: 'Date of the underlying PE fund\'s first capital close, marking the beginning of the investment period.']
  fof_total_commitment_amount decimal(18,2) [note: 'Total capital commitment made by the FoF vehicle to the underlying PE fund.']
  fund_term_years varchar [note: 'Total term of the underlying PE fund in years, including any extension options, as defined in the Limited Partnership Agreement (LPA).']
  geographic_focus varchar [note: 'Primary geographic regions or countries targeted by the underlying PE fund for investment.']
  hurdle_rate_percent decimal(5,4) [note: 'Minimum annualized return threshold that must be achieved before the FoF manager earns carried interest.']
  investment_period_end_date date [note: 'Date when the underlying PE fund\'s investment period concludes, after which new investments are typically restricted.']
  investment_strategy varchar [note: 'Description of the underlying PE fund\'s investment strategy that the FoF vehicle is allocating to (e.g., buyout, growth equity, venture capital).']
  irr_percent decimal(8,4) [note: 'Annualized internal rate of return for the FoF allocation, calculated using cash flow timing and current NAV.']
  key_person_clause_flag boolean [note: 'Indicates whether a key person provision exists that suspends investment activity if specified key investment professionals leave the FoF manager.']
  last_updated_timestamp timestamp [note: 'Timestamp when this allocation record was most recently modified.']
  management_fee_rate_percent decimal(5,4) [note: 'Annual management fee rate charged by the FoF manager, expressed as a percentage of committed or invested capital.']
  moic_multiple decimal(8,4) [note: 'Gross return multiple calculated as total value divided by invested capital, measuring overall investment performance.']
  most_favored_nation_flag boolean [note: 'Indicates whether the pension fund has most favored nation rights, ensuring it receives terms at least as favorable as any other LP.']
  nav_amount decimal(18,2) [note: 'Current fair market value of the FoF vehicle\'s interest in the underlying PE fund, representing unrealized value.']
  notes varchar [note: 'Free-text field for additional commentary, special terms, or operational notes related to the FoF allocation.']
  paid_in_capital_amount decimal(18,2) [note: 'Cumulative capital called and funded by the FoF vehicle to the underlying PE fund as of the reporting date.']
  pension_lp_interest_amount decimal(18,2) [note: 'The pension fund\'s proportional capital commitment within the FoF vehicle, representing its LP interest in the FoF.']
  pension_lp_ownership_percentage decimal(5,2) [note: 'The pension fund\'s ownership percentage in the FoF vehicle, calculated as pension LP interest divided by total FoF commitments.']
  remaining_commitment_amount decimal(18,2) [note: 'Uncalled committed capital available for future drawdowns by the underlying PE fund, also known as dry powder.']
  reporting_currency varchar [note: 'Three-letter ISO 4217 currency code used for consolidated reporting and performance measurement of this allocation.']
  rvpi_multiple decimal(8,4) [note: 'Unrealized value multiple calculated as NAV divided by paid-in capital, measuring remaining investment value.']
  sector_focus varchar [note: 'Primary industry sectors or verticals targeted by the underlying PE fund for investment.']
  side_letter_flag boolean [note: 'Indicates whether the pension fund has negotiated a side letter with the FoF manager granting special rights or terms.']
  termination_date date [note: 'Expected or actual date when the underlying PE fund will be dissolved and all assets liquidated.']
  total_distributions_amount decimal(18,2) [note: 'Cumulative distributions received by the FoF vehicle from the underlying PE fund, including realized proceeds and income.']
  tvpi_multiple decimal(8,4) [note: 'Total value multiple calculated as (distributions plus NAV) divided by paid-in capital, measuring total return on invested capital.']
  valuation_date date [note: 'As-of date for the most recent NAV valuation and performance metrics reported for this allocation.']
  vintage_year varchar [note: 'Year in which the underlying PE fund held its first close and began investing, used for cohort analysis and benchmarking.']
  waterfall_structure varchar [note: 'Distribution waterfall methodology defining how profits are allocated between LPs and the GP (European, American, or deal-by-deal).']

  Note: 'Master record for Fund-of-Funds (FoF) allocations where the pension fund invests in a FoF vehicle that in turn allocates to underlying PE funds. Captures FoF vehicle name, FoF manager, total FoF commitment, the pension fund\'s LP interest in the FoF'
}

Table privateequity.privateequity_cash_flow {
  privateequity_cash_flow_id varchar [pk, note: 'Primary key for cash_flow']
  deal_opportunity_id varchar [note: 'Reference to the specific investment deal or transaction that triggered this cash flow, if applicable.']
  fund_commitment_id varchar [note: 'Reference to the fund commitment record associated with this cash flow.']
  fund_id varchar [note: 'Reference to the private equity fund associated with this cash flow.']
  gp_entity_id varchar [note: 'Foreign key linking to privateequity.gp_entity. Business justification: Cash flow records have denormalized GP contact fields (gp_contact_name, gp_contact_email, gp_contact_phone).']
  opportunity_id varchar [note: 'Reference to the specific investment deal or transaction that triggered this cash flow, if applicable.']
  portfolio_company_id varchar [note: 'Reference to the portfolio company associated with this cash flow, if applicable.']
  base_currency_amount decimal(18,2) [note: 'The cash flow amount converted to the funds base reporting currency.']
  carried_interest_amount decimal(18,2) [note: 'The portion of the distribution representing carried interest or performance allocation to the general partner.']
  cash_flow_status varchar [note: 'Current lifecycle status of the cash flow transaction.']
  cash_flow_type varchar [note: 'Classification of the cash flow transaction indicating the nature of the movement. [ENUM-REF-CANDIDATE: capital_call|distribution|management_fee|fund_expense|organizational_expense|recallable_distribution|carried_interest|preferred_return — 8 candidates']
  created_timestamp timestamp [note: 'The timestamp when this cash flow record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code for the cash flow transaction.']
  default_interest_accrued decimal(18,2) [note: 'The cumulative amount of default interest accrued on late or unpaid capital call amounts.']
  default_interest_rate decimal(5,4) [note: 'The annual interest rate applied to late or defaulted capital call payments, expressed as a decimal.']
  document_url varchar [note: 'The URL or file path to the official cash flow notice document or supporting documentation.']
  due_date date [note: 'The date by which the cash flow payment is due, applicable primarily to capital calls.']
  effective_date date [note: 'The date from which the cash flow is effective for performance and valuation calculations.']
  excuse_approval_status varchar [note: 'The status of the limited partners excuse request as determined by the general partner.']
  excuse_request_flag boolean [note: 'Indicates whether the limited partner has requested to be excused from participating in this cash flow transaction.']
  excuse_request_reason varchar [note: 'The business or legal reason provided by the limited partner for requesting to be excused from the cash flow.']
  fund_expense_amount decimal(18,2) [note: 'The portion of the cash flow representing fund-level operating expenses.']
  fx_rate decimal(12,6) [note: 'The foreign exchange rate used to convert the transaction currency to the base currency.']
  gross_amount decimal(18,2) [note: 'The total gross amount of the cash flow before any adjustments, withholdings, or offsets.']
  investment_amount decimal(18,2) [note: 'The portion of the cash flow allocated to direct investment in portfolio companies or assets.']
  lp_acknowledgement_date date [note: 'The date on which the limited partner acknowledged receipt of the cash flow notice.']
  lp_acknowledgement_flag boolean [note: 'Indicates whether the limited partner has acknowledged receipt of the cash flow notice.']
  management_fee_amount decimal(18,2) [note: 'The portion of the cash flow representing management fees paid to the general partner.']
  modified_timestamp timestamp [note: 'The timestamp when this cash flow record was last modified in the system.']
  net_amount decimal(18,2) [note: 'The net amount of the cash flow after all adjustments, withholdings, and offsets have been applied.']
  notice_date date [note: 'The date on which notice of the cash flow was issued to the limited partner.']
  notice_method varchar [note: 'The method by which notice of the cash flow was communicated to the limited partner.']
  organizational_expense_amount decimal(18,2) [note: 'The portion of the cash flow representing one-time organizational and offering expenses incurred at fund formation.']
  payment_method varchar [note: 'The method used to execute the cash flow payment.']
  payment_reference_number varchar [note: 'The unique reference number assigned to the payment transaction by the treasury or banking system.']
  preferred_return_amount decimal(18,2) [note: 'The portion of the distribution representing the preferred return or hurdle rate payment to limited partners.']
  purpose varchar [note: 'Detailed description of the business purpose or reason for the cash flow transaction.']
  recallable_amount decimal(18,2) [note: 'The amount of the distribution that remains subject to recall by the general partner.']
  recallable_expiry_date date [note: 'The date after which the recallable distribution can no longer be recalled by the general partner.']
  recallable_flag boolean [note: 'Indicates whether the distribution is subject to recallability provisions under the limited partnership agreement.']
  settlement_account_number varchar [note: 'The bank account number used for settling the cash flow transaction.']
  settlement_bank_bic varchar [note: 'The Bank Identifier Code or SWIFT code of the settlement bank.']
  settlement_bank_name varchar [note: 'The name of the financial institution through which the cash flow was settled.']
  settlement_date date [note: 'The date on which the cash flow was actually settled and funds transferred.']
  transaction_date date [note: 'The date on which the cash flow transaction was executed or recorded by the general partner.']
  transaction_number varchar [note: 'Unique business identifier for the cash flow transaction assigned by the fund administrator or general partner.']
  withholding_tax_amount decimal(18,2) [note: 'The amount of tax withheld at source from the cash flow, typically applicable to distributions.']

  Note: 'Granular transactional record of all cash flows associated with PE investments — capital calls, distributions, management fees, fund expenses, and recallable distributions.'
}

Table privateequity.value_creation_plan {
  value_creation_plan_id varchar [pk, note: 'Unique identifier for the value creation plan record.']
  coinvestment_id varchar [note: 'Foreign key linking to privateequity.coinvestment. Business justification: Value creation plans currently link to investment but not coinvestment. Co-investments are direct investments alongside GPs that also require value creation tracking.']
  fund_id varchar [note: 'Reference to the private equity fund that owns or co-invests in this portfolio company.']
  investment_id varchar [note: 'Reference to the underlying private equity direct investment or co-investment for which this value creation plan was developed.']
  portfolio_company_id varchar [note: 'Reference to the portfolio company entity subject to this value creation plan.']
  actual_cost_reduction_amount decimal(18,2) [note: 'Actual cost savings achieved to date from execution of this value creation plan.']
  actual_ebitda_improvement_amount decimal(18,2) [note: 'Actual EBITDA improvement achieved to date from execution of this value creation plan, measured against the baseline.']
  actual_revenue_growth_amount decimal(18,2) [note: 'Actual revenue growth achieved to date from execution of this value creation plan, measured against the baseline.']
  baseline_date date [note: 'Date as of which the baseline financial metrics were measured for this value creation plan.']
  baseline_ebitda_amount decimal(18,2) [note: 'Baseline EBITDA of the portfolio company at the time the value creation plan was established, used as the reference point for measuring improvement.']
  baseline_revenue_amount decimal(18,2) [note: 'Baseline revenue of the portfolio company at the time the value creation plan was established, used as the reference point for measuring growth.']
  board_reporting_frequency varchar [note: 'Frequency at which progress on this value creation plan is reported to the portfolio company board and GP investment committee.']
  created_timestamp timestamp [note: 'Timestamp when this value creation plan record was first created in the system.']
  esg_impact_flag boolean [note: 'Boolean indicator of whether this value creation plan includes specific ESG improvement initiatives or targets.']
  esg_improvement_description varchar [note: 'Narrative description of the ESG improvements targeted by this value creation plan, if applicable.']
  investment_committee_memo_reference varchar [note: 'Reference number or identifier of the Investment Committee memorandum that approved or documented this value creation plan.']
  investment_thesis_alignment varchar [note: 'Narrative describing how this value creation plan aligns with the original investment thesis and underwriting assumptions presented to the Investment Committee.']
  key_initiatives varchar [note: 'Summary of the key strategic initiatives, projects, or workstreams that comprise this value creation plan.']
  key_risks varchar [note: 'Summary of the key risks and challenges that could impede successful execution of the value creation plan.']
  last_review_date date [note: 'Date of the most recent formal review or update of the value creation plan progress and metrics.']
  last_updated_timestamp timestamp [note: 'Timestamp when this value creation plan record was last modified or updated.']
  mitigation_actions varchar [note: 'Summary of the mitigation actions and contingency plans in place to address identified risks.']
  next_review_date date [note: 'Scheduled date for the next formal review or update of the value creation plan.']
  plan_actual_completion_date date [note: 'Actual date on which the value creation plan was completed or closed, if applicable.']
  plan_approval_date date [note: 'Date on which the value creation plan was formally approved by the Investment Committee or relevant governance body.']
  plan_currency varchar [note: 'Three-letter ISO 4217 currency code in which all financial targets and metrics for this value creation plan are denominated.']
  plan_description varchar [note: 'Detailed narrative description of the value creation plan objectives, scope, and strategic rationale.']
  plan_document_uri varchar [note: 'URI or file path to the formal value creation plan document, presentation, or supporting materials stored in the document management system.']
  plan_name varchar [note: 'Descriptive name or title of the value creation plan, typically reflecting the strategic theme or initiative focus.']
  plan_reference_number varchar [note: 'Externally-known unique reference or tracking number assigned to this value creation plan for governance and reporting purposes.']
  plan_start_date date [note: 'Date on which execution of the value creation plan commenced.']
  plan_status varchar [note: 'Current lifecycle status of the value creation plan indicating its stage in the approval and execution workflow.']
  plan_target_completion_date date [note: 'Target date by which all initiatives in the value creation plan are expected to be completed.']
  portfolio_company_ceo_name varchar [note: 'Name of the portfolio company CEO or senior executive accountable for delivering the value creation plan.']
  progress_percent decimal(5,2) [note: 'Overall percentage completion of the value creation plan based on milestone achievement and initiative progress.']
  responsible_partner_email varchar [note: 'Email address of the General Partner or investment professional responsible for this value creation plan.']
  responsible_partner_name varchar [note: 'Name of the General Partner or investment professional responsible for overseeing execution of this value creation plan.']
  risk_assessment varchar [note: 'Current risk rating for successful execution of the value creation plan, reflecting execution challenges, market conditions, and management capability.']
  target_cost_reduction_amount decimal(18,2) [note: 'Targeted absolute cost savings expected from execution of this value creation plan, expressed in the plan currency.']
  target_ebitda_improvement_amount decimal(18,2) [note: 'Targeted absolute improvement in EBITDA expected from execution of this value creation plan, expressed in the plan currency.']
  target_ebitda_improvement_percent decimal(5,2) [note: 'Targeted percentage improvement in EBITDA margin expected from execution of this value creation plan.']
  target_irr_percent decimal(5,2) [note: 'Targeted IRR expected at exit if this value creation plan is successfully executed.']
  target_moic_multiple decimal(5,2) [note: 'Targeted MOIC multiple expected at exit if this value creation plan is successfully executed.']
  target_revenue_growth_amount decimal(18,2) [note: 'Targeted absolute revenue increase expected from execution of this value creation plan, expressed in the plan currency.']
  target_revenue_growth_percent decimal(5,2) [note: 'Targeted percentage revenue growth expected from execution of this value creation plan.']
  value_creation_theme varchar [note: 'Primary strategic theme or category of value creation initiative, such as operational efficiency, revenue growth, margin expansion, cost reduction, ESG improvement, or management change.']

  Note: 'Master record for post-acquisition value creation plans for direct PE investments and co-investments. Captures investment reference, value creation theme (operational efficiency, revenue growth, M&A bolt-on, ESG improvement, management change'
}

Table privateequity.gp_report {
  gp_report_id varchar [pk, note: 'Unique identifier for each GP report received by the pension fund as Limited Partner (LP).']
  fund_id varchar [note: 'Reference to the private equity fund for which this report was issued.']
  audit_opinion varchar [note: 'Type of audit opinion issued by the independent auditor for audited reports.']
  auditor_name varchar [note: 'Name of the independent auditor who audited the fund financials, applicable for audited annual reports.']
  carried_interest_accrued decimal(20,2) [note: 'Cumulative carried interest accrued to the GP as of the reporting period end date, subject to clawback provisions.']
  created_timestamp timestamp [note: 'Timestamp when this GP report record was first created in the system.']
  dpi_multiple decimal(10,4) [note: 'Distributions to Paid-In (DPI) multiple calculated as cumulative distributions divided by paid-in capital.']
  dry_powder decimal(20,2) [note: 'Uncalled committed capital available for future investments as of the reporting period end date.']
  due_date date [note: 'Contractual deadline by which the GP was required to deliver the report per the Limited Partnership Agreement (LPA).']
  esg_metrics_included_flag boolean [note: 'Indicates whether the report includes Environmental, Social, and Governance (ESG) metrics and disclosures.']
  esg_summary varchar [note: 'Summary of ESG initiatives, metrics, and performance reported by the GP for the fund and portfolio companies.']
  fund_expenses decimal(20,2) [note: 'Total fund-level expenses incurred during the reporting period, excluding management fees.']
  fund_nav decimal(20,2) [note: 'Total Net Asset Value (NAV) of the fund as reported by the GP for the reporting period end date.']
  fund_nav_currency varchar [note: 'Three-letter ISO 4217 currency code for the fund NAV amount.']
  gp_contact_email varchar [note: 'Email address of the GP representative for report-related communications.']
  gp_contact_name varchar [note: 'Name of the GP representative responsible for investor relations and report inquiries.']
  gp_contact_phone varchar [note: 'Phone number of the GP representative for report-related communications.']
  irr_percent decimal(10,4) [note: 'Internal Rate of Return (IRR) of the fund as reported by the GP for the reporting period, expressed as a percentage.']
  key_person_event_description varchar [note: 'Details of any key person event that occurred during the reporting period.']
  key_person_event_flag boolean [note: 'Indicates whether a key person event occurred during the reporting period that may trigger LPA provisions.']
  lp_distributions decimal(20,2) [note: 'Cumulative distributions paid to the pension fund as LP as of the reporting period end date.']
  lp_dry_powder decimal(20,2) [note: 'Uncalled committed capital attributable to the pension fund as LP as of the reporting period end date.']
  lp_nav decimal(20,2) [note: 'Net Asset Value (NAV) attributable to the pension fund as LP, reflecting its proportional share of the fund.']
  lp_nav_currency varchar [note: 'Three-letter ISO 4217 currency code for the LP NAV amount.']
  lp_paid_in_capital decimal(20,2) [note: 'Cumulative capital called and funded by the pension fund as LP as of the reporting period end date.']
  management_fees_paid decimal(20,2) [note: 'Total management fees paid to the GP during the reporting period.']
  new_investments_amount decimal(20,2) [note: 'Total capital deployed into new investments during the reporting period.']
  new_investments_count varchar [note: 'Number of new investments made by the fund during the reporting period.']
  notes varchar [note: 'Additional notes or commentary from the pension fund regarding the GP report review and analysis.']
  portfolio_company_count varchar [note: 'Total number of portfolio companies held by the fund as of the reporting period end date.']
  realized_exits_count varchar [note: 'Number of portfolio company exits or realizations completed during the reporting period.']
  realized_proceeds_amount decimal(20,2) [note: 'Total proceeds received from portfolio company exits during the reporting period.']
  receipt_date date [note: 'Date on which the pension fund received the GP report from the General Partner.']
  report_date date [note: 'Date on which the GP report was officially issued or finalized by the General Partner.']
  report_document_url varchar [note: 'Uniform Resource Locator (URL) or file path to the full GP report document stored in the document management system.']
  report_number varchar [note: 'Unique report identifier assigned by the General Partner (GP) for tracking and reference purposes.']
  report_status varchar [note: 'Current lifecycle status of the GP report indicating whether it is preliminary or finalized.']
  report_type varchar [note: 'Classification of the report indicating its frequency and purpose.']
  reporting_period_end_date date [note: 'Ending date of the period covered by this GP report.']
  reporting_period_start_date date [note: 'Beginning date of the period covered by this GP report.']
  rvpi_multiple decimal(10,4) [note: 'Residual Value to Paid-In (RVPI) multiple calculated as NAV divided by paid-in capital.']
  total_distributions decimal(20,2) [note: 'Cumulative distributions paid to all Limited Partners (LPs) as of the reporting period end date.']
  total_paid_in_capital decimal(20,2) [note: 'Cumulative capital called and funded by all Limited Partners (LPs) as of the reporting period end date.']
  tvpi_multiple decimal(10,4) [note: 'Total Value to Paid-In (TVPI) multiple calculated as the sum of distributions and NAV divided by paid-in capital.']
  unrealized_value decimal(20,2) [note: 'Fair value of remaining portfolio investments that have not yet been exited as of the reporting period end date.']
  updated_timestamp timestamp [note: 'Timestamp when this GP report record was last modified in the system.']
  valuation_methodology varchar [note: 'Description of the valuation methodology applied by the GP to determine portfolio company fair values.']

  Note: 'Transactional record for each GP quarterly or annual fund report received by the pension fund as LP. Captures report type (quarterly, annual, audited), reporting period, receipt date, GP fund NAV reported, portfolio company count, new investments in'
}

Table privateequity.privateequity_coverage {
  privateequity_coverage_id varchar [pk, note: 'Primary key for the coverage association']
  pe_fund_id varchar [note: 'Foreign key linking to the private equity fund vehicle being covered by the research report']
  research_report_id varchar [note: 'Foreign key linking to the research report that covers the fund']
  privateequity_coverage_date date [note: 'Date when the research report was linked to or became relevant to the fund, as identified in detection phase relationship data']
  relevance_score decimal(5,2) [note: 'Numeric score indicating how material or relevant the research report is to the specific fund, as identified in detection phase relationship data. A report may be highly relevant to one fund but only tangentially relevant to another.']

  Note: 'This association product represents the research coverage relationship between private equity funds and research reports. It captures which research publications are relevant to which fund vehicles, enabling investment professionals to retrieve all'
}

Table privateequity.fof_vehicle {
  fof_vehicle_id varchar [pk, note: 'Primary key for fof_vehicle']
  gp_entity_id varchar [note: 'Foreign key linking to privateequity.gp_entity. Business justification: Fund-of-Funds vehicles are managed by a General Partner entity. This FK links the FoF vehicle to its managing GP, enabling proper relationship tracking for governance and reporting']
  administrator_name varchar [note: 'Name of the third-party fund administrator providing accounting and investor services.']
  audit_firm_name varchar [note: 'Name of the independent external auditor responsible for auditing the fund of funds vehicle financials.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code representing the functional currency of the fund of funds vehicle.']
  called_capital_amount decimal(18,2) [note: 'Cumulative capital that has been drawn down from limited partners through capital calls.']
  carried_interest_rate decimal(5,4) [note: 'Performance fee rate (carry) payable to the general partner on profits exceeding the preferred return.']
  custodian_name varchar [note: 'Name of the custodian bank responsible for safekeeping the fund of funds vehicle assets.']
  distributed_capital_amount decimal(18,2) [note: 'Cumulative distributions returned to limited partners from the fund of funds vehicle.']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the legal domicile jurisdiction of the fund of funds vehicle.']
  effective_date date [note: 'Date from which this fund of funds vehicle record becomes effective for reporting purposes.']
  extension_period_years varchar [note: 'Number of years by which the fund term may be extended beyond the original termination date.']
  final_close_date date [note: 'Date of the final closing after which no additional limited partner commitments are accepted.']
  first_close_date date [note: 'Date of the initial closing when the fund of funds vehicle accepted its first limited partner commitments.']
  fund_term_years varchar [note: 'Contractual duration in years for the fund of funds vehicle from inception to planned termination.']
  geographic_focus varchar [note: 'Primary geographic region targeted for underlying fund investments by the fund of funds vehicle.']
  gp_commitment_percentage decimal(5,4) [note: 'Percentage of total fund commitments contributed by the general partner to align interests with LPs.']
  hard_cap_amount decimal(18,2) [note: 'Maximum capital commitment amount the fund of funds vehicle is permitted to accept from all limited partners.']
  inception_date date [note: 'Date on which the fund of funds vehicle was legally established and commenced operations.']
  investment_period_end_date date [note: 'Date marking the end of the commitment period during which new investments can be made by the vehicle.']
  investment_strategy varchar [note: 'Primary private equity investment strategy pursued by the fund of funds vehicle.']
  is_erisa_eligible boolean [note: 'Indicates whether the fund of funds vehicle is structured to accept ERISA plan assets from US pension funds.']
  is_esg_compliant boolean [note: 'Indicates whether the fund of funds vehicle follows Environmental, Social, and Governance investment criteria.']
  legal_counsel_name varchar [note: 'Name of the primary legal counsel firm advising the fund of funds vehicle.']
  legal_entity_identifier varchar [note: '20-character ISO 17442 Legal Entity Identifier assigned to the fund of funds vehicle for regulatory reporting.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the general partner as a percentage of committed or invested capital.']
  nav_as_of_date date [note: 'Valuation date as of which the net asset value was calculated for the fund of funds vehicle.']
  net_asset_value decimal(18,2) [note: 'Current net asset value of the fund of funds vehicle representing fair value of all underlying holdings.']
  preferred_return_rate decimal(5,4) [note: 'Minimum annual return rate that must be achieved before carried interest is payable to the general partner.']
  record_created_timestamp timestamp [note: 'Timestamp when this fund of funds vehicle record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this fund of funds vehicle record was last modified in the system.']
  regulatory_status varchar [note: 'Current regulatory registration status of the fund of funds vehicle with applicable authorities.']
  reporting_frequency varchar [note: 'Frequency at which the fund of funds vehicle provides performance reports to limited partners.']
  sector_focus varchar [note: 'Primary industry sectors targeted for investment by the fund of funds vehicle.']
  sfdr_classification varchar [note: 'EU Sustainable Finance Disclosure Regulation classification for the fund of funds vehicle.']
  target_commitment_amount decimal(18,2) [note: 'Target total capital commitment amount the fund of funds vehicle aims to raise from limited partners.']
  tax_status varchar [note: 'Tax treatment classification of the fund of funds vehicle for investor reporting purposes.']
  termination_date date [note: 'Actual or projected date on which the fund of funds vehicle will be wound down and dissolved.']
  total_committed_capital decimal(18,2) [note: 'Aggregate capital commitments received from all limited partners in the fund of funds vehicle.']
  uncalled_capital_amount decimal(18,2) [note: 'Remaining committed capital not yet called from limited partners, representing available dry powder.']
  vehicle_code varchar [note: 'Internal alphanumeric code used to identify the fund of funds vehicle across investment systems.']
  vehicle_name varchar [note: 'Official legal name of the fund of funds vehicle as registered with regulatory authorities.']
  vehicle_status varchar [note: 'Current lifecycle status of the fund of funds vehicle indicating its operational phase.']
  vehicle_structure varchar [note: 'Legal structure under which the fund of funds vehicle is organized and operates.']
  vehicle_type varchar [note: 'Classification of the fund of funds vehicle by investment strategy approach.']
  vintage_year varchar [note: 'Calendar year in which the fund of funds vehicle held its first close or made its first capital call.']
  waterfall_type varchar [note: 'Type of distribution waterfall structure governing how profits are allocated between LP and GP.']

  Note: 'Master reference table for fof_vehicle. Referenced by fof_vehicle_id.'
}

Table privateequity.lp_entity {
  lp_entity_id varchar [pk, note: 'Primary key for lp_entity']
  aml_kyc_expiry_date date [note: 'Date when the current AML/KYC verification expires and requires renewal for the limited partner.']
  aml_kyc_status varchar [note: 'Current status of anti-money laundering and know-your-customer verification for the limited partner.']
  aml_kyc_verification_date date [note: 'Date when the most recent AML/KYC verification was completed for the limited partner entity.']
  aum_as_of_date date [note: 'The effective date for the reported total assets under management figure.']
  aum_currency_code varchar [note: 'ISO 4217 three-letter currency code for the total assets under management amount.']
  created_timestamp timestamp [note: 'Timestamp when the limited partner entity record was first created in the system.']
  crs_status varchar [note: 'OECD Common Reporting Standard classification for automatic exchange of financial account information.']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the legal domicile jurisdiction of the limited partner entity.']
  entity_status varchar [note: 'Current operational status of the limited partner entity in the fund relationship lifecycle.']
  entity_type varchar [note: 'Classification of the limited partner by institutional investor category. [ENUM-REF-CANDIDATE: pension_fund|sovereign_wealth_fund|endowment|foundation|insurance_company|family_office|fund_of_funds|corporate|bank|other — promote to reference product]']
  erisa_status varchar [note: 'Classification indicating whether the limited partner is subject to ERISA regulations for benefit plan investments.']
  esg_policy_indicator boolean [note: 'Indicates whether the limited partner has formal ESG investment policy requirements.']
  fatca_status varchar [note: 'FATCA classification of the limited partner for US tax withholding and reporting compliance purposes.']
  incorporation_date date [note: 'The date on which the limited partner entity was legally incorporated or established.']
  investor_classification varchar [note: 'Regulatory classification of the limited partner based on applicable securities law investor qualification standards.']
  is_government_entity boolean [note: 'Indicates whether the limited partner is a government or sovereign entity for regulatory classification.']
  is_most_favored_nation_eligible boolean [note: 'Indicates whether the limited partner is eligible for most favored nation provisions in fund terms.']
  is_side_letter_holder boolean [note: 'Indicates whether the limited partner has negotiated side letter agreements with special terms.']
  is_tax_exempt boolean [note: 'Indicates whether the limited partner entity has tax-exempt status affecting distribution calculations.']
  legal_entity_identifier varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier assigned to the limited partner for regulatory reporting.']
  legal_name varchar [note: 'The official registered legal name of the limited partner entity as it appears in fund documentation.']
  notes varchar [note: 'Free-form notes and comments regarding the limited partner entity for internal reference.']
  preferred_communication_method varchar [note: 'The limited partners preferred method for receiving fund communications and reports.']
  primary_contact_email varchar [note: 'Email address of the primary contact person for investor relations and fund communications.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the limited partner entity for fund communications.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact person at the limited partner entity.']
  registered_address_line_1 varchar [note: 'First line of the official registered address of the limited partner entity.']
  registered_address_line_2 varchar [note: 'Second line of the official registered address of the limited partner entity.']
  registered_city varchar [note: 'City of the official registered address of the limited partner entity.']
  registered_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the registered address of the limited partner entity.']
  registered_postal_code varchar [note: 'Postal or ZIP code of the official registered address of the limited partner entity.']
  registration_number varchar [note: 'Official registration or incorporation number assigned by the domicile jurisdiction regulatory authority.']
  relationship_manager_name varchar [note: 'Name of the internal relationship manager responsible for the limited partner account.']
  relationship_start_date date [note: 'Date when the business relationship with the limited partner entity was first established.']
  reporting_frequency varchar [note: 'The frequency at which the limited partner requires fund performance and financial reports.']
  risk_rating varchar [note: 'Internal risk assessment rating assigned to the limited partner based on due diligence and compliance review.']
  short_name varchar [note: 'Abbreviated or commonly used name for the limited partner entity for internal reference and reporting.']
  target_private_equity_allocation_pct decimal(5,2) [note: 'The limited partners target allocation percentage to private equity as part of their investment policy.']
  tax_identification_number varchar [note: 'The tax identification number of the limited partner entity used for tax reporting and withholding purposes.']
  total_assets_under_management decimal(18,2) [note: 'Total assets under management by the limited partner entity, used for investor capacity assessment.']
  unpri_signatory_indicator boolean [note: 'Indicates whether the limited partner is a signatory to the UN Principles for Responsible Investment.']
  updated_timestamp timestamp [note: 'Timestamp when the limited partner entity record was last modified in the system.']

  Note: 'Master reference table for lp_entity. Referenced by lp_entity_id.'
}

Table realestate.property {
  property_id varchar [pk, note: 'Unique identifier for the direct real estate asset held by the pension fund.']
  acquisition_date date [note: 'The date on which the pension fund acquired ownership or controlling interest in the property.']
  acquisition_price decimal(18,2) [note: 'The total purchase price paid at acquisition, including transaction costs, in the property\'s functional currency.']
  asset_class varchar [note: 'The primary real estate asset class categorization for the property.']
  cap_rate_percent decimal(5,2) [note: 'The capitalization rate used in valuation, calculated as NOI divided by property value, expressed as a percentage.']
  capex_budget_annual decimal(18,2) [note: 'Annual capital expenditure budget allocated for property improvements, renovations, and value creation initiatives.']
  city varchar [note: 'The city or municipality where the property is located.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code where the property is located (e.g., USA, CAN, GBR).']
  created_timestamp timestamp [note: 'The timestamp when this property record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the property\'s functional currency (e.g., USD, EUR, GBP).']
  disposition_date date [note: 'The date on which the pension fund disposed of or sold the property, if applicable.']
  disposition_price decimal(18,2) [note: 'The total sale price received upon disposition of the property, net of transaction costs, if applicable.']
  dscr decimal(5,2) [note: 'Debt Service Coverage Ratio calculated as NOI divided by annual debt service obligations.']
  energy_consumption_kwh_annual decimal(15,2) [note: 'Total annual energy consumption of the property measured in kilowatt-hours for ESG reporting and operational efficiency tracking.']
  esg_certification varchar [note: 'ESG or green building certification held by the property (e.g., LEED Gold, BREEAM Excellent, ENERGY STAR).']
  gav decimal(18,2) [note: 'Gross Asset Value representing the total fair market value of the property before deducting any debt or liabilities.']
  ghg_emissions_tonnes_co2e_annual decimal(12,2) [note: 'Total annual greenhouse gas emissions from property operations measured in tonnes of carbon dioxide equivalent for ESG and TCFD reporting.']
  gross_leasable_area_sqft decimal(12,2) [note: 'Total leasable floor area of the property measured in square feet, excluding common areas and structural elements.']
  investment_strategy varchar [note: 'The investment strategy classification for the property (core, core-plus, value-add, opportunistic) based on risk-return profile.']
  land_area_acres decimal(12,4) [note: 'Total land area of the property parcel measured in acres.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the property in decimal degrees.']
  legal_entity_identifier varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier for the holding entity that owns the property, if applicable.']
  lifecycle_status varchar [note: 'Current operational and investment lifecycle status of the property.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the property in decimal degrees.']
  ltv_ratio_percent decimal(5,2) [note: 'Loan-to-Value ratio calculated as outstanding debt divided by GAV, expressed as a percentage.']
  manager_name varchar [note: 'Name of the third-party property management firm or internal team responsible for day-to-day operations.']
  nav decimal(18,2) [note: 'Net Asset Value representing the equity value of the property after deducting outstanding debt and other liabilities from GAV.']
  noi_annual decimal(18,2) [note: 'Annual Net Operating Income calculated as gross rental income less operating expenses, excluding debt service and capital expenditures.']
  occupancy_rate_percent decimal(5,2) [note: 'Current physical occupancy rate of the property expressed as a percentage of gross leasable area.']
  outstanding_debt decimal(18,2) [note: 'Total outstanding mortgage or loan balance secured against the property.']
  ownership_percentage decimal(5,2) [note: 'The pension fund\'s percentage ownership interest in the property, expressed as a percentage.']
  ownership_structure varchar [note: 'The legal ownership structure through which the pension fund holds the property (direct, joint venture, fund investment, REIT).']
  postal_code varchar [note: 'The postal or ZIP code for the property location.']
  property_code varchar [note: 'The externally-known unique identifier or asset tag for the property used in portfolio reporting and fund administration systems.']
  property_name varchar [note: 'The business or marketing name of the real estate asset (e.g., Tower One Office Complex, Maple Logistics Center).']
  property_type varchar [note: 'Detailed property type within the asset class (e.g., Class A Office, Distribution Warehouse, Shopping Mall, Multifamily Apartment).']
  state_province varchar [note: 'The state, province, or administrative region where the property is located.']
  street_address varchar [note: 'The full street address of the property including building number and street name.']
  tax_parcel_number varchar [note: 'The local government tax parcel or assessment identifier for the property used for property tax administration.']
  updated_timestamp timestamp [note: 'The timestamp when this property record was last modified in the system.']
  valuation_date date [note: 'The effective date of the most recent independent appraisal or valuation for GAV and NAV determination.']
  valuation_method varchar [note: 'The primary valuation methodology used in the most recent appraisal (e.g., income capitalization, DCF, sales comparison).']
  water_consumption_cubic_meters_annual decimal(12,2) [note: 'Total annual water consumption of the property measured in cubic meters for ESG reporting and resource management.']
  year_built varchar [note: 'The year in which the property was originally constructed.']
  year_renovated varchar [note: 'The most recent year in which the property underwent major renovation or capital improvement, if applicable.']
  zoning_classification varchar [note: 'The municipal zoning classification or land use designation for the property parcel.']

  Note: 'Master record (SSOT) for each direct real estate asset held by the pension fund — commercial office, industrial/logistics, retail, residential, mixed-use, and specialty.'
}

Table realestate.property_valuation {
  property_valuation_id varchar [pk, note: 'Unique identifier for the property valuation record.']
  cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Property valuations are grouped into valuation cycles for periodic reporting and regulatory compliance.']
  property_id varchar [note: 'Reference to the real estate property asset being valued.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Each property_valuation must reference the formal valuation report in valuation_asset_valuation for audit and reporting.']
  appraiser_contact_name varchar [note: 'Name of the lead appraiser or valuation professional responsible for the valuation report.']
  appraiser_firm_name varchar [note: 'Name of the independent appraisal firm or valuation provider that performed the valuation.']
  appraiser_license_number varchar [note: 'Professional license or certification number of the lead appraiser.']
  approval_date date [note: 'Date on which the valuation was formally approved for use in portfolio reporting and financial statements.']
  approved_by varchar [note: 'Name or identifier of the internal investment professional who approved the valuation for portfolio reporting purposes.']
  cap_rate decimal(5,4) [note: 'Capitalization rate applied in the income approach valuation, expressed as a decimal (e.g., 0.0650 for 6.50%).']
  comparable_sales_count varchar [note: 'Number of comparable sales transactions analyzed in the sales comparison approach.']
  created_timestamp timestamp [note: 'Timestamp when this valuation record was first created in the system.']
  deferred_maintenance_estimate decimal(18,2) [note: 'Estimated cost of deferred maintenance and immediate capital repairs identified during the valuation inspection.']
  discount_rate decimal(5,4) [note: 'Discount rate applied in discounted cash flow (DCF) analysis, expressed as a decimal (e.g., 0.0800 for 8.00%).']
  environmental_risk_description varchar [note: 'Description of any environmental risks, contamination, or remediation requirements identified.']
  environmental_risk_flag boolean [note: 'Boolean indicator of whether environmental risks or contamination issues were identified during the valuation process.']
  gav decimal(18,2) [note: 'Gross Asset Value representing the total market value of the property before deducting any debt or liabilities.']
  highest_best_use varchar [note: 'Determination of the highest and best use of the property as concluded by the appraiser (e.g., current use, alternative use, redevelopment).']
  inspection_date date [note: 'Date on which the physical property inspection was conducted by the appraiser.']
  market_liquidity_assessment varchar [note: 'Assessment of the liquidity of the market for this property type and location.']
  market_rent_psf decimal(10,2) [note: 'Estimated market rent per square foot used in the valuation analysis.']
  nav decimal(18,2) [note: 'Net Asset Value representing the market value of the property after deducting associated debt and liabilities.']
  noi decimal(18,2) [note: 'Net Operating Income used in the income approach valuation, representing stabilized annual income after operating expenses but before debt service.']
  prior_valuation_amount decimal(18,2) [note: 'Gross Asset Value (GAV) from the most recent prior valuation for variance comparison.']
  prior_valuation_date date [note: 'Date of the most recent prior valuation for variance comparison purposes.']
  property_condition_rating varchar [note: 'Overall physical condition rating of the property as assessed by the appraiser (excellent, good, average, fair, or poor).']
  stabilized_occupancy_rate decimal(5,4) [note: 'Stabilized occupancy rate assumption used in the valuation, expressed as a decimal (e.g., 0.9500 for 95.00%).']
  terminal_cap_rate decimal(5,4) [note: 'Terminal capitalization rate applied to calculate the reversion value at the end of the DCF projection period, expressed as a decimal.']
  updated_timestamp timestamp [note: 'Timestamp when this valuation record was last modified in the system.']
  valuation_basis varchar [note: 'The basis of value applied in the valuation (market value, fair value, investment value, liquidation value, or insurance replacement value).']
  valuation_confidence_level varchar [note: 'Appraiser\'s confidence level in the valuation conclusion based on data availability and market conditions (high, medium, or low).']
  valuation_currency varchar [note: 'Three-letter ISO 4217 currency code in which the valuation amounts are denominated.']
  valuation_date date [note: 'The as-of date for which the property valuation was performed.']
  valuation_methodology varchar [note: 'Primary valuation methodology applied (income approach, sales comparison approach, cost approach, discounted cash flow, residual method, or hybrid combination).']
  valuation_notes varchar [note: 'Free-text notes capturing key assumptions, qualifications, or special considerations noted in the valuation report.']
  valuation_purpose varchar [note: 'The business purpose for which the valuation was commissioned (acquisition due diligence, portfolio reporting, financial statement reporting, loan collateral, disposition, or regulatory compliance).']
  valuation_report_date date [note: 'Date on which the formal valuation report was issued by the appraiser.']
  valuation_report_reference varchar [note: 'External reference number or identifier assigned by the appraiser to the valuation report.']
  valuation_status varchar [note: 'Current lifecycle status of the valuation record (draft, under review, approved, final, superseded, or rejected).']
  valuation_type varchar [note: 'The type or scope of valuation performed (full appraisal, desktop review, automated valuation model, broker price opinion, internal assessment, or annual revaluation).']
  valuation_variance_pct decimal(5,4) [note: 'Percentage variance between current valuation and prior valuation, expressed as a decimal (e.g., 0.0350 for 3.50% increase).']

  Note: 'Periodic valuation records for each property asset capturing appraised GAV, NAV, cap rate, discount rate, terminal cap rate, DCF-based valuation, independent appraiser details, valuation methodology (income approach, sales comparison, cost approach)'
}

Table realestate.noi_record {
  noi_record_id varchar [pk, note: 'Unique identifier for the NOI record. Primary key.']
  property_id varchar [note: 'Reference to the real estate property for which this NOI is calculated.']
  administrative_expense decimal(18,2) [note: 'General administrative costs including office supplies, communications, and overhead.']
  approved_by varchar [note: 'Name or identifier of the individual who approved this NOI record.']
  approved_timestamp timestamp [note: 'Date and time when this NOI record was approved.']
  calculation_method varchar [note: 'Accounting method used for NOI calculation: cash basis or accrual basis.']
  capitalization_rate decimal(5,4) [note: 'Market cap rate applied to NOI for property valuation purposes, expressed as a decimal.']
  concessions_amount decimal(18,2) [note: 'Rental discounts, free rent periods, or other tenant incentives reducing effective rent.']
  created_timestamp timestamp [note: 'Date and time when this NOI record was first created in the system.']
  credit_loss decimal(18,2) [note: 'Revenue loss due to tenant defaults, non-payment, or bad debt write-offs.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this record.']
  data_source varchar [note: 'System or platform from which the NOI data was sourced (e.g., property management system, accounting system).']
  effective_gross_income decimal(18,2) [note: 'Gross potential rent minus vacancy and credit losses, plus other income. Total revenue before operating expenses.']
  gross_potential_rent decimal(18,2) [note: 'Total rental income if the property were fully leased at market rates with no vacancies.']
  insurance_expense decimal(18,2) [note: 'Property insurance premiums covering casualty, liability, and other risks.']
  legal_professional_fees decimal(18,2) [note: 'Legal, accounting, consulting, and other professional service fees related to property operations.']
  marketing_leasing_expense decimal(18,2) [note: 'Costs for advertising, tenant acquisition, leasing commissions, and promotional activities.']
  modified_timestamp timestamp [note: 'Date and time when this NOI record was last modified.']
  net_operating_income decimal(18,2) [note: 'Effective gross income minus total operating expenses. Key metric for property performance before debt service and capital expenditures.']
  noi_margin_percent decimal(5,2) [note: 'NOI as a percentage of effective gross income, indicating operational efficiency.']
  noi_status varchar [note: 'Current status of the NOI record in the reporting and approval workflow.']
  notes varchar [note: 'Free-text commentary on unusual items, adjustments, or context for this NOI calculation.']
  occupancy_rate_percent decimal(5,2) [note: 'Percentage of leasable space occupied during the reporting period.']
  other_income decimal(18,2) [note: 'Non-rental income such as parking fees, laundry, storage, antenna leases, or service charges.']
  other_operating_expenses decimal(18,2) [note: 'Miscellaneous operating expenses not classified in other categories.']
  payroll_expense decimal(18,2) [note: 'Salaries, wages, and benefits for on-site staff including leasing agents, maintenance, and security.']
  property_management_fee decimal(18,2) [note: 'Fees paid to third-party or internal property management for day-to-day operations.']
  property_taxes decimal(18,2) [note: 'Real estate taxes levied by local government authorities on the property.']
  repairs_maintenance_expense decimal(18,2) [note: 'Routine maintenance, repairs, and upkeep costs to maintain property condition.']
  reporting_frequency varchar [note: 'Frequency at which NOI is calculated and reported for this property.']
  reporting_period_end_date date [note: 'End date of the period for which NOI is calculated.']
  reporting_period_start_date date [note: 'Start date of the period for which NOI is calculated (monthly, quarterly, or annual).']
  total_operating_expenses decimal(18,2) [note: 'Sum of all operating expenses incurred to maintain and operate the property.']
  utilities_expense decimal(18,2) [note: 'Costs for electricity, water, gas, sewer, and other utilities not recovered from tenants.']
  vacancy_loss decimal(18,2) [note: 'Revenue loss due to unoccupied units or spaces during the reporting period.']
  valuation_date date [note: 'Date on which the property was valued, used for NAV and GAV calculations referencing this NOI.']

  Note: 'Net Operating Income (NOI) records calculated at the property level on a periodic basis (monthly, quarterly, annual). Captures gross potential rent, effective gross income, vacancy and credit loss, operating expenses (property taxes, insurance'
}

Table realestate.lease {
  lease_id varchar [pk, note: 'Unique identifier for the lease agreement record.']
  actor_id varchar [note: 'Reference to the party providing financial guarantee or credit support for tenant lease obligations.']
  lease_employee_id varchar [note: 'Reference to the party providing financial guarantee or credit support for tenant lease obligations.']
  lease_property_manager_employee_id varchar [note: 'Reference to the internal employee or external party responsible for managing this lease relationship and property operations.']
  property_id varchar [note: 'Reference to the real estate property asset where the leased premises are located.']
  property_manager_actor_id varchar [note: 'Reference to the internal employee or external party responsible for managing this lease relationship and property operations.']
  tenant_id varchar [note: 'Reference to the tenant party occupying the leased premises.']
  assignment_sublease_rights varchar [note: 'Tenant rights to assign the lease or sublease the premises to third parties (prohibited, permitted with landlord consent, or freely assignable).']
  base_rent_amount decimal(15,2) [note: 'Initial base rent amount payable by tenant per payment period, excluding escalations, operating expenses, and additional charges.']
  commencement_date date [note: 'Date when the lease term begins and tenant occupancy rights commence.']
  created_timestamp timestamp [note: 'System timestamp when this lease record was first created in the data platform.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in the lease agreement.']
  document_uri varchar [note: 'Storage location or document management system reference for the executed lease agreement and related legal documents.']
  escalation_frequency_months varchar [note: 'Number of months between rent escalation events (e.g., 12 for annual escalations, 24 for biennial).']
  escalation_rate decimal(5,4) [note: 'Annual percentage or fixed amount by which base rent increases, expressed as a decimal (e.g., 0.0300 for 3 percent annual increase).']
  escalation_type varchar [note: 'Method by which base rent increases over the lease term (fixed amount, CPI-indexed, percentage increase, or none).']
  exclusivity_clause varchar [note: 'Contractual provision granting tenant exclusive rights to conduct specific business activities within the property, preventing landlord from leasing to competing tenants.']
  execution_date date [note: 'Date when the lease agreement was signed by all parties and became legally binding.']
  expiry_date date [note: 'Date when the lease term ends and tenant occupancy rights expire, unless renewed or extended.']
  floor_number varchar [note: 'Floor number or level identifier where the leased premises are located within the property.']
  free_rent_months varchar [note: 'Number of months at lease commencement during which tenant is not required to pay base rent, used as a lease incentive.']
  gla_square_feet decimal(12,2) [note: 'Total floor area of the leased premises measured in square feet, representing the space available for tenant use and the basis for rent calculations.']
  lease_status varchar [note: 'Current state of the lease agreement in its lifecycle (draft, active, expired, terminated, renewed, holdover).']
  lease_type varchar [note: 'Classification of lease structure defining tenant and landlord expense responsibilities (gross, net, triple-net, modified gross, percentage, ground).']
  notes varchar [note: 'Free-form text field for additional lease terms, special conditions, amendments, or operational notes not captured in structured fields.']
  number varchar [note: 'Externally-known unique business identifier for the lease agreement, used in legal documents and tenant communications.']
  operating_expense_recovery_type varchar [note: 'Method by which landlord recovers property operating expenses from tenant (base-year, expense-stop, pro-rata share, or none for gross leases).']
  parking_rent_amount decimal(12,2) [note: 'Additional monthly or annual rent charged for tenant parking spaces, separate from base rent.']
  parking_spaces_count varchar [note: 'Number of parking spaces allocated to tenant as part of the lease agreement.']
  percentage_rent_breakpoint decimal(15,2) [note: 'Annual sales revenue threshold above which percentage rent becomes payable by tenant.']
  percentage_rent_flag boolean [note: 'Indicates whether lease includes percentage rent provisions based on tenant sales revenue, common in retail leases.']
  percentage_rent_rate decimal(5,4) [note: 'Percentage of tenant gross sales revenue payable as additional rent above base rent, expressed as decimal (e.g., 0.0500 for 5 percent).']
  possession_date date [note: 'Date when tenant takes physical possession of the leased premises, which may differ from commencement date for build-out periods.']
  renewal_notice_days varchar [note: 'Number of days prior to lease expiry by which tenant must notify landlord of intent to exercise renewal option.']
  renewal_option_count varchar [note: 'Number of renewal option periods available to the tenant beyond the initial lease term.']
  renewal_option_term_months varchar [note: 'Duration in months of each renewal option period if tenant exercises the renewal right.']
  rent_commencement_date date [note: 'Date when tenant rent payment obligations begin, which may differ from lease commencement if free rent period is granted.']
  rent_payment_frequency varchar [note: 'Frequency at which rent payments are due from the tenant (monthly, quarterly, annually, semi-annually).']
  rent_per_square_foot decimal(10,2) [note: 'Base rent amount expressed as a rate per square foot of GLA, used for market comparison and valuation analysis.']
  security_deposit_amount decimal(15,2) [note: 'Refundable deposit amount held by landlord as security against tenant default or property damage.']
  suite_number varchar [note: 'Suite or unit number identifier for the specific leased premises within the property.']
  tenant_improvement_allowance decimal(15,2) [note: 'Dollar amount provided by landlord to tenant for build-out and customization of leased premises.']
  term_months varchar [note: 'Total duration of the lease agreement expressed in months from commencement to expiry.']
  termination_notice_days varchar [note: 'Number of days advance notice tenant must provide to landlord to exercise early termination right.']
  termination_option_flag boolean [note: 'Indicates whether tenant has the contractual right to terminate the lease prior to expiry date.']
  termination_penalty_amount decimal(15,2) [note: 'Financial penalty or fee payable by tenant to landlord upon early termination of the lease.']
  updated_timestamp timestamp [note: 'System timestamp when this lease record was last modified in the data platform.']
  use_clause varchar [note: 'Contractual description of permitted business activities and uses for the leased premises, restricting tenant operations to specified purposes.']

  Note: 'Master record for each tenant lease agreement at a property, capturing tenant identity, leased premises (suite, floor, GLA), lease commencement and expiry dates, lease type (gross, net, triple-net, modified gross), base rent, rent escalation schedule'
}

Table realestate.lease_rent_schedule {
  lease_rent_schedule_id varchar [pk, note: 'Unique identifier for the lease rent schedule record. Primary key.']
  lease_id varchar [note: 'Reference to the parent lease agreement for which this rent schedule applies.']
  property_id varchar [note: 'Reference to the real estate property asset associated with this rent schedule.']
  abatement_amount decimal(18,2) [note: 'The rent amount waived or reduced during this period as a lease concession.']
  accounting_period varchar [note: 'The financial reporting period to which this rent schedule entry is allocated, in YYYY-MM format.']
  actual_payment_amount decimal(18,2) [note: 'The actual rent amount received for this period, which may differ from scheduled amount due to adjustments or disputes.']
  actual_payment_date date [note: 'The date on which the rent payment for this period was actually received.']
  base_rent_amount decimal(18,2) [note: 'The contractual base rent amount for this period before any adjustments or escalations.']
  cpi_adjusted_amount decimal(18,2) [note: 'The additional rent amount resulting from CPI indexation for this period.']
  cpi_adjustment_factor decimal(10,6) [note: 'The inflation adjustment multiplier applied to base rent based on CPI movement for this period.']
  created_timestamp timestamp [note: 'The date and time when this rent schedule record was first created in the system.']
  cumulative_rent_to_date decimal(18,2) [note: 'The sum of all rent amounts from lease commencement through the end of this period.']
  effective_rent_per_sqft decimal(12,4) [note: 'The total rent amount divided by leased square footage, representing the effective rate for this period.']
  escalation_amount decimal(18,2) [note: 'The incremental rent increase applied in this period due to contractual step-up provisions.']
  escalation_rate decimal(6,4) [note: 'The percentage rate applied for fixed escalation calculations in this period, expressed as a decimal.']
  escalation_type varchar [note: 'The method by which rent increases are calculated for this period.']
  free_rent_flag boolean [note: 'Indicates whether this period is a rent abatement or free rent period per lease concessions.']
  lease_modification_flag boolean [note: 'Indicates whether this rent schedule entry was affected by a lease amendment or modification.']
  modification_effective_date date [note: 'The date on which a lease modification affecting this rent period became effective.']
  noi_contribution decimal(18,2) [note: 'The net operating income contribution from this rent period after deducting direct property expenses.']
  notes varchar [note: 'Additional commentary or context regarding this rent schedule period, such as special adjustments or tenant negotiations.']
  operating_expense_recovery decimal(18,2) [note: 'Tenant reimbursement for property operating expenses allocated to this rent period.']
  other_charges_amount decimal(18,2) [note: 'Additional charges such as parking, utilities, or amenity fees for this period.']
  payment_due_date date [note: 'The contractual date by which the rent payment for this period must be received.']
  payment_frequency varchar [note: 'The contractual frequency at which rent payments are due for this schedule.']
  payment_status varchar [note: 'The current status of the rent payment for this period.']
  percentage_rent_amount decimal(18,2) [note: 'Variable rent based on tenant revenue or property performance metrics for this period.']
  period_end_date date [note: 'The last date of the rent payment period covered by this schedule entry.']
  period_sequence_number varchar [note: 'Sequential ordering of the rent period within the lease term, starting from 1.']
  period_start_date date [note: 'The first date of the rent payment period covered by this schedule entry.']
  rent_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all rent amounts in this schedule entry.']
  rent_type varchar [note: 'The lease structure type defining which expenses are included in or excluded from base rent.']
  straight_line_rent_amount decimal(18,2) [note: 'The average rent amount per period calculated on a straight-line basis over the lease term for accounting purposes.']
  tax_recovery_amount decimal(18,2) [note: 'Tenant reimbursement for property taxes allocated to this rent period.']
  total_rent_amount decimal(18,2) [note: 'The aggregate rent amount for this period including base rent, escalations, adjustments, and recoveries.']
  updated_timestamp timestamp [note: 'The date and time when this rent schedule record was last modified.']
  variance_amount decimal(18,2) [note: 'The difference between scheduled total rent and actual payment received for this period.']

  Note: 'Detailed rent schedule for each lease, capturing all contractual rent payment periods, scheduled base rent amounts, rent step-up dates, CPI adjustment factors, effective rent per period, and cumulative rent to lease expiry.'
}

Table realestate.rent_collection {
  rent_collection_id varchar [pk, note: 'Unique identifier for the rent collection transaction record.']
  actor_id varchar [note: 'Identifier of the internal or external agent responsible for managing this rent collection.']
  cash_account_id varchar [note: 'Identifier of the bank account into which the rent payment was deposited.']
  employee_id varchar [note: 'Identifier of the internal or external agent responsible for managing this rent collection.']
  lease_id varchar [note: 'Identifier of the lease agreement under which this rent collection occurs.']
  property_id varchar [note: 'Identifier of the real estate property from which rent is collected.']
  tenant_id varchar [note: 'Identifier of the tenant responsible for the rent payment.']
  adjustment_amount decimal(18,2) [note: 'Manual adjustment applied to the rent collection for reconciliation or correction purposes.']
  arrears_balance decimal(18,2) [note: 'Outstanding unpaid rent balance owed by the tenant as of the collection date.']
  billing_period_end_date date [note: 'End date of the rental period covered by this collection transaction.']
  billing_period_start_date date [note: 'Start date of the rental period covered by this collection transaction.']
  collection_notes varchar [note: 'Free-text notes or comments regarding the rent collection transaction, disputes, or follow-up actions.']
  collection_status varchar [note: 'Current status of the rent collection transaction in the receivables lifecycle.']
  created_timestamp timestamp [note: 'Timestamp when the rent collection record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the rent collection transaction.']
  days_overdue varchar [note: 'Number of days the rent payment is overdue past the due date.']
  discount_amount decimal(18,2) [note: 'Discount or concession applied to the invoiced rent amount.']
  dispute_flag boolean [note: 'Indicates whether the tenant has disputed the invoiced rent amount or payment terms.']
  dispute_reason varchar [note: 'Description of the reason provided by the tenant for disputing the rent collection.']
  due_date date [note: 'Date by which the rent payment is contractually due from the tenant.']
  gl_account_code varchar [note: 'General ledger account code to which this rent collection is posted for financial reporting.']
  invoice_date date [note: 'Date on which the rent invoice was issued to the tenant.']
  invoice_number varchar [note: 'Unique invoice reference number issued to the tenant for rent due.']
  invoiced_amount decimal(18,2) [note: 'Total rent amount invoiced to the tenant for the billing period.']
  late_fee_amount decimal(18,2) [note: 'Additional late payment fee charged to the tenant for overdue rent.']
  net_amount_due decimal(18,2) [note: 'Net rent amount due after applying discounts, late fees, and adjustments.']
  noi_contribution decimal(18,2) [note: 'Contribution of this rent collection to the property-level Net Operating Income calculation.']
  payment_channel varchar [note: 'Channel or interface through which the tenant submitted the rent payment.']
  payment_method varchar [note: 'Method or instrument used by the tenant to remit the rent payment.']
  payment_received_date date [note: 'Actual date on which the rent payment was received from the tenant.']
  payment_reference varchar [note: 'External reference number or transaction identifier provided by the tenant or payment processor.']
  received_amount decimal(18,2) [note: 'Actual amount of rent payment received from the tenant.']
  reconciliation_date date [note: 'Date on which the rent collection was reconciled against bank statements and ledger entries.']
  reconciliation_status varchar [note: 'Status of the rent collection transaction in the cash reconciliation process.']
  tax_amount decimal(18,2) [note: 'Tax component included in the rent collection transaction, if applicable.']
  tax_jurisdiction varchar [note: 'Tax jurisdiction or authority under which the rent collection tax is calculated and remitted.']
  updated_timestamp timestamp [note: 'Timestamp when the rent collection record was last modified in the system.']
  write_off_date date [note: 'Date on which the uncollected rent was written off from accounts receivable.']
  write_off_flag boolean [note: 'Indicates whether the uncollected rent has been written off as uncollectible.']
  write_off_reason varchar [note: 'Business justification or reason for writing off the uncollected rent amount.']

  Note: 'Transactional records of actual rent receipts collected from tenants against scheduled lease obligations. Captures invoice date, due date, payment received date, invoiced amount, received amount, arrears balance, payment method, and collection status'
}

Table realestate.tenant {
  tenant_id varchar [pk, note: 'Unique identifier for the tenant occupying space in the real estate portfolio.']
  aml_screening_date date [note: 'The date of the most recent AML screening performed on the tenant.']
  aml_status varchar [note: 'The current Anti-Money Laundering screening status of the tenant.']
  anchor_tenant_flag boolean [note: 'Boolean indicator of whether the tenant is classified as an anchor tenant, typically occupying significant space and driving property value.']
  annual_revenue_amount decimal(18,2) [note: 'The most recent annual revenue of the tenant entity in the reporting currency, used for creditworthiness assessment.']
  annual_revenue_currency varchar [note: 'The ISO 4217 three-letter currency code for the annual revenue amount.']
  business_registration_number varchar [note: 'The official registration or incorporation number assigned by the jurisdiction of incorporation.']
  created_timestamp timestamp [note: 'The timestamp when this tenant record was first created in the system.']
  credit_rating varchar [note: 'The external credit rating assigned to the tenant by a recognized rating agency, used for tenant credit risk assessment. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR — 11 candidates stripped; promote to reference product]']
  credit_rating_agency varchar [note: 'The rating agency that issued the credit rating for the tenant.']
  credit_rating_date date [note: 'The date on which the current credit rating was assigned or last affirmed.']
  employee_count varchar [note: 'The approximate number of employees of the tenant entity, used for business scale assessment.']
  esg_rating varchar [note: 'The ESG rating assigned to the tenant by a recognized ESG rating provider, used for responsible investment screening. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|NR — 8 candidates stripped; promote to reference product]']
  esg_rating_date date [note: 'The date on which the current ESG rating was assigned or last updated.']
  esg_rating_provider varchar [note: 'The name of the ESG rating agency that provided the ESG rating for the tenant.']
  headquarters_address_line1 varchar [note: 'The first line of the tenants corporate headquarters street address.']
  headquarters_city varchar [note: 'The city in which the tenants corporate headquarters is located.']
  headquarters_country_code varchar [note: 'The ISO 3166-1 alpha-3 country code for the tenants corporate headquarters location.']
  headquarters_postal_code varchar [note: 'The postal or ZIP code of the tenants corporate headquarters address.']
  headquarters_state_province varchar [note: 'The state or province in which the tenants corporate headquarters is located.']
  incorporation_country_code varchar [note: 'The ISO 3166-1 alpha-3 country code where the tenant entity is legally incorporated.']
  industry_sector_code varchar [note: 'The GICS industry sector code classifying the tenants primary business activity for concentration risk analysis.']
  industry_sector_name varchar [note: 'The human-readable name of the GICS industry sector in which the tenant operates.']
  kyc_completion_date date [note: 'The date on which the most recent KYC review was completed and approved.']
  kyc_expiry_date date [note: 'The date on which the current KYC approval expires and requires renewal.']
  kyc_status varchar [note: 'The current status of the Know Your Customer due diligence process for the tenant.']
  legal_name varchar [note: 'The full legal registered name of the tenant entity as recorded in corporate registry.']
  lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier for the tenant, enabling global counterparty identification.']
  notes varchar [note: 'Free-form text field for capturing additional notes, special considerations, or historical context about the tenant.']
  number_of_leases varchar [note: 'The total count of active lease agreements held by this tenant across the portfolio.']
  onboarding_date date [note: 'The date on which the tenant was first onboarded into the real estate portfolio management system.']
  parent_entity_lei varchar [note: 'The LEI of the parent entity for consolidated credit and concentration risk monitoring.']
  parent_entity_name varchar [note: 'The name of the parent or ultimate beneficial owner entity if the tenant is a subsidiary, used for group exposure analysis.']
  primary_contact_email varchar [note: 'The email address of the primary tenant contact for operational communications.']
  primary_contact_name varchar [note: 'The name of the primary business contact person for lease administration and tenant relations.']
  primary_contact_phone varchar [note: 'The telephone number of the primary tenant contact for urgent lease matters.']
  public_company_flag boolean [note: 'Boolean indicator of whether the tenant is a publicly traded company with securities listed on a recognized exchange.']
  relationship_manager_name varchar [note: 'The name of the internal relationship manager responsible for managing the tenant relationship and lease administration.']
  stock_exchange_code varchar [note: 'The ISO 10383 Market Identifier Code for the primary stock exchange where the tenant is listed.']
  stock_ticker_symbol varchar [note: 'The stock exchange ticker symbol for the tenant if publicly traded, enabling market data linkage.']
  tax_identification_number varchar [note: 'The tax identification number assigned to the tenant by the relevant tax authority for reporting and compliance.']
  tenant_status varchar [note: 'The current operational and financial status of the tenant relationship.']
  tenant_type varchar [note: 'Classification of tenant by strategic importance and lease characteristics within the portfolio.']
  total_leased_gla_sqft decimal(18,2) [note: 'The total gross leasable area in square feet currently leased by this tenant across all properties in the portfolio.']
  trading_name varchar [note: 'The commercial or trading name under which the tenant operates, if different from legal name.']
  updated_timestamp timestamp [note: 'The timestamp when this tenant record was last modified in the system.']

  Note: 'Master record for each tenant occupying space across the real estate portfolio. Captures tenant legal name, trading name, industry sector (GICS classification), credit rating, LEI, KYC/AML status, parent entity, number of leases, total leased GLA, anchor'
}

Table realestate.realestate_capex_program {
  realestate_capex_program_id varchar [pk, note: 'Unique identifier for the capital expenditure program record.']
  actor_id varchar [note: 'Reference to the asset manager or asset management team responsible for overseeing the property and its value creation initiatives.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Capex program funding originates from a cash account; the link supports budgeting, funding approvals, and cash flow forecasting.']
  contractor_id varchar [note: 'Reference to the contractor or vendor entity responsible for executing the capital expenditure program.']
  employee_id varchar [note: 'Reference to the asset manager or asset management team responsible for overseeing the property and its value creation initiatives.']
  property_id varchar [note: 'Reference to the property asset where the capital expenditure program is being executed.']
  actual_completion_date date [note: 'Actual date when all capital expenditure program activities were completed and the program was closed.']
  actual_spend_amount decimal(18,2) [note: 'Total capital expenditure actually incurred and paid as of the reporting date, representing cash outflows or accrued liabilities.']
  actual_start_date date [note: 'Actual date when capital expenditure program activities commenced, used for schedule variance analysis.']
  approval_authority varchar [note: 'Name or identifier of the governance body or individual who approved the capital expenditure program.']
  approval_date date [note: 'Date when the capital expenditure program and its budget were formally approved by the Investment Committee (IC) or delegated authority.']
  approved_budget_amount decimal(18,2) [note: 'Total capital expenditure budget amount approved by the Investment Committee (IC) or delegated authority for the program.']
  budget_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the approved budget and all financial amounts in the program.']
  business_case_reference varchar [note: 'Reference identifier or document number for the Investment Memorandum (IM) or business case supporting the capital expenditure program.']
  committed_spend_amount decimal(18,2) [note: 'Total amount of capital expenditure committed through contracts, purchase orders, and binding agreements as of the reporting date.']
  completion_percentage decimal(5,2) [note: 'Current percentage of program completion based on milestones achieved, work completed, or budget spent.']
  contingency_amount decimal(18,2) [note: 'Budget contingency or reserve amount set aside to cover unforeseen costs, scope changes, or risk events during program execution.']
  contingency_percentage decimal(5,2) [note: 'Contingency amount expressed as a percentage of the approved budget, indicating the risk buffer allocated.']
  contractor_name varchar [note: 'Name of the primary contractor or construction firm engaged to execute the capital expenditure program.']
  created_timestamp timestamp [note: 'Timestamp when the capital expenditure program record was first created in the system.']
  energy_efficiency_improvement_percentage decimal(5,2) [note: 'Expected percentage improvement in energy efficiency or reduction in energy consumption resulting from the capital expenditure program.']
  esg_impact_category varchar [note: 'Classification of the Environmental, Social, and Governance (ESG) impact or benefit delivered by the capital expenditure program.']
  expected_irr_percentage decimal(5,2) [note: 'Projected Internal Rate of Return (IRR) for the capital expenditure program, used to evaluate value creation and investment efficiency.']
  expected_nav_increase_amount decimal(18,2) [note: 'Projected increase in property Net Asset Value (NAV) or Gross Asset Value (GAV) resulting from the capital expenditure program.']
  expected_noi_increase_amount decimal(18,2) [note: 'Projected annual increase in Net Operating Income (NOI) resulting from the capital expenditure program upon completion.']
  forecast_completion_date date [note: 'Latest forecast date for program completion based on current progress and known delays or accelerations.']
  forecast_total_cost_amount decimal(18,2) [note: 'Latest forecast of the total capital expenditure cost at completion, including all approved changes and anticipated overruns.']
  funding_source varchar [note: 'Source of capital funding for the expenditure program, such as equity, debt, joint venture contribution, or asset-level cash flow.']
  ghg_reduction_target_tonnes decimal(12,2) [note: 'Target reduction in annual Greenhouse Gas (GHG) emissions measured in tonnes of carbon dioxide equivalent resulting from the program.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) decision or resolution approving the capital expenditure program.']
  last_status_update_date date [note: 'Date when the program status, forecast, or financial data was last updated in the system.']
  modified_timestamp timestamp [note: 'Timestamp when the capital expenditure program record was last modified or updated in the system.']
  planned_completion_date date [note: 'Scheduled date for the completion of all capital expenditure program activities as per the original project plan.']
  planned_start_date date [note: 'Scheduled date for the commencement of capital expenditure program activities as per the original project plan.']
  program_code varchar [note: 'Unique business identifier or code assigned to the capital expenditure program for tracking and reference.']
  program_manager_name varchar [note: 'Name of the individual responsible for managing and delivering the capital expenditure program.']
  program_name varchar [note: 'Business name or title of the capital expenditure program for identification and reporting purposes.']
  program_status varchar [note: 'Current lifecycle status of the capital expenditure program indicating its execution stage.']
  program_type varchar [note: 'Classification of the capital expenditure program by its strategic purpose and scope.']
  realestate_capex_program_description varchar [note: 'Detailed narrative description of the capital expenditure program scope, objectives, and key activities.']
  risk_rating varchar [note: 'Overall risk assessment for the capital expenditure program considering execution, cost, schedule, and market risks.']
  strategic_objective varchar [note: 'High-level business objective or value creation goal that the capital expenditure program is designed to achieve.']
  variance_amount decimal(18,2) [note: 'Difference between the approved budget and the forecast total cost, indicating budget overrun or underrun.']
  variance_percentage decimal(5,2) [note: 'Variance amount expressed as a percentage of the approved budget, used for performance monitoring and escalation triggers.']

  Note: 'Capital expenditure program records for post-acquisition value creation initiatives at the property level. Captures program name, type (repositioning, refurbishment, development, ESG retrofit, tenant improvement), approved budget, committed spend, actual'
}

Table realestate.capex_expenditure {
  capex_expenditure_id varchar [pk, note: 'Unique identifier for the capital expenditure transaction record.']
  approver_employee_id varchar [note: 'Reference to the employee or user entity who approved this expenditure.']
  budget_line_item_id varchar [note: 'Reference to the specific budget line item within the capital expenditure program budget against which this expenditure is tracked.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Capex expenditure payments are made from a cash account; linking enables expense tracking and reconciliation with treasury cash balances.']
  contract_id varchar [note: 'Reference to the vendor contract or service agreement under which this expenditure is authorized.']
  employee_id varchar [note: 'Reference to the employee or user entity who approved this expenditure.']
  property_id varchar [note: 'Reference to the real estate property asset where the capital expenditure is being deployed.']
  realestate_capex_program_id varchar [note: 'Reference to the approved capital expenditure program under which this expenditure is authorized.']
  vendor_id varchar [note: 'Reference to the vendor or contractor entity in the vendor master data.']
  approval_date date [note: 'Date on which the expenditure was approved by the authorized approver or investment committee.']
  approved_amount decimal(18,2) [note: 'Amount approved for payment after review and validation, which may differ from the invoiced amount due to adjustments or disputes.']
  approver_name varchar [note: 'Name of the individual or committee that approved this capital expenditure transaction.']
  asset_class varchar [note: 'Fixed asset class or category to which this capitalized expenditure will be assigned (e.g., building improvements, tenant improvements, equipment).']
  capex_expenditure_description varchar [note: 'Detailed narrative description of the work performed, materials purchased, or services rendered for this capital expenditure.']
  capitalization_flag boolean [note: 'Indicates whether this expenditure qualifies for capitalization as a fixed asset addition under accounting standards (True) or should be expensed (False).']
  cost_center_code varchar [note: 'Cost center or business unit code responsible for this capital expenditure.']
  created_timestamp timestamp [note: 'Timestamp when this expenditure record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the expenditure amounts are denominated.']
  depreciation_method varchar [note: 'Depreciation method to be applied to the capitalized expenditure: straight-line, declining balance, units of production, or other.']
  expenditure_category varchar [note: 'Classification of the capital expenditure by cost type: hard costs (construction, materials), soft costs (design, engineering), furniture fixtures and equipment, contingency reserves, professional fees, or permits and regulatory fees.']
  expenditure_date date [note: 'The date on which the capital expenditure transaction occurred or was incurred.']
  expenditure_reference_number varchar [note: 'Business identifier for the expenditure transaction, typically a work order number, invoice number, or payment reference.']
  expenditure_status varchar [note: 'Current lifecycle status of the expenditure transaction within the approval and payment workflow.']
  gl_account_code varchar [note: 'General ledger account code to which this capital expenditure is posted for financial reporting.']
  invoice_date date [note: 'Date on which the vendor invoice was issued.']
  invoice_number varchar [note: 'Vendor invoice number associated with this expenditure transaction.']
  invoiced_amount decimal(18,2) [note: 'Total amount invoiced by the vendor for this expenditure, in the transaction currency.']
  milestone_reference varchar [note: 'Reference to the project milestone or phase associated with this expenditure, used for progress tracking and payment scheduling.']
  modified_by varchar [note: 'User or system identifier of the individual who last modified this expenditure record.']
  modified_timestamp timestamp [note: 'Timestamp when this expenditure record was last modified or updated.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this capital expenditure transaction.']
  paid_amount decimal(18,2) [note: 'Actual amount paid to the vendor for this expenditure transaction.']
  payment_date date [note: 'Date on which payment was made to the vendor for this expenditure.']
  payment_method varchar [note: 'Method used to remit payment to the vendor: wire transfer, check, automated clearing house, credit card, or other.']
  payment_reference varchar [note: 'Payment transaction reference number or confirmation code from the treasury or accounts payable system.']
  project_code varchar [note: 'Project or capital program code under which this expenditure is tracked for budgeting and reporting purposes.']
  purchase_order_number varchar [note: 'Purchase order number issued to the vendor authorizing the work or procurement associated with this expenditure.']
  reconciliation_date date [note: 'Date on which the expenditure was reconciled and confirmed as accurate in the accounting records.']
  reconciliation_status varchar [note: 'Status of the reconciliation process between the expenditure record, vendor invoice, and payment confirmation.']
  retainage_amount decimal(18,2) [note: 'Amount withheld from payment as retainage per contract terms, to be released upon project completion or milestone achievement.']
  retainage_percentage decimal(5,4) [note: 'Percentage of the invoiced amount withheld as retainage, expressed as a decimal (e.g., 0.1000 for 10%).']
  scope_of_work varchar [note: 'Detailed scope of work or deliverables associated with this expenditure, often referencing contract terms or work order specifications.']
  tax_amount decimal(18,2) [note: 'Total tax amount (sales tax, value-added tax, goods and services tax) included in the invoiced amount.']
  tax_rate decimal(5,4) [note: 'Tax rate applied to the expenditure, expressed as a decimal (e.g., 0.0700 for 7%).']
  useful_life_years varchar [note: 'Estimated useful life in years for depreciation purposes if the expenditure is capitalized.']
  variance_amount decimal(18,2) [note: 'Variance between the approved budget amount and the actual expenditure amount, calculated as actual minus budget.']
  vendor_name varchar [note: 'Name of the vendor, contractor, or service provider to whom the expenditure was paid.']
  work_order_reference varchar [note: 'Reference number of the work order or project task associated with this expenditure.']
  created_by varchar [note: 'User or system identifier of the individual who created this expenditure record.']

  Note: 'Individual capital expenditure transaction records within an approved capex program. Captures expenditure date, vendor/contractor, work order reference, expenditure category (hard costs, soft costs, FF&E, contingency), invoiced amount, approved amount'
}

Table realestate.realestate_debt_facility {
  realestate_debt_facility_id varchar [pk, note: 'Unique identifier for the real estate debt facility record. Primary key.']
  actor_id varchar [note: 'Reference to the party providing a guarantee or credit support for the facility, if applicable.']
  credit_issuer_id varchar [note: 'Reference to the financial institution or counterparty providing the debt facility.']
  employee_id varchar [note: 'Reference to the party providing a guarantee or credit support for the facility, if applicable.']
  legal_entity_id varchar [note: 'Reference to the internal legal entity that is the borrower under this facility.']
  lender_counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: The lender of a debt facility is a counterparty; linking facilitates loan origination, servicing, and regulatory reporting.']
  loan_servicer_id varchar [note: 'Reference to the third-party servicer administering the loan, if applicable.']
  property_id varchar [note: 'Reference to the underlying real estate property asset securing this debt facility.']
  accrued_interest_amount decimal(18,2) [note: 'Interest accrued but not yet paid as of the current valuation date.']
  amortization_period_months varchar [note: 'Total number of months over which the loan principal is scheduled to amortize.']
  amortization_type varchar [note: 'Principal repayment structure: interest-only, amortizing, bullet, or balloon payment.']
  commitment_date date [note: 'Date when the lender committed to provide the debt facility.']
  commitment_fee_rate decimal(5,4) [note: 'Annual fee rate applied to the undrawn portion of the facility, expressed as a decimal.']
  covenant_package varchar [note: 'Summary description of financial and operational covenants attached to the facility.']
  created_timestamp timestamp [note: 'Timestamp when this debt facility record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the debt facility denomination.']
  data_source_system varchar [note: 'Name of the source system from which this debt facility record originated (e.g., eFront, State Street).']
  default_date date [note: 'Date when the facility entered default status, if applicable.']
  default_flag boolean [note: 'Indicates whether the facility is currently in default or breach of covenants.']
  drawn_amount decimal(18,2) [note: 'Current principal amount drawn down and outstanding under the facility.']
  dscr decimal(5,2) [note: 'Debt service coverage ratio measuring property NOI relative to debt service obligations.']
  extension_option_flag boolean [note: 'Indicates whether the facility includes an option to extend the maturity date.']
  extension_period_months varchar [note: 'Number of months by which the facility maturity can be extended if the option is exercised.']
  facility_identifier varchar [note: 'External loan or facility reference number assigned by the lender or internal system.']
  facility_limit_amount decimal(18,2) [note: 'Maximum principal amount available under the debt facility agreement.']
  facility_status varchar [note: 'Current lifecycle status of the debt facility: active, committed, drawn, matured, repaid, or defaulted.']
  facility_type varchar [note: 'Classification of the debt facility structure: senior mortgage, mezzanine, construction loan, revolving credit, bridge loan, or term loan.']
  interest_rate decimal(8,5) [note: 'Current annual interest rate applied to the drawn balance, expressed as a decimal (e.g., 0.0450 for 4.50%).']
  interest_rate_type varchar [note: 'Classification of the interest rate structure: fixed, floating, variable, or hybrid.']
  last_payment_date date [note: 'Date of the most recent debt service payment received.']
  loan_agreement_date date [note: 'Date when the formal loan agreement was signed by all parties.']
  ltv_ratio decimal(5,4) [note: 'Loan-to-value ratio calculated as drawn amount divided by property valuation, expressed as a decimal (e.g., 0.6500 for 65%).']
  maturity_date date [note: 'Scheduled date when the debt facility principal is due for full repayment.']
  modified_by_user varchar [note: 'User identifier of the person who last modified this record.']
  modified_timestamp timestamp [note: 'Timestamp when this debt facility record was last modified.']
  next_payment_date date [note: 'Scheduled date for the next debt service payment.']
  origination_date date [note: 'Date when the debt facility was originated and the loan agreement was executed.']
  origination_fee_amount decimal(18,2) [note: 'One-time fee paid to the lender at facility origination.']
  payment_frequency varchar [note: 'Frequency of scheduled debt service payments: monthly, quarterly, semi-annual, or annual.']
  prepayment_allowed_flag boolean [note: 'Indicates whether prepayment of principal is permitted under the facility terms.']
  prepayment_penalty_rate decimal(5,4) [note: 'Penalty rate applied to prepayments, expressed as a decimal percentage of prepaid principal.']
  recourse_type varchar [note: 'Extent of borrower liability beyond collateral: full recourse, non-recourse, or limited recourse.']
  reference_rate decimal(18,2) [note: 'Benchmark rate used for floating rate facilities (e.g., SOFR, LIBOR, EURIBOR).']
  security_type varchar [note: 'Type of security or collateral arrangement: first lien, second lien, unsecured, or cross-collateralized.']
  seniority varchar [note: 'Priority ranking of the debt facility in the capital structure: senior, subordinated, mezzanine, or junior.']
  spread_bps varchar [note: 'Credit spread over the reference rate, expressed in basis points (e.g., 250 for 2.50%).']
  undrawn_amount decimal(18,2) [note: 'Remaining available principal amount that can be drawn under the facility limit.']

  Note: 'Property-level debt financing records capturing mortgage and construction loan facilities secured against real estate assets. Captures lender identity, facility type (senior mortgage, mezzanine, construction loan, revolving credit), facility limit, drawn'
}

Table realestate.ltv_dscr_covenant {
  ltv_dscr_covenant_id varchar [pk, note: 'Unique identifier for the LTV and DSCR covenant compliance record.']
  property_id varchar [note: 'Reference to the real estate property asset subject to covenant measurement.']
  realestate_debt_facility_id varchar [note: 'Reference to the debt facility or loan agreement under which the covenant is measured.']
  annual_debt_service decimal(18,2) [note: 'Total annual debt service obligation including principal and interest payments for the debt facility.']
  appraiser_name varchar [note: 'Name of the independent appraiser or valuation firm that provided the property valuation.']
  approval_date date [note: 'Date on which the covenant compliance report was formally approved.']
  approved_by varchar [note: 'Name or identifier of the senior officer or investment committee member who approved the covenant report.']
  covenant_notes varchar [note: 'Additional notes or commentary regarding the covenant measurement, compliance status, or special circumstances.']
  cure_action_taken varchar [note: 'Description of remedial actions taken to cure a covenant breach, such as capital injection or debt paydown.']
  cure_completion_date date [note: 'Date on which the covenant breach was cured and compliance was restored.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this covenant record.']
  dscr_breach_amount decimal(18,2) [note: 'Monetary shortfall by which the DSCR covenant is breached, if applicable; null if compliant.']
  dscr_compliance_status varchar [note: 'Current compliance status of the DSCR covenant at the measurement date.']
  dscr_covenant_threshold decimal(8,4) [note: 'Minimum required DSCR as specified in the loan agreement or debt facility covenant.']
  dscr_ratio decimal(8,4) [note: 'Calculated DSCR expressed as a decimal, representing NOI divided by annual debt service.']
  lender_notification_date date [note: 'Date on which the lender was formally notified of the covenant measurement results.']
  ltv_breach_amount decimal(18,2) [note: 'Monetary amount by which the LTV covenant is breached, if applicable; null if compliant.']
  ltv_compliance_status varchar [note: 'Current compliance status of the LTV covenant at the measurement date.']
  ltv_covenant_threshold decimal(8,4) [note: 'Maximum allowable LTV ratio as specified in the loan agreement or debt facility covenant.']
  ltv_ratio decimal(8,4) [note: 'Calculated LTV ratio expressed as a decimal, representing outstanding debt divided by property GAV.']
  measurement_date date [note: 'The date on which the LTV and DSCR covenant compliance was measured and calculated.']
  measurement_frequency varchar [note: 'Frequency at which covenant compliance must be measured and reported per the loan agreement.']
  next_measurement_date date [note: 'Scheduled date for the next covenant compliance measurement as per the loan agreement.']
  noi_trailing_twelve_months decimal(18,2) [note: 'Net operating income for the property over the trailing twelve months, used in DSCR calculation.']
  outstanding_debt_balance decimal(18,2) [note: 'Total outstanding principal balance of the debt facility at the measurement date.']
  overall_covenant_status varchar [note: 'Aggregate compliance status considering both LTV and DSCR covenants for the measurement period.']
  prepared_by varchar [note: 'Name or identifier of the individual or team responsible for preparing the covenant compliance report.']
  property_gav decimal(18,2) [note: 'Current gross asset value of the property used in the LTV calculation, typically based on the most recent appraisal or valuation.']
  property_nav decimal(18,2) [note: 'Net asset value of the property after deducting liabilities, used for alternative covenant calculations.']
  record_created_timestamp timestamp [note: 'Timestamp when this covenant compliance record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this covenant compliance record was last updated in the system.']
  reporting_period varchar [note: 'The fiscal period for which the covenant is reported, in YYYY-QN or YYYY-MM format.']
  reviewed_by varchar [note: 'Name or identifier of the individual or team that reviewed and approved the covenant compliance report.']
  valuation_date date [note: 'Date of the most recent property valuation or appraisal used in the GAV calculation.']
  valuation_method varchar [note: 'Method used to determine the property GAV for covenant calculation purposes.']
  waiver_expiry_date date [note: 'Date on which the granted covenant waiver expires, if applicable.']
  waiver_granted_flag boolean [note: 'Indicates whether a covenant waiver was granted by the lender for this measurement period.']

  Note: 'Periodic LTV (Loan-to-Value) and DSCR (Debt Service Coverage Ratio) covenant compliance records calculated at the property and debt facility level. Captures measurement date, current property GAV, outstanding debt balance, calculated LTV ratio, LTV'
}

Table realestate.reit_position {
  reit_position_id varchar [pk, note: 'Unique identifier for the REIT position record within the portfolio management system.']
  portfolio_id varchar [note: 'Reference to the investment portfolio that holds this REIT position.']
  acquisition_date date [note: 'Date when the initial position in this REIT was established, used for holding period and performance attribution calculations.']
  annual_distribution_amount decimal(18,2) [note: 'Total cash distributions received from the REIT over the trailing twelve months in position currency.']
  average_cost_per_unit decimal(18,4) [note: 'Weighted average acquisition cost per unit in the position currency, calculated across all purchase transactions.']
  base_currency_market_value decimal(18,2) [note: 'Market value of the position converted to the fund base currency using the current foreign exchange rate for consolidated reporting.']
  benchmark_index varchar [note: 'Name of the market index used to evaluate relative performance of this REIT position, such as FTSE NAREIT All Equity REITs Index.']
  carbon_intensity decimal(18,4) [note: 'Greenhouse gas emissions per unit of revenue or square footage for the REIT underlying properties, measured in metric tons CO2 equivalent.']
  country_of_domicile varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code indicating the legal jurisdiction where the REIT is incorporated and regulated.']
  created_timestamp timestamp [note: 'System timestamp recording when this REIT position record was first created in the investment book of record.']
  current_market_price decimal(18,4) [note: 'Most recent traded price per unit as of the last market close or intraday quote, used for mark-to-market valuation.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities for clearing and settlement.']
  custodian_account_number varchar [note: 'Account identifier at the custodian bank where the REIT units are held in safekeeping for settlement and corporate action processing.']
  custodian_name varchar [note: 'Name of the financial institution providing custody and safekeeping services for the REIT position.']
  dividend_yield decimal(8,6) [note: 'Annualized dividend income as a percentage of current market price, calculated from trailing twelve-month distributions.']
  esg_rating varchar [note: 'Third-party ESG assessment score or rating assigned to the REIT issuer, reflecting sustainability and responsible investment criteria.']
  esg_rating_provider varchar [note: 'Name of the third-party organization that assigned the ESG rating, such as MSCI, Sustainalytics, or FTSE Russell.']
  exchange_code varchar [note: 'Market Identifier Code (MIC) of the primary exchange where the REIT is listed and traded.']
  fx_rate decimal(18,8) [note: 'Exchange rate used to convert position currency to base currency, expressed as units of base currency per unit of position currency.']
  investment_committee_approval_date date [note: 'Date on which the Investment Committee formally approved the initial investment or material increase in this REIT position.']
  investment_strategy varchar [note: 'Strategic mandate or sub-portfolio classification under which this REIT position is held, such as core real estate, opportunistic, or income-focused.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the REIT security globally.']
  last_distribution_date date [note: 'Most recent date on which a dividend or distribution was paid to unitholders of record.']
  last_trade_date date [note: 'Most recent date on which a buy or sell transaction was executed for this REIT position, used for turnover and activity analysis.']
  lei varchar [note: 'ISO 17442 standard 20-character alphanumeric code uniquely identifying the REIT legal entity for regulatory reporting and counterparty identification.']
  market_value decimal(18,2) [note: 'Current fair value of the entire position calculated as units held multiplied by current market price in position currency.']
  next_distribution_date date [note: 'Expected date of the next scheduled dividend or distribution payment based on the REIT declared distribution calendar.']
  notes varchar [note: 'Free-text field for portfolio manager commentary, special instructions, or qualitative observations regarding the REIT position.']
  position_currency varchar [note: 'Three-letter ISO 4217 currency code in which the REIT is denominated and traded on the primary exchange.']
  position_status varchar [note: 'Current lifecycle state of the position indicating whether it is actively held, fully liquidated, temporarily suspended, or subject to trading restrictions.']
  price_source varchar [note: 'Name of the market data vendor or pricing service providing the current market price, such as Bloomberg, Reuters, or exchange feed.']
  reit_name varchar [note: 'Full legal name of the REIT issuer as registered with the exchange or regulatory authority.']
  reit_sector varchar [note: 'Primary real estate sector classification of the REIT based on underlying property holdings.']
  reit_type varchar [note: 'Structural classification indicating whether the REIT primarily holds equity in properties, mortgages, or a hybrid combination.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  ticker_symbol varchar [note: 'Exchange-specific trading symbol used to identify the REIT on the primary listing exchange.']
  total_cost_basis decimal(18,2) [note: 'Aggregate acquisition cost of the entire position in the position currency, including transaction costs if capitalized.']
  units_held decimal(18,4) [note: 'Total number of REIT shares or units currently held in the position, reflecting all purchases, sales, and corporate actions.']
  unrealized_gain_loss decimal(18,2) [note: 'Difference between current market value and total cost basis, representing mark-to-market profit or loss not yet realized through sale.']
  updated_timestamp timestamp [note: 'System timestamp recording the most recent modification to this REIT position record for audit and data lineage purposes.']
  valuation_date date [note: 'Date as of which the current market price and market value were determined for financial reporting and net asset value calculation.']
  weight_in_portfolio decimal(8,6) [note: 'Position market value as a percentage of total portfolio net asset value, used for asset allocation and risk monitoring.']
  weight_in_real_estate_allocation decimal(8,6) [note: 'Position market value as a percentage of the total real estate asset class allocation within the portfolio.']

  Note: 'Master record for listed REIT (Real Estate Investment Trust) positions held within the real estate allocation. Captures REIT name, ISIN, CUSIP, SEDOL, exchange, REIT sector (office, industrial, retail, residential, diversified, specialty), number of units'
}

Table realestate.re_fund_commitment {
  re_fund_commitment_id varchar [pk, note: 'Unique identifier for the real estate fund commitment record. Primary key.']
  custodian_id varchar [note: 'Reference to the custodian bank or fund administrator responsible for holding and administering the pension funds Limited Partner (LP) interest in the real estate fund.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) entity managing the real estate fund.']
  carried_interest_rate decimal(10,6) [note: 'Carried interest (carry) percentage that the General Partner (GP) receives on profits above the hurdle rate, typically 20% in real estate funds.']
  commitment_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to the real estate fund, representing the maximum callable capital over the funds life.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code in which the commitment amount is denominated.']
  commitment_date date [note: 'Date on which the pension fund formally committed capital to the real estate fund, typically the date the Limited Partnership Agreement (LPA) was executed.']
  commitment_number varchar [note: 'Externally-known unique identifier or reference number for this fund commitment, often assigned by the General Partner (GP) or internal deal tracking system.']
  commitment_status varchar [note: 'Current lifecycle status of the fund commitment indicating whether it is pending approval, active and callable, fully funded, partially funded, cancelled, or terminated.']
  created_timestamp timestamp [note: 'Timestamp when this commitment record was first created in the system.']
  distributions_received decimal(18,2) [note: 'Cumulative distributions received by the pension fund from the real estate fund, including both income distributions and capital returns.']
  dpi decimal(10,4) [note: 'Distributions to Paid-In (DPI) multiple, calculated as cumulative distributions received divided by Paid-In Capital (PIC), measuring realized returns.']
  esg_classification varchar [note: 'Sustainable Finance Disclosure Regulation (SFDR) classification of the real estate fund: Article 6 (no sustainability focus), Article 8 (promotes ESG characteristics), Article 9 (sustainable investment objective), or not classified.']
  expected_termination_date date [note: 'Projected date on which the real estate fund will terminate and complete all distributions, based on fund term and extension provisions.']
  extension_options_years varchar [note: 'Number of additional years the General Partner (GP) may extend the fund term beyond the initial term, subject to Limited Partner (LP) approval or consent thresholds.']
  final_close_date date [note: 'Date of the final capital close for the real estate fund, after which no additional Limited Partner (LP) commitments are accepted.']
  final_fund_size decimal(18,2) [note: 'Actual total capital commitments raised by the real estate fund at final close, representing the aggregate Limited Partner (LP) commitments.']
  first_close_date date [note: 'Date of the first capital close for the real estate fund, when the General Partner (GP) began accepting Limited Partner (LP) commitments and making investments.']
  fund_manager_name varchar [note: 'Name of the investment management firm or General Partner (GP) responsible for managing the real estate fund.']
  fund_strategy varchar [note: 'Investment strategy classification of the real estate fund indicating risk-return profile: core, core-plus, value-add, opportunistic, debt, open-end, or closed-end.']
  fund_term_years varchar [note: 'Total contractual term of the real estate fund in years, typically 10-12 years including investment period and harvest period, as specified in the Limited Partnership Agreement (LPA).']
  fund_type varchar [note: 'Structural classification of the real estate fund vehicle: commingled fund, separate account, club deal, joint venture, or fund-of-funds.']
  geographic_focus varchar [note: 'Primary geographic investment focus of the real estate fund, such as North America, Europe, Asia-Pacific, or specific countries/regions.']
  gresb_participation_flag boolean [note: 'Boolean indicator of whether the real estate fund participates in Global Real Estate Sustainability Benchmark (GRESB) reporting and assessment.']
  hurdle_rate decimal(10,6) [note: 'Preferred return threshold that Limited Partners (LPs) must achieve before the General Partner (GP) receives carried interest, typically 8% for real estate funds.']
  ic_approval_date date [note: 'Date on which the pension funds Investment Committee (IC) approved the commitment to the real estate fund.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) decision or Investment Memorandum (IM) that approved this commitment.']
  investment_period_years varchar [note: 'Duration in years during which the General Partner (GP) can make new investments, typically 3-5 years from first close.']
  irr decimal(10,4) [note: 'Internal Rate of Return (IRR) of the pension funds investment in the real estate fund, representing the annualized time-weighted return including all cash flows and current Net Asset Value (NAV).']
  key_person_clause_flag boolean [note: 'Boolean indicator of whether the Limited Partnership Agreement (LPA) includes a key person clause that suspends investment activity if designated key investment professionals leave the General Partner (GP).']
  last_valuation_date date [note: 'Date of the most recent Net Asset Value (NAV) valuation provided by the General Partner (GP) for the real estate fund.']
  management_fee_rate decimal(10,6) [note: 'Annual management fee rate charged by the General Partner (GP), expressed as a percentage of committed capital or Net Asset Value (NAV) depending on fund terms.']
  modified_timestamp timestamp [note: 'Timestamp when this commitment record was last modified or updated in the system.']
  most_favored_nation_flag boolean [note: 'Boolean indicator of whether the pension fund has Most Favored Nation (MFN) rights, entitling it to the most favorable terms granted to any other Limited Partner (LP).']
  nav decimal(18,2) [note: 'Current Net Asset Value (NAV) of the pension funds investment in the real estate fund, representing the fair market value of the Limited Partner (LP) interest.']
  ownership_percentage decimal(10,6) [note: 'Percentage ownership interest of the pension fund in the real estate fund, calculated as the pension funds commitment divided by final fund size.']
  pic decimal(18,2) [note: 'Cumulative amount of capital called and paid by the pension fund to the real estate fund to date, representing actual funded capital.']
  pri_signatory_flag boolean [note: 'Boolean indicator of whether the General Partner (GP) is a signatory to the United Nations Principles for Responsible Investment (PRI).']
  property_type_focus varchar [note: 'Primary property type or sector focus of the real estate fund, such as office, retail, industrial, multifamily, hospitality, healthcare, or mixed-use.']
  reporting_frequency varchar [note: 'Frequency at which the General Partner (GP) provides financial and operational reports to Limited Partners (LPs): monthly, quarterly, semi-annual, or annual.']
  rvpi decimal(10,4) [note: 'Residual Value to Paid-In (RVPI) multiple, calculated as Net Asset Value (NAV) divided by Paid-In Capital (PIC), measuring unrealized value remaining in the fund.']
  side_letter_flag boolean [note: 'Boolean indicator of whether the pension fund negotiated a side letter with the General Partner (GP) containing special terms, rights, or reporting requirements beyond the standard Limited Partnership Agreement (LPA).']
  target_fund_size decimal(18,2) [note: 'Total target capital raise for the real estate fund as stated in the Private Placement Memorandum (PPM), representing the General Partner (GP) fundraising goal.']
  tvpi decimal(10,4) [note: 'Total Value to Paid-In (TVPI) multiple, calculated as the sum of distributions received plus Net Asset Value (NAV) divided by Paid-In Capital (PIC), measuring total value creation.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future capital calls, calculated as commitment amount minus Paid-In Capital (PIC). Also known as dry powder.']
  vintage_year varchar [note: 'Year in which the real estate fund was established or began making investments, used for performance benchmarking and cohort analysis.']

  Note: 'Commitment records for real estate fund investments (closed-end real estate funds, open-end core funds, value-add funds, opportunistic funds) where the pension fund acts as an LP.'
}

Table realestate.re_capital_call {
  re_capital_call_id varchar [pk, note: 'Unique identifier for the real estate capital call transaction record.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Capital calls from RE funds must link to calling portfolio for liquidity management, funding coordination with treasury, and commitment utilization tracking.']
  re_fund_commitment_id varchar [note: 'Reference to the Limited Partnership Agreement (LPA) commitment against which this call is drawn.']
  acquisition_amount decimal(18,2) [note: 'Portion of the capital call allocated to property acquisition costs.']
  call_amount decimal(18,2) [note: 'Total amount requested from the Limited Partner (LP) in this capital call, denominated in the fund currency.']
  call_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the capital call amount.']
  call_due_date date [note: 'Date by which the Limited Partner (LP) must fund the capital call amount per the Limited Partnership Agreement (LPA).']
  call_notice_date date [note: 'Date on which the General Partner (GP) issued the capital call notice to Limited Partners (LPs).']
  call_notice_document_uri varchar [note: 'Document management system URI or path to the official capital call notice document issued by the General Partner (GP).']
  call_notice_number varchar [note: 'Unique business identifier assigned by the General Partner (GP) to this capital call notice.']
  call_purpose varchar [note: 'Primary purpose for which the capital is being called: property acquisition, capital expenditure, management fees, fund expenses, working capital, or mixed use.']
  call_status varchar [note: 'Current lifecycle status of the capital call transaction.']
  capex_amount decimal(18,2) [note: 'Portion of the capital call allocated to capital expenditure programs for post-acquisition value creation.']
  commitment_percentage_called decimal(5,2) [note: 'Percentage of the total Limited Partnership Agreement (LPA) commitment that will be called after this capital call is funded.']
  created_timestamp timestamp [note: 'Timestamp when this capital call record was first created in the system.']
  cumulative_pic_post_call decimal(18,2) [note: 'Total Paid-In Capital (PIC) from the Limited Partner (LP) to the fund after this capital call is funded.']
  cumulative_pic_pre_call decimal(18,2) [note: 'Total Paid-In Capital (PIC) from the Limited Partner (LP) to the fund immediately before this capital call.']
  default_interest_accrued decimal(18,2) [note: 'Total default interest accrued on this capital call due to late or partial funding.']
  default_interest_rate decimal(5,4) [note: 'Annual interest rate applied to late or unfunded capital call amounts per the Limited Partnership Agreement (LPA), expressed as a decimal.']
  fund_expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to fund-level operating expenses.']
  funded_amount decimal(18,2) [note: 'Actual amount funded by the Limited Partner (LP) in response to this capital call.']
  funded_date date [note: 'Date on which the Limited Partner (LP) transferred funds to the General Partner (GP) for this capital call.']
  fx_rate decimal(12,6) [note: 'Foreign exchange rate applied if the Limited Partner (LP) funded in a currency different from the fund currency.']
  fx_rate_date date [note: 'Date on which the foreign exchange rate was determined for currency conversion.']
  gp_bank_account_number varchar [note: 'Bank account number of the General Partner (GP) receiving the capital call funds.']
  gp_bank_bic varchar [note: 'Bank Identifier Code (BIC) or SWIFT code for the General Partner (GP) receiving bank.']
  gp_bank_name varchar [note: 'Name of the financial institution holding the General Partner (GP) receiving account.']
  gp_contact_email varchar [note: 'Email address of the General Partner (GP) representative for inquiries regarding this capital call.']
  gp_contact_name varchar [note: 'Name of the General Partner (GP) representative responsible for this capital call.']
  internal_approval_date date [note: 'Date on which internal approval was granted to fund this capital call.']
  internal_approver_name varchar [note: 'Name of the internal pension fund officer who approved funding this capital call.']
  last_modified_timestamp timestamp [note: 'Timestamp when this capital call record was last updated in the system.']
  management_fee_amount decimal(18,2) [note: 'Portion of the capital call allocated to General Partner (GP) management fees.']
  notes varchar [note: 'Free-text notes or comments regarding this capital call transaction, including any special instructions or exceptions.']
  other_amount decimal(18,2) [note: 'Portion of the capital call allocated to purposes not classified in standard categories.']
  payment_reference_number varchar [note: 'Bank or treasury system reference number for the wire transfer or payment transaction funding this capital call.']
  settlement_account_number varchar [note: 'Bank account number used by the Limited Partner (LP) to settle this capital call payment.']
  working_capital_amount decimal(18,2) [note: 'Portion of the capital call allocated to property-level working capital requirements.']

  Note: 'Capital call (drawdown) transaction records issued by real estate fund GPs to the pension fund as LP. Captures call notice date, due date, call amount, call purpose (acquisition, capex, fees, expenses), cumulative paid-in capital post-call, fund'
}

Table realestate.re_distribution {
  re_distribution_id varchar [pk, note: 'Unique identifier for the real estate distribution transaction record.']
  cash_account_id varchar [note: 'Reference to the custodian bank account into which the distribution cash was settled.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity that issued this distribution.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: RE fund distributions flow to specific portfolios for cash management, reinvestment decisions, and performance attribution.']
  re_fund_commitment_id varchar [note: 'Reference to the underlying real estate fund investment position from which this distribution originated.']
  re_fund_investment_id varchar [note: 'Reference to the underlying real estate fund investment position from which this distribution originated.']
  underlying_property_id varchar [note: 'Reference to the specific real estate property asset that generated this distribution, if attributable.']
  accounting_period varchar [note: 'The accounting period (YYYY-MM or YYYY-QN) to which this distribution is allocated for financial reporting.']
  announcement_date date [note: 'The date on which the GP formally announced or notified the distribution to limited partners.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the pension fund\'s base reporting currency.']
  capital_gain_component decimal(18,2) [note: 'The portion of the distribution classified as capital gains for tax reporting purposes.']
  carried_interest_component decimal(18,2) [note: 'The portion of the distribution representing carried interest or performance fees paid to the GP.']
  created_timestamp timestamp [note: 'The timestamp when this distribution record was first created in the system.']
  data_source_system varchar [note: 'The operational system or data feed from which this distribution record was sourced.']
  distribution_amount_base decimal(18,2) [note: 'The gross distribution amount converted to the pension fund\'s base reporting currency (typically USD).']
  distribution_amount_local decimal(18,2) [note: 'The gross distribution amount in the fund\'s local reporting currency before any withholding or adjustments.']
  distribution_date date [note: 'The date on which the distribution was paid or is scheduled to be paid by the GP to the LP.']
  distribution_notes varchar [note: 'Free-text commentary from the GP or internal investment team regarding the distribution context or special circumstances.']
  distribution_notice_number varchar [note: 'External reference number assigned by the GP on the distribution notice or capital account statement.']
  distribution_per_unit decimal(18,6) [note: 'The distribution amount per LP unit or per share of fund ownership.']
  distribution_sequence_number varchar [note: 'Sequential numbering of distributions from this fund investment for tracking and reconciliation purposes.']
  distribution_source varchar [note: 'The underlying economic event or transaction that generated this distribution.']
  distribution_status varchar [note: 'Current lifecycle status of the distribution transaction from announcement through settlement.']
  distribution_type varchar [note: 'Classification of the distribution according to its economic nature and tax treatment.']
  dpi_impact decimal(8,4) [note: 'The incremental impact of this distribution on the DPI multiple for the fund investment.']
  fx_rate decimal(12,6) [note: 'The exchange rate applied to convert local currency distribution amount to base currency.']
  hurdle_rate_met_flag boolean [note: 'Indicates whether the preferred return hurdle rate threshold has been met, triggering carried interest participation.']
  income_component decimal(18,2) [note: 'The portion of the distribution classified as ordinary income for tax and accounting purposes.']
  irr_contribution decimal(8,4) [note: 'The contribution of this distribution to the cumulative IRR calculation for the fund investment, expressed as a percentage.']
  k1_schedule_reference varchar [note: 'Reference to the IRS Schedule K-1 or equivalent tax document line item associated with this distribution.']
  local_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the fund\'s local reporting currency.']
  modified_timestamp timestamp [note: 'The timestamp when this distribution record was last modified or updated.']
  nav_impact_amount decimal(18,2) [note: 'The impact of this distribution on the fund investment\'s Net Asset Value for valuation purposes.']
  net_distribution_amount decimal(18,2) [note: 'The net cash amount received by the LP after all withholdings and adjustments.']
  reconciliation_status varchar [note: 'Status of reconciliation between GP notice, custodian cash receipt, and internal accounting records.']
  record_date date [note: 'The date on which LP ownership is determined for eligibility to receive the distribution.']
  reinvestment_flag boolean [note: 'Indicates whether this distribution was automatically reinvested into the fund per the LPA or LP election.']
  return_of_capital_component decimal(18,2) [note: 'The portion of the distribution representing a return of the LP\'s original invested capital.']
  settlement_date date [note: 'The actual date on which cash was received in the LP custodian account.']
  tax_year varchar [note: 'The fiscal or calendar year to which this distribution is allocated for tax reporting purposes.']
  units_held decimal(18,6) [note: 'The number of LP units or shares held by the pension fund on the record date.']
  waterfall_tier varchar [note: 'The distribution waterfall tier or tranche from which this distribution was paid per the LPA.']
  withholding_tax_amount decimal(18,2) [note: 'Total tax withheld at source by the GP or underlying jurisdictions on the distribution.']

  Note: 'Distribution transaction records received from real estate fund GPs representing return of capital, income distributions, and carried interest waterfalls. Captures distribution date, distribution type (income, return of capital, recapitalisation, carried'
}

Table realestate.property_acquisition {
  property_acquisition_id varchar [pk, note: 'Unique identifier for each direct property acquisition transaction executed by the pension fund.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Acquisition settlement is paid from a specific cash account; the pension fund tracks the source account for accounting and reconciliation.']
  contributor_pool_id varchar [note: 'Foreign key linking to beneficiary.contributor_pool. Business justification: During a property acquisition, the acquisition is funded by a specific contributor pool, which must be tracked to allocate capital and calculate contribution rates.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: The acquisition decision is driven by the due diligence engagement that produced findings; linking acquisition to dd_engagement_id allows tracking of the engagement that justified the']
  deal_opportunity_id varchar [note: 'Reference to the origination deal pipeline record that led to this acquisition.']
  employee_id varchar [note: 'Reference to the internal or external asset manager responsible for post-acquisition management.']
  gp_profile_id varchar [note: 'Reference to the internal or external asset manager responsible for post-acquisition management.']
  opportunity_id varchar [note: 'Reference to the origination deal pipeline record that led to this acquisition.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Direct property acquisitions must specify target portfolio for allocation tracking, mandate compliance verification, and performance attribution.']
  property_id varchar [note: 'Reference to the underlying real estate asset acquired in this transaction.']
  seller_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Acquisition records need to reference the seller entity for audit and regulatory reporting; linking to actor provides a structured reference.']
  acquisition_date date [note: 'The date on which legal title to the property was transferred to the pension fund.']
  acquisition_notes varchar [note: 'Free-text field capturing additional context, conditions, or observations about the acquisition.']
  acquisition_status varchar [note: 'Current lifecycle status of the acquisition transaction.']
  acquisition_strategy varchar [note: 'Risk-return classification of the acquisition strategy employed.']
  acquisition_structure varchar [note: 'Legal structure through which the property was acquired.']
  acquisition_yield decimal(5,2) [note: 'Initial yield calculated as first-year NOI divided by total acquisition cost, expressed as a percentage.']
  advisory_fees decimal(18,2) [note: 'Investment advisory, brokerage, and consulting fees paid for the acquisition.']
  cap_rate decimal(5,2) [note: 'Market capitalization rate at acquisition representing NOI divided by purchase price.']
  co_investor_flag boolean [note: 'Indicates whether the acquisition was executed with one or more co-investment partners.']
  completion_date date [note: 'Date on which all conditions precedent were satisfied and the transaction legally completed.']
  created_timestamp timestamp [note: 'System timestamp when the acquisition record was first created in the data platform.']
  debt_amount decimal(18,2) [note: 'Portion of the acquisition financed through debt or leverage.']
  due_diligence_costs decimal(18,2) [note: 'Total costs incurred for operational, financial, legal, and ESG due diligence activities.']
  environmental_risk_description varchar [note: 'Narrative description of any environmental risks identified during acquisition due diligence.']
  environmental_risk_flag boolean [note: 'Indicates whether material environmental risks were identified during due diligence.']
  equity_amount decimal(18,2) [note: 'Portion of the acquisition financed through pension fund equity capital.']
  esg_rating_at_acquisition varchar [note: 'ESG rating or score assigned to the property at acquisition based on due diligence assessment.']
  going_in_irr decimal(5,2) [note: 'Projected internal rate of return at acquisition based on underwriting assumptions.']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved the acquisition.']
  ic_approval_reference varchar [note: 'Reference number of the Investment Committee approval decision or memorandum.']
  legal_fees decimal(18,2) [note: 'Legal advisory and conveyancing fees incurred in the acquisition transaction.']
  loi_date date [note: 'Date on which the non-binding Letter of Intent was executed with the seller.']
  ltv_ratio decimal(5,2) [note: 'Debt amount divided by property value at acquisition, expressed as a percentage.']
  noi_at_acquisition decimal(18,2) [note: 'Trailing twelve-month Net Operating Income at the time of acquisition.']
  occupancy_rate_at_acquisition decimal(5,2) [note: 'Physical occupancy rate of the property at the time of acquisition, expressed as a percentage.']
  other_transaction_costs decimal(18,2) [note: 'Miscellaneous acquisition costs not captured in other specific cost categories.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership stake held by the pension fund in the acquired property.']
  portfolio_allocation varchar [note: 'Strategic portfolio segment or sleeve to which this acquisition is allocated.']
  property_city varchar [note: 'City or metropolitan area where the property is located.']
  property_country varchar [note: 'Three-letter ISO country code where the property is located.']
  property_sector varchar [note: 'Primary real estate sector classification of the acquired property.']
  purchase_price decimal(18,2) [note: 'Total consideration paid for the property acquisition excluding transaction costs.']
  seller_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the seller if applicable.']
  seller_name varchar [note: 'Legal name of the entity or individual from whom the property was acquired.']
  spa_date date [note: 'Date on which the binding Share Purchase Agreement or Sale and Purchase Agreement was signed.']
  stamp_duty decimal(18,2) [note: 'Government stamp duty or transfer tax paid on the property acquisition.']
  target_hold_period_years varchar [note: 'Planned investment horizon in years from acquisition to anticipated disposition.']
  total_acquisition_cost decimal(18,2) [note: 'Sum of purchase price and all transaction costs representing total capital deployed.']
  transaction_currency varchar [note: 'Three-letter ISO 4217 currency code in which the acquisition was denominated.']
  transaction_reference varchar [note: 'External business identifier for the acquisition transaction used in legal documents and reporting.']
  updated_timestamp timestamp [note: 'System timestamp when the acquisition record was last modified in the data platform.']

  Note: 'Transaction record for each direct property acquisition executed by the pension fund. Captures acquisition date, purchase price, transaction costs (stamp duty, legal, advisory), financing structure (equity/debt split), acquisition yield (initial yield'
}

Table realestate.property_disposal {
  property_disposal_id varchar [pk, note: 'Unique identifier for each property disposal transaction executed by the pension fund.']
  buyer_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Disposal transactions require a buyer entity for financial reconciliation and compliance; linking to actor ensures traceability.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Disposal proceeds are credited to a cash account; linking enables tracking of cash inflows and reconciliation with treasury records.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: The disposal decision is based on the due diligence engagement that assessed the property; linking disposal to dd_engagement_id enables audit of the engagement that informed the sale.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Property dispositions must reference owning portfolio for realized gain/loss attribution, rebalancing trigger assessment, and GIPS-compliant performance reporting.']
  property_id varchar [note: 'Reference to the direct property asset being disposed.']
  advisor_firm_name varchar [note: 'Name of the external advisory firm engaged to support the disposal transaction.']
  book_value_at_disposal decimal(18,2) [note: 'Carrying value of the property on the balance sheet at the disposal date per accounting records.']
  buyer_legal_name varchar [note: 'Full legal name of the acquiring party or buyer entity.']
  buyer_lei varchar [note: 'Twenty-character ISO 17442 Legal Entity Identifier (LEI) of the buyer.']
  buyer_type varchar [note: 'Classification of the buyer entity by investor type.']
  capital_gains_tax_amount decimal(18,2) [note: 'Estimated or actual capital gains tax liability arising from the disposal transaction.']
  contract_signing_date date [note: 'Date when the Share Purchase Agreement (SPA) or sale contract was executed.']
  created_timestamp timestamp [note: 'Timestamp when the disposal record was first created in the system.']
  disposal_date date [note: 'Legal completion date when ownership transferred to the buyer and proceeds were received.']
  disposal_notes varchar [note: 'Free-text field capturing additional context, special conditions, or commentary on the disposal transaction.']
  disposal_rationale varchar [note: 'Strategic business rationale for disposing of the property including portfolio rebalancing, capital recycling, or underperformance.']
  disposal_status varchar [note: 'Current lifecycle status of the disposal transaction.']
  disposal_transaction_number varchar [note: 'Externally-known unique transaction reference number for the disposal event.']
  disposal_type varchar [note: 'Classification of the disposal transaction structure.']
  escrow_account_flag boolean [note: 'Indicates whether an escrow account was used to hold proceeds pending final settlement conditions.']
  exit_cap_rate decimal(5,4) [note: 'Capitalization rate implied by the sale price calculated as Net Operating Income (NOI) divided by gross sale price.']
  exit_noi decimal(18,2) [note: 'Trailing twelve-month Net Operating Income (NOI) at the time of disposal used for exit cap rate calculation.']
  gross_sale_price decimal(18,2) [note: 'Total sale price agreed before deducting transaction costs and adjustments.']
  holding_period_years decimal(5,2) [note: 'Total number of years the property was held from acquisition to disposal.']
  ic_approval_date date [note: 'Date when the Investment Committee (IC) approved the disposal transaction.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) approval decision.']
  irr decimal(7,4) [note: 'Internal Rate of Return (IRR) achieved on the investment from acquisition through disposal including all cash flows.']
  legal_counsel_firm_name varchar [note: 'Name of the law firm providing legal counsel for the disposal transaction.']
  moic decimal(5,2) [note: 'Multiple on Invested Capital (MOIC) calculated as total value realized divided by total capital invested.']
  net_proceeds decimal(18,2) [note: 'Net cash proceeds received after deducting all transaction costs from gross sale price.']
  realized_gain_loss decimal(18,2) [note: 'Realized gain or loss calculated as net proceeds minus book value at disposal.']
  settlement_method varchar [note: 'Method used to settle the disposal transaction and transfer proceeds.']
  tax_jurisdiction varchar [note: 'Three-letter ISO country code representing the primary tax jurisdiction for the disposal transaction.']
  transaction_costs decimal(18,2) [note: 'Total costs incurred to execute the disposal including legal, advisory, brokerage, and due diligence fees.']
  transaction_currency varchar [note: 'Three-letter ISO 4217 currency code in which the disposal transaction was denominated.']
  updated_timestamp timestamp [note: 'Timestamp when the disposal record was last modified in the system.']
  withholding_tax_amount decimal(18,2) [note: 'Withholding tax deducted at source by the buyer or intermediary per local tax regulations.']

  Note: 'Transaction record for each direct property disposal (sale, partial sale, recapitalisation) executed by the pension fund. Captures disposal date, gross sale price, transaction costs, net proceeds, book value at disposal, realised gain/loss, exit cap rate'
}

Table realestate.occupancy_record {
  occupancy_record_id varchar [pk, note: 'Unique identifier for the occupancy measurement record.']
  property_id varchar [note: 'Reference to the real estate property being measured.']
  absorption_rate decimal(18,2) [note: 'Net change in occupied space during the measurement period, expressed in area units.']
  area_unit varchar [note: 'Unit of measure for area calculations (square feet or square meters).']
  average_tenant_size decimal(18,2) [note: 'Average GLA per tenant, calculated as total occupied GLA divided by tenant count.']
  created_timestamp timestamp [note: 'Timestamp when the occupancy record was first created in the system.']
  data_source varchar [note: 'Source system or platform from which occupancy data was extracted (e.g., property management system, lease administration system).']
  economic_occupancy_rate decimal(5,4) [note: 'Percentage of potential rental income being collected, accounting for rent concessions and free rent periods.']
  largest_tenant_gla decimal(18,2) [note: 'GLA occupied by the largest single tenant, used for concentration risk assessment.']
  lease_expiry_exposure_12m decimal(18,2) [note: 'Total GLA with leases expiring within the next 12 months from measurement date.']
  lease_expiry_exposure_24m decimal(18,2) [note: 'Total GLA with leases expiring within the next 24 months from measurement date.']
  leasing_velocity decimal(18,2) [note: 'Total GLA leased during the measurement period, indicating leasing activity momentum.']
  market_occupancy_rate decimal(5,4) [note: 'Average occupancy rate for comparable properties in the same submarket as of the measurement date.']
  measurement_date date [note: 'The date on which the occupancy measurement was taken.']
  measurement_method varchar [note: 'Method used to determine occupancy: actual (physical inspection), estimated (based on lease data), or prorated (partial period calculation).']
  measurement_period varchar [note: 'The reporting period for this occupancy measurement (e.g., 2024-Q1, 2024-03).']
  measurement_status varchar [note: 'Status of the occupancy measurement record in the reporting workflow.']
  notes varchar [note: 'Free-text notes providing additional context, explanations for variances, or special circumstances affecting occupancy.']
  occupancy_trend varchar [note: 'Directional trend of occupancy over recent measurement periods.']
  occupancy_variance_pct decimal(7,4) [note: 'Variance between actual physical occupancy rate and target occupancy rate, expressed as a percentage.']
  occupied_gla decimal(18,2) [note: 'Gross leasable area currently occupied by tenants in square feet or square meters.']
  physical_occupancy_rate decimal(5,4) [note: 'Percentage of total GLA that is physically occupied, calculated as occupied GLA divided by total GLA.']
  prior_period_occupancy_rate decimal(5,4) [note: 'Physical occupancy rate from the previous measurement period for trend analysis.']
  renewal_rate decimal(5,4) [note: 'Percentage of expiring leases that were renewed during the measurement period.']
  stabilized_occupancy_flag boolean [note: 'Indicates whether the property has reached stabilized occupancy levels as defined in the investment underwriting.']
  stabilized_occupancy_target decimal(5,4) [note: 'Target occupancy rate defined at acquisition or development completion for stabilized operations.']
  tenant_count varchar [note: 'Number of active tenants occupying space as of the measurement date.']
  top_five_tenant_concentration decimal(5,4) [note: 'Percentage of total GLA occupied by the five largest tenants.']
  total_gla decimal(18,2) [note: 'Total gross leasable area of the property in square feet or square meters.']
  total_unit_count varchar [note: 'Total number of leasable units or spaces in the property.']
  turnover_rate decimal(5,4) [note: 'Percentage of GLA that experienced tenant turnover during the measurement period.']
  updated_timestamp timestamp [note: 'Timestamp when the occupancy record was last modified.']
  vacancy_type varchar [note: 'Classification of vacancy: structural (long-term market condition), transitional (between tenants), development (pre-lease), seasonal, strategic (held for repositioning), or frictional (normal turnover).']
  vacant_gla decimal(18,2) [note: 'Gross leasable area currently vacant in square feet or square meters.']
  vacant_unit_count varchar [note: 'Number of leasable units or spaces that are currently vacant.']
  verification_date date [note: 'Date on which the occupancy data was verified and approved for reporting.']
  verified_by varchar [note: 'Name or identifier of the asset manager or analyst who verified the occupancy data.']
  weighted_average_lease_term decimal(8,2) [note: 'Weighted average remaining lease term across all tenants, weighted by GLA, expressed in years.']

  Note: 'Periodic occupancy and vacancy tracking records at the property and tenancy level. Captures measurement date, total GLA, occupied GLA, vacant GLA, physical occupancy rate, economic occupancy rate, vacancy type (structural, transitional, development)'
}

Table realestate.property_operating_expense {
  property_operating_expense_id varchar [pk, note: 'Unique identifier for the property operating expense record.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Operating expense payments are executed from a cash account; the link supports expense accounting and cash flow management.']
  noi_record_id varchar [note: 'Reference to the NOI record into which this expense rolls up for property-level income calculation.']
  property_id varchar [note: 'Reference to the property for which this operating expense was incurred.']
  realestate_capex_program_id varchar [note: 'Reference to the capital expenditure project if this expense is part of a larger capital improvement or value creation program.']
  vendor_id varchar [note: 'Unique identifier for the vendor in the vendor master data system.']
  accounting_period varchar [note: 'The accounting period (YYYY-MM format) to which this operating expense is allocated for financial reporting and NOI calculation.']
  approval_date date [note: 'The date on which this operating expense was approved for payment.']
  approval_status varchar [note: 'Current approval status of the operating expense in the expense management workflow.']
  approved_by varchar [note: 'Name or identifier of the individual who approved this operating expense for payment.']
  base_currency_amount decimal(18,2) [note: 'The operating expense amount converted to the funds base reporting currency for consolidated financial reporting.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 code for the funds base reporting currency.']
  budget_line_item varchar [note: 'The budget line item or category against which this operating expense is tracked for variance analysis.']
  budgeted_amount decimal(18,2) [note: 'The budgeted or forecasted amount for this expense category in the accounting period, used for variance analysis.']
  capitalized_flag boolean [note: 'Indicates whether this expense qualifies for capitalization as a capital expenditure rather than an operating expense under accounting standards.']
  cost_center varchar [note: 'The cost center or business unit responsible for managing and tracking this operating expense.']
  created_timestamp timestamp [note: 'The timestamp when this operating expense record was first created in the system.']
  expense_amount decimal(18,2) [note: 'The gross amount of the operating expense before any adjustments, discounts, or recoveries.']
  expense_category varchar [note: 'Classification of the operating expense type: property tax, insurance, utilities, maintenance, cleaning, security, management fee, or leasing commission. [ENUM-REF-CANDIDATE']
  expense_currency varchar [note: 'Three-letter ISO 4217 currency code in which the operating expense was incurred.']
  expense_date date [note: 'The date on which the operating expense was incurred or recognized for accounting purposes.']
  expense_subcategory varchar [note: 'Detailed subcategory within the primary expense category for granular expense tracking and analysis.']
  fiscal_quarter varchar [note: 'The fiscal quarter (Q1, Q2, Q3, Q4) to which this operating expense is allocated for quarterly performance reporting.']
  fiscal_year varchar [note: 'The fiscal year to which this operating expense belongs for annual financial reporting and budgeting purposes.']
  fx_rate decimal(12,6) [note: 'The exchange rate applied to convert the expense amount from transaction currency to base currency.']
  gl_account_code varchar [note: 'The general ledger account code to which this operating expense is posted in the accounting system.']
  invoice_date date [note: 'The date the vendor issued the invoice for this operating expense.']
  invoice_number varchar [note: 'The invoice or billing reference number provided by the vendor for this expense transaction.']
  net_expense_amount decimal(18,2) [note: 'The net operating expense after deducting any recoverable amounts from tenants, representing the true cost to the property owner.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to this operating expense for audit trail and operational reference.']
  payment_date date [note: 'The actual date on which payment was made to the vendor for this operating expense.']
  payment_due_date date [note: 'The date by which payment for this operating expense is due to the vendor.']
  payment_method varchar [note: 'The payment instrument or method used to settle this operating expense with the vendor.']
  payment_reference varchar [note: 'The payment transaction reference number or confirmation code from the treasury or payment system.']
  property_operating_expense_description varchar [note: 'Detailed narrative description of the operating expense, including the nature of the goods or services provided.']
  recoverable_amount decimal(18,2) [note: 'The portion of the operating expense that is recoverable from tenants, reducing the net expense impact on NOI.']
  recoverable_flag boolean [note: 'Indicates whether this operating expense is recoverable from tenants through lease agreements or operating expense pass-throughs.']
  tax_treatment varchar [note: 'The tax treatment classification of this operating expense for income tax reporting purposes.']
  updated_timestamp timestamp [note: 'The timestamp when this operating expense record was last modified or updated in the system.']
  variance_amount decimal(18,2) [note: 'The difference between the actual expense amount and the budgeted amount, indicating over or under budget performance.']
  variance_percentage decimal(5,2) [note: 'The variance expressed as a percentage of the budgeted amount, providing a normalized measure of budget performance.']
  vat_amount decimal(18,2) [note: 'The value-added tax or goods and services tax component included in the operating expense amount.']
  vat_rate decimal(5,2) [note: 'The VAT or GST rate percentage applied to this operating expense.']
  vendor_name varchar [note: 'Name of the vendor or service provider who supplied the goods or services for this operating expense.']

  Note: 'Detailed operating-expense line records that roll up into the property-level NOI ledger (noi_record). Captures expense date, category (property tax, insurance, utilities, maintenance, cleaning, security, management fee, leasing commission), vendor'
}

Table realestate.jv_structure {
  jv_structure_id varchar [pk, note: 'Unique identifier for the joint venture structure record.']
  property_id varchar [note: 'Reference to the property held through this joint venture structure.']
  accounting_method varchar [note: 'Accounting treatment applied to the joint venture investment: equity method, proportionate consolidation, cost method, or full consolidation.']
  audit_firm_name varchar [note: 'Name of the external audit firm responsible for auditing the joint venture\'s financial statements.']
  carried_interest_rate_pct decimal(5,2) [note: 'Carried interest (carry) percentage allocated to the General Partner upon exceeding the hurdle rate.']
  control_classification varchar [note: 'Classification of the pension fund\'s level of control or influence over the joint venture: controlled (consolidate), joint control (equity method), significant influence (equity method), or no control.']
  created_timestamp timestamp [note: 'Timestamp when this joint venture structure record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the joint venture\'s functional currency.']
  distribution_waterfall_type varchar [note: 'Type of distribution waterfall structure governing profit distributions: European (whole-fund), American (deal-by-deal), or hybrid.']
  effective_date date [note: 'Date when the joint venture arrangement became effective and operational.']
  esg_policy_flag boolean [note: 'Indicates whether the joint venture has adopted formal Environmental, Social, and Governance policies.']
  extension_options_count varchar [note: 'Number of extension options available to extend the joint venture term beyond the initial period.']
  formation_date date [note: 'Date when the joint venture entity was legally formed or incorporated.']
  fund_term_years varchar [note: 'Total term of the joint venture fund in years, including any extension periods.']
  gp_name varchar [note: 'Name of the General Partner managing the joint venture, if applicable.']
  gp_ownership_pct decimal(5,2) [note: 'Percentage ownership stake held by the General Partner in the joint venture entity.']
  hurdle_rate_pct decimal(5,2) [note: 'Preferred return threshold (hurdle rate) that must be achieved before carried interest is paid to the General Partner.']
  investment_period_end_date date [note: 'Date when the investment period for the joint venture concludes.']
  investment_strategy varchar [note: 'Investment strategy or mandate of the joint venture (e.g., core, core-plus, value-add, opportunistic).']
  jurisdiction varchar [note: 'Legal jurisdiction or country where the joint venture entity is registered and governed.']
  jv_arrangement_type varchar [note: 'Classification of the joint arrangement: joint operation (rights to assets and obligations for liabilities), joint venture (rights to net assets), or co-investment.']
  jv_entity_code varchar [note: 'Internal code or identifier for the joint venture entity.']
  jv_entity_name varchar [note: 'Legal name of the joint venture entity or partnership vehicle.']
  jv_status varchar [note: 'Current lifecycle status of the joint venture arrangement.']
  last_audit_date date [note: 'Date of the most recent external audit of the joint venture.']
  legal_structure_type varchar [note: 'Legal form of the joint venture entity (Limited Partnership, Limited Liability Company, Trust, Real Estate Investment Trust, Corporation, Partnership).']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the joint venture entity, enabling global identification.']
  lpa_execution_date date [note: 'Date when the Limited Partnership Agreement was executed by all parties.']
  lpa_reference varchar [note: 'Reference identifier or document number for the Limited Partnership Agreement governing the joint venture.']
  management_fee_rate_pct decimal(5,2) [note: 'Annual management fee rate charged by the General Partner or asset manager, expressed as a percentage of committed capital or Net Asset Value.']
  notes varchar [note: 'Additional notes, comments, or contextual information about the joint venture structure.']
  pension_fund_capital_commitment decimal(18,2) [note: 'Total capital commitment amount by the pension fund to the joint venture.']
  pension_fund_ownership_pct decimal(5,2) [note: 'Percentage ownership stake held by the pension fund in the joint venture entity.']
  pension_fund_paid_in_capital decimal(18,2) [note: 'Actual capital contributed by the pension fund to date (Paid-In Capital).']
  pri_signatory_flag boolean [note: 'Indicates whether the joint venture or its General Partner is a signatory to the UN Principles for Responsible Investment.']
  primary_co_investor_name varchar [note: 'Name of the primary co-investor or partner in the joint venture.']
  primary_co_investor_ownership_pct decimal(5,2) [note: 'Percentage ownership stake held by the primary co-investor in the joint venture entity.']
  primary_co_investor_type varchar [note: 'Classification of the primary co-investor by investor type.']
  reporting_frequency varchar [note: 'Frequency at which the joint venture provides financial and operational reports to investors.']
  target_irr_pct decimal(5,2) [note: 'Target Internal Rate of Return for the joint venture investment.']
  target_moic decimal(5,2) [note: 'Target Multiple on Invested Capital for the joint venture investment.']
  tax_identification_number varchar [note: 'Tax identification number or employer identification number for the joint venture entity.']
  termination_date date [note: 'Date when the joint venture arrangement was terminated or dissolved, if applicable.']
  total_co_investors_count varchar [note: 'Total number of co-investors or partners in the joint venture structure.']
  updated_timestamp timestamp [note: 'Timestamp when this joint venture structure record was last updated in the system.']
  valuation_frequency varchar [note: 'Frequency at which the joint venture\'s assets are formally valued.']

  Note: 'Joint venture (JV) and co-investment structure records for properties held through partnership vehicles. Captures JV entity name, legal structure (LP, LLC, trust, REIT), pension fund ownership percentage, co-investor identities and ownership percentages'
}

Table realestate.property_insurance {
  property_insurance_id varchar [pk, note: 'Unique identifier for the property insurance policy record.']
  property_id varchar [note: 'Reference to the real estate property asset covered by this insurance policy.']
  additional_insured_parties varchar [note: 'Other parties named on the policy who are entitled to coverage benefits, such as property managers or co-investors.']
  aggregate_limit decimal(18,2) [note: 'Maximum total amount the insurer will pay for all covered losses during the policy period, capping total exposure.']
  annual_premium decimal(18,2) [note: 'Total annual cost paid to the insurer for maintaining coverage, used for budgeting and expense allocation.']
  approval_date date [note: 'Date when the insurance policy was formally approved by internal governance for execution.']
  approved_by varchar [note: 'Name or identifier of the internal authority who approved the insurance policy purchase and terms.']
  broker_name varchar [note: 'Name of the insurance broker or intermediary who arranged the policy on behalf of the pension fund.']
  cancellation_notice_days varchar [note: 'Number of days advance notice required by either party to cancel the policy per contractual terms.']
  cancellation_reason varchar [note: 'Documented reason for policy cancellation if status is cancelled, required for audit and compliance reporting.']
  certificate_of_insurance_reference varchar [note: 'Reference to the certificate of insurance document provided as proof of coverage to third parties.']
  claims_history_summary varchar [note: 'Summary of prior insurance claims filed against this property impacting underwriting and premium pricing.']
  claims_made_basis_flag boolean [note: 'Indicates whether the policy covers claims made during the policy period versus occurrence-based coverage.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of loss shared between the insured and insurer after deductible, typically expressed as a ratio.']
  coverage_description varchar [note: 'Detailed narrative describing the specific risks covered, exclusions, and special conditions of the insurance policy.']
  coverage_limit decimal(18,2) [note: 'Maximum amount the insurer will pay for a covered loss under this policy, defining the upper bound of risk transfer.']
  coverage_type varchar [note: 'Primary category of insurance coverage provided by this policy for risk classification and portfolio management. [ENUM-REF-CANDIDATE: property_damage|liability|business_interruption|environmental|flood|earthquake|terrorism — 7 candidates stripped; promote']
  created_timestamp timestamp [note: 'System timestamp when this insurance policy record was first created in the data platform for audit trail purposes.']
  deductible_amount decimal(18,2) [note: 'Amount the pension fund must pay out-of-pocket before insurance coverage applies, impacting net risk exposure.']
  endorsements varchar [note: 'Amendments or riders attached to the base policy that modify coverage terms, limits, or conditions.']
  exclusions varchar [note: 'Specific perils, conditions, or circumstances explicitly excluded from coverage under this insurance policy.']
  expiry_date date [note: 'Date when the insurance coverage terminates unless renewed, critical for risk management and renewal planning.']
  inception_date date [note: 'Date when the insurance coverage becomes effective and risk transfer begins.']
  insured_value decimal(18,2) [note: 'Maximum amount of coverage provided by the policy representing the replacement cost or agreed value of the property asset.']
  insurer_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the insurance carrier enabling global counterparty identification.']
  insurer_name varchar [note: 'Legal name of the insurance company providing coverage for the property asset.']
  last_inspection_date date [note: 'Date of the most recent property inspection conducted by the insurer for underwriting or renewal purposes.']
  loss_payee varchar [note: 'Entity designated to receive insurance proceeds in the event of a covered loss, often a lender or mortgagee.']
  loss_ratio_percent decimal(5,2) [note: 'Ratio of claims paid to premiums collected expressed as a percentage, indicating policy profitability for the insurer.']
  next_inspection_due_date date [note: 'Scheduled date for the next required property inspection to maintain coverage compliance.']
  notes varchar [note: 'Free-form text field for additional comments, special conditions, or operational notes regarding the insurance policy.']
  payment_frequency varchar [note: 'Frequency at which premium payments are made to the insurer for cash flow planning and treasury management.']
  per_occurrence_limit decimal(18,2) [note: 'Maximum amount the insurer will pay for a single covered loss event, defining per-incident exposure.']
  policy_document_reference varchar [note: 'Reference identifier or file path to the complete insurance policy document for audit and compliance purposes.']
  policy_number varchar [note: 'Unique policy number assigned by the insurance carrier for identification and claims processing.']
  policy_status varchar [note: 'Current state of the insurance policy in its lifecycle for risk monitoring and compliance tracking.']
  policy_term_months varchar [note: 'Duration of the insurance policy coverage period in months, typically 12 for annual policies.']
  premium_currency_code varchar [note: 'ISO 4217 three-letter currency code for the premium and insured value amounts enabling multi-currency portfolio management.']
  renewal_date date [note: 'Scheduled date for policy renewal negotiation and premium renegotiation with the insurer.']
  retroactive_date date [note: 'Earliest date for which claims will be covered under a claims-made policy, defining the lookback period.']
  risk_assessment_rating varchar [note: 'Insurers evaluation of the property risk profile used for underwriting and premium calculation.']
  total_claims_paid_to_date decimal(18,2) [note: 'Cumulative amount paid by the insurer for all claims under this policy since inception for loss ratio analysis.']
  underwriter_name varchar [note: 'Name of the underwriting professional or team at the insurer who assessed and approved the policy.']
  updated_timestamp timestamp [note: 'System timestamp when this insurance policy record was most recently modified for change tracking and audit compliance.']
  valuation_method varchar [note: 'Methodology used to determine the amount payable in the event of a covered loss, impacting claim settlement.']
  waiting_period_days varchar [note: 'Number of days after a loss event before business interruption coverage begins paying benefits.']

  Note: 'Insurance policy records for each property asset covering property damage, liability, business interruption, and environmental risk. Captures insurer name, policy number, coverage type, insured value, annual premium, policy inception and expiry dates'
}

Table realestate.esg_property_assessment {
  esg_property_assessment_id varchar [pk, note: 'Unique identifier for the ESG property assessment record.']
  property_id varchar [note: 'Reference to the real estate property being assessed.']
  approval_date date [note: 'Date when the ESG assessment was formally approved.']
  approved_by varchar [note: 'Name or identifier of the person or committee that approved the ESG assessment.']
  assessment_date date [note: 'Date when the ESG assessment was conducted.']
  assessment_methodology varchar [note: 'Description of the methodology or framework used to conduct the ESG assessment (e.g., GRESB, proprietary framework).']
  assessment_status varchar [note: 'Current status of the ESG assessment in its lifecycle.']
  assessment_type varchar [note: 'Type of ESG assessment conducted for the property.']
  assessor_contact_email varchar [note: 'Email address of the primary assessor contact.']
  assessor_contact_name varchar [note: 'Primary contact person at the assessor firm responsible for this assessment.']
  assessor_firm_name varchar [note: 'Name of the third-party firm or internal team that conducted the ESG assessment.']
  certification_date date [note: 'Date when the environmental certification was awarded.']
  certification_expiry_date date [note: 'Date when the environmental certification expires and requires renewal.']
  certification_level varchar [note: 'Level or rating achieved within the certification scheme (e.g., Platinum, Gold, Silver, Bronze, or numeric rating).']
  certification_reference_number varchar [note: 'Unique reference or registration number assigned by the certifying body.']
  climate_risk_assessment_flag boolean [note: 'Indicates whether a formal climate risk assessment (physical and transition risks) has been conducted for the property.']
  created_timestamp timestamp [note: 'Timestamp when the ESG assessment record was first created in the system.']
  data_quality_rating varchar [note: 'Assessment of the quality and reliability of data used in the ESG assessment.']
  energy_consumption_kwh decimal(18,2) [note: 'Total energy consumed by the property during the reporting period, measured in kilowatt-hours.']
  energy_intensity_kwh_per_sqm decimal(12,3) [note: 'Energy consumption normalized by gross leasable area, expressed as kWh per square meter.']
  environmental_certification_type varchar [note: 'Type of green building certification held by the property. [ENUM-REF-CANDIDATE: LEED|BREEAM|NABERS|ENERGY_STAR|WELL|GREEN_STAR|DGNB|HQE|none — 9 candidates stripped; promote to reference product]']
  esg_risk_rating varchar [note: 'Overall ESG risk rating assigned to the property based on assessment findings.']
  esg_score decimal(5,2) [note: 'Numeric ESG score assigned to the property, typically on a 0-100 scale.']
  ghg_emissions_intensity_kg_co2e_per_sqm decimal(12,3) [note: 'GHG emissions normalized by gross leasable area, expressed as kg CO2e per square meter.']
  ghg_scope_1_emissions_tonnes_co2e decimal(18,3) [note: 'Direct GHG emissions from sources owned or controlled by the property (e.g., on-site fuel combustion, refrigerants).']
  ghg_scope_2_emissions_tonnes_co2e decimal(18,3) [note: 'Indirect GHG emissions from purchased electricity, steam, heating, and cooling consumed by the property.']
  ghg_scope_3_emissions_tonnes_co2e decimal(18,3) [note: 'Other indirect GHG emissions from value chain activities (e.g., tenant activities, waste disposal, business travel).']
  green_lease_clause_flag boolean [note: 'Indicates whether the property has green lease clauses in tenant agreements that promote sustainability practices.']
  green_lease_coverage_percentage decimal(5,2) [note: 'Percentage of gross leasable area covered by leases with green lease clauses.']
  health_safety_incidents_count varchar [note: 'Number of health and safety incidents reported at the property during the reporting period.']
  notes varchar [note: 'Additional notes, observations, or commentary related to the ESG assessment.']
  physical_climate_risk_level varchar [note: 'Assessment of physical climate risks (flooding, extreme weather, sea level rise) facing the property.']
  renewable_energy_percentage decimal(5,2) [note: 'Percentage of total energy consumption sourced from renewable energy (solar, wind, hydro, etc.).']
  reporting_period_end_date date [note: 'End date of the period covered by this ESG assessment.']
  reporting_period_start_date date [note: 'Start date of the period covered by this ESG assessment.']
  social_impact_assessment_flag boolean [note: 'Indicates whether a social impact assessment (community engagement, tenant wellbeing, accessibility) has been conducted.']
  tenant_satisfaction_score decimal(5,2) [note: 'Tenant satisfaction score from surveys, typically on a 0-100 scale, reflecting social performance.']
  third_party_verification_flag boolean [note: 'Indicates whether the ESG assessment data has been verified by an independent third party.']
  total_ghg_emissions_tonnes_co2e decimal(18,3) [note: 'Total GHG emissions across all scopes (Scope 1 + Scope 2 + Scope 3).']
  transition_climate_risk_level varchar [note: 'Assessment of transition climate risks (policy changes, carbon pricing, market shifts) affecting the property.']
  updated_timestamp timestamp [note: 'Timestamp when the ESG assessment record was last modified in the system.']
  verification_date date [note: 'Date when the third-party verification was completed.']
  verification_firm_name varchar [note: 'Name of the third-party firm that verified the ESG assessment data.']
  waste_diversion_rate_percentage decimal(5,2) [note: 'Percentage of total waste diverted from landfill (waste diverted / waste generated * 100).']
  waste_diverted_tonnes decimal(18,3) [note: 'Total waste diverted from landfill through recycling, composting, or reuse, measured in tonnes.']
  waste_generated_tonnes decimal(18,3) [note: 'Total waste generated by the property during the reporting period, measured in tonnes.']
  water_consumption_cubic_meters decimal(18,2) [note: 'Total water consumed by the property during the reporting period, measured in cubic meters.']
  water_intensity_cubic_meters_per_sqm decimal(12,6) [note: 'Water consumption normalized by gross leasable area, expressed as cubic meters per square meter.']

  Note: 'ESG and sustainability assessment records at the property level capturing environmental certifications (LEED, BREEAM, NABERS, ENERGY STAR), GHG emissions (Scope 1, 2, 3), energy intensity (kWh/sqm), water intensity, waste diversion rate, green lease'
}

Table realestate.asset_business_plan {
  asset_business_plan_id varchar [pk, note: 'Unique identifier for the asset business plan record.']
  actor_id varchar [note: 'Reference to the internal asset manager or team responsible for executing this business plan and managing the property.']
  employee_id varchar [note: 'Reference to the internal asset manager or team responsible for executing this business plan and managing the property.']
  property_id varchar [note: 'Reference to the directly held real estate property for which this business plan applies.']
  capex_budget decimal(18,2) [note: 'Total capital expenditure budget allocated for the property during the plan year for value creation and asset improvement initiatives.']
  capex_currency varchar [note: 'Three-letter ISO 4217 currency code for the CAPEX budget amount.']
  capex_program_description varchar [note: 'Detailed narrative of planned capital improvement projects and programs for the plan year, including scope, objectives, and expected value creation.']
  created_timestamp timestamp [note: 'Timestamp when this asset business plan record was first created in the system.']
  disposition_consideration_flag boolean [note: 'Indicates whether the property is under consideration for potential disposition or sale during or following the plan year.']
  energy_efficiency_target decimal(10,2) [note: 'Target percentage improvement in energy efficiency for the property during the plan year, measured in kilowatt-hours per square foot or similar metric.']
  esg_initiatives varchar [note: 'Description of planned ESG initiatives for the property during the plan year, including energy efficiency upgrades, sustainability certifications, and responsible investment stewardship activities.']
  ghg_reduction_target decimal(10,2) [note: 'Target percentage reduction in greenhouse gas emissions for the property during the plan year, aligned with ESG and climate commitments.']
  ic_approval_date date [note: 'Date when the Investment Committee formally approved this asset business plan.']
  ic_meeting_reference varchar [note: 'Reference identifier for the IC meeting at which this business plan was reviewed and approved.']
  lease_expiry_sqft decimal(12,2) [note: 'Total square footage of leases expiring during the plan year, representing rollover risk and re-leasing opportunity.']
  leasing_strategy varchar [note: 'Narrative description of the leasing strategy for the plan year, including target tenant profiles, rental rate objectives, lease term preferences, and tenant retention initiatives.']
  major_capex_projects varchar [note: 'List or description of major capital projects planned for execution during the plan year, such as renovations, system upgrades, or repositioning initiatives.']
  market_outlook varchar [note: 'Assessment of the local real estate market conditions and outlook for the plan year, including supply-demand dynamics, rental rate trends, and competitive positioning.']
  new_leasing_target_sqft decimal(12,2) [note: 'Target square footage of new leasing activity planned for vacant or expiring space during the plan year.']
  operating_expense_budget decimal(18,2) [note: 'Total operating expense budget for the property during the plan year, covering property management, maintenance, utilities, taxes, and insurance.']
  plan_approved_by varchar [note: 'Name or identifier of the Investment Committee member or executive who formally approved this asset business plan.']
  plan_effective_date date [note: 'Date from which this asset business plan becomes operationally effective and guides asset management activities.']
  plan_expiry_date date [note: 'Date when this asset business plan expires and is superseded by the next annual plan.']
  plan_notes varchar [note: 'Additional notes, comments, or context regarding the asset business plan, including assumptions, dependencies, or special considerations.']
  plan_prepared_by varchar [note: 'Name or identifier of the individual or team who prepared this asset business plan.']
  plan_status varchar [note: 'Current lifecycle status of the asset business plan within the approval and execution workflow.']
  plan_version varchar [note: 'Version number of the business plan, allowing for revisions and updates throughout the year.']
  plan_year varchar [note: 'Calendar year for which this asset business plan is prepared and approved.']
  property_manager_name varchar [note: 'Name of the external property management firm or internal team responsible for day-to-day property operations during the plan year.']
  renewal_target_rate decimal(5,2) [note: 'Target percentage of expiring leases planned to be renewed with existing tenants during the plan year.']
  risk_factors varchar [note: 'Identified risk factors and mitigation strategies for the property during the plan year, including market risks, tenant concentration, lease rollover, and operational risks.']
  submission_date date [note: 'Date when the business plan was formally submitted to the Investment Committee (IC) for review and approval.']
  target_average_rent_psf decimal(10,2) [note: 'Planned average rental rate per square foot for the property, reflecting market positioning and leasing strategy.']
  target_exit_date date [note: 'Planned or target date for disposition of the property if disposition is under consideration.']
  target_gav decimal(18,2) [note: 'Planned Gross Asset Value for the property at the end of the plan year, reflecting expected value appreciation from asset management activities.']
  target_irr decimal(5,2) [note: 'Target Internal Rate of Return percentage for the property over the investment holding period, reflecting long-term risk-adjusted return objectives.']
  target_nav decimal(18,2) [note: 'Planned Net Asset Value for the property at the end of the plan year, net of outstanding debt and liabilities.']
  target_noi decimal(18,2) [note: 'Planned Net Operating Income target for the property during the plan year, representing the strategic income objective.']
  target_noi_currency varchar [note: 'Three-letter ISO 4217 currency code for the target NOI amount.']
  target_occupancy_rate decimal(5,2) [note: 'Planned occupancy rate percentage for the property during the plan year, reflecting leasing strategy goals.']
  target_tenant_profile varchar [note: 'Description of the ideal tenant characteristics and industry sectors targeted for new leasing activity during the plan year.']
  tenant_incentive_budget decimal(18,2) [note: 'Budgeted amount allocated for tenant incentives including free rent periods, tenant improvement allowances, and leasing commissions.']
  updated_timestamp timestamp [note: 'Timestamp when this asset business plan record was last modified or updated.']
  value_creation_strategy varchar [note: 'Strategic narrative describing post-acquisition active asset management initiatives planned to unlock operational efficiency and sustainable value during the plan year.']

  Note: 'Annual asset business plan records for each directly held property, capturing the strategic asset management plan approved by the investment committee. Includes target NOI for the plan year, leasing strategy (target tenants, target rents, incentive'
}

Table realestate.property_allocation {
  property_allocation_id varchar [pk, note: 'Unique identifier for the property allocation record']
  portfolio_id varchar [note: 'Foreign key linking to the investment portfolio that holds an ownership stake in the property']
  property_id varchar [note: 'Foreign key linking to the direct real estate property asset']
  allocation_strategy varchar [note: 'The investment strategy classification for this allocation, indicating whether it aligns with Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), or other investment mandates']
  effective_date date [note: 'The date when this portfolio\'s ownership stake in the property became effective']
  ownership_percentage decimal(8,4) [note: 'The percentage of property ownership held by this portfolio. Sum of all portfolio allocations for a property should equal 100%.']
  termination_date date [note: 'The date when this portfolio\'s ownership stake in the property ended. Null for active allocations.']

  Note: 'This association product represents the allocation of direct real estate property ownership across investment portfolios. It captures the ownership stake, effective period, and allocation strategy for each portfolio-property combination.'
}

Table realestate.budget_line_item {
  budget_line_item_id varchar [pk, note: 'Primary key for budget_line_item']
  employee_id varchar [note: 'Reference to the user who approved this budget line item.']
  fund_id varchar [note: 'Reference to the investment fund that owns the property associated with this budget item.']
  project_investment_id varchar [note: 'Reference to the capital project associated with this budget line item if applicable.']
  property_id varchar [note: 'Reference to the real estate property asset associated with this budget line item.']
  realestate_capex_program_id varchar [note: 'Reference to the parent budget document that contains this line item.']
  vendor_id varchar [note: 'Reference to the preferred or contracted vendor for this budget line item.']
  actual_amount decimal(18,2) [note: 'Actual expenditure or revenue amount recorded against this budget line item.']
  approval_date date [note: 'Date when this budget line item received final approval.']
  approval_status varchar [note: 'Current status in the budget approval workflow for governance tracking.']
  asset_class varchar [note: 'Real estate asset class classification for portfolio-level budget analysis.']
  budget_line_item_category varchar [note: 'High-level classification of the budget line item for financial reporting and analysis purposes.']
  budget_line_item_description varchar [note: 'Detailed narrative description of the budget line item purpose and scope.']
  budget_line_item_status varchar [note: 'Current lifecycle status of the budget line item in the approval workflow.']
  budget_period_end_date date [note: 'End date of the fiscal period covered by this budget line item.']
  budget_period_start_date date [note: 'Start date of the fiscal period covered by this budget line item.']
  budgeted_amount decimal(18,2) [note: 'Originally approved budget amount for this line item in the base currency.']
  committed_amount decimal(18,2) [note: 'Amount committed through purchase orders or contracts but not yet expensed.']
  cost_center_code varchar [note: 'Organizational cost center responsible for this budget line item expenditure or revenue.']
  created_timestamp timestamp [note: 'Timestamp when this budget line item record was initially created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this line item.']
  effective_date date [note: 'Date when this budget line item becomes effective for financial planning purposes.']
  expiration_date date [note: 'Date when this budget line item expires or is no longer applicable.']
  fiscal_quarter varchar [note: 'Fiscal quarter designation for quarterly budget tracking and variance analysis.']
  fiscal_year varchar [note: 'Fiscal year to which this budget line item applies for annual planning and reporting.']
  forecast_amount decimal(18,2) [note: 'Latest forecast amount for this line item based on current projections and trends.']
  gl_account_code varchar [note: 'General ledger account code for proper financial statement mapping and consolidation.']
  investment_strategy varchar [note: 'Investment strategy classification aligned with institutional real estate risk-return profiles.']
  is_capital_expenditure boolean [note: 'Indicates whether this line item represents a capital expenditure requiring capitalization.']
  is_recoverable boolean [note: 'Indicates whether this expense is recoverable from tenants under lease agreements.']
  is_recurring boolean [note: 'Indicates whether this budget line item represents a recurring expense or one-time cost.']
  justification varchar [note: 'Business justification narrative supporting the budget request for approval purposes.']
  line_item_code varchar [note: 'Standardized alphanumeric code identifying the budget line item category per institutional accounting standards.']
  line_number varchar [note: 'Sequential ordering number of this line item within the parent budget document.']
  modified_timestamp timestamp [note: 'Timestamp when this budget line item record was last modified.']
  notes varchar [note: 'Free-form notes and comments providing additional context for this budget line item.']
  priority_level varchar [note: 'Priority classification for capital allocation and expenditure sequencing decisions.']
  quantity decimal(18,4) [note: 'Quantity of units budgeted for this line item when applicable.']
  recovery_percentage decimal(5,2) [note: 'Percentage of the expense amount that can be recovered from tenants.']
  recurrence_frequency varchar [note: 'Frequency of recurring expenses for cash flow planning and forecasting.']
  revised_amount decimal(18,2) [note: 'Current revised budget amount after any approved amendments or reforecasts.']
  subcategory varchar [note: 'Detailed classification within the primary category for granular expense and revenue tracking.']
  unit_cost decimal(18,4) [note: 'Cost per unit for quantity-based budget calculations and analysis.']
  unit_of_measure varchar [note: 'Unit of measurement for quantity-based budget items such as square footage or units.']
  variance_amount decimal(18,2) [note: 'Difference between budgeted and actual amounts for variance analysis and reporting.']
  variance_explanation varchar [note: 'Explanation of significant variances between budgeted and actual amounts.']

  Note: 'Master reference table for budget_line_item. Referenced by budget_line_item_id.'
}

Table infrastructure.infra_asset {
  infra_asset_id varchar [pk, note: 'Unique identifier for the infrastructure asset record. Primary key for direct infrastructure investments including toll roads, airports, ports, pipelines, utilities, energy transmission, water treatment, and social infrastructure.']
  asset_class_outlook_id varchar [note: 'Foreign key linking to research.asset_class_outlook. Business justification: Asset class outlook informs asset valuation and allocation decisions.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Country macro outlook influences asset risk assessment.']
  covenant_monitoring_id varchar [note: 'Foreign key linking to credit.covenant_monitoring. Business justification: Tracking covenants for each asset\'s debt instrument in the pension fund\'s covenant monitoring process.']
  credit_issuer_id varchar [note: 'Foreign key linking to credit.credit_issuer. Business justification: Pension fund\'s credit risk team monitors issuer creditworthiness for each infrastructure asset\'s debt.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Asset valuation uses macro scenario for scenario analysis.']
  fixed_income_security_id varchar [note: 'Foreign key linking to credit.fixed_income_security. Business justification: Mapping each infrastructure asset to its dedicated bond for cash flow and risk reporting.']
  infrastructure_sector_classification_id varchar [note: 'Foreign key linking to infrastructure.infrastructure_sector_classification. Business justification: Infra_asset has a sector classification that is captured in infrastructure_sector_classification.']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Asset‑level reporting and deal alignment require linking each asset to its originating investment opportunity.']
  private_credit_investment_id varchar [note: 'Foreign key linking to credit.private_credit_investment. Business justification: Linking infrastructure asset to the private credit investment that finances it for performance attribution.']
  regulatory_calendar_id varchar [note: 'Foreign key linking to compliance.regulatory_calendar. Business justification: Asset-level regulatory calendar for compliance deadlines.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Asset-level regulatory filing for compliance reporting.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Infrastructure assets that are natural resource extraction facilities need to reference the underlying resource asset for reserve, ESG, and regulatory reporting.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Sector outlook informs sector‑specific risk and return expectations.']
  acquisition_cost decimal(18,2) [note: 'Total capital deployed at acquisition including purchase price, transaction costs, and initial capital commitments in base currency.']
  acquisition_date date [note: 'Date on which the pension fund completed the acquisition or initial investment in the infrastructure asset.']
  address varchar [note: 'Full physical address of the infrastructure asset including street, postal code, and administrative subdivisions.']
  allowed_return_rate decimal(5,2) [note: 'Regulated rate of return on capital permitted by the regulatory authority, expressed as an annual percentage.']
  annual_revenue decimal(18,2) [note: 'Total annual revenue generated by the infrastructure asset from operations, tariffs, tolls, or service fees.']
  asset_code varchar [note: 'Internal unique alphanumeric code assigned to the infrastructure asset for portfolio tracking and reporting purposes.']
  asset_manager_name varchar [note: 'Name of the investment manager or asset management firm overseeing the infrastructure investment on behalf of the pension fund.']
  asset_name varchar [note: 'Full legal or commercial name of the infrastructure asset as registered or commonly known in the market.']
  asset_status varchar [note: 'Current lifecycle status of the infrastructure asset indicating operational readiness and portfolio standing.']
  asset_sub_type varchar [note: 'Granular sub-classification within the asset type providing additional operational or structural detail.']
  asset_type varchar [note: 'Classification of the infrastructure asset by operational category defining the core service or utility provided. [ENUM-REF-CANDIDATE']
  capacity_unit varchar [note: 'Unit of measure for operational capacity such as passengers per year, megawatts, cubic meters per day, or vehicles per day.']
  carbon_emissions_annual decimal(18,2) [note: 'Total annual greenhouse gas emissions attributable to the infrastructure asset operations, measured in metric tons of CO2 equivalent.']
  city varchar [note: 'Primary city or municipality where the infrastructure asset is located or serves.']
  concession_agreement_flag boolean [note: 'Indicates whether the infrastructure asset operates under a government or public authority concession agreement.']
  concession_end_date date [note: 'Expiration or termination date of the concession agreement after which operational rights revert to the grantor.']
  concession_start_date date [note: 'Effective start date of the concession agreement granting operational rights for the infrastructure asset.']
  concession_term_years varchar [note: 'Total duration of the concession agreement in years from start to end date.']
  country_code varchar [note: 'Three-letter ISO country code identifying the sovereign jurisdiction where the infrastructure asset is domiciled.']
  created_timestamp timestamp [note: 'System timestamp indicating when the infrastructure asset record was first created in the data platform.']
  currency_code varchar [note: 'Three-letter ISO currency code for the base currency in which the asset financials are denominated.']
  current_valuation decimal(18,2) [note: 'Most recent fair value or mark-to-market valuation of the infrastructure asset as determined by internal or external appraisal.']
  debt_outstanding decimal(18,2) [note: 'Total outstanding debt or leverage associated with the infrastructure asset at the asset or project level.']
  disposal_date date [note: 'Date on which the infrastructure asset was sold, transferred, or otherwise disposed of by the pension fund.']
  disposal_proceeds decimal(18,2) [note: 'Total cash proceeds received from the sale or disposal of the infrastructure asset net of transaction costs.']
  dscr decimal(5,2) [note: 'Debt service coverage ratio measuring the assets ability to cover debt obligations from operating cash flow.']
  ebitda decimal(18,2) [note: 'Annual earnings before interest, taxes, depreciation, and amortization, representing operational cash generation capability.']
  esg_rating varchar [note: 'Overall ESG rating or score assigned to the infrastructure asset by internal assessment or external ESG rating agency.']
  geographic_region varchar [note: 'Broad geographic region where the infrastructure asset is physically located, used for portfolio allocation and risk analysis.']
  investment_committee_approval_date date [note: 'Date on which the pension funds Investment Committee formally approved the infrastructure asset investment.']
  investment_stage varchar [note: 'Development or operational stage of the infrastructure asset at the time of investment or current state.']
  irr decimal(5,2) [note: 'Annualized internal rate of return achieved on the infrastructure investment from inception to current date or disposal.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the infrastructure asset location in decimal degrees for geospatial analysis.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the infrastructure asset location in decimal degrees for geospatial analysis.']
  ltv_ratio decimal(5,2) [note: 'Loan-to-value ratio calculated as outstanding debt divided by current asset valuation, expressed as a percentage.']
  moic decimal(5,2) [note: 'Total value multiple calculated as the sum of distributions and residual value divided by total invested capital.']
  noi decimal(18,2) [note: 'Net operating income after deducting direct operating expenses from gross revenue, excluding financing and tax costs.']
  operational_capacity decimal(18,2) [note: 'Maximum operational throughput or service capacity of the infrastructure asset in relevant units.']
  operator_lei varchar [note: 'Twenty-character ISO Legal Entity Identifier for the operator entity managing the infrastructure asset.']
  operator_name varchar [note: 'Name of the entity or organization responsible for day-to-day operations and management of the infrastructure asset.']
  ownership_percentage decimal(5,2) [note: 'Percentage of economic interest held by the pension fund in the infrastructure asset, expressed as a decimal between 0 and 100.']
  ownership_structure varchar [note: 'Legal ownership model indicating whether the asset is wholly owned, co-invested, or held through joint venture arrangements.']
  regulated_asset_flag boolean [note: 'Indicates whether the infrastructure asset operates under a regulated return or tariff framework set by a government authority.']
  regulatory_framework varchar [note: 'Name or description of the regulatory regime governing tariffs, returns, or operational standards for the asset.']
  renewable_energy_flag boolean [note: 'Indicates whether the infrastructure asset generates or transmits renewable energy such as wind, solar, or hydro power.']
  updated_timestamp timestamp [note: 'System timestamp indicating when the infrastructure asset record was last modified or updated.']
  utilization_rate decimal(5,2) [note: 'Current utilization of operational capacity expressed as a percentage of maximum capacity.']
  valuation_date date [note: 'Date of the most recent valuation assessment for the infrastructure asset.']
  valuation_method varchar [note: 'Primary valuation methodology applied to determine the fair value of the infrastructure asset.']

  Note: 'Master record for direct infrastructure assets owned or co-owned by the pension fund, including toll roads, airports, ports, pipelines, utilities, energy transmission networks, water treatment facilities, and social infrastructure.'
}

Table infrastructure.infra_fund_commitment {
  infra_fund_commitment_id varchar [pk, note: 'Unique identifier for the infrastructure fund commitment record. Primary key for this entity.']
  actor_id varchar [note: 'Reference to the third-party fund administrator entity providing NAV calculation and reporting services for the fund.']
  asset_class_outlook_id varchar [note: 'Foreign key linking to research.asset_class_outlook. Business justification: Fund allocation uses asset class outlook to target exposures.']
  carried_interest_id varchar [note: 'Foreign key linking to fee.carried_interest. Business justification: Carried interest terms are defined per fund; linking infra_fund_commitment to carried_interest allows calculation of carried interest distributions.']
  counterparty_id varchar [note: 'Reference to the custodian or fund administrator entity responsible for holding and administering the fund investment.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Fund country exposure is monitored via country macro outlook.']
  covenant_monitoring_id varchar [note: 'Foreign key linking to credit.covenant_monitoring. Business justification: Tracking covenants associated with each fund commitment\'s debt instrument.']
  credit_issuer_id varchar [note: 'Foreign key linking to credit.credit_issuer. Business justification: Linking fund commitments to the issuer of the debt for credit risk assessment.']
  deal_capital_commitment_id varchar [note: 'Foreign key linking to deal.deal_capital_commitment. Business justification: Linking fund commitments to deal commitments enables accurate capital allocation reporting and regulatory compliance.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Fund scenario analysis uses macro scenario for performance forecasting.']
  fixed_income_security_id varchar [note: 'Foreign key linking to credit.fixed_income_security. Business justification: Mapping fund commitments to the underlying bond for cash flow reconciliation.']
  gp_entity_id varchar [note: 'Reference to the external manager entity acting as General Partner for this infrastructure fund.']
  management_fee_id varchar [note: 'Foreign key linking to fee.management_fee. Business justification: Each infrastructure fund has a specific management fee arrangement; linking infra_fund_commitment to management_fee enables fee schedule retrieval for accounting and reporting.']
  risk_model_id varchar [note: 'Foreign key linking to risk.model. Business justification: The pension fund uses a specific risk model to evaluate the fund\'s risk profile; the fund\'s risk model is tracked per fund commitment.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Fund sector exposure is guided by sector outlook data.']
  waterfall_id varchar [note: 'Foreign key linking to fee.waterfall. Business justification: The distribution waterfall structure is specific to each fund; linking infra_fund_commitment to waterfall supports accurate distribution waterfall calculations.']
  actual_net_irr decimal(5,4) [note: 'Actual net IRR performance of the infrastructure fund to date, calculated using cash flows and current NAV.']
  benchmark_index varchar [note: 'Market benchmark index used to evaluate relative performance of the infrastructure fund commitment.']
  carried_interest_rate decimal(5,4) [note: 'Performance fee rate (carry) payable to the GP on profits above the hurdle rate, expressed as a decimal percentage.']
  co_investment_rights_flag boolean [note: 'Indicates whether the pension fund has negotiated co-investment rights to participate in direct deals alongside the fund.']
  commitment_date date [note: 'Date on which the pension fund formally committed capital to the infrastructure fund, typically the date the LPA was executed.']
  commitment_status varchar [note: 'Current lifecycle status of the infrastructure fund commitment indicating investment phase and activity state.']
  committed_capital_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to the infrastructure fund as stated in the LPA, representing maximum callable capital.']
  committed_capital_currency varchar [note: 'Three-letter ISO 4217 currency code for the committed capital amount (e.g., USD, EUR, GBP).']
  created_timestamp timestamp [note: 'System timestamp when this infrastructure fund commitment record was first created in the data platform.']
  distributed_capital_amount decimal(18,2) [note: 'Cumulative cash distributions received by the pension fund from the infrastructure fund to date, including return of capital and profits.']
  dpi_multiple decimal(5,2) [note: 'Distributions to Paid-In capital multiple, calculated as Distributions / Paid-In Capital, measuring realized cash returns.']
  esg_classification varchar [note: 'ESG classification of the infrastructure fund under SFDR (Sustainable Finance Disclosure Regulation) or equivalent framework.']
  fund_identifier varchar [note: 'External unique identifier or code assigned to the infrastructure fund by the General Partner (GP) or administrator.']
  fund_maturity_date date [note: 'Expected final maturity date of the infrastructure fund when all assets should be liquidated and capital returned to LPs.']
  fund_name varchar [note: 'Full legal name of the infrastructure fund as stated in the Limited Partnership Agreement (LPA) or fund documentation.']
  fund_strategy varchar [note: 'Primary investment strategy classification of the infrastructure fund indicating risk-return profile and asset maturity focus. [ENUM-REF-CANDIDATE: core|core_plus|value_add|opportunistic|greenfield|brownfield|diversified — 7 candidates stripped; promote']
  fund_term_years varchar [note: 'Total contractual term of the infrastructure fund in years from initial closing, typically 10-15 years with extension options.']
  fund_type varchar [note: 'Legal and operational structure type of the infrastructure fund vehicle.']
  geographic_focus varchar [note: 'Primary geographic regions or countries targeted by the infrastructure fund for investment allocation.']
  hurdle_rate decimal(5,4) [note: 'Minimum annualized Internal Rate of Return (IRR) that LPs must achieve before the GP earns carried interest, expressed as a decimal.']
  internal_asset_class varchar [note: 'Internal Strategic Asset Allocation (SAA) asset class bucket to which this infrastructure fund commitment is assigned.']
  investment_committee_approval_date date [note: 'Date on which the pension funds Investment Committee formally approved the infrastructure fund commitment.']
  investment_period_end_date date [note: 'Date on which the funds investment period expires, after which no new investments may be made except follow-on investments.']
  investment_period_start_date date [note: 'Date on which the funds investment period commenced, during which the GP may make new investments and issue capital calls.']
  key_person_clause_flag boolean [note: 'Indicates whether the LPA includes key person provisions that suspend the investment period if designated key investment professionals depart.']
  last_capital_call_date date [note: 'Date of the most recent capital call notice issued by the GP for this infrastructure fund commitment.']
  last_distribution_date date [note: 'Date of the most recent cash distribution received from the infrastructure fund.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the GP, expressed as a decimal percentage of committed or invested capital.']
  most_favored_nation_flag boolean [note: 'Indicates whether the commitment includes a Most Favored Nation clause granting rights to match better terms offered to other LPs.']
  nav_amount decimal(18,2) [note: 'Current Net Asset Value of the pension funds investment in the infrastructure fund, representing fair value of the remaining investment.']
  nav_as_of_date date [note: 'Valuation date for the reported NAV amount, typically quarter-end or month-end.']
  paid_in_capital_amount decimal(18,2) [note: 'Cumulative capital amount drawn down by the GP through capital calls and actually funded by the pension fund to date.']
  regulatory_capital_treatment varchar [note: 'Regulatory capital classification of the infrastructure fund commitment for pension solvency and capital adequacy reporting purposes.']
  reporting_frequency varchar [note: 'Frequency at which the GP provides formal performance and valuation reports to Limited Partners.']
  rvpi_multiple decimal(5,2) [note: 'Residual Value to Paid-In capital multiple, calculated as NAV / Paid-In Capital, measuring unrealized value remaining.']
  sector_focus varchar [note: 'Primary infrastructure sectors targeted by the fund such as transportation, energy, utilities, social infrastructure, or digital infrastructure.']
  side_letter_flag boolean [note: 'Indicates whether a side letter agreement with special terms or rights exists for this commitment.']
  target_net_irr decimal(5,4) [note: 'Target net IRR return objective for the infrastructure fund as stated in the Private Placement Memorandum (PPM), expressed as a decimal.']
  tvpi_multiple decimal(5,2) [note: 'Total Value to Paid-In capital multiple, calculated as (Distributions + NAV) / Paid-In Capital, measuring total value creation.']
  unfunded_commitment_amount decimal(18,2) [note: 'Remaining uncalled capital commitment available for future capital calls, calculated as committed capital minus paid-in capital.']
  updated_timestamp timestamp [note: 'System timestamp when this infrastructure fund commitment record was last modified in the data platform.']
  vintage_year varchar [note: 'Calendar year in which the infrastructure fund held its initial closing and began accepting capital commitments from Limited Partners (LPs).']

  Note: 'Master record for the pension fund\'s LP commitments to infrastructure-focused closed-end funds and open-end vehicles managed by external GPs. Captures fund name, GP entity, vintage year, committed capital (e.g., EUR/USD), drawn capital (PIC), unfunded'
}

Table infrastructure.concession_agreement {
  concession_agreement_id varchar [pk, note: 'Unique identifier for the concession agreement record. Primary key.']
  actor_id varchar [note: 'Reference to the government body, regulatory authority, or public entity that granted the concession rights.']
  concessionaire_entity_actor_id varchar [note: 'Reference to the legal entity holding the concession rights, typically the fund or special purpose vehicle.']
  infra_asset_id varchar [note: 'Reference to the underlying infrastructure asset governed by this concession agreement.']
  agreement_name varchar [note: 'Human-readable name or title of the concession agreement, often referencing the asset or project covered.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the concession agreement, typically assigned by the grantor or regulatory authority.']
  agreement_status varchar [note: 'Current lifecycle status of the concession agreement, indicating whether it is under negotiation, active, or concluded. [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|terminated|expired — 7 candidates stripped; promote to reference']
  agreement_type varchar [note: 'Classification of the concession structure, such as Build-Operate-Transfer (BOT), Build-Own-Operate (BOO), Design-Build-Finance-Operate (DBFO), or traditional concession.']
  allowed_return_rate_percent decimal(6,4) [note: 'Regulatory-approved rate of return on invested capital, expressed as a percentage, applicable under regulated return mechanisms.']
  annual_concession_fee_amount decimal(18,2) [note: 'Recurring annual fee payable to the grantor throughout the concession term, in concession currency.']
  audit_rights_description varchar [note: 'Summary of the grantor\'s rights to audit the concessionaire\'s financial records, operational performance, and compliance.']
  capex_responsibility varchar [note: 'Party responsible for funding capital expenditures during the concession term: concessionaire, grantor, or shared.']
  change_in_law_protection_flag boolean [note: 'Indicates whether the agreement includes provisions protecting the concessionaire from adverse changes in law or regulation.']
  compensation_on_termination_basis varchar [note: 'Methodology for calculating compensation payable to the concessionaire in the event of early termination by the grantor.']
  concession_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all financial terms and payments under the concession agreement.']
  concession_term_years decimal(5,2) [note: 'Total duration of the concession period expressed in years, including any extension options exercised.']
  created_timestamp timestamp [note: 'Timestamp when this concession agreement record was first created in the system.']
  dispute_resolution_mechanism varchar [note: 'Primary method for resolving disputes between parties: litigation, arbitration, mediation, or expert determination.']
  effective_end_date date [note: 'Date on which the concession term expires and rights revert to the grantor, unless extended or renewed.']
  effective_start_date date [note: 'Date on which the concession term begins and the concessionaire assumes operational rights and obligations.']
  esg_compliance_requirements varchar [note: 'Summary of Environmental, Social, and Governance obligations and standards the concessionaire must adhere to under the agreement.']
  execution_date date [note: 'Date on which the concession agreement was formally executed and signed by all parties.']
  extension_option_flag boolean [note: 'Indicates whether the concession agreement includes provisions for term extension beyond the initial period.']
  extension_term_years decimal(5,2) [note: 'Additional years available under extension provisions, if applicable.']
  force_majeure_provisions varchar [note: 'Summary of force majeure clauses defining events beyond parties\' control that excuse performance or trigger relief mechanisms.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law applicable to the interpretation and enforcement of the concession agreement.']
  handback_condition_requirements varchar [note: 'Specifications for the physical and operational condition in which the asset must be returned to the grantor at concession end.']
  insurance_requirements varchar [note: 'Summary of insurance coverage types and minimum limits the concessionaire must maintain throughout the concession term.']
  last_modified_timestamp timestamp [note: 'Timestamp when this concession agreement record was last updated in the system.']
  minimum_revenue_guarantee_amount decimal(18,2) [note: 'Guaranteed minimum annual revenue amount provided by the grantor, if applicable, in the concession currency.']
  minimum_revenue_guarantee_flag boolean [note: 'Indicates whether the grantor provides a minimum revenue guarantee to protect the concessionaire from demand risk.']
  opex_responsibility varchar [note: 'Party responsible for funding operating expenditures during the concession term: concessionaire, grantor, or shared.']
  penalty_regime_description varchar [note: 'Summary of penalties, liquidated damages, or deductions applicable for failure to meet service quality or performance standards.']
  performance_bond_amount decimal(18,2) [note: 'Value of the performance bond or guarantee required, if applicable, in concession currency.']
  performance_bond_required_flag boolean [note: 'Indicates whether the concessionaire is required to post a performance bond or guarantee to secure obligations.']
  refinancing_consent_required_flag boolean [note: 'Indicates whether the concessionaire must obtain grantor consent before refinancing the project debt.']
  refinancing_gain_sharing_percent decimal(5,2) [note: 'Percentage of refinancing gains that must be shared with the grantor, if applicable.']
  regulated_return_mechanism varchar [note: 'Type of return structure governing concessionaire compensation: Regulated Asset Return (RAR), Rate of Return (ROR), availability payment, revenue share, or hybrid model.']
  reporting_frequency varchar [note: 'Frequency at which the concessionaire must submit operational and financial reports to the grantor.']
  revenue_sharing_percent decimal(5,2) [note: 'Percentage of gross revenues that must be shared with the grantor under revenue-sharing concession structures.']
  service_quality_standards varchar [note: 'Description of the service quality, availability, and performance standards the concessionaire must meet under the agreement.']
  step_in_rights_description varchar [note: 'Summary of the grantor\'s or lenders\' rights to step in and assume control of operations in the event of concessionaire default.']
  tariff_indexation_mechanism varchar [note: 'Description of the formula or index used to adjust tariffs over time, such as Consumer Price Index (CPI), Retail Price Index (RPI), or custom formula.']
  tariff_setting_authority varchar [note: 'Entity or mechanism responsible for setting user tariffs or charges: concessionaire discretion, grantor approval, independent regulator, or formula-based indexation.']
  termination_rights_description varchar [note: 'Summary of conditions under which either party may terminate the concession agreement prior to the scheduled end date.']
  upfront_concession_fee_amount decimal(18,2) [note: 'One-time fee paid by the concessionaire to the grantor at the start of the concession term, in concession currency.']

  Note: 'Master record for concession, license, or franchise agreements governing the right to operate regulated infrastructure assets. Captures concession grantor (government or regulatory body), concession term start and end dates, regulated return mechanism'
}

Table infrastructure.regulated_return_model {
  regulated_return_model_id varchar [pk, note: 'Unique identifier for the regulated return model record. Primary key.']
  infra_asset_id varchar [note: 'Foreign key reference to the infrastructure asset to which this regulatory return model applies.']
  allowed_return_rate_percent decimal(8,4) [note: 'Regulatory allowed rate of return on the RAB, expressed as a percentage per annum, representing the weighted average cost of capital or regulated return.']
  capex_allowance_amount decimal(20,2) [note: 'Regulatory allowance for capital expenditure during the determination period, which may be added to the RAB.']
  clawback_mechanism_flag boolean [note: 'Indicates whether a clawback or true-up mechanism exists to adjust future returns based on actual performance versus allowed returns.']
  cost_of_debt_percent decimal(8,4) [note: 'Regulatory cost of debt component used in the WACC calculation, expressed as a percentage.']
  cost_of_equity_percent decimal(8,4) [note: 'Regulatory cost of equity component used in the WACC calculation, expressed as a percentage.']
  created_by_user varchar [note: 'User identifier or name of the person who created this regulated return model record.']
  created_timestamp timestamp [note: 'Timestamp when this regulated return model record was first created in the system.']
  depreciation_method varchar [note: 'Depreciation method applied to the RAB for regulatory purposes: straight-line, declining balance, units of production, or regulatory prescribed.']
  depreciation_rate_percent decimal(8,4) [note: 'Annual depreciation rate applied to the RAB, expressed as a percentage of the asset base.']
  determination_date date [note: 'Date on which the regulatory authority issued the price determination or return decision for this model.']
  determination_document_url varchar [note: 'URL or document repository link to the official regulatory determination or price control decision document.']
  effective_from_date date [note: 'Date from which the regulated return model becomes effective and applicable to the infrastructure asset.']
  effective_to_date date [note: 'Date until which the regulated return model remains effective; nullable for open-ended or current determinations.']
  gearing_ratio_percent decimal(8,4) [note: 'Regulatory gearing or leverage ratio (debt to total capital) assumed in the WACC calculation, expressed as a percentage.']
  incentive_mechanism_type varchar [note: 'Type of regulatory incentive mechanism applied, such as efficiency sharing, performance bonuses, or penalty regimes.']
  inflation_indexation_method varchar [note: 'Method by which the RAB and allowed returns are indexed for inflation: real, nominal, CPI-indexed, RPI-indexed, or none.']
  inflation_rate_percent decimal(8,4) [note: 'Assumed or actual inflation rate used for indexation of the RAB and returns, expressed as a percentage per annum.']
  jurisdiction varchar [note: 'Geographic or legal jurisdiction under which the regulatory return model operates, typically a country or region code.']
  model_code varchar [note: 'Unique business identifier or code for the regulated return model, used for external reporting and regulatory filings.']
  model_name varchar [note: 'Business name or title of the regulated return model, typically referencing the regulatory framework or determination period.']
  model_notes varchar [note: 'Free-text notes or commentary on the regulatory return model, including key assumptions, special conditions, or deviations from standard frameworks.']
  model_status varchar [note: 'Current lifecycle status of the regulated return model: draft, active, superseded, expired, or under review.']
  next_review_date date [note: 'Scheduled date for the next regulatory review or price determination for this infrastructure asset.']
  opex_allowance_amount decimal(20,2) [note: 'Regulatory allowance for operating expenditure during the determination period, used to set revenue caps or price controls.']
  performance_target_description varchar [note: 'Description of performance targets or service quality standards that the asset must meet under the regulatory determination.']
  price_cap_amount decimal(20,2) [note: 'Maximum price or tariff the infrastructure asset is permitted to charge under the regulatory determination, if a price cap framework applies.']
  rab_closing_value decimal(20,2) [note: 'Closing value of the Regulatory Asset Base at the end of the determination period, reflecting capital additions, depreciation, and disposals.']
  rab_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the Regulatory Asset Base valuation.']
  rab_opening_value decimal(20,2) [note: 'Opening value of the Regulatory Asset Base at the start of the determination period, representing the capital base on which returns are calculated.']
  regulator_name varchar [note: 'Name of the regulatory authority or body that sets and oversees the allowed return for this infrastructure asset.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier of the regulatory filing or determination document associated with this return model.']
  regulatory_framework varchar [note: 'Type of regulatory framework governing the allowed return: rate of return, price cap, revenue cap, hybrid, cost of service, or incentive-based regulation.']
  regulatory_period_years varchar [note: 'Duration in years of the regulatory review period or price control period for this determination.']
  revenue_cap_amount decimal(20,2) [note: 'Maximum revenue the infrastructure asset is permitted to earn under the regulatory determination, if a revenue cap framework applies.']
  review_cycle_frequency varchar [note: 'Frequency at which the regulatory return model is reviewed and updated by the regulator: annual, biennial, triennial, quinquennial, or ad hoc.']
  updated_by_user varchar [note: 'User identifier or name of the person who last updated this regulated return model record.']
  updated_timestamp timestamp [note: 'Timestamp when this regulated return model record was last updated in the system.']
  wacc_percent decimal(8,4) [note: 'Weighted Average Cost of Capital used by the regulator to determine the allowed return, expressed as a percentage.']

  Note: 'Master record for the regulatory asset base (RAB) and allowed-return model applicable to regulated infrastructure assets, including the history of regulatory price determinations.'
}

Table infrastructure.project_investment {
  project_investment_id varchar [pk, note: 'Unique identifier for the infrastructure project investment record.']
  asset_class_outlook_id varchar [note: 'Foreign key linking to research.asset_class_outlook. Business justification: Project asset class outlook informs project valuation.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Country macro outlook influences project risk assessment.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Project scenario analysis uses macro scenario for sensitivity testing.']
  private_credit_investment_id varchar [note: 'Foreign key linking to credit.private_credit_investment. Business justification: Associating each project investment with the private credit deal that provides its capital.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Sector outlook informs project risk and return expectations.']
  actual_irr decimal(5,2) [note: 'Actual internal rate of return (IRR) percentage achieved to date on the infrastructure project investment.']
  asset_class varchar [note: 'Primary infrastructure asset class: transportation, energy, utilities, social infrastructure, telecommunications, or other.']
  carbon_intensity decimal(10,2) [note: 'Carbon intensity metric for the infrastructure project, measured as tonnes of CO2 equivalent emissions per unit of output or revenue.']
  commercial_operation_date date [note: 'Date when the infrastructure project commenced full commercial operations and began generating revenue or providing services.']
  concession_duration_years varchar [note: 'Total duration of the concession agreement or operating license in years.']
  concession_end_date date [note: 'End date of the concession agreement or operating license period, after which the asset may revert to the grantor or require renewal.']
  concession_start_date date [note: 'Start date of the concession agreement or operating license period for the infrastructure project.']
  construction_completion_percentage decimal(5,2) [note: 'Percentage of construction or development work completed for the infrastructure project, applicable during construction phase.']
  construction_contractor varchar [note: 'Name of the primary construction contractor responsible for building or developing the infrastructure project.']
  contracted_revenue_percentage decimal(5,2) [note: 'Percentage of total project revenue that is contracted or guaranteed under long-term agreements, providing revenue stability.']
  country_code varchar [note: 'Three-letter ISO country code where the infrastructure project is domiciled.']
  created_timestamp timestamp [note: 'Timestamp when the infrastructure project investment record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the primary currency of the infrastructure project investment.']
  current_nav decimal(18,2) [note: 'Current net asset value (NAV) of the pension funds stake in the infrastructure project investment as of the latest valuation date.']
  debt_financing_amount decimal(18,2) [note: 'Total debt financing amount raised for the infrastructure project, including senior debt, subordinated debt, and other borrowings.']
  development_stage varchar [note: 'Current lifecycle stage of the infrastructure project: pre-construction, construction, operational ramp-up, steady-state, decommissioning, or exited.']
  dscr decimal(5,2) [note: 'Debt service coverage ratio (DSCR) measuring the projects ability to service debt obligations from operating cash flows.']
  equity_commitment decimal(18,2) [note: 'Total equity capital committed by the pension fund to the infrastructure project investment.']
  equity_deployed decimal(18,2) [note: 'Cumulative equity capital deployed or drawn down into the infrastructure project to date.']
  esg_rating varchar [note: 'Environmental, Social, and Governance (ESG) rating assigned to the infrastructure project by an external rating agency or internal assessment. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|NR — 10 candidates stripped; promote to reference product]']
  exit_strategy varchar [note: 'Planned exit strategy for the infrastructure project investment (e.g., hold to maturity, secondary sale, IPO, refinancing, asset sale).']
  expected_completion_date date [note: 'Expected or scheduled completion date for construction or development of the infrastructure project.']
  financial_close_date date [note: 'Date when all financing documentation was executed and conditions precedent were satisfied, enabling project construction or acquisition to proceed.']
  geographic_region varchar [note: 'Primary geographic region where the infrastructure project is located (e.g., North America, Europe, Asia-Pacific, Latin America).']
  greenfield_brownfield_flag boolean [note: 'Indicator of whether the infrastructure project is a greenfield (new development) or brownfield (existing asset acquisition) investment.']
  investment_committee_approval_date date [note: 'Date when the pension funds Investment Committee (IC) approved the infrastructure project investment.']
  investment_date date [note: 'Date when the initial investment commitment or capital deployment into the infrastructure project was executed.']
  investment_status varchar [note: 'Current operational status of the project investment: active, on hold, completed, divested, impaired, or under review.']
  investment_structure varchar [note: 'Structure through which the pension fund holds the infrastructure project investment: direct, co-investment, fund investment, club deal, or secondary.']
  last_modified_timestamp timestamp [note: 'Timestamp when the infrastructure project investment record was last updated or modified.']
  leverage_ratio decimal(5,2) [note: 'Debt-to-equity leverage ratio for the infrastructure project, calculated as total debt divided by total equity.']
  moic decimal(5,2) [note: 'Multiple on invested capital (MOIC) representing total value divided by total invested capital for the infrastructure project.']
  offtake_contract_expiry_date date [note: 'Expiry date of the primary offtake or revenue contract for the infrastructure project.']
  offtake_counterparty varchar [note: 'Primary offtake counterparty or customer purchasing the output or services of the infrastructure project under long-term contract.']
  operator_name varchar [note: 'Name of the third-party operator or asset manager responsible for day-to-day operations and maintenance of the infrastructure project.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership stake held by the pension fund in the infrastructure project investment.']
  project_code varchar [note: 'Internal unique alphanumeric code assigned to the infrastructure project for tracking and reporting purposes.']
  project_name varchar [note: 'Full legal or commercial name of the infrastructure project investment.']
  project_type varchar [note: 'Classification of the infrastructure project investment structure: Public-Private Partnership (PPP), Private Finance Initiative (PFI), availability-payment, merchant, regulated utility, or concession.']
  regulatory_framework varchar [note: 'Description of the regulatory framework governing the infrastructure project, including key regulatory bodies and compliance requirements.']
  revenue_model varchar [note: 'Primary revenue generation model for the infrastructure project: availability payment, usage-based, merchant, regulated return, or hybrid.']
  sub_sector varchar [note: 'Detailed sub-sector classification within the asset class (e.g., toll roads, airports, renewable energy, water treatment, hospitals, schools).']
  target_irr decimal(5,2) [note: 'Target internal rate of return (IRR) percentage established at investment underwriting for the infrastructure project.']
  total_project_cost decimal(18,2) [note: 'Total estimated or actual cost to develop, construct, and commission the infrastructure project, including all capital expenditures.']
  valuation_date date [note: 'Date of the most recent valuation for the infrastructure project investment.']
  valuation_method varchar [note: 'Primary valuation methodology used to determine fair value: discounted cash flow (DCF), comparable transactions, market multiples, cost approach, income approach, or hybrid.']

  Note: 'Master record for greenfield and brownfield infrastructure project investments, capturing project name, development stage (pre-construction, construction, operational ramp-up, steady-state), project type (PPP, PFI, availability-payment, merchant), total'
}

Table infrastructure.infrastructure_capital_call {
  infrastructure_capital_call_id varchar [pk, note: 'Unique identifier for the infrastructure capital call record.']
  actor_id varchar [note: 'Reference to the third-party fund administrator managing capital call processing and settlement.']
  approver_employee_id varchar [note: 'Reference to the internal user or Investment Committee (IC) member who approved the capital call funding.']
  capital_call_notice_document_id varchar [note: 'Reference to the stored capital call notice document received from the General Partner (GP).']
  cash_account_id varchar [note: 'Reference to the bank account or cash account used to settle the capital call payment.']
  employee_id varchar [note: 'Reference to the internal user or Investment Committee (IC) member who approved the capital call funding.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) entity issuing the capital call notice.']
  infra_fund_commitment_id varchar [note: 'Reference to the infrastructure fund issuing the capital call.']
  infrastructure_fund_id varchar [note: 'Reference to the infrastructure fund issuing the capital call.']
  project_investment_id varchar [note: 'Reference to the specific infrastructure investment or co-investment for which capital is being called.']
  approval_date date [note: 'Date on which internal approval was granted to fund the capital call.']
  base_currency_amount decimal(18,2) [note: 'Capital call amount converted to the pension fund base currency using the applicable foreign exchange rate.']
  call_amount decimal(18,2) [note: 'Total amount of capital being called from the Limited Partner (LP) in this drawdown notice.']
  call_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the capital call amount.']
  call_due_date date [note: 'Date by which the Limited Partner (LP) must fund the called capital amount.']
  call_notes varchar [note: 'Additional notes, instructions, or commentary provided by the General Partner (GP) or fund administrator regarding the capital call.']
  call_notice_date date [note: 'Date on which the capital call notice was issued by the General Partner (GP).']
  call_notice_number varchar [note: 'Unique business identifier assigned by the General Partner (GP) or fund administrator to the capital call notice.']
  call_purpose varchar [note: 'Primary purpose or reason for the capital call as stated in the notice.']
  call_sequence_number varchar [note: 'Sequential number of this capital call within the fund or investment lifecycle, indicating the drawdown order.']
  call_status varchar [note: 'Current lifecycle status of the capital call from issuance through funding completion.']
  call_type varchar [note: 'Classification of the capital call based on timing, urgency, or purpose within the fund lifecycle.']
  commitment_amount decimal(18,2) [note: 'Total capital commitment of the Limited Partner (LP) to the infrastructure fund or co-investment vehicle.']
  created_timestamp timestamp [note: 'Timestamp when the capital call record was first created in the data platform.']
  cumulative_pic decimal(18,2) [note: 'Total Paid-In Capital (PIC) to date including this capital call, representing cumulative capital drawn from the Limited Partner (LP).']
  default_interest_rate decimal(5,4) [note: 'Annual interest rate applicable to late or unfunded capital call amounts as specified in the Limited Partnership Agreement (LPA).']
  expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to fund operating expenses, legal fees, or other partnership costs.']
  funded_amount decimal(18,2) [note: 'Actual amount funded by the Limited Partner (LP) in response to the capital call, which may differ from the called amount.']
  funding_date date [note: 'Actual date on which the Limited Partner (LP) funded the capital call amount.']
  fx_rate decimal(12,6) [note: 'Foreign exchange rate applied if the capital call currency differs from the pension fund base currency.']
  internal_approval_status varchar [note: 'Status of internal approval workflow for funding the capital call within the pension fund organization.']
  investment_amount decimal(18,2) [note: 'Portion of the capital call allocated to direct infrastructure investment or co-investment acquisition.']
  is_emergency_call boolean [note: 'Indicates whether this capital call was issued on an emergency or expedited basis requiring shorter notice period.']
  late_payment_penalty decimal(18,2) [note: 'Penalty amount assessed for late or partial funding of the capital call.']
  lpa_reference varchar [note: 'Reference to the specific Limited Partnership Agreement (LPA) section or clause governing this capital call.']
  management_fee_amount decimal(18,2) [note: 'Portion of the capital call allocated to management fees payable to the General Partner (GP).']
  notice_period_days varchar [note: 'Number of days between the capital call notice date and the due date, representing the advance notice provided to the Limited Partner (LP).']
  other_amount decimal(18,2) [note: 'Portion of the capital call allocated to other purposes not classified as investment, fees, or expenses.']
  payment_method varchar [note: 'Method or instrument used by the Limited Partner (LP) to fund the capital call.']
  payment_reference_number varchar [note: 'Transaction reference or confirmation number associated with the capital call payment.']
  source_system_code varchar [note: 'Unique identifier of the capital call record in the source operational system.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future drawdowns, also known as Dry Powder.']
  updated_timestamp timestamp [note: 'Timestamp when the capital call record was last modified in the data platform.']

  Note: 'Transactional record of capital call (drawdown) notices received from infrastructure fund GPs or issued for direct co-investments. Captures call notice date, due date, called amount, cumulative PIC to date, call purpose (investment, fees, expenses'
}

Table infrastructure.distribution_event {
  distribution_event_id varchar [pk, note: 'Unique identifier for the distribution event record.']
  cash_flow_event_id varchar [note: 'Foreign key linking to treasury.cash_flow_event. Business justification: Distribution event triggers a cash flow event in treasury for cash movement recording.']
  custody_account_id varchar [note: 'Reference to the custody account into which the distribution was received.']
  distribution_employee_id varchar [note: 'Reference to the user who created this distribution event record.']
  distribution_notice_document_id varchar [note: 'Reference to the formal distribution notice document received from the General Partner (GP).']
  distribution_updated_by_user_employee_id varchar [note: 'Reference to the user who last updated this distribution event record.']
  employee_id varchar [note: 'Reference to the user who created this distribution event record.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) or asset operator entity that issued the distribution.']
  infra_asset_id varchar [note: 'Reference to the direct infrastructure asset generating the distribution, if applicable.']
  infra_fund_commitment_id varchar [note: 'Reference to the infrastructure fund from which the distribution was received.']
  infrastructure_fund_id varchar [note: 'Reference to the infrastructure fund from which the distribution was received.']
  updated_by_user_employee_id varchar [note: 'Reference to the user who last updated this distribution event record.']
  accounting_period varchar [note: 'Accounting period to which this distribution is attributed for performance and financial reporting, in format YYYY-QN or YYYY-MM.']
  created_timestamp timestamp [note: 'Timestamp when this distribution event record was first created in the system.']
  distribution_amount decimal(18,2) [note: 'The gross amount of the distribution received in the fund or asset base currency.']
  distribution_amount_local decimal(18,2) [note: 'Distribution amount in the reporting currency of the pension fund for consolidated reporting.']
  distribution_currency varchar [note: 'Three-letter ISO 4217 currency code for the distribution amount.']
  distribution_date date [note: 'The date on which the distribution was paid or credited to the Limited Partner (LP).']
  distribution_memo varchar [note: 'Narrative description or memo provided by the General Partner (GP) explaining the nature and context of the distribution.']
  distribution_number varchar [note: 'External reference number or identifier assigned by the General Partner (GP) or asset operator to this distribution event.']
  distribution_source varchar [note: 'Economic source of the distribution: operating cash flow, asset sale proceeds, refinancing, recapitalization, dividend, interest income, or other. [ENUM-REF-CANDIDATE: operating_cash_flow|asset_sale|refinancing|recapitalization|dividend|interest|other — 7']
  distribution_status varchar [note: 'Current lifecycle status of the distribution event: pending notification, received, reconciled, recalled by GP, disputed, or cancelled.']
  distribution_type varchar [note: 'Classification of the distribution: income (operating cash flow), return of capital, recallable capital, carried interest, preferred return, or other.']
  dpi decimal(10,4) [note: 'Cumulative distributions to paid-in capital ratio as of this distribution event, measuring cash returned to investors relative to capital called.']
  esg_classification varchar [note: 'Sustainable Finance Disclosure Regulation (SFDR) classification of the underlying asset or fund generating the distribution.']
  fx_rate decimal(12,6) [note: 'Exchange rate applied to convert distribution amount from fund currency to local reporting currency.']
  gp_notification_date date [note: 'Date on which the General Partner (GP) notified the Limited Partner (LP) of the upcoming distribution.']
  irr_impact decimal(10,4) [note: 'Incremental impact of this distribution on the cumulative Internal Rate of Return (IRR) of the fund or asset, expressed as a decimal.']
  liability_matching_allocation decimal(18,2) [note: 'Portion of the distribution allocated to liability-driven investment (LDI) strategies for actuarial liability matching.']
  moic_impact decimal(10,4) [note: 'Incremental impact of this distribution on the cumulative Multiple on Invested Capital (MOIC) of the fund or asset.']
  net_distribution_amount decimal(18,2) [note: 'Net distribution amount received after deduction of withholding taxes and other fees.']
  payment_method varchar [note: 'Method by which the distribution was paid: wire transfer, Automated Clearing House (ACH), check, in-kind transfer, or other.']
  recall_expiry_date date [note: 'Date after which the distribution can no longer be recalled by the General Partner (GP), if applicable.']
  recallable_flag boolean [note: 'Indicates whether this distribution is subject to recall by the General Partner (GP) under the Limited Partnership Agreement (LPA) terms.']
  reconciliation_date date [note: 'Date on which the distribution was reconciled against General Partner (GP) reporting and custody records.']
  reconciliation_variance_amount decimal(18,2) [note: 'Variance amount identified during reconciliation between expected and actual distribution received.']
  reinvestment_flag boolean [note: 'Indicates whether the distribution was automatically reinvested into the fund or asset under a reinvestment program.']
  rvpi decimal(10,4) [note: 'Residual value to paid-in capital ratio as of this distribution event, representing unrealized value remaining in the fund.']
  settlement_date date [note: 'Date on which the distribution cash was settled and received in the pension fund custody account.']
  tax_jurisdiction varchar [note: 'Three-letter ISO country code representing the tax jurisdiction where withholding tax was applied.']
  tax_treaty_rate decimal(5,4) [note: 'Applicable withholding tax rate under bilateral tax treaty, expressed as a decimal (e.g., 0.15 for 15%).']
  tvpi decimal(10,4) [note: 'Total value to paid-in capital ratio as of this distribution event, combining distributions and residual Net Asset Value (NAV).']
  updated_timestamp timestamp [note: 'Timestamp when this distribution event record was last modified.']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted at source from the distribution by the jurisdiction of the asset or fund.']

  Note: 'Transactional record of cash distributions received from infrastructure fund GPs or direct asset operating entities. Captures distribution date, distribution amount, distribution type (return of capital, income, recallable capital, carried interest), DPI'
}

Table infrastructure.cashflow_projection {
  cashflow_projection_id varchar [pk, note: 'Unique identifier for the cash flow projection record.']
  economic_scenario_id varchar [note: 'Reference to the macroeconomic scenario or market outlook used as the basis for this cash flow projection.']
  employee_id varchar [note: 'Reference to the investment analyst or team member responsible for preparing this cash flow projection.']
  infra_asset_id varchar [note: 'Reference to the direct infrastructure asset or project investment for which cash flows are projected.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Cashflow projections are critical for greenfield/brownfield project investments during development phase before they become operational assets.']
  approval_date date [note: 'The date on which this cash flow projection was formally approved by the investment committee or authorized officer.']
  approval_status varchar [note: 'Current approval status of the cash flow projection within the investment governance workflow.']
  approved_by varchar [note: 'Name or identifier of the investment committee member or senior officer who approved this cash flow projection.']
  asset_lifecycle_stage varchar [note: 'The lifecycle stage of the infrastructure asset: greenfield development, brownfield expansion, operational, mature, or decommissioning.']
  concession_expiry_date date [note: 'The date on which the concession agreement or operating license for the infrastructure asset expires, impacting long-duration cash flow projections.']
  created_timestamp timestamp [note: 'The timestamp when this cash flow projection record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this cash flow projection.']
  discount_rate decimal(8,4) [note: 'The discount rate applied to the projected cash flows for present value calculation, typically based on WACC or hurdle rate.']
  esg_adjustment_factor decimal(6,4) [note: 'Adjustment factor applied to cash flow projections to account for ESG risks or opportunities, such as carbon pricing or social license impacts.']
  forecast_frequency varchar [note: 'The periodicity of the cash flow projection: annual, semi-annual, quarterly, or monthly.']
  forecast_period_end_date date [note: 'The ending date of the forecast period for this cash flow projection.']
  forecast_period_start_date date [note: 'The beginning date of the forecast period for this cash flow projection.']
  inflation_assumption decimal(6,4) [note: 'The assumed inflation rate used in the cash flow projection model for revenue and cost escalation.']
  liability_matching_flag boolean [note: 'Indicates whether this cash flow projection is aligned with the pension funds liability-driven investment and actuarial liability matching strategy.']
  notes varchar [note: 'Free-text notes providing additional context, assumptions, or qualitative commentary on the cash flow projection.']
  projected_capex decimal(18,2) [note: 'Forecasted capital expenditures required for maintenance, expansion, or improvement of the infrastructure asset during the forecast period.']
  projected_debt_service decimal(18,2) [note: 'Forecasted debt service payments including principal and interest for the infrastructure asset during the forecast period.']
  projected_distribution decimal(18,2) [note: 'Forecasted cash distribution to the pension fund as LP from the infrastructure asset during the forecast period.']
  projected_ebitda decimal(18,2) [note: 'Forecasted EBITDA for the infrastructure asset during the forecast period, representing operational cash generation capacity.']
  projected_free_cashflow decimal(18,2) [note: 'Forecasted free cash flow available to equity holders after operating expenses, capital expenditures, and debt service.']
  projected_operating_expense decimal(18,2) [note: 'Forecasted operating expenses for the infrastructure asset during the forecast period.']
  projected_revenue decimal(18,2) [note: 'Forecasted revenue for the infrastructure asset during the forecast period.']
  projection_date date [note: 'The date on which this cash flow projection was generated or last updated.']
  projection_model_version varchar [note: 'Version identifier of the cash flow projection model or template used to generate this forecast.']
  projection_scenario varchar [note: 'Scenario classification for the cash flow projection: base case, upside, downside, stress test, or sensitivity analysis.']
  regulated_return_rate decimal(6,4) [note: 'The regulated rate of return allowed by regulatory authorities for regulated infrastructure assets such as utilities.']
  revenue_growth_assumption decimal(6,4) [note: 'The assumed annual revenue growth rate applied in the cash flow projection.']
  sensitivity_adjustment decimal(8,4) [note: 'The magnitude of adjustment applied to the sensitivity parameter for scenario analysis, expressed as a percentage or absolute value.']
  sensitivity_parameter varchar [note: 'The key variable being stress-tested in sensitivity scenarios, such as discount rate, revenue growth, or inflation.']
  updated_timestamp timestamp [note: 'The timestamp when this cash flow projection record was last modified.']

  Note: 'Transactional record of long-duration cash flow projections for direct infrastructure assets and project investments, capturing projection scenario (base, upside, downside, stress), projection date, forecast period (annual/quarterly), projected revenue'
}

Table infrastructure.infrastructure_asset_valuation {
  infrastructure_asset_valuation_id varchar [pk, note: 'Unique identifier for the infrastructure asset valuation record.']
  infra_asset_id varchar [note: 'Reference to the direct infrastructure asset being valued.']
  appraisal_report_date date [note: 'The date the independent appraisal report was issued.']
  capex_assumption decimal(20,2) [note: 'The annual capital expenditure assumption used in the cash flow projections.']
  cash_flow_projection_period_years varchar [note: 'The number of years of explicit cash flow projections used in the Discounted Cash Flow (DCF) valuation model.']
  comparable_company_count varchar [note: 'The number of comparable publicly traded companies analyzed to derive valuation multiples.']
  comparable_transaction_count varchar [note: 'The number of comparable market transactions analyzed to derive valuation multiples.']
  concession_remaining_term_years varchar [note: 'The number of years remaining in the concession agreement or regulatory license at the valuation date.']
  control_premium_rate decimal(6,5) [note: 'The control premium rate applied to reflect the value of controlling interest, expressed as a decimal (e.g., 0.15000 for 15%).']
  country_risk_premium decimal(6,5) [note: 'The country risk premium added to the discount rate to reflect sovereign and political risk, expressed as a decimal (e.g., 0.02500 for 2.5%).']
  created_timestamp timestamp [note: 'The timestamp when this valuation record was first created in the system.']
  discount_rate decimal(8,5) [note: 'The Weighted Average Cost of Capital (WACC) or discount rate applied in the Discounted Cash Flow (DCF) valuation, expressed as a decimal (e.g., 0.08500 for 8.5%).']
  ebitda_multiple decimal(8,2) [note: 'The Enterprise Value to Earnings Before Interest Taxes Depreciation and Amortization (EV/EBITDA) multiple applied in comparable company or transaction valuation.']
  esg_adjustment_factor decimal(6,5) [note: 'The Environmental Social and Governance (ESG) adjustment factor applied to the valuation to reflect sustainability risks and opportunities, expressed as a decimal.']
  fair_value_amount decimal(20,2) [note: 'The assessed fair value of the infrastructure asset in the reporting currency.']
  fair_value_currency varchar [note: 'Three-letter ISO 4217 currency code for the fair value amount.']
  fair_value_hierarchy_level varchar [note: 'The International Financial Reporting Standards (IFRS) 13 fair value hierarchy classification: Level 1 (quoted prices in active markets), Level 2 (observable inputs), or Level 3 (unobservable inputs).']
  independent_appraiser varchar [note: 'The name of the independent third-party valuation firm or appraiser engaged to perform the fair value assessment.']
  liquidity_discount_rate decimal(6,5) [note: 'The liquidity discount rate applied to reflect the illiquidity of the infrastructure asset, expressed as a decimal (e.g., 0.20000 for 20%).']
  net_working_capital_assumption decimal(20,2) [note: 'The net working capital requirement assumption used in the cash flow projections.']
  operating_margin_assumption decimal(6,5) [note: 'The assumed operating margin (Earnings Before Interest Taxes Depreciation and Amortization (EBITDA) margin) used in the valuation model, expressed as a decimal (e.g., 0.35000 for 35%).']
  prior_valuation_amount decimal(20,2) [note: 'The fair value amount from the immediately preceding valuation for variance analysis.']
  rab_multiple decimal(8,4) [note: 'The Regulated Asset Base (RAB) multiple applied for valuing regulated infrastructure assets, representing the ratio of enterprise value to RAB.']
  regulatory_framework varchar [note: 'The regulatory framework governing the infrastructure asset (e.g., rate-of-return regulation, price cap, revenue cap, availability-based).']
  revenue_forecast_base_year varchar [note: 'The base year from which revenue projections were extrapolated in the valuation model.']
  revenue_growth_rate_assumption decimal(6,5) [note: 'The assumed compound annual revenue growth rate used in the cash flow projections, expressed as a decimal (e.g., 0.03000 for 3%).']
  tax_rate_assumption decimal(6,5) [note: 'The effective tax rate assumption applied in the cash flow projections, expressed as a decimal (e.g., 0.25000 for 25%).']
  terminal_growth_rate decimal(6,5) [note: 'The perpetual growth rate assumption applied to calculate terminal value in Discounted Cash Flow (DCF) models, expressed as a decimal (e.g., 0.02500 for 2.5%).']
  terminal_value decimal(20,2) [note: 'The terminal value component of the Discounted Cash Flow (DCF) valuation representing the asset value beyond the explicit forecast period.']
  updated_timestamp timestamp [note: 'The timestamp when this valuation record was last modified.']
  valuation_adjustment_amount decimal(20,2) [note: 'The total amount of adjustments applied to the base valuation for factors such as control premium, liquidity discount, or country risk.']
  valuation_change_amount decimal(20,2) [note: 'The absolute change in fair value from the prior valuation to the current valuation.']
  valuation_change_percentage decimal(8,5) [note: 'The percentage change in fair value from the prior valuation, expressed as a decimal (e.g., 0.05000 for 5%).']
  valuation_committee_approval_date date [note: 'The date the valuation was approved by the internal Valuation Committee or Investment Committee (IC).']
  valuation_confidence_level varchar [note: 'The confidence level in the valuation assessment based on data quality, market observability, and assumption robustness: High, Medium, or Low.']
  valuation_date date [note: 'The date as of which the fair value assessment was performed.']
  valuation_method varchar [note: 'The methodology applied to determine fair value: Discounted Cash Flow (DCF), Enterprise Value to Earnings Before Interest Taxes Depreciation and Amortization (EV/EBITDA) comparable, Regulated Asset Base (RAB) multiple, independent appraisal, market']
  valuation_notes varchar [note: 'Additional notes, assumptions, or qualifications related to the valuation assessment.']
  valuation_preparer varchar [note: 'The name or identifier of the internal analyst or team who prepared the valuation.']
  valuation_reviewer varchar [note: 'The name or identifier of the senior analyst or manager who reviewed and validated the valuation.']
  valuation_sensitivity_scenario varchar [note: 'The sensitivity scenario applied (e.g., base case, upside case, downside case, stress scenario) for risk assessment.']
  valuation_status varchar [note: 'The current lifecycle status of the valuation record: Draft, Under Review, Approved, Final, or Superseded.']
  valuation_type varchar [note: 'The purpose or frequency of the valuation: Quarterly Net Asset Value (NAV) determination, Annual reporting, Transaction support, Impairment test, or Ad-hoc request.']
  valuation_variance_explanation varchar [note: 'Narrative explanation of the key drivers of valuation change from the prior period (e.g., operational performance, market conditions, discount rate movement).']

  Note: 'Transactional record of periodic fair value assessments for direct infrastructure assets, capturing valuation date, valuation methodology (DCF, EV/EBITDA comparable, RAB multiple, independent appraisal), discount rate applied (WACC), terminal value'
}

Table infrastructure.infrastructure_debt_facility {
  infrastructure_debt_facility_id varchar [pk, note: 'Unique identifier for the infrastructure debt facility record.']
  infra_asset_id varchar [note: 'Reference to the underlying infrastructure asset or project financed by this debt facility.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Infrastructure debt facilities are often structured at the project level for greenfield investments.']
  all_in_rate_percent decimal(8,4) [note: 'Total effective interest rate including base rate, spread, and fees expressed as a percentage.']
  amortization_schedule varchar [note: 'Structure of principal repayment over the life of the facility.']
  arrangement_fee_amount decimal(18,2) [note: 'Upfront fee paid to the lender for arranging and structuring the debt facility.']
  base_rate_index varchar [note: 'Reference rate index for floating rate facilities such as SOFR, EURIBOR, or LIBOR successor rates.']
  commitment_fee_bps decimal(8,2) [note: 'Annual fee charged on the undrawn portion of the facility expressed in basis points.']
  covenant_package varchar [note: 'Summary description of financial covenants including DSCR, LTV, and other maintenance ratios.']
  created_timestamp timestamp [note: 'System timestamp when this facility record was first created in the data platform.']
  credit_rating varchar [note: 'External credit rating assigned to the debt facility by rating agencies.']
  drawn_amount decimal(20,2) [note: 'Current outstanding principal amount drawn down from the facility.']
  dscr_covenant decimal(6,2) [note: 'Minimum required DSCR covenant threshold that must be maintained throughout the facility life.']
  esg_linked_pricing boolean [note: 'Indicates whether the facility includes ESG-linked pricing adjustments based on sustainability performance.']
  expected_credit_loss_amount decimal(18,2) [note: 'Calculated expected credit loss provision under IFRS 9 impairment model.']
  facility_agent varchar [note: 'Name of the institution acting as facility agent responsible for administration and coordination.']
  facility_amount decimal(20,2) [note: 'Total committed amount of the debt facility as documented in the credit agreement.']
  facility_currency varchar [note: 'ISO 4217 three-letter currency code in which the facility is denominated.']
  facility_identifier varchar [note: 'External unique identifier or reference code for the debt facility used by lenders and administrators.']
  facility_name varchar [note: 'Business name or title of the debt facility as documented in the credit agreement.']
  facility_status varchar [note: 'Current operational status of the debt facility in its lifecycle.']
  facility_type varchar [note: 'Classification of the debt facility structure indicating seniority and security position. [ENUM-REF-CANDIDATE: senior_secured|mezzanine|subordinated|green_bond|infrastructure_bond|revolving_credit|term_loan — 7 candidates stripped; promote to reference']
  fair_value_amount decimal(20,2) [note: 'Most recent fair value of the debt facility for financial reporting purposes.']
  first_drawdown_date date [note: 'Date of the first principal drawdown from the facility.']
  governing_law varchar [note: 'Legal jurisdiction whose laws govern the facility agreement.']
  green_bond_certified boolean [note: 'Indicates whether the facility is certified as a green bond under recognized ESG standards.']
  impairment_stage varchar [note: 'Current IFRS 9 impairment stage classification for expected credit loss provisioning.']
  interest_payment_frequency varchar [note: 'Frequency at which interest payments are due under the facility agreement.']
  interest_rate_type varchar [note: 'Classification of the interest rate structure applied to the facility.']
  last_modified_timestamp timestamp [note: 'System timestamp when this facility record was last updated.']
  last_valuation_date date [note: 'Date of the most recent fair value or mark-to-market valuation of the debt facility.']
  lead_arranger varchar [note: 'Name of the lead arranger or bookrunner for syndicated facilities.']
  lender_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the lender institution.']
  lender_name varchar [note: 'Name of the financial institution or syndicate providing the debt facility.']
  ltv_covenant_percent decimal(6,2) [note: 'Maximum permitted LTV ratio covenant expressed as a percentage of asset value.']
  maturity_date date [note: 'Scheduled final maturity date when all outstanding principal and interest must be repaid.']
  origination_date date [note: 'Date when the debt facility agreement was executed and became effective.']
  prepayment_penalty_percent decimal(6,2) [note: 'Penalty rate applied to voluntary prepayments expressed as a percentage of prepaid principal.']
  prepayment_permitted boolean [note: 'Indicates whether voluntary prepayment of principal is permitted under the facility terms.']
  rating_agency varchar [note: 'Name of the rating agency that assigned the credit rating.']
  repayment_frequency varchar [note: 'Frequency at which principal repayments are scheduled.']
  security_type varchar [note: 'Nature of security or collateral pledged to secure the debt facility.']
  spread_bps decimal(8,2) [note: 'Credit spread over the base rate index expressed in basis points.']
  syndicated_facility boolean [note: 'Indicates whether the facility is syndicated among multiple lenders.']
  tenor_years decimal(6,2) [note: 'Total duration of the facility from origination to maturity expressed in years.']
  undrawn_amount decimal(20,2) [note: 'Remaining available commitment that has not yet been drawn.']

  Note: 'Master record for project-level and asset-level debt financing facilities associated with infrastructure investments, capturing lender name, facility type (senior secured, mezzanine, subordinated, green bond, infrastructure bond), facility amount, drawn'
}

Table infrastructure.co_investment {
  co_investment_id varchar [pk, note: 'Unique identifier for the infrastructure co-investment transaction record.']
  deal_opportunity_id varchar [note: 'Reference to the parent deal opportunity from which this co-investment originated.']
  gp_entity_id varchar [note: 'Reference to the lead general partner or sponsor alongside whom the pension fund is co-investing.']
  gp_sponsor_gp_entity_id varchar [note: 'Reference to the lead general partner or sponsor alongside whom the pension fund is co-investing.']
  infra_asset_id varchar [note: 'Reference to the underlying infrastructure asset or project being co-invested.']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Co-investments often occur alongside LP commitments to infrastructure funds.']
  opportunity_id varchar [note: 'Reference to the parent deal opportunity from which this co-investment originated.']
  actual_exit_date date [note: 'Actual date on which the pension fund fully exited the co-investment position.']
  asset_class varchar [note: 'Primary asset class category to which this co-investment belongs for portfolio allocation and reporting.']
  asset_location_country varchar [note: 'Three-letter ISO country code representing the primary geographic location of the underlying infrastructure asset.']
  board_approval_date date [note: 'Date on which the Board of Directors approved the co-investment, if board approval was required.']
  board_approval_required_flag boolean [note: 'Boolean indicator of whether Board of Directors approval was required for this co-investment due to size or strategic significance.']
  co_investment_code varchar [note: 'Unique alphanumeric code assigned to the co-investment for internal tracking and system integration.']
  co_investment_name varchar [note: 'Business name or title of the co-investment transaction for identification and reporting purposes.']
  commitment_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to this co-investment transaction.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code in which the commitment amount is denominated.']
  commitment_date date [note: 'Date on which the pension fund formally committed capital to the co-investment transaction.']
  concession_expiry_date date [note: 'Date on which the concession agreement or operating license for the infrastructure asset expires, if applicable.']
  created_timestamp timestamp [note: 'System timestamp indicating when this co-investment record was first created in the system.']
  current_nav decimal(18,2) [note: 'Most recent net asset value of the co-investment position as of the latest valuation date.']
  distributions_received decimal(18,2) [note: 'Cumulative distributions received by the pension fund from the co-investment to date.']
  esg_assessment_date date [note: 'Date on which the most recent ESG rating or assessment was conducted.']
  esg_rating varchar [note: 'Current ESG rating or score assigned to the co-investment based on responsible investment assessment.']
  expected_exit_date date [note: 'Projected date for full exit or realization of the co-investment based on investment thesis and asset lifecycle.']
  final_close_date date [note: 'Date on which the co-investment reached final close and no further commitments are accepted.']
  first_funding_date date [note: 'Date of the initial capital drawdown or funding event for this co-investment.']
  funded_amount decimal(18,2) [note: 'Total capital amount actually funded or drawn down to date on this co-investment.']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved the co-investment transaction.']
  infrastructure_sector varchar [note: 'Specific infrastructure sector classification such as transportation, energy, utilities, social infrastructure, or telecommunications.']
  investment_status varchar [note: 'Current lifecycle status of the co-investment indicating its stage from pipeline through exit or write-off.']
  investment_team varchar [note: 'Name of the internal investment team or department responsible for this co-investment.']
  investment_type varchar [note: 'Classification of the investment structure indicating whether it is a direct investment, co-investment, club deal, or secondary transaction.']
  investment_vehicle_structure varchar [note: 'Legal structure of the co-investment vehicle such as limited partnership, special purpose vehicle, or direct holding entity.']
  jurisdiction varchar [note: 'Three-letter ISO country code representing the legal jurisdiction in which the co-investment vehicle is domiciled.']
  last_modified_timestamp timestamp [note: 'System timestamp indicating when this co-investment record was most recently updated.']
  lead_investment_professional varchar [note: 'Name of the senior investment professional responsible for originating and managing this co-investment.']
  notes varchar [note: 'Free-text field for additional commentary, strategic rationale, or special conditions related to the co-investment.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership stake held by the pension fund in the underlying infrastructure asset or project entity.']
  project_type varchar [note: 'Classification indicating whether the infrastructure project is greenfield (new construction), brownfield (expansion/upgrade), or operational (mature asset).']
  record_active_flag boolean [note: 'Boolean indicator of whether this co-investment record is currently active in the system for reporting and analytics.']
  regulated_asset_flag boolean [note: 'Boolean indicator of whether the infrastructure asset operates under a regulated return framework or concession agreement.']
  target_irr decimal(5,2) [note: 'Target internal rate of return percentage established at investment commitment for performance benchmarking.']
  target_moic decimal(5,2) [note: 'Target multiple on invested capital established at investment commitment for performance benchmarking.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future drawdowns on this co-investment.']
  valuation_date date [note: 'Date as of which the current net asset value was determined.']
  valuation_method varchar [note: 'Primary valuation methodology applied to determine fair value such as discounted cash flow, market comparable, or cost basis.']
  vintage_year varchar [note: 'Calendar year in which the co-investment commitment was made, used for cohort performance analysis.']

  Note: 'Master record for infrastructure co-investment transactions where the pension fund invests alongside a GP or lead sponsor in a specific asset or project, outside of a fund vehicle.'
}

Table infrastructure.tariff_schedule {
  tariff_schedule_id varchar [pk, note: 'Unique identifier for the tariff schedule record. Primary key for the tariff schedule entity.']
  concession_agreement_id varchar [note: 'Reference to the concession agreement or regulated contract that governs the tariff schedule terms, including revenue rights and regulatory obligations.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset to which this tariff schedule applies, such as toll road, bridge, airport, port, or utility network.']
  superseded_by_tariff_schedule_id varchar [note: 'Reference to the tariff schedule that supersedes this schedule. Null if this is the current active schedule.']
  active_flag boolean [note: 'Indicates whether the tariff schedule is currently active and applicable for revenue generation. False if superseded or expired.']
  allowed_return_rate decimal(8,4) [note: 'Allowed rate of return on invested capital as determined by the regulatory authority, expressed as a percentage. Used in regulated return models to set tariff levels.']
  base_tariff_rate decimal(18,4) [note: 'Base rate or charge per unit of usage before any adjustments, escalations, or discounts. Expressed in the tariff currency per unit of measure.']
  created_by_user varchar [note: 'Identifier of the user or system that created the tariff schedule record.']
  created_timestamp timestamp [note: 'Timestamp when the tariff schedule record was first created in the system.']
  discount_eligibility_flag boolean [note: 'Indicates whether this tariff schedule is eligible for discounts, such as volume discounts, loyalty discounts, or social tariffs for vulnerable users.']
  effective_date date [note: 'Date from which the tariff schedule becomes effective and applicable to revenue generation.']
  environmental_levy_flag boolean [note: 'Indicates whether the tariff schedule includes an environmental levy or surcharge to fund environmental mitigation, carbon offset, or sustainability initiatives.']
  environmental_levy_rate decimal(18,4) [note: 'Rate of the environmental levy or surcharge included in the tariff, expressed in the tariff currency per unit of measure. Null if environmental levy flag is false.']
  escalation_index varchar [note: 'Specific inflation index or benchmark used for tariff escalation, such as national CPI, regional RPI, or sector-specific index.']
  escalation_rate decimal(8,4) [note: 'Annual escalation rate applied to the base tariff rate, expressed as a percentage. Used when escalation method is fixed percentage.']
  expiry_date date [note: 'Date on which the tariff schedule ceases to be effective. Null if the tariff schedule is open-ended or subject to regulatory review.']
  inflation_escalation_method varchar [note: 'Method by which the tariff rate is escalated over time to account for inflation, such as Consumer Price Index (CPI) linkage, Retail Price Index (RPI) linkage, fixed annual percentage increase, revenue cap, price cap, or no escalation.']
  last_modified_by_user varchar [note: 'Identifier of the user or system that last modified the tariff schedule record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the tariff schedule record was last modified or updated.']
  maximum_charge decimal(18,4) [note: 'Maximum charge or cap applicable under this tariff schedule, used to protect users from excessive charges or to comply with regulatory price caps.']
  minimum_charge decimal(18,4) [note: 'Minimum charge applicable under this tariff schedule, regardless of usage volume. Used to ensure cost recovery for fixed infrastructure costs.']
  next_review_date date [note: 'Scheduled date for the next regulatory review of the tariff schedule.']
  peak_off_peak_flag boolean [note: 'Indicates whether the tariff schedule includes differentiated rates for peak and off-peak usage periods, common in utilities and transport infrastructure.']
  public_consultation_flag boolean [note: 'Indicates whether the tariff schedule was subject to public consultation as part of the regulatory approval process.']
  regulated_return_model varchar [note: 'Regulatory return model governing the tariff schedule, such as Regulated Asset Base (RAB) return, Rate of Return (ROR), price cap, revenue cap, hybrid model, or unregulated.']
  regulatory_approval_date date [note: 'Date on which the tariff schedule received regulatory approval from the governing authority.']
  regulatory_approval_status varchar [note: 'Current status of the tariff schedule in the regulatory approval process, indicating whether it is draft, submitted for approval, under regulatory review, approved, rejected, or superseded by a newer schedule.']
  regulatory_authority varchar [note: 'Name of the regulatory body or authority responsible for approving and overseeing the tariff schedule, such as national utility regulator, transport authority, or concession grantor.']
  revenue_sharing_flag boolean [note: 'Indicates whether revenues generated under this tariff schedule are subject to revenue sharing arrangements with government, concession grantor, or other stakeholders.']
  revenue_sharing_percentage decimal(8,4) [note: 'Percentage of tariff revenues that must be shared with government or concession grantor under revenue sharing arrangements. Null if revenue sharing flag is false.']
  social_tariff_flag boolean [note: 'Indicates whether this is a social tariff designed to provide subsidized rates for vulnerable or low-income users, as mandated by regulatory or social policy.']
  tariff_category varchar [note: 'Classification of the tariff by user or usage type, such as vehicle class for toll roads, passenger type for transit, commodity type for ports, capacity band for utilities, time-of-use for peak/off-peak pricing, or distance band for usage-based charges.']
  tariff_code varchar [note: 'Business identifier or code for the tariff schedule, used for external reference and regulatory reporting.']
  tariff_currency varchar [note: 'Three-letter ISO 4217 currency code in which the tariff rate is denominated.']
  tariff_description varchar [note: 'Detailed description of the tariff schedule, including its purpose, applicability, calculation methodology, and any special terms or conditions.']
  tariff_filing_reference varchar [note: 'Reference number or identifier for the regulatory filing or submission associated with this tariff schedule.']
  tariff_name varchar [note: 'Descriptive name of the tariff schedule, identifying the tariff type and applicable user segment.']
  tariff_review_frequency varchar [note: 'Frequency at which the tariff schedule is subject to regulatory review and potential adjustment, such as annual, biennial, quinquennial (every five years), ad hoc, or continuous review.']
  tariff_structure_type varchar [note: 'Type of tariff structure used, such as flat rate, tiered pricing, block pricing, time-of-use pricing, distance-based pricing, or capacity-based pricing.']
  unit_of_measure varchar [note: 'Unit of measure for the tariff rate, such as per vehicle passage, per passenger trip, per tonne, per kilowatt-hour, per cubic meter, or per kilometer.']
  user_class varchar [note: 'Specific user class or segment to which the tariff applies, such as light vehicle, heavy goods vehicle, passenger, freight, residential, commercial, or industrial user.']
  version_number varchar [note: 'Version number of the tariff schedule, incremented with each revision or amendment to track changes over time.']

  Note: 'Master record for tariff, toll, and user-charge schedules applicable to revenue-generating infrastructure assets, capturing tariff effective date, tariff category (vehicle class, passenger type, commodity type), base tariff rate, inflation escalation'
}

Table infrastructure.infrastructure_capex_program {
  infrastructure_capex_program_id varchar [pk, note: 'Unique identifier for the infrastructure capital expenditure program record.']
  infra_asset_id varchar [note: 'Reference to the parent infrastructure asset to which this capital expenditure program is associated.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Capital expenditure programs are essential for greenfield/brownfield project development.']
  actual_completion_date date [note: 'Actual date when all capital expenditure program activities were completed and assets commissioned.']
  actual_start_date date [note: 'Actual date when capital expenditure program execution activities commenced.']
  approval_authority varchar [note: 'Name or identifier of the Investment Committee or governance body that approved the capital expenditure program.']
  approval_date date [note: 'Date when the Investment Committee formally approved the capital expenditure program and budget.']
  asset_class_impact varchar [note: 'Description of how the capital expenditure program impacts the infrastructure asset class valuation and operational performance.']
  budget_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the approved budget and expenditure amounts.']
  budget_variance decimal(18,2) [note: 'Variance between total approved budget and current forecast total expenditure, indicating over or under budget position.']
  contingency_budget decimal(18,2) [note: 'Additional budget allocation reserved for unforeseen costs and risk mitigation during program execution.']
  contract_type varchar [note: 'Type of contractual arrangement used for executing the capital expenditure program with external contractors or vendors.']
  created_timestamp timestamp [note: 'Timestamp when the capital expenditure program record was first created in the system.']
  energy_efficiency_improvement_pct decimal(5,2) [note: 'Expected percentage improvement in energy efficiency resulting from the capital expenditure program implementation.']
  esg_impact_category varchar [note: 'Classification of the capital expenditure programs primary Environmental Social and Governance impact area.']
  expected_irr decimal(5,2) [note: 'Projected Internal Rate of Return for the capital expenditure program based on investment analysis and cash flow modeling.']
  expected_payback_period_years decimal(5,2) [note: 'Projected number of years required to recover the capital expenditure investment through generated cash flows.']
  expenditure_to_date decimal(18,2) [note: 'Cumulative capital expenditure amount spent on the program from inception to the current reporting date.']
  forecast_completion_date date [note: 'Current projected date for program completion based on execution progress and updated forecasts.']
  forecast_remaining_expenditure decimal(18,2) [note: 'Projected capital expenditure amount remaining to be spent to complete the program based on current forecasts.']
  funding_source varchar [note: 'Identification of the capital source or funding mechanism for the capital expenditure program such as internal reserves or external financing.']
  ghg_reduction_target_tonnes decimal(12,2) [note: 'Target reduction in annual Greenhouse Gas emissions measured in tonnes of carbon dioxide equivalent resulting from the capital expenditure program.']
  last_modified_timestamp timestamp [note: 'Timestamp when the capital expenditure program record was most recently updated or modified.']
  last_review_date date [note: 'Date of the most recent formal review of capital expenditure program progress, budget, and forecast by governance or management.']
  nav_impact_estimate decimal(18,2) [note: 'Estimated impact on the infrastructure assets Net Asset Value upon successful completion of the capital expenditure program.']
  next_review_date date [note: 'Scheduled date for the next formal review of capital expenditure program status and performance.']
  planned_completion_date date [note: 'Scheduled date for completion of all capital expenditure program activities and final asset commissioning.']
  planned_start_date date [note: 'Scheduled date for commencement of capital expenditure program execution activities.']
  primary_contractor varchar [note: 'Name of the main contractor or Engineering Procurement and Construction (EPC) firm responsible for program delivery.']
  program_code varchar [note: 'Unique business identifier or code assigned to the capital expenditure program for tracking and reference.']
  program_description varchar [note: 'Detailed narrative describing the scope, objectives, and business rationale for the capital expenditure program.']
  program_manager varchar [note: 'Name of the individual responsible for managing and overseeing execution of the capital expenditure program.']
  program_name varchar [note: 'Business name or title of the capital expenditure program for identification and reporting purposes.']
  program_notes varchar [note: 'Additional commentary, observations, or contextual information regarding the capital expenditure program execution and status.']
  program_status varchar [note: 'Current lifecycle status of the capital expenditure program indicating its execution stage.']
  program_type varchar [note: 'Classification of the capital expenditure program by its strategic purpose and investment objective.']
  record_status varchar [note: 'Operational status of the capital expenditure program record in the data system for data lifecycle management.']
  regulatory_reference varchar [note: 'Citation or reference to the specific regulatory requirement or compliance mandate driving the capital expenditure program.']
  regulatory_requirement_flag boolean [note: 'Indicates whether the capital expenditure program is mandated by regulatory or compliance requirements.']
  risk_rating varchar [note: 'Overall risk assessment rating for the capital expenditure program considering execution, financial, and operational risks.']
  strategic_rationale varchar [note: 'Business case and strategic justification for the capital expenditure program aligned with portfolio objectives.']
  total_approved_budget decimal(18,2) [note: 'Total capital expenditure budget amount approved by the Investment Committee (IC) for the program.']

  Note: 'Master record for capital expenditure programs associated with infrastructure assets, capturing capex program name, type (maintenance capex, growth capex, regulatory capex, environmental upgrade), total approved budget, expenditure to date, forecast'
}

Table infrastructure.availability_payment {
  availability_payment_id varchar [pk, note: 'Unique identifier for the availability payment transaction record.']
  cash_account_id varchar [note: 'Reference to the fund\'s bank account into which the availability payment was deposited.']
  concession_agreement_id varchar [note: 'Reference to the concession or PPP/PFI agreement governing this availability payment structure.']
  infra_asset_id varchar [note: 'Reference to the underlying infrastructure asset generating this availability payment.']
  accounting_period varchar [note: 'Accounting period to which this availability payment is allocated, in YYYY-MM format.']
  actual_payment_amount decimal(18,2) [note: 'Actual availability payment amount received after applying availability performance adjustments and deductions.']
  asset_operator_name varchar [note: 'Name of the entity responsible for operating the infrastructure asset and delivering the availability performance.']
  availability_actual_percentage decimal(5,2) [note: 'Actual availability percentage achieved during the payment period based on operational performance metrics.']
  availability_deduction_amount decimal(18,2) [note: 'Total deduction amount applied to the contracted payment due to availability performance falling below target thresholds.']
  availability_target_percentage decimal(5,2) [note: 'Contractual target availability percentage required to receive full payment for the period, typically 95-99%.']
  bonus_payment_amount decimal(18,2) [note: 'Additional bonus payment earned for exceeding availability or performance targets during the period.']
  contracted_payment_amount decimal(18,2) [note: 'Base availability payment amount as specified in the concession agreement for the period, assuming 100% availability.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the counterparty making the availability payment.']
  counterparty_name varchar [note: 'Name of the government authority, public entity, or contracting party making the availability payment.']
  created_by_user varchar [note: 'Username or identifier of the user who created this availability payment record.']
  created_timestamp timestamp [note: 'Timestamp when this availability payment record was first created in the system.']
  dispute_flag boolean [note: 'Indicates whether this payment is subject to a dispute between the fund and the counterparty regarding amount or performance calculation.']
  dispute_reason varchar [note: 'Description of the reason for payment dispute, if applicable.']
  force_majeure_hours decimal(10,2) [note: 'Hours of unavailability attributed to force majeure events, typically excluded from performance calculations.']
  gl_posting_date date [note: 'Date on which the availability payment was posted to the general ledger.']
  indexation_adjustment_amount decimal(18,2) [note: 'Inflation or indexation adjustment applied to the base payment amount per contractual escalation clauses.']
  indexation_basis varchar [note: 'The index or basis used for calculating payment escalation, such as Consumer Price Index or Retail Price Index.']
  indexation_rate_applied decimal(5,4) [note: 'The inflation or indexation rate percentage applied to adjust the payment amount for the period.']
  modified_by_user varchar [note: 'Username or identifier of the user who last modified this availability payment record.']
  modified_timestamp timestamp [note: 'Timestamp when this availability payment record was last modified.']
  net_payment_amount decimal(18,2) [note: 'Final net payment amount after all adjustments, deductions, bonuses, and withholdings have been applied.']
  payment_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the availability payment.']
  payment_due_date date [note: 'Contractual due date by which the availability payment is expected to be received.']
  payment_frequency varchar [note: 'Contractual frequency at which availability payments are made for this asset.']
  payment_method varchar [note: 'Method by which the availability payment was received.']
  payment_notes varchar [note: 'Free-text notes or comments regarding this availability payment transaction, including any special circumstances or adjustments.']
  payment_period_end_date date [note: 'End date of the service period for which this availability payment is calculated.']
  payment_period_start_date date [note: 'Start date of the service period for which this availability payment is calculated.']
  payment_received_date date [note: 'Actual date on which the availability payment was received into the fund\'s account.']
  payment_reference_number varchar [note: 'External reference number or invoice identifier for this availability payment as issued by the counterparty or asset operator.']
  payment_status varchar [note: 'Current lifecycle status of the availability payment transaction. [ENUM-REF-CANDIDATE: scheduled|invoiced|received|overdue|disputed|adjusted|cancelled — 7 candidates stripped; promote to reference product]']
  payment_type varchar [note: 'Classification of the payment within the contract lifecycle, distinguishing regular periodic payments from adjustments or settlements.']
  performance_deduction_amount decimal(18,2) [note: 'Additional deduction amount applied for performance failures beyond availability metrics, such as quality or service level breaches.']
  planned_maintenance_hours decimal(10,2) [note: 'Hours of scheduled maintenance during the period, which may be excluded from availability calculations per contract terms.']
  reconciliation_status varchar [note: 'Status of reconciliation between expected and actual payment amounts.']
  revenue_recognition_date date [note: 'Date on which revenue from this availability payment is recognized under IFRS 15 principles.']
  unavailability_hours decimal(10,2) [note: 'Total hours during the payment period when the asset was unavailable or failed to meet service requirements.']
  unplanned_outage_hours decimal(10,2) [note: 'Hours of unplanned downtime or service interruption that count against availability performance.']
  withholding_amount decimal(18,2) [note: 'Amount withheld from payment for tax, retention, or contractual holdback purposes.']

  Note: 'Transactional record of availability payment receipts for PPP/PFI infrastructure assets where revenue is based on asset availability rather than usage. Captures payment period, contracted availability payment amount, actual availability achieved'
}

Table infrastructure.asset_ownership {
  asset_ownership_id varchar [pk, note: 'Unique identifier for the infrastructure asset ownership record.']
  actor_id varchar [note: 'Reference to the lead sponsor or general partner managing the infrastructure investment.']
  co_investment_id varchar [note: 'Foreign key linking to infrastructure.co_investment. Business justification: Asset ownership records capture the ownership structure of infrastructure assets.']
  gp_entity_id varchar [note: 'Reference to the lead sponsor or general partner managing the infrastructure investment.']
  infra_asset_id varchar [note: 'Reference to the underlying infrastructure asset being owned.']
  ownership_agreement_id varchar [note: 'Reference to the legal agreement governing the ownership structure and rights for the infrastructure asset.']
  acquisition_date date [note: 'Date when the pension fund acquired its ownership stake in the infrastructure asset.']
  asset_class_alignment varchar [note: 'Risk-return profile classification of the infrastructure ownership stake within the pension funds strategic asset allocation framework.']
  board_seats_count varchar [note: 'Number of board or advisory committee seats held by the pension fund for the infrastructure asset.']
  co_invest_equity_stake_pct decimal(10,6) [note: 'Percentage of equity held by co-investment partners alongside the pension fund.']
  co_investor_count varchar [note: 'Number of co-investment partners participating alongside the pension fund in the infrastructure asset ownership.']
  consolidation_method varchar [note: 'Accounting method used to consolidate the infrastructure asset in the pension funds financial statements.']
  control_classification varchar [note: 'Classification of the pension funds level of control over the infrastructure asset based on ownership and governance rights.']
  created_timestamp timestamp [note: 'Timestamp when the ownership record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this ownership record.']
  distribution_waterfall_tier varchar [note: 'Current tier in the distribution waterfall structure determining how cash flows are allocated among stakeholders.']
  drag_along_rights_flag boolean [note: 'Indicates whether majority shareholders can compel the pension fund to participate in a sale transaction.']
  effective_ownership_date date [note: 'Date when legal and beneficial ownership rights became effective for the pension fund.']
  esg_ownership_rating varchar [note: 'ESG rating assigned to the ownership structure and governance practices for the infrastructure asset. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C — 9 candidates stripped; promote to reference product]']
  exit_strategy varchar [note: 'Planned exit strategy for the pension funds ownership stake in the infrastructure asset.']
  expected_exit_date date [note: 'Anticipated date when the pension fund plans to exit or divest its ownership stake in the infrastructure asset.']
  governance_rights_description varchar [note: 'Description of the pension funds governance rights including board seats, veto rights, and approval authorities for the infrastructure asset.']
  gp_carried_interest_pct decimal(10,6) [note: 'Percentage of profits allocated to the general partner as carried interest after hurdle rate is achieved.']
  gp_hurdle_rate_pct decimal(10,6) [note: 'Preferred return threshold that limited partners must achieve before general partner receives carried interest.']
  investment_vehicle_lei varchar [note: 'Legal Entity Identifier for the investment vehicle holding the ownership stake.']
  investment_vehicle_type varchar [note: 'Type of legal vehicle through which the pension fund holds its ownership stake in the infrastructure asset.']
  is_active boolean [note: 'Indicates whether this ownership record is currently active and valid for reporting and analytics.']
  last_modified_timestamp timestamp [note: 'Timestamp when the ownership record was last updated in the system.']
  last_valuation_date date [note: 'Date of the most recent valuation performed on the pension funds ownership stake in the infrastructure asset.']
  lead_sponsor_equity_stake_pct decimal(10,6) [note: 'Percentage of equity owned by the lead sponsor or general partner in the infrastructure asset.']
  lock_up_end_date date [note: 'Date when contractual restrictions on transferring or selling the ownership stake expire.']
  minority_partner_equity_stake_pct decimal(10,6) [note: 'Aggregate percentage of equity held by minority partners or other limited partners in the infrastructure asset.']
  ownership_notes varchar [note: 'Additional notes or commentary regarding the ownership structure, special terms, or unique arrangements for the infrastructure asset.']
  ownership_status varchar [note: 'Current lifecycle status of the ownership stake in the infrastructure asset.']
  ownership_structure_type varchar [note: 'Classification of the ownership arrangement for the infrastructure asset.']
  ownership_vintage_year varchar [note: 'Year in which the pension fund initially committed capital to acquire its ownership stake in the infrastructure asset.']
  paid_in_capital_amount decimal(20,2) [note: 'Total capital contributed by the pension fund to acquire and maintain its ownership stake in the infrastructure asset.']
  pension_fund_equity_stake_pct decimal(10,6) [note: 'Percentage of total equity owned directly by the pension fund in the infrastructure asset.']
  pension_fund_voting_rights_pct decimal(10,6) [note: 'Percentage of voting rights held by the pension fund, which may differ from equity stake due to share class structures.']
  preferred_return_pct decimal(10,6) [note: 'Preferred return rate that the pension fund is entitled to receive before other profit distributions.']
  record_source_system varchar [note: 'Name of the operational system from which this ownership record originated.']
  right_of_first_refusal_flag boolean [note: 'Indicates whether the pension fund has right of first refusal on additional equity issuances or stake sales.']
  tag_along_rights_flag boolean [note: 'Indicates whether the pension fund has tag-along rights to participate in third-party sale transactions.']
  unfunded_commitment_amount decimal(20,2) [note: 'Remaining capital commitment that the pension fund is obligated to fund for the infrastructure asset but has not yet paid in.']
  valuation_methodology varchar [note: 'Primary valuation methodology used to determine the fair value of the pension funds ownership stake.']
  veto_rights_flag boolean [note: 'Indicates whether the pension fund holds veto rights over major decisions for the infrastructure asset.']

  Note: 'Association record capturing the ownership and co-investment structure of each infrastructure asset: the pension fund\'s direct and co-invest equity stakes, co-investor and lead-sponsor stakes, GP carried-interest entitlement, and minority partner'
}

Table infrastructure.regulatory_review {
  regulatory_review_id varchar [pk, note: 'Unique identifier for the regulatory price review record. Primary key for the regulatory review entity.']
  infra_asset_id varchar [note: 'Reference to the regulated infrastructure asset subject to this price review.']
  regulated_return_model_id varchar [note: 'Foreign key linking to infrastructure.regulated_return_model. Business justification: Regulatory reviews assess and determine allowed returns for regulated infrastructure assets. The regulated_return_model defines the RAB and allowed-return framework.']
  allowed_return_on_equity_percent decimal(5,4) [note: 'Regulator-determined allowed return on equity expressed as a decimal percentage (e.g., 0.0650 for 6.50%), representing the cost of equity component in the Weighted Average Cost of Capital (WACC).']
  allowed_revenue_amount decimal(18,2) [note: 'Total allowed revenue determined by the regulator for the control period, representing the maximum revenue the asset operator may recover from customers.']
  allowed_revenue_currency varchar [note: 'Three-letter ISO 4217 currency code for the allowed revenue amount (e.g., GBP, USD, EUR).']
  allowed_wacc_percent decimal(5,4) [note: 'Regulator-determined Weighted Average Cost of Capital (WACC) expressed as a decimal percentage, used to calculate allowed returns on the Regulated Asset Base (RAB).']
  appeal_date date [note: 'Date on which an appeal was formally filed with the regulatory appeals body or tribunal.']
  appeal_decision_date date [note: 'Date on which the appeals body or tribunal issued its decision on the appeal.']
  appeal_filed_flag boolean [note: 'Boolean flag indicating whether the asset operator or other stakeholder has filed an appeal or challenge against the final determination.']
  appeal_outcome varchar [note: 'Outcome of the regulatory appeal: pending, upheld (determination overturned), partially upheld (determination modified), dismissed (determination stands), or withdrawn.']
  capex_allowance decimal(18,2) [note: 'Total capital expenditure allowance approved by the regulator for the control period, covering investment in new infrastructure, asset replacement, and enhancement projects.']
  consultation_end_date date [note: 'End date of the public consultation period for stakeholder feedback on the draft determination.']
  consultation_start_date date [note: 'Start date of the public consultation period during which stakeholders may submit responses to the draft determination.']
  created_timestamp timestamp [note: 'Timestamp when this regulatory review record was first created in the system.']
  depreciation_method varchar [note: 'Regulatory depreciation method applied to the RAB (e.g., straight-line, declining balance, economic depreciation).']
  draft_determination_date date [note: 'Date on which the regulator published the draft determination or provisional decision for stakeholder consultation.']
  effective_date date [note: 'Date from which the final determination becomes legally effective and the new tariffs or revenue allowances apply.']
  efficiency_target_percent decimal(5,4) [note: 'Regulator-imposed efficiency improvement target expressed as a decimal percentage, requiring the operator to reduce costs or improve productivity over the control period.']
  final_determination_date date [note: 'Date on which the regulator issued the final determination, setting allowed revenues, tariffs, and performance obligations for the control period.']
  gearing_assumption_percent decimal(5,4) [note: 'Regulator-assumed gearing ratio (debt-to-equity ratio) expressed as a decimal percentage, used in calculating the allowed WACC.']
  incentive_mechanism_type varchar [note: 'Type of performance-based incentive or penalty mechanism applied by the regulator (e.g., output delivery incentives, customer service incentives, innovation funding).']
  indexation_mechanism varchar [note: 'Description of the inflation indexation mechanism applied to the RAB and allowed revenues (e.g., RPI, CPI, CPIH indexation).']
  internal_review_lead varchar [note: 'Name or identifier of the internal team member or department responsible for managing the regulatory review process and stakeholder engagement.']
  last_modified_timestamp timestamp [note: 'Timestamp when this regulatory review record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional notes, commentary, or context regarding the regulatory review, including key issues, negotiation points, or strategic considerations.']
  opex_allowance decimal(18,2) [note: 'Total operating expenditure allowance approved by the regulator for the control period, covering day-to-day operational costs, maintenance, and administration.']
  output_delivery_targets varchar [note: 'Summary of key output delivery targets or performance commitments set by the regulator (e.g., service reliability, customer satisfaction, environmental outcomes).']
  rab_closing_value decimal(18,2) [note: 'Projected or actual closing value of the Regulated Asset Base (RAB) at the end of the control period, reflecting capital additions, depreciation, and indexation adjustments.']
  rab_opening_value decimal(18,2) [note: 'Opening value of the Regulated Asset Base (RAB) at the start of the control period, representing the capital invested in regulated infrastructure assets on which the operator earns a return.']
  regulator_contact_email varchar [note: 'Primary email address for regulatory correspondence and inquiries related to this price review.']
  regulator_jurisdiction varchar [note: 'Geographic or legal jurisdiction of the regulatory authority (country, state, or region code).']
  regulator_name varchar [note: 'Name of the regulatory authority conducting the price review (e.g., Ofgem, Ofwat, ORR, state public utility commission).']
  regulatory_framework varchar [note: 'Name or identifier of the regulatory framework or price control regime under which this review is conducted (e.g., RIIO-ED2, PR19, CP6).']
  review_document_url varchar [note: 'URL or document reference to the published regulatory determination, business plan submission, or consultation document.']
  review_period_end_date date [note: 'End date of the regulatory control period or tariff period covered by this review.']
  review_period_start_date date [note: 'Start date of the regulatory control period or tariff period covered by this review (e.g., beginning of the 5-year price control period).']
  review_reference_number varchar [note: 'External reference number or code assigned by the regulator to uniquely identify this price review proceeding.']
  review_status varchar [note: 'Current lifecycle status of the regulatory review: initiated, submission pending, under review, draft determination issued, consultation period, final determination published, appeal filed, or closed.']
  review_type varchar [note: 'Classification of the regulatory review process: periodic determination (scheduled multi-year reset), interim review (mid-cycle adjustment), appeal (challenge of prior determination), reopener, mid-period adjustment, or extraordinary review.']
  submission_date date [note: 'Date on which the asset owner or operator submitted the business plan, revenue proposal, or regulatory filing to the regulator for review.']
  totex_allowance decimal(18,2) [note: 'Combined total expenditure allowance (CAPEX plus OPEX) approved by the regulator for the control period, used in TOTEX-based regulatory frameworks.']

  Note: 'Transactional record of regulatory price reviews and determinations for regulated infrastructure assets, capturing review type (periodic determination, interim review, appeal), regulator name, review submission date, draft determination date, final'
}

Table infrastructure.construction_milestone {
  construction_milestone_id varchar [pk, note: 'Unique identifier for the construction milestone record.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset or project to which this milestone belongs.']
  predecessor_milestone_construction_milestone_id varchar [note: 'Reference to the preceding milestone that must be completed before this milestone can begin, used for dependency tracking.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Construction milestones track development progress for greenfield/brownfield projects. The product description explicitly mentions \'greenfield and brownfield projects\'.']
  actual_date date [note: 'Date on which the milestone was actually achieved and certified by the project team or independent engineer.']
  baseline_date date [note: 'Approved baseline date for the milestone used for variance analysis and Investment Committee (IC) reporting.']
  certification_date date [note: 'Date on which the certifying party formally certified the milestone achievement.']
  certification_document_reference varchar [note: 'Reference number or identifier of the certification document or report confirming milestone achievement.']
  certifying_party varchar [note: 'Name of the independent engineer, surveyor, or authority responsible for certifying milestone achievement.']
  completion_percentage decimal(5,2) [note: 'Percentage of milestone completion for in-progress milestones, ranging from 0.00 to 100.00.']
  contract_reference varchar [note: 'Reference to the construction contract, Engineering Procurement Construction (EPC) agreement, or concession agreement governing this milestone.']
  created_timestamp timestamp [note: 'Timestamp when this milestone record was first created in the system.']
  critical_path_flag boolean [note: 'Indicates whether this milestone is on the project critical path and directly impacts Commercial Operation Date (COD).']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the milestone payment amount.']
  delay_category varchar [note: 'Standardized category of delay cause for portfolio-level risk analysis and reporting. [ENUM-REF-CANDIDATE: weather|permitting|supply_chain|labor|design_change|force_majeure|financing|regulatory|technical|other — promote to reference product]']
  delay_reason varchar [note: 'Explanation of the cause of delay if the milestone is behind schedule, used for risk management and Operational Due Diligence (ODD).']
  dependency_type varchar [note: 'Type of scheduling dependency relationship with the predecessor milestone per Project Management Institute (PMI) standards.']
  forecast_date date [note: 'Current best-estimate date for milestone achievement based on project progress and risk assessment.']
  ic_reporting_flag boolean [note: 'Indicates whether this milestone is material and must be reported to the Investment Committee (IC) in quarterly portfolio reviews.']
  last_updated_timestamp timestamp [note: 'Timestamp when this milestone record was last modified, used for audit trail and change tracking.']
  lender_reporting_flag boolean [note: 'Indicates whether this milestone must be reported to project lenders or debt providers per loan covenants.']
  milestone_code varchar [note: 'Standardized code or abbreviation for the milestone type used for reporting and tracking.']
  milestone_name varchar [note: 'Business name or title of the construction milestone (e.g., Financial Close, Mechanical Completion, Commercial Operation Date).']
  milestone_status varchar [note: 'Current lifecycle status of the milestone indicating progress and completion state.']
  milestone_type varchar [note: 'Category of the construction milestone. COD refers to Commercial Operation Date. [ENUM-REF-CANDIDATE']
  mitigation_action varchar [note: 'Description of corrective actions or mitigation measures being taken to address delays or risks to milestone achievement.']
  notes varchar [note: 'Additional commentary, observations, or context regarding the milestone status, risks, or achievement.']
  payment_amount decimal(18,2) [note: 'Payment amount in the project currency triggered upon milestone achievement, used for cash flow forecasting and capital call planning.']
  payment_trigger_flag boolean [note: 'Indicates whether achievement of this milestone triggers a capital call, drawdown, or payment to the General Partner (GP) or contractor.']
  planned_date date [note: 'Originally scheduled date for milestone achievement as defined in the project plan or Limited Partnership Agreement (LPA).']
  regulatory_approval_required_flag boolean [note: 'Indicates whether this milestone requires regulatory approval or permit issuance before it can be achieved.']
  responsible_party varchar [note: 'Name of the party responsible for delivering this milestone, typically the General Partner (GP), contractor, or engineering firm.']
  risk_rating varchar [note: 'Current risk assessment for milestone achievement based on schedule, budget, and external factors.']
  variance_days varchar [note: 'Number of days between baseline and actual or forecast date, positive indicating delay and negative indicating early completion.']

  Note: 'Transactional record of construction and development milestones for greenfield and brownfield project investments, capturing milestone name, milestone type (financial close, construction start, mechanical completion, commissioning, COD), planned date'
}

Table infrastructure.fund_nav_report {
  fund_nav_report_id varchar [pk, note: 'Unique identifier for the fund NAV report record.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity that issued this NAV report.']
  infra_fund_commitment_id varchar [note: 'Reference to the external infrastructure fund for which this NAV report was received.']
  infrastructure_fund_id varchar [note: 'Reference to the external infrastructure fund for which this NAV report was received.']
  audited_flag boolean [note: 'Indicates whether this NAV report has been audited by an external auditor.']
  auditor_name varchar [note: 'Name of the external auditor who audited this NAV report, if applicable.']
  capital_called_amount decimal(20,2) [note: 'Amount of capital called from the LP during the reporting period.']
  capital_distribution_amount decimal(20,2) [note: 'Portion of distributions attributable to return of capital during the reporting period.']
  carried_interest_accrued decimal(20,2) [note: 'Carried interest accrued to the GP during the reporting period based on fund performance.']
  closing_nav decimal(20,2) [note: 'LP share NAV at the end of the reporting period.']
  created_by_user varchar [note: 'User identifier of the person who created this NAV report record.']
  created_timestamp timestamp [note: 'Timestamp when this NAV report record was first created in the system.']
  cumulative_distributions decimal(20,2) [note: 'Total cumulative distributions received by the LP since fund inception.']
  distribution_amount decimal(20,2) [note: 'Total distributions paid to the LP during the reporting period.']
  dpi_ratio decimal(10,4) [note: 'Distributions to Paid-In capital multiple as of the reporting period end.']
  fund_total_nav decimal(20,2) [note: 'Total Net Asset Value of the entire fund as reported by the GP for the reporting period.']
  income_distribution_amount decimal(20,2) [note: 'Portion of distributions attributable to income during the reporting period.']
  independent_valuation_flag boolean [note: 'Indicates whether an independent third-party valuation was performed for this reporting period.']
  irr_since_inception_percent decimal(10,4) [note: 'Internal Rate of Return for the LP investment since fund inception.']
  lp_share_nav decimal(20,2) [note: 'Net Asset Value attributable to the pension funds LP interest in the fund.']
  management_fee_accrued decimal(20,2) [note: 'Management fee charged by the GP and accrued during the reporting period.']
  material_events_description varchar [note: 'Description of any material events affecting the fund during the reporting period.']
  nav_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all NAV and financial amounts in this report.']
  opening_nav decimal(20,2) [note: 'LP share NAV at the beginning of the reporting period.']
  other_fees_expenses decimal(20,2) [note: 'Other fees and expenses charged to the LP during the reporting period.']
  paid_in_capital decimal(20,2) [note: 'Cumulative capital called and paid in by the LP as of the reporting period end.']
  realized_gain_loss decimal(20,2) [note: 'Gain or loss realized from disposals or exits during the reporting period.']
  reconciliation_notes varchar [note: 'Notes documenting any discrepancies or issues identified during reconciliation.']
  reconciliation_status varchar [note: 'Status of internal reconciliation of the GP-reported NAV against internal records.']
  report_commentary varchar [note: 'Narrative commentary provided by the GP regarding fund performance and market conditions during the reporting period.']
  report_document_url varchar [note: 'URL or file path to the full NAV report document received from the GP.']
  report_received_date date [note: 'Date on which the NAV report was received from the GP.']
  report_reference_number varchar [note: 'External reference number or identifier assigned by the GP to this NAV report.']
  report_status varchar [note: 'Current status of the NAV report in its lifecycle.']
  report_type varchar [note: 'Type or frequency classification of the NAV report.']
  reporting_period_end_date date [note: 'End date of the reporting period covered by this NAV report.']
  reporting_period_start_date date [note: 'Start date of the reporting period covered by this NAV report.']
  rvpi_ratio decimal(10,4) [note: 'Residual Value to Paid-In capital multiple as of the reporting period end.']
  total_committed_capital decimal(20,2) [note: 'Total capital commitment by the LP to the fund as of the reporting period end.']
  tvpi_ratio decimal(10,4) [note: 'Total Value to Paid-In capital multiple as of the reporting period end.']
  unfunded_commitment decimal(20,2) [note: 'Remaining uncalled capital commitment available for future capital calls.']
  unrealized_gain_loss decimal(20,2) [note: 'Change in fair value of unrealized investments during the reporting period.']
  updated_by_user varchar [note: 'User identifier of the person who last updated this NAV report record.']
  updated_timestamp timestamp [note: 'Timestamp when this NAV report record was last updated in the system.']
  valuation_date date [note: 'As-of date for the NAV valuation reported by the GP.']
  valuation_methodology varchar [note: 'Description of the valuation methodology applied by the GP for this reporting period.']

  Note: 'Transactional record of periodic NAV reports received from external infrastructure fund GPs, capturing reporting period, reported NAV (total fund and fund\'s LP share), unrealized gain/loss, realized proceeds in period, management fee accrual, carried'
}

Table infrastructure.insurance_policy {
  insurance_policy_id varchar [pk, note: 'Unique identifier for the insurance policy record covering infrastructure assets.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset covered by this insurance policy.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Insurance coverage is required during the construction/development phase of infrastructure projects.']
  additional_insured_parties varchar [note: 'List of additional entities or individuals covered under the policy beyond the primary insured.']
  aggregate_limit_amount decimal(18,2) [note: 'Total maximum amount the insurer will pay for all claims combined during the entire policy period.']
  annual_premium_amount decimal(18,2) [note: 'Total annual premium cost payable to the insurer for maintaining the insurance coverage.']
  broker_name varchar [note: 'Name of the insurance broker or intermediary who arranged the policy on behalf of the pension fund.']
  cancellation_notice_days varchar [note: 'Number of days advance notice required by either party to cancel the insurance policy before expiry.']
  certificate_holder_name varchar [note: 'Name of the entity to whom a certificate of insurance is issued as proof of coverage.']
  certificate_of_insurance_url varchar [note: 'URL or file path to the certificate of insurance document issued for this policy.']
  claims_contact_email varchar [note: 'Email address for the claims contact at the insurer for electronic claims submission and correspondence.']
  claims_contact_name varchar [note: 'Name of the primary contact person at the insurer for filing and managing claims under this policy.']
  claims_contact_phone varchar [note: 'Phone number for the claims contact at the insurer for reporting incidents and filing claims.']
  claims_made_basis_flag boolean [note: 'Indicates whether the policy covers claims made during the policy period regardless of when the incident occurred.']
  coinsurance_percentage decimal(5,2) [note: 'Percentage of loss shared by the insured after the deductible is met, expressed as a percentage of the claim amount.']
  coverage_description varchar [note: 'Detailed narrative describing the scope of coverage, perils insured, and specific terms applicable to the infrastructure asset.']
  created_by_user varchar [note: 'Username or identifier of the user who created the insurance policy record in the system.']
  created_timestamp timestamp [note: 'Timestamp when the insurance policy record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in the insurance policy.']
  deductible_amount decimal(18,2) [note: 'Amount the insured must pay out-of-pocket before the insurer pays a claim under the policy.']
  endorsements_summary varchar [note: 'Summary of amendments, riders, or endorsements that modify the standard policy terms and conditions.']
  exclusions_summary varchar [note: 'Summary of perils, events, or circumstances explicitly excluded from coverage under the insurance policy.']
  expiry_date date [note: 'Date when the insurance policy coverage terminates unless renewed or extended.']
  geographic_coverage_scope varchar [note: 'Description of the geographic territories or jurisdictions where the insurance coverage applies.']
  inception_date date [note: 'Date when the insurance policy becomes effective and coverage begins for the infrastructure asset.']
  insurer_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the insurance provider enabling global counterparty identification.']
  insurer_name varchar [note: 'Legal name of the insurance company or underwriter providing coverage for the infrastructure asset.']
  last_review_date date [note: 'Date when the insurance policy was last reviewed by internal risk management or asset management teams.']
  loss_payee_name varchar [note: 'Name of the entity designated to receive insurance claim payments, typically a lender or secured creditor.']
  next_review_date date [note: 'Scheduled date for the next internal review of the insurance policy coverage adequacy and terms.']
  occurrence_basis_flag boolean [note: 'Indicates whether the policy covers incidents that occur during the policy period regardless of when the claim is filed.']
  per_occurrence_limit_amount decimal(18,2) [note: 'Maximum amount the insurer will pay for a single claim event or occurrence under the policy.']
  policy_document_url varchar [note: 'URL or file path to the complete insurance policy document and terms and conditions.']
  policy_limit_amount decimal(18,2) [note: 'Maximum aggregate amount the insurer will pay for all claims during the policy period.']
  policy_notes varchar [note: 'Free-text field for additional notes, special conditions, or internal comments regarding the insurance policy.']
  policy_number varchar [note: 'Externally-known unique policy number assigned by the insurer for identification and claims processing.']
  policy_status varchar [note: 'Current lifecycle status of the insurance policy indicating its enforceability and coverage validity.']
  policy_term_years decimal(5,2) [note: 'Duration of the insurance policy coverage period expressed in years from inception to expiry.']
  policy_type varchar [note: 'Classification of insurance coverage type aligned with infrastructure asset risk categories.']
  premium_payment_frequency varchar [note: 'Frequency at which premium payments are due to the insurer during the policy term.']
  reinsurance_arrangement_flag boolean [note: 'Indicates whether the insurer has arranged reinsurance to transfer a portion of the risk to other insurers.']
  reinsurer_names varchar [note: 'Names of reinsurance companies participating in the risk transfer arrangement for this policy.']
  renewal_date date [note: 'Date when the insurance policy is scheduled for renewal review and potential extension.']
  sum_insured_amount decimal(18,2) [note: 'Maximum amount the insurer will pay in the event of a total loss or claim under the policy terms.']
  underwriter_name varchar [note: 'Name of the underwriter or underwriting syndicate responsible for assessing and accepting the insurance risk.']
  updated_by_user varchar [note: 'Username or identifier of the user who last modified the insurance policy record in the system.']
  updated_timestamp timestamp [note: 'Timestamp when the insurance policy record was last modified in the system.']
  waiting_period_days varchar [note: 'Number of days from policy inception before coverage becomes effective for certain perils or claim types.']

  Note: 'Master record for insurance policies covering direct infrastructure assets, capturing insurer name, policy type (property all-risk, business interruption, third-party liability, political risk, construction all-risk, environmental liability), insured'
}

Table infrastructure.operator_contract {
  operator_contract_id varchar [pk, note: 'Unique identifier for the operator contract record. Primary key for the operator contract entity.']
  actor_id varchar [note: 'Reference to the third-party operator, Operations and Maintenance (O&M) contractor, or asset manager engaged to run the infrastructure asset.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset covered by this operator contract.']
  annual_base_fee_amount decimal(18,2) [note: 'Fixed annual base fee payable to the operator for contracted services, excluding performance incentives or variable costs.']
  audit_rights_description varchar [note: 'Description of the asset owners rights to audit the operators books, records, and operational performance.']
  capex_responsibility varchar [note: 'Party responsible for funding capital expenditures on the infrastructure asset during the contract term.']
  change_of_control_consent_required_flag boolean [note: 'Indicates whether the operator must obtain owner consent before undergoing a change of control or ownership.']
  contract_document_url varchar [note: 'Reference link or storage location for the executed operator contract document and related legal agreements.']
  contract_name varchar [note: 'Human-readable name or title of the operator contract for identification and reporting purposes.']
  contract_notes varchar [note: 'Free-text field for additional notes, comments, or context regarding the operator contract.']
  contract_number varchar [note: 'Externally-known unique business identifier for the operator contract, used in legal documents and communications.']
  contract_status varchar [note: 'Current lifecycle status of the operator contract, indicating whether it is in negotiation, active, suspended, or terminated. [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|terminated|expired — 7 candidates stripped; promote to reference']
  contract_term_years decimal(5,2) [note: 'Duration of the operator contract in years, representing the initial term before any extensions.']
  contract_type varchar [note: 'Classification of the operator contract by service model and fee structure, such as Operations and Maintenance (O&M), asset management, or performance-based arrangements.']
  created_by_user varchar [note: 'Identifier of the user or system that created this operator contract record.']
  created_timestamp timestamp [note: 'Timestamp when this operator contract record was first created in the system.']
  dispute_resolution_mechanism varchar [note: 'Method specified for resolving disputes between the parties, such as arbitration, mediation, or litigation.']
  effective_end_date date [note: 'Date on which the operator contract expires or terminates, marking the end of the contractual relationship. Nullable for open-ended contracts.']
  effective_start_date date [note: 'Date from which the operator contract becomes legally binding and operational services commence.']
  esg_compliance_requirements varchar [note: 'Description of Environmental, Social, and Governance (ESG) standards and responsible investment requirements the operator must adhere to.']
  execution_date date [note: 'Date on which the operator contract was formally executed and signed by all parties.']
  extension_option_flag boolean [note: 'Indicates whether the contract includes provisions for extension beyond the initial term.']
  extension_term_years decimal(5,2) [note: 'Duration in years of any available extension period if the extension option is exercised.']
  fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all fee amounts in this contract.']
  fee_indexation_mechanism varchar [note: 'Description of how fees are adjusted over time, such as inflation indexation, Consumer Price Index (CPI) linkage, or fixed escalation rates.']
  fee_structure_type varchar [note: 'Classification of the fee arrangement, such as fixed fee, cost-plus, performance-based, or hybrid models.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law applicable to the operator contract.']
  handback_condition_requirements varchar [note: 'Description of the condition and performance standards the asset must meet when handed back to the owner at contract end.']
  incentive_fee_percent decimal(5,2) [note: 'Percentage of performance-based incentive fee that can be earned by the operator for exceeding performance targets.']
  insurance_responsibility varchar [note: 'Party responsible for procuring and maintaining insurance coverage for the infrastructure asset and operations.']
  key_personnel_clause_flag boolean [note: 'Indicates whether the contract includes key personnel provisions requiring specific individuals to remain assigned to the contract.']
  opex_responsibility varchar [note: 'Party responsible for funding operating expenditures and routine maintenance costs during the contract term.']
  payment_frequency varchar [note: 'Frequency at which operator fees are invoiced and paid, such as monthly, quarterly, or annually.']
  payment_terms_days varchar [note: 'Number of days from invoice date within which payment to the operator is due.']
  penalty_regime_description varchar [note: 'Description of penalties, liquidated damages, or fee reductions applicable if the operator fails to meet contractual performance standards.']
  performance_bond_amount decimal(18,2) [note: 'Value of the performance bond or guarantee required from the operator, if applicable.']
  performance_bond_required_flag boolean [note: 'Indicates whether the operator is required to post a performance bond or guarantee to secure contractual obligations.']
  performance_kpi_description varchar [note: 'Description of the key performance indicators and metrics used to measure operator performance, such as availability, uptime, and response times.']
  reporting_frequency varchar [note: 'Frequency at which the operator is required to provide performance and operational reports to the asset owner.']
  scope_of_services varchar [note: 'Detailed description of the operational and management services the operator is contracted to provide, including maintenance, monitoring, and performance obligations.']
  service_level_agreement_flag boolean [note: 'Indicates whether the contract includes formal Service Level Agreement (SLA) performance targets and metrics.']
  subcontracting_permitted_flag boolean [note: 'Indicates whether the operator is permitted to subcontract services to third parties.']
  termination_notice_days varchar [note: 'Number of days advance notice required for contract termination by either party.']
  termination_rights_description varchar [note: 'Description of conditions under which either party may terminate the contract, including notice periods and termination for cause or convenience.']
  updated_by_user varchar [note: 'Identifier of the user or system that last updated this operator contract record.']
  updated_timestamp timestamp [note: 'Timestamp when this operator contract record was last modified in the system.']
  variable_fee_basis varchar [note: 'Description of the basis for variable or performance-based fees, such as revenue share, throughput, or availability metrics.']

  Note: 'Master record for operational and management contracts with third-party operators, O&M contractors, and asset managers engaged to run infrastructure assets post-acquisition.'
}

Table infrastructure.infrastructure_ic_approval {
  infrastructure_ic_approval_id varchar [pk, note: 'Unique identifier for the infrastructure Investment Committee approval record.']
  deal_opportunity_id varchar [note: 'Reference to the originating deal opportunity that led to this IC approval.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset being approved for investment.']
  infra_fund_commitment_id varchar [note: 'Reference to the infrastructure fund commitment associated with this approval, if applicable.']
  infrastructure_fund_id varchar [note: 'Reference to the infrastructure fund commitment associated with this approval, if applicable.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Investment Committee approvals are required for greenfield/brownfield project investments.']
  approval_authority_level varchar [note: 'The level of authority that granted this approval, indicating whether it was full Investment Committee, delegated authority, or Board-level approval.']
  approval_decision_date date [note: 'The date on which the Investment Committee formally rendered its approval decision.']
  approval_expiry_date date [note: 'The date on which this Investment Committee approval expires if the investment has not been executed.']
  approval_notes varchar [note: 'Additional notes, comments, or observations recorded by the Investment Committee regarding this infrastructure investment approval.']
  approval_status varchar [note: 'The current status of the Investment Committee approval decision.']
  approval_type varchar [note: 'The type of Investment Committee approval being granted for this infrastructure investment.']
  approved_commitment_amount decimal(20,2) [note: 'The total capital commitment amount approved by the Investment Committee for this infrastructure investment.']
  approved_commitment_currency varchar [note: 'The three-letter ISO 4217 currency code for the approved commitment amount.']
  approved_structure varchar [note: 'The investment structure approved by the Investment Committee for this infrastructure investment. [ENUM-REF-CANDIDATE: direct_equity|co_investment|fund_commitment|joint_venture|preferred_equity|mezzanine|debt — 7 candidates stripped; promote to reference']
  asset_class varchar [note: 'The primary asset class category of the infrastructure investment as classified by the Investment Committee.']
  asset_sub_class varchar [note: 'The detailed sub-classification of the infrastructure asset within its primary asset class.']
  conditions_precedent varchar [note: 'Any conditions precedent that must be satisfied before the approved infrastructure investment can proceed to execution.']
  conditions_subsequent varchar [note: 'Any conditions subsequent that must be satisfied after the infrastructure investment is executed.']
  country_code varchar [note: 'The three-letter ISO 3166-1 alpha-3 country code for the infrastructure asset location.']
  created_by_user varchar [note: 'The user identifier of the person who created this Investment Committee approval record in the system.']
  created_timestamp timestamp [note: 'The timestamp when this Investment Committee approval record was first created in the system.']
  esg_classification varchar [note: 'The SFDR article classification of the infrastructure investment for sustainable finance disclosure purposes.']
  esg_rating varchar [note: 'The ESG rating of the infrastructure investment as assessed during the Investment Committee review process.']
  expected_exit_date date [note: 'The anticipated exit date for the infrastructure investment as approved by the Investment Committee.']
  expected_hold_period_years varchar [note: 'The expected investment hold period in years as approved by the Investment Committee.']
  geographic_region varchar [note: 'The geographic region where the infrastructure asset is located.']
  ic_approval_number varchar [note: 'Unique business identifier for the IC approval, used for tracking and reference in governance documentation.']
  ic_meeting_date date [note: 'The date on which the Investment Committee convened to review and approve this infrastructure investment.']
  ic_memo_reference varchar [note: 'Reference identifier for the Investment Memorandum presented to the Investment Committee for this approval.']
  investment_description varchar [note: 'Detailed description of the infrastructure investment opportunity, including strategic rationale and key characteristics.']
  investment_name varchar [note: 'The name of the infrastructure investment as presented to the Investment Committee.']
  investment_stage varchar [note: 'The development stage of the infrastructure asset at the time of Investment Committee approval.']
  leverage_ratio_approved decimal(5,2) [note: 'The maximum leverage ratio approved by the Investment Committee for this infrastructure investment.']
  ownership_percentage_approved decimal(5,2) [note: 'The percentage ownership stake in the infrastructure asset approved by the Investment Committee.']
  regulatory_capital_treatment varchar [note: 'The regulatory capital treatment classification for this infrastructure investment as approved by the Investment Committee.']
  risk_rating varchar [note: 'The overall risk rating assigned to this infrastructure investment by the Investment Committee.']
  strategic_alignment_score decimal(3,1) [note: 'A score representing how well this infrastructure investment aligns with the organizations strategic asset allocation and investment objectives.']
  target_net_irr_percent decimal(5,2) [note: 'The target net Internal Rate of Return percentage approved by the Investment Committee for this infrastructure investment.']
  updated_by_user varchar [note: 'The user identifier of the person who last updated this Investment Committee approval record in the system.']
  updated_timestamp timestamp [note: 'The timestamp when this Investment Committee approval record was last updated in the system.']
  votes_abstained varchar [note: 'The number of Investment Committee members who abstained from voting on this infrastructure investment approval.']
  votes_against varchar [note: 'The number of Investment Committee votes cast against approving this infrastructure investment.']
  votes_in_favor varchar [note: 'The number of Investment Committee votes cast in favor of approving this infrastructure investment.']
  voting_members_present varchar [note: 'The number of Investment Committee voting members present at the meeting when this approval was granted.']

  Note: 'Transactional record of Investment Committee approvals for infrastructure investments, capturing IC meeting date, investment name, approval type (initial approval, final approval, follow-on, disposal), approved commitment amount, approved structure'
}

Table infrastructure.asset_disposition {
  asset_disposition_id varchar [pk, note: 'Unique identifier for the infrastructure asset disposition transaction.']
  actor_id varchar [note: 'Reference to the acquiring party or buyer entity purchasing the infrastructure asset or Limited Partner (LP) interest.']
  advisor_entity_actor_id varchar [note: 'Reference to the sell-side financial advisor or investment bank engaged to execute the disposition transaction.']
  infra_asset_id varchar [note: 'Reference to the direct infrastructure asset being disposed.']
  infra_fund_commitment_id varchar [note: 'Reference to the infrastructure fund commitment when disposing Limited Partner (LP) interests via secondary sale.']
  infrastructure_fund_id varchar [note: 'Reference to the infrastructure fund commitment when disposing Limited Partner (LP) interests via secondary sale.']
  legal_advisor_entity_actor_id varchar [note: 'Reference to the legal counsel engaged to advise on the disposition transaction and draft sale agreements.']
  advisor_fee_amount decimal(18,2) [note: 'Total fees paid to sell-side financial advisors and investment banks for executing the disposition.']
  announcement_date date [note: 'Date on which the disposition was publicly announced or disclosed to stakeholders.']
  buyer_name varchar [note: 'Legal name of the buyer or acquiring entity for the disposition transaction.']
  buyer_type varchar [note: 'Classification of the buyer counterparty: strategic corporate buyer, financial sponsor or private equity, infrastructure fund, pension fund, sovereign wealth fund, insurance company, family office, secondary market buyer, or public market via Initial']
  capital_gains_tax_amount decimal(18,2) [note: 'Estimated or actual capital gains tax liability arising from the disposition transaction.']
  carried_interest_amount decimal(18,2) [note: 'Carried interest or performance fee paid to the General Partner (GP) from disposition proceeds, typically after hurdle rate is achieved.']
  created_by_user varchar [note: 'User identifier or username of the person who created this disposition record.']
  created_timestamp timestamp [note: 'Timestamp when this disposition record was first created in the system.']
  disposition_date date [note: 'The date on which the disposition transaction legally completed and ownership transferred to the buyer, representing the principal business event timestamp for exit recognition.']
  disposition_name varchar [note: 'Human-readable name or title of the disposition transaction for internal tracking and reporting.']
  disposition_notes varchar [note: 'Free-text notes capturing additional context, special conditions, or commentary on the disposition transaction.']
  disposition_number varchar [note: 'Externally-known unique transaction reference number for the disposition event.']
  disposition_rationale varchar [note: 'Strategic rationale and business justification for the disposition decision, including portfolio rebalancing, liquidity needs, or value realization objectives.']
  disposition_status varchar [note: 'Current state of the disposition transaction in its lifecycle workflow: planned for future exit, actively marketed to buyers, under negotiation with counterparty, legally signed awaiting close, completed and settled, cancelled or withdrawn, or temporarily']
  disposition_type varchar [note: 'Classification of the disposition structure: full exit of entire holding, partial sell-down of ownership stake, secondary sale of Limited Partner (LP) interest, Initial Public Offering (IPO) or public listing, trade sale to strategic buyer, management']
  distribution_to_lps_amount decimal(18,2) [note: 'Total amount distributed to Limited Partners (LPs) from the disposition proceeds after carried interest and fees.']
  earnout_potential_amount decimal(18,2) [note: 'Maximum potential additional proceeds from earn-out provisions if performance targets are achieved.']
  earnout_provision_flag boolean [note: 'Boolean flag indicating whether the disposition includes an earn-out or contingent consideration provision based on future performance.']
  escrow_amount decimal(18,2) [note: 'Amount of proceeds held in escrow to cover indemnity claims, representations and warranties, or earn-out provisions.']
  escrow_release_date date [note: 'Scheduled date for release of escrowed funds to the seller, subject to no claims being made.']
  exit_enterprise_value_amount decimal(18,2) [note: 'Total enterprise value of the asset at disposition, representing equity value plus net debt.']
  exit_valuation_multiple decimal(6,2) [note: 'Valuation multiple at exit such as Enterprise Value (EV) to Earnings Before Interest Taxes Depreciation and Amortization (EBITDA) multiple, used to benchmark exit pricing.']
  gross_irr_percent decimal(6,2) [note: 'Gross Internal Rate of Return (IRR) achieved on the investment from acquisition through disposition, before fees and carried interest.']
  gross_proceeds_amount decimal(18,2) [note: 'Total gross proceeds received from the buyer before deducting transaction costs, fees, and expenses.']
  holding_period_years decimal(6,2) [note: 'Total holding period from acquisition date to disposition date, expressed in years with decimal precision.']
  ic_approval_date date [note: 'Date on which the Investment Committee (IC) approved the disposition transaction and exit strategy.']
  ic_approval_reference varchar [note: 'Reference number or identifier for the Investment Committee (IC) approval decision and meeting minutes.']
  moic decimal(6,2) [note: 'Multiple on Invested Capital (MOIC) representing total value returned divided by total capital invested, a key private markets performance metric.']
  net_irr_percent decimal(6,2) [note: 'Net Internal Rate of Return (IRR) achieved on the investment after deducting management fees, transaction costs, and carried interest.']
  net_proceeds_amount decimal(18,2) [note: 'Net proceeds received after deducting all transaction costs, fees, and expenses from gross proceeds.']
  original_cost_basis_amount decimal(18,2) [note: 'Original acquisition cost or invested capital amount in the asset being disposed, used for gain/loss calculation.']
  ownership_percentage_disposed decimal(5,2) [note: 'Percentage of total ownership stake being disposed in this transaction, expressed as a decimal percentage (e.g., 100.00 for full exit, 50.00 for half).']
  proceeds_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the disposition proceeds (e.g., USD, EUR, GBP).']
  realized_gain_loss_amount decimal(18,2) [note: 'Realized gain or loss on the disposition calculated as net proceeds minus original cost basis, can be positive (gain) or negative (loss).']
  retained_ownership_percentage decimal(5,2) [note: 'Percentage of ownership stake retained by the fund after the disposition transaction, relevant for partial sell-downs.']
  sale_structure varchar [note: 'Legal structure of the sale: asset sale transferring underlying assets, share sale transferring equity ownership, Limited Partner (LP) interest transfer in fund context, dual-track process running multiple exit routes, or stapled transaction combining']
  signing_date date [note: 'Date on which the Share Purchase Agreement (SPA) or equivalent sale agreement was executed by all parties.']
  tax_jurisdiction varchar [note: 'Three-letter ISO country code representing the primary tax jurisdiction for the disposition transaction.']
  transaction_costs_amount decimal(18,2) [note: 'Total transaction costs including advisory fees, legal fees, due diligence costs, and other expenses incurred to complete the disposition.']
  updated_by_user varchar [note: 'User identifier or username of the person who last updated this disposition record.']
  updated_timestamp timestamp [note: 'Timestamp when this disposition record was last modified or updated.']
  withholding_tax_amount decimal(18,2) [note: 'Withholding tax deducted at source on disposition proceeds, relevant for cross-border transactions.']

  Note: 'Transactional record of full or partial dispositions (exits) of direct infrastructure assets or secondary sales of fund LP interests, capturing disposition date, buyer name, sale structure (full exit, partial sell-down, secondary LP sale, IPO/listing)'
}

Table infrastructure.infrastructure_sector_classification {
  infrastructure_sector_classification_id varchar [pk, note: 'Unique identifier for the infrastructure sector classification record.']
  asset_class varchar [note: 'Risk-return classification of infrastructure investments within this sector (core, core plus, value add, opportunistic).']
  benchmark_index varchar [note: 'Standard market benchmark index used for performance comparison of investments in this sector (e.g., FTSE Global Core Infrastructure Index, S&P Global Infrastructure Index).']
  carbon_intensity_category varchar [note: 'Typical carbon emissions profile for assets in this sector (high for fossil fuel infrastructure, low for renewables, net zero for carbon-neutral operations).']
  classification_notes varchar [note: 'Additional notes, guidance, or clarifications regarding the application of this sector classification for investment categorization.']
  classification_status varchar [note: 'Current status of this sector classification in the taxonomy (active for current use, deprecated for phased-out, under review for pending changes, proposed for new).']
  concession_based_flag boolean [note: 'Indicates whether assets in this sector typically operate under concession agreements with government or public entities (True) or under freehold ownership (False).']
  created_by_user varchar [note: 'Identifier of the user or system process that created this sector classification record.']
  created_timestamp timestamp [note: 'Timestamp when this sector classification record was first created in the system.']
  demand_elasticity varchar [note: 'Sensitivity of demand to economic cycles for assets in this sector (inelastic for essential utilities, elastic for discretionary transport).']
  effective_from_date date [note: 'Date from which this sector classification became effective for investment categorization and reporting.']
  effective_to_date date [note: 'Date until which this sector classification remains valid; null for currently active classifications.']
  esg_materiality_rating varchar [note: 'Assessment of ESG factor materiality for this sector (high for carbon-intensive sectors, medium for social infrastructure, low for digital).']
  geographic_concentration varchar [note: 'Typical geographic scope of investments in this sector (global for digital infrastructure, regional for transport, domestic for utilities).']
  hierarchy_level varchar [note: 'Level in the sector classification hierarchy (1 for top-level sectors, 2 for sub-sectors, 3 for detailed categories).']
  inflation_linkage_type varchar [note: 'Mechanism by which revenues in this sector are linked to inflation (direct for CPI-indexed tariffs, indirect for volume-driven, none for fixed contracts).']
  investment_stage varchar [note: 'Typical development stage for assets in this sector (greenfield for new construction, brownfield for expansion, operational for stabilized, mature for late-stage).']
  liability_matching_suitability varchar [note: 'Assessment of how well cash flows from this sector align with long-duration pension liabilities (high for regulated utilities, medium for contracted assets, low for merchant).']
  liquidity_profile varchar [note: 'Assessment of secondary market liquidity for assets in this sector (highly liquid for listed infrastructure, illiquid for direct private assets).']
  operational_complexity varchar [note: 'Assessment of operational management requirements for assets in this sector (high for airports, medium for toll roads, low for fiber networks).']
  parent_sector_code varchar [note: 'Code of the parent sector in a hierarchical taxonomy; null for top-level sectors.']
  regulated_flag boolean [note: 'Indicates whether assets in this sector are typically subject to regulatory rate-of-return frameworks (True) or operate in competitive markets (False).']
  regulatory_complexity varchar [note: 'Assessment of regulatory oversight and compliance burden for assets in this sector (high for utilities, medium for transport, low for digital).']
  renewable_energy_flag boolean [note: 'Indicates whether this sector primarily comprises renewable energy assets (True) or conventional energy infrastructure (False).']
  revenue_model_type varchar [note: 'Predominant revenue generation model for assets in this sector (availability payment, user pay, merchant, hybrid, regulated tariff, contracted).']
  sector_code varchar [note: 'Unique alphanumeric code identifying the infrastructure sector (e.g., TRANS, ENRG, UTIL, SOCL, DGTL, NATR).']
  sector_description varchar [note: 'Detailed description of the infrastructure sector, including typical asset types and investment characteristics.']
  sector_name varchar [note: 'Full name of the infrastructure sector (e.g., Transport, Energy, Utilities, Social Infrastructure, Digital Infrastructure, Natural Resources).']
  sort_order varchar [note: 'Numeric value determining the display order of sectors in reports and user interfaces.']
  sub_sector_code varchar [note: 'Unique alphanumeric code identifying the infrastructure sub-sector (e.g., TOLL, ARPT, RAIL, SOLR, WIND, WATR, SEWG, HOSP, SCHL, FBRP, TWRS).']
  sub_sector_description varchar [note: 'Detailed description of the infrastructure sub-sector, including operational characteristics and typical revenue models.']
  sub_sector_name varchar [note: 'Full name of the infrastructure sub-sector (e.g., Toll Roads, Airports, Rail, Solar, Wind, Water, Sewage, Hospitals, Schools, Fiber Optic, Towers).']
  target_net_irr_percent decimal(5,2) [note: 'Typical target net IRR for investments in this sector, expressed as a percentage (e.g., 8.50 for 8.5% net IRR).']
  technology_disruption_risk varchar [note: 'Assessment of exposure to technological obsolescence or disruption for assets in this sector (high for legacy telecom, low for essential utilities).']
  typical_concession_term_years varchar [note: 'Standard concession duration in years for assets in this sector (e.g., 25-30 years for toll roads, 50-99 years for airports).']
  typical_leverage_ratio decimal(5,2) [note: 'Standard debt-to-equity ratio for assets in this sector, expressed as a decimal (e.g., 0.60 represents 60% debt, 40% equity).']
  updated_by_user varchar [note: 'Identifier of the user or system process that last modified this sector classification record.']
  updated_timestamp timestamp [note: 'Timestamp when this sector classification record was last modified.']

  Note: 'Reference data for infrastructure sector and sub-sector classification taxonomy used to categorize assets and fund commitments. Captures sector name (Transport, Energy, Utilities, Social, Digital, Natural Resources), sub-sector (toll roads, airports'
}

Table infrastructure.capital_call_notice_document {
  capital_call_notice_document_id varchar [pk, note: 'Primary key for capital_call_notice_document']
  fund_id varchar [note: 'Reference to the infrastructure fund or investment vehicle issuing the capital call.']
  gp_entity_id varchar [note: 'Reference to the general partner or fund manager issuing the capital call.']
  infra_fund_commitment_id varchar [note: 'Reference to the specific fund commitment agreement against which capital is being called.']
  legal_entity_id varchar [note: 'Reference to the limited partner investor receiving the capital call notice.']
  original_notice_id varchar [note: 'Reference to the original capital call notice if this document is an amendment.']
  acknowledgment_date date [note: 'Date when the limited partner acknowledged receipt of the capital call notice.']
  asset_sector varchar [note: 'Sector classification of the target infrastructure asset or investment.']
  bank_account_name varchar [note: 'Name of the bank account to which capital call funds should be transferred.']
  bank_account_number varchar [note: 'Bank account number for receiving capital call payments.']
  bank_swift_code varchar [note: 'SWIFT/BIC code identifying the receiving bank for international wire transfers.']
  call_amount decimal(18,2) [note: 'Total amount of capital being called from the limited partner in this notice.']
  call_currency_code varchar [note: 'ISO 4217 three-letter currency code for the capital call amount.']
  commitment_percentage_called decimal(8,5) [note: 'Percentage of the limited partners total commitment being called in this notice.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the target infrastructure asset is located.']
  created_timestamp timestamp [note: 'Timestamp when the capital call notice document record was first created in the system.']
  cumulative_called_percentage decimal(8,5) [note: 'Total percentage of the limited partners commitment that has been called to date including this notice.']
  document_file_name varchar [note: 'Name of the electronic file containing the capital call notice document.']
  document_file_path varchar [note: 'Storage location path for the capital call notice document in the document management system.']
  document_format varchar [note: 'File format of the capital call notice document.']
  document_status varchar [note: 'Current lifecycle status of the capital call notice document within the funding workflow.']
  document_type varchar [note: 'Classification of the capital call notice document type indicating the nature of the funding request.']
  document_version varchar [note: 'Version number of the capital call notice document for tracking revisions.']
  due_date date [note: 'Date by which the called capital must be received from the limited partner.']
  funded_amount decimal(18,2) [note: 'Actual amount of capital received from the limited partner in response to this call.']
  funded_date date [note: 'Date when the called capital was received from the limited partner.']
  geographic_region varchar [note: 'Geographic region where the target infrastructure investment is located.']
  investment_amount decimal(18,2) [note: 'Portion of the capital call allocated to direct investment in portfolio assets or infrastructure projects.']
  investment_purpose varchar [note: 'Description of the intended use of called capital such as acquisition, development, or follow-on investment.']
  is_amended boolean [note: 'Indicates whether this notice is an amendment to a previously issued capital call.']
  issue_date date [note: 'Date when the capital call notice was formally issued to the limited partner.']
  late_payment_interest_rate decimal(8,5) [note: 'Interest rate applicable to late capital call payments as specified in the fund agreement.']
  late_payment_penalty_amount decimal(18,2) [note: 'Penalty amount assessed for late payment of the capital call.']
  management_fee_amount decimal(18,2) [note: 'Portion of the capital call allocated to management fees payable to the general partner.']
  notice_delivery_method varchar [note: 'Method by which the capital call notice was delivered to the limited partner.']
  notice_number varchar [note: 'Externally-known unique reference number assigned to the capital call notice for tracking and communication purposes.']
  organizational_expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to fund organizational and formation expenses.']
  other_expense_amount decimal(18,2) [note: 'Portion of the capital call allocated to miscellaneous fund expenses not classified elsewhere.']
  payment_reference varchar [note: 'Reference code to be included with payment for proper allocation and reconciliation.']
  shortfall_amount decimal(18,2) [note: 'Difference between called amount and funded amount if the limited partner underfunded.']
  signatory_name varchar [note: 'Name of the authorized signatory who executed the capital call notice on behalf of the general partner.']
  signatory_title varchar [note: 'Title or position of the authorized signatory executing the capital call notice.']
  target_asset_name varchar [note: 'Name of the infrastructure asset or project for which capital is being called, if disclosed.']
  updated_timestamp timestamp [note: 'Timestamp when the capital call notice document record was last modified.']
  wire_transfer_instructions varchar [note: 'Banking and wire transfer instructions for remitting the called capital to the fund.']

  Note: 'Master reference table for capital_call_notice_document. Referenced by notice_document_id.'
}

Table infrastructure.distribution_notice_document {
  distribution_notice_document_id varchar [pk, note: 'Primary key for distribution_notice_document']
  gp_entity_id varchar [note: 'Reference to the general partner or fund manager issuing the distribution notice.']
  infra_asset_id varchar [note: 'Reference to the specific infrastructure asset associated with this distribution, if applicable.']
  infrastructure_fund_id varchar [note: 'Reference to the infrastructure fund from which the distribution notice originates.']
  legal_entity_id varchar [note: 'Reference to the limited partner (investor) receiving the distribution notice.']
  original_notice_document_id varchar [note: 'Reference to the original distribution notice document if this is an amended notice.']
  amendment_reason varchar [note: 'Explanation for why the distribution notice was amended, if applicable.']
  bank_account_details varchar [note: 'Designated bank account information for receiving the distribution payment (masked or tokenized for security).']
  carried_interest_amount decimal(18,2) [note: 'Amount of carried interest (performance fee) deducted from the distribution payable to the general partner.']
  cumulative_contributions decimal(18,2) [note: 'Total cumulative capital contributions made by the limited partner to the fund as of the distribution date.']
  cumulative_distributions decimal(18,2) [note: 'Total cumulative distributions received by the limited partner from the fund as of this distribution.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the distribution amount (e.g., USD, EUR, GBP).']
  distribution_category varchar [note: 'Category indicating the source or nature of the distribution (operating cash flow, asset realization, refinancing proceeds, dividend, other).']
  document_file_name varchar [note: 'Name of the electronic file containing the distribution notice document.']
  document_file_path varchar [note: 'Storage location path for the distribution notice document in the document management system.']
  document_format varchar [note: 'File format of the distribution notice document (PDF, XLSX, XML, CSV, other).']
  document_number varchar [note: 'Externally-known unique business reference number assigned to the distribution notice document for tracking and correspondence.']
  document_status varchar [note: 'Current lifecycle status of the distribution notice document within the processing workflow.']
  document_type varchar [note: 'Classification of the distribution notice document indicating the nature of the capital movement (capital call, distribution, recallable, equalization, other).']
  document_version varchar [note: 'Version number of the distribution notice document for tracking revisions and amendments.']
  effective_date date [note: 'Date on which the distribution becomes effective for accounting and NAV calculation purposes.']
  gross_distribution_amount decimal(18,2) [note: 'Total gross distribution amount before any withholding taxes, fees, or adjustments.']
  income_distribution_amount decimal(18,2) [note: 'Portion of the distribution representing income (dividends, interest, rental income) from underlying investments.']
  is_amended boolean [note: 'Indicates whether this distribution notice is an amendment to a previously issued notice.']
  lp_commitment_amount decimal(18,2) [note: 'Total capital commitment of the limited partner to the fund as of the distribution notice date.']
  lp_ownership_percentage decimal(8,5) [note: 'Percentage ownership interest of the limited partner in the fund at the time of distribution.']
  management_fee_offset_amount decimal(18,2) [note: 'Amount of management fee offset applied to the distribution as per partnership agreement terms.']
  nav_after_distribution decimal(18,2) [note: 'Limited partners net asset value in the fund immediately after the distribution.']
  nav_before_distribution decimal(18,2) [note: 'Limited partners net asset value in the fund immediately before the distribution.']
  net_distribution_amount decimal(18,2) [note: 'Final net distribution amount payable to the limited partner after all deductions and adjustments.']
  notes varchar [note: 'Additional notes or comments from the general partner regarding the distribution.']
  notice_date date [note: 'Date on which the distribution notice was officially issued by the general partner.']
  payment_due_date date [note: 'Date by which the distribution payment is expected to be received by the limited partner.']
  processed_timestamp timestamp [note: 'Timestamp when the distribution notice was fully processed and recorded in the investment accounting system.']
  realized_gain_amount decimal(18,2) [note: 'Portion of the distribution representing realized capital gains from asset dispositions.']
  recallable_amount decimal(18,2) [note: 'Portion of the distribution that may be recalled by the general partner for future investments per partnership agreement terms.']
  received_timestamp timestamp [note: 'Timestamp when the distribution notice document was received by the pension fund.']
  remaining_unfunded_commitment decimal(18,2) [note: 'Remaining unfunded capital commitment of the limited partner after accounting for all contributions and recallable distributions.']
  reporting_period_end_date date [note: 'End date of the reporting period covered by the distribution notice.']
  reporting_period_start_date date [note: 'Start date of the reporting period covered by the distribution notice.']
  return_of_capital_amount decimal(18,2) [note: 'Portion of the distribution representing return of the limited partners original capital contribution.']
  transaction_reference_number varchar [note: 'External transaction reference number for wire transfer or payment reconciliation purposes.']
  underlying_asset_name varchar [note: 'Name of the underlying infrastructure asset or investment generating the distribution proceeds.']
  valuation_date date [note: 'Date of the fund valuation used to calculate the distribution amounts and ownership percentages.']
  wire_instructions_reference varchar [note: 'Reference to standing wire instructions on file for the limited partner.']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted from the gross distribution as required by applicable tax jurisdictions.']

  Note: 'Master reference table for distribution_notice_document. Referenced by distribution_notice_document_id.'
}

Table infrastructure.ownership_agreement {
  ownership_agreement_id varchar [pk, note: 'Primary key for ownership_agreement']
  actor_id varchar [note: 'Reference to the counterparty acting as lead investor or general partner in the ownership structure.']
  infra_asset_id varchar [note: 'Reference to the infrastructure asset that is the subject of this ownership agreement.']
  agreement_name varchar [note: 'Descriptive name or title of the ownership agreement identifying the asset and parties involved.']
  agreement_number varchar [note: 'Externally-known business reference number assigned to the ownership agreement for tracking and correspondence.']
  agreement_type varchar [note: 'Classification of the ownership structure governing the infrastructure asset investment arrangement.']
  audit_rights_flag boolean [note: 'Indicates whether the pension fund has contractual rights to audit the asset or vehicle financials.']
  board_seat_count varchar [note: 'Number of board seats or governance positions allocated to the pension fund under this agreement.']
  carried_interest_percentage decimal(5,4) [note: 'Performance fee or carried interest rate payable to the general partner or manager on profits.']
  clawback_provision_flag boolean [note: 'Indicates whether the agreement includes clawback provisions for excess carried interest distributions.']
  co_investment_rights_flag boolean [note: 'Indicates whether the agreement grants rights to participate in future co-investment opportunities.']
  committed_capital_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund under this ownership agreement in base currency.']
  created_timestamp timestamp [note: 'Timestamp when this ownership agreement record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this ownership agreement.']
  dispute_resolution_method varchar [note: 'Contractually agreed mechanism for resolving disputes arising under the ownership agreement.']
  economic_interest_percentage decimal(7,4) [note: 'Percentage of economic interest entitling the fund to distributions and capital returns from the asset.']
  effective_date date [note: 'Date on which the ownership agreement becomes legally binding and enforceable between parties.']
  esg_compliance_required boolean [note: 'Indicates whether the agreement mandates Environmental, Social, and Governance compliance standards.']
  esg_reporting_frequency varchar [note: 'Frequency at which ESG performance reports must be provided under the agreement terms.']
  execution_date date [note: 'Date on which all parties formally signed and executed the ownership agreement documentation.']
  exit_strategy varchar [note: 'Planned or preferred exit mechanism for realizing the investment under this ownership agreement.']
  expiration_date date [note: 'Date on which the ownership agreement is scheduled to expire or terminate, if not open-ended.']
  funded_capital_amount decimal(18,2) [note: 'Cumulative capital amount actually funded or drawn down under this ownership agreement to date.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of this ownership agreement.']
  has_anti_dilution_protection boolean [note: 'Indicates whether the agreement includes anti-dilution provisions protecting the ownership percentage.']
  has_information_rights boolean [note: 'Indicates whether the agreement grants enhanced information and reporting rights to the pension fund.']
  has_veto_rights boolean [note: 'Indicates whether the pension fund holds veto rights over material decisions under this agreement.']
  investment_vehicle_type varchar [note: 'Type of legal structure or vehicle through which the ownership interest is held.']
  last_modified_timestamp timestamp [note: 'Timestamp when this ownership agreement record was last updated or modified.']
  legal_entity_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code where the holding legal entity is domiciled.']
  legal_entity_name varchar [note: 'Name of the special purpose vehicle or legal entity holding the ownership interest.']
  lock_up_end_date date [note: 'Date on which the lock-up period expires and transfer restrictions are lifted.']
  lock_up_period_months varchar [note: 'Duration in months during which the ownership interest cannot be transferred or sold.']
  management_fee_percentage decimal(5,4) [note: 'Annual management fee rate charged on committed or invested capital under this ownership structure.']
  notes varchar [note: 'Free-text field for additional comments, observations, or context about the ownership agreement.']
  ownership_agreement_status varchar [note: 'Current state of the ownership agreement within its lifecycle from inception to termination.']
  ownership_percentage decimal(7,4) [note: 'Percentage of ownership stake held by the pension fund in the infrastructure asset under this agreement.']
  preferred_return_percentage decimal(5,4) [note: 'Hurdle rate or preferred return threshold that must be achieved before carried interest is payable.']
  target_exit_date date [note: 'Anticipated date for exiting or divesting the ownership interest under the investment plan.']
  transfer_restriction_type varchar [note: 'Type of transfer restriction governing the sale or assignment of ownership interests under the agreement.']
  unfunded_commitment_amount decimal(18,2) [note: 'Remaining capital commitment not yet called or funded under this ownership agreement.']
  valuation_frequency varchar [note: 'Frequency at which the ownership interest must be valued under the agreement terms.']
  valuation_methodology varchar [note: 'Primary valuation methodology specified in the agreement for determining fair value of the interest.']
  voting_rights_percentage decimal(7,4) [note: 'Percentage of voting rights allocated to the pension fund under the governance provisions of the agreement.']
  waterfall_structure varchar [note: 'Type of distribution waterfall governing the order and priority of cash flow distributions.']

  Note: 'Master reference table for ownership_agreement. Referenced by ownership_agreement_id.'
}

Table naturalresource.resource_asset {
  resource_asset_id varchar [pk, note: 'Unique identifier for the natural resource asset. Primary key for timberland parcels, farmland tracts, mining concessions, energy assets (upstream oil & gas, renewables), and other physical resource holdings.']
  asset_manager_gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Asset manager assignment is required for performance reporting and regulatory compliance.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Audit findings related to asset operations.']
  certification_id varchar [note: 'Foreign key linking to compliance.certification. Business justification: Certifications (ISO, etc.) for asset.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Country risk assessment for each asset is driven by the country outlook.']
  gips_compliance_record_id varchar [note: 'Foreign key linking to compliance.gips_compliance_record. Business justification: GIPS compliance record for asset performance reporting.']
  operator_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Captures operator entity for regulatory and ESG reporting, required for compliance and reporting.']
  policy_document_id varchar [note: 'Foreign key linking to compliance.policy_document. Business justification: Asset‑specific ESG policy documents.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: The pension fund tracks natural resource assets as part of project investments; linking them enables consolidated reporting of project performance and ESG metrics.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: SFDR disclosure for asset sustainability metrics.']
  acquisition_cost decimal(18,2) [note: 'Total cost paid to acquire the resource asset, including purchase price and direct acquisition expenses, in base currency (USD).']
  acquisition_date date [note: 'Date on which the pension fund acquired ownership or control of the natural resource asset.']
  annual_production_capacity decimal(18,2) [note: 'Estimated annual production or harvest capacity of the resource asset in the unit specified by production_unit_of_measure.']
  area_unit_of_measure varchar [note: 'Unit of measure for the total_area field.']
  asset_identifier varchar [note: 'Externally-recognized unique code or registration number for the resource asset (e.g., cadastral parcel ID, mining concession number, lease block identifier, title deed reference).']
  asset_name varchar [note: 'Human-readable name or designation of the natural resource asset (e.g., \'Cascade Timberland Tract\', \'Permian Basin Block 7\', \'Iowa Farmland Portfolio A\').']
  asset_status varchar [note: 'Current operational and ownership status of the resource asset within the portfolio.']
  carbon_footprint decimal(18,2) [note: 'Estimated annual greenhouse gas (GHG) emissions attributable to the resource asset, measured in tonnes of CO2 equivalent.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code where the resource asset is physically located.']
  created_timestamp timestamp [note: 'Timestamp when this resource asset record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values associated with this asset.']
  current_valuation decimal(18,2) [note: 'Most recent fair market value or Net Asset Value (NAV) of the resource asset in base currency (USD).']
  data_source_system varchar [note: 'Name of the operational system of record from which this resource asset data originated (e.g., \'eFront\', \'SimCorp Dimension\', \'Internal Asset Register\').']
  depletion_method varchar [note: 'Accounting method used to allocate the cost of the resource asset over its productive life.']
  discount_rate decimal(5,2) [note: 'Discount rate or Weighted Average Cost of Capital (WACC) used in valuation models for this resource asset, expressed as a percentage.']
  environmental_certification varchar [note: 'Environmental or sustainability certifications held by the resource asset (e.g., FSC for timberland, ISO 14001, LEED, organic certification for farmland).']
  esg_rating varchar [note: 'Overall ESG rating or score assigned to the resource asset by internal or external ESG assessment (e.g., MSCI ESG rating, internal sustainability score).']
  estimated_useful_life_years varchar [note: 'Estimated remaining productive life of the resource asset in years, based on current reserve estimates and production rates.']
  geographic_region varchar [note: 'Primary geographic region or jurisdiction where the resource asset is located (e.g., \'North America\', \'Latin America\', \'Asia Pacific\').']
  insurance_coverage decimal(18,2) [note: 'Total insurance coverage amount for the resource asset, including property, liability, and operational risk insurance, in base currency (USD).']
  investment_strategy varchar [note: 'Investment strategy or mandate under which this resource asset was acquired (e.g., \'Core Natural Resources\', \'Opportunistic Energy\', \'Sustainable Timberland\').']
  last_inspection_date date [note: 'Date of the most recent physical inspection, audit, or operational review of the resource asset.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the resource asset centroid in decimal degrees (WGS84).']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the resource asset centroid in decimal degrees (WGS84).']
  next_inspection_date date [note: 'Scheduled date for the next physical inspection, audit, or operational review of the resource asset.']
  operator_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the operator of the resource asset.']
  operator_name varchar [note: 'Name of the entity responsible for day-to-day operations and management of the resource asset (may be the pension fund or a third-party operator).']
  ownership_percentage decimal(5,2) [note: 'Percentage of economic interest or ownership held by the pension fund in this resource asset (0.00 to 100.00).']
  ownership_structure varchar [note: 'Legal structure of the pension fund\'s ownership interest in the resource asset.']
  permit_expiry_date date [note: 'Expiration date of the primary regulatory permit or concession for the resource asset.']
  production_unit_of_measure varchar [note: 'Unit of measure for annual_production_capacity (e.g., \'barrels_per_day\', \'tonnes_per_year\', \'megawatt_hours\').']
  productive_area decimal(18,2) [note: 'Portion of total area that is actively productive or economically harvestable, in the same unit as total_area.']
  regulatory_permits varchar [note: 'Key regulatory permits, licenses, or concessions held for the operation of the resource asset (e.g., mining permit, drilling license, water rights).']
  reserve_classification varchar [note: 'Confidence classification of the reserve estimate per industry standards (e.g., PRMS for oil & gas, JORC for mining).']
  reserve_quantity decimal(18,2) [note: 'Estimated proven or probable reserves of the resource (e.g., barrels of oil, cubic meters of timber, tonnes of ore) in the unit specified by reserve_unit_of_measure.']
  reserve_unit_of_measure varchar [note: 'Unit of measure for reserve_quantity (e.g., \'barrels\', \'cubic_meters\', \'tonnes\', \'board_feet\').']
  resource_subtype varchar [note: 'Detailed sub-classification within the resource type (e.g., \'softwood timberland\', \'row crop farmland\', \'gold mining\', \'offshore oil\', \'solar farm\', \'wind farm\').']
  resource_type varchar [note: 'Primary classification of the natural resource asset by resource category.']
  risk_rating varchar [note: 'Overall risk rating assigned to the resource asset based on operational, environmental, regulatory, and market risk factors.']
  state_province varchar [note: 'State, province, or first-level administrative division where the resource asset is located.']
  total_area decimal(18,2) [note: 'Total physical area or acreage of the resource asset in the unit specified by area_unit_of_measure.']
  updated_timestamp timestamp [note: 'Timestamp when this resource asset record was last modified in the system.']
  valuation_date date [note: 'Date of the most recent independent valuation or appraisal of the resource asset.']
  valuation_method varchar [note: 'Primary valuation methodology used to determine current_valuation (e.g., Discounted Cash Flow (DCF), comparable sales, income approach).']

  Note: 'SSOT for natural resource asset identity within the naturalresource domain. Master record for each physical resource asset held by the pension fund: timberland parcels, farmland tracts, mining concessions, energy assets (upstream oil & gas, renewables)'
}

Table naturalresource.resource_holding {
  resource_holding_id varchar [pk, note: 'Unique identifier for the natural resource holding record. Primary key for the resource holding entity.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Each resource holding has a dedicated cash account for holding-level cash flows and settlement.']
  general_partner_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Links general partner legal entity for capital call, fee calculation, and compliance monitoring.']
  gp_entity_id varchar [note: 'Reference to the general partner or fund manager responsible for managing this natural resource investment vehicle.']
  gp_profile_id varchar [note: 'Reference to the general partner or fund manager responsible for managing this natural resource investment vehicle.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this resource holding is allocated.']
  resource_vehicle_id varchar [note: 'Reference to the natural resource investment vehicle or fund in which the pension fund holds an economic interest.']
  carbon_footprint_tonnes decimal(18,2) [note: 'Estimated annual carbon footprint of the natural resource holding, measured in metric tonnes of CO2 equivalent emissions.']
  commitment_date date [note: 'Date on which the pension fund committed capital to this natural resource investment vehicle or asset, typically the Limited Partnership Agreement (LPA) signing date or acquisition agreement date.']
  committed_capital_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to this natural resource holding, representing the maximum obligation under the investment agreement.']
  committed_capital_currency varchar [note: 'Three-letter ISO 4217 currency code for the committed capital amount.']
  commodity_price_exposure varchar [note: 'Primary commodity or commodities to which this natural resource holding has price exposure, such as timber, corn, gold, crude oil, or natural gas.']
  cost_basis_amount decimal(18,2) [note: 'Original acquisition cost or book value of the natural resource holding, used for gain/loss calculation and accounting purposes.']
  cumulative_distributions_amount decimal(18,2) [note: 'Total distributions received by the pension fund from this natural resource holding since inception, including income, return of capital, and realized gains.']
  custodian_code varchar [note: 'Reference to the custodian bank or fund administrator holding legal custody of the investment documents and assets.']
  depletion_method varchar [note: 'Accounting method used to allocate the cost of natural resource extraction over the assets productive life: units of production, straight-line, declining balance, or not applicable for non-depleting assets.']
  depletion_rate_percentage decimal(5,2) [note: 'Annual depletion rate applied to the natural resource asset for accounting and valuation purposes, expressed as a percentage.']
  dpi_multiple decimal(5,2) [note: 'Cash-on-cash return metric calculated as cumulative distributions divided by paid-in capital, indicating realized return multiple.']
  economic_interest_percentage decimal(5,2) [note: 'Percentage of economic returns (distributions, profits, carried interest) to which the pension fund is entitled, which may differ from legal ownership percentage due to waterfall structures.']
  esg_rating varchar [note: 'ESG rating assigned to this natural resource holding by internal or external ESG assessment, reflecting environmental stewardship, social responsibility, and governance quality.']
  expected_harvest_date date [note: 'Anticipated date for major harvest or production event for the natural resource asset, such as timber harvest, crop harvest, or mine production commencement.']
  fund_term_years varchar [note: 'Total term of the natural resource fund or investment vehicle in years, including any extension periods, as specified in the Limited Partnership Agreement.']
  geographic_focus varchar [note: 'Primary geographic region or country where the natural resource assets are located, using three-letter ISO country codes or regional descriptors.']
  holding_status varchar [note: 'Current lifecycle status of the resource holding: active management, committed but not yet funded, partially funded with remaining capital calls expected, fully funded, in harvesting or production phase, under divestment process, or fully exited.']
  holding_type varchar [note: 'Classification of the natural resource holding structure: direct ownership of physical assets, limited partner commitment to a fund, co-investment alongside a sponsor, fund of funds allocation, secondary market purchase, or joint venture participation.']
  investment_strategy varchar [note: 'Description of the investment strategy employed for this natural resource holding, such as sustainable forestry, organic farmland, precious metals exploration, renewable energy infrastructure, or commodity arbitrage.']
  irr_percentage decimal(5,2) [note: 'Annualized internal rate of return on the natural resource holding, calculated using cash flows and current NAV.']
  is_co_investment boolean [note: 'Boolean flag indicating whether this holding represents a co-investment alongside a general partner or lead investor, typically with reduced or no management fees.']
  last_capital_call_date date [note: 'Date of the most recent capital call or drawdown notice issued by the general partner for this natural resource holding.']
  legal_entity_identifier varchar [note: '20-character ISO 17442 Legal Entity Identifier for the investment vehicle or holding entity, enabling global entity identification.']
  maturity_date date [note: 'Expected maturity or termination date of the natural resource investment vehicle or holding, after which final distributions and liquidation occur.']
  moic_multiple decimal(5,2) [note: 'Gross return multiple calculated as total value divided by total invested capital, synonymous with TVPI for most holdings.']
  nav_amount decimal(18,2) [note: 'Current net asset value of the pension funds holding in this natural resource investment, representing fair market value of the position.']
  nav_as_of_date date [note: 'Valuation date for the reported NAV amount, typically quarter-end or month-end.']
  next_valuation_date date [note: 'Scheduled date for the next formal valuation of the natural resource holding, typically quarterly or annually.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership interest held by the pension fund in the natural resource vehicle or asset, expressed as a decimal percentage.']
  paid_in_capital_amount decimal(18,2) [note: 'Cumulative capital actually drawn down and invested in the natural resource holding to date, also known as PIC.']
  production_unit varchar [note: 'Unit of measure for production volume, such as board feet, metric tons, bushels, barrels, cubic meters, or troy ounces.']
  production_volume decimal(18,2) [note: 'Current or projected annual production volume from the natural resource asset, measured in asset-specific units such as board feet for timber, bushels for crops, ounces for precious metals, or barrels for oil.']
  record_created_timestamp timestamp [note: 'Timestamp when this resource holding record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this resource holding record was last modified in the system.']
  resource_asset_class varchar [note: 'Primary natural resource asset class category for this holding: timberland, farmland, mining operations, energy assets, or commodity-linked investments.']
  resource_sub_class varchar [note: 'Detailed sub-classification within the resource asset class, such as softwood timberland, row crop farmland, precious metals mining, oil and gas upstream, or commodity futures strategy.']
  rvpi_multiple decimal(5,2) [note: 'Unrealized value metric calculated as current NAV divided by paid-in capital, indicating remaining value multiple.']
  sustainability_certification varchar [note: 'Sustainability or environmental certification held by the natural resource asset, such as Forest Stewardship Council (FSC) for timberland, USDA Organic for farmland, or Responsible Mining Initiative certification.']
  total_value_amount decimal(18,2) [note: 'Sum of current NAV and cumulative distributions, representing the total value generated by the holding to date.']
  tvpi_multiple decimal(5,2) [note: 'Performance metric calculated as total value divided by paid-in capital, indicating the gross return multiple on invested capital.']
  unfunded_commitment_amount decimal(18,2) [note: 'Remaining uncalled committed capital available for future capital calls, commonly referred to as dry powder. Calculated as committed capital minus paid-in capital.']
  valuation_methodology varchar [note: 'Primary valuation approach used for this natural resource holding, such as discounted cash flow (DCF), comparable transactions, net asset value (NAV), or resource-specific models like stumpage value for timber or reserve-based valuation for mining.']
  vintage_year varchar [note: 'Year in which the initial capital commitment was made or the fund was established, used for cohort performance analysis and benchmarking.']

  Note: 'SSOT for the pension fund\'s economic interest in each natural resource vehicle — both direct asset holdings and LP/fund commitments. Tracks committed capital, invested capital (PIC), remaining unfunded commitment (dry powder), ownership percentage'
}

Table naturalresource.production_record {
  production_record_id varchar [pk, note: 'Unique identifier for the production record. Primary key for the production record entity.']
  resource_asset_id varchar [note: 'Foreign key reference to the specific natural resource asset (timberland, farmland, mining site, oil/gas field) that generated this production output.']
  audit_completion_date date [note: 'Date when external audit or verification of the production record was completed. Marks transition to final status for NAV purposes.']
  auditor_name varchar [note: 'Name of the external audit firm or independent verifier that validated the production data. Provides audit trail for compliance and investor reporting.']
  auditor_verification_flag boolean [note: 'Indicates whether the production record has been independently verified by external auditors. Required for final NAV calculation and regulatory reporting.']
  benchmark_commodity_price decimal(18,4) [note: 'Market benchmark price for the commodity during the reporting period (e.g., WTI crude, LME copper, regional timber index). Used for performance attribution and variance analysis.']
  certification_type varchar [note: 'Type of sustainability or responsible sourcing certification held by the asset (e.g., FSC for timber, organic certification for farmland, Equator Principles for mining). Enhances ESG profile and market access.']
  commodity_grade varchar [note: 'Quality classification or grade of the produced commodity. Affects pricing and marketability (e.g., timber grade, ore purity, crude oil API gravity, crop quality).']
  contract_reference_number varchar [note: 'Reference identifier for the production or offtake contract governing this production activity. Links production data to contractual terms and pricing mechanisms.']
  data_quality_score decimal(3,2) [note: 'Quality score for the production data on a scale of 0.00 to 1.00. Reflects completeness, accuracy, and timeliness. Used to assess confidence in valuation inputs.']
  data_source varchar [note: 'Origin of the production data. Indicates reliability and audit trail for NAV determination and performance reporting.']
  depletion_charge decimal(18,2) [note: 'Accounting charge representing the reduction in resource reserves due to extraction. Calculated using units-of-production method for natural resource assets.']
  environmental_incident_flag boolean [note: 'Indicates whether an environmental incident (spill, contamination, habitat damage) occurred during the production period. Critical for ESG reporting and risk management.']
  ghg_emissions_tonnes_co2e decimal(18,4) [note: 'Total greenhouse gas emissions generated during production, measured in tonnes of CO2 equivalent. Required for ESG integration and TCFD climate risk reporting.']
  gross_revenue decimal(18,2) [note: 'Total revenue generated from production before deducting operating costs, royalties, and taxes. Calculated as production volume multiplied by realized price.']
  harvest_method varchar [note: 'Operational method used to extract or harvest the resource. Impacts cost structure, ESG metrics, and depletion rate calculations. [ENUM-REF-CANDIDATE']
  hedging_instrument_flag boolean [note: 'Indicates whether commodity price hedging instruments (futures, swaps, collars) were in place for this production. Affects realized price and risk exposure.']
  net_operating_income decimal(18,2) [note: 'Net income from production after deducting operating costs and royalties. Key metric for asset-level performance evaluation and valuation.']
  notes varchar [note: 'Free-text field for additional context, operational notes, or explanations of variances. Supports qualitative analysis and exception documentation.']
  operating_cost decimal(18,2) [note: 'Direct operating expenses incurred to produce the resource output during the reporting period. Includes labor, equipment, materials, and site maintenance.']
  operator_name varchar [note: 'Name of the entity responsible for day-to-day production operations. May be the fund itself or a contracted third-party operator.']
  price_realization_percentage decimal(5,2) [note: 'Percentage of benchmark commodity price achieved in actual sales. Measures pricing effectiveness and quality premium/discount relative to market.']
  pricing_currency varchar [note: 'Three-letter ISO 4217 currency code for the realized price. Natural resource commodities often priced in USD but may vary by market and contract.']
  production_efficiency_rate decimal(5,2) [note: 'Percentage of planned production achieved during the reporting period. Measures operational performance against targets and identifies underperforming assets.']
  production_status varchar [note: 'Current validation status of the production record. Tracks progression from preliminary field data through audit and final confirmation for NAV calculation.']
  production_unit_of_measure varchar [note: 'Unit of measure for production volume. Varies by resource type: cubic meters or MBF for timber, tonnes for minerals, barrels for oil, bushels for crops, MWh for energy.']
  production_volume decimal(18,4) [note: 'Physical quantity of resource output produced during the reporting period. Measured in resource-specific units (cubic meters, tonnes, barrels, bushels).']
  realized_price_per_unit decimal(18,4) [note: 'Actual price received per unit of production during the reporting period. Used for revenue recognition and performance attribution analysis.']
  record_created_timestamp timestamp [note: 'Timestamp when the production record was first created in the system. Audit trail for data lineage and regulatory compliance.']
  record_updated_by varchar [note: 'Identifier of the user or system that last updated the production record. Supports accountability and audit trail requirements.']
  record_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the production record. Tracks data modification history for audit and reconciliation purposes.']
  regulatory_compliance_status varchar [note: 'Current compliance status with applicable environmental, safety, and operational regulations. Non-compliance can trigger operational shutdowns and financial penalties.']
  remaining_reserves_estimate decimal(18,4) [note: 'Estimated quantity of recoverable resource remaining after this production period. Updated based on production data and reserve studies for long-term planning.']
  reporting_period_end_date date [note: 'End date of the production reporting period. Defines the boundary for production measurement and valuation.']
  reporting_period_start_date date [note: 'Start date of the production reporting period. Typically monthly or quarterly for natural resource assets.']
  reserve_life_years decimal(8,2) [note: 'Estimated number of years of remaining production at current extraction rates. Critical metric for long-duration liability matching and asset allocation decisions.']
  resource_type varchar [note: 'Classification of the natural resource being produced. Determines the applicable production metrics and valuation methodology.']
  royalty_payment decimal(18,2) [note: 'Royalty or lease payment owed to landowners, governments, or mineral rights holders based on production volume or revenue. Common in mining and oil/gas.']
  safety_incident_count varchar [note: 'Number of recordable safety incidents (injuries, near-misses) during the production period. Key operational risk and ESG metric for natural resource operations.']
  third_party_operator_flag boolean [note: 'Indicates whether production operations are managed by a third-party operator under contract rather than directly by the fund. Affects operational control and risk profile.']
  water_usage_unit varchar [note: 'Unit of measure for water usage volume. Varies by jurisdiction and industry practice.']
  water_usage_volume decimal(18,4) [note: 'Volume of water consumed during production operations. Critical ESG metric for water-intensive activities like mining, oil/gas extraction, and irrigation.']
  weather_impact_flag boolean [note: 'Indicates whether production was materially affected by adverse weather conditions (drought, flood, frost, hurricane). Relevant for farmland and timber assets.']

  Note: 'Operational production data captured at the asset level on a periodic basis (monthly/quarterly). Records physical output volumes for each resource type: timber harvest volumes (m³/MBF), crop yields (bushels/tonnes), mineral extraction tonnage, oil & gas'
}

Table naturalresource.commodity_exposure {
  commodity_exposure_id varchar [pk, note: 'Unique identifier for the commodity exposure record.']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: Commodity exposure uses macro indicators to capture price and supply dynamics.']
  market_consensus_id varchar [note: 'Foreign key linking to research.market_consensus. Business justification: Consensus estimates provide benchmark prices for commodity exposure calculations.']
  natural_resource_asset_id varchar [note: 'Reference to the underlying natural resource asset (timberland, farmland, mining, energy) generating the commodity exposure.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding the natural resource assets generating this commodity exposure.']
  benchmark_commodity_index varchar [note: 'Reference commodity index or benchmark used to measure relative performance and price risk (e.g., Bloomberg Commodity Index, S&P GSCI, BCOM Agriculture).']
  benchmark_ticker varchar [note: 'Bloomberg or exchange ticker symbol for the benchmark commodity index or futures contract.']
  comments varchar [note: 'Free-text field for additional notes, qualitative assessments, or special considerations regarding the commodity exposure.']
  commodity_subtype varchar [note: 'Detailed subtype or grade of the commodity (e.g., WTI crude, Brent crude, hard red winter wheat, softwood lumber).']
  commodity_type varchar [note: 'Type of commodity to which the fund has price exposure through natural resource holdings. [ENUM-REF-CANDIDATE: lumber|wheat|corn|soy|crude_oil|natural_gas|copper|gold|iron_ore|silver|platinum|coal|uranium|nickel|zinc|aluminum — 16 candidates stripped']
  correlation_to_portfolio decimal(6,4) [note: 'Statistical correlation coefficient between commodity price movements and overall portfolio returns, used for diversification analysis.']
  country_code varchar [note: 'Three-letter ISO country code for the jurisdiction of the commodity-producing asset.']
  created_timestamp timestamp [note: 'Timestamp when the commodity exposure record was first created in the system.']
  data_source varchar [note: 'Primary source system or vendor providing commodity price and exposure data (e.g., Bloomberg, eFront, internal valuation model).']
  depletion_rate_annual decimal(8,4) [note: 'Annual depletion rate of commodity reserves as a percentage, used for reserve life and valuation modeling.']
  esg_carbon_intensity decimal(12,4) [note: 'Carbon intensity of commodity production measured in metric tons CO2 equivalent per unit of commodity produced.']
  esg_water_usage_intensity decimal(12,4) [note: 'Water consumption intensity for commodity production measured in cubic meters per unit of commodity produced.']
  exposure_classification varchar [note: 'Classification of how the commodity exposure arises (direct production, reserves, contractual commitments, or fund investments).']
  exposure_duration_years decimal(6,2) [note: 'Expected duration of commodity price exposure in years, based on production schedules, reserve life, or contract terms.']
  exposure_notional_usd decimal(20,2) [note: 'Notional value of commodity price exposure in USD, representing the market value of the underlying commodity production or reserves.']
  exposure_percentage_of_aum decimal(8,4) [note: 'Commodity exposure expressed as a percentage of total AUM, used for portfolio concentration risk monitoring.']
  exposure_status varchar [note: 'Current lifecycle status of the commodity exposure for portfolio monitoring and risk management.']
  fair_value_level varchar [note: 'IFRS 13 fair value hierarchy level for the commodity exposure valuation (Level 1: quoted prices, Level 2: observable inputs, Level 3: unobservable inputs).']
  forward_curve_contango_backwardation varchar [note: 'Current shape of the commodity forward price curve, indicating market expectations and storage costs.']
  fx_rate_to_reporting_currency decimal(18,8) [note: 'Exchange rate used to convert local commodity prices to reporting currency at measurement date.']
  geographic_region varchar [note: 'Geographic region where the commodity-producing asset is located, used for geopolitical risk assessment.']
  hedge_ratio_percentage decimal(6,2) [note: 'Percentage of commodity exposure that is hedged through derivatives or forward contracts, used for risk mitigation analysis.']
  hedging_instrument_type varchar [note: 'Type of derivative instrument used to hedge commodity price risk, if any.']
  is_active boolean [note: 'Boolean flag indicating whether the commodity exposure record is currently active and should be included in portfolio analytics.']
  last_modified_by varchar [note: 'User identifier of the person or system that last modified the commodity exposure record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the commodity exposure record was last updated.']
  last_review_date date [note: 'Date when the commodity exposure was last reviewed by the investment or risk management team.']
  measurement_date date [note: 'Date on which the commodity exposure and associated metrics were measured and recorded.']
  next_review_date date [note: 'Scheduled date for the next review of the commodity exposure by the investment or risk management team.']
  price_sensitivity_dv01 decimal(18,2) [note: 'Dollar value change in exposure for a 1% move in commodity price, used for risk analytics and stress testing.']
  price_unit_of_measure varchar [note: 'Unit of measure for commodity pricing (e.g., per barrel, per bushel, per metric ton, per troy ounce, per MMBtu).']
  production_volume_annual decimal(20,4) [note: 'Expected annual production volume of the commodity from the underlying natural resource asset.']
  quantity_exposed decimal(20,4) [note: 'Physical quantity of commodity to which the fund is exposed through production, reserves, or contractual commitments.']
  quantity_unit_of_measure varchar [note: 'Unit of measure for the exposed commodity quantity (e.g., barrels, bushels, metric tons, troy ounces, cubic meters).']
  regulatory_classification varchar [note: 'Regulatory classification of the commodity exposure for reporting purposes (e.g., strategic reserve, speculative, hedging).']
  reporting_currency varchar [note: 'Three-letter ISO currency code in which the exposure is reported (typically USD for commodity exposures).']
  reserve_classification varchar [note: 'Classification of commodity reserves based on geological certainty and economic viability.']
  reserve_quantity decimal(20,4) [note: 'Total proven and probable reserves of the commodity in the underlying natural resource asset.']
  spot_price_per_unit decimal(18,6) [note: 'Current spot market price per unit of the commodity at the measurement date.']
  valuation_methodology varchar [note: 'Primary valuation methodology used to determine the fair value of the commodity exposure.']
  var_contribution_usd decimal(18,2) [note: 'Contribution of this commodity exposure to the overall portfolio VaR, calculated at 95% confidence level.']
  created_by varchar [note: 'User identifier of the person or system that created the commodity exposure record.']

  Note: 'Tracks the fund\'s commodity price exposure arising from natural resource holdings. Captures commodity type (lumber, wheat, corn, soy, crude oil, natural gas, copper, gold, iron ore), notional exposure in USD, exposure as % of AUM, benchmark commodity'
}

Table naturalresource.depletion_schedule {
  depletion_schedule_id varchar [pk, note: 'Unique identifier for the depletion schedule record. Primary key for asset-level depletion tracking of wasting natural resource assets.']
  investment_id varchar [note: 'Reference to the parent investment transaction that acquired the natural resource asset.']
  natural_resource_asset_id varchar [note: 'Reference to the underlying natural resource asset (timberland, farmland, mining property, energy reserve) subject to depletion.']
  reserve_estimate_id varchar [note: 'Foreign key linking to naturalresource.reserve_estimate. Business justification: Depletion schedules for wasting assets are calculated based on reserve estimates (units-of-production method).']
  acquisition_cost decimal(18,2) [note: 'Total capitalized cost of acquiring the natural resource asset, including purchase price and direct acquisition costs.']
  acquisition_cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the acquisition cost amount.']
  acquisition_date date [note: 'Date when the natural resource asset was acquired and placed into service.']
  asset_type varchar [note: 'Classification of the natural resource asset subject to depletion.']
  commodity_price_assumption decimal(18,4) [note: 'Long-term commodity price assumption used in reserve valuation and depletion rate calculations.']
  created_timestamp timestamp [note: 'System timestamp when this depletion schedule record was first created in the data platform.']
  cumulative_depletion_to_date decimal(18,2) [note: 'Total depletion expense recognized from acquisition date through current reporting period.']
  cumulative_impairment_loss decimal(18,2) [note: 'Total impairment losses recognized on the asset to date, reducing the carrying value below depletable base less depletion.']
  cumulative_production_to_date decimal(18,4) [note: 'Total quantity of reserves extracted or harvested from acquisition date through current reporting period.']
  current_period_depletion decimal(18,2) [note: 'Depletion expense recognized for the current reporting period based on production volume and depletion rate.']
  current_period_production decimal(18,4) [note: 'Quantity of reserves extracted or harvested during the current reporting period.']
  data_source_system varchar [note: 'Name of the upstream operational system from which this depletion schedule data originated.']
  depletable_base decimal(18,2) [note: 'Total cost basis subject to depletion, typically acquisition cost less estimated residual land value.']
  depletion_method varchar [note: 'Accounting method used to calculate periodic depletion expense for the wasting asset.']
  depletion_rate_per_unit decimal(18,6) [note: 'Cost per unit of production used to calculate depletion expense, computed as depletable base divided by total proven reserves.']
  depletion_schedule_status varchar [note: 'Current lifecycle status of the depletion schedule reflecting asset operational state.']
  discount_rate decimal(5,4) [note: 'Discount rate applied in discounted cash flow (DCF) valuation of future reserve production for impairment testing.']
  environmental_reclamation_reserve decimal(18,2) [note: 'Accrued liability for future environmental reclamation and site restoration costs associated with resource extraction.']
  estimated_depletion_completion_date date [note: 'Projected date when the asset will be fully depleted based on current production rates and remaining reserves.']
  external_reserve_engineer varchar [note: 'Name of the independent third-party reserve engineer or consultant who certified the proven reserve estimates.']
  impairment_indicator_flag boolean [note: 'Indicates whether impairment indicators have been identified requiring impairment testing under IAS 36 or FASB ASC 360.']
  impairment_test_date date [note: 'Date of the most recent impairment test performed on the natural resource asset.']
  last_reserve_certification_date date [note: 'Date when proven reserves were last certified by an independent reserve engineer.']
  last_updated_timestamp timestamp [note: 'System timestamp when this depletion schedule record was most recently modified.']
  net_book_value decimal(18,2) [note: 'Current carrying value of the natural resource asset, calculated as depletable base less cumulative depletion to date.']
  notes varchar [note: 'Free-text notes capturing additional context, assumptions, or special considerations for this depletion schedule.']
  remaining_reserves decimal(18,4) [note: 'Current estimate of remaining recoverable reserves after cumulative depletion, updated periodically based on reserve studies.']
  reporting_period_end_date date [note: 'End date of the reporting period for which current period depletion and production are measured.']
  reporting_period_start_date date [note: 'Start date of the reporting period for which current period depletion and production are measured.']
  reserve_revision_date date [note: 'Date of the most recent reserve study or revision that updated proven reserve estimates.']
  reserve_revision_reason varchar [note: 'Business reason for the reserve revision, such as new geological data, price changes, or regulatory updates.']
  reserve_unit_of_measure varchar [note: 'Unit of measure for quantifying proven reserves and production volumes. [ENUM-REF-CANDIDATE: barrels|cubic_meters|tonnes|board_feet|acres|hectares|troy_ounces — 7 candidates stripped; promote to reference product]']
  residual_land_value decimal(18,2) [note: 'Estimated value of the land after resource extraction is complete, excluded from depletable base.']
  responsible_investment_officer varchar [note: 'Name of the investment officer responsible for managing this natural resource asset and its depletion schedule.']
  schedule_name varchar [note: 'Business-friendly name or label for this depletion schedule, typically including asset name and vintage year.']
  tax_depletion_allowance decimal(18,2) [note: 'Depletion deduction claimed for tax purposes in the current reporting period.']
  tax_depletion_method varchar [note: 'Depletion method used for tax reporting purposes, which may differ from financial reporting method.']
  total_proven_reserves decimal(18,4) [note: 'Total quantity of proven recoverable reserves at acquisition date, used as denominator in unit-of-production depletion.']
  valuation_model_reference varchar [note: 'Reference identifier for the resource-specific valuation model used for fair value measurement and impairment testing.']

  Note: 'Asset-level depletion, amortization, and depreciation schedule for wasting natural resource assets. Captures depletion method (unit-of-production, straight-line, declining balance), total proven reserves at acquisition, cumulative depletion to date'
}

Table naturalresource.reserve_estimate {
  reserve_estimate_id varchar [pk, note: 'Unique identifier for the reserve estimate record. Primary key for the reserve estimate entity.']
  previous_estimate_reserve_estimate_id varchar [note: 'Foreign key reference to the prior reserve estimate record that this estimate supersedes, enabling historical tracking and variance analysis.']
  resource_asset_id varchar [note: 'Foreign key reference to the underlying natural resource asset (mining property, oil & gas field, timberland tract) for which reserves are estimated.']
  audit_firm_name varchar [note: 'Name of the independent reserves auditing firm that reviewed or certified the reserve estimate, if applicable (e.g., DeGolyer & MacNaughton, Gaffney Cline, SRK Consulting).']
  audit_report_date date [note: 'Date of the independent audit report or certification, if the reserve estimate was externally audited.']
  capital_expenditure_estimate decimal(18,2) [note: 'Total estimated capital expenditure required to develop and extract the reserves, including drilling, infrastructure, equipment, and facility costs.']
  commodity_price_assumption decimal(18,4) [note: 'Long-term commodity price assumption (per unit of measure) used in the economic evaluation of the reserves, typically based on forward curves, analyst consensus, or internal forecasts.']
  commodity_type varchar [note: 'Type of commodity or natural resource being estimated: crude oil, natural gas, gold, copper, iron ore, coal, timber, agricultural products, etc.']
  confidence_level_percent decimal(5,2) [note: 'Statistical confidence level or probability percentage associated with the reserve estimate, typically P10, P50, P90 for probabilistic assessments (e.g., 90% confidence for proven reserves).']
  created_by_user varchar [note: 'User identifier or name of the person who created this reserve estimate record, supporting accountability and audit trail.']
  created_timestamp timestamp [note: 'Timestamp when this reserve estimate record was first created in the system, supporting audit trail and data lineage requirements.']
  depletion_method varchar [note: 'Accounting method used to allocate the cost of the natural resource asset over its productive life: unit-of-production (most common for extractive industries), straight-line, declining balance, cost depletion, or percentage depletion.']
  discount_rate_percent decimal(5,2) [note: 'Discount rate (typically WACC or hurdle rate) applied in the NPV calculation to reflect the time value of money and risk profile of the reserves.']
  effective_date date [note: 'The date as of which this reserve estimate is effective and valid. Critical for time-series valuation and regulatory reporting, as reserve estimates are point-in-time assessments.']
  environmental_adjustment_factor decimal(5,4) [note: 'Adjustment factor applied to reserves to account for environmental constraints, protected areas, seasonal restrictions, or ESG considerations that may limit extraction.']
  estimate_identifier varchar [note: 'Externally-known business identifier or report reference number for this reserve estimate, used in regulatory filings and investment committee materials.']
  estimate_status varchar [note: 'Current lifecycle status of the reserve estimate: draft (under preparation), preliminary (initial assessment), final (approved for use), superseded (replaced by newer estimate), archived (historical record).']
  estimated_npv decimal(18,2) [note: 'Net present value of the reserves calculated using discounted cash flow (DCF) analysis, incorporating commodity price forecasts, operating costs, capital expenditures, and discount rate assumptions.']
  estimation_method varchar [note: 'Technical method used to estimate reserves: deterministic (single-point), probabilistic (Monte Carlo), analogous (comparison), volumetric (geological), decline curve analysis, material balance, or reservoir simulation.']
  geological_model_version varchar [note: 'Version identifier of the geological or reservoir model used as the basis for the reserve estimate, enabling traceability and change management.']
  gross_reserves decimal(20,4) [note: 'Total reserves attributable to the asset before deducting royalties, government take, or working interest adjustments. Represents 100% of the resource in place.']
  independent_audit_flag boolean [note: 'Boolean flag indicating whether the reserve estimate was independently audited or reviewed by a third-party reserves auditor (true) or prepared internally (false).']
  modified_by_user varchar [note: 'User identifier or name of the person who last modified this reserve estimate record, supporting accountability and audit trail.']
  modified_timestamp timestamp [note: 'Timestamp when this reserve estimate record was last modified, supporting change tracking and audit trail requirements.']
  net_reserves decimal(20,4) [note: 'Reserves attributable to the pension funds ownership interest after deducting royalties, government take, and adjusting for working interest or economic interest percentage.']
  notes varchar [note: 'Free-text notes capturing additional context, assumptions, limitations, or qualifications related to the reserve estimate that are important for investment decision-making.']
  operating_cost_per_unit decimal(18,4) [note: 'Estimated operating cost per unit of production (e.g., per barrel, per tonne) used in the economic evaluation, including extraction, processing, transportation, and overhead costs.']
  price_deck_scenario varchar [note: 'Scenario or case used for commodity price assumptions in the reserve valuation: base case, bull case (high prices), bear case (low prices), spot prices, forward curve, or analyst consensus.']
  production_start_date date [note: 'Actual or projected date when commercial production from the resource asset commenced or is expected to commence, relevant for reserve depletion scheduling.']
  qualified_person_credentials varchar [note: 'Professional credentials and certifications of the qualified person (e.g., P.Eng., P.Geo., Chartered Engineer, SPE member), demonstrating competence to prepare reserve estimates.']
  qualified_person_name varchar [note: 'Name of the qualified person (QP), competent person (CP), or professional engineer who prepared or reviewed the reserve estimate, as required by regulatory standards.']
  recoverable_quantity decimal(20,4) [note: 'Estimated quantity of the commodity that can be economically extracted and recovered from the resource asset, expressed in the unit of measure specified.']
  recovery_factor_percent decimal(5,2) [note: 'Percentage of the original resource in place that is estimated to be recoverable, reflecting extraction efficiency and technology limitations.']
  regulatory_approval_status varchar [note: 'Status of regulatory approvals required to extract the reserves: approved (permits granted), pending (under review), conditional (approved with conditions), denied, or not required.']
  reporting_standard varchar [note: 'The industry standard or regulatory framework under which this reserve estimate was prepared: SPE-PRMS (petroleum), JORC (Australia mining), NI 43-101 (Canada mining), SEC (US public companies), SAMREC (South Africa), PERC (Europe).']
  reserve_booking_date date [note: 'Date when the reserve estimate was formally booked or recorded in the pension funds asset register and investment accounting systems.']
  reserve_category varchar [note: 'Classification of reserve confidence level per industry standards: 1P (proven), 2P (proven + probable), 3P (proven + probable + possible) for petroleum; or measured, indicated, inferred for mining.']
  reserve_life_years decimal(6,2) [note: 'Estimated number of years the reserves will last at current or projected production rates. Calculated as recoverable quantity divided by annual production rate.']
  revision_reason varchar [note: 'Business reason for revising the reserve estimate: new drilling data, updated geological model, commodity price change, regulatory change, production performance, technology improvement, or annual review.']
  royalty_burden_percent decimal(5,2) [note: 'Percentage of production or reserves payable as royalty to mineral rights owners, government, or other parties, reducing the net economic interest.']
  unit_of_measure varchar [note: 'Unit of measure for the recoverable quantity: barrels (bbl) for oil, thousand cubic feet (mcf) for gas, barrels of oil equivalent (boe), tonnes or ounces for minerals, board feet for timber, acres for land.']
  valuation_date date [note: 'Date on which the economic valuation of the reserves was performed, which may differ from the effective date if market conditions or pricing assumptions were applied retrospectively.']
  working_interest_percent decimal(5,2) [note: 'Percentage ownership interest in the resource asset that entitles the pension fund to a proportionate share of production and reserves, net of royalties and government take.']

  Note: 'Proven, probable, and possible (3P) reserve estimates for extractive resource assets (mining, oil & gas). Captures reserve category (1P/2P/3P per SPE-PRMS or JORC standards), commodity type, estimated recoverable quantity, unit of measure, effective date'
}

Table naturalresource.resource_valuation {
  resource_valuation_id varchar [pk, note: 'Unique identifier for the natural resource asset valuation record.']
  commodity_price_deck_id varchar [note: 'Reference to the commodity price forecast deck used for revenue projections in the valuation model.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Country outlook is used to adjust valuation assumptions for geopolitical risk.']
  depletion_schedule_id varchar [note: 'Reference to the depletion or extraction schedule used for reserve-based valuation of mining, oil, gas, or timber assets.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Scenario‑based valuation of natural resource assets requires linking to the chosen economic scenario.']
  research_fx_rate_id varchar [note: 'Foreign key linking to research.research_fx_rate. Business justification: Currency conversion for valuation uses the chosen FX rate.']
  research_report_id varchar [note: 'Foreign key linking to research.report. Business justification: Valuation results are documented in formal research reports.']
  research_yield_curve_id varchar [note: 'Foreign key linking to research.research_yield_curve. Business justification: Discounting cash flows uses the selected research yield curve.']
  reserve_estimate_id varchar [note: 'Foreign key linking to naturalresource.reserve_estimate. Business justification: Resource valuations for extractive assets (mining, oil & gas) heavily depend on reserve estimates for DCF modeling.']
  resource_asset_id varchar [note: 'Reference to the underlying natural resource asset being valued (timberland, farmland, mining, energy, commodity fund).']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Sector outlook informs risk and return assumptions in valuations.']
  appraisal_firm_name varchar [note: 'Name of the independent third-party appraisal firm that conducted the valuation, if applicable.']
  appraisal_report_date date [note: 'Date of the independent appraisal report, if third-party valuation was obtained.']
  approval_date date [note: 'Date on which the valuation was formally approved by the Investment Committee or designated authority.']
  capital_expenditure_assumption decimal(20,2) [note: 'Total capital expenditure forecast used in the DCF model for sustaining and growth capital.']
  carbon_price_assumption decimal(10,2) [note: 'Assumed carbon price per ton of CO2 equivalent used in valuation model to reflect climate transition risk.']
  comparable_transaction_date date [note: 'Date of the most recent comparable market transaction used as a valuation benchmark.']
  comparable_transaction_multiple decimal(8,4) [note: 'Valuation multiple derived from comparable transactions (e.g., EV/EBITDA, price per acre, price per barrel of reserves).']
  created_timestamp timestamp [note: 'Timestamp when this valuation record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the fair value amount.']
  data_source_system varchar [note: 'Name of the source system or platform from which valuation inputs were extracted (e.g., eFront, Bloomberg, internal models).']
  discount_rate decimal(8,4) [note: 'Weighted Average Cost of Capital (WACC) or discount rate applied in DCF valuation, expressed as a decimal (e.g., 0.0850 for 8.50%).']
  esg_adjustment_factor decimal(8,6) [note: 'Valuation adjustment factor applied to reflect ESG risks or premiums (e.g., carbon pricing, social license risk, governance quality).']
  fair_value_amount decimal(20,2) [note: 'The determined fair value of the natural resource asset in the reporting currency.']
  fair_value_hierarchy_level varchar [note: 'IFRS 13 fair value hierarchy classification: Level 1 (quoted prices), Level 2 (observable inputs), Level 3 (unobservable inputs).']
  geopolitical_risk_rating varchar [note: 'Qualitative assessment of geopolitical risk associated with the asset location (expropriation, political instability, sanctions).']
  inflation_rate decimal(6,4) [note: 'Long-term inflation rate assumption applied to operating cost and revenue escalation, expressed as a decimal (e.g., 0.0250 for 2.50%).']
  last_modified_timestamp timestamp [note: 'Timestamp when this valuation record was last updated.']
  liquidity_discount decimal(6,4) [note: 'Discount applied to fair value to reflect illiquidity and lack of marketability of the natural resource asset, expressed as a decimal.']
  nav_per_unit decimal(18,6) [note: 'Net Asset Value per unit or share for fund-structured natural resource investments.']
  operating_cost_per_unit decimal(18,4) [note: 'Average operating cost per unit of production used in the valuation model.']
  prior_valuation_amount decimal(20,2) [note: 'Fair value from the immediately preceding valuation period, used for variance analysis.']
  production_unit_of_measure varchar [note: 'Unit of measure for production volume (barrels for oil, tons for minerals, cubic meters for gas, board feet for timber, bushels for farmland, MWh for energy, ounces for precious metals).']
  production_volume_assumption decimal(18,2) [note: 'Expected annual production volume used in valuation model (barrels, tons, cubic meters, board feet, bushels depending on resource type).']
  regulatory_risk_adjustment decimal(8,6) [note: 'Valuation discount or premium applied to reflect jurisdiction-specific regulatory risk (permitting, taxation, environmental compliance).']
  reserve_life_years decimal(6,2) [note: 'Estimated remaining economic life of the resource reserve in years, based on current production rates and proven reserves.']
  sensitivity_analysis_performed boolean [note: 'Indicates whether sensitivity analysis was conducted on key valuation assumptions (discount rate, commodity prices, production volumes).']
  terminal_value_assumption varchar [note: 'Description of terminal value methodology and assumptions used in DCF model (perpetuity growth rate, exit multiple, residual value approach).']
  valuation_analyst_name varchar [note: 'Name of the internal analyst or team responsible for preparing the valuation.']
  valuation_change_amount decimal(20,2) [note: 'Absolute change in fair value from the prior valuation period.']
  valuation_change_percentage decimal(8,4) [note: 'Percentage change in fair value from the prior valuation period, expressed as a decimal.']
  valuation_date date [note: 'The as-of date for which this fair value determination was performed.']
  valuation_frequency varchar [note: 'Scheduled frequency at which this natural resource asset is revalued.']
  valuation_method varchar [note: 'Primary valuation methodology applied: Discounted Cash Flow (DCF), comparable transaction, Net Asset Value (NAV), independent appraisal, market approach, or income approach.']
  valuation_model_version varchar [note: 'Version identifier of the internal valuation model or template used for this valuation.']
  valuation_notes varchar [note: 'Free-text commentary on valuation methodology, key assumptions, significant changes, or qualitative factors affecting the valuation.']
  valuation_reviewer_name varchar [note: 'Name of the senior reviewer or approver who validated the valuation.']
  valuation_status varchar [note: 'Current workflow status of the valuation record in the approval process.']

  Note: 'Periodic fair value and NAV determination records for natural resource assets, capturing valuation methodology (DCF, comparable transaction, NAV, appraisal), discount rate (WACC), terminal value assumptions, commodity price deck used, inflation'
}

Table naturalresource.capital_event {
  capital_event_id varchar [pk, note: 'Unique identifier for the capital event record in the natural resource investment portfolio.']
  natural_resource_investment_id varchar [note: 'Reference to the underlying natural resource investment (timberland, farmland, mining, energy, commodity fund) to which this capital event applies.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: Capital calls/distributions require direct portfolio linkage for cash management and liquidity planning. Investment operations reconcile capital events against portfolio commitments.']
  resource_asset_id varchar [note: 'Reference to the underlying natural resource investment (timberland, farmland, mining, energy, commodity fund) to which this capital event applies.']
  resource_fund_commitment_id varchar [note: 'Foreign key linking to naturalresource.resource_fund_commitment. Business justification: Capital events (calls, distributions) for fund investments draw down or distribute against specific fund commitments.']
  resource_holding_id varchar [note: 'Foreign key linking to naturalresource.resource_holding. Business justification: Capital events (capital calls, distributions) relate to specific resource holdings representing the fund\'s economic interest.']
  approval_date date [note: 'Date on which the capital event was approved by the Investment Committee (IC) or authorized treasury personnel for execution.']
  approval_status varchar [note: 'Internal approval status for the capital event funding or distribution acceptance, reflecting Investment Committee (IC) or treasury approval workflow.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the capital event for funding or acceptance, per internal governance protocols.']
  bank_account_reference varchar [note: 'Reference to the pension fund\'s bank account used for funding capital calls or receiving distributions, per Standard Settlement Instructions (SSI).']
  capital_recycling_flag boolean [note: 'Indicates whether this event is part of a capital recycling provision, where distributed capital is reinvested without counting against the original commitment.']
  commitment_amount decimal(18,2) [note: 'Total committed capital amount for the natural resource investment, representing the maximum capital the Limited Partner (LP) has agreed to contribute.']
  commodity_price_reference varchar [note: 'Reference commodity price index or benchmark used for valuation or distribution calculation (e.g., WTI Crude, Henry Hub Natural Gas, LME Copper).']
  created_timestamp timestamp [note: 'Timestamp when the capital event record was first created in the Investment Book of Record (IBOR) system.']
  depletion_adjustment_amount decimal(18,2) [note: 'Accounting adjustment for natural resource depletion associated with this capital event, reflecting the reduction in resource reserves or asset base.']
  distribution_type varchar [note: 'Classification of distribution: return of capital, income distribution, preferred return, carried interest, recallable distribution, or final liquidating distribution.']
  distributions_to_date decimal(18,2) [note: 'Cumulative distributions received by the Limited Partner (LP) from the natural resource investment as of this event, including this distribution if applicable.']
  due_date date [note: 'Date by which the capital call must be funded or the distribution is scheduled to be paid, as specified in the capital event notice.']
  effective_date date [note: 'Date on which the capital event becomes effective for accounting and valuation purposes, typically the trade date or commitment date.']
  event_amount decimal(18,2) [note: 'Monetary value of the capital event: amount called for capital calls or amount distributed for distributions, in the fund\'s base currency.']
  event_amount_base_currency decimal(18,2) [note: 'Capital event amount converted to the pension fund\'s base reporting currency using the effective date foreign exchange (FX) rate.']
  event_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the capital event amount (e.g., USD, EUR, GBP).']
  event_reference_number varchar [note: 'External business identifier for the capital event, typically assigned by the General Partner (GP) or fund administrator for tracking and reconciliation.']
  event_status varchar [note: 'Current lifecycle status of the capital event: notified by GP, confirmed by LP, funded, settled, cancelled, or recalled (for recallable distributions).']
  event_type varchar [note: 'Classification of the capital flow event: capital call (drawdown), distribution (return of capital or income), recallable distribution, or capital recycling event.']
  exception_notes varchar [note: 'Free-text notes documenting any exceptions, discrepancies, or special circumstances related to the capital event processing or reconciliation.']
  fund_administrator_name varchar [note: 'Name of the third-party fund administrator responsible for processing capital calls and distributions on behalf of the General Partner (GP).']
  fx_rate decimal(12,6) [note: 'Foreign exchange rate applied to convert the event amount from the fund currency to the pension fund\'s base currency, as of the effective date.']
  gp_entity_name varchar [note: 'Legal name of the General Partner (GP) or fund manager responsible for managing the natural resource investment and issuing capital event notices.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the capital event record, reflecting changes in status, amounts, or reconciliation.']
  net_distribution_amount decimal(18,2) [note: 'Net distribution amount received by the Limited Partner (LP) after deducting withholding taxes and any other adjustments from the gross distribution.']
  notice_document_reference varchar [note: 'Reference identifier for the capital call notice or distribution notice document issued by the General Partner (GP), stored in the document management system.']
  notification_date date [note: 'Date on which the General Partner (GP) notified the Limited Partner (LP) of the capital event, typically via capital call notice or distribution notice.']
  paid_in_capital_to_date decimal(18,2) [note: 'Cumulative capital contributed by the Limited Partner (LP) to the natural resource investment as of this event, including this capital call if applicable.']
  payment_instruction_reference varchar [note: 'Reference number or identifier for the payment instruction associated with this capital event, used for treasury and cash management reconciliation.']
  production_linked_flag boolean [note: 'Indicates whether the distribution is linked to production output from the natural resource asset (e.g., timber harvest, crop yield, mineral extraction).']
  recall_expiration_date date [note: 'Date after which a recallable distribution can no longer be recalled by the General Partner (GP), typically specified in the Limited Partnership Agreement (LPA).']
  recallable_flag boolean [note: 'Indicates whether the distribution is subject to recall provisions under the Limited Partnership Agreement (LPA), allowing the General Partner (GP) to reclaim distributed capital.']
  reconciliation_status varchar [note: 'Status of reconciliation between the capital event notice and actual cash movement, used for operational control and audit trail.']
  resource_asset_type varchar [note: 'Classification of the underlying natural resource asset: timberland, farmland, mining, energy, commodity-linked fund, or specific commodity exposure. [ENUM-REF-CANDIDATE: timberland|farmland|mining|energy|commodity_fund|natural_gas|oil|metals|agriculture']
  settlement_date date [note: 'Actual date on which the capital event was settled: funds transferred for capital call or distribution received by the Limited Partner (LP).']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled committed capital available for future capital calls, calculated as commitment amount minus paid-in capital to date.']
  valuation_impact_amount decimal(18,2) [note: 'Impact of this capital event on the Net Asset Value (NAV) of the natural resource investment, reflecting changes in fair value or carrying value.']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted from the distribution by the General Partner (GP) or fund administrator, typically for cross-border tax compliance.']
  withholding_tax_jurisdiction varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code for the jurisdiction imposing withholding tax on the distribution (e.g., USA, CAN, GBR).']

  Note: 'Records all capital flow events for natural resource holdings including capital calls (drawdowns), distributions (return of capital, income distributions), recallable distributions, and capital recycling events.'
}

Table naturalresource.operator_agreement {
  operator_agreement_id varchar [pk, note: 'Unique identifier for the operator agreement record. Primary key for natural resource operating agreements, joint venture agreements, and management contracts.']
  investment_id varchar [note: 'Foreign key reference to the parent investment record in the portfolio. Links operating agreement to the broader investment structure.']
  natural_resource_asset_id varchar [note: 'Foreign key reference to the natural resource asset governed by this operating agreement. Links agreement to underlying timberland, farmland, mining, or energy asset.']
  agreement_name varchar [note: 'Human-readable name or title of the operating agreement, typically referencing the asset or project being governed.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the operating agreement or joint venture contract. Used for legal reference and external communication.']
  agreement_status varchar [note: 'Current lifecycle status of the operating agreement. Tracks progression from negotiation through execution to termination.']
  agreement_type varchar [note: 'Classification of the agreement structure governing the natural resource asset. Defines the legal and operational framework for resource management and revenue sharing.']
  amendment_count varchar [note: 'Total number of amendments or modifications made to the operating agreement since original execution. Indicates contract stability.']
  approval_date date [note: 'Date when the operating agreement was approved by the Investment Committee (IC) or authorized governance body.']
  assignment_restriction_flag boolean [note: 'Indicates whether the agreement restricts assignment or transfer of rights and obligations without prior consent of all parties.']
  audit_rights_flag boolean [note: 'Indicates whether the pension fund has contractual rights to audit the operators books and records. Critical for governance and compliance.']
  capital_call_notice_days varchar [note: 'Number of days advance notice required for capital calls or funding requests under the operating agreement. Defines liquidity planning requirements.']
  change_of_control_clause_flag boolean [note: 'Indicates whether the agreement contains change of control provisions requiring consent or triggering termination rights upon operator ownership changes.']
  confidentiality_obligation_flag boolean [note: 'Indicates whether the agreement contains confidentiality and non-disclosure obligations binding the parties. Protects proprietary information.']
  cost_allocation_method varchar [note: 'Method for allocating operating costs and capital expenditures among joint venture partners. Defines cost-sharing mechanics.']
  created_timestamp timestamp [note: 'Timestamp when this operator agreement record was first created in the system. Supports audit trail and data lineage.']
  default_cure_period_days varchar [note: 'Number of days allowed for the operator to cure a default or breach before termination rights are triggered. Defines grace period for remediation.']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes between parties under the operating agreement. Defines escalation path and binding resolution process.']
  document_repository_path varchar [note: 'File path or URI to the executed agreement document and related legal documentation in the enterprise document management system.']
  effective_date date [note: 'Date when the operating agreement becomes legally binding and operational responsibilities commence.']
  environmental_compliance_standard varchar [note: 'Environmental, Social, and Governance (ESG) standards and certifications that the operator is contractually required to maintain.']
  execution_date date [note: 'Date when the operating agreement was formally executed and signed by all parties. May differ from effective date.']
  expiration_date date [note: 'Date when the operating agreement terminates or expires. Nullable for open-ended or perpetual agreements subject to termination clauses.']
  force_majeure_provision_flag boolean [note: 'Indicates whether the agreement contains force majeure provisions excusing performance during extraordinary events beyond parties control.']
  governing_law varchar [note: 'Jurisdiction and legal framework governing the interpretation and enforcement of the operating agreement. Critical for dispute resolution.']
  hurdle_rate decimal(5,4) [note: 'Minimum preferred return threshold that must be achieved before performance fees or carried interest are payable to the operator.']
  insurance_requirement varchar [note: 'Minimum insurance coverage types and limits that the operator must maintain under the agreement. Protects against operational and liability risks.']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the operating agreement. Tracks contract evolution over time.']
  last_updated_timestamp timestamp [note: 'Timestamp when this operator agreement record was most recently modified. Supports change tracking and audit requirements.']
  management_fee_basis varchar [note: 'Basis for calculating management fees charged by the operator. Defines whether fees are asset-based, revenue-based, or fixed.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the operator as a percentage of asset value or revenue. Used for cost allocation and performance attribution.']
  non_compete_clause_flag boolean [note: 'Indicates whether the agreement contains non-compete restrictions limiting the operators ability to engage in competing activities.']
  notes varchar [note: 'Free-text field for capturing additional context, special provisions, or operational notes related to the operating agreement.']
  operator_entity_code varchar [note: 'Foreign key reference to the legal entity master record for the operator or joint venture partner. Enables counterparty risk and relationship management.']
  operator_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the operator or joint venture partner. Enables global counterparty identification and regulatory reporting.']
  operator_name varchar [note: 'Legal name of the operator or joint venture partner responsible for day-to-day management and operations of the natural resource asset.']
  operator_ownership_percentage decimal(5,2) [note: 'Percentage ownership or working interest held by the operator or joint venture partner. Used for revenue sharing and cost allocation calculations.']
  operator_role varchar [note: 'Functional role of the operator within the agreement structure. Defines operational responsibilities and decision-making authority.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership or working interest held by the pension fund under this operating agreement. Determines revenue and cost allocation.']
  performance_fee_rate decimal(5,4) [note: 'Performance-based fee or carried interest rate earned by the operator above a hurdle rate. Aligns operator incentives with asset performance.']
  reporting_frequency varchar [note: 'Frequency at which the operator is required to provide operational and financial reports to joint venture partners.']
  revenue_sharing_method varchar [note: 'Method for distributing revenue and production proceeds among joint venture partners. Defines cash flow distribution mechanics.']
  termination_date date [note: 'Actual date when the agreement was terminated prior to expiration. Populated only when early termination occurs.']
  termination_reason varchar [note: 'Business or legal reason for early termination of the operating agreement. Captures context for contract closure and lessons learned.']

  Note: 'Master record for operating agreements, joint venture agreements, and management contracts governing natural resource assets. Captures operator/JV partner name, LEI, agreement type (operating agreement, JV, farm-out, royalty agreement, offtake agreement)'
}

Table naturalresource.royalty_obligation {
  royalty_obligation_id varchar [pk, note: 'Unique identifier for the royalty obligation record.']
  natural_resource_asset_id varchar [note: 'Reference to the underlying natural resource asset (timberland, farmland, mining, energy) to which this royalty obligation is attached.']
  audit_rights varchar [note: 'Description of the royalty holders contractual rights to audit production records, revenue calculations, and payment compliance.']
  benchmark_price_index varchar [note: 'Market price index or benchmark used to determine the royalty base value (e.g., WTI, Brent, Henry Hub, LME Copper).']
  commodity_type varchar [note: 'Type of commodity or natural resource produced from the asset and subject to the royalty obligation. [ENUM-REF-CANDIDATE: crude_oil|natural_gas|coal|gold|copper|iron_ore|timber|agricultural_products — 8 candidates stripped; promote to reference product]']
  created_by_user varchar [note: 'Identifier of the user or system process that created this record.']
  created_timestamp timestamp [note: 'Timestamp when this royalty obligation record was first created in the system.']
  deductible_cost_types varchar [note: 'Description of the types of costs that are contractually deductible from the royalty base (e.g., transportation, processing, marketing).']
  deductible_costs_allowed boolean [note: 'Indicates whether certain operating, transportation, or processing costs may be deducted from gross revenue before calculating the royalty base.']
  depletion_method varchar [note: 'Accounting method used to allocate the cost of the natural resource asset over its productive life, relevant for royalty valuation and financial reporting.']
  discount_rate_percent decimal(10,6) [note: 'Discount rate applied in the valuation model to present-value future royalty payment obligations.']
  dispute_resolution_mechanism varchar [note: 'Contractual mechanism for resolving disputes related to royalty calculations, payments, or compliance.']
  effective_date date [note: 'Date on which the royalty obligation becomes legally binding and payment obligations commence.']
  environmental_compliance_required boolean [note: 'Indicates whether the royalty agreement includes environmental compliance or ESG performance conditions that may affect payment obligations.']
  escalation_clause varchar [note: 'Description of any contractual escalation provisions that adjust the royalty rate or minimum payment over time (e.g., CPI-linked, production-tier-based).']
  esg_performance_conditions varchar [note: 'Description of any ESG performance conditions or sustainability criteria linked to the royalty obligation (e.g., GHG emission targets, water usage limits).']
  estimated_reserves_quantity decimal(18,4) [note: 'Estimated quantity of recoverable reserves (barrels, cubic meters, tonnes, board feet) subject to this royalty obligation, used for depletion and valuation modeling.']
  expiration_date date [note: 'Date on which the royalty obligation terminates or expires, if applicable. Null for perpetual or life-of-asset obligations.']
  fair_value_estimate decimal(18,2) [note: 'Estimated fair value of the royalty obligation liability for financial reporting and NAV calculation purposes.']
  governing_law_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the legal jurisdiction whose laws govern the royalty agreement.']
  government_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the government jurisdiction imposing the royalty, if applicable.']
  indigenous_community_name varchar [note: 'Name of the indigenous community or First Nation entitled to royalty payments under treaty or land rights agreements, if applicable.']
  minimum_royalty_amount decimal(18,2) [note: 'Contractual minimum royalty payment due per period, regardless of production or revenue levels.']
  notes varchar [note: 'Additional notes, comments, or contextual information regarding the royalty obligation.']
  obligation_status varchar [note: 'Current lifecycle status of the royalty obligation.']
  payment_due_day varchar [note: 'Day of the month or period on which royalty payments are due (e.g., 15th day of the month following production period).']
  payment_frequency varchar [note: 'Frequency at which royalty payments are calculated and remitted to the royalty holder.']
  price_adjustment_formula varchar [note: 'Contractual formula or methodology for adjusting the royalty base price, including discounts, quality adjustments, or transportation deductions.']
  reserves_unit_of_measure varchar [note: 'Unit of measure for the estimated reserves quantity (e.g., barrels for oil, cubic meters for gas, tonnes for minerals, board feet for timber).']
  royalty_agreement_number varchar [note: 'External business identifier for the royalty agreement or contract governing this obligation.']
  royalty_base_type varchar [note: 'The economic basis on which the royalty rate is applied (e.g., gross revenue, net revenue, production volume, net profits, wellhead value).']
  royalty_currency_code varchar [note: 'ISO 4217 three-letter currency code in which royalty payments are denominated.']
  royalty_holder_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the royalty holder, if applicable.']
  royalty_holder_name varchar [note: 'Legal name of the party entitled to receive royalty payments (government entity, private landowner, indigenous community, or other rights holder).']
  royalty_rate_percent decimal(10,6) [note: 'Percentage rate applied to the royalty base (production volume, revenue, or net profits) to calculate the royalty payment.']
  royalty_type varchar [note: 'Classification of the royalty obligation by legal and economic structure.']
  suspension_reason varchar [note: 'Reason for suspension of the royalty obligation, if applicable (e.g., force majeure, production halt, regulatory moratorium).']
  termination_date date [note: 'Actual date on which the royalty obligation was terminated, if applicable.']
  termination_reason varchar [note: 'Reason for termination of the royalty obligation (e.g., asset depletion, contract expiration, mutual agreement, default).']
  treaty_reference_number varchar [note: 'Reference number or identifier for the treaty, land claim agreement, or indigenous rights agreement governing the royalty obligation.']
  updated_by_user varchar [note: 'Identifier of the user or system process that last updated this record.']
  updated_timestamp timestamp [note: 'Timestamp when this royalty obligation record was last modified.']
  valuation_date date [note: 'Date as of which the fair value estimate was determined.']
  valuation_methodology varchar [note: 'Methodology used to estimate the fair value of the royalty obligation (e.g., DCF, comparable transactions, income approach).']

  Note: 'Tracks royalty, overriding royalty interest (ORRI), net profits interest (NPI), and government royalty obligations attached to natural resource assets. Captures royalty type, royalty rate (%), royalty holder (government, private landowner, indigenous'
}

Table naturalresource.royalty_payment {
  royalty_payment_id varchar [pk, note: 'Unique identifier for the royalty payment transaction record.']
  cash_account_id varchar [note: 'Reference to the bank account to which the royalty payment was disbursed.']
  employee_id varchar [note: 'Reference to the user who approved the royalty payment for disbursement.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset (timberland, farmland, mining, energy) generating the royalty.']
  record_updated_by_user_employee_id varchar [note: 'Reference to the user who last updated the royalty payment record.']
  royalty_obligation_id varchar [note: 'Reference to the underlying royalty obligation contract that governs this payment.']
  base_currency_code varchar [note: 'Three-letter ISO currency code for the fund\'s base reporting currency (typically USD, EUR, or GBP).']
  commodity_price decimal(18,6) [note: 'Market or contract price per unit of the commodity applied to calculate gross revenue for the royalty period.']
  commodity_price_currency varchar [note: 'Three-letter ISO currency code for the commodity price (e.g., USD, AUD).']
  cost_center_code varchar [note: 'Cost center or business unit code to which the royalty payment is allocated for management reporting.']
  deduction_amount decimal(18,2) [note: 'Total deductions applied to the gross royalty amount, including allowable costs, transportation, or processing fees per contract terms.']
  dispute_flag boolean [note: 'Indicator of whether the royalty payment is under dispute by the payee or internal review.']
  dispute_reason varchar [note: 'Description of the reason for dispute if the payment is flagged for review or contested by the payee.']
  fx_rate_to_base decimal(18,8) [note: 'Exchange rate applied to convert local currency royalty amount to the fund\'s base reporting currency.']
  gl_account_code varchar [note: 'General ledger account code to which the royalty payment expense was posted.']
  gl_posting_date date [note: 'Date on which the royalty payment was posted to the general ledger for accounting purposes.']
  gross_revenue_base decimal(18,2) [note: 'Total gross revenue calculated from production volume multiplied by commodity price, before royalty rate application.']
  local_currency_code varchar [note: 'Three-letter ISO currency code for the local currency in which the royalty is denominated.']
  net_payment_amount decimal(18,2) [note: 'Final net royalty payment amount after all deductions, in local currency.']
  payee_legal_entity_code varchar [note: 'Reference to the legal entity receiving the royalty payment (landowner, mineral rights holder, government authority).']
  payment_approval_date date [note: 'Date on which the royalty payment was approved by authorized personnel prior to disbursement.']
  payment_date date [note: 'Date on which the royalty payment was disbursed to the royalty holder.']
  payment_method varchar [note: 'Method used to disburse the royalty payment to the recipient.']
  payment_notes varchar [note: 'Free-text notes or comments regarding the royalty payment, including any special circumstances or adjustments.']
  payment_number varchar [note: 'Business identifier for the royalty payment, typically sequential or formatted per contract terms.']
  payment_period_end_date date [note: 'End date of the production or revenue period covered by this royalty payment.']
  payment_period_start_date date [note: 'Start date of the production or revenue period covered by this royalty payment.']
  payment_reference_number varchar [note: 'External reference or transaction number assigned by the payment system or bank for reconciliation purposes.']
  payment_status varchar [note: 'Current lifecycle status of the royalty payment transaction.']
  production_unit_of_measure varchar [note: 'Unit of measure for the production volume (barrels for oil, tonnes for minerals, board feet for timber, etc.). [ENUM-REF-CANDIDATE: barrels|tonnes|cubic_meters|board_feet|acres|megawatt_hours|ounces — 7 candidates stripped; promote to reference product]']
  production_volume decimal(18,4) [note: 'Quantity of resource extracted or produced during the payment period, forming the basis for royalty calculation.']
  record_created_timestamp timestamp [note: 'Timestamp when the royalty payment record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when the royalty payment record was last updated in the data platform.']
  reversal_date date [note: 'Date on which the royalty payment was reversed, if applicable.']
  reversal_flag boolean [note: 'Indicator of whether this royalty payment has been reversed or cancelled after initial processing.']
  reversal_reason varchar [note: 'Explanation for why the royalty payment was reversed or cancelled.']
  royalty_amount_base decimal(18,2) [note: 'Royalty payment amount converted to the fund\'s base reporting currency for consolidated accounting.']
  royalty_amount_local decimal(18,2) [note: 'Calculated royalty payment amount in the local currency of the natural resource asset or contract.']
  royalty_rate decimal(8,6) [note: 'Percentage or decimal rate applied to gross revenue to determine the royalty payment amount, as specified in the royalty agreement.']
  settlement_date date [note: 'Date on which the royalty payment was settled and cleared through the banking system.']
  source_system_code varchar [note: 'Unique identifier of the royalty payment record in the source operational system for traceability.']
  withholding_tax_amount decimal(18,2) [note: 'Tax amount withheld at source from the royalty payment per local tax regulations.']
  withholding_tax_rate decimal(8,6) [note: 'Percentage rate of withholding tax applied to the royalty payment per local jurisdiction requirements.']

  Note: 'Transactional record of each royalty payment disbursed against a royalty obligation. Captures payment date, payment period covered, production volume basis, commodity price applied, gross revenue base, royalty rate applied, payment amount (local currency'
}

Table naturalresource.land_parcel {
  land_parcel_id varchar [pk, note: 'Unique system identifier for the land parcel record.']
  employee_id varchar [note: 'Identifier of the internal asset manager or external manager responsible for active management and value creation on the parcel.']
  investment_portfolio_id varchar [note: 'Identifier of the investment portfolio or fund to which the parcel is allocated.']
  acquisition_cost decimal(18,2) [note: 'Total cost paid by the fund to acquire the parcel, including purchase price and transaction costs, in base currency.']
  acquisition_date date [note: 'Date on which the fund acquired ownership or rights to the parcel.']
  annual_property_tax decimal(18,2) [note: 'Annual property tax liability for the parcel in base currency, used for cash flow modeling and net operating income calculation.']
  biodiversity_score decimal(5,2) [note: 'Quantitative biodiversity assessment score for the parcel, used for ESG integration and responsible investment stewardship.']
  cadastral_reference varchar [note: 'Government-issued cadastral or parcel identification number used for land registry and taxation purposes.']
  carbon_sequestration_potential decimal(18,2) [note: 'Estimated annual carbon sequestration capacity of the parcel in metric tons of CO2 equivalent, relevant for ESG reporting and carbon credit valuation.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code indicating the jurisdiction where the parcel is located.']
  county_municipality varchar [note: 'County, municipality, or secondary administrative subdivision where the parcel is located.']
  created_timestamp timestamp [note: 'System timestamp when the parcel record was first created in the data platform.']
  crop_type varchar [note: 'Primary crop or agricultural product cultivated on the parcel, applicable to farmland parcels.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values associated with the parcel.']
  data_source_system varchar [note: 'Name of the operational system of record from which the parcel data was sourced, such as eFront or internal GIS platform.']
  elevation_meters decimal(10,2) [note: 'Average elevation of the parcel above sea level in meters, relevant for agricultural and forestry productivity modeling.']
  encumbrance_description varchar [note: 'Detailed description of any legal encumbrances, liens, easements, or restrictive covenants affecting the parcel.']
  encumbrance_flag boolean [note: 'Indicates whether the parcel is subject to legal encumbrances such as liens, easements, or restrictive covenants.']
  environmental_designation varchar [note: 'Environmental protection or conservation designation affecting land use, such as protected area, wetland, or habitat conservation zone.']
  insurance_coverage_amount decimal(18,2) [note: 'Total insurance coverage amount for the parcel in base currency, covering property damage, liability, and natural disaster risks.']
  land_use_type varchar [note: 'Primary classification of the parcels current use within the natural resources portfolio.']
  last_valuation_amount decimal(18,2) [note: 'Fair market value of the parcel as determined by the most recent independent valuation, in base currency.']
  last_valuation_date date [note: 'Date of the most recent independent valuation or appraisal of the parcel.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the parcel centroid in decimal degrees.']
  lease_expiry_date date [note: 'Expiration date of the lease or rights agreement, applicable to leasehold and surface rights parcels.']
  legal_land_description varchar [note: 'Official legal description of the parcel as recorded in title documents, including metes and bounds, lot and block, or government survey system reference.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the parcel centroid in decimal degrees.']
  mineral_resource_type varchar [note: 'Type of mineral or energy resource associated with the parcel, applicable to mining and energy surface rights.']
  notes varchar [note: 'Free-text field for additional operational notes, special conditions, or contextual information about the parcel.']
  ownership_type varchar [note: 'Legal form of ownership or rights held by the fund over the parcel.']
  parcel_name varchar [note: 'Common or business name assigned to the land parcel for internal reference and reporting.']
  parcel_status varchar [note: 'Current operational and investment status of the land parcel within the portfolio.']
  productive_area_hectares decimal(18,4) [note: 'Net productive area of the parcel in hectares, excluding non-productive zones such as wetlands, roads, and buffer zones.']
  road_access_type varchar [note: 'Type of road access available to the parcel, affecting operational logistics and asset management costs.']
  soil_classification varchar [note: 'Soil type or classification code based on local or international soil taxonomy, relevant for agricultural and forestry valuation.']
  state_province varchar [note: 'State, province, or primary administrative subdivision where the parcel is located.']
  timber_volume_m3 decimal(18,2) [note: 'Total standing timber volume on the parcel in cubic meters, applicable to timberland parcels.']
  title_deed_reference varchar [note: 'Official title deed or land registry reference number for the parcel.']
  topography_type varchar [note: 'General topographic characteristic of the parcel affecting operational access and productivity.']
  total_area_hectares decimal(18,4) [note: 'Total land area of the parcel measured in hectares, representing the gross land holding.']
  updated_timestamp timestamp [note: 'System timestamp when the parcel record was last modified in the data platform.']
  valuation_method varchar [note: 'Primary valuation methodology used in the most recent appraisal of the parcel.']
  water_access_flag boolean [note: 'Indicates whether the parcel has direct access to water resources such as rivers, lakes, or irrigation systems.']
  zoning_designation varchar [note: 'Local government zoning or land use designation that governs permitted activities on the parcel.']

  Note: 'Geospatial and legal description master record for land parcels underlying timberland, farmland, and surface rights of mining/energy assets. Captures parcel identifier (legal land description, cadastral reference), total area (hectares), land use'
}

Table naturalresource.environmental_permit {
  environmental_permit_id varchar [pk, note: 'Unique identifier for the environmental permit record.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset (timberland, farmland, mining, energy) to which this permit applies.']
  amendment_count varchar [note: 'Total number of amendments or modifications made to the original permit since issuance.']
  authorized_activity varchar [note: 'Specific operational activity or extraction process authorized under this permit (e.g., timber harvesting, mineral extraction, water withdrawal).']
  bond_amount decimal(18,2) [note: 'Financial bond or security amount required to be posted for environmental reclamation or restoration obligations.']
  bond_currency varchar [note: 'Three-letter ISO currency code for the reclamation bond amount.']
  bond_status varchar [note: 'Current status of the reclamation bond or financial security.']
  compliance_monitoring_frequency varchar [note: 'Required frequency of compliance monitoring and reporting to the regulatory authority.']
  compliance_status varchar [note: 'Current compliance status of the asset operations relative to permit conditions and regulatory requirements.']
  created_timestamp timestamp [note: 'Timestamp when this permit record was first created in the system.']
  effective_date date [note: 'Date from which the permit becomes legally effective and operational activities may commence.']
  emissions_limit_quantity decimal(18,4) [note: 'Maximum allowable emissions quantity under the permit (e.g., tons of carbon dioxide equivalent, particulate matter).']
  emissions_limit_unit varchar [note: 'Unit of measure for emissions limit (e.g., metric tons CO2e, kilograms, parts per million).']
  esg_impact_category varchar [note: 'Primary ESG impact category addressed by this permit (e.g., biodiversity, water stewardship, air quality, community impact). [ENUM-REF-CANDIDATE']
  expiry_date date [note: 'Date on which the permit expires and must be renewed or ceases to be valid.']
  extraction_limit_quantity decimal(18,4) [note: 'Maximum quantity of resource extraction or production authorized under the permit (e.g., cubic meters of water, tons of ore, board feet of timber).']
  extraction_limit_unit varchar [note: 'Unit of measure for the extraction limit quantity (e.g., cubic meters, metric tons, barrels, board feet).']
  extraction_period varchar [note: 'Time period over which the extraction limit applies (daily, monthly, annual, or total permit lifetime).']
  ghg_emissions_scope varchar [note: 'GHG Protocol emissions scope category covered by this permit (Scope 1 direct, Scope 2 indirect energy, Scope 3 value chain).']
  inspection_frequency varchar [note: 'Frequency at which regulatory inspections are required or expected under the permit terms.']
  issue_date date [note: 'Date on which the permit was officially issued by the regulatory authority.']
  issuing_authority varchar [note: 'Name of the government agency or regulatory body that issued the permit.']
  jurisdiction varchar [note: 'Geographic or administrative jurisdiction under which the permit is governed (country, state, province, or local authority).']
  land_area_authorized_hectares decimal(18,4) [note: 'Total land area in hectares authorized for clearing, extraction, or operational activities under the permit.']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the permit terms.']
  last_inspection_date date [note: 'Date of the most recent regulatory inspection conducted for this permit.']
  last_violation_date date [note: 'Date of the most recent permit violation or non-compliance incident.']
  next_inspection_date date [note: 'Date of the next scheduled regulatory inspection for permit compliance verification.']
  penalty_amount decimal(18,2) [note: 'Total monetary penalties assessed for permit violations or non-compliance, in local currency.']
  penalty_currency varchar [note: 'Three-letter ISO currency code for penalty amounts (e.g., USD, EUR).']
  permit_conditions varchar [note: 'Detailed text of special conditions, restrictions, or operational requirements imposed by the regulatory authority.']
  permit_description varchar [note: 'Detailed description of the scope, purpose, and conditions covered by the environmental permit.']
  permit_document_reference varchar [note: 'Reference identifier or file path to the official permit document stored in the document management system.']
  permit_number varchar [note: 'Official permit number or registration code issued by the regulatory authority.']
  permit_status varchar [note: 'Current lifecycle status of the environmental permit.']
  permit_type varchar [note: 'Classification of the permit based on regulatory purpose and scope. [ENUM-REF-CANDIDATE: environmental_assessment|extraction_license|water_use|emissions|land_clearing|operating_permit|reclamation_bond — 7 candidates stripped; promote to reference product]']
  reclamation_deadline_date date [note: 'Date by which environmental reclamation or site restoration must be completed per permit conditions.']
  reclamation_required_flag boolean [note: 'Indicates whether environmental reclamation or site restoration is required under the permit terms.']
  renewal_date date [note: 'Date by which the permit renewal application must be submitted to maintain continuous compliance.']
  reporting_requirement varchar [note: 'Description of mandatory reporting obligations to the regulatory authority (frequency, format, content).']
  responsible_party_contact varchar [note: 'Contact information (email or phone) for the responsible party managing permit compliance.']
  responsible_party_name varchar [note: 'Name of the individual or entity legally responsible for permit compliance and reporting.']
  updated_timestamp timestamp [note: 'Timestamp when this permit record was last modified in the system.']
  violation_count varchar [note: 'Total number of permit violations or non-compliance incidents recorded since permit issuance.']
  water_use_limit_cubic_meters decimal(18,4) [note: 'Maximum volume of water authorized for withdrawal or use under the permit, measured in cubic meters.']

  Note: 'Registry of environmental, operating, and extraction permits required for natural resource asset operations. Captures permit type (environmental assessment, extraction license, water use, emissions, land clearing), issuing regulatory authority, permit'
}

Table naturalresource.carbon_credit {
  carbon_credit_id varchar [pk, note: 'Unique identifier for the carbon credit record.']
  carbon_project_id varchar [note: 'Identifier of the carbon offset project that generated this credit.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset (timberland, farmland, or other) that generated or is associated with this carbon credit.']
  acquisition_currency varchar [note: 'Three-letter ISO 4217 currency code for the acquisition price.']
  acquisition_date date [note: 'Date on which the pension fund acquired ownership of this carbon credit.']
  acquisition_price_per_tonne decimal(18,4) [note: 'Price paid per tonne of CO2e when acquiring this carbon credit.']
  additionality_demonstrated_flag boolean [note: 'Indicates whether the carbon project has demonstrated additionality, meaning the reductions would not have occurred without the project.']
  buffer_pool_contribution_tonnes decimal(18,4) [note: 'Quantity of carbon credits contributed to the registry buffer pool to mitigate permanence risk.']
  co_benefits_description varchar [note: 'Description of additional environmental or social co-benefits delivered by the carbon project beyond carbon reduction.']
  counterparty_name varchar [note: 'Name of the counterparty from whom the carbon credit was acquired or to whom it was transferred.']
  credit_serial_number varchar [note: 'Unique serial number assigned by the registry to this carbon credit unit, serving as the externally-recognized identifier.']
  credit_status varchar [note: 'Current lifecycle status of the carbon credit in the registry and portfolio.']
  credit_type varchar [note: 'Classification of the carbon credit by market type and project category.']
  current_market_price_per_tonne decimal(18,4) [note: 'Current market price per tonne of CO2e for this carbon credit type and vintage.']
  custodian_name varchar [note: 'Name of the custodian or registry account manager holding the carbon credit on behalf of the pension fund.']
  data_source_system varchar [note: 'Name of the source system or registry from which this carbon credit data was ingested.']
  esg_rating varchar [note: 'ESG rating assigned to the carbon project by an external rating agency. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C — 9 candidates stripped; promote to reference product]']
  expiry_date date [note: 'Date on which the carbon credit expires if not retired, applicable to certain compliance markets.']
  holding_purpose varchar [note: 'Business purpose for holding this carbon credit within the pension fund portfolio.']
  issuance_date date [note: 'Date on which the carbon credit was officially issued by the registry.']
  legal_entity_identifier varchar [note: '20-character ISO 17442 Legal Entity Identifier of the counterparty or project developer.']
  market_price_as_of_date date [note: 'Date as of which the current market price was determined.']
  market_price_currency varchar [note: 'Three-letter ISO 4217 currency code for the current market price.']
  methodology_name varchar [note: 'Name of the specific carbon accounting methodology used to quantify the emission reductions or removals.']
  methodology_version varchar [note: 'Version number of the carbon accounting methodology applied.']
  permanence_risk_rating varchar [note: 'Assessment of the risk that the carbon sequestration may be reversed due to natural or human factors.']
  project_location_country varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code where the carbon project is located.']
  project_location_region varchar [note: 'Geographic region or state within the country where the carbon project is located.']
  quantity_tonnes_co2e decimal(18,4) [note: 'Quantity of carbon dioxide equivalent represented by this credit, measured in metric tonnes.']
  record_created_timestamp timestamp [note: 'Timestamp when this carbon credit record was first created in the pension fund system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this carbon credit record was last updated in the pension fund system.']
  registry_account_number varchar [note: 'Account number in the carbon credit registry under which this credit is held.']
  registry_name varchar [note: 'Name of the carbon credit registry that issued and tracks this credit.']
  retirement_beneficiary varchar [note: 'Name of the entity or individual on whose behalf the carbon credit was retired.']
  retirement_date date [note: 'Date on which the carbon credit was retired to offset emissions, rendering it no longer tradable.']
  retirement_reason varchar [note: 'Reason or purpose for retiring the carbon credit, such as offsetting specific emissions or meeting a commitment.']
  sdg_alignment varchar [note: 'List of United Nations Sustainable Development Goals that the carbon project contributes to.']
  verification_body varchar [note: 'Name of the independent third-party organization that verified the carbon project.']
  verification_date date [note: 'Date on which the carbon project was verified by the third-party body.']
  verification_standard varchar [note: 'Name of the verification standard or methodology applied to validate the carbon reduction or sequestration.']
  vintage_year varchar [note: 'Year in which the carbon reduction or sequestration activity occurred, determining the credits vintage classification.']

  Note: 'Tracks carbon credits, carbon offsets, and REDD+ credits generated by or associated with natural resource assets (particularly timberland and farmland). Captures credit type (voluntary, compliance, REDD+, afforestation), registry (Gold Standard, Verra'
}

Table naturalresource.offtake_agreement {
  offtake_agreement_id varchar [pk, note: 'Unique identifier for the offtake agreement record. Primary key for this master agreement entity.']
  employee_id varchar [note: 'Reference to the internal portfolio manager or asset manager responsible for overseeing this offtake agreement and the underlying natural resource asset.']
  natural_resource_asset_id varchar [note: 'Reference to the underlying natural resource asset (timberland, farmland, mining, energy) from which production output is sold under this agreement.']
  agreement_name varchar [note: 'Human-readable descriptive name or title of the offtake agreement for internal reference and reporting.']
  agreement_number varchar [note: 'Externally-known unique business identifier for the offtake agreement, used in legal documents and counterparty communications.']
  agreement_status varchar [note: 'Current lifecycle status of the offtake agreement indicating its operational state and enforceability. [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|terminated|expired — 7 candidates stripped; promote to reference product]']
  amendment_count varchar [note: 'Total number of formal amendments or modifications made to the offtake agreement since its original execution.']
  annual_volume_quantity decimal(18,4) [note: 'Contracted annual volume of commodity to be delivered under this offtake agreement, expressed in the unit of measure specified.']
  benchmark_index_name varchar [note: 'Name of the commodity price index or benchmark used for floating or indexed pricing mechanisms, such as LME, ICE, or regional spot indices.']
  ceiling_price_amount decimal(18,4) [note: 'Maximum price per unit capped under the offtake agreement, providing cost certainty for the buyer.']
  commodity_specification varchar [note: 'Detailed specification of the commodity including grade, quality standards, physical characteristics, and delivery specifications as defined in the agreement.']
  commodity_type varchar [note: 'Classification of the commodity or natural resource output being sold under this offtake agreement. [ENUM-REF-CANDIDATE: timber|agricultural_products|crude_oil|natural_gas|coal|iron_ore|copper|gold|silver|lithium|rare_earth_minerals|uranium|other — 13']
  contract_document_reference varchar [note: 'Document management system reference or file path to the executed offtake agreement legal document.']
  contract_term_years decimal(5,2) [note: 'Total duration of the offtake agreement expressed in years, representing the commitment period for commodity sales.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the offtaker counterparty, enabling global entity identification and regulatory reporting.']
  counterparty_name varchar [note: 'Legal name of the buyer or offtaker entity purchasing the commodity production output under this agreement.']
  created_timestamp timestamp [note: 'System timestamp when this offtake agreement record was first created in the data platform.']
  credit_support_amount decimal(18,2) [note: 'Monetary value of credit support or collateral required from the counterparty to mitigate payment default risk.']
  credit_support_required_flag boolean [note: 'Indicates whether the counterparty is required to provide credit support such as letters of credit, guarantees, or collateral to secure payment obligations.']
  data_source_system varchar [note: 'Name of the operational system of record from which this offtake agreement data was sourced, such as eFront or contract management platform.']
  delivery_incoterm varchar [note: 'International Commercial Terms code defining the allocation of costs, risks, and responsibilities between buyer and seller for commodity delivery. [ENUM-REF-CANDIDATE: EXW|FCA|CPT|CIP|DAP|DPU|DDP|FAS|FOB|CFR|CIF — 11 candidates stripped; promote to']
  delivery_point_location varchar [note: 'Physical location or facility where commodity delivery and title transfer occurs under the terms of this offtake agreement.']
  dispute_resolution_mechanism varchar [note: 'Contractually agreed method for resolving disputes arising under the offtake agreement.']
  effective_date date [note: 'Date on which the offtake agreement becomes legally binding and operative for commodity sales and deliveries.']
  esg_certification_required_flag boolean [note: 'Indicates whether the offtake agreement mandates ESG certifications or sustainability standards for the commodity production and delivery.']
  esg_certification_type varchar [note: 'Type or name of ESG certification or sustainability standard required under the offtake agreement, such as FSC, Fairtrade, or ISO 14001.']
  expiry_date date [note: 'Date on which the offtake agreement terminates or expires, after which no further obligations exist unless renewed.']
  fixed_price_amount decimal(18,4) [note: 'Fixed price per unit for commodity sales if the pricing mechanism is fixed, representing the locked-in sale price.']
  floor_price_amount decimal(18,4) [note: 'Minimum price per unit guaranteed under the offtake agreement, providing downside protection for the seller.']
  force_majeure_clause varchar [note: 'Text or reference to the force majeure provisions defining events that excuse non-performance by either party without liability.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction and governing law specified in the offtake agreement for dispute resolution and contract interpretation.']
  last_amendment_date date [note: 'Date of the most recent amendment or modification to the offtake agreement terms.']
  last_updated_timestamp timestamp [note: 'System timestamp when this offtake agreement record was most recently modified or updated.']
  legal_counsel_name varchar [note: 'Name of the external legal counsel or law firm that advised on or drafted the offtake agreement.']
  minimum_offtake_percentage decimal(5,2) [note: 'Minimum percentage of contracted annual volume that the buyer is obligated to purchase under take-or-pay or minimum purchase provisions.']
  payment_terms_days varchar [note: 'Number of days from delivery or invoice date within which the counterparty must remit payment for commodity purchases.']
  price_adjustment_formula varchar [note: 'Mathematical formula or methodology for calculating price adjustments based on benchmark indices, inflation, or other contractual factors.']
  price_currency_code varchar [note: 'ISO 4217 three-letter currency code for all pricing and payment terms in this offtake agreement.']
  pricing_mechanism varchar [note: 'Type of pricing structure governing commodity sales under this agreement, determining how prices are set or adjusted over time.']
  renewal_option_flag boolean [note: 'Indicates whether the offtake agreement includes an option for either party to renew or extend the contract term beyond the initial expiry date.']
  take_or_pay_flag boolean [note: 'Indicates whether the agreement includes a take-or-pay provision requiring the buyer to pay for minimum volumes regardless of actual offtake.']
  termination_notice_days varchar [note: 'Number of days advance notice required by either party to terminate the offtake agreement under voluntary termination provisions.']
  total_contract_volume_quantity decimal(18,4) [note: 'Total cumulative volume of commodity committed over the entire term of the offtake agreement.']
  volume_unit_of_measure varchar [note: 'Standard unit of measure for commodity volumes specified in this offtake agreement. [ENUM-REF-CANDIDATE: tonnes|barrels|cubic_meters|board_feet|bushels|pounds|kilograms|megawatt_hours|troy_ounces — 9 candidates stripped; promote to reference product]']

  Note: 'Master record for offtake agreements and commodity sales contracts governing the sale of production output from natural resource assets. Captures counterparty name, LEI, commodity type, contract volume (annual/total), pricing mechanism (fixed, floating'
}

Table naturalresource.commodity_price_deck {
  commodity_price_deck_id varchar [pk, note: 'Unique identifier for the commodity price deck record.']
  created_by_user_employee_id varchar [note: 'Identifier of the user who created this price deck record.']
  employee_id varchar [note: 'Identifier of the user or committee member who approved this price deck.']
  last_modified_by_user_employee_id varchar [note: 'Identifier of the user who last modified this price deck record.']
  market_data_feed_id varchar [note: 'Foreign key linking to research.market_data_feed. Business justification: Price decks are sourced from market data feeds for real‑time pricing.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset this price deck applies to.']
  approval_date date [note: 'Date when this price deck was approved by the Investment Committee (IC) or authorized body.']
  benchmark_index varchar [note: 'Market benchmark or index used as reference for this commodity price (e.g., WTI, Brent, LME).']
  commodity_subtype varchar [note: 'Specific subtype or grade of the commodity (e.g., WTI, Brent, Henry Hub).']
  commodity_type varchar [note: 'Type of commodity covered by this price deck. [ENUM-REF-CANDIDATE: crude_oil|natural_gas|gold|silver|copper|iron_ore|coal|timber|agricultural — 9 candidates stripped; promote to reference product]']
  confidence_level varchar [note: 'Confidence level in the accuracy of this price forecast.']
  created_timestamp timestamp [note: 'Timestamp when this price deck record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for the price denomination.']
  deck_name varchar [note: 'Business name or label for this commodity price deck.']
  deck_status varchar [note: 'Current lifecycle status of the price deck.']
  deck_version varchar [note: 'Version identifier for this price deck iteration.']
  effective_date date [note: 'Date from which this price deck becomes effective for valuation and forecasting.']
  esg_impact_consideration varchar [note: 'Description of ESG factors considered in the price forecast (e.g., carbon pricing, regulatory changes).']
  expiry_date date [note: 'Date after which this price deck is no longer valid.']
  forecast_quarter varchar [note: 'Calendar quarter within the forecast year (1-4), if applicable.']
  forecast_year varchar [note: 'Calendar year for which this price forecast applies.']
  geographic_region varchar [note: 'Geographic region or market for which this price deck applies.']
  geopolitical_risk_factor varchar [note: 'Assessment of geopolitical risk impacting commodity price stability.']
  inflation_adjustment_flag boolean [note: 'Indicates whether the price forecast includes inflation adjustment (real vs nominal prices).']
  inflation_rate_assumption decimal(5,4) [note: 'Annual inflation rate assumption used in the price forecast, expressed as a decimal.']
  last_modified_timestamp timestamp [note: 'Timestamp when this price deck record was last modified.']
  last_review_date date [note: 'Date when this price deck was last reviewed or updated.']
  market_conditions_summary varchar [note: 'Summary of macroeconomic and market conditions underlying the price forecast.']
  next_review_date date [note: 'Scheduled date for the next review or update of this price deck.']
  notes varchar [note: 'Additional notes or commentary regarding this price deck.']
  price_ceiling decimal(18,4) [note: 'Maximum price assumption used in upside scenario analysis.']
  price_floor decimal(18,4) [note: 'Minimum price assumption used in stress testing or downside scenario analysis.']
  price_horizon varchar [note: 'Time horizon for the price forecast (spot, short-term 1-3 years, medium-term 3-10 years, long-term 10+ years).']
  price_per_unit decimal(18,4) [note: 'Forecasted price per unit of the commodity.']
  review_frequency varchar [note: 'Frequency at which this price deck is reviewed and updated.']
  scenario_type varchar [note: 'Economic scenario assumption for this price deck (base case, bull case, bear case, stress test).']
  source_provider varchar [note: 'Name of the external provider or internal team that generated the price forecast.']
  source_report_reference varchar [note: 'Reference identifier or document name of the source report or research publication.']
  source_type varchar [note: 'Source of the price forecast (internal research, external consultant, market consensus, proprietary model).']
  supply_demand_balance varchar [note: 'Assumed supply-demand balance for the commodity in the forecast period.']
  unit_of_measure varchar [note: 'Unit of measure for the commodity price (barrel, MMBtu, troy ounce, metric ton). [ENUM-REF-CANDIDATE: barrel|mmbtu|troy_ounce|metric_ton|cubic_meter|board_foot|bushel — 7 candidates stripped; promote to reference product]']
  usage_purpose varchar [note: 'Intended use of this price deck (DCF valuation, budget forecasting, stress testing, portfolio modeling). [ENUM-REF-CANDIDATE: dcf_valuation|budget_forecasting|stress_testing|portfolio_modeling|risk_analysis|performance_attribution|regulatory_reporting —']
  valuation_methodology varchar [note: 'Methodology used to derive the commodity price forecast (e.g., DCF, futures curve, econometric model).']
  volatility_assumption decimal(5,4) [note: 'Price volatility assumption used in scenario modeling, expressed as a decimal.']

  Note: 'Reference price deck for commodities used in DCF valuation, budget forecasting, and stress testing of natural resource assets. Captures commodity type, scenario (base/bull/bear/stress), price per unit by horizon (short/medium/long-term), currency'
}

Table naturalresource.resource_budget {
  resource_budget_id varchar [pk, note: 'Unique identifier for the natural resource asset budget record.']
  asset_manager_employee_id varchar [note: 'Reference to the asset manager responsible for this natural resource asset and its budget.']
  employee_id varchar [note: 'Identifier of the user or committee member who approved the budget.']
  investment_portfolio_id varchar [note: 'Reference to the investment portfolio to which this natural resource asset and budget belong.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset this budget applies to.']
  prepared_by_user_employee_id varchar [note: 'Identifier of the user who prepared the budget.']
  reserve_estimate_id varchar [note: 'Foreign key linking to naturalresource.reserve_estimate. Business justification: Resource budgets include production volume targets that should align with reserve estimates. The budget\'s production assumptions are based on a specific reserve estimate.']
  approval_date date [note: 'Date on which the budget was formally approved by the Investment Committee or authorized body.']
  budget_amount decimal(18,2) [note: 'Total budgeted amount for this category and period in local currency.']
  budget_category varchar [note: 'Detailed category of expenditure within the budget type such as labor, equipment, materials, utilities, maintenance, or environmental compliance.']
  budget_notes varchar [note: 'Additional notes, assumptions, or commentary supporting the budget submission.']
  budget_number varchar [note: 'Externally-known unique identifier for this budget submission or version.']
  budget_period_end_date date [note: 'End date of the period covered by this budget.']
  budget_period_start_date date [note: 'Start date of the period covered by this budget.']
  budget_status varchar [note: 'Current approval and lifecycle status of the budget. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|revised|active|closed — 8 candidates stripped; promote to reference product]']
  budget_type varchar [note: 'Classification of budget expenditure: operating expense, capital expense, sustaining capital, growth capital, reclamation, closure, exploration, or development.']
  budget_year varchar [note: 'Fiscal year for which this budget is prepared.']
  cash_flow_forecast decimal(18,2) [note: 'Forecasted net cash flow from operations for the budget period.']
  commodity_price_assumption decimal(18,4) [note: 'Assumed commodity price per unit used in budget revenue and cost projections.']
  commodity_price_currency varchar [note: 'Currency code for the commodity price assumption.']
  contingency_reserve decimal(18,2) [note: 'Budgeted contingency reserve for unforeseen costs or operational variability.']
  cost_center_code varchar [note: 'Cost center code for internal management accounting and budget tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the budget amount.']
  depletion_expense decimal(18,2) [note: 'Budgeted depletion expense for natural resource extraction during the period.']
  depreciation_expense decimal(18,2) [note: 'Budgeted depreciation expense for property, plant, and equipment during the period.']
  ebitda_forecast decimal(18,2) [note: 'Forecasted EBITDA for the budget period reflecting operating performance before non-cash charges.']
  energy_consumption_target_mwh decimal(18,2) [note: 'Target energy consumption in megawatt hours for the budget period.']
  environmental_compliance_cost decimal(18,2) [note: 'Budgeted cost for environmental monitoring, reporting, and compliance activities.']
  ghg_emissions_target_tonnes decimal(18,2) [note: 'Target greenhouse gas emissions in tonnes of carbon dioxide equivalent for the budget period.']
  gl_account_code varchar [note: 'General ledger account code to which this budget line is mapped for financial reporting.']
  production_unit_of_measure varchar [note: 'Unit of measure for production volume such as barrels, cubic meters, tonnes, board feet, or bushels.']
  production_volume_target decimal(18,4) [note: 'Approved target production volume for the budget period.']
  reclamation_provision decimal(18,2) [note: 'Budgeted provision for asset retirement and land reclamation obligations.']
  record_created_timestamp timestamp [note: 'Timestamp when this budget record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this budget record was last updated in the system.']
  revenue_forecast decimal(18,2) [note: 'Forecasted gross revenue for the budget period based on production and commodity price assumptions.']
  revision_number varchar [note: 'Sequential revision number for tracking budget versions and amendments.']
  revision_reason varchar [note: 'Explanation for why the budget was revised including changes in commodity prices, production targets, or operational conditions.']
  safety_incident_target varchar [note: 'Target maximum number of recordable safety incidents for the budget period.']
  submission_date date [note: 'Date on which the budget was submitted for review and approval.']
  variance_threshold_percentage decimal(5,2) [note: 'Acceptable variance threshold percentage for budget versus actual performance before escalation is required.']
  water_usage_target_cubic_meters decimal(18,2) [note: 'Target water consumption in cubic meters for the budget period.']
  workforce_headcount_target varchar [note: 'Planned workforce headcount for the budget period including direct employees and contractors.']

  Note: 'Annual operating and capital expenditure budget for each natural resource asset. Captures budget year, budget type (opex, capex, sustaining capex, growth capex, reclamation/closure), budget amount by category, approved production volume targets, commodity'
}

Table naturalresource.reclamation_liability {
  reclamation_liability_id varchar [pk, note: 'Unique identifier for the asset retirement obligation and site reclamation liability record.']
  environmental_permit_id varchar [note: 'Foreign key linking to naturalresource.environmental_permit. Business justification: Reclamation liabilities (ARO) often arise from environmental permit conditions. The permit specifies reclamation requirements, deadlines, and bond amounts.']
  natural_resource_asset_id varchar [note: 'Reference to the extractive resource asset (mining, oil & gas, timberland) subject to reclamation obligation.']
  accretion_expense_current_period decimal(18,2) [note: 'Periodic increase in the carrying amount of the ARO liability due to passage of time, recognized as operating expense in the current reporting period.']
  actual_expenditure_to_date decimal(18,2) [note: 'Cumulative cash outflows incurred for reclamation activities to date, reducing the outstanding liability balance as work is performed.']
  area_to_reclaim_hectares decimal(12,2) [note: 'Total land area in hectares requiring reclamation work including disturbed surface, tailings ponds, waste rock piles, and access roads.']
  aro_reference_number varchar [note: 'Business identifier for the asset retirement obligation used in financial reporting and regulatory filings.']
  bond_expiry_date date [note: 'Expiration date of the reclamation bond requiring renewal or replacement to maintain regulatory compliance and permit validity.']
  bond_provider varchar [note: 'Name of the financial institution or surety company providing the reclamation bond or financial assurance instrument.']
  carbon_sequestration_potential decimal(12,2) [note: 'Estimated carbon dioxide equivalent that will be sequestered through revegetation and ecosystem restoration as part of reclamation activities, supporting net-zero commitments.']
  contingent_liability_flag boolean [note: 'Indicates whether the reclamation obligation is contingent on future events (e.g., permit expiry, production cessation) rather than a present obligation requiring immediate recognition.']
  cost_center_code varchar [note: 'Internal cost center or business unit code responsible for managing the natural resource asset and associated reclamation liability.']
  cost_estimation_method varchar [note: 'Methodology used to develop the undiscounted reclamation cost estimate, determining the reliability and audit trail of the liability valuation.']
  cost_estimator_name varchar [note: 'Name of the engineering firm, consultant, or internal team responsible for preparing the reclamation cost estimate and supporting documentation.']
  created_timestamp timestamp [note: 'Date and time when this reclamation liability record was first created in the data platform, supporting audit trail and data lineage requirements.']
  cumulative_accretion_expense decimal(18,2) [note: 'Total accretion expense recognized since initial recognition of the ARO, representing the time-value growth of the liability to date.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this reclamation liability record.']
  discount_rate decimal(8,4) [note: 'Credit-adjusted risk-free rate applied to calculate the present value of the asset retirement obligation, expressed as a decimal (e.g., 0.0350 for 3.50%).']
  esg_impact_category varchar [note: 'Primary ESG dimension addressed by the reclamation obligation, used for responsible investment reporting and TCFD climate risk disclosure.']
  estimate_date date [note: 'Date when the current reclamation cost estimate was prepared or last updated, establishing the baseline for financial reporting and regulatory compliance.']
  estimated_duration_months varchar [note: 'Expected time period in months required to complete all reclamation activities from commencement to final regulatory certification.']
  expected_settlement_date date [note: 'Estimated date when the reclamation work is expected to be completed and the liability settled, typically aligned with end of asset productive life.']
  fair_value_hierarchy_level varchar [note: 'IFRS 13 fair value hierarchy classification for the ARO liability valuation inputs, typically Level 3 due to unobservable inputs and significant estimation uncertainty.']
  funding_status varchar [note: 'Assessment of whether adequate financial resources (bonds, trust funds, restricted cash) are in place to cover the estimated reclamation liability.']
  gl_account_code varchar [note: 'Chart of accounts code for the ARO liability account in the general ledger, enabling financial statement mapping and audit trail.']
  inflation_rate_assumption decimal(6,4) [note: 'Annual inflation rate assumption applied to escalate future reclamation costs from current dollars to expected future nominal dollars, expressed as decimal.']
  initial_recognition_date date [note: 'Date when the asset retirement obligation was first recognized on the balance sheet per accounting standards.']
  jurisdiction varchar [note: 'Three-letter country code identifying the legal jurisdiction governing the reclamation obligation and environmental compliance requirements.']
  last_revision_date date [note: 'Date of the most recent update to the reclamation cost estimate or ARO liability valuation assumptions.']
  last_updated_timestamp timestamp [note: 'Date and time of the most recent modification to this reclamation liability record, enabling change tracking and data quality monitoring.']
  liability_status varchar [note: 'Current state of the reclamation liability in its lifecycle from initial estimation through final completion and regulatory sign-off.']
  liability_type varchar [note: 'Classification of the reclamation obligation based on the nature of the extractive activity and required remediation work. [ENUM-REF-CANDIDATE']
  monitoring_period_years varchar [note: 'Required post-reclamation monitoring and maintenance period in years before final regulatory sign-off and liability release can be obtained.']
  present_value_aro decimal(18,2) [note: 'Discounted present value of the estimated reclamation cost recognized as a liability on the balance sheet per accounting standards.']
  reclamation_bond_amount decimal(18,2) [note: 'Financial assurance or surety bond posted with regulatory authorities to guarantee funding for site reclamation if the operator defaults.']
  reclamation_plan_reference varchar [note: 'Document identifier or reference number for the approved site reclamation plan filed with environmental regulators detailing closure activities and timeline.']
  reclamation_scope_description varchar [note: 'Detailed narrative of the required reclamation activities including land recontouring, revegetation, water treatment, structure removal, and monitoring obligations.']
  regulatory_approval_date date [note: 'Date when the reclamation plan and cost estimate were approved by the relevant environmental regulatory authority.']
  regulatory_authority varchar [note: 'Name of the government agency or environmental regulator with jurisdiction over the reclamation obligation and site closure requirements.']
  regulatory_deadline_date date [note: 'Mandatory completion date imposed by environmental regulators or permit conditions for site reclamation activities.']
  remaining_liability_balance decimal(18,2) [note: 'Current outstanding ARO liability after adjusting for accretion, revisions, and actual expenditures, representing the present value of future reclamation obligations.']
  responsible_party_name varchar [note: 'Legal entity or operating partner with primary contractual and regulatory responsibility for executing and funding the reclamation work.']
  revision_amount decimal(18,2) [note: 'Change in the ARO liability due to revised cost estimates, timing changes, or discount rate adjustments, recorded as adjustment to asset carrying value or expense.']
  sensitivity_analysis_performed boolean [note: 'Indicates whether sensitivity analysis on key assumptions (discount rate, cost inflation, timing) has been performed to assess ARO valuation risk and range of outcomes.']
  trust_fund_balance decimal(18,2) [note: 'Current balance of dedicated reclamation trust fund or restricted cash account set aside to fund future site closure and remediation activities.']
  undiscounted_cost_estimate decimal(18,2) [note: 'Total estimated cost of reclamation activities in nominal future dollars before applying present value discount, representing the full expected cash outflow.']
  valuation_notes varchar [note: 'Free-text commentary on significant assumptions, estimation uncertainties, changes from prior period, or other relevant context for the ARO liability valuation.']

  Note: 'Asset retirement obligation (ARO) and site reclamation liability records for mining, oil & gas, and other extractive resource assets. Captures estimated reclamation cost (undiscounted), discount rate applied, present value of ARO, accretion expense per'
}

Table naturalresource.resource_fund_commitment {
  resource_fund_commitment_id varchar [pk, note: 'Unique identifier for the natural resource fund commitment record.']
  fund_id varchar [note: 'Reference to the external natural resource fund in which the pension fund is investing as a Limited Partner (LP).']
  investment_portfolio_id varchar [note: 'Reference to the internal investment portfolio that holds this natural resource fund commitment.']
  resource_vehicle_id varchar [note: 'Foreign key linking to naturalresource.resource_vehicle. Business justification: Resource fund commitments are LP commitments to natural resource funds/vehicles. The commitment should link to the specific resource_vehicle being invested in.']
  biodiversity_commitment_flag boolean [note: 'Indicates whether the fund has explicit biodiversity protection or enhancement commitments in its investment mandate.']
  carbon_intensity_target decimal(10,2) [note: 'Target greenhouse gas (GHG) emissions intensity for the fund portfolio, measured in tonnes CO2 equivalent per unit of production or revenue, aligned with climate commitments.']
  carried_interest_rate decimal(5,4) [note: 'Performance fee rate payable to the General Partner (GP) on profits above the hurdle rate, typically 20% for natural resource funds.']
  catch_up_provision varchar [note: 'Description of the catch-up mechanism allowing the General Partner (GP) to receive a higher share of profits after the hurdle rate is met, until the target carry split is achieved.']
  commitment_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to the natural resource fund, representing the maximum capital that may be called over the funds life.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code in which the commitment amount is denominated.']
  commitment_date date [note: 'Date on which the pension fund formally committed capital to the natural resource fund, typically the date the Limited Partnership Agreement (LPA) was executed.']
  commitment_number varchar [note: 'Externally-known unique identifier for this fund commitment, typically assigned by the General Partner (GP) or internal deal tracking system.']
  commitment_status varchar [note: 'Current lifecycle status of the fund commitment, indicating whether capital is still being called or the commitment has been fulfilled or terminated.']
  created_timestamp timestamp [note: 'System timestamp when this commitment record was first created in the data platform.']
  custodian_name varchar [note: 'Name of the third-party custodian or fund administrator holding legal title to the fund interests on behalf of the pension fund.']
  deal_team_lead varchar [note: 'Name of the internal investment professional responsible for originating, underwriting, and monitoring this fund commitment.']
  distributions_received decimal(18,2) [note: 'Cumulative cash distributions received by the pension fund from the natural resource fund, including return of capital and realized gains.']
  dpi decimal(10,4) [note: 'Cash-on-cash return multiple calculated as distributions received divided by paid-in capital, indicating realized value returned.']
  esg_classification varchar [note: 'Sustainable Finance Disclosure Regulation (SFDR) classification indicating the funds ESG integration level: Article 6 (no sustainability focus), Article 8 (promotes ESG), Article 9 (sustainable objective).']
  final_closing_date date [note: 'Date of the funds final closing after which no additional Limited Partners (LPs) may join and total fund size is fixed.']
  first_closing_date date [note: 'Date of the funds initial closing when the General Partner (GP) began accepting capital commitments.']
  fund_size_total decimal(18,2) [note: 'Total capital commitments raised by the fund from all Limited Partners (LPs) at final closing, representing the funds aggregate investment capacity.']
  fund_strategy varchar [note: 'Primary investment strategy of the natural resource fund, indicating the type of resource assets targeted.']
  fund_term_years varchar [note: 'Total contractual term of the fund in years, typically 10-15 years for natural resource funds, after which the fund must liquidate or seek extension.']
  geographic_focus varchar [note: 'Primary geographic regions or countries targeted by the natural resource fund for investment, using ISO 3166 country codes or regional descriptors.']
  gp_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the General Partner, used for regulatory reporting and counterparty identification.']
  gp_name varchar [note: 'Legal name of the General Partner managing the natural resource fund.']
  hurdle_rate decimal(5,4) [note: 'Minimum annualized return threshold that Limited Partners (LPs) must achieve before the General Partner (GP) earns carried interest, typically 8% for natural resource funds.']
  investment_committee_approval_date date [note: 'Date on which the pension funds Investment Committee (IC) formally approved the commitment to this natural resource fund.']
  investment_period_end_date date [note: 'Date after which the General Partner (GP) may no longer make new investments, typically 3-5 years from first closing.']
  irr decimal(10,4) [note: 'Annualized time-weighted return on the fund commitment, calculated using cash flows (capital calls and distributions) and current NAV.']
  key_person_clause varchar [note: 'Description of the key person provisions in the Limited Partnership Agreement (LPA) that suspend the investment period if specified senior investment professionals leave the General Partner (GP).']
  last_capital_call_date date [note: 'Date of the most recent capital call notice issued by the General Partner (GP) for this commitment.']
  last_distribution_date date [note: 'Date of the most recent cash distribution received by the pension fund from the natural resource fund.']
  lp_ownership_percentage decimal(5,4) [note: 'Pension funds proportional ownership stake in the fund, calculated as commitment amount divided by fund size total.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the General Partner (GP), typically expressed as a percentage of committed capital during investment period and NAV thereafter.']
  nav decimal(18,2) [note: 'Current fair value of the pension funds remaining investment in the natural resource fund, representing unrealized value as of the latest valuation date.']
  nav_date date [note: 'As-of date for the reported Net Asset Value (NAV), typically quarterly or annually per the funds reporting schedule.']
  paid_in_capital decimal(18,2) [note: 'Cumulative amount of capital called and funded by the pension fund to date, representing actual cash invested.']
  pri_signatory_flag boolean [note: 'Indicates whether the General Partner (GP) is a signatory to the United Nations Principles for Responsible Investment (PRI).']
  rvpi decimal(10,4) [note: 'Unrealized value multiple calculated as NAV divided by paid-in capital, indicating remaining unrealized value.']
  side_letter_flag boolean [note: 'Indicates whether the pension fund negotiated a side letter with the General Partner (GP) granting special rights, fee discounts, or reporting provisions.']
  tvpi decimal(10,4) [note: 'Performance multiple calculated as (distributions received plus NAV) divided by paid-in capital, indicating total value creation.']
  unfunded_commitment decimal(18,2) [note: 'Remaining uncalled capital commitment available for future capital calls, calculated as commitment amount minus paid-in capital.']
  updated_timestamp timestamp [note: 'System timestamp when this commitment record was last modified, used for audit trail and data lineage.']
  vintage_year varchar [note: 'Year in which the fund held its initial closing and began making capital calls, used for performance benchmarking and cohort analysis.']

  Note: 'Commitment record for natural resource fund investments where the pension fund participates as an LP in a dedicated natural resource fund (timberland fund, farmland fund, commodity fund, energy fund).'
}

Table naturalresource.resource_cashflow {
  resource_cashflow_id varchar [pk, note: 'Unique identifier for the natural resource cash flow record.']
  cash_account_id varchar [note: 'Reference to the bank account used for the cash flow transaction.']
  counterparty_id varchar [note: 'Reference to the counterparty legal entity involved in the transaction.']
  employee_id varchar [note: 'Reference to the user who approved this cash flow record.']
  investment_portfolio_id varchar [note: 'Reference to the investment portfolio that owns this natural resource asset.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset generating this cash flow.']
  offtake_agreement_id varchar [note: 'Foreign key linking to naturalresource.offtake_agreement. Business justification: Resource cashflows from commodity sales are governed by offtake agreements. The cashflow has contract_reference_number which is a denormalized reference.']
  accrual_date date [note: 'Date when the cash flow was accrued for accounting purposes.']
  approval_date date [note: 'Date when the cash flow record was approved by authorized personnel.']
  base_currency_code varchar [note: 'ISO 4217 three-letter code for the base reporting currency.']
  capital_expenditure_amount decimal(18,2) [note: 'Capital expenditures for asset development or infrastructure.']
  cashflow_category varchar [note: 'Detailed business category of the cash flow transaction.']
  cashflow_period_end_date date [note: 'End date of the period covered by this cash flow record.']
  cashflow_period_start_date date [note: 'Start date of the period covered by this cash flow record.']
  cashflow_status varchar [note: 'Current status of the cash flow record in its lifecycle.']
  cashflow_type varchar [note: 'Classification of the cash flow by activity type per accounting standards.']
  commodity_price_per_unit decimal(18,4) [note: 'Realized price per unit of commodity for revenue cash flows.']
  commodity_type varchar [note: 'Type of commodity associated with this cash flow if applicable. [ENUM-REF-CANDIDATE: timber|agricultural_crop|crude_oil|natural_gas|coal|gold|copper|iron_ore|other_mineral — 9 candidates stripped; promote to reference product]']
  cost_center_code varchar [note: 'Cost center code for internal management accounting and allocation.']
  counterparty_legal_entity_code varchar [note: 'Reference to the counterparty legal entity involved in the transaction.']
  created_timestamp timestamp [note: 'Timestamp when this cash flow record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the cash flow amounts.']
  depletion_charge_amount decimal(18,2) [note: 'Non-cash depletion charge allocated to this period for resource consumption.']
  dispute_flag boolean [note: 'Indicates whether this cash flow is under dispute.']
  dispute_reason varchar [note: 'Explanation of the dispute if the cash flow is contested.']
  esg_impact_category varchar [note: 'ESG impact category associated with this cash flow for responsible investment reporting.']
  fx_rate_to_base decimal(18,8) [note: 'Exchange rate used to convert local currency to base reporting currency.']
  gl_account_code varchar [note: 'General ledger account code for financial reporting and accounting.']
  gross_revenue_amount decimal(18,2) [note: 'Total gross revenue before deductions for the period.']
  last_modified_timestamp timestamp [note: 'Timestamp when this cash flow record was last updated.']
  net_cashflow_amount decimal(18,2) [note: 'Net cash flow amount after all inflows and outflows for the period.']
  net_cashflow_base_amount decimal(18,2) [note: 'Net cash flow amount converted to base reporting currency.']
  notes varchar [note: 'Additional notes or comments regarding this cash flow record.']
  operating_expense_amount decimal(18,2) [note: 'Operating expenses incurred for resource extraction or production.']
  payment_method varchar [note: 'Method used for payment or receipt of funds.']
  production_unit_of_measure varchar [note: 'Unit of measure for the production volume. [ENUM-REF-CANDIDATE: cubic_meters|barrels|tonnes|metric_tons|hectares|acres|board_feet|bushels — 8 candidates stripped; promote to reference product]']
  production_volume decimal(18,4) [note: 'Quantity of commodity produced or sold during the period.']
  reclamation_contribution_amount decimal(18,2) [note: 'Contributions to reclamation or environmental restoration funds.']
  reversal_date date [note: 'Date when the cash flow was reversed if applicable.']
  reversal_flag boolean [note: 'Indicates whether this cash flow record has been reversed.']
  reversal_reason varchar [note: 'Explanation for why the cash flow was reversed.']
  royalty_amount decimal(18,2) [note: 'Royalty payment amount to landowners or government entities.']
  settlement_date date [note: 'Date when the cash flow was settled or payment was received or made.']
  source_system_record_code varchar [note: 'Unique identifier of this record in the source system for traceability.']
  tax_amount decimal(18,2) [note: 'Tax payments including severance tax, property tax, or income tax.']
  transaction_date date [note: 'Date when the cash flow transaction occurred or was recognized.']

  Note: 'Periodic cash flow records at the asset level capturing all cash inflows and outflows from natural resource operations. Includes revenue from commodity sales, royalty payments, operating expenses, capital expenditures, reclamation fund contributions'
}

Table naturalresource.operational_incident {
  operational_incident_id varchar [pk, note: 'Unique identifier for the operational incident record affecting natural resource asset operations.']
  natural_resource_asset_id varchar [note: 'Reference to the natural resource asset affected by this operational incident.']
  corrective_action_plan varchar [note: 'Summary of the corrective action plan implemented to prevent recurrence including process changes, equipment upgrades, and training initiatives.']
  created_timestamp timestamp [note: 'System timestamp when this operational incident record was first created in the data platform.']
  currency_code varchar [note: 'Three-letter ISO currency code for the estimated financial impact amount.']
  downtime_hours decimal(10,2) [note: 'Total number of hours that operations were halted or significantly impaired due to the incident.']
  environmental_impact_description varchar [note: 'Description of the environmental impacts resulting from the incident including affected ecosystems, contamination extent, and species or habitat damage.']
  environmental_impact_flag boolean [note: 'Indicates whether the incident resulted in environmental damage, contamination, or ecological harm requiring assessment and remediation.']
  esg_impact_category varchar [note: 'Classification of the incidents primary impact area within the ESG framework for responsible investment reporting and stewardship.']
  estimated_financial_impact decimal(18,2) [note: 'Estimated total financial impact of the incident including lost revenue, remediation costs, penalties, and asset damage in base currency.']
  fatality_count varchar [note: 'Number of fatalities resulting from the operational incident.']
  force_majeure_flag boolean [note: 'Indicates whether the incident qualifies as a force majeure event under applicable contracts and legal agreements.']
  ghg_emissions_impact decimal(18,4) [note: 'Estimated greenhouse gas emissions resulting from the incident measured in tonnes of carbon dioxide equivalent for climate impact assessment.']
  incident_description varchar [note: 'Comprehensive narrative description of the operational incident including circumstances, contributing factors, immediate impacts, and initial response actions taken.']
  incident_end_timestamp timestamp [note: 'Date and time when the operational incident was resolved or contained, allowing resumption of normal operations.']
  incident_location_description varchar [note: 'Detailed description of the specific location within the natural resource asset where the incident occurred including parcel, facility, or operational area.']
  incident_notes varchar [note: 'Additional notes, observations, or supplementary information related to the incident not captured in other structured fields.']
  incident_number varchar [note: 'Externally-known unique reference number assigned to this operational incident for tracking and reporting purposes.']
  incident_start_timestamp timestamp [note: 'Date and time when the operational incident began or was first detected at the natural resource asset location.']
  incident_status varchar [note: 'Current state of the incident in its lifecycle from initial reporting through investigation, containment, resolution, and closure.']
  incident_type varchar [note: 'Classification of the operational incident affecting natural resource operations including weather events, equipment failures, regulatory actions, labor disputes, environmental incidents, and natural disasters.']
  injury_count varchar [note: 'Number of personnel injuries resulting from the operational incident.']
  insurance_claim_flag boolean [note: 'Indicates whether an insurance claim has been filed for losses or damages resulting from this operational incident.']
  insurance_claim_number varchar [note: 'Reference number assigned by the insurance carrier for the claim filed in relation to this incident.']
  insurance_recovery_amount decimal(18,2) [note: 'Amount recovered or expected to be recovered from insurance coverage for losses incurred from the incident.']
  investigation_completion_date date [note: 'Date when the formal investigation into the incident was completed and final report issued.']
  investigation_status varchar [note: 'Current status of the formal investigation into the incident causes, impacts, and corrective actions.']
  last_updated_timestamp timestamp [note: 'System timestamp when this operational incident record was most recently modified or updated.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the incident location in decimal degrees for spatial analysis and emergency response.']
  lessons_learned varchar [note: 'Documentation of key lessons learned from the incident for knowledge sharing and continuous improvement of operational risk management practices.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the incident location in decimal degrees for spatial analysis and emergency response.']
  production_impact_flag boolean [note: 'Indicates whether the incident resulted in disruption or reduction of production output from the natural resource asset.']
  production_loss_unit varchar [note: 'Unit of measure for the production loss volume such as cubic meters, barrels, tonnes, board feet, or megawatt hours depending on resource type.']
  production_loss_volume decimal(18,4) [note: 'Quantified volume of production lost due to the operational incident measured in the assets standard unit of production.']
  regulatory_authority_name varchar [note: 'Name of the regulatory authority or government agency notified of the incident.']
  regulatory_notification_date date [note: 'Date when regulatory authorities were formally notified of the operational incident as required by applicable regulations.']
  regulatory_notification_required_flag boolean [note: 'Indicates whether the incident requires mandatory notification to regulatory authorities or government agencies.']
  remediation_cost decimal(18,2) [note: 'Actual or estimated cost of remediation activities including cleanup, repair, restoration, and corrective actions required to address the incident.']
  reported_by_name varchar [note: 'Name of the individual or entity who first reported the operational incident.']
  reported_timestamp timestamp [note: 'Date and time when the incident was formally reported to management or regulatory authorities.']
  response_team_assigned varchar [note: 'Name or identifier of the incident response team or emergency response unit assigned to manage and resolve the incident.']
  root_cause_analysis varchar [note: 'Summary of the root cause analysis findings identifying underlying factors that led to the incident and systemic issues requiring remediation.']
  safety_incident_flag boolean [note: 'Indicates whether the operational incident involved worker safety issues, injuries, or occupational health hazards.']
  severity_level varchar [note: 'Assessment of the incidents severity based on operational impact, financial exposure, safety risk, and environmental consequences.']
  third_party_involvement_flag boolean [note: 'Indicates whether third-party contractors, vendors, or external parties were involved in or contributed to the incident.']
  third_party_name varchar [note: 'Name of the third-party entity involved in the incident if applicable.']

  Note: 'Records operational incidents, disruptions, and force majeure events affecting natural resource asset operations. Captures incident type (weather event, equipment failure, regulatory shutdown, labor dispute, environmental spill, wildfire, flood), incident'
}

Table naturalresource.harvest_plan {
  harvest_plan_id varchar [pk, note: 'Unique identifier for the harvest plan record.']
  asset_manager_employee_id varchar [note: 'Reference to the internal asset manager or portfolio manager responsible for overseeing this harvest plan.']
  depletion_schedule_id varchar [note: 'Reference to the depletion schedule used for accounting and valuation of the harvested resource.']
  employee_id varchar [note: 'Reference to the internal user or investment committee member who approved the harvest plan.']
  environmental_permit_id varchar [note: 'Reference to the environmental permit authorizing harvest activities under applicable regulatory frameworks.']
  investment_portfolio_id varchar [note: 'Reference to the investment portfolio to which this natural resource asset and harvest plan are allocated.']
  land_parcel_id varchar [note: 'Reference to the specific land parcel where harvest activities will occur.']
  legal_entity_id varchar [note: 'Reference to the third-party contractor or service provider engaged to execute harvest operations.']
  natural_resource_asset_id varchar [note: 'Reference to the timberland or farmland asset subject to this harvest plan.']
  offtake_agreement_id varchar [note: 'Foreign key linking to naturalresource.offtake_agreement. Business justification: Harvest plans for timberland/farmland may be tied to specific offtake agreements that govern the sale of harvested production.']
  actual_harvest_end_date date [note: 'Actual date when harvest operations concluded, used for performance tracking and variance analysis.']
  actual_harvest_start_date date [note: 'Actual date when harvest operations commenced, used for performance tracking and variance analysis.']
  actual_harvest_volume decimal(15,2) [note: 'Actual total volume or quantity of resource harvested, used for reconciliation against planned volume.']
  approval_date date [note: 'Date on which the harvest plan received formal approval from internal governance and external regulatory bodies.']
  biodiversity_impact_assessment varchar [note: 'Qualitative assessment of the harvest plans impact on local biodiversity and ecosystem services.']
  carbon_sequestration_impact decimal(12,2) [note: 'Estimated net change in carbon sequestration resulting from the harvest, expressed in tonnes of CO2 equivalent.']
  commodity_price_assumption decimal(12,2) [note: 'Assumed market price per unit of harvested commodity used for revenue estimation and valuation purposes.']
  created_timestamp timestamp [note: 'Timestamp when this harvest plan record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this harvest plan.']
  estimated_cost decimal(18,2) [note: 'Projected total cost of harvest operations including labor, equipment, transportation, and regulatory compliance.']
  estimated_revenue decimal(18,2) [note: 'Projected gross revenue from the planned harvest based on current commodity prices and volume assumptions.']
  estimated_yield_per_hectare decimal(10,2) [note: 'Projected average yield per hectare based on site productivity, stand age, and historical performance.']
  harvest_area_hectares decimal(12,2) [note: 'Total land area in hectares designated for harvest activities under this plan.']
  harvest_method varchar [note: 'Silvicultural or agricultural harvest technique to be employed, reflecting sustainability and regeneration strategy.']
  last_modified_timestamp timestamp [note: 'Timestamp when this harvest plan record was last updated, used for audit trail and change tracking.']
  plan_end_date date [note: 'Planned date when harvest activities are scheduled to conclude under this plan.']
  plan_name varchar [note: 'Descriptive name for the harvest plan identifying the location, resource type, and planning period.']
  plan_notes varchar [note: 'Free-text field for additional operational notes, special conditions, or contextual information relevant to the harvest plan.']
  plan_reference_number varchar [note: 'Externally-known business identifier for the harvest plan used in operational communications and regulatory filings.']
  plan_start_date date [note: 'Planned date when harvest activities are scheduled to commence under this plan.']
  plan_status varchar [note: 'Current lifecycle status of the harvest plan indicating its operational state and approval stage.']
  plan_type varchar [note: 'Classification of the harvest plan by primary resource type being harvested.']
  plan_year varchar [note: 'Calendar year for which this harvest plan is scheduled and budgeted.']
  planned_harvest_volume decimal(15,2) [note: 'Estimated total volume or quantity of resource planned for harvest expressed in the unit of measure specified.']
  price_deck_scenario varchar [note: 'Commodity price scenario applied in the harvest plan reflecting macroeconomic assumptions and risk sensitivity.']
  reforestation_deadline_date date [note: 'Regulatory or contractual deadline by which reforestation or regeneration activities must be completed.']
  reforestation_plan_flag boolean [note: 'Indicates whether a formal reforestation or regeneration plan is required and documented for this harvest area.']
  regulatory_approval_status varchar [note: 'Status of regulatory approval from relevant environmental and forestry authorities for this harvest plan.']
  risk_rating varchar [note: 'Overall risk rating assigned to the harvest plan considering operational, environmental, regulatory, and market risks.']
  rotation_age_years varchar [note: 'Age of the timber stand or crop rotation cycle at the time of planned harvest, relevant for sustainable yield calculations.']
  species_type varchar [note: 'Primary timber species or agricultural crop type targeted for harvest under this plan.']
  sustainability_certification varchar [note: 'Third-party sustainability certification standard under which the harvest plan is designed and will be audited.']
  variance_explanation varchar [note: 'Explanation of significant variances between planned and actual harvest metrics including volume, timing, and cost.']
  volume_unit_of_measure varchar [note: 'Unit of measure for the planned harvest volume, aligned with industry standards for the resource type.']
  weather_dependency_flag boolean [note: 'Indicates whether harvest timing and execution are significantly dependent on favorable weather conditions.']

  Note: 'Timber and agricultural harvest planning records for timberland and farmland assets. Captures plan year, harvest area (hectares), planned harvest volume by species/crop type, harvest method (clear-cut, selective, sustainable yield), planned harvest dates'
}

Table naturalresource.carbon_project {
  carbon_project_id varchar [pk, note: 'Primary key for carbon_project']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Carbon projects (REDD+, reforestation, etc.) are typically associated with underlying natural resource assets like timberland or farmland.']
  acquisition_date date [note: 'Date when the pension fund acquired its ownership stake in the carbon project.']
  additionality_type varchar [note: 'Method used to demonstrate that carbon reductions would not occur without project intervention.']
  article_6_eligible_flag boolean [note: 'Indicates whether credits qualify for Paris Agreement Article 6 international transfers.']
  buffer_pool_contribution_percent decimal(5,2) [note: 'Percentage of issued credits contributed to the registry buffer pool for permanence risk.']
  carbon_project_description varchar [note: 'Detailed narrative description of the carbon project activities and objectives.']
  carbon_project_name varchar [note: 'Official registered name of the carbon project as filed with the carbon registry.']
  carbon_project_status varchar [note: 'Current lifecycle status of the carbon project from development through active credit generation.']
  ccb_certification_flag boolean [note: 'Indicates whether the project holds Climate Community and Biodiversity Standards certification.']
  co_benefits_flag boolean [note: 'Indicates whether the project delivers verified co-benefits beyond carbon reduction.']
  corsia_eligible_flag boolean [note: 'Indicates whether credits are eligible for ICAO CORSIA aviation offsetting compliance.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the carbon project is physically located.']
  crediting_period_end_date date [note: 'Date when the carbon credit generation crediting period is scheduled to end.']
  crediting_period_start_date date [note: 'Date when the carbon credit generation crediting period officially begins.']
  crediting_period_years varchar [note: 'Total duration of the crediting period measured in years as defined in project documentation.']
  credits_issued_to_date_tonnes decimal(18,4) [note: 'Cumulative carbon credits issued by the registry to date in tonnes of CO2 equivalent.']
  credits_retired_to_date_tonnes decimal(18,4) [note: 'Cumulative carbon credits permanently retired from circulation in tonnes of CO2 equivalent.']
  current_valuation_usd decimal(18,2) [note: 'Current fair market valuation of the pension funds stake in US dollars.']
  esg_score decimal(5,2) [note: 'Composite ESG rating score assigned to the carbon project based on internal assessment.']
  estimated_annual_credits_tonnes decimal(18,4) [note: 'Projected annual carbon credit generation capacity measured in tonnes of CO2 equivalent.']
  internal_risk_rating varchar [note: 'Internal investment risk classification assigned by the pension fund risk team.']
  investment_amount_usd decimal(18,2) [note: 'Total capital invested by the pension fund in this carbon project in US dollars.']
  last_verification_date date [note: 'Date of the most recent third-party verification of carbon credit issuance claims.']
  latitude decimal(10,7) [note: 'Geographic latitude coordinate of the carbon project centroid location.']
  longitude decimal(10,7) [note: 'Geographic longitude coordinate of the carbon project centroid location.']
  methodology_code varchar [note: 'Standardized methodology code defining the carbon accounting and quantification approach used.']
  next_verification_date date [note: 'Scheduled date for the next third-party verification of carbon credit claims.']
  notes varchar [note: 'Internal notes and commentary from investment analysts regarding the carbon project.']
  ownership_percentage decimal(5,2) [note: 'Percentage ownership stake held by the pension fund in the carbon project.']
  permanence_risk_rating varchar [note: 'Assessment of the risk that sequestered carbon may be released back to the atmosphere.']
  project_area_hectares decimal(18,4) [note: 'Total land area covered by the carbon project measured in hectares.']
  project_code varchar [note: 'External business identifier code for the carbon project used in registry systems and reporting.']
  project_developer_name varchar [note: 'Name of the organization responsible for developing and implementing the carbon project.']
  project_type varchar [note: 'Classification of the carbon project methodology type determining credit generation approach.']
  record_created_timestamp timestamp [note: 'Timestamp when this carbon project record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this carbon project record was last modified.']
  region varchar [note: 'Geographic region or state/province within the country where the project is situated.']
  registration_date date [note: 'Date when the carbon project was officially registered with the carbon credit registry.']
  registry_name varchar [note: 'Name of the carbon credit registry where the project is registered and credits are issued.']
  registry_project_code varchar [note: 'Unique project identifier assigned by the carbon registry for tracking and verification purposes.']
  sdg_alignment_codes varchar [note: 'Comma-separated UN Sustainable Development Goal numbers the project contributes to.']
  total_estimated_credits_tonnes decimal(18,4) [note: 'Total projected carbon credits over the full crediting period in tonnes of CO2 equivalent.']
  validation_body_name varchar [note: 'Name of the accredited third-party organization that validated the project design.']
  validation_date date [note: 'Date when the carbon project was validated by an accredited third-party validation body.']
  valuation_date date [note: 'Date of the most recent fair market valuation assessment.']
  verification_body_name varchar [note: 'Name of the accredited third-party organization that verifies credit issuance claims.']

  Note: 'Master reference table for carbon_project. Referenced by project_id.'
}

Table naturalresource.resource_vehicle {
  resource_vehicle_id varchar [pk, note: 'Primary key for resource_vehicle']
  administrator_name varchar [note: 'Name of the third-party fund administrator responsible for accounting and investor services.']
  auditor_name varchar [note: 'Name of the external audit firm responsible for auditing the vehicles financial statements.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code representing the functional currency of the resource investment vehicle.']
  called_capital decimal(18,2) [note: 'Cumulative capital called from investors to date for investments and expenses in base currency.']
  carbon_intensity_score decimal(10,4) [note: 'Measure of carbon emissions intensity per unit of revenue or production for climate risk assessment.']
  carried_interest_rate decimal(5,4) [note: 'Performance fee rate payable to the general partner on profits above the hurdle rate expressed as a decimal percentage.']
  commodity_exposure_type varchar [note: 'Primary commodity types the vehicle has exposure to such as oil, gas, timber, agricultural products, or metals.']
  created_timestamp timestamp [note: 'Timestamp when the resource vehicle record was first created in the system.']
  custodian_name varchar [note: 'Name of the custodian bank or institution holding the vehicles assets for safekeeping.']
  distributed_capital decimal(18,2) [note: 'Cumulative distributions returned to investors from the resource vehicle in base currency.']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the resource investment vehicle is legally domiciled for tax and regulatory purposes.']
  esg_rating varchar [note: 'Environmental, Social, and Governance rating assigned by recognized rating agencies or internal assessment.']
  extension_years_available varchar [note: 'Number of additional years the fund term may be extended beyond the original termination date per partnership agreement.']
  fund_term_years varchar [note: 'Contractual duration of the fund in years from inception to scheduled termination excluding extensions.']
  geographic_focus varchar [note: 'Primary geographic regions or countries where the resource vehicle targets investments for portfolio construction.']
  gp_commitment_percentage decimal(5,4) [note: 'Percentage of total fund commitments contributed by the general partner demonstrating alignment of interests.']
  hard_cap_amount decimal(18,2) [note: 'Maximum capital commitment amount the fund will accept as defined in partnership documents in base currency.']
  hurdle_rate decimal(5,4) [note: 'Minimum preferred return rate that must be achieved before carried interest is payable expressed as a decimal percentage.']
  inception_date date [note: 'Date when the resource investment vehicle was established or first capital was deployed.']
  investment_period_end_date date [note: 'Date when the active investment period ends after which no new investments can be made from uncalled capital.']
  investment_strategy varchar [note: 'Risk-return strategy classification of the resource vehicle determining expected return profile and risk tolerance.']
  is_esg_compliant boolean [note: 'Indicates whether the resource vehicle meets Environmental, Social, and Governance compliance standards.']
  is_evergreen boolean [note: 'Indicates whether the vehicle has an evergreen structure with no fixed termination date and continuous reinvestment.']
  is_open_ended boolean [note: 'Indicates whether the vehicle is open-ended with ongoing subscriptions and redemptions versus closed-end structure.']
  legal_name varchar [note: 'Full legal registered name of the resource investment vehicle as per incorporation or registration documents.']
  legal_structure varchar [note: 'Legal entity structure of the vehicle such as limited partnership, LLC, trust, or corporation for tax and liability purposes.']
  management_fee_rate decimal(5,4) [note: 'Annual management fee rate charged by the general partner expressed as a decimal percentage of committed or invested capital.']
  modified_timestamp timestamp [note: 'Timestamp when the resource vehicle record was last modified in the system.']
  nav_date date [note: 'As-of date for the most recent net asset value calculation of the resource vehicle.']
  net_asset_value decimal(18,2) [note: 'Current net asset value of the resource investment vehicle representing fair value of assets less liabilities.']
  regulatory_classification varchar [note: 'Regulatory classification of the vehicle under applicable securities laws such as 3(c)(7), AIFMD, or UCITS.']
  reporting_frequency varchar [note: 'Frequency at which the vehicle provides performance and financial reports to investors.']
  resource_category varchar [note: 'Primary natural resource category that the investment vehicle focuses on for asset allocation classification.']
  resource_vehicle_description varchar [note: 'Detailed narrative description of the resource vehicles investment mandate, strategy, and objectives.']
  resource_vehicle_name varchar [note: 'Human-readable name of the resource investment vehicle as registered or commonly known in the market.']
  resource_vehicle_status varchar [note: 'Current lifecycle status of the resource investment vehicle indicating operational state.']
  sub_category varchar [note: 'Secondary classification within the primary resource category for granular portfolio segmentation and analysis.']
  target_fund_size decimal(18,2) [note: 'Target total capital commitments the resource vehicle aims to raise during fundraising in base currency.']
  tax_status varchar [note: 'Tax treatment classification of the vehicle such as pass-through, blocker, or tax-exempt for investor reporting.']
  termination_date date [note: 'Scheduled or actual date when the resource investment vehicle is expected to or did terminate operations.']
  total_committed_capital decimal(18,2) [note: 'Aggregate capital commitments from all limited partners and general partner to the resource vehicle in base currency.']
  valuation_frequency varchar [note: 'Frequency at which the underlying assets of the vehicle are formally valued for NAV calculation.']
  vehicle_code varchar [note: 'Externally-known unique business identifier code for the resource investment vehicle used in reporting and communications.']
  vehicle_type varchar [note: 'Classification of the resource investment vehicle structure determining legal and operational characteristics.']
  vintage_year varchar [note: 'Year of first capital call or investment deployment used for performance benchmarking and peer comparison.']

  Note: 'Master reference table for resource_vehicle. Referenced by resource_vehicle_id.'
}

Table credit.fixed_income_security {
  fixed_income_security_id varchar [pk, note: 'Unique identifier for the fixed income security record. Primary key.']
  credit_issuer_id varchar [note: 'Foreign key linking to credit.credit_issuer. Business justification: Fixed income securities belong to one issuer; adding credit_issuer_id provides a direct link and removes redundant issuer name and lei columns.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Align security with the instrument traded for pricing and analytics.']
  accrued_interest decimal(20,6) [note: 'Interest accumulated on the security since the last coupon payment date, calculated as of the current valuation date.']
  bloomberg_ticker varchar [note: 'Bloomberg-assigned ticker symbol for the fixed income security used in Bloomberg Terminal.']
  callable_flag boolean [note: 'Indicates whether the issuer has the right to redeem the security before maturity.']
  convexity decimal(10,4) [note: 'Measure of the curvature in the relationship between bond prices and yields, indicating how duration changes as yields change.']
  country_of_risk varchar [note: 'Three-letter ISO 3166 country code representing the primary country exposure or domicile of the issuer.']
  coupon_frequency varchar [note: 'Frequency at which coupon interest payments are made to bondholders.']
  coupon_rate decimal(10,6) [note: 'Annual interest rate paid by the issuer expressed as a decimal percentage of face value.']
  created_timestamp timestamp [note: 'Timestamp when the security record was first created in the system.']
  credit_rating_fitch varchar [note: 'Current credit rating assigned by Fitch rating agency.']
  credit_rating_moody varchar [note: 'Current credit rating assigned by Moody\'s rating agency.']
  credit_rating_sp varchar [note: 'Current credit rating assigned by Standard & Poor\'s rating agency.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the security is denominated.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities.']
  default_flag boolean [note: 'Indicates whether the issuer is currently in default on interest or principal payments.']
  duration decimal(10,4) [note: 'Weighted average time to receive the bond\'s cash flows, measuring interest rate sensitivity in years.']
  dv01 decimal(18,6) [note: 'Change in the market value of the security for a one basis point change in yield, expressed in currency units.']
  esg_rating varchar [note: 'ESG score or rating assigned by external provider assessing sustainability and responsible investment criteria.']
  face_value decimal(20,2) [note: 'Par or nominal value of the security at issuance, representing the principal amount to be repaid at maturity.']
  first_coupon_date date [note: 'Date on which the first coupon payment is scheduled to be made to bondholders.']
  fixed_income_security_status varchar [note: 'Current lifecycle status of the fixed income security.']
  floating_rate_flag boolean [note: 'Indicates whether the coupon rate is variable and resets periodically based on a reference rate.']
  green_bond_flag boolean [note: 'Indicates whether the security is classified as a green bond with proceeds dedicated to environmental projects.']
  investment_grade_flag boolean [note: 'Indicates whether the security is classified as investment grade based on credit ratings.']
  isin varchar [note: '12-character alphanumeric code uniquely identifying the security globally per ISO 6166 standard.']
  issue_date date [note: 'Date on which the fixed income security was originally issued to investors.']
  last_coupon_date date [note: 'Date on which the most recent coupon payment was made to bondholders.']
  liquidity_classification varchar [note: 'Assessment of the ease with which the security can be bought or sold in the market without significant price impact.']
  market_price decimal(20,6) [note: 'Current market price of the security expressed as a percentage of face value or in currency units.']
  maturity_date date [note: 'Date on which the principal amount of the security is due to be repaid in full.']
  next_coupon_date date [note: 'Date on which the next coupon payment is scheduled to be made to bondholders.']
  oas decimal(10,2) [note: 'Spread over the risk-free rate adjusted for embedded options, measured in basis points.']
  price_date date [note: 'Date as of which the market price was observed or quoted.']
  puttable_flag boolean [note: 'Indicates whether the holder has the right to sell the security back to the issuer before maturity.']
  reference_rate decimal(18,2) [note: 'Benchmark interest rate index used for floating rate securities, such as Secured Overnight Financing Rate (SOFR) or London Interbank Offered Rate (LIBOR).']
  sector varchar [note: 'Economic sector or industry classification of the issuer.']
  security_name varchar [note: 'Full legal name or description of the fixed income security as issued.']
  security_type varchar [note: 'Classification of the fixed income instrument by broad category. [ENUM-REF-CANDIDATE: government_bond|corporate_bond|municipal_bond|treasury_bill|structured_product|private_credit|asset_backed_security — 7 candidates stripped; promote to reference product]']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  sinking_fund_flag boolean [note: 'Indicates whether the issuer is required to set aside funds periodically to retire portions of the debt before maturity.']
  spread_over_reference decimal(10,2) [note: 'Fixed spread in basis points added to the reference rate to determine the floating coupon rate.']
  subordination_level varchar [note: 'Ranking of the security in the issuer\'s capital structure determining priority in bankruptcy or liquidation.']
  updated_timestamp timestamp [note: 'Timestamp when the security record was last modified in the system.']
  ytm decimal(10,6) [note: 'Total return anticipated on the bond if held until maturity, expressed as an annual percentage rate.']

  Note: 'Master record for all fixed income and credit instruments held or monitored by the pension fund, including investment grade (IG) bonds, high yield (HY) bonds, sovereign debt, T-Bills, SOFR-linked instruments, private credit notes, and structured products'
}

Table credit.credit_position {
  credit_position_id varchar [pk, note: 'Unique identifier for the credit position record in the Investment Book of Record (IBOR).']
  cash_position_id varchar [note: 'Foreign key linking to treasury.cash_position. Business justification: Pension fund reconciles each credit position with the cash position that funded the purchase for regulatory reporting and internal audit.']
  counterparty_id varchar [note: 'Reference to the counterparty entity for over-the-counter (OTC) transactions or derivatives.']
  credit_blotter_id varchar [note: 'Foreign key linking to trade.blotter. Business justification: Audit trail linking position to the trade that created it for regulatory reporting.']
  credit_custodian_blotter_id varchar [note: 'Reference to the custody bank holding the physical or electronic securities.']
  credit_mandate_id varchar [note: 'Foreign key linking to credit.credit_mandate. Business justification: Credit positions are governed by investment mandates; adding credit_mandate_id links each position to its mandate, enabling mandate‑level reporting.']
  custodian_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Custodian bank details are required for settlement, regulatory reporting, and risk management of each position.']
  fixed_income_security_id varchar [note: 'Reference to the fixed income security master record for this credit instrument.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding this credit position.']
  account_number varchar [note: 'Custodian or broker account number where the position is held.']
  accrued_interest decimal(18,2) [note: 'Interest earned but not yet paid since the last coupon payment date.']
  acquisition_date date [note: 'Date on which the position was first acquired into the portfolio.']
  asset_class varchar [note: 'Classification of the credit instrument by asset class category.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code for the funds reporting currency.']
  benchmark_index varchar [note: 'Reference benchmark index used for performance comparison and spread calculation, such as Secured Overnight Financing Rate (SOFR).']
  book_cost decimal(18,2) [note: 'Original acquisition cost of the position including transaction costs, recorded in base currency.']
  collateral_type varchar [note: 'Type of collateral backing the position for secured debt or derivatives under Credit Support Annex (CSA).']
  convexity decimal(8,4) [note: 'Measure of the curvature in the relationship between bond prices and yields.']
  coupon_rate decimal(8,4) [note: 'Annual interest rate paid by the bond issuer, expressed as a percentage.']
  created_timestamp timestamp [note: 'Timestamp when the position record was first created in the Investment Book of Record (IBOR) system.']
  credit_rating varchar [note: 'External credit rating assigned by rating agencies such as Moodys, S&P, or Fitch.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the position denomination.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  duration decimal(8,4) [note: 'Weighted average time to receive cash flows, measuring interest rate sensitivity in years.']
  dv01 decimal(18,6) [note: 'Change in position value for a one basis point change in yield, used for interest rate risk measurement.']
  esg_score decimal(5,2) [note: 'Composite ESG rating score for the issuer or instrument from external provider or internal assessment.']
  face_value decimal(18,2) [note: 'Par value or notional principal amount of the fixed income position.']
  fx_rate decimal(18,8) [note: 'Exchange rate used to convert position currency to base currency.']
  instrument_type varchar [note: 'Specific type of fixed income or credit derivative instrument.']
  internal_credit_rating varchar [note: 'Proprietary credit rating assigned by the pension funds internal credit research team.']
  is_callable boolean [note: 'Indicates whether the issuer has the right to redeem the bond before maturity.']
  is_puttable boolean [note: 'Indicates whether the holder has the right to sell the bond back to the issuer before maturity.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the security.']
  issuer_lei varchar [note: 'ISO 17442 standard 20-character alphanumeric code uniquely identifying the issuer legal entity.']
  issuer_name varchar [note: 'Legal name of the entity that issued the debt instrument.']
  market_value decimal(18,2) [note: 'Current fair value of the position based on latest market pricing, recorded in base currency.']
  maturity_date date [note: 'Date on which the principal amount of the debt instrument becomes due and payable.']
  oas decimal(8,4) [note: 'Spread over the risk-free rate adjusted for embedded options, measured in basis points.']
  position_status varchar [note: 'Current lifecycle status of the credit position.']
  position_type varchar [note: 'Indicates whether the position is a long holding or short exposure.']
  quantity decimal(18,4) [note: 'Number of units or contracts held in the position.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on London Stock Exchange and other UK exchanges.']
  seniority varchar [note: 'Priority ranking of the debt instrument in the issuers capital structure for repayment in case of default.']
  settlement_date date [note: 'Date on which the position was settled and ownership transferred, typically Trade Date Plus Two (T+2).']
  trade_date date [note: 'Date on which the transaction to acquire or dispose of the position was executed.']
  unrealized_gain_loss decimal(18,2) [note: 'Difference between market value and book cost representing unrealized profit or loss.']
  updated_timestamp timestamp [note: 'Timestamp when the position record was last modified in the Investment Book of Record (IBOR) system.']
  valuation_date date [note: 'Date as of which the market value and analytics were calculated.']
  ytm decimal(8,4) [note: 'Total return anticipated on the bond if held until maturity, expressed as an annual percentage rate.']

  Note: 'IBOR-authoritative record of the pension fund\'s current and historical holdings in all credit and fixed income instruments across portfolios. Captures long/short positions, face value, book cost, market value (MTM), accrued interest, settlement date'
}

Table credit.coupon_schedule {
  coupon_schedule_id varchar [pk, note: 'Unique identifier for the coupon schedule record.']
  fixed_income_security_id varchar [note: 'Foreign key reference to the fixed income security master record for which this coupon schedule applies.']
  reference_sofr_rate_id varchar [note: 'Foreign key linking to credit.sofr_rate. Business justification: Coupon schedules reference a reference rate; adding reference_sofr_rate_id links to the specific SOFR rate record, enabling consistent rate lookups.']
  accrual_days varchar [note: 'Number of days in the coupon accrual period calculated according to the day count convention.']
  accrual_end_date date [note: 'Date on which interest stops accruing for this coupon period.']
  accrual_start_date date [note: 'Date from which interest begins accruing for this coupon period.']
  actual_payment_amount decimal(18,4) [note: 'Actual cash amount received for this coupon payment, which may differ from scheduled amount due to adjustments or withholding.']
  actual_payment_date date [note: 'Actual date on which the coupon payment was made, which may differ from scheduled payment date due to holidays or settlement delays.']
  business_day_convention varchar [note: 'Rule applied to adjust payment dates that fall on non-business days to the nearest valid business day.']
  calculation_agent_lei varchar [note: 'Legal Entity Identifier of the institution responsible for calculating floating rate coupons and determining payment amounts.']
  compounding_method varchar [note: 'Method used for compounding interest when reference rates are observed daily or multiple times within a coupon period, such as simple, compounded, or averaged.']
  coupon_amount decimal(18,4) [note: 'Calculated cash payment amount for this coupon period based on coupon rate, notional principal, and day count convention.']
  coupon_cap_rate decimal(12,8) [note: 'Maximum coupon rate that will be paid regardless of how high the reference rate rises, limiting issuer exposure to rate increases.']
  coupon_currency varchar [note: 'Three-letter ISO currency code in which the coupon payment will be made.']
  coupon_floor_rate decimal(12,8) [note: 'Minimum coupon rate that will be paid regardless of how low the reference rate falls, providing downside protection to investors.']
  coupon_rate decimal(12,8) [note: 'Annual interest rate expressed as a decimal for this coupon period, either fixed or calculated from floating reference rate plus spread.']
  coupon_rate_type varchar [note: 'Classification of the coupon rate structure indicating whether the rate is fixed, floating, zero-coupon, or variable.']
  coupon_sequence_number varchar [note: 'Sequential ordering number of this coupon payment within the overall schedule for the security.']
  created_timestamp timestamp [note: 'Timestamp when this coupon schedule record was first created in the system.']
  cusip varchar [note: 'CUSIP identifier for North American securities, used for trade settlement and custody operations.']
  day_count_convention varchar [note: 'Method used to calculate the number of days in the coupon period for interest accrual purposes.']
  ex_dividend_date date [note: 'Date on which the security begins trading without the right to receive the upcoming coupon payment.']
  fixed_reference_rate_value decimal(12,8) [note: 'Actual observed value of the reference rate on the fixing date, used to calculate the floating coupon rate.']
  fixing_date date [note: 'Date on which the reference rate is observed or fixed for floating rate coupon calculation, typically a few days before the period start.']
  is_final_coupon boolean [note: 'Flag indicating whether this is the final coupon payment before the security matures and principal is repaid.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the fixed income security globally.']
  last_modified_timestamp timestamp [note: 'Timestamp when this coupon schedule record was last updated or modified.']
  net_payment_amount decimal(18,4) [note: 'Net cash amount received after deducting withholding taxes and any other adjustments from the gross coupon payment.']
  notional_principal decimal(20,4) [note: 'Face value or principal amount on which the coupon payment is calculated for this period.']
  paying_agent_lei varchar [note: 'Legal Entity Identifier of the financial institution acting as paying agent responsible for distributing coupon payments to bondholders.']
  payment_calendar varchar [note: 'Financial center or holiday calendar used to determine business days for payment date adjustments.']
  payment_date date [note: 'Scheduled date on which the coupon payment will be made to bondholders of record.']
  payment_frequency varchar [note: 'Frequency at which coupon payments are scheduled to be made throughout the life of the security.']
  payment_method varchar [note: 'Mechanism through which the coupon payment is delivered to the bondholder, such as wire transfer, clearing system, or physical check.']
  payment_status varchar [note: 'Current status of this scheduled coupon payment indicating whether it is upcoming, completed, or has encountered issues.']
  record_date date [note: 'Date on which bondholders must be registered as owners to be entitled to receive the coupon payment.']
  reference_rate decimal(18,2) [note: 'Benchmark interest rate index used for floating rate coupons such as SOFR, LIBOR, EURIBOR, or other market reference rates.']
  reference_rate_tenor varchar [note: 'Maturity period of the reference rate used for floating rate calculation, such as 1M, 3M, 6M, or 12M.']
  reset_frequency varchar [note: 'Frequency at which the floating coupon rate is reset based on the reference rate, such as daily, monthly, quarterly, or semi-annually.']
  schedule_effective_timestamp timestamp [note: 'Timestamp when this version of the coupon schedule became effective and valid for use in portfolio valuation and cash flow forecasting.']
  schedule_source_system varchar [note: 'Operational system from which this coupon schedule record was sourced, such as Bloomberg, SimCorp Dimension, or custodian platform.']
  schedule_version_number varchar [note: 'Version number of this coupon schedule record, incremented when schedule terms are amended or recalculated.']
  sedol varchar [note: 'Stock Exchange Daily Official List identifier primarily used for UK and Irish securities.']
  spread_over_reference_rate_bps decimal(10,4) [note: 'Fixed spread in basis points added to the reference rate to determine the total coupon rate for floating rate securities.']
  withholding_tax_amount decimal(18,4) [note: 'Amount of tax withheld from the coupon payment at source by the paying agent or custodian.']
  withholding_tax_rate decimal(8,6) [note: 'Tax rate applied at source to the coupon payment, expressed as a decimal, based on jurisdiction and tax treaty provisions.']

  Note: 'Forward-looking cash-flow schedule for each fixed income security, capturing all scheduled coupon payment dates, coupon amounts, coupon rates (fixed or floating), reference rate (SOFR, LIBOR), spread over reference rate, ex-dividend/record/payment dates'
}

Table credit.coupon_payment {
  coupon_payment_id varchar [pk, note: 'Unique identifier for the coupon payment transaction record.']
  custodian_id varchar [note: 'Identifier of the custodian bank or fund administrator processing the coupon payment.']
  fixed_income_security_id varchar [note: 'Identifier of the fixed income security generating this coupon payment.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio holding the security at time of coupon payment.']
  accrual_days varchar [note: 'Number of days in the accrual period used to calculate the coupon payment per day count convention.']
  accrual_end_date date [note: 'End date of the interest accrual period for this coupon payment.']
  accrual_start_date date [note: 'Start date of the interest accrual period for this coupon payment.']
  accrued_interest_local decimal(18,4) [note: 'Accrued interest amount at settlement in local currency, used for reconciliation and accounting.']
  base_currency_code varchar [note: 'Three-letter ISO currency code of the fund base reporting currency.']
  coupon_amount_base decimal(18,4) [note: 'Gross coupon payment amount converted to the fund base reporting currency.']
  coupon_amount_local decimal(18,4) [note: 'Gross coupon payment amount received in the local currency of the security.']
  coupon_rate decimal(12,8) [note: 'Annual coupon interest rate expressed as a decimal for this payment period.']
  created_timestamp timestamp [note: 'Timestamp when this coupon payment record was first created in the system.']
  cusip varchar [note: 'CUSIP identifier for North American securities generating the coupon payment.']
  data_classification varchar [note: 'Data classification level of this coupon payment record per information security policy.']
  day_count_convention varchar [note: 'Day count convention used to calculate accrued interest for this coupon payment.']
  fx_rate decimal(18,10) [note: 'Foreign exchange rate used to convert local currency coupon payment to base reporting currency.']
  fx_rate_date date [note: 'Date of the FX rate used for currency conversion, typically payment or settlement date.']
  gl_posting_date date [note: 'Date the coupon payment income was posted to the general ledger accounting system.']
  holding_quantity decimal(18,4) [note: 'Quantity of the security held in the portfolio on the record date for this coupon payment.']
  income_classification varchar [note: 'Accounting classification of the coupon payment income for financial reporting purposes.']
  isin varchar [note: 'International Securities Identification Number of the fixed income security generating the coupon.']
  local_currency_code varchar [note: 'Three-letter ISO currency code of the security denomination and coupon payment.']
  modified_timestamp timestamp [note: 'Timestamp when this coupon payment record was last modified in the system.']
  net_coupon_amount_base decimal(18,4) [note: 'Net coupon payment amount after withholding tax converted to base reporting currency.']
  net_coupon_amount_local decimal(18,4) [note: 'Net coupon payment amount after withholding tax deduction in local currency.']
  paying_agent_lei varchar [note: 'Legal Entity Identifier of the paying agent processing the coupon payment.']
  paying_agent_name varchar [note: 'Name of the financial institution acting as paying agent for the coupon payment.']
  payment_date date [note: 'Actual date the coupon cash payment was received in the portfolio account.']
  payment_frequency varchar [note: 'Frequency at which coupon payments are made per the bond indenture terms.']
  payment_reference_number varchar [note: 'External reference number assigned by custodian or paying agent for this coupon payment transaction.']
  payment_status varchar [note: 'Current lifecycle status of the coupon payment transaction.']
  payment_type varchar [note: 'Classification of the coupon payment type within the bond lifecycle.']
  reconciliation_status varchar [note: 'Status of reconciliation between expected and actual coupon payment amounts and dates.']
  record_date date [note: 'Date on which the holder of record must own the security to be entitled to the coupon payment.']
  scheduled_payment_date date [note: 'Contractual date the coupon payment was scheduled per the bond indenture or prospectus.']
  sedol varchar [note: 'SEDOL identifier for UK and Irish securities generating the coupon payment.']
  settlement_date date [note: 'Date the coupon payment cash settled into the portfolio cash account.']
  tax_reclaim_amount_local decimal(18,4) [note: 'Amount of withholding tax eligible for reclaim in local currency under applicable tax treaty.']
  tax_reclaim_eligible_flag boolean [note: 'Indicates whether the withholding tax on this coupon payment is eligible for reclaim under tax treaty.']
  variance_amount_base decimal(18,4) [note: 'Difference between expected and actual coupon payment in base currency, used for reconciliation.']
  withholding_tax_amount_local decimal(18,4) [note: 'Withholding tax deducted at source by the paying agent or issuer jurisdiction in local currency.']
  withholding_tax_rate decimal(8,6) [note: 'Withholding tax rate applied to the coupon payment expressed as a decimal.']

  Note: 'Transactional record of actual coupon cash receipts and accruals for fixed income holdings, capturing payment date, coupon amount received, accrued interest at settlement, withholding tax applied, currency, FX rate used for conversion, and reconciliation'
}

Table credit.duration_convexity {
  duration_convexity_id varchar [pk, note: 'Unique identifier for the duration and convexity measurement record.']
  credit_yield_curve_id varchar [note: 'Foreign key linking to credit.yield_curve. Business justification: Duration and convexity metrics are calculated against a specific yield curve; adding yield_curve_id links the metrics to the curve definition.']
  fixed_income_security_id varchar [note: 'Foreign key reference to the fixed income security being measured.']
  portfolio_id varchar [note: 'Foreign key reference to the portfolio holding the security.']
  benchmark_curve_name varchar [note: 'Name of the benchmark yield curve used for duration and spread calculations.']
  calculation_engine varchar [note: 'Analytics engine or platform that performed the duration and convexity calculations.']
  calculation_error_message varchar [note: 'Error message or diagnostic information if the calculation failed or encountered issues.']
  calculation_method varchar [note: 'Methodology used to calculate duration and convexity metrics.']
  calculation_status varchar [note: 'Status of the duration and convexity calculation process.']
  calculation_timestamp timestamp [note: 'Precise timestamp when the duration and convexity analytics were computed.']
  convexity decimal(18,8) [note: 'Convexity measuring the curvature of the price-yield relationship and the rate of change of duration.']
  created_timestamp timestamp [note: 'Timestamp when this duration and convexity record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the market value and DV01 amounts.']
  data_source_system varchar [note: 'Source system that provided the input data for duration and convexity calculations.']
  dv01 decimal(18,2) [note: 'Dollar value change in the security or portfolio for a one basis point (0.01%) change in yield.']
  effective_date date [note: 'Date from which these duration and convexity metrics are considered effective for risk management and reporting.']
  effective_duration decimal(18,8) [note: 'Effective duration accounting for embedded options and expected cash flow changes, expressed in years.']
  expiry_date date [note: 'Date after which these duration and convexity metrics are no longer valid and should be recalculated.']
  is_active boolean [note: 'Flag indicating whether this is the current active version of the duration and convexity record.']
  is_portfolio_level boolean [note: 'Flag indicating whether this record represents portfolio-level aggregated metrics or security-level metrics.']
  key_rate_duration_10y decimal(18,8) [note: 'Key rate duration for the 10-year point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_1y decimal(18,8) [note: 'Key rate duration for the 1-year point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_2y decimal(18,8) [note: 'Key rate duration for the 2-year point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_30y decimal(18,8) [note: 'Key reach duration for the 30-year point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_3m decimal(18,8) [note: 'Key rate duration for the 3-month point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_5y decimal(18,8) [note: 'Key rate duration for the 5-year point on the yield curve, measuring sensitivity to that specific maturity.']
  key_rate_duration_6m decimal(18,8) [note: 'Key rate duration for the 6-month point on the yield curve, measuring sensitivity to that specific maturity.']
  macaulay_duration decimal(18,8) [note: 'Macaulay duration representing the weighted average time to receive all cash flows, expressed in years.']
  market_value decimal(18,2) [note: 'Market value of the security or portfolio position at the valuation date, in base currency.']
  modified_duration decimal(18,8) [note: 'Modified duration measuring the percentage change in price for a 1% change in yield, expressed in years.']
  oas decimal(12,6) [note: 'Option-adjusted spread over the benchmark curve used for effective duration calculations, expressed in basis points.']
  pv01 decimal(18,2) [note: 'Present value change for a one basis point parallel shift in the yield curve.']
  spread_duration decimal(18,8) [note: 'Spread duration measuring sensitivity to changes in credit spread over the benchmark yield curve.']
  updated_timestamp timestamp [note: 'Timestamp when this duration and convexity record was last modified.']
  valuation_date date [note: 'The business date for which the duration and convexity metrics were calculated.']
  version_number varchar [note: 'Version number for tracking recalculations or adjustments to the same valuation date metrics.']
  yield_curve_source varchar [note: 'Source system or vendor providing the benchmark yield curve used in calculations.']
  ytm decimal(12,6) [note: 'Yield to maturity used as the base yield for duration and convexity calculations, expressed as a decimal percentage.']

  Note: 'Daily interest-rate sensitivity metrics for each fixed income security and portfolio: modified duration, Macaulay duration, effective duration, convexity, DV01 (dollar value of a basis point), PV01, and key rate durations (KRDs) across the yield curve.'
}

Table credit.rating {
  rating_id varchar [pk, note: 'Unique identifier for the credit rating record.']
  credit_issuer_id varchar [note: 'Reference to the issuer entity (corporate, sovereign, or other) being rated.']
  fixed_income_security_id varchar [note: 'Reference to the specific security being rated, if rating is at security level rather than issuer level.']
  action varchar [note: 'Type of rating action taken: new rating assignment, upgrade, downgrade, affirmation, withdrawal, or suspension.']
  active_flag boolean [note: 'Indicates whether this rating is currently active and in effect (true) or has been superseded or withdrawn (false).']
  agency varchar [note: 'Name of the rating agency that issued the rating (Moodys, S&P, Fitch, DBRS) or Internal for proprietary credit assessments.']
  analyst_name varchar [note: 'Name of the lead analyst or credit officer responsible for the rating assignment or review.']
  committee_date date [note: 'Date on which the rating committee met to approve or review the rating decision.']
  created_timestamp timestamp [note: 'Timestamp when this rating record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code indicating the currency context of the rating, if applicable.']
  default_probability decimal(10,6) [note: 'Estimated probability of default associated with this rating grade, expressed as a decimal (e.g., 0.001 for 0.1%).']
  effective_date date [note: 'Date on which this rating became effective and was published by the rating agency.']
  esg_score decimal(5,2) [note: 'ESG score or rating component provided by the rating agency or internal assessment, if available.']
  internal_override_flag boolean [note: 'Indicates whether the internal credit assessment team has applied an override or adjustment to the external agency rating.']
  internal_override_rationale varchar [note: 'Explanation for any internal override or adjustment applied to the external rating.']
  jurisdiction varchar [note: 'Three-letter ISO country code representing the jurisdiction or domicile relevant to the rating.']
  methodology varchar [note: 'Name or reference to the rating methodology framework applied by the agency for this rating.']
  next_review_date date [note: 'Scheduled date for the next periodic review or surveillance of the rating.']
  notch varchar [note: 'Numeric representation of the rating for quantitative analysis, where higher numbers represent better credit quality.']
  outlook varchar [note: 'Forward-looking opinion on the potential direction of the rating over the medium term.']
  previous_rating_value decimal(18,2) [note: 'The rating grade that was in effect immediately prior to this rating action, for tracking rating transitions.']
  public_flag boolean [note: 'Indicates whether the rating is publicly disclosed or is a private rating for internal use only.']
  rating_category varchar [note: 'Broad classification of the rating: Investment Grade (BBB-/Baa3 and above), High Yield (below BBB-/Baa3), Non-Rated, or Default.']
  rating_type varchar [note: 'Type of rating indicating what is being rated: issuer-level credit quality, specific issue, or debt seniority class.']
  rationale varchar [note: 'Summary of the key factors and reasoning behind the rating assignment or rating action.']
  recovery_rate decimal(5,2) [note: 'Expected recovery rate in the event of default, expressed as a percentage (e.g., 40.00 for 40%).']
  regulatory_capital_treatment varchar [note: 'Regulatory capital classification or risk weight associated with this rating under applicable banking regulations.']
  report_url varchar [note: 'URL or document reference to the full rating report or press release published by the rating agency.']
  scale varchar [note: 'Scale on which the rating is expressed: long-term, short-term, national scale, or global scale.']
  sector varchar [note: 'Economic sector or industry classification of the rated issuer (e.g., Financial, Industrial, Sovereign, Municipal).']
  seniority varchar [note: 'Seniority level of the rated debt instrument in the capital structure (e.g., Senior Secured, Senior Unsecured, Subordinated).']
  solicited_flag boolean [note: 'Indicates whether the rating was requested by the issuer (solicited) or assigned without issuer request (unsolicited).']
  source_identifier varchar [note: 'Unique identifier or reference code for this rating in the source system.']
  updated_timestamp timestamp [note: 'Timestamp when this rating record was last updated in the system.']
  value varchar [note: 'The actual rating grade assigned (e.g., AAA, Aa1, BBB+, B-, CCC, D). Format varies by agency.']
  version_number varchar [note: 'Version number for tracking rating history and changes over time for the same issuer or security.']
  watch_status varchar [note: 'Indicates whether the rating is under review for potential upgrade, downgrade, or not on watch.']
  withdrawal_date date [note: 'Date on which the rating was withdrawn by the rating agency, if applicable.']
  withdrawal_reason varchar [note: 'Explanation for why the rating was withdrawn (e.g., debt matured, issuer request, lack of information).']

  Note: 'SSOT for credit ratings and their full history for fixed income issuers and individual securities, from rating agencies (Moody\'s, S&P, Fitch) and internal credit assessment.'
}

Table credit.rating_action {
  rating_action_id varchar [pk, note: 'Unique identifier for the rating action event record.']
  credit_issuer_id varchar [note: 'Reference to the issuer entity subject to the rating action.']
  employee_id varchar [note: 'Reference to the internal credit analyst who reviewed the rating action for portfolio impact.']
  fixed_income_security_id varchar [note: 'Reference to the specific security instrument rated, if action is security-level rather than issuer-level.']
  action_source_system varchar [note: 'Name of the source system or data feed from which the rating action was ingested.']
  action_trigger_event varchar [note: 'Description of the key event or development that triggered the rating action.']
  action_type varchar [note: 'Type of rating action taken: upgrade, downgrade, affirmed, watch placement, or outlook revision. [ENUM-REF-CANDIDATE: upgrade|downgrade|affirmed|watch_positive|watch_negative|outlook_positive|outlook_negative|outlook_stable — 8 candidates stripped']
  analyst_name varchar [note: 'Name of the lead analyst at the rating agency responsible for the rating action.']
  announcement_timestamp timestamp [note: 'Precise timestamp when the rating action was publicly announced by the agency.']
  committee_approval_date date [note: 'Date on which the rating agencys rating committee formally approved the action.']
  credit_spread_impact_bps varchar [note: 'Estimated impact of the rating action on the credit spread, measured in basis points.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the rated instrument, if applicable to issue-level ratings.']
  default_probability_estimate decimal(10,6) [note: 'Estimated probability of default associated with the new rating, expressed as a decimal fraction.']
  effective_date date [note: 'Date on which the rating action became effective and was published by the rating agency.']
  geographic_region varchar [note: 'Primary geographic region or country of the issuer subject to the rating action.']
  internal_review_date date [note: 'Date on which the internal credit team completed their review of the rating action.']
  internal_review_status varchar [note: 'Status of the pension funds internal credit team review of the rating action.']
  investment_policy_breach_flag boolean [note: 'Indicates whether the new rating causes a breach of the funds investment policy constraints.']
  new_outlook varchar [note: 'The outlook designation assigned as a result of this action, indicating the likely direction of future rating changes.']
  new_rating varchar [note: 'The credit rating assigned as a result of this action, using agency-specific rating scale notation.']
  notch_change varchar [note: 'Number of rating notches changed in this action; positive for upgrades, negative for downgrades, zero for affirmations.']
  portfolio_impact_flag boolean [note: 'Indicates whether this rating action materially impacts the pension funds investment portfolio holdings.']
  prior_outlook varchar [note: 'The outlook designation assigned before this action, indicating the likely direction of future rating changes.']
  prior_rating varchar [note: 'The credit rating assigned immediately before this action, using agency-specific rating scale notation.']
  rating_agency_code varchar [note: 'Reference to the credit rating agency that issued the rating action.']
  rating_category varchar [note: 'Broad classification of the new rating as investment grade, high yield, non-rated, or default status.']
  rating_scale varchar [note: 'The rating scale used by the agency for this action, distinguishing issuer vs. issue, long-term vs. short-term, and sovereign ratings.']
  rating_type varchar [note: 'Classification of the rating by debt seniority or instrument type.']
  rationale_summary varchar [note: 'Brief summary of the key factors and rationale provided by the rating agency for the action.']
  record_created_timestamp timestamp [note: 'Timestamp when this rating action record was first created in the pension funds data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this rating action record was last updated in the pension funds data platform.']
  recovery_rate_estimate decimal(5,2) [note: 'Estimated recovery rate in the event of default, expressed as a percentage.']
  report_url varchar [note: 'Web link to the full rating report or press release published by the rating agency.']
  sector_classification varchar [note: 'Industry or sector classification of the issuer as categorized by the rating agency.']
  solicited_flag boolean [note: 'Indicates whether the rating was solicited by the issuer or unsolicited by the agency.']
  watch_status varchar [note: 'Indicates whether the rating has been placed on a watch list for potential near-term change.']

  Note: 'Transactional event record capturing each rating change, watch placement, or outlook revision for a rated issuer or security. Records the effective date, prior rating, new rating, rating agency, action type (upgrade, downgrade, CreditWatch'
}

Table credit.cds_position {
  cds_position_id varchar [pk, note: 'Unique identifier for the credit default swap position record.']
  counterparty_id varchar [note: 'Identifier of the counterparty to the CDS contract (protection seller if bought, protection buyer if sold).']
  credit_issuer_id varchar [note: 'Identifier of the underlying reference entity (corporate or sovereign) on which credit protection is written.']
  fixed_income_security_id varchar [note: 'Identifier of the specific debt instrument serving as the reference obligation for credit event determination.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio holding this CDS position.']
  reference_entity_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Reference entity is the underlying issuer; required for CDS pricing, risk analytics, and event monitoring.']
  reference_entity_credit_issuer_id varchar [note: 'Identifier of the underlying reference entity (corporate or sovereign) on which credit protection is written.']
  accrued_premium decimal(20,2) [note: 'Premium accrued since last payment date but not yet paid, calculated on a pro-rata basis.']
  ccp_name varchar [note: 'Name of the central counterparty clearing house if the CDS is centrally cleared.']
  clearing_status varchar [note: 'Indicates whether the CDS is centrally cleared through a CCP or remains bilateral OTC.']
  collateral_currency varchar [note: 'Three-letter ISO currency code for collateral posted and received.']
  collateral_posted decimal(20,2) [note: 'Amount of collateral posted by the pension fund to the counterparty or CCP under CSA or margin agreement.']
  collateral_received decimal(20,2) [note: 'Amount of collateral received by the pension fund from the counterparty or CCP under CSA or margin agreement.']
  contract_identifier varchar [note: 'External business identifier or trade reference number for the CDS contract.']
  counterparty_lei varchar [note: 'Legal Entity Identifier of the CDS counterparty.']
  created_timestamp timestamp [note: 'Timestamp when this CDS position record was first created in the system.']
  credit_event_date date [note: 'Date on which a credit event was determined to have occurred for the reference entity.']
  credit_event_flag boolean [note: 'Indicates whether a credit event (bankruptcy, failure to pay, restructuring) has occurred on the reference entity.']
  cusip varchar [note: 'CUSIP identifier for the CDS contract if applicable in North American markets.']
  dv01 decimal(15,4) [note: 'Change in CDS position value for a one basis point parallel shift in credit spread, measuring spread duration risk.']
  effective_date date [note: 'Date from which credit protection coverage begins under the CDS contract.']
  index_flag boolean [note: 'Indicates whether this is a single-name CDS or part of a CDS index (e.g., CDX, iTraxx).']
  index_name varchar [note: 'Name of the CDS index if this position is part of an index (e.g., CDX.NA.IG, iTraxx Europe).']
  index_series varchar [note: 'Series number of the CDS index if applicable.']
  index_version varchar [note: 'Version number of the CDS index if applicable.']
  isin varchar [note: 'International Securities Identification Number for the CDS contract if exchange-traded or centrally cleared.']
  market_spread_bps decimal(10,4) [note: 'Current market credit spread for the reference entity at the CDS tenor, expressed in basis points.']
  market_value decimal(20,2) [note: 'Current mark-to-market value of the CDS position in base currency.']
  market_value_currency varchar [note: 'Three-letter ISO currency code for the market value.']
  maturity_date date [note: 'Scheduled termination date of the CDS contract when protection coverage ends.']
  notional_amount decimal(20,2) [note: 'Face value or notional principal amount of credit protection bought or sold under the CDS contract.']
  notional_currency varchar [note: 'Three-letter ISO currency code for the notional amount.']
  position_status varchar [note: 'Current lifecycle status of the CDS position.']
  protection_direction varchar [note: 'Indicates whether the pension fund bought protection (long credit risk hedge) or sold protection (short credit risk exposure).']
  recovery_rate_assumption decimal(5,4) [note: 'Assumed recovery rate on reference obligation in event of default, expressed as decimal (e.g., 0.40 for 40 percent).']
  reference_entity_lei varchar [note: 'Legal Entity Identifier of the reference entity on which credit protection is written.']
  restructuring_clause varchar [note: 'Type of restructuring credit event covered: CR (cumulative restructuring), MR (modified restructuring), MM (modified-modified restructuring), XR (old restructuring), or none.']
  running_spread_bps decimal(10,4) [note: 'Annual premium or coupon rate paid by the protection buyer expressed in basis points of the notional amount.']
  seniority varchar [note: 'Seniority level of the reference obligation in the capital structure.']
  settlement_method varchar [note: 'Method by which the CDS contract will settle upon credit event: physical delivery, cash settlement, or auction.']
  tenor_years decimal(5,2) [note: 'Original term of the CDS contract expressed in years from effective date to maturity.']
  termination_date date [note: 'Actual date the CDS position was terminated, novated, or assigned prior to scheduled maturity.']
  trade_date date [note: 'Date on which the CDS contract was executed and agreed between counterparties.']
  updated_timestamp timestamp [note: 'Timestamp when this CDS position record was last modified.']
  upfront_payment_amount decimal(20,2) [note: 'One-time upfront payment made at inception to compensate for difference between running spread and market spread.']
  upfront_payment_currency varchar [note: 'Three-letter ISO currency code for the upfront payment.']
  upfront_payment_direction varchar [note: 'Indicates whether the pension fund paid or received the upfront payment.']

  Note: 'Master and position record for credit default swap (CDS) contracts held by the pension fund, capturing reference entity, reference obligation, CDS tenor, notional amount, protection bought/sold flag, CDS spread (running coupon in bps), upfront payment'
}

Table credit.cds_market_data {
  cds_market_data_id varchar [pk, note: 'Unique identifier for the CDS market data record.']
  credit_issuer_id varchar [note: 'Foreign key linking to credit.credit_issuer. Business justification: CDS market data references the issuer; linking to credit_issuer enables issuer-based analytics and regulatory reporting.']
  reference_entity_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Market data for reference entity is used in analytics, valuation, and regulatory reporting.']
  reference_entity_credit_issuer_id varchar [note: 'Identifier for the reference entity (corporate, sovereign, or index) underlying the CDS contract.']
  ask_spread_bps decimal(10,4) [note: 'Ask-side CDS spread in basis points, representing the spread at which market makers are willing to sell protection.']
  bid_ask_spread_bps decimal(10,4) [note: 'Difference between ask and bid spreads in basis points, indicating market liquidity and transaction cost.']
  bid_spread_bps decimal(10,4) [note: 'Bid-side CDS spread in basis points, representing the spread at which market makers are willing to buy protection.']
  cds_index_series varchar [note: 'Series identifier for CDS indices (e.g., CDX.NA.IG.39, iTraxx Europe S36). Null for single-name CDS.']
  cds_index_version varchar [note: 'Version number of the CDS index series. Null for single-name CDS.']
  coupon_rate_bps decimal(10,4) [note: 'Standard fixed coupon rate in basis points for the CDS contract (typically 100 bps or 500 bps for standard contracts).']
  credit_rating_fitch varchar [note: 'Current Fitch credit rating for the reference entity (e.g., AAA, AA+, BBB-, CCC).']
  credit_rating_moody varchar [note: 'Current Moody\'s credit rating for the reference entity (e.g., Aaa, Aa1, Baa3, Caa1).']
  credit_rating_sp varchar [note: 'Current S&P credit rating for the reference entity (e.g., AAA, AA+, BBB-, CCC).']
  cs01 decimal(18,6) [note: 'Dollar value change in CDS contract for a 1 basis point change in credit spread, measuring credit risk sensitivity.']
  currency_code varchar [note: 'Three-letter ISO currency code in which the CDS contract is denominated (e.g., USD, EUR, GBP).']
  data_quality_flag boolean [note: 'Indicator of data quality and reliability for the CDS market observation.']
  data_source varchar [note: 'Source system or vendor providing the CDS market data (e.g., Bloomberg, Markit, ICE, Tradeweb).']
  dv01 decimal(18,6) [note: 'Dollar value change in CDS contract for a 1 basis point change in spread, measuring interest rate sensitivity.']
  implied_probability_of_default decimal(8,6) [note: 'Market-implied cumulative probability of default over the CDS tenor, derived from the CDS spread.']
  is_active boolean [note: 'Indicates whether the CDS contract or reference entity is currently active and trading in the market.']
  liquidity_score decimal(5,2) [note: 'Quantitative score (0-100) representing the liquidity and trading activity of the CDS contract.']
  mid_spread_bps decimal(10,4) [note: 'Mid-market CDS spread in basis points, calculated as the average of bid and ask spreads.']
  pricing_date date [note: 'Business date for which the CDS market data is observed and recorded.']
  pricing_timestamp timestamp [note: 'Precise timestamp when the CDS market data was captured, including time zone.']
  rating_outlook varchar [note: 'Consensus or primary rating agency outlook for the reference entity credit rating.']
  record_created_timestamp timestamp [note: 'Timestamp when this CDS market data record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this CDS market data record was last updated in the system.']
  recovery_rate_assumption decimal(5,4) [note: 'Assumed recovery rate (as decimal) used in CDS pricing and implied default probability calculation, typically 0.40 for senior unsecured debt.']
  reference_entity_name varchar [note: 'Full legal name of the reference entity or index (e.g., corporate issuer, sovereign nation, CDX.NA.IG, iTraxx Europe).']
  reference_entity_ticker varchar [note: 'Market ticker or short code for the reference entity or CDS index.']
  reference_entity_type varchar [note: 'Classification of the reference entity underlying the CDS.']
  region varchar [note: 'Geographic region of the reference entity or index composition.']
  restructuring_clause varchar [note: 'Type of restructuring credit event covered by the CDS contract (No R, Mod R, Mod Mod R, Full R).']
  sector varchar [note: 'Industry sector classification of the reference entity (e.g., Financials, Energy, Technology, Sovereign).']
  seniority varchar [note: 'Seniority level of the reference obligation in the capital structure.']
  spread_bps decimal(10,4) [note: 'CDS spread quoted in basis points, representing the annual premium paid by the protection buyer.']
  tenor varchar [note: 'Maturity tenor of the CDS contract (1-year, 3-year, 5-year, 7-year, 10-year).']
  upfront_points decimal(10,6) [note: 'Upfront payment expressed as percentage points of notional, paid at inception for off-market CDS contracts.']

  Note: 'Time-series of CDS market data for reference entities and indices (CDX, iTraxx), capturing CDS spread by tenor (1Y, 3Y, 5Y, 7Y, 10Y), upfront points, implied probability of default (PD), recovery rate assumption, and pricing date.'
}

Table credit.private_credit_investment {
  private_credit_investment_id varchar [pk, note: 'Unique identifier for the private credit investment record.']
  deal_opportunity_id varchar [note: 'Reference to the originating deal or opportunity that led to this private credit investment.']
  employee_id varchar [note: 'Reference to the internal investment manager or portfolio manager responsible for the private credit investment.']
  gp_profile_id varchar [note: 'Reference to the internal investment manager or portfolio manager responsible for the private credit investment.']
  investment_manager_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Investment manager entity is needed for performance attribution, compliance, and stakeholder reporting.']
  opportunity_id varchar [note: 'Reference to the originating deal or opportunity that led to this private credit investment.']
  borrower_legal_name varchar [note: 'Full legal name of the borrowing entity or obligor under the credit agreement.']
  borrower_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the borrower, enabling global counterparty identification.']
  collateral_type varchar [note: 'Description of assets or security pledged as collateral for the private credit investment.']
  commitment_date date [note: 'Date when the pension fund formally committed capital to the private credit investment.']
  committed_amount decimal(18,2) [note: 'Total capital amount committed by the pension fund to the private credit investment.']
  convexity decimal(10,4) [note: 'Convexity measure capturing the curvature of the price-yield relationship for the private credit investment.']
  coupon_rate decimal(8,5) [note: 'Annual interest rate expressed as a decimal for fixed-rate private credit investments.']
  covenant_package varchar [note: 'Classification of financial and operational covenants embedded in the credit agreement.']
  created_timestamp timestamp [note: 'System timestamp when the private credit investment record was first created in the data platform.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the private credit investment is denominated.']
  default_probability decimal(5,4) [note: 'Estimated probability of default over a one-year horizon expressed as a decimal.']
  dv01 decimal(18,2) [note: 'Dollar value change in the investment for a one basis point parallel shift in interest rates.']
  effective_duration decimal(8,4) [note: 'Effective duration accounting for embedded options and prepayment risk in the private credit investment.']
  esg_score decimal(5,2) [note: 'Composite ESG score for the borrower or investment, reflecting responsible investment integration.']
  expected_credit_loss decimal(18,2) [note: 'Expected credit loss provision calculated under IFRS 9 for the private credit investment.']
  external_credit_rating varchar [note: 'Credit rating assigned by external rating agencies such as Moodys, S&P, or Fitch if applicable.']
  fair_value decimal(18,2) [note: 'Current fair value of the private credit investment as determined by the valuation team for Net Asset Value (NAV) calculation.']
  first_funding_date date [note: 'Date of the initial capital drawdown or funding event for the private credit investment.']
  floating_rate_index varchar [note: 'Reference rate index for floating-rate private credit investments, such as Secured Overnight Financing Rate (SOFR). [ENUM-REF-CANDIDATE: SOFR|LIBOR|EURIBOR|SONIA|CDOR|BBSY|none — 7 candidates stripped; promote to reference product]']
  funded_amount decimal(18,2) [note: 'Cumulative capital amount drawn down and funded to date on the private credit investment.']
  geographic_region varchar [note: 'Primary geographic region or country where the borrower operates or where credit risk is concentrated.']
  industry_sector varchar [note: 'Primary industry sector or GICS classification of the borrower for portfolio diversification analysis.']
  internal_credit_rating varchar [note: 'Proprietary credit rating assigned by the pension funds internal credit risk team.']
  investment_name varchar [note: 'Business name or title of the private credit investment for identification and reporting purposes.']
  investment_status varchar [note: 'Current lifecycle status of the private credit investment from origination through exit. [ENUM-REF-CANDIDATE: pipeline|committed|funded|performing|non_performing|restructured|defaulted|repaid|written_off — 9 candidates stripped; promote to reference']
  investment_type varchar [note: 'Classification of the private credit investment structure and seniority in the capital stack. [ENUM-REF-CANDIDATE: senior_secured_loan|mezzanine_debt|unitranche|distressed_debt|infrastructure_debt|subordinated_debt|bridge_loan|revolving_credit — 8']
  lead_arranger varchar [note: 'Name of the lead arranger or bookrunner for syndicated private credit investments.']
  loan_to_value_ratio decimal(5,4) [note: 'Ratio of the loan amount to the appraised value of the underlying collateral, expressed as a decimal.']
  loss_given_default decimal(5,4) [note: 'Estimated loss severity as a percentage of exposure at default, expressed as a decimal.']
  maturity_date date [note: 'Scheduled final maturity or repayment date of the private credit investment per the credit agreement.']
  modified_duration decimal(8,4) [note: 'Modified duration of the private credit investment, measuring interest rate sensitivity.']
  oas decimal(8,5) [note: 'Option-adjusted spread in decimal form, measuring the credit spread adjusted for embedded optionality.']
  origination_date date [note: 'Date when the private credit investment was originated or the credit agreement was executed.']
  outstanding_principal decimal(18,2) [note: 'Current outstanding principal balance of the private credit investment as of the valuation date.']
  payment_frequency varchar [note: 'Frequency of interest and principal payment schedules per the credit agreement terms.']
  pik_toggle_flag boolean [note: 'Indicates whether the borrower has the option to pay interest in kind rather than cash.']
  prepayment_penalty_flag boolean [note: 'Indicates whether the credit agreement includes prepayment penalties or call protection provisions.']
  seniority varchar [note: 'Position of the private credit investment in the borrowers capital structure and priority of claims.']
  spread_bps varchar [note: 'Credit spread over the floating rate index expressed in basis points for floating-rate investments.']
  syndication_flag boolean [note: 'Indicates whether the private credit investment is part of a syndicated loan with multiple lenders.']
  updated_timestamp timestamp [note: 'System timestamp when the private credit investment record was last modified.']
  valuation_date date [note: 'As-of date for the most recent fair value assessment of the private credit investment.']
  ytm decimal(8,5) [note: 'Annualized yield to maturity of the private credit investment expressed as a decimal.']

  Note: 'Master record for direct private credit investments including senior secured loans, mezzanine debt, unitranche facilities, distressed debt, and infrastructure debt originated or acquired by the pension fund.'
}

Table credit.private_credit_drawdown {
  private_credit_drawdown_id varchar [pk, note: 'Unique identifier for the private credit drawdown transaction.']
  actor_id varchar [note: 'Reference to the pension fund legal entity or investment vehicle acting as lender.']
  blotter_id varchar [note: 'Foreign key linking to trade.blotter. Business justification: Associate drawdown with the trade that funded it for audit and reconciliation.']
  booking_entity_actor_id varchar [note: 'Reference to the legal entity or fund vehicle in whose books this drawdown is recorded.']
  borrower_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Borrower entity is a corporate counterparty; required for covenant monitoring, credit risk assessment, and regulatory reporting.']
  cash_account_id varchar [note: 'Reference to the treasury or cash management account from which the drawdown was funded.']
  counterparty_id varchar [note: 'Reference to the legal entity or counterparty that is the borrower under the credit facility.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this drawdown is allocated.']
  private_credit_facility_id varchar [note: 'Reference to the parent private credit facility from which capital is being drawn.']
  private_credit_investment_id varchar [note: 'Reference to the parent private credit facility from which capital is being drawn.']
  approval_authority varchar [note: 'The governance body or individual who approved the drawdown, such as Investment Committee, CIO, or delegated authority.']
  approval_date date [note: 'The date on which the drawdown was formally approved by the designated authority.']
  asset_class varchar [note: 'The asset class classification of this private credit drawdown for portfolio reporting and strategic asset allocation purposes.']
  available_commitment decimal(18,2) [note: 'Remaining undrawn commitment available on the facility after this drawdown.']
  base_rate_type varchar [note: 'The reference rate index used as the base for interest calculation, such as SOFR, LIBOR, EURIBOR, or Prime.']
  collateral_pledged boolean [note: 'Indicates whether collateral was pledged or updated as part of this drawdown transaction.']
  collateral_value decimal(18,2) [note: 'Fair market value of collateral pledged or securing this drawdown at the time of execution.']
  commitment_fee_waived boolean [note: 'Indicates whether the commitment fee on the undrawn portion was waived for this drawdown period.']
  covenant_compliance_status varchar [note: 'Status of borrower compliance with financial and operational covenants at the time of drawdown.']
  created_timestamp timestamp [note: 'The timestamp when this drawdown record was first created in the system.']
  credit_rating varchar [note: 'Internal or external credit rating assigned to the borrower or facility at the time of drawdown.']
  cumulative_drawn_balance decimal(18,2) [note: 'Total outstanding drawn balance on the facility after this drawdown, including all prior drawdowns less repayments.']
  drawdown_amount decimal(18,2) [note: 'The principal amount drawn down from the facility in this transaction.']
  drawdown_currency varchar [note: 'Three-letter ISO 4217 currency code for the drawdown amount.']
  drawdown_date date [note: 'The date on which the capital drawdown was executed and funds were disbursed.']
  drawdown_number varchar [note: 'Business identifier for the drawdown event, typically sequential within the facility.']
  drawdown_purpose varchar [note: 'Business purpose or use of proceeds for this drawdown, such as acquisition financing, working capital, refinancing, or capital expenditure.']
  drawdown_status varchar [note: 'Current lifecycle status of the drawdown transaction.']
  esg_classification varchar [note: 'ESG classification of the credit facility under SFDR or internal responsible investment framework.']
  funding_source varchar [note: 'The internal or external source of capital used to fund this drawdown, such as fund name, treasury account, or co-investment vehicle.']
  geographic_region varchar [note: 'The primary geographic region or country of the borrower or underlying asset exposure.']
  industry_sector varchar [note: 'The industry sector classification of the borrower or underlying business, using GICS or internal taxonomy.']
  interest_payment_frequency varchar [note: 'Frequency at which interest payments are due on the drawn amount.']
  interest_rate_at_drawdown decimal(8,5) [note: 'The applicable interest rate (expressed as a decimal) in effect at the time of drawdown, including base rate plus spread.']
  investment_strategy varchar [note: 'The investment strategy or sub-strategy under which this drawdown is classified, such as senior secured, unitranche, or opportunistic credit.']
  last_modified_by varchar [note: 'User or system identifier of the person or process that last modified this drawdown record.']
  last_modified_timestamp timestamp [note: 'The timestamp when this drawdown record was last updated.']
  loan_to_value_ratio decimal(8,5) [note: 'The ratio of cumulative drawn balance to collateral value, expressed as a decimal.']
  maturity_date date [note: 'The date on which the drawn principal amount is due for repayment.']
  notes varchar [note: 'Free-text notes or comments regarding the drawdown transaction, including special conditions or operational remarks.']
  prepayment_allowed boolean [note: 'Indicates whether the borrower is permitted to prepay this drawdown without penalty.']
  prepayment_penalty_rate decimal(8,5) [note: 'The penalty rate (as a decimal) applied if the borrower prepays the drawdown before the scheduled maturity.']
  settlement_date date [note: 'The date on which cash settlement and fund transfer occurred for the drawdown.']
  settlement_status varchar [note: 'Status of the cash settlement process for the drawdown transaction.']
  spread_bps varchar [note: 'Credit spread over the base rate expressed in basis points applicable to this drawdown.']
  created_by varchar [note: 'User or system identifier of the person or process that created this drawdown record.']

  Note: 'Transactional record of capital drawdown events on private credit facilities, capturing drawdown date, drawdown amount, cumulative drawn balance, purpose of drawdown, applicable interest rate at drawdown, and funding source.'
}

Table credit.private_credit_repayment {
  private_credit_repayment_id varchar [pk, note: 'Unique identifier for the private credit repayment transaction. Primary key for this entity.']
  amortization_schedule_id varchar [note: 'Reference to the amortization schedule entry that this repayment corresponds to, if applicable.']
  blotter_id varchar [note: 'Foreign key linking to trade.blotter. Business justification: Link repayment to the trade that executed it for settlement tracking.']
  counterparty_id varchar [note: 'Reference to the borrower entity making the repayment, linking to the counterparty master data.']
  custody_account_id varchar [note: 'Reference to the custodian account into which the repayment was received.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this private credit investment and repayment belong.']
  private_counterparty_id varchar [note: 'Reference to the borrower entity making the repayment, linking to the counterparty master data.']
  private_credit_investment_id varchar [note: 'Reference to the underlying private credit investment for which this repayment applies.']
  private_servicer_entity_counterparty_id varchar [note: 'Reference to the loan servicer entity responsible for processing and administering this repayment.']
  servicer_entity_counterparty_id varchar [note: 'Reference to the loan servicer entity responsible for processing and administering this repayment.']
  accounting_treatment varchar [note: 'Description of the accounting treatment applied to this repayment transaction per IFRS or local GAAP standards.']
  accrued_interest_end_date date [note: 'End date of the interest accrual period covered by this repayment.']
  accrued_interest_start_date date [note: 'Start date of the interest accrual period covered by this repayment.']
  created_timestamp timestamp [note: 'Timestamp when this repayment record was first created in the data platform.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the repayment was made.']
  day_count_convention varchar [note: 'Day count convention used to calculate the interest amount for this repayment such as Actual/360, Actual/365, 30/360, or Actual/Actual.']
  days_accrued varchar [note: 'Number of days in the interest accrual period for which interest was calculated and repaid.']
  gl_posting_date date [note: 'The date on which this repayment transaction was posted to the general ledger for accounting purposes.']
  interest_amount_repaid decimal(18,2) [note: 'The interest amount repaid in this transaction, representing accrued interest paid by the borrower.']
  interest_rate_applied decimal(10,6) [note: 'The interest rate applied to calculate the interest component of this repayment, expressed as a decimal.']
  is_early_repayment boolean [note: 'Boolean flag indicating whether this repayment occurred before the scheduled maturity or payment date.']
  is_partial_repayment boolean [note: 'Boolean flag indicating whether this is a partial repayment of the outstanding principal rather than full repayment.']
  last_modified_timestamp timestamp [note: 'Timestamp when this repayment record was last modified or updated in the data platform.']
  notes varchar [note: 'Free-text notes or comments regarding this repayment transaction, including any special circumstances or exceptions.']
  outstanding_principal_balance decimal(18,2) [note: 'Remaining outstanding principal balance of the private credit investment after this repayment has been applied.']
  payment_method varchar [note: 'Method by which the repayment was received from the borrower such as wire transfer, ACH, check, direct debit, or automated clearing.']
  payment_reference varchar [note: 'Bank or payment system reference number associated with the repayment transaction for reconciliation purposes.']
  prepayment_premium decimal(18,2) [note: 'Additional fee or premium charged to the borrower for early repayment of principal before the scheduled maturity date.']
  principal_amount_repaid decimal(18,2) [note: 'The principal amount repaid in this transaction, representing the reduction in outstanding loan balance.']
  reconciliation_date date [note: 'The date on which this repayment transaction was reconciled and confirmed against bank statements and accounting records.']
  reconciliation_status varchar [note: 'Status of the reconciliation process for this repayment indicating whether it has been matched to expected cash flows and accounting entries.']
  repayment_date date [note: 'The date on which the repayment was received or is scheduled to be received from the borrower.']
  repayment_reference_number varchar [note: 'External reference number or identifier assigned to this repayment transaction by the borrower or servicer.']
  repayment_sequence_number varchar [note: 'Sequential number of this repayment within the series of repayments for the private credit investment.']
  repayment_status varchar [note: 'Current lifecycle status of the repayment transaction indicating whether it is pending settlement, settled, failed, reversed, cancelled, or reconciled.']
  repayment_type varchar [note: 'Classification of the repayment indicating whether it is a scheduled principal payment, scheduled interest payment, prepayment, partial prepayment, full prepayment, or amortization payment.']
  scheduled_repayment_amount decimal(18,2) [note: 'The originally scheduled repayment amount per the loan agreement or amortization schedule.']
  settlement_date date [note: 'The date on which the repayment transaction was settled and cash was received into the fund account.']
  source_system_record_code varchar [note: 'Unique identifier of this repayment record in the source system for traceability and reconciliation purposes.']
  total_repayment_amount decimal(18,2) [note: 'Total amount repaid in this transaction including principal, interest, prepayment premium, and any other fees.']
  variance_amount decimal(18,2) [note: 'Difference between the scheduled repayment amount and the actual repayment amount received, indicating over or underpayment.']

  Note: 'Transactional record of principal repayments, amortization payments, and prepayments on private credit investments, capturing repayment date, principal amount repaid, prepayment premium (if any), remaining outstanding balance, and repayment type'
}

Table credit.covenant_monitoring {
  covenant_monitoring_id varchar [pk, note: 'Unique identifier for the covenant monitoring record.']
  investment_id varchar [note: 'Reference to the private credit investment subject to covenant monitoring.']
  actual_value decimal(18,4) [note: 'Actual measured value of the covenant metric as reported by the borrower or calculated from financial statements.']
  borrower_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the borrower entity subject to covenant compliance.']
  borrower_name varchar [note: 'Legal name of the borrower entity whose financial covenants are being monitored.']
  breach_date date [note: 'Date on which the covenant breach was identified or became effective, if applicable.']
  breach_flag boolean [note: 'Boolean indicator of whether the covenant is currently in breach (True) or compliant (False).']
  breach_severity varchar [note: 'Severity classification of the covenant breach based on magnitude of deviation and potential impact on credit quality.']
  comments varchar [note: 'Free-text comments or notes from the credit analyst or portfolio manager regarding covenant monitoring and compliance.']
  compliance_status varchar [note: 'Current compliance status of the covenant: compliant, breach, waived by lender, cured after breach, or under review.']
  covenant_category varchar [note: 'Broad category of covenant: affirmative (actions required), negative (restrictions), financial (ratio/threshold), or reporting (disclosure obligations).']
  covenant_description varchar [note: 'Detailed textual description of the covenant terms and conditions as specified in the credit agreement.']
  covenant_type varchar [note: 'Type of financial covenant being monitored: leverage ratio, interest coverage ratio, Loan to Value (LTV), Debt Service Coverage Ratio (DSCR), minimum liquidity, or net worth.']
  created_timestamp timestamp [note: 'Timestamp when the covenant monitoring record was first created in the system.']
  cure_date date [note: 'Date on which a previously breached covenant was cured and returned to compliance.']
  cure_mechanism varchar [note: 'Description of the mechanism or actions taken to cure the covenant breach (e.g., equity injection, asset sale, debt repayment).']
  cushion_amount decimal(18,4) [note: 'Absolute difference between the actual value and threshold value, representing the margin of safety or breach magnitude.']
  cushion_percentage decimal(5,2) [note: 'Percentage difference between actual value and threshold, expressed as a percentage of the threshold value.']
  data_source varchar [note: 'Source of the covenant measurement data: borrower compliance certificate, audited financial statements, management accounts, or third-party valuation.']
  lender_action varchar [note: 'Actions taken or contemplated by the lender in response to covenant breach (e.g., waiver negotiation, default notice, acceleration).']
  measurement_date date [note: 'Date on which the covenant metric was measured or calculated, typically aligned with financial reporting period end.']
  measurement_period_end date [note: 'End date of the financial period over which the covenant metric is calculated.']
  measurement_period_start date [note: 'Start date of the financial period over which the covenant metric is calculated (e.g., trailing twelve months).']
  next_test_date date [note: 'Scheduled date for the next covenant compliance test or measurement.']
  remediation_plan varchar [note: 'Description of the borrowers plan to address covenant breach or prevent future breach, if applicable.']
  reporting_deadline date [note: 'Deadline by which the borrower must report covenant compliance to the lender.']
  risk_rating varchar [note: 'Internal risk rating assigned to the covenant based on proximity to breach and borrower credit quality.']
  testing_frequency varchar [note: 'Frequency at which the covenant must be tested and reported as specified in the credit agreement.']
  threshold_operator varchar [note: 'Comparison operator defining the covenant compliance condition relative to the threshold value.']
  threshold_value decimal(18,4) [note: 'Numeric threshold or limit specified in the covenant that must be maintained or not exceeded.']
  trend_direction varchar [note: 'Directional trend of covenant compliance over recent measurement periods: improving, stable, or deteriorating.']
  updated_by varchar [note: 'Identifier of the user or system that last updated the covenant monitoring record.']
  updated_timestamp timestamp [note: 'Timestamp when the covenant monitoring record was last updated or modified.']
  verification_date date [note: 'Date on which the covenant compliance was verified by internal or external parties.']
  verification_status varchar [note: 'Status of verification for the reported covenant metric: unverified, verified by internal team, audited by external auditor, or disputed.']
  verified_by varchar [note: 'Name or identifier of the individual or team who verified the covenant compliance calculation.']
  waiver_date date [note: 'Date on which the covenant waiver was granted by the lender or syndicate.']
  waiver_expiry_date date [note: 'Date on which the covenant waiver expires and full compliance is required again.']
  waiver_granted_flag boolean [note: 'Boolean indicator of whether a waiver has been granted by the lender for a covenant breach.']

  Note: 'Operational record tracking financial covenant compliance for private credit investments, capturing covenant type (leverage ratio, interest coverage ratio, LTV, DSCR, minimum liquidity), covenant threshold, actual measured value, measurement date'
}

Table credit.structured_product {
  structured_product_id varchar [pk, note: 'Unique identifier for the structured credit instrument record.']
  credit_issuer_id varchar [note: 'FK to credit.credit_issuer']
  fixed_income_security_id varchar [note: 'Foreign key linking to credit.fixed_income_security. Business justification: Structured products (ABS, MBS, CLOs) are a specialized type of fixed income security. Linking to fixed_income_security creates proper instrument hierarchy.']
  accrued_interest decimal(18,6) [note: 'Interest accumulated since the last coupon payment date, payable to the seller in a transaction.']
  bloomberg_ticker varchar [note: 'Bloomberg terminal ticker symbol for the structured product.']
  collateral_pool_size decimal(18,2) [note: 'Total value of the underlying collateral pool backing the structured product.']
  collateral_type varchar [note: 'Type of underlying collateral backing the structured product (e.g., residential mortgages, commercial loans, auto loans, credit card receivables, corporate loans).']
  constant_prepayment_rate decimal(8,4) [note: 'Annualized rate at which the underlying collateral is expected to prepay, expressed as a decimal.']
  convexity decimal(10,4) [note: 'Measure of the curvature in the relationship between bond prices and yields, capturing second-order interest rate risk.']
  coupon_frequency varchar [note: 'Frequency at which interest payments are made to investors.']
  coupon_rate decimal(10,6) [note: 'Annual interest rate paid to investors, expressed as a decimal (e.g., 0.0525 for 5.25%).']
  credit_enhancement_pct decimal(8,4) [note: 'Total credit enhancement as a percentage of the tranche, including subordination, overcollateralization, and reserve accounts.']
  credit_rating_fitch varchar [note: 'Current credit rating assigned by Fitch Ratings agency.']
  credit_rating_moody varchar [note: 'Current credit rating assigned by Moodys Investors Service.']
  credit_rating_sp varchar [note: 'Current credit rating assigned by Standard and Poors rating agency.']
  currency_code varchar [note: 'Three-letter ISO currency code for the denomination of the structured product.']
  current_face_value decimal(18,2) [note: 'Current outstanding principal balance after amortization, prepayments, and write-downs.']
  cusip varchar [note: 'CUSIP identifier for North American structured securities.']
  default_rate decimal(8,4) [note: 'Percentage of underlying collateral that has defaulted or is expected to default.']
  duration decimal(10,4) [note: 'Weighted average time to receive cash flows, measuring interest rate risk sensitivity in years.']
  dv01 decimal(18,6) [note: 'Change in market value for a one basis point change in yield, measuring interest rate sensitivity.']
  expected_maturity_date date [note: 'Expected date of full principal repayment based on prepayment assumptions, may differ from legal maturity.']
  floating_rate_flag boolean [note: 'Indicates whether the coupon rate is floating (variable) or fixed.']
  investment_grade_flag boolean [note: 'Indicates whether the structured product is rated investment grade (BBB- or higher) or high yield.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the structured product globally.']
  issue_date date [note: 'Date when the structured product was originally issued to investors.']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer for regulatory reporting and counterparty identification.']
  loss_severity_rate decimal(8,4) [note: 'Expected loss as a percentage of exposure upon default, after recovery.']
  market_price decimal(18,6) [note: 'Current market price of the structured product, typically quoted as a percentage of par.']
  maturity_date date [note: 'Final legal maturity date when all principal and interest must be repaid.']
  number_of_collateral_assets varchar [note: 'Count of individual assets or loans in the underlying collateral pool.']
  oas decimal(10,2) [note: 'Spread over the risk-free rate adjusted for embedded options such as prepayment risk, expressed in basis points.']
  original_face_value decimal(18,2) [note: 'Original principal amount of the structured product at issuance.']
  overcollateralization_pct decimal(8,4) [note: 'Excess collateral value over outstanding note balance, expressed as a percentage.']
  price_date date [note: 'Date of the most recent market price observation.']
  product_type varchar [note: 'Classification of structured credit instrument: Asset-Backed Securities, Mortgage-Backed Securities, Residential MBS, Commercial MBS, Collateralized Loan Obligation, Collateralized Debt Obligation, Collateralized Bond Obligation, Covered Bond, Synthetic']
  reference_rate decimal(18,2) [note: 'Benchmark rate for floating rate instruments (e.g., SOFR, LIBOR, EURIBOR).']
  security_name varchar [note: 'Full legal name of the structured credit instrument.']
  sedol varchar [note: 'SEDOL code for UK and Irish structured securities.']
  spread_over_reference_bps decimal(8,2) [note: 'Credit spread added to the reference rate for floating rate instruments, expressed in basis points.']
  subordination_pct decimal(8,4) [note: 'Percentage of junior tranches providing loss protection to this tranche.']
  tranche_name varchar [note: 'Name or designation of the specific tranche within the structured product (e.g., Senior, Mezzanine, Equity, Class A, Class B).']
  tranche_seniority varchar [note: 'Seniority ranking of the tranche in the capital structure determining payment priority and loss absorption.']
  weighted_average_coupon decimal(10,6) [note: 'Weighted average interest rate of the underlying collateral pool.']
  weighted_average_life_years decimal(8,2) [note: 'Expected average time until principal is repaid, accounting for prepayments and amortization.']
  weighted_average_maturity_months varchar [note: 'Weighted average remaining term to maturity of the underlying collateral, expressed in months.']
  ytm decimal(10,6) [note: 'Total return anticipated if the structured product is held until maturity, expressed as a decimal.']

  Note: 'Master record for structured credit instruments including asset-backed securities (ABS), mortgage-backed securities (MBS), collateralized loan obligations (CLO), collateralized debt obligations (CDO), and covered bonds.'
}

Table credit.sovereign_debt_holding {
  sovereign_debt_holding_id varchar [pk, note: 'Unique identifier for the sovereign debt holding record.']
  employee_id varchar [note: 'Reference to the portfolio manager responsible for this sovereign debt holding.']
  fixed_income_security_id varchar [note: 'Reference to the underlying sovereign debt security master record.']
  portfolio_id varchar [note: 'Reference to the investment portfolio containing this sovereign debt holding.']
  accounting_classification varchar [note: 'IFRS 9 accounting treatment category for the sovereign debt holding.']
  accrued_interest decimal(20,2) [note: 'Interest earned but not yet paid since the last coupon payment date.']
  acquisition_date date [note: 'Date when the sovereign debt position was originally acquired.']
  asset_class varchar [note: 'High-level asset class categorization for portfolio allocation and reporting.']
  average_cost decimal(15,6) [note: 'Weighted average cost per unit of the sovereign debt holding across multiple purchases.']
  book_value decimal(20,2) [note: 'Amortized cost or carrying value of the sovereign debt holding on the books.']
  callable_flag boolean [note: 'Indicates whether the issuer has the right to redeem the sovereign debt before maturity.']
  cost_basis decimal(20,2) [note: 'Original purchase price paid for the sovereign debt holding including transaction costs.']
  coupon_frequency varchar [note: 'Frequency at which coupon interest payments are made.']
  coupon_rate decimal(8,5) [note: 'Annual interest rate paid by the sovereign debt security expressed as a decimal.']
  created_timestamp timestamp [note: 'Timestamp when the sovereign debt holding record was first created in the system.']
  credit_rating_fitch varchar [note: 'Current credit rating assigned by Fitch Ratings to the sovereign issuer.']
  credit_rating_moody varchar [note: 'Current credit rating assigned by Moodys Investors Service to the sovereign issuer.']
  credit_rating_sp varchar [note: 'Current credit rating assigned by Standard and Poors to the sovereign issuer.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the sovereign debt is denominated.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American sovereign debt securities.']
  custodian_account varchar [note: 'Account number at the custodian where the sovereign debt holding is held.']
  custodian_name varchar [note: 'Name of the financial institution holding the sovereign debt securities in custody.']
  duration decimal(10,4) [note: 'Macaulay or modified duration measuring interest rate sensitivity of the sovereign debt holding.']
  dv01 decimal(15,4) [note: 'Change in market value for a one basis point change in yield, measuring interest rate risk.']
  esg_rating varchar [note: 'ESG rating assigned to the sovereign issuer by external rating provider.']
  face_value decimal(20,2) [note: 'Par or nominal value of the sovereign debt holding at issuance.']
  green_bond_flag boolean [note: 'Indicates whether the sovereign debt is a certified green bond for environmental projects.']
  holding_status varchar [note: 'Current lifecycle status of the sovereign debt holding.']
  inflation_linked_flag boolean [note: 'Indicates whether the sovereign debt principal and coupons are indexed to inflation.']
  investment_grade_flag boolean [note: 'Indicates whether the sovereign debt is rated investment grade by major rating agencies.']
  investment_strategy varchar [note: 'Investment strategy or mandate under which the sovereign debt holding was acquired.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the sovereign debt security.']
  issuer_country varchar [note: 'ISO 3166-1 alpha-3 country code of the sovereign issuer.']
  issuer_lei varchar [note: 'ISO 17442 standard 20-character alphanumeric code uniquely identifying the issuing legal entity.']
  issuer_name varchar [note: 'Name of the sovereign or quasi-sovereign entity issuing the debt.']
  market_value decimal(20,2) [note: 'Current fair market value of the sovereign debt holding based on latest pricing.']
  market_value_date date [note: 'As-of date for the market value measurement.']
  maturity_date date [note: 'Date when the sovereign debt security matures and principal is repaid.']
  quantity decimal(20,4) [note: 'Number of units or nominal amount of the sovereign debt security held.']
  security_name varchar [note: 'Full legal name of the sovereign debt security.']
  security_type varchar [note: 'Classification of the sovereign debt instrument type.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on London Stock Exchange and other UK markets.']
  settlement_date date [note: 'Date when the acquisition trade settled and ownership transferred.']
  unrealized_gain_loss decimal(20,2) [note: 'Difference between market value and book value representing unrealized profit or loss.']
  updated_timestamp timestamp [note: 'Timestamp when the sovereign debt holding record was last modified.']
  ytm decimal(8,5) [note: 'Total return anticipated on the sovereign debt if held until maturity, expressed as an annual rate.']

  Note: 'Master record for sovereign and quasi-sovereign debt holdings including government bonds, treasury bills (T-Bills), inflation-linked bonds (ILBs/TIPS), agency bonds, and supranational debt (World Bank, EIB).'
}

Table credit.credit_yield_curve {
  credit_yield_curve_id varchar [pk, note: 'Unique identifier for the yield curve record.']
  active_flag boolean [note: 'Indicates whether this yield curve record is currently active and should be used for valuation and analytics (True/False).']
  benchmark_flag boolean [note: 'Indicates whether this is a benchmark curve used as a standard reference for valuation and risk analytics (True/False).']
  compounding_frequency varchar [note: 'Frequency at which interest is compounded for rate calculations (annual, semi-annual, quarterly, monthly, continuous).']
  created_timestamp timestamp [note: 'Date and time when this yield curve record was first created in the system.']
  credit_quality varchar [note: 'Credit quality classification for credit spread curves (AAA, AA, A, BBB, BB, B, CCC, unrated). Not applicable for government curves. [ENUM-REF-CANDIDATE: aaa|aa|a|bbb|bb|b|ccc|unrated — 8 candidates stripped; promote to reference product]']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the yield curve (e.g., USD, EUR, GBP, JPY).']
  curve_date date [note: 'The business date for which this yield curve snapshot is valid and applicable.']
  curve_name varchar [note: 'Human-readable name of the yield curve (e.g., US Treasury Curve, EUR Swap Curve, SOFR OIS Curve).']
  curve_status varchar [note: 'Current lifecycle status of the yield curve record (active, historical, preliminary, final, superseded, invalid).']
  curve_type varchar [note: 'Classification of the yield curve by instrument type (government, swap, SOFR, OIS, credit spread, corporate, LIBOR, treasury). [ENUM-REF-CANDIDATE: government|swap|sofr|ois|credit_spread|corporate|libor|treasury — 8 candidates stripped; promote to']
  day_count_convention varchar [note: 'Day count convention used for rate calculations (ACT/360, ACT/365, 30/360, ACT/ACT).']
  effective_timestamp timestamp [note: 'Date and time from which this yield curve snapshot becomes effective for valuation and risk calculations.']
  expiry_timestamp timestamp [note: 'Date and time when this yield curve snapshot is superseded or expires, marking the end of its validity period.']
  interpolation_method varchar [note: 'Mathematical method used to interpolate rates between tenor points (linear, cubic spline, Nelson-Siegel, Svensson, log-linear, Hermite).']
  jurisdiction varchar [note: 'Three-letter ISO country code representing the jurisdiction or sovereign issuer for government curves (e.g., USA, GBR, DEU, CAN, JPN).']
  notes varchar [note: 'Free-text field for additional notes, comments, or context about the yield curve construction, data quality issues, or special circumstances.']
  publication_timestamp timestamp [note: 'Date and time when the yield curve data was published or made available by the source system.']
  sector varchar [note: 'Industry sector for corporate or credit spread curves (e.g., financials, industrials, utilities, energy). Not applicable for government curves.']
  source_identifier varchar [note: 'Unique identifier or ticker used by the source system to reference this yield curve (e.g., Bloomberg curve ticker).']
  tenor_10y_discount_factor decimal(12,10) [note: 'Discount factor for 10-year tenor used to present-value future cash flows.']
  tenor_10y_forward_rate decimal(12,8) [note: 'Forward rate for 10-year tenor, representing the implied future interest rate.']
  tenor_10y_par_rate decimal(12,8) [note: 'Par yield for 10-year tenor, representing the coupon rate at which a bond would trade at par.']
  tenor_10y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 10-year tenor expressed as a decimal (e.g., 0.0525 for 5.25%).']
  tenor_15y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 15-year tenor expressed as a decimal (e.g., 0.0550 for 5.50%).']
  tenor_1m_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 1-month tenor expressed as a decimal (e.g., 0.0325 for 3.25%).']
  tenor_1y_discount_factor decimal(12,10) [note: 'Discount factor for 1-year tenor used to present-value future cash flows (e.g., 0.9615 for 4% rate).']
  tenor_1y_forward_rate decimal(12,8) [note: 'Forward rate for 1-year tenor, representing the implied future interest rate.']
  tenor_1y_par_rate decimal(12,8) [note: 'Par yield for 1-year tenor, representing the coupon rate at which a bond would trade at par.']
  tenor_1y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 1-year tenor expressed as a decimal (e.g., 0.0400 for 4.00%).']
  tenor_20y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 20-year tenor expressed as a decimal (e.g., 0.0575 for 5.75%).']
  tenor_2y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 2-year tenor expressed as a decimal (e.g., 0.0425 for 4.25%).']
  tenor_30y_discount_factor decimal(12,10) [note: 'Discount factor for 30-year tenor used to present-value future cash flows.']
  tenor_30y_par_rate decimal(12,8) [note: 'Par yield for 30-year tenor, representing the coupon rate at which a bond would trade at par.']
  tenor_30y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 30-year tenor expressed as a decimal (e.g., 0.0600 for 6.00%).']
  tenor_3m_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 3-month tenor expressed as a decimal (e.g., 0.0350 for 3.50%).']
  tenor_3y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 3-year tenor expressed as a decimal (e.g., 0.0450 for 4.50%).']
  tenor_5y_discount_factor decimal(12,10) [note: 'Discount factor for 5-year tenor used to present-value future cash flows.']
  tenor_5y_forward_rate decimal(12,8) [note: 'Forward rate for 5-year tenor, representing the implied future interest rate.']
  tenor_5y_par_rate decimal(12,8) [note: 'Par yield for 5-year tenor, representing the coupon rate at which a bond would trade at par.']
  tenor_5y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 5-year tenor expressed as a decimal (e.g., 0.0475 for 4.75%).']
  tenor_6m_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 6-month tenor expressed as a decimal (e.g., 0.0375 for 3.75%).']
  tenor_7y_zero_rate decimal(12,8) [note: 'Zero-coupon rate for 7-year tenor expressed as a decimal (e.g., 0.0500 for 5.00%).']
  updated_timestamp timestamp [note: 'Date and time when this yield curve record was last modified or updated in the system.']
  validation_status varchar [note: 'Status of data quality validation checks performed on the yield curve data (passed, failed, pending, not validated).']
  version_number varchar [note: 'Sequential version number for tracking revisions and updates to the yield curve for the same curve date.']

  Note: 'Reference data store for benchmark yield curves used in fixed income valuation and risk analytics, capturing curve type (government, swap, SOFR, OIS, credit spread curve), currency, tenor points, zero rates, par rates, forward rates, discount factors, and'
}

Table credit.benchmark_index {
  benchmark_index_id varchar [pk, note: 'Unique identifier for the benchmark index record.']
  active_flag boolean [note: 'Indicates whether this benchmark index record is currently active and in use.']
  asset_class varchar [note: 'Primary asset class category that the benchmark index represents. [ENUM-REF-CANDIDATE: Fixed Income|Credit|Government Bonds|Corporate Bonds|Emerging Markets Debt|High Yield|Investment Grade|Sovereign Debt — 8 candidates stripped; promote to reference']
  base_date date [note: 'Reference date from which the index value is calculated (typically set to 100).']
  base_value decimal(10,2) [note: 'Initial index value at the base date (commonly 100 or 1000).']
  benchmark_status varchar [note: 'Current operational status of the benchmark index.']
  bloomberg_ticker varchar [note: 'Bloomberg terminal ticker symbol for the benchmark index.']
  calculation_frequency varchar [note: 'Frequency at which the index value is calculated and published.']
  convexity decimal(10,4) [note: 'Measure of the curvature in the relationship between bond prices and yields for the index.']
  created_timestamp timestamp [note: 'Date and time when this benchmark index record was first created in the system.']
  credit_quality varchar [note: 'Credit rating category or quality tier of securities included in the index. [ENUM-REF-CANDIDATE: Investment Grade|High Yield|AAA|AA|A|BBB|BB|B|CCC|Mixed — 10 candidates stripped; promote to reference product]']
  currency_code varchar [note: 'Three-letter ISO currency code in which the index is denominated.']
  current_index_level decimal(15,6) [note: 'Most recent calculated value of the index.']
  data_source varchar [note: 'Primary system or vendor from which benchmark data is sourced.']
  duration_years decimal(8,4) [note: 'Effective duration of the index in years, measuring interest rate sensitivity.']
  eligibility_criteria varchar [note: 'Summary of rules and requirements for securities to be included in the index (e.g., minimum issue size, rating).']
  esg_methodology varchar [note: 'Description of ESG screening or integration approach if applicable.']
  esg_screened_flag boolean [note: 'Indicates whether the index applies ESG screening criteria to constituent selection.']
  factset_index_code varchar [note: 'FactSet proprietary identifier for the benchmark index.']
  geographic_focus varchar [note: 'Primary geographic region or market that the index covers. [ENUM-REF-CANDIDATE: Global|USA|EUR|GBR|CAN|JPN|CHN|Developed Markets|Emerging Markets|Asia Pacific|Latin America — 11 candidates stripped; promote to reference product]']
  hedged_flag boolean [note: 'Indicates whether the index includes currency hedging (True) or is unhedged (False).']
  inception_date date [note: 'Date when the benchmark index was first launched or calculated.']
  index_code varchar [note: 'Unique alphanumeric code identifying the benchmark index (e.g., LBUSTRUU for Bloomberg US Aggregate).']
  index_family varchar [note: 'Broader index family or suite to which this benchmark belongs (e.g., Bloomberg Global Aggregate family).']
  index_level_date date [note: 'Date as of which the current index level was calculated.']
  index_name varchar [note: 'Full official name of the benchmark index.']
  index_provider varchar [note: 'Organization that calculates and publishes the benchmark index. [ENUM-REF-CANDIDATE: Bloomberg|ICE BofA|FTSE Russell|JP Morgan|Barclays|MSCI|S&P Dow Jones — 7 candidates stripped; promote to reference product]']
  index_type varchar [note: 'Calculation methodology type for the index (total return includes reinvested income, price return excludes).']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the index.']
  last_rebalance_date date [note: 'Most recent date on which the index was rebalanced.']
  mandate_compliance_flag boolean [note: 'Indicates whether this benchmark is used for formal mandate compliance monitoring.']
  market_value_usd decimal(20,2) [note: 'Total market capitalization of the index in USD.']
  maturity_range varchar [note: 'Maturity bucket or range of securities included (e.g., 1-3 years, 10+ years, All Maturities).']
  methodology_document_url varchar [note: 'Web link to the official index methodology document published by the provider.']
  next_rebalance_date date [note: 'Scheduled date for the next index rebalance.']
  number_of_constituents varchar [note: 'Total count of securities included in the benchmark index.']
  oas_bps decimal(10,2) [note: 'Weighted average option-adjusted spread of the index in basis points.']
  performance_attribution_flag boolean [note: 'Indicates whether this benchmark is used for performance attribution analysis.']
  rebalance_frequency varchar [note: 'Frequency at which the index composition is reviewed and rebalanced.']
  regulatory_classification varchar [note: 'Regulatory designation or classification of the benchmark (e.g., EU BMR critical, significant, non-significant).']
  ric_code varchar [note: 'Reuters Instrument Code used to identify the index on Refinitiv platforms.']
  sector_focus varchar [note: 'Specific industry sector focus if the index is sector-specific (e.g., Financials, Utilities); null for broad indices.']
  sedol varchar [note: 'Seven-character alphanumeric code used to identify the index in UK and Irish markets.']
  updated_timestamp timestamp [note: 'Date and time when this benchmark index record was last modified.']
  usage_purpose varchar [note: 'Primary business use case for this benchmark (e.g., performance attribution, mandate compliance, portfolio construction).']
  weighting_methodology varchar [note: 'Method used to weight constituent securities within the index.']
  ytm_percent decimal(8,4) [note: 'Weighted average yield to maturity of the index constituents, expressed as a percentage.']

  Note: 'Reference master for fixed income benchmark indices used for performance attribution, portfolio construction, and mandate compliance (e.g., Bloomberg Global Aggregate, Bloomberg US Corporate IG, ICE BofA HY, FTSE WGBI, Bloomberg EM USD Aggregate).'
}

Table credit.credit_benchmark_constituent {
  credit_benchmark_constituent_id varchar [pk, note: 'Unique identifier for each benchmark constituent record, representing a specific security within a specific benchmark index at a specific rebalancing date.']
  benchmark_index_id varchar [note: 'Foreign key reference to the parent fixed income benchmark index to which this constituent belongs.']
  fixed_income_security_id varchar [note: 'Foreign key reference to the fixed income security master record for this constituent.']
  accrued_interest decimal(15,4) [note: 'The amount of interest that has accumulated on the security since the last coupon payment date as of the rebalancing date.']
  bloomberg_ticker varchar [note: 'Bloomberg-specific ticker symbol used for market data retrieval and trading.']
  callable_flag boolean [note: 'Boolean indicator of whether the security contains an embedded call option allowing early redemption by the issuer.']
  composite_rating_category varchar [note: 'The composite credit rating category used by the benchmark index for classification purposes. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D — 10 candidates stripped; promote to reference product]']
  constituent_status varchar [note: 'Current lifecycle status of this security within the benchmark index composition.']
  convexity decimal(10,4) [note: 'The convexity measure of the security, capturing the curvature of the price-yield relationship.']
  country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary country of credit risk exposure for the security.']
  coupon_rate decimal(10,6) [note: 'The annual coupon rate of the security, expressed as a decimal percentage of face value.']
  credit_rating_fitch varchar [note: 'The Fitch Ratings credit rating assigned to the security at the rebalancing date.']
  credit_rating_moody varchar [note: 'The Moodys Investors Service credit rating assigned to the security at the rebalancing date.']
  credit_rating_sp varchar [note: 'The Standard and Poors credit rating assigned to the security at the rebalancing date.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  data_source varchar [note: 'The primary source system from which this constituent record was obtained.']
  duration_contribution decimal(10,4) [note: 'The weighted contribution of this security to the overall benchmark index duration, measured in years.']
  dv01 decimal(15,4) [note: 'The dollar value change in the security price for a one basis point change in yield.']
  effective_duration decimal(10,4) [note: 'The effective duration accounting for embedded options, measuring interest rate sensitivity for callable or puttable bonds.']
  effective_from_date date [note: 'The date from which this security became an active constituent of the benchmark index.']
  effective_to_date date [note: 'The date until which this security remains an active constituent of the benchmark index, null if currently active.']
  esg_rating varchar [note: 'The ESG rating assigned to the security or issuer at the rebalancing date.']
  exclusion_reason varchar [note: 'The reason this security was removed from the benchmark index, if applicable.']
  face_value decimal(20,2) [note: 'The par or face value of the security, representing the principal amount to be repaid at maturity.']
  floating_rate_flag boolean [note: 'Boolean indicator of whether the security has a floating coupon rate tied to a reference rate.']
  green_bond_flag boolean [note: 'Boolean indicator of whether the security is classified as a green bond under ESG criteria.']
  inclusion_reason varchar [note: 'The reason this security was added to the benchmark index at this rebalancing date.']
  index_weight_percent decimal(10,6) [note: 'The percentage weight of this security within the benchmark index composition, expressed as a decimal percentage.']
  investment_grade_flag boolean [note: 'Boolean indicator of whether the security is classified as investment grade (BBB-/Baa3 or higher) at the rebalancing date.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the fixed income security.']
  issuer_lei varchar [note: 'ISO 17442 standard 20-character code uniquely identifying the issuing legal entity.']
  issuer_name varchar [note: 'Legal name of the entity that issued the debt security.']
  market_price decimal(15,6) [note: 'The market price of the security at the rebalancing date, typically expressed as a percentage of face value.']
  market_value_contribution decimal(20,2) [note: 'The market value contribution of this security to the total benchmark index market value at the rebalancing date.']
  market_value_currency varchar [note: 'ISO 4217 three-letter currency code for the market value contribution amount.']
  maturity_date date [note: 'The date on which the principal amount of the security becomes due and payable.']
  modified_duration decimal(10,4) [note: 'The modified duration of the security at the rebalancing date, measuring price sensitivity to yield changes.']
  oas decimal(10,2) [note: 'The option-adjusted spread in basis points, measuring the yield spread over the risk-free rate after adjusting for embedded options.']
  puttable_flag boolean [note: 'Boolean indicator of whether the security contains an embedded put option allowing early redemption by the holder.']
  rebalancing_date date [note: 'The effective date of the index rebalancing event when this constituent composition was established.']
  record_created_timestamp timestamp [note: 'The timestamp when this constituent record was first created in the system.']
  record_updated_timestamp timestamp [note: 'The timestamp when this constituent record was last modified in the system.']
  sector_classification varchar [note: 'The industry sector classification of the issuer according to the benchmark index methodology. [ENUM-REF-CANDIDATE: government|corporate|financial|utility|industrial|consumer|technology|healthcare|energy|telecommunications — promote to reference product]']
  security_name varchar [note: 'Full legal name or description of the fixed income security as it appears in the benchmark index.']
  security_type varchar [note: 'The classification of the fixed income security type within the benchmark index. [ENUM-REF-CANDIDATE: government_bond|corporate_bond|agency_bond|municipal_bond|asset_backed_security|mortgage_backed_security|covered_bond|convertible_bond — promote to']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  subordination_level varchar [note: 'The seniority ranking of the security in the issuers capital structure, determining priority in default scenarios.']
  yield_contribution decimal(10,6) [note: 'The weighted contribution of this security to the overall benchmark index yield.']
  ytm decimal(10,6) [note: 'The yield to maturity of the security at the rebalancing date, expressed as a decimal percentage.']

  Note: 'Time-series record of securities comprising each fixed income benchmark index at each rebalancing date, capturing security ISIN, index weight, market value contribution, duration contribution, yield contribution, sector classification, country, and rating'
}

Table credit.credit_issuer {
  credit_issuer_id varchar [pk, note: 'Unique identifier for the credit issuer entity in the pension fund\'s investment universe.']
  parent_credit_issuer_id varchar [note: 'Self-referencing FK on credit_issuer (parent_credit_issuer_id)']
  active_flag boolean [note: 'Boolean indicator whether the issuer record is currently active in the investment universe.']
  country_of_domicile varchar [note: 'ISO 3166-1 alpha-3 country code where the issuer is legally incorporated or domiciled.']
  country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary geographic risk exposure of the issuer.']
  coverage_end_date date [note: 'Date when the pension fund ceased coverage of this issuer if no longer tracked.']
  coverage_start_date date [note: 'Date when the pension fund began tracking and covering this issuer in its investment universe.']
  created_timestamp timestamp [note: 'Timestamp when this issuer record was first created in the lakehouse.']
  credit_rating_fitch varchar [note: 'Current long-term issuer credit rating assigned by Fitch Ratings.']
  credit_rating_moody varchar [note: 'Current long-term issuer credit rating assigned by Moody\'s Investors Service.']
  credit_rating_sp varchar [note: 'Current long-term issuer credit rating assigned by Standard & Poor\'s.']
  debt_currency varchar [note: 'ISO 4217 three-letter currency code for the primary currency of the issuer\'s debt issuance.']
  default_date date [note: 'Date when the issuer entered default status on any debt obligation.']
  default_flag boolean [note: 'Boolean indicator whether the issuer is currently in default on any debt obligations.']
  ebitda decimal(18,2) [note: 'EBITDA reported by the issuer for the most recent fiscal year.']
  esg_rating_msci varchar [note: 'MSCI ESG rating assessing the issuer\'s management of ESG risks and opportunities. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC — 7 candidates stripped; promote to reference product]']
  esg_rating_sustainalytics varchar [note: 'Sustainalytics ESG risk rating score measuring the issuer\'s exposure to material ESG risks.']
  fiscal_year_end varchar [note: 'Month and day of the issuer\'s fiscal year end in MM-DD format.']
  ghg_emissions_scope_1_2 decimal(18,2) [note: 'Total Scope 1 and Scope 2 greenhouse gas emissions in metric tons of CO2 equivalent reported by the issuer.']
  industry_sector_gics varchar [note: 'GICS sector classification code identifying the issuer\'s primary industry sector.']
  industry_sector_icb varchar [note: 'ICB sector classification code identifying the issuer\'s primary industry sector.']
  investment_grade_flag boolean [note: 'Boolean indicator whether the issuer holds investment grade credit rating (BBB-/Baa3 or higher).']
  issuer_type varchar [note: 'Classification of the issuer by organizational structure and legal status.']
  kyc_next_review_date date [note: 'Scheduled date for the next periodic KYC review of the issuer.']
  kyc_review_date date [note: 'Date of the most recent KYC review and approval for the issuer.']
  kyc_status varchar [note: 'Current KYC and AML compliance status for the issuer as a counterparty.']
  legal_name varchar [note: 'Full legal name of the issuer as registered with regulatory authorities.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier uniquely identifying the issuer globally.']
  listing_exchange varchar [note: 'Primary stock exchange where the issuer\'s equity securities are listed if publicly traded.']
  market_capitalization decimal(18,2) [note: 'Total market value of the issuer\'s outstanding equity securities for corporate issuers.']
  pri_signatory_flag boolean [note: 'Boolean indicator whether the issuer is a signatory to the UN Principles for Responsible Investment.']
  public_private_flag boolean [note: 'Indicator whether the issuer is a publicly traded or privately held entity.']
  rating_outlook_fitch varchar [note: 'Current rating outlook assigned by Fitch indicating potential rating direction.']
  rating_outlook_moody varchar [note: 'Current rating outlook assigned by Moody\'s indicating potential rating direction.']
  rating_outlook_sp varchar [note: 'Current rating outlook assigned by Standard & Poor\'s indicating potential rating direction.']
  regulatory_status varchar [note: 'Current regulatory standing of the issuer with relevant securities and financial regulators.']
  sanctioned_entity_flag boolean [note: 'Boolean indicator whether the issuer appears on any international sanctions lists.']
  short_name varchar [note: 'Abbreviated or common name of the issuer used in market communications and reporting.']
  source_identifier varchar [note: 'Unique identifier for this issuer in the source system of record.']
  tcfd_reporting_flag boolean [note: 'Boolean indicator whether the issuer publishes TCFD-aligned climate disclosures.']
  ticker_symbol varchar [note: 'Primary equity ticker symbol for the issuer on its listing exchange.']
  total_assets decimal(18,2) [note: 'Total assets reported on the issuer\'s most recent audited balance sheet.']
  total_debt_outstanding decimal(18,2) [note: 'Total face value of all debt securities issued and outstanding by the issuer.']
  total_revenue decimal(18,2) [note: 'Total revenue reported by the issuer for the most recent fiscal year.']
  updated_timestamp timestamp [note: 'Timestamp when this issuer record was last modified in the lakehouse.']
  watchlist_flag boolean [note: 'Boolean indicator whether the issuer is on credit watch by any major rating agency.']

  Note: 'Master record for corporate and sovereign debt issuers covered by the pension fund\'s credit investment universe, capturing issuer legal name, LEI, parent entity, country of domicile, country of risk, industry sector (GICS/ICB), issuer type (corporate'
}

Table credit.maturity_schedule {
  maturity_schedule_id varchar [pk, note: 'Unique identifier for each maturity schedule entry in the fixed income portfolio.']
  cash_account_id varchar [note: 'Reference to the cash account that will receive redemption proceeds.']
  counterparty_id varchar [note: 'Reference to the counterparty (issuer or custodian) responsible for executing the redemption.']
  custodian_id varchar [note: 'Reference to the custodian bank holding the security and processing the redemption settlement.']
  fixed_income_security_id varchar [note: 'Reference to the underlying fixed income security for which this maturity schedule applies.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding this security position.']
  accrued_interest decimal(20,2) [note: 'Interest accrued from the last coupon payment date to the redemption event date, payable to the holder.']
  active_flag boolean [note: 'Indicates whether this maturity schedule entry is currently active and applicable for portfolio planning and reporting.']
  benchmark_rate decimal(18,2) [note: 'Reference benchmark rate used for make-whole calculations or floating rate adjustments at redemption.']
  benchmark_tenor varchar [note: 'Tenor of the benchmark rate used in make-whole or floating rate calculations. [ENUM-REF-CANDIDATE: overnight|1M|3M|6M|1Y|2Y|5Y|10Y|30Y — 9 candidates stripped; promote to reference product]']
  call_price decimal(12,6) [note: 'Price at which the issuer may call (redeem early) the bond, expressed as percentage of par value.']
  call_protection_end_date date [note: 'Date after which the issuer may exercise call options; bonds are non-callable before this date.']
  convexity_to_event decimal(10,4) [note: 'Convexity calculated to this specific redemption event, measuring the curvature of price-yield relationship.']
  created_timestamp timestamp [note: 'Timestamp when this maturity schedule entry was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for all monetary amounts in this schedule entry.']
  data_source varchar [note: 'System or source from which this maturity schedule entry was obtained. [ENUM-REF-CANDIDATE: Bloomberg|SimCorp|State_Street|Northern_Trust|FactSet|manual_entry|issuer_notice — 7 candidates stripped; promote to reference product]']
  duration_to_event decimal(8,4) [note: 'Modified duration calculated to this specific redemption event date, measuring interest rate sensitivity.']
  event_date date [note: 'Date on which the maturity, call, put, or sinking fund redemption event is scheduled to occur.']
  exercise_decision_date date [note: 'Date on which the decision to exercise or not exercise the call or put option was made.']
  exercise_status varchar [note: 'Current status of the optional redemption right: pending decision, exercised, not exercised, expired, or cancelled.']
  last_updated_timestamp timestamp [note: 'Timestamp when this maturity schedule entry was last updated in the system.']
  liquidity_impact_flag boolean [note: 'Indicates whether this redemption event has material impact on portfolio liquidity and cash management planning.']
  make_whole_provision_flag boolean [note: 'Indicates whether a make-whole call provision applies, requiring the issuer to compensate investors for lost future interest.']
  make_whole_spread_bps decimal(8,2) [note: 'Spread in basis points over the reference treasury rate used to calculate the make-whole call price.']
  notes varchar [note: 'Free-text field for additional comments, special conditions, or analyst notes regarding this redemption event.']
  notification_date date [note: 'Date by which the issuer or investor must provide notice of intent to exercise a call or put option.']
  option_adjusted_spread_bps decimal(8,2) [note: 'Option-adjusted spread in basis points, reflecting the credit spread after removing embedded option value.']
  optional_redemption_flag boolean [note: 'Indicates whether the redemption is optional (call or put) versus mandatory (maturity or sinking fund).']
  outstanding_principal_after decimal(20,2) [note: 'Principal amount remaining outstanding after this redemption event is executed.']
  outstanding_principal_before decimal(20,2) [note: 'Principal amount outstanding immediately before this redemption event.']
  probability_of_exercise decimal(5,2) [note: 'Estimated probability (0-100%) that an optional call or put will be exercised, based on market conditions and analytics.']
  put_price decimal(12,6) [note: 'Price at which the investor may put (sell back) the bond to the issuer, expressed as percentage of par value.']
  redemption_amount decimal(20,2) [note: 'Expected principal amount to be redeemed at this event, expressed in the security currency.']
  redemption_percentage decimal(5,2) [note: 'Percentage of the outstanding principal being redeemed at this event, used for partial redemptions.']
  redemption_price decimal(12,6) [note: 'Price per unit (typically percentage of par) at which the security will be redeemed.']
  reinvestment_rate_assumption decimal(8,4) [note: 'Assumed reinvestment rate for proceeds from this redemption event, used in yield and duration calculations.']
  reinvestment_strategy varchar [note: 'Planned strategy for reinvesting proceeds from this redemption event.']
  schedule_type varchar [note: 'Type of redemption event: maturity (final redemption), call (issuer option), put (investor option), sinking fund (scheduled partial redemption), amortization (structured paydown), or prepayment (early unscheduled).']
  settlement_date date [note: 'Date on which cash and securities are exchanged for the redemption event.']
  settlement_method varchar [note: 'Method by which the redemption will settle: Delivery Versus Payment (DVP), Free of Payment (FOP), cash settlement, or physical delivery.']
  sinking_fund_schedule_flag boolean [note: 'Indicates whether this event is part of a mandatory sinking fund schedule requiring periodic partial redemptions.']
  tax_treatment varchar [note: 'Expected tax treatment of the redemption proceeds for reporting and planning purposes.']
  total_proceeds decimal(20,2) [note: 'Total cash proceeds expected from the redemption event, including principal and accrued interest.']
  yield_to_event decimal(8,4) [note: 'Yield calculated assuming the bond is held until this specific redemption event occurs.']

  Note: 'Forward-looking maturity and redemption schedule for the fixed income portfolio, capturing each security\'s maturity date, call dates (for callable bonds), put dates (for putable bonds), sinking fund schedule, expected redemption amount, and redemption'
}

Table credit.default_event {
  default_event_id varchar [pk, note: 'Unique identifier for the credit default event record.']
  credit_issuer_id varchar [note: 'Identifier of the issuer or reference entity experiencing the credit event.']
  fixed_income_security_id varchar [note: 'Identifier of the specific debt instrument or obligation subject to the credit event.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio holding exposure to the defaulted entity.']
  reference_entity_actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Default event refers to the issuer; needed for event reporting, loss estimation, and regulatory compliance.']
  reference_entity_credit_issuer_id varchar [note: 'Identifier of the issuer or reference entity experiencing the credit event.']
  affected_bond_positions varchar [note: 'Number of direct bond or fixed income security positions in the portfolio affected by this credit event.']
  affected_cds_contracts varchar [note: 'Number of credit default swap contracts in the portfolio directly affected by this credit event and subject to settlement or valuation adjustment.']
  announcement_timestamp timestamp [note: 'Precise timestamp when the credit event was publicly announced or disclosed by the issuer, regulator, or market authority.']
  auction_date date [note: 'Date of the ISDA credit event auction used to determine the final recovery price for cash settlement of credit default swaps.']
  auction_final_price decimal(18,6) [note: 'Final recovery price determined by the ISDA credit event auction, expressed as a percentage of par value (e.g., 40.00 represents 40% recovery).']
  contagion_risk_flag boolean [note: 'Indicates whether the credit event poses systemic or contagion risk to other portfolio holdings, counterparties, or market segments, requiring heightened monitoring.']
  country_of_risk varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the primary country of credit risk exposure for the reference entity.']
  credit_rating_at_event varchar [note: 'The credit rating assigned to the reference entity or obligation immediately prior to or at the time of the credit event, typically from S&P, Moody\'s, or Fitch.']
  data_source varchar [note: 'Source system or data provider from which the credit event information was obtained (e.g., Bloomberg, Markit, internal credit risk system, ISDA).']
  dc_determination_flag boolean [note: 'Indicates whether the credit event was formally determined by an ISDA regional Determinations Committee (true) or identified through internal credit monitoring (false).']
  dc_region varchar [note: 'Geographic region of the ISDA Determinations Committee that issued the credit event determination: Americas, EMEA, Asia, Japan, or Australia/New Zealand.']
  determination_date date [note: 'Date on which the ISDA Determinations Committee formally determined that a credit event has occurred.']
  estimated_loss_amount decimal(20,2) [note: 'Estimated monetary loss resulting from the credit event, calculated as exposure at default multiplied by loss given default.']
  event_date date [note: 'The date on which the credit event occurred or was publicly announced, as determined by the ISDA Determinations Committee or internal credit risk team.']
  event_identifier varchar [note: 'Externally-known unique identifier or reference number for this credit event, often assigned by ISDA Determinations Committee or market infrastructure.']
  event_status varchar [note: 'Current lifecycle status of the credit event: potential (under review), confirmed (DC determination issued), rejected (not a credit event), settled (cash or physical settlement completed), or disputed (under legal challenge).']
  event_type varchar [note: 'Classification of the credit event as defined under ISDA Credit Derivatives Definitions: bankruptcy, failure to pay, restructuring, obligation acceleration, repudiation/moratorium, or governmental intervention.']
  exposure_at_default decimal(20,2) [note: 'Total notional exposure to the reference entity or obligation at the time of the credit event, across all positions and instruments in the portfolio.']
  exposure_currency varchar [note: 'Three-letter ISO 4217 currency code for the exposure at default amount.']
  ic_notification_date date [note: 'Date on which the Investment Committee was formally notified of the credit event and its portfolio impact.']
  legal_counsel_engaged boolean [note: 'Indicates whether external legal counsel has been engaged to represent the fund\'s interests in bankruptcy proceedings, restructuring negotiations, or litigation related to this credit event.']
  loss_currency varchar [note: 'Three-letter ISO 4217 currency code for the estimated and realized loss amounts.']
  loss_given_default decimal(5,4) [note: 'Loss severity as a percentage of exposure at default, calculated as 1 minus recovery rate. Used for credit risk capital calculations and portfolio loss estimation.']
  notes varchar [note: 'Free-text field for additional context, internal analysis, or special circumstances related to the credit event that do not fit structured fields.']
  public_information_source varchar [note: 'Citation of the publicly available information source used to verify the credit event, as required by ISDA definitions (e.g., Bloomberg, Reuters, regulatory filing, court document).']
  rating_agency varchar [note: 'The rating agency that assigned the credit rating at event date: S&P, Moody\'s, Fitch, DBRS, or other recognized agency.']
  realized_loss_amount decimal(20,2) [note: 'Actual realized loss after settlement, workout, or liquidation of the defaulted position. Null until final settlement is completed.']
  record_created_timestamp timestamp [note: 'Timestamp when this credit event record was first created in the system.']
  record_updated_by varchar [note: 'User identifier or system account that last updated this credit event record, for audit trail purposes.']
  record_updated_timestamp timestamp [note: 'Timestamp when this credit event record was last modified, reflecting updates to status, settlement details, or loss estimates.']
  recovery_rate decimal(5,4) [note: 'Estimated or actual recovery rate on the defaulted obligation, expressed as a decimal (e.g., 0.4000 represents 40% recovery). May be based on auction results, market pricing, or internal valuation.']
  regulatory_reporting_required boolean [note: 'Indicates whether this credit event triggers mandatory regulatory reporting obligations to SEC, or other supervisory authorities.']
  restructuring_type varchar [note: 'Type of restructuring clause applicable to the credit event: Modified Restructuring (Mod R), Modified Modified Restructuring (Mod Mod R), No Restructuring, or Full Restructuring. Relevant for restructuring credit events.']
  sector varchar [note: 'Industry sector or economic classification of the reference entity experiencing the credit event (e.g., financials, energy, industrials, sovereign).']
  seniority varchar [note: 'Seniority ranking of the defaulted obligation in the capital structure: senior secured, senior unsecured, subordinated, or junior subordinated. Determines recovery priority.']
  settlement_date date [note: 'Date on which settlement of credit default swap positions or other credit derivatives was completed following the credit event.']
  settlement_method varchar [note: 'Method used to settle credit default swap positions triggered by this event: cash settlement, physical delivery of defaulted obligations, or ISDA auction-based settlement.']
  sovereign_flag boolean [note: 'Indicates whether the credit event involves a sovereign government entity (true) or a corporate/financial institution entity (false).']
  trigger_event_description varchar [note: 'Detailed narrative description of the specific event or circumstances that triggered the credit event determination, including relevant facts and timeline.']
  workout_strategy varchar [note: 'Summary of the planned or executed workout strategy for the defaulted position: hold for recovery, participate in restructuring, sell at market, legal action, or other approach.']

  Note: 'Transactional record of credit events (as defined under ISDA) affecting issuers or reference entities in the portfolio, including bankruptcy, failure to pay, restructuring, obligation acceleration, repudiation/moratorium, and governmental intervention.'
}

Table credit.sofr_rate {
  sofr_rate_id varchar [pk, note: 'Unique identifier for the SOFR rate record.']
  benchmark_status varchar [note: 'Current regulatory status of the SOFR benchmark rate.']
  business_day_convention varchar [note: 'Convention for adjusting rate effective dates when they fall on non-business days.']
  calendar varchar [note: 'Holiday calendar used to determine business days for SOFR rate publication and application.']
  compounding_method varchar [note: 'Method used for compounding SOFR rates over the averaging period (simple, compound in arrears, compound in advance).']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the rate (typically USD for SOFR).']
  data_quality_flag boolean [note: 'Quality status of the rate data indicating verification level and reliability.']
  day_count_convention varchar [note: 'Day count convention applied to SOFR rate calculations (Actual/360, Actual/365, 30/360).']
  effective_date date [note: 'Date for which this SOFR rate is effective and applicable.']
  fallback_rate_flag boolean [note: 'Indicates whether this rate is being used as a fallback replacement for LIBOR (London Interbank Offered Rate) or another discontinued benchmark.']
  index_value decimal(18,8) [note: 'Cumulative compounded SOFR index value used for calculating interest accruals on floating rate instruments.']
  percentile_1 decimal(12,8) [note: 'First percentile of the rate distribution used in SOFR calculation, providing insight into rate dispersion.']
  percentile_25 decimal(12,8) [note: 'Twenty-fifth percentile of the rate distribution used in SOFR calculation.']
  percentile_75 decimal(12,8) [note: 'Seventy-fifth percentile of the rate distribution used in SOFR calculation.']
  percentile_99 decimal(12,8) [note: 'Ninety-ninth percentile of the rate distribution used in SOFR calculation.']
  publication_timestamp timestamp [note: 'Timestamp when the rate was officially published by the Federal Reserve Bank of New York or CME (Chicago Mercantile Exchange).']
  rate_bps decimal(10,2) [note: 'The SOFR rate expressed in basis points for fixed income analytics (e.g., 500 bps for 5%).']
  rate_type varchar [note: 'Type of SOFR rate: overnight, compounded averages (30/90/180 day), or term rates (1M/3M/6M/12M). [ENUM-REF-CANDIDATE: overnight|30_day_average|90_day_average|180_day_average|term_1m|term_3m|term_6m|term_12m — 8 candidates stripped; promote to reference']
  rate_value decimal(12,8) [note: 'The published SOFR rate value expressed as a decimal percentage (e.g., 0.05 for 5%).']
  record_created_timestamp timestamp [note: 'Timestamp when this rate record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this rate record was last updated in the system.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this rate is used for regulatory reporting purposes (True if used, False otherwise).']
  revision_flag boolean [note: 'Indicates whether this rate has been revised after initial publication (True if revised, False if original).']
  revision_reason varchar [note: 'Explanation for why the rate was revised after initial publication.']
  revision_timestamp timestamp [note: 'Timestamp of the most recent revision to this rate record, if applicable.']
  source varchar [note: 'Source system or vendor from which the SOFR rate was obtained (Federal Reserve, CME, Bloomberg, Refinitiv).']
  spread_to_fed_funds decimal(10,4) [note: 'Spread in basis points between SOFR and the Federal Funds effective rate.']
  spread_to_ois decimal(10,4) [note: 'Spread in basis points between SOFR and the corresponding OIS rate, used for relative value analysis.']
  tenor_days varchar [note: 'Number of days in the tenor period for term SOFR rates (e.g., 30, 90, 180, 360).']
  volume_billions_usd decimal(18,2) [note: 'Total transaction volume in billions of USD underlying the SOFR calculation for overnight rates.']

  Note: 'Reference data time-series for SOFR (Secured Overnight Financing Rate) and related overnight/term rates (SOFR compounded in arrears, Term SOFR 1M/3M/6M/12M, SOFR OIS rates) published by the Federal Reserve Bank of New York and CME.'
}

Table credit.credit_mandate {
  credit_mandate_id varchar [pk, note: 'Unique identifier for the credit mandate record.']
  benchmark_index_id varchar [note: 'Foreign key linking to credit.benchmark_index. Business justification: Credit mandates reference benchmark indices for performance attribution and compliance.']
  approval_authority varchar [note: 'Name or title of the authority that approved this mandate (e.g., Investment Committee, Board of Directors).']
  approval_date date [note: 'Date when the mandate was formally approved by the governing authority.']
  asset_class_scope varchar [note: 'Comma-separated list of credit asset classes covered by this mandate (e.g., IG, HY, private credit, sovereign, structured products, T-Bills, SOFR-linked instruments).']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for mandate reporting and allocation amounts.']
  created_timestamp timestamp [note: 'Timestamp when this mandate record was first created in the system.']
  credit_quality_minimum varchar [note: 'Minimum credit rating threshold for investments (e.g., BBB-, B+, unrated allowed).']
  derivatives_allowed_flag boolean [note: 'Indicates whether derivatives (CDS, interest rate swaps, options) are permitted within this mandate.']
  document_reference varchar [note: 'Reference identifier or URL to the formal mandate documentation.']
  duration_maximum_years decimal(8,2) [note: 'Maximum allowable portfolio duration in years.']
  duration_minimum_years decimal(8,2) [note: 'Minimum allowable portfolio duration in years.']
  duration_target_years decimal(8,2) [note: 'Target portfolio duration in years for interest rate risk management.']
  esg_exclusion_list varchar [note: 'Comma-separated list of sectors or activities excluded based on ESG criteria (e.g., tobacco, weapons, fossil fuels).']
  esg_integration_level varchar [note: 'Level of ESG integration required for investments within this mandate.']
  geographic_concentration_limit_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be allocated to any single country or region.']
  hy_allocation_maximum_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be high yield securities.']
  hy_allocation_minimum_pct decimal(5,2) [note: 'Minimum percentage of portfolio that must be high yield securities.']
  ig_allocation_maximum_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be investment grade rated securities.']
  ig_allocation_minimum_pct decimal(5,2) [note: 'Minimum percentage of portfolio that must be investment grade rated securities.']
  inception_date date [note: 'Date when the credit mandate was established and became effective.']
  investment_strategy varchar [note: 'Description of the investment strategy and approach for this credit mandate (e.g., core plus, opportunistic, distressed, direct lending).']
  leverage_allowed_flag boolean [note: 'Indicates whether leverage is permitted within this mandate.']
  leverage_maximum_ratio decimal(5,2) [note: 'Maximum leverage ratio allowed (e.g., 1.5 means 150% gross exposure to NAV).']
  liquidity_requirement_days varchar [note: 'Minimum number of days within which a specified percentage of the portfolio must be liquidatable.']
  liquidity_threshold_pct decimal(5,2) [note: 'Percentage of portfolio that must meet the liquidity requirement timeframe.']
  mandate_code varchar [note: 'Unique business identifier or code assigned to the mandate for operational reference.']
  mandate_name varchar [note: 'Business name or title of the credit investment mandate.']
  mandate_status varchar [note: 'Current lifecycle status of the credit mandate.']
  mandate_type varchar [note: 'Classification of the mandate structure and management approach.']
  maximum_allocation_amount decimal(18,2) [note: 'Maximum investment amount constraint for this mandate in base currency.']
  minimum_allocation_amount decimal(18,2) [note: 'Minimum investment amount constraint for this mandate in base currency.']
  next_review_date date [note: 'Scheduled date for the next formal mandate review.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the mandate.']
  performance_target_return_pct decimal(5,2) [note: 'Target annualized return objective for the mandate expressed as a percentage.']
  performance_target_type varchar [note: 'Type of performance target (absolute return, relative to benchmark, or relative to liability growth).']
  portfolio_manager_name varchar [note: 'Name of the portfolio manager or team responsible for executing this mandate.']
  private_credit_allocation_maximum_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be allocated to private credit investments.']
  rebalancing_frequency varchar [note: 'Frequency at which the portfolio is rebalanced to target allocations.']
  rebalancing_threshold_pct decimal(5,2) [note: 'Percentage deviation from target allocation that triggers rebalancing.']
  review_frequency varchar [note: 'Scheduled frequency for formal mandate performance and compliance review.']
  sector_concentration_limit_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be allocated to any single industry sector.']
  single_issuer_limit_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be invested in securities from a single issuer.']
  sovereign_allocation_maximum_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be allocated to sovereign debt.']
  structured_products_allocation_maximum_pct decimal(5,2) [note: 'Maximum percentage of portfolio that can be allocated to structured credit products (ABS, MBS, CLO).']
  target_allocation_amount decimal(18,2) [note: 'Target investment amount allocated to this mandate in base currency.']
  termination_date date [note: 'Date when the mandate was or will be terminated; null for open-ended mandates.']
  tracking_error_limit_pct decimal(5,2) [note: 'Maximum allowable tracking error versus benchmark expressed as annualized standard deviation percentage.']
  updated_timestamp timestamp [note: 'Timestamp when this mandate record was last updated.']
  var_confidence_level_pct decimal(5,2) [note: 'Confidence level for VaR calculation (e.g., 95%, 99%).']
  var_limit_pct decimal(5,2) [note: 'Maximum allowable Value at Risk as a percentage of portfolio value at specified confidence level.']
  var_time_horizon_days varchar [note: 'Time horizon in days for VaR calculation (e.g., 1-day, 10-day).']

  Note: 'Master record defining the investment mandate parameters and constraints for each credit portfolio or sub-portfolio managed by the pension fund, capturing mandate name, asset class scope (IG, HY, private credit, sovereign, structured), minimum/maximum'
}

Table credit.spread_analytics {
  spread_analytics_id varchar [pk, note: 'Unique identifier for the spread analytics record.']
  fixed_income_security_id varchar [note: 'Identifier linking to the fixed income security.']
  portfolio_id varchar [note: 'Identifier linking to the portfolio containing the security.']
  event_source varchar [note: 'System that generated the analytics data.']
  event_timestamp timestamp [note: 'Timestamp of the analytics snapshot.']
  event_type varchar [note: 'Type of analytics event.']
  security_accrued_interest decimal(18,2) [note: 'Accrued interest on the security.']
  security_asset_swap_spread decimal(10,6) [note: 'Asset-swap spread of the security.']
  security_callability_flag boolean [note: 'Indicates if the security is callable.']
  security_convexity decimal(10,6) [note: 'Convexity of the security.']
  security_country_of_risk varchar [note: 'ISO 3166-1 alpha-3 country code of risk.']
  security_coupon_frequency varchar [note: 'Frequency of coupon payments.']
  security_coupon_rate decimal(10,6) [note: 'Annual coupon rate of the security.']
  security_credit_rating_fitch varchar [note: 'Fitch credit rating for the security.']
  security_credit_rating_moody varchar [note: 'Moody\'s credit rating for the security.']
  security_credit_rating_sp varchar [note: 'Standard & Poor\'s credit rating for the security.']
  security_currency varchar [note: 'ISO 4217 currency code for the security.']
  security_current_yield decimal(10,6) [note: 'Current yield of the security.']
  security_cusip varchar [note: 'Committee on Uniform Securities Identification Procedures number for the security.']
  security_default_flag boolean [note: 'Indicates if the security has defaulted.']
  security_duration decimal(10,6) [note: 'Macaulay duration of the security.']
  security_dv01 decimal(10,6) [note: 'Dollar value of a 1 basis point change in yield.']
  security_esg_rating varchar [note: 'ESG rating of the security.']
  security_face_value decimal(18,2) [note: 'Nominal value of the security.']
  security_g_spread decimal(10,6) [note: 'G-spread of the security.']
  security_green_bond_flag boolean [note: 'Indicates if the security is a green bond.']
  security_i_spread decimal(10,6) [note: 'I-spread of the security.']
  security_isin varchar [note: 'International Securities Identification Number for the security.']
  security_issue_date date [note: 'Date the security was issued.']
  security_issuer_lei varchar [note: 'Legal Entity Identifier of the security issuer.']
  security_liquidity_classification varchar [note: 'Liquidity classification of the security.']
  security_market_price decimal(18,2) [note: 'Current market price of the security.']
  security_market_value decimal(18,2) [note: 'Market value of the security position.']
  security_maturity_date date [note: 'Date the security matures.']
  security_modified_duration decimal(10,6) [note: 'Modified duration of the security.']
  security_option_adjusted_spread decimal(10,6) [note: 'Option-adjusted spread of the security.']
  security_reference_rate decimal(18,2) [note: 'Reference rate used for spread calculations.']
  security_sector varchar [note: 'Industry sector of the issuer.']
  security_sedol varchar [note: 'Stock Exchange Daily Official List code for the security.']
  security_spread_over_reference decimal(10,6) [note: 'Spread over the reference rate.']
  security_subordination_level varchar [note: 'Subordination level of the security.']
  security_type varchar [note: 'Classification of the security instrument.']
  security_yield_to_call decimal(10,6) [note: 'Yield to call of the security.']
  security_yield_to_maturity decimal(10,6) [note: 'Yield to maturity of the security.']
  security_yield_to_worst decimal(10,6) [note: 'Yield to worst scenario of the security.']
  security_z_spread decimal(10,6) [note: 'Z-spread of the security.']

  Note: 'Daily yield and spread analytics for each fixed income security and position, capturing yield to maturity (YTM), yield to worst (YTW), yield to call, current yield, option-adjusted spread (OAS), Z-spread, G-spread, asset-swap spread (ASW), I-spread, and'
}

Table credit.credit_allocation {
  credit_allocation_id varchar [pk, note: 'Primary key for the allocation association']
  collateral_position_id varchar [note: 'Foreign key linking to the collateral position providing security']
  credit_position_id varchar [note: 'Foreign key linking to credit.credit_position. Business justification: Critical missing FK. credit_allocation is described as \'association product between credit_position and collateral\' but only has collateral_position_id FK.']
  credit_allocation_status varchar [note: 'Current lifecycle state of the collateral allocation']
  effective_date date [note: 'The business date on which this collateral allocation became effective']
  percentage decimal(8,4) [note: 'The percentage of the credit position exposure that is secured by this specific collateral position. Enables fractional allocation of collateral across multiple exposures.']
  value decimal(20,2) [note: 'The monetary value of collateral allocated to this specific credit position, typically calculated as the collateral market value multiplied by the allocation percentage and adjusted for haircuts.']

  Note: 'This association product represents the Collateral Allocation between credit_position and collateral_position. It captures the operational record of how collateral assets are pledged or allocated against credit exposures for margin, regulatory, and risk'
}

Table credit.amortization_schedule {
  amortization_schedule_id varchar [pk, note: 'Primary key for amortization_schedule']
  credit_issuer_id varchar [note: 'Reference to the counterparty or entity responsible for making payments under this schedule.']
  custody_account_id varchar [note: 'Reference to the custodian account where payments are received and principal is held.']
  instrument_id varchar [note: 'Reference to the underlying credit instrument (bond, loan, private credit facility) for which this amortization schedule applies.']
  loan_servicer_id varchar [note: 'Reference to the entity responsible for administering and collecting payments on the instrument.']
  private_credit_facility_id varchar [note: 'Foreign key linking to credit.private_credit_facility. Business justification: Amortization schedules define payment structures for private credit facilities. The schedule tracks principal/interest payments over the life of the facility.']
  accrual_method varchar [note: 'Method used to calculate interest accrual between payment periods for accounting purposes.']
  amendment_date date [note: 'Date of the most recent amendment or modification to the amortization schedule terms.']
  amendment_reason varchar [note: 'Business reason for the most recent schedule modification such as restructuring or rate reset.']
  balloon_payment_amount decimal(18,2) [note: 'Large final payment amount due at maturity for balloon or bullet amortization structures.']
  base_interest_rate decimal(8,5) [note: 'Fixed interest rate or initial rate for floating instruments expressed as a decimal percentage for payment calculations.']
  business_day_convention varchar [note: 'Rule for adjusting payment dates that fall on non-business days to the appropriate business day.']
  compounding_frequency varchar [note: 'Frequency at which interest is compounded for compound interest calculations.']
  created_timestamp timestamp [note: 'Timestamp when this amortization schedule record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this amortization schedule.']
  day_count_convention varchar [note: 'Method used to calculate accrued interest between payment dates per fixed income market standards.']
  effective_date date [note: 'Date when the amortization schedule becomes effective and payments commence according to the defined structure.']
  grace_period_days varchar [note: 'Number of days after the scheduled payment date before a payment is considered delinquent.']
  interest_rate_type varchar [note: 'Classification of the interest rate structure applied to the amortization schedule calculations.']
  last_payment_amount decimal(18,2) [note: 'Total amount of the most recent payment received including principal and interest.']
  last_payment_date date [note: 'Date of the most recent amortization payment received or processed.']
  late_payment_fee_amount decimal(18,2) [note: 'Fixed fee amount charged when a payment is received after the grace period expires.']
  late_payment_fee_rate decimal(8,5) [note: 'Percentage-based late fee applied to overdue payment amounts after grace period.']
  maturity_date date [note: 'Final date when all scheduled principal and interest payments are expected to be completed under normal circumstances.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to this amortization schedule record.']
  next_interest_payment decimal(18,2) [note: 'Interest portion of the next scheduled payment based on the current outstanding principal.']
  next_payment_amount decimal(18,2) [note: 'Total amount due on the next scheduled payment date including principal and interest components.']
  next_payment_date date [note: 'Date of the next scheduled amortization payment due under the current schedule.']
  next_principal_payment decimal(18,2) [note: 'Principal portion of the next scheduled payment that will reduce the outstanding balance.']
  notes varchar [note: 'Free-text field for additional comments or special instructions related to the amortization schedule.']
  original_principal_amount decimal(18,2) [note: 'Initial principal balance at schedule inception used as the basis for calculating amortization payments.']
  outstanding_principal_amount decimal(18,2) [note: 'Current remaining principal balance after accounting for all principal payments made to date.']
  payment_calendar_code varchar [note: 'Financial center calendar code used to determine business days for payment date adjustments.']
  payment_frequency varchar [note: 'Frequency at which scheduled amortization payments are due under the terms of the credit instrument.']
  payments_made_count varchar [note: 'Number of scheduled payments that have been successfully completed to date.']
  payments_remaining_count varchar [note: 'Number of scheduled payments remaining until maturity or expected payoff.']
  prepayment_allowed_flag boolean [note: 'Indicates whether early principal prepayments are permitted under the instrument terms.']
  prepayment_lockout_end_date date [note: 'Date until which prepayments are prohibited or subject to maximum penalty under call protection.']
  prepayment_penalty_rate decimal(8,5) [note: 'Percentage penalty applied to prepaid principal amounts if early repayment occurs.']
  reference_rate_index varchar [note: 'Benchmark interest rate index used for floating rate calculations such as SOFR, EURIBOR, or SONIA.']
  schedule_reference_code varchar [note: 'External business identifier for the amortization schedule used in reporting and counterparty communications.']
  schedule_status varchar [note: 'Current state of the amortization schedule in its lifecycle from creation through completion or early termination.']
  schedule_type varchar [note: 'Classification of the amortization structure defining how principal and interest payments are distributed over the instrument life.']
  schedule_version varchar [note: 'Version number tracking amendments or modifications to the original amortization schedule.']
  spread_basis_points varchar [note: 'Credit spread over the reference rate expressed in basis points for floating rate instruments.']
  total_scheduled_payments varchar [note: 'Total number of scheduled payment periods over the full life of the amortization schedule.']

  Note: 'Master reference table for amortization_schedule. Referenced by amortization_schedule_id.'
}

Table credit.private_credit_facility {
  private_credit_facility_id varchar [pk, note: 'Primary key for private_credit_facility']
  credit_issuer_id varchar [note: 'Reference to the counterparty entity that is the borrower under this credit facility.']
  fund_id varchar [note: 'Reference to the internal fund or investment vehicle providing capital for this facility.']
  gp_profile_id varchar [note: 'Reference to the private equity sponsor backing the borrower in sponsored transactions.']
  portfolio_id varchar [note: 'Reference to the portfolio under which this credit facility is managed and reported.']
  agent_bank_name varchar [note: 'Name of the administrative agent bank for syndicated facilities.']
  all_in_rate_percent decimal(7,4) [note: 'Current total interest rate percentage including base rate plus spread.']
  amortization_type varchar [note: 'Principal repayment structure defining scheduled amortization pattern.']
  base_rate_index varchar [note: 'Reference rate benchmark used for floating rate calculations on the facility.']
  borrower_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the borrowers primary jurisdiction.']
  call_protection_months varchar [note: 'Number of months during which prepayment is restricted or penalized.']
  commitment_amount decimal(18,2) [note: 'Total committed capital amount that the lender agrees to make available under the facility.']
  commitment_fee_bps varchar [note: 'Annual fee in basis points charged on unfunded commitment amounts.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the facility denomination.']
  day_count_convention varchar [note: 'Interest calculation convention specifying how days are counted for accrual.']
  deal_source varchar [note: 'Origination channel indicating how the investment opportunity was sourced.']
  effective_date date [note: 'Date when the credit facility agreement becomes legally binding and effective.']
  esg_score decimal(5,2) [note: 'Composite ESG score assigned to the borrower for responsible investment assessment.']
  external_credit_rating varchar [note: 'Credit rating from external rating agency if available for the borrower or facility.']
  facility_name varchar [note: 'Descriptive name of the private credit facility for identification and reporting purposes.']
  facility_number varchar [note: 'External business identifier for the private credit facility used in deal documentation and reporting.']
  facility_status varchar [note: 'Current lifecycle status of the private credit facility indicating operational state.']
  facility_type varchar [note: 'Classification of the credit facility structure determining repayment terms and priority.']
  fair_value decimal(18,2) [note: 'Current fair market value of the credit facility for portfolio valuation.']
  fair_value_date date [note: 'As-of date for the most recent fair value measurement.']
  floor_rate_percent decimal(5,4) [note: 'Minimum interest rate floor as a percentage protecting lender from low rate environments.']
  funded_amount decimal(18,2) [note: 'Current outstanding principal amount that has been drawn and funded under the facility.']
  has_pik_feature boolean [note: 'Indicates whether the facility allows payment-in-kind interest capitalization.']
  industry_sector varchar [note: 'Primary industry classification of the borrower for sector exposure analysis.']
  interest_rate_type varchar [note: 'Classification of interest rate structure as fixed, floating, or hybrid combination.']
  internal_risk_rating varchar [note: 'Proprietary credit risk rating assigned by internal credit committee.']
  is_covenant_lite boolean [note: 'Indicates whether the facility has limited or no maintenance covenants.']
  is_syndicated boolean [note: 'Indicates whether the facility is part of a syndicated loan arrangement.']
  legal_entity_identifier varchar [note: 'LEI code of the borrower for regulatory reporting and counterparty identification.']
  loss_given_default_percent decimal(7,4) [note: 'Expected loss percentage of exposure in the event of borrower default.']
  maturity_date date [note: 'Scheduled final repayment date when all outstanding principal and interest are due.']
  origination_date date [note: 'Date when the credit facility was originally underwritten and closed.']
  payment_frequency varchar [note: 'Frequency of scheduled interest and principal payments under the facility.']
  prepayment_penalty_percent decimal(5,4) [note: 'Percentage penalty fee charged for early voluntary prepayment of principal.']
  probability_of_default_percent decimal(7,4) [note: 'Estimated one-year probability of default percentage for credit risk modeling.']
  record_created_timestamp timestamp [note: 'System timestamp when this facility record was first created in the data platform.']
  security_type varchar [note: 'Type of collateral security or lien position supporting the credit facility.']
  seniority_rank varchar [note: 'Position in the capital structure determining payment priority in default scenarios.']
  spread_bps varchar [note: 'Credit spread in basis points added to the base rate to determine all-in interest rate.']
  unfunded_commitment decimal(18,2) [note: 'Remaining undrawn commitment amount available for future drawdowns by the borrower.']
  upfront_fee_percent decimal(5,4) [note: 'One-time origination fee percentage charged at facility closing.']

  Note: 'Master reference table for private_credit_facility. Referenced by private_credit_facility_id.'
}

Table deal.opportunity {
  opportunity_id varchar [pk, note: 'Unique identifier for the investment opportunity record. Primary key for the opportunity entity.']
  asset_class_outlook_id varchar [note: 'Foreign key linking to research.asset_class_outlook. Business justification: Every deal opportunity is evaluated against asset class return expectations and allocation targets. IC presentations compare deal IRR to asset class outlook expected returns.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Opportunities undergo ESG stress testing under a selected climate scenario to evaluate resilience to climate risks.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Global pension funds assess country risk for every cross-border deal. IC submissions require country outlook assessment for sovereign/political risk.']
  data_provider_id varchar [note: 'Foreign key linking to esg.data_provider. Business justification: ESG data for an opportunity is sourced from a specific data provider; tracking the provider ensures data provenance.']
  esg_benchmark_id varchar [note: 'Foreign key linking to esg.esg_benchmark. Business justification: Opportunities are benchmarked against a chosen ESG benchmark to assess relative performance and risk.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Every opportunity must align with a defined ESG policy that sets inclusion/exclusion criteria for the pension fund.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Each opportunity is evaluated against a specific ESG framework; the investment team selects the framework during opportunity creation.']
  origination_source_id varchar [note: 'Foreign key linking to deal.origination_source. Business justification: Opportunity records originate from a specific source; adding a FK to origination_source links the siloed origination_source table and captures the source of each opportunity.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Deal screening and IC presentations require current sector views. Investment committees evaluate opportunities against sector outlook ratings and conviction levels.']
  target_entity_id varchar [note: 'Foreign key linking to deal.target_entity. Business justification: Opportunity should reference the target entity; adding a FK to target_entity removes redundant columns and ensures consistency across the model.']
  actual_close_date date [note: 'Actual date on which the transaction closed and capital was deployed, if applicable.']
  asset_class varchar [note: 'Primary asset class category of the opportunity aligned with Strategic Asset Allocation (SAA) framework.']
  confidentiality_level varchar [note: 'Data classification level governing access and distribution of opportunity information within the organization.']
  created_timestamp timestamp [note: 'System timestamp indicating when the opportunity record was first created in the pipeline management system.']
  data_room_url varchar [note: 'Web address or link to the virtual data room containing confidential due diligence materials for the opportunity.']
  decline_reason varchar [note: 'Primary rationale for declining or passing on the opportunity, captured for pipeline analytics and lessons learned.']
  esg_exclusion_flag boolean [note: 'Boolean indicator of whether the opportunity triggers any ESG exclusion criteria per the funds responsible investment policy.']
  esg_rating varchar [note: 'Preliminary Environmental, Social, and Governance rating or score assigned during initial screening, aligned with MSCI ESG or equivalent rating methodology.']
  expected_close_date date [note: 'Anticipated date for final transaction closing and capital deployment.']
  expected_hold_period_years decimal(4,1) [note: 'Anticipated investment holding period in years from initial capital deployment to full exit or realization.']
  expected_investment_amount decimal(18,2) [note: 'Anticipated capital commitment or investment size in base currency for this opportunity.']
  gp_sponsor_name varchar [note: 'Name of the General Partner, fund manager, or sponsor presenting or managing the opportunity.']
  ic_decision varchar [note: 'Final decision outcome from the Investment Committee regarding the opportunity.']
  ic_decision_date date [note: 'Date on which the Investment Committee rendered a formal decision on the opportunity.']
  ic_submission_date date [note: 'Date on which the opportunity was formally submitted to the Investment Committee for approval consideration.']
  intermediary_name varchar [note: 'Name of the investment bank, advisor, or intermediary facilitating the opportunity, if applicable.']
  investment_currency varchar [note: 'ISO 4217 three-letter currency code for the expected investment amount.']
  investment_thesis varchar [note: 'High-level strategic rationale and value creation hypothesis for pursuing the opportunity, including expected return drivers and risk-adjusted return profile.']
  is_active boolean [note: 'Boolean flag indicating whether the opportunity is currently active in the pipeline or has been archived or closed.']
  last_modified_timestamp timestamp [note: 'System timestamp indicating when the opportunity record was most recently updated or modified.']
  lead_investment_professional varchar [note: 'Name of the internal investment team member responsible for originating and managing the opportunity through the pipeline.']
  loi_status varchar [note: 'Current status of the Letter of Intent submission indicating preliminary commitment interest.']
  loi_submission_date date [note: 'Date on which the Letter of Intent was formally submitted to the General Partner (GP) or seller.']
  nda_execution_date date [note: 'Date on which the Non-Disclosure Agreement was fully executed by all parties.']
  nda_status varchar [note: 'Current status of the Non-Disclosure Agreement required to access confidential information for the opportunity.']
  notes varchar [note: 'Free-text field for capturing additional context, observations, or commentary relevant to the opportunity evaluation and pipeline management.']
  opportunity_code varchar [note: 'Internal tracking code or reference number assigned to the opportunity for pipeline management and reporting purposes.']
  opportunity_name varchar [note: 'Business name or title of the investment opportunity as presented by the General Partner (GP) or intermediary.']
  opportunity_status varchar [note: 'Current lifecycle stage of the opportunity in the investment pipeline workflow. [ENUM-REF-CANDIDATE: prospecting|screening|due_diligence|ic_review|approved|declined|on_hold|closed — 8 candidates stripped; promote to reference product]']
  opportunity_type varchar [note: 'Classification of the investment structure: direct investment, co-investment alongside a General Partner (GP), fund commitment, secondary market transaction, joint venture, or club deal.']
  origination_date date [note: 'Date when the opportunity was first identified and entered into the deal pipeline system.']
  priority_tier varchar [note: 'Internal prioritization ranking for resource allocation and pipeline management, with Tier 1 representing highest priority opportunities.']
  risk_rating varchar [note: 'Preliminary risk assessment classification based on initial screening and due diligence findings.']
  sourcing_channel varchar [note: 'Method by which the opportunity was originated: proprietary off-market deal, GP-introduced, intermediated through advisor, inbound inquiry, or network referral.']
  strategic_fit_score varchar [note: 'Quantitative score (typically 1-10 scale) assessing alignment with Strategic Asset Allocation (SAA) and portfolio construction objectives.']
  sub_asset_class varchar [note: 'Granular sub-category within the primary asset class for detailed portfolio segmentation and reporting.']
  target_irr_percent decimal(5,2) [note: 'Expected annualized Internal Rate of Return (IRR) for the opportunity expressed as a percentage, used for investment committee evaluation.']
  target_moic decimal(5,2) [note: 'Expected gross multiple of invested capital (MOIC) representing total value divided by paid-in capital.']
  vintage_year varchar [note: 'Year in which the investment commitment or capital deployment is expected to occur, used for cohort analysis and performance benchmarking.']

  Note: 'Core master record (SSOT) for every investment opportunity entering the pipeline—off-market/proprietary, GP-introduced, or intermediated—across all asset classes.'
}

Table deal.pipeline_stage {
  pipeline_stage_id varchar [pk, note: 'Unique identifier for the pipeline stage record.']
  alternate_exit_stages varchar [note: 'Comma-separated list of stage codes representing valid non-sequential exit paths (e.g., rejection, withdrawal, fast-track approval).']
  applicable_asset_classes varchar [note: 'Comma-separated list of asset classes for which this stage is applicable (e.g., Private Equity, Real Estate, Infrastructure, Credit). Empty if applicable to all.']
  applicable_deal_types varchar [note: 'Comma-separated list of deal types for which this stage is applicable (e.g., Direct Investment, Co-Investment, Fund Commitment, Secondary). Empty if applicable to all.']
  compliance_checkpoints varchar [note: 'Comma-separated list of regulatory, legal, or internal compliance checks required at this stage (e.g., KYC, AML, EMIR, SFDR pre-contractual disclosure).']
  created_timestamp timestamp [note: 'Timestamp when this pipeline stage record was first created in the system.']
  effective_from_date date [note: 'Date from which this pipeline stage definition became effective and available for use in deal workflows.']
  effective_to_date date [note: 'Date until which this pipeline stage definition remains effective. Null indicates the stage is currently active with no planned end date.']
  entry_criteria varchar [note: 'Textual description of conditions or prerequisites that must be met for a deal to enter this stage.']
  escalation_contact varchar [note: 'Role, title, or individual to whom deals are escalated when escalation threshold is breached.']
  escalation_threshold_days varchar [note: 'Number of days in stage after which automatic escalation or alert is triggered to senior management or deal governance committee.']
  esg_review_required boolean [note: 'Indicates whether an Environmental, Social, and Governance (ESG) assessment is required at this stage per PRI and SFDR obligations.']
  exit_criteria varchar [note: 'Textual description of conditions, deliverables, or approvals required for a deal to exit this stage and progress to the next.']
  governance_framework varchar [note: 'Reference to the governance policy, Investment Committee (IC) charter, or procedural document governing this stage.']
  ic_submission_required boolean [note: 'Indicates whether a formal Investment Committee (IC) submission and Investment Memorandum (IM) are required at this stage.']
  is_active boolean [note: 'Indicates whether this pipeline stage is currently active and available for use in deal workflows.']
  is_approval_gate boolean [note: 'Indicates whether this stage requires formal Investment Committee (IC) or other governance approval before progression.']
  is_terminal boolean [note: 'Indicates whether this stage represents a terminal state (deal closed, deal rejected, deal withdrawn) with no further progression.']
  legal_review_required boolean [note: 'Indicates whether legal counsel review and sign-off is required before exiting this stage.']
  maximum_dwell_days varchar [note: 'Maximum allowable calendar days in this stage before escalation or review is triggered, preventing pipeline stagnation.']
  minimum_dwell_days varchar [note: 'Minimum number of calendar days a deal must remain in this stage before progression, enforcing process discipline and thoroughness.']
  predecessor_stage_code varchar [note: 'Stage code of the immediately preceding stage in the standard pipeline sequence. Null for the first stage.']
  reporting_label varchar [note: 'Abbreviated or alternative label used for this stage in executive reports, dashboards, and external communications.']
  required_approvers varchar [note: 'Comma-separated list or structured text identifying roles or individuals whose approval is required to exit this stage (e.g., CIO, IC Chair, Legal Counsel).']
  required_deliverables varchar [note: 'Comma-separated list or structured text defining mandatory deliverables, documents, or milestones required for stage completion (e.g., NDA, LOI, IM, FDD report).']
  risk_assessment_required boolean [note: 'Indicates whether a formal risk assessment or risk rating is required before exiting this stage.']
  stage_category varchar [note: 'High-level grouping of the stage within the investment lifecycle (origination, screening, diligence, approval, execution, post-close).']
  stage_code varchar [note: 'Short alphanumeric code uniquely identifying the pipeline stage (e.g., SCREEN, DD, IC_PREP, IC_APPR, CLOSING).']
  stage_color_code varchar [note: 'Hexadecimal color code used for visual representation of this stage in dashboards and reporting tools (e.g., #4CAF50 for green).']
  stage_description varchar [note: 'Detailed narrative description of the purpose, activities, and objectives of this pipeline stage.']
  stage_icon varchar [note: 'Icon identifier or Unicode character used for visual representation of this stage in user interfaces.']
  stage_name varchar [note: 'Full descriptive name of the pipeline stage (e.g., Initial Screening, Due Diligence, Investment Committee Approval).']
  stage_notes varchar [note: 'Free-form text field for additional notes, guidance, or context relevant to this pipeline stage.']
  stage_owner_role varchar [note: 'Role or function responsible for managing and driving deals through this stage (e.g., Deal Lead, Due Diligence Manager, Legal Counsel).']
  stage_sequence varchar [note: 'Numeric ordering of the stage within the deal pipeline lifecycle, enabling chronological sorting and progression tracking.']
  stage_type varchar [note: 'Classification indicating whether the stage is mandatory for all deals, optional, or conditional based on deal characteristics.']
  successor_stage_code varchar [note: 'Stage code of the immediately following stage in the standard pipeline sequence. Null for terminal stages.']
  target_dwell_days varchar [note: 'Target number of calendar days for deal completion within this stage, used for pipeline velocity tracking and performance management.']
  updated_by varchar [note: 'User identifier or name of the individual who last modified this pipeline stage record.']
  updated_timestamp timestamp [note: 'Timestamp when this pipeline stage record was last modified.']
  valuation_required boolean [note: 'Indicates whether a formal valuation (DCF, comparable company analysis, or third-party appraisal) is required at this stage.']
  version_number varchar [note: 'Version number of this stage definition, incremented when stage attributes, criteria, or deliverables are modified.']
  created_by varchar [note: 'User identifier or name of the individual who created this pipeline stage record.']

  Note: 'Reference taxonomy defining the ordered stages of the deal pipeline lifecycle—from initial screening through IC approval and closing. Captures stage code, stage name, stage sequence order, minimum dwell days, required deliverables checklist, stage'
}

Table deal.stage_transition {
  stage_transition_id varchar [pk, note: 'Unique identifier for the stage transition event record.']
  deal_ic_submission_id varchar [note: 'Reference to the Investment Committee submission record associated with this transition.']
  employee_id varchar [note: 'Reference to the user who approved or executed this stage transition.']
  opportunity_id varchar [note: 'Reference to the deal opportunity that underwent this stage transition.']
  pipeline_stage_id varchar [note: 'Foreign key linking to deal.pipeline_stage. Business justification: Stage_transition records transitions between pipeline stages; adding a FK to pipeline_stage enforces referential integrity and connects the siloed pipeline_stage table.']
  approving_committee varchar [note: 'Name of the Investment Committee or governance body that approved this transition, if applicable.']
  approving_user_name varchar [note: 'Full name of the user who approved or executed this stage transition, captured for audit trail.']
  conditions_imposed varchar [note: 'List of conditions or requirements imposed as part of a conditional approval decision.']
  cumulative_days_in_pipeline varchar [note: 'Total number of calendar days the opportunity has been in the pipeline as of this transition.']
  days_in_prior_stage varchar [note: 'Number of calendar days the opportunity spent in the prior stage before this transition.']
  decision_outcome varchar [note: 'Result of the gate or screening decision: pass (approved to advance), fail (rejected), conditional (approved with conditions), deferred (postponed), withdrawn (sponsor pulled).']
  decision_type varchar [note: 'Nature of the decision that triggered the transition: automatic (system-driven), manual (user-initiated), ic_decision (Investment Committee), screening (preliminary filter), gate_review (formal checkpoint).']
  gate_criteria_checklist varchar [note: 'Summary of gate criteria evaluated and their pass/fail status for this transition.']
  gate_criteria_met boolean [note: 'Indicates whether all formal gate criteria were satisfied for this transition.']
  ic_approval_received boolean [note: 'Indicates whether Investment Committee approval was obtained for this transition.']
  ic_meeting_date date [note: 'Date of the Investment Committee meeting where this transition decision was made, if applicable.']
  is_active boolean [note: 'Indicates whether this stage transition record is currently active and valid for reporting.']
  is_milestone_transition boolean [note: 'Indicates whether this transition represents a major milestone in the deal lifecycle.']
  milestone_name varchar [note: 'Name of the milestone achieved if this is a milestone transition.']
  new_stage_code varchar [note: 'Code representing the pipeline stage the opportunity moved to in this transition.']
  new_stage_name varchar [note: 'Human-readable name of the pipeline stage the opportunity moved to in this transition.']
  notification_sent boolean [note: 'Indicates whether stakeholder notifications were sent for this stage transition.']
  notification_timestamp timestamp [note: 'Date and time when stakeholder notifications were sent for this transition.']
  prior_stage_code varchar [note: 'Code representing the pipeline stage the opportunity was in before this transition.']
  prior_stage_name varchar [note: 'Human-readable name of the pipeline stage the opportunity was in before this transition.']
  record_created_by varchar [note: 'User or system identifier that created this stage transition record.']
  record_created_timestamp timestamp [note: 'Date and time when this stage transition record was first created in the system.']
  record_updated_by varchar [note: 'User or system identifier that last modified this stage transition record.']
  record_updated_timestamp timestamp [note: 'Date and time when this stage transition record was last modified.']
  rejection_reason varchar [note: 'Specific reason for rejection if the transition represents a negative decision or deal termination.']
  requires_ic_approval boolean [note: 'Indicates whether this stage transition required formal Investment Committee approval.']
  source_system_code varchar [note: 'Unique identifier of this transition record in the source operational system.']
  supporting_document_count varchar [note: 'Number of supporting documents attached to this stage transition for audit and review purposes.']
  system_generated boolean [note: 'Indicates whether this transition was automatically generated by the system versus manually recorded by a user.']
  transition_date date [note: 'Calendar date of the stage transition, used for day-level reporting and analytics.']
  transition_notes varchar [note: 'Free-text notes and commentary captured during the stage transition, providing additional context.']
  transition_number varchar [note: 'Business-facing identifier for this stage transition event, used for audit trail and reporting purposes.']
  transition_reason_code varchar [note: 'Standardized code indicating the primary reason for the stage transition.']
  transition_reason_description varchar [note: 'Detailed explanation of why the stage transition occurred, capturing business rationale and context.']
  transition_sequence_number varchar [note: 'Sequential order of this transition within the opportunity lifecycle, starting from 1.']
  transition_timestamp timestamp [note: 'Precise date and time when the stage transition occurred, capturing the business event moment.']
  transition_type varchar [note: 'Classification of the transition movement: advance (forward progress), retreat (moved back), reopen (reactivated), reject (declined), approve (gate passed), hold (paused).']

  Note: 'Transactional audit record capturing every pipeline-gate event for an opportunity—both mechanical stage advances and formal go/no-go screening decisions. Records the opportunity, prior stage, new stage, transition date/timestamp, approving'
}

Table deal.nda {
  nda_id varchar [pk, note: 'Unique identifier for the non-disclosure agreement record.']
  counterparty_id varchar [note: 'Reference to the legal entity with whom the NDA is executed.']
  counterparty_legal_entity_counterparty_id varchar [note: 'Reference to the legal entity with whom the NDA is executed.']
  deal_opportunity_id varchar [note: 'Reference to the deal opportunity this NDA supports.']
  employee_id varchar [note: 'Reference to the user who created this NDA record.']
  last_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this NDA record.']
  opportunity_id varchar [note: 'Reference to the deal opportunity this NDA supports.']
  superseded_by_nda_id varchar [note: 'Reference to a subsequent NDA that replaces or supersedes this agreement.']
  asset_class varchar [note: 'Primary asset class associated with the deal opportunity covered by this NDA.']
  breach_description varchar [note: 'Detailed description of the nature and circumstances of any reported NDA breach.']
  breach_reported_flag boolean [note: 'Indicates whether a breach or suspected breach of the NDA has been reported.']
  confidentiality_period_years decimal(5,2) [note: 'Duration in years for which confidential information must be protected under the NDA.']
  counterparty_signatory_name varchar [note: 'Full name of the individual who signed the NDA on behalf of the counterparty.']
  counterparty_signatory_title varchar [note: 'Job title or role of the counterparty signatory (e.g., Chief Executive Officer, General Counsel).']
  created_timestamp timestamp [note: 'Timestamp when this NDA record was first created in the system.']
  data_room_access_granted_flag boolean [note: 'Indicates whether the NDA has been executed and data room access has been granted to the investment team.']
  data_room_url varchar [note: 'Web address or link to the virtual data room where confidential materials are hosted.']
  deal_origination_source varchar [note: 'Channel through which the deal opportunity was sourced, determining NDA negotiation context.']
  disclosure_to_advisors_permitted_flag boolean [note: 'Indicates whether the NDA permits disclosure of confidential information to external advisors (legal, financial, operational) under confidentiality.']
  dispute_resolution_mechanism varchar [note: 'Agreed method for resolving disputes arising under the NDA.']
  document_storage_location varchar [note: 'File path or document management system reference where the executed NDA is stored.']
  effective_date date [note: 'Date from which the confidentiality obligations under the NDA commence.']
  estimated_deal_size_usd_millions decimal(15,2) [note: 'Estimated transaction size in millions of US dollars at the time of NDA execution.']
  execution_date date [note: 'Date on which the NDA was fully executed by all parties and became legally binding.']
  expiry_date date [note: 'Date on which the NDA confidentiality obligations expire, if applicable. Null for perpetual NDAs.']
  external_counsel_firm varchar [note: 'Name of the external law firm that advised on or reviewed the NDA, if applicable.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of the NDA (e.g., New York, England and Wales).']
  intermediary_firm_name varchar [note: 'Name of the investment bank, broker, or advisor facilitating the deal, if applicable.']
  internal_counsel_approval_flag boolean [note: 'Indicates whether the NDA has been reviewed and approved by internal legal counsel.']
  internal_signatory_name varchar [note: 'Full name of the individual who signed the NDA on behalf of the pension fund.']
  internal_signatory_title varchar [note: 'Job title or role of the internal signatory (e.g., Senior Managing Director, Chief Investment Officer).']
  is_perpetual boolean [note: 'Indicates whether the NDA has no expiry date and confidentiality obligations continue indefinitely.']
  last_modified_timestamp timestamp [note: 'Timestamp when this NDA record was last updated.']
  nda_status varchar [note: 'Current lifecycle status of the NDA indicating its enforceability and workflow state.']
  nda_type varchar [note: 'Classification of the NDA structure: mutual (both parties bound), one-way (unilateral), or multilateral (multiple parties).']
  non_solicitation_flag boolean [note: 'Indicates whether the NDA includes a non-solicitation clause prohibiting hiring or soliciting employees of the disclosing party.']
  notes varchar [note: 'Free-text field for additional context, special terms, or internal observations regarding the NDA.']
  permitted_use_scope varchar [note: 'Description of the permitted purposes for which confidential information may be used (e.g., evaluation of investment opportunity, due diligence).']
  reference_number varchar [note: 'Externally-known unique reference number or code assigned to this NDA for tracking and retrieval.']
  regulatory_disclosure_carveout_flag boolean [note: 'Indicates whether the NDA includes a carveout permitting disclosure to regulatory authorities or as required by law.']
  remediation_action_taken varchar [note: 'Description of corrective or remedial actions taken in response to an NDA breach.']
  return_or_destroy_obligation_flag boolean [note: 'Indicates whether the NDA requires the receiving party to return or destroy confidential materials upon request or termination.']
  standstill_period_months varchar [note: 'Duration in months for which the standstill provision applies, if present.']
  standstill_provision_flag boolean [note: 'Indicates whether the NDA includes a standstill clause restricting the counterparty from making unsolicited offers or acquiring securities.']
  target_company_name varchar [note: 'Name of the target company or asset that is the subject of the confidential evaluation.']
  target_geography varchar [note: 'Primary geographic location or jurisdiction of the target asset or company.']
  template_version varchar [note: 'Version identifier of the NDA template used as the basis for this agreement.']
  termination_date date [note: 'Date on which the NDA was formally terminated prior to its natural expiry, if applicable.']

  Note: 'Master record for Non-Disclosure Agreements executed in connection with deal origination and due diligence. Captures NDA type (mutual/one-way), counterparty legal entity, execution date, expiry date, governing law jurisdiction, NDA status (draft'
}

Table deal.loi {
  loi_id varchar [pk, note: 'Unique identifier for the Letter of Intent record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: LOIs are negotiated with counterparties. Linking enables credit/collateral status assessment during deal negotiation, supports counterparty due diligence, and enforces 3NF by removing']
  deal_opportunity_id varchar [note: 'Reference to the deal opportunity in the pipeline that this LOI supports.']
  opportunity_id varchar [note: 'Reference to the deal opportunity in the pipeline that this LOI supports.']
  superseded_by_loi_id varchar [note: 'Reference to a subsequent LOI that supersedes this one.']
  acceptance_date date [note: 'Date on which the counterparty formally accepted the LOI terms.']
  advisor_firm_name varchar [note: 'Name of the external advisory firm (investment bank, broker, consultant) facilitating the transaction.']
  asset_class varchar [note: 'Primary asset class category of the investment opportunity covered by this LOI.']
  break_fee_amount decimal(18,2) [note: 'Monetary penalty payable if either party terminates the LOI under specified conditions.']
  conditions_precedent varchar [note: 'Summary of key conditions that must be satisfied before the LOI becomes effective or binding.']
  confidentiality_clause_flag boolean [note: 'Indicates whether the LOI includes a confidentiality clause binding the parties.']
  created_timestamp timestamp [note: 'Timestamp when this LOI record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in the LOI.']
  deposit_amount decimal(18,2) [note: 'Good faith deposit or earnest money amount required under the LOI terms.']
  deposit_due_date date [note: 'Date by which the deposit amount must be paid.']
  due_diligence_period_days varchar [note: 'Number of days allocated for conducting due diligence as specified in the LOI.']
  exclusivity_end_date date [note: 'Date on which the exclusivity period ends.']
  exclusivity_flag boolean [note: 'Indicates whether the LOI includes an exclusivity provision preventing the seller from negotiating with other parties.']
  exclusivity_start_date date [note: 'Date from which the exclusivity period begins, preventing the seller from negotiating with other parties.']
  expiry_date date [note: 'Date on which the LOI terms expire and are no longer valid unless extended or accepted.']
  financing_contingency_flag boolean [note: 'Indicates whether the LOI is contingent upon securing financing.']
  geographic_region varchar [note: 'Primary geographic region or country where the target asset or entity operates.']
  governing_law varchar [note: 'Jurisdiction and legal framework governing the LOI (e.g., New York law, English law).']
  ic_approval_date date [note: 'Date on which the Investment Committee approved the LOI issuance.']
  ic_approval_required_flag boolean [note: 'Indicates whether Investment Committee approval is required before the LOI can be finalized.']
  ic_submission_date date [note: 'Date on which the LOI and supporting Investment Memorandum (IM) were submitted to the Investment Committee.']
  indicative_enterprise_value decimal(18,2) [note: 'Proposed total enterprise value of the target asset or company as stated in the LOI.']
  indicative_equity_value decimal(18,2) [note: 'Proposed equity value of the target asset or company as stated in the LOI.']
  investment_strategy varchar [note: 'Specific investment strategy or sub-strategy applicable to this LOI (e.g., growth equity, value-add real estate, core infrastructure).']
  issuance_date date [note: 'Date on which the LOI was formally issued to the counterparty.']
  lead_investment_professional varchar [note: 'Name of the lead investment professional or deal team member responsible for this LOI.']
  loi_status varchar [note: 'Current lifecycle state of the LOI in the negotiation process. [ENUM-REF-CANDIDATE: draft|issued|accepted|rejected|expired|withdrawn|superseded — 7 candidates stripped; promote to reference product]']
  loi_type varchar [note: 'Classification of the LOI indicating whether it creates legally binding obligations or is indicative only.']
  nda_reference_number varchar [note: 'Reference number of the NDA executed prior to LOI issuance.']
  notes varchar [note: 'Free-text field for additional comments, clarifications, or internal notes regarding the LOI.']
  number varchar [note: 'Externally-known unique business identifier for the LOI document.']
  proposed_deal_structure varchar [note: 'Type of transaction structure proposed in the LOI.']
  proposed_ownership_percentage decimal(5,2) [note: 'Percentage of ownership stake proposed to be acquired, expressed as a decimal (e.g., 51.00 for 51%).']
  regulatory_approval_required_flag boolean [note: 'Indicates whether the transaction requires regulatory or governmental approval.']
  rejection_date date [note: 'Date on which the counterparty formally rejected the LOI.']
  sector varchar [note: 'Industry sector of the target entity or asset (e.g., technology, healthcare, energy).']
  target_entity_name varchar [note: 'Legal name of the target company or asset being acquired.']
  target_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the target entity if available.']
  term_sheet_reference_number varchar [note: 'Reference number of the term sheet that preceded or accompanies this LOI.']
  updated_timestamp timestamp [note: 'Timestamp when this LOI record was last modified.']
  withdrawal_date date [note: 'Date on which the issuing party withdrew the LOI.']

  Note: 'Master record for Letters of Intent issued during deal origination and early negotiation. Captures LOI type (binding/non-binding), issuance date, expiry date, indicative enterprise value, indicative equity value, proposed deal structure, exclusivity'
}

Table deal.term_sheet {
  term_sheet_id varchar [pk, note: 'Unique identifier for the term sheet record. Primary key.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Term sheets specify deal terms with counterparties. Linking enables credit assessment during deal structuring, exposure monitoring, and enforces 3NF by removing denormalized']
  deal_opportunity_id varchar [note: 'Reference to the parent deal opportunity in the investment pipeline.']
  opportunity_id varchar [note: 'Reference to the parent deal opportunity in the investment pipeline.']
  advisor_firm_name varchar [note: 'Name of the external advisor or intermediary firm facilitating the transaction.']
  asset_class varchar [note: 'Primary asset class category for the proposed investment.']
  binding_status boolean [note: 'Indicates whether the term sheet is legally binding or non-binding.']
  carried_interest_percent decimal(5,2) [note: 'Percentage of profits allocated to the General Partner (GP) as performance fee.']
  closing_conditions varchar [note: 'Key conditions precedent that must be satisfied before transaction closing.']
  created_by_user varchar [note: 'User identifier of the person who created the term sheet record.']
  created_timestamp timestamp [note: 'Timestamp when the term sheet record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the investment amount.']
  deal_structure_type varchar [note: 'Proposed structure of the investment transaction.']
  document_storage_path varchar [note: 'File path or URI to the physical term sheet document in the document management system.']
  due_diligence_period_days varchar [note: 'Number of days allocated for completion of due diligence activities.']
  ebitda_multiple decimal(8,2) [note: 'Valuation multiple expressed as enterprise value divided by EBITDA.']
  enterprise_value decimal(18,2) [note: 'Proposed enterprise value of the target asset or company.']
  equity_value decimal(18,2) [note: 'Proposed equity value of the target asset or company.']
  esg_considerations varchar [note: 'Summary of ESG factors and responsible investment considerations relevant to the term sheet.']
  exclusivity_period_days varchar [note: 'Number of days during which the counterparty grants exclusive negotiation rights.']
  expiry_date date [note: 'Date by which the term sheet offer expires if not accepted.']
  governance_rights varchar [note: 'Summary of proposed governance rights including board seats, veto rights, and consent provisions.']
  hurdle_rate_percent decimal(5,2) [note: 'Minimum preferred return threshold before carried interest is earned, expressed as percentage.']
  ic_submission_planned_date date [note: 'Planned date for submission of the investment opportunity to the Investment Committee.']
  investment_horizon_years varchar [note: 'Expected holding period for the investment expressed in years.']
  investment_type varchar [note: 'Classification of the investment opportunity by transaction type.']
  issuance_date date [note: 'Date the term sheet was formally issued to the counterparty.']
  key_terms_summary varchar [note: 'High-level summary of the principal economic and structural terms of the proposed deal.']
  lead_investment_professional varchar [note: 'Name of the internal investment professional leading the term sheet negotiation.']
  loi_reference_number varchar [note: 'Reference number of the associated Letter of Intent if one was issued prior to term sheet.']
  management_fee_percent decimal(5,2) [note: 'Annual management fee percentage charged on committed or invested capital.']
  modified_by_user varchar [note: 'User identifier of the person who last modified the term sheet record.']
  modified_timestamp timestamp [note: 'Timestamp when the term sheet record was last modified.']
  nda_reference_number varchar [note: 'Reference number of the executed NDA governing confidentiality of term sheet discussions.']
  notes varchar [note: 'Free-form notes and comments regarding the term sheet negotiation and key discussion points.']
  number varchar [note: 'Business identifier for the term sheet, typically assigned by deal origination system.']
  ownership_percentage decimal(5,2) [note: 'Proposed ownership stake percentage in the target entity.']
  proposed_investment_amount decimal(18,2) [note: 'Total capital amount proposed for investment in base currency.']
  regulatory_approvals_required varchar [note: 'List of regulatory approvals or filings required to complete the transaction.']
  source_channel varchar [note: 'Channel through which the deal opportunity was sourced.']
  target_irr_percent decimal(5,2) [note: 'Target internal rate of return expressed as a percentage for the investment.']
  target_moic decimal(5,2) [note: 'Target multiple on invested capital for the investment opportunity.']
  term_sheet_status varchar [note: 'Current lifecycle status of the term sheet in the negotiation process.']
  valuation_basis varchar [note: 'Methodology or basis used for the indicative valuation in the term sheet.']
  version_number varchar [note: 'Sequential version number of the term sheet as negotiations progress.']

  Note: 'Master record for term sheets negotiated during deal structuring. Captures term sheet version, issuance date, counterparty, proposed deal structure (equity/debt/hybrid), indicative valuation basis, key economic terms (purchase price, EBITDA multiple, IRR'
}

Table deal.investment_memo {
  investment_memo_id varchar [pk, note: 'Unique identifier for the investment memorandum record. Primary key.']
  deal_opportunity_id varchar [note: 'Reference to the deal opportunity in the pipeline that this investment memorandum supports.']
  employee_id varchar [note: 'Employee identifier of the primary investment professional responsible for preparing the memorandum.']
  lead_author_employee_id varchar [note: 'Employee identifier of the primary investment professional responsible for preparing the memorandum.']
  opportunity_id varchar [note: 'Reference to the deal opportunity in the pipeline that this investment memorandum supports.']
  asset_class varchar [note: 'Primary asset class category of the investment opportunity covered in this memorandum.']
  commitment_currency varchar [note: 'Three-letter ISO currency code for the proposed commitment amount.']
  competitive_landscape varchar [note: 'Assessment of the competitive environment, market positioning, and key competitors relevant to the target investment.']
  created_timestamp timestamp [note: 'System timestamp when this investment memorandum record was first created in the system.']
  deal_structure varchar [note: 'Proposed transaction structure including equity stake, debt instruments, preferred shares, or other investment vehicles.']
  deal_type varchar [note: 'Type of investment structure being proposed in the memorandum.']
  decision_date date [note: 'Date when the Investment Committee made a formal decision on the investment proposal.']
  document_location varchar [note: 'File path or URI reference to the full investment memorandum document stored in the document management system.']
  esg_rating varchar [note: 'Internal ESG assessment rating assigned to the target investment based on responsible investment criteria.']
  esg_summary varchar [note: 'Summary of key ESG considerations, risks, and opportunities identified during due diligence.']
  exit_strategy varchar [note: 'Planned exit approach for the investment, including potential exit routes such as IPO, strategic sale, secondary sale, or recapitalization.']
  expected_close_date date [note: 'Anticipated date when the investment transaction is expected to close and capital will be deployed.']
  ic_conditions varchar [note: 'Specific conditions or requirements stipulated by the Investment Committee that must be satisfied before proceeding with the investment.']
  ic_decision varchar [note: 'Final decision rendered by the Investment Committee on the investment proposal.']
  ic_decision_notes varchar [note: 'Additional commentary, rationale, or guidance provided by the Investment Committee regarding their decision.']
  ic_meeting_date date [note: 'Scheduled date of the Investment Committee meeting where this memorandum will be or was presented.']
  ic_recommendation varchar [note: 'Formal recommendation presented to the Investment Committee regarding the proposed investment.']
  investment_horizon_years varchar [note: 'Expected holding period for the investment measured in years from initial commitment to anticipated exit.']
  investment_thesis varchar [note: 'Core strategic rationale and value creation hypothesis supporting the investment recommendation.']
  is_active boolean [note: 'Boolean flag indicating whether this investment memorandum record is currently active and valid.']
  key_risks varchar [note: 'Summary of principal risks identified in the investment analysis, including market, operational, regulatory, and execution risks.']
  last_modified_timestamp timestamp [note: 'System timestamp when this investment memorandum record was last updated.']
  management_assessment varchar [note: 'Evaluation of the target company management team quality, experience, track record, and alignment with investment objectives.']
  memo_number varchar [note: 'Business identifier for the investment memorandum, typically formatted as IM-YYYY-NNNN.']
  memo_status varchar [note: 'Current lifecycle status of the investment memorandum in the approval workflow.']
  mitigation_strategies varchar [note: 'Proposed strategies and actions to mitigate identified investment risks.']
  preparation_date date [note: 'Date when the investment memorandum was initially prepared by the investment team.']
  proposed_commitment_amount decimal(18,2) [note: 'Total capital commitment amount being recommended for Investment Committee approval, in base currency.']
  sub_asset_class varchar [note: 'Detailed sub-category within the primary asset class, providing granular investment classification.']
  submission_date date [note: 'Date when the investment memorandum was formally submitted to the Investment Committee for review and decision.']
  target_country varchar [note: 'Three-letter ISO country code representing the primary geographic location of the target asset or company headquarters.']
  target_description varchar [note: 'Detailed business description of the target company or asset, including operations, market position, and strategic rationale.']
  target_irr_percent decimal(5,2) [note: 'Projected internal rate of return expressed as a percentage, representing the expected annualized return on the investment.']
  target_moic decimal(5,2) [note: 'Projected multiple on invested capital, representing the total value expected to be returned relative to the initial investment.']
  target_name varchar [note: 'Name of the target company, asset, or fund that is the subject of the investment proposal.']
  target_region varchar [note: 'Broader geographic region classification of the target investment.']
  target_sector varchar [note: 'Primary industry sector or vertical of the target company or asset.']
  valuation_amount decimal(18,2) [note: 'Enterprise or asset valuation of the target at the proposed transaction price, in base currency.']
  valuation_currency varchar [note: 'Three-letter ISO currency code for the target valuation amount.']
  valuation_methodology varchar [note: 'Primary valuation approach used to determine target pricing, such as Discounted Cash Flow (DCF), comparable transactions, or Net Asset Value (NAV).']
  version_number varchar [note: 'Version number of the investment memorandum, incremented for each revision submitted to the Investment Committee (IC).']

  Note: 'Master record for Investment Memoranda (IM) prepared for IC submission. Captures IM version, preparation date, lead author, asset class, deal type, target company/asset name, recommended deal structure, proposed commitment amount, target IRR, target MOIC'
}

Table deal.deal_ic_submission {
  deal_ic_submission_id varchar [pk, note: 'Unique identifier for the Investment Committee submission record. Primary key for the deal IC submission entity.']
  actor_id varchar [note: 'Reference to the external advisor, investment bank, or intermediary that originated or facilitated the deal opportunity, if applicable.']
  deal_employee_id varchar [note: 'Reference to the investment professional or deal team lead responsible for originating and presenting this opportunity to the IC.']
  deal_external_advisor_employee_id varchar [note: 'Reference to the external advisor, investment bank, or intermediary that originated or facilitated the deal opportunity, if applicable.']
  deal_opportunity_id varchar [note: 'Reference to the underlying deal opportunity or pipeline record being submitted for IC approval.']
  employee_id varchar [note: 'Reference to the user or investment professional who created the IC submission record.']
  fee_benchmark_id varchar [note: 'Foreign key linking to fee.fee_benchmark. Business justification: Investment Committee approval process requires fee reasonableness assessment. IC members review proposed deal fees against market benchmarks to ensure fiduciary duty compliance and']
  gp_manager_gp_profile_id varchar [note: 'Reference to the General Partner or external fund manager for fund commitments or co-investments.']
  gp_profile_id varchar [note: 'Reference to the General Partner or external fund manager for fund commitments or co-investments.']
  ic_governance_record_id varchar [note: 'Foreign key linking to compliance.ic_governance_record. Business justification: IC submissions must link to formal governance meeting records for audit trail and regulatory compliance.']
  last_modified_by_user_employee_id varchar [note: 'Reference to the user who last modified the IC submission record.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: IC submissions reference applicable LDI strategy to demonstrate investment fits liability-driven framework.']
  lead_investment_professional_employee_id varchar [note: 'Reference to the investment professional or deal team lead responsible for originating and presenting this opportunity to the IC.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: IC submissions must demonstrate liability alignment. Pension fund governance requires IC to review how proposed investments support liability matching.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: IC submissions must specify target portfolio for pre-trade compliance validation against portfolio mandates, concentration limits, and SAA targets.']
  approval_conditions varchar [note: 'Text description of any conditions, covenants, or requirements attached to a conditional IC approval that must be satisfied before investment execution.']
  approved_commitment_amount decimal(18,2) [note: 'Actual investment commitment amount approved by the IC, which may differ from the requested amount in cases of conditional or partial approval.']
  asset_class varchar [note: 'Primary asset class category of the investment opportunity being submitted for IC approval. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|multi_asset — 8 candidates stripped; promote to']
  confidentiality_level varchar [note: 'Data classification level for the IC submission and associated materials, governing access and distribution controls.']
  created_timestamp timestamp [note: 'Timestamp when the IC submission record was first created in the system.']
  dd_completion_status varchar [note: 'Status of due diligence workstreams at the time of IC submission, indicating readiness for investment decision.']
  decision_date date [note: 'Date on which the Investment Committee rendered its final decision on this submission.']
  deferral_reason varchar [note: 'Text description of the reasons for deferring the IC decision to a future meeting, including any additional information or analysis requested.']
  esg_rating varchar [note: 'ESG assessment rating assigned to the investment opportunity based on responsible investment criteria.']
  expected_irr_percent decimal(5,2) [note: 'Projected Internal Rate of Return for the investment as presented in the Investment Memorandum, expressed as a percentage.']
  expected_moic decimal(5,2) [note: 'Projected Multiple on Invested Capital for the investment as presented in the Investment Memorandum.']
  ic_decision varchar [note: 'Final decision rendered by the Investment Committee on this submission.']
  ic_feedback varchar [note: 'Free-text feedback, questions, or guidance provided by IC members during or after the review of this submission.']
  ic_type varchar [note: 'Type or level of IC review being requested: preliminary review, full committee approval, special session, emergency approval, or written consent.']
  investment_horizon_years varchar [note: 'Expected holding period or investment horizon for the opportunity, expressed in years.']
  investment_memo_version varchar [note: 'Version identifier of the Investment Memorandum document submitted to the IC for this opportunity.']
  investment_strategy varchar [note: 'Specific investment strategy or sub-strategy within the asset class, such as growth equity, value-add real estate, or core infrastructure.']
  investment_structure varchar [note: 'Structure of the proposed investment: direct investment, co-investment alongside a GP, fund commitment, secondary purchase, or separately managed account.']
  last_modified_timestamp timestamp [note: 'Timestamp when the IC submission record was last updated or modified.']
  presentation_document_uri varchar [note: 'URI or file path reference to the IC presentation deck or Investment Memorandum document submitted for this opportunity.']
  rejection_rationale varchar [note: 'Text description of the reasons and rationale provided by the IC for rejecting the investment submission.']
  requested_commitment_amount decimal(18,2) [note: 'Total investment commitment amount being requested for IC approval, expressed in the base currency.']
  requested_commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the requested commitment amount.']
  risk_rating varchar [note: 'Overall risk assessment rating for the investment opportunity as evaluated by the investment and risk teams.']
  scheduled_ic_meeting_date date [note: 'Date on which the IC meeting is scheduled to review and vote on this submission.']
  sponsoring_department varchar [note: 'Internal department or investment team sponsoring the IC submission, such as Private Equity, Real Estate, or Infrastructure.']
  strategic_alignment_score varchar [note: 'Quantitative score indicating how well the investment aligns with the funds Strategic Asset Allocation and investment objectives, typically on a scale of 1-10.']
  submission_date date [note: 'Date on which the IC submission package was formally submitted to the Investment Committee for review.']
  submission_notes varchar [note: 'Free-text notes or commentary from the deal team providing additional context, updates, or clarifications for the IC submission.']
  submission_reference_number varchar [note: 'Business-facing unique reference number or code assigned to this IC submission for tracking and communication purposes.']
  submission_status varchar [note: 'Current lifecycle status of the IC submission indicating its position in the approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|conditional_approval|withdrawn|deferred — 8 candidates stripped; promote to reference']
  supporting_materials_uri varchar [note: 'URI or file path reference to supporting materials, appendices, or due diligence reports accompanying the IC submission.']
  target_entity_name varchar [note: 'Name of the target company, asset, fund, or entity that is the subject of the investment opportunity.']
  target_geography varchar [note: 'Primary geographic region or country where the target investment is domiciled or operates.']
  target_sector varchar [note: 'Industry sector or sub-sector of the target investment, such as technology, healthcare, energy, or consumer goods.']
  votes_abstained varchar [note: 'Number of IC members who abstained from voting on the investment submission due to conflicts of interest or other reasons.']
  votes_against varchar [note: 'Number of IC members who voted against approving the investment submission.']
  votes_in_favor varchar [note: 'Number of IC members who voted in favor of approving the investment submission.']
  voting_quorum_met boolean [note: 'Boolean flag indicating whether the required quorum of IC members was present for a valid vote on this submission.']

  Note: 'Transactional record capturing each formal Investment Committee (IC) submission for deal approval. Records the opportunity, investment memo version, submission date, IC meeting date, IC type (preliminary/full/special), requested commitment amount'
}

Table deal.deal_ic_condition {
  deal_ic_condition_id varchar [pk, note: 'Unique identifier for the Investment Committee condition record. Primary key for the deal IC condition entity.']
  deal_ic_submission_id varchar [note: 'Reference to the parent IC submission that this condition is attached to. Links condition to the specific investment approval request.']
  deal_opportunity_id varchar [note: 'Reference to the underlying deal or investment opportunity that this condition relates to. Enables direct linkage to deal pipeline.']
  opportunity_id varchar [note: 'Reference to the underlying deal or investment opportunity that this condition relates to. Enables direct linkage to deal pipeline.']
  breach_date date [note: 'Date on which the condition was determined to be breached, either through non-satisfaction by the due date or violation of an ongoing covenant.']
  breach_description varchar [note: 'Detailed description of the nature and circumstances of the condition breach, including materiality assessment and remediation actions.']
  condition_category varchar [note: 'Functional category of the condition indicating which workstream or domain it pertains to for assignment and tracking purposes. [ENUM-REF-CANDIDATE: legal|financial|operational|esg|regulatory|commercial|technical — 7 candidates stripped; promote to']
  condition_description varchar [note: 'Detailed narrative description of the condition requirement as documented in the IC approval resolution or investment memorandum.']
  condition_notes varchar [note: 'Additional notes, comments, or context regarding the condition, its interpretation, satisfaction progress, or any special circumstances.']
  condition_number varchar [note: 'Business-facing reference number or code assigned to this condition for tracking and communication purposes.']
  condition_owner varchar [note: 'Name or identifier of the individual or team responsible for ensuring the condition is satisfied and providing evidence of completion.']
  condition_rationale varchar [note: 'Business justification or risk mitigation rationale explaining why the IC imposed this condition on the investment approval.']
  condition_status varchar [note: 'Current lifecycle status of the condition indicating whether it remains outstanding, has been fulfilled, or has been waived by authorized parties.']
  condition_type varchar [note: 'Classification of the condition based on timing and enforceability. Pre-close must be satisfied before transaction closes, post-close after closing, ongoing covenant throughout holding period.']
  created_timestamp timestamp [note: 'System timestamp indicating when this condition record was first created in the deal management system, typically following IC approval.']
  due_date date [note: 'Target date by which the condition must be satisfied or reported on, as specified in the IC resolution or subsequent tracking updates.']
  escalation_date date [note: 'Date on which the condition issue was escalated to senior management or Investment Committee for review and decision.']
  escalation_required boolean [note: 'Indicator of whether the condition status or breach requires escalation to senior management or the Investment Committee for resolution.']
  evidence_document_reference varchar [note: 'Reference identifier or location of the documentation evidencing satisfaction of the condition, stored in data room or document management system.']
  ic_meeting_date date [note: 'Date of the Investment Committee meeting at which this condition was imposed as part of the investment approval resolution.']
  ic_resolution_reference varchar [note: 'Reference number or identifier of the formal IC resolution document that contains the condition language and approval terms.']
  is_active boolean [note: 'Flag indicating whether this condition record is currently active and relevant, or has been archived or superseded by subsequent IC actions.']
  last_modified_by varchar [note: 'Identifier of the user or system process that last modified this condition record, supporting audit trail and accountability requirements.']
  last_modified_timestamp timestamp [note: 'System timestamp of the most recent update to this condition record, tracking changes to status, evidence, or other attributes over time.']
  monitoring_frequency varchar [note: 'Frequency at which ongoing covenant conditions must be monitored and reported on to ensure continued compliance throughout the investment holding period.']
  next_review_date date [note: 'Scheduled date for the next review or monitoring check of this condition, particularly relevant for ongoing covenants and post-close conditions.']
  priority_level varchar [note: 'Priority ranking assigned to the condition reflecting its materiality and urgency for investment execution or ongoing compliance.']
  remediation_plan varchar [note: 'Description of the action plan to address a breached or at-risk condition, including timeline and responsible parties for remediation activities.']
  responsible_party varchar [note: 'Classification of the party responsible for fulfilling the condition, distinguishing between internal teams, external managers, counterparties, or advisors.']
  satisfaction_date date [note: 'Actual date on which the condition was confirmed as satisfied and evidence was accepted by the responsible oversight function.']
  verification_date date [note: 'Date on which the verification of condition satisfaction was completed and documented by the responsible oversight function.']
  verification_method varchar [note: 'Method or process used to verify and confirm satisfaction of the condition, ensuring appropriate level of assurance based on condition materiality.']
  verified_by varchar [note: 'Name or identifier of the individual or team that performed the verification and confirmed satisfaction of the condition.']
  waiver_authority varchar [note: 'Name or role of the individual or committee that authorized the waiver of this condition, ensuring proper governance and accountability.']
  waiver_date date [note: 'Date on which the condition was formally waived by authorized parties, typically documented in IC minutes or delegated authority records.']
  waiver_rationale varchar [note: 'Business justification and risk assessment supporting the decision to waive the condition rather than require full satisfaction.']
  created_by varchar [note: 'Identifier of the user or system process that created this condition record, supporting audit trail and data lineage requirements.']

  Note: 'Master record for conditions attached to IC approvals. Captures the IC submission, condition description, condition type (pre-close, post-close, ongoing covenant), condition owner, due date, condition status (open, satisfied, waived, breached)'
}

Table deal.team {
  team_id varchar [pk, note: 'Unique identifier for the deal_team data product (auto-inserted during validation).']
  employee_id varchar [note: 'User identifier of the person who created this deal team assignment record.']
  last_modified_by_user_employee_id varchar [note: 'User identifier of the person who last modified this deal team assignment record.']
  opportunity_id varchar [note: 'Reference to the investment opportunity or deal pipeline record this team is assigned to.']
  team_approved_by_employee_id varchar [note: 'Reference to the employee who approved this team assignment.']
  team_employee_id varchar [note: 'Reference to the employee or team member assigned to this deal.']
  actual_hours decimal(10,2) [note: 'Actual total hours the team member has spent on this deal to date.']
  advisor_engagement_type varchar [note: 'Type of advisory engagement for external advisors: financial (financial due diligence), legal (legal counsel), technical (technical assessment), esg (ESG assessment), operational (operational due diligence), tax (tax advisory).']
  advisor_firm_name varchar [note: 'Name of the external advisory firm if the team member is an external advisor or consultant. Null for internal employees.']
  allocation_percentage decimal(5,2) [note: 'Percentage of the team member\'s time allocated to this deal, expressed as a decimal (e.g., 25.00 for 25% allocation).']
  approval_date date [note: 'Date when the team assignment was approved.']
  approval_status varchar [note: 'Approval status of the team member\'s assignment: pending (awaiting approval), approved (assignment confirmed), rejected (assignment not approved).']
  assignment_end_date date [note: 'Date when the team member\'s assignment to the deal ended or is expected to end. Null for ongoing assignments.']
  assignment_notes varchar [note: 'Free-text notes regarding the team member\'s assignment, responsibilities, or special considerations for this deal.']
  assignment_start_date date [note: 'Date when the team member was assigned to the deal.']
  assignment_status varchar [note: 'Current status of the team member\'s assignment: active (currently working), completed (assignment finished), suspended (temporarily paused), withdrawn (removed from deal).']
  conflict_check_date date [note: 'Date when the conflict of interest check was completed.']
  conflict_check_status varchar [note: 'Status of conflict of interest check for this team member on this deal: not_required (no check needed), pending (check in progress), cleared (no conflicts found), flagged (potential conflict identified).']
  cost_center_code varchar [note: 'Cost center code to which the team member\'s time and expenses on this deal are charged.']
  created_timestamp timestamp [note: 'Timestamp when this deal team assignment record was first created in the system.']
  data_room_access_date date [note: 'Date when the team member was granted access to the deal data room.']
  data_room_access_granted boolean [note: 'Indicates whether the team member has been granted access to the deal data room. True if access granted, False otherwise.']
  estimated_hours decimal(10,2) [note: 'Estimated total hours the team member is expected to spend on this deal.']
  is_ic_presenter boolean [note: 'Indicates whether this team member will present the Investment Memorandum (IM) to the Investment Committee (IC). True if presenter, False otherwise.']
  is_primary_contact boolean [note: 'Indicates whether this team member is the primary point of contact for the deal. True if primary contact, False otherwise.']
  last_modified_timestamp timestamp [note: 'Timestamp when this deal team assignment record was last modified.']
  nda_signed_date date [note: 'Date when the team member signed the Non-Disclosure Agreement (NDA) for this deal.']
  nda_signed_flag boolean [note: 'Indicates whether the team member has signed a Non-Disclosure Agreement (NDA) for this deal. True if signed, False otherwise.']
  role_code varchar [note: 'Role of the team member on this deal: LEAD (deal lead or principal), ASSOCIATE (senior associate), ANALYST (junior analyst), LEGAL (legal counsel), ESG (ESG advisor), EXTERNAL (external advisor or consultant).']
  role_description varchar [note: 'Detailed description of the team member\'s responsibilities and scope of work on this deal.']

  Note: 'Association record capturing the deal team composition for each opportunity. Records the opportunity, team member employee reference, role on deal (lead, associate, analyst, legal counsel, ESG advisor, external advisor), assignment start date, assignment'
}

Table deal.origination_source {
  origination_source_id varchar [pk, note: 'Unique identifier for the origination source party or intermediary.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: Origination sources (intermediaries, placement agents, GPs) must undergo KYC verification. The kyc_status/kyc_completion_date attributes indicate KYC is tracked.']
  asset_class_focus varchar [note: 'Primary asset classes or sectors in which the origination source specializes, such as private equity, real estate, infrastructure, or credit. [ENUM-REF-CANDIDATE']
  exclusivity_scope varchar [note: 'Description of the scope of any exclusive arrangement, including asset classes, geographies, or deal size ranges covered.']
  fee_arrangement_type varchar [note: 'Type of fee or compensation arrangement with the origination source for deal introductions.']
  first_deal_date date [note: 'Date on which the first deal opportunity was received from this origination source.']
  geographic_focus varchar [note: 'Primary geographic regions or markets in which the origination source operates and sources deals.']
  is_exclusive boolean [note: 'Indicates whether the origination source has an exclusive deal flow arrangement with the organization for specific sectors or geographies.']
  kyc_completion_date date [note: 'Date on which the most recent KYC and AML review was completed for the origination source.']
  kyc_expiry_date date [note: 'Date on which the current KYC approval expires and requires renewal for the origination source.']
  kyc_status varchar [note: 'Current status of the KYC and AML compliance review for the origination source.']
  last_deal_date date [note: 'Date on which the most recent deal opportunity was received from this origination source.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the origination source organization, enabling global counterparty identification.']
  nda_execution_date date [note: 'Date on which the NDA with the origination source was signed and became effective.']
  nda_expiry_date date [note: 'Date on which the NDA with the origination source expires and requires renewal.']
  nda_status varchar [note: 'Current status of the NDA with the origination source, governing confidentiality of deal information.']
  notes varchar [note: 'Free-text notes capturing additional context, relationship history, or special considerations for the origination source.']
  organization_address_line1 varchar [note: 'First line of the origination source organization\'s registered or primary business address.']
  organization_address_line2 varchar [note: 'Second line of the origination source organization\'s address, including suite or floor details.']
  organization_city varchar [note: 'City or municipality of the origination source organization\'s primary address.']
  organization_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the origination source organization\'s primary address.']
  organization_postal_code varchar [note: 'Postal or ZIP code of the origination source organization\'s primary address.']
  organization_state_province varchar [note: 'State, province, or region of the origination source organization\'s primary address.']
  party_type varchar [note: 'Indicates whether the source is an individual contact, an organization, or an intermediary entity.']
  preferred_communication_method varchar [note: 'Preferred channel for communicating with the origination source contact regarding deal opportunities.']
  primary_contact_email varchar [note: 'Primary email address for the origination source contact, used for deal pipeline communication and NDA distribution.']
  primary_contact_name varchar [note: 'Full name of the primary individual contact at the origination source for deal flow communication.']
  primary_contact_phone varchar [note: 'Primary telephone number for the origination source contact, including country and area codes.']
  record_created_by varchar [note: 'User or system identifier that created this origination source record in the lakehouse.']
  record_created_timestamp timestamp [note: 'Timestamp when this origination source record was first created in the lakehouse silver layer.']
  record_updated_timestamp timestamp [note: 'Timestamp when this origination source record was last updated in the lakehouse silver layer.']
  relationship_manager_name varchar [note: 'Name of the internal relationship manager or deal origination team member responsible for managing this origination source.']
  relationship_status varchar [note: 'Current status of the relationship with the origination source, indicating whether they are actively providing deal flow.']
  relationship_tier varchar [note: 'Strategic importance tier of the origination source based on deal quality, volume, and historical performance.']
  secondary_contact_email varchar [note: 'Secondary email address for backup communication with the origination source.']
  secondary_contact_name varchar [note: 'Full name of the secondary or backup contact at the origination source for continuity of deal flow.']
  secondary_contact_phone varchar [note: 'Secondary telephone number for backup contact at the origination source.']
  source_name varchar [note: 'Full legal or trading name of the origination source party, intermediary, or contact organization.']
  source_system_code varchar [note: 'Unique identifier of this origination source record in the source operational system for traceability and reconciliation.']
  source_type varchar [note: 'Classification of the origination source indicating how the deal opportunity was introduced to the organization.']
  success_rate_percent decimal(5,2) [note: 'Percentage of deals sourced by this origination source that resulted in closed investments, calculated as total deals closed divided by total deals sourced.']
  total_deals_closed varchar [note: 'Cumulative count of deal opportunities from this origination source that resulted in executed investments.']
  total_deals_sourced varchar [note: 'Cumulative count of deal opportunities introduced by this origination source since relationship inception.']

  Note: 'Reference master for external deal parties—origination sources, intermediaries, and their individual contacts—across the pipeline. Captures source/party type (proprietary/off-market, GP-introduced, investment bank, broker, co-investor referral, management'
}

Table deal.target_entity {
  target_entity_id varchar [pk, note: 'Unique identifier for the target entity record in the deal pipeline system.']
  coverage_universe_id varchar [note: 'Foreign key linking to research.coverage_universe. Business justification: Target entities under deal evaluation should link to research coverage when actively covered.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: Target entities MUST have KYC verification before investment per AML regulations. Pension funds must verify counterparty identity and beneficial ownership.']
  lei_record_id varchar [note: 'Foreign key linking to compliance.lei_record. Business justification: Target entities need LEI linkage for regulatory transaction reporting (EMIR, MiFID II). The lei attribute on target_entity is denormalized.']
  sanctions_screening_id varchar [note: 'Foreign key linking to compliance.sanctions_screening. Business justification: All investment targets must be screened against sanctions lists (OFAC, EU, UN) before capital deployment.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: The pension fund requires the valuation of the target entity for investment decision-making; the target entity\'s valuation is stored in valuation_asset_valuation.']
  annual_revenue_amount decimal(18,2) [note: 'Total annual revenue generated by the target entity in its most recent fiscal year, expressed in the reporting currency.']
  annual_revenue_currency varchar [note: 'Three-letter ISO currency code for the currency in which the annual revenue amount is denominated.']
  asset_class varchar [note: 'Investment asset class category to which the target entity belongs for portfolio allocation and strategic asset allocation purposes. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income — 7']
  credit_rating varchar [note: 'External credit rating assigned to the target entity by a recognized rating agency indicating creditworthiness and default risk.']
  credit_rating_agency varchar [note: 'Name of the credit rating agency that assigned the credit rating to the target entity.']
  cusip varchar [note: 'Nine-character alphanumeric CUSIP identifier for the target entity\'s securities, primarily used in North American markets.']
  ebitda_amount decimal(18,2) [note: 'EBITDA for the target entity in its most recent fiscal year, representing operating profitability before financing and non-cash charges.']
  ebitda_currency varchar [note: 'Three-letter ISO currency code for the currency in which the EBITDA amount is denominated.']
  employee_count varchar [note: 'Total number of full-time equivalent employees working for the target entity as of the most recent reporting period.']
  enterprise_value_amount decimal(18,2) [note: 'Estimated or reported enterprise value of the target entity representing the total value of the business including debt and excluding cash.']
  enterprise_value_currency varchar [note: 'Three-letter ISO currency code for the currency in which the enterprise value amount is denominated.']
  esg_assessment_date date [note: 'Date on which the ESG score or rating was assigned or last updated by the rating provider.']
  esg_rating_provider varchar [note: 'Name of the third-party provider or rating agency that assigned the ESG score to the target entity.']
  esg_score decimal(5,2) [note: 'Composite ESG score for the target entity reflecting its performance on environmental, social, and governance factors.']
  headquarters_address varchar [note: 'Full street address of the target entity\'s primary headquarters or principal place of business.']
  headquarters_city varchar [note: 'City where the target entity\'s headquarters is located.']
  headquarters_country varchar [note: 'Three-letter ISO country code for the country where the target entity\'s headquarters is located.']
  incorporation_date date [note: 'Date on which the target entity was legally incorporated or established in its jurisdiction.']
  industry_sector varchar [note: 'Primary industry sector classification for the target entity based on its core business activities.']
  industry_subsector varchar [note: 'More granular industry subsector classification providing additional detail on the target entity\'s business focus.']
  is_publicly_listed boolean [note: 'Boolean flag indicating whether the target entity is publicly listed on a stock exchange.']
  isin varchar [note: 'ISO 6166 compliant 12-character alphanumeric International Securities Identification Number uniquely identifying the target entity\'s securities.']
  jurisdiction_of_incorporation varchar [note: 'Three-letter ISO country code representing the legal jurisdiction where the target entity is incorporated or domiciled.']
  origination_date date [note: 'Date on which the target entity was first identified and entered into the deal origination pipeline.']
  ownership_structure varchar [note: 'Classification of the target entity\'s ownership structure indicating whether it is publicly traded, privately held, family-owned, government-owned, partnership, or joint venture.']
  parent_company_lei varchar [note: 'Legal Entity Identifier of the parent company or ultimate beneficial owner of the target entity.']
  parent_company_name varchar [note: 'Legal name of the parent company or ultimate beneficial owner if the target entity is a subsidiary or controlled entity.']
  primary_business_description varchar [note: 'Detailed narrative description of the target entity\'s core business operations, products, services, and value proposition.']
  primary_contact_email varchar [note: 'Email address of the primary contact person at the target entity for deal correspondence.']
  primary_contact_name varchar [note: 'Full name of the primary contact person at the target entity for deal-related communications.']
  primary_contact_phone varchar [note: 'Telephone number of the primary contact person at the target entity.']
  primary_contact_title varchar [note: 'Job title or role of the primary contact person at the target entity.']
  record_created_timestamp timestamp [note: 'System timestamp indicating when this target entity record was first created in the deal pipeline system.']
  record_updated_timestamp timestamp [note: 'System timestamp indicating when this target entity record was last modified or updated.']
  registration_number varchar [note: 'Official company registration or identification number assigned by the jurisdiction of incorporation for the target entity.']
  sedol varchar [note: 'Seven-character alphanumeric SEDOL identifier for the target entity\'s securities, primarily used in UK and Irish markets.']
  source_channel varchar [note: 'Channel through which the target entity was sourced or originated for the deal pipeline.']
  stock_exchange_code varchar [note: 'Market Identifier Code for the primary stock exchange where the target entity\'s securities are listed, if publicly traded.']
  sub_asset_class varchar [note: 'More specific sub-category within the primary asset class providing granular classification for investment strategy alignment.']
  target_legal_name varchar [note: 'Full legal name of the target company, asset, fund, or investment vehicle as registered in its jurisdiction of incorporation.']
  target_short_name varchar [note: 'Abbreviated or commonly used name for the target entity used in internal communications and reporting.']
  target_status varchar [note: 'Current lifecycle status of the target entity within the deal pipeline indicating whether it is actively being pursued, inactive, under review, archived, or has been merged or acquired.']
  target_type varchar [note: 'Classification of the target entity indicating whether it is an operating company, real asset, infrastructure asset, natural resource asset, fund, or co-investment vehicle.']
  tax_identification_number varchar [note: 'Tax identification number or equivalent identifier used by tax authorities in the target entity\'s primary jurisdiction.']
  ticker_symbol varchar [note: 'Stock ticker symbol or trading symbol for the target entity on its primary stock exchange, if publicly listed.']
  valuation_date date [note: 'Date as of which the enterprise value or other valuation metrics were determined or estimated.']
  website_url varchar [note: 'Primary website URL for the target entity providing public information about the company or asset.']

  Note: 'Master record for the target company, asset, or fund that is the subject of a deal opportunity. Captures target legal name, target type (operating company, real asset, infrastructure asset, fund, co-investment vehicle), jurisdiction of incorporation, LEI'
}

Table deal.deal_valuation {
  deal_valuation_id varchar [pk, note: 'Unique identifier for the deal valuation record.']
  capital_market_assumption_id varchar [note: 'Foreign key linking to research.capital_market_assumption. Business justification: Institutional valuations require documented capital market assumptions for WACC, risk premiums.']
  deal_employee_id varchar [note: 'Reference to the investment professional who prepared the valuation.']
  discount_rate_curve_id varchar [note: 'Foreign key linking to actuarial.discount_rate_curve. Business justification: Deal valuations for pension investments should use liability-consistent discount rates. Actuarial discount curves ensure valuation consistency with ALM framework.']
  employee_id varchar [note: 'Reference to the investment professional who prepared the valuation.']
  macro_model_run_id varchar [note: 'Foreign key linking to research.macro_model_run. Business justification: Deal valuations use macro assumptions (discount rates, growth rates). Linking to specific model run provides audit trail for valuation inputs.']
  opportunity_id varchar [note: 'Reference to the deal opportunity being valued.']
  reviewer_employee_id varchar [note: 'Reference to the senior professional who reviewed and approved the valuation.']
  reviewer_id varchar [note: 'Reference to the senior professional who reviewed and approved the valuation.']
  superseded_by_valuation_deal_valuation_id varchar [note: 'Reference to the subsequent valuation that supersedes this record, if applicable.']
  analyst_name varchar [note: 'Name of the investment professional who prepared the valuation.']
  approval_date date [note: 'Date when the valuation was formally approved by the reviewer.']
  comparable_count varchar [note: 'Number of comparable companies or precedent transactions used in the analysis.']
  confidence_level varchar [note: 'Qualitative assessment of confidence in the valuation estimate given data availability and assumptions.']
  currency varchar [note: 'Three-letter ISO 4217 currency code for valuation amounts.']
  data_quality_score varchar [note: 'Numeric score representing the quality and completeness of data used in valuation, scale 1-10.']
  discount_rate_percent decimal(5,2) [note: 'Discount rate applied in discounted cash flow analysis, expressed as percentage.']
  ebitda_multiple decimal(6,2) [note: 'EBITDA multiple applied in comparable company or precedent transaction analysis.']
  enterprise_value decimal(20,2) [note: 'Estimated enterprise value of the target entity.']
  equity_value decimal(20,2) [note: 'Estimated equity value derived from enterprise value less net debt.']
  key_assumptions varchar [note: 'Summary of critical assumptions underpinning the valuation estimate.']
  methodology varchar [note: 'Primary valuation methodology applied for this estimate.']
  midpoint decimal(20,2) [note: 'Midpoint of the valuation range, representing the central estimate.']
  model_file_path varchar [note: 'File path or document management system reference to the detailed valuation model.']
  nav_per_share decimal(18,4) [note: 'Calculated net asset value per share for equity investments.']
  net_debt decimal(20,2) [note: 'Net debt position of the target entity used to bridge enterprise value to equity value.']
  notes varchar [note: 'Additional commentary, caveats, or context relevant to the valuation estimate.']
  range_high decimal(20,2) [note: 'Upper bound of the valuation range estimate.']
  range_low decimal(20,2) [note: 'Lower bound of the valuation range estimate.']
  record_created_by varchar [note: 'User or system identifier that created this record in the data platform.']
  record_created_timestamp timestamp [note: 'Timestamp when this record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this record was last updated in the data platform.']
  revenue_multiple decimal(6,2) [note: 'Revenue multiple applied in comparable company or precedent transaction analysis.']
  reviewer_name varchar [note: 'Name of the senior professional who reviewed and approved the valuation.']
  risk_factors varchar [note: 'Key risks and uncertainties that could materially impact the valuation.']
  sensitivity_analysis_performed boolean [note: 'Indicates whether sensitivity analysis was conducted on key valuation drivers.']
  source_system_code varchar [note: 'Unique identifier of this valuation record in the source system.']
  target_ebitda decimal(20,2) [note: 'Target company EBITDA used as basis for multiple-based valuation.']
  target_revenue decimal(20,2) [note: 'Target company revenue used as basis for multiple-based valuation.']
  terminal_growth_rate_percent decimal(5,2) [note: 'Perpetual growth rate assumption used in terminal value calculation.']
  valuation_date date [note: 'The as-of date for which the valuation estimate was prepared.']
  valuation_number varchar [note: 'Business identifier for this valuation record, used for tracking and reference.']
  valuation_status varchar [note: 'Current lifecycle status of the valuation record.']
  valuation_timestamp timestamp [note: 'Precise timestamp when the valuation was completed or submitted.']
  valuation_type varchar [note: 'Classification of the valuation approach used during deal origination.']
  version_number varchar [note: 'Sequential version number for tracking iterations of the valuation for the same opportunity.']
  wacc_percent decimal(5,2) [note: 'Weighted average cost of capital used in valuation model, expressed as percentage.']

  Note: 'Transactional record capturing indicative valuation estimates produced during deal origination and screening—prior to formal valuation domain ownership post-IC approval.'
}

Table deal.deal_capital_commitment {
  deal_capital_commitment_id varchar [pk, note: 'Unique identifier for the capital commitment record. Primary key for this entity.']
  deal_employee_id varchar [note: 'Identifier for the internal investment professional responsible for originating and managing this commitment.']
  deal_ic_submission_id varchar [note: 'Reference to the Investment Committee submission that resulted in this commitment approval.']
  deal_portfolio_manager_employee_id varchar [note: 'Identifier for the portfolio manager responsible for overseeing this commitment within the broader portfolio.']
  employee_id varchar [note: 'Identifier for the internal investment professional responsible for originating and managing this commitment.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Capital commitment decisions must align with liability cash flow timing. Investment teams reference liability projections during commitment sizing to ensure assets match']
  opportunity_id varchar [note: 'Reference to the deal opportunity for which this capital commitment was approved.']
  portfolio_id varchar [note: 'Foreign key linking to portfolio.portfolio. Business justification: IC approval process requires specifying target portfolio for mandate compliance checks and allocation limit validation.']
  portfolio_manager_employee_id varchar [note: 'Identifier for the portfolio manager responsible for overseeing this commitment within the broader portfolio.']
  asset_class varchar [note: 'Primary asset class for this commitment: public equity, private equity, real estate, infrastructure, natural resources, or credit.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 code for the fund\'s base reporting currency used for conversion.']
  carried_interest_percent decimal(5,2) [note: 'Percentage of profits above the hurdle rate that will be paid to the General Partner as carried interest.']
  commitment_amount decimal(20,2) [note: 'Total capital amount committed and approved by the Investment Committee for this deal.']
  commitment_amount_base_currency decimal(20,2) [note: 'Commitment amount converted to the fund\'s base reporting currency at the approval date exchange rate.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the commitment amount (e.g., USD, EUR, GBP).']
  commitment_expiry_date date [note: 'Date after which the capital commitment expires if not drawn or legally executed.']
  commitment_name varchar [note: 'Descriptive name for the capital commitment, typically referencing the target entity and commitment type.']
  commitment_notes varchar [note: 'Additional notes, comments, or context related to this capital commitment.']
  commitment_reference_number varchar [note: 'External business identifier for this capital commitment, used in legal documents and reporting.']
  commitment_status varchar [note: 'Current lifecycle status of the capital commitment: approved, reserved, active, partially funded, fully funded, cancelled, or expired. [ENUM-REF-CANDIDATE: approved|reserved|active|partially_funded|fully_funded|cancelled|expired — 7 candidates stripped']
  commitment_type varchar [note: 'Type of capital commitment being made: equity, debt, mezzanine, preferred equity, fund commitment, or co-investment.']
  dry_powder_allocation decimal(20,2) [note: 'Amount of uncalled committed capital (dry powder) reserved for this commitment at approval.']
  esg_exclusion_flag boolean [note: 'Indicates whether the investment was subject to ESG exclusion screening (True if exclusions apply, False otherwise).']
  esg_rating varchar [note: 'ESG rating assigned to the target entity or investment at the time of commitment approval.']
  expected_final_close_date date [note: 'Expected date by which the investment will reach final close and the commitment becomes legally binding.']
  expected_first_drawdown_date date [note: 'Anticipated date for the first capital call or drawdown against this commitment.']
  expected_hold_period_years varchar [note: 'Expected total holding period in years from initial investment to full exit.']
  expected_investment_period_years varchar [note: 'Expected duration in years over which the committed capital will be deployed.']
  fx_rate_at_approval decimal(18,8) [note: 'Exchange rate used to convert commitment amount to base currency at the time of IC approval.']
  gp_sponsor_name varchar [note: 'Name of the General Partner or sponsor managing the investment, applicable for fund commitments and co-investments.']
  hurdle_rate_percent decimal(5,2) [note: 'Preferred return threshold percentage that must be achieved before carried interest is paid to the GP.']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved this capital commitment.']
  ic_conditions varchar [note: 'Any conditions or requirements imposed by the Investment Committee as part of the approval.']
  ic_decision_outcome varchar [note: 'Final decision outcome from the Investment Committee: approved, approved with conditions, deferred, or rejected.']
  ic_meeting_reference varchar [note: 'Reference identifier for the IC meeting at which this commitment was approved.']
  investment_strategy varchar [note: 'Specific investment strategy or mandate under which this commitment is being made.']
  investment_thesis varchar [note: 'Summary of the strategic rationale and value creation hypothesis supporting this capital commitment.']
  lpa_execution_date date [note: 'Date on which the Limited Partnership Agreement was formally executed.']
  lpa_signed_flag boolean [note: 'Indicates whether the Limited Partnership Agreement has been executed (True if signed, False otherwise).']
  management_fee_percent decimal(5,2) [note: 'Annual management fee percentage charged on committed or invested capital.']
  record_created_timestamp timestamp [note: 'Timestamp when this commitment record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this commitment record was last updated in the data platform.']
  risk_rating varchar [note: 'Overall risk rating assigned to this commitment: low, medium, high, or very high.']
  source_system_code varchar [note: 'Unique identifier for this commitment record in the source operational system.']
  strategic_fit_score varchar [note: 'Quantitative score (typically 1-10) representing how well this commitment aligns with the fund\'s strategic asset allocation.']
  sub_asset_class varchar [note: 'Detailed sub-classification within the primary asset class (e.g., growth equity, core real estate, renewable infrastructure).']
  target_entity_name varchar [note: 'Legal name of the target entity or fund receiving the capital commitment.']
  target_irr_percent decimal(5,2) [note: 'Target net Internal Rate of Return percentage expected from this investment at the time of commitment.']
  target_jurisdiction varchar [note: 'Three-letter ISO country code for the primary jurisdiction of the target entity.']
  target_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier for the target entity, if available.']
  target_moic decimal(5,2) [note: 'Target Multiple on Invested Capital expected from this investment at the time of commitment.']
  vintage_year varchar [note: 'Year in which the capital commitment was approved, used for cohort analysis and performance benchmarking.']

  Note: 'Master record for the capital commitment approved and reserved for a deal at IC approval. Captures the opportunity, IC submission reference, approved commitment amount, commitment currency, commitment type (equity, debt, co-invest, fund commitment)'
}

Table deal.ppm_review {
  ppm_review_id varchar [pk, note: 'Unique identifier for the PPM review record. Primary key.']
  employee_id varchar [note: 'Identifier of the investment professional who conducted the primary PPM review.']
  fee_benchmark_id varchar [note: 'Foreign key linking to fee.fee_benchmark. Business justification: PPM due diligence requires systematic comparison of proposed fund fee terms against market benchmarks.']
  opportunity_id varchar [note: 'Reference to the investment opportunity being evaluated through this PPM review.']
  reviewer_employee_id varchar [note: 'Identifier of the investment professional who conducted the primary PPM review.']
  carried_interest_percent decimal(5,4) [note: 'Carried interest percentage that the GP will receive on profits above the hurdle rate.']
  esg_policy_summary varchar [note: 'Summary of the funds ESG policy, responsible investment approach, and sustainability commitments as disclosed in the PPM.']
  esg_rating varchar [note: 'Internal ESG rating assigned to the fund based on PPM review and ESG due diligence.']
  follow_up_actions varchar [note: 'List of follow-up actions, additional diligence items, or clarifications required before proceeding.']
  fund_asset_class varchar [note: 'Primary asset class focus of the fund being reviewed.']
  fund_name varchar [note: 'Name of the fund or investment vehicle described in the PPM.']
  fund_strategy varchar [note: 'Investment strategy of the fund as described in the PPM, including asset class focus and approach.']
  fund_term_years varchar [note: 'Total term of the fund in years, including investment period and harvest period.']
  fund_vintage_year varchar [note: 'Vintage year of the fund, representing the year of first capital commitment.']
  gp_aum_amount decimal(18,2) [note: 'Total assets under management by the GP as disclosed in the PPM.']
  gp_aum_currency varchar [note: 'Currency code for the GP assets under management amount.']
  gp_lei varchar [note: 'Legal Entity Identifier of the General Partner for regulatory identification.']
  gp_prior_fund_count varchar [note: 'Number of prior funds managed by the GP as disclosed in the PPM.']
  gp_sponsor_name varchar [note: 'Name of the General Partner or sponsor managing the fund.']
  gp_track_record_assessment varchar [note: 'Qualitative assessment of the GPs historical performance and track record based on PPM disclosures and external research.']
  hurdle_rate_percent decimal(5,4) [note: 'Preferred return threshold that must be achieved before GP receives carried interest.']
  ic_submission_required boolean [note: 'Flag indicating whether this opportunity requires formal Investment Committee submission and approval.']
  investment_period_years varchar [note: 'Duration in years during which the fund will actively deploy capital into new investments.']
  investment_restrictions varchar [note: 'Summary of investment restrictions, concentration limits, and prohibited activities specified in the PPM.']
  key_person_provisions varchar [note: 'Summary of key person provisions and conditions outlined in the PPM.']
  management_fee_percent decimal(5,4) [note: 'Annual management fee percentage charged by the GP as stated in the PPM.']
  minimum_commitment_amount decimal(18,2) [note: 'Minimum investment commitment required from Limited Partners as specified in the PPM.']
  minimum_commitment_currency varchar [note: 'Currency code for the minimum commitment amount.']
  ppm_document_date date [note: 'Issuance or effective date of the PPM document under review.']
  ppm_document_version varchar [note: 'Version identifier of the Private Placement Memorandum document being reviewed.']
  recommendation varchar [note: 'Reviewers recommendation on whether to proceed with the investment opportunity.']
  recommendation_rationale varchar [note: 'Detailed rationale supporting the reviewers recommendation, including key strengths and concerns.']
  record_created_timestamp timestamp [note: 'Timestamp when this PPM review record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this PPM review record was last updated in the system.']
  red_flags_identified varchar [note: 'Summary of any red flags, concerns, or material issues identified during the PPM review.']
  review_code varchar [note: 'Business identifier for the PPM review, typically combining opportunity code and review sequence.']
  review_completed_timestamp timestamp [note: 'Timestamp when the PPM review was completed and findings finalized.']
  review_date date [note: 'Date when the PPM review was conducted or completed.']
  review_initiated_timestamp timestamp [note: 'Timestamp when the PPM review process was formally initiated.']
  review_notes varchar [note: 'Additional notes, observations, or commentary from the PPM review process.']
  review_status varchar [note: 'Current lifecycle status of the PPM review process.']
  review_team varchar [note: 'Name or identifier of the investment team responsible for the PPM review.']
  reviewer_name varchar [note: 'Full name of the investment professional who conducted the PPM review.']
  risk_assessment varchar [note: 'Overall risk assessment of the fund opportunity based on PPM review, including strategy risk, GP risk, and structural risk.']
  risk_rating varchar [note: 'Categorical risk rating assigned to the fund opportunity.']
  strategic_fit_score varchar [note: 'Numerical score representing alignment of the fund with the organizations strategic asset allocation and investment objectives.']
  target_fund_size_amount decimal(18,2) [note: 'Target total capital to be raised for the fund as stated in the PPM.']
  target_fund_size_currency varchar [note: 'Currency code for the target fund size amount.']

  Note: 'Master record for Private Placement Memorandum (PPM) reviews conducted during fund manager and co-investment screening. Captures the opportunity, PPM document version, review date, reviewer, fund strategy summary, GP track record assessment, fee structure'
}

Table deal.screening_decision {
  screening_decision_id varchar [pk, note: 'Unique identifier for the screening decision record. Primary key for the screening decision entity.']
  employee_id varchar [note: 'Reference to the individual who chaired the screening committee meeting. Senior investment professional responsible for decision governance.']
  lead_reviewer_employee_id varchar [note: 'Reference to the investment professional who led the screening analysis and presented to the committee. Primary deal sponsor.']
  opportunity_id varchar [note: 'Reference to the investment opportunity being screened. Links to the deal opportunity under review.']
  screening_employee_id varchar [note: 'Reference to the individual who chaired the screening committee meeting. Senior investment professional responsible for decision governance.']
  screening_lead_reviewer_employee_id varchar [note: 'Reference to the investment professional who led the screening analysis and presented to the committee. Primary deal sponsor.']
  committee_chair_name varchar [note: 'Full name of the committee chair who presided over the screening decision. Denormalized for reporting convenience.']
  committee_member_count varchar [note: 'Number of committee members present at the screening review. Used to validate quorum requirements.']
  conditions_imposed varchar [note: 'List of conditions or requirements that must be met before advancing to the next stage. May include additional due diligence (DD), valuation work, or legal reviews.']
  confidentiality_level varchar [note: 'Data classification level for the screening decision record. Determines access controls and distribution restrictions.']
  decision_outcome varchar [note: 'Final outcome of the screening review. Proceed advances to next stage; hold pauses for additional information; decline terminates the opportunity; conditional proceed requires specific conditions to be met.']
  decision_status varchar [note: 'Current lifecycle status of the screening decision record. Tracks workflow state from draft through final approval.']
  decline_reason_code varchar [note: 'Standardized code categorizing the primary reason for declining the opportunity. Used for pipeline analytics and sourcing strategy refinement.']
  decline_reason_description varchar [note: 'Detailed explanation of why the opportunity was declined. Captures investment thesis misalignment, valuation concerns, risk factors, or strategic fit issues.']
  esg_exclusion_flag boolean [note: 'Indicates whether the opportunity was flagged for Environmental Social and Governance (ESG) exclusion criteria. True if the investment violates responsible investment policies.']
  esg_rating varchar [note: 'Environmental Social and Governance (ESG) assessment grade assigned during screening. Reflects alignment with Principles for Responsible Investment (PRI) and Sustainable Finance Disclosure Regulation (SFDR) requirements.']
  hold_reason varchar [note: 'Explanation for placing the opportunity on hold. Identifies missing information, pending external events, or conditions that must be satisfied before proceeding.']
  ic_submission_date date [note: 'Date when the Investment Memorandum (IM) was submitted to Investment Committee (IC) for formal approval. Applicable for opportunities requiring IC review.']
  ic_submission_required boolean [note: 'Indicates whether the opportunity must be escalated to full Investment Committee (IC) for approval. True if deal size or risk profile exceeds delegated authority thresholds.']
  lead_reviewer_name varchar [note: 'Full name of the lead investment professional who conducted the screening review. Denormalized for reporting convenience.']
  legal_concern_flag boolean [note: 'Indicates whether legal or regulatory concerns were identified during screening. True if material legal risks require further assessment.']
  meeting_reference_number varchar [note: 'Reference identifier for the committee meeting where the screening decision was made. Links to Investment Committee (IC) meeting minutes.']
  next_review_date date [note: 'Scheduled date for the next screening review or follow-up. Applicable when decision outcome is hold or conditional proceed.']
  operational_concern_flag boolean [note: 'Indicates whether operational due diligence (ODD) concerns were identified. True if material operational risks require further investigation.']
  quorum_met boolean [note: 'Indicates whether the required quorum of committee members was present for the screening decision. True if quorum requirements were satisfied.']
  record_created_by varchar [note: 'User or system identifier that created the screening decision record. Audit trail for data governance.']
  record_created_timestamp timestamp [note: 'Timestamp when the screening decision record was first created in the lakehouse. Audit trail for data lineage.']
  record_updated_timestamp timestamp [note: 'Timestamp when the screening decision record was last modified in the lakehouse. Audit trail for data lineage.']
  risk_rating varchar [note: 'Overall risk assessment assigned during screening. Considers operational, financial, market, and Environmental Social and Governance (ESG) risks.']
  screening_committee_name varchar [note: 'Name of the committee or review body that made the screening decision. May be asset class-specific committee or central Investment Committee (IC).']
  screening_date date [note: 'Date when the screening decision was formally made. Principal business event timestamp for the screening review.']
  screening_notes varchar [note: 'Free-text notes and commentary from the screening committee. Captures key discussion points, concerns raised, and rationale for the decision.']
  screening_number varchar [note: 'Business identifier for the screening decision. Human-readable reference number used in Investment Committee (IC) documentation and pipeline tracking.']
  screening_timestamp timestamp [note: 'Precise timestamp when the screening decision was recorded in the system. Captures exact moment of decision finalization.']
  screening_type varchar [note: 'Classification of the screening review. Initial screening is preliminary assessment; full screening is comprehensive due diligence (DD) gate review.']
  source_system_code varchar [note: 'Unique identifier of the screening decision record in the source system. Used for data lineage and reconciliation.']
  strategic_fit_score decimal(5,2) [note: 'Quantitative assessment of how well the opportunity aligns with Strategic Asset Allocation (SAA) and investment mandate. Scale typically 0-100.']
  supporting_document_count varchar [note: 'Number of supporting documents attached to the screening decision. Includes Investment Memorandum (IM), due diligence (DD) reports, and valuation models.']
  unanimous_decision boolean [note: 'Indicates whether the screening decision was unanimous. True if all voting members agreed on the outcome.']
  valuation_concern_flag boolean [note: 'Indicates whether the screening committee identified material valuation concerns. True if pricing appears misaligned with intrinsic value or market comparables.']
  vote_abstain_count varchar [note: 'Number of committee members who abstained from voting. Typically due to conflict of interest or insufficient information.']
  vote_against_count varchar [note: 'Number of committee members who voted against proceeding with the opportunity. Used for governance audit trail.']
  vote_for_count varchar [note: 'Number of committee members who voted in favor of proceeding with the opportunity. Used for governance audit trail.']

  Note: 'Transactional record capturing the formal screening decision made at each pipeline gate review. Records the opportunity, screening date, screening type (initial/full), screening committee members, decision outcome (proceed, hold, decline), decline reason'
}

Table deal.deal_document {
  deal_document_id varchar [pk, note: 'Unique identifier for the deal document record. Primary key.']
  approved_by_user_employee_id varchar [note: 'Identifier of the user who approved the document, if applicable.']
  counterparty_legal_entity_counterparty_id varchar [note: 'Identifier of the external legal entity that is a party to this document (e.g., target company, General Partner (GP), intermediary).']
  deal_ic_submission_id varchar [note: 'Reference to the Investment Committee (IC) submission package that includes this document, if applicable.']
  employee_id varchar [note: 'Identifier of the internal user who uploaded the document into the system.']
  opportunity_id varchar [note: 'Reference to the deal opportunity this document belongs to.']
  owner_user_employee_id varchar [note: 'Identifier of the internal user responsible for managing and maintaining this document.']
  superseded_by_document_deal_document_id varchar [note: 'Reference to the newer document that supersedes this document, if applicable.']
  access_restriction_flag boolean [note: 'Indicates whether access to this document is restricted to specific users or roles.']
  approval_date date [note: 'Date when the document was formally approved.']
  approval_required_flag boolean [note: 'Indicates whether this document requires formal approval before it can be executed or finalized.']
  approval_status varchar [note: 'Current approval status of the document: Pending, Approved, Rejected, or Not Required.']
  approved_by_user_name varchar [note: 'Full name of the user who approved the document.']
  asset_class varchar [note: 'Asset class associated with the deal this document supports (e.g., Public Equities, Private Equity, Real Estate, Infrastructure, Natural Resources, Credit).']
  author_name varchar [note: 'Name of the individual or organization that authored or prepared the document.']
  confidentiality_level varchar [note: 'Data classification level indicating the sensitivity of the document: Public, Internal, Confidential, or Restricted.']
  deal_stage_code varchar [note: 'Code representing the deal pipeline stage at which this document was created or uploaded.']
  document_date date [note: 'Official date of the document as stated on the document itself (e.g., execution date, issuance date, effective date).']
  document_description varchar [note: 'Detailed description or summary of the document content and purpose.']
  document_status varchar [note: 'Current lifecycle status of the document: Draft, Under Review, Approved, Executed, Superseded, Archived, or Rejected. [ENUM-REF-CANDIDATE: DRAFT|UNDER_REVIEW|APPROVED|EXECUTED|SUPERSEDED|ARCHIVED|REJECTED — 7 candidates stripped; promote to reference']
  effective_date date [note: 'Date from which the document becomes legally or operationally effective.']
  execution_date date [note: 'Date when the document was executed or signed by all parties, if applicable.']
  expiry_date date [note: 'Date when the document expires or ceases to be valid, if applicable.']
  external_signatory_name varchar [note: 'Name of the external counterparty representative who signed the document.']
  external_signatory_title varchar [note: 'Job title or role of the external signatory.']
  file_format varchar [note: 'File format or extension of the document (e.g., PDF, DOCX, XLSX, PPTX, MSG, ZIP). [ENUM-REF-CANDIDATE: PDF|DOCX|XLSX|PPTX|MSG|ZIP|OTHER — 7 candidates stripped; promote to reference product]']
  file_name varchar [note: 'Original file name of the uploaded document including file extension.']
  file_size_bytes varchar [note: 'Size of the document file in bytes for storage and retrieval tracking.']
  hash varchar [note: 'Cryptographic hash (e.g., SHA-256) of the document file to ensure integrity and detect tampering.']
  internal_signatory_name varchar [note: 'Name of the internal representative who signed the document on behalf of the organization.']
  internal_signatory_title varchar [note: 'Job title or role of the internal signatory.']
  legal_counsel_firm varchar [note: 'Name of the external legal counsel firm that reviewed or advised on this document, if applicable.']
  legal_review_required_flag boolean [note: 'Indicates whether this document requires review by internal or external legal counsel.']
  legal_review_status varchar [note: 'Current status of legal review for this document: Pending, In Progress, Completed, or Not Required.']
  notes varchar [note: 'Additional notes, comments, or annotations related to the document for internal reference.']
  owner_user_name varchar [note: 'Full name of the internal user who owns this document.']
  record_created_timestamp timestamp [note: 'Timestamp when this record was first created in the system for audit and lineage tracking.']
  record_updated_timestamp timestamp [note: 'Timestamp when this record was last updated in the system for audit and lineage tracking.']
  reference_number varchar [note: 'Externally-known unique reference number or code assigned to this document for tracking and retrieval purposes.']
  storage_location varchar [note: 'Physical or logical storage path where the document is stored (e.g., cloud storage URI, file share path, data room location).']
  title varchar [note: 'Full title or name of the deal document as it appears on the document itself.']
  type_code varchar [note: 'Categorical code classifying the document type: Non-Disclosure Agreement (NDA), Letter of Intent (LOI), Term Sheet, Investment Memorandum (IM), Private Placement Memorandum (PPM), Financial Model, Legal Opinion, Management Presentation, Data Room Index']
  type_name varchar [note: 'Human-readable name of the document type for display and reporting purposes.']
  upload_date date [note: 'Date when the document was uploaded into the deal pipeline system.']
  upload_timestamp timestamp [note: 'Precise timestamp when the document was uploaded into the system, including time zone information.']
  uploaded_by_user_name varchar [note: 'Full name of the internal user who uploaded the document.']
  version varchar [note: 'Version identifier of the document (e.g., v1.0, v2.1, Final) to track revisions and iterations.']
  version_sequence_number varchar [note: 'Numeric sequence number indicating the version order for sorting and comparison purposes.']

  Note: 'Master record for all deal-related documents managed within the deal pipeline. Captures document type (NDA, LOI, term sheet, IM, PPM, financial model, legal opinion, management presentation, data room index), document title, document version, upload date'
}

Table deal.exclusivity_agreement {
  exclusivity_agreement_id varchar [pk, note: 'Unique identifier for the exclusivity agreement record. Primary key.']
  counterparty_id varchar [note: 'Reference to the seller, General Partner (GP), or other counterparty legal entity with whom exclusivity is negotiated.']
  counterparty_legal_entity_counterparty_id varchar [note: 'Reference to the seller, General Partner (GP), or other counterparty legal entity with whom exclusivity is negotiated.']
  employee_id varchar [note: 'Reference to the internal investment professional responsible for negotiating and managing this exclusivity agreement.']
  lead_investment_professional_employee_id varchar [note: 'Reference to the internal investment professional responsible for negotiating and managing this exclusivity agreement.']
  opportunity_id varchar [note: 'Reference to the deal opportunity for which this exclusivity agreement was negotiated.']
  agreement_number varchar [note: 'Externally-known unique reference number or code assigned to this exclusivity agreement for tracking and communication purposes.']
  agreement_type varchar [note: 'Classification of the exclusivity arrangement: full exclusivity (no other buyers), limited exclusivity (restricted buyer pool), no-shop (no active solicitation), no-talk (no discussions), or standstill (no hostile action).']
  arbitration_venue varchar [note: 'City or institution designated for arbitration proceedings if arbitration is the chosen dispute resolution mechanism (e.g., London, New York, ICC Paris).']
  asset_class varchar [note: 'Primary asset class of the investment opportunity covered by this exclusivity agreement.']
  breach_description varchar [note: 'Narrative description of the alleged or confirmed breach of exclusivity terms, including nature of violation and parties involved.']
  breach_reported_flag boolean [note: 'Indicates whether a breach of the exclusivity terms has been reported or alleged by either party.']
  break_fee_amount decimal(18,2) [note: 'Monetary penalty payable by the counterparty if they breach the exclusivity terms or accept a competing offer during the exclusivity period.']
  break_fee_currency varchar [note: 'ISO 4217 three-letter currency code for the break fee amount (e.g., USD, EUR, GBP).']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the counterparty, enabling global entity identification and regulatory reporting.']
  counterparty_signatory_name varchar [note: 'Name of the authorized representative from the counterparty organization who signed the exclusivity agreement.']
  counterparty_signatory_title varchar [note: 'Job title or role of the counterparty signatory who executed the exclusivity agreement.']
  deal_structure varchar [note: 'High-level description of the proposed transaction structure (e.g., equity purchase, asset acquisition, joint venture, co-investment) contemplated during the exclusivity period.']
  deposit_amount decimal(18,2) [note: 'Refundable or non-refundable deposit paid by the buyer to secure exclusivity, demonstrating commitment and compensating seller for opportunity cost.']
  deposit_currency varchar [note: 'ISO 4217 three-letter currency code for the exclusivity deposit amount.']
  deposit_refundable_flag boolean [note: 'Indicates whether the exclusivity deposit is refundable to the buyer if the deal does not close (true) or is forfeited to the seller (false).']
  dispute_resolution_mechanism varchar [note: 'Method specified for resolving disputes arising from the exclusivity agreement: litigation (court proceedings), arbitration (binding private tribunal), or mediation (facilitated negotiation).']
  document_storage_location varchar [note: 'File path, URL, or document management system reference where the executed exclusivity agreement is stored for retrieval and audit purposes.']
  effective_date date [note: 'Date from which the exclusivity period begins and the counterparty is bound by the exclusivity terms.']
  exclusivity_agreement_status varchar [note: 'Current lifecycle status of the exclusivity agreement: draft (under negotiation), executed (signed), active (in force), expired (period ended), terminated (ended early), or breached (violated).']
  exclusivity_period_days varchar [note: 'Total number of calendar days for which exclusivity is granted, calculated from effective date to expiry date.']
  execution_date date [note: 'Date on which the exclusivity agreement was signed by all parties.']
  expiry_date date [note: 'Date on which the exclusivity period ends, after which the counterparty may engage with other buyers unless extended or deal closes.']
  extension_count varchar [note: 'Number of times the exclusivity period has been extended beyond the original expiry date.']
  extension_permitted_flag boolean [note: 'Indicates whether the exclusivity period may be extended by mutual agreement or under predefined conditions (true) or is fixed with no extension provision (false).']
  external_counsel_firm varchar [note: 'Name of the external law firm engaged to advise on or draft the exclusivity agreement, if applicable.']
  fiduciary_out_clause_flag boolean [note: 'Indicates whether the agreement includes a fiduciary out clause allowing the counterparty to consider superior proposals if required by fiduciary duty to shareholders or beneficiaries.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose laws govern the interpretation and enforcement of the exclusivity agreement (e.g., New York, England and Wales, Delaware).']
  indicative_enterprise_value decimal(18,2) [note: 'Non-binding indicative enterprise value of the target entity or asset at the time the exclusivity agreement was executed, used for scoping the transaction.']
  internal_counsel_approval_flag boolean [note: 'Indicates whether the exclusivity agreement has been reviewed and approved by internal legal counsel prior to execution.']
  internal_signatory_name varchar [note: 'Name of the authorized representative from the pension fund who signed the exclusivity agreement on behalf of the organization.']
  internal_signatory_title varchar [note: 'Job title or role of the internal signatory who executed the exclusivity agreement (e.g., Chief Investment Officer, Managing Director).']
  loi_reference_number varchar [note: 'Reference number of the associated Letter of Intent that may have been issued concurrently with or following this exclusivity agreement.']
  nda_reference_number varchar [note: 'Reference number of the associated NDA that preceded or accompanies this exclusivity agreement, establishing confidentiality obligations.']
  no_shop_provision_flag boolean [note: 'Indicates whether the agreement includes a no-shop provision prohibiting the counterparty from actively soliciting or entertaining competing offers during the exclusivity period.']
  notes varchar [note: 'Free-form notes capturing additional context, special conditions, negotiation history, or internal commentary related to this exclusivity agreement.']
  record_created_by varchar [note: 'Username or identifier of the user or system process that created this exclusivity agreement record.']
  record_created_timestamp timestamp [note: 'Timestamp when this exclusivity agreement record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this exclusivity agreement record was last modified in the data platform.']
  remediation_action_taken varchar [note: 'Description of remedial actions taken in response to a breach, including legal action, fee collection, or agreement termination.']
  scope_description varchar [note: 'Detailed narrative describing the scope and boundaries of the exclusivity arrangement, including any carve-outs, permitted actions, or restrictions on counterparty behavior.']
  source_system_code varchar [note: 'Unique identifier of this exclusivity agreement record in the source operational system, enabling traceability and reconciliation.']
  standstill_period_months varchar [note: 'Duration in months for which the standstill provision remains in effect, restricting hostile actions by the buyer.']
  standstill_provision_flag boolean [note: 'Indicates whether the agreement includes a standstill provision preventing the buyer from taking hostile action (e.g., unsolicited tender offer) during or after the exclusivity period.']
  target_entity_name varchar [note: 'Name of the target company, asset, or investment opportunity that is the subject of the exclusivity agreement.']
  target_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the target entity, if applicable and available.']
  termination_date date [note: 'Actual date on which the exclusivity agreement was terminated early, if applicable (null if agreement ran to expiry or is still active).']
  valuation_currency varchar [note: 'ISO 4217 three-letter currency code for the indicative enterprise value.']

  Note: 'Master record for exclusivity agreements negotiated with sellers or GPs during deal execution. Captures the opportunity, counterparty, exclusivity start date, exclusivity end date, exclusivity scope description, break fee amount, break fee currency'
}

Table deal.milestone {
  milestone_id varchar [pk, note: 'Unique identifier for the deal_milestone data product (auto-inserted during validation).']
  completed_by_user_employee_id varchar [note: 'System identifier of the user who marked this milestone as completed.']
  employee_id varchar [note: 'System identifier of the user assigned as responsible for this milestone completion.']
  opportunity_id varchar [note: 'Reference to the investment opportunity this milestone belongs to.']
  actual_date date [note: 'Date when the milestone was actually achieved or completed.']
  approving_committee varchar [note: 'Name of the Investment Committee (IC) or governance body that approved this milestone.']
  asset_class varchar [note: 'Investment asset class category for this deal milestone such as public equities, private equity, real estate, infrastructure, natural resources, or credit.']
  conditions_imposed varchar [note: 'Description of any conditions, contingencies, or requirements imposed at this milestone by Investment Committee (IC) or counterparty.']
  conditions_met boolean [note: 'Flag indicating whether all conditions precedent for this milestone have been satisfied.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the counterparty entity.']
  counterparty_name varchar [note: 'Name of the counterparty organization involved in this milestone such as seller, General Partner (GP), or intermediary.']
  deal_type varchar [note: 'Classification of the deal structure associated with this milestone.']
  decision_date date [note: 'Date when the gate decision was formally made by the Investment Committee (IC) or approving authority.']
  document_execution_date date [note: 'Date when the associated legal or business document was formally executed by all parties.']
  document_reference_number varchar [note: 'Reference number of the key legal or business document associated with this milestone such as Non-Disclosure Agreement (NDA), Letter of Intent (LOI), or Share Purchase Agreement (SPA) number.']
  esg_review_required boolean [note: 'Flag indicating whether Environmental, Social, and Governance review is required at this milestone per Principles for Responsible Investment (PRI) standards.']
  esg_review_status varchar [note: 'Current status of the Environmental, Social, and Governance due diligence review for this milestone.']
  gate_decision varchar [note: 'Decision outcome for gate milestones requiring formal approval or go/no-go determination.']
  gp_sponsor_name varchar [note: 'Name of the General Partner or sponsor firm managing the investment vehicle or co-investment opportunity.']
  ic_meeting_date date [note: 'Date of the Investment Committee meeting where this milestone was reviewed or approved.']
  intermediary_name varchar [note: 'Name of the investment bank, broker, or advisor intermediating the deal opportunity.']
  investment_strategy varchar [note: 'Strategic investment approach or mandate under which this deal milestone is being executed.']
  is_critical_path boolean [note: 'Flag indicating whether this milestone is on the critical path for deal closure.']
  is_gate_milestone boolean [note: 'Flag indicating whether this milestone represents a formal approval gate requiring Investment Committee (IC) or governance decision.']
  milestone_code varchar [note: 'Standardized code representing the milestone type for system processing and reporting.']
  milestone_name varchar [note: 'Human-readable name of the milestone event for business user display and reporting.']
  milestone_status varchar [note: 'Current lifecycle status of the milestone indicating its completion state.']
  milestone_timestamp timestamp [note: 'Precise timestamp when the milestone event occurred for audit trail and sequencing.']
  milestone_type varchar [note: 'Classification of the milestone event in the deal execution timeline. [ENUM-REF-CANDIDATE: nda_signed|loi_issued|exclusivity_granted|dd_commenced|ic_submission|ic_approval|spa_signed|regulatory_filing|financial_close — 9 candidates stripped; promote to']
  notes varchar [note: 'Free-text commentary providing additional context, observations, or instructions related to this milestone.']
  notification_sent boolean [note: 'Flag indicating whether automated notification was sent to stakeholders upon milestone completion or status change.']
  notification_timestamp timestamp [note: 'Timestamp when the milestone notification was sent to stakeholders.']
  record_created_by varchar [note: 'Username or identifier of the user who created this milestone record.']
  record_created_timestamp timestamp [note: 'Timestamp when this milestone record was first created in the system for audit trail purposes.']
  record_updated_timestamp timestamp [note: 'Timestamp when this milestone record was last modified for change tracking and audit compliance.']
  regulatory_approval_required boolean [note: 'Flag indicating whether regulatory or governmental approval is required to complete this milestone.']
  regulatory_jurisdiction varchar [note: 'Jurisdiction or regulatory body whose approval is required for this milestone such as the national pension regulator, Securities and Exchange Commission (SEC), or Financial Conduct Authority (FCA).']
  responsible_party varchar [note: 'Name of the individual or team responsible for completing this milestone.']
  risk_rating varchar [note: 'Risk assessment level assigned to this milestone based on execution complexity, market conditions, or counterparty factors.']
  scheduled_date date [note: 'Planned or target date for achieving this milestone as per deal execution plan.']
  sequence varchar [note: 'Ordinal position of this milestone within the deal execution timeline for chronological ordering.']
  source_system_code varchar [note: 'Unique identifier of this milestone record in the source system for data lineage and reconciliation.']
  target_entity_name varchar [note: 'Legal name of the target company or asset being acquired or invested in.']
  target_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the target entity enabling global counterparty identification.']
  variance_days varchar [note: 'Number of days difference between scheduled and actual milestone completion, positive for delays and negative for early completion.']

  Note: 'Transactional record tracking key milestones in the deal execution timeline. Captures the opportunity, milestone type (NDA signed, LOI issued, exclusivity granted, DD commenced, IC submission, IC approval, SPA signed, regulatory filing, financial close)'
}

Table deal.co_invest_allocation {
  co_invest_allocation_id varchar [pk, note: 'Unique identifier for the co-investment allocation record.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: Co-investors must have KYC verification before accepting their capital commitments. The kyc_aml_status attribute indicates this is tracked.']
  opportunity_id varchar [note: 'Reference to the parent deal opportunity for which this co-investment allocation is offered or accepted.']
  relationship_manager_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Co-investment relationship management requires tracking assigned employee for LP/co-investor communications and reporting. New FK replaces denormalized relationship_manager_name.']
  actual_close_date date [note: 'Actual date on which the co-investment transaction reached financial close and all funding was completed.']
  allocated_amount decimal(18,2) [note: 'The monetary amount of co-investment capital allocated to or accepted by the co-investor for this opportunity.']
  allocation_acceptance_date date [note: 'Date on which the co-investor formally accepted the co-investment allocation offer.']
  allocation_commitment_date date [note: 'Date on which the co-investor legally committed capital to the co-investment, typically via signed commitment letter or Limited Partnership Agreement (LPA).']
  allocation_currency varchar [note: 'Three-letter ISO 4217 currency code for the allocated co-investment amount.']
  allocation_expiry_date date [note: 'Date by which the co-investor must accept the allocation offer, after which the offer becomes void.']
  allocation_funding_date date [note: 'Date on which the co-investor transferred funds to fulfill their co-investment allocation.']
  allocation_notes varchar [note: 'Free-text field for additional context, special terms, conditions, or internal commentary related to this co-investment allocation.']
  allocation_offer_date date [note: 'Date on which the co-investment opportunity was formally offered to the co-investor.']
  allocation_reference_number varchar [note: 'Externally-known unique reference number for this co-investment allocation, used in communications with co-investors and internal tracking.']
  allocation_status varchar [note: 'Current operational status of the co-investment allocation in its workflow.']
  allocation_type varchar [note: 'Classification of the allocation lifecycle stage: offered to co-investor, accepted by co-investor, declined, committed, funded, or withdrawn.']
  carried_interest_percent decimal(5,4) [note: 'Performance-based fee percentage (carry) charged on profits above the hurdle rate, expressed as a decimal fraction.']
  co_investor_entity_name varchar [note: 'Full legal name of the co-investing entity or institution participating in this allocation.']
  co_investor_jurisdiction varchar [note: 'Three-letter ISO country code representing the legal jurisdiction of the co-investor entity.']
  co_investor_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the co-investing party, enabling global counterparty identification.']
  co_investor_type varchar [note: 'Classification of the co-investor by institutional type, reflecting their investment mandate and regulatory framework.']
  confidentiality_level varchar [note: 'Data classification level for this co-investment allocation record, governing access and disclosure controls.']
  decline_reason varchar [note: 'Explanation provided by the co-investor for declining the co-investment allocation offer, if applicable.']
  expected_close_date date [note: 'Anticipated date for the co-investment transaction to reach financial close and funding completion.']
  fee_arrangement varchar [note: 'Classification of the fee structure applied to this co-investment allocation, indicating whether management fees, carried interest, or both are charged.']
  governance_rights varchar [note: 'Summary of governance, voting, and information rights granted to the co-investor, such as board observer status, consent rights, or veto provisions.']
  hurdle_rate_percent decimal(5,4) [note: 'Minimum annualized return threshold that must be achieved before carried interest is charged, expressed as a decimal percentage.']
  ic_approval_date date [note: 'Date on which the Investment Committee approved this co-investment allocation, if applicable.']
  ic_approval_required_flag boolean [note: 'Indicates whether Investment Committee approval was required for this co-investment allocation.']
  kyc_aml_status varchar [note: 'Current status of KYC and AML due diligence and compliance checks for the co-investor entity.']
  kyc_completion_date date [note: 'Date on which KYC and AML due diligence was completed and approved for the co-investor.']
  lead_investment_professional varchar [note: 'Name of the lead investment professional from the pension fund responsible for originating and managing this co-investment opportunity.']
  lpa_reference_number varchar [note: 'Reference number for the Limited Partnership Agreement or co-investment agreement governing this allocation.']
  management_fee_percent decimal(5,4) [note: 'Annual management fee rate charged on the co-investment allocation, expressed as a decimal percentage of committed or invested capital.']
  ownership_percentage decimal(5,4) [note: 'Percentage of total deal equity or ownership that this co-investment allocation represents, expressed as a decimal fraction.']
  record_created_by varchar [note: 'Username or identifier of the user or system process that created this co-investment allocation record.']
  record_created_timestamp timestamp [note: 'Timestamp when this co-investment allocation record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this co-investment allocation record was last modified in the data platform.']
  regulatory_approval_required_flag boolean [note: 'Indicates whether regulatory or governmental approval is required for this co-investment allocation due to jurisdiction, sector, or size thresholds.']
  regulatory_approval_status varchar [note: 'Current status of any required regulatory approvals for the co-investment allocation.']
  side_letter_flag boolean [note: 'Indicates whether a side letter agreement with special terms or rights was executed for this co-investor allocation.']
  side_letter_reference varchar [note: 'Reference number or document identifier for the side letter agreement, if applicable.']
  source_system_code varchar [note: 'Unique identifier for this co-investment allocation record in the source operational system, enabling traceability and reconciliation.']
  subscription_agreement_reference varchar [note: 'Reference number for the subscription agreement executed by the co-investor to formalize their capital commitment.']
  withdrawal_reason varchar [note: 'Explanation for withdrawal of the co-investment allocation by either party after initial acceptance or commitment.']

  Note: 'Master record for co-investment allocations offered to or accepted from co-investors alongside the pension fund\'s direct investment. Captures the opportunity, co-investor entity name, co-investor LEI, allocated co-invest amount, co-invest currency'
}

Table deal.deal_fee {
  deal_fee_id varchar [pk, note: 'Unique identifier for the deal fee transaction record.']
  approver_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Fee approval workflow requires tracking approving employee for financial controls and audit. Pension funds require documented approval chains for all expenditures.']
  co_invest_allocation_id varchar [note: 'Reference to the parent deal or transaction if the opportunity has progressed to execution stage.']
  deal_ic_submission_id varchar [note: 'Reference to the Investment Committee submission or approval record associated with this deal and its fees.']
  deal_opportunity_id varchar [note: 'Reference to the parent deal or transaction if the opportunity has progressed to execution stage.']
  opportunity_id varchar [note: 'Reference to the investment opportunity or deal pipeline record to which this fee relates.']
  rate_schedule_id varchar [note: 'Foreign key linking to fee.rate_schedule. Business justification: Deal fee calculations require standardized rate structures per LPA terms. Investment professionals reference rate_schedule when negotiating/validating advisor fees, ensuring consistency']
  amount decimal(18,2) [note: 'Monetary value of the fee in the specified currency representing the cost incurred or committed.']
  amount_usd decimal(18,2) [note: 'Fee amount converted to USD using the applicable exchange rate for consolidated reporting and analysis.']
  approval_date date [note: 'Date on which the fee transaction received formal approval from the authorized approver.']
  approval_status varchar [note: 'Current approval status of the fee transaction within internal governance and authorization workflows.']
  asset_class varchar [note: 'Investment asset class associated with the deal for which this fee was incurred such as private equity or real estate.']
  basis varchar [note: 'Methodology or structure used to calculate the fee amount such as fixed amount or percentage of transaction value.']
  calculation_base_amount decimal(18,2) [note: 'The underlying transaction value or asset amount upon which percentage-based fees are calculated.']
  cost_center_code varchar [note: 'Internal cost center or business unit code to which this fee is allocated for management accounting purposes.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the fee amount is denominated.']
  deal_stage varchar [note: 'Pipeline stage or phase of the deal at which this fee was incurred such as due diligence or closing.']
  engagement_letter_reference varchar [note: 'Reference number or identifier of the engagement letter or service agreement governing this fee arrangement.']
  fee_category varchar [note: 'High-level grouping of the fee for financial reporting and cost allocation purposes.']
  fee_status varchar [note: 'Current lifecycle status of the fee transaction indicating its progression from estimation through payment.']
  fee_type varchar [note: 'Classification of the fee based on the service or purpose it represents during deal origination and execution.']
  fx_rate decimal(12,6) [note: 'Exchange rate applied to convert the fee amount from the original currency to USD for reporting purposes.']
  fx_rate_date date [note: 'Date on which the foreign exchange rate was determined or applied for currency conversion.']
  gl_account_code varchar [note: 'General ledger account code to which this fee expense is posted for financial accounting and reporting.']
  invoice_date date [note: 'Date on which the service provider issued the invoice for this fee.']
  invoice_due_date date [note: 'Date by which payment of the invoiced fee amount is contractually due to the service provider.']
  invoice_number varchar [note: 'Unique invoice reference number issued by the service provider for this fee transaction.']
  is_capitalizable boolean [note: 'Indicates whether this fee is eligible to be capitalized as part of the investment cost basis per accounting standards.']
  is_reimbursable boolean [note: 'Indicates whether this fee is eligible for reimbursement from a co-investor or counterparty per transaction agreements.']
  notes varchar [note: 'Free-text field for additional comments or contextual information regarding this fee transaction.']
  payment_date date [note: 'Actual date on which the fee payment was disbursed to the service provider.']
  payment_method varchar [note: 'Financial instrument or mechanism used to disburse the fee payment to the service provider.']
  payment_reference_number varchar [note: 'Unique reference number assigned to the payment transaction in the treasury or accounts payable system.']
  percentage decimal(5,4) [note: 'Percentage rate applied to the transaction value or asset base when fee is calculated on a percentage basis.']
  record_created_by varchar [note: 'User identifier or system account that created this fee record in the data platform.']
  record_created_timestamp timestamp [note: 'Timestamp when this fee record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'Timestamp when this fee record was last modified or updated in the data platform.']
  reference_number varchar [note: 'External or internal reference number assigned to this fee transaction for tracking and reconciliation purposes.']
  reimbursement_amount decimal(18,2) [note: 'Portion of the fee amount that has been or will be reimbursed by a co-investor or counterparty.']
  reimbursement_date date [note: 'Date on which the reimbursement amount was received from the co-investor or counterparty.']
  service_description varchar [note: 'Detailed description of the professional service or advisory work performed for which this fee is charged.']
  service_end_date date [note: 'Date on which the service provider completed or concluded work related to this fee.']
  service_provider_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the service provider enabling global counterparty identification.']
  service_provider_name varchar [note: 'Legal name of the external firm or advisor providing the service for which this fee is charged.']
  service_provider_type varchar [note: 'Classification of the service provider based on their professional specialty and role in the transaction.']
  service_start_date date [note: 'Date on which the service provider commenced work or services related to this fee.']
  source_system_code varchar [note: 'Unique identifier of this fee record in the originating source system for traceability and reconciliation.']

  Note: 'Transactional record for fees incurred during deal origination and execution—including advisory fees, break fees, arrangement fees, legal fees, and due diligence costs.'
}

Table deal.deal_contact {
  deal_contact_id varchar [pk, note: 'Unique identifier for the deal contact record. Primary key.']
  opportunity_id varchar [note: 'Reference to the deal opportunity this contact is associated with.']
  confidentiality_level varchar [note: 'Data classification level for information shared with this contact (public, internal, confidential, or restricted).']
  conflict_of_interest_description varchar [note: 'Description of any identified conflict of interest with this contact.']
  conflict_of_interest_flag boolean [note: 'Indicates whether a potential conflict of interest has been identified with this contact.']
  contact_role varchar [note: 'Specific role or title of the contact within their organization (e.g., Managing Director, Chief Executive Officer, Partner, General Counsel).']
  contact_type varchar [note: 'Classification of the contact\'s role in the deal (sell-side advisor, management team member, GP representative, legal counsel, intermediary, or broker).']
  data_room_access_date date [note: 'Date when data room access was granted to this contact.']
  data_room_access_granted_flag boolean [note: 'Indicates whether this contact has been granted access to the deal data room.']
  decision_maker_flag boolean [note: 'Indicates whether this contact has decision-making authority for the deal.']
  email_address varchar [note: 'Primary email address for the contact.']
  first_contact_date date [note: 'Date when initial contact was established with this person for the deal opportunity.']
  first_name varchar [note: 'First name of the contact person.']
  full_name varchar [note: 'Full legal name of the contact person.']
  kyc_completion_date date [note: 'Date when KYC verification was completed for this contact.']
  kyc_expiry_date date [note: 'Date when the current KYC verification expires and requires renewal.']
  kyc_status varchar [note: 'Status of Know Your Customer verification for this contact (not started, in progress, completed, failed, or expired).']
  last_contact_date date [note: 'Date of the most recent interaction with this contact.']
  last_name varchar [note: 'Last name of the contact person.']
  linkedin_profile_url varchar [note: 'URL to the contact\'s LinkedIn profile for professional background verification.']
  mobile_number varchar [note: 'Mobile phone number for the contact.']
  nda_signatory_flag boolean [note: 'Indicates whether this contact is an authorized signatory for NDA execution.']
  notes varchar [note: 'Free-text notes or comments about the contact, interactions, or relationship history.']
  office_address_line1 varchar [note: 'First line of the contact\'s office address.']
  office_address_line2 varchar [note: 'Second line of the contact\'s office address.']
  office_city varchar [note: 'City of the contact\'s office location.']
  office_country_code varchar [note: 'Three-letter ISO country code for the contact\'s office location.']
  office_postal_code varchar [note: 'Postal code of the contact\'s office location.']
  office_state_province varchar [note: 'State or province of the contact\'s office location.']
  organization_lei varchar [note: 'Legal Entity Identifier for the contact\'s organization.']
  organization_name varchar [note: 'Name of the organization or firm the contact represents.']
  organization_type varchar [note: 'Type of organization the contact represents (investment bank, advisory firm, law firm, GP sponsor, intermediary, or broker-dealer).']
  phone_number varchar [note: 'Primary phone number for the contact.']
  preferred_communication_method varchar [note: 'Preferred method of communication for this contact (email, phone, mobile, video conference, or in-person).']
  primary_contact_flag boolean [note: 'Indicates whether this is the primary contact for the deal opportunity.']
  professional_biography varchar [note: 'Brief professional biography or background summary of the contact.']
  record_created_by varchar [note: 'User or system identifier that created this contact record.']
  record_created_timestamp timestamp [note: 'Timestamp when this contact record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this contact record was last updated in the system.']
  relationship_status varchar [note: 'Current status of the relationship with this contact (active, inactive, suspended, or terminated).']
  source_system_code varchar [note: 'Unique identifier for this contact in the source system.']
  specialization_area varchar [note: 'Area of specialization or expertise (e.g., private equity, real estate, infrastructure, mergers and acquisitions).']
  years_of_experience varchar [note: 'Number of years of professional experience in the relevant industry or role.']

  Note: 'Master record for external contacts associated with a deal opportunity—including sell-side advisors, management teams, GP representatives, legal counsel, and intermediaries.'
}

Table deal.deal_check {
  deal_check_id varchar [pk, note: 'Primary key for the check association']
  employee_id varchar [note: 'Foreign key to the user or compliance officer who performed or approved the compliance check.']
  opportunity_id varchar [note: 'Foreign key linking to the investment opportunity being checked for compliance']
  rule_id varchar [note: 'Foreign key linking to the compliance rule being evaluated against the opportunity']
  deal_check_date date [note: 'Date when the compliance check was performed against the opportunity.']
  deal_check_status varchar [note: 'Outcome of the compliance check indicating whether the opportunity passed, failed, is pending review, received an exception, or the rule was not applicable.']
  exception_flag boolean [note: 'Indicates whether an exception to the compliance rule was granted for this opportunity.']

  Note: 'This association product represents the Compliance Check event between an investment opportunity and a compliance rule. It captures the operational record of each compliance verification performed during the deal pipeline process.'
}

Table diligence.dd_engagement {
  dd_engagement_id varchar [pk, note: 'Unique system-generated identifier for a formal due diligence engagement record. Primary key for the dd_engagement product.']
  concession_agreement_id varchar [note: 'Foreign key linking to infrastructure.concession_agreement. Business justification: Concession agreements are key infrastructure contracts; linking dd_engagement to concession_agreement supports regulatory and financial due diligence on the agreement']
  dd_employee_id varchar [note: 'Internal employee identifier for the primary analyst responsible for coordinating and executing the DD engagement. Sourced from SAP SuccessFactors HR system.']
  dd_ic_sponsor_employee_id varchar [note: 'Internal employee identifier for the senior investment professional sponsoring this DD engagement at the Investment Committee level. Sourced from Diligent/BoardEffect.']
  deal_opportunity_id varchar [note: 'Reference to the originating deal or pipeline opportunity in the deal origination domain (Dealpath/DealCloud). Links DD engagement to the upstream sourcing record.']
  employee_id varchar [note: 'Internal employee identifier for the primary analyst responsible for coordinating and executing the DD engagement. Sourced from SAP SuccessFactors HR system.']
  gp_profile_id varchar [note: 'Reference to the external fund manager record in the manager domain when the DD engagement is a manager-level ODD or mandate review. Null for direct investment engagements.']
  ic_sponsor_employee_id varchar [note: 'Internal employee identifier for the senior investment professional sponsoring this DD engagement at the Investment Committee level. Sourced from Diligent/BoardEffect.']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Due diligence is routinely performed before committing capital to a fund; FK connects engagement to the specific fund commitment for audit and compliance.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager record in the manager domain when the DD engagement is a manager-level ODD or mandate review. Null for direct investment engagements.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: DD engagements for mandate renewals, amendments, or re-ups must link to the specific mandate under review.']
  opportunity_id varchar [note: 'Reference to the originating deal or pipeline opportunity in the deal origination domain (Dealpath/DealCloud). Links DD engagement to the upstream sourcing record.']
  prior_engagement_dd_engagement_id varchar [note: 'Reference to the previous DD engagement record for the same target entity when this is a repeat or re-underwriting engagement. Enables longitudinal DD history tracking.']
  project_investment_id varchar [note: 'Foreign key linking to infrastructure.project_investment. Business justification: Engagements often target a project investment; FK allows tracking of due diligence outcomes per project and integration with investment decision workflows.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Due diligence engagement is performed on a specific natural resource asset; linking enables traceability of the engagement to the asset.']
  actual_completion_date date [note: 'Actual calendar date on which all DD workstreams were completed and the final DD report was signed off. Null if engagement is still in progress.']
  asset_class varchar [note: 'Primary asset class of the investment under review. Determines applicable valuation methodology, risk framework, and regulatory reporting requirements for the DD engagement.']
  cdd_rating varchar [note: 'Outcome rating for the Commercial Due Diligence workstream evaluating market position, competitive dynamics, revenue quality, and business model sustainability.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code for the proposed capital commitment amount (e.g., USD, EUR, GBP). Required for FX hedging analysis and treasury planning.']
  conditions_precedent varchar [note: 'Narrative description of any conditions precedent or outstanding items that must be resolved before the investment can proceed following IC approval. Tracked post-IC decision.']
  created_timestamp timestamp [note: 'System timestamp recording when the DD engagement record was first created in the data platform. Used for audit trail, data lineage, and SLA compliance tracking.']
  data_room_location varchar [note: 'URL or system reference to the virtual data room (VDR) where confidential DD documents, financial statements, and legal materials are stored for this engagement.']
  dd_type varchar [note: 'Classification of the due diligence engagement by discipline: ODD (Operational), FDD (Financial), CDD (Commercial), Legal, ESG, or Combined multi-workstream engagement.']
  engagement_name varchar [note: 'Descriptive name for the DD engagement, typically referencing the target entity and DD type (e.g., \'Acme Infrastructure Fund IV - ODD 2024\'). Used for display and search.']
  engagement_priority varchar [note: 'Business priority level assigned to the DD engagement reflecting deal urgency, strategic importance, and resource allocation. Drives analyst bandwidth and timeline management.']
  engagement_reference varchar [note: 'Externally-known alphanumeric reference code assigned to the DD engagement at initiation (e.g., DD-2024-00123). Used for cross-system tracking in eFront and Dealpath/DealCloud.']
  engagement_scope varchar [note: 'Narrative description of the defined scope, boundaries, and objectives of the DD engagement including specific workstreams, geographic coverage, and exclusions agreed at initiation.']
  engagement_status varchar [note: 'Current lifecycle state of the DD engagement from initiation through IC review to completion or cancellation. Drives workflow routing in eFront and Diligent/BoardEffect.']
  esg_dd_rating varchar [note: 'Outcome rating for the ESG Due Diligence workstream assessing environmental risks, social practices, and governance quality per PRI and TCFD frameworks.']
  esg_material_issues varchar [note: 'Description of material ESG issues identified during the ESG DD workstream, including GHG exposure, social risks, and governance deficiencies per TCFD and PRI frameworks.']
  fdd_rating varchar [note: 'Outcome rating for the Financial Due Diligence workstream covering financial statement analysis, EBITDA quality, cash flow, and capital structure assessment.']
  ic_decision varchar [note: 'Formal outcome of the Investment Committee review following DD completion. Drives downstream capital commitment and mandate execution workflows.']
  ic_decision_date date [note: 'Date on which the Investment Committee rendered its formal decision on the investment opportunity following DD completion. Null if IC review is pending.']
  ic_submission_date date [note: 'Date on which the completed DD package and Investment Memorandum (IM) were formally submitted to the Investment Committee for approval consideration.']
  im_reference varchar [note: 'Document reference or identifier for the Investment Memorandum (IM) prepared as the primary IC submission document summarizing DD findings and investment recommendation.']
  initiation_date date [note: 'Calendar date on which the formal DD engagement was officially initiated and the DD team was mandated. Represents the principal business event date for the engagement lifecycle.']
  investment_strategy varchar [note: 'Stated investment strategy of the target entity or fund (e.g., Buyout, Growth Equity, Core Infrastructure, Value-Add Real Estate, Senior Secured Credit). Informs DD checklist selection.']
  key_risks_summary varchar [note: 'Narrative summary of the most material risks identified across all DD workstreams. Included in the IC submission package and Investment Memorandum for decision-maker review.']
  kyc_aml_cleared boolean [note: 'Indicates whether the target entity has passed KYC/AML screening as required by FATF guidelines prior to investment. Mandatory compliance gate for all engagements.']
  kyc_cleared_date date [note: 'Date on which KYC/AML clearance was formally confirmed for the target entity. Required for regulatory audit trail and compliance reporting to FATF.']
  last_updated_timestamp timestamp [note: 'System timestamp recording the most recent modification to the DD engagement record. Supports incremental data loading, change detection, and audit trail requirements.']
  lead_analyst_name varchar [note: 'Full name of the internal lead analyst responsible for the DD engagement. Denormalized for reporting and IC memorandum generation without requiring HR system join.']
  legal_dd_rating varchar [note: 'Outcome rating for the Legal Due Diligence workstream covering corporate structure, title, regulatory compliance, litigation exposure, and contractual obligations.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity prior to commencement of the DD engagement. Required before confidential data sharing.']
  nda_execution_date date [note: 'Date on which the NDA was formally executed between the pension fund and the target entity. Establishes the legal basis for confidential information exchange during DD.']
  odd_rating varchar [note: 'Outcome rating for the Operational Due Diligence workstream assessing governance, controls, technology, and operational infrastructure of the target entity.']
  overall_dd_rating varchar [note: 'Consolidated DD outcome rating summarizing findings across all workstreams. Represents the lead analyst and DD team\'s aggregate assessment of the target entity\'s suitability.']
  proposed_commitment_amount decimal(20,2) [note: 'Proposed capital commitment or investment amount under consideration, expressed in the base currency. Used for IC sizing approval and portfolio construction impact assessment.']
  regulatory_flags varchar [note: 'Free-text notation of any regulatory concerns, sanctions screening results, or compliance flags raised during the DD process requiring escalation or legal review.']
  repeat_engagement boolean [note: 'Indicates whether this is a repeat or re-underwriting DD engagement on a previously reviewed entity (e.g., re-up fund commitment, periodic ODD refresh on existing manager).']
  target_completion_date date [note: 'Planned date by which all DD workstreams must be completed and findings consolidated for IC submission. Used for project tracking and SLA monitoring.']
  target_entity_name varchar [note: 'Legal name of the investment target, co-investment vehicle, or external fund manager subject to this DD engagement. Sourced from Dealpath/DealCloud or eFront.']
  target_entity_type varchar [note: 'Classification of the entity under DD review: Direct Investment, Co-Investment, External Fund Manager, Real Asset, or Credit Issuer. Determines applicable DD checklist and workstream scope.']
  target_geography varchar [note: 'Primary geographic focus of the investment or fund under review (e.g., North America, Europe, Global). Drives applicable regulatory and legal DD requirements.']
  third_party_advisor varchar [note: 'Name of the external advisory firm engaged to support the DD process (e.g., legal counsel, accounting firm, technical advisor, ESG consultant). Multiple advisors noted as comma-separated.']
  vintage_year varchar [note: 'Year in which the fund or investment vehicle was established or first called capital. Critical for private equity performance benchmarking and J-Curve analysis per GIPS standards.']

  Note: 'Master record for a formal due diligence engagement initiated on a prospective investment, co-investment, or external fund manager. Captures the DD type (ODD, FDD, CDD, Legal, ESG, or combined), the target entity under review, engagement status, lead'
}

Table diligence.dd_workstream {
  dd_workstream_id varchar [pk, note: 'Unique surrogate identifier for a distinct functional workstream within a due diligence engagement. Primary key for the dd_workstream entity.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement to which this workstream belongs. Links the workstream to its overarching diligence process.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity under diligence. Links the workstream to the origination pipeline record in Dealpath/DealCloud.']
  employee_id varchar [note: 'Internal staff member designated as the lead analyst responsible for executing and coordinating this workstream. Links to the HR/workforce record.']
  lead_analyst_employee_id varchar [note: 'Internal staff member designated as the lead analyst responsible for executing and coordinating this workstream. Links to the HR/workforce record.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity under diligence. Links the workstream to the origination pipeline record in Dealpath/DealCloud.']
  actual_completion_date date [note: 'Date on which this workstream was formally signed off as complete. Null if workstream is still in progress. Used for DD cycle time analytics.']
  actual_start_date date [note: 'Date on which work on this DD workstream actually commenced. Compared against planned start date to measure DD process efficiency.']
  advisor_engagement_ref varchar [note: 'External engagement or mandate reference number assigned by the third-party advisor firm for this workstream. Used for invoice reconciliation and report tracking.']
  advisor_fee_amount decimal(18,2) [note: 'Total fee amount committed or invoiced to the third-party advisor for this workstream. Denominated in the currency specified by advisor_fee_currency. Tracked for deal cost budgeting.']
  advisor_fee_currency varchar [note: 'ISO 4217 three-letter currency code for the advisor fee amount (e.g., USD, GBP). Required for multi-currency deal cost consolidation.']
  aml_kyc_concern_flag boolean [note: 'Indicates whether AML or KYC concerns were identified during this workstream. Triggers mandatory escalation to compliance per FATF AML requirements.']
  asset_class varchar [note: 'Asset class of the investment under diligence. Determines the applicable DD framework, checklist templates, and risk thresholds used in this workstream.']
  checklist_completion_pct decimal(5,2) [note: 'Percentage of checklist items within this workstream that have been completed. Provides a granular progress indicator beyond binary status fields.']
  checklist_template_ref varchar [note: 'Reference code or version identifier of the standardized DD checklist template applied to this workstream. Ensures consistency and regulatory alignment across engagements.']
  conditions_precedent varchar [note: 'Narrative description of conditions that must be satisfied before investment can proceed, as identified by this workstream. Tracked through to SPA execution.']
  created_timestamp timestamp [note: 'Timestamp at which this DD workstream record was first created in the system. Provides the audit trail creation anchor for data lineage and compliance purposes.']
  critical_finding_count varchar [note: 'Number of findings rated as Critical or deal-breaker severity within this workstream. A non-zero value typically triggers IC escalation or deal suspension.']
  data_room_access_flag boolean [note: 'Indicates whether the DD team has been granted access to the virtual data room (VDR) for this workstream. Access is a prerequisite for FDD and Legal DD execution.']
  data_room_platform varchar [note: 'Name of the virtual data room platform used for document sharing in this workstream (e.g., Intralinks, Datasite, Ansarada). Used for access audit and document provenance.']
  esg_materiality_flag boolean [note: 'Indicates whether ESG factors identified in this workstream are material to the investment decision. Triggers mandatory ESG DD escalation per PRI and TCFD commitments.']
  esg_risk_rating varchar [note: 'ESG-specific risk rating assigned within this workstream. Populated for ESG DD workstreams and used as an input to MSCI ESG scoring and portfolio-level ESG reporting.']
  finding_count varchar [note: 'Total number of findings identified within this workstream. Provides a quantitative measure of diligence depth and issue density for IC reporting.']
  ic_approval_required_flag boolean [note: 'Indicates whether the findings of this workstream must be formally presented to and approved by the Investment Committee before the deal can proceed.']
  ic_submission_deadline date [note: 'Hard deadline by which this workstream findings must be incorporated into the Investment Memorandum (IM) for IC review and approval.']
  investment_type varchar [note: 'Nature of the investment structure under diligence: Direct, Co-Investment, Fund Subscription, Secondary market transaction, or Separately Managed Account (SMA).']
  key_findings_summary varchar [note: 'Executive summary of the principal findings from this workstream. Incorporated into the Investment Memorandum (IM) for IC review. Confidential deal-sensitive content.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this DD workstream record. Used for change tracking, data freshness monitoring, and incremental ETL processing.']
  nda_executed_flag boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity prior to commencement of this workstream. Required before accessing confidential data room.']
  open_finding_count varchar [note: 'Number of findings that remain unresolved or unmitigated at the time of reporting. Tracks outstanding diligence items blocking workstream sign-off.']
  overall_risk_rating varchar [note: 'Aggregate risk rating assigned to this workstream based on findings. Informs IC decision-making and determines whether deal-breaker conditions exist.']
  planned_completion_date date [note: 'Target date by which this workstream must be completed to meet the IC submission deadline. Drives escalation and resource allocation decisions.']
  planned_start_date date [note: 'Scheduled date on which work on this DD workstream is planned to commence. Used for resource planning and IC timeline management.']
  priority_level varchar [note: 'Business priority assigned to this workstream relative to other concurrent workstreams in the engagement. Drives resource allocation and escalation sequencing.']
  recommendation varchar [note: 'Formal recommendation from the workstream lead submitted to the IC. Drives the overall deal disposition decision. Confidential pre-IC deliberation content.']
  regulatory_concern_flag boolean [note: 'Indicates whether this workstream has identified a regulatory, compliance, or legal concern requiring escalation to the Chief Compliance Officer or Legal counsel.']
  report_issued_date date [note: 'Date on which the final or most recent version of the DD report for this workstream was formally issued to the investment team and IC.']
  report_version varchar [note: 'Version identifier of the most recent DD report produced for this workstream (e.g., v1.0, v2.3). Tracks report iteration history for IC audit trail.']
  scope_description varchar [note: 'Narrative description of the specific scope, objectives, and boundaries of this workstream. Documents what is in and out of scope for IC transparency.']
  sign_off_timestamp timestamp [note: 'Timestamp at which the workstream owner formally signed off on the completeness and accuracy of this workstream. Constitutes the official DD completion event for audit purposes.']
  target_country varchar [note: 'ISO 3166-1 alpha-3 country code of the target entity\'s primary jurisdiction. Used for geopolitical risk assessment, sanctions screening, and regulatory compliance.']
  target_entity_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier (LEI) of the target entity. Used for regulatory reporting, counterparty identification, and KYC/AML verification.']
  target_entity_name varchar [note: 'Legal name of the company, fund, or asset being evaluated in this workstream. Confidential pre-announcement deal information. May differ from deal code name.']
  third_party_advisor varchar [note: 'Name of the external advisory firm engaged to support this workstream (e.g., Big 4 accounting firm for FDD, law firm for Legal DD, ESG consultant for ESG DD).']
  vintage_year varchar [note: 'Year in which the fund or investment commitment is expected to be made. Relevant for private equity and fund subscription workstreams for J-Curve and performance benchmarking.']
  workstream_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this workstream within the DD engagement. Used for cross-system referencing in eFront and Dealpath.']
  workstream_name varchar [note: 'Human-readable descriptive name for the workstream (e.g., \'Financial Due Diligence — Project Maple\'). Used in IC memoranda and reporting dashboards.']
  workstream_owner varchar [note: 'Name or title of the senior investment professional accountable for the quality and completeness of this workstream. Typically a Managing Director or VP.']
  workstream_status varchar [note: 'Current lifecycle state of the workstream. Drives IC governance reporting and tracks progress toward DD completion sign-off.']
  workstream_type varchar [note: 'Functional category of the workstream: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Tax DD. Determines the checklist and risk framework applied.']

  Note: 'Represents a distinct functional workstream within a DD engagement — Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Tax DD.'
}

Table diligence.dd_checklist {
  dd_checklist_id varchar [pk, note: 'Unique surrogate identifier for a DD checklist record within the diligence domain. Primary key for the dd_checklist product.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement to which this checklist belongs. Links the checklist to a specific deal, fund manager, or asset under review.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline for which this checklist is being executed. Links to Dealpath/DealCloud origination records.']
  employee_id varchar [note: 'Reference to the internal analyst or associate responsible for leading the completion of this checklist workstream.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or GP being evaluated, when this checklist is used for manager-level ODD or mandate due diligence.']
  lead_analyst_employee_id varchar [note: 'Reference to the internal analyst or associate responsible for leading the completion of this checklist workstream.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or GP being evaluated, when this checklist is used for manager-level ODD or mandate due diligence.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline for which this checklist is being executed. Links to Dealpath/DealCloud origination records.']
  parent_template_dd_checklist_id varchar [note: 'Reference to the standard master template from which this checklist was derived or customized. Enables lineage tracking between standard and customized checklists.']
  actual_completion_date date [note: 'Date on which this checklist was fully completed and signed off by the workstream lead. Null if not yet completed.']
  advisor_engagement_ref varchar [note: 'External engagement or contract reference number for the third-party advisor assigned to this DD workstream. Confidential business reference.']
  approved_by varchar [note: 'Name or identifier of the investment officer or DD lead who approved the completed checklist for IC submission.']
  approved_date date [note: 'Date on which the completed checklist was reviewed and approved by the DD lead or investment officer, confirming readiness for IC submission.']
  asset_class varchar [note: 'Asset class to which this checklist applies. Determines the scope and relevance of checklist items. [ENUM-REF-CANDIDATE: Private Equity|Real Estate|Infrastructure|Natural Resources|Credit|Public Equities|External Fund Manager — promote to reference']
  assigned_date date [note: 'Date on which this checklist was formally assigned to the DD team or workstream lead for the current engagement.']
  checklist_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this checklist template instance, used for cross-system referencing in eFront and Dealpath/DealCloud.']
  checklist_name varchar [note: 'Human-readable name of the checklist template, e.g., \'Infrastructure ODD Checklist v3\' or \'Private Equity FDD Standard Checklist\'.']
  checklist_status varchar [note: 'Current lifecycle status of the checklist template. Draft=in preparation, Active=approved for use, Deprecated=superseded by newer version, Archived=retired, Under Review=pending approval.']
  checklist_version varchar [note: 'Version identifier of the checklist template (e.g., \'1.0\', \'2.3\'), enabling tracking of template evolution and ensuring the correct version is applied to each engagement.']
  completed_item_count varchar [note: 'Number of checklist items that have been marked as completed within this checklist instance. Enables real-time progress monitoring by the DD team.']
  completion_status varchar [note: 'Operational completion status of this checklist instance within its assigned engagement. Tracks progress from initiation through completion or waiver.']
  conditions_precedent varchar [note: 'Description of any conditions precedent or outstanding requirements that must be satisfied before this checklist can be marked complete and IC approval granted.']
  created_timestamp timestamp [note: 'Timestamp when this checklist record was first created in the system. Audit trail field for data governance and lineage tracking.']
  critical_item_count varchar [note: 'Number of checklist items flagged as critical or mandatory. Critical items must be resolved before IC approval can be granted.']
  data_room_access boolean [note: 'Indicates whether the DD team has been granted access to the virtual data room (VDR) for this engagement, enabling document review and checklist completion.']
  data_room_url varchar [note: 'URL or access link to the virtual data room associated with this DD engagement. Confidential and restricted to authorized DD team members.']
  esg_scope_included boolean [note: 'Indicates whether ESG due diligence items are included within this checklist. Mandatory for all new investments per PRI and TCFD commitments.']
  geography varchar [note: 'ISO 3166-1 alpha-3 country code of the primary jurisdiction where the target entity or asset is domiciled. Drives regulatory and legal DD scope.']
  ic_submission_required boolean [note: 'Indicates whether completion of this checklist is a prerequisite for Investment Committee (IC) submission. Enforces governance gate controls.']
  investment_strategy varchar [note: 'Investment strategy or sub-strategy of the target (e.g., Buyout, Growth Equity, Core Infrastructure, Value-Add Real Estate, Direct Lending). Scopes the DD focus areas.']
  is_customized boolean [note: 'Indicates whether this checklist has been customized from the standard template for a specific engagement. Customized checklists require additional approval before use.']
  is_mandatory boolean [note: 'Indicates whether this checklist is mandatory for the associated asset class and workstream type. Mandatory checklists must be fully completed prior to IC submission.']
  key_findings_summary varchar [note: 'Narrative summary of key findings, red flags, or notable observations identified during completion of this checklist workstream. Confidential investment analysis.']
  kyc_aml_scope_included boolean [note: 'Indicates whether KYC/AML screening items are included in this checklist. Required for all new counterparties per FATF AML guidelines.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this checklist record. Used for change tracking, audit trails, and incremental data pipeline processing.']
  nda_in_place boolean [note: 'Indicates whether a signed NDA is in place with the target entity prior to commencement of this DD workstream. Required before accessing confidential materials.']
  outstanding_item_count varchar [note: 'Number of checklist items that remain open or unresolved. Derived operationally from total minus completed, but stored for reporting and IC governance dashboards.']
  overall_dd_recommendation varchar [note: 'Workstream-level recommendation arising from this checklist. Aggregated with other workstream recommendations to form the overall DD conclusion for IC.']
  regulatory_flags varchar [note: 'Free-text or structured notation of applicable regulatory considerations flagged during this DD workstream (e.g., CFIUS review, FIRB approval notification required).']
  risk_rating varchar [note: 'Overall risk rating assigned to this checklist based on findings to date. Informs IC decision-making and post-investment monitoring intensity.']
  source_system_ref varchar [note: 'Native identifier of this checklist record in the originating source system (e.g., eFront checklist ID or Dealpath checklist GUID) for reconciliation purposes.']
  target_completion_date date [note: 'Target date by which this checklist must be completed to meet the deal timeline and IC submission schedule.']
  target_entity_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the target entity under due diligence. Used for regulatory reporting and counterparty identification per EMIR and MiFID II.']
  target_entity_name varchar [note: 'Legal name of the target company, fund, asset, or manager being evaluated under this checklist. Confidential pre-announcement deal information.']
  third_party_advisor varchar [note: 'Name of the external advisor or consulting firm engaged to assist with this DD workstream (e.g., legal counsel, accounting firm, technical consultant).']
  total_item_count varchar [note: 'Total number of checklist items defined within this checklist template version. Used for progress tracking and completion percentage calculations.']
  vintage_year varchar [note: 'Year of the fund\'s first capital commitment or the deal\'s origination year. Used for benchmarking and cohort analysis in private markets DD.']
  workstream_type varchar [note: 'Type of DD workstream this checklist supports. ODD=Operational, FDD=Financial, CDD=Commercial, Legal DD=Legal, ESG DD=Environmental/Social/Governance, Tax DD=Tax.']

  Note: 'Standardized or customized DD checklist template assigned to a workstream within a DD engagement. Captures the checklist version, applicable asset class (private equity, real estate, infrastructure, credit, etc.), workstream type, total item count'
}

Table diligence.dd_checklist_item {
  dd_checklist_item_id varchar [pk, note: 'Unique surrogate identifier for an individual due diligence checklist line item. Primary key for the dd_checklist_item product.']
  dd_checklist_id varchar [note: 'Reference to the parent DD checklist that this line item belongs to. Links the item to its governing checklist template or engagement.']
  dd_employee_id varchar [note: 'Reference to the internal analyst or investment professional responsible for completing or reviewing this checklist item.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity under diligence. Links the checklist item to the originating deal in the pipeline.']
  employee_id varchar [note: 'Reference to the internal analyst or investment professional responsible for completing or reviewing this checklist item.']
  gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, if this checklist item relates to an Operational Due Diligence (ODD) or manager selection engagement.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, if this checklist item relates to an Operational Due Diligence (ODD) or manager selection engagement.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity under diligence. Links the checklist item to the originating deal in the pipeline.']
  reviewer_employee_id varchar [note: 'Reference to the senior analyst, portfolio manager, or compliance officer who reviewed and approved the response to this checklist item.']
  reviewer_id varchar [note: 'Reference to the senior analyst, portfolio manager, or compliance officer who reviewed and approved the response to this checklist item.']
  advisor_report_reference varchar [note: 'Reference number or document identifier for the third-party advisor report that addresses this checklist item. Links to the document management system.']
  asset_class varchar [note: 'Asset class context for this checklist item. Determines which DD template and regulatory framework applies. [ENUM-REF-CANDIDATE: promote to reference product if values expand]']
  completed_date date [note: 'Date on which this checklist item was marked as satisfactory or closed by the assigned analyst or reviewer. Supports DD completion tracking.']
  created_timestamp timestamp [note: 'Timestamp when this checklist item record was first created in the system. Supports audit trail and DD engagement timeline reconstruction.']
  data_room_reference varchar [note: 'Reference path or identifier for the supporting document in the virtual data room (VDR) that satisfies this checklist item.']
  dd_checklist_item_category varchar [note: 'Business category grouping for this item within its DD type (e.g., Governance, Financial Statements, ESG Policy, AML/KYC, Valuation, Fund Terms, Cybersecurity). Enables thematic reporting.']
  dd_type varchar [note: 'Classification of the diligence workstream this item belongs to: Financial DD (FDD), Operational DD (ODD), Commercial DD (CDD), Legal, ESG, Tax, or Technical. [ENUM-REF-CANDIDATE: FDD|ODD|CDD|Legal|ESG|Tax|Technical — promote to reference product]']
  due_date date [note: 'Target date by which this checklist item must be completed or a response received. Used for DD timeline management and escalation triggers.']
  effront_item_code varchar [note: 'Native identifier for this checklist item in the eFront Private Markets platform. Enables reconciliation and bi-directional synchronization with the system of record.']
  escalation_date date [note: 'Date on which this item was escalated due to non-response, unsatisfactory response, or identified risk. Triggers senior review workflow.']
  escalation_reason varchar [note: 'Narrative explanation for why this item was escalated, including the nature of the concern (e.g., missing document, adverse finding, counterparty non-response).']
  esg_dimension varchar [note: 'ESG pillar this item relates to, if applicable. Enables ESG-specific DD tracking aligned with PRI, TCFD, and SFDR reporting obligations.']
  extended_due_date date [note: 'Revised due date following a formal extension approval. Captures timeline changes for audit trail and DD project management reporting.']
  finding_summary varchar [note: 'Concise analyst summary of the key finding or observation for this checklist item. Included in the DD report and Investment Memorandum (IM) submitted to the IC.']
  guidance_notes varchar [note: 'Internal guidance text for the assigned analyst explaining the intent of the question, acceptable evidence, and evaluation criteria. Not shared with the counterparty.']
  is_ic_blocking boolean [note: 'Indicates whether an unresolved or escalated status on this item will block submission to the Investment Committee (IC). Supports IC governance gate controls.']
  is_mandatory boolean [note: 'Indicates whether this checklist item is mandatory for DD completion. Mandatory items must reach satisfactory status before the investment can proceed to IC approval.']
  is_recurring boolean [note: 'Indicates whether this checklist item recurs on a periodic basis (e.g., annual re-diligence of an external manager), as opposed to a one-time deal DD item.']
  item_reference_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this checklist item within the DD engagement (e.g., DD-FDD-00042). Used in advisor reports and IC submissions.']
  item_sequence varchar [note: 'Ordinal position of this checklist item within its parent checklist section, used to maintain structured ordering for IC presentation and reporting.']
  item_status varchar [note: 'Current workflow status of the checklist item. [ENUM-REF-CANDIDATE: open|in_progress|received|satisfactory|escalated|waived|closed — promote to reference product]']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this checklist item record. Used for change tracking, data lineage, and incremental ETL processing.']
  priority varchar [note: 'Business priority assigned to this checklist item, indicating urgency and materiality to the investment decision. Critical items may block IC approval.']
  question_text varchar [note: 'Full text of the diligence question, information request, or verification task as presented to the counterparty or assigned analyst. Core content of the checklist item.']
  recurrence_frequency varchar [note: 'Frequency at which this recurring checklist item must be re-executed. Applicable only when is_recurring is true. Drives automated scheduling in eFront.']
  regulatory_reference varchar [note: 'Applicable regulatory requirement, standard, or governing body that mandates or informs this checklist item (e.g., model risk management guidance, FATF AML, MiFID II, SFDR Article 8).']
  remediation_notes varchar [note: 'Description of the required remediation action, condition precedent, or post-close monitoring obligation associated with this checklist item finding.']
  remediation_required boolean [note: 'Indicates whether a remediation action or condition precedent is required to address the finding before or after investment close.']
  response_received_date date [note: 'Date on which a response or supporting document was received from the counterparty or data room for this checklist item.']
  response_text varchar [note: 'Free-text or structured response provided by the counterparty or analyst for this checklist item. Captured when response_type is text or yes_no.']
  response_type varchar [note: 'Format of the expected response for this item: document upload, free text, numeric value, date, yes/no confirmation, or multi-select. Drives UI rendering in eFront.']
  reviewed_date date [note: 'Date on which the reviewer assessed and approved or rejected the response for this checklist item. Supports DD quality control audit trail.']
  risk_rating varchar [note: 'Risk rating assigned to this checklist item based on the analyst\'s assessment of the finding. Aggregated to produce overall DD risk profile for IC submission.']
  source_template_code varchar [note: 'Code identifying the standardized DD checklist template from which this item was instantiated (e.g., PE-FDD-V3, INFRA-ODD-V2). Enables template version tracking.']
  sub_category varchar [note: 'Granular sub-grouping within the category (e.g., under Governance: Board Composition, Conflict of Interest Policy). Supports drill-down analytics and structured IC reporting.']
  template_version varchar [note: 'Version of the DD checklist template from which this item was derived. Supports methodology governance and year-over-year comparability of DD quality.']
  third_party_advisor varchar [note: 'Name of the external advisor (legal counsel, accounting firm, technical consultant) engaged to address or validate this checklist item.']
  waiver_approved boolean [note: 'Indicates whether a formal waiver has been approved for this checklist item, allowing the DD process to proceed despite an incomplete or unsatisfactory response.']
  waiver_approved_by varchar [note: 'Name or identifier of the senior officer or committee that approved the waiver for this checklist item. Supports governance accountability.']
  waiver_rationale varchar [note: 'Documented business justification for approving a waiver on this checklist item. Required for audit trail and regulatory compliance purposes.']

  Note: 'Individual line-item within a DD checklist representing a specific information request, verification task, or diligence question. Tracks item category, question text, response status (open, received, satisfactory, escalated), assigned analyst, due date'
}

Table diligence.dd_finding {
  dd_finding_id varchar [pk, note: 'Unique surrogate identifier for a formal due diligence finding record within the diligence domain.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement or workstream under which this finding was raised. Links to the overarching DD process record.']
  deal_opportunity_id varchar [note: 'Reference to the investment deal or pipeline opportunity that this DD finding is associated with, sourced from the deal origination system.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) being assessed, applicable when DD is conducted on a manager mandate rather than a direct deal.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) being assessed, applicable when DD is conducted on a manager mandate rather than a direct deal.']
  opportunity_id varchar [note: 'Reference to the investment deal or pipeline opportunity that this DD finding is associated with, sourced from the deal origination system.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Findings are about the asset; linking directly to the asset supports reporting and audit trails.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: DD findings identifying regulatory concerns must link to specific compliance rules for IC reporting and remediation tracking.']
  advisor_report_reference varchar [note: 'Document reference or identifier for the third-party advisor report in which this finding was originally documented, enabling traceability to source evidence.']
  asset_class varchar [note: 'Asset class of the investment under diligence to which this finding applies, enabling cross-asset-class DD analytics and benchmarking.']
  created_timestamp timestamp [note: 'System timestamp recording when this DD finding record was first created in the data platform, used for audit trail and data lineage purposes.']
  deal_currency varchar [note: 'ISO 4217 three-letter currency code for the deal in which this finding arises, used to denominate price adjustment and indemnity amounts.']
  deal_impact_type varchar [note: 'Classification of how this finding impacts the deal structure: deal-breaker, price adjustment, condition precedent in SPA, warranty/indemnity clause, or ongoing monitoring.']
  esg_sub_theme varchar [note: 'Granular ESG sub-category for the finding (e.g., GHG emissions, water usage, labour practices, board independence, anti-corruption). Applicable when esg_theme is set.']
  esg_theme varchar [note: 'ESG pillar classification for findings raised within the ESG DD workstream: environmental, social, governance, or none for non-ESG findings.']
  finding_category varchar [note: 'Granular business category of the finding within its workstream (e.g., revenue recognition, AML controls, governance structure, GHG emissions). [ENUM-REF-CANDIDATE: promote to reference product]']
  finding_description varchar [note: 'Detailed narrative description of the finding, including the specific issue observed, context, and relevant facts gathered during the DD workstream.']
  finding_reference varchar [note: 'Externally-visible alphanumeric reference code uniquely identifying this finding across DD workstreams and investment committee (IC) documentation.']
  finding_status varchar [note: 'Current lifecycle status of the finding from identification through resolution: open, under review, remediated, accepted (risk accepted), escalated to IC, or closed.']
  finding_title varchar [note: 'Concise human-readable title summarizing the nature of the finding, used in IC memos, investment memoranda (IM), and DD summary reports.']
  follow_up_due_date date [note: 'Target date by which the follow-up information or clarification for this finding must be received, applicable when follow_up_required is true.']
  follow_up_required boolean [note: 'Indicates whether this finding requires a follow-up action or additional information request from the target company, GP, or third-party advisor.']
  geography varchar [note: 'ISO 3166-1 alpha-3 country code of the primary jurisdiction of the investment or fund manager under diligence, used for geographic risk analysis.']
  ic_disposition varchar [note: 'Investment Committee (IC) decision on how to handle this finding: proceed, proceed with conditions, escalate for further review, reject the deal, or defer decision.']
  identified_by varchar [note: 'Name or employee identifier of the internal analyst or team member who formally identified and raised this DD finding during the diligence process.']
  identified_date date [note: 'Calendar date on which the DD finding was formally identified and documented by the diligence team during the due diligence process.']
  impact_confidence_level varchar [note: 'Analyst confidence level in the estimated financial impact amount: high (well-supported), medium (estimated), low (speculative), or unquantifiable.']
  impact_currency varchar [note: 'ISO 4217 three-letter currency code for the potential financial impact amount (e.g., USD, GBP, EUR).']
  indemnity_amount decimal(20,4) [note: 'Monetary value of any indemnity or escrow arrangement negotiated with the vendor as a result of this finding, expressed in the deal currency.']
  investment_stage varchar [note: 'Stage of the investment lifecycle at which this finding was identified: screening, initial DD, full DD, final DD, post-IC approval, or post-acquisition monitoring.']
  is_deal_condition boolean [note: 'Indicates whether this finding has been elevated to a formal condition precedent in the Share Purchase Agreement (SPA) or Limited Partnership Agreement (LPA).']
  is_ic_reportable boolean [note: 'Indicates whether this finding must be formally reported to the Investment Committee (IC) as part of the IC submission package and investment memorandum (IM).']
  likelihood_rating varchar [note: 'Analyst assessment of the probability that the risk identified in this finding will materialize, used in conjunction with severity to derive the composite risk rating.']
  potential_financial_impact_amount decimal(20,4) [note: 'Estimated monetary value of the potential financial impact of this finding on the investment, expressed in the base currency. Used in IC risk quantification.']
  price_adjustment_amount decimal(20,4) [note: 'Monetary value of any purchase price adjustment negotiated as a result of this finding, expressed in the deal currency. Relevant for FDD and legal DD findings.']
  recommendation varchar [note: 'Formal recommendation from the DD team on how to address the finding, including suggested remediation actions, deal structuring adjustments, or risk mitigants.']
  regulatory_breach_flag boolean [note: 'Indicates whether this finding involves a potential or confirmed breach of applicable regulatory requirements (e.g., AML, KYC, EMIR, MiFID II guidelines).']
  regulatory_reference varchar [note: 'Specific regulation, guideline, or standard that is implicated by this finding (e.g., underwriting practices guidance, FATF Recommendation 10, SFDR Article 8).']
  remediation_completed_date date [note: 'Actual date on which the remediation action for this finding was completed and verified by the DD team or post-acquisition monitoring team.']
  remediation_due_date date [note: 'Target date by which the remediation action for this finding must be completed, as agreed between the DD team and the responsible party.']
  remediation_notes varchar [note: 'Free-text notes documenting the remediation steps taken, evidence reviewed, and outcome of the remediation process for this finding.']
  remediation_owner varchar [note: 'Name or identifier of the individual or team responsible for driving remediation of this finding, either internally or at the target company / GP.']
  reviewed_by varchar [note: 'Name or identifier of the senior analyst, portfolio manager, or DD lead who reviewed and validated this finding prior to IC submission.']
  risk_rating varchar [note: 'Composite risk rating assigned to this finding reflecting both likelihood and potential impact on the investment, used in portfolio risk aggregation and VaR analysis.']
  root_cause varchar [note: 'Analyst-documented root cause analysis explaining the underlying reason or systemic driver behind the identified finding.']
  severity_rating varchar [note: 'Standardized severity classification of the finding: critical (deal-breaker risk), major (significant issue requiring remediation), minor (manageable issue), or informational (noted for monitoring).']
  source_system_finding_code varchar [note: 'Native identifier of this finding in the originating operational system (e.g., eFront finding ID, Dealpath issue ID), enabling bi-directional traceability.']
  third_party_advisor varchar [note: 'Name of the external advisor (legal counsel, accounting firm, technical consultant, ESG specialist) who identified or validated this finding.']
  updated_timestamp timestamp [note: 'System timestamp recording the most recent modification to this DD finding record, supporting audit trail and change tracking requirements.']
  vintage_year varchar [note: 'Year in which the fund or investment commitment was made, used to contextualize DD findings within the fund vintage for benchmarking and J-curve analysis.']
  workstream_type varchar [note: 'Classifies the DD workstream that identified this finding: Financial DD (FDD), Operational DD (ODD), Legal DD, Commercial DD (CDD), or ESG DD.']

  Note: 'Formal finding or issue identified during any DD workstream. Captures finding type (financial, operational, legal, ESG, commercial), severity rating (critical, major, minor, informational), description, root cause, potential financial impact, recommended'
}

Table diligence.dd_risk_assessment {
  dd_risk_assessment_id varchar [pk, note: 'Unique surrogate identifier for the consolidated risk assessment record produced at the conclusion of a due diligence engagement or workstream. Entity role: TRANSACTION_HEADER.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement or workstream that produced this risk assessment, linking to the overarching diligence project record in eFront or DealCloud.']
  deal_opportunity_id varchar [note: 'Reference to the investment deal or opportunity in the deal origination pipeline for which this risk assessment was conducted.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: DD risk assessments stress-test findings against macroeconomic scenarios (base/adverse/severe).']
  gp_profile_id varchar [note: 'Reference to the external fund manager or GP subject to this risk assessment, applicable when the DD is conducted on a manager mandate rather than a direct investment.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or GP subject to this risk assessment, applicable when the DD is conducted on a manager mandate rather than a direct investment.']
  opportunity_id varchar [note: 'Reference to the investment deal or opportunity in the deal origination pipeline for which this risk assessment was conducted.']
  prior_assessment_dd_risk_assessment_id varchar [note: 'Reference to the previous version of this risk assessment, enabling version chain navigation for audit, re-underwriting, and IC re-submission scenarios.']
  stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: DD risk assessments evaluate target entity resilience under stress conditions. Pension funds stress-test acquisition targets against macro scenarios (recession, inflation) to validate']
  advisor_report_reference varchar [note: 'Document reference or identifier for the third-party advisor\'s formal DD report, used to link to the document management system for retrieval and audit.']
  assessment_date date [note: 'The principal business event date on which the consolidated risk assessment was formally produced and signed off by the lead DD analyst or team.']
  assessment_reference varchar [note: 'Externally-known alphanumeric reference code assigned to this risk assessment, used for cross-referencing with eFront, DealCloud, and IC governance documentation.']
  assessment_status varchar [note: 'Current workflow state of the risk assessment record, tracking progression from initial drafting through IC approval or withdrawal.']
  assessment_version varchar [note: 'Version number of this risk assessment record, incremented when material updates are made post-initial completion, supporting audit trail and IC re-submission tracking.']
  asset_class varchar [note: 'Asset class of the investment subject to this risk assessment, used for portfolio construction analytics and SAA/TAA reporting. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit — promote to reference']
  commitment_amount decimal(20,2) [note: 'Proposed capital commitment amount in base currency being evaluated as part of this DD risk assessment, used for portfolio sizing and capital call planning.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code for the proposed capital commitment amount, used for FX hedging analysis and treasury planning.']
  conditions_precedent varchar [note: 'Narrative description of conditions that must be satisfied prior to capital commitment, as stipulated by the IC when approving with conditions.']
  created_timestamp timestamp [note: 'Timestamp when this risk assessment record was first captured in the system, used for audit trail and data lineage purposes.']
  dd_type varchar [note: 'Classification of the DD workstream that produced this assessment: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Integrated (full-scope).']
  esg_risk_rating varchar [note: 'Categorical ESG risk rating summarizing climate transition risk, social impact, governance quality, and alignment with the fund\'s responsible investment policy.']
  esg_risk_score decimal(5,2) [note: 'Quantitative ESG risk score derived from MSCI ESG ratings, TCFD alignment assessment, GHG emissions data, and PRI responsible investment criteria.']
  financial_risk_rating varchar [note: 'Categorical risk rating for the financial dimension of the DD assessment, summarizing findings on earnings quality, balance sheet strength, and valuation risk.']
  financial_risk_score decimal(5,2) [note: 'Quantitative risk score for the financial risk dimension, assessing quality of earnings, leverage, liquidity, EBITDA sustainability, and DCF/WACC sensitivity.']
  ic_decision varchar [note: 'Formal decision rendered by the Investment Committee (IC) following review of the risk assessment and DD findings.']
  ic_decision_date date [note: 'Date on which the Investment Committee rendered its formal decision on the investment based on this risk assessment.']
  ic_recommendation varchar [note: 'DD team\'s formal recommendation to the Investment Committee (IC) based on the consolidated risk assessment findings.']
  investment_strategy varchar [note: 'Specific investment strategy or sub-strategy of the target (e.g., buyout, growth equity, core infrastructure, value-add real estate, direct lending), providing context for risk calibration.']
  key_mitigants varchar [note: 'Narrative description of the principal risk mitigants, structural protections, and value creation levers identified to offset the key risk factors in this assessment.']
  key_risk_factors varchar [note: 'Narrative summary of the principal risk factors identified across all DD workstreams, used in the Investment Memorandum (IM) and IC presentation. Confidential deal-sensitive content.']
  kyc_aml_status varchar [note: 'Status of KYC and AML screening conducted on the target entity and its beneficial owners as part of the DD process, per FATF requirements.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this risk assessment record, supporting version control and audit trail requirements.']
  lead_analyst varchar [note: 'Name or employee identifier of the lead internal analyst responsible for coordinating and producing this risk assessment.']
  legal_risk_rating varchar [note: 'Categorical risk rating for the legal dimension, summarizing findings on contractual terms, regulatory exposure, and litigation risk identified during legal DD.']
  legal_risk_score decimal(5,2) [note: 'Quantitative risk score for the legal risk dimension, covering LPA terms, regulatory compliance, litigation exposure, IP ownership, and contractual obligations.']
  management_quality_rating varchar [note: 'Categorical rating for management team quality, covering investment track record, key-person risk, succession planning, and GP/LP alignment of interests.']
  management_quality_score decimal(5,2) [note: 'Quantitative score assessing the quality, depth, track record, and alignment of the target\'s management team or GP investment professionals.']
  market_risk_rating varchar [note: 'Categorical rating for market risk, reflecting the investment\'s sensitivity to macroeconomic cycles, sector dynamics, and capital market conditions.']
  market_risk_score decimal(5,2) [note: 'Quantitative score for market risk exposure including macro sensitivity, sector concentration, FX risk, interest rate risk, and cyclicality of the target\'s business.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity prior to commencement of the DD process.']
  operational_risk_rating varchar [note: 'Categorical risk rating for the operational dimension, summarizing findings on fund administration, compliance infrastructure, and operational controls.']
  operational_risk_score decimal(5,2) [note: 'Quantitative risk score for the operational risk dimension, covering fund operations, middle/back-office controls, technology infrastructure, and service provider quality.']
  overall_risk_rating varchar [note: 'Consolidated risk rating assigned to the investment or manager at the conclusion of the DD engagement, synthesizing all risk dimension scores for IC decision-making.']
  overall_risk_score decimal(5,2) [note: 'Quantitative composite risk score (typically on a 0–100 scale) derived from weighted individual risk dimension scores, used for portfolio-level risk aggregation and benchmarking.']
  sanctions_screening_status varchar [note: 'Result of sanctions list screening (OFAC, UN, EU) conducted on the target entity and key principals as part of the DD compliance process.']
  target_domicile varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction where the investment target or fund is domiciled, used for regulatory, tax, and FX risk analysis.']
  target_entity_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the investment target or fund manager, used for regulatory reporting under EMIR, MiFID II counterparty identification.']
  target_entity_name varchar [note: 'Legal name of the investment target, fund, or manager subject to this risk assessment. Classified confidential as it may relate to non-public deal information.']
  target_irr_pct decimal(6,4) [note: 'Expected gross IRR for the investment as modeled during DD, used to assess whether the risk-adjusted return meets the fund\'s hurdle rate and SAA return targets.']
  target_moic decimal(6,2) [note: 'Expected gross Multiple on Invested Capital (MOIC) for the investment as modeled during DD, complementing IRR for private markets return assessment.']
  third_party_advisor varchar [note: 'Name of the external advisor firm (legal counsel, accounting firm, technical advisor, ESG consultant) engaged to support this DD workstream.']
  vintage_year varchar [note: 'Year of the fund\'s first capital call or the deal\'s commitment year, used for performance benchmarking, J-curve analysis, and peer comparison in private markets.']

  Note: 'Consolidated risk assessment record produced at the conclusion of a DD engagement or workstream. Captures overall risk rating, individual risk dimension scores (financial, operational, legal, ESG, market, management quality), key risk factors, mitigants'
}

Table diligence.advisor_engagement {
  advisor_engagement_id varchar [pk, note: 'Unique surrogate identifier for the advisor engagement record within the due diligence domain. Primary key for this master agreement entity.']
  dd_workstream_id varchar [note: 'Reference to the specific DD workstream (ODD, FDD, CDD, Legal DD, ESG DD) within the diligence domain that this advisor engagement supports.']
  internal_deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal origination pipeline (DealCloud/Dealpath) for which this advisor engagement was initiated.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal origination pipeline (DealCloud/Dealpath) for which this advisor engagement was initiated.']
  advisor_firm_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the advisor firm, used for regulatory counterparty identification and KYC/AML compliance verification.']
  advisor_firm_name varchar [note: 'Legal name of the third-party advisory or specialist firm engaged to support the DD workstream (e.g., law firm, Big-4 accounting firm, technical consultant, environmental consultant).']
  agreed_fee_amount decimal(18,2) [note: 'Total contracted fee amount agreed with the advisor firm for the full scope of the engagement, expressed in the fee currency. For hourly/retainer structures, represents the estimated or capped total.']
  approved_by varchar [note: 'Name or identifier of the internal authority (IC member, CIO, or delegated approver) who authorized the advisor engagement per the internal governance and procurement policy.']
  asset_class varchar [note: 'Asset class of the investment or fund manager under DD for which this advisor engagement was initiated, used for cost allocation and portfolio analytics.']
  conflict_of_interest_checked boolean [note: 'Indicates whether a formal conflict of interest check has been completed for the advisor firm relative to the target investment or fund manager prior to engagement.']
  conflict_of_interest_notes varchar [note: 'Free-text notes documenting the outcome of the conflict of interest review, including any identified conflicts, mitigants applied, or waivers granted by the IC or compliance team.']
  cost_center_code varchar [note: 'Oracle Financials General Ledger (GL) cost center code to which advisor engagement fees are allocated for internal management accounting and budget tracking purposes.']
  created_timestamp timestamp [note: 'Timestamp when the advisor engagement record was first created in the system, providing the audit trail creation marker per data governance and regulatory record-keeping requirements.']
  dd_report_due_date date [note: 'Contractually agreed date by which the advisor must deliver the final DD report or key deliverable to the internal deal team, used for timeline management and IC scheduling.']
  dd_report_received_date date [note: 'Actual date on which the final DD report or principal deliverable was received from the advisor firm. Compared against dd_report_due_date to assess advisor performance.']
  deal_geography varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary geographic jurisdiction of the investment or fund manager under due diligence, used for regulatory and reporting purposes.']
  effront_engagement_ref varchar [note: 'System reference identifier for this advisor engagement record within the eFront Private Markets platform, enabling data lineage and reconciliation with the source system of record.']
  engagement_channel varchar [note: 'Method by which the advisor was selected and engaged: directly appointed, sourced via intermediary, selected through panel rotation, or awarded via competitive tender/RFP process.']
  engagement_end_date date [note: 'Contractual end date of the advisor engagement. Nullable for open-ended engagements. Represents the effective-until date of the agreement.']
  engagement_letter_date date [note: 'Date on which the formal engagement letter or statement of work was signed by both parties, establishing the binding contractual relationship.']
  engagement_reference varchar [note: 'Externally-known alphanumeric reference code assigned to the advisor engagement, used in correspondence, invoices, and eFront/DealCloud records. Format: ENG-YYYY-NNNNNN.']
  engagement_start_date date [note: 'Date on which the advisor engagement formally commences, as stipulated in the signed engagement letter or contract. Marks the effective-from date of the agreement.']
  engagement_status varchar [note: 'Current lifecycle state of the advisor engagement, tracking progression from initial scoping through completion or early termination.']
  engagement_type varchar [note: 'Classification of the DD workstream the advisor is engaged to support. [ENUM-REF-CANDIDATE: legal|financial_dd|commercial_dd|technical|environmental_esg|actuarial|tax|cyber_security|other — promote to reference product]']
  fee_cap_amount decimal(18,2) [note: 'Maximum fee amount payable to the advisor under the engagement, regardless of hours incurred. Applicable for capped_fee and blended fee structures. Null if no cap applies.']
  fee_currency varchar [note: 'ISO 4217 three-letter currency code in which advisor fees are denominated and invoiced (e.g., USD, GBP, EUR).']
  fee_structure_type varchar [note: 'Classification of the commercial fee arrangement agreed with the advisor firm (e.g., fixed fee, hourly rate, capped fee, success fee, retainer, or blended structure).']
  gl_account_code varchar [note: 'Oracle Financials General Ledger (GL) account code used to record advisor fee expenses, enabling accurate financial reporting and cost attribution by deal or asset class.']
  hourly_rate decimal(10,2) [note: 'Agreed hourly billing rate for the advisor engagement, applicable where the fee structure type is hourly_rate or blended. Expressed in the fee currency.']
  ic_approval_date date [note: 'Date on which the Investment Committee (IC) or delegated authority approved the advisor engagement. Null if IC approval is not required or not yet obtained.']
  ic_approval_required boolean [note: 'Indicates whether Investment Committee (IC) approval is required to authorize this advisor engagement, based on fee thresholds or deal materiality per internal governance policy.']
  insurance_expiry_date date [note: 'Expiry date of the advisor firm\'s professional indemnity insurance policy. Used to trigger renewal verification before the policy lapses during an active engagement.']
  insurance_verified boolean [note: 'Indicates whether the advisor firm\'s professional indemnity and liability insurance coverage has been verified and meets the minimum requirements stipulated in the engagement letter.']
  internal_deal_lead varchar [note: 'Name of the internal investment professional (deal lead or portfolio manager) responsible for managing the advisor engagement and overseeing DD deliverables.']
  invoiced_amount decimal(18,2) [note: 'Cumulative amount invoiced by the advisor firm against this engagement to date, expressed in the fee currency. Used for budget tracking and accrual management.']
  kyc_aml_status varchar [note: 'Current status of the KYC/AML onboarding and verification process for the advisor firm, required before engagement commencement per regulatory and internal compliance policy.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the advisor engagement record, supporting audit trail, data lineage, and change management requirements.']
  lead_advisor_email varchar [note: 'Primary email address of the lead advisor at the engaged firm, used for formal engagement correspondence and document exchange.']
  lead_advisor_name varchar [note: 'Full name of the primary individual (partner, director, or senior specialist) at the advisor firm who leads the engagement and is the principal point of contact.']
  mandate_scope varchar [note: 'Narrative description of the specific scope of work, deliverables, and boundaries of the advisor\'s mandate as defined in the engagement letter or statement of work.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been fully executed with the advisor firm prior to sharing confidential deal or portfolio information.']
  nda_execution_date date [note: 'Date on which the NDA was fully executed between the pension fund and the advisor firm. Null if NDA has not yet been executed.']
  paid_amount decimal(18,2) [note: 'Cumulative amount actually paid to the advisor firm against this engagement to date, expressed in the fee currency. Sourced from Oracle Financials AP payment records.']
  preferred_panel_advisor boolean [note: 'Indicates whether the advisor firm is on the pension fund\'s pre-approved preferred advisor panel for this engagement type, streamlining procurement and governance approval.']
  report_quality_rating varchar [note: 'Internal qualitative rating assigned by the deal team to the advisor\'s final deliverable, used for advisor performance tracking and future panel selection decisions.']
  rfp_conducted boolean [note: 'Indicates whether a formal Request for Proposal (RFP) process was conducted to select this advisor, as required for engagements above the procurement threshold.']
  termination_date date [note: 'Date on which the advisor engagement was formally terminated or cancelled prior to the contractual end date. Null for engagements that run to their natural conclusion.']
  termination_reason varchar [note: 'Reason code for early termination or cancellation of the advisor engagement. Null for engagements that complete normally. Used for advisor performance analytics.']

  Note: 'Master record for a third-party advisor or specialist firm engaged to support a DD workstream — e.g., legal counsel, accounting firm (FDD), technical consultant (infrastructure/real estate), environmental consultant (ESG/natural resources), or commercial'
}

Table diligence.advisor_report {
  advisor_report_id varchar [pk, note: 'Unique surrogate identifier for the third-party advisor report record within the due diligence engagement.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement for which this advisor report was commissioned and submitted.']
  superseded_by_report_advisor_report_id varchar [note: 'Reference to the newer advisor report record that supersedes this version, enabling version chain tracking across draft and final report iterations.']
  advisor_firm_name varchar [note: 'Legal name of the third-party advisory firm that authored and submitted the report, e.g., a Big Four accounting firm, law firm, or specialist ESG consultant.']
  advisor_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the third-party advisor firm, enabling unambiguous global identification for regulatory and counterparty management purposes.']
  asset_class varchar [note: 'Asset class of the investment subject to due diligence, aligning the report to the fund\'s SAA domains: Private Equity, Real Estate, Infrastructure, Natural Resources, Credit, or Public Equities.']
  conditions_and_recommendations varchar [note: 'Narrative description of conditions precedent, remediation actions, or recommendations made by the advisor that must be addressed prior to or post-investment close.']
  confidentiality_classification varchar [note: 'Confidentiality level assigned to the advisor report as stipulated by the advisor or engagement letter: Strictly Confidential, Confidential, Internal, or Restricted.']
  created_timestamp timestamp [note: 'Timestamp when this advisor report record was first created in the system, providing the audit trail creation marker per data governance policy.']
  data_room_location varchar [note: 'URL or path reference to the virtual data room folder where the advisor report document is stored, enabling direct access for authorized DD team members.']
  dd_scope varchar [note: 'Scope of the due diligence engagement for which this report was produced: Direct Investment, Co-Investment, Fund Investment, Manager Selection, or Secondary transaction.']
  document_format varchar [note: 'File format of the advisor report document as stored in the data room: PDF, Word, Excel, or PowerPoint.']
  engagement_letter_reference varchar [note: 'Reference number or identifier of the engagement letter or mandate agreement under which the advisor was retained to produce this report.']
  esg_issues_identified boolean [note: 'Indicates whether the advisor identified material Environmental, Social, or Governance (ESG) issues within the scope of this report, triggering ESG escalation review.']
  esg_rating varchar [note: 'ESG risk rating assigned within the advisor report, reflecting the materiality of environmental, social, and governance risks identified for the target entity.']
  fee_amount decimal(18,2) [note: 'Total fee charged by the third-party advisor for producing this report, as invoiced under the engagement letter. Used for DD cost tracking and budget management.']
  fee_currency varchar [note: 'ISO 4217 three-letter currency code for the advisor fee amount, e.g., USD, GBP, EUR.']
  follow_up_due_date date [note: 'Target date by which outstanding follow-up items identified in the advisor report must be resolved, supporting DD timeline management and IC readiness.']
  follow_up_required boolean [note: 'Indicates whether the advisor report has identified open items or questions requiring follow-up clarification from the advisor or the target entity before DD can be concluded.']
  ic_submission_date date [note: 'Date on which this advisor report was included in and submitted to the Investment Committee (IC) as part of the formal IC approval package.']
  ic_submission_included boolean [note: 'Indicates whether this advisor report has been included as a supporting document in the Investment Committee (IC) submission pack for the related DD engagement.']
  internal_review_date date [note: 'Date on which the internal investment team member completed their review and sign-off of the advisor report findings.']
  internal_review_notes varchar [note: 'Free-text notes from the internal reviewer capturing their assessment, challenges, or additional context on the advisor\'s findings for IC and investment team use.']
  internal_reviewer_name varchar [note: 'Name of the internal investment team member (analyst, associate, or VP) responsible for reviewing, challenging, and summarizing the advisor report findings.']
  invoice_reference varchar [note: 'Reference number of the advisor\'s invoice for this report engagement, linking to the Oracle Financials AP module for payment processing and cost allocation.']
  key_findings_summary varchar [note: 'Concise narrative summary of the advisor\'s principal findings, red flags, and material observations from the report, as extracted for IC and investment team review.']
  lead_advisor_name varchar [note: 'Full name of the lead partner or senior engagement manager at the advisor firm responsible for the report deliverable.']
  material_issues_count varchar [note: 'Total number of material issues or red flags identified by the advisor in the report, providing a quantitative signal of report severity for IC prioritization.']
  nda_reference varchar [note: 'Reference number of the Non-Disclosure Agreement (NDA) executed with the advisor firm governing the confidentiality of information exchanged during the DD engagement.']
  overall_conclusion varchar [note: 'High-level conclusion of the advisor\'s report: Satisfactory, Satisfactory with Conditions, Unsatisfactory, or Inconclusive. Feeds into the IC\'s overall DD rating for the engagement.']
  page_count varchar [note: 'Total number of pages in the advisor report document, used for document management, completeness verification, and IC pack preparation.']
  regulatory_issues_identified boolean [note: 'Indicates whether the advisor identified material regulatory, legal, or compliance issues within the report scope, requiring escalation to legal counsel or compliance.']
  reliance_letter_reference varchar [note: 'Reference number of the formal reliance letter issued by the advisor permitting the pension fund to rely on the report findings for investment decision purposes.']
  reliance_permitted boolean [note: 'Indicates whether the advisor has granted the pension fund permission to rely on the report for investment decision-making purposes, as stipulated in the engagement letter.']
  report_date date [note: 'The official date printed on the face of the advisor report, representing the date as of which the advisor\'s findings and conclusions are stated.']
  report_period_end date [note: 'End date of the historical period covered by the advisor\'s analysis, typically the most recent audited financial year-end or ESG reporting period.']
  report_period_start date [note: 'Start date of the historical period covered by the advisor\'s analysis, e.g., the earliest financial year reviewed in an FDD or the earliest ESG data period assessed.']
  report_reference varchar [note: 'Externally assigned unique reference number or code for the advisor report, as issued by the third-party advisor firm. Used for cross-referencing with the advisor\'s own document management system.']
  report_status varchar [note: 'Current lifecycle status of the advisor report: Draft (in preparation), Preliminary (initial submission), Final (approved deliverable), Superseded (replaced by newer version), or Withdrawn.']
  report_subtype varchar [note: 'Further classification within the report type, e.g., \'Quality of Earnings\' under FDD, \'IT Infrastructure\' under ODD, \'TCFD Climate Assessment\' under ESG. Free-text to accommodate evolving DD practice.']
  report_title varchar [note: 'Full descriptive title of the advisor report as submitted by the third-party advisor, e.g., \'Financial Due Diligence Report – Target Co Ltd – Q3 2024\'.']
  report_type varchar [note: 'Classification of the due diligence report by discipline: Financial Due Diligence (FDD), Operational Due Diligence (ODD), Commercial Due Diligence (CDD), Legal, ESG, Technical, or Environmental.']
  report_version varchar [note: 'Version identifier of the report (e.g., v1.0, v2.1, v3.0-final), tracking draft iterations through to the final deliverable submitted for IC review.']
  risk_rating varchar [note: 'Aggregate risk rating assigned by the advisor based on findings within the report scope: Low, Medium, High, or Critical. Used in IC risk aggregation and portfolio risk management.']
  submission_date date [note: 'Date on which the advisor formally submitted this version of the report to the pension fund\'s due diligence team.']
  target_entity_name varchar [note: 'Legal name of the investment target, fund, or external manager that is the subject of the due diligence report, as referenced in the advisor\'s deliverable.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this advisor report record, supporting audit trail and data lineage requirements in the Databricks Silver layer.']

  Note: 'Formal report or deliverable submitted by a third-party advisor as part of a DD engagement. Captures report type (legal opinion, FDD report, ODD report, environmental assessment, technical report, CDD report), submission date, report version, key'
}

Table diligence.odd_assessment {
  odd_assessment_id varchar [pk, note: 'Unique surrogate identifier for the ODD assessment record. Primary key for the odd_assessment product in the diligence domain.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement under which this ODD assessment was conducted. Links to the dd_engagement product in the diligence domain.']
  employee_id varchar [note: 'Internal analyst responsible for leading and coordinating the ODD assessment. Accountable for the completeness and accuracy of the ODD findings.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or GP being assessed in this ODD review. Links to the gp_profile product in the manager domain.']
  lead_odd_analyst_employee_id varchar [note: 'Internal analyst responsible for leading and coordinating the ODD assessment. Accountable for the completeness and accuracy of the ODD findings.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or GP being assessed in this ODD review. Links to the gp_profile product in the manager domain.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: ODD assessments evaluate operational risks at mandate level (fee structures, reporting SLAs, custody arrangements).']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: ODD assessments evaluate GP/manager compliance with specific regulatory frameworks.']
  actual_completion_date date [note: 'Date on which the ODD assessment was formally completed and the final report signed off. Compared against target_completion_date for SLA tracking.']
  assessment_date date [note: 'The principal date on which the ODD assessment was formally conducted or the on-site visit occurred. Represents the real-world business event date for this assessment.']
  assessment_reference varchar [note: 'Externally-known unique alphanumeric reference code assigned to this ODD assessment (e.g., ODD-2024-00123). Used for cross-system tracking and IC reporting.']
  assessment_status varchar [note: 'Current lifecycle status of the ODD assessment workflow, from initial drafting through analyst review to final completion or cancellation.']
  assessment_type varchar [note: 'Classification of the ODD assessment by trigger: initial (first-time manager), re-up (re-commitment), periodic (scheduled review), event-driven (triggered by material change), or ad-hoc.']
  auditor_name varchar [note: 'Name of the independent external auditor engaged to audit the manager\'s funds and management company financial statements. Independence and quality assessed during ODD.']
  aum_at_assessment decimal(20,2) [note: 'Total AUM managed by the external fund manager at the time of the ODD assessment, expressed in the reporting currency. Used to contextualise operational scale and resource adequacy.']
  aum_currency varchar [note: 'ISO 4217 three-letter currency code in which the manager\'s AUM at assessment is denominated (e.g., USD, EUR).']
  bcp_tested_flag boolean [note: 'Indicates whether the manager has conducted a documented and tested Business Continuity Plan (BCP) and Disaster Recovery (DR) exercise within the past 12 months.']
  compliance_aml_rating varchar [note: 'ODD sub-dimension rating for the manager\'s compliance programme, AML/KYC controls, regulatory licensing status, and adherence to applicable regulations (MiFID II, EMIR, FATF).']
  created_timestamp timestamp [note: 'Timestamp when this ODD assessment record was first created in the system. Audit trail field supporting data lineage and regulatory record-keeping requirements.']
  custodian_name varchar [note: 'Name of the primary custodian holding assets on behalf of the manager\'s funds. Assessed for independence, creditworthiness, and segregation of assets.']
  cybersecurity_rating varchar [note: 'ODD sub-dimension rating for the manager\'s cybersecurity posture, data protection controls, incident response procedures, and alignment with ISO 27001 and SOC 2 standards.']
  ddq_received_date date [note: 'Date on which the completed ILPA or proprietary Due Diligence Questionnaire (DDQ) was received from the manager. Marks the start of substantive ODD analysis.']
  fund_admin_rating varchar [note: 'ODD sub-dimension rating for the manager\'s fund administration arrangements, use of independent third-party administrators, NAV calculation controls, and investor reporting quality.']
  fund_administrator_name varchar [note: 'Name of the third-party fund administrator responsible for NAV calculation, investor reporting, and fund accounting on behalf of the manager\'s funds.']
  governance_rating varchar [note: 'ODD sub-dimension rating for the manager\'s governance framework, ownership structure, key-person dependencies, succession planning, and organizational stability.']
  independent_admin_flag boolean [note: 'Indicates whether the manager uses a fully independent third-party fund administrator for NAV calculation and investor reporting, a key ODD best-practice indicator.']
  initiation_date date [note: 'Date on which the ODD assessment process was formally initiated and assigned to the lead analyst. Marks the start of the ODD workflow lifecycle.']
  key_person_risk_flag boolean [note: 'Indicates whether the ODD assessment identified material key-person dependency risk at the manager, where the departure of one or more individuals would significantly impair operations.']
  last_updated_timestamp timestamp [note: 'Timestamp when this ODD assessment record was most recently modified. Supports audit trail, data lineage tracking, and incremental data pipeline processing.']
  legal_counsel_name varchar [note: 'Name of the primary external legal counsel engaged by the manager for fund structuring, regulatory compliance, and ongoing legal matters. Assessed for quality and independence.']
  litigation_flag boolean [note: 'Indicates whether the ODD assessment identified material pending or historical litigation, arbitration, or legal proceedings involving the manager or its principals.']
  material_findings_summary varchar [note: 'Narrative summary of material operational findings, red flags, or concerns identified during the ODD assessment. Key input to IC memorandum and investment decision.']
  next_review_date date [note: 'Date on which the next periodic ODD review of this manager is scheduled. Supports ongoing monitoring obligations and periodic re-assessment cadence.']
  number_of_investment_professionals varchar [note: 'Total headcount of investment professionals (portfolio managers, analysts, associates) at the manager as reported during the ODD assessment. Indicator of operational capacity.']
  number_of_operations_staff varchar [note: 'Total headcount of operations, middle-office, and back-office staff at the manager as reported during ODD. Assesses operational infrastructure relative to AUM and strategy complexity.']
  odd_recommendation varchar [note: 'Formal ODD team recommendation on whether to proceed with the investment based on operational findings: proceed, proceed with conditions, defer pending remediation, or decline.']
  onsite_visit_conducted boolean [note: 'Indicates whether an in-person on-site visit to the manager\'s offices was conducted as part of this ODD assessment, as opposed to a purely desk-based or remote review.']
  onsite_visit_date date [note: 'Date on which the on-site visit to the manager\'s offices was conducted. Populated only when onsite_visit_conducted is true.']
  overall_odd_rating varchar [note: 'Composite qualitative rating summarising the manager\'s overall operational infrastructure quality across all ODD dimensions. Used as a key input to IC approval decisions.']
  prime_broker_names varchar [note: 'Names of the manager\'s primary prime brokerage counterparties as identified during ODD. Relevant for counterparty concentration risk assessment and settlement infrastructure review.']
  regulatory_action_flag boolean [note: 'Indicates whether the manager or its principals are subject to any current or historical regulatory sanctions, enforcement actions, or material regulatory findings identified during ODD.']
  remediation_deadline date [note: 'Target date by which the manager must complete all required operational remediation actions identified in the ODD assessment. Populated only when remediation_required_flag is true.']
  remediation_required_flag boolean [note: 'Indicates whether the ODD assessment identified operational deficiencies requiring formal remediation actions by the manager prior to or as a condition of investment.']
  risk_management_rating varchar [note: 'ODD sub-dimension rating for the manager\'s risk management framework, including VaR/CVaR monitoring, counterparty risk controls, liquidity risk management, and stress testing capabilities.']
  soc2_report_available boolean [note: 'Indicates whether the manager or its key service providers have a current SOC 2 Type II report available, evidencing controls over security, availability, and confidentiality.']
  target_completion_date date [note: 'Planned date by which the ODD assessment is expected to be completed and findings submitted for IC review. Used for workflow tracking and IC scheduling.']
  technology_systems_rating varchar [note: 'ODD sub-dimension rating for the manager\'s technology infrastructure, portfolio management systems, cybersecurity controls, disaster recovery, and business continuity capabilities.']
  third_party_odd_provider varchar [note: 'Name of any external specialist ODD firm engaged to assist with or independently conduct the operational due diligence review (e.g., Albourne Partners, PAAMCO, Aksia).']
  trade_execution_rating varchar [note: 'ODD sub-dimension rating for the manager\'s order management, best execution policies, prime brokerage arrangements, settlement processes, and DVP controls.']
  valuation_rating varchar [note: 'ODD sub-dimension rating for the manager\'s valuation policies, independence of valuation function, NAV/GAV calculation methodology, and use of third-party valuation agents.']
  years_in_operation varchar [note: 'Number of years the manager has been in operation as of the assessment date. Provides context for organisational maturity and track record depth.']

  Note: 'Operational Due Diligence (ODD) assessment record specific to external fund manager evaluations. Captures operational infrastructure quality ratings across key ODD dimensions: governance and organizational structure, technology and systems, valuation'
}

Table diligence.fdd_assessment {
  fdd_assessment_id varchar [pk, note: 'Unique surrogate identifier for the Financial Due Diligence (FDD) assessment record within the diligence domain.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement record that initiated this FDD assessment, linking to the overarching diligence workflow.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Financial DD normalizes EBITDA and projects cash flows under specific economic assumptions.']
  employee_id varchar [note: 'Reference to the internal analyst responsible for leading the FDD workstream, accountable for QoE findings and EBITDA normalization conclusions.']
  fee_benchmark_id varchar [note: 'Foreign key linking to fee.fee_benchmark. Business justification: Financial due diligence requires comparing proposed manager fee structures against market benchmarks.']
  lead_fdd_analyst_employee_id varchar [note: 'Reference to the internal analyst responsible for leading the FDD workstream, accountable for QoE findings and EBITDA normalization conclusions.']
  accounting_standard varchar [note: 'Accounting framework under which the target\'s financial statements were prepared, critical for normalization and comparability of FDD findings.']
  adjusted_net_debt decimal(20,2) [note: 'Net debt after FDD reconciliation adjustments including debt-like items, contingent liabilities, pension deficits, and off-balance-sheet obligations.']
  assessment_date date [note: 'The principal date on which the FDD assessment was formally conducted or the financial analysis period was anchored, per the engagement timeline.']
  assessment_reference varchar [note: 'Externally-known alphanumeric reference code uniquely identifying this FDD assessment, used in IC submissions, IM documents, and eFront records.']
  assessment_status varchar [note: 'Current lifecycle state of the FDD assessment, tracking progression from initial drafting through analyst review to IC-ready completion or withdrawal.']
  audit_firm varchar [note: 'Name of the external auditor that issued the audit opinion on the target\'s financial statements reviewed during FDD.']
  audit_opinion_type varchar [note: 'Type of audit opinion issued on the most recent audited financial statements, flagging any qualifications or adverse opinions as key FDD risk indicators.']
  capex_growth decimal(20,2) [note: 'Annual growth capital expenditure identified during FDD for capacity expansion or new initiatives, distinct from maintenance CapEx, in the FDD reporting currency.']
  capex_maintenance decimal(20,2) [note: 'Annual maintenance capital expenditure required to sustain current operating capacity, as identified during FDD, in the FDD reporting currency.']
  conditions_and_recommendations varchar [note: 'Conditions precedent or post-closing recommendations arising from FDD findings, including price adjustments, escrow arrangements, or warranty and indemnity requirements.']
  contingent_liabilities_amount decimal(20,2) [note: 'Estimated aggregate value of contingent liabilities identified during FDD, used in net debt reconciliation and risk-adjusted valuation, in the FDD reporting currency.']
  contingent_liabilities_identified boolean [note: 'Indicates whether material contingent liabilities (litigation, tax exposures, warranties, guarantees) were identified during FDD requiring IC disclosure.']
  created_timestamp timestamp [note: 'Timestamp when this FDD assessment record was first created in the system, used for audit trail and data lineage tracking.']
  data_room_reference varchar [note: 'Reference identifier or URL for the virtual data room folder containing FDD source documents, financial models, and supporting workpapers.']
  ebitda_margin_pct decimal(8,4) [note: 'Normalized EBITDA as a percentage of revenue for the most recent full fiscal year, a key profitability metric used in valuation and peer benchmarking.']
  ebitda_normalization_total decimal(20,2) [note: 'Net aggregate of all EBITDA normalization adjustments identified during FDD, being the difference between reported and normalized EBITDA.']
  esg_financial_materiality_flag boolean [note: 'Indicates whether ESG factors with financial materiality (e.g., carbon liabilities, stranded assets, regulatory fines) were identified and incorporated into FDD findings.']
  financial_controls_rating varchar [note: 'Assessment of the adequacy of the target\'s internal financial controls and reporting processes, informing post-acquisition integration planning.']
  financial_model_version varchar [note: 'Version identifier of the financial model (DCF, LBO, or returns model) used in conjunction with FDD findings for investment valuation and IC submission.']
  financial_statements_period_end date [note: 'End date of the historical financial period reviewed during FDD, anchoring the most recent audited or management accounts period analyzed.']
  financial_statements_period_start date [note: 'Start date of the historical financial period reviewed during FDD, typically covering 3–5 fiscal years of audited financial statements.']
  ic_submission_ready boolean [note: 'Indicates whether the FDD assessment has been reviewed, signed off, and is ready for inclusion in the Investment Committee (IC) submission package.']
  key_financial_risks_summary varchar [note: 'Narrative summary of the most material financial risks identified during FDD, including earnings quality concerns, leverage risks, and structural financial issues.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this FDD assessment record, supporting version control and audit compliance.']
  management_accounts_quality varchar [note: 'Quality rating of the target\'s management reporting and internal accounts, assessing timeliness, accuracy, and granularity for post-acquisition monitoring.']
  net_debt_adjustment_notes varchar [note: 'Narrative description of material adjustments made to reported net debt during FDD, including debt-like items, earn-outs, and pension obligations identified.']
  normalized_ebitda decimal(20,2) [note: 'EBITDA after all FDD normalization adjustments (one-time items, non-recurring charges, run-rate adjustments), representing sustainable earnings power.']
  normalized_working_capital decimal(20,2) [note: 'Normalized working capital peg established during FDD, representing the level of working capital required to operate the business at a normalized level.']
  overall_fdd_rating varchar [note: 'Aggregate FDD rating summarizing the overall financial health and risk profile of the target, used as a key input to the IC investment decision.']
  pension_deficit decimal(20,2) [note: 'Defined benefit pension scheme deficit identified during FDD, treated as a debt-like item in net debt reconciliation, in the FDD reporting currency.']
  qoe_findings_summary varchar [note: 'Narrative summary of key QoE findings including revenue recognition practices, earnings sustainability, and material accounting policy concerns identified in FDD.']
  qoe_rating varchar [note: 'FDD analyst\'s assessment of the quality and sustainability of the target\'s reported earnings, reflecting reliability of financial statements for investment decisions.']
  reported_ebitda decimal(20,2) [note: 'EBITDA as reported by management or derived from audited financials before any normalization adjustments, in the FDD reporting currency.']
  reported_net_debt decimal(20,2) [note: 'Net debt as reported by management (gross debt minus cash and cash equivalents) prior to FDD adjustments, in the FDD reporting currency.']
  reported_revenue decimal(20,2) [note: 'Total revenue as reported in the target\'s audited financial statements for the most recent full fiscal year reviewed, in the FDD reporting currency.']
  reporting_currency varchar [note: 'ISO 4217 three-letter currency code in which all FDD financial figures are denominated (e.g., USD, GBP, EUR).']
  revenue_cagr_pct decimal(8,4) [note: 'Compound annual growth rate of the target\'s revenue over the FDD review period, expressed as a percentage, used to assess historical growth trajectory.']
  revenue_concentration_risk varchar [note: 'Risk rating reflecting the degree of revenue concentration by customer, product, or geography identified during FDD, impacting earnings sustainability assessment.']
  sign_off_date date [note: 'Date on which the lead FDD analyst or senior investment professional formally signed off on the completed FDD assessment for IC submission.']
  tax_structure_risk varchar [note: 'FDD analyst\'s risk rating of the target\'s tax structure, including transfer pricing, deferred tax positions, and unresolved tax authority disputes.']
  third_party_advisor_firm varchar [note: 'Name of the external accounting or advisory firm engaged to conduct or support the FDD (e.g., Big 4 accounting firm), if applicable.']
  third_party_report_date date [note: 'Date on which the external advisor issued the final FDD report, used to assess report currency and relevance at IC submission.']
  working_capital_findings_summary varchar [note: 'Narrative summary of working capital analysis findings including seasonality, cash conversion cycle, and any unusual movements identified during FDD.']
  working_capital_peg_basis varchar [note: 'Methodology used to establish the normalized working capital peg in the SPA, determining the reference period for working capital adjustment at closing.']

  Note: 'Financial Due Diligence (FDD) assessment record capturing the financial analysis of a target investment or fund manager. Tracks quality of earnings (QoE) findings, EBITDA normalization adjustments, working capital analysis, net debt reconciliation'
}

Table diligence.cdd_assessment {
  cdd_assessment_id varchar [pk, note: 'Unique system-generated identifier for the Commercial Due Diligence (CDD) assessment record. Primary key for this entity.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Commercial DD for cross-border investments must reference country risk assessment.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement under which this CDD assessment was commissioned. Links to the overarching DD engagement record.']
  employee_id varchar [note: 'Identifier of the internal investment professional responsible for leading and owning the CDD assessment. Links to the internal analyst/employee party record.']
  lead_analyst_employee_id varchar [note: 'Identifier of the internal investment professional responsible for leading and owning the CDD assessment. Links to the internal analyst/employee party record.']
  sector_outlook_id varchar [note: 'Foreign key linking to research.sector_outlook. Business justification: Commercial DD assesses market size, growth rates, and competitive dynamics. Must reference the sector outlook that informed TAM/SAM assumptions.']
  advisor_report_date date [note: 'Date on which the third-party CDD advisor delivered their final report, used to track timeliness of DD completion relative to IC submission deadlines.']
  assessment_date date [note: 'The principal date on which the CDD assessment was formally conducted or the assessment report was issued by the lead analyst or third-party advisor.']
  assessment_reference varchar [note: 'Externally-known alphanumeric reference code uniquely identifying this CDD assessment, used in Investment Memoranda, IC submissions, and advisor correspondence.']
  assessment_status varchar [note: 'Current lifecycle status of the CDD assessment, tracking progression from initial drafting through IC-ready completion or cancellation.']
  assessment_version varchar [note: 'Version number of the CDD assessment, incremented when material updates are made post-initial completion (e.g., following management clarifications or updated market data).']
  asset_class varchar [note: 'Asset class of the target investment being assessed, determining the applicable CDD framework, benchmarks, and IC approval thresholds.']
  cdd_scope_notes varchar [note: 'Narrative description of the scope, limitations, and key assumptions of the CDD assessment, including any areas excluded from scope or subject to information constraints.']
  competitive_intensity varchar [note: 'Analyst-assigned rating of the overall competitive intensity in the target\'s market, reflecting pricing pressure, new entrant threat, and substitute product risk.']
  competitive_moat_assessment varchar [note: 'Analyst assessment of the durability and width of the target\'s competitive moat, including barriers to entry such as IP, switching costs, network effects, and regulatory licences.']
  competitive_position_rating varchar [note: 'Assessment of the target entity\'s competitive standing within its primary market, reflecting market share, brand strength, pricing power, and differentiation.']
  completion_date date [note: 'Date on which the CDD assessment was formally completed and signed off by the lead analyst and/or IC sponsor, marking readiness for IC submission.']
  contracted_revenue_pct decimal(8,4) [note: 'Percentage of total revenue covered by long-term contracts or take-or-pay agreements, a key indicator of revenue predictability and downside protection.']
  created_timestamp timestamp [note: 'Timestamp when this CDD assessment record was first created in the system, used for audit trail and data lineage purposes.']
  customer_churn_rate_pct decimal(8,4) [note: 'Annual customer attrition rate expressed as a percentage of total customers, used to assess revenue retention quality and commercial durability of the target.']
  data_room_reference varchar [note: 'Reference identifier or URL for the virtual data room folder containing CDD-related documents, management presentations, and market research reports.']
  esg_commercial_risk_flag boolean [note: 'Indicates whether material ESG-related commercial risks (e.g., carbon transition risk, social licence to operate) were identified during the CDD assessment.']
  growth_strategy_assessment varchar [note: 'Classification of the target\'s primary growth strategy as assessed during CDD, used to evaluate execution risk, capital requirements, and alignment with investment thesis.']
  ic_submission_ready boolean [note: 'Indicates whether the CDD assessment has been completed and approved to a standard sufficient for inclusion in the Investment Committee (IC) submission package.']
  investment_thesis_alignment varchar [note: 'Assessment of how well the target\'s commercial profile aligns with the fund\'s stated investment thesis, SAA objectives, and long-term return requirements.']
  key_commercial_opportunities varchar [note: 'Narrative summary of the primary commercial value creation opportunities identified during CDD, including market expansion, pricing improvement, and customer growth levers.']
  key_commercial_risks varchar [note: 'Narrative summary of the most material commercial risks identified during the CDD assessment, including market, competitive, customer, and regulatory risk factors.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this CDD assessment record, supporting audit trail, version control, and change management requirements.']
  macro_sensitivity_rating varchar [note: 'Assessment of the target\'s revenue and earnings sensitivity to macroeconomic variables (GDP, interest rates, inflation, FX), used in stress testing and LDI alignment.']
  management_quality_rating varchar [note: 'CDD-perspective rating of the target management team\'s commercial track record, strategic vision, and execution capability, distinct from ODD management assessment.']
  market_cycle_stage varchar [note: 'Analyst assessment of the current stage of the target\'s market cycle at the time of CDD, informing entry timing, valuation, and macroeconomic sensitivity analysis.']
  market_growth_assessment varchar [note: 'Qualitative classification of the target market\'s growth trajectory based on analyst assessment of structural drivers, cyclicality, and secular trends.']
  market_growth_rate_pct decimal(8,4) [note: 'Projected compound annual growth rate (CAGR) of the target\'s addressable market expressed as a percentage, used to assess long-term revenue trajectory and market tailwinds.']
  market_share_pct decimal(8,4) [note: 'Estimated percentage of the target\'s primary addressable market captured by the target entity, used to benchmark competitive position and revenue sustainability.']
  market_size_usd_mm decimal(18,2) [note: 'Estimated total addressable market (TAM) size in USD millions for the target\'s primary market, derived from third-party research and proprietary analysis.']
  number_of_competitors varchar [note: 'Count of direct competitors identified in the CDD competitive landscape analysis, used to assess market concentration and competitive intensity.']
  overall_cdd_rating varchar [note: 'Composite qualitative rating summarising the overall commercial viability of the target investment based on all CDD workstreams, used in IC submission and investment decision.']
  pricing_power_assessment varchar [note: 'Analyst assessment of the target\'s ability to sustain or increase prices without material volume loss, reflecting brand strength, switching costs, and market position.']
  regulatory_risk_rating varchar [note: 'Assessment of the regulatory risk exposure facing the target entity, including licensing requirements, sector-specific regulation, and potential for adverse regulatory change.']
  revenue_base_year varchar [note: 'The fiscal year used as the baseline for market size, revenue, and growth rate estimates in the CDD assessment, ensuring temporal consistency across analyses.']
  revenue_visibility varchar [note: 'Classification of the target\'s revenue model by predictability and contractual certainty, informing cash flow forecasting and risk-adjusted return analysis.']
  supply_chain_risk_rating varchar [note: 'Assessment of the target\'s exposure to supply chain disruption risk, including supplier concentration, geographic risk, and input cost volatility identified during CDD.']
  target_entity_name varchar [note: 'Legal name of the investment target (company, fund, or asset) subject to this CDD assessment. Treated as confidential pre-announcement deal information.']
  target_geography varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the primary operating geography of the target entity, used for country risk and SAA alignment.']
  target_sector varchar [note: 'Primary industry sector classification of the target entity (e.g., Technology, Healthcare, Industrials, Consumer), used for peer benchmarking and portfolio construction analysis.']
  technology_disruption_risk varchar [note: 'Assessment of the risk that technological innovation or digital disruption could materially erode the target\'s market position or business model over the investment horizon.']
  third_party_advisor varchar [note: 'Name of the external commercial due diligence advisor firm engaged to support or lead the CDD assessment (e.g., strategy consultancy, sector specialist).']
  top_5_customer_concentration_pct decimal(8,4) [note: 'Combined revenue percentage attributable to the five largest customers, used to assess customer diversification risk and revenue resilience in the CDD analysis.']
  top_customer_concentration_pct decimal(8,4) [note: 'Revenue percentage attributable to the single largest customer, a key risk indicator for customer concentration and revenue sustainability in the CDD assessment.']

  Note: 'Commercial Due Diligence (CDD) assessment record evaluating the market position, competitive dynamics, and commercial viability of a target investment. Captures market size and growth assessment, competitive positioning, customer concentration analysis'
}

Table diligence.esg_dd_assessment {
  esg_dd_assessment_id varchar [pk, note: 'Unique surrogate identifier for the ESG due diligence assessment record within the diligence domain.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD-aligned DD requires documenting which climate scenario informed transition/physical risk ratings.']
  climate_stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: ESG DD requires TCFD-aligned climate scenario analysis. Product already has climate_transition_risk_rating and tcfd_disclosure_assessed - linking to stress_scenario enables formal']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement under which this ESG assessment was conducted.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity that this ESG DD assessment is associated with.']
  employee_id varchar [note: 'Internal analyst responsible for conducting and owning this ESG due diligence assessment.']
  esg_employee_id varchar [note: 'Internal analyst responsible for conducting and owning this ESG due diligence assessment.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Pension fund ESG DD must verify targets against exclusion lists per SFDR/fiduciary requirements.']
  gp_profile_id varchar [note: 'Reference to the external fund manager being assessed, if this ESG DD relates to a manager mandate evaluation rather than a direct investment.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being assessed, if this ESG DD relates to a manager mandate evaluation rather than a direct investment.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity that this ESG DD assessment is associated with.']
  reviewer_employee_id varchar [note: 'Internal senior ESG professional or portfolio manager who reviewed and approved the ESG DD assessment prior to IC submission.']
  reviewer_id varchar [note: 'Internal senior ESG professional or portfolio manager who reviewed and approved the ESG DD assessment prior to IC submission.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: ESG DD assessments directly inform SFDR Article 6/8/9 classification. EU pension funds must link ESG diligence to SFDR disclosures for regulatory filings.']
  actual_completion_date date [note: 'Date on which the ESG DD assessment was actually completed and signed off by the lead ESG analyst.']
  advisor_report_reference varchar [note: 'Document reference or data room location of the third-party ESG advisor report supporting this assessment, for audit trail and IC submission purposes.']
  assessment_reference varchar [note: 'Externally-known unique business reference code for this ESG DD assessment, used in IC submissions, IM documentation, and eFront records.']
  assessment_status varchar [note: 'Current lifecycle status of the ESG DD assessment from initiation through IC approval or withdrawal.']
  assessment_type varchar [note: 'Classification of the assessment trigger: initial pre-investment DD, periodic refresh, post-acquisition monitoring, or incident-triggered reassessment.']
  asset_class varchar [note: 'Asset class of the investment subject to ESG DD, determining applicable ESG materiality frameworks and sector-specific risk factors. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|external_fund — 7']
  board_independence_pct decimal(5,2) [note: 'Percentage of independent directors on the target entity\'s board of directors, a key governance quality indicator assessed during ESG DD.']
  carbon_intensity decimal(18,6) [note: 'Carbon intensity of the target entity expressed as tCO2e per unit of revenue, used for portfolio-level carbon footprint reporting per TCFD and SFDR.']
  climate_transition_risk_rating varchar [note: 'Assessment of the target entity\'s exposure to policy, technology, and market risks arising from the transition to a low-carbon economy per TCFD framework.']
  controversy_description varchar [note: 'Narrative description of identified ESG controversies, including nature, severity, and current resolution status, populated when controversy_flag is true.']
  controversy_flag boolean [note: 'Indicates whether the target entity has active or recent material ESG controversies (e.g., environmental violations, labor disputes, governance scandals) identified during DD.']
  created_timestamp timestamp [note: 'Timestamp when the ESG DD assessment record was first created in the system, providing the audit trail creation marker.']
  environmental_risk_rating varchar [note: 'Risk rating for the environmental dimension of the ESG assessment, covering climate, GHG emissions, biodiversity, water, and waste factors.']
  esg_conditions_precedent varchar [note: 'ESG-specific conditions that must be satisfied prior to investment close, such as adoption of an ESG policy, remediation of identified risks, or third-party certification.']
  esg_engagement_plan varchar [note: 'Description of planned post-investment ESG engagement actions and stewardship activities to address identified ESG risks and improvement opportunities.']
  esg_policy_in_place boolean [note: 'Indicates whether the target entity has a formal, documented ESG policy or responsible investment policy in place at the time of assessment.']
  esg_reporting_standard varchar [note: 'Primary ESG reporting framework adopted by the target entity (e.g., GRI, SASB, TCFD, ISSB/IFRS S1/S2), indicating disclosure quality and comparability. [ENUM-REF-CANDIDATE: GRI|SASB|TCFD|ISSB|CDP|UNPRI|none|multiple — 8 candidates stripped; promote to']
  esg_score decimal(5,2) [note: 'Quantitative ESG score (0-100 scale) assigned to the target entity based on the assessment, sourced or benchmarked against MSCI ESG or proprietary scoring.']
  esg_score_provider varchar [note: 'Source or provider of the ESG score used in the assessment, distinguishing between internal proprietary scoring and third-party rating agencies. [ENUM-REF-CANDIDATE: internal|MSCI|Sustainalytics|ISS|Bloomberg|FTSE_Russell|proprietary — 7 candidates']
  exclusion_list_check boolean [note: 'Indicates whether the target entity has been screened against the fund\'s responsible investment exclusion list (e.g., weapons, tobacco, coal) per investment policy.']
  exclusion_list_result varchar [note: 'Outcome of the exclusion list screening: pass (no exclusion triggers), fail (investment prohibited), or conditional pass (subject to conditions or waivers).']
  ghg_emissions_year varchar [note: 'The reporting year to which the GHG Scope 1, 2, and 3 emissions figures relate, enabling year-over-year trend analysis.']
  ghg_scope1_emissions decimal(18,4) [note: 'Target entity\'s direct Scope 1 GHG emissions in tonnes of CO2 equivalent (tCO2e) as reported or estimated during the ESG DD process.']
  ghg_scope2_emissions decimal(18,4) [note: 'Target entity\'s indirect Scope 2 GHG emissions from purchased energy in tCO2e as reported or estimated during the ESG DD process.']
  ghg_scope3_emissions decimal(18,4) [note: 'Target entity\'s value chain Scope 3 GHG emissions in tCO2e where available, covering upstream and downstream indirect emissions.']
  governance_risk_rating varchar [note: 'Risk rating for the governance dimension covering board composition, ownership structure, executive compensation, anti-corruption, and shareholder rights.']
  human_rights_risk_flag boolean [note: 'Indicates whether material human rights risks were identified during the social dimension of the ESG DD, including supply chain labor and community impacts.']
  ic_esg_recommendation varchar [note: 'ESG analyst\'s recommendation to the Investment Committee based on the assessment outcome, indicating whether to proceed with the investment from an ESG perspective.']
  initiation_date date [note: 'Date on which the ESG DD assessment was formally initiated, marking the start of the ESG review process.']
  key_esg_risks_summary varchar [note: 'Executive summary of the most material ESG risks identified during the assessment, used in the Investment Memorandum (IM) and IC submission package.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the ESG DD assessment record, supporting audit trail and data lineage requirements.']
  net_zero_alignment varchar [note: 'Assessment of whether the target entity\'s strategy and emissions trajectory are aligned with a net-zero by 2050 pathway per Paris Agreement commitments.']
  overall_esg_rating varchar [note: 'Composite ESG risk rating assigned at the conclusion of the assessment, summarizing environmental, social, and governance dimensions for IC reporting.']
  physical_climate_risk_rating varchar [note: 'Assessment of the target entity\'s exposure to acute and chronic physical climate risks (e.g., flooding, extreme heat, sea-level rise) per TCFD framework.']
  pri_signatory boolean [note: 'Indicates whether the target entity or fund manager is a signatory to the UN Principles for Responsible Investment (PRI).']
  reviewed_date date [note: 'Date on which the ESG DD assessment was reviewed and signed off by the designated reviewer prior to IC submission.']
  sfdr_article_classification varchar [note: 'SFDR product classification of the investment or fund: Article 6 (no sustainability objective), Article 8 (promotes ESG), or Article 9 (sustainable investment objective).']
  social_risk_rating varchar [note: 'Risk rating for the social dimension covering labor practices, human rights, supply chain standards, health and safety, and community impact.']
  target_completion_date date [note: 'Planned date by which the ESG DD assessment must be completed to meet IC submission timelines.']
  target_entity_name varchar [note: 'Legal name of the company, fund, asset, or manager subject to this ESG due diligence assessment.']
  target_geography varchar [note: 'Primary country of operation of the target entity using ISO 3166-1 alpha-3 code, informing jurisdiction-specific ESG regulatory requirements.']
  target_sector varchar [note: 'Global Industry Classification Standard (GICS) sector of the target entity, used to apply sector-specific ESG materiality frameworks (e.g., SASB standards).']
  tcfd_disclosure_assessed boolean [note: 'Indicates whether the target entity\'s TCFD-aligned climate disclosure was reviewed and assessed as part of the ESG DD process.']
  third_party_esg_advisor varchar [note: 'Name of the external ESG advisory firm or specialist engaged to support the ESG DD assessment (e.g., ERM, Sustainalytics, specialist ESG consultants).']

  Note: 'ESG-specific due diligence assessment conducted as part of the investment DD process. Captures ESG materiality screening results, environmental risk factors (GHG emissions, climate transition risk, physical risk), social risk factors (labor practices'
}

Table diligence.legal_dd_assessment {
  legal_dd_assessment_id varchar [pk, note: 'Unique surrogate identifier for the legal due diligence assessment record. Primary key for this entity. TRANSACTION_HEADER role.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement under which this legal DD assessment was commissioned.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline that this legal DD assessment relates to.']
  employee_id varchar [note: 'Reference to the internal legal counsel or external legal advisor leading the legal due diligence review.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) being assessed, where the legal DD is conducted on a manager mandate rather than a direct deal.']
  lead_legal_counsel_employee_id varchar [note: 'Reference to the internal legal counsel or external legal advisor leading the legal due diligence review.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) being assessed, where the legal DD is conducted on a manager mandate rather than a direct deal.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline that this legal DD assessment relates to.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Legal DD assessments evaluate target compliance with specific regulatory authorities (FCA, SEC, etc.).']
  actual_completion_date date [note: 'Date on which the legal DD assessment was formally completed and the final legal opinion or report was received.']
  assessment_reference varchar [note: 'Externally-known unique reference code for this legal DD assessment, used in correspondence with legal advisors, Investment Committee (IC) submissions, and data room indexing.']
  assessment_status varchar [note: 'Current lifecycle status of the legal DD assessment, tracking progression from initial scoping through completion or withdrawal.']
  assessment_type varchar [note: 'Classification of the legal DD assessment by investment type, distinguishing direct deals, co-investments, fund manager mandates, secondaries, real estate, and infrastructure.']
  conditions_precedent_identified boolean [note: 'Indicates whether legal conditions precedent to closing have been identified, including regulatory approvals, third-party consents, or restructuring steps required before investment completion.']
  conditions_precedent_summary varchar [note: 'Summary of identified legal conditions precedent to closing, including required regulatory approvals, consent requirements, and outstanding restructuring steps.']
  corporate_structure_findings varchar [note: 'Summary of key findings from the corporate structure review, including any structural complexities, offshore entities, or holding company arrangements identified.']
  corporate_structure_reviewed boolean [note: 'Indicates whether the corporate structure, ownership hierarchy, and entity formation documents of the target have been reviewed and verified as part of the legal DD.']
  created_timestamp timestamp [note: 'Timestamp when this legal DD assessment record was first created in the system, used for audit trail and data lineage purposes.']
  data_privacy_findings varchar [note: 'Summary of data privacy and cybersecurity legal findings, including identified GDPR non-compliance, data breach history, or inadequate data processing agreements.']
  data_privacy_review_status varchar [note: 'Status of the data privacy and cybersecurity legal review, assessing the target\'s compliance with applicable data protection regulations such as GDPR.']
  data_room_reference varchar [note: 'Reference identifier or URL for the virtual data room folder containing legal DD source documents, including constitutional documents, contracts, and regulatory filings.']
  employment_findings varchar [note: 'Summary of employment and labour law findings, including identified unfunded pension liabilities, change-of-control clauses in executive contracts, or material employment disputes.']
  employment_review_status varchar [note: 'Status of the employment and labour law review covering key management contracts, collective bargaining agreements, pension obligations, and employment liability exposure.']
  external_legal_advisor varchar [note: 'Name of the external law firm engaged to conduct or support the legal due diligence review on behalf of the pension fund.']
  governing_law varchar [note: 'The legal jurisdiction and governing law applicable to the primary transaction documents (e.g., Share Purchase Agreement (SPA), Limited Partnership Agreement (LPA)), such as New York Law or English Law.']
  ic_submission_date date [note: 'Date on which the legal DD assessment findings were submitted to the Investment Committee (IC) as part of the investment approval package.']
  initiation_date date [note: 'Date on which the legal due diligence assessment was formally initiated and scope was agreed with legal counsel.']
  ip_findings varchar [note: 'Summary of findings from the IP review, including unregistered IP risks, licensing gaps, third-party IP claims, or freedom-to-operate concerns identified.']
  ip_review_status varchar [note: 'Status of the intellectual property review covering ownership, registration, licensing, and freedom-to-operate of material IP assets held by the target.']
  legal_advisor_report_reference varchar [note: 'Document reference or data room identifier for the external legal advisor\'s formal legal DD report or legal opinion letter.']
  legal_risk_flags varchar [note: 'Free-text summary of the most material legal risk flags identified across all workstreams, intended for Investment Committee (IC) briefing and investment memorandum (IM) inclusion.']
  legal_sign_off_date date [note: 'Date on which the lead legal counsel formally signed off the legal DD assessment as complete and satisfactory for investment committee purposes.']
  litigation_findings varchar [note: 'Summary of identified litigation, arbitration proceedings, regulatory investigations, or material threatened claims, including estimated financial exposure where disclosed.']
  litigation_review_status varchar [note: 'Status of the litigation and dispute review, covering pending, threatened, and historical legal proceedings against the target entity.']
  lpa_key_terms_summary varchar [note: 'Summary of material LPA terms reviewed, including hurdle rate, carried interest, clawback provisions, key-man clauses, no-fault divorce rights, and LP transfer restrictions.']
  lpa_reviewed boolean [note: 'Indicates whether the Limited Partnership Agreement (LPA) has been reviewed for key terms including GP removal rights, LPAC governance, fee and carry provisions, and transfer restrictions.']
  material_contracts_findings varchar [note: 'Summary of findings from the material contracts review, including identified change-of-control triggers, consent requirements, termination rights, and unusual commercial terms.']
  material_contracts_reviewed boolean [note: 'Indicates whether key commercial agreements (e.g., customer contracts, supplier agreements, joint ventures, licences) have been reviewed for change-of-control provisions and assignment restrictions.']
  material_litigation_identified boolean [note: 'Indicates whether material litigation, arbitration, regulatory investigations, or threatened claims have been identified that could adversely affect the investment.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity or its advisors prior to commencement of the legal DD review.']
  overall_legal_rating varchar [note: 'Composite legal risk rating assigned by the lead legal counsel upon completion of the legal DD, summarising the aggregate legal risk profile of the target entity or transaction.']
  regulatory_compliance_findings varchar [note: 'Summary of findings from the regulatory compliance review, including identified licence gaps, regulatory breaches, pending enforcement actions, or AML/KYC deficiencies.']
  regulatory_compliance_reviewed boolean [note: 'Indicates whether the target entity\'s regulatory licences, permits, and compliance with applicable laws (including AML, KYC, and sector-specific regulations) have been reviewed.']
  remediation_notes varchar [note: 'Detailed notes on required legal remediation actions, responsible parties, and target resolution dates for identified legal issues prior to investment closing.']
  remediation_required boolean [note: 'Indicates whether legal remediation actions are required prior to or as a condition of investment closing, such as restructuring, consent procurement, or warranty and indemnity insurance.']
  spa_key_terms_summary varchar [note: 'Summary of material SPA terms including representations and warranties, indemnification caps, baskets, escrow arrangements, and conditions precedent to closing.']
  spa_reviewed boolean [note: 'Indicates whether the Share Purchase Agreement (SPA) or equivalent acquisition agreement has been reviewed for representations, warranties, indemnities, and conditions precedent.']
  target_completion_date date [note: 'Planned date by which the legal DD assessment is expected to be completed and the legal DD report delivered to the Investment Committee (IC).']
  target_entity_name varchar [note: 'Legal name of the target company, fund, or manager entity subject to the legal due diligence review.']
  target_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the primary legal jurisdiction in which the target entity is incorporated or domiciled.']
  title_ownership_findings varchar [note: 'Summary of findings from the title and ownership verification, including any identified encumbrances, liens, pledges, or unresolved ownership disputes.']
  title_ownership_verified boolean [note: 'Indicates whether title to the target assets and ownership interests have been verified as free and clear of undisclosed encumbrances, liens, or competing claims.']
  updated_timestamp timestamp [note: 'Timestamp when this legal DD assessment record was last modified, supporting audit trail, change tracking, and incremental data pipeline processing.']

  Note: 'Legal due diligence assessment record capturing the legal review of a target investment or fund manager. Tracks corporate structure review, title and ownership verification, material contract review (LPA terms, SPA, key commercial agreements), litigation'
}

Table diligence.diligence_ic_submission {
  diligence_ic_submission_id varchar [pk, note: 'Unique surrogate identifier for the Investment Committee (IC) submission package record within the diligence domain.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement that underpins this IC submission, linking all DD workstreams and findings to the submission package.']
  deal_opportunity_id varchar [note: 'Reference to the originating deal or investment opportunity in the deal pipeline, sourced from Dealpath/DealCloud CRM.']
  diligence_employee_id varchar [note: 'Reference to the senior investment professional sponsoring and presenting this submission to the Investment Committee, accountable for the recommendation.']
  diligence_lead_analyst_employee_id varchar [note: 'Reference to the lead analyst who conducted the due diligence and authored the Investment Memorandum (IM) supporting this IC submission.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: IC submissions must document the macroeconomic scenario under which target IRR/MOIC were modeled.']
  employee_id varchar [note: 'Reference to the senior investment professional sponsoring and presenting this submission to the Investment Committee, accountable for the recommendation.']
  fee_benchmark_id varchar [note: 'Foreign key linking to fee.fee_benchmark. Business justification: IC submissions must demonstrate fee competitiveness vs market benchmarks. Investment Committee requires fee benchmark comparison in approval memos to validate proposed terms align with']
  gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, applicable when the IC submission relates to a new or re-up external manager mandate rather than a direct investment.']
  lead_analyst_employee_id varchar [note: 'Reference to the lead analyst who conducted the due diligence and authored the Investment Memorandum (IM) supporting this IC submission.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, applicable when the IC submission relates to a new or re-up external manager mandate rather than a direct investment.']
  opportunity_id varchar [note: 'Reference to the originating deal or investment opportunity in the deal pipeline, sourced from Dealpath/DealCloud CRM.']
  prior_submission_diligence_ic_submission_id varchar [note: 'Self-referencing identifier linking to the previous IC submission for the same deal or manager, enabling tracking of resubmissions and IC round history.']
  approved_commitment_amount decimal(20,4) [note: 'The capital commitment amount formally approved by the Investment Committee, which may differ from the recommended amount if the IC imposed a cap or condition.']
  asset_class varchar [note: 'The primary asset class of the investment opportunity being submitted for IC approval, aligned with the fund\'s Strategic Asset Allocation (SAA) framework. [ENUM-REF-CANDIDATE']
  co_investment_flag boolean [note: 'Indicates whether this IC submission relates to a co-investment opportunity alongside a GP, as distinct from a primary fund commitment or direct investment.']
  commitment_amount_base_equivalent decimal(20,4) [note: 'Recommended commitment amount converted to national Dollars (Base Currency) at the submission date FX rate, used for consolidated portfolio exposure and SAA compliance reporting.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code for the recommended commitment amount (e.g., USD, EUR, GBP), used for FX hedging and multi-currency portfolio reporting.']
  conditions_precedent varchar [note: 'Narrative description of conditions that must be satisfied prior to closing the investment, as stipulated by the IC in its approval decision or identified by the legal DD workstream.']
  created_timestamp timestamp [note: 'Timestamp when this IC submission record was first created in the system, used for audit trail and data lineage purposes.']
  data_room_location varchar [note: 'URL or path reference to the virtual data room (VDR) containing the supporting due diligence materials, IM, and third-party advisor reports for this IC submission.']
  dd_completion_status varchar [note: 'Overall completion status of the due diligence process at the time of IC submission, indicating whether all DD workstreams (ODD, FDD, CDD, Legal, ESG) are fully or substantially complete.']
  esg_materiality_flag boolean [note: 'Indicates whether material ESG risks or opportunities were identified during the ESG DD workstream that require specific IC attention, conditions, or post-investment monitoring.']
  esg_rating varchar [note: 'ESG risk rating assigned during the ESG due diligence workstream, reflecting material environmental, social, and governance risks identified for the investment target.']
  hurdle_rate_pct decimal(8,4) [note: 'The minimum preferred return threshold (hurdle rate) applicable to this investment, above which carried interest accrues to the GP. Expressed as an annual percentage per the LPA.']
  ic_decision varchar [note: 'The formal decision rendered by the Investment Committee on this submission: approved, rejected, deferred for further information, or approved subject to conditions precedent.']
  ic_decision_date date [note: 'The date on which the Investment Committee formally rendered its decision (approval, rejection, or deferral) on this submission.']
  ic_meeting_date date [note: 'The scheduled or actual date of the Investment Committee meeting at which this submission is presented for deliberation and decision.']
  ic_round varchar [note: 'Sequential round number of this IC submission for the same deal or manager (e.g., 1 for initial submission, 2 for resubmission after deferral), tracking iterative IC review cycles.']
  im_reference varchar [note: 'Document reference or identifier for the Investment Memorandum (IM) submitted to the IC, linking to the formal research and analysis document in the data room or document management system.']
  im_version varchar [note: 'Version number of the Investment Memorandum submitted with this IC package (e.g., v1.0, v2.3), tracking document revisions through the IC review process.']
  investment_horizon_years varchar [note: 'Expected holding period or fund life in years for the investment, used for liability-driven investment (LDI) matching and long-duration portfolio planning.']
  investment_strategy varchar [note: 'Specific investment strategy or sub-strategy of the proposed investment (e.g., buyout, growth equity, core real estate, value-add infrastructure, direct lending, distressed credit).']
  investment_type varchar [note: 'Classification of the investment structure being proposed: direct investment, co-investment alongside a GP, fund commitment (LP interest), secondary market transaction, or separately managed account (SMA).']
  key_risks_summary varchar [note: 'Narrative summary of the principal investment risks identified during due diligence, as presented to the IC. Includes financial, operational, legal, ESG, and macroeconomic risk factors.']
  kyc_aml_cleared boolean [note: 'Indicates whether the KYC and AML screening of the target entity and its beneficial owners has been completed and cleared prior to IC submission.']
  loi_executed boolean [note: 'Indicates whether a Letter of Intent (LOI) or term sheet has been executed with the target entity prior to IC submission, signaling advanced deal progression.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity or GP prior to receiving confidential deal information and commencing due diligence.']
  overall_dd_rating varchar [note: 'Composite risk rating assigned by the DD team across all workstreams (ODD, FDD, CDD, Legal, ESG), summarizing the overall risk profile of the investment for IC deliberation.']
  portfolio_weight_pct decimal(8,4) [note: 'Proposed weight of this investment as a percentage of total fund AUM at the time of IC submission, used for concentration risk assessment and SAA compliance.']
  recommendation varchar [note: 'Formal recommendation of the investment team as presented in the IC submission: invest, do not invest, proceed with further diligence, or invest subject to conditions.']
  recommended_commitment_amount decimal(20,4) [note: 'The gross capital commitment amount recommended by the investment team for IC approval, expressed in the commitment currency. Represents the proposed Paid-In Capital (PIC) obligation.']
  regulatory_concern_flag boolean [note: 'Indicates whether the legal or compliance DD workstream identified material regulatory concerns (e.g., EMIR, MiFID II, SFDR) requiring IC awareness or conditions precedent.']
  saa_asset_class_bucket varchar [note: 'The SAA portfolio bucket to which this investment is allocated (e.g., Global Equities, Private Equity, Real Assets, Credit), used for SAA compliance monitoring and rebalancing.']
  submission_date date [note: 'The date on which the completed IC submission package was formally submitted to the Investment Committee secretariat for scheduling and review.']
  submission_reference varchar [note: 'Externally-known alphanumeric reference code uniquely identifying this IC submission package, used in board governance systems and audit trails (e.g., IC-2024-00123).']
  submission_status varchar [note: 'Current lifecycle state of the IC submission package. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|deferred|withdrawn — promote to reference product]']
  target_entity_name varchar [note: 'Legal name of the investment target entity, fund, or manager being evaluated in this IC submission. Classified confidential due to deal sensitivity and NDA obligations.']
  target_geography varchar [note: 'Primary country or region of the investment target, expressed as an ISO 3166-1 alpha-3 country code, used for geographic exposure and regulatory reporting.']
  target_irr_pct decimal(8,4) [note: 'Projected gross Internal Rate of Return (IRR) for the investment as modeled in the IC submission, expressed as a percentage. Key return metric for private markets investments.']
  target_moic decimal(8,4) [note: 'Projected gross Multiple on Invested Capital (MOIC) for the investment as modeled in the IC submission. Complements IRR as a return metric for private markets and illiquid assets.']
  third_party_advisor varchar [note: 'Name of the primary external advisor (legal, financial, technical, or ESG) engaged to support the due diligence process for this IC submission.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this IC submission record, supporting audit trail and change tracking requirements.']
  vintage_year varchar [note: 'The year in which the capital commitment is made or the fund\'s first capital call occurs, used for vintage year benchmarking and J-curve analysis of private markets investments.']

  Note: 'Investment Committee (IC) submission package record representing the formal presentation of a DD-completed investment opportunity to the IC for approval. Captures submission date, IC meeting date, investment type, recommended commitment amount, deal'
}

Table diligence.diligence_ic_condition {
  diligence_ic_condition_id varchar [pk, note: 'Unique surrogate identifier for an individual condition or requirement attached to an Investment Committee (IC) approval decision within the due diligence process.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement under which the IC approval decision and this condition were generated.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline (Dealpath/DealCloud) to which this IC condition applies.']
  employee_id varchar [note: 'Reference to the internal analyst or investment professional assigned as the primary owner accountable for tracking and driving resolution of this IC condition.']
  gp_profile_id varchar [note: 'Reference to the external fund manager subject to this IC condition, applicable when the condition relates to an external manager mandate rather than a direct investment.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager subject to this IC condition, applicable when the condition relates to an external manager mandate rather than a direct investment.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline (Dealpath/DealCloud) to which this IC condition applies.']
  owner_analyst_employee_id varchar [note: 'Reference to the internal analyst or investment professional assigned as the primary owner accountable for tracking and driving resolution of this IC condition.']
  risk_assessment_id varchar [note: 'Reference to the DD risk assessment record that informed the IC decision and gave rise to this condition.']
  actual_resolution_date date [note: 'Date on which the IC condition was actually satisfied, waived, or formally closed, enabling resolution cycle time analysis and governance reporting.']
  advisor_report_reference varchar [note: 'Reference identifier for the third-party advisor report or legal opinion that supports or evidences the resolution of this IC condition.']
  asset_class varchar [note: 'Asset class of the investment to which this IC condition applies, enabling portfolio-level condition tracking across public equities, private equity, real estate, infrastructure, natural resources, and credit.']
  condition_category varchar [note: 'Sub-category providing further granularity within the condition type (e.g., KYC/AML clearance, ISDA/CSA execution, TCFD disclosure, LPA negotiation, capital call mechanics).']
  condition_description varchar [note: 'Full narrative description of the condition or requirement as stated in the IC approval decision, including specific actions, deliverables, or thresholds that must be met.']
  condition_rationale varchar [note: 'Business rationale or risk basis for imposing this condition, as documented in the IC minutes or Investment Memorandum (IM), supporting audit and governance review.']
  condition_reference varchar [note: 'Externally-known alphanumeric reference code uniquely identifying this IC condition, used in IC minutes, governance records, and Diligent/BoardEffect board documentation.']
  condition_sequence varchar [note: 'Ordinal sequence number of this condition within the set of conditions attached to the same IC decision, used for ordering in IC minutes and governance reports.']
  condition_status varchar [note: 'Current lifecycle status of the IC condition: open (not yet actioned), in_progress (being resolved), satisfied (fully met), waived (formally waived by IC), escalated, or overdue.']
  condition_type varchar [note: 'Classification of the IC condition by functional domain: legal (SPA, LPA, NDA), financial (FDD, valuation, EBITDA), ESG, operational (ODD), or regulatory (FCA, EMIR).']
  created_timestamp timestamp [note: 'Timestamp when this IC condition record was first created in the system, providing the audit trail start point for governance and regulatory review.']
  data_room_reference varchar [note: 'Reference path or document identifier within the virtual data room (VDR) where supporting evidence or documentation for this IC condition is stored.']
  dd_type varchar [note: 'Type of due diligence workstream that identified or generated this IC condition: ODD (Operational), FDD (Financial), CDD (Commercial), Legal DD, or ESG DD.']
  escalation_date date [note: 'Date on which this IC condition was escalated due to non-resolution by the target date, triggering senior management or IC review.']
  escalation_reason varchar [note: 'Narrative explanation of why this IC condition was escalated, including blocking factors, counterparty delays, or regulatory complications encountered.']
  esg_dimension varchar [note: 'ESG dimension relevant to this condition when condition_type is ESG: environmental (GHG, TCFD), social (labour, human rights), governance (board structure), or none if not ESG-related.']
  extended_resolution_date date [note: 'Revised target resolution date if the original deadline was formally extended, capturing the approved extension for audit and governance tracking purposes.']
  ic_decision_date date [note: 'Date on which the IC formally approved the investment subject to this condition, as recorded in the IC minutes and Diligent/BoardEffect governance platform.']
  ic_decision_reference varchar [note: 'Reference number or identifier of the IC approval decision to which this condition is attached, linking back to the formal IC minutes or resolution document.']
  investment_type varchar [note: 'Nature of the investment structure to which this condition applies: direct investment, co-investment (Co-Invest), fund commitment (LP), separately managed account (SMA), or secondary transaction.']
  is_conditions_precedent boolean [note: 'Indicates whether this condition is a formal condition precedent (CP) that must be satisfied before capital can be committed or the transaction can close.']
  is_ic_blocking boolean [note: 'Indicates whether this condition blocks final IC approval or investment execution until resolved. Blocking conditions prevent capital deployment until satisfied.']
  last_reviewed_by varchar [note: 'Name or identifier of the analyst, compliance officer, or IC member who conducted the most recent formal review of this condition\'s status.']
  last_reviewed_date date [note: 'Date on which this IC condition was most recently formally reviewed and its status updated by the responsible analyst or governance team.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this IC condition record, supporting audit trail, data lineage, and change management requirements.']
  next_review_date date [note: 'Scheduled date for the next formal status review of this IC condition, used to drive workflow reminders and governance reporting cadence.']
  priority varchar [note: 'Priority level assigned to this IC condition, indicating urgency of resolution relative to deal timeline and capital commitment schedule.']
  regulatory_reference varchar [note: 'Specific regulatory rule, article, or requirement (e.g., underwriting practices guidance, EMIR Article 11, MiFID II, SFDR Article 8) that this IC condition is designed to address or satisfy.']
  resolution_evidence varchar [note: 'Description or reference to documentary evidence (e.g., signed SPA, legal opinion, KYC clearance certificate, ESG policy submission) confirming the condition has been satisfied.']
  resolution_notes varchar [note: 'Free-text notes documenting progress updates, outstanding actions, counterparty communications, or partial resolutions related to satisfying this IC condition.']
  responsible_party_name varchar [note: 'Name of the individual, team, or external counterparty (e.g., legal counsel, GP, third-party advisor) responsible for resolving or satisfying this IC condition.']
  responsible_party_type varchar [note: 'Classification of the party responsible for resolving the condition: internal analyst, legal counsel, external advisor, GP/manager, compliance, or finance team.']
  review_frequency varchar [note: 'Frequency at which the status of this IC condition is formally reviewed and reported to the IC or investment team until resolution.']
  target_resolution_date date [note: 'Target date by which the responsible party must satisfy or resolve this IC condition, as agreed at the time of IC approval.']
  third_party_advisor varchar [note: 'Name of the external advisor (legal firm, accounting firm, ESG consultant, technical advisor) engaged to support resolution of this IC condition.']
  waiver_approved boolean [note: 'Indicates whether a formal waiver has been approved by the IC or delegated authority, allowing the investment to proceed without full satisfaction of this condition.']
  waiver_approved_by varchar [note: 'Name or identifier of the IC member, committee, or delegated authority who formally approved the waiver of this condition.']
  waiver_date date [note: 'Date on which the formal waiver of this IC condition was approved and recorded in the governance system.']
  waiver_rationale varchar [note: 'Documented justification for granting a waiver on this IC condition, including risk acceptance rationale and mitigating factors considered by the IC.']

  Note: 'Individual condition or requirement attached to an IC approval decision. Captures condition type (legal, financial, ESG, operational, regulatory), condition description, responsible party for resolution, target resolution date, actual resolution date, and'
}

Table diligence.nda_record {
  nda_record_id varchar [pk, note: 'Unique surrogate identifier for the NDA record within the diligence domain. Primary key for this entity.']
  dd_engagement_id varchar [note: 'Reference to the due diligence engagement for which this NDA was executed, linking the NDA to the broader DD process in eFront or DealCloud.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal origination pipeline (Dealpath/DealCloud) for which this NDA was executed.']
  employee_id varchar [note: 'Reference to the internal investment analyst or deal team member who initiated or is responsible for managing this NDA as part of the deal origination or DD process.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) with whom this NDA was executed, if applicable to a manager evaluation context.']
  lead_analyst_employee_id varchar [note: 'Reference to the internal investment analyst or deal team member who initiated or is responsible for managing this NDA as part of the deal origination or DD process.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) with whom this NDA was executed, if applicable to a manager evaluation context.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal origination pipeline (Dealpath/DealCloud) for which this NDA was executed.']
  asset_class varchar [note: 'Asset class of the investment opportunity or manager evaluation for which this NDA was executed, aligning with the fund\'s strategic asset allocation (SAA) framework.']
  confidentiality_scope varchar [note: 'Narrative description of the scope of confidential information covered by the NDA, including categories of information (financial, operational, strategic) and any explicit exclusions.']
  counterparty_domicile varchar [note: 'ISO 3166-1 alpha-3 country code representing the jurisdiction of incorporation or domicile of the counterparty, used for governing law and regulatory screening.']
  counterparty_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier (LEI) of the counterparty, used for regulatory identification and KYC/AML compliance screening.']
  counterparty_name varchar [note: 'Full legal name of the counterparty (target company, fund manager, intermediary, or advisor) with whom the NDA is executed, as registered in the relevant jurisdiction.']
  counterparty_signatory_name varchar [note: 'Full name of the authorized signatory representing the counterparty who executed the NDA. Captured for legal enforceability and counterparty due diligence records.']
  counterparty_signatory_title varchar [note: 'Job title or role of the authorized signatory from the counterparty organization who executed the NDA (e.g., CEO, General Counsel, Managing Partner).']
  counterparty_type varchar [note: 'Classification of the counterparty entity type for the NDA, distinguishing between target companies, fund managers (GPs), intermediaries, advisors, co-investors, and lenders. [ENUM-REF-CANDIDATE: promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when this NDA record was first created in the system, providing an audit trail for record creation in compliance with data governance and regulatory requirements.']
  data_room_access_granted boolean [note: 'Indicates whether execution of this NDA has resulted in the fund being granted access to the counterparty\'s virtual data room (VDR) for due diligence purposes.']
  data_room_platform varchar [note: 'Name of the virtual data room (VDR) platform to which access was granted following NDA execution (e.g., Intralinks, Datasite, Ansarada). Used for DD workflow coordination.']
  document_reference varchar [note: 'Reference identifier or URL for the executed NDA document stored in the fund\'s document management system or virtual data room, enabling retrieval of the signed agreement.']
  document_version varchar [note: 'Version identifier of the executed NDA document, tracking amendments or restated versions of the agreement over the course of the deal lifecycle.']
  exclusivity_expiry_date date [note: 'Date on which any exclusivity provision within the NDA expires. Null if no exclusivity clause is included. Critical for deal timeline management in the origination pipeline.']
  exclusivity_included boolean [note: 'Indicates whether the NDA includes an exclusivity clause granting the fund exclusive negotiation rights for a defined period, preventing the counterparty from engaging other buyers.']
  execution_date date [note: 'The date on which the NDA was fully executed (signed by all parties), marking the commencement of confidentiality obligations under the agreement.']
  expiry_date date [note: 'The date on which the NDA\'s confidentiality obligations expire. Null if the NDA is perpetual or open-ended. Used for compliance monitoring and renewal tracking.']
  external_counsel_firm varchar [note: 'Name of the external law firm engaged to review or negotiate the NDA on behalf of the pension fund, if applicable. Supports advisor fee tracking and legal engagement management.']
  fund_signatory_name varchar [note: 'Full name of the authorized signatory representing the pension fund who executed the NDA on behalf of the fund. Used for legal record and governance audit trail.']
  fund_signatory_title varchar [note: 'Job title or role of the authorized signatory from the pension fund who executed the NDA (e.g., Managing Director, General Counsel, Chief Investment Officer).']
  governing_law_detail varchar [note: 'Specific governing law clause detail, including state or province where applicable (e.g., \'England and Wales\', \'New York, USA\') for precise legal enforceability.']
  governing_law_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern the NDA. Critical for legal enforceability assessment and cross-border transaction management.']
  investment_type varchar [note: 'Type of investment transaction associated with this NDA, distinguishing direct investments, co-investments (Co-Invest), fund investments (LP), secondaries, and separately managed accounts (SMAs).']
  kyc_aml_cleared boolean [note: 'Indicates whether the counterparty has passed KYC/AML screening at the time of NDA execution. Supports compliance gating for deal progression.']
  kyc_aml_screening_required boolean [note: 'Indicates whether KYC/AML screening of the counterparty is required as a condition of or concurrent with NDA execution, per the fund\'s compliance policy.']
  kyc_cleared_date date [note: 'Date on which the counterparty\'s KYC/AML screening was completed and cleared, enabling deal progression. Null if screening is pending or not yet required.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this NDA record, supporting audit trail, data lineage, and change management requirements in the Silver layer lakehouse.']
  legal_counsel_internal varchar [note: 'Name of the internal legal counsel or legal team responsible for reviewing and approving the NDA on behalf of the pension fund.']
  nda_reference varchar [note: 'Externally-known unique reference number or code assigned to this NDA, used for tracking in legal document management systems and correspondence.']
  nda_status varchar [note: 'Current lifecycle status of the NDA record, tracking progression from draft through execution to expiry or termination. [ENUM-REF-CANDIDATE: draft|pending_signature|executed|expired|terminated|superseded — promote to reference product]']
  nda_type varchar [note: 'Classification of the NDA by directionality of confidentiality obligations: mutual (bilateral), one-way inbound (counterparty discloses to fund), one-way outbound, or multilateral.']
  non_solicit_included boolean [note: 'Indicates whether the NDA includes a non-solicitation clause restricting either party from soliciting the other\'s employees or clients during and after the evaluation period.']
  notes varchar [note: 'Free-text field for additional notes, negotiation commentary, or special conditions associated with this NDA that are not captured in structured fields.']
  origination_channel varchar [note: 'Channel through which the deal or manager relationship was originated, indicating whether the NDA arose from proprietary sourcing, an intermediary, a secondary market process, or an RFP.']
  permitted_use_description varchar [note: 'Description of the permitted purposes for which confidential information may be used under the NDA, typically limited to evaluation of the specific investment opportunity.']
  renewal_date date [note: 'Date on which the NDA was renewed or extended. Null if the NDA has not been renewed. Supports compliance monitoring and legal document lifecycle management.']
  renewal_required boolean [note: 'Indicates whether this NDA requires renewal prior to expiry to maintain confidentiality coverage for an ongoing due diligence or investment monitoring process.']
  sanctions_screened boolean [note: 'Indicates whether the counterparty has been screened against applicable sanctions lists (OFAC, UN, EU) prior to or concurrent with NDA execution.']
  standstill_expiry_date date [note: 'Date on which the standstill provision within the NDA expires, after which the fund may freely acquire securities of the counterparty. Null if no standstill provision exists.']
  standstill_included boolean [note: 'Indicates whether the NDA includes a standstill provision restricting the fund from acquiring securities of the counterparty for a defined period. Relevant for public equity transactions.']
  superseded_by_agreement varchar [note: 'Reference to the definitive agreement (e.g., Share Purchase Agreement (SPA), Limited Partnership Agreement (LPA), or ISDA Master Agreement) that supersedes this NDA upon deal execution.']
  term_months varchar [note: 'Duration of the NDA\'s confidentiality obligations expressed in months from execution date. Null for perpetual NDAs. Supports automated expiry monitoring and renewal workflows.']
  termination_date date [note: 'Date on which the NDA was terminated prior to its natural expiry, if applicable. Null for active or naturally expired NDAs. Captures early termination events.']
  termination_reason varchar [note: 'Reason for early termination of the NDA, such as deal abandonment, deal closure, mutual agreement, breach, or supersession by a definitive agreement (e.g., SPA or LPA).']

  Note: 'Non-Disclosure Agreement (NDA) record executed with a target company, fund manager, or intermediary as part of the deal origination and DD process. Captures counterparty name, LEI, NDA type (mutual, one-way), execution date, expiry date, governing law'
}

Table diligence.data_room_access {
  data_room_access_id varchar [pk, note: 'Unique surrogate identifier for a virtual data room (VDR) access record within a due diligence engagement.']
  dd_engagement_id varchar [note: 'Reference to the parent due diligence engagement for which this VDR access was provisioned.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline associated with this data room access.']
  employee_id varchar [note: 'Reference to the lead investment analyst responsible for the DD engagement, who is the primary user of the VDR access.']
  gp_profile_id varchar [note: 'Reference to the external fund manager under evaluation, applicable when the DD engagement relates to manager selection or ODD.']
  lead_analyst_employee_id varchar [note: 'Reference to the lead investment analyst responsible for the DD engagement, who is the primary user of the VDR access.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager under evaluation, applicable when the DD engagement relates to manager selection or ODD.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the deal pipeline associated with this data room access.']
  access_expiry_date date [note: 'Date on which the VDR access is scheduled to expire. After this date, the investment team can no longer access documents unless access is extended.']
  access_extension_count varchar [note: 'Number of times the VDR access expiry date has been extended. Repeated extensions may indicate deal complexity or delays in the DD process.']
  access_grant_date date [note: 'Date on which access to the virtual data room was formally granted to the investment team. Marks the start of the document review period.']
  access_notes varchar [note: 'Free-text notes recorded by the DD team regarding the VDR access, such as access limitations, counterparty restrictions, or document quality observations.']
  access_reference varchar [note: 'Unique business reference code assigned to this VDR access grant, used for tracking and audit purposes across the DD lifecycle.']
  access_revocation_date date [note: 'Date on which VDR access was revoked prior to the scheduled expiry, typically upon deal termination, NDA breach, or completion of the DD process.']
  access_status varchar [note: 'Current lifecycle status of the VDR access grant. Active indicates current access; expired indicates the access period has lapsed; revoked indicates early termination.']
  access_type varchar [note: 'Level of access permissions granted within the VDR, controlling whether users can view only, download documents, or have full access including printing.']
  access_user_count varchar [note: 'Number of internal investment team members provisioned with access to this VDR. Used for access governance and information security monitoring.']
  advisor_access_granted boolean [note: 'Indicates whether the third-party advisor has been granted access to the VDR in addition to the internal investment team.']
  asset_class varchar [note: 'Asset class of the investment under due diligence (e.g., Private Equity, Real Estate, Infrastructure, Natural Resources, Credit). [ENUM-REF-CANDIDATE: private_equity|real_estate|infrastructure|natural_resources|credit|public_equities|co_investment —']
  created_timestamp timestamp [note: 'Timestamp when this VDR access record was first created in the data platform. Supports audit trail and data lineage requirements.']
  dd_type varchar [note: 'Type of due diligence workstream this VDR access supports: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Full DD.']
  document_categories varchar [note: 'Comma-separated list of document category folders available in the VDR (e.g., Financial Statements, Legal Agreements, ESG Reports, Management Presentations).']
  document_count varchar [note: 'Total number of documents available in the VDR at the time of access grant. Provides a baseline for tracking document completeness during the DD process.']
  documents_downloaded_count varchar [note: 'Cumulative number of documents downloaded from the VDR by the investment team. Tracked for information security audit and NDA compliance purposes.']
  documents_viewed_count varchar [note: 'Cumulative number of distinct documents viewed by the investment team within this VDR access grant. Indicates DD thoroughness and document review progress.']
  download_enabled boolean [note: 'Indicates whether downloading of documents is permitted for users with this access grant. Restricted access may allow viewing only without download capability.']
  esg_documents_available boolean [note: 'Indicates whether ESG-related documents (e.g., sustainability reports, GHG disclosures, governance policies) are available in the VDR for ESG DD review.']
  financial_statements_available boolean [note: 'Indicates whether audited financial statements are available in the VDR, a prerequisite for Financial Due Diligence (FDD) workstream completion.']
  granted_by varchar [note: 'Name or identifier of the individual (typically the deal lead or DD coordinator) who authorized and provisioned the VDR access for the investment team.']
  ic_submission_ready boolean [note: 'Indicates whether the document review from this VDR access is sufficiently complete to support Investment Committee submission for the associated deal.']
  kyc_aml_documents_available boolean [note: 'Indicates whether KYC/AML documentation (e.g., ownership structure, beneficial ownership, source of funds) is available in the VDR for compliance review.']
  last_accessed_date date [note: 'Most recent date on which a member of the investment team accessed the VDR. Used to monitor engagement activity and identify stale or inactive access grants.']
  last_updated_timestamp timestamp [note: 'Timestamp when this VDR access record was most recently modified in the data platform. Supports change tracking and audit trail requirements.']
  legal_documents_available boolean [note: 'Indicates whether key legal documents (e.g., LPA, SPA, constitutional documents, material contracts) are available in the VDR for legal DD review.']
  nda_executed boolean [note: 'Indicates whether a valid NDA has been executed with the target entity prior to granting VDR access. Access should not be provisioned without NDA execution.']
  nda_execution_date date [note: 'Date on which the NDA was formally executed between the pension fund and the target entity or its advisors, establishing confidentiality obligations.']
  nda_reference varchar [note: 'Reference number or identifier of the executed NDA governing the use of information accessed through the VDR. Required before access is provisioned.']
  outstanding_document_requests varchar [note: 'Number of document requests submitted to the target entity via the VDR that remain unfulfilled. Tracks information gaps in the DD process.']
  print_enabled boolean [note: 'Indicates whether printing of documents is permitted for users with this access grant. Controlled to limit physical distribution of confidential deal materials.']
  revocation_reason varchar [note: 'Reason for early revocation of VDR access. Supports audit trail and compliance reporting on information security and deal lifecycle management.']
  source_system_ref varchar [note: 'Native identifier of this VDR access record in the originating source system (e.g., eFront access record ID), enabling lineage tracing and reconciliation.']
  target_entity_name varchar [note: 'Legal name of the target company, fund, or asset being evaluated in the DD engagement. Confidential as it identifies a prospective investment under NDA.']
  third_party_advisor varchar [note: 'Name of the external advisor firm (e.g., legal counsel, accounting firm, technical advisor) also granted access to the VDR as part of the DD engagement.']
  vdr_platform varchar [note: 'Name of the virtual data room platform hosting the DD documents (e.g., Intralinks, Datasite, Ansarada). Determines integration and access protocols.']
  vdr_room_code varchar [note: 'Platform-assigned unique identifier for the data room instance, used for API integration and cross-referencing with the VDR platform\'s own records.']
  vdr_room_name varchar [note: 'Name of the specific data room instance on the VDR platform, typically reflecting the target entity or deal name. Treated as confidential deal information.']
  vdr_url varchar [note: 'Web URL for accessing the virtual data room. Classified as confidential as it provides direct access to sensitive deal documents under NDA.']
  watermarking_enabled boolean [note: 'Indicates whether document watermarking is enabled in the VDR to deter unauthorized distribution and support document traceability.']

  Note: 'Record of virtual data room (VDR) access granted to the investment team for a specific DD engagement. Captures VDR platform (e.g., Intralinks, Datasite, Ansarada), access grant date, access expiry date, document categories available, number of documents'
}

Table diligence.management_interview {
  management_interview_id varchar [pk, note: 'Unique surrogate identifier for a management interview or reference check record within the due diligence process.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement under which this interview or reference check is conducted.']
  dd_workstream_id varchar [note: 'Reference to the specific DD workstream (e.g., ODD, FDD, CDD) this interview supports.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this interview, sourced from the deal pipeline system.']
  employee_id varchar [note: 'Internal analyst responsible for conducting and documenting this interview or reference check.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or GP being evaluated, where the interview relates to an external manager mandate.']
  lead_analyst_employee_id varchar [note: 'Internal analyst responsible for conducting and documenting this interview or reference check.']
  manager_contact_id varchar [note: 'Foreign key linking to manager.manager_contact. Business justification: Management interviews must link to specific GP contacts interviewed. This supports key person clause monitoring, tracks interview history per individual, and enables cross-referencing']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or GP being evaluated, where the interview relates to an external manager mandate.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this interview, sourced from the deal pipeline system.']
  actual_date date [note: 'The actual calendar date on which the interview or reference check took place, which may differ from the scheduled date.']
  additional_attendees varchar [note: 'Names and roles of other internal team members or advisors who attended the interview, recorded for completeness of the DD audit trail.']
  aml_kyc_concern_flag boolean [note: 'Flags whether the interview surfaced any AML or KYC concerns requiring escalation to the compliance team for further investigation.']
  asset_class varchar [note: 'Asset class of the investment being evaluated, providing context for the interview\'s scope and relevance to the portfolio strategy. [ENUM-REF-CANDIDATE: private_equity|real_estate|infrastructure|natural_resources|credit|public_equities|external_manager —']
  created_timestamp timestamp [note: 'Timestamp when this management interview record was first created in the system, providing the audit trail creation point.']
  data_room_reference varchar [note: 'Reference path or document identifier in the virtual data room where the interview notes, transcript, or supporting materials are stored.']
  dd_type varchar [note: 'The DD workstream category this interview supports: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or general cross-workstream.']
  duration_minutes varchar [note: 'Actual duration of the interview or reference check in minutes, used to assess depth of engagement and completeness of coverage.']
  esg_findings_summary varchar [note: 'Summary of ESG-related findings from the interview, including management\'s approach to climate risk, governance practices, and responsible investment integration.']
  esg_topics_discussed boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) topics were explicitly discussed during the interview, supporting ESG DD completeness tracking.']
  follow_up_description varchar [note: 'Description of the specific follow-up actions required, including outstanding questions, additional document requests, or further interviews needed.']
  follow_up_due_date date [note: 'Target date by which follow-up actions from this interview must be completed, aligned with the overall DD engagement timeline.']
  follow_up_required boolean [note: 'Indicates whether additional follow-up actions, clarifications, or supplementary interviews are required as a result of this interview.']
  ic_submission_included boolean [note: 'Indicates whether findings from this interview are included in the Investment Committee (IC) submission package for the associated deal or mandate.']
  interview_format varchar [note: 'The medium through which the interview was conducted: in-person meeting, video call, phone call, or written questionnaire response.']
  interview_location varchar [note: 'Physical location or virtual platform where the interview took place (e.g., target HQ city, office address, or video platform name for remote sessions).']
  interview_reference varchar [note: 'Unique human-readable reference code for this interview or reference check record, used for tracking and cross-referencing in IC submissions and DD reports.']
  interview_sequence varchar [note: 'Sequential number of this interview within the DD engagement, indicating whether it is the first, second, or subsequent session with the target or referee.']
  interview_status varchar [note: 'Current lifecycle status of the interview: scheduled, completed, cancelled, rescheduled, or pending notes/write-up after completion.']
  interview_type varchar [note: 'Classification of the engagement: formal management interview with target, on-site visit, third-party reference check, expert network call, or advisor debrief.']
  interviewee_name varchar [note: 'Full name of the primary individual interviewed (management representative) or the referee providing a reference check response.']
  interviewee_organization varchar [note: 'Name of the organization the interviewee represents. For reference checks, this is the referee\'s employer, not the target entity.']
  interviewee_relationship varchar [note: 'Nature of the interviewee\'s relationship to the target entity, critical for assessing objectivity and relevance of information provided. [ENUM-REF-CANDIDATE: promote to reference product]']
  interviewee_title varchar [note: 'Professional title or role of the interviewee at their organization (e.g., CEO, CFO, Head of Risk, Portfolio Manager).']
  key_findings varchar [note: 'Analyst\'s summary of the most significant insights, observations, and conclusions drawn from the interview relevant to the investment decision.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this interview record, supporting audit trail and data lineage requirements.']
  lead_analyst_name varchar [note: 'Name of the internal analyst who led the interview, retained for audit trail and IC submission documentation.']
  management_quality_assessment varchar [note: 'Narrative assessment of management team quality, depth, experience, and alignment of interests based on the interview, feeding into the DD risk assessment management quality score.']
  notes_completed_date date [note: 'Date on which the interview notes or write-up were finalized and submitted, used for DD timeline tracking.']
  notes_completed_flag boolean [note: 'Indicates whether the formal interview notes or write-up have been completed and submitted by the lead analyst.']
  overall_impression_rating varchar [note: 'Analyst\'s qualitative rating of the overall impression from the interview, used to inform the management quality score in the DD risk assessment.']
  recording_consent_obtained boolean [note: 'Indicates whether explicit consent was obtained from the interviewee to record the session, required for compliance with privacy regulations.']
  red_flags_identified varchar [note: 'Specific concerns, inconsistencies, or adverse findings surfaced during the interview that require escalation or further investigation.']
  referee_sourced_by varchar [note: 'How the referee or interviewee was identified: analyst-sourced independently, provided by the GP/target, via third-party advisor, expert network, or internal network. Indicates potential bias.']
  scheduled_date date [note: 'The calendar date on which the interview or site visit is planned to occur.']
  scheduled_start_time timestamp [note: 'Precise date and time the interview is scheduled to begin, including timezone offset, for calendar coordination across geographies.']
  target_entity_name varchar [note: 'Legal name of the company, fund, or asset being evaluated in the DD process to which this interview relates.']
  third_party_advisor varchar [note: 'Name of the external advisor firm (e.g., legal counsel, ODD specialist) who participated in or facilitated this interview.']
  topics_covered varchar [note: 'Summary of the key subject areas and agenda items discussed during the interview (e.g., investment process, risk management, team stability, ESG integration).']

  Note: 'Record of a formal qualitative information-gathering engagement conducted during DD — covering both management interviews/site visits with the target and reference checks with third-party referees.'
}

Table diligence.reference_check {
  reference_check_id varchar [pk, note: 'Unique surrogate identifier for the reference check record within the diligence domain.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement under which this reference check was conducted.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this reference check, sourced from the deal pipeline.']
  employee_id varchar [note: 'Internal identifier of the investment team analyst or associate who conducted the reference check interview.']
  gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, where the reference check relates to a manager mandate assessment.']
  interviewer_employee_id varchar [note: 'Internal identifier of the investment team analyst or associate who conducted the reference check interview.']
  manager_contact_id varchar [note: 'Foreign key linking to manager.manager_contact. Business justification: Reference checks on key persons must link to the manager_contact record. This supports key person due diligence, tracks reference history per individual, and enables pattern analysis']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, where the reference check relates to a manager mandate assessment.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this reference check, sourced from the deal pipeline.']
  advisor_report_reference varchar [note: 'Document reference or identifier for the third-party advisor\'s written report or findings related to this reference check, linking to the data room.']
  asset_class varchar [note: 'Asset class of the investment opportunity or fund manager mandate to which this reference check relates, enabling domain-specific DD analysis.']
  check_date date [note: 'Date on which the reference check conversation or interview was conducted with the referee.']
  check_reference varchar [note: 'Unique human-readable business identifier for the reference check, used for tracking and cross-referencing in IC submissions and DD reports.']
  check_status varchar [note: 'Current lifecycle status of the reference check, tracking progress from planning through completion or cancellation.']
  check_type varchar [note: 'Category of reference check indicating whether it covers a target company management team member, GP investment professional, co-investor, or other party. [ENUM-REF-CANDIDATE']
  confidentiality_requested boolean [note: 'Indicates whether the referee requested that their identity be kept confidential and not disclosed to the subject or third parties.']
  created_timestamp timestamp [note: 'Timestamp when this reference check record was first created in the system, providing the audit trail creation event.']
  data_room_reference varchar [note: 'Reference path or identifier for the reference check notes, transcript, or supporting documentation stored in the virtual data room.']
  dd_type varchar [note: 'The DD workstream category under which this reference check falls: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, or ESG DD.']
  esg_concerns_noted boolean [note: 'Indicates whether the reference check surfaced any Environmental, Social, or Governance concerns about the subject, feeding into ESG DD and responsible investment assessment.']
  follow_up_notes varchar [note: 'Description of required follow-up actions, open questions, or additional investigation steps identified as a result of this reference check.']
  follow_up_required boolean [note: 'Indicates whether additional follow-up with the referee or further investigation is required based on the findings of this reference check.']
  ic_submission_included boolean [note: 'Indicates whether the findings from this reference check are included in the Investment Committee (IC) submission package for the associated deal or mandate.']
  integrity_rating varchar [note: 'Referee\'s assessment of the subject\'s integrity and ethical conduct, a critical dimension in ODD for institutional investors.']
  interview_duration_minutes varchar [note: 'Duration of the reference check interview in minutes, providing context for the depth and thoroughness of the reference conversation.']
  interview_method varchar [note: 'Mode by which the reference check interview was conducted: phone call, video conference, in-person meeting, or written questionnaire.']
  interviewer_name varchar [note: 'Full name of the internal analyst or investment professional who conducted the reference check, for audit and IC submission purposes.']
  investment_acumen_rating varchar [note: 'Referee\'s assessment of the subject\'s investment judgment, deal sourcing capability, and track record quality, relevant for GP and management team evaluations.']
  key_feedback_summary varchar [note: 'Narrative summary of the most significant feedback provided by the referee, capturing key strengths, concerns, and notable observations for IC and DD report inclusion.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this reference check record, supporting audit trail and data lineage requirements.']
  leadership_rating varchar [note: 'Referee\'s qualitative assessment of the subject\'s leadership capabilities, team management, and strategic decision-making effectiveness.']
  overall_rating varchar [note: 'Consolidated qualitative rating summarizing the overall outcome of the reference check, used in DD risk assessment and IC submission materials.']
  red_flags_description varchar [note: 'Detailed narrative description of any red flags or material concerns identified during the reference check, required when red_flags_noted is True.']
  red_flags_noted boolean [note: 'Boolean flag indicating whether the reference check surfaced any material red flags, concerns, or adverse findings requiring escalation or further investigation.']
  referee_consent_obtained boolean [note: 'Confirms that the referee provided informed consent for their feedback to be recorded and used in the DD process, required under GDPR and applicable privacy regulations.']
  referee_contact_email varchar [note: 'Professional email address of the referee, used for follow-up correspondence and audit trail. Classified as restricted PII per GDPR.']
  referee_contact_phone varchar [note: 'Direct phone number of the referee for scheduling and follow-up. Classified as restricted PII per GDPR and applicable privacy regulations.']
  referee_name varchar [note: 'Full name of the individual who provided the reference. Treated as confidential to protect the referee\'s identity in IC and reporting contexts.']
  referee_organization varchar [note: 'Name of the organization where the referee is currently employed or was employed during their relationship with the subject.']
  referee_relationship varchar [note: 'Nature of the professional relationship between the referee and the subject being referenced, critical for assessing objectivity and relevance of feedback.']
  referee_sourced_by varchar [note: 'Indicates how the referee was identified — whether provided by the GP/target, independently sourced by the investment team, or identified via network or third-party advisor.']
  referee_title varchar [note: 'Professional title or designation of the referee at the time of the reference check (e.g., CFO, Managing Partner, Head of Infrastructure).']
  relationship_duration_years decimal(5,2) [note: 'Approximate number of years the referee has known or worked with the subject, providing context for the depth and relevance of the reference.']
  subject_name varchar [note: 'Full name of the individual being referenced — typically a management team member of the target company or an investment professional at the GP being evaluated.']
  subject_organization varchar [note: 'Name of the organization where the subject individual is employed or was previously employed at the time of the reference check.']
  subject_title varchar [note: 'Professional title or role of the individual being referenced (e.g., CEO, Managing Director, Portfolio Manager) at the target entity.']
  target_entity_name varchar [note: 'Name of the target company, fund, or GP organization that is the subject of the broader DD engagement to which this reference check belongs.']
  third_party_advisor varchar [note: 'Name of the external advisory firm engaged to conduct or assist with the reference check (e.g., specialist ODD firm, background check provider).']
  topics_covered varchar [note: 'Structured summary of the key topic areas discussed during the reference check, such as leadership, investment track record, integrity, team dynamics, and ESG practices.']
  would_work_again varchar [note: 'Referee\'s response to whether they would work with or invest alongside the subject again, a standard qualitative indicator in institutional ODD reference checks.']

  Note: 'Record of a reference check conducted on a target company\'s management team or an external fund manager\'s investment professionals. Captures referee name, referee organization, referee relationship to subject, check date, topics covered, key feedback'
}

Table diligence.dd_document {
  dd_document_id varchar [pk, note: 'Unique surrogate identifier for a due diligence document record in the metadata registry.']
  dd_checklist_item_id varchar [note: 'Reference to the DD checklist item this document satisfies or supports as evidence.']
  dd_engagement_id varchar [note: 'Reference to the DD engagement under which this document was received, generated, or reviewed.']
  dd_workstream_id varchar [note: 'Reference to the specific DD workstream (ODD, FDD, CDD, Legal, ESG) this document belongs to.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the pipeline that this document supports.']
  employee_id varchar [note: 'Reference to the internal analyst or team member responsible for reviewing and assessing this document.']
  gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, if this document relates to a manager DD engagement.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being evaluated, if this document relates to a manager DD engagement.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity in the pipeline that this document supports.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Documents related to the asset are stored in dd_document; linking allows asset‑centric document search.']
  reviewer_employee_id varchar [note: 'Reference to the internal analyst or team member responsible for reviewing and assessing this document.']
  superseded_by_document_dd_document_id varchar [note: 'Reference to the newer document record that supersedes this version, enabling document version chain tracking.']
  target_entity_id varchar [note: 'FK to deal.target_entity']
  asset_class varchar [note: 'The investment asset class to which the DD engagement and this document relate.']
  confidentiality_level varchar [note: 'Data classification level assigned to this document per the fund\'s information security policy.']
  created_timestamp timestamp [note: 'Timestamp when this document metadata record was first created in the registry.']
  data_room_platform varchar [note: 'Name of the virtual data room (VDR) platform where this document is stored and accessed during the DD process. [ENUM-REF-CANDIDATE: Intralinks|Datasite|Ansarada|SharePoint|Box|Firmex|other — 7 candidates stripped; promote to reference product]']
  data_room_reference varchar [note: 'Unique path, folder reference, or file identifier locating this document within the virtual data room (VDR) platform.']
  dd_type varchar [note: 'The DD workstream category this document primarily supports: Operational (ODD), Financial (FDD), Commercial (CDD), Legal, ESG, Tax, Technical, or General. [ENUM-REF-CANDIDATE: ODD|FDD|CDD|Legal|ESG|Tax|Technical|General — 8 candidates stripped; promote to']
  document_currency varchar [note: 'ISO 4217 three-letter currency code of the primary currency used in the document (e.g., USD, GBP, EUR).']
  document_date date [note: 'The date the document was formally issued, signed, or published by the originating party.']
  document_language varchar [note: 'ISO 639-2 three-letter language code of the document (e.g., ENG, FRE, DEU).']
  document_reference varchar [note: 'Unique human-readable reference code assigned to this document within the DD engagement (e.g., DDR-2024-FDD-0042).']
  document_status varchar [note: 'Current lifecycle status of the document within the DD review process.']
  document_summary varchar [note: 'Brief analyst-authored summary of the document\'s key content, findings, or relevance to the DD engagement.']
  document_title varchar [note: 'Full descriptive title of the document as provided by the originating party or assigned by the DD team.']
  document_type varchar [note: 'Classification of the document by its business purpose. [ENUM-REF-CANDIDATE']
  document_version varchar [note: 'Version identifier of the document (e.g., v1.0, v2.1, Final) as designated by the originating party.']
  esg_dimension varchar [note: 'ESG dimension addressed by this document, if applicable (e.g., climate risk report = environmental, board governance review = governance).']
  file_format varchar [note: 'File format or MIME type of the document (e.g., PDF, XLSX, DOCX), used for document management and access control. [ENUM-REF-CANDIDATE: PDF|XLSX|DOCX|PPTX|CSV|ZIP|other — 7 candidates stripped; promote to reference product]']
  file_name varchar [note: 'Original file name of the document as stored in the data room or document management system.']
  file_size_kb varchar [note: 'Size of the document file in kilobytes, used for storage management and data room auditing.']
  is_final_version boolean [note: 'Indicates whether this document represents the final, authoritative version superseding all prior drafts.']
  is_ic_relevant boolean [note: 'Indicates whether this document is designated as material evidence for the Investment Committee (IC) submission package.']
  is_nda_required boolean [note: 'Indicates whether a signed NDA is required before this document may be accessed or distributed.']
  key_findings varchar [note: 'Material findings or observations extracted from this document that are relevant to the DD risk assessment or IC recommendation.']
  last_updated_timestamp timestamp [note: 'Timestamp when this document metadata record was most recently modified.']
  originating_party_name varchar [note: 'Name of the entity that produced or provided the document (e.g., target company, GP, external advisor, legal counsel, auditor).']
  originating_party_type varchar [note: 'Classification of the party that produced the document, distinguishing internal from external sources. [ENUM-REF-CANDIDATE: target_company|GP|external_advisor|legal_counsel|auditor|regulator|internal — 7 candidates stripped; promote to reference product]']
  received_date date [note: 'The date the document was received by the DD team from the counterparty, advisor, or data room.']
  regulatory_reference varchar [note: 'Applicable regulatory framework or standard this document relates to (e.g., SFDR Article 8, TCFD disclosure, third-party risk management guidance).']
  reporting_period_end date [note: 'End date of the financial or operational reporting period covered by the document.']
  reporting_period_start date [note: 'Start date of the financial or operational reporting period covered by the document (e.g., for audited financials or management accounts).']
  reviewed_date date [note: 'The date the document was formally reviewed and assessed by the responsible analyst or advisor.']
  risk_relevance_rating varchar [note: 'Analyst assessment of the degree to which this document\'s content is material to the overall DD risk assessment.']
  source_system_ref varchar [note: 'Native identifier or document ID assigned to this record in the originating source system (e.g., eFront document ID).']
  target_entity_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the target entity, used for regulatory reporting and counterparty identification.']
  third_party_advisor varchar [note: 'Name of the external advisor firm (e.g., Big 4 accounting firm, law firm, technical consultant) that authored or provided this document.']

  Note: 'Metadata registry record for a document received, generated, or reviewed during a DD engagement (CIM, PPM, audited financials, legal opinion, technical report, ESG disclosure, management presentation, data room file).'
}

Table diligence.dd_status_event {
  dd_status_event_id varchar [pk, note: 'Unique surrogate identifier for each DD status transition event record in the audit trail.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement to which this status event belongs.']
  dd_workstream_id varchar [note: 'Reference to the specific DD workstream (ODD, FDD, CDD, Legal, ESG) whose status changed. Null if the event applies at engagement level.']
  deal_opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this DD status event, sourced from the deal pipeline system.']
  employee_id varchar [note: 'Identifier of the internal analyst or user who manually triggered this status transition. Null when the transition was system-initiated.']
  opportunity_id varchar [note: 'Reference to the deal or investment opportunity associated with this DD status event, sourced from the deal pipeline system.']
  triggered_by_analyst_employee_id varchar [note: 'Identifier of the internal analyst or user who manually triggered this status transition. Null when the transition was system-initiated.']
  asset_class varchar [note: 'Asset class of the investment under DD at the time of this status event, used for domain-specific reporting and analytics across the portfolio.']
  comments varchar [note: 'Additional free-text commentary provided by the analyst or system at the time of the status transition, capturing context not covered by structured fields.']
  created_timestamp timestamp [note: 'Timestamp when this status event record was first written to the lakehouse Silver layer. Distinct from event_timestamp which records the business event time.']
  dd_type varchar [note: 'The type of due diligence workstream affected by this status event: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or full engagement-level DD.']
  escalated_to varchar [note: 'Name or role of the senior stakeholder, committee, or governance body to whom this status event was escalated (e.g., IC Sponsor, Chief Investment Officer, Investment Committee).']
  escalation_flag boolean [note: 'Indicates whether this status event was accompanied by a formal escalation to senior management, the IC sponsor, or the Investment Committee due to a critical finding or risk.']
  escalation_reason varchar [note: 'Narrative description of the reason for escalation associated with this status event, where escalation_flag is true. Documents the specific risk or finding that necessitated escalation.']
  event_reference varchar [note: 'Human-readable unique reference code for this status event, used in audit reports and IC governance documentation (e.g., DDSE-2024-000123).']
  event_scope varchar [note: 'Indicates whether this status event applies to the overall DD engagement or to a specific workstream within the engagement.']
  event_timestamp timestamp [note: 'Precise date and time at which the status transition occurred, recorded in ISO 8601 format with timezone offset. This is the authoritative business event time.']
  event_type varchar [note: 'Categorises the nature of the status transition event (e.g., analyst-driven status change, IC decision, escalation, waiver approval, or automated system update).']
  ic_decision_outcome varchar [note: 'The IC decision outcome that drove this status event, where the transition was triggered by an IC meeting (e.g., approved, rejected, deferred, approved with conditions).']
  ic_decision_reference varchar [note: 'Reference number of the IC decision that triggered this status transition, where applicable (e.g., IC approval advancing DD to completed, or IC rejection terminating engagement).']
  investment_type varchar [note: 'Type of investment structure under DD at the time of this event: direct investment, co-investment, fund commitment, secondary transaction, or separately managed account (SMA).']
  is_ic_blocking boolean [note: 'Indicates whether the status resulting from this event blocks IC submission or IC approval until resolved (e.g., a critical finding or unresolved condition precedent).']
  is_milestone_event boolean [note: 'Indicates whether this status transition represents a key DD lifecycle milestone (e.g., initiation, IC submission readiness, completion) for reporting and governance dashboards.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this status event record in the lakehouse, supporting data lineage and incremental load tracking.']
  new_status varchar [note: 'The status of the DD engagement or workstream after this transition event. Represents the current state post-transition. [ENUM-REF-CANDIDATE: not_started|in_progress|on_hold|pending_ic|pending_information|completed|terminated|waived|escalated — promote to']
  on_hold_reason varchar [note: 'Reason the DD engagement or workstream was placed on hold, captured when new_status is on_hold (e.g., pending NDA execution, awaiting data room access, counterparty unresponsive).']
  prior_status varchar [note: 'The status of the DD engagement or workstream immediately before this transition event. Null for the initial status assignment. [ENUM-REF-CANDIDATE: not_started|in_progress|on_hold|pending_ic|pending_information|completed|terminated|waived|escalated —']
  prior_status_duration_days varchar [note: 'Number of calendar days the DD engagement or workstream remained in the prior status before this transition. Used for SLA monitoring and DD cycle time analytics.']
  source_system_event_ref varchar [note: 'The native event or transaction identifier from the originating source system (e.g., eFront workflow event ID), enabling traceability back to the system of record.']
  target_completion_date date [note: 'The planned completion date for the DD engagement or workstream at the time of this status event, capturing any revisions to the timeline as the engagement progresses.']
  target_entity_name varchar [note: 'Name of the investment target entity or external fund manager subject to DD at the time of this status event, captured for audit immutability.']
  termination_reason varchar [note: 'Reason the DD engagement or workstream was terminated, captured when new_status is terminated (e.g., deal withdrawn, IC rejection, valuation mismatch, ESG disqualification).']
  triggered_by_analyst_name varchar [note: 'Display name of the internal analyst or user who triggered this status transition, captured at the time of the event for audit immutability.']
  triggered_by_system varchar [note: 'Name of the operational system that automatically triggered this status transition (e.g., eFront workflow engine, Dealpath pipeline update). Null for manually triggered events.']
  triggered_by_type varchar [note: 'Indicates the category of actor or mechanism that triggered the status transition: an analyst, an IC decision, an automated system process, the external manager, a third-party advisor, or a compliance control.']
  triggering_event_description varchar [note: 'Free-text narrative describing the specific business event, decision, or condition that caused this status transition (e.g., IC approval received, data room access granted, critical finding identified).']
  waiver_approved_by varchar [note: 'Name or role of the authority who approved the waiver associated with this status event (e.g., IC Sponsor, Chief Risk Officer). Populated only when waiver_flag is true.']
  waiver_flag boolean [note: 'Indicates whether this status event involved the approval of a waiver for an outstanding DD item or condition, allowing the engagement to progress despite an unresolved finding.']

  Note: 'Audit trail of status transitions for a DD engagement or workstream throughout its lifecycle. Captures the prior status, new status, transition timestamp, triggering event description, and the analyst or system that triggered the change.'
}

Table diligence.kyc_aml_record {
  kyc_aml_record_id varchar [pk, note: 'Unique system-generated identifier for the KYC/AML screening record. Primary key for this entity. Role: TRANSACTION_HEADER.']
  compliance_officer_employee_id varchar [note: 'Reference to the compliance officer responsible for reviewing and approving this KYC/AML screening record and its final determination.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Regulatory requirement (EMIR/Dodd-Frank): OTC derivative counterparties must pass KYC/AML screening before ISDA/CSA execution.']
  dd_engagement_id varchar [note: 'Reference to the parent DD engagement under which this KYC/AML screening was initiated, linking the record to the broader diligence process.']
  deal_opportunity_id varchar [note: 'Reference to the investment deal or transaction for which this KYC/AML screening was conducted, linking to the deal origination pipeline.']
  employee_id varchar [note: 'Reference to the internal analyst or compliance officer who initiated this KYC/AML screening request.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: KYC/AML screening must cross-reference ESG exclusion lists for sanctions, controversial weapons, UNGC violations.']
  gp_profile_id varchar [note: 'Reference to the external fund manager being screened, applicable when the KYC/AML record pertains to a GP or external manager onboarding.']
  kyc_compliance_officer_employee_id varchar [note: 'Reference to the compliance officer responsible for reviewing and approving this KYC/AML screening record and its final determination.']
  kyc_employee_id varchar [note: 'Reference to the internal analyst or compliance officer who initiated this KYC/AML screening request.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager being screened, applicable when the KYC/AML record pertains to a GP or external manager onboarding.']
  opportunity_id varchar [note: 'Reference to the investment deal or transaction for which this KYC/AML screening was conducted, linking to the deal origination pipeline.']
  adverse_media_flag boolean [note: 'Indicates whether adverse media screening identified negative news coverage related to financial crime, fraud, corruption, or regulatory violations for the subject.']
  adverse_media_summary varchar [note: 'Brief narrative summary of adverse media findings identified during screening, including nature of allegations and source references. Null if no adverse media found.']
  aml_risk_rating varchar [note: 'Risk-based AML classification assigned to the subject following screening, used to determine monitoring frequency and enhanced due diligence requirements.']
  aml_risk_score decimal(5,2) [note: 'Quantitative AML risk score assigned to the subject by the screening model or third-party provider, on a standardized scale used for risk-tiering decisions.']
  asset_class varchar [note: 'Asset class context in which this KYC/AML screening was conducted, enabling domain-specific risk calibration and reporting segmentation. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset — 7']
  beneficial_owner_verified boolean [note: 'Indicates whether the ultimate beneficial owner(s) (UBO) of the subject entity have been identified and verified per the applicable ownership threshold (typically 25%).']
  compliance_approval_date date [note: 'Date on which the compliance officer formally approved the KYC/AML screening outcome, marking the completion of the compliance sign-off process.']
  created_timestamp timestamp [note: 'System timestamp when this KYC/AML record was first created in the data platform, providing the audit trail creation marker.']
  document_reference varchar [note: 'Reference to the document repository location or data room path where KYC/AML supporting documents (ID copies, registry extracts, etc.) are stored.']
  edd_completed_date date [note: 'Date on which Enhanced Due Diligence (EDD) was completed for this subject, applicable when EDD was required. Null if EDD was not required.']
  enhanced_due_diligence_required boolean [note: 'Indicates whether Enhanced Due Diligence (EDD) is required for this subject based on risk rating, PEP status, sanctions proximity, or high-risk jurisdiction.']
  escalation_reason varchar [note: 'Narrative description of the reason for escalating this KYC/AML record to senior compliance or the AML committee, applicable when screening_status is escalated.']
  expiry_date date [note: 'Date on which this KYC/AML clearance expires and the subject must be re-screened before further business activity is permitted.']
  high_risk_jurisdiction_flag boolean [note: 'Indicates whether the subject is domiciled in or primarily operates from a FATF-identified high-risk or non-cooperative jurisdiction, triggering enhanced scrutiny.']
  identity_verification_method varchar [note: 'Method used to verify the identity of the subject, such as document review, third-party database check, official registry search, or electronic verification.']
  investment_type varchar [note: 'Type of investment transaction associated with this KYC/AML screening, distinguishing direct investments, co-investments, fund commitments, secondaries, or SMAs.']
  last_updated_timestamp timestamp [note: 'System timestamp of the most recent modification to this KYC/AML record, supporting audit trail and data lineage requirements.']
  next_review_date date [note: 'Scheduled date for the next periodic KYC/AML refresh review, determined by the subject\'s risk tier and the firm\'s periodic review policy.']
  overall_kyc_aml_outcome varchar [note: 'Final determination of the KYC/AML screening process, indicating whether the subject is cleared for onboarding, cleared with conditions, escalated, or rejected.']
  pep_category varchar [note: 'Classification of the PEP designation: domestic, foreign, international organisation PEP, or close associate, per FATF R.12 taxonomy.']
  pep_flag boolean [note: 'Indicates whether the subject or a beneficial owner has been identified as a Politically Exposed Person (PEP), triggering enhanced due diligence requirements.']
  periodic_review_frequency varchar [note: 'Frequency at which this subject\'s KYC/AML record must be periodically refreshed, determined by the assigned risk rating and regulatory requirements.']
  record_reference varchar [note: 'Externally-visible business reference code for this KYC/AML screening record, used in correspondence, audit trails, and regulatory submissions.']
  rejection_reason varchar [note: 'Documented reason for rejecting the subject\'s onboarding or continued relationship based on KYC/AML findings, required for regulatory record-keeping.']
  sanctions_hit_flag boolean [note: 'Indicates whether the subject returned a positive match against any sanctions list (OFAC, UN, EU, or other applicable lists) during screening.']
  sanctions_list_matched varchar [note: 'Name(s) of the specific sanctions list(s) on which the subject returned a match (e.g., OFAC SDN, UN Consolidated, EU Consolidated). Null if no match.']
  screening_completed_date date [note: 'Calendar date on which the KYC/AML screening was concluded and a final determination was reached, used for SLA and regulatory timeliness tracking.']
  screening_initiated_date date [note: 'Calendar date on which the KYC/AML screening process was formally initiated, marking the start of the compliance clock for regulatory timeliness requirements.']
  screening_provider varchar [note: 'Name of the third-party screening provider or internal system used to conduct the KYC/AML checks (e.g., Refinitiv World-Check, Dow Jones Risk, LexisNexis).']
  screening_provider_reference varchar [note: 'Unique reference or case number assigned by the third-party screening provider for this screening event, used for audit trail and provider reconciliation.']
  screening_status varchar [note: 'Current lifecycle status of the KYC/AML screening process for this record, driving workflow routing and onboarding gate decisions.']
  screening_type varchar [note: 'Classification of the screening event: initial onboarding, periodic refresh, event-triggered review, or enhanced/simplified due diligence based on risk tier.']
  source_of_funds_description varchar [note: 'Narrative description of the verified source of funds or wealth for the subject, documenting the basis for the fund origin determination.']
  source_of_funds_verified boolean [note: 'Indicates whether the source of funds or wealth for the subject has been verified as part of the KYC/AML process, required for high-risk and PEP subjects.']
  subject_domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the subject\'s country of domicile or incorporation, used for jurisdiction risk assessment and sanctions screening.']
  subject_legal_name varchar [note: 'Full registered legal name of the entity or individual being screened, as per official incorporation documents or government-issued identification.']
  subject_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier (LEI) of the subject being screened, used for global entity identification and regulatory reporting.']
  subject_operating_country varchar [note: 'ISO 3166-1 alpha-3 country code of the primary country where the subject conducts its principal business operations, which may differ from domicile.']
  subject_registration_number varchar [note: 'Official corporate registration or incorporation number issued by the relevant national registry for the subject entity, used for identity verification.']
  subject_type varchar [note: 'Category of the entity being screened: counterparty, target company, external fund manager, beneficial owner, co-investor, custodian, or service provider. [ENUM-REF-CANDIDATE']
  ubo_ownership_threshold_pct decimal(5,2) [note: 'Ownership percentage threshold applied to identify ultimate beneficial owners (UBOs) for this screening, typically 25% per FATF standards.']
  watchlist_match_flag boolean [note: 'Indicates whether the subject matched any internal or external watchlist beyond formal sanctions lists, such as internal restricted counterparty lists.']

  Note: 'Know Your Customer (KYC) and Anti-Money Laundering (AML) screening record conducted on a counterparty, target company, fund manager, or beneficial owner as part of the DD and onboarding process.'
}

Table diligence.dd_advisor_cost {
  dd_advisor_cost_id varchar [pk, note: 'Unique identifier for the advisor cost record.']
  advisor_engagement_id varchar [note: 'Identifier of the third‑party advisor.']
  dd_advisor_engagement_id varchar [note: 'Identifier of the advisor engagement associated with this cost.']
  dd_engagement_id varchar [note: 'Identifier of the due diligence engagement.']
  deal_opportunity_id varchar [note: 'Identifier of the deal associated with the engagement.']
  employee_id varchar [note: 'Identifier of the third‑party advisor.']
  gp_profile_id varchar [note: 'Identifier of the manager overseeing the engagement.']
  manager_gp_profile_id varchar [note: 'Identifier of the manager overseeing the engagement.']
  opportunity_id varchar [note: 'Identifier of the deal associated with the engagement.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Cost records for due diligence are tied to the asset; linking enables cost allocation per asset.']
  accrued_amount decimal(18,2) [note: 'Amount accrued to date for the cost.']
  budgeted_amount decimal(18,2) [note: 'Planned amount for the cost.']
  cost_accrual_date date [note: 'Date when the cost was accrued.']
  cost_approval_date date [note: 'Date when the cost was approved.']
  cost_approval_status varchar [note: 'Approval status of the cost record.']
  cost_approved_by varchar [note: 'Name of the approver for the cost record.']
  cost_category varchar [note: 'Classification of the cost item.']
  cost_center_code varchar [note: 'Internal cost center code for accounting purposes.']
  cost_currency_rate decimal(18,6) [note: 'Exchange rate used for currency conversion.']
  cost_currency_rate_date date [note: 'Date of the exchange rate applied.']
  cost_date date [note: 'Date of the cost event.']
  cost_description varchar [note: 'Detailed description of the cost item.']
  cost_end_date date [note: 'End date of the cost period.']
  cost_invoice_date date [note: 'Date of the invoice for the cost.']
  cost_invoice_number varchar [note: 'Invoice number issued for the cost.']
  cost_invoiced_date date [note: 'Date when the cost was invoiced.']
  cost_notes varchar [note: 'Free‑text notes related to the cost.']
  cost_paid_date date [note: 'Date when the cost was paid.']
  cost_payment_date date [note: 'Date when the payment was processed.']
  cost_payment_method varchar [note: 'Method used to pay the cost.']
  cost_payment_status varchar [note: 'Status of the payment for the cost.']
  cost_start_date date [note: 'Start date of the cost period.']
  cost_status varchar [note: 'Current status of the cost line item.']
  cost_tax_amount decimal(18,2) [note: 'Tax amount applied to the cost.']
  cost_tax_code varchar [note: 'Tax code used for the cost.']
  cost_tax_rate decimal(5,2) [note: 'Tax rate applied to the cost.']
  cost_type varchar [note: 'Fee structure type for the advisor engagement.']
  created_at timestamp [note: 'Timestamp when the cost record was first created.']
  currency varchar [note: 'ISO 4217 currency code for the cost amounts.']
  dd_advisor_cost_status varchar [note: 'Current lifecycle status of the cost record.']
  gl_account_code varchar [note: 'General ledger account code for cost allocation.']
  invoiced_amount decimal(18,2) [note: 'Amount invoiced to the advisor.']
  paid_amount decimal(18,2) [note: 'Amount paid to the advisor.']
  reference varchar [note: 'Human‑readable reference for the advisor cost record.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the cost record.']

  Note: 'Cost and fee-accrual record for a third-party advisor engagement within a DD engagement. Captures the advisor_engagement reference, fee type (fixed, capped, hourly, success-based), budgeted amount, accrued-to-date, invoiced amount, paid amount, currency'
}

Table diligence.assessment {
  assessment_id varchar [pk, note: 'Primary key for the assessment association']
  dd_engagement_id varchar [note: 'Foreign key linking to the due diligence engagement being assessed for compliance']
  rule_id varchar [note: 'Foreign key linking to the compliance rule being evaluated']
  applicability_status varchar [note: 'Indicates whether the compliance rule applies to this specific DD engagement based on asset class, geography, and entity type. Some rules only apply to certain engagement types.']
  assessment_date date [note: 'Calendar date on which the compliance assessment was performed for this engagement-rule combination.']
  compliance_rating varchar [note: 'Outcome rating of the compliance assessment indicating whether the DD engagement satisfies the requirements of the specific rule.']
  remediation_required boolean [note: 'Boolean flag indicating whether remediation actions are required before the engagement can proceed to IC submission based on this rule assessment.']

  Note: 'This association product represents the compliance assessment event between a due diligence engagement and a compliance rule. It captures the outcome of evaluating a specific DD engagement against a specific compliance monitoring rule.'
}

Table manager.gp_profile {
  gp_profile_id varchar [pk, note: 'Unique surrogate identifier for each external General Partner (GP), sub-advisor, or Fund-of-Funds manager record in the Silver layer. Primary key for the gp_profile master entity.']
  framework_id varchar [note: 'Foreign key linking to the ESG framework against which compliance is tracked']
  strategy_id varchar [note: 'Foreign key linking to manager.strategy. Business justification: gp_profile.primary_strategy is a string that duplicates strategy information; replacing it with a FK to strategy.strategy_id normalizes the data and removes redundancy.']
  adoption_date date [note: 'Date on which the GP formally adopted or committed to this ESG framework. Used to assess maturity of ESG integration.']
  approved_mandate_types varchar [note: 'Comma-separated list of mandate types for which this GP is approved (e.g., LP fund commitment, co-investment, SMA, advisory). Constrains permissible transaction types in the deal pipeline.']
  asset_class varchar [note: 'Broad asset class bucket to which the GP\'s strategy belongs, aligned with the pension fund\'s Strategic Asset Allocation (SAA) framework and portfolio construction taxonomy.']
  aum_reporting_date date [note: 'Date as of which the reported AUM figure was calculated or disclosed by the GP. Required to assess data currency and staleness for manager monitoring purposes.']
  aum_usd decimal(20,2) [note: 'Total Assets Under Management (AUM) reported by the GP firm in USD as of the most recent reporting date. Key sizing metric for manager selection, capacity constraints, and peer benchmarking.']
  carried_interest_rate decimal(6,4) [note: 'Standard carried interest (Carry) rate charged by the GP on profits above the hurdle rate (e.g., 0.2000 = 20%). Core economic term in LPA fee structure analysis and net return modeling.']
  certification_status varchar [note: 'Status of formal certification or verification under this framework: certified (valid certification), pending (certification in progress), expired (certification lapsed), not_applicable (framework does not offer certification).']
  co_invest_rights_flag boolean [note: 'Indicates whether the pension fund has secured co-investment rights with this GP, enabling direct participation in individual deals alongside the fund. Key for deal origination pipeline.']
  compliance_level varchar [note: 'Current level of GP compliance with the framework requirements: full (meets all requirements), partial (meets some requirements), non_compliant (does not meet requirements), in_progress (actively working toward compliance).']
  created_timestamp timestamp [note: 'Timestamp when the GP profile record was first created in the Silver layer data product. Provides the audit trail creation anchor for data lineage and governance compliance.']
  domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction where the GP firm is legally domiciled. Used for regulatory classification, tax treaty analysis, and FATF AML risk assessment.']
  dry_powder_usd decimal(20,2) [note: 'Total uncalled committed capital (Dry Powder) available to the GP across all active funds in USD. Indicates deployment capacity and competitive positioning for new deal origination.']
  efront_manager_code varchar [note: 'Unique manager identifier within the eFront private markets portfolio monitoring system, which serves as the operational system of record for private fund investment data and GP reporting.']
  esg_policy_flag boolean [note: 'Indicates whether the GP firm has a formally documented ESG policy integrated into its investment process. Required for PRI signatory screening and SFDR alignment assessment.']
  firm_founded_year varchar [note: 'Calendar year in which the GP firm was established. Used to assess organizational maturity, track record length, and key-person risk in manager due diligence.']
  geographic_focus varchar [note: 'Primary geographic region(s) targeted by the GP\'s investment strategy (e.g., North America, Europe, Asia-Pacific, Global). Used for geographic concentration risk monitoring and SAA alignment.']
  headquarters_city varchar [note: 'City where the GP firm\'s principal office and investment decision-making team are located. Used for operational due diligence site visit planning and time-zone coordination.']
  headquarters_country varchar [note: 'ISO 3166-1 alpha-3 country code of the GP firm\'s principal office location. Used for regulatory jurisdiction mapping and FATF AML country risk scoring.']
  hurdle_rate decimal(6,4) [note: 'Preferred return threshold (Hurdle Rate) that must be achieved before the GP is entitled to carried interest (e.g., 0.0800 = 8%). Key economic term for net IRR modeling and LP/GP alignment assessment.']
  ic_approval_date date [note: 'Date on which the Investment Committee (IC) formally approved this GP for inclusion in the pension fund\'s approved manager universe. Establishes the governance audit trail.']
  key_person_clause_flag boolean [note: 'Indicates whether the GP\'s fund agreements include a key-person clause that triggers suspension of the investment period upon departure of named key individuals. Critical governance risk indicator.']
  kyc_next_review_date date [note: 'Scheduled date for the next mandatory KYC/AML periodic review of this GP entity, based on risk-tiered review frequency defined in the AML compliance policy.']
  kyc_review_date date [note: 'Date on which the most recent KYC/AML periodic review was completed for this GP entity. Drives refresh scheduling and compliance monitoring alerts.']
  kyc_status varchar [note: 'Current status of the KYC/AML onboarding and periodic review process for the GP entity. Mandatory for counterparty onboarding under FATF, and internal AML compliance policy.']
  last_assessment_date date [note: 'Date of the most recent compliance assessment or review conducted by the pension fund or external assessor for this GP-framework combination.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the GP profile record in the Silver layer. Used for change detection, data freshness monitoring, and incremental ETL processing.']
  legal_name varchar [note: 'Full registered legal name of the GP firm as recorded in its jurisdiction of incorporation. Used for contract execution, regulatory filings, and KYC/AML documentation.']
  lei varchar [note: '20-character ISO 17442 Legal Entity Identifier assigned to the GP firm. Mandatory for OTC derivative reporting under EMIR and MiFID II counterparty identification.']
  management_fee_rate decimal(6,4) [note: 'Standard annual management fee rate charged by the GP as a percentage of committed or invested capital (e.g., 0.0150 = 1.50%). Used for fee budget modeling and total cost of ownership analysis.']
  manager_risk_rating varchar [note: 'Internal risk rating assigned to the GP based on operational, financial, regulatory, and reputational risk assessment. Used for monitoring frequency tiering and mandate eligibility gating.']
  manager_status varchar [note: 'Current lifecycle status of the GP relationship within the pension fund\'s approved manager universe. Drives eligibility for new mandates and capital commitments.']
  manager_type varchar [note: 'Classification of the external manager relationship: General Partner (GP), sub-advisor, Fund-of-Funds (FoF) manager, co-investment manager, or Separately Managed Account (SMA) manager.']
  number_of_funds varchar [note: 'Total count of investment funds currently managed or advised by the GP firm, including closed-end, open-end, and co-investment vehicles. Used for organizational complexity assessment.']
  number_of_investment_professionals varchar [note: 'Headcount of dedicated investment professionals (partners, principals, associates) at the GP firm. Key input for key-person risk assessment and operational due diligence.']
  operational_due_diligence_date date [note: 'Date on which the most recent Operational Due Diligence (ODD) review was completed for this GP. Tracks compliance with the pension fund\'s periodic ODD refresh policy.']
  pitchbook_manager_code varchar [note: 'Unique manager identifier assigned by PitchBook, used for cross-referencing GP data, fund performance benchmarks, and deal flow analytics from the PitchBook platform.']
  preferred_lp_terms_flag boolean [note: 'Indicates whether the pension fund has negotiated preferred LP terms (e.g., reduced management fees, enhanced co-investment rights, MFN clause) with this GP. Drives fee administration and mandate tracking.']
  preqin_manager_code varchar [note: 'Unique manager identifier assigned by Preqin, the primary external market intelligence source for private markets manager data. Enables automated data enrichment and benchmarking feeds.']
  pri_signatory_flag boolean [note: 'Indicates whether the GP firm is a current signatory to the UN Principles for Responsible Investment (PRI). Used for ESG manager screening and responsible investment stewardship reporting.']
  primary_contact_email varchar [note: 'Email address of the primary relationship contact at the GP firm. Used for capital call notices, distribution announcements, and investor reporting communications.']
  primary_contact_name varchar [note: 'Full name of the primary relationship contact at the GP firm (typically the Investor Relations lead or Partner responsible for the LP relationship). Used for capital call notices and reporting distribution.']
  primary_regulator varchar [note: 'Name of the primary regulatory body that supervises the GP firm (e.g., SEC, FCA, ESMA, MAS). Used for regulatory risk assessment and compliance monitoring.']
  registration_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction where the GP firm is incorporated or registered. May differ from domicile for tax-efficient structures (e.g., Cayman Islands).']
  regulatory_registration_number varchar [note: 'Primary regulatory registration or licence number issued by the GP\'s home regulator (e.g., SEC CRD number, FCA FRN registration). Required for KYC and counterparty onboarding.']
  relationship_inception_date date [note: 'Date on which the pension fund first established a formal investment relationship with this GP (first capital commitment or mandate execution). Measures relationship tenure for loyalty and negotiation leverage.']
  relationship_termination_date date [note: 'Date on which the pension fund formally terminated its investment relationship with this GP. Null for active relationships. Used for historical manager universe reporting and post-mortem analysis.']
  short_name varchar [note: 'Commonly used abbreviated or trading name of the GP firm, used in internal reporting, dashboards, and investment committee materials for brevity.']
  sub_strategy varchar [note: 'More granular strategy classification within the primary asset class (e.g., large-cap buyout, core-plus real estate, greenfield infrastructure, direct lending). Used for portfolio diversification analysis.']
  tcfd_aligned_flag boolean [note: 'Indicates whether the GP firm\'s reporting is aligned with TCFD recommendations for climate-related financial disclosures. Required for pension fund\'s climate risk stewardship obligations.']
  track_record_years varchar [note: 'Number of years of audited investment performance track record available for the GP firm. Minimum track record thresholds are defined in the pension fund\'s manager selection policy.']
  vintage_year_first varchar [note: 'Earliest vintage year of a fund managed by the GP for which performance track record data is available. Defines the start of the GP\'s measurable investment history for IRR and MOIC benchmarking.']
  vintage_year_latest varchar [note: 'Most recent vintage year of a fund managed by the GP. Used to assess recency of deployment activity and alignment with current market cycle positioning.']

  Note: 'Master SSOT record for each external General Partner (GP), sub-advisor, or Fund-of-Funds manager relationship. Captures manager identity, legal entity details, LEI, domicile, AUM, strategy focus, vintage coverage, and operational status, PLUS the'
}

Table manager.manager_mandate {
  manager_mandate_id varchar [pk, note: 'Unique surrogate identifier for each investment mandate awarded to an external manager. Primary key for the manager_mandate product in the Silver layer.']
  custodian_id varchar [note: 'Reference to the custodian or fund administrator responsible for safekeeping assets and NAV calculation under this mandate (e.g., State Street, Northern Trust). Links to the counterparty master.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Mandates must comply with specific ESG policies governing investment restrictions and engagement requirements.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Mandates reference specific exclusion lists defining prohibited investments. Business process: Compliance monitoring ensures managers avoid excluded securities per mandate terms.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) to whom this mandate has been awarded. Links to the manager master record.']
  ic_approval_ic_decision_id varchar [note: 'Reference to the Investment Committee approval record that authorized this mandate. Links to the IC governance record in Diligent/BoardEffect.']
  ic_decision_id varchar [note: 'Reference to the Investment Committee approval record that authorized this mandate. Links to the IC governance record in Diligent/BoardEffect.']
  investment_strategy_id varchar [note: 'Foreign key linking to manager.strategy. Business justification: manager_mandate.investment_strategy is a string that duplicates strategy information; replacing it with a FK to strategy.strategy_id normalizes the data and removes redundancy.']
  manager_benchmark_id varchar [note: 'Reference to the performance benchmark assigned to this mandate (e.g., MSCI World, CPI+4%, Cambridge Associates PE Benchmark). Used for TWR/MWR attribution and GIPS-compliant reporting.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) to whom this mandate has been awarded. Links to the manager master record.']
  portfolio_id varchar [note: 'Reference to the internal investment portfolio or fund sleeve to which this mandate is allocated. Links to the portfolio master record in SimCorp Dimension.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: EU SFDR requires disclosure filings per investment mandate. Links mandate to its regulatory disclosure record for Article 6/8/9 classification reporting.']
  valuation_policy_id varchar [note: 'Foreign key linking to valuation.valuation_policy. Business justification: LPAs and mandate agreements specify valuation methodology requirements (IPEV, GIPS compliance).']
  asset_class varchar [note: 'Primary asset class covered by this mandate (e.g., Private Equity, Real Estate, Infrastructure, Natural Resources, Public Equities, Credit). [ENUM-REF-CANDIDATE']
  carried_interest_rate decimal(8,6) [note: 'GP\'s share of profits above the hurdle rate, expressed as a decimal (e.g., 0.20 = 20% carry). Key fee term sourced from LPA. Used in fee administration and carry accrual calculations.']
  co_investment_rights boolean [note: 'Indicates whether the mandate agreement grants the pension fund co-investment rights alongside the GP\'s fund investments. Co-invest rights are a key negotiated term for large LP commitments.']
  commitment_amount decimal(22,4) [note: 'Total capital committed by the pension fund to this mandate in the mandate currency. Represents the maximum obligation (dry powder + deployed capital). Key input to SAA and liquidity planning.']
  created_timestamp timestamp [note: 'Timestamp when this mandate record was first created in the system, in ISO 8601 format (yyyy-MM-ddTHH:mm:ss.SSSXXX). Provides audit trail for mandate origination and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the mandate is denominated (e.g., USD, EUR, GBP). Used for capital call processing, NAV reporting, and FX hedging decisions.']
  domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code where the fund or mandate vehicle is legally domiciled (e.g., CYM for Cayman Islands, LUX for Luxembourg). Relevant for tax treaty and regulatory treatment.']
  effective_date date [note: 'Date on which the mandate became legally binding and operationally effective. For LP funds, typically the fund closing date. For SMAs, the agreement execution date.']
  esg_integration_level varchar [note: 'Degree to which Environmental, Social, and Governance (ESG) factors are integrated into the mandate\'s investment process: FULL (systematic ESG scoring), PARTIAL (considered but not scored), EXCLUSIONS_ONLY, or NONE.']
  expiry_date date [note: 'Contractual end date of the mandate. For LP funds, the fund term end date (including extensions). For SMAs, the agreement termination date. Null for open-ended mandates.']
  geographic_focus varchar [note: 'Primary geographic region or country focus of the mandate (e.g., North America, Europe, Asia-Pacific, Global, GBR). Expressed as region name or ISO 3166-1 alpha-3 country code where single-country.']
  governing_law_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern the mandate agreement (e.g., CAN, USA, GBR, LUX). Critical for legal enforceability and regulatory reporting.']
  hurdle_rate decimal(8,6) [note: 'Minimum preferred return threshold (as a decimal, e.g., 0.08 = 8%) that must be achieved before the GP is entitled to carried interest. Sourced from LPA or SMA agreement.']
  investment_period_end_date date [note: 'Date on which the GP\'s right to make new investments (deploy capital) expires. After this date, the fund enters harvest/realization phase. Specific to LP fund commitments.']
  key_person_clause boolean [note: 'Indicates whether the LPA or SMA includes a key person clause that suspends the investment period or triggers LP consent rights if named key investment professionals depart the GP.']
  last_odd_review_date date [note: 'Date of the most recent Operational Due Diligence (ODD) review conducted on the external manager for this mandate. Drives scheduling of next review per internal ODD policy.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this mandate record, in ISO 8601 format. Used for change data capture, audit trails, and Silver layer incremental processing in Databricks.']
  lock_up_period_months varchar [note: 'Number of months during which the pension fund cannot redeem or transfer its interest in the mandate. Relevant for hedge funds and open-ended private market vehicles. Zero for fully liquid mandates.']
  lp_advisory_committee_seat boolean [note: 'Indicates whether the pension fund holds a seat on the LP Advisory Committee (LPAC) for this fund mandate, granting governance rights over conflicts of interest and valuation matters.']
  lpa_reference_number varchar [note: 'Unique reference number of the executed Limited Partnership Agreement or SMA contract document. Used to cross-reference legal documents in the document management system.']
  management_fee_basis varchar [note: 'The base on which the management fee is calculated: Committed Capital (during investment period), Invested Capital (post-investment period), NAV, or AUM. Sourced from LPA.']
  management_fee_rate decimal(8,6) [note: 'Annual management fee charged by the external manager as a decimal fraction of committed or invested capital (e.g., 0.015 = 1.5%). Sourced from LPA or SMA fee schedule.']
  manager_risk_rating varchar [note: 'Internal risk rating assigned to the external manager for this mandate, reflecting ODD findings, key person risk, operational controls, and financial stability. Drives oversight intensity.']
  mandate_name varchar [note: 'Human-readable descriptive name of the mandate, typically combining manager name, strategy, and vintage year (e.g., \'Blackstone Real Estate Partners X - LP Commitment 2022\').']
  mandate_status varchar [note: 'Current lifecycle state of the mandate. DRAFT=under negotiation, ACTIVE=deployed and operational, SUSPENDED=temporarily halted, TERMINATED=contractually ended, EXPIRED=term lapsed, PENDING_CLOSE=wind-down in progress.']
  mandate_type varchar [note: 'Classification of the mandate structure: LP Fund Commitment (limited partnership), Separately Managed Account (SMA), Co-Investment agreement, Fund of Funds (FoF), or Advisory.']
  max_allocation_pct decimal(8,6) [note: 'Maximum permissible portfolio weight for this mandate per investment guidelines. Breach triggers a compliance alert. Expressed as a decimal fraction of total AUM.']
  max_extension_years varchar [note: 'Maximum number of years by which the mandate term can be extended under the contractual extension option. Typically 1 or 2 years for PE/RE/Infrastructure LP funds.']
  min_allocation_pct decimal(8,6) [note: 'Minimum permissible portfolio weight for this mandate per investment guidelines. Breach triggers a rebalancing review. Expressed as a decimal fraction of total AUM.']
  most_favored_nation_flag boolean [note: 'Indicates whether the pension fund has negotiated Most Favored Nation (MFN) status, entitling it to the most favorable fee terms offered to any LP in the fund.']
  next_odd_review_date date [note: 'Scheduled date for the next Operational Due Diligence (ODD) review of the external manager. Determined by manager risk rating and internal ODD review cycle policy.']
  redemption_notice_days varchar [note: 'Number of calendar days\' notice required to redeem or withdraw capital from this mandate. Applicable primarily to open-ended funds, hedge funds, and liquid SMAs. Null for closed-end LP funds.']
  reference_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this mandate across internal systems (SimCorp, eFront, Dealpath). Used in counterparty correspondence and regulatory reporting.']
  reporting_frequency varchar [note: 'Frequency at which the external manager is contractually required to provide performance, portfolio, and financial reports to the pension fund. Sourced from LPA or SMA reporting schedule.']
  sla_reporting_breach_flag boolean [note: 'Indicates whether the external manager is currently in breach of contractual SLA reporting obligations (e.g., late quarterly reports, missing capital account statements). Triggers manager oversight review.']
  sub_asset_class varchar [note: 'Granular sub-classification within the asset class (e.g., Buyout, Venture Capital, Core Real Estate, Value-Add, Senior Infrastructure, Direct Lending, High Yield). Supports portfolio construction and attribution.']
  target_allocation_amount decimal(22,4) [note: 'Target dollar allocation to this mandate as determined by the SAA/TAA process. May differ from commitment_amount for LP funds where deployment is phased over the investment period.']
  target_allocation_pct decimal(8,6) [note: 'Target portfolio weight for this mandate expressed as a decimal fraction of total AUM (e.g., 0.025 = 2.5%). Used in SAA compliance monitoring and rebalancing triggers.']
  term_extension_option boolean [note: 'Indicates whether the LPA or SMA agreement includes an option to extend the mandate term beyond the initial expiry date (typically 1+1 year extensions for PE funds).']
  valuation_methodology varchar [note: 'Primary valuation methodology applied to assets held under this mandate. Determines how NAV/GAV is calculated for illiquid private assets. Sourced from LPA or fund governing documents.']
  vintage_year varchar [note: 'The calendar year in which the fund\'s first capital call was made or the mandate was first funded. Critical for benchmarking PE/VC/RE fund performance against peers of the same vintage.']

  Note: 'Authoritative record of each investment mandate awarded to an external manager, covering mandate type (LP fund commitment, SMA, co-investment agreement, FoF), asset class, strategy, target allocation, benchmark, investment guidelines, and contractual term'
}

Table manager.rfp {
  rfp_id varchar [pk, note: 'Unique system-generated identifier for each Request for Proposal or Request for Information issued to external managers during the manager selection process.']
  gp_profile_id varchar [note: 'Reference to the external fund manager, General Partner (GP), or sub-advisor to whom this RFP/RFI was issued. Null if issued to multiple or unspecified managers.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager, General Partner (GP), or sub-advisor to whom this RFP/RFI was issued. Null if issued to multiple or unspecified managers.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate or mandate opportunity that this RFP/RFI is intended to fill. Links the sourcing process to the resulting mandate if awarded.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: RFP manager selection process specifies benchmark requirements for evaluating manager proposals.']
  asset_class varchar [note: 'Primary asset class targeted by this RFP (e.g., Public Equities, Private Equity, Real Estate, Infrastructure, Natural Resources, Credit). [ENUM-REF-CANDIDATE: public_equities|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset —']
  award_target_date date [note: 'Target date by which the RFP evaluation is expected to conclude and a mandate award decision is expected to be communicated to the selected manager.']
  closed_date date [note: 'The actual date on which the RFP process was formally closed, either through award, cancellation, or withdrawal. Null if still active.']
  created_timestamp timestamp [note: 'Timestamp when this RFP record was first created in the system, used for audit trail and data lineage purposes. Conforms to ISO 8601 format.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the mandate size and AUM thresholds stated in this RFP (e.g., USD, GBP, EUR).']
  distribution_channel varchar [note: 'Channel through which the RFP was distributed to prospective managers: directly, via investment consultant, through an intermediary, public tender, or manager platform.']
  esg_framework varchar [note: 'Specific ESG framework or standard the manager is required or expected to adhere to (e.g., PRI, TCFD, SFDR Article 8/9, GHG Protocol, UNPRI signatory status).']
  esg_requirement varchar [note: 'Specifies whether ESG (Environmental, Social, and Governance) integration by the responding manager is mandatory, preferred, or not required for this mandate.']
  evaluation_start_date date [note: 'The date on which the formal evaluation and scoring of received manager responses commences following the response deadline.']
  geography varchar [note: 'Geographic scope or target region for the mandate being sought (e.g., Global, North America, Europe, Asia-Pacific). Uses ISO 3166-1 alpha-3 country codes or regional descriptors.']
  gips_compliance_required boolean [note: 'Indicates whether responding managers are required to be compliant with CFA Institute Global Investment Performance Standards (GIPS) for performance reporting.']
  hurdle_rate decimal(8,4) [note: 'Minimum required rate of return (preferred return threshold) specified in the RFP that the selected manager must achieve before carried interest or performance fees are earned.']
  ic_approval_required boolean [note: 'Indicates whether the final manager selection and mandate award resulting from this RFP requires formal Investment Committee (IC) approval before execution.']
  issuance_date date [note: 'The date on which the RFP or RFI was formally issued and distributed to prospective external managers or the broader market.']
  kyc_aml_required boolean [note: 'Indicates whether responding managers must demonstrate Know Your Customer (KYC) and Anti-Money Laundering (AML) compliance as part of the RFP eligibility criteria.']
  lead_analyst varchar [note: 'Name or identifier of the internal investment analyst or portfolio manager responsible for leading the RFP evaluation process.']
  mandate_size decimal(20,2) [note: 'Indicative capital commitment or mandate size being sought through this RFP, expressed in the mandate currency. Confidential as it reveals investment sizing intentions.']
  min_strategy_aum decimal(20,2) [note: 'Minimum AUM specifically in the target strategy (not total firm AUM) required for a manager to be eligible to respond to this RFP.']
  min_track_record_years varchar [note: 'Minimum number of years of audited performance track record required from responding managers for the relevant strategy to be considered eligible.']
  nda_required boolean [note: 'Indicates whether a signed Non-Disclosure Agreement (NDA) is required from prospective managers before they may access the full RFP documentation.']
  notes varchar [note: 'Free-text field for internal notes, commentary, or supplementary context related to the RFP process, evaluation observations, or special considerations.']
  reference_number varchar [note: 'Externally communicated unique reference number assigned to this RFP/RFI, used in all correspondence with prospective managers and in procurement records.']
  response_deadline date [note: 'The deadline by which prospective managers must submit their responses to the RFP or RFI. Responses received after this date are typically disqualified.']
  responses_received varchar [note: 'Total count of manager responses received by the response deadline. Used to assess market interest and competitiveness of the RFP process.']
  rfp_status varchar [note: 'Current lifecycle status of the RFP. Tracks progression from drafting through issuance, evaluation, and final award or cancellation. [ENUM-REF-CANDIDATE: draft|issued|under_review|shortlisted|awarded|cancelled|closed — promote to reference product]']
  rfp_type varchar [note: 'Classifies the solicitation document type: RFP (Request for Proposal), RFI (Request for Information), RFQ (Request for Quotation), or DDQ (Due Diligence Questionnaire).']
  shortlisted_count varchar [note: 'Number of managers advanced to the shortlist stage following initial screening and evaluation of RFP responses.']
  sourcing_origin varchar [note: 'Indicates how this RFP was initiated: proactively by the investment team, reactively in response to an inbound manager pitch, consultant-recommended, board-directed, or regulatory-driven.']
  strategy_description varchar [note: 'Detailed narrative describing the investment strategy, mandate scope, and return objectives being sought through this RFP, as communicated to prospective managers.']
  sub_asset_class varchar [note: 'More granular classification within the primary asset class (e.g., Large Cap Growth within Public Equities, Core Plus within Real Estate, Senior Secured within Credit).']
  target_aum_max decimal(20,2) [note: 'Maximum AUM threshold for responding managers, used to screen for boutique or capacity-constrained managers where strategy capacity is a consideration.']
  target_aum_min decimal(20,2) [note: 'Minimum Assets Under Management (AUM) threshold required of responding managers to qualify for consideration, expressed in the mandate currency.']
  target_irr decimal(8,4) [note: 'Target net Internal Rate of Return (IRR) specified in the RFP as the expected return objective for the mandate, used to evaluate manager proposals against return expectations.']
  title varchar [note: 'Short descriptive title of the RFP or RFI, summarising the strategy or mandate being sought (e.g., \'Global Infrastructure Equity Manager RFP 2024\').']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this RFP record, supporting audit trail, change tracking, and incremental data pipeline processing.']
  vehicle_type varchar [note: 'Legal or structural vehicle type sought through this RFP: LP Fund (Limited Partnership), SMA (Separately Managed Account), Co-Investment, FoF (Fund of Funds), REIT, or other fund structures.']
  weight_esg decimal(5,2) [note: 'Percentage weight assigned to the ESG Integration criterion in the RFP evaluation scoring framework, reflecting the importance of responsible investment practices.']
  weight_fees decimal(5,2) [note: 'Percentage weight assigned to the Fee Structure criterion in the RFP evaluation scoring framework, covering management fees, carried interest, and total expense ratios.']
  weight_investment_process decimal(5,2) [note: 'Percentage weight assigned to the Investment Process criterion in the RFP evaluation scoring framework. All evaluation weights must sum to 100%.']
  weight_operational_dd decimal(5,2) [note: 'Percentage weight assigned to the Operational Due Diligence (ODD) criterion, covering back-office infrastructure, compliance, cybersecurity, and business continuity.']
  weight_risk_management decimal(5,2) [note: 'Percentage weight assigned to the Risk Management Framework criterion in the RFP evaluation scoring framework, covering VaR, drawdown controls, and risk governance.']
  weight_team_experience decimal(5,2) [note: 'Percentage weight assigned to the Team and Key Personnel Experience criterion in the RFP evaluation scoring framework.']
  weight_track_record decimal(5,2) [note: 'Percentage weight assigned to the Performance Track Record criterion in the RFP evaluation scoring framework, reflecting historical returns and consistency.']

  Note: 'Tracks each Request for Proposal (RFP) or Request for Information (RFI) issued to external managers during the manager selection process. Records RFP type, asset class, strategy sought, issuance date, response deadline, evaluation criteria weighting'
}

Table manager.rfp_response {
  rfp_response_id varchar [pk, note: 'Unique surrogate identifier for each manager\'s formal response to an RFP. Primary key of the rfp_response product.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) that submitted this RFP response. Sourced from Preqin/PitchBook manager registry.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) that submitted this RFP response. Sourced from Preqin/PitchBook manager registry.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: RFP response evaluation compares proposed manager performance against specified benchmarks.']
  rfp_id varchar [note: 'Reference to the parent RFP solicitation to which this response belongs. Links the response to the originating RFP event.']
  asset_class varchar [note: 'Primary asset class of the proposed strategy as categorized by the pension fund\'s Strategic Asset Allocation (SAA) framework.']
  aum_at_submission_usd decimal(20,2) [note: 'Total AUM reported by the manager at the time of RFP response submission in USD, used to assess manager scale and operational capacity.']
  carried_interest_rate_pct decimal(8,4) [note: 'Proposed carried interest (carry) percentage charged by the GP on profits above the hurdle rate, as stated in the RFP response fee schedule.']
  esg_policy_disclosed boolean [note: 'Indicates whether the manager disclosed a formal ESG (Environmental, Social, and Governance) policy or responsible investment framework in their RFP response.']
  esg_score decimal(6,2) [note: 'Sub-score assigned by the internal ESG team assessing the quality and integration of the manager\'s ESG framework as disclosed in the RFP response.']
  evaluation_lead varchar [note: 'Name or identifier of the internal investment professional designated as the lead evaluator for this RFP response.']
  evaluation_notes varchar [note: 'Free-text internal commentary and qualitative observations recorded by the evaluation team regarding the manager\'s RFP response, strengths, weaknesses, and concerns.']
  fee_basis varchar [note: 'The capital base on which the proposed management fee is calculated (e.g., committed capital, invested capital, NAV, GAV), as specified in the manager\'s fee schedule.']
  fee_competitiveness_score decimal(6,2) [note: 'Sub-score assigned by the internal team assessing the competitiveness and alignment of the proposed fee schedule relative to market benchmarks and peer managers.']
  fund_term_years varchar [note: 'Total proposed fund life in years from first close to final liquidation, including any extension options, as stated in the manager\'s RFP response.']
  hurdle_rate_pct decimal(8,4) [note: 'Proposed preferred return threshold (hurdle rate) that must be achieved before the GP is entitled to carried interest, expressed as an annual percentage.']
  ic_presentation_required boolean [note: 'Indicates whether this RFP response has been escalated to require a formal presentation to the Investment Committee (IC) as part of the manager selection process.']
  investment_merit_score decimal(6,2) [note: 'Sub-score assigned by the internal team assessing the investment thesis, strategy quality, and return potential of the proposed mandate.']
  investment_period_years varchar [note: 'Duration of the proposed investment period in years during which the manager may draw down committed capital, as stated in the LPA or mandate terms.']
  key_person_risk_flag boolean [note: 'Indicates whether the internal evaluation team identified key person risk concentration in the manager\'s proposed team, based on RFP response team composition disclosure.']
  key_personnel_count varchar [note: 'Number of key investment professionals (partners, managing directors, portfolio managers) disclosed in the team composition section of the RFP response.']
  management_fee_rate_bps decimal(10,2) [note: 'Annual management fee rate proposed by the manager expressed in basis points (bps) on committed or invested capital, as stated in the RFP response.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) was executed with the manager prior to or concurrent with the RFP response submission.']
  operational_risk_score decimal(6,2) [note: 'Sub-score from the Operational Due Diligence (ODD) assessment of the manager\'s operational infrastructure, controls, and risk management as disclosed in the RFP response.']
  overall_evaluation_score decimal(6,2) [note: 'Composite evaluation score assigned by the internal manager selection team to this RFP response, aggregating scores across all evaluation criteria dimensions.']
  pri_signatory boolean [note: 'Indicates whether the manager is a current signatory to the UN Principles for Responsible Investment (PRI) as disclosed in the RFP response.']
  prior_fund_count varchar [note: 'Number of prior funds or strategies managed by the GP in the same asset class and strategy type, as disclosed in the RFP response track record section.']
  proposed_commitment_usd decimal(20,2) [note: 'The specific capital commitment amount proposed or requested from the pension fund in USD, as stated in the manager\'s RFP response.']
  proposed_fund_size_usd decimal(20,2) [note: 'Total target fund size proposed by the manager in USD, representing the aggregate capital the manager intends to raise for the strategy.']
  proposed_strategy_description varchar [note: 'Detailed narrative description of the proposed investment strategy, including investment thesis, target sectors, geographies, and value creation approach as stated by the manager.']
  proposed_strategy_name varchar [note: 'Name of the investment strategy proposed by the manager in their RFP response (e.g., \'Global Infrastructure Equity Fund IV\', \'Senior Secured Credit Strategy\').']
  received_timestamp timestamp [note: 'System-recorded timestamp when the RFP response document was ingested into the deal management platform (Dealpath/DealCloud), distinct from submission timestamp.']
  response_document_reference varchar [note: 'Document management system reference or URL pointing to the manager\'s full RFP response submission package stored in the deal management platform.']
  response_reference_number varchar [note: 'Externally assigned or manager-generated reference number for this RFP response submission, used for correspondence and audit trail purposes.']
  shortlist_recommendation boolean [note: 'Indicates whether the internal evaluation team has recommended this manager\'s RFP response for advancement to the shortlist stage of the selection process.']
  strategy_aum_usd decimal(20,2) [note: 'AUM specifically attributable to the proposed strategy or asset class at the time of submission, distinct from the manager\'s total firm-wide AUM.']
  strategy_type varchar [note: 'Sub-classification of the proposed strategy (e.g., buyout, venture, core, value-add, opportunistic, direct lending, mezzanine, co-invest, FoF, SMA). [ENUM-REF-CANDIDATE']
  submission_date date [note: 'Calendar date on which the manager formally submitted their RFP response to the pension fund\'s investment team.']
  submission_status varchar [note: 'Current lifecycle state of the manager\'s RFP response within the internal selection process. Drives workflow routing in Dealpath/DealCloud.']
  submission_timestamp timestamp [note: 'Precise date and time at which the manager\'s RFP response was received and recorded in the system, used for deadline compliance verification.']
  target_geography varchar [note: 'Primary geographic focus of the proposed strategy as stated by the manager (e.g., North America, Global, Europe). Free-text to accommodate multi-region mandates.']
  target_irr_pct decimal(8,4) [note: 'Manager\'s stated target net IRR for the proposed strategy, used as a key performance benchmark during the evaluation and mandate negotiation process.']
  target_moic decimal(8,4) [note: 'Manager\'s stated target MOIC (gross or net) for the proposed strategy, representing the expected total value multiple on invested capital.']
  tcfd_aligned boolean [note: 'Indicates whether the manager\'s proposed strategy and reporting framework is aligned with TCFD recommendations as disclosed in the RFP response.']
  team_composition_description varchar [note: 'Narrative description of the investment team structure, key personnel roles, experience, and stability as presented in the RFP response.']
  team_quality_score decimal(6,2) [note: 'Sub-score assigned by the internal team assessing the depth, experience, stability, and succession planning of the manager\'s investment team.']
  track_record_summary varchar [note: 'Narrative summary of the manager\'s historical performance track record as presented in the RFP response, covering prior fund vintages and realized returns.']
  track_record_years varchar [note: 'Number of years of verifiable investment track record presented by the manager in the RFP response, used to assess manager experience and longevity.']
  vintage_year varchar [note: 'The year in which the proposed fund or strategy is expected to make its first capital commitment, used for J-Curve analysis and portfolio construction.']

  Note: 'Captures each manager\'s formal response to an RFP, including submission date, proposed strategy details, proposed fee schedule, track record summary, team composition, AUM at time of submission, and evaluation scores assigned by the internal selection'
}

Table manager.mandate_term {
  mandate_term_id varchar [pk, note: 'Unique surrogate identifier for each mandate term record in the Silver layer. Primary key for the mandate_term data product.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (General Partner or sub-advisor) who is party to this mandate term.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (General Partner or sub-advisor) who is party to this mandate term.']
  manager_mandate_id varchar [note: 'Reference to the parent mandate or investment agreement to which these economic and governance terms apply.']
  asset_class varchar [note: 'Primary asset class covered by the mandate, used for SAA/TAA alignment and fee benchmarking. [ENUM-REF-CANDIDATE: promote to reference product if additional classes added]']
  audit_firm varchar [note: 'Name of the independent external auditor engaged to audit the fund\'s financial statements under this mandate.']
  carried_interest_rate_pct decimal(6,4) [note: 'Percentage of profits allocated to the GP as carried interest (carry) above the hurdle rate. Typically 20% for private equity mandates.']
  carry_split_lp_pct decimal(6,4) [note: 'LP share of profits in the carried interest waterfall after the GP catch-up phase. Typically 80% in a standard 80/20 carry structure.']
  clawback_flag boolean [note: 'Indicates whether a GP clawback provision exists, requiring the GP to return previously distributed carry if the fund underperforms over its life.']
  clawback_lookback_years varchar [note: 'Number of years over which the clawback obligation is assessed. Defines the GP\'s liability window for returning excess carry distributions.']
  co_invest_carry_rate_pct decimal(6,4) [note: 'Carried interest rate applicable to co-investment transactions, typically lower than the main fund carry rate.']
  co_invest_fee_rate_bps decimal(8,4) [note: 'Management fee rate in basis points applicable to co-investment capital deployed alongside the fund, often reduced or zero.']
  co_invest_rights_flag boolean [note: 'Indicates whether the LP has negotiated co-investment rights alongside the fund, allowing direct participation in individual deals.']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code in which the LP commitment and fee calculations are denominated.']
  committed_capital_amount decimal(22,4) [note: 'Total capital committed by the LP under this mandate, as stated in the LPA or SMA. Basis for fee calculations where fee_base is committed_capital.']
  created_timestamp timestamp [note: 'Timestamp when the mandate term record was first created in the system, used for audit trail and data lineage.']
  effective_date date [note: 'Date from which the mandate terms become legally binding and operationally effective, as stated in the LPA or SMA agreement.']
  esg_side_letter_flag boolean [note: 'Indicates whether an ESG-specific side letter or addendum is attached to the mandate, imposing additional responsible investment obligations on the GP.']
  excuse_right_flag boolean [note: 'Indicates whether the LP has the right to excuse itself from specific investments (e.g., for regulatory, ESG, or conflict-of-interest reasons).']
  expiry_date date [note: 'Date on which the mandate terms expire or the fund reaches its scheduled end of term. Nullable for open-ended mandates.']
  extension_option_years varchar [note: 'Number of additional years the GP may extend the fund term beyond the base term, subject to LP advisory committee or LP consent.']
  fee_base varchar [note: 'The capital base on which management fees are calculated: committed capital, invested capital, NAV, GAV, or AUM. Critical for fee accrual and reconciliation.']
  fee_frequency varchar [note: 'Frequency at which management fees are calculated and payable to the GP, as stipulated in the LPA or SMA.']
  fee_payment_timing varchar [note: 'Specifies whether management fees are paid in advance (at the start of the period) or in arrears (at the end of the period).']
  fund_administrator varchar [note: 'Name of the third-party fund administrator responsible for NAV calculation, capital account maintenance, and investor reporting.']
  fund_domicile varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the jurisdiction where the fund vehicle is legally domiciled.']
  fund_term_years varchar [note: 'Contractual life of the fund in years from the initial closing date, as specified in the LPA. Excludes extension options.']
  governing_law_jurisdiction varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code of the legal jurisdiction whose laws govern the mandate agreement (e.g., CYM for Cayman Islands, GBR, USA).']
  gp_catch_up_rate_pct decimal(6,4) [note: 'Rate at which the GP receives profits during the catch-up phase after the LP preferred return is met, before the standard carry split applies.']
  high_water_mark_flag boolean [note: 'Indicates whether a high-water mark provision applies, requiring the fund to recover prior losses before carry is charged again.']
  hurdle_rate_pct decimal(6,4) [note: 'Minimum annualized return (preferred return) that must be achieved before the GP is entitled to carried interest. Also known as the hurdle rate.']
  hurdle_type varchar [note: 'Specifies whether the hurdle is a hard hurdle (carry only on returns above hurdle) or soft hurdle (catch-up provision applies once hurdle is met).']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved the mandate terms and authorized the LP commitment.']
  investment_period_end_date date [note: 'Date on which the fund\'s investment period closes, after which new capital deployments are restricted and management fees may step down.']
  key_person_clause_flag boolean [note: 'Indicates whether the mandate includes a key person provision that suspends the investment period if named key individuals depart the GP.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the mandate term record, supporting amendment tracking and audit compliance.']
  lp_advisory_committee_flag boolean [note: 'Indicates whether the LP has a seat or observer rights on the Limited Partner Advisory Committee (LPAC) for this fund mandate.']
  mandate_type varchar [note: 'Classification of the mandate structure governing these terms. [ENUM-REF-CANDIDATE: LPA|SMA|co_investment|FoF|sub_advisory|co_investment_side_letter — promote to reference product]']
  mgmt_fee_rate_bps decimal(8,4) [note: 'Annual management fee rate expressed in basis points (bps) applied to the fee base. Represents the primary tier or flat rate where tiered schedules are not applicable.']
  mgmt_fee_tier_schedule varchar [note: 'Textual or structured description of tiered management fee breakpoints by AUM band (e.g., 100bps on first $500M, 75bps above). Stored as structured text pending normalization.']
  monitoring_fee_offset_pct decimal(6,4) [note: 'Percentage of portfolio company monitoring, transaction, or advisory fees received by the GP that must be credited back to offset LP management fees.']
  most_favored_nation_flag boolean [note: 'Indicates whether the LP has Most Favored Nation rights, entitling it to the most favorable economic terms offered to any other LP in the fund.']
  no_fault_divorce_flag boolean [note: 'Indicates whether LPs have the right to remove the GP without cause (no-fault divorce) by a supermajority vote.']
  organizational_expense_cap_pct decimal(6,4) [note: 'Maximum percentage of committed capital that the GP may charge as organizational and formation expenses to the fund.']
  post_investment_fee_rate_bps decimal(8,4) [note: 'Reduced management fee rate in basis points applicable after the investment period ends, typically applied to invested (not committed) capital.']
  reporting_frequency varchar [note: 'Frequency at which the GP is contractually required to deliver fund performance, valuation, and portfolio reports to the LP.']
  term_reference_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this version of the mandate term, used in LPA schedules, SMA agreements, and co-investment side letters.']
  term_status varchar [note: 'Current lifecycle state of the mandate term record, governing whether the economic terms are operationally binding.']
  valuation_methodology varchar [note: 'Accounting and valuation standard used to determine NAV/GAV for the fund under this mandate (e.g., IPEV guidelines, IFRS 13, FASB ASC 820).']
  vintage_year varchar [note: 'Calendar year in which the fund\'s first capital call was made or the mandate became effective. Used for peer benchmarking and J-curve analysis.']
  waterfall_type varchar [note: 'Distribution waterfall structure: deal-by-deal (American) allows carry on each deal; whole-fund (European) requires full capital return before carry.']

  Note: 'Authoritative SSOT for the economic and governance terms of each mandate: management fee basis points (tiered by AUM band), carried interest rate, hurdle/preferred return, high-water mark, clawback terms, fee base (committed vs invested capital), fee'
}

Table manager.mandate_amendment {
  mandate_amendment_id varchar [pk, note: 'Unique surrogate identifier for each formal amendment record to an external manager mandate. Primary key for the mandate_amendment product in the Silver layer.']
  actor_id varchar [note: 'Reference to the governance body or individual (e.g., Investment Committee, Board, CIO) that approved this amendment. Links to the governance authority entity.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) whose mandate is being amended. Sourced from the manager master profile.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) whose mandate is being amended. Sourced from the manager master profile.']
  manager_mandate_id varchar [note: 'Reference to the parent mandate (LPA, SMA, co-investment agreement, or FoF mandate) that this amendment modifies. Links to the mandate master record.']
  mandate_dealcloud_amendment_id varchar [note: 'Native amendment record identifier from DealCloud (Deal Pipeline and Origination CRM), used for amendments originating from the deal pipeline or manager relationship management workflow.']
  mandate_efront_amendment_id varchar [note: 'Native amendment record identifier from eFront (Private Markets Portfolio Monitoring system), the primary system of record for private market mandate amendments. Enables reconciliation.']
  amendment_date date [note: 'The principal real-world date on which the amendment was formally agreed and signed by both parties. This is the legally binding execution date per the amendment agreement.']
  amendment_rationale varchar [note: 'Business justification for the amendment as documented in the IC memo or negotiation record. Captures the strategic or operational reason driving the change.']
  amendment_reference varchar [note: 'Externally-known unique reference code assigned to this amendment (e.g., AMD-MAND0042-2024-001). Used in legal correspondence, IC memos, and audit trails.']
  amendment_status varchar [note: 'Current workflow state of the amendment from drafting through execution. Controls downstream processing and reporting inclusion.']
  amendment_type varchar [note: 'Classification of the amendment by its primary business purpose. Drives workflow routing and legal review requirements. [ENUM-REF-CANDIDATE']
  amendment_version varchar [note: 'Sequential version number for amendments to the same clause or provision within the same mandate. Enables tracking of iterative renegotiations over the mandate lifecycle.']
  approval_level varchar [note: 'Governance tier at which the amendment was approved, reflecting the materiality and delegation of authority framework (e.g., CIO for minor fee adjustments, Board for material term changes).']
  clause_description varchar [note: 'Plain-language description of the clause or provision being amended, providing business context for the change beyond the clause reference number.']
  clause_reference varchar [note: 'Specific section, article, or clause number within the original mandate agreement (LPA, SMA, or co-investment agreement) that is being modified by this amendment.']
  counterparty_signed_date date [note: 'Date on which the external manager (GP or sub-advisor) executed their signature on the amendment document. May differ from amendment_date if signing occurred in stages.']
  created_timestamp timestamp [note: 'Timestamp when this amendment record was first created in the system. Supports audit trail, data lineage, and Silver layer ingestion tracking per ISO 27001.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable when value_unit is currency (e.g., USD, GBP, EUR). Null for non-monetary clause amendments.']
  document_reference varchar [note: 'Document management system reference or file path for the executed amendment agreement. Enables retrieval of the legal document from the document repository.']
  effective_date date [note: 'Date from which the amended terms take legal and operational effect. May differ from amendment_date if the amendment has a retroactive or future effective date.']
  esg_impact_assessed boolean [note: 'Indicates whether an ESG impact assessment was conducted for this amendment, particularly relevant for guideline changes affecting ESG constraints or responsible investment mandates.']
  expiry_date date [note: 'Date on which the amended terms cease to apply, if the amendment is time-limited (e.g., a temporary fee waiver or a side letter with a sunset clause). Null for permanent amendments.']
  fee_type_amended varchar [note: 'Specific fee component modified by this amendment when amendment_type is fee_renegotiation. Null for non-fee amendments. [ENUM-REF-CANDIDATE: management_fee|carried_interest|hurdle_rate|preferred_return|transaction_fee|monitoring_fee|setup_fee|clawback —']
  ic_approval_date date [note: 'Date on which the Investment Committee formally approved this amendment. May precede the amendment_date (execution date) by days or weeks.']
  ic_approval_reference varchar [note: 'Reference number or resolution identifier from the Investment Committee (IC) meeting minutes approving this amendment. Links to the governance record in Diligent/BoardEffect.']
  internal_signed_date date [note: 'Date on which the pension fund\'s authorized signatory executed the amendment on behalf of the fund. Completes the bilateral execution of the amendment.']
  investment_guideline_category varchar [note: 'Category of investment guideline modified when amendment_type is guideline_change. Drives compliance monitoring updates in BlackRock Aladdin and Charles River IMS.']
  is_material_amendment boolean [note: 'Indicates whether this amendment is classified as material under the fund\'s internal governance policy, triggering enhanced IC approval, legal review, and regulatory disclosure requirements.']
  is_side_letter boolean [note: 'Indicates whether this amendment is structured as a side letter (a separate bilateral agreement supplementing the main LPA or SMA) rather than a formal amendment to the primary document.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this amendment record. Used for incremental data pipeline processing and change detection in the Databricks Silver layer.']
  legal_counsel_firm varchar [note: 'Name of the external legal counsel firm engaged to review and draft this amendment. Supports legal cost tracking and counsel relationship management.']
  legal_review_completed boolean [note: 'Indicates whether the internal or external legal review of this amendment has been formally completed and signed off prior to execution.']
  mfn_applicable boolean [note: 'Indicates whether a Most Favoured Nation (MFN) clause applies to this amendment, entitling the pension fund to the most favourable terms granted to any other LP in the fund.']
  negotiation_summary varchar [note: 'Summary of the negotiation process, key concessions, and counterparty positions leading to the agreed amendment terms. Supports post-deal review and future renegotiations.']
  prior_carry_rate decimal(8,6) [note: 'The carried interest (carry) rate as a decimal (e.g., 0.20 for 20%) in effect before this amendment. Populated when fee_type_amended includes carried_interest.']
  prior_hurdle_rate decimal(8,6) [note: 'The preferred return / hurdle rate as a decimal (e.g., 0.08 for 8%) before this amendment. The threshold IRR the GP must exceed before earning carry.']
  prior_management_fee_rate decimal(8,6) [note: 'The management fee rate (as a decimal, e.g., 0.015 for 1.5%) in effect before this amendment. Populated only when fee_type_amended includes management_fee.']
  prior_term_end_date date [note: 'The original contractual end date of the mandate or fund term before this amendment. Populated for term extension amendments to document the change.']
  prior_value decimal(18,2) [note: 'The original contractual value, rate, limit, or text of the clause before this amendment. Stored as STRING to accommodate numeric, percentage, date, and free-text clause values.']
  regulatory_disclosure_required boolean [note: 'Indicates whether this amendment triggers a regulatory disclosure obligation (e.g., SFDR, SEC reporting). Drives compliance workflow and regulatory reporting queue.']
  revised_carry_rate decimal(8,6) [note: 'The carried interest (carry) rate as a decimal after this amendment. Tracks renegotiated economics for performance attribution and fee analysis.']
  revised_hurdle_rate decimal(8,6) [note: 'The preferred return / hurdle rate as a decimal after this amendment. Impacts IRR and MOIC calculations for performance attribution.']
  revised_management_fee_rate decimal(8,6) [note: 'The management fee rate (as a decimal) after this amendment. Enables fee savings tracking and benchmarking against Preqin/PitchBook market data.']
  revised_term_end_date date [note: 'The new contractual end date of the mandate or fund term after this amendment. Used in ALM, liquidity forecasting, and commitment scheduling.']
  revised_value decimal(18,2) [note: 'The new contractual value, rate, limit, or text of the clause after this amendment. Stored as STRING to accommodate numeric, percentage, date, and free-text clause values.']
  side_letter_type varchar [note: 'Classification of the side letter if is_side_letter is true. MFN (Most Favoured Nation) clauses, co-investment rights, and fee discounts are common LP-negotiated side letter types.']
  term_extension_years decimal(5,2) [note: 'Number of years by which the mandate or fund term is extended under this amendment. Populated when amendment_type is term_extension. Supports ALM and liquidity planning.']
  value_unit varchar [note: 'Unit of measure for prior_value and revised_value (e.g., percentage for management fee rate, bps for spread, currency for hard cap). Enables correct interpretation of the change.']

  Note: 'Records each formal amendment to an existing mandate, capturing amendment date, amendment type (fee renegotiation, guideline change, term extension, side letter), the specific clause modified, prior value, revised value, and approval authority.'
}

Table manager.manager_contact {
  manager_contact_id varchar [pk, note: 'Unique surrogate identifier for a key personnel record at an external manager firm. Primary key for the manager_contact entity.']
  employee_id varchar [note: 'Internal employee ID of the pension fund staff member responsible for managing the relationship with this contact, used for accountability and coverage tracking.']
  gp_profile_id varchar [note: 'Reference to the external manager firm (GP, sub-advisor, or FoF manager) that this contact is associated with. Links to the manager master record.']
  manager_firm_gp_profile_id varchar [note: 'Reference to the external manager firm (GP, sub-advisor, or FoF manager) that this contact is associated with. Links to the manager master record.']
  contact_status varchar [note: 'Current lifecycle status of the contact record, reflecting whether the individual is actively employed at the manager firm and available for engagement.']
  coverage_asset_class varchar [note: 'Primary asset class covered by this contact within the external manager firm, aligning to the pension fund\'s asset allocation domains (e.g., private equity, infrastructure, credit).']
  coverage_strategy varchar [note: 'Specific investment strategy or sub-strategy the contact oversees or represents (e.g., buyout, growth equity, core infrastructure, senior secured credit, value-add real estate).']
  data_consent_date date [note: 'Date on which data processing consent was obtained from this contact, used to track consent validity and trigger renewal workflows per GDPR and applicable privacy law requirements.']
  data_consent_obtained boolean [note: 'Indicates whether explicit consent for processing personal data has been obtained from this contact in jurisdictions where GDPR or equivalent privacy regulations apply.']
  date_joined_firm date [note: 'Date the contact joined the external manager firm, used to calculate tenure and assess team stability as part of ongoing manager oversight and ODD.']
  departure_date date [note: 'Date the contact departed the external manager firm, populated when contact_status transitions to departed. Triggers key-person event review if is_key_person is true.']
  departure_reason varchar [note: 'Reason for the contact\'s departure from the external manager firm, used in key-person event analysis and manager stability risk assessment.']
  direct_phone varchar [note: 'Direct business telephone number for the contact, in E.164 international format, used for investment committee follow-ups and urgent mandate communications.']
  do_not_contact boolean [note: 'Indicates whether this contact has requested to be excluded from outreach, or has been flagged by compliance as restricted from contact due to regulatory or legal constraints.']
  educational_background varchar [note: 'Summary of the contact\'s highest academic qualification and institution (e.g., MBA Harvard Business School), used in qualitative manager team assessment during ODD.']
  email varchar [note: 'Primary business email address for the contact at the external manager firm, used for capital call notices, LP communications, and mandate correspondence.']
  first_name varchar [note: 'Legal given name of the key personnel contact at the external manager firm, as recorded in Preqin, PitchBook, or direct firm communication.']
  is_key_person boolean [note: 'Indicates whether this contact is designated as a key person under the terms of an LPA or mandate agreement, triggering key-person event monitoring and notification obligations.']
  is_primary_contact boolean [note: 'Indicates whether this individual is the designated primary point of contact for the pension fund\'s relationship with the external manager firm.']
  job_title varchar [note: 'Official job title of the contact at the external manager firm (e.g., Portfolio Manager, Chief Investment Officer, Investor Relations Director, Chief Compliance Officer).']
  key_person_mandate_ref varchar [note: 'Reference identifier of the LPA, SMA, or co-investment agreement in which this contact is named as a key person, enabling traceability to contractual key-person provisions.']
  kyc_verified boolean [note: 'Indicates whether KYC identity verification has been completed for this contact in accordance with AML/CTF obligations and FATF recommendations.']
  kyc_verified_date date [note: 'Date on which KYC verification was last completed for this contact, used to track compliance with AML/CTF refresh cycles and regulatory obligations.']
  last_interaction_date date [note: 'Date of the most recent recorded interaction between the pension fund\'s team and this contact (e.g., LP advisory call, annual meeting, IC presentation), used for relationship health monitoring.']
  last_interaction_type varchar [note: 'Type of the most recent recorded interaction with this contact, used to assess engagement quality and frequency as part of ongoing manager relationship management.']
  last_name varchar [note: 'Legal family name of the key personnel contact at the external manager firm, as recorded in Preqin, PitchBook, or direct firm communication.']
  linkedin_url varchar [note: 'LinkedIn profile URL for the contact, used for background verification, professional history review during ODD, and ongoing key-person monitoring.']
  mobile_phone varchar [note: 'Mobile phone number for the contact in E.164 international format, used for time-sensitive communications such as capital call notices or NAV queries.']
  nda_expiry_date date [note: 'Expiry date of the NDA in place with this contact. Null if the NDA is perpetual or if no NDA is in place. Used to trigger NDA renewal workflows.']
  nda_in_place boolean [note: 'Indicates whether a valid NDA is in place with this contact, required before sharing proprietary deal information, IM documents, or confidential portfolio data.']
  notes varchar [note: 'Free-text field for qualitative notes on the contact relationship, including meeting observations, personality insights, and engagement history relevant to manager oversight.']
  office_location_city varchar [note: 'City of the contact\'s primary office location at the external manager firm, used for time-zone management and in-person meeting logistics.']
  office_location_country varchar [note: 'ISO 3166-1 alpha-3 country code of the contact\'s primary office location, used for regulatory jurisdiction mapping and travel planning.']
  pep_status varchar [note: 'Politically Exposed Person classification for the contact per FATF Recommendation 12, required for enhanced due diligence and AML compliance screening.']
  preferred_contact_method varchar [note: 'The contact\'s preferred communication channel for routine LP-GP interactions, capital call notices, and investor relations correspondence.']
  preferred_language varchar [note: 'Preferred language for communications with this contact, expressed as an IETF BCP 47 language tag (e.g., en-CA, fr-FR), used for LP reporting and correspondence.']
  prior_employer varchar [note: 'Most recent prior employer of the contact before joining the current manager firm, used in background verification and key-person track record assessment during ODD.']
  professional_designation varchar [note: 'Primary professional credential or designation held by the contact (e.g., CFA, CPA, CAIA, FRM), used in qualitative assessment of manager team quality during DD.']
  record_created_timestamp timestamp [note: 'Timestamp when this manager contact record was first created in the data platform, used for audit trail and data lineage purposes per the national pension regulator data governance requirements.']
  record_updated_timestamp timestamp [note: 'Timestamp when this manager contact record was most recently modified in the data platform, used for change tracking, audit trail, and data freshness monitoring.']
  role_type varchar [note: 'Functional classification of the contact\'s role within the external manager firm, used to route communications and oversight activities. [ENUM-REF-CANDIDATE: investment|investor_relations|compliance|operations|legal|executive|risk|finance — promote to']
  sanctions_screened boolean [note: 'Indicates whether this contact has been screened against applicable sanctions lists (OFAC, UN, EU) as part of AML/CTF compliance obligations.']
  sanctions_screened_date date [note: 'Date on which the most recent sanctions screening was performed for this contact, used to ensure compliance with periodic AML/CTF refresh requirements.']
  source_system_contact_code varchar [note: 'The unique identifier assigned to this contact in the originating source system (Preqin, PitchBook, or DealCloud), used for data lineage tracing and cross-system reconciliation.']
  tenure_at_firm_years decimal(5,2) [note: 'Number of years the contact has been employed at the current external manager firm, a key metric in key-person risk assessment and manager stability evaluation.']
  time_zone varchar [note: 'IANA time zone identifier for the contact\'s primary office location (e.g., America/New_York, Europe/London), used for scheduling IC meetings and capital call deadlines.']
  years_of_experience varchar [note: 'Total years of professional investment experience for the contact, used in key-person risk assessment during ODD and ongoing manager oversight.']

  Note: 'Master record for key personnel at each external manager firm, including portfolio managers, investor relations contacts, compliance officers, and operations contacts.'
}

Table manager.fee_schedule {
  fee_schedule_id varchar [pk, note: 'Unique surrogate identifier for the fee schedule record within the pension fund\'s manager domain.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) subject to this fee schedule.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) subject to this fee schedule.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate (LPA, SMA, co-investment agreement) to which this fee schedule applies.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: Performance fee calculations require benchmark reference for hurdle rate comparisons.']
  approval_date date [note: 'Date on which the Investment Committee (IC) formally approved this fee schedule as part of the mandate approval process.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee (IC) member or authorized officer who approved this fee schedule, as recorded in Diligent/BoardEffect.']
  asset_class varchar [note: 'Asset class to which this fee schedule applies, aligning with the pension fund\'s Strategic Asset Allocation (SAA) taxonomy.']
  calculation_frequency varchar [note: 'Frequency at which management fees are calculated and accrued: monthly, quarterly, semi-annual, or annual. Drives fee accrual in SimCorp Dimension and Oracle Financials.']
  carried_interest_rate_pct decimal(8,4) [note: 'Percentage of profits allocated to the GP as carried interest (Carry), typically 20% for private equity mandates. Governed by the LPA waterfall provisions.']
  carry_split_lp_pct decimal(8,4) [note: 'LP\'s share of profits above the hurdle rate after the GP catch-up, expressed as a percentage. Typically 80% in a standard 80/20 carry split.']
  clawback_escrow_pct decimal(8,4) [note: 'Percentage of carried interest distributions held in escrow to fund potential clawback obligations. Null if no clawback escrow is required by the LPA.']
  clawback_provision boolean [note: 'Indicates whether the LPA includes a GP clawback provision requiring the GP to return excess carried interest distributions if the fund underperforms over its life.']
  created_timestamp timestamp [note: 'Timestamp when this fee schedule record was first created in the system, used for audit trail and data lineage in the Databricks Silver layer.']
  crystallization_frequency varchar [note: 'Frequency at which performance fees (carried interest or incentive fees) are crystallized and become payable: annual, quarterly, at realization, or at fund end.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which fees are denominated and settled (e.g., USD, EUR, GBP).']
  effective_date date [note: 'Date from which this fee schedule becomes contractually binding, as stipulated in the LPA or SMA agreement.']
  expiry_date date [note: 'Date on which this fee schedule ceases to be effective. Null for open-ended mandates. Triggers renegotiation workflow in eFront.']
  fee_base varchar [note: 'The denominator used to calculate management fees: Committed Capital, Invested Capital, Net Asset Value (NAV), Gross Asset Value (GAV), or Assets Under Management (AUM).']
  fee_rebate_eligible boolean [note: 'Indicates whether the pension fund is eligible for fee rebates based on commitment size, co-investment rights, or negotiated LP-specific terms in the side letter.']
  fee_rebate_rate_bps decimal(10,4) [note: 'Basis point reduction applied to the standard management fee rate as a rebate for large LP commitments or co-investment participation. Null if not eligible.']
  fee_reporting_standard varchar [note: 'Reporting standard under which fee disclosures are made: ILPA Fee Reporting Template, GIPS, SFDR Article 8/9, or custom bilateral agreement.']
  fee_schedule_status varchar [note: 'Current lifecycle state of the fee schedule record: active (in force), superseded (replaced by a newer version), terminated, draft, or pending IC approval.']
  gp_catchup_rate_pct decimal(8,4) [note: 'Rate at which the GP receives distributions during the catch-up phase after the LP preferred return hurdle is met, before the standard carry split applies.']
  high_water_mark_flag boolean [note: 'Indicates whether a high water mark provision applies, preventing the GP from collecting performance fees until prior losses are recovered.']
  hurdle_rate_pct decimal(8,4) [note: 'Preferred return threshold (Hurdle Rate) that must be achieved before the GP is entitled to carried interest. Expressed as an annual percentage (e.g., 8%).']
  hurdle_type varchar [note: 'Specifies whether the hurdle rate is a hard hurdle (carry only on returns above hurdle) or soft hurdle (catch-up provision applies once hurdle is met).']
  investment_period_fee_rate_bps decimal(10,4) [note: 'Management fee rate in basis points applicable during the fund\'s active investment period (typically years 1–5 for PE). May differ from the post-investment-period rate.']
  is_tiered boolean [note: 'Indicates whether the management fee schedule uses AUM-band tiers (True) or a flat rate (False). Tiered details are stored in the fee_schedule_tier product.']
  management_fee_offset_pct decimal(8,4) [note: 'Percentage of transaction fees, monitoring fees, or other GP income credited back to reduce the LP\'s management fee obligation, per ILPA best practice.']
  management_fee_rate_bps decimal(10,4) [note: 'Standard management fee rate expressed in basis points (bps) applied to the fee base. For tiered schedules, this is the first-tier rate.']
  mandate_type varchar [note: 'Type of investment mandate agreement governing this fee schedule: Limited Partnership Agreement (LPA), Separately Managed Account (SMA), co-investment, Fund of Funds (FoF), or sub-advisory.']
  monitoring_fee_annual_usd decimal(22,2) [note: 'Fixed annual monitoring fee in USD charged by the GP for portfolio company oversight services. Subject to management fee offset per LPA terms.']
  most_favored_nation_flag boolean [note: 'Indicates whether the pension fund has negotiated Most Favored Nation (MFN) rights, entitling it to the most favorable fee terms offered to any LP in the fund.']
  notes varchar [note: 'Free-text field for additional commentary on fee terms, negotiation context, or exceptions not captured in structured fields. Sourced from eFront or DealCloud.']
  organizational_expense_cap_pct decimal(8,4) [note: 'Maximum percentage of committed capital that the GP may charge to the fund for organizational and formation expenses, as negotiated in the LPA.']
  payment_frequency varchar [note: 'Frequency at which management fee invoices are settled and cash is transferred to the GP. May differ from calculation frequency (e.g., calculated monthly, paid quarterly).']
  payment_timing varchar [note: 'Specifies whether management fees are paid in advance (at the start of the period) or in arrears (at the end of the period), as defined in the LPA.']
  post_investment_period_fee_rate_bps decimal(10,4) [note: 'Reduced management fee rate in basis points applicable after the fund\'s investment period ends, typically based on invested (not committed) capital.']
  schedule_code varchar [note: 'Unique business identifier for the fee schedule, used in mandate documentation, fee invoices, and reconciliation with eFront and Oracle Financials.']
  schedule_name varchar [note: 'Descriptive name for the fee schedule (e.g., \'PE Fund III Management Fee Schedule\'), used for display and reporting purposes.']
  schedule_type varchar [note: 'Classification of the fee schedule by fee category. [ENUM-REF-CANDIDATE: management_fee|carried_interest|advisory_fee|performance_fee|transaction_fee|monitoring_fee|placement_fee|custody_fee — promote to reference product]']
  side_letter_reference varchar [note: 'Reference number or identifier of the side letter agreement that modifies standard LPA fee terms for this LP. Null if no side letter exists.']
  tier_1_upper_bound_usd decimal(22,2) [note: 'Upper AUM boundary in USD for the first management fee tier. Fees on committed/invested capital up to this amount are charged at the Tier 1 rate.']
  tier_2_fee_rate_bps decimal(10,4) [note: 'Management fee rate in basis points applicable to the AUM band above the Tier 1 upper bound. Null if the schedule is not tiered.']
  transaction_fee_rate_bps decimal(10,4) [note: 'Fee rate in basis points charged by the GP on deal transaction value (acquisition, disposition). Subject to management fee offset provisions per ILPA guidelines.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this fee schedule record, supporting change tracking and audit compliance per SOC 2 requirements.']
  version_number varchar [note: 'Sequential version number of the fee schedule, incremented each time terms are renegotiated or amended. Enables historical tracking of fee evolution over the mandate lifecycle.']
  vintage_year varchar [note: 'The year in which the fund\'s first capital call occurred, used to benchmark fee terms against peer funds of the same vintage year in Preqin and PitchBook.']
  waterfall_type varchar [note: 'Specifies the carry distribution waterfall structure: deal-by-deal (carry calculated per investment) or whole-fund (carry calculated across the entire portfolio).']

  Note: 'Defines the fee structure applicable to each mandate or manager relationship, including management fee tiers (basis points by AUM band), carried interest percentage, preferred return hurdle, fee calculation frequency, fee base (committed vs.'
}

Table manager.evaluation {
  evaluation_id varchar [pk, note: 'Unique surrogate identifier for each periodic external manager evaluation record within the manager domain.']
  composite_id varchar [note: 'Foreign key linking to performance.composite. Business justification: Manager evaluation process requires composite performance data to calculate conviction ratings and performance assessment scores.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: Annual manager evaluation process requires tracing back to original DD engagement that established the relationship.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Manager evaluations assess performance under specific economic scenarios (base/stress cases).']
  employee_id varchar [note: 'Senior investment professional or IC member who formally approved and signed off on this evaluation. Links to the internal employee record.']
  evaluation_employee_id varchar [note: 'Senior investment professional or IC member who formally approved and signed off on this evaluation. Links to the internal employee record.']
  evaluation_lead_analyst_employee_id varchar [note: 'Internal staff member responsible for authoring and coordinating this manager evaluation. Links to the internal employee/analyst record.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) being evaluated. Links to the manager master record.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) being evaluated. Links to the manager master record.']
  manager_mandate_id varchar [note: 'Reference to the specific mandate (LPA, SMA, or co-investment agreement) under which this manager evaluation is conducted.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: Manager evaluations compare reported performance against benchmarks. The evaluation has benchmark_irr_pct field indicating benchmark comparison is core to the evaluation']
  approval_timestamp timestamp [note: 'Date and time when the evaluation was formally approved by the designated approver, completing the governance workflow.']
  benchmark_irr_pct decimal(8,4) [note: 'The target or benchmark Internal Rate of Return (IRR) percentage against which the manager\'s performance is evaluated during this review period.']
  compliance_breach_details varchar [note: 'Narrative description of any compliance breaches, regulatory incidents, or mandate violations identified during the review period.']
  compliance_breach_flag boolean [note: 'Indicates whether the manager reported any regulatory, mandate, or investment guideline compliance breaches during the review period.']
  created_timestamp timestamp [note: 'System timestamp recording when this evaluation record was first created in the data platform, used for audit trail and data lineage.']
  data_source varchar [note: 'Primary data source(s) used to populate this evaluation, such as eFront fund monitoring data, Preqin/PitchBook benchmarks, manager-submitted reports, or on-site visit findings.']
  esg_integration_notes varchar [note: 'Qualitative narrative on the manager\'s ESG policies, stewardship activities, TCFD alignment, and PRI signatory status.']
  esg_integration_score decimal(5,2) [note: 'Numeric score assessing the depth and quality of Environmental, Social, and Governance (ESG) integration within the manager\'s investment process.']
  esg_maturity_level varchar [note: 'Categorical maturity tier for the manager\'s ESG integration, from nascent (minimal) to leading (best-in-class), used for portfolio-level ESG reporting.']
  evaluation_date date [note: 'The principal business date on which the evaluation assessment was formally conducted or the review period ended.']
  evaluation_status varchar [note: 'Current lifecycle state of the evaluation record from initial drafting through IC approval and final publication.']
  evaluation_type varchar [note: 'Classification of the evaluation cycle: annual review, interim review triggered by an event, onboarding assessment, termination review, or ad hoc. [ENUM-REF-CANDIDATE: annual_review|interim_review|onboarding|termination_review|ad_hoc — promote to']
  executive_summary varchar [note: 'High-level narrative summary of the evaluation findings, key strengths, concerns, and recommended actions, intended for IC and senior management review.']
  fee_compliance_flag boolean [note: 'Indicates whether the manager\'s fee charges (management fee, carried interest, and expenses) were compliant with the agreed LPA or mandate terms during the review period.']
  ic_decision_date date [note: 'Date on which the Investment Committee (IC) formally reviewed and resolved the recommended action arising from this evaluation.']
  ic_review_required_flag boolean [note: 'Indicates whether this evaluation outcome requires formal escalation to the Investment Committee (IC) for review and decision.']
  investment_process_notes varchar [note: 'Qualitative narrative describing the analyst\'s assessment of the manager\'s investment process, strategy differentiation, and edge.']
  investment_process_score decimal(5,2) [note: 'Numeric score assessing the quality, repeatability, and differentiation of the manager\'s investment process and philosophy.']
  key_person_departure_flag boolean [note: 'Indicates whether a key-person departure event occurred at the manager during the review period, triggering enhanced monitoring.']
  methodology varchar [note: 'The scoring framework or methodology version applied in this evaluation (e.g., internal scorecard version, qualitative-only, or hybrid approach).']
  next_evaluation_date date [note: 'Scheduled date for the next periodic evaluation of this manager, set based on conviction rating and watch-list status.']
  on_site_visit_conducted_flag boolean [note: 'Indicates whether an on-site operational due diligence (ODD) visit to the manager\'s offices was conducted as part of this evaluation cycle.']
  on_site_visit_date date [note: 'Date on which the on-site operational due diligence visit was conducted at the manager\'s premises during this evaluation cycle.']
  operational_infrastructure_notes varchar [note: 'Qualitative narrative on the manager\'s operational setup, technology stack, fund administration quality, and cybersecurity posture.']
  operational_infrastructure_score decimal(5,2) [note: 'Numeric score from Operational Due Diligence (ODD) assessing the manager\'s back-office, technology, compliance, and operational controls.']
  overall_conviction_rating varchar [note: 'Composite qualitative conviction rating summarising the investment team\'s overall confidence in the manager. Drives mandate continuation or termination decisions.']
  overall_score decimal(5,2) [note: 'Composite weighted numeric score (e.g., 0.00–100.00) aggregating all qualitative and quantitative sub-scores into a single manager evaluation rating.']
  performance_assessment_rating varchar [note: 'Qualitative rating of the manager\'s investment performance relative to benchmark and peers over the review period, based on TWR and IRR analysis.']
  prior_conviction_rating varchar [note: 'The overall conviction rating assigned in the immediately preceding evaluation cycle, enabling trend analysis and rating migration tracking.']
  rating_change_flag boolean [note: 'Indicates whether the overall conviction rating changed from the prior evaluation cycle, flagging upgrades or downgrades for IC attention.']
  recommended_action varchar [note: 'Formal recommendation arising from this evaluation for the Investment Committee (IC) regarding the mandate relationship. [ENUM-REF-CANDIDATE: continue|continue_with_conditions|increase_allocation|reduce_allocation|terminate|place_on_watch — promote to']
  reference varchar [note: 'Externally-visible unique reference code for this evaluation record, used in IC reporting and governance documentation (e.g., EVAL-2024-000123).']
  reported_irr_pct decimal(8,4) [note: 'The manager\'s reported net IRR percentage for the mandate or fund as of the review period end date, sourced from eFront or manager reporting.']
  reported_moic decimal(8,4) [note: 'The manager\'s reported Multiple on Invested Capital (MOIC) as of the review period end date, reflecting gross investment return multiple.']
  reported_tvpi decimal(8,4) [note: 'Total Value to Paid-In (TVPI) ratio reported by the manager as of the review period end date, combining DPI and RVPI.']
  reporting_quality_score decimal(5,2) [note: 'Numeric score assessing the accuracy, completeness, timeliness, and transparency of the manager\'s investor reporting and capital account statements.']
  review_period_end_date date [note: 'End date of the performance and qualitative assessment window covered by this evaluation.']
  review_period_start_date date [note: 'Start date of the performance and qualitative assessment window covered by this evaluation (e.g., beginning of the annual review period).']
  risk_management_notes varchar [note: 'Qualitative narrative on the manager\'s risk governance, portfolio risk controls, and alignment with the pension fund\'s risk appetite.']
  risk_management_score decimal(5,2) [note: 'Numeric score evaluating the robustness of the manager\'s risk management framework, including VaR, drawdown controls, and stress testing practices.']
  sla_compliance_rating varchar [note: 'Assessment of the manager\'s adherence to Service Level Agreement (SLA) obligations including reporting timeliness, data quality, and operational deliverables.']
  team_stability_notes varchar [note: 'Qualitative narrative on key-person risk, team tenure, succession planning, and any notable personnel changes since the last evaluation.']
  team_stability_score decimal(5,2) [note: 'Numeric score reflecting the stability, depth, and continuity of the manager\'s investment team, including key-person risk assessment.']
  updated_timestamp timestamp [note: 'System timestamp recording the most recent modification to this evaluation record, supporting audit trail and change tracking requirements.']
  watch_list_flag boolean [note: 'Indicates whether the manager has been placed on the internal watch list as a result of this evaluation, triggering enhanced monitoring and reporting.']

  Note: 'Records periodic qualitative and quantitative evaluations of each external manager, covering investment process assessment, team stability, operational infrastructure, risk management quality, ESG integration maturity, and overall conviction rating.'
}

Table manager.risk_assessment {
  risk_assessment_id varchar [pk, note: 'Unique surrogate identifier for each external manager risk assessment record in the silver layer lakehouse.']
  approver_employee_id varchar [note: 'Reference to the IC member or delegated authority who formally approved this risk assessment. Links to the staff/user master.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Manager risk assessments must be conducted under defined economic scenarios for regulatory stress testing (e.g., IORP II, local pension regulations).']
  employee_id varchar [note: 'Reference to the internal investment professional responsible for conducting and authoring this risk assessment. Links to the staff/user master.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) being assessed. Links to the manager master record.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) being assessed. Links to the manager master record.']
  manager_mandate_id varchar [note: 'Reference to the specific mandate (LPA, SMA, or co-investment agreement) under which this risk assessment is conducted, if applicable.']
  risk_model_id varchar [note: 'Foreign key linking to risk.model. Business justification: Operational Due Diligence (ODD) assessments must document which risk model framework was applied. Pension fund compliance requires traceability of methodology used in manager risk scoring.']
  adverse_media_flag boolean [note: 'Indicates whether adverse media screening identified material negative news about the manager, its principals, or affiliated entities during the assessment period.']
  approved_timestamp timestamp [note: 'Date and time when the risk assessment was formally approved by the Investment Committee or delegated authority, marking the record as authoritative.']
  assessment_date date [note: 'The principal business date on which the risk assessment was formally conducted or the assessment period end date used for scoring and conclusions.']
  assessment_methodology_version varchar [note: 'Version identifier of the internal risk assessment scoring methodology applied (e.g., v2.1), enabling comparability across assessments and audit of methodology changes.']
  assessment_notes varchar [note: 'Free-text narrative field capturing qualitative analyst commentary, contextual observations, and IC discussion points not captured in structured scoring fields.']
  assessment_reference varchar [note: 'Externally-visible unique reference code for this risk assessment, used in IC submissions, ODD reports, and regulatory correspondence. Format: RA-YYYY-NNNNNN.']
  assessment_status varchar [note: 'Current lifecycle state of the risk assessment document: draft, in_review, pending_ic_approval, approved, rejected, or superseded by a newer assessment.']
  assessment_type varchar [note: 'Classification of the assessment trigger: initial (new manager onboarding), periodic (scheduled review), event_driven (triggered by material event), pre_commitment, post_investment, or termination.']
  aum_at_assessment decimal(20,2) [note: 'Total AUM of the external manager at the time of this risk assessment, used to assess scale, stability, and viability risk. Expressed in the reporting currency.']
  aum_currency varchar [note: 'ISO 4217 three-letter currency code in which the manager\'s AUM at assessment is denominated (e.g., USD, GBP).']
  business_continuity_rating varchar [note: 'Assessment of the manager\'s business continuity and disaster recovery capabilities, including documented BCP, testing frequency, and technology resilience.']
  concentration_risk_rating varchar [note: 'Categorical rating for concentration risk, reflecting the fund\'s exposure to single issuers, sectors, geographies, or counterparties relative to mandate limits.']
  concentration_risk_score decimal(5,2) [note: 'Quantitative score measuring the degree of portfolio or counterparty concentration risk attributable to this manager, including single-name, sector, and geographic concentration.']
  counterparty_risk_rating varchar [note: 'Categorical rating for counterparty risk, covering prime broker credit quality, CSA terms, CCP usage, and collateral management practices of the external manager.']
  counterparty_risk_score decimal(5,2) [note: 'Quantitative score assessing the credit and settlement risk arising from the manager\'s prime brokerage, custodian, OTC derivative, and other counterparty relationships.']
  created_timestamp timestamp [note: 'Timestamp when this risk assessment record was first created in the system, used for audit trail and data lineage tracking.']
  critical_findings_count varchar [note: 'Number of critical-severity findings identified in this assessment requiring immediate remediation or escalation to the Investment Committee.']
  cybersecurity_rating varchar [note: 'Assessment of the manager\'s cybersecurity posture, including data protection controls, incident response capability, and third-party security certifications (ISO 27001, SOC 2).']
  enforcement_action_exists boolean [note: 'Indicates whether the manager or its principals have been subject to any regulatory enforcement actions, sanctions, or material investigations within the lookback period.']
  esg_risk_rating varchar [note: 'Categorical ESG risk rating for the manager based on MSCI ESG scores, PRI assessment, TCFD alignment, and internal responsible investment due diligence findings.']
  esg_risk_score decimal(5,2) [note: 'Quantitative ESG risk score for the manager, reflecting the quality of ESG integration in their investment process, SFDR classification, and PRI signatory status.']
  keyman_clause_exists boolean [note: 'Indicates whether the governing LPA or mandate agreement contains a key-man clause that triggers suspension of capital calls or investor rights upon departure of named individuals.']
  keyman_risk_rating varchar [note: 'Categorical rating for key-man risk. Elevated when the manager\'s investment process is highly dependent on a single portfolio manager or founding partner.']
  keyman_risk_score decimal(5,2) [note: 'Quantitative score assessing the degree of dependency on one or more key investment professionals at the manager firm, and the adequacy of succession planning.']
  liquidity_risk_rating varchar [note: 'Categorical rating for liquidity risk, reflecting the manager\'s redemption terms, lock-up provisions, side pocket usage, and alignment with the pension fund\'s liquidity needs.']
  liquidity_risk_score decimal(5,2) [note: 'Quantitative score assessing the liquidity risk of the manager\'s strategy, including redemption terms, lock-up periods, gate provisions, and underlying asset liquidity profile.']
  next_review_date date [note: 'Date by which the next periodic risk assessment of this manager must be completed, driven by risk rating and mandate review cycle policy.']
  odd_findings_summary varchar [note: 'Narrative summary of key findings from the Operational Due Diligence (ODD) review, including material control weaknesses, remediation actions, and outstanding items.']
  open_findings_count varchar [note: 'Number of unresolved risk findings or remediation action items outstanding from this assessment, used to track manager remediation progress and escalation triggers.']
  operational_risk_rating varchar [note: 'Categorical rating for operational risk derived from ODD findings. Covers technology infrastructure, middle/back-office controls, disaster recovery, and process robustness.']
  operational_risk_score decimal(5,2) [note: 'Quantitative score reflecting the manager\'s operational risk exposure based on ODD findings, including technology, process, controls, and business continuity assessments.']
  overall_risk_rating varchar [note: 'Composite risk rating assigned to the external manager based on aggregated scores across all risk dimensions. Drives review frequency and mandate oversight intensity.']
  overall_risk_score decimal(5,2) [note: 'Quantitative composite risk score (e.g., 0.00–100.00) aggregating all risk dimension scores using the internal risk scoring methodology for this manager.']
  pension_fund_aum_pct decimal(7,4) [note: 'The pension fund\'s total committed capital to this manager expressed as a percentage of the manager\'s total AUM, used to assess investor concentration and influence risk.']
  recommended_action varchar [note: 'Formal recommendation arising from this risk assessment regarding the ongoing mandate relationship. Drives IC agenda items and mandate management actions.']
  regulatory_risk_rating varchar [note: 'Categorical rating for regulatory risk, including the manager\'s regulatory status, history of enforcement actions, and compliance with KYC/AML and reporting obligations.']
  regulatory_risk_score decimal(5,2) [note: 'Quantitative score reflecting the manager\'s exposure to regulatory sanctions, licensing issues, enforcement actions, or non-compliance with applicable regulations.']
  regulatory_status varchar [note: 'Current regulatory registration status of the external manager with applicable regulators (SEC, FCA, ESMA, etc.) at the time of assessment.']
  reputational_risk_rating varchar [note: 'Categorical rating for reputational risk, covering adverse media coverage, ESG controversies, sanctions screening results, and alignment with PRI commitments.']
  reputational_risk_score decimal(5,2) [note: 'Quantitative score assessing reputational risk associated with the manager, including adverse media, ESG controversies, litigation, and alignment with the pension fund\'s values.']
  sanctions_screening_status varchar [note: 'Result of sanctions and watchlist screening for the manager and its principals against OFAC, UN, EU, and other applicable sanctions lists as part of KYC/AML due diligence.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this risk assessment record, supporting audit trail and change management requirements.']
  watch_list_flag boolean [note: 'Indicates whether the manager has been placed on the internal watch list as a result of this assessment, triggering enhanced monitoring and potential mandate review.']

  Note: 'Captures structured risk assessments of each external manager covering operational risk (ODD findings), key-man risk, concentration risk, counterparty risk, regulatory risk, and reputational risk.'
}

Table manager.sla_agreement {
  sla_agreement_id varchar [pk, note: 'Unique surrogate identifier for each SLA agreement record between the pension fund and an external manager or fund administrator.']
  employee_id varchar [note: 'Reference to the internal pension fund employee (typically a Portfolio Manager or Manager Relations Officer) who owns and is accountable for monitoring this SLA agreement.']
  gp_profile_id varchar [note: 'Reference to the external fund manager, General Partner (GP), sub-advisor, or fund administrator party that is counterparty to this SLA agreement.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager, General Partner (GP), sub-advisor, or fund administrator party that is counterparty to this SLA agreement.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate (LPA, SMA, co-investment agreement) under which this SLA agreement operates, linking SLA obligations to the governing contractual mandate.']
  agreement_name varchar [note: 'Human-readable descriptive name of the SLA agreement, typically referencing the manager name and scope (e.g., \'Blackstone PE Fund IV — NAV Reporting SLA\').']
  agreement_type varchar [note: 'Classification of the SLA agreement by functional scope. [ENUM-REF-CANDIDATE: reporting_sla|operational_sla|custody_sla|valuation_sla|compliance_sla|administrator_sla — promote to reference product]']
  agreement_version varchar [note: 'Version identifier of the SLA agreement document, incremented upon each formal amendment or renegotiation (e.g., v1.0, v2.1).']
  asset_class_scope varchar [note: 'Asset class or classes covered by this SLA agreement, defining the investment domain to which the service-level obligations apply. [ENUM-REF-CANDIDATE: promote to reference product if multi-value needed]']
  audited_financials_delivery_days varchar [note: 'Maximum number of calendar days after fiscal year-end by which the manager must deliver audited financial statements to the pension fund under this SLA.']
  auto_renewal_flag boolean [note: 'Indicates whether the SLA agreement automatically renews upon expiry unless either party provides written notice of termination within the notice period.']
  breach_notification_hours varchar [note: 'Maximum number of hours within which the manager must notify the pension fund of an SLA breach or material reporting failure, as stipulated in the agreement.']
  capital_account_delivery_days varchar [note: 'Maximum number of business days after period end by which the manager must deliver capital account statements showing Paid-In Capital (PIC), distributions, and RVPI.']
  capital_call_notice_days varchar [note: 'Minimum number of business days advance notice the GP must provide to the pension fund before issuing a capital call (drawdown notice), as stipulated in the SLA and LPA.']
  compliance_cert_delivery_days varchar [note: 'Maximum number of business days after period end by which the manager must deliver compliance certificates confirming adherence to investment guidelines and regulatory requirements.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier (LEI) of the external manager or fund administrator that is counterparty to this SLA, used for regulatory reporting and entity disambiguation.']
  counterparty_name varchar [note: 'Full legal name of the external manager, GP, sub-advisor, or fund administrator that is the counterparty to this SLA agreement, as registered with the relevant regulatory authority.']
  created_timestamp timestamp [note: 'Timestamp when this SLA agreement record was first created in the data platform, providing the audit trail creation marker per data governance policy.']
  custodian_involved boolean [note: 'Indicates whether a third-party custodian (e.g., State Street, Northern Trust) is a party to or referenced in the SLA obligations, particularly for settlement and NAV reporting.']
  data_delivery_channel varchar [note: 'Transmission channel through which the manager delivers reports and data to the pension fund under this SLA (e.g., SFTP, API, custodian platform portal). [ENUM-REF-CANDIDATE: sftp|api|email|portal|swift|custodian_platform|other — 7 candidates stripped']
  data_delivery_format varchar [note: 'Contractually agreed file or transmission format in which the manager must deliver reports and data under this SLA (e.g., SWIFT, SFTP, API feed, Excel). [ENUM-REF-CANDIDATE: promote to reference product]']
  distribution_notice_days varchar [note: 'Minimum number of business days advance notice the GP must provide before making a distribution to the pension fund, enabling treasury and cash management planning.']
  effective_date date [note: 'Date on which the SLA agreement becomes binding and service-level obligations commence between the pension fund and the counterparty.']
  esg_report_delivery_days varchar [note: 'Maximum number of business days after period end by which the manager must deliver ESG and responsible investment reports, including GHG emissions data and TCFD disclosures.']
  esg_reporting_required boolean [note: 'Indicates whether the SLA mandates periodic ESG reporting from the manager, including PRI alignment, TCFD disclosures, and GHG emissions data.']
  expiry_date date [note: 'Date on which the SLA agreement is scheduled to expire or terminate. Null for open-ended agreements. Triggers renewal workflow when approaching.']
  fund_admin_involved boolean [note: 'Indicates whether a separate fund administrator (distinct from the GP) is a party to the SLA obligations for NAV calculation, capital account statements, and investor reporting.']
  gips_compliant_reporting boolean [note: 'Indicates whether the manager is contractually required to deliver performance reports in compliance with CFA Institute GIPS standards under this SLA.']
  governing_law_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern the SLA agreement (e.g., CAN, GBR, USA).']
  independent_valuation_required boolean [note: 'Indicates whether the SLA mandates an independent third-party valuation agent for illiquid or private asset valuations, as required for NAV/GAV determination.']
  last_review_date date [note: 'Date on which the most recent formal SLA performance review was completed between the pension fund and the manager.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this SLA agreement record in the data platform, supporting audit trail and change tracking requirements.']
  nav_delivery_deadline_days varchar [note: 'Maximum number of business days after the reference period end date by which the manager must deliver the NAV statement, as stipulated in the SLA.']
  nav_delivery_frequency varchar [note: 'Contractually agreed frequency at which the manager or administrator must deliver NAV statements to the pension fund under this SLA.']
  next_review_date date [note: 'Scheduled date of the next formal SLA performance review between the pension fund and the manager, used to trigger review workflow in the manager oversight process.']
  notes varchar [note: 'Free-text field for capturing material qualifications, special conditions, side-letter provisions, or operational notes relevant to this SLA agreement that are not captured in structured fields.']
  penalty_basis_points decimal(10,4) [note: 'Fee rebate or penalty rate expressed in basis points (bps) applied to management fees upon confirmed SLA breach, as defined in the agreement.']
  penalty_clause_applicable boolean [note: 'Indicates whether financial penalty or fee rebate clauses are contractually applicable upon SLA breach by the manager or fund administrator.']
  performance_report_delivery_days varchar [note: 'Maximum number of business days after period end by which the manager must deliver performance attribution reports including TWR, MWR, IRR, MOIC, TVPI, DPI, and RVPI metrics.']
  primary_contact_email varchar [note: 'Email address of the primary relationship contact at the external manager responsible for SLA reporting delivery and breach notifications.']
  primary_contact_name varchar [note: 'Full name of the primary relationship contact at the external manager or fund administrator responsible for SLA compliance and reporting delivery.']
  renewal_notice_days varchar [note: 'Number of calendar days prior to expiry by which either party must provide written notice to prevent automatic renewal or to initiate renegotiation of the SLA.']
  reporting_currency varchar [note: 'ISO 4217 three-letter currency code in which all financial reports and NAV statements under this SLA must be delivered (e.g., USD, GBP).']
  review_frequency varchar [note: 'Agreed frequency at which the pension fund and manager formally review SLA performance, compliance metrics, and potential amendments.']
  sla_agreement_status varchar [note: 'Current lifecycle state of the SLA agreement, governing whether obligations are enforceable and being monitored.']
  sla_reference_number varchar [note: 'Externally-known alphanumeric reference code assigned to this SLA agreement, used in correspondence with the manager and in regulatory reporting.']
  source_system_reference_code varchar [note: 'Native identifier of this SLA agreement record in the originating operational system (e.g., eFront deal ID, DealCloud contract ID), enabling cross-system reconciliation.']
  termination_date date [note: 'Actual date on which the SLA agreement was terminated, if applicable. Null for active agreements. Distinct from expiry_date which is the scheduled end.']
  termination_reason varchar [note: 'Reason code for the termination of the SLA agreement, used for manager oversight analytics and regulatory audit trail. [ENUM-REF-CANDIDATE: promote to reference product if extended]']
  valuation_methodology varchar [note: 'Contractually agreed valuation methodology the manager must apply when determining NAV and asset values reported under this SLA. [ENUM-REF-CANDIDATE: promote to reference product if extended]']

  Note: 'SSOT for all service-level commitments and individual reporting obligations between the pension fund and each external manager or fund administrator. Covers reporting delivery timelines and line-item obligations (NAV, capital account statements, audited'
}

Table manager.sla_breach {
  sla_breach_id varchar [pk, note: 'Unique surrogate identifier for each SLA breach event record within the manager domain.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) whose SLA obligation was breached.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) whose SLA obligation was breached.']
  manager_mandate_id varchar [note: 'Reference to the specific mandate (LPA, SMA, or co-investment agreement) under which the SLA obligation was defined and breached.']
  sla_agreement_id varchar [note: 'Reference to the specific SLA obligation definition that was breached, as catalogued in the SLA obligation register.']
  sla_obligation_id varchar [note: 'Reference to the specific SLA obligation definition that was breached, as catalogued in the SLA obligation register.']
  affected_asset_class varchar [note: 'The asset class of the mandate affected by the breach, enabling portfolio-level SLA compliance analysis across the fund\'s diversified allocation. [ENUM-REF-CANDIDATE']
  breach_category varchar [note: 'Functional category of the SLA obligation that was breached. [ENUM-REF-CANDIDATE: reporting|valuation|capital_call|distribution|compliance|operational|esg|risk_disclosure — promote to reference product]']
  breach_date date [note: 'The actual date on which the SLA obligation was breached (i.e., the obligation due date passed without fulfilment). Principal business event date for this record.']
  breach_description varchar [note: 'Detailed narrative describing the nature of the breach event, what was not delivered, and the circumstances surrounding the failure.']
  breach_detected_date date [note: 'The calendar date on which the SLA breach was first identified or detected by the internal oversight team or monitoring system.']
  breach_detected_timestamp timestamp [note: 'Precise timestamp at which the SLA breach was first detected, used for SLA measurement calculations and audit trail purposes.']
  breach_reference_number varchar [note: 'Externally-visible unique reference number assigned to this breach event, used in manager correspondence, escalation notices, and regulatory reporting.']
  breach_status varchar [note: 'Current lifecycle status of the breach event, tracking progression from initial detection through resolution or waiver. [ENUM-REF-CANDIDATE: open|under_review|remediation_in_progress|resolved|waived|escalated — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp at which this SLA breach record was first created in the data platform, providing the audit trail creation marker.']
  days_overdue varchar [note: 'Number of calendar days elapsed between the SLA obligation due date and the breach detection date, quantifying the extent of the delay at point of detection.']
  days_to_resolution varchar [note: 'Number of calendar days elapsed between the breach detection date and the resolution date. Null if unresolved. Used for manager performance benchmarking.']
  detection_source varchar [note: 'The mechanism or source through which the SLA breach was identified, distinguishing automated system alerts from manual reviews or manager self-reporting.']
  escalation_date date [note: 'Date on which the breach was formally escalated to the current escalation level. Null if no escalation has occurred.']
  escalation_level varchar [note: 'Current escalation tier to which this breach has been raised within the internal governance hierarchy, from relationship manager through to Investment Committee (IC).']
  esg_related boolean [note: 'Indicates whether the breached SLA obligation relates to Environmental, Social, and Governance (ESG) reporting or stewardship commitments under the mandate.']
  financial_impact_amount decimal(18,2) [note: 'Estimated or actual financial impact of the breach on the fund, including any NAV misstatement, delayed distributions, or operational losses.']
  financial_impact_currency varchar [note: 'ISO 4217 three-letter currency code for the financial impact amount.']
  impact_assessment varchar [note: 'Narrative assessment of the actual or potential impact of the breach on fund operations, NAV accuracy, beneficiary interests, or regulatory compliance.']
  internal_owner varchar [note: 'Name or identifier of the internal relationship manager or oversight officer responsible for managing and resolving this breach event.']
  is_contractual_penalty_triggered boolean [note: 'Indicates whether the breach has triggered a contractual penalty, fee reduction, or other financial remedy as defined in the LPA or SMA.']
  is_regulatory_reportable boolean [note: 'Indicates whether this breach must be disclosed to a regulatory body (e.g., FCA, SEC) under applicable reporting obligations.']
  is_repeat_breach boolean [note: 'Indicates whether this breach is a recurrence of a previously recorded breach of the same SLA obligation by the same manager, flagging systemic non-compliance.']
  manager_response varchar [note: 'Verbatim or summarised formal response provided by the external manager acknowledging the breach and explaining their position or corrective intent.']
  manager_response_date date [note: 'Date on which the external manager formally responded to the breach notification. Used to measure manager responsiveness against SLA response time commitments.']
  mandate_type varchar [note: 'Type of mandate agreement under which the breached SLA obligation was defined, distinguishing LPA, SMA, co-investment, and Fund of Funds (FoF) structures.']
  obligation_description varchar [note: 'Narrative description of the specific SLA obligation that was breached, including the contractual clause reference and expected deliverable.']
  penalty_amount decimal(18,2) [note: 'Monetary value of the contractual penalty or fee reduction applied as a result of this breach, denominated in the mandate currency. Null if no penalty triggered.']
  penalty_currency varchar [note: 'ISO 4217 three-letter currency code for the penalty amount. Aligns with the mandate base currency.']
  prior_breach_count varchar [note: 'Number of prior breach events recorded for the same SLA obligation and manager within the current mandate term, used for escalation threshold monitoring.']
  regulatory_body varchar [note: 'The regulatory authority to which this breach must be reported, if applicable. Populated only when is_regulatory_reportable is true.']
  regulatory_report_date date [note: 'Date on which the breach was formally reported to the relevant regulatory authority. Null if not yet reported or not required.']
  remediation_plan varchar [note: 'Description of the corrective action plan agreed with the manager to address the breach, prevent recurrence, and restore SLA compliance.']
  remediation_target_date date [note: 'Agreed target date by which the manager is expected to complete the remediation plan and restore full SLA compliance.']
  resolution_date date [note: 'The date on which the breach was formally resolved, remediated, or waived. Null if the breach remains open or in progress.']
  root_cause_category varchar [note: 'Categorical classification of the root cause of the breach. [ENUM-REF-CANDIDATE: system_failure|process_failure|data_error|staffing|third_party|regulatory_change|force_majeure|unknown — promote to reference product]']
  root_cause_description varchar [note: 'Detailed narrative of the root cause analysis conducted by the manager or internal oversight team explaining why the SLA obligation was not met.']
  severity_classification varchar [note: 'Categorical severity rating assigned to the breach based on its impact on fund operations, regulatory obligations, or beneficiary interests.']
  sla_obligation_date date [note: 'The contractually agreed date by which the manager was required to fulfil the SLA obligation that was subsequently breached.']
  updated_timestamp timestamp [note: 'Timestamp at which this SLA breach record was most recently modified, supporting audit trail and change tracking requirements.']
  waiver_approved_date date [note: 'Date on which the waiver of the breach was formally approved by the authorised internal governance body. Null if no waiver granted.']
  waiver_justification varchar [note: 'Narrative justification for waiving the breach without penalty or escalation, including approver details. Populated only when breach_status is waived.']

  Note: 'Transactional record of each SLA breach event by an external manager, capturing breach date, SLA obligation breached, severity classification, root cause, manager response, remediation plan, and resolution date.'
}

Table manager.watchlist {
  watchlist_id varchar [pk, note: 'Unique surrogate identifier for a manager watchlist record. Primary key for this entity.']
  gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) placed on the watchlist. Links to the manager master record.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager or General Partner (GP) placed on the watchlist. Links to the manager master record.']
  manager_mandate_id varchar [note: 'Reference to the specific mandate (LPA, SMA, co-investment agreement) associated with this watchlist entry, if applicable.']
  approving_officer varchar [note: 'Name or employee identifier of the senior officer (e.g., CIO, Head of External Managers) who formally approved the watchlist placement decision.']
  asset_class varchar [note: 'The primary asset class of the manager\'s mandate under watchlist review. Enables asset-class-level watchlist analytics and risk aggregation.']
  aum_at_placement decimal(20,2) [note: 'The pension fund\'s total committed or invested capital with this manager (AUM) at the time of watchlist placement, in base currency. Used to assess financial exposure.']
  aum_currency varchar [note: 'ISO 4217 three-letter currency code for the AUM at placement amount (e.g., USD, GBP).']
  consecutive_underperformance_quarters varchar [note: 'Number of consecutive calendar quarters in which the manager has underperformed their agreed benchmark or hurdle rate, as recorded at the time of watchlist placement.']
  created_timestamp timestamp [note: 'The timestamp when this watchlist record was first created in the system, used for audit trail and data lineage purposes.']
  engagement_log_summary varchar [note: 'Summary of formal engagement activities with the manager since watchlist placement, including calls, meetings, and written correspondence. Full log maintained in DealCloud.']
  esg_concern_category varchar [note: 'Classifies the ESG dimension driving the concern: environmental (E), social (S), governance (G), or a combination. Populated when esg_concern_flag is true.']
  esg_concern_flag boolean [note: 'Indicates whether ESG-related concerns (e.g., governance failures, environmental violations, social controversies) contributed to the watchlist placement.']
  ic_approval_required boolean [note: 'Indicates whether formal Investment Committee (IC) approval is required to resolve or close this watchlist entry, based on AUM exposure or severity level.']
  ic_decision varchar [note: 'The formal decision recorded by the Investment Committee (IC) following review of the watchlist entry. Drives downstream mandate management actions.']
  ic_review_date date [note: 'The date on which the Investment Committee (IC) formally reviewed this watchlist entry and issued a decision or deferred for further monitoring.']
  key_man_clause_triggered boolean [note: 'Indicates whether the formal key-man clause in the Limited Partnership Agreement (LPA) or mandate has been contractually triggered, potentially suspending capital calls or enabling early redemption.']
  key_man_departure_flag boolean [note: 'Indicates whether the watchlist placement was triggered by the departure or announced departure of a key investment professional covered under a key-man clause in the LPA or mandate agreement.']
  last_review_date date [note: 'The date of the most recent formal review of this watchlist entry, used to track review cadence compliance and identify overdue reviews.']
  last_updated_timestamp timestamp [note: 'The timestamp of the most recent update to this watchlist record, supporting audit trail, change tracking, and incremental data pipeline processing.']
  lead_analyst varchar [note: 'Name or employee identifier of the internal investment analyst or portfolio manager responsible for monitoring and reporting on this watchlist entry.']
  manager_response_date date [note: 'The date on which the external manager formally responded to the watchlist notification. Populated when manager_response_received is true.']
  manager_response_received boolean [note: 'Indicates whether the external manager has formally responded to the watchlist notification and provided a remediation plan or explanation.']
  manager_strategy varchar [note: 'The specific investment strategy employed by the manager under the mandate (e.g., buyout, venture capital, core real estate, direct lending, long/short equity, infrastructure core-plus).']
  new_capital_deployment_suspended boolean [note: 'Indicates whether new capital commitments or capital calls to this manager have been suspended as a result of the watchlist placement, pending resolution.']
  next_review_date date [note: 'The date of the next scheduled formal review of this watchlist entry by the internal manager oversight or risk team.']
  odd_finding_flag boolean [note: 'Indicates whether a material finding from an Operational Due Diligence (ODD) review contributed to the watchlist placement, such as control failures, valuation concerns, or compliance gaps.']
  odd_finding_summary varchar [note: 'Concise summary of the material ODD findings that contributed to watchlist placement. Classified confidential due to sensitive operational assessment content.']
  performance_concern_flag boolean [note: 'Indicates whether underperformance relative to benchmark or hurdle rate is a contributing factor to the watchlist placement. Enables performance-driven watchlist analytics.']
  placement_date date [note: 'The formal date on which the manager was officially placed on the internal watchlist following Investment Committee or risk team approval.']
  portfolio_exposure_pct decimal(7,4) [note: 'The pension fund\'s exposure to this manager as a percentage of total fund AUM at the time of watchlist placement. Used for concentration risk assessment.']
  redemption_notice_date date [note: 'The date on which the formal redemption or withdrawal notice was issued to the manager. Populated when redemption_notice_issued is true.']
  redemption_notice_issued boolean [note: 'Indicates whether a formal redemption or withdrawal notice has been issued to the manager as a result of the watchlist review process.']
  reference_code varchar [note: 'Externally-known unique alphanumeric code assigned to this watchlist entry for cross-system referencing and audit trail purposes (e.g., WL-2024-000123).']
  regulatory_body varchar [note: 'Name of the regulatory authority conducting the investigation or enforcement action against the manager (e.g., SEC, FCA, ESMA). Populated when regulatory_investigation_flag is true.']
  regulatory_investigation_flag boolean [note: 'Indicates whether the manager is subject to an active regulatory investigation by a governing body (e.g., SEC, FCA) that contributed to watchlist placement.']
  remediation_plan_agreed boolean [note: 'Indicates whether a formal remediation plan has been agreed between the pension fund and the external manager to address the watchlist concerns.']
  remediation_plan_deadline date [note: 'The agreed deadline by which the manager must demonstrate completion of remediation actions. Populated when remediation_plan_agreed is true.']
  resolution_date date [note: 'The actual date on which the watchlist entry was formally resolved or closed, either through remediation, redemption, or termination of the mandate.']
  resolution_outcome varchar [note: 'The formal outcome decision upon closure of the watchlist entry. Indicates whether the manager relationship was retained, redeemed, or terminated following review.']
  review_frequency varchar [note: 'The required frequency of formal internal review for this watchlist entry, determined by severity level and asset class. Drives the monitoring calendar.']
  severity_level varchar [note: 'Internal risk severity rating assigned to the watchlist entry, reflecting the urgency and potential impact on the pension fund portfolio. Drives escalation and review frequency.']
  strategic_misalignment_flag boolean [note: 'Indicates whether the watchlist placement is driven by a strategic misalignment between the manager\'s investment approach and the pension fund\'s evolving Strategic Asset Allocation (SAA) or mandate objectives.']
  target_resolution_date date [note: 'The target date by which the watchlist concerns are expected to be resolved or a formal decision (retain, redeem, terminate) is required from the Investment Committee.']
  trigger_date date [note: 'The date on which the triggering event or finding occurred that led to watchlist placement. Distinct from the formal placement date.']
  trigger_reason varchar [note: 'Detailed narrative description of the specific event or finding that triggered placement of the manager on the watchlist (e.g., lead PM departure, SEC investigation opened, consecutive quarters of underperformance).']
  watchlist_category varchar [note: 'Primary classification of the reason for watchlist placement. [ENUM-REF-CANDIDATE: performance|key_man|regulatory|odd_finding|strategic_misalignment|esg_concern|fee_dispute|legal — promote to reference product]']
  watchlist_status varchar [note: 'Current lifecycle status of the watchlist entry. Active indicates ongoing monitoring; resolved indicates concerns addressed; closed indicates formal removal from watchlist.']

  Note: 'Tracks external managers placed on formal internal watch-list status due to performance concerns, key-man departures, regulatory investigations, ODD findings, or strategic misalignment.'
}

Table manager.meeting {
  meeting_id varchar [pk, note: 'Unique surrogate identifier for each formal manager interaction record within the external manager oversight domain.']
  deal_opportunity_id varchar [note: 'Reference to the deal pipeline record if this meeting is linked to an active origination or due diligence process.']
  employee_id varchar [note: 'Reference to the internal investment professional (portfolio manager, analyst, or relationship manager) who led or organised this meeting on behalf of the pension fund.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) who is the primary subject of this meeting.']
  ic_governance_record_id varchar [note: 'Foreign key linking to compliance.ic_governance_record. Business justification: IC meetings discussing managers (evaluations, mandate approvals) must link to formal IC governance records.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (GP, sub-advisor, or FoF manager) who is the primary subject of this meeting.']
  manager_mandate_id varchar [note: 'Reference to the specific investment mandate (LPA, SMA, or co-investment agreement) that this meeting is associated with, if applicable.']
  opportunity_id varchar [note: 'Reference to the deal pipeline record if this meeting is linked to an active origination or due diligence process.']
  action_items_count varchar [note: 'Total number of formal action items or follow-up tasks recorded as outcomes of this meeting. Supports SLA and accountability tracking.']
  actual_date date [note: 'The calendar date on which the meeting actually took place. May differ from scheduled_date if rescheduled.']
  agenda_summary varchar [note: 'Structured summary of the agenda items discussed, including key topics such as performance attribution, risk review, ESG updates, and operational matters.']
  asset_class varchar [note: 'Primary asset class context of the meeting (e.g., private equity, real estate, infrastructure, credit, public equities). [ENUM-REF-CANDIDATE: private_equity|real_estate|infrastructure|natural_resources|credit|public_equities|multi_asset|fund_of_funds —']
  created_timestamp timestamp [note: 'Timestamp when this meeting record was first created in the data platform. Supports audit trail and data lineage requirements.']
  dd_type varchar [note: 'Type of due diligence conducted during or associated with this meeting: ODD (Operational), FDD (Financial), CDD (Commercial), ESG DD, Legal DD, or not applicable.']
  duration_minutes varchar [note: 'Actual elapsed duration of the meeting in minutes as recorded by the meeting organiser. Supports SLA monitoring and engagement analytics.']
  end_timestamp timestamp [note: 'Precise date and time the meeting concluded, including timezone offset. Used alongside start_timestamp to derive meeting duration.']
  escalation_flag boolean [note: 'Indicates whether issues raised in this meeting require escalation to the Investment Committee (IC) or senior management for further review or decision.']
  escalation_reason varchar [note: 'Narrative description of the reason for escalation to the IC or senior management, if escalation_flag is true. Null if no escalation is required.']
  esg_topics_discussed boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) topics were formally discussed during the meeting, supporting PRI and TCFD stewardship reporting.']
  esg_topics_summary varchar [note: 'Free-text summary of ESG-related topics discussed, including climate risk, GHG targets, governance concerns, or social impact matters raised during the meeting.']
  external_attendee_count varchar [note: 'Number of external manager representatives (GP principals, IR staff, portfolio managers) who attended the meeting.']
  format varchar [note: 'Delivery format of the meeting: in-person, video conference, telephone, or hybrid. Relevant for travel cost attribution and engagement quality assessment.']
  ic_member_present boolean [note: 'Indicates whether a member of the internal Investment Committee (IC) attended this meeting, relevant for governance and escalation tracking.']
  internal_attendee_count varchar [note: 'Number of internal pension fund staff members who attended the meeting. Used for engagement intensity and resource utilisation reporting.']
  key_risks_identified varchar [note: 'Narrative summary of material risks identified during the meeting, including operational, market, liquidity, counterparty, or ESG risks flagged by either party.']
  location_city varchar [note: 'City where the in-person or hybrid meeting took place (e.g., London, New York, Singapore). Null for fully remote meetings.']
  location_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the jurisdiction where the meeting physically occurred (e.g., GBR, USA, CAN). Null for fully remote meetings.']
  location_venue varchar [note: 'Name of the specific venue, office, or facility where the meeting was held (e.g., manager HQ, fund administrator office, pension fund offices).']
  manager_conviction_rating varchar [note: 'Internal conviction rating assigned to the manager following this meeting: high, medium, low, or under review. Feeds into manager scoring and allocation decisions.']
  manager_senior_rep_present boolean [note: 'Indicates whether a senior representative (partner, CIO, or managing director) of the external manager was present. Relevant for escalation and governance quality assessment.']
  meeting_status varchar [note: 'Current lifecycle state of the meeting record: scheduled, completed, cancelled, rescheduled, or pending minutes approval.']
  meeting_type varchar [note: 'Classification of the formal interaction: annual review, quarterly update call, on-site due diligence visit, LPAC meeting, ad-hoc escalation, or initial screening.']
  minutes_approved boolean [note: 'Indicates whether the formal meeting minutes have been reviewed and approved by the designated internal approver, completing the governance record.']
  minutes_approved_date date [note: 'Date on which the meeting minutes were formally approved. Null if minutes are pending or not yet approved.']
  minutes_document_ref varchar [note: 'Document management system reference or URL pointing to the formal meeting minutes stored in the governance platform (e.g., Diligent / BoardEffect).']
  next_meeting_date date [note: 'Tentative or confirmed date for the next formal interaction with this manager, supporting engagement cadence planning and SLA compliance.']
  next_meeting_type varchar [note: 'Anticipated type of the next scheduled meeting with this manager. Supports forward engagement planning and oversight cadence management.']
  open_action_items_count varchar [note: 'Number of action items from this meeting that remain open or unresolved at the time of record update. Used for follow-up governance monitoring.']
  overall_sentiment varchar [note: 'Internal qualitative assessment of the overall tone and outcome of the meeting: positive, neutral, negative, or cautionary. Supports manager scoring and watch-list decisions.']
  performance_review_period varchar [note: 'The reporting period covered in the performance discussion (e.g., Q3 2024, FY2023). Aligns with GIPS-compliant performance reporting cycles.']
  purpose varchar [note: 'Free-text description of the primary business objective of the meeting (e.g., annual ODD review, portfolio performance discussion, ESG integration assessment).']
  reference_number varchar [note: 'Externally-visible alphanumeric reference code assigned to this meeting, used in correspondence and governance records (e.g., MTG-2024-000123).']
  scheduled_date date [note: 'The calendar date on which the meeting was originally scheduled to occur, used for planning and SLA tracking purposes.']
  sla_compliant boolean [note: 'Indicates whether this meeting was conducted within the required SLA engagement frequency for this manager tier (e.g., annual review within 12 months of prior).']
  source_system_ref_code varchar [note: 'The native identifier of this meeting record in the originating source system (e.g., DealCloud activity ID, eFront interaction ID). Supports data lineage and reconciliation.']
  start_timestamp timestamp [note: 'Precise date and time the meeting commenced, including timezone offset. Used for duration calculation and audit trail.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to this meeting record in the data platform. Supports change tracking and audit compliance.']
  vintage_year varchar [note: 'The vintage year of the fund or mandate under discussion, representing the year of initial capital commitment. Key context for private markets performance benchmarking.']
  watch_list_flag boolean [note: 'Indicates whether this meeting resulted in the manager being placed on or remaining on the internal watch list due to performance, operational, or ESG concerns.']

  Note: 'Records all formal interactions with external managers including annual reviews, quarterly update calls, on-site due diligence visits, LPAC meetings, and ad-hoc escalation meetings.'
}

Table manager.co_invest_right {
  co_invest_right_id varchar [pk, note: 'Unique surrogate identifier for a co-investment right record negotiated within an LP mandate. Primary key for this entity. Role: MASTER_AGREEMENT.']
  fund_id varchar [note: 'Reference to the specific GP fund vehicle (e.g., private equity fund, infrastructure fund) within which this co-investment right is embedded.']
  gp_profile_id varchar [note: 'Reference to the external fund manager (General Partner) who granted this co-investment right. Sourced from the manager master record in Preqin/PitchBook.']
  ic_decision_id varchar [note: 'Foreign key linking to compliance.ic_decision. Business justification: Co-investment right exercise requires IC approval per fiduciary governance. Links co-invest rights to IC decisions that approved/modified them.']
  manager_gp_profile_id varchar [note: 'Reference to the external fund manager (General Partner) who granted this co-investment right. Sourced from the manager master record in Preqin/PitchBook.']
  manager_mandate_id varchar [note: 'Reference to the LP mandate (LPA or SMA) under which this co-investment right was negotiated. Links to the parent mandate record in the manager domain.']
  allocation_basis varchar [note: 'Basis on which the co-investment allocation right is measured: as a percentage of deal size, percentage of LP commitment, a fixed dollar cap, or uncapped.']
  allocation_cap_amount decimal(22,4) [note: 'Maximum dollar amount the pension fund may invest per co-investment opportunity under this right. Applicable when allocation_basis is fixed_dollar_cap. Expressed in the mandate currency.']
  allocation_percentage decimal(8,4) [note: 'The percentage of each co-investment opportunity the pension fund is entitled to receive under this right. Applicable when allocation_basis is percentage-based. Expressed as a decimal (e.g., 0.1000 = 10%).']
  annual_utilization_cap_amount decimal(22,4) [note: 'Maximum aggregate amount (in mandate currency) the pension fund may deploy under this co-investment right within a single calendar or fiscal year.']
  approval_process_type varchar [note: 'Internal approval process required to exercise this co-investment right: Investment Committee (IC) approval, delegated authority, CIO approval, or committee approval.']
  asset_class varchar [note: 'Primary asset class to which this co-investment right applies, aligned with the pension fund\'s SAA framework (e.g., private equity, infrastructure, real estate).']
  carry_rate decimal(8,4) [note: 'Carried interest (carry) rate applicable to co-investments under this right, expressed as a decimal (e.g., 0.2000 = 20%). Zero for no-carry structures.']
  confidentiality_obligation boolean [note: 'Indicates whether the terms of this co-investment right are subject to confidentiality obligations under the LPA or NDA, restricting disclosure to third parties.']
  created_timestamp timestamp [note: 'Timestamp when this co-investment right record was first created in the data platform. Supports audit trail and data lineage requirements per SOC 2 and ISO 27001.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code applicable to monetary fields on this co-investment right (e.g., USD, GBP, EUR).']
  decision_deadline_days varchar [note: 'Maximum number of calendar days within which the pension fund must communicate its investment decision (accept or decline) after receiving a co-investment opportunity notice from the GP.']
  effective_date date [note: 'Date from which this co-investment right becomes binding and exercisable, as stipulated in the LPA or side-letter agreement.']
  esg_screening_required boolean [note: 'Indicates whether co-investment opportunities under this right must pass the pension fund\'s ESG screening and responsible investment assessment prior to acceptance.']
  exclusivity_applicable boolean [note: 'Indicates whether an exclusivity window applies to this co-investment right, preventing the GP from offering the same opportunity to other LPs during the pension fund\'s review period.']
  exclusivity_window_days varchar [note: 'Number of calendar days the pension fund has exclusive right to evaluate and accept or decline a co-investment opportunity before the GP may offer it to other LPs.']
  expiry_date date [note: 'Date on which this co-investment right expires or lapses. Null for rights that persist for the full fund term. Aligned with fund investment period end.']
  fee_structure_type varchar [note: 'Fee and carried interest structure applicable to co-investments under this right. Common structures include no-fee/no-carry (preferred), reduced fee/no carry, or full fee/full carry.']
  geographic_focus varchar [note: 'Geographic scope or region for which this co-investment right applies (e.g., North America, Global, Europe). Free-text to accommodate multi-region mandates.']
  hurdle_rate decimal(8,4) [note: 'Preferred return threshold (hurdle rate) that must be achieved before carried interest accrues on co-investments under this right. Expressed as a decimal annual rate.']
  last_review_date date [note: 'Date of the most recent formal review of this co-investment right by the internal manager oversight team, confirming terms remain current and utilization is within limits.']
  management_fee_rate decimal(8,4) [note: 'Annual management fee rate charged on co-investments under this right, expressed as a decimal (e.g., 0.0050 = 50 bps). Zero for no-fee structures.']
  max_deal_size_amount decimal(22,4) [note: 'Maximum total deal or transaction size (in mandate currency) for which this co-investment right applies. Null if no upper deal size restriction is stipulated.']
  min_deal_size_amount decimal(22,4) [note: 'Minimum total deal or transaction size (in mandate currency) for which this co-investment right is triggered. Deals below this threshold may not qualify for co-investment.']
  negotiation_date date [note: 'Date on which this co-investment right was formally negotiated and agreed between the pension fund and the GP, typically coinciding with LPA signing or side-letter execution.']
  next_review_date date [note: 'Scheduled date for the next formal review of this co-investment right. Supports manager oversight calendar and governance compliance tracking.']
  notes varchar [note: 'Free-text field for additional context, negotiation history, special conditions, or qualifications associated with this co-investment right not captured in structured fields.']
  notice_period_days varchar [note: 'Number of calendar days the GP must provide advance notice to the pension fund before a co-investment opportunity closes, as stipulated in the LPA or side-letter.']
  opportunities_accepted_count varchar [note: 'Cumulative number of co-investment opportunities accepted and funded by the pension fund under this right since inception. Numerator for acceptance rate analytics.']
  opportunities_declined_count varchar [note: 'Cumulative number of co-investment opportunities formally declined by the pension fund under this right since inception. Supports GP relationship and pipeline analytics.']
  opportunities_offered_count varchar [note: 'Cumulative number of co-investment opportunities formally offered by the GP to the pension fund under this right since inception. Used for utilization tracking and GP relationship assessment.']
  remaining_capacity_amount decimal(22,4) [note: 'Remaining investable capacity under the total right cap (total_right_cap_amount minus total_deployed_amount). Null if the right is uncapped. Supports portfolio construction decisions.']
  right_name varchar [note: 'Descriptive human-readable name for this co-investment right, typically referencing the fund name and right type (e.g., \'Buyout Fund V Co-Invest Pro-Rata Right\').']
  right_reference_code varchar [note: 'Externally-known alphanumeric code uniquely identifying this co-investment right, as referenced in the LPA side-letter or mandate agreement documentation.']
  right_status varchar [note: 'Current lifecycle status of the co-investment right: active (exercisable), suspended, expired (past effective period), terminated (cancelled), or pending_negotiation.']
  right_type varchar [note: 'Classification of the co-investment right structure: pro_rata (proportional to LP commitment), discretionary (GP discretion), first_look, last_look, or capped_allocation.']
  sector_focus varchar [note: 'Industry sector or sectors to which this co-investment right is restricted or focused (e.g., Technology, Healthcare, Energy Infrastructure). Null if no sector restriction.']
  side_letter_reference varchar [note: 'Document reference number or identifier for the LPA side-letter or amendment that formally grants this co-investment right. Used for legal and compliance traceability.']
  source_system_record_code varchar [note: 'Native record identifier from the originating source system (e.g., eFront co-invest right ID, DealCloud record ID). Supports data lineage, reconciliation, and audit traceability.']
  total_deployed_amount decimal(22,4) [note: 'Cumulative capital deployed (invested) by the pension fund under this co-investment right since inception, expressed in mandate currency. Tracks historical utilization against caps.']
  total_right_cap_amount decimal(22,4) [note: 'Maximum aggregate amount (in mandate currency) the pension fund may deploy under this co-investment right over the full fund term. Null if uncapped.']
  transferability_permitted boolean [note: 'Indicates whether the pension fund may transfer or assign this co-investment right to an affiliated entity or co-investor. Governed by LPA transfer restriction clauses.']
  updated_timestamp timestamp [note: 'Timestamp when this co-investment right record was most recently modified in the data platform. Supports change tracking, audit trail, and Silver layer reconciliation.']

  Note: 'Master record of co-investment rights negotiated within each LP mandate, specifying the co-investment allocation right (percentage or dollar cap), notice period for co-invest opportunities, approval process, exclusivity window, and historical utilization.'
}

Table manager.lpac_membership {
  lpac_membership_id varchar [pk, note: 'Unique surrogate identifier for each LPAC membership position held by the pension fund across LP fund mandates. Primary key for this entity.']
  employee_id varchar [note: 'Reference to the internal pension fund employee or officer appointed to represent the fund on this LPAC seat.']
  gp_profile_id varchar [note: 'Reference to the external General Partner (GP) or fund manager entity for which this LPAC seat is held. Sourced from Preqin/PitchBook manager registry.']
  manager_contact_id varchar [note: 'Reference to the internal pension fund employee or officer appointed to represent the fund on this LPAC seat.']
  manager_gp_profile_id varchar [note: 'Reference to the external General Partner (GP) or fund manager entity for which this LPAC seat is held. Sourced from Preqin/PitchBook manager registry.']
  manager_mandate_id varchar [note: 'Reference to the LP fund mandate under which this LPAC membership seat is held. Links to the specific Limited Partnership Agreement (LPA) governing the fund.']
  alternate_representative_name varchar [note: 'Full name of the designated alternate representative who may attend and vote on behalf of the pension fund when the primary representative is unavailable.']
  appointment_date date [note: 'Date on which the pension fund was formally appointed to the LPAC seat, as confirmed by the GP and documented in the LPA or side letter.']
  commitment_amount decimal(28,6) [note: 'Total capital committed by the pension fund to this LP fund mandate under the LPA. Expressed in the fund\'s base currency. Drives LPAC seat eligibility thresholds.']
  commitment_currency varchar [note: 'ISO 4217 three-letter currency code for the denomination of the LP commitment amount (e.g., USD, EUR, GBP).']
  conflict_of_interest_notes varchar [note: 'Free-text description of any identified or disclosed conflicts of interest associated with this LPAC membership, including related-party relationships or co-investment overlaps.']
  consent_matters_voted_count varchar [note: 'Total number of GP consent matters (e.g., conflict approvals, valuation overrides, key person waivers) on which the pension fund has cast a vote via this LPAC seat.']
  data_source_system varchar [note: 'Operational system of record from which this LPAC membership record was sourced (e.g., eFront for private markets monitoring, DealCloud for manager CRM, Preqin/PitchBook for external data).']
  esg_oversight_scope varchar [note: 'Scope of ESG oversight rights exercised through this LPAC seat, as defined in the LPA or side letter. Full scope includes ESG reporting review; limited scope covers specific ESG consent matters only.']
  fund_asset_class varchar [note: 'Primary asset class of the fund for which the LPAC seat is held. Drives portfolio domain classification and reporting alignment. [ENUM-REF-CANDIDATE: private_equity|real_estate|infrastructure|natural_resources|credit|fund_of_funds|other — promote to']
  fund_domicile_country varchar [note: 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the fund is legally domiciled (e.g., CYM for Cayman Islands, LUX for Luxembourg, GBR for United Kingdom).']
  fund_legal_entity_identifier varchar [note: '20-character ISO 17442 Legal Entity Identifier (LEI) of the fund vehicle. Used for regulatory reporting and counterparty identification under EMIR and MiFID II.']
  fund_name varchar [note: 'Full legal name of the LP fund for which this LPAC membership is held, as stated in the Limited Partnership Agreement (LPA).']
  fund_strategy varchar [note: 'Specific investment strategy of the fund (e.g., buyout, venture capital, core infrastructure, opportunistic real estate, direct lending). Provides sub-classification within the asset class.']
  fund_vintage_year varchar [note: 'Year in which the fund made its first capital call or was formally closed, used to classify the fund generation and benchmark performance against peers of the same vintage.']
  governance_review_date date [note: 'Date of the most recent internal governance review of this LPAC membership, including assessment of representative suitability, conflict of interest status, and seat value to the pension fund.']
  gp_consent_required boolean [note: 'Indicates whether the General Partner (GP) must provide consent for the pension fund to transfer or assign its LPAC seat to another LP or representative.']
  has_conflict_of_interest_waiver boolean [note: 'Indicates whether the pension fund has executed a conflict of interest waiver in connection with this LPAC seat, as required by the LPA for certain GP-related transactions.']
  internal_approval_date date [note: 'Date on which the internal Investment Committee (IC) or governance body formally approved the pension fund\'s participation in this LPAC seat.']
  internal_approval_reference varchar [note: 'Reference number of the internal Investment Committee (IC) or governance body approval authorizing the pension fund\'s participation in this LPAC seat.']
  is_lead_lp boolean [note: 'Indicates whether the pension fund holds the lead LP designation on this LPAC, conferring additional governance rights such as chairing meetings or coordinating LP responses to GP consent requests.']
  last_meeting_date date [note: 'Date of the most recent LPAC meeting attended or scheduled for this fund. Used for monitoring engagement recency and governance activity.']
  lp_commitment_pct_of_fund decimal(7,4) [note: 'The pension fund\'s committed capital as a percentage of total fund commitments at final close. Determines voting weight and LPAC seat eligibility.']
  lpa_side_letter_reference varchar [note: 'Reference number or identifier of any side letter executed between the pension fund and the GP that modifies or supplements LPAC rights beyond the standard LPA terms.']
  meetings_attended_count varchar [note: 'Total number of LPAC meetings attended by the pension fund\'s representative since appointment or within the current reporting period. Used for attendance compliance tracking.']
  meetings_scheduled_count varchar [note: 'Total number of LPAC meetings formally scheduled for this fund during the current reporting period or since appointment. Used to compute attendance rate.']
  membership_status varchar [note: 'Current lifecycle status of the LPAC membership position. Reflects whether the pension fund currently holds, is pending confirmation of, or has exited the LPAC seat.']
  nda_executed boolean [note: 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed by the pension fund representative in connection with LPAC membership, as required for access to confidential GP materials.']
  nda_execution_date date [note: 'Date on which the NDA was formally executed by the pension fund representative for this LPAC membership. Null if no NDA has been executed.']
  next_meeting_date date [note: 'Date of the next scheduled LPAC meeting for this fund. Used for calendar management and representative preparation.']
  notes varchar [note: 'Free-text field for additional context, special conditions, or qualifications associated with this LPAC membership not captured in structured fields.']
  record_created_timestamp timestamp [note: 'Timestamp when this LPAC membership record was first created in the data platform. Supports audit trail and data lineage requirements.']
  record_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this LPAC membership record in the data platform. Used for change detection and incremental processing in the Silver layer.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this LPAC membership position must be disclosed in regulatory filings (e.g., SEC, FCA) due to governance rights, ownership thresholds, or related-party rules.']
  representative_name varchar [note: 'Full name of the internal pension fund officer or employee formally designated to represent the fund on this LPAC seat.']
  representative_title varchar [note: 'Job title or role of the internal representative assigned to this LPAC seat (e.g., Managing Director, Portfolio Manager, General Counsel).']
  resignation_date date [note: 'Date on which the pension fund formally resigned or was removed from the LPAC seat. Null if the membership is still active.']
  seat_eligibility_threshold_pct decimal(7,4) [note: 'Minimum LP commitment percentage of total fund commitments required to qualify for an LPAC seat, as stipulated in the LPA. Expressed as a percentage (e.g., 5.0000 = 5%).']
  seat_source varchar [note: 'Indicates the contractual basis under which the LPAC seat was obtained: standard LPA provision, side letter negotiation, LPA amendment, or transfer from another LP.']
  seat_type varchar [note: 'Classification of the LPAC seat held by the pension fund. Voting seats carry formal decision-making rights; observer seats provide attendance without vote; alternate seats are backup positions.']
  source_system_record_code varchar [note: 'Native record identifier from the operational source system (e.g., eFront fund ID, DealCloud entity ID) for lineage tracing and reconciliation with upstream systems.']
  term_expiry_date date [note: 'Date on which the current LPAC membership term expires or is subject to renewal. Null if the seat is held for the full life of the fund with no fixed term.']
  voting_weight_pct decimal(7,4) [note: 'Percentage of total LPAC voting rights held by the pension fund on this committee, as defined in the LPA. Applicable only for voting seat types; null for observer seats.']

  Note: 'Tracks the pension fund\'s Limited Partner Advisory Committee (LPAC) membership positions across all LP fund mandates, including seat type (voting, observer), appointment date, term expiry, representative assigned, and LPAC meeting attendance record.'
}

Table manager.strategy {
  strategy_id varchar [pk, note: 'Unique identifier for the strategy.']
  asset_class varchar [note: 'Primary asset class targeted by the strategy. [ENUM-REF-CANDIDATE: Equity|Fixed Income|Real Estate|Private Equity|Infrastructure|Natural Resources|Credit — promote to reference product]']
  created_timestamp timestamp [note: 'Timestamp when the strategy record was created.']
  geographic_focus varchar [note: 'Primary geographic focus of the strategy. [ENUM-REF-CANDIDATE: North America|Europe|Asia|Latin America|Middle East|Africa|Global — promote to reference product]']
  strategy_code varchar [note: 'Alphanumeric code used to identify the strategy in external systems.']
  strategy_description varchar [note: 'Detailed description of the strategy\'s investment approach.']
  strategy_name varchar [note: 'Human-readable name of the investment strategy.']
  strategy_status varchar [note: 'Current lifecycle status of the strategy.']
  sub_strategy_type varchar [note: 'Specific sub-strategy focus. [ENUM-REF-CANDIDATE: Buyout|Venture|Growth|Distressed|Core Real Estate|Value-Add|Infrastructure Greenfield|... — promote to reference product]']
  target_allocation_amount decimal(18,2) [note: 'Target allocation amount in USD for the strategy.']
  target_allocation_pct decimal(5,2) [note: 'Target allocation percentage of the strategy within a portfolio.']
  target_aum_max decimal(18,2) [note: 'Maximum target assets under management for the strategy.']
  target_aum_min decimal(18,2) [note: 'Minimum target assets under management for the strategy.']
  target_carry_rate decimal(5,2) [note: 'Target carried interest rate for the strategy.']
  target_co_investment_flag boolean [note: 'Flag indicating if co-investment is allowed for the strategy.']
  target_commitment decimal(18,2) [note: 'Target committed capital for the strategy.']
  target_dpi decimal(5,2) [note: 'Target distributions to paid-in for the strategy.']
  target_esg_integration_level varchar [note: 'Target ESG integration level for the strategy.']
  target_fund_size decimal(18,2) [note: 'Target size of the fund for the strategy.']
  target_gps varchar [note: 'Target GIPS compliance status for the strategy.']
  target_hurdle_rate decimal(5,2) [note: 'Target hurdle rate for the strategy.']
  target_irr decimal(5,2) [note: 'Target internal rate of return for the strategy.']
  target_lpa_carry decimal(5,2) [note: 'Carry rate specified in the Limited Partnership Agreement.']
  target_lpa_carry_rate decimal(5,2) [note: 'Carry rate percentage specified in the Limited Partnership Agreement.']
  target_lpa_carry_split decimal(5,2) [note: 'Carry split percentage specified in the Limited Partnership Agreement.']
  target_lpa_end_date date [note: 'End date of the Limited Partnership Agreement.']
  target_lpa_fee_structure varchar [note: 'Fee structure of the Limited Partnership Agreement.']
  target_lpa_hurdle decimal(5,2) [note: 'Hurdle rate specified in the Limited Partnership Agreement.']
  target_lpa_mgmt_fee decimal(5,2) [note: 'Management fee rate specified in the Limited Partnership Agreement.']
  target_lpa_reference varchar [note: 'Reference to the Limited Partnership Agreement for the strategy.']
  target_lpa_start_date date [note: 'Start date of the Limited Partnership Agreement.']
  target_lpa_status varchar [note: 'Current status of the Limited Partnership Agreement.']
  target_lpa_type varchar [note: 'Type of Limited Partnership Agreement for the strategy.']
  target_management_fee_rate decimal(5,2) [note: 'Target management fee rate for the strategy.']
  target_max_deal_size decimal(18,2) [note: 'Maximum deal size for the strategy.']
  target_max_investment_period_years varchar [note: 'Maximum investment period in years for the strategy.']
  target_min_deal_size decimal(18,2) [note: 'Minimum deal size for the strategy.']
  target_min_investment_period_years varchar [note: 'Minimum investment period in years for the strategy.']
  target_moic decimal(5,2) [note: 'Target multiple on invested capital for the strategy.']
  target_rvpi decimal(5,2) [note: 'Target residual value to paid-in for the strategy.']
  target_tvpi decimal(5,2) [note: 'Target total value to paid-in for the strategy.']
  target_vintage_year varchar [note: 'Target vintage year for the strategy.']
  updated_timestamp timestamp [note: 'Timestamp when the strategy record was last updated.']

  Note: 'Reference classification of investment strategies offered by external managers, including strategy name, asset class, sub-strategy type (buyout, venture, growth, distressed, core real estate, value-add, infrastructure greenfield, etc.), geographic focus'
}

Table manager.manager_document {
  manager_document_id varchar [pk, note: 'Unique identifier for the manager document record.']
  gp_profile_id varchar [note: 'Identifier linking the document to the associated manager.']
  manager_gp_profile_id varchar [note: 'Identifier linking the document to the associated manager.']
  manager_mandate_id varchar [note: 'Identifier linking the document to the related mandate.']
  access_control varchar [note: 'Access control level for the document (public, restricted, confidential).']
  approval_status varchar [note: 'Status of the document approval workflow (approved, pending, rejected).']
  approved_by varchar [note: 'Identifier of the individual who approved the document.']
  approved_date date [note: 'Date when the document was approved.']
  created_at timestamp [note: 'Timestamp when the document record was created.']
  document_category varchar [note: 'High-level category of the document (e.g., Legal, Financial, Compliance).']
  document_description varchar [note: 'Detailed description of the document contents.']
  document_status varchar [note: 'Current lifecycle status of the document (draft, final, archived, replaced).']
  document_type varchar [note: 'Classification of the document (e.g., LPA, NDA, PPM).']
  effective_date date [note: 'Date when the document becomes effective.']
  expiry_date date [note: 'Date when the document expires or is no longer valid.']
  format varchar [note: 'File format of the document (PDF, DOCX, XLSX, TXT, HTML).']
  hash_sha256 varchar [note: 'SHA-256 hash of the document file for integrity verification.']
  language varchar [note: 'Primary language of the document.']
  language_code varchar [note: 'ISO 639-1 code for the document language.']
  last_accessed timestamp [note: 'Timestamp of the last time the document was accessed.']
  page_count varchar [note: 'Number of pages in the document.']
  pii_content_flag boolean [note: 'Flag indicating whether the document content includes PII.']
  pii_flag boolean [note: 'Flag indicating whether the document contains personally identifiable information.']
  reference_code varchar [note: 'Alphanumeric code used to reference the document in external systems.']
  reference_number varchar [note: 'Sequential number assigned to the document for tracking.']
  signed_by varchar [note: 'Identifier of the individual who signed the document.']
  signed_by_role varchar [note: 'Role of the signer within the organization.']
  signed_date date [note: 'Date when the document was signed.']
  signed_status varchar [note: 'Status of the document\'s electronic signature (signed, unsigned, pending).']
  size_bytes varchar [note: 'Size of the document file in bytes.']
  storage_location varchar [note: 'Storage path or URI where the document is stored.']
  summary varchar [note: 'Brief summary of the document.']
  title varchar [note: 'Title of the document.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the document record.']
  version_label varchar [note: 'Human-readable label for the document version.']
  version_number varchar [note: 'Numeric version identifier of the document.']
  created_by varchar [note: 'User who created the document record.']

  Note: 'Catalog of all legal and operational documents associated with each manager relationship, including executed LPAs, side letters, NDAs, PPMs, subscription agreements, audited financial statements, DDQs (Due Diligence Questionnaires), and regulatory'
}

Table manager.kyc {
  kyc_id varchar [pk, note: 'Unique identifier for the KYC record.']
  gp_profile_id varchar [note: 'Identifier of the external manager subject to KYC.']
  kyc_record_id varchar [note: 'FK to compliance.kyc_record.kyc_record_id — Manager-level KYC must reference the enterprise compliance KYC master so AML/sanctions status is authoritative and not duplicated across onboarding workflows.']
  manager_gp_profile_id varchar [note: 'Identifier of the external manager subject to KYC.']
  sanctions_screening_id varchar [note: 'Foreign key linking to compliance.sanctions_screening. Business justification: Manager onboarding due diligence requires documented sanctions screening. Links KYC record to actual screening performed, enabling audit trail for regulatory examinations and']
  aml_screening_result varchar [note: 'Result of AML screening.']
  beneficial_ownership_verification boolean [note: 'Verification of beneficial ownership.']
  completion_date date [note: 'Date when KYC was completed.']
  compliance_flag boolean [note: 'Flag indicating compliance status.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  document_category varchar [note: 'Category of the document.']
  document_expiry_date date [note: 'Expiry date of the document.']
  document_hash varchar [note: 'Hash of the document for integrity.']
  document_language varchar [note: 'Language of the document.']
  document_reference varchar [note: 'Reference code for the KYC document.']
  document_size_bytes varchar [note: 'Size of the document in bytes.']
  document_status varchar [note: 'Status of the KYC document.']
  document_storage_location varchar [note: 'Storage location of the document.']
  document_type varchar [note: 'Type of the KYC document.']
  document_upload_date date [note: 'Date the document was uploaded.']
  document_version varchar [note: 'Version of the document.']
  kyc_status varchar [note: 'Current status of the KYC process.']
  pep_status varchar [note: 'Politically Exposed Person status.']
  provider varchar [note: 'Provider that performed the KYC.']
  provider_document_category varchar [note: 'Category of the provider\'s document.']
  provider_document_expiry_date date [note: 'Expiry date of the provider\'s document.']
  provider_document_hash varchar [note: 'Hash of the provider\'s document.']
  provider_document_language varchar [note: 'Language of the provider\'s document.']
  provider_document_reference varchar [note: 'Reference for the provider\'s document.']
  provider_document_size_bytes varchar [note: 'Size of the provider\'s document in bytes.']
  provider_document_status varchar [note: 'Status of the provider\'s document.']
  provider_document_storage_location varchar [note: 'Storage location of the provider\'s document.']
  provider_document_type varchar [note: 'Type of the provider\'s document.']
  provider_document_upload_date date [note: 'Upload date of the provider\'s document.']
  provider_document_version varchar [note: 'Version of the provider\'s document.']
  provider_version varchar [note: 'Version of the KYC provider.']
  reference varchar [note: 'Reference code for the KYC record.']
  reference_code varchar [note: 'Code for the KYC reference.']
  reference_name varchar [note: 'Name of the KYC reference.']
  regulatory_compliance_status varchar [note: 'Regulatory compliance status.']
  review_date date [note: 'Date of the last KYC review.']
  review_frequency varchar [note: 'Frequency of KYC reviews.']
  risk_rating varchar [note: 'Overall risk rating of the KYC.']
  source_of_funds_confirmation boolean [note: 'Confirmation of source of funds.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  version varchar [note: 'Version of the KYC record.']

  Note: 'Records KYC (Know Your Customer) and AML (Anti-Money Laundering) due diligence completed for each external manager entity, including beneficial ownership verification, sanctions screening results, PEP checks, source of funds confirmation, and regulatory'
}

Table manager.esg_profile {
  esg_profile_id varchar [pk, note: 'Globally unique identifier for the ESG profile record.']
  esg_policy_document_id varchar [note: 'Identifier of the ESG policy document associated with the profile.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Manager ESG profiles implement specific ESG policies. Business process: ESG policy compliance tracking, manager selection based on policy alignment.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: ESG profiles align to specific frameworks (PRI, TCFD, SFDR). Business process: Framework compliance reporting, manager ESG assessment during due diligence. Required for regulatory disclosures.']
  esg_framework varchar [note: 'The ESG framework or standard the profile adheres to, e.g., PRI, SFDR, TCFD, or ESG.']
  esg_policy_document_created_by varchar [note: 'Identifier of the user or system that created the ESG policy document.']
  esg_policy_document_created_date date [note: 'Date when the ESG policy document was first created.']
  esg_policy_document_language varchar [note: 'Language of the ESG policy document, ISO 639‑1 code.']
  esg_policy_document_last_updated_by varchar [note: 'Identifier of the user or system that last updated the ESG policy document.']
  esg_policy_document_last_updated_date date [note: 'Date when the ESG policy document was last updated.']
  esg_policy_document_notes varchar [note: 'Additional notes or remarks about the ESG policy document.']
  esg_policy_document_source varchar [note: 'Source of the ESG policy document, internal or external.']
  esg_policy_document_status varchar [note: 'Publication status of the ESG policy document.']
  esg_policy_document_type varchar [note: 'Type of the ESG policy document, e.g., policy, report, guideline.']
  esg_policy_document_url varchar [note: 'Web URL where the ESG policy document can be accessed.']
  esg_policy_document_version varchar [note: 'Version identifier of the ESG policy document.']
  esg_profile_status varchar [note: 'Current lifecycle status of the ESG profile.']
  esg_score decimal(5,2) [note: 'Composite ESG score as a percentage, ranging from 0.00 to 100.00.']
  esg_score_calculation_frequency varchar [note: 'Frequency at which the ESG score is recalculated, e.g., annual, quarterly.']
  esg_score_calculation_method varchar [note: 'Methodology used to compute the ESG score, e.g., weighted average, composite index.']
  esg_score_calculation_notes varchar [note: 'Additional notes or remarks about the ESG score calculation methodology.']
  esg_score_date date [note: 'Date when the ESG score was last calculated.']
  esg_score_source varchar [note: 'Source of the ESG score data, e.g., internal model, third‑party provider.']
  profile_code varchar [note: 'Unique alphanumeric code assigned to the ESG profile.']
  profile_name varchar [note: 'Human-readable name of the ESG profile.']

  Note: 'Captures the ESG credentials and responsible investment profile of each external manager, including PRI signatory status, SFDR article classification, TCFD alignment, proprietary ESG policy documentation, GHG reporting capability, exclusion list'
}

Table manager.manager_benchmark {
  manager_benchmark_id varchar [pk, note: 'Unique identifier for the manager benchmark record.']
  gp_profile_id varchar [note: 'Identifier of the external manager associated with the benchmark.']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: Benchmarks reference macro indicators (CPI, GDP) for real return calculations and inflation-linked performance measurement.']
  manager_gp_profile_id varchar [note: 'Identifier of the external manager associated with the benchmark.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: Manager benchmark assignments must reference master benchmark definitions in performance domain.']
  approval_by varchar [note: 'Identifier of the approver for the benchmark.']
  approval_date date [note: 'Date when the benchmark was approved.']
  approval_notes varchar [note: 'Notes or comments from the approval process.']
  approval_status varchar [note: 'Current approval state of the benchmark.']
  benchmark_description varchar [note: 'Detailed description of the benchmark and its scope.']
  benchmark_name varchar [note: 'Human-readable name of the benchmark.']
  benchmark_status varchar [note: 'Current operational status of the benchmark.']
  benchmark_type varchar [note: 'Asset class or category the benchmark represents.']
  calculation_methodology varchar [note: 'Method used to calculate benchmark performance.']
  created_at timestamp [note: 'Timestamp when the benchmark record was created.']
  currency varchar [note: 'ISO 4217 currency code for benchmark values.']
  end_date date [note: 'Date when the benchmark expires or is no longer effective.']
  frequency varchar [note: 'How often the benchmark is updated.']
  index_code varchar [note: 'Standard code identifying the benchmark index.']
  is_confidential boolean [note: 'Indicates if the benchmark contains confidential information.']
  is_custom boolean [note: 'Indicates if this benchmark was created internally.']
  is_default boolean [note: 'Indicates if this benchmark is the default for its type.']
  is_public boolean [note: 'Indicates if the benchmark is publicly available.']
  is_restricted boolean [note: 'Indicates if the benchmark is restricted to certain users.']
  is_sensitive boolean [note: 'Indicates if the benchmark contains sensitive data.']
  mandate_id varchar [note: 'Identifier of the mandate to which the benchmark is assigned.']
  provider varchar [note: 'Name of the organization that publishes the benchmark.']
  source_document varchar [note: 'Reference to the source document for the benchmark.']
  source_document_checksum varchar [note: 'Checksum of the source document for integrity.']
  source_document_date date [note: 'Date of the source document for the benchmark.']
  source_document_format varchar [note: 'File format of the source document.']
  source_document_language varchar [note: 'Language of the source document.']
  source_document_language_code varchar [note: 'ISO 639-1 code for the source document language.']
  source_document_language_description varchar [note: 'Description of the source document language.']
  source_document_language_notes varchar [note: 'Additional notes about the source document language.']
  source_document_size varchar [note: 'Size of the source document in bytes.']
  source_document_type varchar [note: 'Type of the source document (e.g., PDF, XLS).']
  source_document_version varchar [note: 'Version of the source document.']
  source_url varchar [note: 'URL to the source of the benchmark data.']
  start_date date [note: 'Date when the benchmark becomes effective.']
  unit varchar [note: 'Unit of measurement for benchmark values.']
  updated_at timestamp [note: 'Timestamp of the last update to the benchmark record.']
  version varchar [note: 'Version identifier for the benchmark definition.']
  version_date date [note: 'Date when the benchmark version was released.']
  created_by varchar [note: 'Identifier of the user who created the benchmark.']

  Note: 'Defines the performance benchmarks assigned to each mandate or manager strategy, including benchmark name, benchmark provider, benchmark index code, benchmark currency, benchmark calculation methodology, and effective date range.'
}

Table manager.reporting_obligation {
  reporting_obligation_id varchar [pk, note: 'Unique identifier for the reporting obligation record.']
  gp_profile_id varchar [note: 'Identifier of the external manager associated with this obligation.']
  manager_gp_profile_id varchar [note: 'Identifier of the external manager associated with this obligation.']
  manager_mandate_id varchar [note: 'Identifier of the mandate under which the obligation is defined.']
  compliance_flag boolean [note: 'Indicates if the obligation is in compliance with regulatory requirements.']
  compliance_notes varchar [note: 'Additional notes regarding compliance status.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  data_delivery_channel varchar [note: 'Channel used for data delivery.']
  data_delivery_deadline_days varchar [note: 'Number of days allowed to deliver data after the due date.']
  data_delivery_format varchar [note: 'Format in which data is delivered to the manager.']
  delivery_channel varchar [note: 'Channel used to deliver the report.']
  delivery_format varchar [note: 'Format in which the report is delivered.']
  due_date date [note: 'Deadline for submitting the report.']
  effective_from date [note: 'Date when the obligation becomes effective.']
  effective_until date [note: 'Date when the obligation expires or is terminated.']
  frequency varchar [note: 'How often the obligation must be reported.']
  last_sent_date date [note: 'Date the report was last sent to the manager.']
  next_due_date date [note: 'Next scheduled due date for the obligation.']
  obligation_type varchar [note: 'Category of the reporting obligation.']
  penalty_amount decimal(18,2) [note: 'Monetary penalty amount if the obligation is breached.']
  penalty_clause_applicable boolean [note: 'Indicates if a penalty clause is applicable to the obligation.']
  penalty_currency varchar [note: 'Currency code for the penalty amount.']
  reference_code varchar [note: 'Code used to reference the obligation in external systems.']
  reference_name varchar [note: 'Human-readable name for the obligation reference.']
  report_description varchar [note: 'Detailed description of the report content.']
  report_notes varchar [note: 'Additional notes about the report.']
  reporting_obligation_status varchar [note: 'Current lifecycle status of the obligation.']
  sla_effective_from date [note: 'Date when the SLA becomes effective.']
  sla_effective_until date [note: 'Date when the SLA expires.']
  sla_reference_number varchar [note: 'Reference number for the SLA governing the obligation.']
  sla_status varchar [note: 'Current status of the SLA.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Defines the specific reporting obligations each external manager must fulfill under their mandate, including report type (capital account statement, audited financials, quarterly investor letter, ESG report, ILPA data template), delivery frequency'
}

Table manager.report_receipt {
  report_receipt_id varchar [pk, note: 'Unique identifier for each manager report receipt record.']
  gp_profile_id varchar [note: 'Identifier of the external manager whose report was received.']
  manager_gp_profile_id varchar [note: 'Identifier of the external manager whose report was received.']
  completeness_check_result varchar [note: 'Outcome of the initial completeness validation of the report.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the system.']
  data_quality_flags varchar [note: 'Comma-separated flags indicating data quality issues detected.']
  delivery_channel varchar [note: 'Medium through which the report was delivered to the system.']
  processing_error_code varchar [note: 'Error code returned by the processing engine, if any.']
  processing_error_details varchar [note: 'Additional details or stack trace for processing errors.']
  processing_error_flag boolean [note: 'Indicates whether an error occurred during processing.']
  processing_error_message varchar [note: 'Human-readable error message for processing failures.']
  processing_status varchar [note: 'Current status of the report processing workflow.']
  processing_timestamp timestamp [note: 'Timestamp when the report processing status last changed.']
  receipt_date timestamp [note: 'Timestamp when the report was received by the system.']
  report_checksum varchar [note: 'Checksum value for verifying file integrity.']
  report_file_name varchar [note: 'Original file name of the received report document.']
  report_file_size_bytes varchar [note: 'Size of the report file in bytes.']
  report_language_code varchar [note: 'ISO 639-1 code indicating the language of the report.']
  report_reference_code varchar [note: 'Alphanumeric code assigned to the report for tracking.']
  report_source_system_code varchar [note: 'Unique identifier of the source system instance.']
  report_source_system_name varchar [note: 'Name of the system that generated the report.']
  report_source_system_type varchar [note: 'Type of system that produced the report.']
  report_source_system_version varchar [note: 'Version of the source system that generated the report.']
  report_type varchar [note: 'Category of the report received, e.g., NAV, Performance, ESG.']
  report_version varchar [note: 'Version identifier of the report format.']
  reporting_period_end_date date [note: 'End date of the period covered by the report.']
  reporting_period_start_date date [note: 'Start date of the period covered by the report.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Transactional log of each manager report received, recording report type, reporting period covered, receipt date, delivery channel, completeness check result, data quality flags, and processing status.'
}

Table valuation.valuation_asset_valuation {
  valuation_asset_valuation_id varchar [pk, note: 'Unique identifier for the valuation record of an investment asset.']
  actor_id varchar [note: 'Identifier of the valuation agent or firm.']
  asset_id varchar [note: 'System-generated identifier for the underlying investment asset.']
  credit_rating_id varchar [note: 'Foreign key linking to risk.credit_rating. Business justification: Asset valuations require credit ratings for IFRS 9 impairment assessment and fair value hierarchy classification.']
  employee_id varchar [note: 'Identifier of the manager responsible for the portfolio.']
  fair_value_hierarchy_id varchar [note: 'Foreign key linking to valuation.fair_value_hierarchy. Business justification: Valuation records need to reference the fair value hierarchy level for IFRS 13 compliance.']
  input_id varchar [note: 'Foreign key linking to valuation.input. Business justification: Valuation models use quantitative inputs; linking to input table centralizes input data.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: SFDR/TCFD compliance requires ESG integration in asset valuations. Pension funds must document ESG scores affecting fair value for regulatory reporting and investment committee reviews.']
  portfolio_id varchar [note: 'Identifier of the portfolio containing the asset.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle or reporting period.']
  valuation_fx_rate_id varchar [note: 'Foreign key linking to valuation.valuation_fx_rate. Business justification: Valuation may involve foreign currency; linking to FX rate provides conversion context.']
  valuation_policy_id varchar [note: 'Foreign key linking to valuation.valuation_policy. Business justification: Each valuation is governed by a policy; linking to policy provides governance context.']
  valuation_yield_curve_id varchar [note: 'Foreign key linking to valuation.valuation_yield_curve. Business justification: Valuation calculations use a yield curve; linking provides the curve reference.']
  asset_category varchar [note: 'Category grouping for the asset (e.g., real estate, natural resources).']
  asset_class varchar [note: 'Asset class within the broader type (e.g., public equity, private equity).']
  asset_currency varchar [note: 'ISO 4217 currency code for the asset valuation.']
  asset_isin varchar [note: 'International Securities Identification Number for the asset.']
  asset_name varchar [note: 'Human‑readable name of the investment asset.']
  asset_sector varchar [note: 'Economic sector of the asset (e.g., technology, energy).']
  asset_subclass varchar [note: 'More granular subclass of the asset (e.g., growth equity, infrastructure).']
  asset_type varchar [note: 'Broad classification of the asset (e.g., equity, fixed income, private equity).']
  book_value decimal(38,10) [note: 'Accounting book value of the asset.']
  fair_value decimal(38,10) [note: 'Fair value of the asset as determined by the valuation method.']
  gav decimal(38,10) [note: 'Gross asset value of the portfolio at the valuation date.']
  market_value decimal(38,10) [note: 'Market price of the asset if available.']
  nav decimal(38,10) [note: 'Net asset value of the portfolio at the valuation date.']
  portfolio_type varchar [note: 'Classification of the portfolio (e.g., public, private, fund of funds).']
  valuation_comments varchar [note: 'Free‑text comments or notes about the valuation.']
  valuation_cycle_cycle_number varchar [note: 'Sequential number of the cycle within the year.']
  valuation_cycle_cycle_year varchar [note: 'Calendar year of the valuation cycle.']
  valuation_cycle_end_date date [note: 'End date of the valuation cycle.']
  valuation_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  valuation_cycle_start_date date [note: 'Start date of the valuation cycle.']
  valuation_cycle_status varchar [note: 'Current status of the valuation cycle.']
  valuation_date date [note: 'Date on which the valuation was performed.']
  valuation_document_code varchar [note: 'Identifier of the supporting valuation document.']
  valuation_document_date date [note: 'Date the valuation document was created.']
  valuation_document_hash varchar [note: 'Cryptographic hash of the valuation document for integrity.']
  valuation_document_signed_at timestamp [note: 'Timestamp when the valuation document was signed.']
  valuation_document_signed_by varchar [note: 'Name of the person who signed the valuation document.']
  valuation_document_status varchar [note: 'Current status of the valuation document.']
  valuation_document_type varchar [note: 'File format of the valuation document.']
  valuation_document_url varchar [note: 'URL to the valuation document.']
  valuation_document_version varchar [note: 'Version identifier of the valuation document.']
  valuation_engine varchar [note: 'Software or system used to compute the valuation.']
  valuation_method varchar [note: 'Methodology used to determine the asset value.']
  valuation_reason varchar [note: 'Reason for performing the valuation (e.g., periodic, event‑driven).']
  valuation_status varchar [note: 'Current status of the valuation record.']
  valuation_time timestamp [note: 'Exact timestamp of the valuation event.']

  Note: 'Core master record and authoritative SSOT for the concluded fair value of an individual investment asset at a specific valuation date, across ALL asset classes (public equity, private equity, infrastructure, real estate, natural resources, credit).'
}

Table valuation.valuation_nav_record {
  valuation_nav_record_id varchar [pk, note: 'Unique identifier for the valuation NAV record.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: NAV records must be filed with regulators (Form N-PORT, AIFMD Annex IV). Pension funds submit periodic NAV reports to regulatory authorities.']
  valuation_cycle_id varchar [note: 'Identifier for the valuation cycle.']
  created_at timestamp [note: 'Timestamp when the record was first created.']
  currency_code varchar [note: 'ISO 4217 currency code for NAV amounts.']
  fund_code varchar [note: 'Unique code identifying the fund or portfolio.']
  fund_name varchar [note: 'Human-readable name of the fund or portfolio.']
  nav_per_unit decimal(38,2) [note: 'NAV divided by the number of units outstanding.']
  net_asset_value decimal(38,2) [note: 'Net asset value after subtracting liabilities.']
  number_of_units decimal(38,2) [note: 'Total number of units or shares outstanding.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of last record update.']
  remarks varchar [note: 'Additional notes or comments about the valuation.']
  total_gross_asset_value decimal(38,2) [note: 'Sum of all asset values before liabilities.']
  total_liabilities decimal(38,2) [note: 'Sum of all liabilities associated with the fund.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the record.']
  valuation_cycle_frequency varchar [note: 'Frequency at which valuations occur.']
  valuation_date date [note: 'Date on which the NAV was calculated.']
  valuation_method varchar [note: 'Method used to compute the NAV (e.g., MTM, DCF).']
  valuation_reference varchar [note: 'Reference code used to identify the valuation instance.']
  valuation_source_code varchar [note: 'Identifier of the source system or process.']
  valuation_source_description varchar [note: 'Description of the source system or process.']
  valuation_source_name varchar [note: 'Name of the source system or process.']
  valuation_status varchar [note: 'Current status of the valuation process.']

  Note: 'Authoritative NAV (Net Asset Value) and GAV (Gross Asset Value) record for a fund, portfolio, or investment vehicle at a specific valuation date. Captures total gross asset value, total liabilities, net asset value, NAV per unit/share, number of units'
}

Table valuation.cycle {
  cycle_id varchar [pk, note: 'Unique identifier for the valuation cycle.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Valuation cycles must satisfy regulatory obligations. Pension funds link each cycle to the specific compliance obligation it fulfills for deadline tracking.']
  regulatory_calendar_id varchar [note: 'Foreign key linking to compliance.regulatory_calendar. Business justification: Valuation cycles must align with regulatory filing deadlines. Pension funds coordinate quarter-end valuations with compliance calendars to meet filing requirements.']
  approval_by varchar [note: 'User or system that approved the cycle.']
  approval_comments varchar [note: 'Comments provided during approval.']
  approval_date timestamp [note: 'Timestamp when the cycle was approved.']
  created_at timestamp [note: 'Timestamp when the cycle record was created.']
  cycle_description varchar [note: 'Free‑form description of the cycle.']
  cycle_status varchar [note: 'Current lifecycle state of the cycle.']
  cycle_type varchar [note: 'Frequency of the cycle: monthly, quarterly, annual, or custom.']
  end_date date [note: 'Date the cycle ends.']
  identifier varchar [note: 'Human‑readable identifier for the cycle, e.g., "FY23 Q1".']
  is_archived boolean [note: 'Indicates if the cycle has been archived.']
  is_finalized boolean [note: 'Indicates if the cycle has been finalized.']
  is_locked boolean [note: 'Indicates if the cycle is locked for editing.']
  number varchar [note: 'Sequential number of the cycle within the portfolio.']
  number_month varchar [note: 'Month component of the cycle number.']
  number_quarter varchar [note: 'Quarter component of the cycle number.']
  number_year varchar [note: 'Year component of the cycle number.']
  number_year_month varchar [note: 'Year and month concatenated, e.g., "2023-04".']
  number_year_month_day date [note: 'Full date of the cycle number.']
  number_year_quarter varchar [note: 'Year and quarter concatenated, e.g., "2023-Q2".']
  number_year_quarter_day date [note: 'Date of the cycle within the quarter.']
  number_year_quarter_month varchar [note: 'Year, quarter, and month, e.g., "2023-Q2-04".']
  number_year_quarter_month_day date [note: 'Full date of the cycle within the quarter and month.']
  number_year_quarter_month_day_time timestamp [note: 'Full timestamp of the cycle within the quarter and month.']
  number_year_quarter_month_day_time_millis varchar [note: 'Milliseconds component of the cycle timestamp.']
  number_year_quarter_month_day_time_nanos varchar [note: 'Nanoseconds component of the cycle timestamp.']
  number_year_quarter_month_day_time_seconds varchar [note: 'Seconds component of the cycle timestamp.']
  start_date date [note: 'Date the cycle begins.']
  updated_at timestamp [note: 'Timestamp of the last update to the cycle.']
  updated_by varchar [note: 'User or system that performed the last update.']
  valuation_reference_date date [note: 'Date used for mark‑to‑market valuation.']
  version varchar [note: 'Version number for change tracking.']
  created_by varchar [note: 'User or system that created the cycle.']

  Note: 'Master record defining a scheduled valuation cycle or reporting period for a portfolio, fund, or asset class. Captures cycle type (monthly, quarterly, annual), cycle start and end dates, valuation reference date, cycle status (open, in-progress'
}

Table valuation.dcf_model {
  dcf_model_id varchar [pk, note: 'Unique identifier for the DCF model record.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD requires climate scenario analysis in valuations. DCF models must stress-test cash flows against temperature pathways (1.5°C, 2°C scenarios).']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: DCF valuations must be stress-tested under base/upside/downside economic scenarios per pension fund risk management and regulatory requirements.']
  fdd_assessment_id varchar [note: 'Foreign key linking to diligence.fdd_assessment. Business justification: DCF models incorporate normalized EBITDA, QoE adjustments, and working capital peg from FDD assessment.']
  macro_model_id varchar [note: 'Foreign key linking to research.macro_model. Business justification: DCF models for private assets consume macroeconomic projections (GDP, inflation, discount rates) from research macro models.']
  model_created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: DCF models require creator tracking for model governance and audit. model_created_by_user is text; proper FK needed for employee accountability in valuation model management.']
  model_portfolio_id varchar [note: 'Identifier of the portfolio the model is associated with.']
  stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: DCF models for private assets must be stress-tested under regulatory scenarios (climate, market crash).']
  valuation_asset_valuation_id varchar [note: 'Identifier of the asset the model is applied to.']
  model_asset_code varchar [note: 'Identifier of the asset the model is applied to.']
  model_author varchar [note: 'Name of the person who created the model.']
  model_code varchar [note: 'Alphanumeric code identifying the DCF model.']
  model_confidence_level varchar [note: 'Confidence level of the model outputs.']
  model_created_by_user varchar [note: 'User who created the model.']
  model_creation_date date [note: 'Date the model was first created.']
  model_currency varchar [note: 'Currency of the valuation amount. [ENUM-REF-CANDIDATE: USD|EUR|GBP|JPY|CHF|CAD|AUD — promote to reference product]']
  model_description varchar [note: 'Detailed description of the DCF model.']
  model_discount_rate decimal(5,4) [note: 'Discount rate applied to future cash flows.']
  model_effective_from date [note: 'Date the model becomes effective.']
  model_effective_until date [note: 'Date the model ceases to be effective.']
  model_external_reference varchar [note: 'External reference identifier for the model.']
  model_file_path varchar [note: 'Filesystem path to the model file.']
  model_hash varchar [note: 'Hash of the model file for integrity.']
  model_is_active boolean [note: 'Flag indicating if the model is currently active.']
  model_is_approved boolean [note: 'Flag indicating if the model has been approved.']
  model_is_archived boolean [note: 'Flag indicating if the model has been archived.']
  model_is_draft boolean [note: 'Flag indicating if the model is in draft state.']
  model_is_validated boolean [note: 'Flag indicating if the model has been validated.']
  model_last_updated date [note: 'Date the model was last updated.']
  model_name varchar [note: 'Human-readable name of the DCF model.']
  model_notes varchar [note: 'Additional notes or comments about the model.']
  model_projected_free_cash_flow decimal(18,2) [note: 'Projected free cash flow for each year.']
  model_projection_horizon_years varchar [note: 'Number of years the model projects cash flows.']
  model_risk_category varchar [note: 'Category of risk associated with the model.']
  model_risk_rating varchar [note: 'Risk rating assigned to the model.']
  model_source_system varchar [note: 'Originating system of the model data. [ENUM-REF-CANDIDATE: SimCorp|BlackRock|Bloomberg|StateStreet|eFront|DealCloud|MSCI|CharlesRiver|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]']
  model_status varchar [note: 'Current lifecycle status of the DCF model.']
  model_terminal_growth_rate decimal(5,4) [note: 'Assumed perpetual growth rate after projection horizon.']
  model_termination_date date [note: 'Date the model was terminated.']
  model_termination_reason varchar [note: 'Reason for terminating the model.']
  model_type varchar [note: 'Category of the model (e.g., Equity, Debt, Real Estate). [ENUM-REF-CANDIDATE: Equity|Debt|RealEstate|Infrastructure|PrivateEquity|Credit|Portfolio — promote to reference product]']
  model_updated_by_user varchar [note: 'User who last updated the model.']
  model_valuation_amount decimal(18,2) [note: 'Valuation amount derived from the DCF model.']
  model_valuation_date date [note: 'Date on which the valuation was performed.']
  model_valuation_method varchar [note: 'Method used to derive the valuation.']
  model_valuation_notes varchar [note: 'Additional notes on the valuation.']
  model_valuation_source varchar [note: 'Source of the valuation data.']
  model_version varchar [note: 'Version identifier of the DCF model.']
  model_wacc decimal(5,4) [note: 'Weighted average cost of capital used in discounting.']

  Note: 'Proprietary Discounted Cash Flow (DCF) model record for an investment asset or portfolio company. Stores model version, projection horizon (years), terminal growth rate, WACC (Weighted Average Cost of Capital), discount rate, projected free cash flow'
}

Table valuation.wacc_calculation {
  wacc_calculation_id varchar [pk, note: 'Unique identifier for the WACC calculation record.']
  capital_market_assumption_id varchar [note: 'Foreign key linking to research.capital_market_assumption. Business justification: WACC calculations directly consume capital market assumptions (risk-free rate, equity risk premium, cost of debt).']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Climate risk premiums affect cost of capital. WACC calculations must incorporate transition risk severity from climate scenarios.']
  dcf_model_id varchar [note: 'Foreign key linking to valuation.dcf_model. Business justification: WACC calculations are used as inputs to DCF models. A DCF model references a specific WACC calculation for its discount rate.']
  fee_calculation_run_id varchar [note: 'Unique code for the specific calculation run instance.']
  portfolio_id varchar [note: 'Identifier of the portfolio containing the asset.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle during which the calculation was performed.']
  asset_code varchar [note: 'Identifier of the asset for which the WACC was calculated.']
  calculation_currency varchar [note: 'ISO 4217 currency code for the calculation.']
  calculation_end_timestamp timestamp [note: 'Timestamp when the calculation finished processing.']
  calculation_method varchar [note: 'Methodology used for the WACC calculation.']
  calculation_model_version varchar [note: 'Version identifier of the calculation model.']
  calculation_notes varchar [note: 'Free-text notes or comments about the calculation.']
  calculation_source varchar [note: 'System or source that performed the calculation.']
  calculation_start_timestamp timestamp [note: 'Timestamp when the calculation started processing.']
  calculation_status varchar [note: 'Current lifecycle status of the calculation process.']
  calculation_timestamp timestamp [note: 'Timestamp when the calculation was executed.']
  cost_of_debt_rate decimal(10,6) [note: 'Cost of debt component of the WACC.']
  cost_of_equity_rate decimal(10,6) [note: 'Cost of equity component of the WACC.']
  created_at timestamp [note: 'Timestamp when the record was first created in the system.']
  debt_weight decimal(5,4) [note: 'Proportion of debt in the capital structure.']
  equity_weight decimal(5,4) [note: 'Proportion of equity in the capital structure.']
  record_audit_created timestamp [note: 'Audit timestamp for record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp for record update.']
  tax_rate decimal(5,4) [note: 'Effective tax rate applied to the calculation.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']
  valuation_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  valuation_source_code varchar [note: 'Identifier of the source used for valuation data.']
  valuation_source_description varchar [note: 'Description of the valuation source.']
  valuation_source_name varchar [note: 'Name of the valuation source.']
  wacc_rate decimal(10,6) [note: 'Weighted average cost of capital expressed as a percentage.']

  Note: 'Record of a WACC (Weighted Average Cost of Capital) calculation performed for a specific asset, portfolio company, or investment vehicle at a point in time.'
}

Table valuation.fair_value_hierarchy {
  fair_value_hierarchy_id varchar [pk, note: 'Primary key for the fair value hierarchy classification record.']
  hierarchy_parent_fair_value_hierarchy_id varchar [note: 'Reference to a parent hierarchy level for nested structures.']
  created_at timestamp [note: 'Timestamp when the record was first created.']
  effective_from date [note: 'Date when the hierarchy level becomes effective.']
  effective_until date [note: 'Date when the hierarchy level ceases to be effective.']
  fair_value_hierarchy_description varchar [note: 'Detailed description of the hierarchy level and its application.']
  fair_value_hierarchy_status varchar [note: 'Current operational status of the hierarchy record.']
  hierarchy_code varchar [note: 'Unique alphanumeric code identifying the hierarchy level.']
  hierarchy_level varchar [note: 'Numeric indicator of the fair value hierarchy level (1, 2, or 3).']
  hierarchy_name varchar [note: 'Human‑readable name of the hierarchy level.']
  hierarchy_order varchar [note: 'Ordering of hierarchy levels within a list.']
  hierarchy_path varchar [note: 'Delimited path representing the hierarchy lineage.']
  hierarchy_type varchar [note: 'Descriptive type of the hierarchy level as defined by IFRS 13.']
  is_default boolean [note: 'Flag indicating if this level is the default selection.']
  notes varchar [note: 'Additional remarks or context for the hierarchy level.']
  source_system_code varchar [note: 'Identifier of the record in the source system.']
  source_system_version varchar [note: 'Version of the source system record.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the record.']
  version varchar [note: 'Version number of the hierarchy record for change tracking.']

  Note: 'Reference classification record defining the IFRS 13 / ASC 820 fair value hierarchy levels applied to asset valuations. Captures hierarchy level (Level 1 — quoted prices in active markets, Level 2 — observable inputs, Level 3 — unobservable/model-based'
}

Table valuation.indep_valuation_engagement {
  indep_valuation_engagement_id varchar [pk, note: 'Globally unique identifier for the independent valuation engagement record.']
  actor_id varchar [note: 'Identifier of the independent valuation agent.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Mandate/LPA terms often require independent third-party valuations for illiquid private assets annually.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Independent valuations are mandated by specific regulators (FCA, SEC). Pension funds track which regulatory authority requires the independent valuation engagement.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: An independent engagement is performed for a specific asset valuation; linking provides traceability.']
  engagement_agent_address varchar [note: 'Physical address of the agent\'s office.']
  engagement_agent_contact varchar [note: 'Primary contact person for the agent.']
  engagement_agent_email varchar [note: 'Primary email address for the agent.']
  engagement_agent_legal_entity_address varchar [note: 'Physical address of the legal entity.']
  engagement_agent_legal_entity_code varchar [note: 'Identifier of the agent\'s legal entity.']
  engagement_agent_legal_entity_country varchar [note: 'ISO 3166-1 alpha-3 country code of the legal entity.']
  engagement_agent_legal_entity_email varchar [note: 'Email address of the legal entity.']
  engagement_agent_legal_entity_name varchar [note: 'Legal name of the agent\'s entity.']
  engagement_agent_legal_entity_phone varchar [note: 'Phone number of the legal entity.']
  engagement_agent_legal_entity_type varchar [note: 'Type of the legal entity.']
  engagement_agent_phone varchar [note: 'Primary phone number for the agent.']
  engagement_agent_tax_number varchar [note: 'Tax identification number of the legal entity.']
  engagement_agent_type varchar [note: 'Classification of the agent: independent, firm, or consulting.']
  engagement_description varchar [note: 'Brief description of the engagement purpose and scope.']
  engagement_end_date date [note: 'Date when the engagement terminates or expires.']
  engagement_fee decimal(18,2) [note: 'Total fee charged for the engagement in the base currency.']
  engagement_fee_currency varchar [note: 'ISO 4217 currency code for the engagement fee.']
  engagement_fee_due_amount decimal(18,2) [note: 'Amount due for the fee on the due date.']
  engagement_fee_due_currency varchar [note: 'Currency code for the fee due amount.']
  engagement_fee_due_date date [note: 'Date when the fee is due for payment.']
  engagement_fee_paid_amount decimal(18,2) [note: 'Amount paid for the fee.']
  engagement_fee_paid_currency varchar [note: 'Currency code for the paid fee amount.']
  engagement_fee_paid_date date [note: 'Date when the fee was actually paid.']
  engagement_fee_rate decimal(18,6) [note: 'Rate applied to the fee calculation, if applicable.']
  engagement_fee_rate_unit varchar [note: 'Unit of measure for the fee rate.']
  engagement_fee_schedule varchar [note: 'Description of the fee payment schedule.']
  engagement_fee_type varchar [note: 'Nature of the fee: fixed, hourly, or retainer.']
  engagement_name varchar [note: 'Human-readable name of the engagement.']
  engagement_number varchar [note: 'External reference number assigned to the engagement by the pension fund.']
  engagement_scope varchar [note: 'High-level description of the assets or portfolio covered by the engagement.']
  engagement_scope_amount decimal(18,2) [note: 'Monetary value of the scope in the engagement\'s base currency.']
  engagement_scope_currency varchar [note: 'ISO 4217 currency code for the scope amount.']
  engagement_scope_description varchar [note: 'Detailed description of the scope of the engagement.']
  engagement_scope_type varchar [note: 'Classification of the scope: asset, portfolio, or fund.']
  engagement_start_date date [note: 'Date when the engagement becomes effective.']
  engagement_status varchar [note: 'Current lifecycle state of the engagement.']
  engagement_status_reason varchar [note: 'Reason for the current engagement status, if applicable.']
  engagement_type varchar [note: 'Category of the engagement, e.g., valuation, appraisal, or audit.']
  record_audit_created timestamp [note: 'Timestamp when the record was first created.']
  record_audit_updated timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Master record for an engagement with an independent external valuation agent or appraiser (including licensed real estate appraisers) for a specific asset or portfolio.'
}

Table valuation.adjustment {
  adjustment_id varchar [pk, note: 'Unique system-generated identifier for the adjustment record.']
  audit_finding_id varchar [note: 'Foreign key linking to compliance.audit_finding. Business justification: Valuation adjustments often result from audit findings. Pension funds must track which adjustments remediate specific audit observations for regulatory reporting.']
  cycle_id varchar [note: 'Identifier of the valuation cycle associated with the adjustment.']
  rule_breach_id varchar [note: 'Foreign key linking to compliance.rule_breach. Business justification: Valuation adjustments may be required to remediate compliance rule breaches. Links corrective valuation actions to the triggering breach for audit trail.']
  valuation_asset_valuation_id varchar [note: 'Identifier of the valuation to which this adjustment applies.']
  valuation_document_id varchar [note: 'Identifier of the supporting document for the adjustment.']
  adjustment_date timestamp [note: 'Date and time when the adjustment was applied to the valuation.']
  adjustment_status varchar [note: 'Current lifecycle state of the adjustment record.']
  adjustment_type varchar [note: 'Category of the valuation adjustment applied to the base asset valuation.']
  amount decimal(18,4) [note: 'Monetary value of the adjustment applied to the valuation.']
  approved_at timestamp [note: 'Timestamp when the adjustment was approved by the governance process.']
  approved_by varchar [note: 'Identifier of the user who approved the adjustment.']
  approved_by_name varchar [note: 'Name of the user who approved the adjustment.']
  created_at timestamp [note: 'Timestamp when the adjustment record was first created.']
  currency varchar [note: 'ISO 4217 currency code for the adjustment amount.']
  cycle_frequency varchar [note: 'Frequency of the valuation cycle (e.g., monthly, quarterly).']
  effective_from date [note: 'Date from which the adjustment becomes effective.']
  effective_until date [note: 'Date until which the adjustment remains effective.']
  is_active boolean [note: 'Flag indicating if the adjustment is currently active.']
  is_approved boolean [note: 'Flag indicating if the adjustment has been approved.']
  is_draft boolean [note: 'Flag indicating if the adjustment is in draft state.']
  is_finalized boolean [note: 'Flag indicating if the adjustment has been finalized.']
  is_locked boolean [note: 'Flag indicating if the adjustment record is locked from edits.']
  reason varchar [note: 'Narrative explanation of why the adjustment was applied.']
  reference varchar [note: 'Business reference number used to identify the adjustment in external systems.']
  source_system_code varchar [note: 'Identifier of the source system.']
  source_system_description varchar [note: 'Description of the source system.']
  source_system_name varchar [note: 'Name of the source system.']
  source_system_version varchar [note: 'Version of the source system.']
  updated_at timestamp [note: 'Timestamp of the most recent modification to the adjustment record.']
  version varchar [note: 'Version number of the adjustment record for change tracking.']

  Note: 'Record of a specific valuation adjustment applied to a base asset valuation. Captures adjustment type (liquidity discount, control premium, minority discount, credit risk adjustment, FX translation adjustment, model overlay), adjustment amount, adjustment'
}

Table valuation.market_price_snapshot {
  market_price_snapshot_id varchar [pk, note: 'Unique identifier for the market price snapshot record.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Market price snapshots must link to instrument master for price validation, NAV calculation, and best execution analysis.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Each market price snapshot is for a specific asset; linking to valuation allows correlation of price data.']
  ask_price decimal(18,6) [note: 'Ask price of the instrument at the snapshot time.']
  asset_category varchar [note: 'Category of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  asset_class varchar [note: 'Class of the asset (e.g., equity, fixed income). [ENUM-REF-CANDIDATE: equity|fixed_income|real_estate|private_equity|infrastructure|natural_resources|credit|cash — promote to reference product]']
  asset_currency varchar [note: 'ISO 4217 currency code for the asset.']
  asset_sector varchar [note: 'Sector of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  asset_subclass varchar [note: 'Subclass of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  bid_price decimal(18,6) [note: 'Bid price of the instrument at the snapshot time.']
  closing_price decimal(18,6) [note: 'Closing price of the instrument at the snapshot time.']
  cusip varchar [note: 'CUSIP identifier for the instrument.']
  exchange_code varchar [note: 'Code of the exchange where the instrument trades.']
  exchange_name varchar [note: 'Name of the exchange where the instrument trades.']
  high_price decimal(18,6) [note: 'High price of the instrument during the snapshot period.']
  instrument_type varchar [note: 'Category of the instrument (e.g., equity, bond, derivative). [ENUM-REF-CANDIDATE: equity|bond|derivative|fund|real_estate|private_equity|credit|cash|commodity — promote to reference product]']
  isin varchar [note: 'International Securities Identification Number for the instrument.']
  last_traded_price decimal(18,6) [note: 'Last traded price of the instrument at the snapshot time.']
  lei varchar [note: 'Legal Entity Identifier for the instrument issuer.']
  low_price decimal(18,6) [note: 'Low price of the instrument during the snapshot period.']
  market varchar [note: 'Market type of the instrument (equity, fixed income, etc.). [ENUM-REF-CANDIDATE: equity|fixed_income|real_estate|private_equity|infrastructure|natural_resources|credit|cash — promote to reference product]']
  mid_price decimal(18,6) [note: 'Mid price of the instrument at the snapshot time.']
  open_price decimal(18,6) [note: 'Opening price of the instrument at the snapshot time.']
  price_source_system varchar [note: 'System that provided the price data. [ENUM-REF-CANDIDATE: Bloomberg|FactSet|Aladdin|State_Street|eFront|DealCloud|MSCI|Charles_River|Oracle|SAP|Diligent|Preqin|PitchBook — promote to reference product]']
  price_source_system_address varchar [note: 'Contact address for the price source system.']
  price_source_system_code varchar [note: 'Identifier of the price source system.']
  price_source_system_contact varchar [note: 'Contact name for the price source system.']
  price_source_system_country varchar [note: 'ISO 3166 country code of the price source system.']
  price_source_system_description varchar [note: 'Description of the price source system.']
  price_source_system_effective_from date [note: 'Date when the price source system became effective.']
  price_source_system_effective_until date [note: 'Date when the price source system ceased to be effective.']
  price_source_system_email varchar [note: 'Contact email for the price source system.']
  price_source_system_license varchar [note: 'License type for the price source system (commercial, subscription, free).']
  price_source_system_license_expiry date [note: 'Date when the license for the price source system expires.']
  price_source_system_notes varchar [note: 'Additional notes about the price source system.']
  price_source_system_phone varchar [note: 'Contact phone for the price source system.']
  price_source_system_rating varchar [note: 'Rating of the price source system (A|B|C|D|E|F).']
  price_source_system_reference varchar [note: 'Reference identifier for the price source system.']
  price_source_system_status varchar [note: 'Operational status of the price source system (active, inactive, deprecated).']
  price_source_system_type varchar [note: 'Type of the price source system (DataFeed, API, WebService, Manual).']
  price_source_system_version varchar [note: 'Version of the price source system.']
  price_source_system_website varchar [note: 'Website URL of the price source system.']
  price_source_timestamp timestamp [note: 'Timestamp when the price was captured by the source system.']
  price_timestamp timestamp [note: 'Timestamp of the market price snapshot.']
  sedol varchar [note: 'SEDOL identifier for the instrument.']
  trade_count varchar [note: 'Number of trades of the instrument during the snapshot period.']
  volume varchar [note: 'Trade volume of the instrument during the snapshot period.']

  Note: 'Point-in-time market price record for a liquid security or instrument sourced from Bloomberg, FactSet, or exchange feeds. Captures ISIN, CUSIP, SEDOL, instrument type, exchange, bid price, ask price, mid price, last traded price, closing price, price'
}

Table valuation.comparable_transaction {
  comparable_transaction_id varchar [pk, note: 'Unique identifier for the comparable transaction record.']
  actor_id varchar [note: 'Identifier of the valuation agent or firm.']
  adjustment_id varchar [note: 'Identifier of the supporting document.']
  methodology_id varchar [note: 'Foreign key linking to valuation.methodology. Business justification: Comparable transactions use approved valuation methodologies. The transaction_valuation_method string attribute can be normalized by linking to the methodology reference table which']
  transaction_valuation_agent_legal_entity_id varchar [note: 'Legal entity identifier of the valuation agent.']
  transaction_valuation_cycle_id varchar [note: 'Identifier of the valuation cycle or period.']
  ebitda decimal(38,2) [note: 'Earnings before interest, taxes, depreciation, and amortization of the target.']
  enterprise_value decimal(38,2) [note: 'Enterprise value of the target company at transaction date.']
  record_audit_created timestamp [note: 'Timestamp when the record was first created.']
  record_audit_updated timestamp [note: 'Timestamp when the record was last updated.']
  transaction_amount_gross decimal(38,2) [note: 'Gross monetary value of the transaction before fees and taxes.']
  transaction_amount_net decimal(38,2) [note: 'Net monetary value after fees, taxes, and discounts.']
  transaction_currency varchar [note: 'ISO 4217 currency code for transaction amounts.']
  transaction_date date [note: 'Date on which the transaction occurred.']
  transaction_discount decimal(38,2) [note: 'Discount applied to the transaction price.']
  transaction_document_code varchar [note: 'Identifier of the supporting document.']
  transaction_document_date date [note: 'Date the supporting document was created.']
  transaction_document_hash varchar [note: 'Cryptographic hash of the supporting document.']
  transaction_document_status varchar [note: 'Current status of the supporting document.']
  transaction_document_type varchar [note: 'File format of the supporting document.']
  transaction_document_url varchar [note: 'URL to access the supporting document.']
  transaction_document_version varchar [note: 'Version identifier of the supporting document.']
  transaction_fee decimal(38,2) [note: 'Transaction fee or commission paid.']
  transaction_identifier varchar [note: 'Human-readable identifier for the comparable transaction.']
  transaction_market varchar [note: 'Market segment where the transaction took place.']
  transaction_market_code varchar [note: 'Standard code identifying the market segment.']
  transaction_market_type varchar [note: 'Classification of the market: equity, private equity, real estate, infrastructure, or credit.']
  transaction_source_code varchar [note: 'Identifier within the source system.']
  transaction_source_system varchar [note: 'System that originated the transaction record.']
  transaction_status varchar [note: 'Current workflow state of the transaction record.']
  transaction_subtype varchar [note: 'Specific subtype within the transaction type, e.g., acquisition, divestiture.']
  transaction_tax decimal(38,2) [note: 'Tax amount associated with the transaction.']
  transaction_time timestamp [note: 'Precise timestamp of the transaction event.']
  transaction_type varchar [note: 'Category of the transaction such as M&A, secondary sale, IPO, or recapitalization.']
  transaction_valuation_agent_legal_entity_name varchar [note: 'Legal entity name of the valuation agent.']
  transaction_valuation_agent_legal_entity_type varchar [note: 'Legal entity type of the valuation agent, e.g., corporation, partnership.']
  transaction_valuation_agent_type varchar [note: 'Type of valuation agent, e.g., independent, internal.']
  transaction_valuation_comments varchar [note: 'Additional comments or notes on the valuation.']
  transaction_valuation_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  transaction_valuation_engine varchar [note: 'Engine or platform that performed the valuation.']
  transaction_valuation_reason varchar [note: 'Reason for the valuation, e.g., due diligence, audit.']
  transaction_valuation_source_code varchar [note: 'Identifier of the source of valuation data.']
  transaction_valuation_source_description varchar [note: 'Description of the valuation source.']
  transaction_valuation_source_name varchar [note: 'Name of the source of valuation data.']
  transaction_valuation_status varchar [note: 'Current status of the valuation process.']

  Note: 'Record of a market comparable transaction used as a valuation reference for an illiquid asset. Captures the comparable company or asset name, transaction date, transaction type (M&A, secondary sale, IPO, recapitalization), enterprise value, EBITDA'
}

Table valuation.methodology {
  methodology_id varchar [pk, note: 'Unique identifier for the valuation methodology.']
  adjustment_id varchar [note: 'Identifier of the associated valuation document.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Valuation methodologies must comply with specific regulatory requirements (IFRS 13, GIPS). Links methodology to the governing regulatory authority for compliance tracking.']
  applicable_asset_category varchar [note: 'Category of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  applicable_asset_class varchar [note: 'Asset class the methodology applies to. [ENUM-REF-CANDIDATE: public_equities|private_equities|real_estate|infrastructure|natural_resources|credit|fixed_income|private_equity|co_investment|real_estate|infrastructure|natural_resources|credit|fixed_income —']
  applicable_asset_currency varchar [note: 'ISO 4217 currency code for the asset.']
  applicable_asset_sector varchar [note: 'Sector of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  applicable_asset_subclass varchar [note: 'Subclass of the asset class. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  applicable_asset_type varchar [note: 'Type of the asset. [ENUM-REF-CANDIDATE: ... — promote to reference product]']
  created_at timestamp [note: 'Timestamp when the methodology record was first created.']
  document_code varchar [note: 'Identifier of the associated valuation document.']
  document_created_at timestamp [note: 'Timestamp when the document was created.']
  document_created_by varchar [note: 'User who created the document.']
  document_date date [note: 'Date the document was created or published.']
  document_description varchar [note: 'Description of the document contents.']
  document_hash varchar [note: 'Cryptographic hash of the document for integrity.']
  document_hash_algorithm varchar [note: 'Algorithm used to generate the document hash.']
  document_notes varchar [note: 'Additional notes about the document.']
  document_reference varchar [note: 'Reference identifier for the document in external systems.']
  document_signed_at timestamp [note: 'Timestamp when the document was signed.']
  document_signed_by varchar [note: 'Name of the person who signed the document.']
  document_signed_by_address varchar [note: 'Physical address of the signer.']
  document_signed_by_department varchar [note: 'Department of the signer.']
  document_signed_by_email varchar [note: 'Email address of the signer.']
  document_signed_by_identifier varchar [note: 'Unique identifier for the signer.']
  document_signed_by_identifier_type varchar [note: 'Type of identifier (e.g., employee_id, external_id).']
  document_signed_by_identifier_value decimal(18,2) [note: 'Value of the signer\'s identifier.']
  document_signed_by_phone varchar [note: 'Phone number of the signer.']
  document_signed_by_role varchar [note: 'Role of the signer (e.g., Analyst, Manager).']
  document_signed_by_title varchar [note: 'Job title of the signer.']
  document_source_system varchar [note: 'System that created the document.']
  document_status varchar [note: 'Lifecycle status of the document.']
  document_type varchar [note: 'File format of the document.']
  document_updated_at timestamp [note: 'Timestamp of the most recent document update.']
  document_updated_by varchar [note: 'User who last updated the document.']
  document_url varchar [note: 'URL to access the valuation methodology document.']
  document_version varchar [note: 'Version number of the document.']
  effective_from date [note: 'Date the methodology becomes effective.']
  effective_until date [note: 'Date the methodology ceases to be effective (nullable).']
  methodology_code varchar [note: 'External code used to reference the methodology.']
  methodology_description varchar [note: 'Detailed description of the methodology and its use.']
  methodology_name varchar [note: 'Human‑readable name of the valuation methodology.']
  methodology_status varchar [note: 'Current lifecycle status of the methodology.']
  methodology_type varchar [note: 'Type of valuation method (DCF, EV/EBITDA, NAV, broker quote, recent transaction, replacement cost, income capitalization). [ENUM-REF-CANDIDATE: DCF|EV/EBITDA|NAV|broker_quote|recent_transaction|replacement_cost|income_capitalization — promote to reference']
  notes varchar [note: 'Free‑text notes about the methodology.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the methodology record.']
  version varchar [note: 'Version identifier for the methodology definition.']

  Note: 'Reference record defining approved valuation methodologies available for use across asset classes. Captures methodology name (DCF, EV/EBITDA multiple, NAV, broker quote, recent transaction price, replacement cost, income capitalization), applicable asset'
}

Table valuation.valuation_policy {
  valuation_policy_id varchar [pk, note: 'Unique identifier for the valuation policy record.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Valuation policies are governed by regulatory requirements. Pension funds must track which authority\'s rules govern each policy for compliance certification.']
  approval_required boolean [note: 'Flag indicating if policy approval is required.']
  approval_required_reason varchar [note: 'Reason for requiring approval.']
  created_at timestamp [note: 'Timestamp when the policy record was created.']
  document_date date [note: 'Date of the policy document.']
  document_description varchar [note: 'Description of the policy document.']
  document_hash varchar [note: 'Hash of the policy document for integrity.']
  document_reference varchar [note: 'Reference identifier for the policy document.']
  document_signed_at timestamp [note: 'Timestamp when the document was signed.']
  document_signed_by varchar [note: 'Name of the person who signed the document.']
  document_source_system varchar [note: 'System where the policy document originates.']
  document_source_system_code varchar [note: 'Identifier of the source system.']
  document_source_system_created_at timestamp [note: 'Timestamp when the source system record was created.']
  document_source_system_description varchar [note: 'Description of the source system.']
  document_source_system_name varchar [note: 'Name of the source system.']
  document_source_system_status varchar [note: 'Current status of the source system.']
  document_source_system_type varchar [note: 'Type of source system. [ENUM-REF-CANDIDATE: SimCorp|BlackRock|Bloomberg|StateStreet|eFront|DealCloud|MSCI|CharlesRiver|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]']
  document_source_system_updated_at timestamp [note: 'Timestamp when the source system record was last updated.']
  document_source_system_version varchar [note: 'Version of the source system.']
  document_status varchar [note: 'Current status of the policy document.']
  document_type varchar [note: 'File type of the policy document.']
  document_url varchar [note: 'URL to the policy document.']
  document_version varchar [note: 'Version of the policy document.']
  effective_from date [note: 'Date when the policy becomes effective.']
  effective_until date [note: 'Date when the policy expires or is no longer effective.']
  hierarchy_rules varchar [note: 'Rules for assigning fair value hierarchy levels.']
  independent_valuation_reason varchar [note: 'Reason for requiring independent valuation.']
  independent_valuation_required boolean [note: 'Flag indicating if independent valuation is required.']
  methodology varchar [note: 'Methodology used for valuation.']
  methodology_description varchar [note: 'Description of the valuation methodology.']
  policy_name varchar [note: 'Human-readable name of the valuation policy.']
  policy_scope varchar [note: 'Scope of the policy (e.g., asset classes, funds).']
  policy_status varchar [note: 'Current lifecycle status of the policy.']
  policy_type varchar [note: 'Category of the valuation policy.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of record update.']
  scope_description varchar [note: 'Detailed description of the policy scope.']
  scope_type varchar [note: 'Type of scope for the policy.']
  updated_at timestamp [note: 'Timestamp when the policy record was last updated.']
  version varchar [note: 'Version identifier of the policy.']

  Note: 'Master record for the firm\'s formal valuation policy governing fair value determination across asset classes. Captures policy version, effective date, expiry date, asset class scope, approved methodologies, hierarchy level assignment rules, independent'
}

Table valuation.valuation_review {
  valuation_review_id varchar [pk, note: 'Unique identifier for the valuation review record.']
  analyst_assignment_id varchar [note: 'Foreign key linking to research.analyst_assignment. Business justification: Valuation reviews should link to the research analyst assignment covering the asset for accountability tracking.']
  approver_employee_id varchar [note: 'Identifier of the party who approved the review.']
  approver_id varchar [note: 'Identifier of the party who approved the review.']
  cycle_id varchar [note: 'Identifier of the review cycle or period.']
  employee_id varchar [note: 'Identifier of the party who performed the review.']
  origination_source_id varchar [note: 'Identifier of the source system or origin of the review.']
  valuation_asset_valuation_id varchar [note: 'Identifier of the valuation record being reviewed.']
  valuation_document_id varchar [note: 'Foreign key linking to valuation.valuation_document. Business justification: Valuation reviews have document attributes (document_code, document_url, document_type, document_date, document_status) that can be normalized by linking to valuation_document.']
  valuation_employee_id varchar [note: 'Identifier of the party who performed the review.']
  approval_comments varchar [note: 'Comments provided during the approval.']
  approval_date timestamp [note: 'Timestamp when the review was approved.']
  approval_status varchar [note: 'Status of the approval process (approved, pending, rejected).']
  approver_name varchar [note: 'Full name of the approver.']
  comments varchar [note: 'Narrative comments or observations from the review.']
  created_at timestamp [note: 'Timestamp when the review record was first created.']
  cycle_frequency varchar [note: 'Frequency of the review cycle (monthly, quarterly, annual).']
  impact varchar [note: 'Business impact or action resulting from the review.']
  method_description varchar [note: 'Detailed description of the review methodology.']
  outcome varchar [note: 'Final outcome or decision of the review.']
  reason varchar [note: 'Business justification for initiating the review.']
  review_date timestamp [note: 'Timestamp when the review was initiated or conducted.']
  review_method varchar [note: 'Methodology used for the review (e.g., DCF, market comparison).']
  review_status varchar [note: 'Current lifecycle status of the review (e.g., draft, open, closed, approved, rejected).']
  review_type varchar [note: 'Classification of the review (internal, external, audit).']
  reviewer_name varchar [note: 'Full name of the reviewer.']
  source_description varchar [note: 'Description of the review source context.']
  source_name varchar [note: 'Name of the system or entity that generated the review.']
  status_date timestamp [note: 'Timestamp of the last status change for the review.']
  status_notes varchar [note: 'Additional notes related to status changes.']
  status_reason varchar [note: 'Reason for the current review status.']
  updated_at timestamp [note: 'Timestamp of the most recent update to the review record.']
  valuation_comments varchar [note: 'Narrative comments on the valuation.']
  valuation_date timestamp [note: 'Date of the valuation being reviewed.']
  valuation_document_code varchar [note: 'Identifier of the supporting document for the valuation.']
  valuation_document_date timestamp [note: 'Date the valuation document was created or finalized.']
  valuation_document_type varchar [note: 'Format of the valuation document (PDF, DOCX).']
  valuation_document_url varchar [note: 'Location of the valuation document.']
  valuation_method varchar [note: 'Method used for the valuation (DCF, market, book).']
  valuation_status varchar [note: 'Current status of the valuation (approved, pending, rejected).']

  Note: 'Record of a formal valuation review or challenge event conducted by the Valuation Committee, IC (Investment Committee), or external auditor for a specific asset valuation or NAV record.'
}

Table valuation.private_asset_valuation {
  private_asset_valuation_id varchar [pk, note: 'Unique identifier for the private asset valuation record.']
  actor_id varchar [note: 'Identifier of the valuation agent or firm.']
  adjustment_id varchar [note: 'Identifier of the valuation supporting document.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: Private asset valuation memos require reference to original DD engagement for acquisition basis, identified risks, and conditions precedent.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Private asset valuations (PE, infrastructure, real estate) require scenario analysis for IC presentations and regulatory stress testing.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Private equity/infrastructure valuations require ESG score integration per pension fund policies.']
  model_id varchar [note: 'Identifier of the DCF model used.']
  portfolio_id varchar [note: 'Identifier of the portfolio containing the asset.']
  valuation_asset_valuation_id varchar [note: 'Unique identifier for the asset being valued.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle.']
  asset_class varchar [note: 'Secondary classification of the asset (e.g., private equity, real estate).']
  asset_code varchar [note: 'Unique identifier for the asset being valued.']
  asset_currency varchar [note: 'ISO 4217 currency code for the asset valuation.']
  asset_isin varchar [note: 'International Securities Identification Number for the asset.']
  asset_name varchar [note: 'Legal name of the asset.']
  asset_type varchar [note: 'Primary classification of the asset (e.g., equity, debt).']
  book_value decimal(18,4) [note: 'Accounting book value of the asset.']
  cost_of_debt_rate decimal(5,4) [note: 'Cost of debt component in WACC calculation.']
  cost_of_equity_rate decimal(5,4) [note: 'Cost of equity component in WACC calculation.']
  debt_weight decimal(5,4) [note: 'Proportion of debt in the capital structure.']
  equity_weight decimal(5,4) [note: 'Proportion of equity in the capital structure.']
  fair_value decimal(18,4) [note: 'Estimated fair market value of the asset.']
  gav decimal(18,4) [note: 'Gross asset value of the portfolio at valuation date.']
  market_value decimal(18,4) [note: 'Observable market value if available.']
  nav decimal(18,4) [note: 'Net asset value of the portfolio at valuation date.']
  tax_rate decimal(5,4) [note: 'Applicable tax rate for the valuation.']
  valuation_comments varchar [note: 'Additional comments or notes on the valuation.']
  valuation_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  valuation_date date [note: 'Date on which the valuation was performed.']
  valuation_document_code varchar [note: 'Identifier of the valuation supporting document.']
  valuation_document_date date [note: 'Date the valuation document was created.']
  valuation_document_hash varchar [note: 'SHA-256 hash of the valuation document.']
  valuation_document_signed_at timestamp [note: 'Timestamp when the valuation document was signed.']
  valuation_document_signed_by varchar [note: 'Name of the person who signed the valuation document.']
  valuation_document_status varchar [note: 'Current status of the valuation document.']
  valuation_document_type varchar [note: 'File format of the valuation document.']
  valuation_document_url varchar [note: 'URL to access the valuation document.']
  valuation_document_version varchar [note: 'Version identifier of the valuation document.']
  valuation_engine varchar [note: 'System or tool used to compute the valuation.']
  valuation_method varchar [note: 'Method used to determine the asset\'s value.']
  valuation_reason varchar [note: 'Reason for initiating the valuation.']
  valuation_source_code varchar [note: 'Identifier of the source of valuation data.']
  valuation_source_description varchar [note: 'Description of the valuation source.']
  valuation_source_name varchar [note: 'Name of the source of valuation data.']
  valuation_status varchar [note: 'Current status of the valuation process.']
  valuation_time timestamp [note: 'Timestamp of the valuation event.']
  wacc_rate decimal(5,4) [note: 'Weighted average cost of capital used in valuation.']

  Note: 'Specialized valuation record for illiquid private market assets (private equity, infrastructure, real estate, natural resources) where observable market prices are unavailable.'
}

Table valuation.broker_quote {
  broker_quote_id varchar [pk, note: 'Unique identifier for the broker quote record.']
  broker_id varchar [note: 'Unique identifier for the broker.']
  data_vendor_id varchar [note: 'Foreign key linking to research.data_vendor. Business justification: Broker quotes must track the data vendor source for data quality monitoring, vendor performance assessment, and regulatory audit trails.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Broker quotes must reference instrument master for quote aggregation, price discovery, and best execution compliance.']
  quote_source_id varchar [note: 'Identifier of the quote in the source system.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Broker quotes are Level 2 pricing inputs used in asset valuations. Linking broker_quote to valuation_asset_valuation enables tracking which quotes were used for a specific']
  ask_price decimal(18,6) [note: 'Ask price quoted by the broker.']
  ask_size decimal(18,6) [note: 'Ask size quoted by the broker.']
  bid_ask_spread decimal(18,6) [note: 'Spread between bid and ask prices.']
  bid_price decimal(18,6) [note: 'Bid price quoted by the broker.']
  bid_size decimal(18,6) [note: 'Bid size quoted by the broker.']
  broker_dealer_lei varchar [note: 'LEI of the broker\'s dealer entity.']
  broker_dealer_name varchar [note: 'Name of the broker\'s dealer entity.']
  mid_price decimal(18,6) [note: 'Mid price calculated from bid and ask.']
  quote_source_country varchar [note: 'Country of the quote source.']
  quote_source_exchange varchar [note: 'Exchange where the quote originates.']
  quote_source_market varchar [note: 'Market of the quote source.']
  quote_source_name varchar [note: 'Name of the source providing the quote.']
  quote_source_region varchar [note: 'Region of the quote source.']
  quote_source_system varchar [note: 'System that provided the quote.']
  quote_source_type varchar [note: 'Type of the quote source (e.g., Reuters, Bloomberg).']
  quote_status varchar [note: 'Current status of the quote (active, expired, cancelled).']
  quote_timestamp timestamp [note: 'Timestamp when the quote was received.']
  quote_type varchar [note: 'Type of the quote (indicative, firm, best).']
  quote_valid_from timestamp [note: 'Start of the quote\'s validity period.']
  quote_valid_to timestamp [note: 'End of the quote\'s validity period.']

  Note: 'Record of a broker or dealer price quote obtained for a security or instrument as a Level 2 pricing input. Captures instrument identifier (ISIN/CUSIP/SEDOL), broker/dealer name, LEI, quote date, bid price, ask price, mid price, quote type (indicative'
}

Table valuation.valuation_yield_curve {
  valuation_yield_curve_id varchar [pk, note: 'Unique identifier for the yield curve record.']
  research_yield_curve_id varchar [note: 'FK to research.research_yield_curve.research_yield_curve_id — DCF and fixed-income valuations must draw discount curves from the research market-data SSOT to ensure valuation and risk use identical curve inputs.']
  created_at timestamp [note: 'Timestamp when the record was created.']
  currency varchar [note: 'ISO 4217 currency code for the yield curve.']
  curve_code varchar [note: 'Unique code assigned to the yield curve.']
  curve_description varchar [note: 'Detailed description of the yield curve.']
  curve_name varchar [note: 'Human-readable name of the yield curve.']
  curve_notes varchar [note: 'Notes specific to the yield curve.']
  curve_source_code varchar [note: 'Identifier of the source of the yield curve.']
  curve_source_description varchar [note: 'Description of the source of the yield curve.']
  curve_source_name varchar [note: 'Name of the source of the yield curve.']
  curve_source_type varchar [note: 'Type of the source such as market data or internal model.']
  curve_source_url varchar [note: 'URL to access the source of the yield curve.']
  curve_type varchar [note: 'Category of the yield curve such as government or swap.']
  effective_from date [note: 'Date when the yield curve becomes effective.']
  effective_until date [note: 'Date when the yield curve expires.']
  is_active boolean [note: 'Indicates if the curve is currently active.']
  is_default boolean [note: 'Indicates if this curve is the default for its type.']
  is_public boolean [note: 'Indicates if the curve is publicly available.']
  notes varchar [note: 'Free-text notes about the yield curve.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of record update.']
  reference_date date [note: 'Date on which the yield curve is referenced.']
  remarks varchar [note: 'Additional remarks about the yield curve.']
  source_system_code varchar [note: 'Identifier of the source system record.']
  source_system_name varchar [note: 'Human-readable name of the source system.']
  source_system_type varchar [note: 'Type of the source system such as database or API.']
  source_system_url varchar [note: 'URL of the source system endpoint.']
  source_system_version varchar [note: 'Version of the source system used.']
  tags varchar [note: 'Comma-separated tags for categorization.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']
  valuation_yield_curve_status varchar [note: 'Current lifecycle status of the yield curve.']
  value_10y decimal(18,6) [note: 'Yield value for the 10-year tenor.']
  value_1y decimal(18,6) [note: 'Yield value for the 1-year tenor.']
  value_2y decimal(18,6) [note: 'Yield value for the 2-year tenor.']
  value_30y decimal(18,6) [note: 'Yield value for the 30-year tenor.']
  value_3m decimal(18,6) [note: 'Yield value for the 3-month tenor.']
  value_5y decimal(18,6) [note: 'Yield value for the 5-year tenor.']
  value_6m decimal(18,6) [note: 'Yield value for the 6-month tenor.']
  version varchar [note: 'Version number of the yield curve record.']

  Note: 'Reference record for a yield curve or discount rate curve used in fixed income and DCF valuations. Captures curve name, curve type (government, swap, credit spread, OAS), currency, reference date, tenor points (3M, 6M, 1Y, 2Y, 5Y, 10Y, 30Y), corresponding'
}

Table valuation.valuation_fx_rate {
  valuation_fx_rate_id varchar [pk, note: 'Unique identifier for the FX rate record.']
  base_currency varchar [note: 'ISO 4217 three-letter code of the base currency.']
  created_at timestamp [note: 'Timestamp when the record was created.']
  currency_pair varchar [note: 'Concatenated base and quote currency codes (e.g., USD/EUR).']
  effective_from date [note: 'Date from which the FX rate is effective.']
  effective_until date [note: 'Date until which the FX rate is effective.']
  forward_rate_12m decimal(20,10) [note: 'Forward exchange rate for twelve month maturity.']
  forward_rate_1m decimal(20,10) [note: 'Forward exchange rate for one month maturity.']
  forward_rate_3m decimal(20,10) [note: 'Forward exchange rate for three month maturity.']
  forward_rate_6m decimal(20,10) [note: 'Forward exchange rate for six month maturity.']
  quote_currency varchar [note: 'ISO 4217 three-letter code of the quote currency.']
  rate_date date [note: 'Date on which the FX rate is applicable.']
  rate_source varchar [note: 'Source of the FX rate data.']
  rate_source_description varchar [note: 'Detailed description of the rate source.']
  rate_status varchar [note: 'Current status of the FX rate record.']
  rate_type varchar [note: 'Type of rate: spot or forward.']
  rate_version varchar [note: 'Version number of the FX rate record.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of last record update.']
  remarks varchar [note: 'Additional notes or comments about the FX rate.']
  spot_rate decimal(20,10) [note: 'Current market spot exchange rate between base and quote currencies.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Reference record for foreign exchange (FX) rates used in multi-currency asset valuations and NAV translation. Captures base currency, quote currency, spot rate, forward rate (1M, 3M, 6M, 12M), rate date, rate source (Bloomberg, WM/Reuters fixing), and'
}

Table valuation.nav_liability {
  nav_liability_id varchar [pk, note: 'Unique identifier for the nav liability record.']
  adjustment_id varchar [note: 'Identifier of the document associated with the liability.']
  counterparty_id varchar [note: 'Identifier of the counterparty involved in the liability.']
  fund_id varchar [note: 'Identifier of the fund associated with the liability.']
  portfolio_id varchar [note: 'Identifier of the portfolio associated with the liability.']
  settlement_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: NAV liabilities (accrued fees, payables) settle through designated cash accounts. Pension fund controllers need this link for liability settlement tracking and cash flow projection']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle during which the liability is recorded.']
  valuation_nav_record_id varchar [note: 'Foreign key linking to valuation.valuation_nav_record. Business justification: NAV liabilities are deducted in NAV computation. Linking nav_liability to valuation_nav_record creates the relationship between the liability records and the NAV record they']
  counterparty_address varchar [note: 'Physical address of the counterparty.']
  counterparty_contact varchar [note: 'Primary contact person at the counterparty.']
  counterparty_email varchar [note: 'Email address of the counterparty contact.']
  counterparty_phone varchar [note: 'Phone number of the counterparty contact.']
  counterparty_type varchar [note: 'Classification of the counterparty.']
  created_at timestamp [note: 'Timestamp when the record was created.']
  effective_date date [note: 'Date when the liability becomes effective.']
  legal_entity_code varchar [note: 'Identifier of the legal entity associated with the liability.']
  liability_amount decimal(18,2) [note: 'Monetary amount of the liability.']
  liability_currency varchar [note: 'ISO 4217 currency code for the liability amount.']
  liability_date date [note: 'Date when the liability was incurred.']
  liability_document_code varchar [note: 'Identifier of the document associated with the liability.']
  liability_document_date date [note: 'Date the liability document was created.']
  liability_document_type varchar [note: 'File type of the liability document.']
  liability_document_url varchar [note: 'URL to access the liability document.']
  liability_document_version varchar [note: 'Version identifier of the liability document.']
  liability_subtype varchar [note: 'Further classification of the liability.']
  liability_type varchar [note: 'Classification of the liability type.']
  maturity_date date [note: 'Date when the liability matures or is due.']
  nav_liability_description varchar [note: 'Free-text description of the liability.']
  nav_liability_status varchar [note: 'Current status of the liability record.']
  notes varchar [note: 'Free-text notes related to the liability.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of last record update.']
  reference_number varchar [note: 'Internal reference number for the liability.']
  settlement_amount decimal(18,2) [note: 'Monetary amount settled for the liability.']
  settlement_currency varchar [note: 'ISO 4217 currency code for the settlement amount.']
  settlement_date date [note: 'Date when the liability was settled.']
  settlement_method varchar [note: 'Method used to settle the liability.']
  settlement_reference varchar [note: 'Reference number for the settlement transaction.']
  settlement_status varchar [note: 'Current status of the settlement.']
  source_system_code varchar [note: 'Identifier of the source system instance.']
  source_system_version varchar [note: 'Version of the source system.']
  tax_amount decimal(18,2) [note: 'Tax amount associated with the liability.']
  tax_code varchar [note: 'Tax code applicable to the liability.']
  tax_jurisdiction varchar [note: 'Country code for the tax jurisdiction.']
  tax_rate decimal(5,4) [note: 'Tax rate applied to the liability.']
  tax_type varchar [note: 'Type of tax applied to the liability.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']

  Note: 'Record of liabilities deducted in the NAV computation for a fund or investment vehicle. Captures liability type (management fees payable, carried interest accrual, redemptions payable, borrowings, derivatives MTM liability, tax provisions), liability'
}

Table valuation.input {
  input_id varchar [pk, note: 'Unique identifier for the valuation input record.']
  approval_by varchar [note: 'User or authority that approved the input.']
  approval_comments varchar [note: 'Comments or rationale for the approval decision.']
  approval_date date [note: 'Date when the input was approved.']
  created_at timestamp [note: 'Timestamp when the input record was first created.']
  effective_from date [note: 'Date from which the input is considered valid.']
  effective_until date [note: 'Date until which the input remains valid (nullable).']
  input_code varchar [note: 'Alphanumeric code used internally to reference the input.']
  input_description varchar [note: 'Detailed description of the input and its purpose.']
  input_name varchar [note: 'Human-readable name of the input, e.g., \'Revenue Growth Rate\'.']
  input_status varchar [note: 'Current lifecycle status of the input (e.g., active, deprecated).']
  input_type varchar [note: 'Category of the input, such as \'Rate\', \'Price\', \'Metric\'.']
  is_active boolean [note: 'Flag indicating if the input is currently active.']
  is_approved boolean [note: 'Flag indicating if the input has been approved for use.']
  is_confidential boolean [note: 'Flag indicating if the input contains confidential data.']
  is_default boolean [note: 'Flag indicating if the input is the default value for its type.']
  is_derived boolean [note: 'Flag indicating if the input is derived from other inputs.']
  is_required boolean [note: 'Flag indicating if the input is mandatory for valuation models.']
  remarks varchar [note: 'Additional remarks or notes about the input.']
  source varchar [note: 'Origin of the input data (e.g., internal model, market feed).']
  source_reference varchar [note: 'Reference identifier in the source system (e.g., model ID).']
  unit varchar [note: 'Unit of measure for the input value (e.g., % , USD).']
  updated_at timestamp [note: 'Timestamp of the most recent update to the input record.']
  updated_by varchar [note: 'User or system that last updated the input record.']
  value decimal(18,6) [note: 'Numerical value used in valuation calculations.']
  version varchar [note: 'Version number of the input record for change tracking.']
  created_by varchar [note: 'User or system that created the input record.']

  Note: 'Granular record of a specific quantitative input used in an asset valuation model. Captures input name (revenue growth rate, terminal growth rate, cap rate, NOI, LTV, DSCR, occupancy rate, commodity price), input value, input unit, source (internal model'
}

Table valuation.sensitivity {
  sensitivity_id varchar [pk, note: 'Unique identifier for the sensitivity analysis record.']
  actor_id varchar [note: 'Identifier of the valuation agent.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD mandates climate sensitivity analysis. Pension funds run valuation sensitivities against multiple temperature pathways to assess portfolio resilience.']
  created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Sensitivity analyses are created by employees. created_by_user is text; proper FK needed for audit trail and analyst accountability in risk assessment.']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: Sensitivity analyses test valuation impacts against specific macro indicators (interest rates, inflation, GDP growth).']
  model_id varchar [note: 'Identifier of the valuation model used.']
  valuation_asset_valuation_asset_valuation_id varchar [note: 'Identifier of the asset being valued.']
  valuation_asset_valuation_id varchar [note: 'Identifier of the asset being valued.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle.']
  base_case_value decimal(38,10) [note: 'Fair value under base case assumptions.']
  created_at timestamp [note: 'Timestamp when the record was created.']
  created_by_user varchar [note: 'User who created the record.']
  delta_value decimal(38,10) [note: 'Change in fair value due to sensitivity variable.']
  notes varchar [note: 'Additional notes about the sensitivity analysis.']
  percent_change decimal(38,10) [note: 'Percentage change in fair value relative to base case.']
  run_date date [note: 'Calendar date when the sensitivity run was initiated.']
  run_description varchar [note: 'Brief description of the sensitivity run purpose.']
  run_duration_seconds varchar [note: 'Total duration of the run in seconds.']
  run_engine_version varchar [note: 'Version of the engine that executed the run.']
  run_environment varchar [note: 'Execution environment for the run (e.g., production, test).']
  run_error_message varchar [note: 'Error message if the run failed.']
  run_notes varchar [note: 'Additional notes or comments about the run.']
  run_number varchar [note: 'Sequential number assigned to each sensitivity run.']
  run_source_system varchar [note: 'System that originated the run request.']
  run_source_system_description varchar [note: 'Description of the source system that triggered the run.']
  run_source_system_version varchar [note: 'Version of the source system that initiated the run.']
  run_status varchar [note: 'Current status of the sensitivity run.']
  run_timestamp timestamp [note: 'Exact timestamp of sensitivity run start.']
  sensitivity_description varchar [note: 'Detailed description of the sensitivity analysis.']
  sensitivity_status varchar [note: 'Current status of the sensitivity record.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']
  updated_by_user varchar [note: 'User who last updated the record.']
  valuation_engine varchar [note: 'Engine that performed the valuation.']
  valuation_method varchar [note: 'Method used for valuation.']
  valuation_source_code varchar [note: 'Identifier of the source of valuation data.']
  valuation_source_name varchar [note: 'Name of the valuation source.']
  valuation_source_status varchar [note: 'Lifecycle status of the valuation source.']
  valuation_source_type varchar [note: 'Type of the valuation source.']
  valuation_source_version varchar [note: 'Version of the valuation source.']
  variable varchar [note: 'Variable that was altered in the sensitivity analysis.']
  variable_value decimal(38,10) [note: 'Value of the variable used in the sensitivity run.']

  Note: 'Record of a sensitivity analysis run against a valuation model, capturing how the concluded fair value changes under alternative input assumptions. Captures the base case value, sensitivity variable (WACC, terminal growth rate, exit multiple, cap rate)'
}

Table valuation.real_estate_appraisal {
  real_estate_appraisal_id varchar [pk, note: 'Unique identifier for the real estate appraisal record.']
  property_id varchar [note: 'Unique identifier for the property being appraised.']
  real_adjustment_id varchar [note: 'Identifier of the appraisal report document.']
  real_property_valuation_document_adjustment_id varchar [note: 'Identifier of the property valuation document.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Real estate appraisals follow regulatory standards (RICS, USPAP). Pension funds track which regulatory body\'s standards govern each appraisal for compliance.']
  taxonomy_alignment_id varchar [note: 'Foreign key linking to esg.taxonomy_alignment. Business justification: EU Taxonomy alignment directly impacts real estate valuations. Green building certifications and energy efficiency ratings affect property values.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Real estate appraisals are specialized valuations that feed into the core asset valuation record.']
  appraisal_comments varchar [note: 'Additional comments from the appraiser.']
  appraisal_currency varchar [note: 'Currency used for the appraisal value.']
  appraisal_date date [note: 'Date the appraisal was completed.']
  appraisal_document_code varchar [note: 'Identifier of the appraisal report document.']
  appraisal_document_date date [note: 'Date the appraisal document was issued.']
  appraisal_document_hash varchar [note: 'Cryptographic hash of the appraisal document.']
  appraisal_document_signed_at timestamp [note: 'Timestamp when the appraisal document was signed.']
  appraisal_document_signed_by varchar [note: 'Name of the person who signed the appraisal document.']
  appraisal_document_status varchar [note: 'Current status of the appraisal document.']
  appraisal_document_type varchar [note: 'Format of the appraisal document (e.g., PDF).']
  appraisal_document_url varchar [note: 'URL to access the appraisal document.']
  appraisal_document_version varchar [note: 'Version number of the appraisal document.']
  appraisal_method varchar [note: 'Methodology used for the appraisal (e.g., income capitalization).']
  appraised_value decimal(19,4) [note: 'Monetary value assigned by the appraisal.']
  appraiser_firm varchar [note: 'Firm or organization of the appraiser.']
  appraiser_name varchar [note: 'Full name of the licensed appraiser.']
  property_address varchar [note: 'Street address of the property.']
  property_area_sqft decimal(19,4) [note: 'Total area of the property in square feet.']
  property_city varchar [note: 'City where the property is located.']
  property_country varchar [note: 'Country of the property.']
  property_ownership_type varchar [note: 'Ownership classification of the property.']
  property_state varchar [note: 'State or province of the property.']
  property_status varchar [note: 'Current lifecycle status of the property.']
  property_type varchar [note: 'Classification of the property (e.g., residential, commercial).']
  property_valuation_comments varchar [note: 'Additional comments related to the property valuation.']
  property_valuation_currency varchar [note: 'Currency used for the property valuation value.']
  property_valuation_date date [note: 'Date the property valuation was performed.']
  property_valuation_document_code varchar [note: 'Identifier of the property valuation document.']
  property_valuation_document_date date [note: 'Date the property valuation document was issued.']
  property_valuation_document_hash varchar [note: 'Cryptographic hash of the property valuation document.']
  property_valuation_document_signed_at timestamp [note: 'Timestamp when the property valuation document was signed.']
  property_valuation_document_signed_by varchar [note: 'Name of the person who signed the property valuation document.']
  property_valuation_document_status varchar [note: 'Current status of the property valuation document.']
  property_valuation_document_type varchar [note: 'Format of the property valuation document.']
  property_valuation_document_url varchar [note: 'URL to access the property valuation document.']
  property_valuation_document_version varchar [note: 'Version number of the property valuation document.']
  property_valuation_method varchar [note: 'Method used for the property valuation.']
  property_valuation_notes varchar [note: 'Notes related to the property valuation.']
  property_valuation_status varchar [note: 'Current status of the property valuation.']
  property_valuation_value decimal(19,4) [note: 'Monetary value assigned during property valuation.']
  property_year_built varchar [note: 'Year the property was constructed.']
  property_zip_code varchar [note: 'Postal code of the property.']

  Note: 'Specialized appraisal record for direct real estate holdings capturing property-level valuation outputs from licensed appraisers. Captures property identifier, appraiser firm, appraisal date, appraisal methodology (income capitalization, discounted cash'
}

Table valuation.infrastructure_valuation {
  infrastructure_valuation_id varchar [pk, note: 'Unique identifier for the infrastructure valuation record.']
  actor_id varchar [note: 'Identifier of the valuation agent or firm.']
  adjustment_id varchar [note: 'Identifier of the valuation document.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: Infrastructure valuations require DD engagement reference for acquisition assumptions, regulatory conditions, concession terms, and ESG factors.']
  employee_id varchar [note: 'Identifier of the portfolio manager.']
  infra_asset_id varchar [note: 'Unique identifier for the underlying infrastructure asset.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Infrastructure assets (renewables, utilities) require ESG ratings for valuation adjustments.']
  portfolio_id varchar [note: 'Identifier of the portfolio containing the asset.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Infrastructure valuations are specialized valuations for infrastructure assets.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle.']
  asset_category varchar [note: 'Category of the asset (e.g., renewable, non-renewable).']
  asset_class varchar [note: 'Class of the asset within the investment taxonomy.']
  asset_currency varchar [note: 'ISO 4217 currency code for the asset valuation.']
  asset_isin varchar [note: 'International Securities Identification Number for the asset.']
  asset_name varchar [note: 'Legal name of the infrastructure asset.']
  asset_sector varchar [note: 'Sector in which the asset operates (e.g., energy, transport).']
  asset_subclass varchar [note: 'Subclass of the asset for more granular categorization.']
  asset_type varchar [note: 'Type of infrastructure asset (e.g., toll road, airport).']
  book_value decimal(20,4) [note: 'Book value of the asset in the books.']
  created_at timestamp [note: 'Timestamp when the record was first created.']
  fair_value decimal(20,4) [note: 'Fair value of the asset as determined by the valuation model.']
  gav decimal(20,4) [note: 'Gross asset value of the portfolio including this asset.']
  infrastructure_valuation_status varchar [note: 'Current lifecycle status of the valuation record.']
  market_value decimal(20,4) [note: 'Market value of the asset if available.']
  nav decimal(20,4) [note: 'Net asset value of the portfolio including this asset.']
  portfolio_type varchar [note: 'Type of portfolio (e.g., infrastructure, private equity).']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']
  valuation_comments varchar [note: 'Additional comments or notes on the valuation.']
  valuation_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  valuation_document_code varchar [note: 'Identifier of the valuation document.']
  valuation_document_date date [note: 'Date the valuation document was issued.']
  valuation_document_hash varchar [note: 'Cryptographic hash of the valuation document.']
  valuation_document_signed_at timestamp [note: 'Timestamp when the valuation document was signed.']
  valuation_document_signed_by varchar [note: 'Name of the person who signed the valuation document.']
  valuation_document_status varchar [note: 'Current status of the valuation document.']
  valuation_document_type varchar [note: 'File type of the valuation document.']
  valuation_document_url varchar [note: 'URL to the valuation document.']
  valuation_document_version varchar [note: 'Version identifier of the valuation document.']
  valuation_engine varchar [note: 'Software or model engine used for valuation.']
  valuation_method varchar [note: 'Method used for valuation (e.g., DCF, market comparables).']
  valuation_reason varchar [note: 'Reason for the valuation (e.g., periodic, trigger).']
  valuation_reference varchar [note: 'External reference code for the valuation.']
  valuation_source_code varchar [note: 'Identifier of the source of valuation data.']
  valuation_source_name varchar [note: 'Name of the source of valuation data.']
  valuation_status varchar [note: 'Status of the valuation document.']
  valuation_timestamp timestamp [note: 'Date and time when the valuation was performed.']

  Note: 'Specialized valuation record for direct infrastructure assets (toll roads, airports, utilities, pipelines, renewable energy) capturing infrastructure-specific valuation metrics.'
}

Table valuation.credit_instrument_valuation {
  credit_instrument_valuation_id varchar [pk, note: 'Unique identifier for the credit instrument valuation record.']
  actor_id varchar [note: 'Identifier of the valuation agent or firm.']
  adjustment_id varchar [note: 'Identifier of the valuation document.']
  credit_rating_id varchar [note: 'Foreign key linking to risk.credit_rating. Business justification: Credit instrument fair values depend on issuer credit ratings for spread calculations and OAS determination.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Credit instrument valuations (bonds, loans) must link to instrument master for position reconciliation, duration/convexity reporting, and regulatory filings.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Credit valuations incorporate ESG risk premiums in spread calculations. ESG ratings affect credit spreads and default probability estimates.']
  portfolio_id varchar [note: 'Identifier of the portfolio containing the instrument.']
  regulatory_reporting_regulatory_filing_id varchar [note: 'Identifier for regulatory reporting purposes.']
  research_yield_curve_id varchar [note: 'Foreign key linking to research.research_yield_curve. Business justification: Credit instrument valuations require yield curves for discounting cash flows and calculating spreads.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Credit instrument valuations are specialized valuations for fixed income instruments.']
  valuation_cycle_id varchar [note: 'Identifier of the valuation cycle.']
  accrued_interest decimal(18,4) [note: 'Interest accrued since last coupon payment.']
  book_value decimal(18,4) [note: 'Book value of the instrument.']
  clean_price decimal(18,4) [note: 'Market price excluding accrued interest.']
  coupon_rate decimal(10,6) [note: 'Annual coupon rate of the instrument.']
  created_at timestamp [note: 'Timestamp when the record was first created.']
  currency_code varchar [note: 'ISO 4217 currency code for the valuation.']
  dirty_price decimal(18,4) [note: 'Market price including accrued interest.']
  face_value decimal(18,2) [note: 'Nominal value of the instrument at maturity.']
  fair_value decimal(18,4) [note: 'Fair value of the instrument.']
  gav decimal(18,4) [note: 'Gross asset value of the instrument.']
  instrument_cusip varchar [note: 'Committee on Uniform Securities Identification Procedures code for the credit instrument.']
  instrument_isin varchar [note: 'International Securities Identification Number for the credit instrument.']
  instrument_type varchar [note: 'Classification of the credit instrument.']
  market_code varchar [note: 'Identifier of the market where the instrument trades.']
  market_value decimal(18,4) [note: 'Market value of the instrument.']
  maturity_date date [note: 'Date on which the instrument matures.']
  nav decimal(18,4) [note: 'Net asset value of the instrument.']
  oas decimal(10,6) [note: 'Spread over risk‑free rate adjusted for options.']
  record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  record_audit_updated timestamp [note: 'Audit timestamp of record update.']
  risk_metric_convexity decimal(10,4) [note: 'Convexity metric of the instrument.']
  risk_metric_credit_spread decimal(10,4) [note: 'Credit spread metric of the instrument.']
  risk_metric_duration decimal(10,4) [note: 'Duration metric of the instrument.']
  updated_at timestamp [note: 'Timestamp when the record was last updated.']
  valuation_comments varchar [note: 'Additional comments on the valuation.']
  valuation_date date [note: 'Date on which the valuation was performed.']
  valuation_document_code varchar [note: 'Identifier of the valuation document.']
  valuation_document_date date [note: 'Date of the valuation document.']
  valuation_document_type varchar [note: 'Type of the valuation document.']
  valuation_document_url varchar [note: 'URL to the valuation document.']
  valuation_engine varchar [note: 'Engine or system that performed the valuation.']
  valuation_method varchar [note: 'Method used for the valuation.']
  valuation_source_code varchar [note: 'Identifier of the source system for the valuation.']
  valuation_status varchar [note: 'Current status of the valuation.']
  valuation_time timestamp [note: 'Timestamp of the valuation event.']
  ytm decimal(10,6) [note: 'Yield to maturity of the instrument.']

  Note: 'Valuation record for credit and fixed income instruments including IG bonds, HY bonds, private credit, and sovereign debt. Captures instrument identifier (ISIN/CUSIP), face value, clean price, dirty price, accrued interest, YTM (Yield to Maturity), OAS'
}

Table valuation.price_exception {
  price_exception_id varchar [pk, note: 'Globally unique identifier for the price exception record.']
  actor_id varchar [note: 'Identifier of the agent that performed the valuation.']
  adjustment_id varchar [note: 'Identifier of the supporting document for the exception.']
  exception_cycle_id varchar [note: 'Identifier of the valuation cycle in which the exception occurred.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Price exceptions flag valuation anomalies per instrument. Linking to instrument master enables exception tracking, audit trails, and valuation committee review by security.']
  limit_breach_id varchar [note: 'Foreign key linking to risk.limit_breach. Business justification: Price exceptions directly cause limit breaches when valuations move outside tolerance. Audit trail requires linking the valuation exception to the resulting breach for regulatory compliance.']
  rule_breach_id varchar [note: 'Foreign key linking to compliance.rule_breach. Business justification: Price exceptions may constitute compliance rule breaches. Links pricing anomalies to formal breach records for regulatory reporting and remediation tracking.']
  valuation_asset_valuation_id varchar [note: 'Identifier of the valuation record related to the exception.']
  exception_created_at timestamp [note: 'When the exception record was first created.']
  exception_cycle_frequency varchar [note: 'Frequency of the valuation cycle.']
  exception_description varchar [note: 'Detailed description of the exception.']
  exception_document_code varchar [note: 'Identifier of the supporting document for the exception.']
  exception_document_hash varchar [note: 'Hash of the supporting document for integrity.']
  exception_document_signed_at timestamp [note: 'Timestamp when the document was signed.']
  exception_document_signed_by varchar [note: 'Name of the person who signed the document.']
  exception_document_status varchar [note: 'Status of the supporting document.']
  exception_document_type varchar [note: 'Type of the supporting document.']
  exception_document_url varchar [note: 'URL to the supporting document.']
  exception_reason varchar [note: 'Short textual reason for the exception.']
  exception_record_audit_created timestamp [note: 'Audit timestamp of record creation.']
  exception_record_audit_updated timestamp [note: 'Audit timestamp of record update.']
  exception_remarks varchar [note: 'Additional remarks about the exception.']
  exception_severity varchar [note: 'Severity level of the exception.']
  exception_source varchar [note: 'System or party that generated the exception.']
  exception_source_code varchar [note: 'Identifier of the source record that triggered the exception.']
  exception_source_system varchar [note: 'Underlying system that produced the exception.']
  exception_status varchar [note: 'Current status of the exception record.']
  exception_threshold_unit varchar [note: 'Unit of the threshold value.']
  exception_threshold_value decimal(38,10) [note: 'Threshold value exceeded by the exception.']
  exception_timestamp timestamp [note: 'When the exception was detected.']
  exception_type varchar [note: 'The type of exception that occurred during the valuation cycle.']
  exception_updated_at timestamp [note: 'When the exception record was last updated.']
  exception_valuation_comments varchar [note: 'Additional comments about the valuation exception.']
  exception_valuation_date date [note: 'Date of the valuation that triggered the exception.']
  exception_valuation_engine varchar [note: 'Engine that performed the valuation.']
  exception_valuation_method varchar [note: 'Method used for the valuation.']
  exception_valuation_reason varchar [note: 'Reason for the valuation exception.']
  exception_valuation_source_code varchar [note: 'Identifier of the source of the valuation data.']
  exception_valuation_source_description varchar [note: 'Description of the valuation source.']
  exception_valuation_source_name varchar [note: 'Name of the source of the valuation data.']
  exception_valuation_status varchar [note: 'Status of the valuation related to the exception.']
  exception_valuation_time timestamp [note: 'Timestamp of the valuation that triggered the exception.']
  exception_value decimal(38,10) [note: 'The numeric value that caused the exception.']

  Note: 'Operational data-quality exception record raised during a valuation cycle when a price or NAV input fails a validation tolerance — stale price, missing price, price move beyond threshold, source disagreement (Bloomberg vs broker quote), or NAV'
}

Table valuation.exclusion_screening {
  exclusion_screening_id varchar [pk, note: 'Primary key for the exclusion_screening association']
  employee_id varchar [note: 'Identifier of the ESG analyst or compliance officer who performed or approved this screening']
  exclusion_list_id varchar [note: 'Foreign key linking to the exclusion list entry against which the asset is screened']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to the asset valuation record being screened']
  check_date date [note: 'Date on which this exclusion screening was performed against the asset valuation']
  exclusion_screening_status varchar [note: 'Outcome of the exclusion screening - whether the asset passed, failed, or was flagged for review']
  override_flag boolean [note: 'Boolean indicating whether an Investment Committee override was granted for this exclusion check']
  override_reason varchar [note: 'Detailed justification for why an exclusion override was granted by the Investment Committee']

  Note: 'This association product represents the Exclusion Screening event between an asset valuation and an exclusion list entry. It captures the compliance screening process where each investment asset is checked against the fund\'s exclusion policies.'
}

Table valuation.compliance_requirement {
  compliance_requirement_id varchar [pk, note: 'Unique identifier for the methodology-rule compliance requirement record']
  methodology_id varchar [note: 'Foreign key linking to the valuation methodology being assessed for compliance']
  rule_id varchar [note: 'Foreign key linking to the compliance rule that governs the methodology']
  compliance_requirement_status varchar [note: 'Current compliance status of the methodology against this specific rule']
  created_at timestamp [note: 'Timestamp when this compliance requirement record was created']
  effective_from date [note: 'Date from which the methodology became subject to this compliance rule']
  effective_until date [note: 'Date until which the compliance requirement applies; null for ongoing requirements']
  next_review_date date [note: 'Scheduled date for the next compliance review of this methodology-rule pairing']
  notes varchar [note: 'Free-text notes documenting compliance findings, exceptions, or remediation actions']
  updated_at timestamp [note: 'Timestamp of the most recent update to this compliance requirement record']
  validated_by varchar [note: 'User ID of the compliance officer who performed the last validation']
  validation_date date [note: 'Date of the most recent compliance validation or review for this methodology-rule pairing']

  Note: 'This association product represents the compliance contract between a valuation methodology and a compliance rule. It captures which regulatory and internal rules each valuation methodology must adhere to, along with the compliance status, effective'
}

Table valuation.filing_inclusion {
  filing_inclusion_id varchar [pk, note: 'Primary key for the filing_inclusion association']
  regulatory_filing_id varchar [note: 'Foreign key linking to the regulatory filing containing this valuation']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to the asset valuation record being included in the filing']
  filing_date date [note: 'The date when this specific valuation was included or processed for the filing']
  inclusion_status varchar [note: 'Status indicating whether the valuation was included in the filing, excluded, or adjusted for regulatory purposes']
  reported_value decimal(38,10) [note: 'The actual value reported in the regulatory filing, which may differ from the fair_value due to regulatory adjustments, currency conversions, or timing differences']
  variance_amount decimal(38,10) [note: 'The difference between the fair_value from the valuation record and the reported_value in the filing, used for reconciliation and audit purposes']

  Note: 'This association product represents the inclusion of a specific asset valuation in a regulatory filing. It captures the regulatory disclosure relationship between valuations and filings, tracking which valuations were reported to which regulatory'
}

Table valuation.quote_source {
  quote_source_id varchar [pk, note: 'Primary key for quote_source']
  vendor_id varchar [note: 'Reference to the vendor master record for the data provider organization supplying this quote source.']
  api_endpoint_url varchar [note: 'Base URL for the API endpoint used to retrieve pricing data from this source. Confidential for security purposes.']
  approval_date date [note: 'Date when this quote source was formally approved for use in production valuation processes.']
  approved_by varchar [note: 'Name or identifier of the person or committee that approved this quote source for use in valuation processes.']
  asset_class_coverage varchar [note: 'Comma-separated list of asset classes covered by this source (e.g., equities, fixed_income, derivatives, real_estate, private_equity).']
  authentication_method varchar [note: 'Method used to authenticate with the quote source API for data retrieval.']
  business_days_calendar varchar [note: 'Reference to the holiday calendar used by this source to determine business days for pricing availability.']
  contact_email varchar [note: 'Email address of the primary contact at the quote source provider for operational communications.']
  contact_name varchar [note: 'Name of the primary contact person at the quote source provider for operational inquiries and escalations.']
  contact_phone varchar [note: 'Phone number of the primary contact at the quote source provider for urgent escalations.']
  contract_reference varchar [note: 'Reference number or identifier for the commercial agreement governing data usage from this source. Used for license compliance tracking.']
  created_timestamp timestamp [note: 'Timestamp when this quote source record was first created in the system.']
  currency_coverage varchar [note: 'Comma-separated list of ISO 4217 currency codes for which this source provides pricing data (e.g., USD, EUR, GBP, JPY).']
  cut_off_time varchar [note: 'Daily cut-off time (HH:MM format in source timezone) after which prices are considered next-day values for NAV calculation.']
  data_feed_format varchar [note: 'Technical format in which pricing data is received from this source. Used for integration and parsing configuration.']
  data_quality_score decimal(5,2) [note: 'Internal quality rating (0-100) based on historical accuracy, timeliness, and completeness of data from this source.']
  effective_from_date date [note: 'Date from which this quote source became active and available for use in valuation processes.']
  effective_to_date date [note: 'Date until which this quote source is valid. Null indicates currently active with no planned termination.']
  fair_value_hierarchy_level varchar [note: 'IFRS 13 / ASC 820 fair value hierarchy classification indicating the observability of inputs from this source. Level 1 is quoted prices in active markets.']
  geographic_coverage varchar [note: 'Regions or markets covered by this quote source (e.g., global, North America, EMEA, APAC). Determines applicability for regional asset valuations.']
  is_independent_source boolean [note: 'Indicates whether the source is independent from the fund manager for regulatory compliance. Required for Level 3 asset valuations.']
  is_primary_source boolean [note: 'Indicates whether this is the primary (preferred) quote source for its covered asset classes. True means primary source.']
  is_regulatory_approved boolean [note: 'Indicates whether this quote source has been approved by relevant regulatory bodies for use in official NAV calculations.']
  last_validation_date date [note: 'Date when the quote source was last validated for data quality and compliance with internal standards.']
  license_expiry_date date [note: 'Date when the current data license agreement expires. Triggers renewal workflow notifications.']
  minimum_quote_size decimal(18,2) [note: 'Minimum notional or quantity threshold for which quotes from this source are considered representative of market prices.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this quote source for continued suitability and compliance.']
  notes varchar [note: 'Free-text field for additional operational notes, special handling instructions, or known limitations of this quote source.']
  pricing_methodology varchar [note: 'Description of the valuation methodology used by the source (e.g., mark-to-market, mark-to-model, DCF, comparable transactions, NAV-based).']
  priority_rank varchar [note: 'Numeric ranking indicating preference order when multiple sources provide prices for the same instrument. Lower values indicate higher priority.']
  quote_source_status varchar [note: 'Current operational status of the quote source. Only active sources are used in production valuation processes.']
  source_code varchar [note: 'Standardized alphanumeric code uniquely identifying the quote source within the organization. Used for system integrations and reporting.']
  source_name varchar [note: 'Full legal or commercial name of the quote source provider (e.g., Bloomberg, Reuters, ICE Data Services, Markit).']
  source_type varchar [note: 'Classification of the quote source by origin type. Determines data governance and validation rules applied to received prices.']
  staleness_threshold_hours varchar [note: 'Maximum number of hours a price from this source can be considered valid before requiring refresh or escalation.']
  supports_bid_ask_spread boolean [note: 'Indicates whether the source provides both bid and ask prices enabling spread analysis for liquidity assessment.']
  supports_historical_prices boolean [note: 'Indicates whether the source provides access to historical pricing data for back-testing and performance attribution.']
  timezone varchar [note: 'IANA timezone identifier for the quote source (e.g., America/New_York, Europe/London). Used for timestamp normalization.']
  tolerance_threshold_percent decimal(5,2) [note: 'Maximum acceptable percentage deviation from prior price before triggering price challenge workflow.']
  update_frequency varchar [note: 'Frequency at which the quote source provides updated pricing data. Critical for determining staleness thresholds in valuation processes.']
  updated_timestamp timestamp [note: 'Timestamp when this quote source record was last modified.']

  Note: 'Master reference table for quote_source. Referenced by quote_source_id.'
}

Table valuation.valuation_document {
  valuation_document_id varchar [pk, note: 'Primary key for valuation_document']
  actor_id varchar [note: 'Reference to the independent valuation agent or firm that prepared or reviewed the valuation.']
  asset_id varchar [note: 'Reference to the asset or investment being valued in this document.']
  employee_id varchar [note: 'Reference to the internal analyst who prepared the valuation document.']
  portfolio_id varchar [note: 'Reference to the portfolio containing the asset being valued.']
  reviewed_by_analyst_employee_id varchar [note: 'Reference to the senior analyst or manager who reviewed and approved the valuation.']
  superseded_document_id varchar [note: 'Reference to the prior valuation document that this document supersedes.']
  approval_date date [note: 'Date when the valuation document received final approval for use in reporting.']
  asset_class varchar [note: 'Broad classification of the asset type being valued (public equity, private equity, real estate, infrastructure, natural resources, credit).']
  capitalization_rate_percent decimal(8,4) [note: 'Cap rate used in real estate and infrastructure valuations to convert income to value.']
  control_premium_percent decimal(8,4) [note: 'Premium applied to reflect controlling interest in the valued entity.']
  created_timestamp timestamp [note: 'Timestamp when this valuation document record was first created in the system.']
  discount_rate_percent decimal(8,4) [note: 'Discount rate applied in discounted cash flow (DCF) valuation models, expressed as a percentage.']
  document_file_path varchar [note: 'Storage location or URI of the valuation document file in the document management system.']
  document_number varchar [note: 'Externally-known business identifier for the valuation document, used for tracking and audit trail purposes.']
  document_status varchar [note: 'Current lifecycle status of the valuation document within the approval workflow.']
  document_title varchar [note: 'Human-readable title or name of the valuation document for identification and reporting purposes.']
  document_type varchar [note: 'Classification of the valuation document indicating the methodology or purpose (NAV, GAV, mark-to-market, DCF, fair value, independent appraisal).']
  document_version varchar [note: 'Version number of the valuation document for tracking revisions and amendments.']
  ebitda_multiple decimal(10,4) [note: 'Enterprise value to EBITDA multiple used in comparable company or transaction analysis.']
  effective_from_date date [note: 'Date from which this valuation document becomes the authoritative valuation for the asset.']
  effective_until_date date [note: 'Date until which this valuation document remains valid before requiring update or supersession.']
  fair_value_amount decimal(28,6) [note: 'The concluded fair value of the asset as determined by the valuation analysis.']
  fair_value_hierarchy_level varchar [note: 'IFRS 13 / ASC 820 fair value hierarchy classification indicating the observability of inputs used in valuation (Level 1, 2, or 3).']
  gross_asset_value decimal(28,6) [note: 'Total gross asset value before deduction of liabilities, fees, and carried interest as determined in the valuation.']
  illiquidity_discount_percent decimal(8,4) [note: 'Discount applied to reflect lack of marketability for private or illiquid assets.']
  is_audited boolean [note: 'Indicates whether the valuation has been reviewed or audited by external auditors.']
  is_independent_valuation boolean [note: 'Indicates whether the valuation was performed by an independent third-party valuation agent.']
  is_material_change boolean [note: 'Indicates whether this valuation reflects a material change from the prior valuation period.']
  net_asset_value decimal(28,6) [note: 'Net asset value after deducting liabilities, accrued fees, and other obligations from gross asset value.']
  next_valuation_due_date date [note: 'Scheduled date for the next periodic valuation update of the asset.']
  preparation_date date [note: 'Date when the valuation document was initially prepared.']
  prior_valuation_amount decimal(28,6) [note: 'Fair value from the immediately preceding valuation for comparison and change analysis.']
  revenue_multiple decimal(10,4) [note: 'Enterprise value to revenue multiple used in market-based valuation approaches.']
  review_date date [note: 'Date when the valuation document was reviewed by senior personnel.']
  terminal_growth_rate_percent decimal(8,4) [note: 'Long-term growth rate assumption used in terminal value calculations for DCF models.']
  updated_timestamp timestamp [note: 'Timestamp when this valuation document record was last modified.']
  valuation_change_amount decimal(28,6) [note: 'Absolute change in fair value from the prior valuation period.']
  valuation_change_percent decimal(10,4) [note: 'Percentage change in fair value from the prior valuation period.']
  valuation_confidence_level varchar [note: 'Internal assessment of confidence in the valuation conclusion based on data quality and methodology reliability.']
  valuation_currency_code varchar [note: 'ISO 4217 three-letter currency code in which the valuation is denominated.']
  valuation_date date [note: 'The effective date as of which the valuation is determined, representing the point-in-time fair value assessment.']
  valuation_frequency varchar [note: 'Frequency at which the asset is valued (daily for liquid assets, quarterly/annual for illiquid).']
  valuation_methodology varchar [note: 'Primary valuation methodology applied in the document (market approach, income approach, cost approach, NAV approach, or hybrid).']
  valuation_notes varchar [note: 'Free-text notes capturing key assumptions, limitations, or qualifications related to the valuation.']
  wacc_percent decimal(8,4) [note: 'Weighted average cost of capital used in DCF models for enterprise valuation, expressed as a percentage.']

  Note: 'Master reference table for valuation_document. Referenced by document_id.'
}

Table risk.limit {
  limit_id varchar [pk, note: 'Unique identifier for the risk limit record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Risk limit approvals require documented accountability per regulatory frameworks (BCBS 239). Pension funds must track which employee authorized each limit for audit trails and IC governance.']
  counterparty_id varchar [note: 'Identifier of the counterparty to which this limit applies, for counterparty credit risk and exposure limits.']
  portfolio_id varchar [note: 'Identifier of the specific portfolio to which this limit applies, if limit is portfolio-specific rather than enterprise-wide.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Risk limits with regulatory_requirement_flag=true are established to comply with specific regulatory rules. Links limit to its governing compliance rule.']
  strategy_id varchar [note: 'Identifier of the investment strategy to which this limit applies, if limit is strategy-specific.']
  approval_date date [note: 'Date on which this limit was formally approved by the designated authority.']
  asset_class varchar [note: 'Asset class to which this limit applies: public equities, private equity, real estate, infrastructure, natural resources, credit, or multi-asset. [ENUM-REF-CANDIDATE']
  breach_count_ytd varchar [note: 'Number of times this limit has been breached in the current calendar year.']
  breach_tolerance_lower decimal(20,4) [note: 'Lower threshold defining the soft breach tolerance band below the limit value, triggering monitoring alerts before hard breach.']
  breach_tolerance_upper decimal(20,4) [note: 'Upper threshold defining the soft breach tolerance band above the limit value, triggering monitoring alerts before hard breach.']
  calculation_methodology varchar [note: 'Methodology used to calculate the risk metric: historical simulation, parametric, Monte Carlo, or other quantitative approach.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level used for VaR and CVaR calculations, typically expressed as a percentage (e.g., 95.00, 99.00).']
  created_timestamp timestamp [note: 'Timestamp when this limit record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the limit value is denominated.']
  effective_date date [note: 'Date from which the limit becomes active and enforceable.']
  escalation_level varchar [note: 'Organizational level to which limit breaches must be escalated: portfolio manager, Chief Investment Officer (CIO), Chief Risk Officer (CRO), Investment Committee (IC), or Board.']
  escalation_procedure varchar [note: 'Documented procedure and workflow to be followed when the limit is breached, including notification and approval requirements.']
  expiry_date date [note: 'Date on which the limit expires and is no longer enforced, nullable for perpetual limits.']
  geographic_region varchar [note: 'Geographic region or country to which this limit applies, for concentration and geographic exposure limits.']
  last_breach_date date [note: 'Date of the most recent breach of this limit.']
  last_review_date date [note: 'Date of the most recent formal review of this limit by risk management or the Investment Committee.']
  limit_code varchar [note: 'Business-assigned unique code identifying the limit for operational reference and reporting.']
  limit_name varchar [note: 'Human-readable name describing the purpose and scope of the risk limit.']
  limit_status varchar [note: 'Current lifecycle status of the risk limit indicating whether it is actively enforced, suspended, expired, awaiting approval, or retired.']
  limit_type varchar [note: 'Category of risk limit: Value at Risk (VaR), Conditional Value at Risk (CVaR), Dollar Value of 01 (DV01), concentration, leverage, or liquidity.']
  modified_timestamp timestamp [note: 'Timestamp when this limit record was last modified or updated.']
  monitoring_frequency varchar [note: 'Frequency at which the limit is monitored and compliance is assessed: real-time, daily, weekly, monthly, or quarterly.']
  next_review_date date [note: 'Scheduled date for the next formal review of this limit.']
  notes varchar [note: 'Additional notes, comments, or context regarding the limit, its application, or special considerations.']
  rationale varchar [note: 'Business rationale and justification for establishing this limit at the specified level, including risk appetite considerations.']
  regulatory_reference varchar [note: 'Citation of the specific regulatory rule, guideline, or framework that mandates this limit, if applicable.']
  regulatory_requirement_flag boolean [note: 'Indicates whether this limit is mandated by regulatory requirements (True) or is an internal risk management control (False).']
  review_frequency varchar [note: 'Frequency at which the limit is formally reviewed and potentially recalibrated by risk management and the Investment Committee.']
  risk_system_source varchar [note: 'Source system from which the limit and its monitoring data originate: BlackRock Aladdin, MSCI Barra, SimCorp Dimension, or internal risk platform.']
  sector varchar [note: 'Economic sector or industry to which this limit applies, for sector concentration limits.']
  time_horizon_days varchar [note: 'Time horizon in days over which the risk metric is calculated, commonly 1-day or 10-day for VaR.']
  unit varchar [note: 'Unit of measure for the limit value: currency amount, percentage, basis points (bps), notional value, or number of shares.']
  utilization_percentage decimal(5,2) [note: 'Current utilization of the limit expressed as a percentage of the limit value, calculated as (current exposure / limit value) * 100.']
  value decimal(20,4) [note: 'Numeric threshold value defining the maximum allowable exposure or risk metric for this limit.']

  Note: 'Master registry of enterprise risk limits and thresholds governing investment exposures across all asset classes and portfolios. Captures limit type (VaR, CVaR, DV01, concentration, leverage, liquidity), limit value, breach tolerance bands, escalation'
}

Table risk.factor {
  factor_id varchar [pk, note: 'Unique identifier for the systematic risk factor in the master catalog.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Risk factor approval is part of model governance framework. Pension funds must track who approved each factor for use in risk models and attribution analysis.']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: Risk factors (inflation, GDP growth, rates) are derived from macro indicators tracked by research.']
  risk_model_id varchar [note: 'Identifier of the parent risk model or factor framework to which this factor belongs.']
  annualized_volatility_pct decimal(10,4) [note: 'Annualized standard deviation of the factor returns, expressed as a percentage, representing the factors historical volatility.']
  approval_date date [note: 'Date on which the factor was approved for production use by the governing authority.']
  approval_status varchar [note: 'Governance approval status of the factor for use in production risk analytics (approved, pending, rejected, under review).']
  asset_class varchar [note: 'Primary asset class to which this factor applies (equity, fixed income, real estate, infrastructure, private equity, natural resources, multi-asset). [ENUM-REF-CANDIDATE']
  benchmark_index_code varchar [note: 'Code of the benchmark index or universe against which this factor is constructed or measured (e.g., MSCI ACWI, Bloomberg Barclays Aggregate).']
  beta_to_market decimal(10,4) [note: 'Systematic risk measure representing the factors sensitivity to broad market movements, calculated via regression against market index.']
  calculation_methodology varchar [note: 'Description of the mathematical or statistical methodology used to construct the factor (e.g., cross-sectional regression, principal component analysis, fundamental ratio).']
  correlation_to_market decimal(5,4) [note: 'Correlation coefficient between the factor returns and the broad market index returns, ranging from -1 to +1.']
  created_timestamp timestamp [note: 'Timestamp when the factor record was first created in the master catalog.']
  data_quality_score decimal(5,2) [note: 'Quantitative score representing the quality, completeness, and reliability of the factor data, typically on a 0-100 scale.']
  data_source varchar [note: 'Primary data source or vendor providing the factor data (e.g., MSCI Barra, BlackRock Aladdin, Bloomberg, internal proprietary model).']
  effective_from_date date [note: 'Date from which this factor definition became effective and available for use in risk analytics.']
  effective_to_date date [note: 'Date until which this factor definition is effective; null for currently active factors.']
  esg_integration_flag boolean [note: 'Indicates whether this factor incorporates Environmental, Social, and Governance (ESG) criteria in its construction (True) or not (False).']
  factor_category varchar [note: 'High-level classification of the factor by asset class or risk domain.']
  factor_code varchar [note: 'Standardized alphanumeric code uniquely identifying the factor across risk systems (e.g., VAL_FACTOR, MOM_FACTOR, DUR_FACTOR).']
  factor_description varchar [note: 'Detailed business description of the factor, its economic rationale, and how it captures systematic risk or return drivers.']
  factor_name varchar [note: 'Human-readable name of the risk factor (e.g., Value, Momentum, Duration, Credit Spread).']
  factor_status varchar [note: 'Current lifecycle status of the factor in the catalog (active, deprecated, under review, pending approval).']
  factor_type varchar [note: 'Classification of the factor by its construction methodology (style, statistical, macroeconomic, fundamental, technical).']
  family varchar [note: 'Grouping of related factors into a family (e.g., Equity Style Factors, Term Structure Factors, Volatility Factors).']
  information_ratio decimal(10,4) [note: 'Ratio of active return to tracking error, measuring the factors risk-adjusted outperformance relative to a benchmark.']
  is_active boolean [note: 'Indicates whether the factor is currently active and used in risk decomposition and attribution (True) or deprecated (False).']
  is_proprietary boolean [note: 'Indicates whether the factor is a proprietary internal model (True) or sourced from an external vendor (False).']
  last_rebalance_date date [note: 'Most recent date on which the factor exposures or constituents were recalculated or rebalanced.']
  last_review_date date [note: 'Most recent date on which the factor underwent governance review and validation.']
  loading_interpretation varchar [note: 'Business interpretation guidance for positive and negative factor exposures (e.g., positive loading indicates value tilt, negative indicates growth tilt).']
  max_drawdown_pct decimal(10,4) [note: 'Largest peak-to-trough decline in the factors cumulative return history, expressed as a percentage.']
  next_rebalance_date date [note: 'Scheduled date for the next factor rebalance or recalculation.']
  next_review_date date [note: 'Scheduled date for the next governance review and validation of the factor.']
  rebalance_frequency varchar [note: 'Frequency at which the factor exposures or constituents are recalculated or rebalanced (daily, weekly, monthly, quarterly, annual, ad hoc).']
  regulatory_reporting_flag boolean [note: 'Indicates whether this factor is required for regulatory risk reporting to SEC, or other governing bodies (True) or not (False).']
  return_history_end_date date [note: 'Most recent date for which historical factor return data is available.']
  return_history_start_date date [note: 'Earliest date for which historical factor return data is available.']
  review_frequency varchar [note: 'Scheduled frequency for governance review and validation of the factor definition and performance (monthly, quarterly, semi-annual, annual, ad hoc).']
  sharpe_ratio decimal(10,4) [note: 'Risk-adjusted return metric for the factor, calculated as excess return over risk-free rate divided by volatility.']
  unit varchar [note: 'Unit of measure for the factor exposure or return (e.g., standard deviations, basis points (bps), percentage, ratio).']
  updated_timestamp timestamp [note: 'Timestamp when the factor record was last modified in the master catalog.']
  usage_in_stress_testing boolean [note: 'Indicates whether this factor is used in macroeconomic stress testing and scenario analysis (True) or not (False).']
  usage_in_var_calculation boolean [note: 'Indicates whether this factor is included in the portfolio Value at Risk (VaR) calculation (True) or excluded (False).']
  vendor_model_name varchar [note: 'Name of the vendor risk model or factor library from which this factor is sourced (e.g., Barra Global Equity Model, Aladdin Risk Model).']
  vendor_model_version varchar [note: 'Version identifier of the vendor risk model or factor library.']
  vintage_year varchar [note: 'Year in which the factor model or definition was first introduced or last materially revised.']

  Note: 'Master catalog of systematic risk factors used in factor-based risk decomposition and attribution across the investment portfolio. Covers equity style factors (value, momentum, quality, size, low-volatility), fixed income factors (duration, spread'
}

Table risk.model {
  model_id varchar [pk, note: 'Unique identifier for the risk model record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Model risk management (SR 11-7) requires documented model approval. Pension funds must track which employee approved each risk model for regulatory compliance and governance.']
  approval_date date [note: 'Date when the model was formally approved for production use by the investment committee or model governance body.']
  asset_class varchar [note: 'Primary asset class scope for which this model is calibrated. [ENUM-REF-CANDIDATE: public_equities|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset — 7 candidates stripped; promote to reference product]']
  backtesting_frequency varchar [note: 'Frequency at which model performance is validated against actual outcomes.']
  benchmark_index varchar [note: 'Name or identifier of the benchmark index used for relative risk measurement or tracking error calculation.']
  calculation_frequency varchar [note: 'Frequency at which the model is executed and risk measures are updated.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level for the risk measure expressed as a decimal (e.g., 0.9500 for 95%, 0.9900 for 99%).']
  created_timestamp timestamp [note: 'Timestamp when the model record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which risk measures are expressed.']
  data_source varchar [note: 'Primary data source or system feeding input data to the model (e.g., Bloomberg, SimCorp Dimension, BlackRock Aladdin).']
  documentation_url varchar [note: 'URL or file path to the detailed model documentation, methodology paper, or validation report.']
  effective_from_date date [note: 'Date from which the model became active and began producing risk measures for decision-making.']
  effective_to_date date [note: 'Date when the model was retired or superseded; null for currently active models.']
  factor_model_flag boolean [note: 'Indicates whether the model uses factor decomposition for risk attribution.']
  holding_period_days varchar [note: 'Time horizon in days over which risk is measured.']
  last_backtest_date date [note: 'Date when the most recent backtesting validation was performed.']
  last_calibration_date date [note: 'Date when the model parameters were last recalibrated using updated historical data.']
  limitations varchar [note: 'Known limitations, assumptions, or constraints of the model that users should be aware of.']
  lookback_window_days varchar [note: 'Number of historical days used for model calibration and calculation.']
  methodology_description varchar [note: 'Detailed textual description of the model methodology, assumptions, and calculation approach.']
  model_code varchar [note: 'Externally-known unique code for the risk model used in system integrations and reporting.']
  model_name varchar [note: 'Human-readable name of the risk model.']
  model_status varchar [note: 'Current lifecycle status of the risk model.']
  model_type varchar [note: 'Classification of the quantitative risk model methodology.']
  next_review_date date [note: 'Scheduled date for the next formal model review and validation by the model governance committee.']
  notes varchar [note: 'Additional free-text notes or comments about the model for operational or audit purposes.']
  owner varchar [note: 'Name or identifier of the business unit or individual responsible for the model.']
  regulatory_approved_flag boolean [note: 'Indicates whether the model has been approved by regulatory authorities for capital adequacy or reporting purposes.']
  regulatory_framework varchar [note: 'Name of the regulatory framework or standard the model complies with (e.g., Basel III guidelines, EMIR).']
  risk_measure varchar [note: 'Primary risk metric calculated by this model (VaR = Value at Risk, CVaR = Conditional Value at Risk, DV01 = Dollar Value of 01).']
  simulation_count varchar [note: 'Number of Monte Carlo simulations or scenarios executed per model run; applicable to Monte Carlo and scenario-based models.']
  stress_test_flag boolean [note: 'Indicates whether the model is used for macroeconomic stress testing and scenario analysis.']
  updated_timestamp timestamp [note: 'Timestamp when the model record was last modified.']
  vendor varchar [note: 'Name of the external vendor or system providing the model (e.g., BlackRock Aladdin, MSCI RiskMetrics, Barra, internal proprietary).']
  version varchar [note: 'Version identifier of the model implementation for change tracking and audit purposes.']

  Note: 'Master registry of quantitative risk models deployed across the enterprise for VaR, CVaR, factor risk, and stress testing. Records model name, model type (historical simulation, Monte Carlo, parametric), confidence level, lookback window, asset class'
}

Table risk.stress_scenario {
  stress_scenario_id varchar [pk, note: 'Unique identifier for the stress scenario. Primary key.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Stress scenario approval is required for regulatory stress testing (ORSA, IORP II). Pension funds must document which employee approved each scenario for audit purposes.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD-mandated climate stress testing requires pension funds to apply standardized climate scenarios (RCP/SSP pathways) to financial stress tests.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Pension fund stress testing requires linking risk stress scenarios to research economic scenarios.']
  macro_indicator_id varchar [note: 'Foreign key linking to the macroeconomic indicator being shocked']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Pension fund stress scenarios are mandated by specific regulators (PRA, EIOPA, local pension authorities). The regulatory_source field indicates this need.']
  superseded_by_scenario_stress_scenario_id varchar [note: 'Reference to the stress scenario that supersedes this one if deprecated. Null if current.']
  approval_date date [note: 'Date when the scenario was formally approved for use in stress testing.']
  asset_class_scope varchar [note: 'Comma-separated list of asset classes covered by this scenario (e.g., public equities, private equity, real estate, infrastructure, credit, natural resources).']
  commodity_shock_percent decimal(10,4) [note: 'Percentage change in commodity prices (e.g., oil, natural gas, metals). Positive for price increases, negative for decreases.']
  counterparty_default_rate_percent decimal(10,4) [note: 'Assumed percentage of counterparties that default under the scenario.']
  created_timestamp timestamp [note: 'Timestamp when the stress scenario record was first created in the system.']
  credit_spread_shock_bps varchar [note: 'Widening or tightening of credit spreads in basis points (bps). Positive for widening, negative for tightening.']
  cvar_confidence_level_percent decimal(5,2) [note: 'Confidence level used for CVaR (Expected Shortfall) calculations under this scenario (e.g., 95.00, 99.00). Null if not applicable.']
  effective_date date [note: 'Date from which this shock parameter specification is effective. Allows versioning of shock assumptions over time. Identified in detection phase.']
  equity_shock_percent decimal(10,4) [note: 'Percentage change applied to equity markets in this scenario (e.g., -40.0000 for 40% decline). Positive for gains, negative for losses.']
  external_scenario_code varchar [note: 'Identifier used by the external vendor or regulatory body for this scenario. Null for internal scenarios.']
  fx_shock_percent decimal(10,4) [note: 'Percentage change in foreign exchange rates (e.g., domestic currency depreciation or appreciation). Positive for appreciation, negative for depreciation.']
  gdp_shock_percent decimal(10,4) [note: 'Percentage change in GDP growth rate under the scenario (e.g., -5.0000 for 5% contraction).']
  geographic_scope varchar [note: 'Geographic regions or countries affected by the scenario (e.g., Global, North America, Europe, Emerging Markets). Use 3-letter ISO country codes where applicable.']
  historical_event_date date [note: 'Date of the historical event if the scenario is based on a past crisis (e.g., 2008-09-15 for Lehman collapse). Null for hypothetical scenarios.']
  indicator_weight decimal(10,6) [note: 'Relative weight or importance of this indicator\'s shock in the overall scenario impact calculation. Used for weighted stress metrics. Identified in detection phase.']
  inflation_shock_percent decimal(10,4) [note: 'Percentage point change in inflation rate (e.g., +3.0000 for 3 percentage point increase in inflation).']
  interest_rate_shock_bps varchar [note: 'Parallel shift in interest rates expressed in basis points (bps). Positive for rate increases, negative for decreases (e.g., +300 for 3% hike).']
  is_baseline boolean [note: 'Flag indicating whether this is a baseline (no-stress) scenario used for comparison. True if baseline, False otherwise.']
  is_regulatory_required boolean [note: 'Flag indicating whether this scenario is mandated by a regulatory authority. True if required, False if discretionary.']
  last_review_date date [note: 'Date when the scenario was last reviewed for relevance and accuracy.']
  liquidity_shock_description varchar [note: 'Narrative description of liquidity stress conditions (e.g., bid-ask spreads widen 10x, redemption surge 20%, funding markets freeze).']
  modified_by varchar [note: 'Identifier of the user or system that last modified the stress scenario record.']
  modified_timestamp timestamp [note: 'Timestamp when the stress scenario record was last modified.']
  next_review_date date [note: 'Scheduled date for the next review of the scenario.']
  probability_assessment varchar [note: 'Qualitative assessment of the likelihood of the scenario occurring: very low, low, medium, high, very high, or not assessed.']
  real_estate_shock_percent decimal(10,4) [note: 'Percentage change in real estate valuations. Positive for appreciation, negative for depreciation.']
  recovery_rate_percent decimal(10,4) [note: 'Assumed recovery rate on defaulted exposures (e.g., 40.0000 for 40% recovery).']
  regulatory_source varchar [note: 'Name of the regulatory body or framework that mandated this scenario (e.g., EBA, CCAR). Null for internal scenarios.']
  scenario_category varchar [note: 'Broad category of the stress event: market shock, credit event, liquidity crisis, macroeconomic downturn, geopolitical, operational, climate, pandemic, or cyber.']
  scenario_code varchar [note: 'Unique business identifier code for the stress scenario (e.g., GFC_2008, COVID_SHOCK, RATE_HIKE_300).']
  scenario_name varchar [note: 'Human-readable name of the stress scenario (e.g., 2008 Global Financial Crisis, COVID-19 Market Shock, Oil Price Collapse).']
  scenario_narrative varchar [note: 'Detailed narrative describing the scenario storyline, including macroeconomic context, triggering events, and transmission channels.']
  scenario_status varchar [note: 'Current lifecycle status of the stress scenario: draft (under development), active (approved for use), archived (historical reference), deprecated (no longer used), or under review (pending approval).']
  scenario_type varchar [note: 'Classification of the stress scenario: historical (actual past event), hypothetical (plausible future event), regulatory (mandated by regulator), custom (bespoke internal), or reverse stress (identifies breaking point).']
  severity_level varchar [note: 'Qualitative severity classification of the stress scenario: mild, moderate, severe, or extreme.']
  shock_direction varchar [note: 'Direction of the shock: increase (positive shock), decrease (negative shock), or unchanged (indicator held constant). Identified in detection phase.']
  shock_magnitude decimal(18,6) [note: 'The magnitude of the shock applied to this indicator in this scenario, expressed in the indicator\'s native unit (percent, basis points, index points). Identified in detection phase.']
  shock_magnitude_description varchar [note: 'Narrative description of the magnitude and nature of the stress shock (e.g., equity markets down 40%, credit spreads widen 500 bps, GDP contracts 5%).']
  time_horizon_months varchar [note: 'Duration over which the stress scenario unfolds, expressed in months (e.g., 3, 6, 12, 24).']
  unemployment_shock_percent decimal(10,4) [note: 'Percentage point change in unemployment rate (e.g., +5.0000 for 5 percentage point increase).']
  usage_count varchar [note: 'Number of times this scenario has been used in stress testing runs. Incremented with each execution.']
  var_confidence_level_percent decimal(5,2) [note: 'Confidence level used for VaR calculations under this scenario (e.g., 95.00, 99.00). Null if not applicable.']
  version_number varchar [note: 'Version identifier for the scenario (e.g., 1.0, 2.1). Incremented when scenario parameters are updated.']
  volatility_shock_percent decimal(10,4) [note: 'Percentage change in market volatility (e.g., VIX increase). Positive for volatility spike, negative for compression.']
  created_by varchar [note: 'Identifier of the user or system that created the stress scenario record.']

  Note: 'Master catalog of macroeconomic and market stress scenarios used for portfolio stress testing and sensitivity analysis. Each scenario defines a named event (e.g., 2008 GFC, COVID-19 shock, rate hike +300bps, oil price collapse), scenario type (historical'
}

Table risk.var_calculation {
  var_calculation_id varchar [pk, note: 'Unique identifier for each VaR calculation run. Primary key for the var_calculation product.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: VaR calculations require approval sign-off for regulatory capital reporting. Pension funds must track approver for daily risk reporting governance and IC oversight.']
  calculation_run_id varchar [note: 'Business identifier for the calculation batch or run, used for grouping related VaR calculations executed together.']
  portfolio_id varchar [note: 'Reference to the portfolio or position set against which this VaR calculation was performed.']
  risk_model_id varchar [note: 'Reference to the risk model configuration used for this VaR calculation, defining methodology and parameters.']
  stress_scenario_id varchar [note: 'Reference to a specific stress test or market scenario applied during the VaR calculation, if applicable.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: VaR calculations must reference the valuation cycle ensuring risk metrics use consistent, audited asset values.']
  approval_timestamp timestamp [note: 'Timestamp when the VaR calculation result was formally approved for reporting and decision-making purposes.']
  asset_class_scope varchar [note: 'Comma-separated list of asset classes included in this VaR calculation, such as equities, fixed income, FX, commodities, alternatives.']
  backtesting_exceptions varchar [note: 'Number of times actual losses exceeded the VaR estimate during the backtesting period, used to assess model accuracy.']
  backtesting_period_end date [note: 'End date of the backtesting period used to validate the VaR model accuracy against actual portfolio returns.']
  backtesting_period_start date [note: 'Start date of the backtesting period used to validate the VaR model accuracy against actual portfolio returns.']
  calculation_date date [note: 'The business date on which this VaR calculation was performed, representing the as-of date for the risk assessment.']
  calculation_duration_seconds decimal(10,2) [note: 'Time taken to complete the VaR calculation, measured in seconds, used for performance monitoring.']
  calculation_engine varchar [note: 'Name of the risk analytics platform or engine that performed the calculation, such as BlackRock Aladdin or MSCI RiskMetrics.']
  calculation_notes varchar [note: 'Free-text notes or comments regarding special circumstances, assumptions, or observations related to this VaR calculation.']
  calculation_status varchar [note: 'Current status of the VaR calculation run, indicating whether it completed successfully or encountered issues.']
  calculation_timestamp timestamp [note: 'Precise timestamp when the VaR calculation was executed, capturing the exact moment of computation.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level for the VaR calculation expressed as a decimal, typically 0.9500 for 95% or 0.9900 for 99%.']
  correlation_matrix_version varchar [note: 'Version identifier of the correlation matrix used in parametric VaR calculations, tracking model updates over time.']
  created_timestamp timestamp [note: 'Timestamp when this VaR calculation record was first created in the system, for audit trail purposes.']
  cvar_amount decimal(20,2) [note: 'The calculated CVaR or Expected Shortfall, representing the expected loss given that the loss exceeds the VaR threshold.']
  data_quality_score decimal(5,2) [note: 'Quality score from 0 to 100 indicating the completeness and reliability of market data used in the VaR calculation.']
  decomposition_available boolean [note: 'Indicates whether detailed risk factor decomposition or contribution analysis is available for this VaR calculation.']
  diversification_benefit decimal(20,2) [note: 'Reduction in VaR due to portfolio diversification, calculated as the difference between sum of individual VaRs and portfolio VaR.']
  historical_lookback_days varchar [note: 'Number of historical days of market data used in the VaR calculation, typically 250 to 500 trading days.']
  holding_period_days varchar [note: 'The time horizon in days over which the VaR is calculated, representing the period the portfolio is assumed to be held.']
  incremental_risk_charge decimal(20,2) [note: 'Additional capital charge for default and migration risk in the trading book, complementing VaR measures.']
  liquidity_horizon_days varchar [note: 'Estimated time in days required to liquidate the portfolio positions without significant market impact, used for liquidity-adjusted VaR.']
  market_data_source varchar [note: 'Primary source of market data used for the VaR calculation, such as Bloomberg, Reuters, or internal pricing systems.']
  methodology varchar [note: 'The statistical methodology applied for VaR calculation: historical simulation, Monte Carlo simulation, parametric, or hybrid approach.']
  modified_timestamp timestamp [note: 'Timestamp when this VaR calculation record was last modified, tracking any updates or corrections to the calculation.']
  portfolio_value decimal(20,2) [note: 'The total market value of the portfolio at the calculation date, serving as the base for VaR percentage calculations.']
  position_count varchar [note: 'Total number of positions or securities included in the portfolio for this VaR calculation.']
  regulatory_capital_multiplier decimal(5,2) [note: 'Multiplier applied to VaR for regulatory capital calculation purposes, typically ranging from 3.0 to 4.0 based on backtesting results.']
  risk_factor_count varchar [note: 'Number of distinct risk factors or market variables considered in the VaR model, such as equity indices, interest rates, FX rates.']
  simulation_iterations varchar [note: 'Number of simulation paths or iterations used in Monte Carlo VaR calculations, typically 10,000 or more.']
  stress_var_amount decimal(20,2) [note: 'VaR calculated using a stressed historical period, typically a 12-month period of significant financial stress.']
  var_amount decimal(20,2) [note: 'The calculated VaR amount representing the maximum expected loss at the specified confidence level over the holding period.']
  var_currency varchar [note: 'Three-letter ISO 4217 currency code in which the VaR amount is denominated.']
  var_percentage decimal(7,4) [note: 'VaR amount expressed as a percentage of total portfolio value, calculated as VaR amount divided by portfolio value.']
  volatility_adjustment_factor decimal(7,4) [note: 'Scaling factor applied to historical volatility estimates to account for current market conditions or regime changes.']

  Note: 'Transactional record of each Value-at-Risk (VaR) and Conditional Value-at-Risk (CVaR) calculation run performed against a portfolio or position set. Captures calculation date, portfolio scope, risk model used, confidence level (95%, 99%), holding period'
}

Table risk.risk_factor_exposure {
  risk_factor_exposure_id varchar [pk, note: 'Unique identifier for the risk factor exposure record. Primary key for this transactional snapshot of factor exposure at a point in time.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Factor exposure approvals are required for governance. Pension funds must track who approved material factor exposures for risk committee oversight.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Factor risk models decompose returns at instrument level. Pension funds use Barra/Axioma models requiring instrument-to-factor mappings for risk attribution, tracking error analysis, and']
  listed_security_id varchar [note: 'Identifier of the individual security for which this factor exposure is calculated. Nullable when exposure is at portfolio level only.']
  portfolio_id varchar [note: 'Identifier of the portfolio for which this factor exposure is calculated. Links to the investment portfolio master.']
  risk_factor_id varchar [note: 'Identifier of the systematic risk factor to which exposure is measured (e.g., market factor, size factor, value factor, momentum, sector, country, currency).']
  risk_model_id varchar [note: 'Identifier of the risk model used to compute this factor exposure (e.g., MSCI Barra Global Equity Model, BlackRock Aladdin Fixed Income Model).']
  stress_scenario_id varchar [note: 'Identifier of the stress test scenario applied to this factor exposure. Nullable for baseline (non-stressed) exposures.']
  active_exposure decimal(18,6) [note: 'The difference between the portfolios factor exposure and the benchmark factor exposure. Measures active risk positioning.']
  approval_status varchar [note: 'The approval status of this factor exposure record, particularly relevant when exposures breach limits and require IC or CRO approval.']
  approval_timestamp timestamp [note: 'The date and time when this factor exposure or limit override was approved. Nullable for non-breach exposures.']
  as_of_date date [note: 'The business date for which this factor exposure snapshot is calculated. Represents the valuation date of the underlying positions.']
  base_currency_code varchar [note: 'The three-letter ISO 4217 base currency code of the portfolio for currency conversion and reporting purposes.']
  benchmark_exposure decimal(18,6) [note: 'The factor exposure of the portfolios benchmark index. Used to calculate active exposure and tracking error contribution.']
  calculation_method varchar [note: 'The statistical method used to compute the factor exposure: regression, covariance matrix, Monte Carlo simulation, or historical analysis.']
  calculation_timestamp timestamp [note: 'The precise date and time when this factor exposure was computed by the risk system. Supports audit trail and version control.']
  comments varchar [note: 'Free-text comments or notes from risk analysts regarding this factor exposure, limit breach rationale, or model adjustments.']
  confidence_level decimal(5,2) [note: 'The confidence level associated with the factor exposure estimate, expressed as a percentage (e.g., 95.00, 99.00).']
  contribution_to_risk_percentage decimal(10,4) [note: 'The percentage of total portfolio risk attributable to this factor exposure. Sum across all factors equals 100%.']
  created_timestamp timestamp [note: 'The date and time when this risk factor exposure record was first created in the lakehouse. Supports audit trail and data lineage.']
  cvar_contribution decimal(18,2) [note: 'The contribution of this factor exposure to the portfolios Conditional Value at Risk (CVaR or Expected Shortfall), in base currency.']
  data_quality_score decimal(5,2) [note: 'A quality score (0-100) indicating the completeness and reliability of the input data used for this exposure calculation.']
  exposure_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the exposure value is denominated (e.g., USD, EUR, GBP).']
  exposure_direction varchar [note: 'The directional bias of the factor exposure: long (positive exposure), short (negative exposure), or neutral (near-zero exposure).']
  exposure_percentage decimal(10,4) [note: 'The factor exposure expressed as a percentage of total portfolio risk or NAV. Facilitates relative comparison across factors.']
  exposure_value decimal(18,6) [note: 'The numerical exposure of the portfolio or security to this risk factor. Typically expressed as a standardized beta or factor loading.']
  factor_category varchar [note: 'The high-level category of the risk factor: style (value, growth, momentum), industry, country, currency, macro (interest rate, inflation), or custom.']
  factor_return decimal(12,6) [note: 'The return of the risk factor itself over the measurement period. Used to compute factor-driven performance attribution.']
  factor_type varchar [note: 'Classification of the factor as systematic (common across securities), idiosyncratic (security-specific), or specific (custom defined).']
  factor_volatility decimal(12,6) [note: 'The historical or implied volatility of the risk factor. Expressed as annualized standard deviation in percentage terms.']
  fx_rate decimal(18,8) [note: 'The foreign exchange rate used to convert exposure from exposure currency to base currency as of the calculation date.']
  is_material_exposure boolean [note: 'Boolean flag indicating whether this factor exposure exceeds the materiality threshold defined in the risk policy (True) or not (False).']
  limit_breach_flag boolean [note: 'Boolean flag indicating whether this factor exposure breaches the defined risk limit (True) or is within limits (False).']
  limit_utilization_percentage decimal(10,4) [note: 'The percentage of the risk limit consumed by this factor exposure. Values over 100% indicate a breach.']
  lookback_period_days varchar [note: 'The number of historical days used in the factor exposure calculation (e.g., 252 for one-year daily returns).']
  marginal_contribution_to_risk decimal(18,6) [note: 'The marginal contribution of this factor exposure to total portfolio risk (VaR or volatility). Measures incremental risk impact.']
  market_value decimal(18,2) [note: 'The market value of the position (security or portfolio) underlying this factor exposure, in base currency.']
  model_version varchar [note: 'The version identifier of the risk model used for this calculation (e.g., MSCI Barra GEM3, Aladdin v8.2). Supports model change tracking.']
  notional_value decimal(18,2) [note: 'The notional value of derivative positions contributing to this factor exposure. Relevant for futures, swaps, and options.']
  stressed_exposure_value decimal(18,6) [note: 'The factor exposure value under the applied stress scenario. Nullable for baseline exposures.']
  t_statistic decimal(10,4) [note: 'The statistical significance measure of the factor exposure. Values above 2.0 typically indicate statistically significant exposure.']
  tracking_error_contribution decimal(12,6) [note: 'The contribution of this factor exposure to the portfolios tracking error versus its benchmark, expressed in basis points.']
  updated_timestamp timestamp [note: 'The date and time when this risk factor exposure record was last modified. Supports change tracking and version control.']
  var_contribution decimal(18,2) [note: 'The contribution of this factor exposure to the portfolios total Value at Risk (VaR), in base currency.']

  Note: 'Transactional record of a portfolio\'s or security\'s exposure to each systematic risk factor at a point in time, as computed by the risk model (MSCI Barra or BlackRock Aladdin).'
}

Table risk.stress_test_result {
  stress_test_result_id varchar [pk, note: 'Unique identifier for the stress test result record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Stress test results require approval for IC reporting and regulatory submissions. Pension funds must document which employee signed off on results.']
  hedge_program_id varchar [note: 'Foreign key linking to the hedge program being stress tested']
  instrument_id varchar [note: 'Foreign key linking to the financial instrument being stressed']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Regulatory stress testing (PRA) requires showing stressed asset values against liability projections to calculate stressed funded ratio.']
  performance_calculation_run_id varchar [note: 'Foreign key linking to performance.performance_calculation_run. Business justification: Stress tests use baseline NAV from performance calculations. Pension funds require traceability from stressed results to the specific performance run that established']
  portfolio_id varchar [note: 'Identifier of the portfolio or position set subjected to the stress test.']
  stress_scenario_id varchar [note: 'Identifier of the stress scenario applied in this test (e.g., market crash, interest rate shock, credit spread widening).']
  stress_test_run_id varchar [note: 'Identifier of the parent stress test execution run that generated this result.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Stress test results must identify which valuation cycle\'s NAV was the base case. Regulatory stress testing (IORP II, local pension regulations) requires this audit trail for supervisory']
  approval_date date [note: 'Date on which the stress test result was formally approved.']
  approval_status varchar [note: 'Current approval status of the stress test result for reporting or decision-making purposes.']
  asset_class varchar [note: 'Primary asset class of the portfolio or position set subjected to the stress test.']
  base_cvar decimal(20,2) [note: 'Conditional Value at Risk (expected shortfall) of the portfolio before applying the stress scenario, in the reporting currency.']
  base_nav decimal(20,2) [note: 'Net Asset Value of the portfolio before applying the stress scenario, in the reporting currency.']
  base_var decimal(20,2) [note: 'Value at Risk of the portfolio before applying the stress scenario, in the reporting currency.']
  breach_flag boolean [note: 'Indicates whether the stress test result breached any defined risk limits or thresholds (True if breach occurred, False otherwise).']
  breach_severity varchar [note: 'Severity classification of any risk limit breach identified by the stress test result.']
  calculation_date date [note: 'The as-of date for this stress test calculation. Stress tests are run periodically (daily, weekly, monthly) and results are point-in-time.']
  calculation_methodology varchar [note: 'Methodology used to calculate the stress test results (e.g., historical simulation, Monte Carlo, parametric VaR, hybrid approach).']
  concentration_risk_score decimal(10,4) [note: 'Quantitative score measuring portfolio concentration risk under the stress scenario (higher values indicate greater concentration).']
  confidence_level decimal(5,4) [note: 'Statistical confidence level used in the stress test risk calculations (e.g., 0.9500 for 95%, 0.9900 for 99%).']
  counterparty_exposure_change decimal(20,2) [note: 'Change in aggregate counterparty credit exposure resulting from the stress scenario, in the reporting currency.']
  created_timestamp timestamp [note: 'Date and time when this stress test result record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this stress test result (e.g., USD, EUR, GBP).']
  effectiveness_under_stress varchar [note: 'Assessment of whether the hedging relationship would remain effective under the stress scenario conditions, per IFRS 9 hedge accounting requirements. Determines if hedge accounting treatment could be maintained.']
  factor_contribution_summary varchar [note: 'Summary of key risk factor contributions to the stressed P&L (e.g., equity factor, interest rate factor, credit spread factor).']
  geographic_region varchar [note: 'Geographic region or market focus of the portfolio subjected to the stress test (e.g., North America, Europe, Asia-Pacific, Global).']
  liquidity_impact_days varchar [note: 'Estimated number of days required to liquidate the stressed positions under the scenario conditions, reflecting liquidity risk.']
  market_value_base decimal(20,2) [note: 'The market value of the position in base currency at calculation date, before stress is applied.']
  model_version varchar [note: 'Version identifier of the risk model or stress testing engine used to generate this result.']
  modified_timestamp timestamp [note: 'Date and time when this stress test result record was last modified or updated.']
  notes varchar [note: 'Free-text field for additional commentary, observations, or context regarding the stress test result.']
  position_quantity decimal(20,4) [note: 'The quantity of the instrument held at calculation date. Required to calculate stressed P&L from per-unit impact.']
  rebalance_trigger_flag boolean [note: 'Indicates whether the stress scenario would cause the hedge ratio to breach the permitted band (min/max hedge ratio) and trigger a mandatory rebalancing event for this hedge program.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement, guideline, or framework that mandated this stress test (if applicable).']
  regulatory_scenario_flag boolean [note: 'Indicates whether this stress test was performed to satisfy a regulatory requirement (True) or for internal risk management purposes (False).']
  result_timestamp timestamp [note: 'Date and time when the stress test result was calculated and recorded.']
  risk_system_source varchar [note: 'Source system that performed the stress test calculation (e.g., BlackRock Aladdin, MSCI RiskMetrics, MSCI Barra, SimCorp Dimension, internal proprietary system).']
  scenario_impact_amount decimal(18,2) [note: 'The calculated mark-to-market or P&L impact of applying this stress scenario to this hedge program, expressed in the fund\'s base currency. Positive values indicate gains, negative values indicate losses under the stress scenario.']
  sector varchar [note: 'Primary economic sector or industry classification of the portfolio holdings subjected to the stress test.']
  sensitivity decimal(18,6) [note: 'The sensitivity of this instrument to the scenario shocks. For equities this may be beta, for bonds duration/convexity, for derivatives delta/gamma. Captures how the instrument responds to the scenario factors.']
  shock_value decimal(18,6) [note: 'The specific shock value applied to this instrument under this scenario. May differ from scenario-level defaults based on instrument characteristics (e.g., sector-specific equity shocks, credit-rating-specific spread shocks).']
  stressed_cvar decimal(20,2) [note: 'Conditional Value at Risk (expected shortfall) of the portfolio after applying the stress scenario, in the reporting currency.']
  stressed_market_value decimal(20,2) [note: 'The market value of the position in base currency after applying the scenario stress shocks.']
  stressed_nav decimal(20,2) [note: 'Net Asset Value of the portfolio after applying the stress scenario, in the reporting currency.']
  stressed_pnl decimal(20,2) [note: 'The calculated profit and loss impact for this instrument under this scenario, expressed in base currency. Represents the contribution of this position to total portfolio stress loss.']
  stressed_pnl_absolute decimal(20,2) [note: 'Absolute change in portfolio value resulting from the stress scenario (stressed NAV minus base NAV), in the reporting currency.']
  stressed_pnl_percentage decimal(10,4) [note: 'Percentage change in portfolio value resulting from the stress scenario, expressed as a decimal (e.g., -0.1250 for -12.50%).']
  stressed_var decimal(20,2) [note: 'Value at Risk of the portfolio after applying the stress scenario, in the reporting currency.']
  test_execution_date date [note: 'Date on which this stress test was executed. Required for audit trail and regulatory reporting of when stress tests were performed.']
  test_status varchar [note: 'Lifecycle status of this stress test record, tracking progression from execution through review and approval for regulatory reporting.']
  time_horizon_days varchar [note: 'Time horizon in days over which the stress scenario is applied (e.g., 1-day, 10-day, 30-day).']
  valuation_date date [note: 'As-of date for the portfolio valuation used as the baseline for stress testing.']

  Note: 'Transactional record of the output from a stress test run applying a defined stress scenario to a portfolio or position set. Captures scenario applied, portfolio scope, stressed P&L impact (absolute and % of NAV), stressed VaR, stressed CVaR, asset class'
}

Table risk.limit_breach {
  limit_breach_id varchar [pk, note: 'Unique identifier for the limit breach event record.']
  acknowledged_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Breach acknowledgment must be traceable for escalation procedures. Pension funds require documented accountability for who acknowledged each limit breach per risk governance.']
  counterparty_id varchar [note: 'Reference to the counterparty associated with the breach, if applicable for counterparty risk limits.']
  limit_id varchar [note: 'Reference to the risk limit that was breached.']
  portfolio_id varchar [note: 'Reference to the investment portfolio associated with the breach, if applicable.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: When risk limit breaches have regulatory implications (regulatory_breach_flag=true), compliance must assess which regulatory rule was violated.']
  strategy_id varchar [note: 'Reference to the investment strategy associated with the breach, if applicable.']
  triggering_order_id varchar [note: 'Foreign key linking to trade.order. Business justification: Pre-trade compliance and breach remediation require linking breaches to triggering orders. Risk teams must identify which orders caused limit violations for regulatory reporting (AIFMD, UCITS)']
  acknowledged_timestamp timestamp [note: 'Date and time when the breach was formally acknowledged by risk management.']
  asset_class varchar [note: 'Asset class associated with the breach such as public equities, private equity, real estate, infrastructure, natural resources, or credit.']
  breach_code varchar [note: 'Unique business identifier code for the breach event, used for tracking and reporting.']
  breach_duration_minutes varchar [note: 'Duration in minutes that the breach persisted before returning to compliance or being remediated.']
  breach_magnitude decimal(20,4) [note: 'Absolute difference between the breached metric value and the limit threshold.']
  breach_percentage decimal(10,4) [note: 'Percentage by which the metric exceeded the limit threshold, calculated as magnitude divided by threshold times 100.']
  breach_severity varchar [note: 'Classification of the breach severity level based on magnitude and risk impact.']
  breach_status varchar [note: 'Current lifecycle status of the breach event in the remediation workflow.']
  breach_timestamp timestamp [note: 'Date and time when the limit breach was first detected by the risk monitoring system.']
  breached_metric_value decimal(20,4) [note: 'Actual value of the risk metric at the time of breach detection.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level used in the risk calculation, typically expressed as a percentage such as 95% or 99%.']
  created_timestamp timestamp [note: 'Date and time when the breach record was first created in the system.']
  currency varchar [note: 'Three-letter ISO currency code for monetary breach values.']
  detection_timestamp timestamp [note: 'Date and time when the breach was identified and logged by the risk system, may differ from breach timestamp if detected retrospectively.']
  escalation_level varchar [note: 'Level to which the breach was escalated based on severity and escalation procedures.']
  escalation_timestamp timestamp [note: 'Date and time when the breach was escalated to higher authority or governance body.']
  geographic_region varchar [note: 'Geographic region or market associated with the breach for regional concentration limits.']
  ic_review_date date [note: 'Date when the breach was reviewed by the Investment Committee, if applicable.']
  ic_review_required_flag boolean [note: 'Indicates whether the breach requires formal review by the Investment Committee based on severity and governance policy.']
  intraday_breach_flag boolean [note: 'Indicates whether the breach occurred during intraday monitoring versus end-of-day monitoring.']
  limit_threshold_value decimal(20,4) [note: 'The threshold value of the limit that was breached, captured at time of breach for audit trail.']
  modified_timestamp timestamp [note: 'Date and time when the breach record was last modified or updated.']
  notes varchar [note: 'Free-text notes and comments regarding the breach event, remediation, or follow-up actions.']
  notification_sent_flag boolean [note: 'Indicates whether automated notification was sent to stakeholders upon breach detection.']
  notification_timestamp timestamp [note: 'Date and time when breach notification was sent to stakeholders.']
  regulatory_breach_flag boolean [note: 'Indicates whether the breach violates a regulatory requirement and requires regulatory reporting.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement or rule that was breached, if applicable.']
  remediated_by varchar [note: 'Name or identifier of the portfolio manager or trader who executed the remediation action.']
  remediation_action varchar [note: 'Description of the remediation action taken to address the breach and return to compliance.']
  remediation_timestamp timestamp [note: 'Date and time when remediation action was completed and the breach was resolved.']
  risk_metric_type varchar [note: 'Type of risk metric that breached the limit such as Value at Risk (VaR), Conditional Value at Risk (CVaR), Dollar Value of 01 (DV01), concentration, or liquidity.']
  risk_system_source varchar [note: 'Source risk system that detected and reported the breach such as BlackRock Aladdin, MSCI RiskMetrics, or Barra.']
  root_cause varchar [note: 'Identified root cause of the breach such as market movement, operational error, model failure, or limit misconfiguration.']
  sector varchar [note: 'Industry sector or GICS classification associated with the breach for sector concentration limits.']
  time_horizon_days varchar [note: 'Time horizon in days over which the risk metric was calculated, such as 1-day or 10-day VaR.']
  unit_of_measure varchar [note: 'Unit of measurement for the breached metric, such as basis points, percentage, currency, or other risk metric units.']

  Note: 'Transactional record of each risk limit breach event detected during daily or intraday risk monitoring. Captures the breached limit, breach date and time, breached metric value vs limit threshold, breach severity (warning, soft breach, hard breach)'
}

Table risk.risk_counterparty_exposure {
  risk_counterparty_exposure_id varchar [pk, note: 'Unique identifier for each counterparty exposure record in the risk management system.']
  counterparty_id varchar [note: 'Reference to the counterparty entity to which this exposure applies.']
  csa_id varchar [note: 'Foreign key linking to collateral.csa. Business justification: CSA terms (thresholds, minimum transfer amounts) directly impact collateral-adjusted exposure calculations.']
  netting_agreement_id varchar [note: 'Foreign key linking to collateral.netting_agreement. Business justification: Netting agreements directly reduce counterparty exposure through close-out netting. Pension fund risk teams must calculate net exposure using actual netting agreement terms.']
  otc_derivative_id varchar [note: 'Foreign key linking to trade.otc_derivative. Business justification: Counterparty credit exposure calculations must link to underlying OTC derivatives for CVA/DVA computation, EMIR reporting, and ISDA CSA margin calculations.']
  portfolio_id varchar [note: 'Reference to the portfolio holding positions that contribute to this counterparty exposure.']
  stress_scenario_id varchar [note: 'Reference to the stress test scenario under which this exposure was calculated, if applicable.']
  asset_class varchar [note: 'The asset class of the underlying instruments contributing to the counterparty exposure.']
  breach_flag boolean [note: 'Indicates whether this exposure breaches any established counterparty credit limit or concentration threshold.']
  breach_severity varchar [note: 'The severity classification of any limit breach associated with this counterparty exposure.']
  calculation_methodology varchar [note: 'The methodology used to calculate the counterparty credit exposure.']
  ccp_name varchar [note: 'The name of the central counterparty clearing house if the exposure is centrally cleared.']
  clearing_status varchar [note: 'Indicates whether the exposure is centrally cleared through a CCP or remains bilateral.']
  collateral_agreement_flag boolean [note: 'Indicates whether a collateral support agreement is in place with the counterparty.']
  collateral_agreement_type varchar [note: 'The type of collateral support agreement governing margin and collateral exchange with the counterparty.']
  collateral_held_amount decimal(20,2) [note: 'The market value of collateral held from the counterparty to mitigate credit exposure, in base currency.']
  collateral_posted_amount decimal(20,2) [note: 'The market value of collateral posted to the counterparty, in base currency.']
  concentration_limit_utilization decimal(8,4) [note: 'The percentage of the counterparty concentration limit currently utilized by this exposure, expressed as a decimal.']
  counterparty_credit_rating varchar [note: 'The external credit rating assigned to the counterparty by a recognized rating agency. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR — 11 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'The date and time when this counterparty exposure record was first created in the system.']
  credit_valuation_adjustment decimal(20,2) [note: 'The market value adjustment to reflect counterparty credit risk in OTC derivative valuations.']
  debit_valuation_adjustment decimal(20,2) [note: 'The market value adjustment to reflect own credit risk in OTC derivative valuations.']
  effective_maturity_years decimal(8,2) [note: 'The effective maturity of the exposure in years, used in regulatory capital calculations.']
  expected_credit_loss decimal(20,2) [note: 'The probability-weighted estimate of credit losses over the expected life of the exposure, calculated as EAD × PD × LGD.']
  expected_exposure decimal(20,2) [note: 'The mean of the probability distribution of exposure at a future date, used in credit valuation adjustment calculations.']
  exposure_at_default decimal(20,2) [note: 'The estimated exposure amount at the time of counterparty default, used in regulatory capital calculations.']
  exposure_currency varchar [note: 'The base currency in which all exposure amounts are denominated, using ISO 4217 three-letter code.']
  exposure_type varchar [note: 'The category of transaction or instrument giving rise to the counterparty credit exposure.']
  gross_exposure_amount decimal(20,2) [note: 'The total gross credit exposure to the counterparty before netting and collateral adjustments, in base currency.']
  independent_amount decimal(20,2) [note: 'The fixed collateral amount required to be posted regardless of mark-to-market exposure, providing additional credit protection.']
  instrument_type varchar [note: 'The specific financial instrument type contributing to the exposure. [ENUM-REF-CANDIDATE: Swap|Forward|Option|Future|Repo|Reverse Repo|Securities Loan|Other — 8 candidates stripped; promote to reference product]']
  internal_credit_rating varchar [note: 'The internal credit rating assigned to the counterparty by the funds credit risk team.']
  lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier of the counterparty.']
  loss_given_default decimal(8,6) [note: 'The estimated percentage of exposure that would be lost in the event of counterparty default, expressed as a decimal.']
  margin_threshold_amount decimal(20,2) [note: 'The exposure threshold below which no collateral is required to be posted under the collateral agreement.']
  maturity_date date [note: 'The weighted average maturity date of the instruments contributing to this counterparty exposure.']
  minimum_transfer_amount decimal(20,2) [note: 'The minimum collateral amount that must be transferred in any single margin call under the collateral agreement.']
  modified_timestamp timestamp [note: 'The date and time when this counterparty exposure record was last updated in the system.']
  net_exposure_amount decimal(20,2) [note: 'The net credit exposure after netting and collateral adjustments, representing the residual credit risk, in base currency.']
  netting_agreement_flag boolean [note: 'Indicates whether a legally enforceable netting agreement is in place with the counterparty.']
  netting_agreement_type varchar [note: 'The type of master netting agreement governing the exposure relationship with the counterparty.']
  netting_benefit_amount decimal(20,2) [note: 'The reduction in exposure achieved through legally enforceable netting agreements, in base currency.']
  notes varchar [note: 'Additional commentary or context regarding this counterparty exposure record.']
  potential_future_exposure decimal(20,2) [note: 'The estimated maximum exposure that could arise in the future due to market movements, calculated using simulation models.']
  probability_of_default decimal(8,6) [note: 'The estimated likelihood that the counterparty will default within a one-year horizon, expressed as a decimal.']
  risk_weight decimal(8,4) [note: 'The regulatory risk weight applied to this exposure for capital adequacy calculations, expressed as a decimal.']
  risk_weighted_exposure decimal(20,2) [note: 'The exposure amount multiplied by the applicable risk weight, used in regulatory capital calculations.']
  valuation_date date [note: 'The date on which this counterparty exposure was calculated and valued.']
  wrong_way_risk_flag boolean [note: 'Indicates whether this exposure exhibits wrong-way risk, where exposure increases when counterparty creditworthiness deteriorates.']

  Note: 'Transactional record of gross and net credit exposure to each counterparty across all OTC derivatives, repo agreements, securities lending, and unsettled trades.'
}

Table risk.concentration_exposure {
  concentration_exposure_id varchar [pk, note: 'Unique identifier for the concentration exposure measurement record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Concentration exposure approvals require documented accountability for prudent person rule compliance. Pension funds track approvers for diversification governance.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Counterparty concentration monitoring is critical for pension fund risk management.']
  credit_rating_id varchar [note: 'Foreign key linking to risk.credit_rating. Business justification: Adds a foreign key to the credit_rating master table, removing the redundant credit_rating string column and enabling referential integrity and efficient joins.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Manager concentration limits require tracking total exposure to each GP across all mandates. Regulatory large exposure reporting and internal risk limits mandate GP-level aggregation.']
  limit_id varchar [note: 'Reference to the applicable concentration risk limit framework or threshold against which this exposure is monitored.']
  portfolio_id varchar [note: 'Reference to the investment portfolio being measured for concentration risk.']
  stress_scenario_id varchar [note: 'Reference to a macroeconomic stress scenario under which this concentration exposure was calculated, null for base case measurements.']
  approval_date date [note: 'Date on which an exception or remediation plan for a concentration breach was formally approved by risk governance authority.']
  asset_class varchar [note: 'The asset class category when concentration dimension is asset class: public equities, private equity, real estate, infrastructure, natural resources, credit, or fixed income.']
  breach_amount decimal(20,2) [note: 'The absolute monetary amount by which the exposure exceeds the limit threshold, null if within limit.']
  breach_percentage decimal(7,4) [note: 'The percentage points by which the exposure exceeds the limit threshold, null if within limit.']
  breach_status varchar [note: 'Indicates whether the concentration exposure is within limits, has breached a soft threshold, breached a hard limit, or has been escalated for remediation.']
  calculation_methodology varchar [note: 'Description of the methodology used to calculate the concentration exposure, including aggregation rules, netting conventions, and look-through approaches for fund investments.']
  concentration_dimension varchar [note: 'The dimension along which concentration risk is being measured: single issuer, sector/industry, geography, asset class, currency, or counterparty.']
  confidence_level decimal(5,4) [note: 'The statistical confidence level used for risk metric calculations, typically expressed as a decimal (e.g., 0.95 for 95% confidence).']
  created_timestamp timestamp [note: 'System timestamp indicating when this concentration exposure record was first created in the risk management system.']
  cvar_contribution decimal(20,2) [note: 'The contribution of this concentration exposure to the overall portfolio Conditional Value at Risk (CVaR) or Expected Shortfall metric.']
  data_source varchar [note: 'The source system or platform from which the concentration exposure data was derived, such as BlackRock Aladdin, MSCI RiskMetrics, or SimCorp Dimension.']
  dimension_value decimal(18,2) [note: 'The specific value within the concentration dimension being measured, such as issuer name, sector code, country code, asset class name, currency code, or counterparty identifier.']
  escalation_required_flag boolean [note: 'Boolean indicator of whether the concentration exposure breach requires escalation to senior management or Investment Committee (IC) per governance policy.']
  exposure_amount decimal(20,2) [note: 'The total monetary exposure to the specified concentration dimension value, expressed in the portfolio base currency.']
  exposure_currency varchar [note: 'Three-letter ISO 4217 currency code in which the exposure amount is denominated.']
  exposure_percentage decimal(7,4) [note: 'The concentration exposure expressed as a percentage of total portfolio Net Asset Value (NAV) or Assets Under Management (AUM).']
  geographic_region varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code representing the geographic region of concentration when dimension is geography.']
  limit_threshold decimal(7,4) [note: 'The maximum allowable concentration exposure percentage as defined by the risk limit framework for this dimension and value.']
  look_through_flag boolean [note: 'Boolean indicator of whether the concentration calculation includes look-through analysis of underlying holdings in fund-of-funds or commingled vehicles.']
  measurement_date date [note: 'Business date on which the concentration exposure was calculated and recorded.']
  modified_timestamp timestamp [note: 'System timestamp indicating when this concentration exposure record was last updated or modified.']
  monitoring_frequency varchar [note: 'The frequency at which this concentration exposure is monitored and reported to risk management and Investment Committee (IC).']
  nav_base decimal(20,2) [note: 'The total portfolio Net Asset Value (NAV) or Assets Under Management (AUM) used as the denominator for calculating exposure percentage.']
  netting_applied_flag boolean [note: 'Boolean indicator of whether long and short positions were netted in the concentration exposure calculation, or if gross exposure was used.']
  notes varchar [note: 'Free-text field for additional context, commentary, or qualitative assessment related to the concentration exposure measurement.']
  regulatory_reporting_flag boolean [note: 'Boolean indicator of whether this concentration exposure must be included in regulatory reporting to SEC, or other governing bodies.']
  remediation_plan varchar [note: 'Description of the action plan to reduce or mitigate the concentration exposure if a breach has occurred, including target reduction timeline and responsible party.']
  risk_rating varchar [note: 'Qualitative risk assessment of the concentration exposure based on magnitude, volatility, and correlation characteristics.']
  sector_classification varchar [note: 'The industry sector classification code or name applicable when concentration dimension is sector, using standard taxonomy such as GICS or BICS.']
  time_horizon_days varchar [note: 'The time horizon in days over which the concentration risk metrics are calculated, commonly 1-day or 10-day for VaR.']
  var_contribution decimal(20,2) [note: 'The contribution of this concentration exposure to the overall portfolio Value at Risk (VaR) metric.']

  Note: 'Transactional record of portfolio concentration risk measurements across multiple dimensions: single issuer, sector/industry, geography, asset class, currency, and counterparty.'
}

Table risk.dv01_sensitivity {
  dv01_sensitivity_id varchar [pk, note: 'Unique identifier for the DV01 sensitivity record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Interest rate sensitivity approvals are critical for ALM governance. Pension funds must track who approved DV01 calculations for liability matching oversight.']
  discount_rate_curve_id varchar [note: 'Foreign key linking to actuarial.discount_rate_curve. Business justification: LDI hedge ratio calculations require asset DV01 computed using the SAME discount curve as liabilities.']
  holding_id varchar [note: 'Reference to the specific position or holding for which DV01 sensitivity is calculated.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: DV01/duration calculations are instrument-specific for fixed income. Essential for liability-driven investing (LDI) where pension funds match asset duration to pension liabilities.']
  portfolio_id varchar [note: 'Reference to the portfolio containing the position or aggregate portfolio for which DV01 is measured.']
  research_yield_curve_id varchar [note: 'Foreign key linking to research.research_yield_curve. Business justification: DV01/duration calculations require yield curve inputs. The dv01_sensitivity table references yield_curve_source/date indicating dependency on curve data.']
  security_instrument_id varchar [note: 'Reference to the underlying security or instrument for which interest rate sensitivity is calculated.']
  stress_scenario_id varchar [note: 'Reference to a specific stress scenario under which this DV01 sensitivity was calculated.']
  aggregation_level varchar [note: 'The level at which DV01 sensitivity is aggregated: individual position, portfolio, strategy, or total fund.']
  approval_timestamp timestamp [note: 'Timestamp when the DV01 calculation was approved or validated.']
  asset_class varchar [note: 'The asset class category of the position for which DV01 is calculated.']
  calculation_date date [note: 'The date on which the DV01 sensitivity measure was calculated.']
  calculation_methodology varchar [note: 'The methodology used to calculate DV01, such as analytical approximation or full revaluation.']
  calculation_timestamp timestamp [note: 'Precise timestamp when the DV01 sensitivity calculation was performed, supporting intraday risk monitoring.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level associated with the DV01 calculation, expressed as a percentage.']
  convexity decimal(12,4) [note: 'Second-order measure of interest rate sensitivity, capturing the curvature of the price-yield relationship.']
  coupon_rate decimal(8,4) [note: 'The coupon rate of the fixed income instrument, expressed as a percentage.']
  created_timestamp timestamp [note: 'Timestamp when the DV01 sensitivity record was first created in the system.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the DV01 amount is denominated.']
  dv01_amount decimal(18,2) [note: 'The dollar change in the value of the position or portfolio for a one basis point parallel shift in the yield curve.']
  effective_duration decimal(12,4) [note: 'Effective duration accounting for embedded options, measuring interest rate sensitivity for bonds with optionality.']
  hedge_adjusted_flag boolean [note: 'Indicates whether the DV01 calculation reflects hedging positions or is gross of hedges.']
  instrument_type varchar [note: 'The type of financial instrument for which interest rate sensitivity is measured.']
  key_rate_duration_10y decimal(12,4) [note: 'Sensitivity to a one basis point change in the 10-year point of the yield curve, holding other points constant.']
  key_rate_duration_1y decimal(12,4) [note: 'Sensitivity to a one basis point change in the 1-year point of the yield curve, holding other points constant.']
  key_rate_duration_2y decimal(12,4) [note: 'Sensitivity to a one basis point change in the 2-year point of the yield curve, holding other points constant.']
  key_rate_duration_30y decimal(12,4) [note: 'Sensitivity to a one basis point change in the 30-year point of the yield curve, holding other points constant.']
  key_rate_duration_3m decimal(12,4) [note: 'Sensitivity to a one basis point change in the 3-month point of the yield curve, holding other points constant.']
  key_rate_duration_5y decimal(12,4) [note: 'Sensitivity to a one basis point change in the 5-year point of the yield curve, holding other points constant.']
  key_rate_duration_6m decimal(12,4) [note: 'Sensitivity to a one basis point change in the 6-month point of the yield curve, holding other points constant.']
  macaulay_duration decimal(12,4) [note: 'Weighted average time to receive cash flows, expressed in years.']
  market_value decimal(18,2) [note: 'Current market value of the position at the time of DV01 calculation.']
  maturity_date date [note: 'The maturity date of the fixed income instrument.']
  modified_duration decimal(12,4) [note: 'Modified duration of the position, measuring the percentage change in price for a 1% change in yield.']
  modified_timestamp timestamp [note: 'Timestamp when the DV01 sensitivity record was last modified or recalculated.']
  notes varchar [note: 'Free-text notes or comments regarding the DV01 calculation, including any assumptions or adjustments.']
  notional_amount decimal(18,2) [note: 'Notional principal amount of the position, particularly relevant for derivatives and swaps.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this DV01 measure is used for regulatory reporting purposes such as Pension regulator or Basel III.']
  risk_system_source varchar [note: 'The risk management system that generated the DV01 calculation, such as Aladdin, RiskMetrics, or SimCorp.']
  shock_size_bps varchar [note: 'The size of the interest rate shock applied in the calculation, typically 1 basis point for DV01.']
  spread_duration decimal(12,4) [note: 'Sensitivity to changes in credit spread, measuring the impact of spread widening or tightening on position value.']
  yield_curve_date date [note: 'The effective date of the yield curve used in the sensitivity calculation.']
  yield_curve_source varchar [note: 'The source or vendor of the yield curve used in the DV01 calculation, such as Bloomberg or internal curve.']
  yield_to_maturity decimal(8,4) [note: 'The yield to maturity of the position at the time of calculation, expressed as a percentage.']

  Note: 'Transactional record of DV01 (Dollar Value of a Basis Point) and broader interest rate sensitivity measures for fixed income and rate-sensitive positions. Captures position or portfolio identifier, DV01 amount, duration (modified, effective, key-rate)'
}

Table risk.liquidity_risk_assessment {
  liquidity_risk_assessment_id varchar [pk, note: 'Unique identifier for the liquidity risk assessment record.']
  assessed_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Liquidity assessments require documented assessor for audit trails. Pension funds must track which analyst performed each liquidity risk assessment.']
  liability_cash_flow_id varchar [note: 'Foreign key linking to actuarial.liability_cash_flow. Business justification: Pension liquidity assessments must evaluate asset liquidity against projected benefit payments.']
  limit_id varchar [note: 'Reference to the liquidity risk limit framework applied to this assessment.']
  portfolio_id varchar [note: 'Reference to the investment portfolio being assessed for liquidity risk.']
  significant_cash_flow_id varchar [note: 'Foreign key linking to performance.significant_cash_flow. Business justification: Pension funds must assess liquidity risk considering significant cash flows (beneficiary payments, large redemptions).']
  stress_scenario_id varchar [note: 'Reference to the stress test scenario applied in this liquidity assessment.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Liquidity assessments use portfolio NAV from specific valuation cycles. Pension funds must demonstrate liquidity coverage against audited valuations for regulatory compliance and benefit']
  approval_date date [note: 'Date on which the liquidity risk assessment was formally approved.']
  approved_by varchar [note: 'Name or identifier of the authority who approved the liquidity risk assessment.']
  assessment_code varchar [note: 'Externally-known unique business identifier for this liquidity risk assessment.']
  assessment_date date [note: 'Business date on which the liquidity risk assessment was performed.']
  assessment_status varchar [note: 'Current lifecycle status of the liquidity risk assessment.']
  asset_class varchar [note: 'Primary asset class category for which liquidity risk is being assessed.']
  bid_ask_spread_bps decimal(10,2) [note: 'Average bid-ask spread across portfolio positions, expressed in basis points.']
  breach_severity varchar [note: 'Severity classification of any identified liquidity limit breach.']
  concentration_risk_flag boolean [note: 'Indicates whether concentration risk was identified that could impair liquidity.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level used in the liquidity risk calculation, expressed as a decimal.']
  created_timestamp timestamp [note: 'Timestamp when this liquidity risk assessment record was first created in the system.']
  days_to_liquidate decimal(10,2) [note: 'Estimated number of days required to liquidate the portfolio without exceeding market impact thresholds.']
  escalation_required_flag boolean [note: 'Indicates whether the assessment results require escalation to senior management or Investment Committee.']
  funding_liquidity_risk_flag boolean [note: 'Indicates whether funding liquidity risk was identified in meeting capital calls or obligations.']
  geographic_region varchar [note: 'Geographic region or market where the assessed assets are primarily located.']
  illiquid_assets_value decimal(20,2) [note: 'Total value of assets classified as illiquid within the specified time horizon.']
  limit_breach_flag boolean [note: 'Indicates whether the liquidity assessment identified a breach of established risk limits.']
  liquid_assets_value decimal(20,2) [note: 'Total value of assets classified as liquid within the specified time horizon.']
  liquidation_scenario varchar [note: 'Market condition scenario under which the liquidity assessment is performed.']
  liquidity_coverage_ratio decimal(10,6) [note: 'Ratio of high-quality liquid assets to net cash outflows over the stress period.']
  liquidity_ratio decimal(10,6) [note: 'Ratio of liquid assets to total portfolio NAV, expressed as a decimal.']
  market_impact_cost_bps decimal(10,2) [note: 'Estimated market impact cost of liquidating positions, expressed in basis points.']
  measurement_timestamp timestamp [note: 'Precise timestamp when the liquidity risk measurement was captured.']
  methodology varchar [note: 'Calculation methodology or model used to perform the liquidity risk assessment.']
  modified_timestamp timestamp [note: 'Timestamp when this liquidity risk assessment record was last modified.']
  nav_currency varchar [note: 'Three-letter ISO 4217 currency code for the portfolio NAV.']
  next_review_date date [note: 'Scheduled date for the next liquidity risk assessment review.']
  notes varchar [note: 'Additional commentary, observations, or context related to the liquidity risk assessment.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement or framework governing this liquidity assessment.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this liquidity assessment must be included in regulatory reporting submissions.']
  remediation_plan varchar [note: 'Description of the remediation actions planned or taken to address identified liquidity risks.']
  reviewed_by varchar [note: 'Name or identifier of the senior risk officer who reviewed and validated the assessment.']
  risk_system_source varchar [note: 'Source risk management system or platform that generated the liquidity assessment.']
  sector varchar [note: 'Economic sector classification of the assessed portfolio holdings.']
  time_horizon_days varchar [note: 'Number of days over which the liquidity risk is assessed for liquidation without material market impact.']
  total_portfolio_nav decimal(20,2) [note: 'Total Net Asset Value of the portfolio at the time of assessment.']

  Note: 'Transactional record of portfolio liquidity risk assessments measuring the ability to liquidate positions within defined time horizons without material market impact.'
}

Table risk.fx_risk_exposure {
  fx_risk_exposure_id varchar [pk, note: 'Unique identifier for the foreign exchange risk exposure record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: FX exposure approvals require documented accountability. Pension funds track who approved currency exposures for hedging policy compliance and governance.']
  fx_position_id varchar [note: 'Foreign key linking to treasury.fx_position. Business justification: FX risk exposure measurements must reference the underlying treasury FX position being assessed.']
  hedge_fx_trade_id varchar [note: 'Foreign key linking to trade.fx_trade. Business justification: Currency hedging programs require linking FX exposures to hedge trades. Pension funds with global mandates track hedge effectiveness per IAS 39/IFRS 9 and need exposure-to-hedge trade linkage']
  limit_id varchar [note: 'Reference to the risk limit framework governing this foreign exchange exposure.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding the currency exposure.']
  research_fx_rate_id varchar [note: 'Foreign key linking to research.research_fx_rate. Business justification: FX risk exposures use spot rates and volatility from research market data. Pension funds with global portfolios calculate currency exposures using research-maintained FX rates.']
  stress_scenario_id varchar [note: 'Reference to the macroeconomic stress scenario applied to calculate stressed foreign exchange exposure.']
  approval_date date [note: 'Date on which the foreign exchange exposure position was formally approved by the risk committee or investment committee.']
  asset_class varchar [note: 'The asset class category generating the foreign exchange exposure.']
  base_currency varchar [note: 'The reporting currency of the portfolio, typically the functional currency for risk measurement (ISO 4217 three-letter code).']
  breach_status varchar [note: 'Indicates whether the foreign exchange exposure is within limits, approaching limits, or in breach of risk thresholds.']
  calculation_methodology varchar [note: 'Statistical methodology used to calculate Value at Risk and other risk metrics for the foreign exchange exposure.']
  confidence_level decimal(4,2) [note: 'Statistical confidence level used for Value at Risk calculations, typically expressed as a percentage (e.g., 99.00 for 99%).']
  correlation_to_portfolio decimal(6,4) [note: 'Statistical correlation between the foreign exchange exposure and the overall portfolio returns, ranging from -1.0000 to 1.0000.']
  counterparty_lei varchar [note: 'Legal Entity Identifier of the counterparty for hedging instruments, if applicable.']
  created_timestamp timestamp [note: 'Timestamp when the foreign exchange risk exposure record was first created in the system.']
  currency_pair varchar [note: 'The currency pair representing the exchange rate relationship, formatted as base/exposure (e.g., EUR/USD).']
  cvar_1day_99pct decimal(18,2) [note: 'One-day Conditional Value at Risk (expected shortfall) at 99% confidence level for the foreign exchange exposure.']
  dv01 decimal(18,2) [note: 'Sensitivity of the foreign exchange position to a 1 basis point move in the exchange rate, expressed in base currency.']
  exposure_base_currency_equivalent decimal(20,2) [note: 'Net foreign exchange exposure translated into the base currency using the spot exchange rate at measurement date.']
  exposure_currency varchar [note: 'The foreign currency to which the portfolio has exposure (ISO 4217 three-letter code).']
  exposure_type varchar [note: 'Classification of the foreign exchange exposure: transaction (cash flow), translation (balance sheet), or economic (strategic).']
  geographic_region varchar [note: 'Geographic region or country code (ISO 3166-1 alpha-3) where the underlying assets generating the exposure are located.']
  gross_exposure_amount decimal(20,2) [note: 'Total unhedged foreign currency exposure amount in the exposure currency before any hedging instruments are applied.']
  hedge_effectiveness decimal(5,4) [note: 'Measure of how effectively the hedging instruments offset the foreign exchange exposure, expressed as a ratio (0.0000 to 1.0000).']
  hedge_instrument_type varchar [note: 'Type of derivative instrument used to hedge the foreign exchange exposure, or none if unhedged.']
  hedge_notional_amount decimal(20,2) [note: 'Notional amount of foreign exchange hedging instruments (forwards, swaps, options) applied to offset the exposure.']
  hedge_ratio decimal(5,4) [note: 'Proportion of gross exposure that is hedged, calculated as hedge notional divided by gross exposure (0.0000 to 1.0000).']
  limit_utilization_percentage decimal(5,2) [note: 'Percentage of the assigned foreign exchange risk limit consumed by this exposure.']
  measurement_date date [note: 'Date on which the foreign exchange risk exposure was measured and recorded.']
  modified_timestamp timestamp [note: 'Timestamp when the foreign exchange risk exposure record was last modified or updated.']
  net_exposure_amount decimal(20,2) [note: 'Net foreign currency exposure after hedging, calculated as gross exposure minus hedge notional.']
  notes varchar [note: 'Additional commentary, context, or observations regarding the foreign exchange risk exposure.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement or reporting framework applicable to this exposure.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this foreign exchange exposure must be included in regulatory reporting submissions.']
  risk_system_source varchar [note: 'Source system that calculated and provided the foreign exchange risk exposure data.']
  spot_rate decimal(18,6) [note: 'The current market exchange rate between the base currency and exposure currency at measurement date.']
  stressed_exposure_amount decimal(20,2) [note: 'Foreign exchange exposure amount under the applied stress scenario, expressed in base currency.']
  time_horizon_days varchar [note: 'Number of days over which the foreign exchange risk exposure is measured and risk metrics are calculated.']
  var_1day_99pct decimal(18,2) [note: 'One-day Value at Risk at 99% confidence level for the foreign exchange exposure, representing potential loss in base currency.']
  volatility decimal(8,6) [note: 'Historical or implied volatility of the currency pair, expressed as an annualized standard deviation.']

  Note: 'Transactional record of foreign exchange risk exposures across the investment portfolio, capturing unhedged and hedged currency positions by currency pair.'
}

Table risk.attribution {
  attribution_id varchar [pk, note: 'Unique identifier for the risk attribution record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Risk attribution approvals are required for performance reporting to beneficiaries. Pension funds must track who approved attribution analysis for IC presentations.']
  equity_benchmark_id varchar [note: 'Reference to the benchmark used for active risk calculation.']
  portfolio_id varchar [note: 'Reference to the portfolio for which risk is being attributed.']
  risk_model_id varchar [note: 'Foreign key linking to risk.model. Business justification: Attribution calculations use a specific risk model for decomposition. The attribution table has risk_model_name and risk_model_version columns that can be normalized by adding a FK to the model']
  stress_scenario_id varchar [note: 'Reference to the stress scenario under which this attribution was calculated, if applicable.']
  active_risk decimal(18,6) [note: 'Active risk or tracking error relative to benchmark, expressed in percentage terms.']
  allocation_risk decimal(18,6) [note: 'Portion of active risk attributable to asset allocation decisions across asset classes or sectors, expressed in percentage terms.']
  approval_date date [note: 'Date on which the risk attribution analysis was formally approved.']
  asset_class_risk decimal(18,6) [note: 'Portion of total risk attributable to asset class allocation decisions, expressed in percentage terms.']
  attribution_type varchar [note: 'Type of risk attribution analysis performed.']
  beta_to_benchmark decimal(10,6) [note: 'Beta coefficient measuring systematic risk of this component relative to the benchmark.']
  calculation_methodology varchar [note: 'Methodology used for risk attribution calculation, such as Brinson-Fachler, factor decomposition, or variance decomposition.']
  calculation_timestamp timestamp [note: 'Timestamp when the risk attribution calculation was performed.']
  component_var decimal(18,6) [note: 'Component VaR representing the standalone risk contribution of this attribution component, expressed in percentage terms.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level used for risk calculations, typically expressed as a percentage such as 95.00 or 99.00.']
  correlation_to_portfolio decimal(8,6) [note: 'Correlation coefficient between this risk component and total portfolio risk, ranging from -1.000000 to 1.000000.']
  created_timestamp timestamp [note: 'Timestamp when this risk attribution record was first created in the system.']
  currency_risk decimal(18,6) [note: 'Portion of total risk attributable to foreign exchange exposures, expressed in percentage terms.']
  cvar_contribution decimal(18,6) [note: 'Contribution of this attribution component to portfolio Conditional Value at Risk, expressed in percentage terms.']
  data_source varchar [note: 'Source system or platform from which attribution data was derived, such as BlackRock Aladdin, MSCI RiskMetrics, or SimCorp Dimension.']
  decomposition_level varchar [note: 'Granularity level at which risk attribution is decomposed.']
  factor_risk decimal(18,6) [note: 'Portion of total risk attributable to systematic factor exposures, expressed in percentage terms.']
  geographic_risk decimal(18,6) [note: 'Portion of total risk attributable to geographic or regional exposures, expressed in percentage terms.']
  interaction_risk decimal(18,6) [note: 'Portion of active risk attributable to the interaction between allocation and selection decisions, expressed in percentage terms.']
  marginal_var decimal(18,6) [note: 'Marginal contribution to portfolio VaR from a small change in this risk component, expressed in percentage terms.']
  measurement_date date [note: 'Date on which the risk attribution analysis was performed.']
  modified_timestamp timestamp [note: 'Timestamp when this risk attribution record was last modified.']
  notes varchar [note: 'Free-text notes or commentary regarding the risk attribution analysis, including any assumptions or caveats.']
  r_squared decimal(8,6) [note: 'R-squared statistic measuring the proportion of variance explained by the risk model, ranging from 0.000000 to 1.000000.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this attribution record is required for regulatory reporting to SEC, or other governing bodies.']
  review_status varchar [note: 'Current review and approval status of the risk attribution record.']
  risk_currency varchar [note: 'Three-letter ISO 4217 currency code in which risk metrics are expressed.']
  sector_risk decimal(18,6) [note: 'Portion of total risk attributable to sector allocation and selection, expressed in percentage terms.']
  selection_risk decimal(18,6) [note: 'Portion of active risk attributable to security selection decisions within asset classes or sectors, expressed in percentage terms.']
  specific_risk decimal(18,6) [note: 'Portion of total risk attributable to idiosyncratic or security-specific sources, expressed in percentage terms.']
  style_risk decimal(18,6) [note: 'Portion of total risk attributable to investment style factors such as value, growth, momentum, expressed in percentage terms.']
  time_horizon_days varchar [note: 'Time horizon in days over which risk is measured, commonly 1, 10, or 252 trading days.']
  total_risk decimal(18,6) [note: 'Total portfolio risk measured as standard deviation of returns, expressed in percentage terms.']
  var_contribution decimal(18,6) [note: 'Contribution of this attribution component to portfolio Value at Risk, expressed in percentage terms.']

  Note: 'Transactional record of risk attribution decomposing total portfolio risk (active risk / tracking error) into contributing sources: factor risk, specific risk, asset class risk, geographic risk, and currency risk.'
}

Table risk.sensitivity_analysis {
  sensitivity_analysis_id varchar [pk, note: 'Unique identifier for the sensitivity analysis run record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Sensitivity analysis sign-off is required for governance. Pension funds must document which employee approved scenario analysis for risk committee reporting.']
  holding_id varchar [note: 'Reference to the specific position being analyzed; null if portfolio-level analysis.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Greeks and sensitivity calculations (delta, gamma, vega) are computed per instrument. Essential for derivatives overlay strategies and options hedging programs common in pension fund risk']
  portfolio_id varchar [note: 'Reference to the portfolio being analyzed for sensitivity to factor shocks.']
  risk_factor_id varchar [note: 'Reference to the single risk factor being shocked in this sensitivity analysis.']
  stress_scenario_id varchar [note: 'Reference to the stress scenario configuration applied in this sensitivity run.']
  analysis_code varchar [note: 'Business identifier code for the sensitivity analysis run, used for reporting and tracking.']
  analysis_name varchar [note: 'Descriptive name of the sensitivity analysis run for business user identification.']
  analysis_status varchar [note: 'Current lifecycle status of the sensitivity analysis run.']
  analysis_type varchar [note: 'Classification of the sensitivity analysis methodology applied.']
  approval_timestamp timestamp [note: 'Date and time when the sensitivity analysis was approved.']
  as_of_date date [note: 'Valuation date for which the sensitivity analysis was performed.']
  asset_class varchar [note: 'Primary asset class of the portfolio or position being analyzed.']
  base_value decimal(28,8) [note: 'Portfolio or position value before the sensitivity shock is applied.']
  calculation_methodology varchar [note: 'Methodology used to calculate the sensitivity: full revaluation, delta approximation, Taylor expansion, Monte Carlo, or historical simulation.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level used in risk calculations, expressed as a decimal (e.g., 0.9500 for 95%).']
  convexity_impact decimal(12,6) [note: 'Impact on portfolio convexity resulting from the sensitivity shock.']
  created_timestamp timestamp [note: 'Date and time when the sensitivity analysis record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary values in this sensitivity analysis.']
  cvar_impact decimal(28,8) [note: 'Change in portfolio Conditional Value at Risk resulting from the sensitivity shock.']
  duration_impact decimal(12,6) [note: 'Impact on portfolio duration resulting from the sensitivity shock, measured in years.']
  dv01 decimal(18,6) [note: 'Dollar value change for a one basis point move in interest rates, if applicable to this analysis.']
  escalation_required_flag boolean [note: 'Indicates whether the sensitivity analysis result requires escalation to senior management or Investment Committee.']
  execution_timestamp timestamp [note: 'Date and time when the sensitivity analysis was executed.']
  geographic_region varchar [note: 'Geographic region of exposure for the portfolio or position being analyzed.']
  ic_review_required_flag boolean [note: 'Indicates whether the sensitivity analysis result requires Investment Committee review.']
  limit_breach_flag boolean [note: 'Indicates whether the sensitivity analysis result breached any defined risk limits.']
  limit_utilization_percentage decimal(12,6) [note: 'Percentage of risk limit utilized after the sensitivity shock is applied.']
  model_version varchar [note: 'Version identifier of the risk model used for the sensitivity analysis.']
  modified_timestamp timestamp [note: 'Date and time when the sensitivity analysis record was last modified.']
  notes varchar [note: 'Free-text notes or comments regarding the sensitivity analysis run, assumptions, or results.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement or framework that mandates this sensitivity analysis.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this sensitivity analysis is required for regulatory reporting purposes.']
  risk_factor_category varchar [note: 'High-level classification of the risk factor being analyzed. [ENUM-REF-CANDIDATE: equity|interest_rate|credit_spread|fx|commodity|volatility|inflation|macro — 8 candidates stripped; promote to reference product]']
  risk_system_source varchar [note: 'Source risk management system that generated this sensitivity analysis (e.g., Aladdin, RiskMetrics, Barra).']
  sector varchar [note: 'Economic sector classification of the portfolio or position being analyzed.']
  shock_direction varchar [note: 'Direction of the shock applied: upward, downward, parallel shift, curve twist, or custom.']
  shock_magnitude decimal(18,6) [note: 'Magnitude of the shock applied to the risk factor, expressed in units consistent with shock type.']
  shock_type varchar [note: 'Type of shock applied to the risk factor: absolute change, relative change, basis points, or percentage.']
  shocked_value decimal(28,8) [note: 'Portfolio or position value after the sensitivity shock is applied.']
  time_horizon_days varchar [note: 'Time horizon in days over which the sensitivity analysis is measured.']
  value_change decimal(28,8) [note: 'Absolute change in portfolio or position value resulting from the sensitivity shock.']
  value_change_percentage decimal(12,6) [note: 'Percentage change in portfolio or position value resulting from the sensitivity shock.']
  var_impact decimal(28,8) [note: 'Change in portfolio Value at Risk resulting from the sensitivity shock.']

  Note: 'Transactional record of sensitivity analysis runs measuring portfolio or position value changes in response to defined single-factor shocks (e.g., equity market -10%, credit spreads +100bps, oil price -30%, inflation +50bps).'
}

Table risk.risk_review {
  risk_review_id varchar [pk, note: 'Unique identifier for the risk review record.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Periodic risk reviews must document which external managers contributed to portfolio risk. IC risk reporting requires identifying GP-specific risk concentrations.']
  lead_reviewer_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Risk reviews must track the lead reviewer for accountability. Pension funds require documented ownership of periodic risk reviews for governance and audit.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio subject to this risk review.']
  research_report_id varchar [note: 'Foreign key linking to research.report. Business justification: Periodic risk reviews incorporate research reports for market context, sector analysis, and macroeconomic outlook. Risk committee presentations reference research findings.']
  strategy_id varchar [note: 'Identifier of the investment strategy being reviewed for risk assessment.']
  action_items varchar [note: 'Specific action items assigned to responsible parties with target completion dates.']
  approval_date date [note: 'Date on which the risk review was formally approved by the designated authority.']
  approved_by varchar [note: 'Name of the senior risk officer or executive who formally approved the risk review findings and recommendations.']
  asset_class varchar [note: 'Primary asset class focus of the risk review.']
  created_timestamp timestamp [note: 'Timestamp when this risk review record was first created in the system.']
  critical_breach_count varchar [note: 'Number of critical-severity risk limit breaches identified during the review period.']
  cvar_95_amount decimal(20,2) [note: 'Conditional Value at Risk (expected shortfall) at 95 percent confidence level as of the review date.']
  data_quality_issues varchar [note: 'Description of any data quality issues or gaps encountered during the review that may affect conclusions.']
  data_quality_score decimal(5,2) [note: 'Percentage score representing the completeness and accuracy of data used in the risk review, scale 0 to 100.']
  document_reference varchar [note: 'File path or document management system reference to the full risk review report and supporting materials.']
  emerging_risk_count varchar [note: 'Number of new or emerging risks identified during this review that require monitoring or action.']
  frequency varchar [note: 'Scheduled frequency at which this type of risk review is conducted. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|ad_hoc — 7 candidates stripped; promote to reference product]']
  ic_decision varchar [note: 'Decision or guidance provided by the Investment Committee in response to this risk review.']
  ic_review_date date [note: 'Date on which the Investment Committee reviewed this risk assessment.']
  ic_review_required_flag boolean [note: 'Indicates whether this risk review requires escalation to the Investment Committee for review and decision.']
  key_findings varchar [note: 'Summary of the most significant findings from the risk review including material risks, trends, and areas of concern.']
  limit_breach_count varchar [note: 'Number of risk limit breaches identified during the review period.']
  modified_timestamp timestamp [note: 'Timestamp when this risk review record was last modified.']
  next_review_date date [note: 'Scheduled date for the next periodic risk review of this scope.']
  notes varchar [note: 'Additional notes, context, or commentary related to the risk review.']
  period_end_date date [note: 'End date of the period covered by this risk review.']
  period_start_date date [note: 'Start date of the period covered by this risk review.']
  previous_risk_rating varchar [note: 'Risk rating from the prior review period for comparison and trend analysis.']
  recommendations varchar [note: 'Recommended actions and risk mitigation measures proposed by the review team.']
  regulatory_reference varchar [note: 'Citation of applicable regulatory requirement or guideline that mandates this review.']
  regulatory_reporting_flag boolean [note: 'Indicates whether findings from this review must be included in regulatory reporting submissions.']
  risk_currency varchar [note: 'Three-letter ISO 4217 currency code in which risk metrics are denominated.']
  risk_rating varchar [note: 'Overall risk rating assigned as a result of this review based on aggregate risk assessment.']
  risk_rating_change varchar [note: 'Direction of change in risk rating compared to the previous review period.']
  risk_review_code varchar [note: 'Business identifier for the risk review following format RR-YYYY-NNNNNN where YYYY is year and NNNNNN is sequence number.']
  risk_review_date date [note: 'Date on which the formal risk review was conducted or completed.']
  risk_review_status varchar [note: 'Current lifecycle status of the risk review process.']
  risk_review_type varchar [note: 'Category of risk review conducted: portfolio-level, counterparty-specific, concentration analysis, market risk, liquidity risk, or operational risk.']
  risk_system_source varchar [note: 'Primary risk analytics system from which risk metrics and data were sourced for this review.']
  scope varchar [note: 'Detailed description of the scope and boundaries of the risk review including specific portfolios, strategies, or risk factors examined.']
  stress_test_result varchar [note: 'Summary outcome of the stress test scenario including projected losses or impacts.']
  stress_test_scenario_applied varchar [note: 'Name or identifier of the macroeconomic stress test scenario applied during this review.']
  team_members varchar [note: 'Comma-separated list of team members who participated in conducting the risk review.']
  var_95_amount decimal(20,2) [note: 'Value at Risk calculated at 95 percent confidence level as of the review date.']
  var_99_amount decimal(20,2) [note: 'Value at Risk calculated at 99 percent confidence level as of the review date.']

  Note: 'Master record of formal periodic risk reviews conducted by the Risk Management team covering portfolio-level risk assessment, limit compliance status, emerging risk identification, and risk governance actions.'
}

Table risk.limit_assignment {
  limit_assignment_id varchar [pk, note: 'Unique identifier for the limit assignment record linking risk limits to portfolios, mandates, asset classes, or investment strategies.']
  assigned_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Limit assignments need documented assigner for governance. Pension funds track who assigned limits to portfolios/strategies for accountability and audit.']
  counterparty_id varchar [note: 'Reference to the counterparty to which this limit is assigned, if applicable for counterparty credit risk limits.']
  limit_id varchar [note: 'Reference to the risk limit being assigned to an entity.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate to which this limit is assigned, if applicable.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this limit is assigned, if applicable.']
  strategy_id varchar [note: 'Reference to the investment strategy to which this limit is assigned, if applicable.']
  approval_date date [note: 'Date on which this limit assignment was formally approved by the designated authority.']
  approved_by varchar [note: 'Name or identifier of the authority who approved this limit assignment, typically Chief Risk Officer (CRO) or Investment Committee (IC).']
  asset_class varchar [note: 'The asset class category to which this limit assignment applies such as public equities, private equity, real estate, infrastructure, natural resources, or credit.']
  assigned_limit_value decimal(20,4) [note: 'The specific limit threshold value assigned to this entity, which may differ from the base limit definition to accommodate entity-specific risk tolerance.']
  assignment_code varchar [note: 'Business identifier code for the limit assignment used for operational reference and reporting.']
  assignment_date date [note: 'Date on which this limit assignment was created and recorded in the system.']
  assignment_priority varchar [note: 'Priority ranking of this assignment when multiple overlapping limits apply to the same entity, with lower numbers indicating higher priority.']
  assignment_rationale varchar [note: 'Business justification and reasoning for assigning this specific limit to this entity, including risk considerations and strategic context.']
  assignment_status varchar [note: 'Current lifecycle status of the limit assignment indicating whether it is currently in force.']
  assignment_type varchar [note: 'Classification of the assignment indicating the entity type to which the limit is applied.']
  auto_remediation_flag boolean [note: 'Indicates whether automated remediation actions are enabled for breaches of this limit assignment.']
  breach_count_ytd varchar [note: 'Number of times this limit assignment has been breached in the current calendar year.']
  breach_tolerance_lower decimal(10,4) [note: 'Lower tolerance threshold as a percentage below which a soft breach warning is triggered before a hard limit breach.']
  breach_tolerance_upper decimal(10,4) [note: 'Upper tolerance threshold as a percentage above which a soft breach warning is triggered before a hard limit breach.']
  created_timestamp timestamp [note: 'Timestamp when this limit assignment record was first created in the system.']
  effective_date date [note: 'Date from which this limit assignment becomes active and enforceable.']
  escalation_level varchar [note: 'Organizational level to which limit breaches for this assignment must be escalated.']
  escalation_procedure varchar [note: 'Detailed procedure to be followed when a breach of this limit assignment occurs, including notification and remediation steps.']
  expiry_date date [note: 'Date on which this limit assignment ceases to be active, nullable for open-ended assignments.']
  geographic_region varchar [note: 'Geographic region or market to which this limit assignment applies for regional concentration limits.']
  last_breach_date date [note: 'Date of the most recent breach of this limit assignment.']
  last_review_date date [note: 'Date of the most recent review of this limit assignment.']
  limit_currency varchar [note: 'Three-letter ISO currency code for the assigned limit value.']
  limit_unit varchar [note: 'Unit of measure for the assigned limit such as currency amount, percentage, basis points, or Value at Risk (VaR) units.']
  modified_timestamp timestamp [note: 'Timestamp when this limit assignment record was last modified or updated.']
  monitoring_frequency varchar [note: 'Frequency at which this limit assignment is monitored for compliance and potential breaches.']
  next_review_date date [note: 'Scheduled date for the next review of this limit assignment.']
  notes varchar [note: 'Additional free-text notes, comments, or context regarding this limit assignment for operational reference.']
  override_flag boolean [note: 'Indicates whether this assignment overrides other conflicting limit assignments for the same entity.']
  regulatory_reference varchar [note: 'Citation of the specific regulatory requirement, rule, or guideline that mandates this limit assignment, if applicable.']
  regulatory_requirement_flag boolean [note: 'Indicates whether this limit assignment is mandated by regulatory requirements or is an internal risk management control.']
  remediation_action varchar [note: 'Predefined action to be taken automatically or manually when this limit assignment is breached, such as position reduction or trading halt.']
  review_frequency varchar [note: 'Scheduled frequency at which this limit assignment is reviewed for continued appropriateness and relevance.']
  risk_system_source varchar [note: 'Name of the risk management system from which this limit assignment originates, such as BlackRock Aladdin or MSCI RiskMetrics.']
  sector varchar [note: 'Industry sector to which this limit assignment applies for sector concentration limits.']
  utilization_percentage decimal(10,4) [note: 'Current utilization of the assigned limit expressed as a percentage, calculated as current exposure divided by limit value.']

  Note: 'Association record linking risk limits to specific portfolios, mandates, asset classes, or investment strategies. Captures the risk limit, the entity it applies to (portfolio, fund, asset class, manager mandate), effective start and end dates, assigned'
}

Table risk.factor_return {
  factor_return_id varchar [pk, note: 'Unique identifier for the factor return record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Factor return approvals are part of model governance. Pension funds must track who approved factor return data for use in risk calculations and attribution.']
  factor_id varchar [note: 'Reference to the risk factor for which this return is recorded.']
  risk_model_id varchar [note: 'Reference to the risk model under which this factor return was calculated.']
  approval_status varchar [note: 'The approval status of this factor return record within the risk governance framework.']
  approval_timestamp timestamp [note: 'The timestamp when this factor return was approved for use in risk calculations.']
  asset_class varchar [note: 'The asset class to which this factor return applies (e.g., public equities, fixed income, real estate, infrastructure).']
  benchmark_index_code varchar [note: 'The benchmark index code against which this factor return is measured, if applicable.']
  beta_to_market decimal(10,6) [note: 'The systematic risk measure of the factor relative to the overall market.']
  calculation_methodology varchar [note: 'Description of the methodology used to calculate this factor return (e.g., regression-based, principal component analysis, fundamental factor model).']
  calculation_timestamp timestamp [note: 'The timestamp when this factor return was calculated by the risk system.']
  confidence_level decimal(5,2) [note: 'The confidence level used in statistical testing of the factor return, expressed as a percentage (e.g., 95.00 for 95%).']
  correlation_to_market decimal(5,4) [note: 'The correlation coefficient between the factor return and the market return.']
  created_timestamp timestamp [note: 'The timestamp when this factor return record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the factor return is denominated.']
  data_quality_score decimal(5,2) [note: 'A quality score indicating the completeness and reliability of the underlying data used to calculate this factor return, expressed as a percentage.']
  data_source varchar [note: 'The source system or vendor from which the underlying data for this factor return was obtained (e.g., Bloomberg, MSCI, FactSet).']
  esg_integration_flag boolean [note: 'Indicates whether this factor incorporates ESG considerations in its construction or calculation.']
  factor_category varchar [note: 'High-level category of the risk factor (e.g., style, industry, country, currency, macroeconomic, statistical).']
  factor_type varchar [note: 'Specific type or sub-classification of the factor within its category (e.g., value, momentum, size, volatility).']
  geographic_region varchar [note: 'The geographic region or market to which this factor return applies (e.g., North America, Europe, Asia-Pacific, Global).']
  information_ratio decimal(10,4) [note: 'The ratio of active return to tracking error for the factor relative to its benchmark.']
  is_material_factor boolean [note: 'Indicates whether this factor is considered material to portfolio risk based on contribution thresholds.']
  is_proprietary boolean [note: 'Indicates whether this factor is a proprietary internal factor (True) or a vendor-provided factor (False).']
  lookback_period_days varchar [note: 'The number of days used in the historical lookback window for calculating this factor return.']
  modified_timestamp timestamp [note: 'The timestamp when this factor return record was last modified.']
  notes varchar [note: 'Free-text notes or comments regarding this factor return observation, including any anomalies or special considerations.']
  observation_count varchar [note: 'The number of data points or observations used in calculating this factor return.']
  r_squared decimal(5,4) [note: 'The coefficient of determination indicating the proportion of variance in returns explained by the factor model.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this factor return must be included in regulatory risk reporting submissions.']
  return_date date [note: 'The date for which this factor return is recorded.']
  return_percentage decimal(10,4) [note: 'The realized return of the risk factor expressed as a percentage for reporting purposes.']
  return_period_type varchar [note: 'The time period granularity for this factor return observation.']
  return_value decimal(18,8) [note: 'The realized return of the risk factor for the specified period, expressed as a decimal (e.g., 0.0125 for 1.25%).']
  sector_classification varchar [note: 'Industry sector classification if this is an industry factor return (e.g., GICS sector code or name).']
  sharpe_ratio decimal(10,4) [note: 'The risk-adjusted return metric for the factor, calculated as excess return divided by volatility.']
  t_statistic decimal(10,4) [note: 'The t-statistic measuring the statistical significance of the factor return.']
  usage_in_attribution boolean [note: 'Indicates whether this factor return is used in performance attribution analysis.']
  usage_in_stress_testing boolean [note: 'Indicates whether this factor return is used in macroeconomic stress testing and scenario analysis.']
  usage_in_var_calculation boolean [note: 'Indicates whether this factor return is used in historical simulation VaR calculations.']
  vendor_model_name varchar [note: 'The name of the vendor risk model used to generate this factor return (e.g., Barra Global Equity Model, MSCI World Factor Model).']
  vendor_model_version varchar [note: 'The version identifier of the vendor risk model used for this calculation.']
  volatility decimal(10,6) [note: 'The annualized volatility of the factor over the measurement period, expressed as a decimal.']

  Note: 'Transactional record of realized risk factor returns over defined periods, used for historical simulation VaR, factor model calibration, and performance attribution.'
}

Table risk.credit_rating {
  credit_rating_id varchar [pk, note: 'Unique identifier for the credit rating record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Credit rating overrides/approvals need documented accountability. Pension funds track who approved internal rating overrides for credit risk governance.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Credit ratings drive margin call thresholds and collateral eligibility decisions. Pension funds must assess counterparty creditworthiness for OTC derivative exposures.']
  rating_id varchar [note: 'FK to credit.rating.rating_id — Risk calculations that bucket by credit quality must use the single rating SSOT in credit to avoid divergent rating snapshots feeding VaR and concentration risk.']
  approval_date date [note: 'Date when the internal rating assessment or override was approved.']
  asset_class varchar [note: 'Asset class of the rated instrument or issuer: equity, fixed income, credit, structured products, sovereign, municipal, or corporate. [ENUM-REF-CANDIDATE: equity|fixed_income|credit|structured|sovereign|municipal|corporate — 7 candidates stripped; promote']
  created_timestamp timestamp [note: 'Timestamp when the credit rating record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Data quality score for the rating record, indicating completeness and accuracy of the data.']
  ecl_currency_code varchar [note: 'ISO 4217 three-letter currency code for the expected credit loss amount.']
  expected_credit_loss_amount decimal(18,2) [note: 'Expected credit loss amount calculated based on the rating, exposure, probability of default, and loss given default.']
  geographic_region varchar [note: 'Geographic region or country of the issuer or instrument domicile.']
  instrument_cusip varchar [note: 'CUSIP identifier of the instrument being rated, if applicable.']
  instrument_isin varchar [note: 'ISIN of the specific instrument being rated, if applicable. Null for issuer-level ratings.']
  internal_rating_override varchar [note: 'Internal credit assessment that overrides or supplements the external rating, if applicable.']
  internal_rating_rationale varchar [note: 'Rationale for internal rating override or adjustment, documenting the basis for deviation from external rating.']
  is_solicited_rating boolean [note: 'Indicates whether the rating was solicited by the issuer (true) or unsolicited (false).']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer or counterparty being rated.']
  issuer_name varchar [note: 'Legal name of the issuer or counterparty being rated.']
  last_review_date date [note: 'Date when the credit rating was last reviewed by internal risk management.']
  loss_given_default_pct decimal(8,5) [note: 'Estimated loss given default associated with the credit rating, expressed as a percentage of exposure at default.']
  maturity_date date [note: 'Maturity date of the rated instrument, if applicable.']
  modified_timestamp timestamp [note: 'Timestamp when the credit rating record was last modified in the system.']
  next_review_date date [note: 'Scheduled date for the next review of the credit rating by internal risk management.']
  notes varchar [note: 'Additional notes or comments regarding the credit rating, rating action, or internal assessment.']
  outlook varchar [note: 'Rating agency outlook indicating the potential direction of the rating: positive, stable, negative, developing, or not applicable.']
  previous_rating_value decimal(18,2) [note: 'The credit rating value prior to the most recent rating action, if applicable.']
  probability_of_default_pct decimal(8,5) [note: 'Estimated probability of default associated with the credit rating, expressed as a percentage.']
  rating_action_date date [note: 'Date when the rating agency took action (affirmed, upgraded, downgraded, or withdrew the rating).']
  rating_action_type varchar [note: 'Type of rating action taken: new assignment, affirmation, upgrade, downgrade, withdrawal, or suspension.']
  rating_agency varchar [note: 'Name of the rating agency that assigned the credit rating: S&P, Moody\'s, Fitch, DBRS, or Internal assessment.']
  rating_category varchar [note: 'Broad category of the credit rating: investment grade (IG), high yield (HY), non-rated, or default.']
  rating_change_notches varchar [note: 'Number of notches the rating changed in the most recent action (positive for upgrades, negative for downgrades).']
  rating_effective_date date [note: 'Date when the credit rating became effective or was assigned.']
  rating_notch varchar [note: 'Numeric notch representation of the rating for quantitative analysis, where higher values indicate better credit quality.']
  rating_scale varchar [note: 'Rating scale used: long-term, short-term, issuer default rating, or financial strength rating.']
  rating_source_identifier varchar [note: 'Unique identifier of the rating record in the source system.']
  rating_source_system varchar [note: 'Source system from which the credit rating data was obtained (e.g., Bloomberg, Aladdin, vendor feed).']
  rating_type varchar [note: 'Type of credit rating: issuer-level, instrument-level, counterparty, sovereign, municipal, corporate, or structured finance. [ENUM-REF-CANDIDATE: issuer|instrument|counterparty|sovereign|municipal|corporate|structured — 7 candidates stripped; promote to']
  rating_value decimal(18,2) [note: 'The actual credit rating value assigned by the rating agency (e.g., AAA, Aa1, BBB+, B-, CCC).']
  regulatory_reporting_flag boolean [note: 'Indicates whether this rating is used for regulatory capital or reporting purposes.']
  risk_weight_pct decimal(8,5) [note: 'Regulatory risk weight percentage assigned based on the credit rating for capital adequacy calculations.']
  sector_classification varchar [note: 'Industry sector classification of the issuer (e.g., financials, industrials, utilities, technology).']
  seniority varchar [note: 'Seniority level of the rated instrument in the capital structure: senior secured, senior unsecured, subordinated, junior, or equity.']
  watch_status varchar [note: 'Indicates if the rating is on credit watch for potential upgrade, downgrade, or under review.']

  Note: 'Master record of external credit ratings assigned to issuers and instruments held in the portfolio, sourced from rating agencies (S&P, Moody\'s, Fitch) and internal credit assessment.'
}

Table risk.risk_exception {
  risk_exception_id varchar [pk, note: 'Unique identifier for the risk exception record.']
  counterparty_id varchar [note: 'Reference to the counterparty entity if the exception relates to counterparty exposure limits.']
  limit_id varchar [note: 'Reference to the risk limit that this exception applies to.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Risk exceptions (limit overrides) are often granted for specific mandate allocations.']
  portfolio_id varchar [note: 'Reference to the investment portfolio for which the exception is granted.']
  requested_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Exception requests must track the requestor for governance. Pension funds require documented accountability for who initiated each risk exception request.']
  strategy_id varchar [note: 'Reference to the investment strategy associated with this exception.']
  approval_date date [note: 'Date when the exception was formally approved by the designated authority.']
  approval_level varchar [note: 'Organizational level or authority required to approve this exception based on materiality and risk.']
  approved_by varchar [note: 'Name or identifier of the individual or committee who approved the exception.']
  asset_class varchar [note: 'The asset class to which this exception applies. [ENUM-REF-CANDIDATE: public_equities|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|cash — 8 candidates stripped; promote to reference product]']
  breach_count varchar [note: 'Number of times the exception threshold itself has been breached during the active period.']
  business_rationale varchar [note: 'Detailed business justification for requesting the exception, including strategic context and expected benefits.']
  created_timestamp timestamp [note: 'Timestamp when the exception record was first created in the system.']
  currency varchar [note: 'Three-letter ISO currency code for monetary thresholds and limits.']
  duration_days varchar [note: 'Number of calendar days for which the exception is valid.']
  effective_date date [note: 'Date from which the exception becomes active and the portfolio may operate outside standard limits.']
  escalation_procedure varchar [note: 'Defined procedure for escalating issues if the exception threshold is itself breached or conditions change.']
  exception_code varchar [note: 'Business identifier code for the exception, typically formatted as three-letter prefix followed by six-digit sequence.']
  exception_name varchar [note: 'Short descriptive name of the risk exception for identification and reporting purposes.']
  exception_status varchar [note: 'Current lifecycle status of the exception request and approval.']
  exception_type varchar [note: 'Classification of the exception by the nature of the risk constraint being waived or exceeded.']
  expiry_date date [note: 'Date when the exception expires and standard limits are reinstated.']
  geographic_region varchar [note: 'Geographic region or market to which the exception applies, using three-letter country codes or regional groupings.']
  ic_review_date date [note: 'Date when the Investment Committee reviewed and approved the exception.']
  ic_review_required_flag boolean [note: 'Indicates whether Investment Committee review and approval is required for this exception.']
  last_breach_date date [note: 'Most recent date when the exception threshold was breached.']
  last_review_date date [note: 'Date of the most recent formal review of the exception.']
  mitigation_measures varchar [note: 'Specific risk mitigation actions or controls that will be implemented while the exception is active.']
  modified_timestamp timestamp [note: 'Timestamp when the exception record was last modified.']
  monitoring_frequency varchar [note: 'Frequency at which the portfolio will be monitored for compliance with the exception terms.']
  next_review_date date [note: 'Scheduled date for the next formal review of the exception.']
  notes varchar [note: 'Additional free-text notes or comments regarding the exception.']
  original_limit_value decimal(20,4) [note: 'The standard limit value that is being temporarily waived or exceeded.']
  regulatory_reference varchar [note: 'Reference to the specific regulatory requirement or guideline that governs this exception.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this exception must be reported to regulatory authorities.']
  request_date date [note: 'Date when the exception was formally requested.']
  review_frequency varchar [note: 'Frequency at which the exception will be formally reviewed by risk management or governance bodies.']
  revocation_date date [note: 'Date when the exception was revoked prior to its scheduled expiry.']
  revocation_reason varchar [note: 'Explanation for why the exception was revoked before its scheduled expiry date.']
  revoked_by varchar [note: 'Name or identifier of the individual or authority who revoked the exception.']
  risk_assessment varchar [note: 'Summary of the risk analysis conducted to evaluate the impact of granting the exception.']
  risk_system_source varchar [note: 'Name of the risk management system or platform from which the exception data originates.']
  sector varchar [note: 'Industry sector classification to which the exception applies.']
  threshold_value decimal(20,4) [note: 'The temporary threshold or limit value permitted under this exception.']
  unit_of_measure varchar [note: 'Unit in which the threshold is expressed, such as currency, percentage, basis points, or count.']
  utilization_percentage decimal(10,4) [note: 'Current utilization of the exception threshold as a percentage of the permitted limit.']
  variance_amount decimal(20,4) [note: 'Absolute difference between the exception threshold and the original limit.']
  variance_percentage decimal(10,4) [note: 'Percentage variance between the exception threshold and the original limit.']

  Note: 'Transactional record of formally approved exceptions to risk limits or investment policy constraints, where a portfolio is permitted to operate outside standard limits for a defined period.'
}

Table risk.correlation_matrix {
  correlation_matrix_id varchar [pk, note: 'Unique identifier for the correlation matrix record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Correlation matrix approvals are critical for model governance. Pension funds must track who approved correlation assumptions for VaR and stress testing.']
  portfolio_id varchar [note: 'Reference to the portfolio for which this correlation matrix is applied.']
  risk_model_id varchar [note: 'Reference to the risk model that uses this correlation matrix for portfolio risk calculations.']
  superseded_by_matrix_correlation_matrix_id varchar [note: 'Reference to the newer correlation matrix that replaces this one when status changes to superseded.']
  adjustment_applied_flag boolean [note: 'Indicates whether numerical adjustments were applied to ensure positive definiteness or stability.']
  adjustment_method varchar [note: 'Method used to adjust the matrix such as eigenvalue flooring, nearest correlation matrix, or Higham algorithm.']
  approval_date date [note: 'Date when the correlation matrix was formally approved for use in risk calculations.']
  as_of_date date [note: 'Business date for which the correlation matrix is calculated and applicable.']
  asset_class varchar [note: 'Primary asset class scope for the correlation matrix such as public equities, private equity, real estate, infrastructure, natural resources, or credit.']
  average_correlation decimal(8,6) [note: 'Mean of all pairwise correlation coefficients in the matrix, used for summary risk assessment.']
  calculation_timestamp timestamp [note: 'Precise timestamp when the correlation matrix was computed by the risk system.']
  condition_number decimal(20,6) [note: 'Ratio of largest to smallest eigenvalue indicating numerical stability and multicollinearity of the correlation matrix.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level for correlation estimates expressed as a decimal.']
  created_timestamp timestamp [note: 'Timestamp when this correlation matrix record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for returns used in correlation calculation.']
  data_source varchar [note: 'Source system or vendor providing the underlying return data for correlation estimation.']
  decay_factor decimal(10,6) [note: 'Exponential decay factor applied in weighted correlation estimation to give more weight to recent observations.']
  dimension_count varchar [note: 'Number of assets, factors, or entities included in the correlation matrix.']
  effective_from_date date [note: 'Date from which this correlation matrix becomes effective for risk calculations.']
  effective_to_date date [note: 'Date until which this correlation matrix remains effective, nullable for open-ended matrices.']
  estimation_methodology varchar [note: 'Statistical method used to estimate correlations such as rolling window, exponentially weighted moving average, or shrinkage estimator.']
  geographic_scope varchar [note: 'Geographic region or market scope covered by the correlation matrix such as global, regional, or country-specific.']
  ic_approval_required_flag boolean [note: 'Indicates whether Investment Committee approval is required before using this correlation matrix in risk calculations.']
  last_review_date date [note: 'Date when the correlation matrix was last reviewed by risk management or Investment Committee.']
  lookback_period_days varchar [note: 'Number of historical days used in the correlation estimation calculation.']
  matrix_code varchar [note: 'Business identifier code for the correlation matrix used in risk calculations and reporting.']
  matrix_determinant decimal(20,10) [note: 'Determinant of the correlation matrix used to assess matrix invertibility and numerical stability.']
  matrix_name varchar [note: 'Descriptive name of the correlation matrix for business user identification.']
  matrix_status varchar [note: 'Current lifecycle status of the correlation matrix in the risk management system.']
  matrix_type varchar [note: 'Type of correlation matrix indicating the dimension being correlated.']
  maximum_correlation decimal(8,6) [note: 'Highest correlation coefficient in the matrix indicating strongest positive relationship.']
  minimum_correlation decimal(8,6) [note: 'Lowest correlation coefficient in the matrix indicating strongest negative relationship.']
  model_version varchar [note: 'Version identifier of the risk model or calculation engine used to produce the correlation matrix.']
  modified_timestamp timestamp [note: 'Timestamp when this correlation matrix record was last modified in the system.']
  next_review_date date [note: 'Scheduled date for the next review of the correlation matrix.']
  notes varchar [note: 'Free-text notes or comments about the correlation matrix for risk analyst reference.']
  observation_frequency varchar [note: 'Frequency of return observations used in correlation estimation.']
  positive_definite_flag boolean [note: 'Indicates whether the correlation matrix is positive definite, a mathematical requirement for valid covariance matrices.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this correlation matrix is used for regulatory risk reporting requirements.']
  review_frequency varchar [note: 'Scheduled frequency for reviewing and recalculating the correlation matrix.']
  risk_system_source varchar [note: 'Name of the risk management system that generated or stores this correlation matrix such as Aladdin or RiskMetrics.']
  shrinkage_intensity decimal(5,4) [note: 'Intensity parameter for shrinkage estimator used to stabilize correlation estimates by blending sample and target matrices.']
  usage_in_stress_testing boolean [note: 'Indicates whether this correlation matrix is used in macroeconomic stress testing scenarios.']
  usage_in_var_calculation boolean [note: 'Indicates whether this correlation matrix is used in portfolio Value at Risk calculations.']
  vendor_model_name varchar [note: 'Name of the vendor risk model used to generate the correlation matrix such as MSCI Barra or RiskMetrics.']

  Note: 'Transactional record of asset class and factor correlation matrices used in portfolio risk calculations. Captures matrix type (asset class, factor, currency), the set of assets or factors included, correlation coefficients, estimation methodology (rolling'
}

Table risk.appetite_statement {
  appetite_statement_id varchar [pk, note: 'Unique identifier for the risk appetite statement record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Risk appetite statements require board/IC approval tracking. Pension funds must document which senior employee approved appetite statements for governance.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: TCFD governance pillar requires documented alignment between risk appetite and ESG/climate policies.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Pension fund risk appetite statements must align with regulatory requirements from specific authorities. The regulatory_requirement_flag indicates regulatory-driven appetite.']
  superseded_by_statement_appetite_statement_id varchar [note: 'Identifier of the risk appetite statement that supersedes this version, establishing version lineage and audit trail.']
  approval_date date [note: 'Date on which this risk appetite statement was formally approved by the board or designated committee.']
  asset_class varchar [note: 'Asset class to which this risk appetite statement applies, or all for enterprise-wide statements. [ENUM-REF-CANDIDATE: public_equities|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset|all — 8 candidates stripped; promote to']
  calculation_methodology varchar [note: 'Detailed description of the methodology used to calculate the risk metric, including model assumptions, data sources, and computational approach.']
  climate_scenario_alignment varchar [note: 'Description of alignment with climate-related financial risk scenarios, such as Task Force on Climate-related Financial Disclosures (TCFD) scenarios or net-zero transition pathways.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level used in risk metric calculation, typically 95.00 or 99.00 percent for Value at Risk (VaR) and Conditional Value at Risk (CVaR) measures.']
  created_timestamp timestamp [note: 'Timestamp when this risk appetite statement record was first created in the system, supporting audit trail and data lineage.']
  effective_date date [note: 'Date from which this risk appetite statement becomes binding and enforceable, typically aligned with board approval date.']
  escalation_level varchar [note: 'Governance level to which breaches of this risk appetite statement must be escalated, reflecting materiality and severity.']
  escalation_procedure varchar [note: 'Documented procedure for escalating risk appetite breaches, including notification protocols and decision-making authority.']
  esg_integration_flag boolean [note: 'Indicates whether this risk appetite statement explicitly incorporates Environmental, Social, and Governance (ESG) risk considerations.']
  expiry_date date [note: 'Date on which this risk appetite statement expires or is scheduled for mandatory review, typically annual or aligned with strategic planning cycle.']
  external_reference_code varchar [note: 'Unique identifier for this risk appetite statement in the external source system, enabling cross-system reconciliation and lineage tracking.']
  geographic_scope varchar [note: 'Geographic region or market to which this risk appetite statement applies, using ISO 3166-1 alpha-3 country codes or regional groupings.']
  last_review_date date [note: 'Date of the most recent formal review of this risk appetite statement by the board or designated committee.']
  liability_matching_consideration varchar [note: 'Description of how this risk appetite statement considers the pension funds long-duration liability profile and Asset-Liability Management (ALM) constraints.']
  modified_timestamp timestamp [note: 'Timestamp when this risk appetite statement record was last modified, supporting audit trail and change tracking.']
  monitoring_frequency varchar [note: 'Frequency at which risk exposure against this appetite statement is monitored and reported.']
  next_review_date date [note: 'Date of the next scheduled formal review of this risk appetite statement.']
  notes varchar [note: 'Free-text field for additional context, clarifications, or operational notes related to this risk appetite statement.']
  rationale varchar [note: 'Business rationale and strategic context for the defined risk tolerance levels, linking risk appetite to investment objectives and liability obligations.']
  regulatory_reference varchar [note: 'Citation or reference to the specific regulatory requirement, guideline, or supervisory expectation that this risk appetite statement addresses.']
  regulatory_requirement_flag boolean [note: 'Indicates whether this risk appetite statement is driven by or aligned with a specific regulatory requirement or supervisory expectation.']
  review_frequency varchar [note: 'Scheduled frequency for formal review and reaffirmation of the risk appetite statement by the board or designated committee.']
  risk_category varchar [note: 'Primary risk category that this appetite statement addresses, aligned with enterprise risk taxonomy.']
  risk_model_name varchar [note: 'Name of the risk model or system used to measure exposure against this appetite statement, such as Aladdin, RiskMetrics, or Barra.']
  risk_model_version varchar [note: 'Version identifier of the risk model used for measurement, ensuring consistency and auditability of risk calculations.']
  risk_subcategory varchar [note: 'Detailed subcategory within the primary risk category, such as equity risk, interest rate risk, or counterparty credit risk.']
  statement_code varchar [note: 'Externally-known unique business identifier for the risk appetite statement, typically used in board materials and regulatory filings.']
  statement_name varchar [note: 'Human-readable name or title of the risk appetite statement, typically reflecting the fiscal year or strategic planning period.']
  statement_status varchar [note: 'Current lifecycle status of the risk appetite statement within the governance approval workflow.']
  statement_version varchar [note: 'Version number of the risk appetite statement, incremented with each board-approved revision.']
  stress_scenario_alignment varchar [note: 'Description of how this risk appetite statement is calibrated or validated against enterprise stress testing scenarios and macroeconomic sensitivity analysis.']
  target_threshold decimal(18,4) [note: 'Target or preferred level of risk exposure, typically lower than the tolerance threshold, representing the desired operating range.']
  time_horizon_days varchar [note: 'Time horizon in days over which the risk metric is measured, commonly 1, 10, or 252 days for market risk.']
  tolerance_currency varchar [note: 'ISO 4217 three-letter currency code when tolerance threshold is expressed in monetary terms.']
  tolerance_metric varchar [note: 'The specific risk metric or measure used to quantify risk tolerance, such as Value at Risk (VaR), Conditional Value at Risk (CVaR), or tracking error.']
  tolerance_threshold decimal(18,4) [note: 'Numeric threshold value representing the maximum acceptable level of risk for the specified metric, expressed in the unit defined by tolerance unit.']
  tolerance_unit varchar [note: 'Unit of measure for the tolerance threshold value, such as currency, percentage, basis points, or ratio.']
  warning_threshold decimal(18,4) [note: 'Early warning threshold that triggers heightened monitoring and management attention before tolerance threshold is breached.']

  Note: 'Master record of the enterprise Risk Appetite Statement (RAS) defining the board-approved risk tolerance levels across risk categories: market risk, credit risk, liquidity risk, concentration risk, operational risk, and ESG risk.'
}

Table risk.model_validation {
  model_validation_id varchar [pk, note: 'Unique identifier for the model validation record.']
  employee_id varchar [note: 'Identifier of the user who initiated the validation.']
  job_run_user_employee_id varchar [note: 'Identifier of the user who triggered the job run.']
  model_employee_id varchar [note: 'Identifier of the user who initiated the validation.']
  model_id varchar [note: 'Identifier of the risk model being validated.']
  model_job_run_user_employee_id varchar [note: 'Identifier of the user who triggered the job run.']
  validation_run_id varchar [note: 'Unique alphanumeric code for the validation run.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  environment varchar [note: 'Execution environment of the validation run.']
  job_run_cluster_code varchar [note: 'Identifier of the cluster used for the job run.']
  job_run_cluster_config_hash varchar [note: 'Hash of the cluster configuration for integrity.']
  job_run_cluster_config_json varchar [note: 'JSON representation of the cluster configuration.']
  job_run_cluster_config_properties varchar [note: 'Cluster configuration properties as key-value pairs.']
  job_run_cluster_config_properties_hash varchar [note: 'Hash of the cluster configuration properties.']
  job_run_cluster_config_properties_json varchar [note: 'JSON of cluster configuration properties.']
  job_run_cluster_name varchar [note: 'Name of the cluster used for the job run.']
  job_run_cluster_type varchar [note: 'Type of cluster used for the job run.']
  job_run_cluster_version varchar [note: 'Version of the cluster used for the job run.']
  job_run_code varchar [note: 'Identifier of the Databricks job run.']
  job_run_end_time timestamp [note: 'Timestamp when the job run finished.']
  job_run_error varchar [note: 'Error message from the job run if any.']
  job_run_log_url varchar [note: 'URL to the job run logs.']
  job_run_parameters_hash varchar [note: 'Hash of the job run parameters for integrity.']
  job_run_parameters_json varchar [note: 'JSON of parameters passed to the job run.']
  job_run_start_time timestamp [note: 'Timestamp when the job run started.']
  job_run_status varchar [note: 'Current status of the Databricks job run.']
  job_run_user varchar [note: 'Username of the individual who triggered the job run.']
  model_validation_status varchar [note: 'Current lifecycle status of the validation process.']
  notes varchar [note: 'Free-text notes or observations from the validation.']
  platform varchar [note: 'Platform used for validation (e.g., Databricks).']
  risk_model_version varchar [note: 'Version of the risk model used in the validation.']
  updated_timestamp timestamp [note: 'Timestamp when the record was last updated.']
  validation_date timestamp [note: 'Timestamp when the validation was executed.']
  validation_duration_seconds varchar [note: 'Total duration of the validation in seconds.']
  validation_end_timestamp timestamp [note: 'Timestamp when the validation finished.']
  validation_engine varchar [note: 'Name of the engine or framework used for validation.']
  validation_engine_version varchar [note: 'Version of the validation engine.']
  validation_outcome varchar [note: 'Result of the validation process.']
  validation_parameters_hash varchar [note: 'Hash of the validation parameters for integrity.']
  validation_parameters_json varchar [note: 'JSON representation of parameters used in the validation.']
  validation_start_timestamp timestamp [note: 'Timestamp when the validation started.']
  validation_type varchar [note: 'Category of the validation activity.']
  validation_version varchar [note: 'Version identifier of the validation logic.']

  Note: 'Transactional record of risk model validation and backtesting activities required for model risk governance (model risk management guidance / SR 11-7 style). Captures the risk model validated, validation type (initial, periodic, backtest, benchmarking), validation date'
}

Table risk.scenario_requirement {
  scenario_requirement_id varchar [pk, note: 'Unique identifier for the scenario requirement record. Primary key.']
  obligation_id varchar [note: 'Foreign key linking to the compliance obligation requiring this scenario']
  stress_scenario_id varchar [note: 'Foreign key linking to the stress scenario that must be executed']
  applicability_status varchar [note: 'Whether this stress scenario is required, recommended, or optional for satisfying this compliance obligation. Derived from detection phase \'scenario_applicability_status\'.']
  compliance_deadline date [note: 'The deadline by which this stress scenario must be executed to satisfy this specific compliance obligation. Different obligations may have different deadlines for the same scenario.']
  created_timestamp timestamp [note: 'Timestamp when this scenario requirement record was created.']
  last_execution_date date [note: 'Date when this stress scenario was last executed specifically for this compliance obligation. Tracks execution history per obligation.']
  next_required_date date [note: 'The next date by which this stress scenario must be executed for this compliance obligation, based on filing frequency and regulatory requirements.']
  updated_timestamp timestamp [note: 'Timestamp when this scenario requirement record was last updated.']

  Note: 'This association product represents the contractual requirement linking stress scenarios to compliance obligations. It captures which stress scenarios must be executed to satisfy which regulatory or policy obligations, along with execution tracking and'
}

Table risk.calculation_run {
  calculation_run_id varchar [pk, note: 'Primary key for calculation_run']
  approved_by_user_employee_id varchar [note: 'Reference to the user who approved the calculation run results for official use or regulatory submission.']
  calculation_model_id varchar [note: 'Reference to the risk calculation model or methodology used for this run.']
  employee_id varchar [note: 'Reference to the user or system account that initiated or triggered the calculation run.']
  market_data_snapshot_id varchar [note: 'Reference to the market data and position data snapshot used as input for this calculation run.']
  parent_run_id varchar [note: 'Reference to the original calculation run if this is a rerun or child run in a hierarchical execution.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or portfolio group subject to this calculation run.']
  actual_end_timestamp timestamp [note: 'Actual date and time when the calculation run execution completed or terminated.']
  actual_start_timestamp timestamp [note: 'Actual date and time when the calculation run execution began.']
  approval_timestamp timestamp [note: 'Date and time when the calculation run results were formally approved.']
  asset_class_scope varchar [note: 'Asset classes included in the calculation run such as equities, fixed income, alternatives, or all asset classes.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code used as the base currency for all risk calculations and reporting.']
  calculation_methodology varchar [note: 'Specific methodology applied such as VaR, CVaR, Monte Carlo simulation, historical simulation, or parametric approach.']
  confidence_level_percent decimal(5,2) [note: 'Statistical confidence level used for Value at Risk and other probabilistic risk measures, typically 95% or 99%.']
  created_timestamp timestamp [note: 'Date and time when the calculation run record was first created in the system.']
  error_count varchar [note: 'Number of errors or exceptions encountered during the calculation run execution.']
  execution_duration_seconds varchar [note: 'Total elapsed time in seconds for the calculation run from start to completion.']
  failure_reason varchar [note: 'Description of the primary reason for calculation run failure if the run did not complete successfully.']
  is_official_run boolean [note: 'Indicates whether this is the official production run for the valuation date versus a test or draft run.']
  is_regulatory_submission boolean [note: 'Indicates whether this calculation run is intended for regulatory reporting submission.']
  is_rerun boolean [note: 'Indicates whether this calculation run is a rerun of a previous execution due to corrections or updates.']
  lookback_period_days varchar [note: 'Historical observation window in days used for calculating risk metrics and volatility estimates.']
  market_data_version varchar [note: 'Version identifier of the market data set used for pricing and risk factor inputs.']
  model_version varchar [note: 'Version number of the risk calculation model or algorithm used in this run for audit and reproducibility.']
  modified_timestamp timestamp [note: 'Date and time when the calculation run record was last updated.']
  output_file_path varchar [note: 'File system or storage path where calculation run output files and reports are stored.']
  position_count varchar [note: 'Total number of investment positions included in the calculation run scope.']
  regulatory_framework varchar [note: 'Regulatory framework or standard governing the calculation methodology such as Basel III, Solvency II, or internal policy.']
  reporting_period_end_date date [note: 'End date of the reporting period covered by this calculation run.']
  reporting_period_start_date date [note: 'Start date of the reporting period covered by this calculation run.']
  risk_category varchar [note: 'Primary risk category being calculated such as market risk, credit risk, liquidity risk, or operational risk.']
  run_code varchar [note: 'Business-readable alphanumeric code uniquely identifying the calculation run for external reference and audit trails.']
  run_description varchar [note: 'Detailed description of the calculation run purpose, scope, and any special parameters or assumptions.']
  run_name varchar [note: 'Descriptive name assigned to the calculation run for identification in reports and dashboards.']
  run_notes varchar [note: 'Additional notes or comments recorded by analysts regarding the calculation run or its results.']
  run_priority varchar [note: 'Execution priority level determining resource allocation and processing order in the calculation queue.']
  run_status varchar [note: 'Current execution status of the calculation run within its processing lifecycle.']
  run_type varchar [note: 'Classification of the calculation run purpose such as scheduled production, ad-hoc analysis, regulatory submission, or stress testing.']
  scenario_set_code varchar [note: 'Reference to the set of stress scenarios or macroeconomic scenarios applied in this calculation run.']
  scheduled_start_timestamp timestamp [note: 'Planned start date and time for the calculation run execution.']
  simulation_count varchar [note: 'Number of Monte Carlo simulations or scenario iterations executed in this calculation run.']
  time_horizon_days varchar [note: 'Number of days for the risk calculation holding period, commonly 1-day, 10-day, or 252-day horizons.']
  valuation_date date [note: 'As-of date for which risk metrics are calculated, representing the portfolio snapshot date.']
  warning_count varchar [note: 'Number of warnings or data quality issues flagged during the calculation run execution.']

  Note: 'Master reference table for calculation_run. Referenced by calculation_run_id.'
}

Table risk.stress_test_run {
  stress_test_run_id varchar [pk, note: 'Primary key for stress_test_run']
  actor_id varchar [note: 'Reference to the risk analyst or portfolio manager who initiated this stress test run.']
  approved_by_user_actor_id varchar [note: 'Reference to the senior risk officer or committee member who approved the stress test run results.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or portfolio group being stress tested in this run.']
  stress_scenario_id varchar [note: 'Reference to the macroeconomic or market scenario definition used for this stress test run.']
  approval_status varchar [note: 'Status of the stress test results approval workflow by risk governance.']
  approval_timestamp timestamp [note: 'Timestamp when the stress test run results were approved by the designated approver.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code in which all stress test results are denominated.']
  breach_threshold_exceeded boolean [note: 'Indicates whether the stress test results exceeded predefined risk tolerance thresholds.']
  comments varchar [note: 'Free-text comments or notes from risk analysts regarding the stress test run assumptions or results.']
  commodity_shock_percent decimal(8,4) [note: 'Percentage shock applied to commodity prices in the stress scenario.']
  confidence_level_percent decimal(5,2) [note: 'Statistical confidence level used for Value at Risk (VaR) and Conditional VaR calculations, typically 95.00 or 99.00 percent.']
  counterparty_default_rate decimal(8,4) [note: 'Assumed default rate for counterparty credit risk assessment in the stress scenario.']
  created_timestamp timestamp [note: 'Timestamp when this stress test run record was first created in the system.']
  credit_spread_shock_bps decimal(8,2) [note: 'Basis point widening or tightening applied to credit spreads in the stress scenario.']
  cvar_amount decimal(20,4) [note: 'Expected Shortfall or Conditional VaR representing the average loss beyond the VaR threshold.']
  dv01_amount decimal(18,4) [note: 'Interest rate sensitivity measure showing portfolio value change for a one basis point shift in rates.']
  equity_shock_percent decimal(8,4) [note: 'Percentage shock applied to equity positions in the stress scenario.']
  escalation_required boolean [note: 'Indicates whether the stress test results require escalation to senior management or risk committee.']
  fx_shock_percent decimal(8,4) [note: 'Percentage shock applied to foreign exchange rates in the stress scenario.']
  horizon_days varchar [note: 'Number of days over which the stress scenario is applied, typically 1, 10, 30, 90, or 252 trading days.']
  interest_rate_shock_bps decimal(8,2) [note: 'Basis point shift applied to interest rate curves in the stress scenario.']
  liquidity_haircut_percent decimal(8,4) [note: 'Percentage haircut applied to illiquid assets to reflect potential liquidation costs under stress.']
  methodology varchar [note: 'Calculation methodology used: historical simulation, parametric, Monte Carlo, or hybrid approach.']
  model_version varchar [note: 'Version identifier of the risk model or calculation engine used for this stress test run.']
  pnl_impact_amount decimal(20,4) [note: 'Estimated profit or loss impact from the stress scenario, calculated as stressed NAV minus base NAV.']
  pnl_impact_percent decimal(8,4) [note: 'Percentage change in portfolio value resulting from the stress scenario relative to base NAV.']
  portfolio_nav_base decimal(20,4) [note: 'Net Asset Value of the portfolio at the valuation date before applying stress scenario, in base currency.']
  real_estate_shock_percent decimal(8,4) [note: 'Percentage shock applied to real estate and infrastructure valuations in the stress scenario.']
  regulatory_framework varchar [note: 'Applicable regulatory framework for this stress test, such as Basel III, Solvency II, or local pension regulations.']
  regulatory_submission_required boolean [note: 'Indicates whether this stress test run is part of a regulatory reporting requirement.']
  run_code varchar [note: 'Business-readable unique code assigned to each stress test run for external reference and audit trail purposes.']
  run_end_timestamp timestamp [note: 'Timestamp when the stress test run execution completed or terminated.']
  run_name varchar [note: 'Descriptive name for the stress test run, typically indicating the scenario type and date for easy identification.']
  run_start_timestamp timestamp [note: 'Timestamp when the stress test run execution began processing.']
  run_status varchar [note: 'Current lifecycle status of the stress test run execution workflow.']
  run_type varchar [note: 'Classification of the stress test run by purpose: regulatory (mandated), internal (routine), ad_hoc, sensitivity, reverse, or custom.']
  simulation_count varchar [note: 'Number of Monte Carlo simulations or historical scenarios used in the stress test calculations.']
  stressed_nav decimal(20,4) [note: 'Projected Net Asset Value of the portfolio after applying the stress scenario, in base currency.']
  updated_timestamp timestamp [note: 'Timestamp when this stress test run record was last modified.']
  valuation_date date [note: 'As-of date for portfolio positions and market data used in the stress test calculations.']
  var_amount decimal(20,4) [note: 'Value at Risk measure representing the maximum expected loss at the specified confidence level and horizon.']

  Note: 'Master reference table for stress_test_run. Referenced by stress_test_run_id.'
}

Table risk.validation_run {
  validation_run_id varchar [pk, note: 'Primary key for validation_run']
  actor_id varchar [note: 'Reference to the user who initiated or triggered the validation run.']
  approved_by_user_actor_id varchar [note: 'Reference to the user who approved the validation run results for regulatory or internal use.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark used for comparative validation analysis.']
  portfolio_id varchar [note: 'Reference to the investment portfolio scope for this validation run.']
  regulatory_filing_id varchar [note: 'Reference to the regulatory report this validation run supports if applicable.']
  risk_model_id varchar [note: 'Reference to the risk model being validated in this run.']
  actual_end_timestamp timestamp [note: 'Actual date and time when the validation run execution completed or terminated.']
  actual_start_timestamp timestamp [note: 'Actual date and time when the validation run execution commenced.']
  approval_timestamp timestamp [note: 'Date and time when the validation run results were formally approved.']
  as_of_date date [note: 'Reference date for portfolio positions and market data snapshot used in the validation run.']
  asset_class_scope varchar [note: 'Asset classes included in the validation scope such as equities, fixed income, alternatives, or multi-asset.']
  christoffersen_p_value decimal(10,6) [note: 'Statistical p-value from the Christoffersen independence test for exception clustering analysis.']
  christoffersen_test_result varchar [note: 'Outcome of the Christoffersen conditional coverage test assessing exception clustering.']
  confidence_level_percent decimal(5,2) [note: 'Statistical confidence level used in the validation calculations, typically 95% or 99% for VaR models.']
  created_timestamp timestamp [note: 'Date and time when the validation run record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the base currency used in validation calculations.']
  data_quality_score decimal(5,2) [note: 'Quantitative assessment of input data quality used in the validation run, expressed as a percentage.']
  error_message varchar [note: 'Descriptive error message captured if the validation run failed or encountered issues during execution.']
  exception_threshold varchar [note: 'Maximum allowable number of exceptions before the model is flagged for review under regulatory guidelines.']
  execution_duration_seconds varchar [note: 'Total elapsed time in seconds for the validation run from start to completion.']
  kupiec_pof_p_value decimal(10,6) [note: 'Statistical p-value from the Kupiec proportion of failures test for model validation.']
  kupiec_pof_test_result varchar [note: 'Outcome of the Kupiec unconditional coverage test for backtesting VaR model accuracy.']
  lookback_period_days varchar [note: 'Historical observation window in days used for backtesting and model calibration during validation.']
  missing_data_percentage decimal(5,2) [note: 'Percentage of required data points that were missing or imputed during the validation run.']
  model_multiplier decimal(5,2) [note: 'Regulatory capital multiplier applied based on backtesting results, ranging from 3.0 to 4.0 under Basel guidelines.']
  notes varchar [note: 'Free-text notes or comments added by analysts regarding the validation run context or findings.']
  observation_end_date date [note: 'Ending date of the historical data window used in the validation analysis.']
  observation_start_date date [note: 'Beginning date of the historical data window used in the validation analysis.']
  overall_validation_result varchar [note: 'Aggregate outcome of all validation tests determining model fitness for continued use.']
  regulatory_submission_flag boolean [note: 'Indicates whether this validation run is intended for regulatory reporting submission.']
  run_code varchar [note: 'Business-readable alphanumeric code uniquely identifying the validation run for external reference and audit trails.']
  run_name varchar [note: 'Descriptive name assigned to the validation run for identification in reports and dashboards.']
  run_type varchar [note: 'Classification of the validation run purpose such as scheduled periodic runs, ad-hoc analysis, or regulatory submissions.']
  scenario_set_code varchar [note: 'Reference to the stress scenario set applied during validation if applicable.']
  scheduled_start_timestamp timestamp [note: 'Planned date and time when the validation run was scheduled to begin execution.']
  time_horizon_days varchar [note: 'Number of days representing the forward-looking time horizon for risk calculations in this validation run.']
  total_exceptions_count varchar [note: 'Number of backtesting exceptions or breaches identified during the validation run.']
  total_market_value_base decimal(20,4) [note: 'Aggregate market value of positions validated expressed in the base currency.']
  total_positions_validated varchar [note: 'Count of individual portfolio positions included in the validation run scope.']
  traffic_light_zone varchar [note: 'Basel traffic light classification indicating model performance based on exception count relative to thresholds.']
  updated_timestamp timestamp [note: 'Date and time when the validation run record was last modified.']
  validation_methodology varchar [note: 'The statistical or analytical methodology applied during validation such as historical simulation, Monte Carlo, or parametric approaches.']
  validation_run_status varchar [note: 'Current lifecycle state of the validation run execution process.']

  Note: 'Master reference table for validation_run. Referenced by validation_run_id.'
}

Table risk.factor_ic_observation {
  factor_ic_observation_id varchar [pk, note: 'Unique identifier for the factor ic observation record (factor ic observation id).']
  factor_id varchar [note: 'Foreign key reference to the factor identifier associated with this factor IC observation.']
  holding_period_days varchar [note: 'Number of days in the holding period over which the factor information coefficient observation is measured.']
  information_coefficient decimal(9,6) [note: 'Information coefficient measuring the correlation between the factor signal and subsequent realized returns for this observation.']
  period_end_date date [note: 'End date of the observation period for the factor information coefficient.']
  sector_name varchar [note: 'The sector name of the factor ic observation.']
  universe_size varchar [note: 'The universe size of the factor ic observation.']

  Note: 'Information coefficient of a factor signal, computed by the quant research team; one row per factor, period, holding period and sector.'
}

Table risk.factor_signal_prediction {
  factor_signal_prediction_id varchar [pk, note: 'Primary key identifier for the factor signal prediction record.']
  factor_id varchar [note: 'Reference to risk.factor.factor_id.']
  listed_security_id varchar [note: 'Reference to equity.listed_security.listed_security_id.']
  portfolio_id varchar [note: 'Reference to portfolio.portfolio.portfolio_id.']
  direction_correct_flag boolean [note: 'Indicator for direction correct flag on the factor signal prediction.']
  holding_period_days varchar [note: 'The holding period days of the factor signal prediction.']
  predicted_direction varchar [note: 'The predicted direction of the factor signal prediction.']
  prediction_date date [note: 'Prediction date of the factor signal prediction.']
  realized_return_percent decimal(18,8) [note: 'The realized return percent of the factor signal prediction.']
  signal_value decimal(18,8) [note: 'The signal value of the factor signal prediction.']

  Note: 'One directional prediction of a factor signal for one security.'
}

Table risk.strategy_backtest_result {
  strategy_backtest_result_id varchar [pk, note: 'Surrogate primary key.']
  factor_id varchar [note: 'FK to risk.factor, the signal the strategy trades.']
  period_end_date date [note: 'Period end date.']
  sample_type varchar [note: 'Sample type: in_sample, out_of_sample.']
  simulated_drawdown_percent decimal(18,8) [note: 'Simulated drawdown percent, stored as a negative number.']
  simulated_pnl_amount decimal(20,2) [note: 'Simulated PnL amount.']
  simulated_return_percent decimal(18,8) [note: 'Simulated return percent.']
  strategy_name varchar [note: 'Name of the candidate strategy.']
  vintage_date date [note: 'Backtest start or signal activation date.']

  Note: 'Simulated performance of a candidate strategy, one row per strategy, vintage and period.'
}

Table risk.factor_ic_correlation {
  factor_ic_correlation_id varchar [pk, note: 'Surrogate primary key.']
  factor_id varchar [note: 'FK to risk.factor.']
  paired_factor_id varchar [note: 'FK to risk.factor, the second factor of the pair.']
  correlation_value decimal(9,6) [note: 'Correlation value between -1 and 1.']
  lookback_period_days varchar [note: 'Lookback period in days.']
  period_end_date date [note: 'Period end date.']

  Note: 'Pairwise correlation of two factors information coefficients, one row per factor pair and period.'
}

Table esg.issuer_esg_rating {
  issuer_esg_rating_id varchar [pk, note: 'Unique surrogate identifier for each ESG rating record assigned to an investable issuer. Primary key for the issuer_esg_rating product in the ESG domain.']
  equity_issuer_id varchar [note: 'Reference to the investable issuer (corporate, sovereign, or real asset entity) to which this ESG rating applies. Links to the master issuer record.']
  asset_class varchar [note: 'Primary asset class of the issuer\'s securities held or evaluated by the pension fund. Determines ESG integration approach and applicable SFDR product-level disclosures. [ENUM-REF-CANDIDATE: promote to reference product]']
  carbon_intensity decimal(12,4) [note: 'Issuer\'s GHG emissions intensity measured in tonnes of CO2 equivalent per USD million of revenue. Key TCFD and SFDR climate metric used in portfolio carbon footprint reporting and net-zero alignment analysis.']
  created_timestamp timestamp [note: 'Timestamp when this ESG rating record was first ingested into the Databricks Silver Layer from the source system (MSCI ESG Ratings feed or internal assessment). Supports data lineage and audit trail.']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the issuer\'s country of domicile/incorporation. Used for sovereign ESG overlay, country-level exclusion screening, and SFDR geographic disclosures.']
  emissions_data_source varchar [note: 'Indicates whether the issuer\'s GHG emissions data is directly reported by the issuer, estimated by the rating provider, or modeled. Affects data quality weighting in TCFD and SFDR disclosures.']
  engagement_priority_flag boolean [note: 'Indicates whether the issuer has been designated as a priority for active ESG engagement by the responsible investment stewardship team, based on ESG rating, controversy level, or portfolio weight.']
  environmental_score decimal(5,2) [note: 'Numeric score for the Environmental pillar of the ESG rating, covering climate change, natural resources, pollution, and environmental opportunities. Sourced from MSCI ESG Ratings.']
  esg_controversy_level varchar [note: 'Categorical severity level of ESG controversies for the issuer per MSCI methodology (0–10 scale mapped to levels). Used in exclusion screening and engagement prioritization workflows.']
  esg_controversy_score decimal(5,2) [note: 'Numeric score reflecting the severity of ESG-related controversies involving the issuer, sourced from MSCI ESG Controversy Scores. High controversy scores may trigger exclusion list review.']
  esg_data_coverage_pct decimal(5,2) [note: 'Percentage of ESG key issues for which underlying data is available for this issuer, as reported by the rating provider. Indicates data completeness and reliability of the ESG rating.']
  esg_rating_category varchar [note: 'Broad categorical classification of the issuer\'s ESG performance: Leader (AAA–AA), Average (A–BBB–BB), or Laggard (B–CCC). Used for portfolio-level ESG reporting and SAA constraints.']
  esg_rating_grade varchar [note: 'Letter-grade ESG rating assigned by the provider (e.g., MSCI scale: AAA to CCC). Represents the issuer\'s ESG risk category used in investment screening, exclusion lists, and SFDR classification.']
  esg_rating_methodology_version varchar [note: 'Version identifier of the ESG rating methodology applied by the provider (e.g., MSCI ESG Ratings v3.1). Required for audit trail and to identify ratings produced under different methodology vintages.']
  esg_rating_score decimal(5,2) [note: 'Numeric ESG score assigned by the rating provider, typically on a 0–10 scale for MSCI. Represents the issuer\'s overall ESG risk management performance used in portfolio construction and IC reporting.']
  exclusion_reason varchar [note: 'Narrative description of the reason for the issuer\'s inclusion on the exclusion list (e.g., controversial weapons, severe ESG controversy, UNGC non-compliance). Populated only when on_exclusion_list is True.']
  gics_industry_code varchar [note: 'Eight-digit GICS industry code providing granular industry classification for the issuer. Enables industry-adjusted ESG key issue weighting in MSCI ESG Ratings methodology.']
  gics_sector_code varchar [note: 'Two-digit GICS sector code classifying the issuer\'s primary industry. Used for sector-level ESG benchmarking, peer comparison, and industry-adjusted ESG scoring in MSCI RiskMetrics.']
  governance_score decimal(5,2) [note: 'Numeric score for the Governance pillar of the ESG rating, covering corporate governance, corporate behavior, and board structure. Sourced from MSCI ESG Ratings.']
  industry_adjusted_score decimal(5,2) [note: 'ESG score normalized relative to the issuer\'s GICS industry peer group, enabling cross-sector comparison. Used in BlackRock Aladdin ESG analytics for relative ESG positioning within sector allocations.']
  internal_esg_override_flag boolean [note: 'Indicates whether the pension fund\'s internal ESG team has applied an override to the external provider\'s rating based on proprietary due diligence or investment committee decision.']
  internal_esg_override_grade varchar [note: 'The internally assigned ESG rating grade when the internal team overrides the external provider\'s rating. Null if no override is applied. Used in IC reporting and investment decision documentation.']
  internal_override_rationale varchar [note: 'Narrative justification provided by the internal ESG team for overriding the external provider\'s rating. Required for audit trail and IC governance documentation when override flag is True.']
  isin varchar [note: '12-character ISIN code identifying the primary security of the issuer, used to link ESG ratings to portfolio holdings in SimCorp Dimension and BlackRock Aladdin.']
  issuer_name varchar [note: 'Full legal name of the issuer entity (corporate, sovereign, or real asset) as recognized by the ESG rating provider. Used for display and reconciliation purposes.']
  issuer_type varchar [note: 'Classification of the issuer entity type for ESG rating methodology selection. Determines which MSCI ESG rating framework applies (corporate, sovereign, or real asset methodology).']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this ESG rating record in the Silver Layer. Used for incremental data pipeline processing, change detection, and audit trail compliance.']
  lei_code varchar [note: '20-character ISO 17442 Legal Entity Identifier uniquely identifying the issuer globally. Used for cross-system reconciliation and regulatory reporting under EMIR and MiFID II.']
  net_zero_target_flag boolean [note: 'Indicates whether the issuer has publicly committed to a net-zero GHG emissions target. Used in portfolio net-zero alignment analysis and TCFD transition risk assessment.']
  net_zero_target_year varchar [note: 'The year by which the issuer has committed to achieving net-zero GHG emissions. Null if no net-zero target has been set. Used in transition risk modeling and portfolio decarbonization pathway analysis.']
  on_exclusion_list boolean [note: 'Indicates whether the issuer is currently on the pension fund\'s internal exclusion list, prohibiting new investment. Driven by ESG screening, UNGC non-compliance, or IC-approved exclusion decisions.']
  prior_esg_rating_grade varchar [note: 'The issuer\'s ESG rating grade from the immediately preceding rating cycle. Used to identify rating upgrades or downgrades and assess ESG momentum for engagement prioritization.']
  proxy_voting_policy_alignment varchar [note: 'Assessment of the issuer\'s governance practices alignment with the pension fund\'s proxy voting policy. Used in stewardship reporting and annual proxy voting disclosure to beneficiaries.']
  rating_change_direction varchar [note: 'Direction of change from the prior ESG rating grade to the current grade. Upgrade or Downgrade triggers internal review and potential engagement action per the responsible investment stewardship policy.']
  rating_date date [note: 'The date on which the ESG rating was officially assigned or last updated by the rating provider. Used to determine rating currency and trigger review workflows in BlackRock Aladdin.']
  rating_effective_date date [note: 'Date from which this ESG rating version is considered effective for portfolio management and compliance purposes. Supports point-in-time ESG analysis and SFDR periodic reporting.']
  rating_expiry_date date [note: 'Date on which this ESG rating version expires or is superseded by a new rating. Null if the rating remains current. Used to manage rating staleness and trigger re-assessment workflows.']
  rating_provider varchar [note: 'Organization that produced the ESG rating. Primary source is MSCI ESG Ratings via MSCI RiskMetrics and Barra; supplemented by internal assessments. [ENUM-REF-CANDIDATE: MSCI|Sustainalytics|ISS ESG|Bloomberg ESG|Internal|Refinitiv|S&P Global ESG — promote']
  rating_status varchar [note: 'Current lifecycle status of this ESG rating record. Active ratings are used in portfolio analytics; Superseded records are retained for historical point-in-time analysis and GIPS compliance.']
  scope1_emissions decimal(15,2) [note: 'Issuer\'s direct Scope 1 GHG emissions in tonnes of CO2 equivalent, as reported or estimated. Required for TCFD climate risk disclosure and SFDR Principal Adverse Impact (PAI) indicator reporting.']
  scope2_emissions decimal(15,2) [note: 'Issuer\'s indirect Scope 2 GHG emissions from purchased energy in tonnes of CO2 equivalent. Required for TCFD climate risk disclosure and SFDR PAI indicator reporting.']
  scope3_emissions decimal(15,2) [note: 'Issuer\'s value chain Scope 3 GHG emissions in tonnes of CO2 equivalent. Used in portfolio-level financed emissions calculations and net-zero pathway alignment assessments per TCFD.']
  sfdr_pai_flag boolean [note: 'Indicates whether this issuer contributes to one or more SFDR Principal Adverse Impact indicators at the portfolio level. True triggers inclusion in mandatory PAI statement disclosures.']
  social_score decimal(5,2) [note: 'Numeric score for the Social pillar of the ESG rating, covering human capital, product liability, stakeholder opposition, and social opportunities. Sourced from MSCI ESG Ratings.']
  source_system_rating_code varchar [note: 'Native identifier of this ESG rating record in the originating source system (e.g., MSCI ESG Ratings platform or BlackRock Aladdin ESG module). Used for upstream reconciliation and data lineage tracing.']
  tcfd_alignment_status varchar [note: 'Assessment of the issuer\'s climate-related financial disclosures against TCFD recommendations. Used in portfolio-level TCFD reporting and climate risk integration into investment decisions.']
  ungc_compliance_status varchar [note: 'Issuer\'s compliance status with the UN Global Compact principles covering human rights, labor, environment, and anti-corruption. Non-compliant issuers are candidates for exclusion list review per PRI commitments.']
  weapons_involvement_flag boolean [note: 'Indicates whether the issuer is involved in the manufacture or sale of controversial weapons (cluster munitions, anti-personnel mines, biological/chemical weapons). Triggers mandatory exclusion screening.']

  Note: 'Master record of ESG ratings assigned to investable issuers (corporates, sovereigns, real assets) sourced primarily from MSCI ESG Ratings and supplemented by internal assessments.'
}

Table esg.framework {
  framework_id varchar [pk, note: 'Unique surrogate identifier for each ESG framework, standard, or regulatory regime record in the reference catalogue. Primary key. Role: REFERENCE_LOOKUP — exempt from per-role minimums; serves as a controlled vocabulary for ESG framework adoption.']
  abbreviation varchar [note: 'Widely recognised acronym or abbreviation for the framework (e.g., PRI, SFDR, TCFD, GRI). Distinct from code where the code may include versioning or internal suffixes.']
  adoption_date date [note: 'Date on which the fund\'s Investment Committee or Board formally approved adoption of this ESG framework into the fund\'s responsible investment programme and policies.']
  adoption_status varchar [note: 'Current lifecycle status of the framework within the fund\'s ESG programme: adopted (in active use), under_review (being assessed), pending_adoption, superseded (replaced by newer version), withdrawn, or not_applicable.']
  applicable_jurisdiction varchar [note: 'Geographic or regulatory jurisdiction(s) where the framework applies or is mandated (e.g., \'EU\', \'GBR\', \'CAN\', \'Global\'). Pipe-delimited ISO 3166-1 alpha-3 codes or \'Global\' for universal frameworks.']
  assessment_score decimal [note: 'Quantitative compliance assessment score for this framework-obligation combination, typically 0-100']
  asset_class_scope varchar [note: 'Asset classes to which this framework applies within the fund\'s portfolio (e.g., \'public_equities\', \'private_equity\', \'real_estate\', \'infrastructure\', \'all\'). Pipe-delimited list.']
  assurance_provider varchar [note: 'Name of the external assurance or audit firm engaged to verify the fund\'s compliance disclosures under this framework (e.g., \'PwC\', \'Deloitte\', \'EY\'). Null if external assurance is not required or not yet engaged.']
  benchmark_alignment varchar [note: 'Name of any ESG benchmark, index, or reference portfolio aligned to this framework (e.g., \'Paris-Aligned Benchmark\', \'EU Climate Transition Benchmark\', \'MSCI ESG Leaders Index\'). Null if no benchmark alignment.']
  climate_related boolean [note: 'Indicates whether this framework specifically addresses climate-related financial risks and disclosures (True), such as TCFD, TNFD, SFDR PAI climate indicators, or GHG reporting standards.']
  compliance_category varchar [note: 'Categorises the basis of the fund\'s obligation to the framework: regulatory (legally mandated), voluntary (self-elected commitment), best_practice (industry norm), or contractual (required by LPA or mandate terms).']
  compliance_score decimal(5,2) [note: 'Numeric score (0.00–100.00) representing the fund\'s assessed level of compliance or alignment with this framework at the last assessment date. Sourced from internal ESG assessments or PRI assessment results.']
  compliance_status varchar [note: 'Current compliance status for this specific framework-obligation pairing']
  created_timestamp timestamp [note: 'Timestamp when this ESG framework record was first created in the data catalogue. Supports data lineage, audit trail, and Silver layer provenance tracking per lakehouse governance standards.']
  data_source_system varchar [note: 'Operational system of record that is the primary source of ESG data for this framework\'s reporting (e.g., \'BlackRock Aladdin\', \'MSCI RiskMetrics\', \'eFront\', \'SimCorp Dimension\'). Supports data lineage.']
  effective_date date [note: 'Date from which this version of the framework became effective and applicable to the fund\'s investment and reporting activities. Used for compliance timeline tracking.']
  engagement_applicable boolean [note: 'Indicates whether this framework requires or recommends active engagement with investee companies or external fund managers on ESG matters (True). Supports engagement activity logging and stewardship reporting.']
  esg_pillar varchar [note: 'Primary Environmental, Social, and Governance (ESG) pillar addressed by the framework. \'cross_pillar\' indicates the framework spans all three dimensions (e.g., PRI, GRI).']
  exclusion_list_applicable boolean [note: 'Indicates whether this framework mandates or recommends maintaining an investment exclusion list (e.g., controversial weapons under UNGC, fossil fuel exclusions under certain SFDR Article 9 mandates).']
  expiry_date date [note: 'Date on which this version of the framework ceases to be applicable, superseded by a newer version or withdrawn. Null if the framework version remains open-ended and currently in force.']
  external_assurance_required boolean [note: 'Indicates whether the framework requires or recommends third-party external assurance or audit of the fund\'s disclosures (True). Relevant for GRI, SFDR RTS, and TCFD-aligned reporting.']
  external_reference_url varchar [note: 'Official URL to the governing body\'s published framework documentation, standard text, or regulatory guidance. Enables direct access to source material for compliance and due diligence teams.']
  framework_code varchar [note: 'Short, unique alphanumeric code identifying the ESG framework (e.g., PRI, SFDR, TCFD, UNGC, SASB, GRI, TNFD). Used as the business key across systems and reporting outputs.']
  framework_type varchar [note: 'Categorical classification of the ESG framework by its nature: regulatory regime (SFDR, EMIR), voluntary principle (PRI, UNGC), disclosure framework (TCFD, TNFD), reporting standard (GRI, SASB), or rating methodology (MSCI ESG).']
  full_name varchar [note: 'Complete official name of the ESG framework or standard (e.g., \'Principles for Responsible Investment\', \'Sustainable Finance Disclosure Regulation\'). Used in regulatory and beneficiary reporting.']
  ghg_reporting_required boolean [note: 'Indicates whether the framework mandates or recommends Greenhouse Gas (GHG) emissions reporting (Scope 1, 2, or 3) as part of the fund\'s disclosure obligations.']
  governing_body varchar [note: 'Name of the organisation or regulatory authority that owns, maintains, and publishes the framework (e.g., \'UN PRI Association\', \'European Commission\', \'TCFD Secretariat / IFRS Foundation\', \'GRI Standards Board\').']
  integration_level varchar [note: 'Degree to which this framework is integrated into the fund\'s investment decision-making process: full (embedded in IC process), partial (considered but not binding), monitoring_only, or not_integrated.']
  is_mandatory boolean [note: 'Indicates whether compliance with this framework is legally or regulatorily mandatory for the fund (True) or voluntary (False). Mandatory frameworks include SFDR, MiFID II ESG; voluntary include PRI, TCFD (pre-ISSB).']
  last_assessment_date date [note: 'Date of the most recent internal or external assessment of the fund\'s compliance posture and performance against this framework. Supports ongoing ESG governance and audit readiness.']
  materiality_approach varchar [note: 'Materiality concept applied by the framework: single_materiality (financial impact on the fund), double_materiality (financial + societal/environmental impact), dynamic_materiality, or not_specified. Relevant for GRI vs SASB vs SFDR.']
  next_review_date date [note: 'Scheduled date for the next compliance review of this specific framework-obligation mapping']
  notes varchar [note: 'Free-text field for additional context, implementation notes, known gaps, or commentary on the fund\'s adoption and compliance posture for this ESG framework. Used by the ESG & Responsible Investment team.']
  pai_indicator_required boolean [note: 'Indicates whether the framework requires disclosure of Principal Adverse Impact (PAI) indicators on sustainability factors, as defined under SFDR Article 7 and Regulatory Technical Standards.']
  pri_module varchar [note: 'Specific PRI Transparency Report module(s) associated with this framework (e.g., \'Strategy & Governance\', \'Listed Equity\', \'Private Equity\', \'Infrastructure\'). Null if framework is not PRI-related.']
  proxy_voting_applicable boolean [note: 'Indicates whether this framework includes requirements or guidance on proxy voting and shareholder engagement stewardship activities (True). Relevant for PRI, UK Stewardship Code, and similar frameworks.']
  publication_date date [note: 'Date on which the governing body officially published or released this version of the framework. Distinct from the effective_date on which the fund\'s obligations commence.']
  reporting_deadline_month varchar [note: 'Calendar month (1–12) by which the fund\'s annual or periodic disclosure under this framework must be submitted to the governing body or published publicly. Supports ESG reporting calendar management.']
  reporting_frequency varchar [note: 'Required or expected frequency of disclosure or reporting under this framework (e.g., annual PRI Transparency Report, annual TCFD disclosure). Drives the fund\'s ESG reporting calendar.']
  responsible_team varchar [note: 'Name of the internal team or business unit responsible for managing compliance with and reporting under this framework (e.g., \'ESG & Responsible Investment\', \'Risk Management\', \'Legal & Compliance\').']
  review_date date [note: 'Scheduled date for the fund\'s next internal review of this framework\'s applicability, version currency, and compliance posture. Supports proactive ESG governance and regulatory change management.']
  sfdr_article_classification varchar [note: 'SFDR product classification applicable to this framework context: Article 6 (no sustainability integration), Article 8 (promotes environmental/social characteristics), Article 9 (sustainable investment objective), or not_applicable.']
  signatory_date date [note: 'Date on which the fund formally became a signatory to the framework or voluntary principle. Null if the fund is not a signatory. Relevant for PRI, UNGC, TCFD supporter declarations.']
  signatory_status varchar [note: 'The fund\'s formal signatory status with the framework\'s governing body: signatory (committed member), non_signatory, pending (application submitted), or former_signatory (previously committed, now withdrawn).']
  taxonomy_alignment varchar [note: 'Sustainable finance taxonomy to which this framework aligns for classifying environmentally sustainable economic activities (e.g., EU Taxonomy Regulation, UK Green Taxonomy, ASEAN Taxonomy). Supports SFDR and TCFD reporting.']
  tcfd_pillar varchar [note: 'TCFD disclosure pillar addressed by this framework: Governance, Strategy, Risk Management, or Metrics and Targets. Null or not_applicable for non-TCFD frameworks. Supports TCFD alignment mapping.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this ESG framework record. Used for change tracking, incremental data loads, and audit compliance in the Databricks Silver layer.']
  version varchar [note: 'Version or edition of the framework currently adopted by the fund (e.g., \'2.0\', \'2021\', \'Article 8\', \'GRI 2021\'). Tracks which iteration of the standard is in force for compliance purposes.']

  Note: 'Reference catalogue of ESG frameworks, standards, and regulatory regimes adopted by the fund (PRI, SFDR, TCFD, UNGC, SASB, GRI, TNFD). Stores framework code, full name, governing body, applicable jurisdiction, version, effective date, and mandatory vs.'
}

Table esg.esg_policy {
  esg_policy_id varchar [pk, note: 'Unique identifier for the responsible investment policy record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: ESG policy governance requires documented approval chains for regulatory compliance and audit. Investment policies must track which employee formally approved them.']
  superseded_policy_esg_policy_id varchar [note: 'Identifier of the previous policy version that this policy replaces.']
  approval_date date [note: 'Date on which the policy was formally approved by the Investment Committee (IC) or Board.']
  baseline_year varchar [note: 'Reference year for measuring progress against climate or ESG targets (e.g., 2020, 2019).']
  breach_escalation_procedure varchar [note: 'Description of the procedure to follow when a policy breach is detected (e.g., notify IC, divest within 90 days, escalate to Board).']
  climate_alignment_target varchar [note: 'Specific climate-related target or commitment defined by the policy (e.g., net-zero by 2050, Paris Agreement alignment, 1.5°C pathway).']
  compliance_monitoring_method varchar [note: 'Method used to monitor compliance with the policy (automated system checks, manual review, or hybrid approach).']
  created_timestamp timestamp [note: 'Timestamp when the policy record was first created in the system.']
  document_url varchar [note: 'URL to the official published version of the policy document.']
  effective_date date [note: 'Date from which the policy becomes binding and enforceable across the investment portfolio.']
  engagement_mandate boolean [note: 'Indicates whether the policy mandates active engagement with portfolio companies on ESG issues.']
  esg_integration_level varchar [note: 'Degree to which ESG factors must be integrated into investment decision-making under this policy.']
  esg_policy_code varchar [note: 'Externally-known unique code for the policy (e.g., RIP-2024, EXCL-POL-01, PROXY-V3).']
  esg_policy_name varchar [note: 'Full official name of the responsible investment policy (e.g., Responsible Investment Policy, Climate Change Policy, Exclusion Policy).']
  esg_policy_status varchar [note: 'Current lifecycle status of the policy within the governance framework.']
  esg_policy_type varchar [note: 'Classification of the policy by its primary ESG (Environmental, Social, and Governance) focus area.']
  exclusion_criteria varchar [note: 'Detailed description of sectors, activities, or entities excluded from investment under this policy (e.g., tobacco, controversial weapons, thermal coal).']
  expiry_date date [note: 'Date on which the policy ceases to be in force; null for open-ended policies.']
  external_audit_required boolean [note: 'Indicates whether compliance with the policy requires external third-party audit or verification.']
  geographic_scope varchar [note: 'Geographic coverage of the policy (global, regional, or market-specific).']
  ghg_reduction_target_pct decimal(5,2) [note: 'Target percentage reduction in portfolio GHG emissions intensity or absolute emissions as defined by the policy.']
  is_active boolean [note: 'Indicates whether the policy is currently active and enforceable (true) or inactive (false).']
  language varchar [note: 'ISO 639-2 three-letter language code for the primary language of the policy document (e.g., ENG, FRA, DEU).']
  last_audit_date date [note: 'Date of the most recent external or internal audit of policy compliance.']
  last_modified_by varchar [note: 'User or system identifier of the individual who last modified the policy record.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent update to the policy record.']
  legal_jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary legal jurisdiction governing the policy (e.g., CAN, USA, GBR).']
  next_audit_date date [note: 'Scheduled date for the next audit of policy compliance.']
  next_review_date date [note: 'Scheduled date for the next mandatory review and update of the policy.']
  notes varchar [note: 'Free-text field for additional context, implementation guidance, or historical notes related to the policy.']
  owner varchar [note: 'Name or title of the individual or department responsible for maintaining and enforcing the policy (e.g., Chief Investment Officer, ESG Team).']
  proxy_voting_mandate boolean [note: 'Indicates whether the policy mandates proxy voting on ESG-related shareholder resolutions.']
  public_disclosure_required boolean [note: 'Indicates whether the policy or its compliance metrics must be publicly disclosed.']
  regulatory_alignment varchar [note: 'Comma-separated list of regulatory frameworks the policy aligns with (e.g., SFDR, TCFD, PRI).']
  related_policy_ids varchar [note: 'Comma-separated list of policy_id values for related or dependent policies (e.g., parent policy, superseded policy).']
  reporting_frequency varchar [note: 'Frequency at which compliance with the policy must be reported to stakeholders.']
  review_frequency_months varchar [note: 'Number of months between mandatory policy reviews (e.g., 12, 24, 36).']
  scope varchar [note: 'Asset class or investment domain to which the policy applies. [ENUM-REF-CANDIDATE: all_assets|public_equities|private_equity|real_estate|infrastructure|fixed_income|natural_resources — 7 candidates stripped; promote to reference product]']
  summary varchar [note: 'Executive summary or high-level description of the policys objectives and key provisions.']
  tags varchar [note: 'Comma-separated list of keywords or tags for categorization and search (e.g., climate, human_rights, diversity, fossil_fuels).']
  target_year varchar [note: 'Year by which the policy targets or commitments are to be achieved (e.g., 2030, 2050).']
  version_number varchar [note: 'Semantic version identifier for the policy document (e.g., 1.0, 2.1, 3.0.1).']
  created_by varchar [note: 'User or system identifier of the individual who created the policy record.']

  Note: 'Master record of the fund\'s responsible investment policies and ESG integration mandates—including the Responsible Investment Policy, Exclusion Policy, Proxy Voting Policy, and Engagement Policy.'
}

Table esg.exclusion_list {
  exclusion_list_id varchar [pk, note: 'Unique identifier for the exclusion list entry. Primary key.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Exclusion decisions require Investment Committee approval with documented accountability. Pension funds must demonstrate governance over exclusion decisions for beneficiary protection and']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Exclusion lists are mandated by responsible investment policies. The policy_reference STRING can be removed as the FK provides the authoritative link.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Exclusions may be driven by framework requirements (e.g., UNGC violations). Links exclusion criteria to governing frameworks.']
  approval_date date [note: 'Date on which the Investment Committee or Responsible Investment Committee formally approved this exclusion.']
  breach_resolution_date date [note: 'Date on which a detected compliance breach was resolved through divestment, override, or policy amendment.']
  compliance_breach_flag boolean [note: 'Boolean flag indicating whether a compliance breach has been detected (i.e., excluded security found in active portfolio holdings).']
  controversy_level varchar [note: 'Severity level of ESG controversies associated with the issuer: low, medium, high, or severe, as assessed by ESG data providers or internal due diligence.']
  created_timestamp timestamp [note: 'Timestamp when this exclusion list record was first created in the system.']
  data_source varchar [note: 'Source system or vendor providing the exclusion data or ESG rating that triggered the exclusion, such as MSCI ESG, Sustainalytics, or internal research.']
  divestment_deadline date [note: 'Target date by which existing holdings of the excluded security must be divested to achieve full compliance with the exclusion policy.']
  divestment_status varchar [note: 'Current status of divestment for legacy holdings: not applicable (no holdings), pending (divestment planned), in progress (actively divesting), completed (fully divested), or exempted (override granted).']
  effective_date date [note: 'Date from which this exclusion becomes active and enforceable across the investment portfolio.']
  engagement_status varchar [note: 'Status of active ownership engagement with the excluded issuer: no engagement, active engagement (ongoing dialogue), escalated (formal escalation), resolved (issue addressed), or discontinued (engagement ceased).']
  esg_rating varchar [note: 'ESG rating or score from external provider (e.g., MSCI ESG, Sustainalytics) that contributed to the exclusion decision.']
  exclusion_category varchar [note: 'Specific category or theme of the exclusion, such as controversial weapons, tobacco, thermal coal, oil sands, human rights violations, or labor rights violations.']
  exclusion_identifier varchar [note: 'Business-facing unique identifier or code for this exclusion entry, used for external reference and reporting.']
  exclusion_override_flag boolean [note: 'Boolean flag indicating whether an exception or override has been granted for this exclusion, allowing investment despite the exclusion criteria being met.']
  exclusion_reason varchar [note: 'Detailed narrative explanation of why this security, issuer, or sector is excluded from the investable universe, including policy references and rationale.']
  exclusion_scope varchar [note: 'Asset class or portfolio scope to which this exclusion applies: all portfolios, public equity only, private equity, fixed income, real estate, or infrastructure.']
  exclusion_status varchar [note: 'Current lifecycle status of the exclusion entry: active (enforced), suspended (temporarily inactive), expired (no longer valid), under review (being reassessed), pending approval (awaiting IC decision), or revoked (formally withdrawn).']
  exclusion_type varchar [note: 'Classification of the exclusion basis: norm-based (international norms violations), sector-based (industry exclusion), product-based (specific products), issuer-based (entity-level), geography-based (country/region), or conduct-based (corporate behavior).']
  expiry_date date [note: 'Date on which this exclusion expires or is scheduled for review. Null if the exclusion is indefinite.']
  ghg_emissions_intensity decimal(15,2) [note: 'GHG emissions intensity metric (e.g., tonnes CO2e per million USD revenue) for the issuer, used as a quantitative exclusion criterion for high-carbon emitters.']
  issuer_country varchar [note: 'Three-letter ISO country code representing the issuers country of domicile or primary listing.']
  issuer_lei varchar [note: '20-character Legal Entity Identifier for the issuer, providing globally unique entity identification.']
  issuer_name varchar [note: 'Legal name of the issuer, company, or entity subject to the exclusion.']
  last_holdings_check_date date [note: 'Date of the most recent portfolio holdings check to verify compliance with this exclusion across all portfolios and asset classes.']
  notes varchar [note: 'Free-text field for additional context, operational notes, or special instructions related to this exclusion entry.']
  override_reason varchar [note: 'Detailed explanation of why an exclusion override was granted, including Investment Committee rationale and compensating controls.']
  proxy_voting_restriction boolean [note: 'Boolean flag indicating whether proxy voting rights are restricted or prohibited for this excluded security, if still held in legacy positions.']
  revenue_threshold_pct decimal(5,2) [note: 'Revenue exposure threshold percentage that triggers exclusion. For example, companies deriving more than 5% of revenue from thermal coal may be excluded.']
  review_date date [note: 'Next scheduled date for periodic review of this exclusion to assess continued relevance and compliance with evolving ESG standards.']
  sector_classification varchar [note: 'Industry sector classification of the excluded entity or security, typically using GICS, ICB, or internal taxonomy.']
  security_identifier varchar [note: 'Primary security identifier for the excluded instrument. May be ISIN, CUSIP, SEDOL, or internal security ID depending on asset class and market.']
  security_identifier_type varchar [note: 'Type of security identifier used: ISIN (International Securities Identification Number), CUSIP, SEDOL, TICKER, or INTERNAL (proprietary identifier).']
  sfdr_classification varchar [note: 'SFDR article classification for the excluded security or issuer: Article 6 (no sustainability objective), Article 8 (promotes ESG), Article 9 (sustainable investment objective), or excluded (not eligible under SFDR).']
  tcfd_climate_risk_flag boolean [note: 'Boolean flag indicating whether the exclusion is driven by TCFD-identified climate-related financial risks, such as transition risk or physical risk exposure.']
  un_global_compact_violation boolean [note: 'Boolean flag indicating whether the issuer has been identified as violating UN Global Compact principles (human rights, labor, environment, anti-corruption).']
  updated_by varchar [note: 'User identifier or system account that last updated this exclusion list record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this exclusion list record.']
  created_by varchar [note: 'User identifier or system account that created this exclusion list record.']

  Note: 'Master record of securities, issuers, sectors, and geographies formally excluded from the investable universe under the fund\'s Exclusion Policy. Captures exclusion type (norm-based, sector-based, product-based), exclusion reason (controversial weapons'
}

Table esg.sfdr_classification {
  sfdr_classification_id varchar [pk, note: 'Unique identifier for the SFDR classification record.']
  composite_id varchar [note: 'Foreign key linking to performance.composite. Business justification: EU SFDR regulation requires pension funds to report Article 6/8/9 classification at composite level for investor disclosures.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: SFDR classifications are made under the SFDR regulatory framework. Links classification to the governing framework.']
  fund_id varchar [note: 'Reference to the fund vehicle or mandate to which this SFDR classification applies.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate if this classification applies to a separately managed account or mandate rather than a pooled fund.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: SFDR fund classifications (Article 6/8/9) directly determine regulatory disclosure requirements. Pension funds must file SFDR disclosures based on each fund\'s classification.']
  benchmark_index_name varchar [note: 'Name of the designated ESG or sustainability benchmark index used for performance comparison and alignment assessment, if applicable (e.g., MSCI World ESG Leaders, FTSE4Good).']
  benchmark_is_esg_aligned boolean [note: 'Indicates whether the designated benchmark is itself an ESG or Paris-aligned benchmark as defined under the EU Benchmark Regulation.']
  classification_approval_date date [note: 'The date on which this SFDR classification was formally approved by the Investment Committee or designated governance body.']
  classification_approved_by varchar [note: 'Name or identifier of the Investment Committee member or governance body that approved this SFDR classification.']
  classification_effective_date date [note: 'The date from which this SFDR classification becomes effective and must be disclosed to investors.']
  classification_end_date date [note: 'The date on which this SFDR classification ceases to be effective, typically due to reclassification or fund closure. Null for currently active classifications.']
  classification_rationale varchar [note: 'Detailed business and regulatory rationale explaining why this fund or mandate was assigned this specific SFDR article classification, including reference to investment objectives, ESG integration approach, and sustainability commitments.']
  classification_status varchar [note: 'Current lifecycle status of this SFDR classification record: active (in force), pending (approved but not yet effective), superseded (replaced by newer classification), or withdrawn (no longer applicable).']
  created_timestamp timestamp [note: 'The timestamp when this SFDR classification record was first created in the system.']
  data_coverage_percentage decimal(5,2) [note: 'Percentage of the funds portfolio (by market value or number of holdings) for which ESG data is available to support SFDR classification and PAI disclosures.']
  data_quality_score decimal(3,2) [note: 'Internal data quality score (0.00 to 1.00) reflecting the completeness, accuracy, and timeliness of the ESG data used to support this SFDR classification.']
  do_no_significant_harm_assessment varchar [note: 'Summary of the assessment process and conclusion regarding whether the funds sustainable investments do no significant harm to any environmental or social objective, as required under SFDR.']
  engagement_strategy_applied boolean [note: 'Indicates whether an active engagement strategy with investee companies on ESG matters is part of the responsible investment approach for this fund or mandate.']
  environmental_objective_alignment boolean [note: 'Indicates whether the fund or mandate promotes or has as its objective alignment with one or more environmental objectives as defined under the EU Taxonomy Regulation.']
  esg_methodology_version varchar [note: 'Version identifier of the ESG assessment methodology or framework applied to determine this SFDR classification and ongoing monitoring.']
  esg_rating_provider varchar [note: 'Name of the primary external ESG rating or data provider used to assess sustainability characteristics and PAI indicators for this fund or mandate (e.g., MSCI ESG, Sustainalytics, ISS ESG).']
  exclusion_policy_applied boolean [note: 'Indicates whether a formal exclusion policy (e.g., fossil fuels, controversial weapons, tobacco) is applied as part of the ESG integration strategy for this fund or mandate.']
  exclusion_policy_description varchar [note: 'Detailed description of the exclusion criteria and sectors or activities that are excluded from the investment universe for this fund or mandate.']
  good_governance_assessment varchar [note: 'Summary of the assessment process and conclusion regarding whether investee companies follow good governance practices, particularly with respect to sound management structures, employee relations, remuneration of staff, and tax compliance.']
  last_review_date date [note: 'The date on which this SFDR classification was last reviewed for continued accuracy and compliance with evolving regulatory guidance.']
  minimum_sustainable_investment_percentage decimal(5,2) [note: 'For Article 9 funds, the minimum proportion of the portfolio (as a percentage) that must be invested in sustainable investments as defined by SFDR. Null for Article 6 and Article 8 funds unless they commit to a minimum sustainable investment threshold.']
  next_review_date date [note: 'The scheduled date for the next periodic review of this SFDR classification to ensure ongoing compliance and accuracy.']
  notes varchar [note: 'Free-text field for additional notes, comments, or context regarding this SFDR classification, including any special considerations or pending regulatory clarifications.']
  pai_disclosure_required boolean [note: 'Indicates whether this fund or mandate is required to disclose Principal Adverse Impacts on sustainability factors under SFDR Article 4 or 7.']
  pai_indicators_considered varchar [note: 'Comma-separated list of PAI indicator codes or names that are considered and disclosed for this fund or mandate, drawn from the mandatory and optional PAI indicators defined in SFDR RTS.']
  periodic_disclosure_url varchar [note: 'URL or document reference to the periodic (annual) disclosure report that contains the SFDR-mandated sustainability performance and PAI disclosures for this fund or mandate.']
  pre_contractual_disclosure_url varchar [note: 'URL or document reference to the pre-contractual disclosure document (e.g., prospectus annex) that contains the SFDR-mandated sustainability disclosures for this fund or mandate.']
  proxy_voting_policy_applied boolean [note: 'Indicates whether a formal proxy voting policy aligned with ESG principles is applied to portfolio holdings in this fund or mandate.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier of the regulatory filing or submission to the competent authority (e.g., national regulator, ESMA) that includes this SFDR classification.']
  sfdr_article_classification varchar [note: 'The SFDR article classification: Article 6 (no sustainability objective), Article 8 (promotes environmental or social characteristics), or Article 9 (has sustainable investment as objective).']
  social_objective_alignment boolean [note: 'Indicates whether the fund or mandate promotes or has as its objective alignment with one or more social objectives as defined under SFDR and related frameworks.']
  taxonomy_alignment_percentage decimal(5,2) [note: 'The percentage of the funds investments that are aligned with the EU Taxonomy for sustainable activities. Required disclosure for Article 8 and Article 9 funds.']
  updated_by varchar [note: 'User identifier or system account that last modified this SFDR classification record.']
  updated_timestamp timestamp [note: 'The timestamp when this SFDR classification record was last modified.']
  website_disclosure_url varchar [note: 'URL to the dedicated website section where SFDR sustainability information for this fund or mandate is published and maintained.']
  created_by varchar [note: 'User identifier or system account that created this SFDR classification record.']

  Note: 'Master record of SFDR (Sustainable Finance Disclosure Regulation) product-level classifications for each fund vehicle and mandate managed or invested in. Stores Article classification (6, 8, or 9), classification rationale, which Principal Adverse Impact'
}

Table esg.tcfd_disclosure {
  tcfd_disclosure_id varchar [pk, note: 'Unique identifier for the TCFD disclosure submission record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: TCFD disclosures are regulatory filings requiring formal sign-off. Pension funds must document who approved climate risk disclosures for regulatory accountability and audit trails.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD disclosures reference climate scenarios for scenario analysis. The scenario_temperature_pathways is a summary field, the FK links to the detailed scenario.']
  net_zero_commitment_id varchar [note: 'Foreign key linking to esg.net_zero_commitment. Business justification: TCFD disclosures report on net zero commitment progress. The net_zero_commitment_flag and net_zero_target_year are disclosure-specific values, the FK links to the commitment record.']
  approval_date date [note: 'Date on which the TCFD disclosure was formally approved by the designated authority.']
  assurance_level varchar [note: 'Level of assurance provided by the external auditor, either limited or reasonable assurance.']
  assurance_provider varchar [note: 'Name of the external assurance provider or auditor who verified the TCFD disclosure and climate data.']
  baseline_year varchar [note: 'Reference year against which emissions reductions and progress toward targets are measured.']
  board_oversight_description varchar [note: 'Description of the board\'s oversight of climate-related risks and opportunities, including committee structure and frequency of review.']
  carbon_footprint_portfolio_tco2e_per_million decimal(18,4) [note: 'Portfolio-level carbon footprint metric representing financed emissions per million dollars invested, calculated according to PCAF methodology.']
  climate_opportunity_summary varchar [note: 'Summary of climate-related opportunities identified by the organization, including resource efficiency, energy sources, products and services, markets, and resilience.']
  climate_related_financial_impact_estimate varchar [note: 'Qualitative or quantitative estimate of the financial impact of climate-related risks and opportunities on the organization\'s financial position and performance.']
  climate_risk_integration_approach varchar [note: 'Description of how climate-related risks are integrated into the organization\'s overall risk management framework and investment decision-making processes.']
  climate_var_estimate decimal(18,2) [note: 'Estimated potential loss in portfolio value due to climate-related risks under specified scenarios, expressed in monetary terms.']
  climate_var_methodology varchar [note: 'Description of the methodology and assumptions used to calculate the climate VaR estimate.']
  created_timestamp timestamp [note: 'System timestamp recording when this TCFD disclosure record was first created in the system.']
  disclosure_status varchar [note: 'Current lifecycle status of the TCFD disclosure submission.']
  disclosure_version varchar [note: 'Version identifier for the disclosure document, used to track revisions and amendments.']
  disclosure_year varchar [note: 'Calendar year in which the TCFD disclosure was published or submitted.']
  emissions_intensity_metric varchar [note: 'Description of the emissions intensity metric used, such as tCO2e per million dollars of Assets Under Management (AUM) or tCO2e per million dollars of revenue.']
  emissions_intensity_value decimal(18,4) [note: 'Calculated emissions intensity value based on the specified metric, enabling comparison across periods and peers.']
  external_assurance_obtained boolean [note: 'Indicates whether the TCFD disclosure and underlying climate data have been subject to external third-party assurance or verification.']
  fossil_fuel_exposure_pct decimal(5,2) [note: 'Percentage of portfolio value exposed to fossil fuel-related assets, used to assess transition risk exposure.']
  governance_narrative varchar [note: 'Textual description of the organization\'s governance around climate-related risks and opportunities, including board oversight and management\'s role.']
  green_revenue_alignment_pct decimal(5,2) [note: 'Percentage of portfolio companies\' revenues aligned with green or low-carbon activities, as defined by relevant taxonomies such as EU Taxonomy.']
  interim_emissions_reduction_target_pct decimal(5,2) [note: 'Interim percentage reduction target for GHG emissions relative to a baseline year, used to track progress toward long-term net-zero goals.']
  interim_target_year varchar [note: 'Year by which the interim emissions reduction target is to be achieved.']
  last_modified_by varchar [note: 'User identifier of the individual who last modified this TCFD disclosure record.']
  last_modified_timestamp timestamp [note: 'System timestamp recording when this TCFD disclosure record was last updated.']
  management_role_description varchar [note: 'Description of management\'s role in assessing and managing climate-related risks and opportunities, including specific roles and responsibilities.']
  metrics_targets_narrative varchar [note: 'Textual description of the metrics and targets used to assess and manage relevant climate-related risks and opportunities.']
  net_zero_commitment_flag boolean [note: 'Indicates whether the organization has made a formal commitment to achieve net-zero emissions by a specified target year.']
  net_zero_target_year varchar [note: 'Target year by which the organization aims to achieve net-zero greenhouse gas emissions.']
  physical_risk_exposure_summary varchar [note: 'Summary of the organization\'s exposure to physical climate risks such as extreme weather events, sea-level rise, and temperature changes.']
  prepared_by varchar [note: 'Name or identifier of the individual or team responsible for preparing the TCFD disclosure.']
  publication_url varchar [note: 'Web address where the published TCFD disclosure document can be accessed by stakeholders.']
  reporting_period_end_date date [note: 'End date of the fiscal or calendar period covered by this TCFD disclosure.']
  reporting_period_start_date date [note: 'Start date of the fiscal or calendar period covered by this TCFD disclosure.']
  risk_management_narrative varchar [note: 'Textual description of the processes used by the organization to identify, assess, and manage climate-related risks.']
  scenario_analysis_approach varchar [note: 'Description of the scenario analysis methodology used to assess the resilience of the organization\'s strategy under different climate-related scenarios.']
  scenario_temperature_pathways varchar [note: 'Temperature pathways or scenarios analyzed, such as 1.5C, 2C, or higher warming scenarios, used in the scenario analysis.']
  scope_1_emissions_tco2e decimal(18,2) [note: 'Total direct GHG emissions from sources owned or controlled by the organization, measured in metric tons of carbon dioxide equivalent.']
  scope_2_emissions_tco2e decimal(18,2) [note: 'Total indirect GHG emissions from the generation of purchased electricity, steam, heating, and cooling consumed by the organization, measured in metric tons of carbon dioxide equivalent.']
  scope_3_emissions_tco2e decimal(18,2) [note: 'Total indirect GHG emissions from the organization\'s value chain, including financed emissions from investment portfolio, measured in metric tons of carbon dioxide equivalent.']
  stranded_asset_risk_assessment varchar [note: 'Qualitative assessment of the risk that portfolio assets may become stranded due to climate policy, technology shifts, or market changes.']
  strategy_narrative varchar [note: 'Textual description of the actual and potential impacts of climate-related risks and opportunities on the organization\'s businesses, strategy, and financial planning.']
  submission_date date [note: 'Date on which the TCFD disclosure was formally submitted or published.']
  time_horizons_assessed varchar [note: 'Time horizons considered in the climate risk assessment, such as short-term (0-5 years), medium-term (5-15 years), and long-term (15+ years).']
  total_emissions_tco2e decimal(18,2) [note: 'Sum of Scope 1, Scope 2, and Scope 3 emissions, representing the organization\'s total carbon footprint in metric tons of carbon dioxide equivalent.']
  transition_risk_exposure_summary varchar [note: 'Summary of the organization\'s exposure to transition risks arising from policy, legal, technology, and market changes as the economy shifts toward a lower-carbon future.']
  weighted_average_carbon_intensity_waci decimal(18,4) [note: 'Portfolio-weighted average of investee companies\' carbon intensities, measured in tCO2e per million dollars of revenue, used to assess portfolio climate risk.']
  created_by varchar [note: 'User identifier of the individual who created this TCFD disclosure record in the system.']

  Note: 'Transactional record of annual TCFD (Task Force on Climate-related Financial Disclosures) climate risk disclosure submissions. Captures reporting period, governance narrative, strategy narrative, risk management narrative, physical risk exposure summary'
}

Table esg.ghg_emission_record {
  ghg_emission_record_id varchar [pk, note: 'Unique identifier for the greenhouse gas emission record.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: GHG emissions are tracked against climate scenario pathways for alignment assessment.']
  data_provider_id varchar [note: 'Foreign key linking to esg.data_provider. Business justification: GHG emissions data is sourced from external data providers. The data_provider STRING can be removed as the FK provides the authoritative link.']
  infra_asset_id varchar [note: 'Reference to the underlying asset (direct investment, real estate property, infrastructure asset) for which emissions are measured.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Linking ghg_emission_record to issuer_esg_rating associates emissions data with the issuer’s ESG profile, enabling integrated reporting.']
  portfolio_holding_id varchar [note: 'Reference to the specific portfolio holding or investment position to which this emission data applies.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Each GHG emission record must be tied to a specific natural resource asset for compliance and reporting.']
  asset_class varchar [note: 'Investment asset class to which this emission record applies. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|other — 7 candidates stripped; promote to reference product]']
  attributed_emissions_tco2e decimal(18,4) [note: 'Emissions attributed to the funds investment based on ownership percentage or other allocation method, measured in tCO2e.']
  baseline_year varchar [note: 'Reference year used as the baseline for measuring emissions reduction progress.']
  carbon_footprint_per_million_invested decimal(18,4) [note: 'Carbon footprint metric expressed as tCO2e per million dollars invested, used for portfolio-level aggregation.']
  created_timestamp timestamp [note: 'Timestamp when this emission record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for any monetary values used in intensity calculations.']
  data_collection_method varchar [note: 'Description of the method used to collect or obtain the emissions data (e.g., direct reporting, survey, estimation model, third-party data feed).']
  data_quality_flag boolean [note: 'Categorical flag indicating the quality level of the emissions data.']
  data_quality_score decimal(5,2) [note: 'Numerical score representing the quality, completeness, and reliability of the emissions data (scale 0-100).']
  data_source_type varchar [note: 'Classification of the data source used to obtain emissions data (reported by company, estimated, modeled, third-party provider, proxy).']
  emission_factor_source varchar [note: 'Source of the emission factors used in calculations (e.g., IPCC, EPA, DEFRA, IEA).']
  emissions_intensity_metric varchar [note: 'Denominator used to calculate emissions intensity (e.g., revenue, AUM, employees, production unit, square meter).']
  emissions_intensity_value decimal(18,6) [note: 'Calculated emissions intensity ratio (tCO2e per unit of the chosen metric).']
  geographic_scope varchar [note: 'Three-letter ISO country code representing the primary geographic location of the emissions source.']
  is_active boolean [note: 'Indicates whether this emission record is currently active and should be used in reporting and analytics.']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer or operating company responsible for the emissions.']
  issuer_name varchar [note: 'Legal name of the issuer or operating company responsible for the emissions.']
  last_modified_by varchar [note: 'User or system identifier that last modified this emission record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this emission record was last updated.']
  measurement_date date [note: 'Date on which the emission measurement or calculation was performed.']
  methodology varchar [note: 'Description of the calculation methodology or standard used to measure emissions (e.g., GHG Protocol, ISO 14064, PCAF).']
  notes varchar [note: 'Additional notes, comments, or context regarding the emissions data, methodology, or data quality.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership or attribution used to calculate the funds proportional share of emissions.']
  paris_alignment_flag boolean [note: 'Indicates whether the emissions trajectory is aligned with Paris Agreement climate goals (1.5 or 2 degree scenarios).']
  reduction_target_pct decimal(5,2) [note: 'Target percentage reduction in emissions relative to the baseline year.']
  reporting_period_end_date date [note: 'End date of the reporting period for which emissions are measured.']
  reporting_period_start_date date [note: 'Start date of the reporting period for which emissions are measured.']
  scope_1_emissions_tco2e decimal(18,4) [note: 'Direct greenhouse gas emissions from sources owned or controlled by the company, measured in tonnes of carbon dioxide equivalent.']
  scope_2_location_based_emissions_tco2e decimal(18,4) [note: 'Indirect emissions from purchased electricity, steam, heating, and cooling using average emission factors for the grid, measured in tCO2e.']
  scope_2_market_based_emissions_tco2e decimal(18,4) [note: 'Indirect emissions from purchased energy using contractual instruments and supplier-specific emission factors, measured in tCO2e.']
  scope_3_category varchar [note: 'Specific Scope 3 category classification per GHG Protocol (e.g., Category 1 Purchased Goods, Category 11 Use of Sold Products). [ENUM-REF-CANDIDATE']
  scope_3_emissions_tco2e decimal(18,4) [note: 'All other indirect emissions occurring in the value chain (upstream and downstream), measured in tonnes of carbon dioxide equivalent.']
  sector_classification varchar [note: 'Industry sector classification of the emitting entity (e.g., GICS, NAICS, NACE).']
  sfdr_classification varchar [note: 'SFDR article classification of the investment product to which this emission data applies.']
  target_year varchar [note: 'Year by which the emissions reduction target is to be achieved.']
  tcfd_alignment_flag boolean [note: 'Indicates whether the emissions data meets TCFD disclosure requirements.']
  total_emissions_tco2e decimal(18,4) [note: 'Sum of Scope 1, Scope 2 (location-based or market-based), and Scope 3 emissions, measured in tCO2e.']
  verification_body varchar [note: 'Name of the independent third-party organization that verified the emissions data.']
  verification_date date [note: 'Date on which the emissions data verification was completed.']
  verification_status varchar [note: 'Indicates whether the emissions data has been independently verified and the level of assurance obtained.']
  created_by varchar [note: 'User or system identifier that created this emission record.']

  Note: 'Transactional record of greenhouse gas (GHG) emissions data collected at the portfolio holding or asset level. Captures Scope 1, Scope 2 (location-based and market-based), and Scope 3 emissions in tCO2e, data source (reported vs.'
}

Table esg.climate_scenario {
  climate_scenario_id varchar [pk, note: 'Unique identifier for the climate scenario record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Climate scenarios used for stress testing require formal approval before use in portfolio analysis. Documents who authorized each scenario for risk management governance.']
  approval_date date [note: 'Date when the scenario was formally approved for use by the Investment Committee or Risk Committee.']
  approved_for_use_flag boolean [note: 'Indicates whether the scenario has been formally approved by the Investment Committee or Risk Committee for use in investment decision-making and risk management.']
  asset_class_applicability varchar [note: 'Investment asset classes for which this scenario is relevant and applicable (e.g., public equities, private equity, real estate, infrastructure, credit).']
  base_year varchar [note: 'Starting year for the climate scenario projections and baseline measurements.']
  carbon_budget_gt decimal(12,2) [note: 'Total cumulative carbon dioxide emissions budget in gigatonnes allowed under this scenario pathway from base year to target year.']
  carbon_price_trajectory varchar [note: 'Qualitative classification of the carbon pricing pathway assumed in the scenario (low, medium, high, very high).']
  climate_scenario_status varchar [note: 'Current lifecycle status of the climate scenario within the organization\'s stress testing framework.']
  created_timestamp timestamp [note: 'Date and time when the climate scenario record was first created in the system.']
  data_source_url varchar [note: 'Web address or repository location where the full scenario data, documentation, and methodology can be accessed.']
  geographic_scope varchar [note: 'Spatial coverage of the climate scenario (global, regional, or national level projections).']
  key_assumptions varchar [note: 'Critical assumptions underlying the scenario regarding policy action, technology deployment, economic growth, population dynamics, and behavioral change.']
  last_modified_by varchar [note: 'User identifier or system account that last modified the climate scenario record.']
  last_modified_timestamp timestamp [note: 'Date and time when the climate scenario record was most recently updated or modified.']
  limitations varchar [note: 'Known limitations, uncertainties, and caveats associated with the scenario\'s projections and applicability to investment decision-making.']
  methodology_summary varchar [note: 'Brief summary of the modeling approach, assumptions, and methodologies used to construct the climate scenario (maximum 500 characters).']
  net_zero_year varchar [note: 'Year in which net greenhouse gas emissions reach zero under this scenario pathway (null if net zero is not achieved).']
  next_review_date date [note: 'Scheduled date for the next periodic review and validation of the scenario\'s continued relevance and accuracy.']
  owner varchar [note: 'Name or identifier of the internal team or individual responsible for maintaining and updating the scenario (e.g., Climate Risk Team, ESG Research).']
  peak_emissions_year varchar [note: 'Year in which global greenhouse gas emissions reach their maximum level before declining under this scenario.']
  physical_risk_severity varchar [note: 'Overall severity level of physical climate risks (acute and chronic) under this scenario.']
  policy_stringency varchar [note: 'Assessment of the strength and comprehensiveness of climate policy measures assumed in the scenario.']
  publication_date date [note: 'Date when the climate scenario was officially published or released by the source organization.']
  rcp_classification varchar [note: 'IPCC Representative Concentration Pathway classification indicating radiative forcing level (W/m2) by 2100.']
  regulatory_alignment varchar [note: 'Comma-separated list of regulatory frameworks and stress testing requirements this scenario satisfies (e.g., a prudential climate risk guideline, ECB Climate Stress Test, PRA Climate Biennial Exploratory Scenario).']
  review_frequency_months varchar [note: 'Number of months between scheduled reviews of the scenario (e.g., 12 for annual review, 24 for biennial review).']
  scenario_category varchar [note: 'High-level categorization of the climate scenario pathway (orderly transition, disorderly transition, hot house world, too little too late).']
  scenario_code varchar [note: 'Unique business identifier code for the climate scenario (e.g., NGFS_NZ2050, IEA_SDS, RCP26).']
  scenario_name varchar [note: 'Full descriptive name of the climate scenario (e.g., Network for Greening the Financial System Net Zero 2050, International Energy Agency Sustainable Development Scenario).']
  scenario_type varchar [note: 'Classification of the climate scenario as transition risk, physical risk, or combined risk scenario.']
  sector_coverage varchar [note: 'Economic sectors and industries covered by the scenario\'s projections and impact assessments (e.g., energy, transport, agriculture, buildings, industry).']
  sfdr_disclosure_flag boolean [note: 'Indicates whether the scenario is used for SFDR principal adverse impact and sustainability risk disclosures.']
  source_organization varchar [note: 'Name of the organization or consortium that published the climate scenario (e.g., NGFS, IEA, IPCC, UNEP).']
  ssp_classification varchar [note: 'IPCC Shared Socioeconomic Pathway classification describing socioeconomic development trajectory (e.g., SSP1, SSP2, SSP3, SSP4, SSP5).']
  stress_test_usage_flag boolean [note: 'Indicates whether this scenario is actively used in the organization\'s climate risk stress testing and scenario analysis exercises.']
  target_year varchar [note: 'End year for the climate scenario projections and impact assessments.']
  tcfd_alignment_flag boolean [note: 'Indicates whether the scenario is aligned with TCFD recommended climate scenario analysis frameworks.']
  technology_change_assumption varchar [note: 'Assumed pace of technological innovation and deployment for decarbonization and adaptation technologies.']
  temperature_pathway varchar [note: 'Global mean temperature increase pathway associated with the scenario (e.g., 1.5C, 2C, 3C, 4C+) by end of century relative to pre-industrial levels.']
  time_horizon varchar [note: 'Number of years from base year to the scenario\'s target projection year (e.g., 30 for 2050 target from 2020 base).']
  transition_risk_severity varchar [note: 'Overall severity level of transition risks (policy, technology, market, reputation) under this scenario.']
  usage_guidance varchar [note: 'Internal guidance on appropriate use cases, interpretation, and integration of the scenario into investment analysis and risk management processes.']
  version varchar [note: 'Version number of the climate scenario release (e.g., 1.0, 2.1, 3.0).']
  created_by varchar [note: 'User identifier or system account that created the climate scenario record.']

  Note: 'Reference catalogue of climate transition and physical risk scenarios used in stress testing and TCFD disclosures. Stores scenario name (e.g., NGFS Net Zero 2050, IEA SDS, RCP 2.6/4.5/8.5), scenario type (transition vs.'
}

Table esg.engagement_activity {
  engagement_activity_id varchar [pk, note: 'Unique identifier for the stewardship engagement activity record.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Engagement activities are conducted under specific responsible investment policies. The policy_reference STRING can be removed as the FK provides the authoritative link.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Engagement activities target investee companies that have ESG ratings. The investee_lei and investee_name are operational identifiers needed for matching, not redundant with the rating']
  asset_class varchar [note: 'Investment asset class category of the holding that is the subject of the engagement, aligning with the funds strategic asset allocation framework. [ENUM-REF-CANDIDATE']
  collaborative_initiative_name varchar [note: 'Name of the formal collaborative engagement initiative or investor coalition through which the engagement was conducted, if applicable.']
  controversy_level varchar [note: 'Severity classification of any ESG-related controversy or incident associated with the investee entity that triggered or informed the engagement.']
  created_timestamp timestamp [note: 'System timestamp when this engagement activity record was first created in the data platform, supporting audit trail and data lineage.']
  data_source varchar [note: 'System or platform from which the engagement activity record was captured or logged, supporting data lineage and audit requirements.']
  document_reference_url varchar [note: 'URL or file path to supporting documentation for the engagement activity, such as meeting notes, correspondence, or presentation materials.']
  engagement_channel varchar [note: 'Communication medium or forum through which the engagement activity was conducted, distinct from engagement type which describes the approach. [ENUM-REF-CANDIDATE']
  engagement_date date [note: 'The date when the engagement activity occurred or was initiated, representing the primary business event timestamp for this interaction.']
  engagement_identifier varchar [note: 'Human-readable unique business identifier for the engagement activity, used for external reference and reporting.']
  engagement_milestone varchar [note: 'Key progress indicator or achievement reached during the engagement, used to track effectiveness and outcomes over time.']
  engagement_objective varchar [note: 'Specific goal or desired outcome that the fund seeks to achieve through this engagement activity, articulating the stewardship intent.']
  engagement_outcome varchar [note: 'Assessment of the result or impact achieved from the engagement activity, measuring the effectiveness of stewardship efforts. [ENUM-REF-CANDIDATE']
  engagement_participants_external varchar [note: 'Names or roles of external stakeholders from the investee entity or collaborative partners who participated in the engagement.']
  engagement_participants_internal varchar [note: 'Names or roles of internal fund personnel who participated in the engagement activity, supporting accountability and knowledge management.']
  engagement_priority varchar [note: 'Priority classification assigned to the engagement activity based on materiality, risk, and strategic importance to the funds stewardship objectives.']
  engagement_status varchar [note: 'Current lifecycle status of the engagement activity indicating its progression through the stewardship workflow.']
  engagement_sub_topic varchar [note: 'Detailed sub-category or specific aspect within the primary engagement topic, providing granular classification of the engagement focus area.']
  engagement_summary varchar [note: 'Narrative summary of the engagement discussion, key points raised, investee responses, and any commitments or action items agreed upon.']
  engagement_topic varchar [note: 'Primary Environmental, Social, and Governance (ESG) theme or issue that is the focus of the engagement activity. [ENUM-REF-CANDIDATE']
  engagement_type varchar [note: 'Classification of the engagement approach used: direct dialogue, collaborative initiative, escalation action, proxy voting, shareholder resolution filing, or public statement.']
  escalation_level varchar [note: 'Degree of escalation applied in the engagement, ranging from standard dialogue to formal actions such as voting against management or divestment consideration.']
  esg_rating_at_engagement varchar [note: 'MSCI ESG rating or equivalent third-party ESG assessment of the investee entity at the time of engagement, providing risk context.']
  holding_value_at_engagement decimal(18,2) [note: 'Market value of the funds holding in the investee entity at the time of engagement, providing materiality context for stewardship prioritization.']
  holding_value_currency varchar [note: 'ISO 4217 three-letter currency code for the holding value amount, supporting multi-currency portfolio reporting.']
  investee_country varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary jurisdiction or headquarters location of the investee entity.']
  investee_entity_name varchar [note: 'Legal name of the portfolio company, external manager, or other investee entity that is the subject of the engagement activity.']
  investee_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the investee entity, providing globally unique identification for regulatory and reporting purposes.']
  investee_sector varchar [note: 'Industry sector classification of the investee entity using Global Industry Classification Standard (GICS) or equivalent taxonomy.']
  is_active boolean [note: 'Indicates whether this engagement activity record is currently active and valid, supporting logical deletion and historical record management.']
  last_modified_by varchar [note: 'User identifier or name of the individual who most recently modified this engagement activity record, supporting audit and accountability.']
  last_modified_timestamp timestamp [note: 'System timestamp when this engagement activity record was most recently updated, enabling change tracking and version control.']
  next_action varchar [note: 'Planned follow-up activity or next step in the engagement process, supporting continuity and accountability in stewardship efforts.']
  next_action_due_date date [note: 'Target date by which the next engagement action or follow-up is scheduled to occur, enabling tracking of engagement cadence.']
  ownership_percentage decimal(5,2) [note: 'Percentage of the investee entitys equity or voting rights held by the fund at the time of engagement, indicating influence capacity.']
  public_disclosure_flag boolean [note: 'Indicates whether details of this engagement activity are subject to public disclosure under PRI reporting or other transparency commitments.']
  sfdr_classification varchar [note: 'EU SFDR article classification of the investment strategy or fund under which this engagement is conducted, supporting regulatory disclosure.']
  tcfd_alignment_flag boolean [note: 'Indicates whether the engagement topic relates to TCFD climate risk disclosure or climate transition planning.']
  un_global_compact_violation_flag boolean [note: 'Indicates whether the engagement was triggered by or relates to a potential violation of UN Global Compact principles by the investee entity.']
  voting_action_taken boolean [note: 'Indicates whether proxy voting action was taken as part of or in connection with this engagement activity.']
  voting_decision varchar [note: 'The funds voting decision on the resolution associated with this engagement activity.']
  voting_meeting_date date [note: 'Date of the Annual General Meeting (AGM) or Extraordinary General Meeting (EGM) where voting action related to this engagement occurred.']
  voting_resolution_description varchar [note: 'Description of the shareholder resolution or management proposal that was the subject of voting action related to this engagement.']
  created_by varchar [note: 'User identifier or name of the individual who created this engagement activity record, supporting accountability and audit requirements.']

  Note: 'Transactional record of stewardship engagement interactions between the fund and investee companies or external managers. Captures engagement type (direct, collaborative, escalation), engagement topic (climate, board diversity, executive pay, supply'
}

Table esg.engagement_objective {
  engagement_objective_id varchar [pk, note: 'Unique identifier for the engagement objective record.']
  engagement_activity_id varchar [note: 'Reference to the parent engagement program or activity under which this objective is defined.']
  engagement_engagement_activity_id varchar [note: 'Reference to the parent engagement program or activity under which this objective is defined.']
  engagement_esg_policy_id varchar [note: 'Reference to the ESG policy or responsible investment policy that mandates or guides this engagement objective.']
  engagement_related_policy_esg_policy_id varchar [note: 'Reference to the ESG policy or responsible investment policy that mandates or guides this engagement objective.']
  owner_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Engagement objectives require accountable owners to drive progress. PRI reporting requires tracking who owns each engagement objective for stewardship accountability.']
  achievement_date date [note: 'Actual date on which the objective was achieved, if applicable.']
  approval_date date [note: 'Date on which the engagement objective was formally approved for execution.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the engagement objective.']
  baseline_date date [note: 'Date on which the baseline value was measured or established.']
  baseline_value decimal(18,2) [note: 'Baseline or starting value of the target metric at the time the objective was established.']
  closure_date date [note: 'Date on which the objective was formally closed, whether achieved, not achieved, or cancelled.']
  closure_reason varchar [note: 'Explanation for why the objective was closed, including achievement rationale or reasons for non-achievement or cancellation.']
  collaboration_initiative_name varchar [note: 'Name of the external collaborative engagement initiative or coalition, if applicable, such as Climate Action 100+ or Investor Alliance for Human Rights.']
  created_timestamp timestamp [note: 'Timestamp when the engagement objective record was first created in the system.']
  data_source varchar [note: 'Source system or provider from which objective data and progress metrics are obtained, such as MSCI ESG, Bloomberg, or internal stewardship platform.']
  engagement_approach varchar [note: 'Method or strategy employed to achieve the objective, such as direct dialogue, collaborative engagement, proxy voting, or public advocacy.']
  engagement_objective_status varchar [note: 'Current lifecycle status of the engagement objective, tracking progress from definition through completion. [ENUM-REF-CANDIDATE: draft|active|on_track|at_risk|achieved|not_achieved|deferred|cancelled — 8 candidates stripped; promote to reference product]']
  escalation_level varchar [note: 'Current escalation level of the engagement, indicating intensity of stewardship actions taken.']
  esg_issue varchar [note: 'Specific ESG issue or topic that the objective targets, such as climate risk, board diversity, labor practices, or supply chain transparency.']
  esg_pillar varchar [note: 'Primary ESG pillar that this objective addresses: environmental, social, governance, or integrated across multiple pillars.']
  external_collaboration_flag boolean [note: 'Indicates whether this objective is pursued in collaboration with other institutional investors or engagement coalitions.']
  investee_country varchar [note: 'Primary country of domicile or operations for the investee entity, using ISO 3166-1 alpha-3 country codes.']
  investee_entity_name varchar [note: 'Name of the investee company, fund manager, or counterparty that is the subject of this engagement objective.']
  investee_lei varchar [note: 'Legal Entity Identifier of the investee entity subject to this engagement objective.']
  investee_sector varchar [note: 'Industry sector classification of the investee entity, using standard classification systems such as GICS or NAICS.']
  last_modified_by varchar [note: 'Identifier of the user or system that last modified the engagement objective record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the engagement objective record was last updated.']
  last_review_date date [note: 'Date of the most recent formal review of progress toward the objective.']
  milestone_description varchar [note: 'Specific, measurable, achievable, relevant, and time-bound (SMART) milestone definition for tracking progress toward the objective.']
  next_review_date date [note: 'Scheduled date for the next formal review of progress toward the objective.']
  notes varchar [note: 'Additional free-text notes, observations, or context regarding the engagement objective and its execution.']
  objective_code varchar [note: 'Business-assigned unique code or identifier for the engagement objective.']
  objective_description varchar [note: 'Detailed description of the engagement objective, including the desired outcome and rationale.']
  objective_name varchar [note: 'Short descriptive name or title of the engagement objective.']
  objective_type varchar [note: 'Classification of the engagement objective by its strategic or operational nature.']
  owner_department varchar [note: 'Department or business unit to which the objective owner belongs, such as ESG team, investment team, or stewardship team.']
  priority_level varchar [note: 'Priority classification of the objective within the engagement program, indicating urgency and resource allocation.']
  progress_percentage decimal(5,2) [note: 'Estimated percentage completion of the objective, ranging from 0.00 to 100.00 percent.']
  public_disclosure_flag boolean [note: 'Indicates whether the objective and its progress are disclosed publicly in stewardship reports or PRI reporting.']
  review_frequency_months varchar [note: 'Frequency in months at which progress toward the objective is formally reviewed and reported.']
  sfdr_principal_adverse_impact varchar [note: 'SFDR Principal Adverse Impact indicator that this objective addresses, if applicable.']
  target_completion_date date [note: 'Target date by which the engagement objective is expected to be achieved.']
  target_metric varchar [note: 'Quantitative or qualitative metric used to measure achievement of the objective, such as GHG emissions reduction percentage, board independence ratio, or policy adoption.']
  target_value decimal(18,2) [note: 'Specific target value or threshold for the metric that defines successful achievement of the objective.']
  tcfd_alignment varchar [note: 'Alignment of the objective with TCFD disclosure pillars: governance, strategy, risk management, or metrics and targets.']
  un_sdg_alignment varchar [note: 'UN Sustainable Development Goals that this objective supports, specified as goal numbers or names.']
  created_by varchar [note: 'Identifier of the user or system that created the engagement objective record.']

  Note: 'Master record of structured engagement objectives and milestones set for each investee company or manager engagement program. Captures objective description, target ESG issue (E/S/G pillar), SMART milestone definition, target completion date, priority'
}

Table esg.proxy_vote_record {
  proxy_vote_record_id varchar [pk, note: 'Unique identifier for the proxy vote record. Primary key for this transactional voting record.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Proxy votes are cast according to voting policies. The policy_reference STRING can be removed as the FK provides the authoritative link to the policy.']
  holding_id varchar [note: 'Reference to the investment holding position for which this proxy vote was cast.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Proxy votes are cast on specific securities. Linking to instrument master enables corporate governance analysis, voting pattern reporting by security type, and integration with trading data']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Proxy votes are cast at companies with ESG ratings. The issuer_name and issuer_lei are operational identifiers for matching, not redundant.']
  approval_date date [note: 'Date on which the vote decision was formally approved.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the vote decision.']
  ballot_reference varchar [note: 'Unique identifier for the ballot or voting card submitted for this meeting.']
  climate_alignment_flag boolean [note: 'Indicates whether the resolution relates to climate change alignment and net-zero transition goals (True) or not (False).']
  created_timestamp timestamp [note: 'Timestamp when this proxy vote record was first created in the system.']
  custodian_name varchar [note: 'Name of the custodian bank or institution holding the shares and facilitating the proxy vote.']
  disclosure_date date [note: 'Date on which the proxy vote record was publicly disclosed or reported.']
  engagement_activity_flag boolean [note: 'Indicates whether this vote was preceded by direct engagement with the investee company (True) or not (False).']
  esg_relevance_flag boolean [note: 'Indicates whether this resolution had material ESG implications (True) or not (False).']
  esg_theme varchar [note: 'Primary ESG theme associated with the resolution: Climate Change, Board Diversity, Executive Pay, Human Rights, Labor Standards, or Anti-Corruption.']
  glass_lewis_recommendation varchar [note: 'Voting recommendation provided by Glass Lewis proxy advisory service.']
  iss_recommendation varchar [note: 'Voting recommendation provided by ISS proxy advisory service.']
  issuer_lei varchar [note: '20-character Legal Entity Identifier for the investee company issuer.']
  issuer_name varchar [note: 'Legal name of the investee company holding the shareholder meeting.']
  last_modified_by varchar [note: 'User or system identifier that last modified this proxy vote record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this proxy vote record was last updated.']
  management_recommendation varchar [note: 'Voting recommendation provided by the investee company management.']
  meeting_date date [note: 'Date on which the shareholder meeting took place.']
  meeting_location varchar [note: 'Physical or virtual location where the shareholder meeting was held.']
  meeting_outcome varchar [note: 'Final outcome of the resolution at the shareholder meeting: Passed, Failed, or Withdrawn.']
  meeting_type varchar [note: 'Type of shareholder meeting: Annual General Meeting (AGM), Extraordinary General Meeting (EGM), Special, or Class meeting.']
  notes varchar [note: 'Additional free-text notes or comments related to the proxy vote decision or execution.']
  proxy_agent_name varchar [note: 'Name of the third-party proxy voting service or agent used to execute the vote (e.g., Broadridge, ISS ProxyExchange).']
  public_disclosure_required boolean [note: 'Indicates whether this proxy vote must be publicly disclosed per regulatory or policy requirements (True) or not (False).']
  record_date date [note: 'Date on which shareholders of record were eligible to vote at the meeting.']
  regulatory_filing_reference varchar [note: 'Reference number or identifier for any regulatory filing associated with this proxy vote disclosure.']
  resolution_category varchar [note: 'High-level category of the resolution: Board Election, Executive Compensation, Audit, Capital Structure, Mergers and Acquisitions (M&A), Environmental Social and Governance (ESG), or Shareholder Proposal.']
  resolution_description varchar [note: 'Full text or summary description of the resolution being voted on.']
  resolution_number varchar [note: 'Sequential number or identifier of the resolution item on the meeting agenda.']
  resolution_type varchar [note: 'Indicates whether the resolution was proposed by Management or by a Shareholder.']
  security_identifier varchar [note: 'Unique identifier for the security (ISIN, CUSIP, SEDOL) of the investee company whose meeting is being voted on.']
  security_identifier_type varchar [note: 'Type of security identifier used (ISIN, CUSIP, SEDOL, TICKER, LEI).']
  shares_voted decimal(18,4) [note: 'Number of shares voted on this resolution by the fund.']
  vote_alignment_with_iss boolean [note: 'Indicates whether the vote cast was aligned with ISS recommendation (True) or not (False).']
  vote_alignment_with_management boolean [note: 'Indicates whether the vote cast was aligned with management recommendation (True) or not (False).']
  vote_confirmation_number varchar [note: 'Confirmation or reference number received upon successful vote submission.']
  vote_direction varchar [note: 'Direction of the vote cast: For, Against, Abstain, Withhold, or Do Not Vote.']
  vote_execution_method varchar [note: 'Method by which the vote was submitted: Electronic platform, Paper ballot, Proxy Agent, or Direct submission.']
  vote_rationale varchar [note: 'Detailed explanation and justification for the vote direction taken, aligned with proxy voting policy and ESG considerations.']
  vote_recommendation_source varchar [note: 'Source of the voting recommendation consulted: Institutional Shareholder Services (ISS), Glass Lewis, Internal research, Management recommendation, or Other.']
  vote_rejection_reason varchar [note: 'Reason provided if the vote was rejected by the custodian or proxy agent (e.g., late submission, insufficient shares).']
  vote_status varchar [note: 'Current status of the proxy vote: Submitted, Confirmed, Rejected, Pending, or Cancelled.']
  vote_submission_date date [note: 'Date on which the proxy vote was submitted to the custodian or proxy agent.']
  votes_against_percentage decimal(5,2) [note: 'Percentage of total votes cast against the resolution at the meeting.']
  votes_for_percentage decimal(5,2) [note: 'Percentage of total votes cast in favor of the resolution at the meeting.']
  voting_power_percentage decimal(5,2) [note: 'Percentage of total outstanding shares represented by the shares voted, indicating voting power.']
  created_by varchar [note: 'User or system identifier that created this proxy vote record.']

  Note: 'SSOT transactional record of proxy voting decisions cast at investee company shareholder meetings, including meeting date, resolution category, vote direction, and rationale. Governed by proxy_vote_policy guidelines.'
}

Table esg.pri_reporting_submission {
  pri_reporting_submission_id varchar [pk, note: 'Unique identifier for the PRI reporting submission record.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: PRI reporting submissions are made under the PRI framework. This also connects the previously siloed pri_reporting_submission product.']
  approval_date date [note: 'The date on which this submission response was formally approved for submission to PRI.']
  assessment_band varchar [note: 'The overall assessment band awarded by PRI for the module (e.g., Five Stars, Four Stars, Three Stars, Two Stars, One Star).']
  assessment_score varchar [note: 'The assessment score awarded by PRI for this indicator (e.g., A+, A, B, C, D, E) based on the quality and comprehensiveness of the response.']
  asset_class varchar [note: 'The asset class to which this indicator response applies (e.g., Public Equities, Private Equity, Real Estate, Infrastructure, Fixed Income, Natural Resources).']
  aum_coverage_amount decimal(20,2) [note: 'The total AUM (in base currency) covered by this indicator response, representing the asset base to which the ESG practice applies.']
  aum_coverage_percentage decimal(5,2) [note: 'The percentage of total AUM covered by this indicator response (0.00 to 100.00).']
  created_timestamp timestamp [note: 'The timestamp when this submission record was first created in the system.']
  data_quality_score decimal(3,2) [note: 'Internal data quality score for this submission (0.00 to 1.00) reflecting completeness, accuracy, and timeliness of the underlying data.']
  data_source varchar [note: 'The internal or external system from which the response data was sourced (e.g., BlackRock Aladdin ESG Analytics, MSCI ESG Ratings, Internal ESG Database).']
  indicator_code varchar [note: 'The specific indicator code within the module (e.g., SG01, LE02.1, PE03) as defined by PRI reporting taxonomy.']
  indicator_description varchar [note: 'Full text description of the indicator question or requirement being addressed in this submission.']
  last_modified_by varchar [note: 'Identifier of the user or system that last modified this submission record.']
  last_modified_timestamp timestamp [note: 'The timestamp when this submission record was last modified.']
  module_name varchar [note: 'The specific PRI reporting module being submitted (e.g., Strategy & Governance, Listed Equity, Private Equity, Real Estate, Infrastructure, Fixed Income).']
  notes varchar [note: 'Additional notes, comments, or context related to this submission response for internal reference.']
  peer_comparison_percentile decimal(5,2) [note: 'The percentile ranking of this submission relative to peer signatories in the same asset class and region (0.00 to 100.00).']
  prepared_by varchar [note: 'Name or identifier of the individual or team responsible for preparing this submission response.']
  public_disclosure_flag boolean [note: 'Indicates whether this submission response is approved for public disclosure in the PRI Transparency Report (True/False).']
  reporting_year varchar [note: 'The calendar year for which the PRI assessment is being reported (e.g., 2023).']
  response_type varchar [note: 'The type of response required for this indicator (e.g., Quantitative, Qualitative, Binary, Multiple Choice, Descriptive).']
  response_unit varchar [note: 'Unit of measure for quantitative responses (e.g., USD millions, percentage, tonnes CO2e, number of holdings).']
  response_value decimal(18,2) [note: 'The actual response value submitted for this indicator. May contain numeric values, text descriptions, or categorical selections depending on response_type.']
  reviewed_by varchar [note: 'Name or identifier of the individual or team who reviewed and approved this submission response before submission.']
  submission_date date [note: 'The date on which this submission was formally submitted to PRI.']
  submission_deadline date [note: 'The deadline date by which this submission must be completed and submitted to PRI.']
  submission_reference_number varchar [note: 'External reference number assigned by PRI for this submission (e.g., PRI-2023-A1B2C3D4).']
  submission_status varchar [note: 'Current lifecycle status of this submission record (e.g., Draft, In Review, Submitted, Validated, Published, Rejected).']
  supporting_evidence_url varchar [note: 'URL or document reference to supporting evidence, policies, or documentation that substantiates this submission response.']
  transparency_report_url varchar [note: 'URL to the published PRI Transparency Report containing this submission data.']
  validation_errors varchar [note: 'Description of any validation errors or warnings identified by PRI during submission review.']
  validation_status varchar [note: 'Status of PRI validation checks for this submission (e.g., Pending, Passed, Failed, Waived).']
  created_by varchar [note: 'Identifier of the user or system that created this submission record.']

  Note: 'Transactional record of annual PRI (Principles for Responsible Investment) Assessment submissions. Captures reporting year, module name (Strategy & Governance, Listed Equity, Private Equity, Real Estate, Infrastructure, Fixed Income), indicator code'
}

Table esg.controversy {
  controversy_id varchar [pk, note: 'Unique identifier for the ESG controversy record.']
  assigned_analyst_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: ESG controversy monitoring requires analyst assignment for investigation and escalation. Pension funds track which employee is responsible for monitoring each controversy for workload']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Controversies are assessed against responsible investment policies to determine escalation and response actions.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Severe controversies can trigger exclusion list placement. The exclusion_list_flag indicates this relationship exists, the FK provides the direct link.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Linking controversy to issuer_esg_rating associates controversies with the issuer’s ESG rating, supporting risk analysis.']
  analyst_notes varchar [note: 'Internal notes and commentary from the ESG analyst or investment team regarding the controversy.']
  controversy_category varchar [note: 'Detailed sub-category or theme of the controversy within the primary type.']
  controversy_code varchar [note: 'Business-assigned unique code for the controversy event.']
  controversy_status varchar [note: 'Current lifecycle status of the controversy within the investment risk management process.']
  controversy_type varchar [note: 'Primary classification of the controversy event.']
  created_timestamp timestamp [note: 'Timestamp when the controversy record was first created in the system.']
  data_source varchar [note: 'Primary source of the controversy information (e.g., MSCI ESG, RepRisk, media, regulatory filing).']
  divestment_deadline date [note: 'Target date by which divestment or exposure reduction should be completed if recommended.']
  divestment_recommendation varchar [note: 'Investment action recommendation resulting from the controversy assessment.']
  engagement_initiated_flag boolean [note: 'Indicates whether active engagement with the investee has been initiated in response to the controversy.']
  engagement_status varchar [note: 'Current status of the engagement activity with the investee regarding the controversy.']
  escalation_date date [note: 'Date when the controversy was escalated to Investment Committee or senior management.']
  escalation_flag boolean [note: 'Indicates whether the controversy has been escalated to Investment Committee or senior management.']
  exclusion_list_flag boolean [note: 'Indicates whether the investee has been added to the exclusion list as a result of this controversy.']
  financial_penalty_amount decimal(18,2) [note: 'Monetary value of fines or penalties imposed on the investee related to the controversy.']
  geographic_location varchar [note: 'ISO 3166-1 alpha-3 country code where the controversy incident occurred.']
  ghg_emissions_related boolean [note: 'Indicates whether the controversy involves greenhouse gas emissions or climate impact.']
  ic_decision varchar [note: 'Investment Committee decision or recommendation regarding the controversy and investee.']
  ic_decision_date date [note: 'Date when the Investment Committee made its decision regarding the controversy.']
  ic_submission_flag boolean [note: 'Indicates whether the controversy has been formally submitted to the Investment Committee for review.']
  identification_date date [note: 'Date when the controversy was first identified and recorded by the ESG team.']
  impact_assessment_summary varchar [note: 'Summary of the assessed impact of the controversy on stakeholders, environment, and investment value.']
  incident_date date [note: 'Date when the controversy event or incident occurred or was first reported publicly.']
  investee_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the investee company or fund manager subject to the controversy.']
  investee_name varchar [note: 'Legal or common name of the investee company or fund manager involved in the controversy.']
  investee_response_summary varchar [note: 'Summary of the investee\'s response, remediation actions, or public statement regarding the controversy.']
  is_active boolean [note: 'Indicates whether the controversy record is currently active and under monitoring.']
  last_modified_by varchar [note: 'User identifier of the person who last modified the controversy record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the controversy record was last updated.']
  media_url varchar [note: 'URL link to the primary media article or public disclosure reporting the controversy.']
  next_review_date date [note: 'Scheduled date for the next review of the controversy status and investee response.']
  penalty_currency varchar [note: 'ISO 4217 three-letter currency code for the financial penalty amount.']
  proxy_voting_action varchar [note: 'Proxy voting action taken or recommended in response to the controversy.']
  regulatory_action_flag boolean [note: 'Indicates whether regulatory or legal action has been taken against the investee.']
  regulatory_authority varchar [note: 'Name of the regulatory body or authority involved in the controversy investigation or enforcement.']
  resolution_date date [note: 'Date when the controversy was resolved or closed by the investee or regulatory authority.']
  sector_classification varchar [note: 'Industry sector classification of the investee (e.g., GICS, NAICS).']
  severity_level varchar [note: 'Assessed severity of the controversy impact on stakeholders and reputation.']
  sfdr_pai_indicator varchar [note: 'SFDR Principal Adverse Impact indicator code associated with the controversy.']
  source_reference_code varchar [note: 'External reference identifier from the data source provider for traceability.']
  tcfd_climate_risk_flag boolean [note: 'Indicates whether the controversy relates to climate-related physical or transition risk.']
  un_global_compact_violation boolean [note: 'Indicates whether the controversy constitutes a violation of UN Global Compact principles.']
  watch_list_flag boolean [note: 'Indicates whether the investee has been placed on the ESG watch list due to this controversy.']
  created_by varchar [note: 'User identifier of the person who created the controversy record.']

  Note: 'Master record of ESG controversies, adverse-media events, and the resulting watch/escalation status flagged against investee companies or fund managers. Captures controversy type (environmental incident, labor violation, governance failure'
}

Table esg.due_diligence {
  due_diligence_id varchar [pk, note: 'Unique identifier for the ESG due diligence assessment record. Primary key for the due diligence product.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Linking due_diligence to climate_scenario provides a reference to the scenario used in the assessment, enabling traceability of stress‑testing data.']
  data_provider_id varchar [note: 'Foreign key linking to esg.data_provider. Business justification: Linking due_diligence to data_provider allows attribution of ESG ratings to the external vendor, supporting provenance and audit.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: ESG due_diligence records must link to master dd_engagement for integrated DD workflow. Enables consolidated DD status tracking and ensures ESG findings flow to IC submission package.']
  deal_opportunity_id varchar [note: 'Reference to the investment deal or opportunity being evaluated through ESG due diligence.']
  employee_id varchar [note: 'Reference to the internal ESG specialist or analyst responsible for leading the due diligence assessment.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: ESG due diligence assessments are conducted under responsible investment policies. Links DD to governing policy.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Linking due_diligence to exclusion_list records the specific exclusion criteria applied during the assessment, enabling detailed reporting.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Linking due_diligence to issuer_esg_rating associates the target issuer’s ESG rating with the assessment, providing context for risk scoring.']
  lead_assessor_employee_id varchar [note: 'Reference to the internal ESG specialist or analyst responsible for leading the due diligence assessment.']
  opportunity_id varchar [note: 'Reference to the investment deal or opportunity being evaluated through ESG due diligence.']
  assessment_code varchar [note: 'Unique business identifier for the ESG due diligence assessment, following format DD-ESG-NNNNNN.']
  assessment_status varchar [note: 'Current lifecycle status of the ESG due diligence assessment process. [ENUM-REF-CANDIDATE: initiated|in_progress|pending_review|completed|approved|rejected|on_hold — 7 candidates stripped; promote to reference product]']
  assessment_team_members varchar [note: 'Comma-separated list of employee identifiers representing the full ESG due diligence assessment team.']
  assessment_type varchar [note: 'Category of ESG due diligence assessment based on the nature of the investment opportunity being evaluated.']
  asset_class varchar [note: 'Investment asset class category to which the target entity or opportunity belongs. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income — 7 candidates stripped; promote to reference product]']
  carbon_intensity_metric varchar [note: 'Unit of measure for carbon intensity calculation, such as tCO2e per million revenue or tCO2e per unit produced.']
  carbon_intensity_value decimal(18,4) [note: 'Calculated carbon intensity value for the target entity using the specified metric denominator.']
  climate_risk_assessment varchar [note: 'Assessment of physical and transition climate risks facing the target entity under TCFD framework.']
  completion_date date [note: 'Date when the ESG due diligence assessment was completed and finalized for Investment Committee review.']
  controversy_description varchar [note: 'Summary of material ESG controversies, legal disputes, or reputational issues identified during due diligence.']
  controversy_level varchar [note: 'Severity classification of ESG-related controversies or incidents involving the target entity.']
  created_timestamp timestamp [note: 'System timestamp when the ESG due diligence assessment record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Assessment of the completeness and reliability of ESG data obtained during due diligence, on a 0-100 scale.']
  engagement_priority_flag boolean [note: 'Indicates whether the target entity has been flagged for active ESG engagement and stewardship activities post-investment.']
  engagement_topics varchar [note: 'Comma-separated list of ESG topics identified for active engagement with the target entity management or board.']
  environmental_score decimal(5,2) [note: 'Environmental pillar score assessing climate risk, resource efficiency, pollution, and biodiversity impact.']
  esg_overall_score decimal(5,2) [note: 'Composite ESG score assigned to the target entity, typically on a 0-100 scale, reflecting overall ESG performance.']
  esg_rating_provider varchar [note: 'Third-party ESG rating agency or internal methodology used to assess the target entity ESG performance. [ENUM-REF-CANDIDATE: msci|sustainalytics|refinitiv|sp_global|ftse_russell|internal|other — 7 candidates stripped; promote to reference product]']
  esg_risk_rating varchar [note: 'Categorical ESG risk classification indicating the severity of unmanaged ESG risks for the target entity.']
  exclusion_criteria_breached varchar [note: 'Comma-separated list of specific exclusion criteria breached by the target entity, if applicable.']
  exclusion_policy_breach_flag boolean [note: 'Indicates whether the target entity breaches any of the pension funds ESG exclusion policies or criteria.']
  external_advisor_name varchar [note: 'Name of external ESG consultant or advisory firm engaged to support the due diligence assessment, if applicable.']
  governance_score decimal(5,2) [note: 'Governance pillar score assessing board structure, executive compensation, shareholder rights, and business ethics.']
  ic_decision varchar [note: 'Final Investment Committee decision on the investment opportunity following ESG due diligence review.']
  ic_decision_date date [note: 'Date when the Investment Committee rendered its final decision on the investment opportunity.']
  ic_submission_date date [note: 'Date when the ESG due diligence assessment was submitted to the Investment Committee for review and decision.']
  initiation_date date [note: 'Date when the ESG due diligence assessment was formally initiated and assigned to the assessment team.']
  last_modified_by varchar [note: 'User identifier of the individual who most recently modified the ESG due diligence assessment record.']
  last_modified_timestamp timestamp [note: 'System timestamp when the ESG due diligence assessment record was most recently updated.']
  net_zero_commitment_flag boolean [note: 'Indicates whether the target entity has made a public commitment to achieve net zero greenhouse gas emissions.']
  net_zero_target_year varchar [note: 'Calendar year by which the target entity has committed to achieve net zero emissions, if applicable.']
  pri_signatory_flag boolean [note: 'Indicates whether the target entity or fund manager is a signatory to the UN Principles for Responsible Investment.']
  recommendation varchar [note: 'Final ESG due diligence recommendation to the Investment Committee regarding the investment opportunity.']
  recommendation_rationale varchar [note: 'Detailed justification for the ESG due diligence recommendation, including key findings and risk mitigation strategies.']
  scope_1_emissions_tco2e decimal(18,2) [note: 'Direct greenhouse gas emissions from sources owned or controlled by the target entity, measured in tonnes CO2 equivalent.']
  scope_2_emissions_tco2e decimal(18,2) [note: 'Indirect greenhouse gas emissions from purchased electricity, steam, heating, and cooling consumed by the target entity.']
  scope_3_emissions_tco2e decimal(18,2) [note: 'Indirect greenhouse gas emissions from value chain activities upstream and downstream of the target entity.']
  sfdr_article_classification varchar [note: 'SFDR classification indicating whether the investment promotes environmental or social characteristics or has sustainable investment as its objective.']
  social_score decimal(5,2) [note: 'Social pillar score assessing labor practices, human rights, community relations, and product responsibility.']
  target_entity_country varchar [note: 'ISO 3166-1 alpha-3 country code representing the primary jurisdiction of the investment target entity.']
  target_entity_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the investment target, enabling global entity identification.']
  target_entity_name varchar [note: 'Legal name of the investment target entity being assessed for ESG risks and opportunities.']
  target_sector varchar [note: 'Industry sector classification of the investment target entity using GICS or equivalent taxonomy.']
  taxonomy_alignment_pct decimal(5,2) [note: 'Percentage of target entity revenue or activities aligned with EU Taxonomy for sustainable activities.']
  un_global_compact_violation_flag boolean [note: 'Indicates whether the target entity has been identified as violating UN Global Compact principles on human rights, labor, environment, or anti-corruption.']
  created_by varchar [note: 'User identifier of the individual who created the ESG due diligence assessment record in the system.']

  Note: 'Transactional record of ESG due diligence assessments conducted during investment evaluation for new deals, co-investments, and external manager selections.'
}

Table esg.kpi_target {
  kpi_target_id varchar [pk, note: 'Unique identifier for the ESG KPI target record.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: KPI targets align to ESG frameworks (PRI, TCFD, etc.). The alignment_framework STRING can be removed as the FK provides the authoritative link.']
  holding_id varchar [note: 'Reference to a specific portfolio holding if the KPI target is set at the individual investment level.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this KPI target applies.']
  achievement_status varchar [note: 'Current assessment of progress toward the KPI target, indicating whether achievement is on track, at risk, off track, already achieved, or not yet started.']
  approval_date date [note: 'Date on which the KPI target was formally approved by the Investment Committee or ESG governance body.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the KPI target.']
  asset_class varchar [note: 'Asset class to which this KPI target applies, enabling asset-class-level ESG performance tracking.']
  baseline_value decimal(18,4) [note: 'Starting or baseline value of the KPI against which progress toward the target is measured.']
  baseline_year varchar [note: 'Calendar year in which the baseline value was established, serving as the reference point for target achievement.']
  created_timestamp timestamp [note: 'Timestamp when the KPI target record was first created in the system.']
  data_source varchar [note: 'Primary data source or provider used to measure progress against the KPI target, such as MSCI ESG, Bloomberg, or issuer disclosures.']
  effective_date date [note: 'Date from which the KPI target becomes active and performance tracking begins.']
  escalation_threshold_pct decimal(5,2) [note: 'Percentage deviation from the target trajectory that triggers escalation to senior management or the Investment Committee.']
  expiry_date date [note: 'Date on which the KPI target expires or is superseded, marking the end of its active tracking period.']
  interim_target_value decimal(18,4) [note: 'Intermediate target value set for a milestone year between the baseline and final target year.']
  interim_target_year varchar [note: 'Calendar year for the interim target milestone, enabling phased progress tracking.']
  is_active boolean [note: 'Indicates whether the KPI target is currently active and being tracked, or has been archived or superseded.']
  kpi_category varchar [note: 'High-level category classifying the KPI into environmental, social, governance, climate, diversity, or health and safety domains.']
  kpi_code varchar [note: 'Standardized code identifying the specific ESG KPI being targeted.']
  kpi_name varchar [note: 'Human-readable name of the ESG KPI, such as carbon intensity, board diversity percentage, renewable energy percentage, water intensity, or employee safety rate.']
  kpi_subcategory varchar [note: 'Detailed subcategory providing granular classification of the KPI within its primary category.']
  last_measured_value decimal(18,4) [note: 'Most recent measured value of the KPI, used to assess current progress toward the target.']
  last_measurement_date date [note: 'Date on which the most recent KPI measurement was taken.']
  last_modified_by varchar [note: 'Identifier of the user or system that last modified the KPI target record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the KPI target record was most recently modified.']
  methodology varchar [note: 'Description of the methodology used to set the KPI target, including calculation approach, data sources, and assumptions.']
  next_review_date date [note: 'Scheduled date for the next formal review of the KPI target and its progress.']
  notes varchar [note: 'Free-text field for additional context, commentary, or qualitative information about the KPI target and its progress.']
  owner varchar [note: 'Name or identifier of the individual, team, or department responsible for achieving the KPI target.']
  paris_alignment_flag boolean [note: 'Indicates whether the KPI target is aligned with the Paris Agreement climate goals, typically 1.5 or 2 degrees Celsius warming scenarios.']
  progress_pct decimal(5,2) [note: 'Percentage of progress achieved toward the KPI target, calculated as the ratio of improvement to total required improvement.']
  public_disclosure_required boolean [note: 'Indicates whether the KPI target and its progress must be publicly disclosed in regulatory filings or sustainability reports.']
  reporting_frequency varchar [note: 'Frequency at which progress against the KPI target is reported to stakeholders and governance bodies.']
  review_frequency_months varchar [note: 'Frequency in months at which the KPI target is reviewed for progress and potential adjustment.']
  sbti_validated_flag boolean [note: 'Indicates whether the KPI target has been validated by the Science Based Targets initiative as science-based.']
  target_scope varchar [note: 'Scope level at which the KPI target is set, such as entire portfolio, specific asset class, individual holding, or fund.']
  target_status varchar [note: 'Current lifecycle status of the KPI target, indicating whether it is in draft, active tracking, achieved, missed, suspended, or cancelled.']
  target_type varchar [note: 'Classification of the target as absolute reduction, intensity-based, percentage improvement, or binary achievement.']
  target_unit varchar [note: 'Unit of measure for the target value, such as percentage, tonnes CO2e per million revenue, or incidents per employee.']
  target_value decimal(18,4) [note: 'Numeric target value for the KPI that the portfolio, asset class, or holding is expected to achieve.']
  target_year varchar [note: 'Calendar year by which the KPI target is expected to be achieved.']
  created_by varchar [note: 'Identifier of the user or system that created the KPI target record.']

  Note: 'Master record of ESG key performance indicator (KPI) targets set at the portfolio, asset class, or individual holding level. Captures KPI name, KPI category (carbon intensity, board diversity %, renewable energy %, water intensity, employee safety rate)'
}

Table esg.kpi_measurement {
  kpi_measurement_id varchar [pk, note: 'Unique identifier for the ESG KPI measurement record.']
  data_provider_id varchar [note: 'Foreign key linking to esg.data_provider. Business justification: KPI measurement data is sourced from external data providers. The data_provider STRING can be removed as the FK provides the authoritative link.']
  kpi_kpi_target_id varchar [note: 'Reference to the ESG KPI definition being measured.']
  kpi_target_id varchar [note: 'Foreign key linking to esg.kpi_target. Business justification: KPI measurements track progress against KPI targets. The target_value on measurement is the point-in-time target, the FK links to the full target record.']
  portfolio_holding_id varchar [note: 'Reference to the specific portfolio holding for which this KPI is measured.']
  portfolio_id varchar [note: 'Reference to the portfolio for which this KPI is measured at aggregate level.']
  actual_value decimal(20,6) [note: 'The actual measured value of the KPI for the specified period.']
  approval_date date [note: 'The date on which the measurement was approved for official reporting.']
  approval_status varchar [note: 'The approval status of the measurement for official reporting purposes.']
  approved_by varchar [note: 'The name or identifier of the person who approved the measurement for reporting.']
  asset_class varchar [note: 'The asset class category to which the measured holding belongs. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income — 7 candidates stripped; promote to reference product]']
  baseline_value decimal(20,6) [note: 'The baseline or reference value against which progress is measured over time.']
  baseline_year varchar [note: 'The year from which the baseline value was established for comparison purposes.']
  calculation_method varchar [note: 'The specific calculation method applied to derive the KPI value from raw data.']
  created_timestamp timestamp [note: 'The timestamp when this measurement record was first created in the system.']
  currency_code varchar [note: 'The ISO 4217 three-letter currency code if the KPI measurement is expressed in monetary terms.']
  data_coverage_percentage decimal(5,2) [note: 'The percentage of the portfolio or holding for which actual data was available (vs. estimated or proxied).']
  data_quality_flag boolean [note: 'A categorical flag indicating the overall quality level of the measurement data.']
  data_quality_score decimal(5,2) [note: 'A numerical score representing the quality and reliability of the measurement data, typically on a scale of 0-100.']
  data_source_type varchar [note: 'The type of data source used to obtain the KPI measurement.']
  exception_flag boolean [note: 'Indicates whether this measurement represents an exception or anomaly requiring attention.']
  exception_reason varchar [note: 'Explanation of why this measurement was flagged as an exception.']
  geographic_scope varchar [note: 'The geographic region or country to which this measurement applies.']
  gri_indicator_code varchar [note: 'The GRI indicator code that this measurement corresponds to, if applicable.']
  last_modified_by varchar [note: 'The identifier of the user or system that last modified this measurement record.']
  last_modified_timestamp timestamp [note: 'The timestamp when this measurement record was last updated.']
  materiality_assessment varchar [note: 'Assessment of whether this KPI measurement is material to investment decision-making or reporting.']
  measurement_date date [note: 'The date on which the KPI measurement was taken or observed.']
  measurement_frequency varchar [note: 'The frequency at which this KPI is measured and reported.']
  measurement_methodology varchar [note: 'Description of the methodology or approach used to measure or calculate the KPI value.']
  measurement_notes varchar [note: 'Additional notes, comments, or context regarding the KPI measurement.']
  measurement_status varchar [note: 'The current status of the KPI measurement in its lifecycle.']
  on_track_flag boolean [note: 'Boolean indicator of whether the KPI measurement is on track to meet its target.']
  progress_to_target_percentage decimal(10,4) [note: 'The percentage of progress achieved toward the target value from the baseline.']
  reporting_period_end_date date [note: 'The end date of the reporting period for which this KPI measurement applies.']
  reporting_period_start_date date [note: 'The start date of the reporting period for which this KPI measurement applies.']
  sasb_metric_code varchar [note: 'The SASB metric code that this measurement corresponds to, if applicable.']
  sector_classification varchar [note: 'The industry sector classification of the asset or holding being measured.']
  sfdr_pai_indicator varchar [note: 'The SFDR PAI indicator code that this measurement corresponds to, if applicable.']
  target_value decimal(20,6) [note: 'The target or benchmark value that the KPI is measured against.']
  tcfd_alignment_flag boolean [note: 'Indicates whether this measurement aligns with TCFD disclosure requirements.']
  unit_of_measure varchar [note: 'The unit in which the KPI value is expressed (e.g., tCO2e for emissions, percentage for ratios). [ENUM-REF-CANDIDATE: tCO2e|MWh|m3|percentage|score|count|currency|ratio — 8 candidates stripped; promote to reference product]']
  variance_percentage decimal(10,4) [note: 'The variance expressed as a percentage of the target value.']
  variance_value decimal(20,6) [note: 'The calculated variance between actual and target values (actual minus target).']
  verification_body varchar [note: 'The name of the independent third-party organization that verified the measurement.']
  verification_date date [note: 'The date on which the measurement was verified by an independent party.']
  verification_status varchar [note: 'Indicates whether the measurement has been independently verified or assured.']
  created_by varchar [note: 'The identifier of the user or system that created this measurement record.']

  Note: 'Transactional record of periodic ESG KPI actuals measured against targets at the holding or portfolio level. Captures measurement date, KPI reference, actual value, unit of measure, variance from target, data source, measurement methodology, data quality'
}

Table esg.integration_checklist {
  integration_checklist_id varchar [pk, note: 'Unique identifier for the ESG integration checklist record. Primary key for the integration checklist entity.']
  assigned_to_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: ESG integration checklists in deal process require assignment to specific analysts. Tracks who is responsible for completing ESG due diligence items before Investment Committee.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: ESG integration checklists track ESG factor integration during investment process. Linking to dd_engagement enables tracking checklist completion as part of DD workflow and IC']
  deal_opportunity_id varchar [note: 'Identifier of the deal or transaction in the origination pipeline associated with this ESG integration checklist.']
  esg_benchmark_id varchar [note: 'Foreign key linking to esg.esg_benchmark. Business justification: Linking integration_checklist to esg_benchmark records the benchmark used during the ESG integration process, enabling traceability.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Integration checklists implement policy requirements during investment evaluation. Links checklist to governing policy.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Integration checklists check investments against exclusion lists. The exclusion_criteria_breached and exclusion_details are assessment results, the FK links to the exclusion list checked.']
  ic_decision_id varchar [note: 'Foreign key linking to compliance.ic_decision. Business justification: ESG integration checklists are reviewed during investment committee meetings. The IC decision records which ESG checklist was considered when approving/rejecting investments.']
  investment_id varchar [note: 'Identifier of the investment opportunity or holding to which this ESG integration checklist applies.']
  opportunity_id varchar [note: 'Identifier of the deal or transaction in the origination pipeline associated with this ESG integration checklist.']
  approval_date date [note: 'Date when the completed ESG integration checklist was formally approved by the designated reviewer or governance body.']
  approved_by varchar [note: 'Name or identifier of the individual who formally approved the ESG integration checklist.']
  asset_class varchar [note: 'Primary asset class category of the investment being assessed through this ESG integration checklist. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|multi_asset — 8 candidates stripped']
  checklist_identifier varchar [note: 'Business-readable unique identifier or reference code for the checklist instance, used for tracking and reporting purposes.']
  checklist_status varchar [note: 'Current lifecycle status of the ESG integration checklist indicating progress through the assessment workflow. [ENUM-REF-CANDIDATE: not_started|in_progress|completed|approved|rejected|pending_review|overdue — 7 candidates stripped; promote to reference']
  checklist_type varchar [note: 'Category of ESG integration checklist defining the stage in the investment lifecycle where ESG factors are assessed. [ENUM-REF-CANDIDATE']
  completed_items varchar [note: 'Number of checklist items that have been completed and assessed as of the current status.']
  completion_date date [note: 'Date when the ESG integration checklist was fully completed and all required items were assessed.']
  completion_percentage decimal(5,2) [note: 'Percentage of checklist items completed, calculated as completed items divided by total items, expressed as a percentage.']
  controversy_level varchar [note: 'Severity level of ESG controversies associated with the investment, based on third-party data and internal assessment.']
  created_timestamp timestamp [note: 'Timestamp when the ESG integration checklist record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Assessment of the quality and completeness of ESG data available for the checklist, expressed as a percentage score.']
  data_source varchar [note: 'Primary source of ESG data used to complete the integration checklist, such as third-party providers or direct issuer disclosure.']
  document_reference_url varchar [note: 'URL or file path to the detailed ESG integration checklist document, supporting evidence, or assessment report.']
  due_date date [note: 'Target date by which the ESG integration checklist must be completed to meet investment governance requirements.']
  engagement_priority varchar [note: 'Priority level assigned to engagement activities required based on the severity of ESG issues identified.']
  engagement_required boolean [note: 'Flag indicating whether active engagement with the investee entity is required to address ESG concerns identified in the checklist.']
  environmental_score decimal(5,2) [note: 'Numerical score representing the environmental pillar assessment from the ESG integration checklist, typically on a 0-100 scale.']
  exclusion_criteria_breached boolean [note: 'Flag indicating whether the investment breaches any ESG exclusion criteria defined in the responsible investment policy.']
  exclusion_details varchar [note: 'Description of specific exclusion criteria breached, including policy references and severity of the breach.']
  governance_score decimal(5,2) [note: 'Numerical score representing the governance pillar assessment from the ESG integration checklist, typically on a 0-100 scale.']
  ic_conditions varchar [note: 'Specific conditions or requirements imposed by the Investment Committee related to ESG factors that must be met before investment execution.']
  ic_decision varchar [note: 'Investment Committee decision regarding the investment based on the ESG integration checklist findings.']
  ic_submission_date date [note: 'Date when the ESG integration checklist was submitted to the Investment Committee as part of the investment approval process.']
  investment_stage varchar [note: 'Stage in the investment lifecycle at which this ESG integration checklist is being conducted. [ENUM-REF-CANDIDATE: origination|screening|due_diligence|ic_approval|execution|holding|monitoring|exit — 8 candidates stripped; promote to reference product]']
  last_modified_timestamp timestamp [note: 'Timestamp when the ESG integration checklist record was last updated or modified.']
  material_esg_risks_identified boolean [note: 'Flag indicating whether material ESG risks were identified during the checklist assessment that require mitigation or escalation.']
  methodology_version varchar [note: 'Version identifier of the ESG integration methodology or checklist template used for this assessment.']
  mitigation_actions_required boolean [note: 'Flag indicating whether specific mitigation actions or remediation steps are required based on the checklist findings.']
  mitigation_plan varchar [note: 'Description of planned actions to address identified ESG risks or deficiencies, including timelines and responsible parties.']
  next_review_date date [note: 'Scheduled date for the next ESG integration checklist review or reassessment, typically for ongoing monitoring of held investments.']
  notes varchar [note: 'Additional comments, observations, or context related to the ESG integration checklist assessment and findings.']
  overall_esg_rating varchar [note: 'Aggregated ESG rating or score assigned to the investment based on the checklist assessment results. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|not_rated — 8 candidates stripped; promote to reference product]']
  paris_alignment_flag boolean [note: 'Flag indicating whether the investment is aligned with Paris Agreement climate goals and net-zero transition pathways.']
  review_frequency_months varchar [note: 'Frequency in months at which the ESG integration checklist should be reviewed and updated for ongoing investments.']
  reviewer varchar [note: 'Name or identifier of the individual responsible for reviewing and approving the completed ESG integration checklist.']
  risk_summary varchar [note: 'Narrative summary of key ESG risks identified through the checklist assessment, including severity and potential impact.']
  sfdr_classification varchar [note: 'Sustainable Finance Disclosure Regulation article classification applicable to this investment based on ESG integration assessment.']
  social_score decimal(5,2) [note: 'Numerical score representing the social pillar assessment from the ESG integration checklist, typically on a 0-100 scale.']
  tcfd_alignment_flag boolean [note: 'Flag indicating whether the investment aligns with Task Force on Climate-related Financial Disclosures recommendations.']
  total_items varchar [note: 'Total number of assessment items or questions included in this ESG integration checklist.']
  un_global_compact_violation_flag boolean [note: 'Flag indicating whether the investment involves entities with confirmed violations of UN Global Compact principles.']

  Note: 'Transactional record of ESG integration checklist completions embedded within the investment lifecycle (deal screening, IC memo, annual review). Captures checklist type (pre-investment screening, annual monitoring, exit review), completion date'
}

Table esg.net_zero_commitment {
  net_zero_commitment_id varchar [pk, note: 'Unique identifier for the net-zero commitment record.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Net zero commitments align to frameworks like SBTi, NZAOA. The commitment_standard STRING can be removed as the FK provides the authoritative link.']
  net_esg_policy_id varchar [note: 'Reference to the ESG or climate policy that governs or supports this net-zero commitment.']
  net_related_policy_esg_policy_id varchar [note: 'Reference to the ESG or climate policy that governs or supports this net-zero commitment.']
  approval_date date [note: 'The date on which the net-zero commitment was formally approved by the Investment Committee or Board.']
  approved_by varchar [note: 'Name or identifier of the governance body or individual who approved the commitment, such as Investment Committee or Board of Directors.']
  asset_class varchar [note: 'The asset class to which this net-zero commitment applies, if scope is asset-class specific. [ENUM-REF-CANDIDATE: Public_Equities|Private_Equity|Real_Estate|Infrastructure|Natural_Resources|Credit|Multi_Asset|All — 8 candidates stripped; promote to']
  base_year varchar [note: 'The baseline year against which emissions reductions are measured, typically the year of initial emissions measurement.']
  base_year_emissions_tco2e decimal(18,2) [note: 'Total greenhouse gas emissions in tonnes of carbon dioxide equivalent for the baseline year, covering applicable scopes.']
  carbon_offset_allowed boolean [note: 'Indicates whether carbon offsets or credits are permitted to meet the net-zero target, and under what conditions.']
  carbon_removal_allowed boolean [note: 'Indicates whether carbon removal technologies or nature-based solutions are permitted to neutralize residual emissions.']
  commitment_code varchar [note: 'Business identifier code for the net-zero commitment, used for external reference and reporting.']
  commitment_name varchar [note: 'Descriptive name of the net-zero commitment initiative or program.']
  commitment_owner varchar [note: 'Name or department of the internal owner responsible for managing and delivering the net-zero commitment.']
  commitment_scope varchar [note: 'The scope of the commitment, indicating whether it applies to the total portfolio, specific asset class, sector, geography, or fund.']
  commitment_status varchar [note: 'Current lifecycle status of the net-zero commitment. [ENUM-REF-CANDIDATE: Draft|Approved|Active|Under_Review|Suspended|Achieved|Superseded — 7 candidates stripped; promote to reference product]']
  created_timestamp timestamp [note: 'The timestamp when this net-zero commitment record was first created in the system.']
  decarbonization_strategy varchar [note: 'High-level description of the strategy to achieve the net-zero commitment, including engagement, divestment, green investment, and transition finance approaches.']
  divestment_threshold_defined boolean [note: 'Indicates whether specific divestment thresholds or criteria have been defined as part of the commitment strategy.']
  document_url varchar [note: 'URL or document reference to the formal commitment document, public disclosure, or detailed strategy documentation.']
  effective_date date [note: 'The date from which the net-zero commitment becomes effective and operational.']
  engagement_priority boolean [note: 'Indicates whether active engagement with investee companies is a priority strategy for achieving this commitment.']
  external_verification_required boolean [note: 'Indicates whether external third-party verification or assurance of emissions data and progress is required.']
  financed_emissions_methodology varchar [note: 'The methodology used to calculate financed emissions for portfolio holdings, such as Partnership for Carbon Accounting Financials (PCAF) or SBTi Financial Institutions standard.']
  geographic_scope varchar [note: 'Geographic region or country scope of the commitment, using ISO 3166 country codes or regional groupings.']
  green_investment_target_pct decimal(5,2) [note: 'Target percentage of portfolio allocated to green or climate-aligned investments as part of the net-zero strategy.']
  interim_reduction_target_pct decimal(5,2) [note: 'The percentage reduction in greenhouse gas emissions targeted for the interim target year, relative to the baseline year.']
  interim_target_year varchar [note: 'The year by which the interim decarbonization target is to be achieved, typically 2025, 2030, or 2035.']
  is_active boolean [note: 'Indicates whether this net-zero commitment record is currently active and in use.']
  last_modified_by varchar [note: 'User or system identifier of the person or process that last modified this record.']
  last_modified_timestamp timestamp [note: 'The timestamp when this net-zero commitment record was last modified or updated.']
  last_review_date date [note: 'The date of the most recent review of the commitment progress and strategy.']
  net_zero_definition varchar [note: 'The specific definition of net-zero used for this commitment, including treatment of residual emissions, carbon offsets, and removals.']
  net_zero_target_year varchar [note: 'The year by which net-zero greenhouse gas emissions are targeted to be achieved, typically 2050.']
  next_review_date date [note: 'The scheduled date for the next review of the commitment progress and strategy.']
  notes varchar [note: 'Additional notes, context, or commentary regarding the net-zero commitment, including assumptions, limitations, or special considerations.']
  paris_alignment_flag boolean [note: 'Indicates whether the commitment is explicitly aligned with the goals of the Paris Agreement on climate change.']
  public_disclosure_required boolean [note: 'Indicates whether public disclosure of the commitment and progress is required under regulatory or voluntary frameworks.']
  reporting_frequency varchar [note: 'The frequency at which progress against the net-zero commitment is reported to stakeholders and regulators.']
  review_frequency_months varchar [note: 'The frequency in months at which the commitment progress is reviewed and reported, typically annually or semi-annually.']
  scope_1_included boolean [note: 'Indicates whether Scope 1 direct emissions from owned or controlled sources are included in the commitment.']
  scope_2_included boolean [note: 'Indicates whether Scope 2 indirect emissions from purchased electricity, heat, or steam are included in the commitment.']
  scope_3_included boolean [note: 'Indicates whether Scope 3 indirect emissions from the value chain, including financed emissions, are included in the commitment.']
  sector_classification varchar [note: 'Industry sector classification if the commitment is sector-specific, using standard classification systems such as GICS or BICS.']
  temperature_alignment_target varchar [note: 'The global warming temperature pathway that the commitment is aligned with, typically 1.5 degrees Celsius consistent with the Paris Agreement.']
  verification_body varchar [note: 'Name of the external third-party organization providing verification or assurance services for the commitment.']
  created_by varchar [note: 'User or system identifier of the person or process that created this record.']

  Note: 'Master record of the fund\'s net-zero commitments and interim decarbonization targets at the total portfolio and asset class level. Captures commitment name, commitment standard (NZAOA, SBTi, IIGCC NZIF), base year emissions, interim target year, interim'
}

Table esg.esg_benchmark {
  esg_benchmark_id varchar [pk, note: 'Unique identifier for the ESG benchmark record. Primary key.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Linking esg_benchmark to framework associates the benchmark with the governing ESG framework, supporting compliance reporting.']
  administrator varchar [note: 'Legal entity responsible for the administration and governance of the benchmark under applicable regulatory frameworks (e.g., EU Benchmark Regulation).']
  approval_date date [note: 'Date on which the benchmark was approved for use by the internal investment committee or governance authority.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the benchmark for use in portfolio management and reporting.']
  approved_for_use_flag boolean [note: 'Indicates whether the benchmark has been approved by internal investment committee or governance body for use in portfolio performance measurement and reporting.']
  base_index_name varchar [note: 'Name of the parent or underlying broad market index from which the ESG benchmark is derived (e.g., MSCI ACWI, S&P 500).']
  benchmark_category varchar [note: 'Asset class or market segment that the benchmark covers (e.g., Equity, Fixed Income, Multi-Asset, Real Estate, Infrastructure). [ENUM-REF-CANDIDATE: Equity|Fixed Income|Multi-Asset|Real Estate|Infrastructure|Private Markets|Broad Market|Sector-Specific —']
  benchmark_code varchar [note: 'Unique alphanumeric code assigned by the provider to identify the benchmark (e.g., MSCI ACWI ESG Leaders, FTSE4Good).']
  benchmark_name varchar [note: 'Full descriptive name of the ESG benchmark or index used for portfolio performance comparison.']
  benchmark_type varchar [note: 'Classification of the ESG benchmark methodology (e.g., ESG Leaders, Paris-Aligned, Climate Transition, Best-in-Class, Low Carbon). [ENUM-REF-CANDIDATE: ESG Leaders|Paris-Aligned|Climate Transition|Best-in-Class|Low Carbon|SRI|Thematic|Exclusionary — 8']
  carbon_intensity_reduction_target_pct decimal(5,2) [note: 'Target percentage reduction in weighted average carbon intensity (WACI) relative to the base index (e.g., 30% lower carbon intensity than parent index).']
  climate_alignment_target varchar [note: 'Climate goal or temperature pathway the benchmark is designed to align with (e.g., Paris Agreement 1.5°C, Net Zero by 2050, 2°C scenario).']
  created_timestamp timestamp [note: 'Timestamp when this benchmark record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the benchmark returns are denominated (e.g., USD, EUR, GBP).']
  data_source_url varchar [note: 'Web address or hyperlink to the official benchmark methodology document, factsheet, or provider page.']
  esg_benchmark_status varchar [note: 'Current lifecycle status of the benchmark indicating whether it is actively maintained and available for use.']
  esg_methodology varchar [note: 'Description of the ESG screening, scoring, or weighting methodology applied by the benchmark provider to construct the index.']
  esg_rating_provider varchar [note: 'Third-party ESG data or rating provider whose scores are used in the benchmark construction (e.g., MSCI ESG Research, Sustainalytics, ISS ESG).']
  eu_climate_benchmark_flag boolean [note: 'Indicates whether the benchmark is designated as an EU Climate Transition Benchmark (CTB) or EU Paris-Aligned Benchmark (PAB) under EU regulations.']
  exclusion_criteria varchar [note: 'List of sectors, activities, or controversies that result in exclusion from the benchmark (e.g., tobacco, weapons, thermal coal, UN Global Compact violators).']
  fossil_fuel_exposure_limit_pct decimal(5,2) [note: 'Maximum allowable percentage of benchmark weight allocated to fossil fuel-related companies (e.g., 5% cap on coal, oil, gas producers).']
  geographic_scope varchar [note: 'Geographic coverage of the benchmark (e.g., Global, North America, Europe, Asia-Pacific, Emerging Markets). Use 3-letter country codes for single-country benchmarks.']
  green_revenue_alignment_pct decimal(5,2) [note: 'Minimum percentage of constituent revenues that must be derived from green or sustainable activities as defined by EU Taxonomy or similar frameworks.']
  inception_date date [note: 'Date when the benchmark was first launched or calculated by the provider.']
  last_modified_by varchar [note: 'User identifier or system account that last modified this benchmark record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this benchmark record was last updated or modified.']
  last_rebalance_date date [note: 'Most recent date on which the benchmark was rebalanced or reconstituted by the provider.']
  last_review_date date [note: 'Most recent date on which the benchmark was reviewed for continued suitability and alignment with investment objectives.']
  methodology_document_url varchar [note: 'Direct link to the detailed methodology document published by the benchmark provider describing construction rules and ESG criteria.']
  minimum_esg_rating varchar [note: 'Minimum ESG rating threshold required for constituent inclusion in the benchmark (e.g., BBB or above on MSCI ESG scale).']
  next_rebalance_date date [note: 'Scheduled date for the next benchmark rebalancing or reconstitution event.']
  next_review_date date [note: 'Scheduled date for the next internal review of the benchmark suitability and methodology alignment.']
  notes varchar [note: 'Additional free-text notes, comments, or observations regarding the benchmark selection, limitations, or special considerations for use.']
  number_of_constituents varchar [note: 'Total count of securities or holdings included in the benchmark as of the last rebalance date.']
  pri_signatory_flag boolean [note: 'Indicates whether the benchmark provider is a signatory to the UN Principles for Responsible Investment.']
  provider varchar [note: 'Organization that publishes and maintains the ESG benchmark (e.g., MSCI, FTSE Russell, S&P Dow Jones Indices). [ENUM-REF-CANDIDATE: MSCI|FTSE Russell|S&P Dow Jones|Bloomberg|Sustainalytics|ISS ESG|Refinitiv|STOXX|Other — 9 candidates stripped; promote to']
  rebalancing_frequency varchar [note: 'Frequency at which the benchmark constituents and weights are reviewed and rebalanced by the provider.']
  regulatory_authorization varchar [note: 'Regulatory approval or registration status of the benchmark under applicable jurisdictions (e.g., EU BMR authorized, IOSCO compliant).']
  review_frequency_months varchar [note: 'Frequency in months at which the benchmark suitability and methodology are reviewed by internal governance (e.g., 12 for annual review, 36 for triennial).']
  sfdr_classification varchar [note: 'SFDR article classification of the benchmark indicating its sustainability characteristics (Article 6, 8, or 9 alignment).']
  tcfd_alignment_flag boolean [note: 'Indicates whether the benchmark methodology and disclosure practices align with TCFD recommendations for climate risk reporting.']
  un_sdg_alignment varchar [note: 'List of UN Sustainable Development Goals that the benchmark is designed to support or align with (e.g., SDG 7 Affordable Clean Energy, SDG 13 Climate Action).']
  usage_scope varchar [note: 'Description of the portfolios, mandates, or asset classes for which this benchmark is designated as the primary performance comparison standard.']
  weighting_methodology varchar [note: 'Method used to determine constituent weights in the benchmark (e.g., Market Capitalization, Equal Weight, ESG Score-Weighted, Carbon Efficiency). [ENUM-REF-CANDIDATE: Market Cap|Equal Weight|ESG Score|Carbon Efficiency|Fundamental|Factor-Based|Optimized —']
  created_by varchar [note: 'User identifier or system account that created this benchmark record.']

  Note: 'Reference catalogue of ESG benchmarks and indices used for portfolio ESG performance comparison. Captures benchmark name, benchmark provider (MSCI, FTSE Russell, S&P), benchmark type (ESG Leaders, Paris-Aligned, Climate Transition, Best-in-Class)'
}

Table esg.data_provider {
  data_provider_id varchar [pk, note: 'Unique identifier for the external ESG data provider or rating agency. Primary key.']
  annual_subscription_cost decimal(15,2) [note: 'Total annual cost of the subscription or service agreement with the provider in the contract currency.']
  api_endpoint_url varchar [note: 'Base URL for the provider\'s API endpoint if API delivery is used. Confidential operational information.']
  approval_date date [note: 'Date when the provider was approved for use by the investment committee or procurement authority.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the provider relationship.']
  contract_end_date date [note: 'Scheduled expiration or renewal date of the current contractual agreement. Null for evergreen contracts.']
  contract_reference_number varchar [note: 'Internal or external reference number for the master service agreement or subscription contract.']
  contract_start_date date [note: 'Effective start date of the current contractual agreement with the provider.']
  cost_currency_code varchar [note: 'ISO 4217 three-letter currency code for the annual subscription cost (e.g., USD, EUR, GBP).']
  coverage_asset_classes varchar [note: 'Asset classes covered by the provider\'s data (e.g., public equities, corporate bonds, sovereign debt, private equity, real estate, infrastructure).']
  coverage_geography varchar [note: 'Geographic scope of the provider\'s data coverage (e.g., global, North America, Europe, Asia-Pacific, emerging markets).']
  coverage_issuer_count varchar [note: 'Approximate number of unique issuers or entities covered by the provider\'s data universe.']
  created_timestamp timestamp [note: 'Timestamp when this provider record was first created in the system.']
  data_delivery_frequency varchar [note: 'Frequency at which data updates are delivered by the provider (real-time, daily, weekly, monthly, quarterly, annual, or on-demand). [ENUM-REF-CANDIDATE: real_time|daily|weekly|monthly|quarterly|annual|on_demand — 7 candidates stripped; promote to']
  data_delivery_method varchar [note: 'Primary method by which data is delivered from the provider (API, SFTP, web portal, email, vendor platform, or data feed).']
  data_format varchar [note: 'Technical format of delivered data (e.g., JSON, XML, CSV, Excel, Parquet, proprietary format).']
  data_products_subscribed varchar [note: 'Comma-separated list or description of specific data products, feeds, or services subscribed from this provider (e.g., ESG ratings, carbon data, controversy alerts, proxy research).']
  data_quality_last_review_date date [note: 'Date of the most recent internal data quality assessment or audit of the provider\'s data.']
  data_quality_score decimal(5,2) [note: 'Internal assessment score (0-100) reflecting the quality, completeness, and reliability of the provider\'s data based on periodic reviews.']
  data_usage_restrictions varchar [note: 'Description of any contractual restrictions on data usage, redistribution, or publication imposed by the provider.']
  headquarters_country varchar [note: 'ISO 3166-1 alpha-3 country code of the provider\'s headquarters location.']
  last_modified_by varchar [note: 'User identifier or system account that last modified this provider record.']
  last_modified_timestamp timestamp [note: 'Timestamp when this provider record was last updated.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the provider organization, enabling global entity identification.']
  methodology_framework varchar [note: 'Description or reference to the provider\'s ESG assessment methodology, rating framework, or data collection approach.']
  methodology_last_updated_date date [note: 'Date when the provider last updated or revised their methodology framework.']
  methodology_version varchar [note: 'Version identifier of the current methodology or rating framework in use by the provider.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the provider relationship, data quality, or contract terms.']
  notes varchar [note: 'Free-text field for additional comments, special considerations, or operational notes about the provider.']
  payment_terms varchar [note: 'Description of payment terms and schedule (e.g., annual in advance, quarterly in arrears, monthly billing).']
  portal_url varchar [note: 'Web portal URL for accessing provider data, reports, or analytics tools.']
  primary_contact_email varchar [note: 'Email address of the primary contact for operational and commercial matters.']
  primary_contact_name varchar [note: 'Full name of the primary relationship manager or account representative at the provider.']
  primary_contact_phone varchar [note: 'Telephone number of the primary contact for urgent escalations and support.']
  provider_code varchar [note: 'Short alphanumeric code uniquely identifying the provider (e.g., MSCI_ESG, SUSTAINALYTICS, ISS_ESG, REPRISK, CDP, BBGESG).']
  provider_name varchar [note: 'Full legal or trading name of the ESG data provider or rating agency.']
  provider_status varchar [note: 'Current lifecycle status of the provider relationship (active, inactive, suspended, under review, or terminated).']
  provider_type varchar [note: 'Classification of the provider\'s primary service offering (rating agency, data vendor, research provider, index provider, disclosure platform, or multi-service).']
  regulatory_alignment varchar [note: 'Comma-separated list of regulatory frameworks or standards the provider\'s data supports (e.g., SFDR, TCFD, PRI, EU Taxonomy, SASB, GRI).']
  review_frequency_months varchar [note: 'Frequency in months at which the provider relationship is reviewed (e.g., 12 for annual, 6 for semi-annual).']
  sfdr_pai_coverage_flag boolean [note: 'Indicates whether the provider supplies data for SFDR Principal Adverse Impact indicators (True/False).']
  sftp_host varchar [note: 'SFTP server hostname or IP address if SFTP delivery is used. Confidential operational information.']
  sla_support_response_time_hours varchar [note: 'Contractual maximum response time in hours for support requests or incidents.']
  sla_uptime_percentage decimal(5,2) [note: 'Contractual service level agreement uptime commitment as a percentage (e.g., 99.5 for 99.5% uptime).']
  tcfd_alignment_flag boolean [note: 'Indicates whether the provider\'s data is aligned with TCFD disclosure requirements (True/False).']
  vendor_risk_last_assessment_date date [note: 'Date of the most recent vendor risk assessment or due diligence review.']
  vendor_risk_rating varchar [note: 'Internal risk assessment rating for the provider based on operational, financial, and reputational risk (low, medium, high, or critical).']
  created_by varchar [note: 'User identifier or system account that created this provider record.']

  Note: 'Reference master of external ESG data vendors and rating agencies contracted by the fund. Captures provider name (MSCI ESG, RepRisk, Sustainalytics, ISS ESG, CDP, Bloomberg ESG), data products subscribed, coverage universe (asset class, geography, issuer'
}

Table esg.watch_list {
  watch_list_id varchar [pk, note: 'Unique identifier for the ESG watch list record. Primary key for the watch list entity.']
  controversy_id varchar [note: 'Foreign key linking to esg.controversy. Business justification: Watch list placements are often triggered by controversies. The controversy_level and controversy_description on watch_list are summary fields, the FK links to the full controversy record.']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Watch list entries may be linked to exclusion list entries when an issuer is being monitored for potential exclusion. Natural escalation path.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: ESG watch list tracks securities under scrutiny for controversies or policy breaches. Linking to instrument enables pre-trade screening systems to flag/block orders on watched securities']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Watch list entries monitor issuers with ESG ratings. The esg_rating_current/previous are point-in-time values that should be retained for historical tracking.']
  owner_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Watch list items require designated owners for ongoing monitoring and escalation decisions. Critical for risk management workflow and ensuring no items are orphaned.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: ESG watch list placements trigger compliance rules (trading restrictions, pre-clearance requirements, disclosure obligations).']
  approval_date date [note: 'Date when the watch list placement was formally approved by the responsible committee or authority.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the watch list placement.']
  closure_reason varchar [note: 'Reason for closing or removing the entity from the watch list, such as issue resolved, position divested, or entity no longer held.']
  controversy_description varchar [note: 'Detailed description of the ESG controversy or incident that led to watch list placement, including nature, scope, and stakeholders affected.']
  controversy_level varchar [note: 'Severity level of ESG-related controversy associated with the entity: low, moderate, high, or severe.']
  created_timestamp timestamp [note: 'Timestamp when the watch list record was first created in the system.']
  data_source varchar [note: 'Primary data source or system that provided the information triggering watch list placement, such as MSCI ESG, Bloomberg, or internal research.']
  divestment_deadline date [note: 'Target date by which divestment or position reduction must be completed if divestment has been recommended.']
  divestment_recommendation_flag boolean [note: 'Boolean flag indicating whether divestment or exclusion from portfolio has been recommended as a result of watch list review.']
  divestment_status varchar [note: 'Current status of divestment action: not applicable, planned, in progress, completed, or deferred.']
  engagement_objective varchar [note: 'Primary objective or goal of engagement with the entity on watch list, such as improving ESG disclosure, addressing controversy, or achieving policy compliance.']
  engagement_status varchar [note: 'Current status of active engagement with the entity on the watch list: not initiated, active, escalated, suspended, or completed.']
  entity_lei varchar [note: '20-character Legal Entity Identifier for the entity on watch list, enabling global entity identification.']
  entity_name varchar [note: 'Full legal or registered name of the entity placed on the ESG watch list.']
  entity_type varchar [note: 'Type of entity placed on the watch list: issuer, fund, manager, counterparty, security, or portfolio holding.']
  escalation_level varchar [note: 'Severity or priority level of the watch list entry: low, medium, high, or critical, determining urgency of response.']
  esg_rating_change_date date [note: 'Date when the ESG rating change occurred that contributed to watch list placement.']
  esg_rating_current varchar [note: 'Current ESG rating of the entity at the time of watch list placement or most recent update, from provider such as MSCI, Sustainalytics, or internal rating.']
  esg_rating_previous varchar [note: 'Previous ESG rating before the deterioration or change that triggered watch list placement, enabling trend analysis.']
  esg_rating_provider varchar [note: 'Name of the ESG rating provider whose rating triggered or informed the watch list placement, such as MSCI ESG, Sustainalytics, or ISS ESG.']
  ghg_emissions_intensity decimal(18,4) [note: 'Greenhouse gas emissions intensity metric for the entity, typically measured as tonnes of CO2 equivalent per million revenue or per unit of production.']
  holding_value_at_placement decimal(18,2) [note: 'Market value of the holding or exposure to the entity at the time of watch list placement, used to assess materiality and portfolio impact.']
  holding_value_currency varchar [note: 'Three-letter ISO currency code for the holding value at placement, such as USD, EUR, GBP, or JPY.']
  identifier varchar [note: 'Business-readable unique identifier or reference code for the watch list entry, used for external communication and reporting.']
  issuer_country varchar [note: 'Three-letter ISO country code representing the country of domicile or incorporation of the issuer.']
  last_modified_by varchar [note: 'User identifier or system account that last modified the watch list record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the watch list record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional context, observations, or commentary related to the watch list entry.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership or voting rights held in the entity at the time of watch list placement, relevant for engagement and stewardship decisions.']
  paris_alignment_flag boolean [note: 'Boolean flag indicating whether the entity is aligned with Paris Agreement climate goals and net-zero pathways.']
  placement_date date [note: 'Date when the entity was formally placed on the ESG watch list.']
  policy_breach_type varchar [note: 'Type or category of policy breach that triggered watch list placement, such as exclusion criteria violation, engagement mandate breach, or climate target misalignment.']
  policy_reference varchar [note: 'Reference to the specific ESG policy, exclusion policy, or responsible investment policy that was breached or triggered the watch list placement.']
  proxy_voting_restriction varchar [note: 'Voting restriction or guideline applied to the entity on watch list: none, vote against management, abstain, or case-by-case review.']
  resolution_action varchar [note: 'Specific action or milestone required to resolve the watch list issue and enable removal from watch list, such as rating upgrade, controversy resolution, or policy compliance.']
  resolution_date date [note: 'Date when the watch list issue was resolved and the entity was removed from active watch list status.']
  review_date date [note: 'Scheduled date for the next formal review of the watch list entry to assess status and determine next actions.']
  review_frequency_months varchar [note: 'Frequency in months for periodic review of the watch list entry, typically ranging from 1 to 12 months.']
  sector_classification varchar [note: 'Industry sector classification of the entity, typically using GICS, ICB, or internal taxonomy.']
  security_identifier varchar [note: 'Primary security identifier for the instrument on watch list, such as ISIN, CUSIP, or SEDOL.']
  security_identifier_type varchar [note: 'Type of security identifier used: ISIN, CUSIP, SEDOL, TICKER, or INTERNAL code.']
  sfdr_classification varchar [note: 'SFDR article classification of the fund or mandate associated with the watch list entity: Article 6, Article 8, or Article 9.']
  tcfd_climate_risk_flag boolean [note: 'Boolean flag indicating whether the entity has been identified as having material climate-related financial risk under TCFD framework.']
  trigger_date date [note: 'Date when the triggering event occurred that led to watch list placement.']
  trigger_event varchar [note: 'Specific event or incident that triggered the placement on the watch list, such as rating downgrade, controversy emergence, or policy violation.']
  un_global_compact_violation_flag boolean [note: 'Boolean flag indicating whether the entity has violated one or more of the UN Global Compact principles on human rights, labor, environment, or anti-corruption.']
  watch_list_category varchar [note: 'Primary category or reason for watch list placement: ESG rating deterioration, controversy, policy breach, regulatory violation, engagement escalation, or exclusion candidate.']
  watch_list_status varchar [note: 'Current lifecycle status of the watch list entry: active, under review, escalated, resolved, or closed.']
  created_by varchar [note: 'User identifier or system account that created the watch list record.']

  Note: 'Master record of issuers, funds, or managers placed on formal ESG watch or review status due to deteriorating ESG ratings, controversy escalation, or policy breaches.'
}

Table esg.responsible_investment_report {
  responsible_investment_report_id varchar [pk, note: 'Unique identifier for the responsible investment report record.']
  approved_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: RI reports are public disclosures requiring formal approval. Pension funds must document who approved annual responsible investment reports for governance and regulatory compliance.']
  composite_id varchar [note: 'Foreign key linking to performance.composite. Business justification: Responsible investment reports must reference specific composites for AUM coverage and ESG performance disclosure.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: RI reports align to ESG frameworks (PRI, TCFD, SFDR). The regulatory_framework STRING can be removed as the FK provides the authoritative link.']
  net_zero_commitment_id varchar [note: 'Foreign key linking to esg.net_zero_commitment. Business justification: RI reports disclose net zero commitment progress. The net_zero_commitment_flag and net_zero_target_year are report-specific values, the FK links to the commitment record.']
  superseded_report_responsible_investment_report_id varchar [note: 'Identifier of the previous report that this report supersedes or replaces, if applicable.']
  approval_date date [note: 'Date on which the responsible investment report was formally approved by the Investment Committee or Board.']
  asset_class_coverage varchar [note: 'Asset classes covered by the responsible investment report, such as public equities, private equity, real estate, infrastructure, fixed income.']
  assurance_level varchar [note: 'Level of external assurance obtained for the report, if applicable.']
  assurance_provider_name varchar [note: 'Name of the external assurance or audit provider, if applicable.']
  aum_covered decimal(20,2) [note: 'Total assets under management covered by the responsible investment report, in the reporting currency.']
  aum_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the AUM covered amount.']
  carbon_footprint_per_million_invested decimal(18,2) [note: 'Portfolio carbon footprint normalized per million units of currency invested, as disclosed in the report.']
  climate_action_summary varchar [note: 'Summary of climate-related actions, commitments, and progress during the reporting period.']
  created_timestamp timestamp [note: 'Timestamp when the responsible investment report record was first created in the system.']
  disclosure_level varchar [note: 'Classification of the report\'s disclosure level, determining who may access the document.']
  document_url varchar [note: 'Web address or file path where the published responsible investment report document is stored or accessible.']
  engagement_activity_summary varchar [note: 'Summary of stewardship and engagement activities undertaken with investee companies during the reporting period.']
  esg_integration_summary varchar [note: 'High-level narrative summary of how ESG factors are integrated into investment decision-making during the reporting period.']
  exclusion_criteria_summary varchar [note: 'Summary of exclusion criteria applied to investments during the reporting period.']
  exclusion_policy_applied_flag boolean [note: 'Indicates whether exclusion policies were applied during the reporting period.']
  external_assurance_obtained_flag boolean [note: 'Indicates whether the report has been externally assured or audited by a third party.']
  geographic_scope varchar [note: 'Geographic scope of the investments covered by the report, such as global, regional, or country-specific.']
  language varchar [note: 'Two-letter ISO 639-1 language code indicating the primary language of the report.']
  last_modified_by varchar [note: 'Identifier of the user or system that last modified the responsible investment report record.']
  last_modified_timestamp timestamp [note: 'Timestamp when the responsible investment report record was last modified.']
  net_zero_commitment_flag boolean [note: 'Indicates whether the fund has made a formal net zero emissions commitment as disclosed in the report.']
  net_zero_target_year varchar [note: 'Target year for achieving net zero emissions, if a commitment has been made.']
  next_publication_date date [note: 'Expected or scheduled date for the next responsible investment report publication.']
  notes varchar [note: 'Additional notes, comments, or context related to the responsible investment report.']
  prepared_by varchar [note: 'Name or identifier of the individual or team responsible for preparing the report.']
  pri_signatory_status varchar [note: 'Indicates whether the fund is a signatory to the UN Principles for Responsible Investment at the time of report publication.']
  proxy_voting_summary varchar [note: 'Summary of proxy voting activities and outcomes during the reporting period.']
  publication_date date [note: 'Date on which the responsible investment report was officially published to external stakeholders.']
  report_code varchar [note: 'Business identifier or reference code for the responsible investment report, used for external citation and tracking.']
  report_status varchar [note: 'Current lifecycle status of the responsible investment report.']
  report_title varchar [note: 'Full title of the responsible investment report as published.']
  report_type varchar [note: 'Classification of the responsible investment report by regulatory or stakeholder framework.']
  report_year varchar [note: 'Calendar or fiscal year to which the responsible investment report primarily relates.']
  reporting_period_end_date date [note: 'End date of the period covered by the responsible investment report.']
  reporting_period_start_date date [note: 'Start date of the period covered by the responsible investment report.']
  reviewed_by varchar [note: 'Name or identifier of the individual or committee that reviewed the report prior to approval.']
  sfdr_classification varchar [note: 'SFDR article classification applicable to the fund or mandate covered by the report.']
  submission_date date [note: 'Date on which the report was submitted to the relevant regulatory or industry body.']
  target_audience varchar [note: 'Primary intended audience for the responsible investment report.']
  tcfd_alignment_flag boolean [note: 'Indicates whether the report is aligned with TCFD recommendations.']
  total_ghg_emissions_tco2e decimal(18,2) [note: 'Total portfolio greenhouse gas emissions reported in the responsible investment report, measured in tonnes of CO2 equivalent.']
  version_number varchar [note: 'Version identifier for the report, used to track revisions and updates.']
  created_by varchar [note: 'Identifier of the user or system that created the responsible investment report record.']

  Note: 'Transactional record of formal responsible investment (RI) reports published by the fund for external stakeholders—beneficiaries, regulators, and the public.'
}

Table esg.pai_indicator {
  pai_indicator_id varchar [pk, note: 'Unique identifier for the PAI indicator record.']
  credit_issuer_id varchar [note: 'Unique identifier for the issuer associated with the PAI indicator.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: PAI (Principal Adverse Impact) indicators are mandated by the SFDR framework. Links PAI tracking to the governing framework.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: PAI (Principal Adverse Impact) indicators are SFDR-mandated metrics that must be disclosed. Each PAI measurement directly supports a specific SFDR disclosure filing.']
  created_timestamp timestamp [note: 'Timestamp when the PAI indicator record was created.']
  indicator_code varchar [note: 'Alphanumeric code identifying the specific PAI indicator.']
  indicator_description varchar [note: 'Detailed description of the PAI indicator\'s purpose and scope.']
  indicator_name varchar [note: 'Human-readable name of the PAI indicator.']
  indicator_pai_disclosure_date date [note: 'Date when the PAI indicator was disclosed to regulators or investors.']
  indicator_pai_disclosure_document_url varchar [note: 'URL to the official disclosure document for the PAI indicator.']
  indicator_pai_disclosure_notes varchar [note: 'Additional notes or comments regarding the PAI disclosure.']
  indicator_pai_disclosure_required boolean [note: 'Flag indicating if the PAI indicator requires disclosure under SFDR Article 7.']
  indicator_pai_disclosure_status varchar [note: 'Current status of the PAI disclosure process.']
  indicator_source varchar [note: 'Source of the indicator data (e.g., MSCI, Bloomberg).']
  indicator_source_date date [note: 'Date when the source data was published or updated.']
  indicator_source_version varchar [note: 'Version or release of the source data used for the indicator.']
  indicator_type varchar [note: 'Classification of the PAI indicator as environmental, social, or governance.']
  indicator_unit varchar [note: 'Unit of measurement for the indicator value (e.g., percentage, absolute).']
  indicator_value decimal(18,4) [note: 'Quantitative value of the PAI indicator for the reporting period.']
  pai_indicator_status varchar [note: 'Current lifecycle status of the PAI indicator record.']
  reporting_period_end_date date [note: 'End date of the reporting period for the PAI indicator.']
  reporting_period_start_date date [note: 'Start date of the reporting period for the PAI indicator.']
  updated_timestamp timestamp [note: 'Timestamp when the PAI indicator record was last updated.']

  Note: 'Transactional/reference record of Principal Adverse Impact (PAI) indicator values tracked per issuer and per reporting period under SFDR Article 7 and the PAI Statement.'
}

Table esg.taxonomy_alignment {
  taxonomy_alignment_id varchar [pk, note: 'Unique identifier for the taxonomy alignment record.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: EU Taxonomy alignment is tracked against the EU Taxonomy framework. The regulatory_alignment field is a status, not the framework reference.']
  holding_id varchar [note: 'Identifier of the holding associated with the alignment.']
  infra_asset_id varchar [note: 'Identifier of the asset associated with the alignment.']
  portfolio_id varchar [note: 'Identifier of the portfolio associated with the alignment.']
  activity_code varchar [note: 'Identifier for the specific economic activity.']
  activity_description varchar [note: 'Description of the economic activity.']
  alignment_end_date date [note: 'Date when the alignment ended or is scheduled to end.']
  alignment_percentage decimal(5,2) [note: 'Percentage of alignment to the taxonomy objective.']
  alignment_start_date date [note: 'Date when the alignment became effective.']
  alignment_status varchar [note: 'Current status of the alignment record.']
  alignment_type varchar [note: 'Type of investment alignment (direct, co-investment, fund).']
  audit_trail_flag boolean [note: 'Indicates if an audit trail exists for the record.']
  biodiversity_objective varchar [note: 'Biodiversity objective of the activity.']
  carbon_intensity_metric varchar [note: 'Metric used for carbon intensity measurement.']
  carbon_intensity_value decimal(10,2) [note: 'Value of carbon intensity for the activity.']
  circular_economy_objective varchar [note: 'Circular economy objective of the activity.']
  climate_objective varchar [note: 'Climate-related objective of the activity (e.g., mitigation, adaptation).']
  compliance_status varchar [note: 'Compliance status of the alignment record.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the activity location.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  data_quality_flag boolean [note: 'Flag indicating overall data quality status.']
  data_quality_score decimal(5,2) [note: 'Score indicating the quality of the data.']
  data_source varchar [note: 'Origin of the data (e.g., internal, external provider).']
  effective_date date [note: 'Date when the alignment record became effective.']
  eligible_capex_pct decimal(5,2) [note: 'Percentage of capital expenditure eligible under the taxonomy.']
  eligible_opex_pct decimal(5,2) [note: 'Percentage of operating expenditure eligible under the taxonomy.']
  eligible_revenue_pct decimal(5,2) [note: 'Percentage of revenue eligible under the taxonomy.']
  expiry_date date [note: 'Date when the alignment record expires.']
  gics_industry_code varchar [note: 'GICS industry code for the activity.']
  gics_sector_code varchar [note: 'GICS sector code for the activity.']
  last_modified_by varchar [note: 'User who last modified the record.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  net_zero_commitment_flag boolean [note: 'Indicates if the alignment includes a net zero commitment.']
  notes varchar [note: 'Free-text notes about the alignment record.']
  pollution_objective varchar [note: 'Pollution-related objective of the activity.']
  regulatory_alignment varchar [note: 'Regulatory framework aligned with the taxonomy record.']
  risk_assessment_flag boolean [note: 'Indicates if a risk assessment has been performed.']
  sector_classification varchar [note: 'Sector classification of the activity (e.g., GICS sector).']
  taxonomy_code varchar [note: 'Code identifying the EU Taxonomy activity.']
  taxonomy_eligibility_reason varchar [note: 'Reason for the eligibility status.']
  taxonomy_eligibility_status varchar [note: 'Eligibility status of the activity under the taxonomy.']
  taxonomy_name varchar [note: 'Human-readable name of the EU Taxonomy activity.']
  taxonomy_version varchar [note: 'Version of the EU Taxonomy used.']
  water_objective varchar [note: 'Water-related objective of the activity.']
  created_by varchar [note: 'User who created the record.']

  Note: 'Record of EU Taxonomy eligibility and alignment at the economic-activity / holding level. Captures environmental objective (climate mitigation, adaptation, water, circular economy, pollution, biodiversity), eligible revenue/capex/opex %, aligned %'
}

Table trade.order {
  order_id varchar [pk, note: 'Unique system identifier for the investment order record. Primary key for the order entity.']
  broker_id varchar [note: 'Reference to the external broker or dealer to whom the order was routed for execution. Links to counterparty entity.']
  custodian_id varchar [note: 'Foreign key linking to trade.custodian. Business justification: Orders specify which custodian will hold the securities. The existing custodian_code (BIGINT) appears to be an unlinked FK.']
  employee_id varchar [note: 'Reference to the portfolio manager or investment professional who originated the order. Links to employee or user entity.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Orders must reference governing ESG policy for compliance audit trail. Pension funds track which responsible investment policy applies to each order for breach detection, regulatory reporting']
  exclusion_list_id varchar [note: 'Foreign key linking to esg.exclusion_list. Business justification: Pre-trade compliance workflow: pension fund orders must be validated against ESG exclusion lists before execution.']
  instrument_id varchar [note: 'Reference to the security master record representing the instrument being traded. Links to security entity for ISIN, CUSIP, SEDOL, and pricing details.']
  natural_resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Trade order for a natural resource asset requires linking to the asset for trade reporting and regulatory compliance.']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Each trade order must be associated with the deal it executes; the pension fund’s trade execution reports and risk dashboards rely on this link.']
  order_employee_id varchar [note: 'Reference to the portfolio manager or investment professional who originated the order. Links to employee or user entity.']
  order_trader_employee_id varchar [note: 'Reference to the trader assigned to execute the order. May differ from portfolio manager. Links to employee or user entity.']
  parent_order_id varchar [note: 'Reference to the parent order if this is a child order resulting from order splitting or algorithmic slicing. Null for top-level orders.']
  portfolio_id varchar [note: 'Reference to the investment portfolio for which this order is placed. Links to the portfolio master entity.']
  security_instrument_id varchar [note: 'Reference to the security master record representing the instrument being traded. Links to security entity for ISIN, CUSIP, SEDOL, and pricing details.']
  trader_employee_id varchar [note: 'Reference to the trader assigned to execute the order. May differ from portfolio manager. Links to employee or user entity.']
  allocation_method varchar [note: 'Method for allocating fills across multiple portfolios when order is placed on behalf of multiple accounts: pro-rata, priority-based, manual, or average price.']
  approved_timestamp timestamp [note: 'Date and time when the order received final approval from compliance or investment committee. Null if approval not required or pending.']
  asset_class varchar [note: 'High-level classification of the security being traded: public equities, fixed income, foreign exchange, OTC derivatives, commodities, or alternative assets.']
  average_execution_price decimal(18,6) [note: 'Volume-weighted average price of all fills for this order. Calculated from execution records. Null until first fill occurs.']
  benchmark_index varchar [note: 'Reference benchmark index used for performance comparison and execution quality measurement (e.g., S&P 500, MSCI World, Bloomberg Barclays Aggregate).']
  cancellation_reason varchar [note: 'Explanation for why the order was cancelled. Null if order was not cancelled. Captures user-provided reason or system-generated cause.']
  commission_amount decimal(18,2) [note: 'Total brokerage commission charged for executing the order. Expressed in order currency. Null until execution occurs.']
  commission_basis_points decimal(8,2) [note: 'Commission rate expressed in basis points of notional value. One basis point equals 0.01%. Used for performance attribution and TCA.']
  completed_timestamp timestamp [note: 'Date and time when the order reached a terminal state (filled, cancelled, rejected, or expired). Null for active orders.']
  compliance_approved_flag boolean [note: 'Boolean indicator whether the order has passed pre-trade compliance checks (position limits, restricted lists, concentration rules). True if approved, False otherwise.']
  compliance_override_reason varchar [note: 'Explanation for any compliance rule override or exception granted for this order. Null if no override was required.']
  created_timestamp timestamp [note: 'System audit timestamp capturing when this order record was first inserted into the database. Distinct from order_timestamp which is the business event time.']
  currency varchar [note: 'Three-letter ISO 4217 currency code in which the order is denominated. Typically matches the trading currency of the security.']
  cusip varchar [note: '9-character alphanumeric identifier for North American securities. Denormalized from security master for operational convenience.']
  execution_strategy varchar [note: 'Algorithmic or manual execution approach specified for the order (e.g., VWAP, TWAP, Implementation Shortfall, Direct Market Access, High Touch).']
  execution_venue varchar [note: 'Name or code of the exchange, trading platform, or OTC venue where the order is to be executed (e.g., NYSE, NASDAQ, LSE, OTC).']
  expiry_date date [note: 'Date on which the order automatically expires if not filled. Applicable for GTD (Good Till Date) orders. Null for Day and GTC orders.']
  filled_quantity decimal(18,4) [note: 'Cumulative number of units executed to date. Updated as partial fills occur. Equals quantity when order is fully filled.']
  instructions varchar [note: 'Free-text field capturing special handling instructions, execution preferences, or notes from the portfolio manager to the trader or broker.']
  isin varchar [note: '12-character alphanumeric code uniquely identifying the security globally. Denormalized from security master for operational convenience.']
  limit_price decimal(18,6) [note: 'Maximum price for buy orders or minimum price for sell orders. Null for market orders. Expressed in order currency.']
  notional_value decimal(20,2) [note: 'Total market value of the order calculated as quantity multiplied by limit price (or market price for market orders). Expressed in order currency.']
  number varchar [note: 'Externally visible business identifier for the order, typically generated by the Order Management System (OMS). Used for operational tracking and communication with brokers.']
  order_date date [note: 'Business date on which the order was created by the portfolio manager. Distinct from order_timestamp which captures precise creation time.']
  order_status varchar [note: 'Current lifecycle state of the order in the order management workflow, from draft through execution to final settlement or cancellation. [ENUM-REF-CANDIDATE: draft|pending_approval|approved|submitted|partially_filled|filled|cancelled|rejected|expired — 9']
  order_type varchar [note: 'Classification of the order execution instruction: market order, limit order, stop order, algorithmic order types (VWAP, TWAP), or basket order. [ENUM-REF-CANDIDATE: market|limit|stop|stop_limit|iceberg|vwap|twap|peg|basket — 9 candidates stripped']
  quantity decimal(18,4) [note: 'Total number of units (shares, bonds, contracts) requested in the order. For fixed income, may represent par value or face amount.']
  rejection_reason varchar [note: 'Explanation for why the order was rejected by broker, exchange, or internal compliance. Null if order was not rejected.']
  remaining_quantity decimal(18,4) [note: 'Outstanding quantity yet to be executed. Calculated as quantity minus filled_quantity. Zero when order is complete.']
  sedol varchar [note: '7-character alphanumeric identifier for securities traded on the London Stock Exchange and other UK exchanges. Denormalized from security master.']
  settlement_currency varchar [note: 'Three-letter ISO 4217 currency code in which the trade will settle. May differ from order currency if FX conversion is required.']
  settlement_date date [note: 'Expected date for delivery versus payment (DVP) settlement. Typically T+2 for equities, T+1 for certain markets, or custom for OTC derivatives.']
  side varchar [note: 'Direction of the order: buy (long), sell, short sell, or cover (close short position).']
  stop_price decimal(18,6) [note: 'Trigger price for stop and stop-limit orders. Order becomes active when market reaches this level. Null for non-stop orders.']
  submitted_timestamp timestamp [note: 'Date and time when the order was submitted to the broker or execution venue. Null if order has not yet been submitted.']
  ticker_symbol varchar [note: 'Exchange-specific trading symbol for the security. Denormalized from security master for operational display and broker communication.']
  time_in_force varchar [note: 'Duration for which the order remains active: Day (expires end of trading day), GTC (Good Till Cancelled), IOC (Immediate or Cancel), FOK (Fill or Kill), GTD (Good Till Date), At Open, At Close.']
  timestamp timestamp [note: 'Precise date and time when the order was created in the OMS. Primary business event timestamp for order lifecycle tracking.']
  updated_timestamp timestamp [note: 'System audit timestamp capturing when this order record was last modified. Updated on every status change, fill, or attribute update.']

  Note: 'Core order management record representing an investment order originating from portfolio managers via Charles River IMS or Bloomberg AIM across all liquid asset classes (equities, fixed income, FX, OTC derivatives).'
}

Table trade.order_allocation {
  order_allocation_id varchar [pk, note: 'Unique identifier for the order allocation record.']
  allocation_group_id varchar [note: 'Grouping identifier for allocations that are part of the same allocation batch or block trade split.']
  broker_id varchar [note: 'Broker or executing counterparty assigned to this allocation.']
  cash_account_id varchar [note: 'Target account or sub-mandate receiving this allocation.']
  clearing_house_id varchar [note: 'Central Counterparty (CCP) or clearing house used for this allocation, applicable for exchange-traded and cleared Over-The-Counter (OTC) derivatives.']
  custodian_id varchar [note: 'Foreign key linking to trade.custodian. Business justification: Order allocations specify which custodian will hold the allocated securities. The existing custodian_code (BIGINT) appears to be an unlinked FK.']
  employee_id varchar [note: 'Internal trader or portfolio manager who authorized or executed the allocation instruction.']
  order_id varchar [note: 'Reference to the parent order being allocated across portfolios or accounts.']
  portfolio_id varchar [note: 'Target portfolio receiving this allocation of the parent order.']
  standing_settlement_instruction_id varchar [note: 'Reference to the Standard Settlement Instructions (SSI) used for Delivery Versus Payment (DVP) settlement of this allocation.']
  trader_employee_id varchar [note: 'Internal trader or portfolio manager who authorized or executed the allocation instruction.']
  accrued_interest decimal(18,2) [note: 'Accrued interest amount for fixed income allocations, calculated from the last coupon date to the settlement date.']
  allocated_notional decimal(20,2) [note: 'Notional value of the allocation in the trade currency, calculated as allocated quantity multiplied by execution price.']
  allocated_quantity decimal(18,4) [note: 'Number of units or shares allocated to this portfolio or account from the parent order.']
  allocation_instruction_type varchar [note: 'Method by which the allocation was determined: automatic system allocation, manual trader instruction, model-driven, or pro-rata distribution.']
  allocation_number varchar [note: 'Business identifier for the allocation, typically generated by the Order Management System (OMS).']
  allocation_percentage decimal(5,2) [note: 'Percentage of the parent order allocated to this portfolio or account, expressed as a decimal (e.g., 25.50 for 25.5%).']
  allocation_reason varchar [note: 'Business rationale or comment explaining the allocation decision, particularly for manual or non-standard allocations.']
  allocation_status varchar [note: 'Current lifecycle status of the allocation in the settlement workflow.']
  allocation_timestamp timestamp [note: 'Date and time when the allocation was created or confirmed by the Order Management System (OMS).']
  allocation_type varchar [note: 'Classification of the allocation method or instruction type per FIX AllocType field.']
  allocation_version varchar [note: 'Version number of the allocation record, incremented when amendments or corrections are made post-confirmation.']
  average_price decimal(18,6) [note: 'Average price at which the allocated quantity was executed, used for settlement and performance attribution.']
  commission_amount decimal(18,2) [note: 'Brokerage commission charged for this allocation, expressed in the trade currency.']
  confirmation_timestamp timestamp [note: 'Date and time when the allocation was confirmed by the broker or counterparty.']
  created_timestamp timestamp [note: 'Date and time when this allocation record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the allocated notional and price.']
  fx_rate decimal(12,6) [note: 'Foreign Exchange (FX) rate applied when converting trade currency to settlement currency, if applicable.']
  modified_by varchar [note: 'User identifier or system process that last modified this allocation record.']
  modified_timestamp timestamp [note: 'Date and time when this allocation record was last modified or updated.']
  net_amount decimal(20,2) [note: 'Net amount payable or receivable after deducting commissions, fees, and taxes from the gross settlement amount.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this allocation requires regulatory reporting under MiFID II, EMIR, or other jurisdictional requirements.']
  rejection_reason varchar [note: 'Explanation provided when an allocation is rejected by the broker, custodian, or compliance system.']
  settlement_amount decimal(20,2) [note: 'Total amount due for settlement in the settlement currency, including principal and any adjustments.']
  settlement_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which settlement will occur, may differ from trade currency due to Foreign Exchange (FX) conversion.']
  settlement_date date [note: 'Expected settlement date for this allocation, typically Trade Date plus two business days (T+2) for equities.']
  settlement_method varchar [note: 'Settlement mechanism: Delivery Versus Payment (DVP), Free Of Payment (FOP), Delivery Against Payment (DAP), or Receive Versus Payment (RVP).']
  settlement_status varchar [note: 'Current status of the settlement process for this allocation.']
  tax_amount decimal(18,2) [note: 'Total tax amount applicable to this allocation, including transaction taxes, stamp duty, or withholding tax.']
  trade_date date [note: 'Date on which the parent order was executed, used as the reference for settlement date calculation.']
  created_by varchar [note: 'User identifier or system process that created this allocation record.']

  Note: 'Broker and account allocation record that splits a parent order across multiple portfolios, accounts, or sub-mandates. Captures the allocation quantity, allocated notional, target portfolio, allocation percentage, allocation status, and the broker or'
}

Table trade.execution {
  execution_id varchar [pk, note: 'Unique identifier for the trade execution event. Primary key.']
  broker_id varchar [note: 'Reference to the broker or counterparty that executed the trade.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: OTC executions require counterparty identification for exposure calculation and collateral management.']
  execution_venue_id varchar [note: 'Foreign key linking to trade.execution_venue. Business justification: Trade executions occur at specific execution venues. The existing venue and venue_mic_code are string identifiers but there is no FK to the execution_venue master table.']
  instrument_id varchar [note: 'Reference to the financial instrument that was executed.']
  natural_resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Execution records must reference the natural resource asset for accurate trade reporting and settlement reconciliation.']
  order_id varchar [note: 'Reference to the parent order that generated this execution.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this execution is allocated.']
  strategy_id varchar [note: 'Reference to the investment strategy driving this execution.']
  accrued_interest decimal(18,2) [note: 'Interest accrued on fixed income instruments from last coupon date to execution date.']
  algorithm varchar [note: 'Name or identifier of the algorithmic trading strategy used for execution.']
  asset_class varchar [note: 'High-level classification of the asset class for the executed instrument.']
  average_price_flag boolean [note: 'Indicates whether this execution is part of an average price order.']
  benchmark_price decimal(18,6) [note: 'Reference benchmark price used for execution quality analysis.']
  bloomberg_ticker varchar [note: 'Bloomberg ticker symbol for the executed instrument.']
  capacity varchar [note: 'Capacity in which the broker executed the trade.']
  clearing_house varchar [note: 'Name or identifier of the central counterparty clearing house.']
  commission_amount decimal(18,2) [note: 'Broker commission charged for this execution.']
  commission_currency varchar [note: 'Three-letter ISO currency code for the commission amount.']
  confirmation_received_timestamp timestamp [note: 'Date and time when trade confirmation was received from the broker or venue.']
  created_timestamp timestamp [note: 'Date and time when this execution record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for the execution value and price.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  dvp_indicator boolean [note: 'Indicates whether the execution will settle on a delivery versus payment basis.']
  executed_price decimal(18,6) [note: 'Price per unit at which the execution occurred.']
  executed_quantity decimal(18,4) [note: 'Number of units or shares executed in this fill event.']
  executing_trader varchar [note: 'Name or identifier of the trader who executed the order.']
  execution_status varchar [note: 'Current lifecycle status of the execution event.']
  execution_type varchar [note: 'Classification of the execution event type per FIX protocol standards. [ENUM-REF-CANDIDATE: new|partial_fill|fill|cancelled|replaced|pending_cancel|rejected — 7 candidates stripped; promote to reference product]']
  isin varchar [note: 'Twelve-character alphanumeric code uniquely identifying the security.']
  last_market_flag boolean [note: 'Indicates whether this is the final execution for the parent order.']
  liquidity_indicator varchar [note: 'Indicates whether the execution added or removed liquidity from the market.']
  modified_timestamp timestamp [note: 'Date and time when this execution record was last modified.']
  net_settlement_amount decimal(20,2) [note: 'Net amount payable or receivable after commissions and fees.']
  notes varchar [note: 'Free-text notes or comments regarding the execution event.']
  price_deviation_bps decimal(10,2) [note: 'Deviation of executed price from benchmark price expressed in basis points.']
  reference varchar [note: 'External execution reference number assigned by the execution venue or broker.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange.']
  settlement_cycle varchar [note: 'Number of business days between trade date and settlement date.']
  settlement_date date [note: 'Expected date when the trade will settle and ownership transfers.']
  side varchar [note: 'Indicates whether the execution was a buy or sell transaction.']
  timestamp timestamp [note: 'Precise date and time when the trade was executed in the market.']
  trade_reporting_indicator varchar [note: 'Status of regulatory trade reporting for this execution.']
  value decimal(20,2) [note: 'Total gross value of the execution calculated as executed quantity multiplied by executed price.']
  venue varchar [note: 'Name or code of the exchange, ECN, or trading venue where the execution occurred.']
  venue_mic_code varchar [note: 'ISO 10383 four-character Market Identifier Code for the execution venue.']

  Note: 'Trade execution record capturing the actual fill details from the market or execution venue. Represents a single execution event against a parent order, including executed price, executed quantity, execution timestamp, execution venue (exchange, ECN'
}

Table trade.blotter {
  blotter_id varchar [pk, note: 'Unique identifier for the trade blotter record. Primary key for the consolidated intraday trade register.']
  broker_id varchar [note: 'Identifier of the executing broker or dealer who facilitated the trade. Links to counterparty master data.']
  counterparty_id varchar [note: 'Identifier of the trade counterparty. For exchange-traded securities, may be the central counterparty (CCP); for OTC, the bilateral counterparty.']
  custodian_id varchar [note: 'Identifier of the custodian bank holding the securities. Links to Standard Settlement Instructions (SSI).']
  employee_id varchar [note: 'Identifier of the internal portfolio manager or trader who initiated the order. Used for performance attribution and compliance monitoring.']
  execution_id varchar [note: 'Unique business identifier for the executed trade. Externally-known trade reference number assigned by the Order Management System (OMS).']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Co-investment trade attribution: When pension fund executes co-investments alongside GPs, blotter must track originating manager for performance attribution, co-invest utilization']
  instrument_id varchar [note: 'Internal identifier of the security instrument traded. Links to master security reference data.']
  natural_resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Blotter entries need the asset reference for settlement processing and regulatory audit trails.']
  order_id varchar [note: 'Reference to the parent order that generated this trade execution. Links trade to originating investment decision.']
  performance_benchmark_id varchar [note: 'Identifier of the performance benchmark against which this trade will be measured. Used for performance attribution analysis.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio to which this trade belongs. Links trade to asset allocation strategy.']
  strategy_id varchar [note: 'Identifier of the investment strategy or mandate under which the trade was executed. Links to Strategic Asset Allocation (SAA) or Tactical Asset Allocation (TAA).']
  trader_employee_id varchar [note: 'Identifier of the internal portfolio manager or trader who initiated the order. Used for performance attribution and compliance monitoring.']
  accrued_interest decimal(18,2) [note: 'Interest accrued on fixed income securities from last coupon payment to trade date. Paid by buyer to seller.']
  allocation_status varchar [note: 'Status of trade allocation to underlying portfolios. Block trades may be allocated across multiple portfolios.']
  asset_class varchar [note: 'High-level classification of the traded instrument type. Determines settlement and valuation treatment.']
  broker_lei varchar [note: 'ISO 17442 standard 20-character alphanumeric code uniquely identifying the broker legal entity globally.']
  capacity varchar [note: 'Capacity in which the broker executed the trade. Principal means broker traded from own inventory; agency means broker acted as agent.']
  commission decimal(18,2) [note: 'Brokerage commission charged for executing the trade. Paid to the executing broker.']
  compliance_rule_breached varchar [note: 'Identifier of the compliance rule that was breached, if any. Used for exception reporting and audit trail.']
  compliance_status varchar [note: 'Pre-trade and post-trade compliance check result. Indicates whether trade complies with investment guidelines and regulatory limits.']
  created_timestamp timestamp [note: 'Timestamp when the blotter record was first created in the Investment Book of Record (IBOR). Audit trail for data lineage.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities. Used for US and national instruments.']
  custodian_account varchar [note: 'Account number at the custodian bank where securities will be settled. Part of Standard Settlement Instructions (SSI).']
  execution_type varchar [note: 'Method by which the trade was executed. Indicates the execution channel and strategy used.']
  execution_venue varchar [note: 'Market or trading venue where the trade was executed. Examples: NYSE, NASDAQ, LSE, OTC, internal crossing network.']
  fees decimal(18,2) [note: 'Additional fees associated with the trade execution. Includes exchange fees, clearing fees, and regulatory fees.']
  fx_rate decimal(18,8) [note: 'Exchange rate applied for cross-currency trades. Converts price currency to settlement currency.']
  gross_amount decimal(18,2) [note: 'Total trade value before fees, commissions, and taxes. Calculated as quantity multiplied by price.']
  instrument_type varchar [note: 'Detailed classification of the security instrument. Examples: common stock, corporate bond, government bond, FX spot, FX forward, interest rate swap, credit default swap.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the security globally.']
  mic_code varchar [note: 'ISO 10383 standard 4-character code identifying the exchange or trading venue.']
  modified_timestamp timestamp [note: 'Timestamp when the blotter record was last updated. Tracks amendments, corrections, and status changes.']
  net_amount decimal(18,2) [note: 'Total settlement amount after all fees, commissions, and taxes. Amount that will be debited or credited to the portfolio cash account.']
  price decimal(18,6) [note: 'Execution price per unit of the security. For bonds, may be expressed as percentage of par; for equities, price per share.']
  price_currency varchar [note: 'ISO 4217 three-letter currency code in which the trade price is denominated.']
  quantity decimal(18,4) [note: 'Number of units or nominal amount of the security traded. For bonds, represents face value; for equities, represents share count.']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  settlement_currency varchar [note: 'ISO 4217 three-letter currency code in which the trade will settle. May differ from price currency for cross-currency trades.']
  settlement_date date [note: 'Date on which the trade will settle and cash and securities will be exchanged. Typically T+2 for equities.']
  settlement_method varchar [note: 'Settlement instruction type. DVP (Delivery Versus Payment) is standard for most trades; RVP (Receive Versus Payment) for purchases; FOP (Free Of Payment) for transfers.']
  side varchar [note: 'Direction of the trade from the fund perspective. Buy increases position, sell decreases position.']
  tax_amount decimal(18,2) [note: 'Transaction taxes levied on the trade. Includes stamp duty, financial transaction tax, and other applicable taxes.']
  ticker varchar [note: 'Exchange-specific ticker symbol for the traded security. Human-readable market identifier.']
  trade_confirmation_number varchar [note: 'Confirmation reference number provided by the broker or counterparty. Used for trade matching and reconciliation.']
  trade_date date [note: 'Date on which the trade was executed in the market. T in T+2 settlement convention.']
  trade_notes varchar [note: 'Free-text notes or comments about the trade. Captures trader rationale, special instructions, or execution commentary.']
  trade_status varchar [note: 'Current lifecycle state of the trade in the settlement workflow. Tracks progression from execution to final settlement.']
  trade_timestamp timestamp [note: 'Precise date and time when the trade was executed. Includes timezone for global trading operations.']

  Note: 'Consolidated intraday trade blotter record aggregating all executed trades across asset classes for a given trading day. Serves as the authoritative daily trade register for the investment book of record (IBOR).'
}

Table trade.settlement_instruction {
  settlement_instruction_id varchar [pk, note: 'Unique identifier for the settlement instruction record.']
  blotter_id varchar [note: 'Reference to the trade that this settlement instruction governs.']
  execution_id varchar [note: 'Reference to the trade that this settlement instruction governs.']
  standing_settlement_instruction_id varchar [note: 'Reference to the counterparty\'s standard settlement instructions, containing their delivery and payment details.']
  accrued_interest decimal(18,2) [note: 'Amount of accrued interest to be settled along with the principal for fixed income securities.']
  affirmation_status varchar [note: 'Status indicating whether the institutional investor has affirmed the trade details with the broker or custodian.']
  affirmation_timestamp timestamp [note: 'Date and time when the trade was affirmed by the institutional investor.']
  cancellation_reason varchar [note: 'Explanation for why the settlement instruction was cancelled, if applicable.']
  ccp_clearing_member varchar [note: 'Name of the clearing member through which the trade is cleared at the CCP.']
  ccp_name varchar [note: 'Name of the central counterparty clearing house if the trade is centrally cleared (e.g., LCH, CME Clearing).']
  counterparty_account_number varchar [note: 'The account number at the counterparty\'s custodian or depository where securities or cash will be delivered or received.']
  counterparty_custodian_bic varchar [note: 'ISO 9362 Bank Identifier Code (SWIFT code) of the counterparty\'s custodian institution.']
  custodian_account_number varchar [note: 'The account number at the custodian bank where the securities or cash will be delivered or received.']
  custodian_bic varchar [note: 'ISO 9362 Bank Identifier Code (SWIFT code) of the custodian institution.']
  custodian_name varchar [note: 'Name of the custodian bank or financial institution responsible for holding and settling the securities.']
  depository_code varchar [note: 'Standard code identifying the central securities depository or clearing system.']
  depository_name varchar [note: 'Name of the central securities depository or clearing system where the securities are held (e.g., DTC, Euroclear, Clearstream).']
  failure_code varchar [note: 'Standardized code representing the category of settlement failure.']
  failure_reason varchar [note: 'Description of the reason for settlement failure if the instruction status is failed (e.g., insufficient securities, account mismatch, counterparty rejection).']
  instruction_generation_timestamp timestamp [note: 'Date and time when the settlement instruction was generated by the order management or portfolio management system.']
  instruction_reference varchar [note: 'External reference number or identifier for the settlement instruction, used for reconciliation and communication with counterparties and custodians.']
  instruction_sent_timestamp timestamp [note: 'Date and time when the settlement instruction was transmitted to the custodian or depository.']
  instruction_status varchar [note: 'Current lifecycle status of the settlement instruction in the settlement workflow.']
  instruction_type varchar [note: 'Indicates whether this instruction is for delivery of securities, receipt of securities, payment of cash, or receipt of cash.']
  last_modified_timestamp timestamp [note: 'Date and time when the settlement instruction record was last updated.']
  matching_status varchar [note: 'Status indicating whether the settlement instruction has been matched with the counterparty\'s instruction.']
  modified_by varchar [note: 'Identifier of the user or system that last modified the settlement instruction record.']
  net_settlement_amount decimal(18,2) [note: 'Net amount to be settled after accounting for accrued interest, fees, and any other adjustments.']
  partial_settlement_allowed boolean [note: 'Indicates whether partial settlement of the instruction is permitted if the full quantity is not available.']
  place_of_settlement varchar [note: 'Three-letter ISO 3166 country code indicating the jurisdiction where settlement occurs.']
  quantity decimal(18,4) [note: 'The number of units or nominal amount of the security to be settled.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this settlement instruction requires regulatory reporting under MiFID II, EMIR, or other jurisdictional requirements.']
  security_identifier varchar [note: 'Primary identifier for the security being settled, typically ISIN, CUSIP, or SEDOL.']
  security_identifier_type varchar [note: 'Type of security identifier used (ISIN, CUSIP, SEDOL, or TICKER).']
  settlement_amount decimal(18,2) [note: 'The total monetary amount to be settled, including principal and any accrued interest or fees, denominated in the settlement currency.']
  settlement_currency varchar [note: 'Three-letter ISO 4217 currency code in which the settlement payment will be made.']
  settlement_date date [note: 'The contractual date on which the settlement of the trade is scheduled to occur, typically T+2 for equities or as per asset class convention.']
  settlement_fees decimal(18,2) [note: 'Total fees charged by custodians, depositories, or clearing systems for processing the settlement.']
  settlement_method varchar [note: 'Method governing the delivery and payment mechanics. DVP (Delivery Versus Payment) ensures simultaneous exchange of securities and cash; RVP (Receive Versus Payment) for receipt side; FOP (Free of Payment) for securities transfer without payment; DFP']
  settlement_priority varchar [note: 'Priority level assigned to the settlement instruction for processing by custodians and clearing systems.']
  settlement_timestamp timestamp [note: 'Date and time when the settlement was actually completed and confirmed by the depository or custodian.']
  settlement_type varchar [note: 'Classification of the settlement cycle: regular (T+2), cash (T+0), next day (T+1), or seller option (custom date).']
  trade_confirmation_reference varchar [note: 'Reference number from the trade confirmation document linking this settlement instruction to the original trade.']
  created_by varchar [note: 'Identifier of the user or system that created the settlement instruction record.']

  Note: 'Settlement instruction record governing the delivery and payment mechanics for a trade. Captures settlement date (T+2 standard or contractual), settlement method (DVP, FOP, DFP), settlement currency, custodian account, depository (DTC, Euroclear'
}

Table trade.settlement_fail {
  settlement_fail_id varchar [pk, note: 'Unique identifier for the settlement failure event record.']
  blotter_id varchar [note: 'Reference to the underlying trade that failed to settle.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Settlement fails must be tracked by counterparty for CSDR penalty regime compliance and credit risk monitoring.']
  execution_id varchar [note: 'Reference to the underlying trade that failed to settle.']
  actual_settlement_date date [note: 'The date on which the trade ultimately settled successfully, resolving the fail.']
  assigned_to varchar [note: 'Name or identifier of the operations team member or desk responsible for resolving the settlement failure.']
  buy_in_execution_date date [note: 'Date on which a buy-in transaction was executed in the market to cover the failed settlement.']
  buy_in_notice_date date [note: 'Date on which a formal buy-in notice was issued to the failing party under CSDR mandatory buy-in rules.']
  buy_in_risk_flag boolean [note: 'Indicates whether the settlement failure has reached a threshold that triggers buy-in risk under CSDR or contractual terms.']
  clearing_system varchar [note: 'Name of the central securities depository or clearing system where the settlement failure occurred.']
  created_timestamp timestamp [note: 'System timestamp when this settlement failure record was first created in the lakehouse.']
  custodian_bic varchar [note: 'ISO 9362 Bank Identifier Code of the custodian bank handling settlement for this trade.']
  dvp_model varchar [note: 'The DVP settlement model applicable to this trade as defined by the Bank for International Settlements.']
  escalation_date date [note: 'Date on which the settlement failure was escalated to a higher management or operational tier.']
  escalation_level varchar [note: 'Current escalation tier within the organization for managing and resolving the settlement failure.']
  expected_settlement_date date [note: 'The original contractual settlement date per the trade terms, typically Trade Date plus two (T+2).']
  fail_amount decimal(18,2) [note: 'Monetary value of the securities that failed to settle, in the trade currency.']
  fail_currency varchar [note: 'ISO 4217 three-letter currency code for the monetary value of the failed settlement.']
  fail_date date [note: 'The contractual settlement date on which the trade failed to settle as expected.']
  fail_detected_timestamp timestamp [note: 'System timestamp when the settlement failure was first identified and recorded in the operations system.']
  fail_duration_days varchar [note: 'Number of business days the settlement has been outstanding since the original fail date.']
  fail_party_type varchar [note: 'Classification of the party responsible for or contributing to the settlement failure.']
  fail_quantity decimal(18,4) [note: 'Number of units or shares that failed to settle on the contractual settlement date.']
  fail_reason_code varchar [note: 'Standardized code indicating the root cause of the settlement failure.']
  fail_reason_description varchar [note: 'Detailed narrative explanation of the circumstances that caused the settlement failure.']
  fail_reference_number varchar [note: 'External reference number assigned by custodian or clearing system to track the settlement failure.']
  fail_side varchar [note: 'Indicates whether the failure occurred on the buy side or sell side of the transaction.']
  fail_status varchar [note: 'Current lifecycle status of the settlement failure event.']
  penalty_amount decimal(18,2) [note: 'Monetary penalty assessed under CSDR mandatory cash penalties regime for late settlement.']
  penalty_currency varchar [note: 'ISO 4217 three-letter currency code for the settlement failure penalty amount.']
  regulatory_report_date date [note: 'Date on which the settlement failure was reported to the relevant regulatory authority.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this settlement failure must be reported to regulatory authorities under CSDR or other regimes.']
  resolution_action varchar [note: 'Description of the corrective action taken or planned to resolve the settlement failure.']
  revised_settlement_date date [note: 'Updated target settlement date negotiated or projected after the initial failure.']
  security_cusip varchar [note: 'CUSIP identifier for North American securities involved in the failed settlement.']
  security_isin varchar [note: 'ISO 6166 International Securities Identification Number of the security that failed to settle.']
  security_sedol varchar [note: 'SEDOL identifier for securities traded on UK and Irish exchanges involved in the failed settlement.']
  ssi_correction_date date [note: 'Date on which corrected Standard Settlement Instructions were provided to resolve the mismatch.']
  ssi_mismatch_flag boolean [note: 'Indicates whether the failure was caused by a mismatch in Standard Settlement Instructions between counterparties.']
  updated_timestamp timestamp [note: 'System timestamp when this settlement failure record was last modified.']

  Note: 'Record of a settlement failure event where a trade did not settle on the contractual settlement date. Captures fail date, fail reason code (insufficient securities, cash shortfall, counterparty fail, SSI mismatch), fail duration in days, buy-in risk flag'
}

Table trade.confirmation {
  confirmation_id varchar [pk, note: 'Unique identifier for the trade confirmation record.']
  broker_id varchar [note: 'Reference to the broker or intermediary involved in the trade execution and confirmation process.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Trade confirmations are exchanged with counterparties. Linking enables confirmation matching, dispute resolution, and regulatory reporting. Essential for T+1 settlement compliance.']
  execution_id varchar [note: 'Reference to the trade execution that this confirmation validates.']
  instrument_id varchar [note: 'Internal reference to the financial instrument being confirmed.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or fund to which this trade is allocated.']
  strategy_id varchar [note: 'Reference to the investment strategy under which this trade was executed.']
  accrued_interest decimal(20,2) [note: 'Interest accrued on fixed income securities from the last coupon payment date to the trade date, confirmed by counterparty.']
  affirmation_timestamp timestamp [note: 'Date and time when the confirmation was affirmed by both parties, indicating bilateral agreement on trade economics.']
  asset_class varchar [note: 'High-level classification of the financial instrument being confirmed.']
  capacity varchar [note: 'Capacity in which the counterparty acted in the trade: principal, agent, or riskless principal.']
  clearing_house varchar [note: 'Name of the Central Counterparty (CCP) or clearing house responsible for clearing and settlement of the trade.']
  clearing_house_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the clearing house or CCP.']
  commission_amount decimal(20,2) [note: 'Commission charged by the broker or intermediary, as confirmed in the trade confirmation.']
  confirmation_status varchar [note: 'Current lifecycle status of the trade confirmation indicating matching and affirmation state. [ENUM-REF-CANDIDATE: unconfirmed|matched|mismatched|affirmed|pending_affirmation|cancelled|rejected — 7 candidates stripped; promote to reference product]']
  confirmation_type varchar [note: 'Method by which the confirmation was received or transmitted, such as electronic via SWIFT or FIX, verbal, or written.']
  confirmed_price decimal(20,8) [note: 'Price per unit confirmed by the counterparty, used for matching against executed price.']
  confirmed_quantity decimal(20,6) [note: 'Quantity of the instrument confirmed by the counterparty, used for matching against executed quantity.']
  confirmed_settlement_amount decimal(20,2) [note: 'Net settlement amount confirmed by the counterparty, including adjustments for accrued interest, commissions, and fees.']
  confirmed_trade_value decimal(20,2) [note: 'Total trade value confirmed by the counterparty, calculated as confirmed quantity multiplied by confirmed price.']
  counterparty_confirmation_number varchar [note: 'Confirmation reference number assigned by the counterparty for cross-referencing and reconciliation purposes.']
  created_timestamp timestamp [note: 'Date and time when this confirmation record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the trade value and settlement.']
  cusip varchar [note: 'CUSIP identifier for North American securities.']
  dvp_indicator boolean [note: 'Flag indicating whether the trade will settle on a Delivery Versus Payment basis, ensuring simultaneous exchange of securities and cash.']
  exception_notes varchar [note: 'Free-text notes documenting any exceptions, manual interventions, or special handling required for this confirmation.']
  fix_message_type varchar [note: 'FIX protocol message type used for electronic confirmation, such as ExecutionReport or AllocationReport.']
  isin varchar [note: 'ISO 6166 International Securities Identification Number uniquely identifying the security.']
  matched_by varchar [note: 'User or system that performed the confirmation matching and affirmation process.']
  matched_timestamp timestamp [note: 'Date and time when the confirmation was successfully matched against internal execution records.']
  matching_status varchar [note: 'Status of the confirmation matching process between internal trade records and counterparty confirmation details.']
  mismatch_reason varchar [note: 'Description of any discrepancies between internal execution records and counterparty confirmation, such as quantity, price, or settlement date mismatches.']
  number varchar [note: 'External business identifier for the confirmation, typically assigned by the counterparty or matching system.']
  sedol varchar [note: 'SEDOL identifier for securities traded on the London Stock Exchange and other UK markets.']
  settlement_cycle varchar [note: 'Standard settlement cycle for the trade, indicating the number of business days between trade date and settlement date.']
  settlement_date date [note: 'Date on which the trade is scheduled to settle, as confirmed by the counterparty.']
  source varchar [note: 'System or platform from which the confirmation was received, such as Bloomberg AIM, Charles River IMS, or direct counterparty system.']
  ssi_reference varchar [note: 'Reference to the Standard Settlement Instructions used for this trade, defining payment and delivery details.']
  swift_message_type varchar [note: 'SWIFT message type used for electronic confirmation transmission, such as MT515 for client confirmation or MT518 for market-side confirmation.']
  timestamp timestamp [note: 'Date and time when the confirmation was received or generated, representing the principal business event for this record.']
  trade_date date [note: 'Date on which the trade was executed, as confirmed by the counterparty.']
  trade_reporting_indicator boolean [note: 'Flag indicating whether this trade requires regulatory reporting under MiFID II, EMIR, or other trade reporting regimes.']
  trade_side varchar [note: 'Indicates whether the pension fund is buying or selling the instrument in this trade.']
  updated_timestamp timestamp [note: 'Date and time when this confirmation record was last modified.']

  Note: 'Trade confirmation record representing the bilateral agreement between the pension fund and its counterparty confirming trade economics. Captures confirmation type (electronic via SWIFT/FIX, verbal, written), confirmation status (unconfirmed, matched'
}

Table trade.instrument {
  instrument_id varchar [pk, note: 'Unique identifier for the financial instrument. Primary key.']
  underlying_instrument_id varchar [note: 'Reference to the underlying instrument for derivatives. Links to another instrument record.']
  active_flag boolean [note: 'Boolean indicator of whether the instrument record is currently active in the system.']
  asset_class varchar [note: 'High-level classification of the instrument into major asset categories.']
  bloomberg_ticker varchar [note: 'Bloomberg proprietary ticker symbol used for market data and trade execution via Bloomberg Terminal.']
  callable_flag boolean [note: 'Boolean indicator of whether the issuer has the right to redeem the instrument before maturity.']
  cfi_code varchar [note: '6-character ISO 10962 code classifying the instrument by category, group, and attributes.']
  contract_size decimal(18,4) [note: 'Notional size or multiplier for derivative contracts (e.g., number of shares per option contract).']
  convertible_flag boolean [note: 'Boolean indicator of whether the instrument can be converted into another security (typically equity).']
  country_of_issue varchar [note: '3-letter ISO 3166 country code representing the jurisdiction where the instrument was issued.']
  coupon_frequency varchar [note: 'Frequency at which coupon payments are made for fixed income instruments.']
  coupon_rate decimal(10,6) [note: 'Annual interest rate paid by fixed income instruments, expressed as a decimal (e.g., 0.0325 for 3.25%).']
  credit_rating varchar [note: 'Current credit rating assigned to the instrument by a recognized rating agency (e.g., AAA, BB+, Caa1).']
  currency_code varchar [note: '3-letter ISO 4217 currency code representing the denomination currency of the instrument.']
  cusip varchar [note: '9-character alphanumeric code identifying North American securities.']
  delisting_date date [note: 'Date on which the instrument was removed from exchange listing. Null if still listed.']
  effective_date date [note: 'Date from which this instrument record is effective for trading and portfolio management.']
  esg_rating varchar [note: 'ESG rating or score assigned to the instrument or issuer by a recognized ESG rating provider.']
  exchange_code varchar [note: 'Code identifying the primary exchange or trading venue where the instrument is listed.']
  exercise_style varchar [note: 'Style of option exercise: American (any time), European (expiry only), or Bermudan (specific dates).']
  face_value decimal(20,2) [note: 'Nominal or par value of the instrument at issuance, typically for fixed income securities.']
  figi varchar [note: '12-character alphanumeric code providing a universal identifier for financial instruments per Bloomberg Open Symbology.']
  green_bond_flag boolean [note: 'Boolean indicator of whether the instrument is certified as a green bond under recognized standards.']
  instrument_name varchar [note: 'Full legal or common name of the financial instrument as recognized in the market.']
  instrument_type varchar [note: 'Detailed classification of the instrument within its asset class (e.g., common stock, corporate bond, interest rate swap, FX forward).']
  investment_grade_flag boolean [note: 'Boolean indicator of whether the instrument is rated investment grade (BBB-/Baa3 or higher) by major rating agencies.']
  isin varchar [note: '12-character alphanumeric code uniquely identifying the security globally per ISO 6166 standard.']
  issue_date date [note: 'Date on which the instrument was originally issued or created.']
  issuer_lei varchar [note: '20-character ISO 17442 code uniquely identifying the issuing legal entity.']
  issuer_name varchar [note: 'Legal name of the entity that issued the instrument.']
  listing_date date [note: 'Date on which the instrument was first listed on an exchange for public trading.']
  lot_size decimal(18,4) [note: 'Minimum tradeable quantity or contract size for the instrument.']
  maturity_date date [note: 'Date on which the instrument matures or expires. Null for perpetual instruments.']
  mic_code varchar [note: '4-character ISO 10383 code identifying the exchange or trading venue.']
  option_type varchar [note: 'Type of option contract: call (right to buy) or put (right to sell).']
  puttable_flag boolean [note: 'Boolean indicator of whether the holder has the right to sell the instrument back to the issuer before maturity.']
  rating_agency varchar [note: 'Name of the credit rating agency that assigned the credit rating (e.g., S&P, Moody\'s, Fitch).']
  reuters_ric varchar [note: 'Reuters proprietary instrument code used for market data and analytics.']
  sector_classification varchar [note: 'Industry sector classification of the issuer or underlying entity per GICS, ICB, or similar taxonomy.']
  sedol varchar [note: '7-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  settlement_cycle varchar [note: 'Standard settlement period for trades in this instrument, expressed as trade date plus number of business days (e.g., T+2).']
  settlement_method varchar [note: 'Method by which the instrument settles upon maturity or exercise (physical delivery, cash settlement, or net settlement).']
  short_name varchar [note: 'Abbreviated or display name of the instrument for operational and reporting purposes.']
  strike_price decimal(20,6) [note: 'Exercise price for options and other derivative instruments.']
  termination_date date [note: 'Date on which this instrument record was terminated or superseded. Null if still active.']
  tick_size decimal(18,8) [note: 'Minimum price increment for trading the instrument on the exchange.']
  trading_status varchar [note: 'Current trading status of the instrument indicating whether it is actively tradeable.']

  Note: 'Master reference record for all tradeable financial instruments across asset classes—equities, fixed income, FX, and OTC derivatives. Serves as the SSOT for instrument identity within the trade domain.'
}

Table trade.broker {
  broker_id varchar [pk, note: 'Unique identifier for the broker-dealer or execution counterparty record.']
  finra_member_id varchar [note: 'FINRA member identifier for U.S. broker-dealers subject to FINRA oversight.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: AML/KYC regulations require broker due diligence before trading. Pension funds must verify broker KYC status during onboarding and periodic reviews per FCA/SEC requirements.']
  approval_date date [note: 'Date on which the broker was approved by the Investment Committee (IC) or designated authority for inclusion on the approved broker list.']
  approved_asset_classes varchar [note: 'Comma-separated list of asset classes for which the broker is approved to execute trades (e.g., equities, fixed income, FX, derivatives, commodities).']
  bic varchar [note: 'ISO 9362 Bank Identifier Code (SWIFT code) used for settlement instructions and payment routing to the broker.']
  broker_status varchar [note: 'Current operational status of the broker relationship indicating whether the broker is approved for trade execution.']
  broker_type varchar [note: 'Classification of the broker-dealer by service model and execution capability.']
  clearing_arrangement varchar [note: 'Type of clearing arrangement used by the broker for trade settlement.']
  clearing_house_name varchar [note: 'Name of the central counterparty (CCP) or clearing house used by the broker for trade clearing and settlement.']
  commission_structure varchar [note: 'Description of the commission and fee structure applicable to trades executed through this broker (e.g., basis points, fixed per trade, tiered).']
  counterparty_risk_limit decimal(18,2) [note: 'Maximum exposure limit (in base currency) allowed with this broker for counterparty risk management purposes.']
  created_timestamp timestamp [note: 'Timestamp when the broker record was first created in the system.']
  credit_rating varchar [note: 'Current credit rating of the broker-dealer from a recognized rating agency (e.g., Moodys, S&P, Fitch) used for counterparty risk assessment.']
  csa_flag boolean [note: 'Indicates whether a Credit Support Annex is in place with this broker for collateral management on OTC derivatives.']
  csa_threshold_amount decimal(18,2) [note: 'Threshold amount (in base currency) below which collateral is not required under the CSA with this broker.']
  custodian_name varchar [note: 'Name of the custodian bank holding securities on behalf of the pension fund when trading through this broker.']
  dvp_capability_flag boolean [note: 'Indicates whether the broker supports Delivery Versus Payment (DVP) settlement to mitigate settlement risk.']
  esg_rating varchar [note: 'ESG rating or score assigned to the broker-dealer by an external ESG rating provider (e.g., MSCI, Sustainalytics) for responsible investment stewardship.']
  execution_capabilities varchar [note: 'Description of the brokers execution capabilities including algorithmic trading, direct market access (DMA), high-touch services, and electronic trading platforms.']
  fca_firm_reference_number varchar [note: 'FCA-issued firm reference number for UK-regulated broker-dealers.']
  headquarters_address varchar [note: 'Full street address of the broker-dealers headquarters or principal place of business.']
  headquarters_city varchar [note: 'City where the broker-dealers headquarters is located.']
  headquarters_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the country where the broker-dealers headquarters is located.']
  isda_agreement_date date [note: 'Date on which the ISDA Master Agreement with this broker was executed.']
  isda_master_agreement_flag boolean [note: 'Indicates whether an ISDA Master Agreement is in place with this broker for over-the-counter (OTC) derivatives trading.']
  last_review_date date [note: 'Date of the most recent periodic review of the broker-dealer for continued approval and performance assessment.']
  legal_name varchar [note: 'Full legal name of the broker-dealer or execution counterparty as registered with regulatory authorities.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier uniquely identifying the broker-dealer globally for regulatory reporting and counterparty identification.']
  minimum_transfer_amount decimal(18,2) [note: 'Minimum collateral transfer amount (in base currency) specified in the CSA with this broker.']
  modified_by varchar [note: 'User identifier of the person who last modified the broker record.']
  modified_timestamp timestamp [note: 'Timestamp when the broker record was last modified in the system.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the broker-dealer.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special instructions related to the broker relationship.']
  primary_contact_email varchar [note: 'Email address of the primary relationship contact at the broker-dealer.']
  primary_contact_name varchar [note: 'Name of the primary relationship contact at the broker-dealer for operational and escalation purposes.']
  primary_contact_phone varchar [note: 'Phone number of the primary relationship contact at the broker-dealer.']
  primary_regulator varchar [note: 'Name of the primary regulatory body overseeing the broker-dealer (e.g., SEC, FCA, FINRA, ESMA).']
  sec_registration_number varchar [note: 'SEC-issued registration number for U.S.-registered broker-dealers.']
  settlement_cycle varchar [note: 'Standard settlement cycle for trades executed through this broker (e.g., T+2, T+1, T+0) across different asset classes.']
  short_name varchar [note: 'Abbreviated or trading name of the broker used for operational reference and reporting.']
  ssi_on_file_flag boolean [note: 'Indicates whether Standard Settlement Instructions (SSI) are on file and current for this broker.']
  termination_date date [note: 'Date on which the broker relationship was terminated or the broker was removed from the approved list.']
  created_by varchar [note: 'User identifier of the person who created the broker record.']

  Note: 'Master record for approved broker-dealers and execution counterparties used for trade execution across all asset classes. Captures broker legal name, LEI, BIC, regulatory registration numbers (FCA, SEC), approved asset classes, execution capabilities'
}

Table trade.broker_commission {
  broker_commission_id varchar [pk, note: 'Unique identifier for the broker commission record.']
  broker_id varchar [note: 'Identifier of the broker or executing dealer to whom the commission is payable.']
  employee_id varchar [note: 'Identifier of the internal trader or portfolio manager who executed the trade.']
  execution_id varchar [note: 'Reference to the trade execution that generated this commission charge.']
  instrument_id varchar [note: 'Internal identifier of the financial instrument that was traded.']
  order_id varchar [note: 'Reference to the parent order associated with this commission.']
  payment_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Commission payments to brokers settle through specific cash accounts. Finance teams need this link for commission payment processing, cash forecasting, and broker payables']
  portfolio_id varchar [note: 'Identifier of the investment portfolio or fund to which this commission expense is allocated.']
  strategy_id varchar [note: 'Identifier of the investment strategy under which the trade and commission were executed.']
  trader_employee_id varchar [note: 'Identifier of the internal trader or portfolio manager who executed the trade.']
  accrual_date date [note: 'Date on which the commission expense is accrued in the accounting books.']
  asset_class varchar [note: 'Broad asset class of the instrument traded: equity, fixed income, foreign exchange, derivative, commodity, or alternative.']
  capacity varchar [note: 'Capacity in which the broker acted: principal, agency, or riskless principal.']
  commission_amount decimal(18,4) [note: 'Total commission charge payable to the broker in the commission currency.']
  commission_basis varchar [note: 'Method by which the commission is calculated: per share, percentage of trade value, flat fee per trade, tiered schedule, notional-based, or ticket charge.']
  commission_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the commission is denominated.']
  commission_rate_bps decimal(10,4) [note: 'Commission rate expressed in basis points of the trade notional value.']
  commission_rate_per_share decimal(10,6) [note: 'Commission charge per share or unit traded, applicable for per-share commission structures.']
  commission_reference varchar [note: 'External reference or invoice number assigned by the broker for this commission charge.']
  commission_sharing_arrangement_flag boolean [note: 'Indicates whether this commission is part of a commission sharing arrangement with multiple brokers.']
  commission_type varchar [note: 'Classification of the commission structure: explicit fee, soft dollar arrangement, research payment account, bundled service, execution-only, or full-service.']
  cost_center_code varchar [note: 'General ledger cost center code to which this commission expense is allocated for accounting purposes.']
  created_timestamp timestamp [note: 'Timestamp when this commission record was first created in the system.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  execution_quality_tier varchar [note: 'Internal rating of the brokers execution quality for this trade, used for best execution monitoring.']
  execution_venue varchar [note: 'Name of the exchange, trading platform, or venue where the trade was executed.']
  fx_rate decimal(18,10) [note: 'Exchange rate applied when converting commission amount from commission currency to settlement currency.']
  gl_account_code varchar [note: 'General ledger account code for booking the commission expense.']
  invoice_date date [note: 'Date on which the broker issued the commission invoice.']
  invoice_number varchar [note: 'Broker-issued invoice number for this commission charge.']
  isin varchar [note: 'Twelve-character alphanumeric code uniquely identifying the traded security.']
  modified_timestamp timestamp [note: 'Timestamp when this commission record was last modified.']
  notes varchar [note: 'Free-text notes or comments regarding the commission charge, payment terms, or special arrangements.']
  payment_date date [note: 'Actual date on which the commission was paid to the broker.']
  payment_due_date date [note: 'Date by which the commission payment must be remitted to the broker.']
  payment_method varchar [note: 'Method used to remit the commission payment: wire transfer, ACH, check, netting arrangement, or offset against receivables.']
  payment_reference varchar [note: 'Payment transaction reference or wire confirmation number for the commission remittance.']
  payment_status varchar [note: 'Current status of the commission payment: pending, scheduled, paid, overdue, disputed, or waived.']
  research_payment_account_flag boolean [note: 'Indicates whether this commission is allocated to a research payment account under MiFID II unbundling rules.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange and other UK exchanges.']
  settlement_amount decimal(18,4) [note: 'Commission amount in settlement currency after foreign exchange conversion, if applicable.']
  settlement_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the commission payment is settled, if different from commission currency.']
  settlement_date date [note: 'Date on which the trade settles and commission payment is due.']
  side varchar [note: 'Direction of the trade: buy or sell.']
  soft_dollar_flag boolean [note: 'Indicates whether this commission includes soft dollar benefits or bundled research services.']
  trade_date date [note: 'Date on which the underlying trade was executed.']
  trade_notional_value decimal(18,4) [note: 'Gross notional value of the underlying trade used as the basis for commission calculation.']
  trade_quantity decimal(18,6) [note: 'Number of shares or units traded, used for per-share commission calculations.']
  venue_mic_code varchar [note: 'Four-character ISO 10383 code identifying the execution venue or exchange.']

  Note: 'Record of commission and transaction cost charges payable to a broker for trade execution services. Captures commission amount, commission rate (bps), commission type (explicit, soft dollar, research payment), trade reference, settlement currency, payment'
}

Table trade.standing_settlement_instruction {
  standing_settlement_instruction_id varchar [pk, note: 'Unique identifier for the standing_settlement_instruction data product (auto-inserted during validation).']
  counterparty_id varchar [note: 'Reference to the counterparty entity for which this SSI applies.']
  custodian_id varchar [note: 'Foreign key linking to trade.custodian. Business justification: Standing settlement instructions specify custodian details for settlement. The existing custodian_code (BIGINT) appears to be an unlinked FK.']
  instrument_id varchar [note: 'Reference to the financial instrument for which this SSI applies.']
  approval_status varchar [note: 'Internal approval status of this SSI record before activation.']
  approval_timestamp timestamp [note: 'Date and time when this SSI was approved.']
  approved_by varchar [note: 'User or role who approved this SSI for operational use.']
  asset_class varchar [note: 'Asset class category to which this SSI applies.']
  beneficiary_account_name varchar [note: 'Name on the beneficiary account for settlement proceeds.']
  beneficiary_account_number varchar [note: 'Account number for the beneficiary receiving settlement proceeds.']
  clearing_system_code varchar [note: 'Code identifying the clearing system or Central Counterparty (CCP) used.']
  contact_email varchar [note: 'Email address of the primary contact for settlement queries.']
  contact_name varchar [note: 'Name of the primary contact person for settlement queries related to this SSI.']
  contact_phone varchar [note: 'Phone number of the primary contact for settlement queries.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the counterparty.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the settlement jurisdiction.']
  created_timestamp timestamp [note: 'Date and time when this SSI record was first created in the system.']
  custodian_bic varchar [note: 'ISO 9362 Bank Identifier Code for the custodian institution.']
  depository_account_number varchar [note: 'Account number at the depository or custodian where securities are held.']
  depository_bic varchar [note: 'ISO 9362 Bank Identifier Code for the depository institution.']
  depository_name varchar [note: 'Name of the depository institution or central securities depository.']
  effective_date date [note: 'Date from which this SSI becomes valid and operational.']
  emir_reporting_flag boolean [note: 'Indicates whether this SSI requires EMIR trade reporting for derivatives.']
  expiry_date date [note: 'Date on which this SSI ceases to be valid, nullable for open-ended SSIs.']
  instrument_type varchar [note: 'Specific type of financial instrument covered by this SSI.']
  intermediary_account_number varchar [note: 'Account number at the intermediary institution, if applicable.']
  intermediary_bic varchar [note: 'ISO 9362 Bank Identifier Code for any intermediary institution in the settlement chain.']
  last_used_date date [note: 'Date when this SSI was last used for a settlement transaction.']
  market_code varchar [note: 'ISO 10383 Market Identifier Code (MIC) for the trading venue.']
  modified_timestamp timestamp [note: 'Date and time when this SSI record was last modified.']
  notes varchar [note: 'Additional notes or comments regarding this SSI record.']
  place_of_settlement varchar [note: 'ISO 10383 MIC code for the place where settlement occurs.']
  priority_indicator varchar [note: 'Priority level for settlement processing of trades using this SSI.']
  regulatory_reporting_flag boolean [note: 'Indicates whether trades settled via this SSI require regulatory reporting.']
  safekeeping_account varchar [note: 'Account number for safekeeping of securities at the custodian.']
  settlement_currency_code varchar [note: 'ISO 4217 three-letter currency code for settlement transactions.']
  settlement_cycle varchar [note: 'Standard settlement cycle for this SSI, expressed as T+N (e.g., T+2).']
  settlement_method varchar [note: 'Method of settlement: Delivery Versus Payment (DVP), Free of Payment (FOP), Receive Versus Payment (RVP), or Payment Free of Delivery (PFOD).']
  special_instructions varchar [note: 'Free-text field for any special settlement instructions or conditions.']
  ssi_reference varchar [note: 'External business reference number or code for this SSI record.']
  ssi_status varchar [note: 'Current lifecycle status of the SSI record.']
  ssi_version varchar [note: 'Version number of this SSI record, incremented with each update.']
  standing_instruction_type varchar [note: 'Indicates whether this SSI applies to receive, deliver, or both directions.']
  tax_status varchar [note: 'Tax treatment status applicable to settlements under this SSI.']
  usage_count varchar [note: 'Number of times this SSI has been used for settlement transactions.']

  Note: 'Standard Settlement Instruction master record defining the standing settlement details for a counterparty and instrument combination. Captures SSI version, effective date, expiry date, counterparty LEI, custodian BIC, depository account number, settlement'
}

Table trade.fx_trade {
  fx_trade_id varchar [pk, note: 'Unique identifier for the foreign exchange trade transaction.']
  broker_id varchar [note: 'Reference to the broker or intermediary who facilitated the FX trade execution.']
  counterparty_id varchar [note: 'Reference to the financial institution or counterparty with whom the FX trade was executed.']
  csa_id varchar [note: 'Foreign key linking to collateral.csa. Business justification: FX derivatives require CSA for collateral posting terms. Essential for pension fund\'s FX hedging program margin management and UMR compliance.']
  employee_id varchar [note: 'Reference to the internal trader or portfolio manager who executed or authorized the FX trade.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Currency hedging attribution: FX trades executed to hedge capital calls/distributions from external managers require GP linkage for manager-level currency exposure analysis, hedge']
  isda_master_id varchar [note: 'Foreign key linking to collateral.isda_master. Business justification: FX forwards and swaps are governed by ISDA agreements. Pension funds hedge currency exposure extensively; ISDA linkage enables netting and close-out netting calculations.']
  portfolio_id varchar [note: 'Reference to the investment portfolio for which this FX trade was executed.']
  settlement_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: FX trades settle through designated cash accounts. Treasury operations require this link for FX settlement processing, currency funding, and intraday liquidity management.']
  trader_employee_id varchar [note: 'Reference to the internal trader or portfolio manager who executed or authorized the FX trade.']
  base_amount decimal(20,4) [note: 'The notional amount in the base currency being sold or exchanged.']
  base_currency varchar [note: 'The currency being sold or exchanged in the FX transaction, expressed as ISO 4217 three-letter code.']
  benchmark_rate decimal(18,8) [note: 'Reference benchmark exchange rate used for valuation or performance comparison purposes.']
  benchmark_source varchar [note: 'Source or provider of the benchmark exchange rate, such as WM/Reuters, ECB, or Bloomberg.']
  clearing_house varchar [note: 'Name of the central counterparty clearing house used for cleared FX trades, if applicable.']
  clearing_status varchar [note: 'Indicates whether the FX trade is centrally cleared, bilaterally settled, pending clearing, or failed clearing.']
  commission_amount decimal(18,4) [note: 'Total commission or brokerage fee charged for executing the FX trade.']
  commission_currency varchar [note: 'Currency in which the commission or brokerage fee is denominated, expressed as ISO 4217 three-letter code.']
  confirmation_timestamp timestamp [note: 'Date and time when the FX trade was confirmed by the counterparty.']
  counterparty_lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier of the FX trade counterparty.']
  created_timestamp timestamp [note: 'System timestamp when this FX trade record was first created in the database.']
  exchange_rate decimal(18,8) [note: 'The agreed exchange rate at which the base currency is converted to the quote currency.']
  execution_method varchar [note: 'Method by which the FX trade was executed: electronic platform, voice broker, request for quote, or algorithmic trading.']
  execution_venue varchar [note: 'Name or identifier of the trading venue, platform, or system where the FX trade was executed.']
  forward_points decimal(12,6) [note: 'The adjustment to the spot rate to derive the forward rate, reflecting interest rate differentials between the two currencies.']
  hedge_designation varchar [note: 'Accounting classification of the FX trade for hedge accounting purposes under IFRS 9 or equivalent standards.']
  hedge_effectiveness_test varchar [note: 'Type of hedge effectiveness testing applied to this FX trade if designated as a hedge.']
  modified_timestamp timestamp [note: 'System timestamp when this FX trade record was last updated or modified.']
  ndf_fixing_date date [note: 'The date on which the reference exchange rate is determined for settlement of a non-deliverable forward contract.']
  ndf_fixing_source varchar [note: 'The reference rate source used to determine the fixing rate for NDF settlement, such as central bank or Reuters page.']
  notional_amount_usd decimal(20,4) [note: 'The total notional value of the FX trade converted to USD for reporting and risk aggregation purposes.']
  quote_amount decimal(20,4) [note: 'The notional amount in the quote currency being bought or received.']
  quote_currency varchar [note: 'The currency being bought or received in the FX transaction, expressed as ISO 4217 three-letter code.']
  rate_type varchar [note: 'Classification of the exchange rate: market rate at execution, benchmark reference rate, fixed contractual rate, or bilaterally negotiated rate.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this FX trade is subject to regulatory reporting requirements under EMIR, MiFID II, or equivalent jurisdictions.']
  settlement_date date [note: 'The date on which the FX trade is scheduled to settle and currencies are exchanged.']
  settlement_method varchar [note: 'Method by which the FX trade will be settled: physical delivery of currencies, cash settlement of net difference, or netting with other trades.']
  settlement_timestamp timestamp [note: 'Date and time when the FX trade settlement was completed and currencies were exchanged.']
  side varchar [note: 'Indicates whether the fund is buying or selling the base currency in this FX transaction.']
  spread_bps decimal(8,2) [note: 'The bid-ask spread or markup applied to the FX rate, expressed in basis points.']
  swap_far_leg_date date [note: 'Settlement date for the far leg of an FX swap transaction.']
  swap_near_leg_date date [note: 'Settlement date for the near leg of an FX swap transaction.']
  trade_date date [note: 'The business date on which the FX trade was executed.']
  trade_purpose varchar [note: 'Business purpose for executing the FX trade: hedging currency exposure, funding investments, repatriating proceeds, managing liquidity, or settling obligations.']
  trade_reference varchar [note: 'External business identifier or reference number assigned to this FX trade by the trading system or counterparty.']
  trade_status varchar [note: 'Current lifecycle status of the FX trade in the settlement workflow.']
  trade_timestamp timestamp [note: 'Date and time when the FX trade was executed in the market.']
  transaction_type varchar [note: 'Type of FX transaction: spot for immediate delivery, forward for future delivery, swap for simultaneous buy and sell, or NDF for non-deliverable forward.']
  uti varchar [note: 'Globally unique identifier for the FX trade as required by regulatory reporting frameworks such as EMIR and Dodd-Frank.']
  value_date date [note: 'The effective date from which the exchanged currencies are available for use.']
  venue_mic_code varchar [note: 'ISO 10383 four-character Market Identifier Code for the execution venue.']

  Note: 'Foreign exchange trade record capturing spot, forward, and swap FX transactions executed to fund investments, repatriate proceeds, or hedge currency exposure.'
}

Table trade.otc_derivative {
  otc_derivative_id varchar [pk, note: 'Unique identifier for the OTC derivative trade record.']
  blotter_id varchar [note: 'Reference to the parent trade execution record in the trade execution system.']
  clearing_house_id varchar [note: 'Foreign key linking to trade.clearing_house. Business justification: OTC derivatives that are cleared need to link to the clearing_house master reference table. The existing clearing_house_code (BIGINT) appears to be an unlinked FK.']
  counterparty_id varchar [note: 'Identifier of the external counterparty with whom the OTC derivative contract is bilaterally negotiated.']
  csa_id varchar [note: 'Foreign key linking to collateral.csa. Business justification: OTC derivatives require CSA linkage for collateral terms (thresholds, eligible collateral, haircuts). Critical for UMR compliance and daily variation margin calculation.']
  employee_id varchar [note: 'Identifier of the internal trader or portfolio manager who executed the OTC derivative trade.']
  execution_id varchar [note: 'Reference to the parent trade execution record in the trade execution system.']
  isda_master_id varchar [note: 'Foreign key linking to collateral.isda_master. Business justification: OTC derivatives are governed by ISDA master agreements defining netting, close-out, and termination rights.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio to which this OTC derivative position is allocated.']
  research_yield_curve_id varchar [note: 'Foreign key linking to research.research_yield_curve. Business justification: OTC derivative valuation (especially interest rate swaps) requires yield curves for discounting and projection.']
  trader_employee_id varchar [note: 'Identifier of the internal trader or portfolio manager who executed the OTC derivative trade.']
  booking_entity varchar [note: 'Legal entity within the pension fund organization that books and holds the OTC derivative position.']
  clearing_status varchar [note: 'Indicates whether the OTC derivative is centrally cleared through a CCP or remains a bilateral contract.']
  collateral_currency varchar [note: 'Three-letter ISO 4217 currency code for collateral posted or received.']
  collateral_posted decimal(18,2) [note: 'Amount of collateral posted by the fund to the counterparty to cover mark-to-market exposure.']
  collateral_received decimal(18,2) [note: 'Amount of collateral received from the counterparty to cover mark-to-market exposure in favor of the fund.']
  confirmation_status varchar [note: 'Status of trade confirmation between counterparties, indicating whether terms have been agreed and documented.']
  confirmation_timestamp timestamp [note: 'Timestamp when the OTC derivative trade was confirmed by both counterparties.']
  counterparty_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier for the derivative counterparty, required for regulatory reporting.']
  created_timestamp timestamp [note: 'Timestamp when the OTC derivative trade record was first created in the system.']
  credit_rating varchar [note: 'Credit rating of the counterparty or underlying reference entity, provided by agencies such as Moody\'s, S&P, or Fitch.']
  csa_in_place boolean [note: 'Boolean flag indicating whether a Credit Support Annex is in place for collateral management with the counterparty.']
  day_count_convention varchar [note: 'Method used to calculate accrued interest and payment amounts over time periods in the derivative contract.']
  derivative_subtype varchar [note: 'Granular classification within the derivative type, such as fixed-to-floating swap or single-name CDS.']
  derivative_type varchar [note: 'Classification of the OTC derivative instrument by its underlying structure and payoff mechanism.']
  effective_date date [note: 'Date on which the OTC derivative contract becomes legally binding and cash flows or obligations commence.']
  fixed_rate decimal(10,6) [note: 'Fixed interest rate or spread expressed as a decimal for fixed-leg payments in interest rate swaps or CDS premiums.']
  floating_rate_index varchar [note: 'Reference rate index for floating-leg payments, such as SOFR, LIBOR, EURIBOR, or other benchmark rates.']
  floating_rate_spread decimal(10,6) [note: 'Basis points spread added to or subtracted from the floating rate index, expressed as a decimal.']
  isda_master_agreement_date date [note: 'Date of the ISDA Master Agreement governing the legal terms and conditions of the derivative relationship with the counterparty.']
  mark_to_market_value decimal(18,2) [note: 'Current fair value of the OTC derivative position based on market prices or valuation models.']
  maturity_date date [note: 'Date on which the OTC derivative contract expires and final settlement occurs.']
  modified_timestamp timestamp [note: 'Timestamp when the OTC derivative trade record was last modified in the system.']
  mtm_currency varchar [note: 'Three-letter ISO 4217 currency code for the mark-to-market valuation.']
  notional_amount decimal(20,2) [note: 'Principal amount on which derivative cash flows and payments are calculated, not exchanged at inception.']
  notional_currency varchar [note: 'Three-letter ISO 4217 currency code for the notional amount of the derivative contract.']
  payment_frequency varchar [note: 'Frequency at which periodic cash flows or coupon payments are exchanged between counterparties.']
  regulatory_reporting_flag boolean [note: 'Boolean flag indicating whether this OTC derivative trade is subject to regulatory reporting under EMIR, Dodd-Frank, or MiFID II.']
  settlement_method varchar [note: 'Method by which the derivative contract is settled at maturity or upon a credit event: cash settlement or physical delivery.']
  termination_date date [note: 'Date on which the OTC derivative contract was terminated early, if applicable.']
  termination_reason varchar [note: 'Business reason for early termination of the derivative contract, such as credit event, mutual agreement, or portfolio rebalancing.']
  trade_date date [note: 'Date on which the OTC derivative contract was executed and agreed between counterparties.']
  trade_reference_number varchar [note: 'External business identifier for the OTC derivative trade, used for confirmation and settlement communication.']
  trade_status varchar [note: 'Current lifecycle status of the OTC derivative trade in the trade management workflow.']
  trade_timestamp timestamp [note: 'Precise timestamp when the OTC derivative trade was executed, including time zone.']
  underlying_asset_class varchar [note: 'Broad asset class category of the underlying reference entity or index for the derivative.']
  underlying_identifier varchar [note: 'Unique identifier for the underlying reference asset, index, or entity (e.g., ISIN, Bloomberg ticker, RED code for CDS).']
  underlying_name varchar [note: 'Human-readable name of the underlying reference entity, index, or asset for the derivative contract.']
  unique_product_identifier varchar [note: 'Standardized identifier for the OTC derivative product type, used for regulatory reporting and market transparency.']
  unique_trade_identifier varchar [note: 'Globally unique identifier for the OTC derivative trade, required for regulatory reporting to trade repositories.']
  valuation_date date [note: 'Date as of which the mark-to-market value was calculated.']
  valuation_source varchar [note: 'Source system or vendor providing the mark-to-market valuation, such as Bloomberg, Markit, or internal model.']

  Note: 'OTC derivative trade record for bilaterally negotiated derivative contracts including interest rate swaps, credit default swaps (CDS), total return swaps, and equity derivatives.'
}

Table trade.ccp_clearing {
  ccp_clearing_id varchar [pk, note: 'Unique identifier for the CCP clearing record.']
  cash_account_id varchar [note: 'Reference to the account under which the cleared trade is booked.']
  ccp_membership_id varchar [note: 'Foreign key linking to collateral.ccp_membership. Business justification: Cleared trades must link to CCP membership for initial/variation margin requirements.']
  clearing_house_id varchar [note: 'Foreign key linking to trade.clearing_house. Business justification: CCP clearing records should link to the clearing_house master reference table. The existing clearing_house_code (BIGINT) appears to be an unlinked FK.']
  execution_id varchar [note: 'Reference to the underlying trade that was submitted for clearing.']
  instrument_id varchar [note: 'Reference to the financial instrument that was cleared.']
  netting_agreement_id varchar [note: 'Identifier for the netting set to which this cleared position belongs.']
  portfolio_id varchar [note: 'Reference to the investment portfolio to which this cleared trade belongs.']
  asset_class varchar [note: 'Asset class of the cleared instrument.']
  backloading_flag boolean [note: 'Indicates whether this is a backloaded trade submitted for clearing after execution.']
  ccp_lei varchar [note: 'Legal Entity Identifier of the CCP clearing house.']
  ccp_name varchar [note: 'Name of the central counterparty clearing house that cleared the trade.']
  cleared_currency_code varchar [note: 'ISO 4217 three-letter currency code for the cleared transaction.']
  cleared_notional_amount decimal(18,2) [note: 'Notional amount of the derivative contract that was cleared.']
  cleared_quantity decimal(18,4) [note: 'Quantity of the instrument that was cleared through the CCP.']
  clearing_acceptance_timestamp timestamp [note: 'Date and time when the CCP accepted the trade for clearing.']
  clearing_account_number varchar [note: 'Account number at the CCP under which the trade is cleared.']
  clearing_fee_amount decimal(18,2) [note: 'Fee charged by the CCP for clearing the transaction.']
  clearing_fee_currency_code varchar [note: 'Currency in which the clearing fee is denominated.']
  clearing_member_lei varchar [note: 'Legal Entity Identifier of the clearing member firm.']
  clearing_member_name varchar [note: 'Name of the clearing member firm through which the trade was cleared.']
  clearing_obligation_flag boolean [note: 'Indicates whether the trade is subject to mandatory clearing obligation under EMIR.']
  clearing_reference_number varchar [note: 'Unique reference number assigned by the CCP for this cleared transaction.']
  clearing_rejection_timestamp timestamp [note: 'Date and time when the CCP rejected the trade for clearing.']
  clearing_status varchar [note: 'Current status of the clearing process for this trade.']
  clearing_submission_timestamp timestamp [note: 'Date and time when the trade was submitted to the CCP for clearing.']
  collateral_currency_code varchar [note: 'Currency in which the collateral value is denominated.']
  collateral_type varchar [note: 'Type of collateral posted to the CCP for margin requirements.']
  collateral_value decimal(18,2) [note: 'Market value of collateral posted to the CCP.']
  compression_eligible_flag boolean [note: 'Indicates whether the cleared position is eligible for portfolio compression.']
  created_timestamp timestamp [note: 'Date and time when this CCP clearing record was first created in the system.']
  default_fund_contribution decimal(18,2) [note: 'Contribution amount to the CCPs default fund for mutualized risk coverage.']
  haircut_percentage decimal(5,2) [note: 'Haircut percentage applied by the CCP to the collateral value.']
  initial_margin_amount decimal(18,2) [note: 'Initial margin requirement posted to the CCP to cover potential future exposure.']
  initial_margin_currency_code varchar [note: 'Currency in which the initial margin is denominated.']
  isin varchar [note: 'International Securities Identification Number of the cleared instrument.']
  maturity_date date [note: 'Maturity date of the cleared derivative contract.']
  modified_timestamp timestamp [note: 'Date and time when this CCP clearing record was last modified.']
  product_type varchar [note: 'Specific product type of the cleared derivative or security.']
  rejection_code varchar [note: 'Standardized code indicating the reason for clearing rejection.']
  rejection_reason varchar [note: 'Reason provided by the CCP for rejecting the clearing submission.']
  settlement_date date [note: 'Date on which the cleared trade is scheduled to settle.']
  trade_date date [note: 'Date on which the original trade was executed.']
  usi varchar [note: 'Unique Swap Identifier for cleared swap transactions under US regulations.']
  uti varchar [note: 'Unique Trade Identifier assigned to the cleared derivative transaction.']
  variation_margin_amount decimal(18,2) [note: 'Variation margin amount exchanged to reflect daily mark-to-market changes.']
  variation_margin_currency_code varchar [note: 'Currency in which the variation margin is denominated.']

  Note: 'Central counterparty clearing record for exchange-traded and cleared OTC derivatives submitted to a CCP (e.g., LCH, CME Clearing, Eurex). Captures CCP name, clearing member, cleared trade reference, initial margin requirement, variation margin, clearing'
}

Table trade.execution_venue {
  execution_venue_id varchar [pk, note: 'Unique identifier for the execution venue record.']
  approval_expiry_date date [note: 'Date when the current venue approval expires and requires renewal or re-certification.']
  approved_date date [note: 'Date when the venue was approved for trading by the firms investment committee or trading governance body.']
  asset_classes_supported varchar [note: 'Comma-separated list of asset classes tradable on this venue: equities, fixed income, foreign exchange, derivatives, commodities.']
  average_fill_rate_pct decimal(5,2) [note: 'Historical average percentage of order quantity filled on first execution attempt.']
  average_latency_ms decimal(10,2) [note: 'Average round-trip latency in milliseconds from order submission to execution acknowledgment.']
  best_execution_eligible boolean [note: 'Indicates whether the venue is approved for inclusion in the firms best execution policy and venue selection process.']
  clearing_house varchar [note: 'Name of the central counterparty or clearing house used for trade clearing and settlement.']
  connectivity_protocol varchar [note: 'Primary electronic connectivity protocol or API standard used for order routing and execution.']
  contact_email varchar [note: 'Primary email address for operational inquiries and trade support at the venue.']
  contact_phone varchar [note: 'Primary phone number for operational support and trade desk contact at the venue.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the venues primary jurisdiction.']
  created_timestamp timestamp [note: 'Timestamp when the execution venue record was first created in the system.']
  execution_quality_score decimal(5,2) [note: 'Composite score representing the venues execution quality based on price improvement, fill rates, and speed metrics.']
  last_review_date date [note: 'Date of the most recent periodic review of venue performance, execution quality, and compliance.']
  lei varchar [note: 'ISO 17442 legal entity identifier for the venue operator or parent organization.']
  maximum_order_size decimal(18,4) [note: 'Maximum order quantity or notional value permitted for single order execution on this venue.']
  mic_code varchar [note: 'ISO 10383 four-character market identifier code uniquely identifying the venue.']
  minimum_order_size decimal(18,4) [note: 'Minimum order quantity or notional value required for execution on this venue.']
  modified_by varchar [note: 'User identifier or system account that last modified the execution venue record.']
  modified_timestamp timestamp [note: 'Timestamp when the execution venue record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next periodic review of venue performance and best execution metrics.']
  notes varchar [note: 'Free-text field for additional operational notes, restrictions, or special handling instructions for this venue.']
  operating_mic varchar [note: 'Operating MIC identifying the entity operating the venue when different from the segment MIC.']
  post_trade_reporting_required boolean [note: 'Indicates whether trades executed on this venue require post-trade reporting to an approved publication arrangement.']
  pre_trade_transparency_waiver boolean [note: 'Indicates whether the venue operates under a pre-trade transparency waiver for certain instrument classes.']
  regulatory_authority varchar [note: 'Name of the primary regulatory body overseeing the execution venue.']
  settlement_cycle varchar [note: 'Standard settlement cycle for trades executed on this venue, expressed as T+N format.']
  supports_algorithmic_trading boolean [note: 'Indicates whether the venue supports algorithmic order types and execution strategies.']
  supports_dark_pool boolean [note: 'Indicates whether the venue operates a dark pool or non-displayed liquidity mechanism.']
  tick_size_regime varchar [note: 'Description of the tick size rules and minimum price increment structure applied by the venue.']
  time_zone varchar [note: 'IANA time zone identifier for the venues trading hours and timestamps.']
  trading_currency varchar [note: 'Primary ISO 4217 currency code used for pricing and settlement on this venue.']
  trading_hours varchar [note: 'Standard trading session hours in local time zone, including pre-market and post-market sessions if applicable.']
  venue_name varchar [note: 'Full legal or trading name of the execution venue.']
  venue_status varchar [note: 'Current operational status of the execution venue for trade routing and execution.']
  venue_type varchar [note: 'Classification of the execution venue: regulated market, multilateral trading facility, organized trading facility, systematic internaliser, over-the-counter bilateral, or approved publication arrangement.']
  website_url varchar [note: 'Official website URL of the execution venue for reference documentation and market data.']
  created_by varchar [note: 'User identifier or system account that created the execution venue record.']

  Note: 'Master reference record for approved execution venues including regulated markets (exchanges), multilateral trading facilities (MTFs), systematic internalisers (SIs), and OTC bilateral venues.'
}

Table trade.amendment {
  amendment_id varchar [pk, note: 'Unique identifier for the trade amendment record.']
  amendment_approved_by_user_employee_id varchar [note: 'Identifier of the authorized user who approved the amendment for application.']
  amendment_employee_id varchar [note: 'Identifier of the user or trader who initiated the amendment request.']
  approved_by_user_employee_id varchar [note: 'Identifier of the authorized user who approved the amendment for application.']
  blotter_id varchar [note: 'Reference to the original executed trade that is being amended.']
  employee_id varchar [note: 'Identifier of the user or trader who initiated the amendment request.']
  execution_id varchar [note: 'Reference to the original executed trade that is being amended.']
  supersedes_amendment_id varchar [note: 'Reference to a previous amendment that this amendment replaces or supersedes.']
  amended_commission_amount decimal(18,2) [note: 'The corrected commission amount after amendment is applied.']
  amended_executed_price decimal(18,6) [note: 'The corrected execution price after amendment is applied.']
  amended_executed_quantity decimal(18,4) [note: 'The corrected executed quantity after amendment is applied.']
  amended_field_name varchar [note: 'Name of the specific trade attribute that was modified by this amendment.']
  amended_net_settlement_amount decimal(18,2) [note: 'The corrected net settlement amount after amendment is applied.']
  amended_settlement_date date [note: 'The corrected settlement date after amendment is applied.']
  amended_value decimal(18,2) [note: 'The new corrected value of the field after the amendment is applied.']
  amendment_status varchar [note: 'Current lifecycle status of the amendment request in the approval and application workflow.']
  amendment_type varchar [note: 'Classification of the amendment indicating which aspect of the trade is being corrected.']
  applied_timestamp timestamp [note: 'Date and time when the amendment was successfully applied to the trade record.']
  approval_timestamp timestamp [note: 'Date and time when the amendment was approved by an authorized user.']
  audit_trail_reference varchar [note: 'Reference to the detailed audit log entry capturing the full before-and-after state of the trade.']
  counterparty_notification_status varchar [note: 'Status indicating whether the counterparty has been notified of the amendment.']
  counterparty_notification_timestamp timestamp [note: 'Date and time when the counterparty was notified of the trade amendment.']
  created_timestamp timestamp [note: 'System timestamp when this amendment record was first created in the database.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for monetary amounts in this amendment.']
  impact_on_accounting boolean [note: 'Indicates whether this amendment requires accounting entries to be reversed or adjusted in the ABOR.']
  impact_on_settlement boolean [note: 'Indicates whether this amendment affects the settlement instructions and requires settlement system updates.']
  modified_timestamp timestamp [note: 'System timestamp when this amendment record was last modified.']
  notes varchar [note: 'Additional free-text notes or comments related to the amendment for operational context.']
  original_commission_amount decimal(18,2) [note: 'The original commission amount before amendment, captured for audit trail purposes.']
  original_executed_price decimal(18,6) [note: 'The original execution price before amendment, captured for audit trail purposes.']
  original_executed_quantity decimal(18,4) [note: 'The original executed quantity before amendment, captured for audit trail purposes.']
  original_net_settlement_amount decimal(18,2) [note: 'The original net settlement amount before amendment, captured for audit trail purposes.']
  original_settlement_date date [note: 'The original settlement date before amendment, captured for audit trail purposes.']
  original_value decimal(18,2) [note: 'The original value of the field before the amendment was applied.']
  reason_code varchar [note: 'Standardized code indicating the business reason for the amendment.']
  reason_description varchar [note: 'Detailed free-text explanation of why the amendment was necessary.']
  reference varchar [note: 'External business reference number for this amendment, used for tracking and reconciliation.']
  regulatory_reporting_required boolean [note: 'Indicates whether this amendment must be reported to regulatory authorities under MiFID II or EMIR.']
  regulatory_reporting_status varchar [note: 'Status of regulatory reporting submission for this amendment.']
  regulatory_reporting_timestamp timestamp [note: 'Date and time when the amendment was reported to regulatory authorities.']
  rejection_reason varchar [note: 'Explanation provided when an amendment request is rejected and not applied.']
  timestamp timestamp [note: 'Date and time when the amendment was initiated or requested.']
  version_number varchar [note: 'Sequential version number tracking multiple amendments to the same trade.']

  Note: 'Record of a post-trade amendment or correction applied to an executed trade. Captures amendment type (price correction, quantity adjustment, settlement date change, counterparty correction), original trade reference, amended field name, old value, new'
}

Table trade.status_history {
  status_history_id varchar [pk, note: 'Unique identifier for each status transition record in the trade lifecycle audit trail.']
  broker_id varchar [note: 'Reference to the broker handling the trade at this transition point.']
  counterparty_id varchar [note: 'Reference to the counterparty involved in this trade at the time of status transition.']
  execution_id varchar [note: 'Reference to the trade whose status transition is being recorded.']
  instrument_id varchar [note: 'Reference to the financial instrument being traded.']
  order_id varchar [note: 'Reference to the originating order for this trade status event.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this trade belongs at the time of status change.']
  triggering_user_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Trade status transitions require audit trails showing which employee triggered each change.']
  allocation_status varchar [note: 'The allocation status of the trade at the time of this status transition.']
  amendment_flag boolean [note: 'Indicates whether this status transition was triggered by a trade amendment.']
  cancellation_flag boolean [note: 'Indicates whether this status transition represents a trade cancellation event.']
  clearing_house varchar [note: 'The name of the central counterparty clearing house processing this trade.']
  clearing_status varchar [note: 'The clearing status of the trade with the central counterparty at this transition point.']
  confirmation_status varchar [note: 'The confirmation status of the trade at the time of this status event.']
  correction_flag boolean [note: 'Indicates whether this status transition was triggered by a trade correction.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier of the counterparty at the time of this status event.']
  created_timestamp timestamp [note: 'The timestamp when this status history record was created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for the trade value.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  emir_reporting_flag boolean [note: 'Indicates whether this status transition requires EMIR trade repository reporting.']
  error_code varchar [note: 'System or business error code if the status transition represents a failure or rejection.']
  error_message varchar [note: 'Detailed error message explaining the reason for failure or rejection.']
  execution_venue varchar [note: 'The trading venue or exchange where the trade was executed at this transition point.']
  isin varchar [note: 'ISO 6166 twelve-character alphanumeric code uniquely identifying the security.']
  notes varchar [note: 'Free-text notes or comments associated with this status transition.']
  price decimal(18,6) [note: 'The price per unit of the instrument at the time of this status event.']
  quantity decimal(18,4) [note: 'The quantity of the instrument involved in the trade at this status transition.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this status transition requires regulatory reporting.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded on the London Stock Exchange.']
  sequence_number varchar [note: 'Sequential order of this status transition within the trades complete lifecycle.']
  settlement_date date [note: 'The expected or actual settlement date for the trade at the time of this status event.']
  settlement_status varchar [note: 'The settlement status of the trade at the time of this status transition.']
  status_from varchar [note: 'The previous status of the trade before this transition occurred. [ENUM-REF-CANDIDATE: new|pending|executed|confirmed|allocated|settled|cancelled|rejected — 8 candidates stripped; promote to reference product]']
  status_to varchar [note: 'The new status of the trade after this transition occurred. [ENUM-REF-CANDIDATE: new|pending|executed|confirmed|allocated|settled|cancelled|rejected — 8 candidates stripped; promote to reference product]']
  trade_value decimal(18,2) [note: 'The total monetary value of the trade at this status transition point.']
  transition_event varchar [note: 'The business event that triggered this status change. [ENUM-REF-CANDIDATE: order_created|execution_received|trade_confirmed|allocation_completed|settlement_completed|trade_cancelled|trade_rejected|amendment_applied|correction_applied — 9 candidates']
  transition_reason varchar [note: 'Business reason or explanation for the status change.']
  transition_reason_code varchar [note: 'Standardized code representing the reason for the status transition.']
  transition_timestamp timestamp [note: 'The exact date and time when the status transition occurred.']
  triggering_system varchar [note: 'The source system that initiated or recorded this status transition.']
  triggering_user varchar [note: 'The user or service account that triggered this status change.']
  venue_mic_code varchar [note: 'ISO 10383 four-character Market Identifier Code for the execution venue.']
  version_number varchar [note: 'Sequential version number of the trade at the time of this status transition.']
  created_by varchar [note: 'The user or system account that created this status history record.']

  Note: 'Immutable trade audit and lifecycle trail capturing every change to a trade from order creation through settlement. Records both (a) status transitions — status_from, status_to, triggering event (execution, confirmation, settlement, cancellation), system'
}

Table trade.transaction_cost {
  transaction_cost_id varchar [pk, note: 'Unique identifier for the transaction cost record.']
  broker_id varchar [note: 'Reference to the broker or counterparty who charged or facilitated this cost.']
  execution_id varchar [note: 'Reference to the trade execution that incurred these costs.']
  instrument_id varchar [note: 'Reference to the financial instrument traded.']
  market_data_snapshot_id varchar [note: 'Foreign key linking to research.market_data_snapshot. Business justification: Transaction Cost Analysis (TCA) requires linking execution costs to benchmark market data snapshots.']
  order_id varchar [note: 'Reference to the parent order for this transaction cost.']
  portfolio_id varchar [note: 'Reference to the portfolio that incurred this transaction cost.']
  strategy_id varchar [note: 'Reference to the investment strategy associated with this transaction cost.']
  asset_class varchar [note: 'High-level asset class categorization of the traded instrument.']
  benchmark_price decimal(18,6) [note: 'Reference price used to calculate implicit costs such as market impact and slippage.']
  benchmark_type varchar [note: 'Type of benchmark price used for transaction cost analysis.']
  clearing_fee decimal(18,4) [note: 'Fee charged by the central counterparty or clearing house for trade clearing.']
  commission_type varchar [note: 'Classification of commission payment structure per MiFID II unbundling requirements.']
  cost_amount decimal(18,4) [note: 'Total cost amount for this transaction cost component in the cost currency.']
  cost_bps decimal(10,4) [note: 'Transaction cost expressed in basis points relative to trade notional value.']
  cost_calculation_timestamp timestamp [note: 'Date and time when the transaction cost was calculated and recorded.']
  cost_category varchar [note: 'High-level categorization of the transaction cost type.']
  cost_center_code varchar [note: 'Internal cost center or business unit code for cost allocation and reporting.']
  cost_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the transaction cost amount.']
  cost_reference varchar [note: 'External reference number or identifier for this transaction cost record.']
  cost_status varchar [note: 'Current lifecycle status of the transaction cost record.']
  cost_type varchar [note: 'Specific type of transaction cost incurred during trade execution. [ENUM-REF-CANDIDATE: commission|spread|market_impact|slippage|delay|tax|clearing_fee|exchange_fee|custody_fee|settlement_fee — 10 candidates stripped; promote to reference product]']
  cusip varchar [note: 'Nine-character alphanumeric code identifying North American securities.']
  exchange_fee decimal(18,4) [note: 'Fee charged by the trading venue or exchange for trade execution.']
  execution_price decimal(18,6) [note: 'Actual price at which the trade was executed.']
  execution_venue varchar [note: 'Name of the trading venue or exchange where the trade was executed.']
  fx_conversion_cost decimal(18,4) [note: 'Cost incurred for currency conversion related to cross-border trade settlement.']
  invoice_reference varchar [note: 'External invoice or billing reference number from the broker or service provider.']
  isin varchar [note: 'Twelve-character alphanumeric code uniquely identifying the security.']
  market_impact_amount decimal(18,4) [note: 'Estimated cost due to the trades impact on market price during execution.']
  notes varchar [note: 'Free-text notes or comments regarding this transaction cost record.']
  opportunity_cost_amount decimal(18,4) [note: 'Cost of unfilled or partially filled orders representing missed investment opportunities.']
  payment_date date [note: 'Actual date on which the transaction cost was paid.']
  payment_due_date date [note: 'Date by which the transaction cost payment is due to the broker or venue.']
  quantity decimal(18,6) [note: 'Number of units or shares traded in this execution.']
  research_payment_account_flag boolean [note: 'Indicates whether this cost was paid through a dedicated Research Payment Account per MiFID II.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying securities traded in the UK and Ireland.']
  settlement_date date [note: 'Date on which the trade is scheduled to settle and costs are finalized.']
  settlement_fee decimal(18,4) [note: 'Fee charged by custodian or settlement agent for trade settlement processing.']
  side varchar [note: 'Direction of the trade indicating whether the position was bought or sold.']
  slippage_amount decimal(18,4) [note: 'Difference between expected execution price and actual execution price.']
  soft_dollar_allocation decimal(18,4) [note: 'Portion of commission allocated to soft dollar research payments per MiFID II unbundling.']
  spread_amount decimal(18,6) [note: 'Cost attributed to the bid-ask spread at time of execution.']
  tax_amount decimal(18,4) [note: 'Tax levied on the transaction such as stamp duty or financial transaction tax.']
  timing_cost_amount decimal(18,4) [note: 'Cost attributed to delay between order decision and execution.']
  trade_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the trade notional value.']
  trade_date date [note: 'Date on which the trade was executed.']
  trade_notional_value decimal(18,4) [note: 'Total notional value of the trade used as the basis for cost calculation.']
  venue_mic_code varchar [note: 'Four-character ISO 10383 Market Identifier Code for the execution venue.']

  Note: 'Comprehensive transaction cost SSOT capturing ALL explicit and implicit costs for a trade execution — including broker commission (with commission type: explicit, soft dollar, research payment, and soft-dollar research credit allocation per MiFID II'
}

Table trade.algo_order {
  algo_order_id varchar [pk, note: 'Unique identifier for the algorithmic execution order record.']
  broker_id varchar [note: 'Reference to the broker or execution venue providing the algorithmic execution service.']
  employee_id varchar [note: 'Reference to the trader who initiated or is responsible for monitoring the algorithmic order.']
  instrument_id varchar [note: 'Reference to the financial instrument being traded via this algorithmic order.']
  parent_order_id varchar [note: 'Reference to the parent order that spawned this algorithmic execution strategy.']
  portfolio_id varchar [note: 'Reference to the portfolio for which this algorithmic order is executed.']
  strategy_id varchar [note: 'Reference to the investment strategy driving this algorithmic order.']
  trader_employee_id varchar [note: 'Reference to the trader who initiated or is responsible for monitoring the algorithmic order.']
  algo_order_status varchar [note: 'Current lifecycle status of the algorithmic order execution. [ENUM-REF-CANDIDATE: New|Pending|Active|Paused|Completed|Cancelled|Rejected|Expired — 8 candidates stripped; promote to reference product]']
  algo_provider varchar [note: 'Name of the algorithmic trading platform or service provider executing the order.']
  algo_strategy_type varchar [note: 'Type of algorithmic trading strategy employed to execute the order with minimal market impact.']
  algo_version varchar [note: 'Version identifier of the algorithmic strategy used for execution, for audit and performance tracking.']
  average_execution_price decimal(18,6) [note: 'Volume-weighted average price achieved by the algorithmic strategy across all child executions.']
  benchmark_price decimal(18,6) [note: 'Reference price used to measure the performance of the algorithmic execution strategy.']
  benchmark_type varchar [note: 'Type of benchmark used to evaluate the execution performance of the algorithmic order.']
  cancellation_reason varchar [note: 'Free-text explanation for why the algorithmic order was cancelled or terminated before completion.']
  child_order_count varchar [note: 'Total number of child orders generated by the algorithmic strategy to execute the parent order.']
  created_timestamp timestamp [note: 'Date and time when this algorithmic order record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for the order pricing and settlement.']
  dark_pool_participation_flag boolean [note: 'Indicates whether the algorithmic strategy is permitted to route orders to dark pools and alternative trading systems.']
  end_time timestamp [note: 'Scheduled end time for the algorithmic execution window in HH:MM:SS format.']
  end_timestamp timestamp [note: 'Date and time when the algorithmic execution strategy completed or was terminated.']
  executed_quantity decimal(18,4) [note: 'Cumulative quantity of the instrument that has been executed by the algorithmic strategy to date.']
  execution_style varchar [note: 'Trading style parameter controlling the aggressiveness of the algorithmic execution strategy.']
  implementation_shortfall_bps decimal(8,2) [note: 'Total cost of execution in basis points including market impact, timing cost, and opportunity cost.']
  limit_price decimal(18,6) [note: 'Maximum price for buy orders or minimum price for sell orders that the algorithmic strategy may execute at.']
  max_participation_rate decimal(5,4) [note: 'Maximum percentage of market volume that the algorithmic strategy may consume to avoid excessive market impact.']
  max_slice_quantity decimal(18,4) [note: 'Maximum quantity that may be sent in a single child order slice by the algorithmic strategy.']
  min_fill_quantity decimal(18,4) [note: 'Minimum quantity that must be filled in each child order execution to avoid excessive fragmentation.']
  modified_by varchar [note: 'User identifier or system account that last modified this algorithmic order record.']
  modified_timestamp timestamp [note: 'Date and time when this algorithmic order record was last modified in the system.']
  notes varchar [note: 'Additional free-text notes or comments regarding the algorithmic order execution for operational reference.']
  notional_value decimal(20,2) [note: 'Total notional value of the algorithmic order calculated as quantity multiplied by average execution price.']
  order_quantity decimal(18,4) [note: 'Total quantity of the instrument to be executed via the algorithmic strategy.']
  participation_rate_target decimal(5,4) [note: 'Target participation rate as a percentage of market volume for POV algorithmic strategies.']
  price_limit_offset_bps varchar [note: 'Price tolerance in basis points from the benchmark or limit price that the algorithmic strategy may deviate.']
  reference varchar [note: 'External business reference number for the algorithmic order, used for tracking and reconciliation.']
  rejection_reason varchar [note: 'Free-text explanation for why the algorithmic order was rejected by the execution system or broker.']
  remaining_quantity decimal(18,4) [note: 'Quantity of the instrument still pending execution by the algorithmic strategy.']
  side varchar [note: 'Direction of the algorithmic order indicating whether it is a buy or sell transaction.']
  slippage_bps decimal(8,2) [note: 'Measured slippage in basis points between the average execution price and the benchmark price.']
  start_time timestamp [note: 'Scheduled start time for the algorithmic execution window in HH:MM:SS format.']
  start_timestamp timestamp [note: 'Date and time when the algorithmic execution strategy began processing the order.']
  submission_timestamp timestamp [note: 'Date and time when the algorithmic order was submitted to the execution management system.']
  urgency_level varchar [note: 'Priority level indicating how aggressively the algorithmic strategy should pursue execution.']
  venue_restriction_list varchar [note: 'Comma-separated list of Market Identifier Codes (MIC) for venues that are restricted or preferred for this algorithmic order.']
  created_by varchar [note: 'User identifier or system account that created this algorithmic order record.']

  Note: 'Algorithmic execution order record capturing the parameters and performance of algorithmic trading strategies used to execute large orders with minimal market impact.'
}

Table trade.custody_account {
  custody_account_id varchar [pk, note: 'Unique identifier for the custody account record.']
  counterparty_id varchar [note: 'Reference to the custodian bank holding the account (State Street, Northern Trust, etc.).']
  custodian_id varchar [note: 'Foreign key linking to trade.custodian. Business justification: Custody accounts are held at custodian banks. The existing custodian_code (BIGINT) appears to be an unlinked FK.']
  portfolio_id varchar [note: 'Reference to the portfolio that owns this custody account.']
  account_closure_date date [note: 'The date when the custody account was closed, if applicable.']
  account_currency varchar [note: 'The base currency in which the custody account is denominated (ISO 4217 three-letter code).']
  account_manager_email varchar [note: 'Email address of the custodian relationship manager for operational communications.']
  account_manager_name varchar [note: 'Name of the relationship manager or account officer at the custodian bank responsible for this account.']
  account_manager_phone varchar [note: 'Phone number of the custodian relationship manager for urgent operational matters.']
  account_name varchar [note: 'The legal name or title of the custody account as registered with the custodian.']
  account_number varchar [note: 'The unique account number assigned by the custodian bank for this custody account.']
  account_opening_date date [note: 'The date when the custody account was opened with the custodian.']
  account_status varchar [note: 'Current operational status of the custody account.']
  account_type varchar [note: 'Classification of the custody account based on its purpose and structure.']
  annual_custody_fee_bps decimal(8,4) [note: 'The annual custody fee charged by the custodian, expressed in basis points of Assets Under Administration (AUA).']
  asset_class varchar [note: 'Primary asset class held in this custody account.']
  beneficial_owner_name varchar [note: 'The legal name of the beneficial owner of the assets held in this custody account.']
  cash_sweep_account_flag boolean [note: 'Indicates whether uninvested cash in this account is automatically swept to a designated cash management vehicle.']
  collateral_account_flag boolean [note: 'Indicates whether this custody account is designated for holding collateral for derivatives or securities financing transactions.']
  created_timestamp timestamp [note: 'The timestamp when this custody account record was first created in the system.']
  custodian_bic varchar [note: 'The SWIFT BIC code of the custodian bank holding this account.']
  custodian_lei varchar [note: 'The Legal Entity Identifier of the custodian bank.']
  custody_fee_schedule_code varchar [note: 'Reference code for the fee schedule applicable to this custody account.']
  depository_code varchar [note: 'Standard code identifying the central securities depository (e.g., DTC, Euroclear, Clearstream).']
  depository_name varchar [note: 'Name of the central securities depository or sub-custodian where assets are held.']
  emir_reporting_flag boolean [note: 'Indicates whether trades in this account are subject to EMIR reporting requirements.']
  last_reconciliation_date date [note: 'The date of the most recent successful reconciliation of this custody account.']
  last_statement_date date [note: 'The date of the most recent custody account statement received from the custodian.']
  last_valuation_date date [note: 'The most recent date on which the custodian provided a valuation for assets held in this account.']
  modified_by varchar [note: 'The user or system identifier that last modified this custody account record.']
  modified_timestamp timestamp [note: 'The timestamp when this custody account record was last modified.']
  nominee_name varchar [note: 'The name of the nominee entity under which securities are registered, if applicable.']
  omnibus_account_flag boolean [note: 'Indicates whether this is an omnibus account holding assets for multiple underlying beneficial owners.']
  place_of_settlement varchar [note: 'ISO country code indicating the jurisdiction where settlement occurs for this account.']
  reconciliation_frequency varchar [note: 'The frequency at which holdings and cash balances in this custody account are reconciled with internal records.']
  regulatory_classification varchar [note: 'The regulatory classification of the account holder under applicable securities regulations.']
  safekeeping_account_number varchar [note: 'The safekeeping or depository account number where securities are held.']
  securities_lending_eligible_flag boolean [note: 'Indicates whether securities held in this account are eligible for securities lending programs.']
  segregated_account_flag boolean [note: 'Indicates whether assets in this account are held in a segregated manner separate from the custodians own assets.']
  service_level_agreement_tier varchar [note: 'The service tier or SLA level applicable to this custody account.']
  settlement_method varchar [note: 'Default settlement method for trades settling through this custody account (DVP = Delivery Versus Payment, RVP = Receive Versus Payment, FOP = Free of Payment).']
  sfdr_classification varchar [note: 'SFDR article classification for ESG disclosure purposes, if applicable.']
  special_instructions varchar [note: 'Any special handling instructions or operational notes specific to this custody account.']
  tax_identification_number varchar [note: 'The tax identification number associated with the beneficial owner of this custody account.']
  tax_jurisdiction varchar [note: 'ISO country code of the primary tax jurisdiction for this custody account.']
  tax_status varchar [note: 'The tax treatment classification of the custody account.']
  transaction_fee_per_trade decimal(12,2) [note: 'The per-transaction fee charged by the custodian for trade settlement services.']
  created_by varchar [note: 'The user or system identifier that created this custody account record.']

  Note: 'Master record for custody accounts held at custodian banks (State Street, Northern Trust) used to hold securities and cash on behalf of the pension fund\'s portfolios.'
}

Table trade.instrument_exclusion {
  instrument_exclusion_id varchar [pk, note: 'Unique identifier for this instrument-exclusion relationship record. Primary key.']
  exclusion_list_id varchar [note: 'Foreign key linking to the exclusion list policy that applies to this instrument']
  instrument_id varchar [note: 'Foreign key linking to the financial instrument subject to this exclusion']
  divestment_deadline date [note: 'Date by which the fund must complete divestment of this specific instrument under this exclusion policy. Critical for compliance monitoring and trade execution planning.']
  effective_date date [note: 'Date from which this specific exclusion applies to this specific instrument. May differ from the exclusion list\'s general effective date if the instrument was added later.']
  instrument_exclusion_status varchar [note: 'Current status of this exclusion application: active (exclusion enforced), pending_divestment (in process of selling), divested (fully exited), waived (exception granted).']
  reason varchar [note: 'Detailed explanation of why this specific instrument triggered this specific exclusion policy. Captures instrument-level nuance beyond the general exclusion list reason.']
  revenue_threshold_pct decimal(5,2) [note: 'The actual revenue exposure percentage for this instrument that triggered the exclusion threshold. Allows tracking of how far above/below threshold each instrument falls.']

  Note: 'This association product represents the application of an exclusion policy to a specific financial instrument. It captures the compliance relationship between ESG exclusion lists and tradeable instruments in the pension fund\'s investable universe.'
}

Table trade.netting_set_inclusion {
  netting_set_inclusion_id varchar [pk, note: 'Unique system-generated identifier for the netting set inclusion record']
  netting_agreement_id varchar [note: 'Foreign key linking to the netting agreement governing the netting arrangement']
  otc_derivative_id varchar [note: 'Foreign key linking to the OTC derivative trade included in the netting set']
  eligibility_status varchar [note: 'Current eligibility status of the trade for netting under this agreement based on product scope, legal enforceability, and agreement terms']
  exclusion_date date [note: 'Date on which the trade was removed from the netting set, null if currently included']
  exclusion_reason varchar [note: 'Reason for excluding the trade from the netting set if applicable (e.g., matured, novated, eligibility change)']
  exposure_contribution decimal(20,2) [note: 'The trade\'s contribution to the netted exposure calculation under this netting agreement, expressed in the agreement\'s base currency']
  inclusion_date date [note: 'Date on which the OTC derivative trade was added to the netting set under this agreement']

  Note: 'This association product represents the inclusion of an OTC derivative trade within a netting agreement for exposure calculation and close-out netting purposes.'
}

Table trade.trade_check {
  trade_check_id varchar [pk, note: 'Primary key for the check association']
  order_id varchar [note: 'Foreign key linking to the investment order being validated']
  rule_id varchar [note: 'Foreign key linking to the compliance rule applied in this check']
  override_approved_by varchar [note: 'Reference to the compliance officer or authorized user who approved the override exception']
  override_reason varchar [note: 'Justification text provided when a failed compliance check is overridden to allow order execution']
  result varchar [note: 'Outcome of the compliance check indicating whether the order passed, failed, or triggered a warning for this rule']
  timestamp timestamp [note: 'Date and time when the compliance check was performed against the order']

  Note: 'This association product represents the pre-trade compliance check event between an investment order and a compliance rule. It captures the result of validating each order against applicable compliance rules before execution, including the check outcome'
}

Table trade.custodian {
  custodian_id varchar [pk, note: 'Primary key for custodian']
  annual_custody_fee_bps decimal(8,4) [note: 'Annual custody fee expressed in basis points charged on assets under custody.']
  api_integration_status varchar [note: 'Status of API-based integration for real-time position and transaction data feeds.']
  aum_threshold_usd decimal(18,2) [note: 'Minimum assets under management threshold in USD required by the custodian for service eligibility.']
  base_currency_code varchar [note: 'ISO 4217 currency code for the custodians primary reporting and fee currency.']
  bic_code varchar [note: 'SWIFT/BIC code identifying the custodian for international wire transfers and settlement instructions.']
  contract_effective_date date [note: 'Date when the current custody agreement became legally effective.']
  contract_expiry_date date [note: 'Date when the current custody agreement is scheduled to expire or requires renewal.']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the custodians domicile jurisdiction.']
  created_timestamp timestamp [note: 'Timestamp when the custodian record was first created in the system.']
  credit_rating varchar [note: 'Current credit rating of the custodian from major rating agencies for counterparty risk assessment.']
  credit_rating_agency varchar [note: 'Name of the rating agency that issued the current credit rating (e.g., Moodys, S&P, Fitch).']
  credit_rating_date date [note: 'Date when the current credit rating was assigned or last reviewed.']
  custodian_name varchar [note: 'Legal registered name of the custodian institution providing asset safekeeping and settlement services.']
  custodian_status varchar [note: 'Current operational status of the custodian relationship for trade settlement purposes.']
  custodian_type varchar [note: 'Classification of custodian by service model and market coverage scope.']
  insurance_coverage_usd decimal(18,2) [note: 'Total insurance coverage amount in USD protecting client assets held by the custodian.']
  is_qualified_custodian boolean [note: 'Indicates whether the custodian meets qualified custodian requirements under SEC Rule 206(4)-2.']
  is_systemically_important boolean [note: 'Indicates whether the custodian is designated as a systemically important financial institution (SIFI).']
  last_due_diligence_date date [note: 'Date of the most recent operational due diligence review conducted on the custodian.']
  legal_entity_identifier varchar [note: '20-character alphanumeric code uniquely identifying the custodian per ISO 17442 standard for global financial transactions.']
  modified_timestamp timestamp [note: 'Timestamp when the custodian record was last modified.']
  next_due_diligence_date date [note: 'Scheduled date for the next operational due diligence review of the custodian.']
  notes varchar [note: 'Free-text field for additional operational notes or special instructions regarding the custodian.']
  onboarding_date date [note: 'Date when the custodian relationship was formally established and approved for use.']
  parent_company_name varchar [note: 'Name of the parent company or holding entity if the custodian is a subsidiary.']
  primary_contact_email varchar [note: 'Email address of the primary contact for operational communications and settlement inquiries.']
  primary_contact_name varchar [note: 'Name of the primary relationship manager or contact person at the custodian institution.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact for urgent settlement and custody matters.']
  registered_address varchar [note: 'Official registered business address of the custodian institution for legal and regulatory correspondence.']
  regulatory_jurisdiction varchar [note: 'Primary regulatory authority or jurisdiction governing the custodians operations and licensing.']
  regulatory_license_number varchar [note: 'License or registration number issued by the regulatory authority authorizing custody services.']
  risk_rating varchar [note: 'Internal counterparty risk rating assigned to the custodian based on due diligence assessment.']
  service_level_agreement_tier varchar [note: 'Contracted service level tier defining response times, reporting frequency, and support commitments.']
  settlement_cut_off_time varchar [note: 'Daily deadline time for submitting settlement instructions to the custodian in local timezone.']
  supported_asset_classes varchar [note: 'Comma-separated list of asset classes the custodian can hold and settle (equities, fixed income, FX, derivatives).']
  supported_markets varchar [note: 'Comma-separated list of market codes or regions where the custodian provides settlement services.']
  supports_corporate_actions boolean [note: 'Indicates whether the custodian processes corporate actions (dividends, splits, mergers) on behalf of clients.']
  supports_fx_execution boolean [note: 'Indicates whether the custodian provides foreign exchange execution services for settlement.']
  supports_proxy_voting boolean [note: 'Indicates whether the custodian facilitates proxy voting services for equity holdings.']
  supports_securities_lending boolean [note: 'Indicates whether the custodian offers securities lending program services.']
  swift_connectivity_status varchar [note: 'Status of SWIFT messaging connectivity for automated settlement instruction transmission.']
  termination_date date [note: 'Date when the custodian relationship was terminated or scheduled for termination.']
  transaction_fee_usd decimal(12,4) [note: 'Standard per-transaction settlement fee in USD charged by the custodian.']

  Note: 'Master reference table for custodian. Referenced by custodian_id.'
}

Table trade.allocation_group {
  allocation_group_id varchar [pk, note: 'Primary key for allocation_group']
  approved_by_user_employee_id varchar [note: 'Reference to the user who approved this allocation group for operational use.']
  custodian_id varchar [note: 'Reference to the primary custodian for assets held within this allocation group.']
  department_id varchar [note: 'Reference to the trading desk responsible for executing orders for this allocation group.']
  employee_id varchar [note: 'Reference to the portfolio manager responsible for investment decisions within this allocation group.']
  investment_strategy_id varchar [note: 'Reference to the investment strategy that governs this allocation group\'s investment approach.']
  legal_entity_id varchar [note: 'Reference to the legal entity that owns or manages this allocation group.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for performance measurement of this allocation group.']
  settlement_instruction_id varchar [note: 'Reference to default settlement instructions for trades allocated to this group.']
  account_count varchar [note: 'Number of investment accounts currently assigned to this allocation group.']
  allocation_group_description varchar [note: 'Detailed description of the allocation group purpose, investment mandate, and allocation rules.']
  allocation_group_name varchar [note: 'Human-readable name of the allocation group used for display and reporting purposes.']
  allocation_group_status varchar [note: 'Current lifecycle status of the allocation group indicating its operational availability.']
  allocation_method varchar [note: 'Method used to distribute trade fills across accounts within the allocation group.']
  allows_partial_fills boolean [note: 'Indicates whether the allocation group accepts partial order fills for distribution.']
  approved_timestamp timestamp [note: 'Timestamp when the allocation group was approved for operational use.']
  asset_class varchar [note: 'Primary asset class that this allocation group is designed to trade or manage.']
  auto_rebalance_enabled boolean [note: 'Indicates whether automatic rebalancing is enabled for accounts in this allocation group.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code representing the base currency for the allocation group.']
  cash_buffer_percent decimal(5,2) [note: 'Percentage of portfolio value to maintain as cash buffer for liquidity management.']
  created_timestamp timestamp [note: 'Timestamp when the allocation group record was first created in the system.']
  drift_tolerance_percent decimal(5,2) [note: 'Maximum percentage deviation from target weights before triggering rebalancing.']
  effective_from_date date [note: 'Date from which the allocation group becomes active and available for trade allocation.']
  effective_to_date date [note: 'Date until which the allocation group remains active. Null indicates open-ended validity.']
  external_system_code varchar [note: 'Identifier used by external systems or counterparties to reference this allocation group.']
  group_code varchar [note: 'Business identifier code used to reference the allocation group in trading systems and order management platforms.']
  group_type varchar [note: 'Classification of the allocation group by its functional purpose in the investment process.']
  is_default_group boolean [note: 'Indicates whether this allocation group is the default for unassigned orders.']
  is_model_portfolio boolean [note: 'Indicates whether this allocation group represents a model portfolio for rebalancing purposes.']
  last_modified_timestamp timestamp [note: 'Timestamp when the allocation group record was last updated.']
  minimum_allocation_amount decimal(18,2) [note: 'Minimum monetary amount that can be allocated to any single account within the group.']
  minimum_allocation_quantity decimal(18,6) [note: 'Minimum number of shares or units that can be allocated to any single account within the group.']
  notes varchar [note: 'Free-form notes and comments about the allocation group for operational reference.']
  oms_system_code varchar [note: 'Code identifying this allocation group in the Order Management System (Charles River or Bloomberg AIM).']
  priority_rank varchar [note: 'Numeric rank determining allocation priority when multiple groups compete for limited fills.']
  rebalance_frequency varchar [note: 'Frequency at which the allocation group is reviewed and rebalanced to target weights.']
  requires_pre_trade_compliance boolean [note: 'Indicates whether orders for this group must pass pre-trade compliance checks.']
  rounding_lot_size decimal(18,6) [note: 'Standard lot size used for rounding allocations to tradeable quantities.']
  rounding_method varchar [note: 'Method used to round fractional shares or units during the allocation process.']
  tax_lot_method varchar [note: 'Method used for selecting tax lots when allocating sales within the group.']
  total_aum decimal(18,2) [note: 'Total assets under management across all accounts in this allocation group in base currency.']

  Note: 'Master reference table for allocation_group. Referenced by allocation_group_id.'
}

Table trade.clearing_house {
  clearing_house_id varchar [pk, note: 'Primary key for clearing_house']
  clearing_broker_id varchar [note: 'Reference to the clearing broker used for indirect clearing access, if applicable.']
  asset_class_coverage varchar [note: 'Comma-separated list of asset classes cleared (e.g., equities, fixed_income, derivatives, fx, commodities).']
  bic_code varchar [note: 'SWIFT/BIC code identifying the clearing house for international financial messaging per ISO 9362.']
  central_bank_money_settlement boolean [note: 'Indicates whether settlement occurs in central bank money rather than commercial bank money.']
  clearing_house_name varchar [note: 'Official registered name of the clearing house organization.']
  clearing_house_type varchar [note: 'Classification of clearing house: CCP (Central Counterparty), CSD (Central Securities Depository), ICSD (International CSD), hybrid, or other.']
  created_timestamp timestamp [note: 'Timestamp when this clearing house record was first created in the system.']
  credit_rating_moodys varchar [note: 'Current credit rating assigned to the clearing house by Moody\'s Investors Service.']
  credit_rating_sp varchar [note: 'Current credit rating assigned to the clearing house by Standard & Poor\'s.']
  default_fund_contribution_required boolean [note: 'Indicates whether clearing members must contribute to a mutualized default fund.']
  default_settlement_cycle varchar [note: 'Standard settlement cycle for cleared trades (e.g., T+0, T+1, T+2).']
  default_waterfall_position varchar [note: 'Position of clearing house capital in the default waterfall sequence (1=first loss, higher=later).']
  domicile_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the clearing house is legally domiciled.']
  emir_tier varchar [note: 'EMIR classification tier for third-country CCPs (Tier 1 or Tier 2) or not applicable for EU-based CCPs.']
  interoperability_links varchar [note: 'Comma-separated list of other clearing houses with which interoperability agreements exist.']
  is_active boolean [note: 'Indicates whether the clearing house is currently active and available for clearing services.']
  is_systemically_important boolean [note: 'Indicates whether the clearing house is designated as systemically important by regulators.']
  legal_entity_identifier varchar [note: '20-character alphanumeric code that uniquely identifies the clearing house as a legal entity per ISO 17442.']
  margin_methodology varchar [note: 'Primary margin calculation methodology used by the clearing house.']
  membership_effective_date date [note: 'Date when the pension funds clearing membership or access became effective.']
  membership_status varchar [note: 'Current status of the pension funds membership or relationship with this clearing house.']
  membership_termination_date date [note: 'Date when the pension funds clearing membership or access was terminated, if applicable.']
  membership_type varchar [note: 'Type of clearing access: direct clearing member, indirect via clearing broker, or sponsored access.']
  mic_code varchar [note: 'Four-character code identifying the clearing house as a market infrastructure per ISO 10383.']
  netting_capability boolean [note: 'Indicates whether the clearing house supports multilateral netting of obligations.']
  notes varchar [note: 'Free-text field for additional operational notes or comments about the clearing house.']
  operational_hours_end varchar [note: 'Daily operational end time in HH:MM format (local time zone).']
  operational_hours_start varchar [note: 'Daily operational start time in HH:MM format (local time zone).']
  pfmi_compliant boolean [note: 'Indicates whether the clearing house is compliant with CPMI-IOSCO Principles for Financial Market Infrastructures.']
  primary_contact_email varchar [note: 'Primary email address for operational inquiries with the clearing house.']
  primary_contact_phone varchar [note: 'Primary telephone number for operational contact with the clearing house.']
  primary_regulator varchar [note: 'Name of the primary regulatory authority overseeing the clearing house (e.g., SEC, ESMA, FCA, CFTC).']
  qccp_status boolean [note: 'Indicates whether the clearing house qualifies as a QCCP under Basel III capital requirements.']
  real_time_gross_settlement boolean [note: 'Indicates whether the clearing house supports real-time gross settlement processing.']
  recovery_plan_available boolean [note: 'Indicates whether the clearing house has a published recovery and resolution plan.']
  registered_address varchar [note: 'Official registered business address of the clearing house.']
  regulatory_status varchar [note: 'Current regulatory authorization status of the clearing house in its home jurisdiction.']
  settlement_currency_codes varchar [note: 'Comma-separated ISO 4217 currency codes supported for settlement (e.g., USD,EUR,GBP,JPY).']
  short_name varchar [note: 'Abbreviated or commonly used trading name of the clearing house (e.g., LCH, CME, DTCC).']
  skin_in_the_game_amount decimal(18,2) [note: 'Amount of the clearing houses own capital committed to the default waterfall, in base currency.']
  time_zone varchar [note: 'IANA time zone identifier for the clearing houses primary operational time zone (e.g., Europe/London).']
  updated_timestamp timestamp [note: 'Timestamp when this clearing house record was last modified.']
  website_url varchar [note: 'Official website URL of the clearing house.']

  Note: 'Master reference table for clearing_house. Referenced by clearing_house_id.'
}

Table treasury.cash_position {
  cash_position_id varchar [pk, note: 'Unique identifier for the cash position record. Primary key for the cash position entity.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Cash position records duplicate account details that are already stored in cash_account; linking to cash_account centralizes account data.']
  custodian_id varchar [note: 'Reference to the custodian bank holding the cash account (State Street or Northern Trust).']
  fund_id varchar [note: 'Reference to the fund entity (one per participating plan) that owns this cash position.']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Cash position is associated with a fund commitment to monitor fund cash balances.']
  liquidity_reserve_policy_id varchar [note: 'Foreign key linking to treasury.liquidity_reserve_policy. Business justification: Cash positions are measured against liquidity reserve policy requirements. Links position to applicable policy.']
  settlement_instruction_id varchar [note: 'Reference to the standard settlement instructions template used for automated cash movements to and from this account.']
  sofr_benchmark_id varchar [note: 'Foreign key linking to treasury.sofr_benchmark. Business justification: Cash position interest rates are derived from SOFR; linking provides a direct reference to the benchmark.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Pension fund NAV calculation requires cash position reconciliation within valuation cycles.']
  accrued_interest decimal(20,2) [note: 'The cumulative interest earned but not yet paid on the cash balance as of the position date.']
  available_balance decimal(20,2) [note: 'The cash balance available for immediate use, net of pending settlements, holds, and reserved amounts.']
  bank_identifier_code varchar [note: 'The SWIFT BIC code of the custodian bank branch holding this cash account, used for international wire transfers and settlement instructions.']
  capital_call_pending decimal(20,2) [note: 'Total value of capital calls issued by private equity, infrastructure, or real estate fund managers that are pending funding from this cash account.']
  collateral_posted decimal(20,2) [note: 'Cash amount posted as collateral to counterparties for derivative positions, margin requirements, or securities lending, reducing available cash.']
  collateral_received decimal(20,2) [note: 'Cash amount received as collateral from counterparties for derivative positions or securities lending, increasing available cash but with restrictions.']
  created_timestamp timestamp [note: 'The timestamp when this cash position record was first created in the data warehouse.']
  custody_balance decimal(20,2) [note: 'The cash balance reported by the custodian bank (State Street or Northern Trust), representing the external source of truth for reconciliation.']
  data_quality_score decimal(5,2) [note: 'Automated data quality assessment score for this cash position record, ranging from 0.00 to 100.00, based on completeness, accuracy, and timeliness checks.']
  distribution_pending decimal(20,2) [note: 'Total value of distributions from private market investments or fund managers that are expected to be received into this cash account.']
  effective_date date [note: 'The date from which this cash position record is effective, supporting historical point-in-time queries and slowly changing dimension tracking.']
  expiry_date date [note: 'The date when this cash position record is superseded by a newer version, supporting historical point-in-time queries and slowly changing dimension tracking. Null for current records.']
  fx_hedge_ratio decimal(5,4) [note: 'The proportion of this currency exposure that is hedged through FX forwards or swaps, expressed as a decimal (e.g., 0.8500 for 85 percent hedged).']
  interest_rate decimal(8,5) [note: 'The current interest rate applied to the cash balance, expressed as a decimal (e.g., 0.0525 for 5.25 percent), typically linked to SOFR (Secured Overnight Financing Rate) or equivalent benchmark.']
  is_current boolean [note: 'Indicates whether this is the current active version of the cash position record, supporting slowly changing dimension queries.']
  last_reconciliation_date date [note: 'The date when the most recent successful reconciliation between ledger and custody balances was completed.']
  last_updated_timestamp timestamp [note: 'The timestamp when this cash position record was last modified in the source system or data warehouse.']
  ledger_balance decimal(20,2) [note: 'The accounting book balance as recorded in the internal general ledger, representing the official accounting position before reconciliation adjustments.']
  legal_entity_identifier varchar [note: 'The 20-character LEI code of the fund entity that legally owns this cash account, required for regulatory reporting.']
  liquidity_tier varchar [note: 'Classification of cash liquidity: tier_1 for immediately available cash, tier_2 for same-day available, tier_3 for next-day available, restricted for encumbered or limited-access cash.']
  net_contribution_inflow decimal(20,2) [note: 'The net cash inflow from pension contributions (member and employer contributions minus benefit payments) received during the reporting period.']
  notes varchar [note: 'Free-text field for treasury operations team to record comments, explanations, or special circumstances related to this cash position.']
  overdraft_limit decimal(20,2) [note: 'The maximum negative balance permitted by the custodian for this account, representing the intraday credit facility available.']
  pending_settlements_inflow decimal(20,2) [note: 'Total value of incoming cash settlements not yet reflected in the custody balance, including trade settlements, dividend receipts, and capital distributions.']
  pending_settlements_outflow decimal(20,2) [note: 'Total value of outgoing cash settlements not yet reflected in the custody balance, including trade purchases, capital calls, and fee payments.']
  position_date date [note: 'The business date for which this cash position is reported, representing the as-of date for all balance figures.']
  position_status varchar [note: 'Current operational status of the cash position: active for normal operations, inactive for dormant accounts, closed for terminated accounts, frozen for regulatory hold, restricted for limited access.']
  position_timestamp timestamp [note: 'The precise timestamp when this cash position snapshot was captured, supporting intraday position tracking.']
  projected_balance decimal(20,2) [note: 'The forecasted end-of-day cash balance incorporating known future cash flows, capital calls, and scheduled settlements.']
  reconciliation_difference decimal(20,2) [note: 'The variance between ledger balance and custody balance, representing unreconciled items requiring investigation.']
  reconciliation_status varchar [note: 'Status of the reconciliation between ledger balance and custody balance: reconciled for matched positions, pending for in-progress reconciliation, break for identified discrepancies, investigating for unresolved differences.']
  reporting_currency_flag boolean [note: 'Indicates whether this cash position is denominated in the funds base reporting currency, used for performance and NAV (Net Asset Value) calculation.']
  reserved_amount decimal(20,2) [note: 'Cash amount reserved or earmarked for specific purposes such as collateral requirements, margin calls, or committed capital calls, not available for general use.']
  sweep_account_flag boolean [note: 'Indicates whether this account participates in automated cash sweep programs to optimize interest income on idle cash balances.']
  zero_balance_account_flag boolean [note: 'Indicates whether this is a zero balance account that automatically transfers excess cash to or from a master concentration account.']

  Note: 'Authoritative IBOR/ABOR cash position record for each currency account held at custodians (State Street / Northern Trust). Captures intraday and end-of-day cash balances, projected cash, ledger cash, and custody cash across all fund entities and currency'
}

Table treasury.cash_account {
  cash_account_id varchar [pk, note: 'Unique identifier for the cash account record. Primary key.']
  bank_account_ssi_id varchar [note: 'Reference to the standard settlement instructions template used for automated payment routing from this account.']
  counterparty_id varchar [note: 'Reference to the custodian bank holding this account (State Street, Northern Trust, etc.).']
  csa_agreement_csa_id varchar [note: 'Reference to the ISDA Credit Support Annex agreement governing collateral held in this account.']
  csa_id varchar [note: 'Reference to the ISDA Credit Support Annex agreement governing collateral held in this account.']
  custodian_id varchar [note: 'Reference to the custodian bank holding this account (State Street, Northern Trust, etc.).']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Cash account belongs to a specific fund commitment; linking enables tracking of cash account usage per fund.']
  legal_entity_id varchar [note: 'Reference to the legal entity that owns or controls this cash account.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Pension funds designate specific cash accounts for external manager mandates to segregate capital call funding, distribution receipts, and fee payments.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or fund that this cash account supports.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Each resource asset has a dedicated cash account for settlement and reporting of production revenue and royalties.']
  ssi_template_bank_account_ssi_id varchar [note: 'Reference to the standard settlement instructions template used for automated payment routing from this account.']
  sweep_target_account_id varchar [note: 'Reference to the target cash account for automated sweep transactions.']
  aba_routing_number varchar [note: 'Nine-digit ABA routing transit number for domestic US wire transfers and ACH transactions.']
  account_closed_date date [note: 'Date when the cash account was closed or terminated, if applicable.']
  account_manager_email varchar [note: 'Email address of the custodian account manager for operational inquiries and support.']
  account_manager_name varchar [note: 'Name of the custodian relationship manager or account officer responsible for this account.']
  account_manager_phone varchar [note: 'Phone number of the custodian account manager for urgent operational matters.']
  account_name varchar [note: 'The descriptive name or title of the cash account as registered with the custodian.']
  account_number varchar [note: 'The unique account number assigned by the custodian bank for this cash or settlement account.']
  account_opened_date date [note: 'Date when the cash account was originally opened with the custodian.']
  account_ownership varchar [note: 'Ownership structure of the account: internal treasury, external custodian-held, pooled with other funds, or segregated for specific mandate.']
  account_purpose varchar [note: 'Detailed business purpose or use case for this cash account (e.g., trade settlement, capital call funding, dividend collection, FX hedging collateral).']
  account_status varchar [note: 'Current operational status of the cash account in its lifecycle.']
  account_type varchar [note: 'Classification of the cash account by its primary business purpose (settlement, operational liquidity, reserve, collateral, margin, sweep).']
  balance_reporting_frequency varchar [note: 'Frequency at which the custodian provides balance updates for this account.']
  benchmark_rate decimal(18,2) [note: 'Reference benchmark rate for floating interest calculation (SOFR, LIBOR, EURIBOR, SONIA, TONAR, ESTR, Fed Funds, or none for fixed/zero).']
  bic_swift_code varchar [note: 'BIC/SWIFT code identifying the custodian bank and branch for international wire transfers and settlement instructions.']
  collateral_account_flag boolean [note: 'Indicates whether this account is designated for holding collateral for derivatives, securities lending, or margin requirements.']
  correspondent_bank_account_number varchar [note: 'Account number held at the correspondent bank for settlement routing.']
  correspondent_bank_bic varchar [note: 'BIC/SWIFT code of the correspondent bank for routing international payments.']
  correspondent_bank_name varchar [note: 'Name of the correspondent or intermediary bank used for settlement routing, if applicable.']
  cost_center_code varchar [note: 'Internal cost center or business unit code responsible for this account in the corporate chart of accounts.']
  created_timestamp timestamp [note: 'Timestamp when this cash account record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the account denomination (USD, EUR, GBP, JPY, etc.).']
  iban varchar [note: 'International Bank Account Number for cross-border settlement and identification, primarily used in European and international transactions.']
  interest_bearing_flag boolean [note: 'Indicates whether this cash account earns interest on positive balances.']
  interest_calculation_method varchar [note: 'Day count convention used for interest accrual calculation (Actual/360, Actual/365, 30/360, Actual/Actual).']
  interest_rate_bps decimal(10,4) [note: 'Current interest rate applied to the account, expressed in basis points (1 bps = 0.01%).']
  interest_rate_type varchar [note: 'Type of interest rate applied to the account: fixed, floating (e.g., SOFR-linked), tiered based on balance, or zero.']
  internal_gl_account_code varchar [note: 'Internal general ledger account code in Oracle Financials or corporate accounting system mapped to this cash account.']
  last_activity_date date [note: 'Date of the most recent transaction or balance change in this account.']
  last_reconciliation_date date [note: 'Date of the most recent successful reconciliation of this account.']
  lei varchar [note: '20-character ISO 17442 Legal Entity Identifier for the account holder, used for regulatory reporting and counterparty identification.']
  minimum_balance_requirement decimal(18,2) [note: 'Minimum balance that must be maintained in the account to avoid fees or restrictions, in the account currency.']
  notes varchar [note: 'Free-text field for additional operational notes, special instructions, or account-specific details.']
  overdraft_allowed_flag boolean [note: 'Indicates whether the account is permitted to have a negative balance (overdraft facility).']
  overdraft_limit_amount decimal(18,2) [note: 'Maximum negative balance permitted on this account, in the account currency.']
  reconciliation_frequency varchar [note: 'Frequency at which this account is reconciled between internal records and custodian statements.']
  regulatory_reporting_flag boolean [note: 'Indicates whether transactions in this account are subject to regulatory reporting requirements (EMIR, MiFID II, etc.).']
  sweep_arrangement_flag boolean [note: 'Indicates whether this account participates in an automated cash sweep arrangement to optimize liquidity.']
  sweep_threshold_amount decimal(18,2) [note: 'Balance threshold above which excess cash is automatically swept to the target account.']
  updated_timestamp timestamp [note: 'Timestamp when this cash account record was last modified.']

  Note: 'Master record for each cash and settlement account maintained at custodian banks (State Street, Northern Trust) and internal treasury accounts. Captures account number, BIC/SWIFT, IBAN, correspondent bank details, currency, account type (settlement'
}

Table treasury.liquidity_forecast {
  liquidity_forecast_id varchar [pk, note: 'Unique identifier for the liquidity forecast record.']
  approved_by_user_employee_id varchar [note: 'Identifier of the treasury manager or authorized approver who approved the liquidity forecast for publication.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Pension fund liquidity stress testing requires modeling cash flows under multiple economic scenarios (baseline, adverse, severely adverse).']
  employee_id varchar [note: 'Identifier of the treasury analyst or system user who prepared the liquidity forecast.']
  liability_cash_flow_id varchar [note: 'Foreign key linking to actuarial.liability_cash_flow. Business justification: Granular liquidity forecasting requires detailed liability cash flow projections by period.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Pension liquidity forecasting requires projected benefit payment outflows from actuarial liability projections.']
  liquidity_reserve_policy_id varchar [note: 'Foreign key linking to treasury.liquidity_reserve_policy. Business justification: Liquidity forecasts are governed by liquidity reserve policies. Links forecast to applicable policy.']
  liquidity_risk_assessment_id varchar [note: 'Foreign key linking to risk.liquidity_risk_assessment. Business justification: Liquidity forecasts inform and are validated against liquidity risk assessments.']
  superseded_by_forecast_liquidity_forecast_id varchar [note: 'Reference to the subsequent liquidity forecast that supersedes this forecast, enabling version tracking and audit trail.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Liquidity forecasts must align with valuation cycles for pension fund cash planning. Forecasted cash needs are validated against NAV dates to ensure sufficient liquidity for benefit payments']
  approval_timestamp timestamp [note: 'The date and time when the liquidity forecast was approved by the authorized approver.']
  capital_call_funding_amount decimal(20,2) [note: 'Projected capital call drawdowns from private equity, infrastructure, real estate, and other illiquid commitments requiring cash funding during the forecast period.']
  closing_cash_position_amount decimal(20,2) [note: 'The projected ending cash and cash equivalents balance at the end of the forecast period, calculated as opening position plus net inflows minus net outflows.']
  collateral_movement_net_amount decimal(20,2) [note: 'Net cash impact from collateral posting and return requirements for derivatives, securities lending, and repo transactions.']
  created_timestamp timestamp [note: 'The date and time when the liquidity forecast record was first created in the system.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the forecast amounts are denominated (e.g., USD, GBP, EUR).']
  distribution_inflow_amount decimal(20,2) [note: 'Projected cash distributions from private market investments, including dividends, interest, and capital returns during the forecast period.']
  fee_expense_amount decimal(20,2) [note: 'Projected cash outflows for investment management fees, custody fees, advisory fees, and carried interest payments during the forecast period.']
  forecast_confidence_level varchar [note: 'The assessed confidence level in the accuracy of the forecast, based on data quality, market volatility, and assumption reliability.']
  forecast_date date [note: 'The as-of date for which this liquidity forecast is prepared, representing the base date from which forward projections are calculated.']
  forecast_horizon_end_date date [note: 'The end date of the forecast projection period.']
  forecast_horizon_start_date date [note: 'The start date of the forecast projection period.']
  forecast_methodology varchar [note: 'Description of the methodology and assumptions used to prepare the liquidity forecast, including statistical models, historical trends, and expert judgment.']
  forecast_reference_number varchar [note: 'Business identifier for the liquidity forecast, used for external reference and reporting.']
  forecast_scenario varchar [note: 'The scenario assumption under which the liquidity forecast is prepared, enabling stress testing and sensitivity analysis.']
  forecast_status varchar [note: 'Current lifecycle status of the liquidity forecast in the approval and publication workflow.']
  forecast_type varchar [note: 'Classification of the forecast by time horizon and purpose: short-term (T+1 to T+30), medium-term (T+30 to T+90), long-term (T+90 to T+365), strategic, tactical, or operational.']
  fx_hedge_settlement_amount decimal(20,2) [note: 'Projected cash flows from foreign exchange forward and swap settlements used for currency hedging during the forecast period.']
  last_modified_timestamp timestamp [note: 'The date and time when the liquidity forecast record was last updated or modified.']
  liquidity_surplus_deficit_amount decimal(20,2) [note: 'The projected surplus (positive) or deficit (negative) relative to the minimum liquidity threshold, indicating whether additional funding or investment actions are required.']
  minimum_liquidity_threshold_amount decimal(20,2) [note: 'The minimum cash balance required to meet operational needs, regulatory requirements, and risk management policies.']
  net_contribution_inflow_amount decimal(20,2) [note: 'Projected net contributions from beneficiary pools (one per participating plan) during the forecast period, net of benefit payments and withdrawals.']
  notes varchar [note: 'Free-text notes and commentary providing additional context, assumptions, risks, or qualifications related to the liquidity forecast.']
  opening_cash_position_amount decimal(20,2) [note: 'The starting cash and cash equivalents balance at the beginning of the forecast period, aggregated across all custody accounts and treasury instruments.']
  operational_expense_amount decimal(20,2) [note: 'Projected cash outflows for operational expenses including payroll, technology, facilities, and administrative costs.']
  other_inflow_amount decimal(20,2) [note: 'Projected cash inflows from other sources not categorized above, including tax refunds, legal settlements, and miscellaneous receipts.']
  other_outflow_amount decimal(20,2) [note: 'Projected cash outflows for other purposes not categorized above, including tax payments, legal settlements, and miscellaneous disbursements.']
  published_timestamp timestamp [note: 'The date and time when the liquidity forecast was published and made available to stakeholders.']
  short_term_investment_maturity_amount decimal(20,2) [note: 'Projected cash inflows from maturing short-term liquidity instruments such as Treasury Bills (T-Bills), commercial paper, and SOFR-linked instruments.']
  short_term_investment_purchase_amount decimal(20,2) [note: 'Projected cash outflows for purchasing short-term liquidity instruments to manage excess cash.']
  trade_settlement_net_amount decimal(20,2) [note: 'Net cash impact from expected trade settlements across public equities, fixed income, and derivatives, calculated as settlement inflows minus outflows.']

  Note: 'Forward-looking liquidity projection records covering short-term (T+1 to T+30), medium-term (T+30 to T+90), and long-term (T+90 to T+365) horizons. Aggregates expected net contribution inflows from beneficiary pools (several participating plans'
}

Table treasury.net_contribution_inflow {
  net_contribution_inflow_id varchar [pk, note: 'Unique identifier for the net contribution inflow record.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Net contribution inflows are deposited into cash accounts; linking tracks the destination account.']
  contributor_pool_id varchar [note: 'Reference to the beneficiary pool from which the contribution originated (one per participating plan).']
  participating_employer_id varchar [note: 'Reference to the participating employer that remitted the contribution on behalf of members.']
  allocation_date date [note: 'The date on which the contribution was allocated to investment portfolios or asset classes.']
  allocation_status varchar [note: 'Indicates whether the net contribution has been allocated to investment strategies per the Strategic Asset Allocation (SAA).']
  base_currency_amount decimal(18,2) [note: 'Net contribution amount converted to the fund base currency using the applicable FX rate.']
  contribution_date date [note: 'The date on which the net contribution was received or credited to the fund.']
  contribution_period_end date [note: 'End date of the payroll or contribution period covered by this inflow.']
  contribution_period_start date [note: 'Start date of the payroll or contribution period covered by this inflow.']
  contribution_reference_number varchar [note: 'External reference number assigned to this contribution inflow by the custody platform or remittance system.']
  contribution_status varchar [note: 'Current lifecycle status of the contribution inflow in the treasury workflow.']
  contribution_type varchar [note: 'Classification of the contribution inflow by source or purpose.']
  created_timestamp timestamp [note: 'Timestamp when this contribution inflow record was first created in the treasury system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the contribution was received.']
  custody_account_number varchar [note: 'Account number at the custody platform where the contribution was received.']
  deduction_amount decimal(18,2) [note: 'Total amount deducted from the gross contribution for fees, taxes, or other adjustments.']
  fx_rate decimal(18,6) [note: 'Exchange rate applied if the contribution was received in a foreign currency and converted to the fund base currency.']
  gross_contribution_amount decimal(18,2) [note: 'Total contribution amount received before any deductions or adjustments.']
  liquidity_reserve_amount decimal(18,2) [note: 'Amount of the net contribution held in short-term liquidity instruments for cash management purposes.']
  liquidity_reserve_flag boolean [note: 'Indicates whether a portion of this contribution was held in liquidity reserves (T-Bills, SOFR-linked instruments) rather than immediately allocated.']
  member_count varchar [note: 'Number of individual members whose contributions are aggregated in this inflow record.']
  modified_timestamp timestamp [note: 'Timestamp when this contribution inflow record was last modified.']
  net_contribution_amount decimal(18,2) [note: 'Net investable capital after all deductions, representing the amount available for allocation to investment strategies.']
  notes varchar [note: 'Free-text notes or comments regarding the contribution inflow, exceptions, or special handling instructions.']
  reconciliation_date date [note: 'The date on which the contribution was successfully reconciled with custody records.']
  reconciliation_status varchar [note: 'Status of the reconciliation between the contribution record and custody platform settlement records.']
  remittance_method varchar [note: 'The payment method or channel through which the contribution was received.']
  remitting_institution_bic varchar [note: 'BIC or SWIFT code of the remitting financial institution.']
  remitting_institution_name varchar [note: 'Name of the financial institution or employer that remitted the contribution.']
  settlement_date date [note: 'The date on which the contribution cash settled in the custody account.']
  value_date date [note: 'The effective date from which the contribution begins accruing investment returns.']

  Note: 'Records of net pension contributions received from each beneficiary pool (one per participating plan) representing the primary source of investable capital.'
}

Table treasury.capital_call_funding {
  capital_call_funding_id varchar [pk, note: 'Unique identifier for the capital call funding record.']
  adjustment_id varchar [note: 'Reference to the payment confirmation document received from the General Partner (GP) or custodian bank.']
  bank_account_ssi_id varchar [note: 'Reference to the General Partner (GP) bank account receiving the capital call funding.']
  confirmation_document_id varchar [note: 'Reference to the payment confirmation document received from the General Partner (GP) or custodian bank.']
  dd_engagement_id varchar [note: 'Foreign key linking to diligence.dd_engagement. Business justification: Capital call funding requires verification that the underlying investment passed DD and IC approval. Treasury operations must confirm diligence clearance before releasing funds.']
  employee_id varchar [note: 'Reference to the treasury or investment committee user who approved the capital call funding.']
  fund_investment_id varchar [note: 'Reference to the private market fund investment that issued this capital call.']
  fx_forward_id varchar [note: 'Foreign key linking to treasury.fx_forward. Business justification: Capital call funding with FX hedge applied should link to the specific FX forward used for hedging.']
  fx_hedge_instrument_id varchar [note: 'Reference to the foreign exchange forward or swap instrument used to hedge this capital call funding.']
  gp_bank_account_id varchar [note: 'Reference to the General Partner (GP) bank account receiving the capital call funding.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Capital call funding requires direct GP identification for payment routing, call verification, and GP communication.']
  infra_fund_commitment_id varchar [note: 'Foreign key linking to infrastructure.infra_fund_commitment. Business justification: Capital call funding is linked to the fund commitment to track capital call execution.']
  source_cash_account_id varchar [note: 'Reference to the internal cash account from which the capital call funding was sourced.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Capital call funding links to asset valuations for tracking cost basis versus fair value.']
  approval_workflow_reference varchar [note: 'Reference to the internal approval workflow instance for this capital call funding.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the pension fund base currency.']
  call_amount_requested decimal(18,2) [note: 'Total capital amount requested by the General Partner (GP) in the fund currency.']
  call_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the capital call amount.']
  call_due_date date [note: 'Date by which the capital call funding must be received by the General Partner (GP) per the Limited Partnership Agreement (LPA).']
  call_notice_date date [note: 'Date the capital call notice was issued by the General Partner (GP).']
  call_notice_number varchar [note: 'External reference number assigned by the General Partner (GP) to the capital call notice.']
  call_purpose_description varchar [note: 'Business purpose or investment use case for the capital call as stated by the General Partner (GP).']
  call_type varchar [note: 'Classification of the capital call purpose per Limited Partnership Agreement (LPA) terms.']
  commitment_percentage_called decimal(5,2) [note: 'Percentage of the total Limited Partner (LP) commitment being called in this drawdown.']
  created_timestamp timestamp [note: 'Timestamp when the capital call funding record was first created in the system.']
  custodian_reference_number varchar [note: 'Reference number assigned by the custody platform for tracking the capital call funding settlement.']
  default_interest_rate decimal(5,2) [note: 'Annual interest rate applied to late capital call payments per Limited Partnership Agreement (LPA) terms.']
  funding_amount_base_currency decimal(18,2) [note: 'Capital call funding amount converted to the pension fund base currency for accounting.']
  funding_approval_date date [note: 'Date the capital call funding was approved by internal treasury or investment committee.']
  funding_execution_date date [note: 'Date the capital call funding payment was executed and sent to the General Partner (GP).']
  funding_priority varchar [note: 'Internal priority level assigned to this capital call funding based on strategic importance and liquidity constraints.']
  funding_settlement_date date [note: 'Date the capital call funding payment settled in the General Partner (GP) account per confirmation.']
  funding_status varchar [note: 'Current workflow status of the capital call funding process.']
  fx_hedge_applied_flag boolean [note: 'Indicates whether a foreign exchange hedge instrument was used to mitigate currency risk for this funding.']
  fx_rate decimal(12,6) [note: 'Foreign exchange rate applied to convert call currency to base currency at funding execution.']
  gp_account_number varchar [note: 'Bank account number of the General Partner (GP) receiving the capital call funding.']
  gp_bank_name varchar [note: 'Name of the bank holding the General Partner (GP) account for this capital call.']
  gp_swift_bic_code varchar [note: 'SWIFT Bank Identifier Code (BIC) for the General Partner (GP) receiving bank.']
  late_payment_penalty_amount decimal(18,2) [note: 'Penalty amount incurred if the capital call funding is not received by the due date per Limited Partnership Agreement (LPA).']
  liquidity_source varchar [note: 'Source of liquidity used to fund the capital call within the pension fund treasury operations.']
  notes varchar [note: 'Additional operational notes or comments related to the capital call funding workflow.']
  payment_method varchar [note: 'Payment instrument used to transfer the capital call funding to the General Partner (GP).']
  payment_reference_number varchar [note: 'Unique reference number assigned by the treasury system or bank for the payment transaction.']
  reconciliation_date date [note: 'Date the capital call funding was reconciled with General Partner (GP) records and custody platform.']
  reconciliation_status varchar [note: 'Status of the reconciliation between internal funding records and General Partner (GP) confirmation.']
  rejection_reason varchar [note: 'Explanation provided if the capital call funding was rejected or cancelled by internal treasury.']
  updated_timestamp timestamp [note: 'Timestamp when the capital call funding record was last modified.']

  Note: 'Operational records tracking the funding workflow for private market capital calls (drawdowns) issued by GPs across private equity, infrastructure, real estate, and natural resources funds.'
}

Table treasury.fx_position {
  fx_position_id varchar [pk, note: 'Unique identifier for the foreign exchange position record.']
  hedge_program_id varchar [note: 'Foreign key linking to treasury.hedge_program. Business justification: FX positions are managed under hedge programs. Links position to governing hedge program.']
  portfolio_id varchar [note: 'Reference to the investment portfolio holding this FX position.']
  base_currency varchar [note: 'Three-letter ISO 4217 code for the base currency of the position (e.g., USD for US Dollar).']
  collateral_posted_base decimal(20,2) [note: 'Total collateral posted to counterparties under Credit Support Annex (CSA) agreements for FX derivative positions in this currency pair.']
  collateral_received_base decimal(20,2) [note: 'Total collateral received from counterparties under CSA agreements for FX derivative positions in this currency pair.']
  comments varchar [note: 'Free-text field for treasury analysts to record notes, exceptions, or special circumstances related to this FX position.']
  counterparty_concentration_pct decimal(5,4) [note: 'Percentage of total hedge notional concentrated with the largest single counterparty for this currency pair, used for counterparty risk monitoring.']
  created_timestamp timestamp [note: 'Timestamp when this FX position record was first created in the system.']
  currency_pair varchar [note: 'Standard currency pair notation combining base and quote currencies (e.g., EUR/USD).']
  data_source_system varchar [note: 'Source system from which the FX position data was extracted (e.g., SimCorp Dimension, BlackRock Aladdin, custody platform).']
  dv01_base decimal(20,2) [note: 'Sensitivity of the FX position value to a 1 basis point move in the exchange rate, expressed in base currency.']
  forward_hedge_notional_base decimal(20,2) [note: 'Aggregate notional amount of FX forward contracts used to hedge exposure, expressed in base currency.']
  hedge_designation varchar [note: 'Accounting hedge designation classification under IFRS 9 for the FX hedging relationship.']
  hedge_effectiveness_ratio decimal(5,4) [note: 'Measure of hedge effectiveness per IFRS 9, calculated as the ratio of hedge instrument value change to hedged item value change.']
  hedge_ratio_actual decimal(5,4) [note: 'Current hedge ratio expressed as a decimal, calculated as total hedge notional divided by spot exposure (e.g., 0.9500 represents 95% hedged).']
  hedge_ratio_target decimal(5,4) [note: 'Strategic target hedge ratio as defined by treasury policy for this currency pair, expressed as a decimal.']
  hedge_ratio_variance decimal(5,4) [note: 'Difference between actual and target hedge ratios, indicating over-hedging (positive) or under-hedging (negative).']
  last_rebalance_date date [note: 'Most recent date when the FX hedge position was rebalanced to align with target hedge ratio.']
  mtm_value_base decimal(20,2) [note: 'Current mark-to-market valuation of all FX hedging instruments for this currency pair, expressed in base currency.']
  net_open_exposure_base decimal(20,2) [note: 'Net unhedged FX exposure after accounting for all hedging instruments, calculated as spot exposure minus total hedge notional.']
  next_scheduled_rebalance_date date [note: 'Planned date for the next periodic hedge rebalancing review per treasury calendar.']
  option_hedge_notional_base decimal(20,2) [note: 'Aggregate notional amount of FX option contracts used to hedge exposure, expressed in base currency.']
  position_date date [note: 'Business date for which this FX position snapshot is recorded.']
  position_owner varchar [note: 'Name or identifier of the treasury desk or portfolio manager responsible for managing this FX position.']
  position_status varchar [note: 'Current operational status of the FX position record in the treasury management system.']
  quote_currency varchar [note: 'Three-letter ISO 4217 code for the quote currency in the currency pair (e.g., USD for US Dollar).']
  rebalance_required_flag boolean [note: 'Indicator whether the position requires rebalancing to bring actual hedge ratio back within target tolerance bands.']
  rebalance_threshold_breach_date date [note: 'Date when the hedge ratio variance first exceeded the policy-defined tolerance threshold, triggering rebalance requirement.']
  regulatory_reporting_flag boolean [note: 'Indicator whether this FX position is subject to regulatory reporting requirements under EMIR, MiFID II, or other jurisdictional mandates.']
  spot_exposure_base decimal(20,2) [note: 'Total unhedged foreign exchange exposure in base currency terms arising from underlying asset holdings.']
  spot_rate decimal(12,6) [note: 'Current market spot exchange rate for the currency pair as of position date.']
  swap_hedge_notional_base decimal(20,2) [note: 'Aggregate notional amount of FX swap contracts used to hedge exposure, expressed in base currency.']
  total_hedge_notional_base decimal(20,2) [note: 'Sum of all FX hedging instrument notionals (forwards, swaps, options) in base currency.']
  unrealized_pnl_base decimal(20,2) [note: 'Unrealized gain or loss on FX hedging instruments since inception, expressed in base currency.']
  updated_timestamp timestamp [note: 'Timestamp when this FX position record was last modified.']
  var_1day_95pct_base decimal(20,2) [note: 'One-day Value at Risk at 95% confidence level for the net open FX exposure, expressed in base currency.']
  weighted_avg_forward_rate decimal(12,6) [note: 'Notional-weighted average forward rate across all outstanding FX forward hedge contracts for this currency pair.']

  Note: 'Master record of the fund\'s aggregate foreign exchange exposure by currency pair, capturing spot exposure, forward hedge notional, net open exposure, hedge ratio, and target hedge ratio per currency.'
}

Table treasury.fx_forward {
  fx_forward_id varchar [pk, note: 'Unique identifier for the FX forward contract record.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: FX forward contracts are settled against a cash account; linking provides direct access to settlement details.']
  csa_agreement_csa_id varchar [note: 'Reference to the Credit Support Annex that governs collateral posting requirements for this forward contract.']
  csa_id varchar [note: 'Reference to the Credit Support Annex that governs collateral posting requirements for this forward contract.']
  employee_id varchar [note: 'Employee identifier of the treasury trader who executed the forward contract.']
  fx_position_id varchar [note: 'Foreign key linking to treasury.fx_position. Business justification: FX forward contracts contribute to aggregate FX position. Links forward to its position record for exposure tracking.']
  hedge_program_id varchar [note: 'Foreign key linking to treasury.hedge_program. Business justification: FX forwards are executed as part of hedge programs. Links forward to governing hedge program for program-level reporting.']
  isda_master_agreement_isda_master_id varchar [note: 'Reference to the ISDA Master Agreement governing the legal terms of this derivative transaction.']
  isda_master_id varchar [note: 'Reference to the ISDA Master Agreement governing the legal terms of this derivative transaction.']
  netting_agreement_id varchar [note: 'Identifier for the group of transactions with the same counterparty that are subject to close-out netting under the ISDA agreement.']
  netting_set_netting_agreement_id varchar [note: 'Identifier for the group of transactions with the same counterparty that are subject to close-out netting under the ISDA agreement.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or asset class that generated the currency exposure being hedged.']
  treasury_fx_rate_id varchar [note: 'Foreign key linking to treasury.treasury_fx_rate. Business justification: FX forward contracts reference the applicable treasury FX rate for pricing; linking ensures rate consistency.']
  approval_authority varchar [note: 'Name or role of the individual or committee that approved the execution of this forward contract.']
  approval_date date [note: 'Date on which the forward contract was approved by the designated authority.']
  booking_timestamp timestamp [note: 'Date and time when the forward contract was recorded in the treasury management system.']
  buy_amount decimal(20,2) [note: 'Notional amount of the currency being purchased, denominated in the buy currency.']
  buy_currency varchar [note: 'Three-letter ISO 4217 currency code for the currency being purchased in the forward contract.']
  central_counterparty_name varchar [note: 'Name of the central clearing house if the contract is centrally cleared.']
  clearing_status varchar [note: 'Indicates whether the forward contract is centrally cleared through a CCP or remains bilateral.']
  collateral_currency varchar [note: 'Three-letter ISO 4217 currency code for the currency in which collateral is posted.']
  collateral_posted_amount decimal(20,2) [note: 'Amount of collateral posted by the pension fund to the counterparty to secure the forward contract, denominated in the collateral currency.']
  contract_status varchar [note: 'Current lifecycle status of the FX forward contract.']
  counterparty_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier for the financial institution counterparty to the FX forward contract.']
  counterparty_name varchar [note: 'Legal name of the financial institution or bank acting as counterparty to the forward contract.']
  created_timestamp timestamp [note: 'System timestamp when this record was first created in the data platform.']
  custodian_name varchar [note: 'Name of the custody bank or settlement agent facilitating the currency exchange.']
  forward_points decimal(18,8) [note: 'Difference between the forward rate and the spot rate at inception, representing the interest rate differential between the two currencies.']
  forward_rate decimal(18,8) [note: 'Agreed exchange rate at which the currency pair will be exchanged on the value date, expressed as units of sell currency per unit of buy currency.']
  hedge_designation varchar [note: 'Accounting hedge classification under IFRS 9 or equivalent standard, indicating the type of hedge relationship.']
  hedge_effectiveness_test_method varchar [note: 'Methodology used to assess whether the hedge relationship qualifies for hedge accounting treatment.']
  hedge_ratio decimal(5,4) [note: 'Proportion of the underlying currency exposure that this forward contract is intended to hedge, expressed as a decimal.']
  mark_to_market_value decimal(20,2) [note: 'Current fair value of the forward contract based on prevailing market rates, denominated in the base currency.']
  maturity_date date [note: 'Final date of the forward contract when the obligation must be fulfilled or the contract expires.']
  mtm_valuation_date date [note: 'Date as of which the mark-to-market value was last calculated.']
  realized_gain_loss decimal(20,2) [note: 'Actual profit or loss realized upon settlement or early termination of the forward contract.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this forward contract is subject to regulatory reporting requirements under EMIR, Dodd-Frank, or equivalent.']
  sell_amount decimal(20,2) [note: 'Notional amount of the currency being sold, denominated in the sell currency.']
  sell_currency varchar [note: 'Three-letter ISO 4217 currency code for the currency being sold in the forward contract.']
  settlement_account_buy varchar [note: 'Bank account or custody account identifier where the purchased currency will be received upon settlement.']
  settlement_account_sell varchar [note: 'Bank account or custody account identifier from which the sold currency will be debited upon settlement.']
  settlement_method varchar [note: 'Mechanism by which the forward contract will be settled at maturity.']
  spot_rate_at_inception decimal(18,8) [note: 'Market spot exchange rate for the currency pair at the time the forward contract was executed.']
  termination_date date [note: 'Date on which the forward contract was terminated early, if applicable.']
  termination_reason varchar [note: 'Business reason for early termination of the forward contract, such as change in hedge strategy or underlying exposure elimination.']
  trade_confirmation_date date [note: 'Date on which the trade confirmation was received and validated by both parties.']
  trade_date date [note: 'Date on which the FX forward contract was executed and agreed upon by both parties.']
  trade_reference_number varchar [note: 'External business identifier for the FX forward trade, typically assigned by the trading platform or counterparty.']
  trading_desk varchar [note: 'Internal treasury or trading desk responsible for executing and managing this FX forward contract.']
  underlying_exposure_type varchar [note: 'Nature of the currency exposure being hedged, such as foreign equity investment, private equity commitment, real estate acquisition, or infrastructure asset.']
  unique_transaction_identifier varchar [note: 'Globally unique identifier for the transaction as required by regulatory reporting frameworks.']
  unrealized_gain_loss decimal(20,2) [note: 'Cumulative unrealized profit or loss on the forward contract since inception, based on current market rates.']
  updated_timestamp timestamp [note: 'System timestamp when this record was last modified in the data platform.']
  value_date date [note: 'Settlement date when the currency exchange will occur and funds will be transferred.']

  Note: 'Transactional record for each FX forward contract executed to hedge currency exposure arising from non-base-currency investments. Captures trade date, value date, maturity date, buy currency, sell currency, notional amount, forward rate, spot rate at inception'
}

Table treasury.fx_swap {
  fx_swap_id varchar [pk, note: 'Unique identifier for the FX swap transaction record.']
  counterparty_id varchar [note: 'Reference to the financial institution or entity serving as the counterparty to this FX swap transaction.']
  custody_account_id varchar [note: 'Reference to the custody account at State Street or Northern Trust through which the FX swap cash flows will be settled.']
  employee_id varchar [note: 'Reference to the individual trader or portfolio manager who executed this FX swap transaction.']
  fx_position_id varchar [note: 'Foreign key linking to treasury.fx_position. Business justification: FX swap contracts contribute to aggregate FX position. Links swap to its position record for exposure tracking.']
  hedge_program_id varchar [note: 'Foreign key linking to treasury.hedge_program. Business justification: FX swaps are used to roll hedges as part of hedge programs. Links swap to governing hedge program.']
  isda_agreement_isda_master_id varchar [note: 'Reference to the master ISDA agreement governing this FX swap transaction, establishing legal terms and credit support arrangements.']
  isda_master_id varchar [note: 'Reference to the master ISDA agreement governing this FX swap transaction, establishing legal terms and credit support arrangements.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or fund to which this FX swap is allocated for performance attribution and risk reporting.']
  treasury_fx_rate_id varchar [note: 'Foreign key linking to treasury.treasury_fx_rate. Business justification: FX swap rates should reference treasury_fx_rate for rate source traceability and audit.']
  accrued_interest_amount decimal(20,4) [note: 'The interest differential that has accrued on the swap position since trade date, reflecting the time value component of the swap points.']
  base_currency_code varchar [note: 'The base currency in the FX swap pair, representing the currency being bought or sold in the near leg.']
  ccp_name varchar [note: 'Name of the central clearing house if the swap is centrally cleared (e.g., LCH, CME), null for bilateral trades.']
  clearing_status varchar [note: 'Indicates whether the FX swap is cleared through a Central Counterparty (CCP) or remains bilateral, per EMIR clearing obligations.']
  confirmation_status varchar [note: 'Status of trade confirmation with the counterparty, tracking whether economic terms have been mutually agreed and documented.']
  confirmation_timestamp timestamp [note: 'Timestamp when the FX swap trade confirmation was received and matched with the counterparty.']
  counterparty_lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier of the counterparty, required for regulatory reporting under EMIR and MiFID II.']
  created_timestamp timestamp [note: 'Timestamp when this FX swap record was first created in the system.']
  csa_applicable_flag boolean [note: 'Indicates whether a Credit Support Annex is in place for this swap, governing collateral posting requirements.']
  currency_pair varchar [note: 'The two currencies involved in the swap expressed as base currency / quote currency (e.g., USD/JPY, EUR/USD), following ISO 4217 three-letter codes.']
  execution_venue varchar [note: 'The platform or venue through which the FX swap was executed (e.g., Bloomberg FXGO, direct counterparty negotiation, electronic trading platform).']
  far_leg_base_amount decimal(20,4) [note: 'Notional amount of the base currency exchanged in the far leg of the swap.']
  far_leg_date date [note: 'Settlement date for the second leg of the FX swap, typically the later of the two exchange dates, reversing the near leg transaction.']
  far_leg_direction varchar [note: 'Direction of the base currency transaction in the far leg: opposite of near leg direction to complete the swap structure.']
  far_leg_exchange_rate decimal(18,8) [note: 'The agreed FX rate applied to the far leg transaction, expressed as quote currency per unit of base currency.']
  far_leg_quote_amount decimal(20,4) [note: 'Notional amount of the quote currency exchanged in the far leg of the swap.']
  far_leg_settlement_timestamp timestamp [note: 'Actual timestamp when the far leg cash flows were settled through the custody account.']
  hedge_designation varchar [note: 'Accounting hedge designation under IFRS 9 or equivalent standard, determining how gains and losses are recognized in financial statements.']
  hedge_ratio decimal(8,4) [note: 'The proportion of the underlying currency exposure that this FX swap is intended to hedge, expressed as a decimal (e.g., 1.0000 for 100% hedge).']
  hedged_item_reference varchar [note: 'Business reference to the underlying exposure being hedged (e.g., foreign equity position, private equity commitment, infrastructure asset), linking the swap to its economic purpose.']
  last_modified_timestamp timestamp [note: 'Timestamp when this FX swap record was last updated, supporting audit trail and data lineage requirements.']
  mark_to_market_value decimal(20,4) [note: 'Current fair value of the FX swap position based on prevailing market rates, used for NAV calculation and risk reporting.']
  mtm_currency_code varchar [note: 'The currency in which the mark-to-market value is expressed, typically the funds base currency.']
  mtm_valuation_date date [note: 'The date as of which the mark-to-market value was calculated, typically the most recent business day.']
  near_leg_base_amount decimal(20,4) [note: 'Notional amount of the base currency exchanged in the near leg of the swap.']
  near_leg_date date [note: 'Settlement date for the first leg of the FX swap, typically the earlier of the two exchange dates.']
  near_leg_direction varchar [note: 'Direction of the base currency transaction in the near leg: buy indicates purchasing base currency, sell indicates selling base currency.']
  near_leg_exchange_rate decimal(18,8) [note: 'The agreed FX rate applied to the near leg transaction, expressed as quote currency per unit of base currency.']
  near_leg_quote_amount decimal(20,4) [note: 'Notional amount of the quote currency exchanged in the near leg of the swap.']
  near_leg_settlement_timestamp timestamp [note: 'Actual timestamp when the near leg cash flows were settled through the custody account.']
  notes varchar [note: 'Free-text field for operational notes, special instructions, or context regarding the FX swap execution and purpose.']
  quote_currency_code varchar [note: 'The quote currency in the FX swap pair, representing the counter-currency used to price the base currency.']
  reporting_timestamp timestamp [note: 'Timestamp when this FX swap transaction was reported to the trade repository, meeting EMIR T+1 reporting requirements.']
  settlement_method varchar [note: 'The method by which the FX swap will be settled: physical delivery involves actual currency exchange, cash settlement involves net payment, netting offsets multiple positions.']
  settlement_status varchar [note: 'Tracks the settlement progress of both legs of the FX swap through the custody platform.']
  swap_points decimal(12,8) [note: 'The difference between the far leg and near leg exchange rates, representing the interest rate differential between the two currencies over the swap tenor.']
  swap_reference_number varchar [note: 'External business identifier for the FX swap contract, used for operational reference and reconciliation with counterparties and custody platforms.']
  swap_status varchar [note: 'Current lifecycle status of the FX swap transaction in the trade execution and settlement workflow.']
  swap_type varchar [note: 'Classification of the FX swap purpose: hedge roll extends existing FX forward hedges, liquidity management addresses short-term currency needs, collateral adjustment manages margin requirements, tactical positioning captures opportunistic currency views.']
  trade_date date [note: 'The date on which the FX swap transaction was executed and agreed between counterparties.']
  trade_timestamp timestamp [note: 'Precise timestamp when the FX swap was executed, capturing time-of-day for regulatory reporting and audit trail purposes.']
  trading_desk varchar [note: 'The internal trading desk or business unit responsible for executing and managing this FX swap (e.g., Treasury Desk, Currency Overlay Team).']
  unique_transaction_identifier varchar [note: 'Globally unique identifier assigned to this FX swap for regulatory trade reporting under EMIR and MiFID II, ensuring consistent cross-border identification.']

  Note: 'Transactional record for FX swap contracts used to roll FX forward hedges or manage short-term currency liquidity needs. Captures near leg and far leg details (dates, rates, notionals), currency pair, counterparty, ISDA agreement reference, purpose (hedge'
}

Table treasury.hedge_program {
  hedge_program_id varchar [pk, note: 'Unique identifier for the foreign exchange (FX) hedging program. Primary key.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: FX hedge programs require scenario analysis for effectiveness testing and stress testing (hedge_program.stress_test_scenario exists).']
  employee_id varchar [note: 'Identifier of the treasury or investment committee member who approved the establishment or modification of this hedging program.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Pension funds must demonstrate ESG-aligned hedging per SFDR/PRI requirements. Links hedge programs to governing ESG policy for compliance reporting and audit trail.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: Treasury hedge programs (FX, interest rate) must align with actuarial LDI strategy defining hedge_ratio_target and duration_target_years.']
  var_limit_id varchar [note: 'Foreign key linking to risk.limit. Business justification: Hedge programs operate within VaR and DV01 risk limits. Business process: Hedge program compliance monitoring requires checking program exposures against approved risk limits for governance and']
  approval_timestamp timestamp [note: 'Date and time when the hedging program was formally approved by the investment committee or treasury governance body.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the fund\'s reporting currency (typically USD).']
  benchmark_rate decimal(18,2) [note: 'Reference interest rate used for pricing hedging instruments (e.g., SOFR, CORRA, EURIBOR, SONIA).']
  collateral_posting_threshold_amount decimal(18,2) [note: 'Minimum mark-to-market (MTM) exposure amount that triggers collateral posting under Credit Support Annex (CSA) agreements.']
  counterparty_concentration_limit_percent decimal(5,2) [note: 'Maximum percentage of total hedge notional that can be allocated to a single counterparty, enforcing diversification.']
  created_timestamp timestamp [note: 'System timestamp when this hedge program record was first created in the data platform.']
  effectiveness_test_frequency varchar [note: 'Frequency at which hedge effectiveness testing is performed for accounting and compliance purposes.']
  esg_alignment_flag boolean [note: 'Indicates whether the hedging program incorporates ESG considerations or aligns with responsible investment principles.']
  hedge_accounting_treatment varchar [note: 'Accounting classification under IFRS 9 or equivalent standard for hedge effectiveness and financial reporting.']
  hedge_effectiveness_test_method varchar [note: 'Methodology used to assess whether the hedging relationship qualifies for hedge accounting under IFRS 9.']
  hedged_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the foreign currency exposure being hedged.']
  last_effectiveness_test_date date [note: 'Most recent date on which hedge effectiveness testing was performed for accounting compliance.']
  last_effectiveness_test_result varchar [note: 'Outcome of the most recent hedge effectiveness test, determining continued eligibility for hedge accounting treatment.']
  last_modified_timestamp timestamp [note: 'System timestamp when this hedge program record was last updated in the data platform.']
  last_rebalance_date date [note: 'Most recent date on which the hedge ratio was rebalanced to align with target parameters.']
  maximum_hedge_ratio_percent decimal(5,2) [note: 'Upper bound of the permitted hedge ratio band. Triggers rebalancing if actual hedge ratio exceeds this threshold.']
  maximum_time_to_maturity_days varchar [note: 'Maximum tenor in days for hedging instruments under this program, limiting long-dated exposure and roll risk.']
  minimum_hedge_ratio_percent decimal(5,2) [note: 'Lower bound of the permitted hedge ratio band. Triggers rebalancing if actual hedge ratio falls below this threshold.']
  minimum_time_to_maturity_days varchar [note: 'Minimum tenor in days for hedging instruments under this program, ensuring alignment with liquidity and funding horizons.']
  next_scheduled_rebalance_date date [note: 'Next scheduled date for reviewing and potentially rebalancing the hedge ratio.']
  notes varchar [note: 'Free-text field for additional context, special instructions, or operational notes related to the hedging program.']
  permitted_instruments varchar [note: 'Comma-separated list of derivative instruments permitted under this program (e.g., FX forwards, FX swaps, currency options, cross-currency swaps).']
  program_inception_date date [note: 'Date on which the hedging program was first established and became operational.']
  program_name varchar [note: 'Descriptive name of the hedging program, identifying the currency exposure or asset class being hedged.']
  program_objective varchar [note: 'Strategic objective of the hedging program, such as reducing currency volatility, protecting NAV, or stabilizing cash flows.']
  program_reference_code varchar [note: 'Business-facing unique reference code for the hedging program, typically formatted as HP-{CURRENCY}-{YEAR}.']
  program_status varchar [note: 'Current lifecycle status of the hedging program.']
  program_termination_date date [note: 'Date on which the hedging program was formally terminated or is scheduled to terminate. Null for active programs.']
  program_type varchar [note: 'Classification of the hedging program by the type of exposure being managed.']
  rebalancing_frequency varchar [note: 'Scheduled frequency for reviewing and rebalancing the hedge ratio to maintain alignment with target parameters.']
  rebalancing_trigger_threshold_bps varchar [note: 'Deviation threshold in basis points from the target hedge ratio that triggers a rebalancing action.']
  regulatory_reporting_requirement varchar [note: 'Applicable regulatory reporting obligations for this hedging program (e.g., EMIR trade reporting, MiFID II transaction reporting).']
  risk_limit_var_amount decimal(18,2) [note: 'Maximum Value at Risk (VaR) permitted for the hedging program, expressed in base currency, as a risk management constraint.']
  roll_strategy varchar [note: 'Strategy for rolling maturing hedge positions into new contracts to maintain continuous hedge coverage.']
  stress_test_scenario varchar [note: 'Description of the macroeconomic or market stress scenario applied to test the resilience of the hedging program.']
  target_hedge_ratio_percent decimal(5,2) [note: 'Strategic target hedge ratio expressed as a percentage of the total foreign currency exposure (e.g., 50.00 means 50% of exposure is hedged).']
  var_confidence_level_percent decimal(5,2) [note: 'Statistical confidence level used for VaR calculation (e.g., 95.00 or 99.00 percent).']
  var_time_horizon_days varchar [note: 'Time horizon in days over which VaR is calculated for risk monitoring (commonly 1 or 10 days).']

  Note: 'Master record defining the FX hedging program parameters for each currency or asset class exposure. Captures target hedge ratio, permitted hedge ratio band (min/max), hedging instruments allowed (forwards, swaps, options), rebalancing trigger thresholds'
}

Table treasury.hedge_effectiveness {
  hedge_effectiveness_id varchar [pk, note: 'Unique identifier for the hedge effectiveness assessment record.']
  approved_by_user_employee_id varchar [note: 'Reference to the finance or risk committee member who approved the hedge effectiveness assessment.']
  employee_id varchar [note: 'Reference to the treasury or risk management user who prepared the hedge effectiveness assessment.']
  hedge_program_id varchar [note: 'Reference to the overarching hedge program or strategy under which this effectiveness assessment is performed.']
  hedging_instrument_id varchar [note: 'Reference to the derivative or financial instrument used as the hedging instrument in this hedge relationship.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: IFRS 9/ASC 815 hedge accounting requires documenting the hedged item. For pension funds, the hedged item is liabilities per LDI strategy.']
  reviewed_by_user_employee_id varchar [note: 'Reference to the senior treasury or finance user who reviewed the hedge effectiveness assessment.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Hedge effectiveness testing must align with valuation cycles for hedge accounting compliance. Pension funds assess hedge effectiveness at each valuation date per IFRS 9/ASC 815 requirements.']
  approval_timestamp timestamp [note: 'The date and time when the hedge effectiveness assessment was formally approved.']
  assessment_date date [note: 'The date on which the hedge effectiveness assessment was performed.']
  assessment_methodology_description varchar [note: 'Detailed narrative describing the specific methodology, assumptions, and data sources used to perform the hedge effectiveness assessment.']
  assessment_period_end_date date [note: 'The end date of the period covered by this hedge effectiveness assessment.']
  assessment_period_start_date date [note: 'The start date of the period covered by this hedge effectiveness assessment.']
  assessment_reference_number varchar [note: 'Business identifier for the hedge effectiveness assessment, used for external reporting and audit trails.']
  assessment_status varchar [note: 'Current lifecycle status of the hedge effectiveness assessment record.']
  assessment_type varchar [note: 'Type of hedge effectiveness assessment: prospective (forward-looking), retrospective (historical), or combined.']
  created_timestamp timestamp [note: 'The date and time when this hedge effectiveness assessment record was first created in the system.']
  critical_terms_match_flag boolean [note: 'Indicates whether the critical terms of the hedging instrument and hedged item match, supporting a qualitative assessment of effectiveness.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this assessment.']
  discontinuation_date date [note: 'The date on which hedge accounting was discontinued for this hedge relationship, if applicable.']
  discontinuation_flag boolean [note: 'Indicates whether hedge accounting has been discontinued for this hedge relationship.']
  discontinuation_reason varchar [note: 'Business explanation for why hedge accounting was discontinued, such as failure to meet effectiveness criteria or hedge objective no longer valid.']
  dollar_offset_ratio decimal(10,4) [note: 'The ratio of cumulative change in fair value of the hedging instrument to cumulative change in fair value of the hedged item, used in dollar-offset method.']
  effectiveness_ratio decimal(10,4) [note: 'Quantitative ratio measuring the degree of offset between changes in fair value or cash flows of the hedging instrument and the hedged item, typically expressed as a percentage.']
  external_auditor_reviewed_flag boolean [note: 'Indicates whether this hedge effectiveness assessment has been reviewed by external auditors as part of financial statement audit.']
  hedge_accounting_model varchar [note: 'The type of hedge accounting model applied under IFRS 9: fair value hedge, cash flow hedge, or net investment hedge.']
  hedge_ratio decimal(10,4) [note: 'The ratio of the quantity of hedging instrument to the quantity of hedged item, used to determine the hedge relationship structure.']
  hedge_relationship_designation_date date [note: 'The date on which the hedge relationship was formally designated for hedge accounting purposes.']
  hedged_item_fair_value_change_amount decimal(18,2) [note: 'The change in fair value of the hedged item during the assessment period, used to calculate effectiveness.']
  hedged_item_reference varchar [note: 'Reference to the asset, liability, or forecasted transaction that is being hedged.']
  hedged_item_type varchar [note: 'Classification of the risk exposure being hedged in this hedge relationship.']
  hedging_instrument_fair_value_change_amount decimal(18,2) [note: 'The change in fair value of the hedging instrument during the assessment period, used to calculate effectiveness.']
  hedging_instrument_type varchar [note: 'Classification of the hedging instrument used in the hedge relationship.']
  ineffectiveness_amount decimal(18,2) [note: 'The portion of the hedge that is deemed ineffective and must be recognized immediately in profit or loss under IFRS 9.']
  last_modified_timestamp timestamp [note: 'The date and time when this hedge effectiveness assessment record was last updated.']
  next_assessment_due_date date [note: 'The scheduled date for the next periodic hedge effectiveness assessment, typically quarterly or as required by policy.']
  notes varchar [note: 'Free-text field for additional commentary, observations, or qualitative factors relevant to the hedge effectiveness assessment.']
  prospective_effectiveness_result varchar [note: 'Outcome of the prospective hedge effectiveness test indicating whether the hedge is expected to be highly effective.']
  prospective_test_method varchar [note: 'The quantitative or qualitative method used to assess prospective hedge effectiveness.']
  rebalancing_date date [note: 'The date on which the hedge relationship was rebalanced to restore effectiveness, if applicable.']
  rebalancing_required_flag boolean [note: 'Indicates whether the hedge relationship requires rebalancing to maintain hedge effectiveness under IFRS 9.']
  regression_r_squared decimal(10,6) [note: 'The coefficient of determination from regression analysis, measuring the proportion of variance in the hedged item explained by the hedging instrument.']
  regression_slope decimal(10,6) [note: 'The slope coefficient from regression analysis, indicating the sensitivity of the hedged item to changes in the hedging instrument.']
  retrospective_effectiveness_result varchar [note: 'Outcome of the retrospective hedge effectiveness test indicating whether the hedge was highly effective during the assessment period.']
  retrospective_test_method varchar [note: 'The quantitative or qualitative method used to assess retrospective hedge effectiveness.']

  Note: 'Periodic assessment records of FX hedge effectiveness under IFRS 9 hedge accounting requirements. Captures assessment date, hedge program reference, hedging instrument, hedged item, prospective effectiveness test method (regression, dollar-offset)'
}

Table treasury.short_term_instrument {
  short_term_instrument_id varchar [pk, note: 'Unique identifier for the short-term liquidity instrument record.']
  approval_user_employee_id varchar [note: 'Identifier of the user who approved the investment in the short-term instrument.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Money market instruments (CP, CDs, repos) require counterparty tracking for credit risk limits and concentration monitoring.']
  employee_id varchar [note: 'Identifier of the treasury trader or portfolio manager who executed the purchase of the instrument.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Pension funds screen ALL investments for ESG including money market/liquidity instruments.']
  accrued_interest_amount decimal(18,2) [note: 'Interest earned but not yet paid on the instrument since the last coupon payment or purchase date.']
  approval_timestamp timestamp [note: 'Date and time when the investment was approved by the authorized approver.']
  benchmark_rate_type varchar [note: 'Reference rate or benchmark to which the instrument yield is linked, such as SOFR or fixed rate.']
  bloomberg_ticker varchar [note: 'Bloomberg ticker symbol used for market data retrieval and pricing.']
  collateral_flag boolean [note: 'Indicates whether the instrument is pledged as collateral for derivatives or other obligations.']
  coupon_rate_percent decimal(8,5) [note: 'Annual interest rate paid by the instrument, expressed as a percentage of face value.']
  created_timestamp timestamp [note: 'Date and time when the short-term instrument record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code in which the instrument is denominated.']
  current_market_value_amount decimal(18,2) [note: 'Current mark-to-market valuation of the instrument based on latest pricing.']
  cusip varchar [note: 'CUSIP identifier for North American securities, used for trade settlement and custody.']
  custodian_account_number varchar [note: 'Account number at the custodian where the instrument is held.']
  custodian_name varchar [note: 'Name of the custodian bank or institution holding the instrument on behalf of the pension fund.']
  days_to_maturity varchar [note: 'Number of calendar days remaining until the instrument reaches maturity.']
  discount_rate_percent decimal(8,5) [note: 'Rate at which the instrument was purchased at a discount to face value, applicable to discount instruments like T-Bills.']
  esg_compliant_flag boolean [note: 'Indicates whether the instrument meets the pension fund ESG investment criteria and responsible investment standards.']
  face_value_amount decimal(18,2) [note: 'Par or face value of the instrument that will be repaid at maturity.']
  instrument_credit_rating varchar [note: 'Specific credit rating assigned to this instrument issuance by rating agencies.']
  instrument_reference_number varchar [note: 'External business identifier or reference number assigned to the short-term instrument by the treasury system or custodian.']
  instrument_status varchar [note: 'Current lifecycle status of the short-term instrument position.']
  instrument_type varchar [note: 'Classification of the short-term liquidity instrument held in the treasury portfolio. [ENUM-REF-CANDIDATE: t_bill|commercial_paper|bankers_acceptance|money_market_fund|sofr_linked|repo|reverse_repo — 7 candidates stripped; promote to reference product]']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the instrument globally.']
  issue_date date [note: 'Original date on which the instrument was issued by the issuer.']
  issuer_credit_rating varchar [note: 'Credit rating assigned to the issuer by major rating agencies, indicating creditworthiness.']
  issuer_lei varchar [note: 'Legal Entity Identifier of the issuer for regulatory reporting and counterparty identification.']
  issuer_name varchar [note: 'Legal name of the entity that issued the short-term instrument.']
  last_modified_timestamp timestamp [note: 'Date and time when the short-term instrument record was last updated.']
  liquidity_tier varchar [note: 'Classification of the instrument based on its liquidity profile and ease of conversion to cash.']
  maturity_date date [note: 'Date on which the instrument matures and principal is repaid to the holder.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or contextual information about the instrument.']
  portfolio_allocation_strategy varchar [note: 'Strategic purpose for holding this instrument within the treasury portfolio.']
  purchase_date date [note: 'Date on which the short-term instrument was acquired by the treasury portfolio.']
  purchase_price_amount decimal(18,2) [note: 'Total amount paid to acquire the instrument, including any premium or discount.']
  quantity decimal(18,4) [note: 'Number of units or shares of the instrument held in the portfolio.']
  sedol varchar [note: 'SEDOL code for securities traded on London Stock Exchange and other UK markets.']
  settlement_date date [note: 'Date on which the purchase transaction settled and cash was exchanged for the instrument.']
  spread_over_benchmark_bps varchar [note: 'Additional yield spread over the benchmark rate, expressed in basis points.']
  trade_reference_number varchar [note: 'Unique reference number assigned to the original purchase trade by the order management system.']
  unrealized_gain_loss_amount decimal(18,2) [note: 'Difference between current market value and purchase price, representing unrealized profit or loss.']
  valuation_date date [note: 'Date on which the current market value and accrued interest were last calculated.']
  valuation_source varchar [note: 'Source system or vendor providing the market valuation for the instrument, such as Bloomberg or custodian pricing.']
  yield_to_maturity_percent decimal(8,5) [note: 'Annualized rate of return if the instrument is held to maturity, accounting for purchase price and coupon payments.']

  Note: 'Master record for short-term liquidity instruments held in the treasury portfolio including T-Bills, SOFR-linked instruments, commercial paper, bankers acceptances, and money market fund units.'
}

Table treasury.st_instrument_transaction {
  st_instrument_transaction_id varchar [pk, note: 'Unique identifier for the short-term instrument transaction record.']
  approved_by_user_employee_id varchar [note: 'Identifier of the user who approved the transaction for execution, if pre-approval is required.']
  broker_id varchar [note: 'Foreign key linking to trade.broker. Business justification: Money market transactions (T-bills, CP, repo) execute through approved brokers. Treasury teams track broker relationships for best execution analysis and counterparty concentration monitoring.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Short-term instrument transactions require counterparty identification for settlement risk management and credit exposure tracking.']
  employee_id varchar [note: 'Identifier of the trader or portfolio manager who executed the transaction.']
  short_term_instrument_id varchar [note: 'Foreign key linking to treasury.short_term_instrument. Business justification: Transactions for short-term instruments should FK to the instrument master. Removes redundant instrument_identifier and instrument_type which can be retrieved via JOIN.']
  accrued_interest_amount decimal(18,2) [note: 'Interest accrued on the instrument from the last coupon payment date to the trade date, paid by the buyer to the seller.']
  actual_settlement_date date [note: 'Actual date on which the transaction settled, may differ from scheduled settlement date due to operational factors.']
  booking_timestamp timestamp [note: 'Date and time when the transaction was booked into the investment book of record.']
  confirmation_timestamp timestamp [note: 'Date and time when the transaction was confirmed by the counterparty or custodian.']
  consideration_amount decimal(18,2) [note: 'Total cash amount paid or received for the transaction, excluding fees and accrued interest.']
  created_timestamp timestamp [note: 'Date and time when this transaction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the transaction is denominated.']
  cusip varchar [note: 'Nine-character alphanumeric code identifying the security in North American markets.']
  custodian_account_number varchar [note: 'Account number at the custodian bank where the securities are held and settled.']
  custodian_name varchar [note: 'Name of the custodian bank holding the securities and processing settlement.']
  days_to_maturity varchar [note: 'Number of calendar days from trade date to maturity date.']
  discount_rate_percent decimal(8,4) [note: 'Discount rate applied to the face value for discount instruments such as Treasury Bills, expressed as a percentage.']
  external_transaction_reference varchar [note: 'Transaction identifier assigned by the external counterparty, broker, or custodian system for reconciliation purposes.']
  face_value_amount decimal(18,2) [note: 'Par or nominal value of the short-term instrument at issuance or maturity.']
  isin varchar [note: 'Twelve-character alphanumeric code uniquely identifying the security globally.']
  last_modified_timestamp timestamp [note: 'Date and time when this transaction record was last updated or modified.']
  maturity_date date [note: 'Date on which the short-term instrument matures and principal is repaid.']
  net_settlement_amount decimal(18,2) [note: 'Total net cash amount to be settled, including consideration, accrued interest, and fees.']
  notes varchar [note: 'Free-text notes or comments providing additional context or operational details about the transaction.']
  portfolio_code varchar [note: 'Internal code identifying the investment portfolio or fund to which this transaction is allocated.']
  quantity decimal(18,4) [note: 'Number of units or nominal amount of the instrument transacted.']
  settlement_date date [note: 'Date on which the transaction is scheduled to settle and cash and securities are exchanged.']
  settlement_location varchar [note: 'Name of the central securities depository or settlement system where the transaction settles.']
  settlement_method varchar [note: 'Method of settlement: Delivery Versus Payment, Free of Payment, or Receive Versus Payment.']
  strategy_code varchar [note: 'Code identifying the investment strategy or mandate under which this transaction was executed.']
  trade_date date [note: 'Date on which the transaction was executed or agreed upon.']
  transaction_fee_amount decimal(18,2) [note: 'Fees charged by brokers, custodians, or intermediaries for executing and settling the transaction.']
  transaction_reference_number varchar [note: 'Externally-known unique reference number assigned to this short-term instrument transaction for operational tracking and reconciliation.']
  transaction_status varchar [note: 'Current lifecycle status of the transaction in the settlement workflow.']
  transaction_type varchar [note: 'Type of transaction executed on the short-term instrument: purchase, sale, maturity, rollover, redemption, or interest payment.']
  unit_price decimal(18,6) [note: 'Price per unit of the instrument at which the transaction was executed.']
  yield_to_maturity_percent decimal(8,4) [note: 'Annualized yield to maturity of the instrument at the time of transaction, expressed as a percentage.']

  Note: 'Transactional records for purchases, maturities, sales, and rollovers of short-term liquidity instruments (T-Bills, SOFR-linked, commercial paper). Captures transaction type, trade date, settlement date, instrument reference, face value, consideration'
}

Table treasury.cash_transfer {
  cash_transfer_id varchar [pk, note: 'Unique identifier for the cash transfer transaction.']
  capital_call_funding_id varchar [note: 'Foreign key linking to treasury.capital_call_funding. Business justification: Cash transfers funding capital calls should link to the capital_call_funding workflow record.']
  counterparty_id varchar [note: 'Identifier of the external counterparty involved in the transfer, such as a fund manager, broker, or beneficiary.']
  destination_account_cash_account_id varchar [note: 'Identifier of the cash account to which funds are being transferred.']
  destination_custodian_id varchar [note: 'Identifier of the custodian or banking institution holding the destination account.']
  distribution_receipt_id varchar [note: 'Foreign key linking to treasury.distribution_receipt. Business justification: Cash transfers receiving distributions should link to the distribution_receipt record.']
  employee_id varchar [note: 'Identifier of the treasury user who approved the transfer for execution.']
  fx_forward_id varchar [note: 'Foreign key linking to treasury.fx_forward. Business justification: Cash transfers settling FX forwards should link to the forward contract being settled.']
  fx_swap_id varchar [note: 'Foreign key linking to treasury.fx_swap. Business justification: Cash transfers settling FX swaps should link to the swap contract being settled.']
  initiated_by_user_employee_id varchar [note: 'Identifier of the treasury user who initiated the cash transfer request.']
  margin_call_id varchar [note: 'Foreign key linking to collateral.margin_call. Business justification: Cash transfers are initiated to satisfy margin calls under CSA agreements. Direct linkage enables audit trail from margin call to funding execution, essential for collateral operations']
  pe_investment_id varchar [note: 'Identifier of the investment transaction that triggered this cash transfer, such as a capital call or distribution.']
  primary_cash_account_id varchar [note: 'Identifier of the cash account from which funds are being transferred.']
  related_fx_hedge_hedge_program_id varchar [note: 'Identifier of the FX forward or swap position being settled through this cash transfer.']
  related_trade_blotter_id varchar [note: 'Identifier of the trade execution that requires this cash transfer for settlement purposes.']
  reversed_transfer_cash_transfer_id varchar [note: 'Identifier of the original cash transfer that this transfer reverses.']
  source_custodian_id varchar [note: 'Identifier of the custodian or banking institution holding the source account.']
  standing_settlement_instruction_id varchar [note: 'Foreign key linking to trade.standing_settlement_instruction. Business justification: Cash transfers require SSIs for payment routing instructions. Operations teams use SSIs to ensure correct beneficiary details, correspondent banks, and settlement']
  treasury_fx_rate_id varchar [note: 'Foreign key linking to treasury.treasury_fx_rate. Business justification: Cash transfer FX rates should reference treasury_fx_rate for rate source traceability.']
  approval_required_flag boolean [note: 'Indicates whether the transfer requires explicit approval before execution based on amount thresholds or transfer type.']
  approval_timestamp timestamp [note: 'Date and time when the transfer was approved by the authorized treasury user.']
  counterparty_lei varchar [note: '20-character Legal Entity Identifier of the counterparty as per ISO 17442 standard.']
  created_timestamp timestamp [note: 'Date and time when the cash transfer record was first created in the system.']
  destination_account_number varchar [note: 'External account number of the destination cash account as maintained by the custodian or banking institution.']
  destination_currency_code varchar [note: 'Three-letter ISO currency code of the destination account for FX transfers.']
  failure_reason varchar [note: 'Detailed explanation of why the transfer failed, including error codes and messages from the payment system.']
  fee_amount decimal(18,2) [note: 'Total fees charged for executing the cash transfer, including wire fees, custodian fees, and intermediary bank charges.']
  fx_rate decimal(18,8) [note: 'Exchange rate applied if the transfer involves currency conversion between source and destination accounts.']
  initiation_timestamp timestamp [note: 'Date and time when the cash transfer was initiated by treasury operations.']
  intermediary_bank_bic varchar [note: 'SWIFT Bank Identifier Code of any intermediary bank involved in routing the transfer.']
  intermediary_bank_name varchar [note: 'Name of the intermediary bank used for routing the transfer between source and destination institutions.']
  last_modified_timestamp timestamp [note: 'Date and time when the cash transfer record was last updated in the system.']
  net_transfer_amount decimal(18,2) [note: 'Net monetary amount transferred after deducting all fees and adjustments.']
  notes varchar [note: 'Additional free-text notes or comments recorded by treasury operations regarding the transfer.']
  payment_channel varchar [note: 'System or interface through which the transfer was initiated: custody platform, treasury workstation, banking portal, or manual entry.']
  payment_method varchar [note: 'Payment instrument used to execute the transfer: wire transfer, ACH, SWIFT, SEPA, internal book transfer, or check.']
  priority_level varchar [note: 'Processing priority assigned to the transfer: standard, urgent, same-day, or next-day settlement.']
  purpose_description varchar [note: 'Detailed business purpose or reason for the cash transfer, such as capital call funding for Fund XYZ or distribution receipt from ABC Investment.']
  remittance_information varchar [note: 'Unstructured payment reference information provided to the beneficiary for reconciliation purposes.']
  reversal_reason varchar [note: 'Business justification for reversing a previously settled transfer, such as erroneous payment or counterparty request.']
  settlement_confirmation_number varchar [note: 'Confirmation reference number provided by the custodian or banking institution upon successful settlement.']
  settlement_date date [note: 'Actual date when the cash transfer settled and funds were exchanged between accounts.']
  source_account_number varchar [note: 'External account number of the source cash account as maintained by the custodian or banking institution.']
  source_currency_code varchar [note: 'Three-letter ISO currency code of the source account for FX transfers.']
  transfer_amount decimal(18,2) [note: 'Gross monetary amount being transferred before any fees or adjustments.']
  transfer_currency_code varchar [note: 'Three-letter ISO currency code of the transfer amount (e.g., USD, EUR, GBP).']
  transfer_reference_number varchar [note: 'Externally-known unique reference number assigned to this cash transfer for tracking and reconciliation purposes.']
  transfer_status varchar [note: 'Current lifecycle status of the cash transfer: initiated, pending approval, approved, in transit, settled, failed, cancelled, or reversed. [ENUM-REF-CANDIDATE: initiated|pending_approval|approved|in_transit|settled|failed|cancelled|reversed — 8 candidates']
  transfer_type varchar [note: 'Classification of the cash transfer by business purpose: internal sweep, custodian-to-custodian transfer, capital call wire payment, distribution receipt, FX settlement, collateral movement, fee payment, or contribution receipt.']
  value_date date [note: 'Effective date when the cash transfer is valued and impacts cash positions for accounting and liquidity purposes.']

  Note: 'Operational record for each internal and external cash movement initiated by treasury, including inter-account and overnight/threshold-triggered sweeps, custodian-to-custodian transfers, capital call wire payments, distribution receipts, and FX settlement'
}

Table treasury.cash_reconciliation {
  cash_reconciliation_id varchar [pk, note: 'Unique identifier for the cash reconciliation record.']
  approved_by_user_employee_id varchar [note: 'Reference to the treasury manager or controller who approved the reconciliation and any adjustments.']
  cash_account_id varchar [note: 'Reference to the cash account being reconciled.']
  cash_position_id varchar [note: 'Foreign key linking to treasury.cash_position. Business justification: Cash reconciliation compares IBOR position to custodian. Links reconciliation to the specific cash position being reconciled.']
  custodian_id varchar [note: 'Reference to the custodian institution (State Street or Northern Trust) providing the cash balance report.']
  employee_id varchar [note: 'Reference to the treasury operations user who prepared or reviewed the reconciliation.']
  reviewed_by_user_employee_id varchar [note: 'Reference to the senior treasury user who performed secondary review of the reconciliation.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Cash reconciliations are mandatory before NAV finalization. Pension fund operations must complete cash reconciliation within each valuation cycle to ensure accurate NAV reporting to trustees.']
  approval_timestamp timestamp [note: 'Timestamp when the reconciliation was formally approved by authorized treasury management.']
  auto_reconciled_flag boolean [note: 'Indicates whether the reconciliation was automatically matched by system rules without manual intervention.']
  closing_balance_variance_amount decimal(20,4) [note: 'Difference between IBOR and custodian closing balances (IBOR minus custodian).']
  created_timestamp timestamp [note: 'Timestamp when the reconciliation record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cash position being reconciled.']
  custodian_closing_balance_amount decimal(20,4) [note: 'Closing cash balance reported by custodian (State Street or Northern Trust) at end of reconciliation date.']
  custodian_file_received_timestamp timestamp [note: 'Timestamp when custodian cash position file was received and loaded into reconciliation system.']
  custodian_opening_balance_amount decimal(20,4) [note: 'Opening cash balance reported by custodian (State Street or Northern Trust) at start of reconciliation date.']
  custodian_statement_date date [note: 'Date of the custodian statement used for reconciliation, may differ from reconciliation date due to reporting lag.']
  custodian_statement_reference varchar [note: 'Custodian-provided statement or report reference number used as source for custodian balances.']
  custodian_transaction_count varchar [note: 'Number of cash transactions reported by custodian for the reconciliation date.']
  escalation_required_flag boolean [note: 'Indicates whether the variance exceeds tolerance and requires escalation to senior treasury or finance management.']
  fee_difference_amount decimal(20,4) [note: 'Variance attributed to custody fees, transaction fees, or other charges recorded differently.']
  fx_revaluation_difference_amount decimal(20,4) [note: 'Variance attributed to foreign exchange revaluation methodology differences between IBOR and custodian.']
  ibor_closing_balance_amount decimal(20,4) [note: 'Closing cash balance from internal IBOR system (SimCorp Dimension) at end of reconciliation date.']
  ibor_extract_timestamp timestamp [note: 'Timestamp when IBOR cash position data was extracted from SimCorp Dimension for reconciliation.']
  ibor_opening_balance_amount decimal(20,4) [note: 'Opening cash balance from internal IBOR system (SimCorp Dimension) at start of reconciliation date.']
  ibor_transaction_count varchar [note: 'Number of cash transactions recorded in IBOR system for the reconciliation date.']
  interest_accrual_difference_amount decimal(20,4) [note: 'Variance attributed to interest accrual calculation differences between IBOR and custodian.']
  last_modified_timestamp timestamp [note: 'Timestamp when the reconciliation record was last updated, reflecting status changes or adjustments.']
  manual_adjustment_required_flag boolean [note: 'Indicates whether manual journal entries or adjustments are required to resolve the variance.']
  matched_transaction_amount decimal(20,4) [note: 'Total value of successfully matched transactions between IBOR and custodian.']
  matched_transaction_count varchar [note: 'Number of transactions successfully matched between IBOR and custodian records.']
  opening_balance_variance_amount decimal(20,4) [note: 'Difference between IBOR and custodian opening balances (IBOR minus custodian).']
  reconciliation_date date [note: 'Business date for which the cash reconciliation is performed, typically the prior business day close.']
  reconciliation_reference_number varchar [note: 'Business identifier for the reconciliation record, typically system-generated or custodian-provided reference.']
  reconciliation_run_timestamp timestamp [note: 'Timestamp when the automated reconciliation matching process was executed.']
  reconciliation_status varchar [note: 'Current lifecycle status of the reconciliation record in the workflow. [ENUM-REF-CANDIDATE: pending|in_progress|matched|unmatched|partially_matched|approved|rejected|escalated — 8 candidates stripped; promote to reference product]']
  reconciliation_type varchar [note: 'Classification of the reconciliation by frequency and business purpose.']
  resolution_notes varchar [note: 'Detailed explanation of variance causes, reconciling items identified, and resolution actions taken.']
  settlement_difference_amount decimal(20,4) [note: 'Variance attributed to settlement timing or DVP processing differences.']
  timing_difference_amount decimal(20,4) [note: 'Variance attributed to timing differences in transaction recording between IBOR and custodian systems.']
  tolerance_threshold_amount decimal(20,4) [note: 'Maximum acceptable variance amount before escalation is required, defined by treasury policy.']
  tolerance_threshold_bps varchar [note: 'Maximum acceptable variance in basis points relative to account balance before escalation is required.']
  unexplained_variance_amount decimal(20,4) [note: 'Remaining variance after all identified reconciling items have been accounted for.']
  unmatched_custodian_transaction_amount decimal(20,4) [note: 'Total value of custodian transactions with no corresponding IBOR record.']
  unmatched_custodian_transaction_count varchar [note: 'Number of custodian transactions with no corresponding IBOR record.']
  unmatched_ibor_transaction_amount decimal(20,4) [note: 'Total value of IBOR transactions with no corresponding custodian record.']
  unmatched_ibor_transaction_count varchar [note: 'Number of IBOR transactions with no corresponding custodian record.']
  within_tolerance_flag boolean [note: 'Indicates whether the reconciliation variance is within acceptable tolerance thresholds.']

  Note: 'Daily reconciliation records comparing internal IBOR cash positions (SimCorp Dimension) against custodian-reported cash balances (State Street / Northern Trust) by account and currency.'
}

Table treasury.treasury_fx_rate {
  treasury_fx_rate_id varchar [pk, note: 'Unique identifier for the FX rate record. Primary key for the treasury FX rate reference data table.']
  superseded_by_rate_treasury_fx_rate_id varchar [note: 'Reference to the treasury FX rate record that supersedes this rate, enabling navigation through rate history and audit trail of rate changes.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the base currency in the currency pair (e.g., USD in USD/JPY).']
  bid_ask_spread_bps decimal(10,4) [note: 'The difference between ask and bid rates expressed in basis points, representing the transaction cost and market liquidity for the currency pair.']
  created_timestamp timestamp [note: 'Timestamp when this FX rate record was first created in the treasury system, supporting audit trail and data lineage tracking.']
  cross_rate_flag boolean [note: 'Boolean flag indicating whether this rate is a cross rate calculated from two USD pairs rather than a directly quoted market rate (e.g., EUR/JPY derived from EUR/USD and USD/JPY).']
  currency_pair varchar [note: 'Standard currency pair notation combining base and quote currencies (e.g., USD/JPY, EUR/USD) following market convention for FX trading and hedging.']
  effective_end_timestamp timestamp [note: 'Timestamp until which this FX rate remains effective, after which it is superseded by a newer rate. Null for currently active rates, supporting temporal validity and rate history.']
  effective_start_timestamp timestamp [note: 'Timestamp from which this FX rate becomes effective for valuation and hedge accounting purposes, supporting temporal validity and historical rate reconstruction.']
  fixing_time timestamp [note: 'The standard market fixing time for this rate (e.g., 4:00 PM London, 10:00 AM New York), used for benchmark rate determination and hedge accounting compliance.']
  forward_points_1m decimal(12,6) [note: 'Forward points for one-month tenor, used to calculate the one-month forward FX rate for hedging monthly cash flows, capital calls, and distributions.']
  forward_points_1w decimal(12,6) [note: 'Forward points for one-week tenor, representing the interest rate differential between the two currencies. Added to spot rate to derive the one-week forward rate for hedging short-term FX exposure.']
  forward_points_1y decimal(12,6) [note: 'Forward points for one-year tenor, used to calculate the one-year forward FX rate for hedging annual exposures and long-term strategic currency hedges.']
  forward_points_3m decimal(12,6) [note: 'Forward points for three-month tenor, used to calculate the three-month forward FX rate for hedging quarterly exposures and medium-term currency risk.']
  forward_points_6m decimal(12,6) [note: 'Forward points for six-month tenor, used to calculate the six-month forward FX rate for hedging semi-annual exposures and medium-term currency positions.']
  inversion_flag boolean [note: 'Boolean flag indicating whether this rate has been inverted from the source systems native quotation to match internal portfolio reporting convention (e.g., converting EUR/USD to USD/EUR).']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this FX rate record, supporting change tracking and audit trail for data corrections or restatements.']
  market_convention varchar [note: 'Indicates whether the rate follows direct quotation (domestic currency per unit of foreign currency) or indirect quotation (foreign currency per unit of domestic currency) convention.']
  notes varchar [note: 'Free-text field for additional context, explanations of unusual rate movements, data quality issues, or special handling instructions for this FX rate observation.']
  published_timestamp timestamp [note: 'Timestamp when the rate was officially published or made available by the source provider, used for audit trail and data lineage tracking.']
  quote_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the quote currency in the currency pair (e.g., JPY in USD/JPY).']
  rate_date date [note: 'The business date for which this FX rate is effective. Used for valuation, hedge accounting, and settlement calculations.']
  rate_quality_flag boolean [note: 'Data quality indicator for the FX rate: verified for confirmed rates, unverified for preliminary rates, estimated for interpolated or calculated rates, or stale for rates exceeding freshness threshold.']
  rate_reference_code varchar [note: 'Unique business identifier for this FX rate observation, typically combining currency pair, rate date, and source identifier for external reference and reconciliation.']
  rate_source varchar [note: 'The external data provider or central bank that published this FX rate (e.g., Bloomberg, Reuters, European Central Bank, Bank of Canada, Federal Reserve, or custom internal calculation).']
  rate_source_identifier varchar [note: 'The unique identifier or ticker symbol used by the source system to reference this FX rate (e.g., Bloomberg ticker USDCAD Curncy), enabling traceability and reconciliation.']
  rate_status varchar [note: 'Current status of the FX rate record: active for current use, superseded by a later rate, preliminary for initial publication, final for confirmed rate, or restated for corrected historical rate.']
  rate_timestamp timestamp [note: 'Precise timestamp when the FX rate was observed or published by the source system, including time zone information for intraday rate tracking.']
  rate_type varchar [note: 'Classification of the FX rate type: spot for immediate delivery, forward for future delivery, swap for simultaneous spot and forward, or cross for non-USD pairs.']
  received_timestamp timestamp [note: 'Timestamp when the rate was received and ingested into the internal treasury system from the external source, used for latency monitoring and data freshness validation.']
  regulatory_reporting_flag boolean [note: 'Boolean flag indicating whether this rate is approved for use in regulatory reporting submissions to SEC, or other governing bodies, ensuring compliance with prescribed rate sources.']
  spot_ask_rate decimal(18,8) [note: 'The ask (offer) side of the spot FX rate, representing the rate at which the market maker will sell the base currency. Used for bid-ask spread analysis and transaction cost estimation.']
  spot_bid_rate decimal(18,8) [note: 'The bid side of the spot FX rate, representing the rate at which the market maker will buy the base currency. Used for bid-ask spread analysis and transaction cost estimation.']
  spot_mid_rate decimal(18,8) [note: 'The mid-point between bid and ask spot rates, calculated as the average of bid and ask. Commonly used for portfolio valuation and performance reporting.']
  spot_rate decimal(18,8) [note: 'The current market exchange rate for immediate delivery (typically T+2 settlement) of the currency pair, used for valuation and hedge ratio calculations.']
  triangulation_method varchar [note: 'Description of the calculation method used for cross rates, specifying the intermediate currency pairs and mathematical operations applied to derive the rate.']
  usage_context varchar [note: 'Description of the intended usage context for this rate (e.g., portfolio valuation, hedge accounting, settlement, performance reporting), supporting appropriate rate selection for different business processes.']
  volatility_30d decimal(10,4) [note: 'Thirty-day historical volatility of the currency pair expressed as an annualized percentage, used for risk assessment, VaR calculations, and option pricing.']

  Note: 'Reference data table for official FX spot rates and forward points by currency pair and tenor, sourced from Bloomberg. Captures rate date, currency pair, spot rate, bid/ask spread, forward points by tenor (1W, 1M, 3M, 6M, 1Y), rate source, and rate type'
}

Table treasury.counterparty_limit {
  counterparty_limit_id varchar [pk, note: 'Unique identifier for the treasury counterparty credit limit record.']
  counterparty_id varchar [note: 'Reference to the bank or dealer counterparty to which this limit applies.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Counterparty credit limits for FX/derivatives counterparties incorporate country risk assessment.']
  csa_agreement_csa_id varchar [note: 'Reference to the ISDA Credit Support Annex agreement governing collateral arrangements with this counterparty.']
  csa_id varchar [note: 'Reference to the ISDA Credit Support Annex agreement governing collateral arrangements with this counterparty.']
  employee_id varchar [note: 'Reference to the treasury officer or risk manager who approved this counterparty limit.']
  isda_master_agreement_isda_master_id varchar [note: 'Reference to the ISDA Master Agreement governing derivative transactions with this counterparty.']
  isda_master_id varchar [note: 'Reference to the ISDA Master Agreement governing derivative transactions with this counterparty.']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: AML regulations require pension funds to verify counterparty KYC status before establishing trading limits.']
  modified_by_user_employee_id varchar [note: 'Reference to the user who last modified this counterparty limit record.']
  risk_limit_id varchar [note: 'Foreign key linking to risk.limit. Business justification: Treasury counterparty limits must align with enterprise risk limit framework. Business process: Integrated limit monitoring ensures treasury limits are consistent with board-approved risk appetite']
  approval_authority_level varchar [note: 'Organizational authority level required to approve this limit: treasury officer, senior treasury manager, CFO, or board.']
  approval_date date [note: 'Date on which the counterparty limit was formally approved by authorized personnel.']
  available_amount decimal(20,2) [note: 'Remaining available limit capacity, calculated as limit amount minus utilized amount.']
  bic_swift_code varchar [note: 'ISO 9362 BIC/SWIFT code of the counterparty bank, used for payment routing and settlement instructions.']
  breach_action varchar [note: 'Automated action to be taken when the limit is breached: block new trades, alert only, require approval for new trades, or reduce exposure.']
  breach_count varchar [note: 'Total number of times this counterparty limit has been breached since inception or last reset.']
  collateral_required_flag boolean [note: 'Indicates whether collateral posting is required under a Credit Support Annex (CSA) for transactions under this limit.']
  concentration_limit_flag boolean [note: 'Indicates whether this limit is subject to additional concentration risk controls due to the counterparty\'s systemic importance.']
  created_timestamp timestamp [note: 'Timestamp when this counterparty limit record was first created in the system.']
  credit_rating varchar [note: 'Current credit rating of the counterparty from the specified rating agency, used to determine limit sizing.']
  credit_rating_agency varchar [note: 'The rating agency whose credit assessment is used as the basis for this limit: S&P, Moody\'s, Fitch, DBRS, or internal rating.']
  effective_date date [note: 'Date from which the counterparty limit becomes active and enforceable.']
  expiry_date date [note: 'Date on which the counterparty limit expires and is no longer enforceable; nullable for evergreen limits.']
  instrument_scope varchar [note: 'The treasury instrument types covered by this limit: FX forwards, FX swaps, FX spot, repo, reverse repo, money market instruments, or all instruments. [ENUM-REF-CANDIDATE: fx_forward|fx_swap|fx_spot|repo|reverse_repo|money_market|all_instruments — 7']
  internal_risk_classification varchar [note: 'Internal risk classification assigned to the counterparty based on credit quality, systemic importance, and concentration risk.']
  last_breach_date date [note: 'Date of the most recent breach of this counterparty limit, if any.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to this counterparty limit record.']
  last_review_date date [note: 'Date of the most recent periodic review of this counterparty limit.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier of the counterparty, used for regulatory reporting and entity identification.']
  limit_amount decimal(20,2) [note: 'Maximum permissible exposure amount to the counterparty, expressed in the limit currency.']
  limit_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the limit amount is denominated.']
  limit_reference_number varchar [note: 'Business identifier for the counterparty limit record, used for external communication and audit trails.']
  limit_status varchar [note: 'Current lifecycle status of the counterparty limit: active for operational use, suspended temporarily, expired, pending approval, or revoked.']
  limit_type varchar [note: 'Classification of the limit by risk measurement approach: credit exposure, settlement risk, pre-settlement exposure, aggregate exposure, intraday, or overnight.']
  minimum_rating_threshold varchar [note: 'Minimum acceptable credit rating for the counterparty; limit is suspended if rating falls below this threshold.']
  next_review_date date [note: 'Scheduled date for the next periodic review of this counterparty limit.']
  notes varchar [note: 'Free-text field for additional context, special conditions, or exceptions related to this counterparty limit.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this counterparty limit is subject to regulatory reporting requirements under EMIR, MiFID II, or local regulations.']
  review_frequency varchar [note: 'Scheduled frequency for periodic review and reaffirmation of the counterparty limit.']
  threshold_breach_percentage decimal(5,2) [note: 'Utilization percentage threshold at which a breach alert is triggered and new transactions may be blocked.']
  threshold_warning_percentage decimal(5,2) [note: 'Utilization percentage threshold at which a warning alert is triggered to treasury management.']
  utilization_percentage decimal(5,2) [note: 'Percentage of the limit currently utilized, expressed as a decimal (e.g., 75.50 for 75.5%).']
  utilized_amount decimal(20,2) [note: 'Current exposure amount utilized against the limit, calculated from outstanding positions and pending settlements.']

  Note: 'Treasury counterparty credit limit records defining the maximum permissible exposure to each bank or dealer counterparty for FX forwards, FX swaps, and short-term instrument transactions.'
}

Table treasury.treasury_counterparty_exposure {
  treasury_counterparty_exposure_id varchar [pk, note: 'Unique identifier for the treasury counterparty exposure record.']
  counterparty_id varchar [note: 'Reference to the financial institution or counterparty with whom the pension fund has treasury exposure.']
  counterparty_limit_id varchar [note: 'Foreign key linking to treasury.counterparty_limit. Business justification: Counterparty exposure is measured against counterparty limits. Links exposure record to applicable limit for breach monitoring.']
  country_outlook_id varchar [note: 'Foreign key linking to research.country_outlook. Business justification: Counterparty credit exposure assessment incorporates sovereign/country risk for foreign counterparties.']
  custodian_id varchar [note: 'Reference to the custody platform through which positions with this counterparty are settled and reported.']
  netting_agreement_id varchar [note: 'Foreign key linking to collateral.netting_agreement. Business justification: Net counterparty exposure calculations depend on applicable netting agreements.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code in which exposure amounts are reported.']
  collateral_held_amount decimal(20,2) [note: 'Market value of collateral received from the counterparty under Credit Support Annex (CSA) agreements.']
  collateral_posted_amount decimal(20,2) [note: 'Market value of collateral posted to the counterparty under Credit Support Annex (CSA) agreements.']
  counterparty_credit_rating varchar [note: 'Current external credit rating of the counterparty from a recognized rating agency.']
  counterparty_lei varchar [note: 'ISO 17442 Legal Entity Identifier for the counterparty, enabling global identification and regulatory reporting.']
  counterparty_type varchar [note: 'Classification of the counterparty by institutional type.']
  created_timestamp timestamp [note: 'Timestamp when this exposure record was first created in the system.']
  credit_valuation_adjustment_amount decimal(20,2) [note: 'Adjustment to the fair value of derivative positions to account for counterparty credit risk.']
  csa_agreement_flag boolean [note: 'Indicates whether a Credit Support Annex is in place with this counterparty for collateral management.']
  csa_minimum_transfer_amount decimal(20,2) [note: 'Minimum amount of collateral that must be transferred in a single movement under the CSA.']
  csa_threshold_amount decimal(20,2) [note: 'Exposure threshold amount below which collateral exchange is not required under the CSA.']
  exposure_date date [note: 'Business date for which the counterparty exposure is calculated and reported.']
  exposure_limit_amount decimal(20,2) [note: 'Maximum approved credit exposure limit for this counterparty as set by the Investment Committee or risk policy.']
  exposure_status varchar [note: 'Current operational status of the counterparty exposure relationship.']
  fx_forward_count varchar [note: 'Number of outstanding FX forward contracts with this counterparty.']
  fx_swap_count varchar [note: 'Number of outstanding FX swap contracts with this counterparty.']
  gross_mtm_exposure_amount decimal(20,2) [note: 'Total mark-to-market value of all positions with the counterparty before netting and collateral adjustments.']
  gross_notional_amount decimal(20,2) [note: 'Total notional value of all outstanding positions with the counterparty before netting.']
  isda_agreement_date date [note: 'Effective date of the ISDA Master Agreement with this counterparty.']
  isda_master_agreement_flag boolean [note: 'Indicates whether an ISDA Master Agreement is in place with this counterparty.']
  last_collateral_call_date date [note: 'Date of the most recent collateral call or margin call with this counterparty.']
  last_modified_timestamp timestamp [note: 'Timestamp when this exposure record was last updated.']
  last_reconciliation_date date [note: 'Date when the exposure was last reconciled with counterparty statements.']
  limit_breach_flag boolean [note: 'Indicator of whether the current exposure exceeds the approved counterparty limit.']
  limit_utilization_percentage decimal(5,2) [note: 'Percentage of the approved exposure limit currently utilized by the net credit exposure.']
  net_credit_exposure_amount decimal(20,2) [note: 'Final net credit exposure after netting and collateral adjustments, representing true counterparty credit risk.']
  net_mtm_exposure_amount decimal(20,2) [note: 'Net mark-to-market exposure after applying bilateral netting but before collateral adjustments.']
  netting_benefit_amount decimal(20,2) [note: 'Reduction in exposure achieved through bilateral netting agreements under ISDA Master Agreement.']
  next_collateral_review_date date [note: 'Scheduled date for the next collateral position review with this counterparty.']
  notes varchar [note: 'Free-text field for additional comments, exceptions, or context regarding the counterparty exposure.']
  potential_future_exposure_amount decimal(20,2) [note: 'Estimated maximum exposure that could arise in the future due to market movements, calculated using risk models.']
  rating_agency varchar [note: 'Credit rating agency that issued the counterparty credit rating.']
  reconciliation_status varchar [note: 'Status of reconciliation between internal exposure calculation and counterparty confirmation.']
  regulatory_capital_charge_amount decimal(20,2) [note: 'Regulatory capital requirement associated with this counterparty exposure under Basel III or local prudential rules.']
  risk_weight_percentage decimal(5,2) [note: 'Basel III risk weight applied to this counterparty exposure for regulatory capital calculation.']
  settlement_risk_flag boolean [note: 'Indicates whether settlement risk exists due to non-delivery-versus-payment settlement arrangements.']
  short_term_instrument_count varchar [note: 'Number of outstanding short-term liquidity instruments with this counterparty.']
  valuation_timestamp timestamp [note: 'Precise timestamp when the mark-to-market valuation was performed for this exposure record.']
  wrong_way_risk_flag boolean [note: 'Indicates whether wrong-way risk exists where counterparty credit quality is negatively correlated with exposure.']

  Note: 'Daily mark-to-market counterparty exposure records aggregating all outstanding FX forward, FX swap, and short-term instrument positions with each treasury counterparty.'
}

Table treasury.liquidity_reserve_policy {
  liquidity_reserve_policy_id varchar [pk, note: 'Unique identifier for the liquidity reserve policy record.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Liquidity reserve policies define stress thresholds (stress_scenario_type exists). Regulatory stress testing requires linking reserve requirements to specific economic scenarios.']
  employee_id varchar [note: 'Identifier of the user who approved this liquidity reserve policy.']
  funded_status_id varchar [note: 'Foreign key linking to actuarial.funded_status. Business justification: Liquidity reserve requirements vary based on plan funded status - underfunded plans require larger buffers for potential special contributions.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Pension fund liquidity requirements are mandated by specific regulators (PRA, FCA, local pension authorities).']
  superseded_by_policy_liquidity_reserve_policy_id varchar [note: 'Identifier of the liquidity reserve policy that supersedes this policy; nullable if current.']
  approval_authority varchar [note: 'Governance body or role with authority to approve this liquidity reserve policy.']
  approval_date date [note: 'Date on which the liquidity reserve policy was formally approved.']
  capital_call_reserve_percentage decimal(5,2) [note: 'Percentage of unfunded capital commitments to be held as liquidity reserve for capital call funding.']
  collateral_buffer_percentage decimal(5,2) [note: 'Percentage buffer for collateral posting requirements under derivative and repo agreements.']
  created_timestamp timestamp [note: 'Timestamp when the liquidity reserve policy record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which liquidity reserve amounts are denominated.']
  distribution_reserve_percentage decimal(5,2) [note: 'Percentage of expected beneficiary distributions to be held as liquidity reserve.']
  effective_date date [note: 'Date from which the liquidity reserve policy becomes binding and operational.']
  eligible_instrument_types varchar [note: 'Comma-separated list of eligible short-term liquidity instrument types under this policy. [ENUM-REF-CANDIDATE: t_bills|sofr_linked|commercial_paper|repo|money_market_funds|bank_deposits|government_bonds — promote to reference product]']
  escalation_procedure varchar [note: 'Description of the escalation procedure to be followed when liquidity thresholds are breached.']
  escalation_threshold_amount decimal(18,2) [note: 'Absolute liquidity shortfall amount that triggers escalation to senior management or Investment Committee (IC).']
  expiry_date date [note: 'Date on which the liquidity reserve policy ceases to be effective; nullable for open-ended policies.']
  fx_hedge_settlement_reserve_days varchar [note: 'Number of days of FX hedge settlement exposure to be covered by liquidity reserves.']
  last_modified_timestamp timestamp [note: 'Timestamp when the liquidity reserve policy record was last modified.']
  last_review_date date [note: 'Date of the most recent review of the liquidity reserve policy.']
  liquidity_tier_classification varchar [note: 'Classification of liquidity assets into tiers based on quality and convertibility to cash.']
  minimum_cash_buffer_amount decimal(18,2) [note: 'Minimum absolute cash reserve amount required to be maintained under this policy.']
  minimum_cash_buffer_percentage decimal(5,2) [note: 'Minimum cash reserve expressed as a percentage of Assets Under Management (AUM) or net contributions.']
  minimum_liquidity_coverage_ratio decimal(5,2) [note: 'Minimum acceptable liquidity coverage ratio below which escalation procedures are triggered.']
  net_stable_funding_ratio_target decimal(5,2) [note: 'Target ratio of available stable funding to required stable funding over a one-year horizon.']
  next_review_date date [note: 'Scheduled date for the next review of the liquidity reserve policy.']
  notes varchar [note: 'Additional notes, comments, or context regarding the liquidity reserve policy.']
  policy_document_uri varchar [note: 'URI or file path to the formal policy document for this liquidity reserve policy.']
  policy_name varchar [note: 'Descriptive name of the liquidity reserve policy.']
  policy_reference_number varchar [note: 'Externally-known unique reference number for the liquidity reserve policy.']
  policy_status varchar [note: 'Current lifecycle status of the liquidity reserve policy.']
  policy_type varchar [note: 'Classification of the liquidity reserve policy by purpose and scope.']
  rebalancing_frequency varchar [note: 'Frequency at which liquidity reserve positions are reviewed and rebalanced.']
  rebalancing_trigger_threshold_percentage decimal(5,2) [note: 'Percentage deviation from target liquidity levels that triggers rebalancing action.']
  regulatory_framework varchar [note: 'Name of the regulatory framework or standard to which this policy is aligned.']
  reporting_frequency varchar [note: 'Frequency at which liquidity reserve compliance is reported to governance bodies.']
  review_frequency varchar [note: 'Frequency at which the liquidity reserve policy is reviewed and updated.']
  short_term_instrument_maturity_limit_days varchar [note: 'Maximum maturity in days for short-term liquidity instruments eligible under this policy.']
  stress_liquidity_threshold_amount decimal(18,2) [note: 'Minimum cash reserve required under stress scenario conditions.']
  stress_scenario_type varchar [note: 'Type of stress scenario for which the stress liquidity threshold is calibrated.']
  target_liquidity_coverage_ratio decimal(5,2) [note: 'Target ratio of high-quality liquid assets to net cash outflows over a 30-day stress period.']

  Note: 'Master record defining the liquidity reserve policy parameters governing minimum cash buffer requirements, liquidity tier classifications, and stress liquidity thresholds.'
}

Table treasury.cash_flow_event {
  cash_flow_event_id varchar [pk, note: 'Unique identifier for the cash flow event record. Primary key for the cash flow event entity.']
  blotter_id varchar [note: 'Reference to the trade execution record if this event represents settlement of a trade transaction.']
  capital_call_funding_id varchar [note: 'Reference to the capital call notice if this event represents funding of a capital call commitment.']
  cash_account_id varchar [note: 'Reference to the specific cash account that will receive or disburse the cash flow.']
  counterparty_id varchar [note: 'Reference to the external counterparty entity involved in the cash flow event, such as a GP, custodian, or broker.']
  custodian_id varchar [note: 'Reference to the custodian bank or institution through which the cash flow event will settle.']
  distribution_id varchar [note: 'Reference to the distribution record if this event represents a distribution received from an investment.']
  distribution_receipt_id varchar [note: 'Foreign key linking to treasury.distribution_receipt. Business justification: Cash flow events from distributions should link to treasury distribution_receipt for treasury-side tracking.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Asset-liability management (ALM) requires projecting cash flow events under different economic scenarios.']
  employee_id varchar [note: 'Reference to the user who last modified this cash flow event record.']
  fx_forward_id varchar [note: 'Foreign key linking to treasury.fx_forward. Business justification: Cash flow events from FX forward settlements should link to the specific forward contract.']
  fx_swap_id varchar [note: 'Foreign key linking to treasury.fx_swap. Business justification: Cash flow events from FX swap settlements should link to the specific swap contract.']
  hedge_program_id varchar [note: 'Reference to the FX hedge instrument if this event represents settlement of a currency hedge position.']
  investment_id varchar [note: 'Reference to the specific investment position or holding that generated this cash flow event, if applicable.']
  liquidity_forecast_id varchar [note: 'Reference to the parent liquidity forecast that this cash flow event feeds into.']
  listed_security_id varchar [note: 'Reference to the security instrument generating the cash flow, such as a bond for coupon payments or maturity.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Management fee payments and carried interest settlements are mandate-specific cash flows.']
  margin_call_id varchar [note: 'Foreign key linking to collateral.margin_call. Business justification: Margin call settlements are material cash flow events requiring explicit tracking in liquidity forecasting.']
  net_contribution_inflow_id varchar [note: 'Foreign key linking to treasury.net_contribution_inflow. Business justification: Cash flow events from pension contributions should link to net_contribution_inflow records.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or fund entity to which this cash flow event is allocated.']
  privateequity_capital_call_id varchar [note: 'Reference to the capital call notice if this event represents funding of a capital call commitment.']
  resource_asset_id varchar [note: 'Foreign key linking to naturalresource.resource_asset. Business justification: Cash flow events (royalties, production revenue) are tied to a specific resource asset for reconciliation and reporting.']
  short_term_instrument_id varchar [note: 'Foreign key linking to treasury.short_term_instrument. Business justification: Cash flow events from ST instrument maturities/purchases should link to the specific instrument.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Cash flow events (dividends, distributions, interest) must link to asset valuations for performance attribution and return calculation.']
  actual_flag boolean [note: 'Boolean indicator of whether this cash flow event has actually occurred and settled, versus being a forecast or expectation.']
  base_currency_amount decimal(20,2) [note: 'The net cash flow amount converted to the funds base reporting currency using the applicable FX rate.']
  created_timestamp timestamp [note: 'System timestamp when this cash flow event record was first created in the lakehouse.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cash flow event amounts.']
  cusip varchar [note: 'CUSIP identifier for the security generating the cash flow, primarily used for North American securities.']
  event_date date [note: 'The business date on which the cash flow event is scheduled to occur or did occur.']
  event_reference_number varchar [note: 'Externally-known unique reference number or code for this cash flow event, used for tracking and reconciliation.']
  event_status varchar [note: 'Current lifecycle status of the cash flow event indicating whether it is expected, confirmed, or has occurred.']
  event_type varchar [note: 'Classification of the cash flow event type indicating the nature of the cash movement. [ENUM-REF-CANDIDATE']
  ex_date date [note: 'Ex-dividend or ex-distribution date after which new holders are not entitled to the cash flow.']
  fee_amount decimal(20,2) [note: 'Total fees or deductions applied to the gross cash flow amount, in the event currency.']
  flow_direction varchar [note: 'Indicates whether the cash flow event represents an inflow of cash to the fund or an outflow from the fund.']
  forecast_confidence_level varchar [note: 'Confidence level in the accuracy and timing of the forecasted cash flow event, based on certainty of occurrence.']
  fx_rate decimal(18,8) [note: 'Exchange rate applied to convert the event currency to the base reporting currency, if applicable.']
  gross_amount decimal(20,2) [note: 'The gross cash flow amount before any deductions, fees, or adjustments, in the event currency.']
  isin varchar [note: 'International Securities Identification Number for the security generating the cash flow, if applicable.']
  last_modified_timestamp timestamp [note: 'System timestamp when this cash flow event record was last updated or modified.']
  net_amount decimal(20,2) [note: 'The net cash flow amount after all fees and deductions, representing the actual impact on cash position, in the event currency.']
  notes varchar [note: 'Free-text notes or comments providing additional context, explanations, or special instructions for the cash flow event.']
  notification_date date [note: 'Date on which the cash flow event was first notified or announced by the counterparty or source system.']
  payment_frequency varchar [note: 'Expected frequency or recurrence pattern of this type of cash flow event.']
  payment_type varchar [note: 'Specific classification of the payment or cash flow within the broader event type category. [ENUM-REF-CANDIDATE: coupon|dividend|principal|redemption|interest|return_of_capital|carried_interest|management_fee|performance_fee — 9 candidates stripped']
  reconciliation_status varchar [note: 'Status of reconciliation between the forecasted cash flow event and the actual settlement from custody systems.']
  record_date date [note: 'Record date for determining entitlement to the cash flow, particularly relevant for dividends and distributions.']
  settlement_date date [note: 'The actual date on which the cash flow event settled or is expected to settle with the counterparty.']
  source_system_reference varchar [note: 'Unique identifier or reference number for this cash flow event in the originating source system.']
  value_date date [note: 'The date on which the cash flow becomes available for use or investment, accounting for settlement cycles.']
  variance_amount decimal(20,2) [note: 'Difference between the forecasted cash flow amount and the actual settled amount, in the event currency.']

  Note: 'Granular record of each expected or actual cash flow event feeding into the liquidity forecast, including scheduled capital calls, LP distributions received, coupon and dividend receipts, bond maturities, FX hedge settlements, management fee payments'
}

Table treasury.bank_account_ssi {
  bank_account_ssi_id varchar [pk, note: 'Unique identifier for the bank account standard settlement instruction record.']
  approved_by_user_employee_id varchar [note: 'Reference to the user who approved this SSI record for operational use.']
  counterparty_id varchar [note: 'Reference to the counterparty entity associated with this settlement instruction.']
  custodian_id varchar [note: 'Reference to the custodian bank or financial institution holding the account.']
  employee_id varchar [note: 'Reference to the user who approved this SSI record for operational use.']
  legal_entity_id varchar [note: 'Reference to the internal legal entity that owns or controls this account for regulatory and accounting purposes.']
  aba_routing_number varchar [note: 'Nine-digit ABA routing number used for domestic US settlement instructions.']
  account_name varchar [note: 'Full legal name of the account as registered with the custodian or correspondent bank.']
  account_number varchar [note: 'Unique account number assigned by the custodian or bank for settlement purposes.']
  approval_timestamp timestamp [note: 'Date and time when this SSI record was approved for operational use.']
  asset_class varchar [note: 'Primary asset class for which this SSI is designated, enabling asset-specific routing and settlement workflows. [ENUM-REF-CANDIDATE: equity|fixed_income|fx|derivatives|commodities|cash|multi_asset — 7 candidates stripped; promote to reference product]']
  beneficiary_address_line1 varchar [note: 'First line of the beneficiary or account holder address for settlement documentation.']
  beneficiary_address_line2 varchar [note: 'Second line of the beneficiary or account holder address for settlement documentation.']
  beneficiary_city varchar [note: 'City of the beneficiary or account holder address.']
  beneficiary_country_code varchar [note: 'Three-letter ISO country code of the beneficiary or account holder address.']
  beneficiary_name varchar [note: 'Name of the ultimate beneficiary or account holder for the settlement instruction.']
  beneficiary_postal_code varchar [note: 'Postal or ZIP code of the beneficiary or account holder address.']
  beneficiary_state_province varchar [note: 'State or province of the beneficiary or account holder address.']
  bic_swift_code varchar [note: 'Bank Identifier Code or SWIFT code identifying the custodian or correspondent bank in the global financial network.']
  correspondent_bank_account_number varchar [note: 'Account number held at the correspondent bank for routing settlement instructions.']
  correspondent_bank_bic varchar [note: 'BIC or SWIFT code of the correspondent or intermediary bank in the settlement chain.']
  correspondent_bank_name varchar [note: 'Full legal name of the correspondent or intermediary bank used in the settlement chain, if applicable.']
  created_timestamp timestamp [note: 'Date and time when this SSI record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code indicating the currency denomination of the account.']
  default_ssi_flag boolean [note: 'Indicates whether this SSI is the default instruction for the given custodian, currency, and asset class combination.']
  effective_date date [note: 'Date from which this SSI record becomes active and available for use in settlement operations.']
  expiration_date date [note: 'Date on which this SSI record expires and is no longer valid for settlement operations. Null indicates no expiration.']
  iban varchar [note: 'International Bank Account Number used for cross-border settlement instructions, primarily in European and international markets.']
  last_modified_timestamp timestamp [note: 'Date and time when this SSI record was last updated or modified.']
  last_verified_date date [note: 'Date when this SSI was last verified or confirmed with the custodian or counterparty for accuracy and operational readiness.']
  lei varchar [note: 'Twenty-character Legal Entity Identifier for the account owner, used for regulatory reporting and counterparty identification.']
  market_code varchar [note: 'Market or exchange code where this SSI is applicable for settlement operations.']
  next_verification_due_date date [note: 'Date by which the next verification of this SSI record must be completed.']
  notes varchar [note: 'Additional free-text notes or comments related to this SSI record for operational reference and audit trail purposes.']
  regulatory_reporting_flag boolean [note: 'Indicates whether transactions settled through this SSI require special regulatory reporting or disclosure.']
  safekeeping_account_flag boolean [note: 'Indicates whether this account is used for safekeeping of securities versus cash settlement only.']
  settlement_method varchar [note: 'Method of settlement for transactions using this SSI. DVP: Delivery Versus Payment, RVP: Receive Versus Payment, FOP: Free of Payment, DAP: Delivery Against Payment, RAF: Receive and Free.']
  settlement_priority varchar [note: 'Priority level assigned to settlement instructions using this SSI for operational sequencing.']
  special_instructions varchar [note: 'Free-text field capturing any special handling instructions, operational notes, or settlement requirements specific to this SSI.']
  ssi_reference_number varchar [note: 'Unique business reference number for this SSI record, used for operational identification and communication.']
  ssi_status varchar [note: 'Current lifecycle status of the SSI record indicating whether it is available for use in settlement operations.']
  ssi_type varchar [note: 'Classification of the SSI record by its operational purpose.']
  verification_frequency_days varchar [note: 'Number of days between required verifications of this SSI record to ensure ongoing accuracy and compliance.']

  Note: 'Standard Settlement Instructions (SSI) reference records for each custodian bank account and counterparty settlement account used in treasury operations. Captures account name, account number, BIC/SWIFT code, IBAN, correspondent bank details, currency'
}

Table treasury.fx_hedge_rebalance {
  fx_hedge_rebalance_id varchar [pk, note: 'Unique identifier for the FX hedge rebalancing event.']
  counterparty_id varchar [note: 'Reference to the financial institution counterparty with whom the rebalancing trades were executed.']
  employee_id varchar [note: 'Reference to the user who approved the rebalancing execution, if approval was required.']
  executed_by_user_employee_id varchar [note: 'Reference to the treasury user who executed the rebalancing trades in the market.']
  fx_position_id varchar [note: 'Reference to the FX position that triggered this rebalancing event.']
  fx_risk_exposure_id varchar [note: 'Foreign key linking to risk.fx_risk_exposure. Business justification: FX hedge rebalancing decisions are triggered by risk exposure assessments. Business process: Rebalancing workflow requires current FX risk exposure to calculate required hedge']
  fx_trade_id varchar [note: 'Foreign key linking to trade.fx_trade. Business justification: Hedge rebalancing generates FX trades to adjust hedge ratios. Treasury teams must link rebalance events to resulting trades for hedge effectiveness testing and audit trail compliance.']
  hedge_program_id varchar [note: 'Foreign key linking to treasury.hedge_program. Business justification: Hedge rebalancing events are triggered by hedge program parameters. Links rebalance to its governing program.']
  isda_agreement_isda_master_id varchar [note: 'Reference to the ISDA master agreement under which the rebalancing trades were executed.']
  isda_master_id varchar [note: 'Reference to the ISDA master agreement under which the rebalancing trades were executed.']
  portfolio_id varchar [note: 'Reference to the portfolio for which the hedge is being rebalanced.']
  actual_hedge_ratio_after decimal(5,4) [note: 'Actual hedge ratio achieved after the rebalancing execution, expressed as a decimal proportion.']
  actual_hedge_ratio_before decimal(5,4) [note: 'Actual hedge ratio calculated immediately before the rebalancing event, expressed as a decimal proportion.']
  approval_required_flag boolean [note: 'Indicates whether the rebalancing required formal approval before execution based on size or policy thresholds.']
  approval_timestamp timestamp [note: 'Date and time when the rebalancing was formally approved for execution.']
  base_currency varchar [note: 'Three-letter ISO 4217 code for the base currency of the portfolio being hedged.']
  collateral_impact_base decimal(18,2) [note: 'Net change in collateral posted or received as a result of the rebalancing, expressed in base currency.']
  created_timestamp timestamp [note: 'Date and time when this rebalancing record was first created in the system.']
  currency_pair varchar [note: 'Standard FX market notation for the currency pair being rebalanced, typically base/quote format.']
  execution_date date [note: 'Date on which the rebalancing trades were executed in the market.']
  execution_rate decimal(18,8) [note: 'Weighted average exchange rate at which the rebalancing trades were executed.']
  execution_timestamp timestamp [note: 'Date and time when the rebalancing trades were executed in the market.']
  existing_hedge_notional_base decimal(20,2) [note: 'Total notional value of existing hedge instruments in base currency before rebalancing.']
  exposure_amount_base decimal(20,2) [note: 'Total currency exposure in base currency terms at the time of rebalancing trigger.']
  forward_points decimal(12,6) [note: 'Forward points applied to the spot rate for forward-dated hedge instruments in the rebalancing.']
  hedge_designation varchar [note: 'Accounting designation of the hedge relationship for financial reporting purposes.']
  hedge_effectiveness_ratio decimal(5,4) [note: 'Calculated hedge effectiveness ratio after rebalancing for hedge accounting qualification purposes.']
  hedge_instrument_type varchar [note: 'Primary type of FX derivative instrument used to execute the rebalancing.']
  hedge_ratio_variance decimal(5,4) [note: 'Difference between actual hedge ratio and target hedge ratio that triggered the rebalancing event.']
  last_modified_timestamp timestamp [note: 'Date and time when this rebalancing record was last updated in the system.']
  lower_threshold_breach_flag boolean [note: 'Indicates whether the rebalancing was triggered by the hedge ratio falling below the lower permitted band.']
  mtm_impact_base decimal(18,2) [note: 'Immediate mark-to-market profit or loss impact from the rebalancing trades, expressed in base currency.']
  new_hedge_notional_base decimal(20,2) [note: 'Total notional value of hedge instruments after rebalancing execution, expressed in base currency.']
  notes varchar [note: 'Free-text field for additional context, rationale, or special circumstances related to the rebalancing event.']
  quote_currency varchar [note: 'Three-letter ISO 4217 code for the quote currency in the FX pair being rebalanced.']
  rebalance_action_type varchar [note: 'Classification of the hedging action taken to restore the hedge ratio to target.']
  rebalance_cost_base decimal(18,2) [note: 'Total transaction cost incurred for executing the rebalancing, including spreads and fees, in base currency.']
  rebalance_notional_amount_base decimal(20,2) [note: 'Notional amount of hedge instruments added or removed during rebalancing, expressed in base currency.']
  rebalance_reference_number varchar [note: 'Externally-known unique reference number assigned to this rebalancing event for tracking and audit purposes.']
  rebalance_status varchar [note: 'Current lifecycle status of the rebalancing event in the workflow.']
  rebalance_trigger_type varchar [note: 'Classification of the event or condition that triggered this rebalancing action.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this rebalancing event requires regulatory reporting under applicable derivatives regulations.']
  settlement_date date [note: 'Date on which the rebalancing trades are scheduled to settle and cash flows exchange.']
  spot_rate_at_trigger decimal(18,8) [note: 'Market spot exchange rate for the currency pair at the time the rebalancing was triggered.']
  target_hedge_ratio decimal(5,4) [note: 'Policy-defined target hedge ratio that the rebalancing aims to achieve, expressed as a decimal proportion.']
  trade_confirmation_reference varchar [note: 'External confirmation reference number provided by the counterparty or trading platform for the rebalancing trades.']
  trigger_timestamp timestamp [note: 'Date and time when the rebalancing trigger condition was detected and the event was initiated.']
  upper_threshold_breach_flag boolean [note: 'Indicates whether the rebalancing was triggered by the hedge ratio exceeding the upper permitted band.']

  Note: 'Operational records capturing each FX hedge rebalancing event triggered when currency exposures drift outside the permitted hedge ratio band defined in the hedge program.'
}

Table treasury.treasury_policy {
  treasury_policy_id varchar [pk, note: 'Primary key for policy']
  employee_id varchar [note: 'Identifier of the treasury function user responsible for maintaining and executing this mandate policy.']
  esg_policy_id varchar [note: 'Foreign key linking to esg.policy. Business justification: Treasury mandates with esg_integration_flag need linkage to specific ESG policy governing integration requirements.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Treasury policies must align with regulatory ESG frameworks (SFDR, TCFD, PRI). Links treasury mandate to applicable framework for regulatory compliance tracking and disclosure requirements.']
  policy_document_id varchar [note: 'Reference to the formal policy document artifact stored in the document management system, containing the full Investment Committee (IC) approved mandate text.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Treasury mandates implement specific regulatory requirements. Linking to regulatory_authority enables compliance teams to track which regulator\'s rules each treasury policy']
  superseded_by_mandate_treasury_policy_id varchar [note: 'Reference to the subsequent treasury mandate policy that replaces this version, enabling version lineage tracking.']
  approved_counterparty_list varchar [note: 'Comma-separated list of counterparties approved for Foreign Exchange (FX) forward, swap, and derivative transactions under this mandate, subject to Know Your Customer (KYC) and Anti-Money Laundering (AML) compliance.']
  approved_custodian_list varchar [note: 'Comma-separated list of custodian institutions approved for treasury cash account management and settlement under this mandate, such as State Street and Northern Trust.']
  base_currency_code varchar [note: 'Three-letter International Organization for Standardization (ISO) 4217 currency code representing the base reporting currency for all treasury mandate thresholds and limits.']
  benchmark_rate decimal(18,2) [note: 'Reference benchmark rate used for pricing short-term treasury instruments and evaluating performance, such as Secured Overnight Financing Rate (SOFR) or Euro Short-Term Rate (ESTR).']
  collateral_minimum_transfer_amount decimal(18,2) [note: 'Minimum collateral transfer amount required under Credit Support Annex (CSA) agreements to reduce operational friction, denominated in base currency.']
  collateral_posting_threshold_amount decimal(18,2) [note: 'Minimum mark-to-market (MTM) exposure threshold that triggers collateral posting requirements under Credit Support Annex (CSA) agreements, denominated in base currency.']
  counterparty_concentration_limit_pct decimal(5,2) [note: 'Maximum percentage of total treasury assets that may be allocated to a single counterparty, expressed in basis points (bps) to manage concentration risk.']
  created_timestamp timestamp [note: 'Timestamp when this treasury mandate policy record was first created in the system.']
  dv01_limit_amount decimal(18,2) [note: 'Maximum Dollar Value of Zero One (DV01) interest rate sensitivity permitted for treasury fixed income holdings, denominated in base currency.']
  effective_date date [note: 'Date on which the treasury mandate policy becomes binding and operational for treasury activities.']
  eligible_collateral_types varchar [note: 'Comma-separated list of collateral asset types acceptable for posting under this mandate, such as cash, government bonds, Investment Grade (IG) corporate bonds, and money market instruments.']
  esg_integration_flag boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) criteria are integrated into counterparty and instrument selection under this mandate.']
  expiry_date date [note: 'Date on which the treasury mandate policy ceases to be effective, nullable for open-ended mandates subject to periodic review.']
  fx_hedge_ratio_target_pct decimal(5,2) [note: 'Target hedge ratio for Foreign Exchange (FX) exposure management, expressed as a percentage of total foreign currency exposure to be hedged.']
  fx_hedge_ratio_tolerance_pct decimal(5,2) [note: 'Allowable deviation from the target Foreign Exchange (FX) hedge ratio before rebalancing is required, expressed in percentage points.']
  ic_approval_date date [note: 'Date on which the Investment Committee (IC) formally approved this treasury mandate policy version.']
  ic_approval_reference varchar [note: 'Investment Committee (IC) meeting reference number or resolution identifier documenting the approval of this mandate policy.']
  last_modified_timestamp timestamp [note: 'Timestamp when this treasury mandate policy record was last updated, supporting audit trail and version control.']
  last_review_date date [note: 'Date of the most recent Investment Committee (IC) review of this treasury mandate policy.']
  mandate_name varchar [note: 'Descriptive name of the treasury mandate policy, typically reflecting the strategic purpose or version identifier.']
  mandate_reference_number varchar [note: 'Externally-known business identifier for the treasury mandate policy, used in Investment Committee (IC) documentation and governance records.']
  mandate_status varchar [note: 'Current lifecycle status of the treasury mandate policy within the governance approval and operational workflow.']
  mandate_type varchar [note: 'Classification of the treasury mandate by operational focus area: liquidity management, cash management, Foreign Exchange (FX) hedging, collateral management, or integrated.']
  maximum_maturity_days varchar [note: 'Maximum allowable maturity in days for short-term liquidity instruments under this treasury mandate, ensuring alignment with liquidity requirements.']
  minimum_credit_rating varchar [note: 'Minimum Investment Grade (IG) credit rating required for counterparties and issuers of short-term instruments, as per rating agency standards.']
  minimum_liquidity_threshold_amount decimal(18,2) [note: 'Minimum cash position amount that must be maintained across all treasury accounts to meet operational and capital call funding requirements, denominated in base currency.']
  next_review_date date [note: 'Scheduled date for the next Investment Committee (IC) review of this treasury mandate policy.']
  notes varchar [note: 'Free-text field for additional context, special conditions, or operational guidance related to this treasury mandate policy.']
  permitted_instrument_types varchar [note: 'Comma-separated list of short-term investment instruments authorized under this mandate, such as Treasury Bills (T-Bills), Secured Overnight Financing Rate (SOFR) linked instruments, commercial paper, and money market funds.']
  rebalance_frequency varchar [note: 'Scheduled frequency for reviewing and rebalancing Foreign Exchange (FX) hedge positions and liquidity allocations under this mandate.']
  regulatory_reporting_required_flag boolean [note: 'Indicates whether transactions under this mandate require regulatory reporting to the national pension regulator, European Market Infrastructure Regulation (EMIR), or other governing bodies.']
  review_frequency varchar [note: 'Scheduled frequency for Investment Committee (IC) review and reaffirmation of this treasury mandate policy.']
  settlement_cycle varchar [note: 'Standard settlement cycle for treasury transactions, expressed as Trade Date Plus (T+) number of business days.']
  settlement_method varchar [note: 'Standard settlement method for treasury transactions: Delivery Versus Payment (DVP), Free of Payment (FOP), or cash settlement.']
  var_limit_1day_95pct_amount decimal(18,2) [note: 'Maximum one-day Value at Risk (VaR) at ninety-five percent confidence level permitted for treasury portfolio, denominated in base currency.']
  version_number varchar [note: 'Semantic version identifier for the mandate policy, incremented with each Investment Committee (IC) approved revision.']

  Note: 'Master record defining the treasury investment mandate and operating parameters approved by the Investment Committee. Captures mandate version, effective date, permitted instrument types, maximum maturity for short-term instruments, counterparty'
}

Table treasury.sofr_benchmark {
  sofr_benchmark_id varchar [pk, note: 'Unique identifier for the SOFR benchmark rate record. Primary key.']
  superseded_by_sofr_benchmark_id varchar [note: 'Reference to the sofr_benchmark_id that supersedes this record if this rate was revised.']
  administrator_lei varchar [note: '20-character Legal Entity Identifier of the benchmark administrator.']
  benchmark_administrator varchar [note: 'Name of the official administrator publishing this rate (Federal Reserve Bank of New York for SOFR).']
  benchmark_regulation_compliant_flag boolean [note: 'Indicates whether this rate complies with EU Benchmark Regulation (BMR) and IOSCO Principles for Financial Benchmarks.']
  business_day_convention varchar [note: 'Convention for adjusting rate dates that fall on non-business days.']
  calendar_code varchar [note: 'Three-letter code identifying the business day calendar used (e.g., USD for U.S. Federal Reserve calendar).']
  compounding_index decimal(18,10) [note: 'Cumulative compounding index value used for calculating interest on SOFR-linked floating rate instruments.']
  created_timestamp timestamp [note: 'Timestamp when this rate record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Automated data quality score (0-100) assessing completeness, timeliness, and consistency of this rate record.']
  day_count_convention varchar [note: 'The day count convention used for interest accrual calculations with this SOFR rate (typically Actual/360 for SOFR).']
  index_base_date date [note: 'The reference date from which the SOFR compounding index is calculated (typically April 2, 2018).']
  last_modified_timestamp timestamp [note: 'Timestamp when this rate record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional comments, annotations, or context regarding this rate record.']
  percentile_25th decimal(12,8) [note: 'The 25th percentile rate from the distribution of underlying repo transactions, used for rate dispersion analysis.']
  percentile_75th decimal(12,8) [note: 'The 75th percentile rate from the distribution of underlying repo transactions, used for rate dispersion analysis.']
  publication_timestamp timestamp [note: 'The exact timestamp when the Federal Reserve Bank of New York published this SOFR rate.']
  rate_date date [note: 'The business date for which this SOFR rate is effective and published.']
  rate_status varchar [note: 'Current lifecycle status of the rate: published (official), preliminary (subject to revision), revised (corrected), final (no further changes), or suspended (not available).']
  rate_type varchar [note: 'Classification of the SOFR rate: overnight spot rate or term/average rate with specific tenor. [ENUM-REF-CANDIDATE: overnight|30day_average|90day_average|180day_average|1month_term|3month_term|6month_term|12month_term — 8 candidates stripped; promote to']
  rate_value_bps decimal(12,4) [note: 'The SOFR rate expressed in basis points (bps) for precision in spread calculations (e.g., 532.0000 bps for 5.32%).']
  rate_value_percent decimal(12,8) [note: 'The published SOFR rate expressed as an annualized percentage (e.g., 5.32 for 5.32% per annum).']
  rate_volatility_bps decimal(12,4) [note: 'Standard deviation or volatility measure of the SOFR rate over the calculation period, expressed in basis points.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this rate is used for regulatory reporting purposes (e.g., EMIR, MiFID II trade reporting).']
  revision_number varchar [note: 'Sequential revision number for this rate date; increments when a rate is corrected or republished (0 for initial publication).']
  revision_reason varchar [note: 'Explanation for why this rate was revised or republished, if applicable.']
  source_identifier varchar [note: 'Unique identifier or ticker symbol for this rate in the source system (e.g., SOFRRATE Index in Bloomberg).']
  transaction_count varchar [note: 'Number of individual repo transactions included in the SOFR calculation for this date.']
  transaction_volume_usd decimal(18,2) [note: 'Total notional volume in USD of overnight Treasury repo transactions used to calculate this SOFR rate.']
  usage_context varchar [note: 'Description of how this rate is used within the organization (e.g., pricing short-term liquidity instruments, floating rate accrual, treasury portfolio benchmarking).']
  validation_status varchar [note: 'Status of automated validation checks performed on this rate record.']
  validation_timestamp timestamp [note: 'Timestamp when automated validation checks were last performed on this rate record.']

  Note: 'Reference data for SOFR (Secured Overnight Financing Rate) and related overnight/term benchmark rates used to price SOFR-linked short-term instruments, calculate floating rate accruals, and benchmark treasury portfolio returns.'
}

Table treasury.distribution_receipt {
  distribution_receipt_id varchar [pk, note: 'Unique identifier for the distribution receipt record from private market fund investments.']
  adjustment_id varchar [note: 'Reference to the stored distribution notice or capital account statement document received from the General Partner (GP).']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Distribution receipts represent cash inflows into a cash account; linking records the receiving account.']
  custody_account_id varchar [note: 'Reference to the custody cash account (State Street or Northern Trust) into which the distribution was settled.']
  distribution_notice_document_id varchar [note: 'Reference to the stored distribution notice or capital account statement document received from the General Partner (GP).']
  distribution_notice_id varchar [note: 'Foreign key linking to performance.notice. Business justification: Distribution processing workflow: Treasury receives distributions announced via GP notices. Parallel to existing capital_call_funding→notice link.']
  employee_id varchar [note: 'Reference to the treasury operations user who approved the distribution receipt for posting to the Investment Book of Record (IBOR).']
  fund_investment_id varchar [note: 'Reference to the underlying private market fund investment (private equity, infrastructure, real estate, natural resources) that generated this distribution.']
  gp_bank_account_id varchar [note: 'Foreign key linking to treasury.gp_bank_account. Business justification: Distributions are received from GP bank accounts. Links receipt to source GP account.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) legal entity that manages the fund and issued the distribution.']
  portfolio_id varchar [note: 'Reference to the investment portfolio or mandate to which this distribution is allocated for performance attribution and reporting.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: PE distribution receipts need asset valuation context for IRR/TVPI calculations.']
  accounting_period varchar [note: 'Accounting period (YYYY-QN for quarterly or YYYY-MM for monthly) to which the distribution is allocated for financial reporting and Net Asset Value (NAV) calculation.']
  announcement_date date [note: 'Date on which the General Partner (GP) announced or notified the Limited Partner (LP) of the distribution via capital account statement or distribution notice.']
  approval_timestamp timestamp [note: 'Date and time when the distribution receipt was approved for posting, in ISO 8601 format with timezone.']
  asset_class varchar [note: 'Primary asset class classification of the fund investment generating the distribution: private equity, infrastructure, real estate, natural resources, or credit.']
  base_currency_amount decimal(18,2) [note: 'Net distribution amount converted to base currency (Base Currency) using the FX rate, for portfolio accounting and Net Asset Value (NAV) calculation.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 code for the pension fund\'s base reporting currency (typically USD).']
  created_timestamp timestamp [note: 'Date and time when the distribution receipt record was first created in the system, in ISO 8601 format with timezone.']
  custodian_reference_number varchar [note: 'Unique transaction reference number assigned by the custodian (State Street or Northern Trust) for the distribution settlement.']
  distribution_amount decimal(18,2) [note: 'Gross distribution amount received in the original distribution currency, before any withholding taxes or fees.']
  distribution_currency_code varchar [note: 'Three-letter ISO 4217 currency code of the distribution amount as paid by the General Partner (GP).']
  distribution_reference_number varchar [note: 'External reference number or identifier provided by the General Partner (GP) or fund administrator for this distribution.']
  distribution_status varchar [note: 'Current lifecycle status of the distribution receipt: announced by GP, pending settlement, received in custody account, reconciled to notice, disputed, or reversed.']
  distribution_type varchar [note: 'Classification of the distribution: return of capital (return of Paid-In Capital), realized gain (capital appreciation), income (dividends, interest, rent), recallable (subject to clawback), or other.']
  dpi_contribution decimal(18,6) [note: 'Contribution of this distribution to the cumulative Distributions to Paid-In (DPI) multiple for the fund investment, calculated as distribution amount divided by Paid-In Capital (PIC).']
  fund_administrator_name varchar [note: 'Name of the third-party fund administrator responsible for processing and reporting the distribution (e.g., SS&C, Citco, Apex).']
  fx_rate decimal(18,6) [note: 'Foreign exchange rate applied to convert the distribution amount from distribution currency to base currency (Base Currency), as of settlement date.']
  gp_lei varchar [note: '20-character ISO 17442 Legal Entity Identifier (LEI) of the General Partner (GP) for regulatory reporting and counterparty identification.']
  income_amount decimal(18,2) [note: 'Portion of the distribution classified as income (dividends, interest, rental income, royalties) from underlying portfolio assets, in base currency.']
  last_modified_timestamp timestamp [note: 'Date and time when the distribution receipt record was last modified or updated, in ISO 8601 format with timezone.']
  nav_impact_amount decimal(18,2) [note: 'Impact of the distribution on the fund\'s Net Asset Value (NAV), calculated as the base currency amount adjusted for any unrealized gain recognition, in base currency.']
  net_distribution_amount decimal(18,2) [note: 'Net distribution amount received after deduction of withholding taxes and any GP-deducted fees, in distribution currency.']
  notes varchar [note: 'Free-text notes or comments regarding the distribution receipt, including any special circumstances, disputes, or reconciliation details.']
  payment_date date [note: 'Scheduled or actual date on which the distribution was paid by the General Partner (GP) to the Limited Partner (LP).']
  posted_timestamp timestamp [note: 'Date and time when the distribution receipt was posted to the Investment Book of Record (IBOR) in SimCorp Dimension or Aladdin, in ISO 8601 format with timezone.']
  processing_status varchar [note: 'Internal processing workflow status: draft entry, pending treasury approval, approved for posting, posted to Investment Book of Record (IBOR), or rejected.']
  realized_gain_amount decimal(18,2) [note: 'Portion of the distribution classified as realized capital gain from asset sales or exits, in base currency.']
  recallable_amount decimal(18,2) [note: 'Amount of the distribution that is subject to potential recall or clawback by the General Partner (GP), in base currency.']
  recallable_expiry_date date [note: 'Date after which the recallable distribution is no longer subject to clawback, as specified in the Limited Partnership Agreement (LPA).']
  recallable_flag boolean [note: 'Indicates whether this distribution is subject to clawback or recall provisions under the Limited Partnership Agreement (LPA), typically for GP carry true-up.']
  reconciliation_date date [note: 'Date on which the distribution was reconciled between the GP notice and custodian receipt, or variance was resolved.']
  reconciliation_status varchar [note: 'Status of reconciliation between the GP distribution notice and the custodian cash receipt: pending, matched, variance identified, or resolved.']
  reconciliation_variance_amount decimal(18,2) [note: 'Difference between the expected distribution amount per GP notice and the actual amount received in custody, in base currency.']
  record_date date [note: 'Date of record for determining Limited Partner (LP) entitlement to the distribution, as specified in the distribution notice.']
  return_of_capital_amount decimal(18,2) [note: 'Portion of the distribution classified as return of Paid-In Capital (PIC), reducing the outstanding investment cost basis, in base currency.']
  settlement_date date [note: 'Date on which the distribution cash was settled and received into the custody account, as confirmed by the custodian (State Street or Northern Trust).']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted at source by the General Partner (GP) or fund jurisdiction, in distribution currency.']
  withholding_tax_rate_percent decimal(5,2) [note: 'Percentage rate of withholding tax applied to the distribution, as specified by the fund jurisdiction or applicable tax treaty.']

  Note: 'Records of cash distributions received from private market fund investments (private equity, infrastructure, real estate, natural resources) including return of capital, realized gain distributions, income distributions, and recallable distributions.'
}

Table treasury.sweep_instruction {
  sweep_instruction_id varchar [pk, note: 'Unique identifier for the cash sweep instruction record.']
  bank_account_ssi_id varchar [note: 'Reference to the standard settlement instructions template used for this sweep.']
  custodian_id varchar [note: 'Reference to the custodian bank executing the sweep instruction.']
  employee_id varchar [note: 'Reference to the user who approved the sweep instruction for execution.']
  initiated_by_user_employee_id varchar [note: 'Reference to the user who created or initiated the sweep instruction.']
  legal_entity_id varchar [note: 'Reference to the legal entity on whose behalf the sweep instruction is executed.']
  liquidity_reserve_policy_id varchar [note: 'Foreign key linking to treasury.liquidity_reserve_policy. Business justification: Sweep instructions may be governed by liquidity reserve policies. Links sweep to applicable policy.']
  portfolio_id varchar [note: 'Reference to the investment portfolio associated with the sweep instruction.']
  source_cash_account_id varchar [note: 'Reference to the originating cash account from which funds are swept.']
  ssi_registry_id varchar [note: 'Reference to the standard settlement instructions template used for this sweep.']
  target_cash_account_id varchar [note: 'Reference to the destination cash account or liquidity instrument account receiving swept funds.']
  approval_required_flag boolean [note: 'Indicates whether manual approval is required before sweep execution.']
  approval_timestamp timestamp [note: 'Date and time when the sweep instruction was approved.']
  benchmark_rate decimal(18,2) [note: 'Reference benchmark rate for the liquidity instrument, such as SOFR, LIBOR replacement, or central bank rate.']
  cancellation_reason varchar [note: 'Explanation for why the sweep instruction was cancelled before execution.']
  created_timestamp timestamp [note: 'Date and time when the sweep instruction record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO currency code for the swept funds.']
  custodian_confirmation_number varchar [note: 'Confirmation reference number provided by the custodian bank for the executed sweep.']
  executed_timestamp timestamp [note: 'Date and time when the sweep instruction was executed and funds movement initiated.']
  execution_time timestamp [note: 'Scheduled time of day for sweep execution in HH:MM format, applicable for time-based automated sweeps.']
  failure_reason varchar [note: 'Detailed explanation of why the sweep instruction failed to execute, if applicable.']
  instruction_date date [note: 'Business date when the sweep instruction was created or issued.']
  instruction_reference_number varchar [note: 'Externally visible unique reference number for the sweep instruction used for tracking and reconciliation.']
  instruction_status varchar [note: 'Current lifecycle status of the sweep instruction in the workflow from creation through settlement. [ENUM-REF-CANDIDATE: pending|approved|executed|settled|failed|cancelled|rejected — 7 candidates stripped; promote to reference product]']
  instruction_type varchar [note: 'Classification of the sweep instruction mechanism: automated rule-based, manual one-time, scheduled periodic, threshold-triggered, zero-balance sweep, or target-balance sweep.']
  instrument_maturity_date date [note: 'Maturity date of the short-term liquidity instrument purchased with swept funds.']
  interest_rate_bps decimal(8,4) [note: 'Interest rate earned on swept funds expressed in basis points.']
  last_modified_timestamp timestamp [note: 'Date and time when the sweep instruction record was last updated.']
  lei varchar [note: 'Twenty-character ISO Legal Entity Identifier for the entity executing the sweep.']
  liquidity_instrument_type varchar [note: 'Type of short-term liquidity instrument into which excess cash is swept. [ENUM-REF-CANDIDATE: money_market_fund|treasury_bill|commercial_paper|repo|overnight_deposit|term_deposit|sofr_linked — 7 candidates stripped; promote to reference product]']
  liquidity_tier varchar [note: 'Classification of the liquidity reserve tier to which swept funds are allocated per liquidity management policy.']
  minimum_sweep_amount decimal(18,2) [note: 'Minimum monetary amount required for a sweep to be executed; sweeps below this threshold are not processed.']
  notes varchar [note: 'Free-text field for additional comments, special instructions, or operational notes regarding the sweep.']
  payment_method varchar [note: 'Payment mechanism used to execute the cash sweep between accounts.']
  payment_reference_number varchar [note: 'Unique reference number assigned by the payment system for the sweep transaction.']
  reconciliation_date date [note: 'Date when the sweep instruction was reconciled against custodian records.']
  reconciliation_status varchar [note: 'Status of reconciliation between internal sweep records and custodian confirmations.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this sweep instruction must be included in regulatory reporting submissions.']
  settled_timestamp timestamp [note: 'Date and time when the sweep transaction was settled and funds transfer completed.']
  settlement_date date [note: 'Date when the cash movement is settled and funds are transferred between accounts.']
  sweep_amount decimal(18,2) [note: 'Monetary amount of cash being swept from the source account to the target account or instrument.']
  sweep_frequency varchar [note: 'Scheduled frequency at which automated sweep instructions are evaluated and executed.']
  sweep_priority varchar [note: 'Execution priority ranking for this sweep instruction when multiple sweeps compete for available cash.']
  target_balance_amount decimal(18,2) [note: 'Desired balance to be maintained in the source account after sweep execution; excess above this level is swept.']
  threshold_amount decimal(18,2) [note: 'Minimum balance threshold that triggers an automated sweep when exceeded in the source account.']
  value_date date [note: 'Effective date when the swept funds are valued and interest calculations apply.']

  Note: 'Automated and manual cash sweep instruction records governing the movement of excess cash from operating accounts into short-term liquidity instruments or between custodian accounts.'
}

Table treasury.gp_bank_account {
  gp_bank_account_id varchar [pk, note: 'Primary key for gp_bank_account']
  cash_account_id varchar [note: 'Identifier of the target bank account for automatic cash sweep transfers.']
  custodian_id varchar [note: 'Identifier of the custodian institution responsible for safekeeping assets in this account.']
  fund_id varchar [note: 'Identifier of the investment fund associated with this bank account for capital management.']
  gp_entity_id varchar [note: 'Identifier of the general partner legal entity that owns or controls this bank account.']
  account_closing_date date [note: 'Date when the bank account was closed. Null if account remains open.']
  account_name varchar [note: 'The registered name on the bank account as it appears in the financial institution records.']
  account_number varchar [note: 'The unique account number assigned by the financial institution to identify this bank account.']
  account_opening_date date [note: 'Date when the bank account was officially opened and became operational.']
  account_status varchar [note: 'Current operational status of the bank account within treasury management workflows.']
  account_type varchar [note: 'Classification of the bank account by its primary treasury function within fund operations.']
  aml_risk_rating varchar [note: 'Risk rating assigned to this account for anti-money laundering compliance purposes.']
  bank_branch_code varchar [note: 'Routing or sort code identifying the specific branch within the banking network.']
  bank_branch_name varchar [note: 'Name of the specific branch of the financial institution servicing this account.']
  bank_contact_email varchar [note: 'Email address for the primary bank contact managing this account relationship.']
  bank_contact_phone varchar [note: 'Phone number for the primary bank contact managing this account relationship.']
  bank_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the bank account is domiciled.']
  bank_name varchar [note: 'Legal name of the financial institution where the account is held.']
  bank_relationship_manager varchar [note: 'Name of the relationship manager at the financial institution servicing this account.']
  cost_center_code varchar [note: 'Cost center code associated with this bank account for expense allocation.']
  created_timestamp timestamp [note: 'Timestamp when this bank account record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code indicating the denomination of the bank account.']
  daily_transaction_limit decimal(18,2) [note: 'Maximum aggregate transaction amount permitted per day on this account.']
  effective_from_date date [note: 'Date from which this bank account record is effective for treasury operations.']
  effective_to_date date [note: 'Date until which this bank account record is effective. Null for currently active records.']
  gl_account_code varchar [note: 'General ledger account code mapped to this bank account for financial reporting.']
  iban varchar [note: 'International Bank Account Number used for cross-border transactions and account identification.']
  interest_rate_basis_points varchar [note: 'Interest rate applied to account balances expressed in basis points.']
  is_capital_call_account boolean [note: 'Indicates whether this account is designated for receiving capital call contributions from LPs.']
  is_distribution_account boolean [note: 'Indicates whether this account is designated for making distributions to limited partners.']
  is_fx_hedging_account boolean [note: 'Indicates whether this account is used for foreign exchange hedging transactions.']
  is_sweep_enabled boolean [note: 'Indicates whether automatic cash sweep functionality is enabled for liquidity optimization.']
  kyc_verification_date date [note: 'Date when the most recent KYC verification was completed for this account.']
  last_reconciliation_date date [note: 'Date of the most recent bank reconciliation performed for this account.']
  legal_entity_identifier varchar [note: 'LEI of the legal entity that owns this bank account for regulatory reporting.']
  minimum_balance_requirement decimal(18,2) [note: 'Minimum balance that must be maintained in the account per banking agreement.']
  modified_timestamp timestamp [note: 'Timestamp when this bank account record was last modified.']
  notes varchar [note: 'Free-text notes and comments related to this bank account for operational reference.']
  overdraft_limit decimal(18,2) [note: 'Maximum overdraft facility amount available on this account if applicable.']
  primary_signatory_name varchar [note: 'Name of the primary authorized signatory for transactions on this bank account.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this account is subject to specific regulatory reporting requirements.']
  secondary_signatory_name varchar [note: 'Name of the secondary authorized signatory for dual-signature requirements.']
  signature_threshold_amount decimal(18,2) [note: 'Transaction amount threshold above which dual signatures are required for authorization.']
  single_transaction_limit decimal(18,2) [note: 'Maximum amount permitted for a single transaction on this account.']
  sweep_threshold_amount decimal(18,2) [note: 'Balance threshold that triggers automatic sweep transfers to the target account.']
  swift_bic_code varchar [note: 'SWIFT/BIC code identifying the financial institution holding this account for international wire transfers.']
  tax_jurisdiction_code varchar [note: 'Code identifying the tax jurisdiction applicable to this bank account.']

  Note: 'Master reference table for gp_bank_account. Referenced by gp_bank_account_id.'
}

Table collateral.counterparty {
  counterparty_id varchar [pk, note: 'Unique system-generated identifier for the counterparty.']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Counterparties (banks, asset managers, CCPs) must link to unified actor registry for KYC/AML compliance, regulatory reporting (EMIR), and consolidated entity management.']
  bic varchar [note: 'ISO 9362 BIC for the counterparty\'s primary banking relationship.']
  blacklist_reason varchar [note: 'Reason for blacklisting the counterparty, if applicable.']
  classification varchar [note: 'Business classification indicating internal, external, or affiliated relationship.']
  collateral_eligible_flag boolean [note: 'Indicates whether the counterparty is eligible to post collateral under firm policy.']
  comments varchar [note: 'Free-text field for additional notes or remarks about the counterparty.']
  counterparty_name varchar [note: 'Full legal name of the counterparty entity.']
  counterparty_status varchar [note: 'Current operational status of the counterparty.']
  country_of_incorporation varchar [note: 'Country where the counterparty is legally incorporated. [ENUM-REF-CANDIDATE: USA|CAN|GBR|FRA|DEU|JPN|AUS|CHN|... — promote to reference product]']
  credit_limit decimal(20,2) [note: 'Maximum credit exposure approved for the counterparty.']
  default_probability decimal(5,4) [note: 'One-year probability of default as assessed by internal risk models.']
  entity_type varchar [note: 'Category of the counterparty based on its role in the financial ecosystem.']
  esg_score decimal(5,2) [note: 'Aggregated Environmental, Social, and Governance score assigned to the counterparty.']
  exposure_limit decimal(20,2) [note: 'Maximum aggregate exposure allowed for the counterparty across all trades.']
  is_blacklisted boolean [note: 'Indicates whether the counterparty is on the internal blacklist.']
  is_central_counterparty boolean [note: 'True if the counterparty functions as a Central Counterparty.']
  is_clearing_member boolean [note: 'True if the counterparty is a clearing member of a CCP.']
  jurisdiction varchar [note: 'Legal jurisdiction under which the counterparty is organized.']
  last_rating_date date [note: 'Date of the most recent risk rating assignment.']
  lei varchar [note: 'Global legal entity identifier assigned to the counterparty.']
  lifecycle_status varchar [note: 'Lifecycle stage of the counterparty record within the data system.']
  margin_call_threshold decimal(5,2) [note: 'Exposure percentage at which a margin call is triggered.']
  onboarding_date date [note: 'Date when the counterparty was first onboarded into the system.']
  primary_contact_address varchar [note: 'Mailing address for the primary contact of the counterparty.']
  primary_contact_email varchar [note: 'Email address of the primary contact person.']
  primary_contact_name varchar [note: 'Full name of the primary contact person for the counterparty.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact person.']
  rating_agency varchar [note: 'Name of the external agency providing the risk rating.']
  record_audit_created timestamp [note: 'Timestamp when the counterparty record was initially created in the data lake.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the counterparty record.']
  recovery_rate decimal(5,2) [note: 'Estimated recovery rate in the event of counterparty default.']
  registration_number varchar [note: 'Official registration number of the counterparty in its jurisdiction of incorporation.']
  regulatory_status varchar [note: 'Regulatory classification of the counterparty under applicable frameworks.']
  risk_rating varchar [note: 'External credit risk rating of the counterparty. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D — promote to reference product]']
  settlement_currency varchar [note: 'Default currency used for settlement with the counterparty.']
  settlement_cycle varchar [note: 'Standard settlement period for trades with the counterparty.']
  short_name varchar [note: 'Commonly used short name or ticker for the counterparty.']
  tax_identifier varchar [note: 'Tax identification number of the counterparty for jurisdictional tax reporting.']
  termination_date date [note: 'Date when the relationship with the counterparty was terminated, if applicable.']

  Note: 'Master record for each counterparty entity in the pension fund\'s collateral and OTC derivatives ecosystem, including banks, broker-dealers, CCPs, and custodians.'
}

Table collateral.isda_master {
  isda_master_id varchar [pk, note: 'Unique system-generated identifier for the ISDA Master Agreement record.']
  counterparty_id varchar [note: 'FK to collateral.counterparty']
  agreement_number varchar [note: 'External reference number or code assigned to the ISDA Master Agreement.']
  agreement_type varchar [note: 'Indicates whether the agreement follows the 1992 or 2002 ISDA Master Agreement version.']
  amendment_count varchar [note: 'Total number of amendments applied to the agreement.']
  amendment_indicator boolean [note: 'True if the agreement has been amended since original execution.']
  close_out_netting_provision varchar [note: 'Text describing the close‑out netting rules applicable to the agreement.']
  collateral_eligibility varchar [note: 'Indicates whether the agreement permits collateral posting and its scope.']
  comments varchar [note: 'Free‑form notes or remarks about the agreement.']
  confidentiality_classification varchar [note: 'Data classification level applied to the agreement record.']
  counterparty_bic varchar [note: 'BIC of the counterparty\'s primary banking relationship.']
  counterparty_lei varchar [note: 'Global identifier for the counterparty as defined by ISO 17442.']
  created_timestamp timestamp [note: 'Timestamp when the ISDA Master Agreement record was first created in the system.']
  credit_support_annex_reference varchar [note: 'Identifier of the associated Credit Support Annex governing collateral terms.']
  default_provision varchar [note: 'Text of the provision outlining events of default and remedies.']
  dispute_resolution_mechanism varchar [note: 'Mechanism (e.g., arbitration, court) for resolving disputes under the agreement.']
  document_reference varchar [note: 'Path or identifier for the stored electronic copy of the agreement.']
  early_termination_rights varchar [note: 'Description of any rights allowing early termination of the agreement.']
  effective_from date [note: 'Date on which the agreement becomes legally binding.']
  effective_until date [note: 'Date on which the agreement terminates or expires; null for open‑ended agreements.']
  execution_date date [note: 'Date the parties signed the ISDA Master Agreement.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction whose law governs the agreement.']
  isda_master_status varchar [note: 'Current lifecycle state of the ISDA Master Agreement.']
  jurisdiction_code varchar [note: 'Three‑letter ISO country code representing the governing jurisdiction.']
  last_amendment_date date [note: 'Date of the most recent amendment to the agreement.']
  margin_call_frequency varchar [note: 'How often margin calls are required under the agreement.']
  margin_currency varchar [note: 'ISO 4217 currency code for the margin threshold amount.']
  margin_threshold_amount decimal(18,2) [note: 'Monetary threshold that triggers a margin call under the agreement.']
  netting_agreement_type varchar [note: 'Specifies whether the agreement provides full, partial, or no netting of exposures.']
  regulatory_body varchar [note: 'Regulatory authority overseeing compliance of the agreement. [ENUM-REF-CANDIDATE: SEC|FCA|ESMA|IOSCO|CFA|PRI|TCFD|SFDR|IFRS|FASB|FATF|ISDA|FSB|Basel|Local|ISO27001|SOC2|GDPR|MiFIDII — promote to reference product]']
  regulatory_reporting_requirement varchar [note: 'Regulatory regime(s) that the agreement must satisfy for reporting.']
  termination_event_clauses varchar [note: 'Key clauses that define events triggering termination of the agreement.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the ISDA Master Agreement record.']
  version_number varchar [note: 'Sequential version of the agreement reflecting amendments or restatements.']

  Note: 'Master record for each ISDA Master Agreement executed between the pension fund and a counterparty. Captures agreement version (1992 or 2002 ISDA), execution date, governing law jurisdiction, default provisions, termination event clauses, close-out netting'
}

Table collateral.csa {
  csa_id varchar [pk, note: 'System-generated unique identifier for the CSA record.']
  counterparty_id varchar [note: 'Unique identifier of the counterparty party to the CSA.']
  isda_master_id varchar [note: 'Foreign key linking to collateral.isda_master. Business justification: CSA (Credit Support Annex) is ALWAYS attached to an ISDA Master Agreement - this is fundamental to OTC derivatives documentation. Every CSA must reference its parent ISDA Master.']
  netting_agreement_id varchar [note: 'Identifier of the netting agreement linked to this CSA, if any.']
  valuation_policy_id varchar [note: 'Foreign key linking to valuation.valuation_policy. Business justification: CSAs specify collateral valuation methods that must align with internal valuation policies.']
  amendment_date date [note: 'Date on which the latest amendment was executed.']
  amendment_number varchar [note: 'Sequential number of the most recent amendment to the CSA.']
  collateral_valuation_frequency varchar [note: 'How often collateral valuations are refreshed.']
  collateral_valuation_method varchar [note: 'Method used to value posted collateral.']
  collateral_valuation_source varchar [note: 'Origin of the data used for collateral valuation.']
  created_timestamp timestamp [note: 'Timestamp when the CSA record was first created in the system.']
  credit_limit decimal(20,2) [note: 'Maximum credit exposure allowed under the CSA.']
  credit_limit_currency varchar [note: 'ISO 4217 currency code for the credit limit.']
  csa_description varchar [note: 'Free‑text description of the CSA, including any special provisions.']
  csa_status varchar [note: 'Current lifecycle state of the CSA agreement.']
  csa_type varchar [note: 'Classification of the CSA based on governing law or ISDA version.']
  effective_from date [note: 'Date on which the CSA becomes legally binding.']
  effective_until date [note: 'Date on which the CSA expires or is terminated; null for open‑ended agreements.']
  eligible_collateral_type varchar [note: 'Asset class(s) permitted as collateral under the CSA.']
  governing_law varchar [note: 'Legal jurisdiction governing the CSA.']
  independent_amount decimal(20,2) [note: 'Collateral amount that must be posted irrespective of exposure.']
  independent_amount_currency varchar [note: 'ISO 4217 currency code for the independent amount.']
  is_eligible_for_clearing boolean [note: 'True if the CSA permits clearing through a CCP; false otherwise.']
  is_margin_call_required boolean [note: 'Indicates whether the CSA mandates margin calls (true) or not (false).']
  margin_call_frequency varchar [note: 'How often margin calls are calculated and issued.']
  minimum_transfer_amount decimal(20,2) [note: 'Minimum amount of collateral that must be transferred in a margin call.']
  minimum_transfer_currency varchar [note: 'ISO 4217 currency code for the minimum transfer amount.']
  number varchar [note: 'External reference number or code assigned to the CSA by the firm or regulator.']
  threshold_amount decimal(20,2) [note: 'Monetary amount that triggers a margin call under the CSA.']
  threshold_currency varchar [note: 'ISO 4217 currency code for the threshold amount.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the CSA record.']
  valuation_currency varchar [note: 'Currency in which collateral valuations are expressed.']

  Note: 'Master record for each Credit Support Annex (CSA) attached to an ISDA Master Agreement. Stores CSA type (English Law, New York Law, ISDA 2016 VM CSA), threshold amounts, minimum transfer amounts (MTA), independent amounts (IA), eligible collateral'
}

Table collateral.netting_agreement {
  netting_agreement_id varchar [pk, note: 'Unique system-generated identifier for the netting agreement record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Netting agreements are bilateral contracts between the pension fund and a specific counterparty.']
  agreement_classification varchar [note: 'Indicates whether the netting arrangement is bilateral (between two parties) or multilateral (involving multiple parties).']
  agreement_number varchar [note: 'External business identifier or reference number assigned to the netting agreement.']
  amendment_date date [note: 'Date on which the latest amendment to the agreement was executed.']
  amendment_number varchar [note: 'Sequential number of the most recent amendment to the agreement.']
  collateral_eligibility_criteria varchar [note: 'Business rules defining which assets qualify as eligible collateral under the agreement.']
  collateral_type varchar [note: 'Primary form of collateral accepted (cash, securities, or both).']
  comments varchar [note: 'Free‑form field for any supplemental notes or remarks about the agreement.']
  created_timestamp timestamp [note: 'Date‑time when the netting agreement record was first created in the system.']
  credit_limit decimal(20,2) [note: 'Maximum credit exposure permitted for the counterparty under the netting arrangement.']
  currency_code varchar [note: 'ISO 4217 three‑letter code of the currency used for the threshold amount.']
  effective_from date [note: 'Date on which the netting agreement becomes legally binding.']
  effective_until date [note: 'Date on which the netting agreement terminates or expires; null for open‑ended agreements.']
  governing_law varchar [note: 'Jurisdiction whose law governs the interpretation and enforcement of the agreement.']
  last_review_date date [note: 'Date when the agreement was last reviewed for compliance or operational relevance.']
  margin_call_frequency varchar [note: 'How often margin calls are calculated and communicated under the agreement.']
  netting_agreement_description varchar [note: 'Free‑form textual description of the netting agreement purpose and key terms.']
  netting_agreement_status varchar [note: 'Current lifecycle status of the netting agreement.']
  netting_type varchar [note: 'Specifies the type of netting covered by the agreement: close‑out, payment, or novation.']
  product_scope varchar [note: 'Asset classes covered by the netting agreement.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the agreement is subject to EMIR reporting obligations.']
  risk_weight decimal(5,2) [note: 'Regulatory risk‑weight percentage applied to the netted exposure.']
  settlement_cycle varchar [note: 'Standard settlement convention applied to transactions covered by the agreement.']
  threshold_amount decimal(20,2) [note: 'Monetary amount of collateral that must be posted before netting is applied.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the netting agreement record.']
  valuation_method varchar [note: 'Method used to value eligible collateral (e.g., market price, model‑based).']

  Note: 'Master record for each bilateral netting agreement (close-out netting or payment netting) executed with a counterparty. Captures netting type (close-out, payment, novation), governing law, effective date, product scope (rates, FX, credit, equity'
}

Table collateral.eligibility_schedule {
  eligibility_schedule_id varchar [pk, note: 'Unique system-generated identifier for the collateral eligibility schedule.']
  agreement_csa_id varchar [note: 'Identifier of the CSA or CCP agreement to which this eligibility schedule applies.']
  csa_id varchar [note: 'Identifier of the CSA or CCP agreement to which this eligibility schedule applies.']
  asset_class varchar [note: 'Asset class that is eligible as collateral under this schedule.']
  collateral_category varchar [note: 'High‑level category of the collateral (e.g., primary, secondary, liquidity, haircut).']
  created_timestamp timestamp [note: 'Timestamp when the eligibility schedule record was first created in the system.']
  currency varchar [note: 'Three‑letter ISO 4217 currency code for the eligible collateral.']
  effective_from date [note: 'Date on which the eligibility schedule becomes binding.']
  effective_until date [note: 'Date on which the eligibility schedule expires or is superseded; null if open‑ended.']
  eligibility_criteria varchar [note: 'Detailed textual rules defining eligibility beyond asset class and currency.']
  eligibility_schedule_description varchar [note: 'Free‑form description of the schedule, its purpose, and any special conditions.']
  eligibility_status varchar [note: 'Current operational status of the eligibility schedule.']
  haircut_percentage decimal(5,2) [note: 'Percentage reduction applied to the market value of the collateral for risk weighting.']
  is_marginable boolean [note: 'Indicates whether the eligible asset can be used for margin purposes.']
  last_review_date date [note: 'Date when the eligibility schedule was last reviewed for compliance or market changes.']
  max_balance decimal(18,2) [note: 'Maximum monetary amount of the eligible asset that can be posted under this schedule.']
  min_balance decimal(18,2) [note: 'Minimum monetary amount of the eligible asset that must be posted as collateral.']
  regulatory_reference varchar [note: 'Reference to the specific EMIR or other regulatory clause governing the schedule.']
  review_frequency varchar [note: 'How often the schedule must be reviewed or re‑validated.']
  risk_weight decimal(5,4) [note: 'Risk weight assigned to the collateral class for capital adequacy calculations.']
  schedule_name varchar [note: 'Human‑readable name for the eligibility schedule used in reporting and governance.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the eligibility schedule record.']
  version_number varchar [note: 'Sequential version of the eligibility schedule for change management.']

  Note: 'Defines the collateral eligibility criteria and haircut schedules applicable under each CSA or CCP clearing membership. Stores eligible asset classes (government bonds, agency bonds, cash, equities, money market funds), currency eligibility, minimum'
}

Table collateral.credit_limit {
  credit_limit_id varchar [pk, note: 'Unique surrogate key for the credit limit record.']
  counterparty_id varchar [note: 'Surrogate key referencing the counterparty to which the limit applies.']
  approval_date date [note: 'Date on which the credit limit was formally approved by the committee.']
  approved_by varchar [note: 'Name of the individual who signed off the credit limit approval.']
  breach_action varchar [note: 'Pre‑defined action to be taken when a breach occurs.']
  breach_date date [note: 'Date on which the credit limit breach was first identified.']
  breach_threshold decimal(5,2) [note: 'Utilization percentage that constitutes a breach of the credit limit.']
  collateral_eligible boolean [note: 'True if the counterparty\'s exposures are eligible for collateral posting under EMIR.']
  committee_name varchar [note: 'Name of the Investment or Risk Committee that granted the limit.']
  created_timestamp timestamp [note: 'Timestamp when the credit limit record was first created in the system.']
  credit_limit_status varchar [note: 'Current lifecycle status of the credit limit.']
  credit_rating varchar [note: 'Credit rating from external agencies (e.g., S&P, Moody\'s) for the counterparty. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D — promote to reference product]']
  effective_from date [note: 'Date when the credit limit becomes effective.']
  effective_until date [note: 'Date when the credit limit expires or is scheduled to be reviewed; null for open‑ended.']
  emir_reporting_indicator boolean [note: 'True when the limit is subject to EMIR reporting requirements.']
  is_override boolean [note: 'Indicates whether the limit has been manually overridden beyond standard rules.']
  last_review_date date [note: 'Date when the credit limit was last reviewed by risk governance.']
  limit_amount decimal(20,2) [note: 'Maximum credit exposure approved for the counterparty, in the limit currency.']
  limit_amount_usd decimal(20,2) [note: 'Approved limit converted to US dollars for reporting purposes.']
  limit_category varchar [note: 'High‑level grouping of the limit (e.g., counterparty, portfolio, group).']
  limit_change_reason varchar [note: 'Narrative explanation for any amendment to the credit limit.']
  limit_currency varchar [note: 'Three‑letter ISO 4217 code of the currency in which the limit is expressed.']
  limit_identifier varchar [note: 'Business identifier or code assigned to the credit limit.']
  limit_revision_number varchar [note: 'Sequential revision number tracking changes to the limit over time.']
  limit_subtype varchar [note: 'Optional finer classification of the limit within its category.']
  limit_type varchar [note: 'Classification of the limit based on its application scope.']
  margin_call_threshold decimal(5,2) [note: 'Utilization percentage that triggers a margin call under the agreement.']
  next_review_date date [note: 'Planned date for the next periodic review of the credit limit.']
  override_reason varchar [note: 'Justification provided for a manual override of the limit.']
  regulatory_reporting_flag boolean [note: 'Indicates if the limit must be reported under regulatory regimes (e.g., EMIR).']
  risk_rating varchar [note: 'Internal risk rating assigned to the limit exposure.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the credit limit record.']
  usage_amount decimal(20,2) [note: 'Current amount of credit already utilized against the approved limit.']
  usage_percentage decimal(5,2) [note: 'Percentage of the approved limit that is currently utilized.']

  Note: 'Master record defining the approved counterparty credit exposure limits set by the Investment Committee or Risk Committee for each counterparty. Stores limit type (pre-settlement, settlement, issuer, aggregate), limit currency, approved limit amount'
}

Table collateral.exposure {
  exposure_id varchar [pk, note: 'Unique identifier for the daily exposure record.']
  counterparty_id varchar [note: 'Identifier of the counterparty for which exposure is measured.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Counterparty exposure stress testing under economic scenarios (base/adverse/severely adverse) is required for Basel III CVA capital, EMIR reporting, and internal risk limits.']
  netting_agreement_id varchar [note: 'Identifier of the netting set grouping related OTC derivatives.']
  stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: Regulatory stress testing (EMIR, Basel) requires stressed counterparty exposure calculations. Pension funds must report stressed exposures under defined scenarios.']
  collateral_held decimal(20,4) [note: 'Value of collateral posted against the exposure.']
  collateral_usd decimal(20,4) [note: 'Collateral amount converted to US dollars.']
  comments varchar [note: 'Additional free‑form notes from analysts or operations.']
  created_timestamp timestamp [note: 'Timestamp when the exposure record was first created.']
  currency_code varchar [note: 'Three‑letter ISO currency code of the exposure amounts.']
  cvar decimal(20,4) [note: 'Expected loss exceeding VaR, used for tail‑risk analysis.']
  data_quality_score decimal(5,2) [note: 'Score (0‑100) indicating confidence in the exposure data quality.']
  dv01 decimal(20,4) [note: 'Sensitivity of the exposure to a one‑basis‑point shift in interest rates.']
  effective_from date [note: 'Start date of the exposure\'s validity period.']
  effective_until date [note: 'End date of the exposure\'s validity period (nullable).']
  exposure_category varchar [note: 'High‑level asset class category of the exposure.']
  exposure_description varchar [note: 'Free‑form description or notes about the exposure record.']
  exposure_status varchar [note: 'Current lifecycle status of the exposure record.']
  exposure_type varchar [note: 'Classification of the exposure measurement.']
  gross_exposure_usd decimal(20,4) [note: 'Gross positive exposure converted to US dollars.']
  gross_positive_exposure decimal(20,4) [note: 'Total positive mark‑to‑market exposure before netting.']
  is_approximate boolean [note: 'True if the exposure values are estimated rather than fully calculated.']
  is_historical boolean [note: 'True if the record represents a historical (non‑current) exposure.']
  last_margin_call_amount decimal(20,4) [note: 'Amount of the most recent margin call.']
  last_margin_call_date date [note: 'Date of the most recent margin call associated with this exposure.']
  margin_call_amount decimal(20,4) [note: 'Amount of additional collateral required by the margin call.']
  margin_call_flag boolean [note: 'Indicates whether a margin call was generated for the exposure.']
  net_exposure decimal(20,4) [note: 'Exposure after applying netting agreements, before collateral.']
  net_exposure_after_collateral decimal(20,4) [note: 'Net exposure after deducting posted collateral.']
  net_exposure_usd decimal(20,4) [note: 'Net exposure converted to US dollars.']
  netting_set_name varchar [note: 'Human‑readable name of the netting set.']
  regulatory_reporting_flag boolean [note: 'True if the exposure is included in regulatory reporting (e.g., EMIR).']
  reporting_period varchar [note: 'Frequency at which the exposure is reported.']
  risk_factor varchar [note: 'Key risk factor identifier (e.g., interest rate, credit spread) driving the exposure.']
  risk_weight decimal(5,2) [note: 'Regulatory risk weight applied to the exposure for capital calculations.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the exposure record.']
  valuation_date date [note: 'Date of the exposure valuation (yyyy-MM-dd).']
  valuation_timestamp timestamp [note: 'Exact timestamp when the exposure was calculated.']
  var decimal(20,4) [note: 'Statistical risk measure representing potential loss at a confidence level.']
  version varchar [note: 'Version number for revisions of the same exposure snapshot.']

  Note: 'Daily counterparty exposure record capturing gross and net MTM exposure per counterparty across all OTC derivative netting sets. Stores valuation date, gross positive exposure (GPE), net exposure after netting, collateral held, net exposure after'
}

Table collateral.margin_call {
  margin_call_id varchar [pk, note: 'System-generated unique identifier for each margin call record.']
  collateral_account_id varchar [note: 'Identifier of the account holding collateral pledged for the margin call.']
  counterparty_id varchar [note: 'Unique identifier of the counterparty to which the margin call relates.']
  csa_id varchar [note: 'Foreign key linking to collateral.csa. Business justification: Margin calls are governed by CSA terms including threshold amounts, minimum transfer amounts, and call frequency. Linking margin_call to csa enables retrieval of the governing agreement terms.']
  party_counterparty_id varchar [note: 'Unique identifier of the counterparty to which the margin call relates.']
  processed_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Margin call processing requires audit trail of which employee processed/approved the call. Critical for operational risk controls, regulatory compliance, and segregation of duties in']
  related_trade_blotter_id varchar [note: 'Identifier of the trade that triggered the margin requirement.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Margin calls are triggered by valuation changes. Pension funds must link margin call amounts to the specific asset valuation that triggered the call for regulatory']
  adjustment_amount decimal(20,4) [note: 'Any positive or negative adjustment applied to the gross call amount.']
  adjustment_reason varchar [note: 'Free‑text description of why an adjustment was made to the margin call amount.']
  call_amount decimal(20,4) [note: 'Total amount requested in the margin call before any adjustments, expressed in the call currency.']
  call_batch_reference varchar [note: 'Identifier of the batch grouping multiple margin calls generated together.']
  call_currency varchar [note: 'Three‑letter ISO 4217 code of the currency in which the margin call amount is denominated.']
  call_date timestamp [note: 'Date and time when the margin call was generated or received in the operational system.']
  call_direction varchar [note: 'Indicates whether the margin call was issued to a counterparty or received from a counterparty.']
  call_number varchar [note: 'External reference number assigned to the margin call by the front‑office system.']
  call_processed_flag boolean [note: 'True when the margin call has been fully processed and posted.']
  call_sequence_number varchar [note: 'Ordinal position of the margin call within its batch.']
  collateral_amount decimal(20,4) [note: 'Monetary value of the collateral posted, expressed in the collateral currency.']
  collateral_currency varchar [note: 'ISO 4217 code of the currency in which collateral amount is denominated.']
  collateral_type varchar [note: 'Category of collateral posted against the margin call.']
  comments varchar [note: 'Free‑form notes entered by operations or risk teams.']
  created_timestamp timestamp [note: 'Timestamp when the margin call record was first created in the data lake.']
  due_date date [note: 'Deadline by which the counterparty must satisfy the margin call.']
  exchange_rate decimal(12,6) [note: 'FX rate applied when converting between call currency and reporting currency.']
  exchange_rate_date date [note: 'Date on which the exchange rate was sourced.']
  external_reference varchar [note: 'Identifier of the margin call in an external system (e.g., Aladdin, SimCorp).']
  interest_rate decimal(6,4) [note: 'Interest rate applied to the margin amount when the call is overdue, expressed as a decimal.']
  interest_rate_type varchar [note: 'Indicates whether the margin interest rate is fixed or floating.']
  margin_call_status varchar [note: 'Current processing state of the margin call within the workflow.']
  margin_type varchar [note: 'Specifies whether the call relates to variation margin (VM) or initial margin (IM).']
  net_amount decimal(20,4) [note: 'Final amount after adjustments (fees, interest) that the counterparty must pay.']
  net_currency varchar [note: 'Currency of the net amount payable.']
  processed_by varchar [note: 'Identifier of the user or system that processed the margin call.']
  processed_timestamp timestamp [note: 'Date and time when the margin call was processed (e.g., posted to accounting).']
  regulatory_report_flag boolean [note: 'True if the margin call must be reported under EMIR or similar regulations.']
  regulatory_report_status varchar [note: 'Current status of the regulatory report for this margin call.']
  settlement_date date [note: 'Date on which the margin call amount is expected to be settled.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the margin call record.']
  valuation_amount decimal(20,4) [note: 'Monetary value of the portfolio used in the margin calculation.']
  valuation_currency varchar [note: 'Currency in which the valuation amount is expressed.']
  valuation_date date [note: 'Date of the market valuation used to calculate the margin requirement.']
  valuation_method varchar [note: 'Methodology used to value the underlying positions for margin calculation.']
  valuation_source varchar [note: 'System or vendor providing the market data for valuation (e.g., Bloomberg, internal model).']

  Note: 'Transactional record of each margin call issued or received in the collateral management workflow. Captures call date, call direction (call issued / call received), margin type (VM — Variation Margin or IM — Initial Margin), call amount, call currency'
}

Table collateral.margin_dispute {
  margin_dispute_id varchar [pk, note: 'Unique system-generated identifier for the margin dispute record.']
  counterparty_id varchar [note: 'Identifier of the counterparty (e.g., broker, clearing house) that raised or is subject to the dispute.']
  margin_call_id varchar [note: 'Identifier of the margin call that triggered the dispute.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Margin disputes frequently arise from valuation disagreements. Linking disputes to the contested valuation record enables pension funds to track dispute resolution and']
  comments varchar [note: 'Optional free‑form comments captured by the disputing party.']
  created_timestamp timestamp [note: 'Timestamp when the dispute record was first created in the system.']
  dispute_date timestamp [note: 'Timestamp when the margin dispute was initially raised by a party.']
  dispute_initiator varchar [note: 'Party that originated the dispute (either the counterparty or the fund).']
  dispute_number varchar [note: 'Business-facing identifier assigned to the dispute, used in communications and reporting.']
  dispute_reason varchar [note: 'Root cause of the dispute, such as valuation mismatch, eligibility disagreement, or haircut issue.']
  disputed_amount decimal(20,2) [note: 'Monetary amount that is being contested in the dispute.']
  disputed_currency varchar [note: 'Three‑letter ISO currency code of the disputed amount.']
  eligibility_flag boolean [note: 'Indicates whether the dispute relates to collateral eligibility (true) or not (false).']
  haircut_dispute_flag boolean [note: 'True if the dispute concerns the applied haircut on collateral.']
  margin_dispute_status varchar [note: 'Current lifecycle state of the dispute (e.g., open, resolved, closed, rejected).']
  resolution_amount decimal(20,2) [note: 'Final monetary amount agreed upon after dispute resolution.']
  resolution_currency varchar [note: 'Currency code of the resolved amount.']
  resolution_date date [note: 'Date on which the dispute was formally resolved.']
  resolution_notes varchar [note: 'Free‑text notes describing the outcome and any agreed actions.']
  resolution_status varchar [note: 'Current status of the dispute resolution workflow.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the dispute record.']
  valuation_date date [note: 'Date of the market valuation that is the basis of the dispute.']

  Note: 'Transactional record of each margin call dispute raised by either party. Captures dispute date, disputing party, disputed amount, dispute reason (valuation difference, eligibility disagreement, haircut dispute), resolution status (open, resolved'
}

Table collateral.posting {
  posting_id varchar [pk, note: 'Unique system-generated identifier for the collateral posting record.']
  collateral_position_id varchar [note: 'Foreign key linking to collateral.collateral_position. Business justification: A collateral posting instruction affects a specific collateral position. When collateral is posted or returned, it updates the position inventory.']
  counterparty_id varchar [note: 'Identifier of the counterparty (e.g., clearing member, broker) involved in the posting.']
  margin_call_id varchar [note: 'Identifier of the margin call that triggered this posting.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: When collateral is posted, the asset_value must be supported by a formal valuation.']
  asset_identifier varchar [note: 'Unique market identifier of the posted asset (ISIN, CUSIP, or SEDOL).']
  asset_quantity decimal(20,4) [note: 'Number of units of the posted asset (e.g., shares, bond face value).']
  asset_type varchar [note: 'Classification of the collateral asset being posted.']
  asset_value decimal(20,4) [note: 'Market value of the posted asset at the time of posting, expressed in the posting currency.']
  collateral_quality varchar [note: 'Regulatory eligibility status of the posted collateral.']
  collateral_source varchar [note: 'Origin of the collateral (e.g., cash pool, bond portfolio).']
  comments varchar [note: 'Free‑form notes entered by operations staff regarding the posting.']
  created_timestamp timestamp [note: 'Timestamp when the posting record was first created in the data lake.']
  currency_code varchar [note: 'Three‑letter ISO currency code of the posting amount.']
  direction varchar [note: 'Indicates whether collateral was posted to, received from, or returned to the counterparty.']
  exchange_rate decimal(12,6) [note: 'FX rate used when the posting currency differs from the fund\'s base currency.']
  gross_amount decimal(20,4) [note: 'Total amount of collateral posted before haircuts and adjustments.']
  haircut_percentage decimal(5,2) [note: 'Risk haircut applied to the collateral value, expressed as a percent.']
  internal_reference varchar [note: 'Internal reference or memo number used for reconciliation across systems.']
  net_amount decimal(20,4) [note: 'Collateral amount after applying haircuts and any adjustments.']
  number varchar [note: 'External reference number assigned to the posting by the front‑office or margin‑call system.']
  posting_status varchar [note: 'Current lifecycle state of the posting record.']
  regulatory_reported boolean [note: 'Indicates whether the posting has been reported to EMIR or other regulatory regimes.']
  settlement_date date [note: 'Date on which the posting is expected to settle or was settled.']
  settlement_method varchar [note: 'Mechanism used to settle the collateral posting.']
  timestamp timestamp [note: 'Date‑time when the posting instruction was executed in the market.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the posting record.']
  valuation_date date [note: 'Date on which the asset value was determined for the posting.']
  valuation_method varchar [note: 'Methodology used to determine the asset\'s market value for the posting.']

  Note: 'Transactional record of each collateral posting or return instruction executed to satisfy a margin call. Captures posting date, posting direction (posted / received / returned), asset type (cash, government bond, agency bond, equity), ISIN/CUSIP of posted'
}

Table collateral.collateral_position {
  collateral_position_id varchar [pk, note: 'Unique system-generated identifier for the collateral position record.']
  ccp_ccp_membership_id varchar [note: 'Identifier of the clearing house (CCP) when collateral is posted to a CCP.']
  ccp_membership_id varchar [note: 'Identifier of the clearing house (CCP) when collateral is posted to a CCP.']
  counterparty_id varchar [note: 'Identifier of the counterparty or client to which the collateral is held or pledged.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Collateral positions require independent valuations for margin adequacy.']
  asset_cusip varchar [note: 'North American security identifier for the collateral asset, when applicable.']
  asset_isin varchar [note: 'Standardized 12‑character identifier for the underlying security used as collateral.']
  asset_type varchar [note: 'Classification of the collateral asset (cash, security, repo, derivative).']
  collateral_position_description varchar [note: 'Free‑form text providing additional context about the position.']
  collateral_position_status varchar [note: 'Current lifecycle state of the position (e.g., active, inactive, closed).']
  collateral_type varchar [note: 'Business classification used for regulatory and risk reporting.']
  created_timestamp timestamp [note: 'Timestamp when the position record was first created in the system.']
  currency varchar [note: 'Three‑letter ISO 4217 currency code of the market value.']
  eligible_flag boolean [note: 'True if the asset meets eligibility criteria for posting under the agreement.']
  haircut_percent decimal(5,2) [note: 'Regulatory haircut applied to the market value, expressed as a percent.']
  label varchar [note: 'Human‑readable label describing the collateral position (e.g., "Cash Collateral for Counterparty X on 2023‑10‑01").']
  margin_call_flag boolean [note: 'True if the position triggered a margin call on the reporting date.']
  market_value decimal(20,2) [note: 'Current market value of the collateral in the reporting currency.']
  net_market_value decimal(20,2) [note: 'Market value after applying the haircut (market_value * (1‑haircut_percent/100)).']
  position_date date [note: 'The business date for which the collateral snapshot is taken.']
  position_source varchar [note: 'Origin of the data feed (internal system vs external market data).']
  quantity decimal(20,6) [note: 'Nominal amount of the collateral asset (units or face value).']
  reference varchar [note: 'Business reference code for the position, often used in reporting and reconciliation.']
  regulatory_reportable_flag boolean [note: 'True if the position must be reported under EMIR or similar regulations.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the position record.']
  valuation_method varchar [note: 'Method used to determine the market value of the collateral.']

  Note: 'Daily snapshot of the collateral inventory held or pledged with each counterparty or CCP, representing the current collateral book of record. Stores position date, counterparty or CCP, asset ISIN/CUSIP, asset type, nominal quantity, market value, haircut'
}

Table collateral.ccp_membership {
  ccp_membership_id varchar [pk, note: 'Unique surrogate key for each CCP membership record.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: CCP memberships are overseen by specific regulators (ESMA for EU CCPs, CFTC for US).']
  ccp_name varchar [note: 'Name of the central counterparty clearing house.']
  cleared_product varchar [note: 'Asset class or product category cleared under the membership.']
  clearing_broker_lei varchar [note: 'LEI of the broker that holds the clearing membership on behalf of the fund.']
  collateral_eligible boolean [note: 'Indicates whether the membership permits posting collateral.']
  collateral_type_allowed varchar [note: 'Types of assets that can be used as collateral for this membership.']
  compliance_document_reference varchar [note: 'Identifier of the regulatory compliance document linked to this membership.']
  created_timestamp timestamp [note: 'Timestamp when the membership record was created in the system.']
  credit_limit decimal(18,2) [note: 'Maximum credit exposure permitted by the CCP for the member.']
  effective_from date [note: 'Date when the membership becomes effective.']
  effective_until date [note: 'Date when the membership ends or expires; null if open‑ended.']
  fee_amount decimal(18,2) [note: 'Monetary amount of the membership fee for the current period.']
  fee_structure varchar [note: 'Method used to calculate CCP membership fees.']
  initial_margin_requirement decimal(18,2) [note: 'Initial margin amount required by the CCP for this membership.']
  jurisdiction varchar [note: 'Country jurisdiction governing the CCP membership.']
  last_fee_assessed_date date [note: 'Date when the most recent membership fee was assessed.']
  last_margin_call_amount decimal(18,2) [note: 'Amount of the most recent margin call.']
  last_margin_call_date date [note: 'Date of the most recent margin call issued by the CCP.']
  margin_call_frequency varchar [note: 'How often margin calls are issued under the membership.']
  membership_status varchar [note: 'Current lifecycle status of the CCP membership.']
  membership_type varchar [note: 'Classification of the membership relationship with the CCP.']
  netting_agreement_flag boolean [note: 'True if a netting agreement exists with the CCP.']
  notes varchar [note: 'Free‑form comments or remarks about the membership.']
  registration_date date [note: 'Date the membership was formally registered with the CCP.']
  regulatory_reporting_status varchar [note: 'Status of EMIR/other regulatory reporting for this membership.']
  reporting_currency varchar [note: 'Currency used for reporting balances and margins to the CCP.']
  risk_weight decimal(5,2) [note: 'Risk‑weight factor applied to exposures under this membership.']
  settlement_cycle varchar [note: 'Standard settlement period for trades cleared through this CCP.']
  termination_date date [note: 'Date the membership was terminated, if applicable.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the membership record.']
  variation_margin_requirement decimal(18,2) [note: 'Daily variation margin amount that must be posted to the CCP.']

  Note: 'Master record for each Central Counterparty (CCP) clearing membership held by the pension fund or its clearing broker. Stores CCP name (LCH, Eurex, CME, ICE), membership type (direct clearing member, client clearing), clearing broker LEI, cleared product'
}

Table collateral.simm_calculation {
  simm_calculation_id varchar [pk, note: 'Unique system-generated identifier for the SIMM calculation record.']
  counterparty_id varchar [note: 'Identifier of the counterparty for which the SIMM margin is calculated.']
  netting_agreement_id varchar [note: 'Reference to the netting agreement governing offsetting of exposures.']
  portfolio_id varchar [note: 'Identifier of the investment portfolio containing the trades subject to the calculation.']
  calculation_method varchar [note: 'Indicates whether the calculation follows the standard SIMM methodology or a custom approach.']
  calculation_number varchar [note: 'External business identifier or reference number assigned to the SIMM calculation.']
  calculation_source_system varchar [note: 'System that performed the SIMM calculation (e.g., Aladdin, In‑house engine).']
  calculation_timestamp timestamp [note: 'Timestamp when the SIMM calculation was performed.']
  collateral_eligible boolean [note: 'Indicates if the calculated margin is eligible to be posted as collateral.']
  comments varchar [note: 'Free‑form notes or remarks about the calculation.']
  confidence_interval decimal(5,2) [note: 'Statistical confidence interval associated with the margin estimate.']
  created_timestamp timestamp [note: 'Timestamp when the calculation record was first created in the system.']
  initial_margin_amount decimal(20,2) [note: 'Gross initial margin calculated before netting or offsets.']
  input_data_hash varchar [note: 'Cryptographic hash of the raw input data set used for reproducibility.']
  is_override boolean [note: 'True if the margin amount was manually overridden after automatic calculation.']
  margin_adjustment decimal(20,2) [note: 'Any manual or regulatory adjustments applied to the margin.']
  margin_call_date date [note: 'Date by which the margin call should be satisfied.']
  margin_call_required boolean [note: 'True if a margin call must be issued based on the calculation result.']
  margin_currency varchar [note: 'Three‑letter ISO currency code of the margin amounts.']
  margin_factor decimal(10,4) [note: 'Multiplicative factor used in the margin calculation (e.g., scaling for stress scenarios).']
  margin_type varchar [note: 'Specifies whether the margin is initial, variation, or both.']
  model_version varchar [note: 'Version of the ISDA SIMM model applied (e.g., v2.5).']
  net_margin_amount decimal(20,2) [note: 'Margin amount after applying netting and eligible offsets.']
  override_reason varchar [note: 'Explanation provided for a manual margin override.']
  regulatory_framework varchar [note: 'Regulatory regime governing the margin calculation, e.g., EMIR.']
  regulatory_reportable boolean [note: 'Indicates whether the calculation result must be reported to regulators.']
  risk_class varchar [note: 'Primary risk class of the underlying exposure (e.g., interest rate, credit).']
  sensitivity_count varchar [note: 'Number of individual risk factor sensitivities processed in the calculation.']
  simm_calculation_status varchar [note: 'Current processing status of the SIMM calculation.']
  total_risk_weight decimal(10,6) [note: 'Aggregate risk weight applied across all risk factors.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the calculation record.']
  valuation_date date [note: 'Date of the market data snapshot used for valuation in the calculation.']
  version_number varchar [note: 'Version number of the calculation record for audit and change tracking.']

  Note: 'Transactional record of each ISDA SIMM (Standard Initial Margin Model) calculation performed for bilateral uncleared OTC derivatives under EMIR UMR (Uncleared Margin Rules).'
}

Table collateral.repo_transaction {
  repo_transaction_id varchar [pk, note: 'System-generated unique identifier for the repo transaction record.']
  broker_id varchar [note: 'Unique identifier of the broker facilitating the repo transaction.']
  ccp_membership_id varchar [note: 'Identifier of the clearing house that processes the repo settlement.']
  counterparty_id varchar [note: 'Unique identifier of the counterparty (bank, broker, or dealer) to the pension fund.']
  legal_entity_id varchar [note: 'Identifier of the legal entity (LEI) owning the transaction.']
  repo_collateral_security_listed_security_id varchar [note: 'Identifier of the security or asset posted as collateral for the repo.']
  repo_listed_security_id varchar [note: 'Identifier of the security that is being financed through the repo.']
  accrued_interest decimal(20,2) [note: 'Interest accrued on the principal up to the reporting date.']
  collateral_type varchar [note: 'Classification of the collateral (cash, securities, or other assets).']
  collateral_value decimal(20,2) [note: 'Current market valuation of the posted collateral.']
  created_timestamp timestamp [note: 'Timestamp when the repo transaction record was first created in the system.']
  currency varchar [note: 'ISO 4217 currency code of the cash leg of the repo transaction.']
  emir_reporting_status varchar [note: 'Current status of EMIR reporting for the transaction.']
  external_trade_reference varchar [note: 'Identifier assigned by the external execution system or broker.']
  haircut_percent decimal(5,2) [note: 'Percentage discount applied to the collateral value for risk mitigation.']
  initial_margin_amount decimal(20,2) [note: 'Initial collateral margin posted at the start of the repo.']
  is_cleared boolean [note: 'True if the transaction has been cleared through a CCP or clearing house.']
  is_closed boolean [note: 'True when the repo has been fully settled and closed.']
  is_marginable boolean [note: 'Indicates whether the repo transaction is eligible for margining under regulatory rules.']
  is_open boolean [note: 'Indicates whether the repo transaction is currently open (true) or closed (false).']
  is_rehypothecated boolean [note: 'True if the posted collateral may be rehypothecated by the counterparty.']
  is_secured boolean [note: 'Indicates whether the transaction is fully secured by collateral.']
  maturity_date date [note: 'Date when the repo transaction matures and the original security is repurchased.']
  net_amount decimal(20,2) [note: 'Net cash amount after adding accrued interest and subtracting fees.']
  notes varchar [note: 'Free‑form text for any additional information or comments about the repo transaction.']
  principal_amount decimal(20,2) [note: 'Cash amount lent or borrowed in the repo transaction.']
  regulatory_reporting_flag boolean [note: 'Indicates the regulatory reporting status of the repo under EMIR/SEC.']
  repo_rate decimal(10,6) [note: 'Annualized interest rate applied to the principal for the repo term.']
  repo_rate_type varchar [note: 'Specifies whether the repo rate is fixed for the term or floating based on a reference index.']
  repo_term_days varchar [note: 'Length of the repo agreement expressed in calendar days.']
  repo_trade_reference varchar [note: 'External trade identifier assigned by the execution venue or broker.']
  repo_transaction_status varchar [note: 'Current processing state of the repo transaction.']
  repo_type varchar [note: 'Indicates whether the transaction is a repo (sell‑and‑repurchase) or reverse repo (buy‑and‑sell).']
  settlement_amount decimal(20,2) [note: 'Total amount settled at maturity, including principal and interest.']
  settlement_currency varchar [note: 'Currency code used for the final settlement payment.']
  settlement_date date [note: 'Date on which cash and securities are exchanged to settle the repo.']
  settlement_method varchar [note: 'Method used to settle the repo (cash, securities, or netting).']
  tax_withholding_amount decimal(20,2) [note: 'Monetary amount of tax withheld from the interest component.']
  tax_withholding_percent decimal(5,2) [note: 'Percentage of tax withheld on interest payments, if applicable.']
  termination_date date [note: 'Date on which the repo transaction was terminated.']
  termination_reason varchar [note: 'Reason why the repo transaction was terminated before or at maturity.']
  trade_date date [note: 'Calendar date on which the repo trade was agreed.']
  trade_execution_venue varchar [note: 'Platform or market where the repo trade was executed.']
  transaction_timestamp timestamp [note: 'Date and time when the repo trade was executed in the market.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the repo transaction record.']
  variation_margin_amount decimal(20,2) [note: 'Additional margin required due to changes in market value of the collateral.']

  Note: 'Transactional record of each repurchase agreement (repo) or reverse repo executed for collateral transformation, liquidity management, or securities financing.'
}

Table collateral.securities_lending {
  securities_lending_id varchar [pk, note: 'Unique surrogate key for each securities lending transaction record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Securities lending transactions are executed with counterparties; adding counterparty_id FK links the transaction to the counterparty and removes redundant LEI/BIC columns.']
  listed_security_id varchar [note: 'ISIN of the security that is being lent.']
  amendment_date date [note: 'Date when the most recent amendment to the loan was executed.']
  amendment_number varchar [note: 'Sequential number of any amendment to the original loan agreement.']
  collateral_currency varchar [note: 'ISO 4217 currency code of the collateral value.']
  collateral_eligibility_criteria varchar [note: 'Business rules defining which assets qualify as collateral for this loan.']
  collateral_type varchar [note: 'Classification of the collateral received for the loan.']
  collateral_value decimal(20,4) [note: 'Market value of the collateral at the time of loan initiation.']
  created_timestamp timestamp [note: 'Timestamp when the loan record was first created in the system.']
  credit_limit decimal(20,4) [note: 'Maximum credit exposure allowed for the counterparty under this loan.']
  currency_code varchar [note: 'ISO 4217 three‑letter code of the transaction currency.']
  effective_from date [note: 'Date on which the loan agreement becomes effective.']
  effective_until date [note: 'Date on which the loan agreement terminates or expires.']
  fee_amount decimal(20,4) [note: 'Monetary amount of fees charged for the loan.']
  fee_rate decimal(5,4) [note: 'Annualized fee rate charged for the securities loan, expressed as a decimal.']
  gross_amount decimal(20,4) [note: 'Total monetary amount before fees and rebates, in the loan currency.']
  last_review_date date [note: 'Date of the most recent compliance or risk review of the loan.']
  loan_number varchar [note: 'External business identifier assigned to the securities loan.']
  loan_open_timestamp timestamp [note: 'Date and time when the securities loan was initially opened.']
  loan_recall_timestamp timestamp [note: 'Date and time when the lender recalled the loaned securities.']
  loan_return_timestamp timestamp [note: 'Date and time when the loaned securities were returned to the lender.']
  loan_status varchar [note: 'Current lifecycle state of the securities loan.']
  loan_term_days varchar [note: 'Length of the loan in calendar days.']
  loan_type varchar [note: 'Classification of the loan product type.']
  margin_call_frequency varchar [note: 'How often margin calls are evaluated for the loan.']
  net_amount decimal(20,4) [note: 'Net monetary amount after applying fees and rebates.']
  rebate_rate decimal(5,4) [note: 'Annualized rebate rate paid by the borrower to the lender, expressed as a decimal.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the loan must be reported under EMIR or other regulations.']
  risk_weight decimal(5,4) [note: 'Regulatory risk weight assigned to the collateral.']
  securities_lending_description varchar [note: 'Free‑text description of the loan purpose or special terms.']
  security_cusip varchar [note: 'CUSIP of the security that is being lent.']
  security_quantity decimal(20,4) [note: 'Number of units of the security lent, expressed in the security\'s native units.']
  settlement_cycle varchar [note: 'Standard settlement period for the loan transaction.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the loan record.']
  valuation_method varchar [note: 'Method used to value the collateral at loan inception.']

  Note: 'Transactional record of each securities lending transaction where the pension fund lends securities from its portfolio in exchange for collateral. Captures loan open date, recall date, return date, lent security ISIN/CUSIP, quantity lent, collateral type'
}

Table collateral.substitution {
  substitution_id varchar [pk, note: 'Unique system-generated identifier for the collateral substitution transaction.']
  blotter_id varchar [note: 'Identifier of the underlying trade linked to the collateral substitution.']
  collateral_position_id varchar [note: 'Identifier of the collateral that is being replaced.']
  counterparty_id varchar [note: 'Identifier of the counterparty involved in the substitution.']
  employee_id varchar [note: 'System identifier of the user who created or last modified the record.']
  margin_call_id varchar [note: 'Identifier of the margin call that triggered the substitution, if applicable.']
  new_collateral_collateral_position_id varchar [note: 'Identifier of the collateral that is posted as replacement.']
  substitution_collateral_position_id varchar [note: 'Identifier of the collateral that is being replaced.']
  substitution_new_collateral_collateral_position_id varchar [note: 'Identifier of the collateral that is posted as replacement.']
  audit_user_role varchar [note: 'Business role of the user performing the audit action.']
  comments varchar [note: 'Additional free‑form notes captured by the operations team.']
  created_timestamp timestamp [note: 'Timestamp when the substitution record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three‑letter currency code for the collateral values.']
  effective_date date [note: 'Date on which the substitution becomes legally effective.']
  eligibility_flag boolean [note: 'Indicates whether the new collateral meets eligibility criteria under ISDA/CSA.']
  execution_timestamp timestamp [note: 'Date and time when the substitution was executed and posted.']
  fee_currency_code varchar [note: 'ISO 4217 currency code for the transaction fee.']
  haircut_percent decimal(5,2) [note: 'Percentage haircut applied to the new collateral value for margin purposes.']
  is_automated boolean [note: 'Indicates whether the substitution was processed automatically by workflow rules.']
  net_amount_change decimal(20,2) [note: 'Difference between new and old collateral values (new – old).']
  net_settlement_amount decimal(20,2) [note: 'Net cash amount to be settled after accounting for fees and haircuts.']
  net_settlement_currency varchar [note: 'Currency of the net settlement amount.']
  new_collateral_quantity decimal(20,6) [note: 'Quantity of the replacement collateral posted.']
  new_collateral_value decimal(20,2) [note: 'Monetary value of the replacement collateral at the time of substitution.']
  number varchar [note: 'External reference number assigned to the substitution request for tracking and reporting.']
  old_collateral_quantity decimal(20,6) [note: 'Quantity of the original collateral being substituted, expressed in its unit of measure.']
  old_collateral_value decimal(20,2) [note: 'Monetary value of the original collateral at the time of substitution.']
  reason_code varchar [note: 'Standard code indicating the primary driver for the substitution.']
  reason_description varchar [note: 'Free‑text explanation of why the substitution was performed.']
  regulatory_reporting_flag boolean [note: 'True if the substitution must be reported under EMIR or other regulatory regimes.']
  request_timestamp timestamp [note: 'Date and time when the substitution request was submitted.']
  settlement_date date [note: 'Date on which cash or securities settlement for the substitution occurs.']
  substitution_status varchar [note: 'Current lifecycle state of the substitution request.']
  substitution_type varchar [note: 'Category describing why the substitution is being performed.']
  transaction_fee decimal(20,2) [note: 'Fee charged for processing the collateral substitution.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the substitution record.']
  valuation_method varchar [note: 'Method used to value the collateral at the time of substitution.']

  Note: 'Transactional record of each collateral substitution request and execution, where previously posted collateral is replaced with an alternative eligible asset.'
}

Table collateral.credit_limit_breach {
  credit_limit_breach_id varchar [pk, note: 'Unique system-generated identifier for the credit limit breach event.']
  counterparty_id varchar [note: 'Identifier of the counterparty whose exposure triggered the breach.']
  credit_limit_id varchar [note: 'Foreign key linking to collateral.credit_limit. Business justification: A credit limit breach event occurs when exposure exceeds a specific credit limit. The breach should reference the exact credit_limit record that was breached.']
  limit_id varchar [note: 'Reference to the master credit limit record that was breached.']
  actual_exposure_amount decimal(20,2) [note: 'Measured exposure amount of the counterparty at the breach moment.']
  breach_amount decimal(20,2) [note: 'Monetary amount by which exposure exceeded the approved limit.']
  breach_number varchar [note: 'Business identifier assigned to the breach event for tracking and reference.']
  breach_percentage decimal(5,2) [note: 'Percentage of the approved limit that was exceeded (breach amount / approved limit).']
  breach_reason varchar [note: 'Narrative explanation of why the breach occurred (e.g., market move, valuation error).']
  breach_resolution_deadline date [note: 'Target date by which the breach must be resolved or mitigated.']
  breach_resolved_flag boolean [note: 'True if the breach has been fully addressed and exposure is back within limit.']
  breach_resolved_timestamp timestamp [note: 'Date and time when the breach was marked as resolved.']
  breach_severity varchar [note: 'Risk severity assigned to the breach based on magnitude and counterparty profile.']
  breach_timestamp timestamp [note: 'Date and time when the credit limit breach was detected.']
  comments varchar [note: 'Additional remarks from risk or compliance teams regarding the breach.']
  created_timestamp timestamp [note: 'Timestamp when the breach record was first created in the system.']
  credit_limit_breach_description varchar [note: 'Free‑form notes providing extra context about the breach.']
  credit_limit_breach_status varchar [note: 'Current lifecycle status of the breach record.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary amounts in this record.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this breach must be reported to regulators (e.g., SEC).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the breach record.']

  Note: 'Transactional record of each credit limit breach event where counterparty exposure exceeds an approved credit limit. Captures breach date, counterparty, limit type breached, approved limit amount, actual exposure at breach, breach magnitude (amount and'
}

Table collateral.emir_trade_report {
  emir_trade_report_id varchar [pk, note: 'Surrogate primary key for the EMIR trade report record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: EMIR trade reports reference a counterparty via LEI/BIC; adding counterparty_id FK provides a direct link and removes redundancy.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: EMIR trade reports must be submitted to specific regulatory authorities (ESMA, NCAs).']
  amendment_indicator boolean [note: 'True if the report represents an amendment to a previously submitted report.']
  clearing_house_lei varchar [note: 'LEI of the clearing house, if the trade is centrally cleared.']
  collateral_eligible_flag boolean [note: 'True if the trade is eligible to receive or post collateral under EMIR.']
  comments varchar [note: 'Additional remarks or notes related to the trade report.']
  created_timestamp timestamp [note: 'Timestamp when the EMIR trade report record was first created in the data lake.']
  emir_trade_report_description varchar [note: 'Free‑form description of the trade for internal reference.']
  jurisdiction varchar [note: 'Three‑letter country code of the regulatory jurisdiction.']
  margin_call_flag boolean [note: 'Indicates whether a margin call was generated for the trade.']
  maturity_date date [note: 'Date on which the derivative contract expires or settles.']
  notional_amount decimal(20,2) [note: 'Principal amount on which the derivative payoff is based.']
  notional_currency varchar [note: 'Three‑letter ISO currency code for the notional amount.']
  price decimal(20,6) [note: 'Price or rate agreed for the derivative contract.']
  price_currency varchar [note: 'Currency in which the trade price is expressed.']
  product_class varchar [note: 'High‑level classification of the derivative product.']
  quantity decimal(20,6) [note: 'Number of units or contracts involved in the trade.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the trade is subject to EMIR reporting.']
  report_date date [note: 'Calendar date on which the trade report was submitted to the trade repository.']
  report_status varchar [note: 'Processing status of the EMIR report within the trade repository.']
  reporting_entity_lei varchar [note: 'LEI of the pension fund entity that is responsible for the EMIR report.']
  risk_weight decimal(5,2) [note: 'Regulatory risk weight assigned to the trade for capital calculations.']
  settlement_date date [note: 'Date on which cash or securities settlement is due.']
  trade_status varchar [note: 'Current lifecycle state of the trade.']
  trade_timestamp timestamp [note: 'Exact date and time when the OTC derivative trade was executed.']
  trade_type varchar [note: 'Category of the derivative contract (e.g., swap, option).']
  trade_venue varchar [note: 'Identifier of the venue or platform where the trade was executed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the EMIR trade report record.']
  upi varchar [note: 'Identifier for the underlying product class of the trade as defined by EMIR.']
  uti varchar [note: 'Globally unique identifier assigned to the trade under EMIR reporting.']
  valuation_date date [note: 'Date on which the trade was valued for reporting purposes.']
  valuation_method varchar [note: 'Methodology used to determine the trade\'s value.']
  valuation_timestamp timestamp [note: 'Exact time of the valuation used for the EMIR report.']
  version_number varchar [note: 'Sequential version number for amended reports.']

  Note: 'Transactional record of each EMIR trade reporting submission for OTC derivative transactions to a registered Trade Repository (TR). Captures report date, UTI (Unique Trade Identifier), UPI (Unique Product Identifier), counterparty LEI, reporting'
}

Table collateral.ssi_registry {
  ssi_registry_id varchar [pk, note: 'Unique surrogate key for each SSI registry record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: SSIs are issued to counterparties; adding counterparty_id FK links SSIs to the counterparty and removes redundant LEI/BIC columns.']
  account_number varchar [note: 'Account identifier at the custodian for the settlement of the asset.']
  asset_type varchar [note: 'Category of asset for which the settlement instruction is used.']
  collateral_type varchar [note: 'Nature of collateral accepted under the SSI.']
  comments varchar [note: 'Free‑form notes or remarks about the SSI.']
  created_timestamp timestamp [note: 'Timestamp when the SSI record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code of the settlement currency.']
  custodian_bic varchar [note: 'BIC of the custodian bank holding the settlement account.']
  effective_from date [note: 'Date on which the SSI becomes effective for settlement.']
  effective_until date [note: 'Date on which the SSI expires or is superseded; null for open‑ended.']
  eligibility_criteria varchar [note: 'Business rules that determine whether an asset qualifies for the SSI.']
  haircut_percentage decimal(5,2) [note: 'Percentage reduction applied to the collateral value for risk mitigation.']
  instruction_type varchar [note: 'Classification of the instruction record (e.g., standard SSI, settlement instruction, payment instruction).']
  last_review_date date [note: 'Date when the SSI was last reviewed for accuracy and compliance.']
  margin_call_frequency varchar [note: 'How often margin calls are generated against this SSI.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the SSI must be reported under EMIR/BCBS regulations.']
  risk_weight decimal(5,2) [note: 'Regulatory risk weight applied to the collateral for capital calculations.']
  settlement_cycle varchar [note: 'Regularity of settlement processing for the instruction.']
  settlement_method varchar [note: 'Mechanism by which the settlement is executed.']
  settlement_platform varchar [note: 'Clearing/settlement platform used for the instruction.']
  ssi_code varchar [note: 'Business identifier assigned to the SSI record by the fund.']
  ssi_registry_description varchar [note: 'Human‑readable description of the SSI purpose and scope.']
  ssi_registry_status varchar [note: 'Current lifecycle status of the SSI record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the SSI record.']
  valuation_method varchar [note: 'Methodology used to value the collateral (e.g., market price, model).']
  version varchar [note: 'Incremental version number for change tracking.']

  Note: 'Master registry of Standard Settlement Instructions (SSIs) for each counterparty and asset type combination used in collateral settlement. Stores counterparty LEI, asset type, currency, custodian BIC, account number, settlement platform (Euroclear'
}

Table collateral.counterparty_rating {
  counterparty_rating_id varchar [pk, note: 'Unique identifier for the rating record.']
  counterparty_id varchar [note: 'Identifier of the counterparty to which this rating applies.']
  comments varchar [note: 'Free‑form notes or comments about the rating.']
  counterparty_rating_status varchar [note: 'Current lifecycle status of the rating record.']
  created_timestamp timestamp [note: 'Timestamp when the rating record was first created in the system.']
  data_quality_score decimal(3,2) [note: 'Score (0‑1) reflecting the quality and completeness of the rating data.']
  is_historical boolean [note: 'Indicates whether the rating is retained for historical reporting only.']
  outlook varchar [note: 'Outlook associated with the rating (positive, negative, stable, unchanged).']
  prior_rating_value decimal(18,2) [note: 'Rating value that preceded the current rating.']
  rating_agency varchar [note: 'Name of the external rating agency (e.g., Moody\'s, S&P, Fitch).']
  rating_change_reason varchar [note: 'Reason or event that triggered the rating change (e.g., financial performance, market conditions).']
  rating_confidence_score decimal(5,2) [note: 'Numeric confidence score (0-100) indicating the certainty of the rating.']
  rating_date date [note: 'Date on which the rating was issued.']
  rating_effective_date date [note: 'Date when the rating becomes effective for the counterparty.']
  rating_expiration_date date [note: 'Date when the rating expires or is scheduled for review.']
  rating_methodology varchar [note: 'Brief description of the methodology used to derive the rating.']
  rating_scale varchar [note: 'Scale used by the rating agency (e.g., S&P, Moody\'s, Fitch).']
  rating_source varchar [note: 'Indicates whether the rating originates from an external agency or internal assessment.']
  rating_type varchar [note: 'Classification of rating as long-term, short-term, or outlook.']
  rating_value decimal(18,2) [note: 'Numeric or alphanumeric rating assigned by the agency. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C|D|NR|WD|SD — promote to reference product]']
  regulatory_reporting_flag boolean [note: 'Indicates if the rating is required for regulatory reporting (yes/no).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the rating record.']
  version varchar [note: 'Incremental version number for the rating record to track revisions.']

  Note: 'Tracks the credit ratings assigned to each counterparty by external rating agencies (Moody\'s, S&P, Fitch) and internal credit assessment. Stores rating agency, rating type (long-term, short-term, outlook), rating value, rating date, prior rating, rating'
}

Table collateral.recall {
  recall_id varchar [pk, note: 'System-generated unique identifier for the collateral recall instruction.']
  collateral_position_id varchar [note: 'Foreign key linking to collateral.collateral_position. Business justification: A recall instruction retrieves previously posted collateral from a specific position. The recall should reference the collateral_position from which assets are being recalled.']
  counterparty_id varchar [note: 'Unique identifier of the counterparty from which collateral is being recalled.']
  asset_identifier varchar [note: 'Standard security identifier of the collateral asset being recalled.']
  asset_type varchar [note: 'Classification of the recalled asset.']
  comments varchar [note: 'Additional free‑form notes related to the recall.']
  created_timestamp timestamp [note: 'Timestamp when the recall record was first created in the system.']
  haircut_percentage decimal(5,2) [note: 'Percentage reduction applied to the gross value of the recalled collateral.']
  is_historical boolean [note: 'True if the record represents a historical (non‑current) recall.']
  net_amount decimal(20,6) [note: 'Value of the recalled collateral after applying the haircut.']
  net_currency varchar [note: 'Currency of the net recall amount.']
  number varchar [note: 'External business identifier assigned to the recall request.']
  quantity decimal(20,6) [note: 'Amount of the asset being recalled, expressed in the unit specified.']
  quantity_unit varchar [note: 'Unit of measure for the recalled quantity.']
  reason varchar [note: 'Business reason prompting the collateral recall.']
  recall_description varchar [note: 'Free‑text description providing additional context for the recall.']
  recall_status varchar [note: 'Current lifecycle state of the recall instruction.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the recall must be reported to regulatory authorities.']
  timestamp timestamp [note: 'Date and time when the recall instruction was issued.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the recall record.']
  valuation_amount decimal(20,6) [note: 'Monetary value of the recalled collateral on the valuation date.']
  valuation_currency varchar [note: 'Three‑letter ISO currency code of the valuation amount.']
  valuation_date date [note: 'Date of the market valuation used for the recalled collateral.']
  version varchar [note: 'Version number for optimistic concurrency control.']

  Note: 'Transactional record of each collateral recall instruction issued to retrieve previously posted collateral from a counterparty. Captures recall date, asset ISIN/CUSIP, quantity recalled, recall reason (trade maturity, rebalancing, substitution'
}

Table collateral.counterparty_stress_result {
  counterparty_stress_result_id varchar [pk, note: 'Unique identifier for this counterparty stress test result record']
  counterparty_id varchar [note: 'Foreign key linking to the counterparty being stress tested']
  stress_scenario_id varchar [note: 'Foreign key linking to the stress scenario being applied']
  effective_date date [note: 'The date on which this stress test result was calculated or became effective']
  exposure_amount decimal(20,2) [note: 'The counterparty exposure amount under this specific stress scenario, reflecting stressed mark-to-market values']
  margin_call_estimate decimal(20,2) [note: 'Estimated margin call amount that would be triggered for this counterparty under this stress scenario']
  pnl_impact decimal(20,2) [note: 'The profit and loss impact for this counterparty under this stress scenario']

  Note: 'This association product represents the stress test result for a specific counterparty under a specific stress scenario. It captures the quantified impact of applying a macroeconomic or market stress scenario to a counterparty\'s exposure, including'
}

Table collateral.collateral_account {
  collateral_account_id varchar [pk, note: 'Primary key for collateral_account']
  ccp_membership_id varchar [note: 'Reference to the central counterparty clearing house if this is a CCP-cleared collateral account.']
  counterparty_id varchar [note: 'Reference to the counterparty entity associated with this collateral account for exposure tracking.']
  csa_id varchar [note: 'Reference to the governing ISDA Credit Support Annex agreement defining collateral terms and eligibility.']
  custodian_id varchar [note: 'Reference to the custodian institution holding the collateral assets in this account.']
  eligibility_schedule_id varchar [note: 'Reference to the schedule defining eligible collateral types and haircuts for this account.']
  account_holder_name varchar [note: 'Legal name of the entity that holds this collateral account as registered with the custodian.']
  account_number varchar [note: 'External business identifier for the collateral account used in margin call processing and counterparty communications.']
  account_type varchar [note: 'Classification of the collateral account indicating its purpose and segregation requirements under regulatory frameworks.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code representing the base currency for collateral valuations and margin calculations.']
  bic_code varchar [note: 'SWIFT BIC code of the custodian bank holding the collateral account for settlement instructions.']
  collateral_account_description varchar [note: 'Free-text description providing additional context about the collateral account purpose and usage.']
  collateral_account_name varchar [note: 'Human-readable name or label assigned to the collateral account for identification purposes.']
  collateral_account_status varchar [note: 'Current lifecycle status of the collateral account indicating operational availability for margin movements.']
  created_timestamp timestamp [note: 'Timestamp when this collateral account record was first created in the system.']
  credit_limit_amount decimal(18,2) [note: 'Maximum unsecured credit exposure permitted for this account before additional collateral is required.']
  dispute_resolution_method varchar [note: 'Method specified for resolving disputes related to margin calls and collateral valuations.']
  effective_date date [note: 'Date from which the collateral account becomes active and available for margin call processing.']
  governing_law_jurisdiction varchar [note: 'Legal jurisdiction governing the collateral account and associated CSA agreement terms.']
  independent_amount decimal(18,2) [note: 'Additional collateral amount required independent of mark-to-market exposure, often based on credit rating.']
  interest_rate_basis varchar [note: 'Reference rate used for calculating interest on cash collateral held in this account.']
  interest_rate_spread_bps decimal(8,4) [note: 'Spread in basis points applied to the reference rate for cash collateral interest calculations.']
  is_bilateral boolean [note: 'Indicates whether this is a bilateral OTC collateral arrangement versus a cleared arrangement.']
  is_ccp_cleared boolean [note: 'Indicates whether this account is used for centrally cleared derivatives requiring CCP margin posting.']
  is_initial_margin_required boolean [note: 'Indicates whether initial margin posting is required under BCBS-IOSCO uncleared margin rules.']
  is_rehypothecation_allowed boolean [note: 'Indicates whether the collateral holder may reuse posted collateral for their own purposes.']
  is_segregated boolean [note: 'Indicates whether collateral assets are held in a segregated account separate from house assets.']
  is_unilateral_posting boolean [note: 'Indicates whether only one party is required to post collateral under the agreement terms.']
  is_variation_margin_required boolean [note: 'Indicates whether variation margin posting is required for this collateral arrangement.']
  last_modified_timestamp timestamp [note: 'Timestamp when this collateral account record was last updated in the system.']
  legal_entity_identifier varchar [note: '20-character ISO 17442 Legal Entity Identifier of the account holder for regulatory reporting.']
  margin_call_frequency varchar [note: 'Frequency at which margin calls are calculated and issued for this collateral account.']
  margin_type varchar [note: 'Type of margin this account is designated to hold, distinguishing initial margin from variation margin.']
  minimum_transfer_amount decimal(18,2) [note: 'Minimum threshold amount below which collateral transfers are not required under the CSA agreement.']
  notification_deadline_time varchar [note: 'Daily cutoff time by which margin call notifications must be issued to be effective for same-day settlement.']
  notification_time_zone varchar [note: 'Time zone used for determining margin call notification deadlines and settlement cutoff times.']
  posting_party_role varchar [note: 'Role of the account holder in the collateral arrangement indicating posting obligations.']
  regulatory_classification varchar [note: 'EMIR counterparty classification affecting margin requirements and clearing obligations.']
  rounding_amount decimal(18,2) [note: 'Amount to which collateral transfers are rounded for operational efficiency in margin call processing.']
  settlement_days varchar [note: 'Number of business days allowed for collateral settlement following a margin call notification.']
  settlement_method varchar [note: 'Method by which collateral is transferred between parties, affecting legal ownership and rehypothecation rights.']
  termination_date date [note: 'Date on which the collateral account is scheduled to terminate or was closed. Null for open-ended accounts.']
  threshold_amount decimal(18,2) [note: 'Unsecured credit exposure threshold above which collateral must be posted under the CSA agreement.']
  valuation_frequency varchar [note: 'Frequency at which collateral assets in this account are marked to market for exposure calculations.']

  Note: 'Master reference table for collateral_account. Referenced by collateral_account_id.'
}

Table performance.portfolio_return {
  portfolio_return_id varchar [pk, note: 'Unique identifier for the portfolio return record.']
  composite_id varchar [note: 'Reference to the GIPS composite to which this portfolio belongs, if applicable.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Pension funds must stress-test portfolio returns against economic scenarios (base, adverse, severely adverse) for regulatory reporting (ORSA, IORP II) and internal risk management.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for performance comparison.']
  performance_calculation_run_id varchar [note: 'Foreign key linking to performance.performance_calculation_run. Business justification: Portfolio returns are generated by performance calculation runs. Adding FK provides audit trail and traceability from calculated returns back to the batch execution']
  portfolio_id varchar [note: 'Reference to the portfolio for which this return is calculated.']
  return_period_id varchar [note: 'Foreign key linking to performance.return_period. Business justification: Portfolio returns are calculated for standard measurement periods (daily, monthly, quarterly, annual). Adding FK to return_period normalizes period definitions.']
  active_share_percent decimal(9,4) [note: 'Add column active_share_percent (share of holdings that differ from the benchmark, 0 to 100) to performance.portfolio_return. active_share_percent (share of holdings that differ from the benchmark, 0 to 100)']
  annualized_return_percent varchar [note: 'On performance.portfolio_return add annualized_return_percent, the annualized return for the period in the same unit as drawdown_percent. annualized_return_percent (annualized return for the period, same unit as drawdown_percent)']
  approval_timestamp timestamp [note: 'The date and time when the return calculation was approved or verified.']
  approved_by varchar [note: 'The user identifier of the person who approved or verified the return calculation.']
  asset_class varchar [note: 'The primary asset class of the portfolio for which this return is calculated.']
  attribution_available boolean [note: 'Indicates whether detailed performance attribution analysis is available for this return period.']
  beginning_market_value decimal(20,2) [note: 'The market value of the portfolio at the start of the measurement period.']
  benchmark_return decimal(18,8) [note: 'The return of the assigned benchmark index for the same measurement period, expressed as a decimal rate.']
  calculated_by varchar [note: 'The system or user identifier that performed the return calculation.']
  calculation_date date [note: 'The date on which the return was calculated.']
  calculation_method varchar [note: 'The methodology used to calculate the return (e.g., Modified Dietz, True TWR, IRR).']
  calculation_timestamp timestamp [note: 'The exact date and time when the return calculation was performed.']
  capital_return decimal(18,8) [note: 'The portion of total return attributable to capital appreciation or depreciation, expressed as a decimal rate.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the return and values are denominated.']
  drawdown_percent varchar [note: 'On performance.portfolio_return add drawdown_percent, the decline from the running NAV peak at period end, stored as a negative number. performance.portfolio_return: add drawdown_percent (decline from the running NAV peak at period end, sto']
  ending_market_value decimal(20,2) [note: 'The market value of the portfolio at the end of the measurement period.']
  excess_return_gross decimal(18,8) [note: 'The difference between gross TWR and benchmark return, expressed in basis points or decimal rate.']
  excess_return_net decimal(18,8) [note: 'The difference between net TWR and benchmark return, expressed in basis points or decimal rate.']
  fx_impact decimal(18,8) [note: 'The impact of foreign exchange rate movements on the portfolio return, expressed as a decimal rate.']
  gips_compliant boolean [note: 'Indicates whether this return calculation is compliant with GIPS standards.']
  income_return decimal(18,8) [note: 'The portion of total return attributable to income (dividends, interest, coupons), expressed as a decimal rate.']
  information_ratio decimal(18,8) [note: 'The information ratio measuring the portfolio\'s excess return relative to the benchmark divided by tracking error.']
  management_fee decimal(20,2) [note: 'The total management fees charged during the measurement period.']
  mwr decimal(18,8) [note: 'Money-weighted return (also known as Internal Rate of Return or IRR) for the period, expressed as a decimal rate.']
  net_cash_flow decimal(20,2) [note: 'The net cash flow (contributions minus distributions) during the measurement period.']
  notes varchar [note: 'Additional notes or comments regarding the return calculation, including any adjustments or special circumstances.']
  number_of_holdings varchar [note: 'The total number of distinct holdings in the portfolio at the end of the measurement period.']
  other_fees decimal(20,2) [note: 'Any other fees or expenses charged during the measurement period not classified as management or performance fees.']
  performance_fee decimal(20,2) [note: 'The total performance or incentive fees charged during the measurement period.']
  period_end_date date [note: 'The end date of the measurement period for this return calculation.']
  period_start_date date [note: 'The start date of the measurement period for this return calculation.']
  record_created_timestamp timestamp [note: 'The timestamp when this record was first created in the data platform.']
  record_updated_timestamp timestamp [note: 'The timestamp when this record was last updated in the data platform.']
  recovery_days varchar [note: 'On performance.portfolio_return add recovery_days, the days from the drawdown trough back to a new high. recovery_days (days from the drawdown trough back to a new high)']
  return_frequency varchar [note: 'The frequency or periodicity of the return calculation.']
  return_status varchar [note: 'The status of the return calculation indicating whether it is preliminary, final, restated, or audited.']
  return_volatility_percent decimal(18,8) [note: 'Add column return_volatility_percent (annualized standard deviation of the portfolios period returns, same unit as twr_net) to performance.portfolio_return. performance.portfolio_return: add return_volatility_percent (annualized standard de']
  risk_free_rate decimal(18,8) [note: 'The risk-free rate used for Sharpe ratio and other risk-adjusted return calculations, expressed as a decimal rate.']
  sharpe_ratio decimal(18,8) [note: 'The Sharpe ratio for the portfolio during the measurement period, calculated as excess return divided by standard deviation.']
  total_contributions decimal(20,2) [note: 'The total amount of capital contributions into the portfolio during the measurement period.']
  total_distributions decimal(20,2) [note: 'The total amount of capital distributions from the portfolio during the measurement period.']
  tracking_error decimal(18,8) [note: 'The standard deviation of the difference between portfolio returns and benchmark returns, expressed as a decimal rate.']
  twr_gross decimal(18,8) [note: 'Time-weighted return calculated gross of fees, expressed as a decimal rate.']
  twr_net decimal(18,8) [note: 'Time-weighted return calculated net of fees, expressed as a decimal rate.']
  valuation_frequency varchar [note: 'The frequency at which portfolio valuations are performed for return calculation purposes.']

  Note: 'Core transactional record of calculated portfolio-level returns for each measurement period. Stores both Time-Weighted Return (TWR) and Money-Weighted Return (MWR/IRR), plus benchmark-relative metrics (gross and net-of-fee excess return, information'
}

Table performance.composite {
  composite_id varchar [pk, note: 'Unique identifier for the GIPS-compliant composite grouping portfolios with similar investment mandates and objectives.']
  esg_benchmark_id varchar [note: 'Foreign key linking to esg.esg_benchmark. Business justification: SFDR Article 8/9 composites must compare against ESG-aligned benchmarks. Pension funds need direct composite-to-ESG-benchmark linkage for regulatory reporting and ESG performance']
  gp_profile_id varchar [note: 'Reference to the internal portfolio manager or investment team responsible for the composite strategy.']
  secondary_benchmark_performance_benchmark_id varchar [note: 'Reference to an optional secondary benchmark for additional performance comparison and multi-benchmark attribution.']
  secondary_performance_benchmark_id varchar [note: 'Reference to an optional secondary benchmark for additional performance comparison and multi-benchmark attribution.']
  aum decimal(20,2) [note: 'Total market value of all portfolios included in the composite as of the most recent valuation date, in base currency.']
  base_currency varchar [note: 'Three-letter ISO 4217 currency code in which composite performance and assets are reported.']
  benchmark_name varchar [note: 'Name of the primary benchmark index against which composite performance is measured and reported.']
  calculation_methodology varchar [note: 'Primary method used to calculate composite returns: Time-Weighted Return (TWR), Money-Weighted Return (MWR), or Internal Rate of Return (IRR).']
  composite_code varchar [note: 'Internal system code uniquely identifying the composite across performance and reporting systems.']
  composite_description varchar [note: 'Detailed description of the composite investment strategy, mandate, and objectives for client and regulatory disclosure.']
  composite_name varchar [note: 'Official name of the composite as disclosed in GIPS-compliant presentations and regulatory filings.']
  composite_status varchar [note: 'Current lifecycle status of the composite indicating whether it is actively accepting portfolios and reporting performance.']
  composite_type varchar [note: 'Primary asset class or strategy classification of the composite for performance segmentation and reporting. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|credit|multi_asset|balanced — 7 candidates stripped; promote to']
  created_timestamp timestamp [note: 'System timestamp when the composite record was first created in the performance system.']
  dispersion_measure varchar [note: 'Statistical method used to measure the variability of individual portfolio returns within the composite.']
  esg_approach varchar [note: 'Specific ESG investment approach or methodology applied to the composite strategy.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are systematically integrated into the investment process for portfolios within the composite.']
  exclusion_criteria varchar [note: 'Documented rules defining which portfolios are excluded from the composite due to significant cash flows, mandate changes, or other disqualifying events.']
  fee_basis varchar [note: 'Indicates whether composite returns are reported gross of fees (before management fees) or net of fees (after management fees).']
  geographic_focus varchar [note: 'Primary geographic investment focus or regional mandate of the composite strategy.']
  gips_compliant_flag boolean [note: 'Indicates whether the composite is constructed and maintained in full compliance with CFA Institute GIPS Standards.']
  gips_verification_date date [note: 'Date of the most recent independent GIPS verification performed by a qualified third-party verifier.']
  inception_date date [note: 'Date when the composite was first created and began tracking performance, establishing the start of the performance track record.']
  inclusion_criteria varchar [note: 'Documented rules defining which portfolios qualify for inclusion in the composite based on mandate, strategy, and investment characteristics.']
  investment_style varchar [note: 'Investment style classification of the composite strategy for performance attribution and peer comparison.']
  management_fee_schedule varchar [note: 'Description of the standard management fee structure applied to portfolios within the composite for net-of-fee performance calculation.']
  minimum_portfolio_size decimal(18,2) [note: 'Minimum asset value threshold in base currency for a portfolio to be eligible for composite inclusion, ensuring representative performance.']
  modified_by varchar [note: 'User identifier of the person who last modified the composite record, supporting audit trail and governance.']
  modified_timestamp timestamp [note: 'System timestamp when the composite record was last modified, tracking changes to construction rules or metadata.']
  notes varchar [note: 'Additional notes, disclosures, or commentary regarding composite construction, methodology changes, or special circumstances.']
  number_of_portfolios varchar [note: 'Count of individual portfolios currently included in the composite as of the most recent reporting period.']
  presentation_currency varchar [note: 'Three-letter ISO 4217 currency code in which composite performance is presented to clients and in marketing materials.']
  reporting_frequency varchar [note: 'Frequency at which composite performance is calculated and reported to stakeholders and regulatory bodies.']
  risk_profile varchar [note: 'Risk classification of the composite based on expected volatility, leverage, and investment characteristics.']
  sector_focus varchar [note: 'Primary sector or industry focus of the composite, if applicable to the investment strategy.']
  sfdr_classification varchar [note: 'EU SFDR article classification indicating the level of sustainability integration in the composite strategy.']
  strategy varchar [note: 'Detailed description of the investment strategy, philosophy, and approach employed by portfolios within the composite.']
  termination_date date [note: 'Date when the composite was closed or terminated, ending the performance track record. Null for active composites.']
  valuation_frequency varchar [note: 'Frequency at which portfolios within the composite are valued for performance calculation and reporting purposes.']
  created_by varchar [note: 'User identifier of the person who created the composite record in the performance system.']

  Note: 'Master record for each GIPS-compliant composite grouping portfolios with similar investment mandates and objectives. Defines composite construction rules, inclusion/exclusion criteria, composite inception date, benchmark assignment, and composite-level'
}

Table performance.performance_composite_membership {
  performance_composite_membership_id varchar [pk, note: 'Unique identifier for the composite membership record tracking portfolio inclusion in a GIPS composite for a specific measurement period.']
  composite_id varchar [note: 'Reference to the GIPS composite to which the portfolio belongs during this membership period.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for performance comparison during this membership period.']
  portfolio_id varchar [note: 'Reference to the portfolio that is a member of the composite during this period.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the portfolios base currency for performance measurement.']
  carve_out_cash_allocation_method varchar [note: 'The method used to allocate cash to the carved-out portfolio segment, required for GIPS compliance when carve-outs are included in composites.']
  carve_out_flag boolean [note: 'Indicates whether this portfolio represents a carved-out segment of a larger portfolio for composite inclusion purposes.']
  composite_definition_version varchar [note: 'Version identifier of the composite definition document in effect during this membership period, supporting audit trail and compliance.']
  discretionary_flag boolean [note: 'Indicates whether the portfolio was managed on a discretionary basis during this membership period. Only discretionary portfolios are eligible for GIPS composite inclusion.']
  exclusion_approval_date date [note: 'The date on which the portfolios exclusion from the composite was formally approved by the investment committee or compliance team.']
  exclusion_approved_by varchar [note: 'Name or identifier of the individual or committee that approved the portfolios exclusion from the composite.']
  exclusion_reason_code varchar [note: 'Standardized code indicating the reason for portfolio exclusion from the composite.']
  exclusion_reason_description varchar [note: 'Detailed narrative explanation of why the portfolio was excluded from the composite, supporting audit and compliance review.']
  fee_paying_flag boolean [note: 'Indicates whether the portfolio pays management fees during this membership period, relevant for gross versus net return calculations.']
  inclusion_approval_date date [note: 'The date on which the portfolios inclusion in the composite was formally approved by the investment committee or compliance team.']
  inclusion_approved_by varchar [note: 'Name or identifier of the individual or committee that approved the portfolios inclusion in the composite.']
  inclusion_end_date date [note: 'The date on which the portfolio was removed from the composite. Null if the portfolio remains an active member.']
  inclusion_start_date date [note: 'The date on which the portfolio was first included in the composite for performance measurement purposes.']
  mandate_type varchar [note: 'The investment mandate or strategy type assigned to the portfolio during this membership period, used to ensure composite homogeneity.']
  membership_status varchar [note: 'Current status of the portfolios membership in the composite.']
  minimum_portfolio_size_threshold decimal(20,2) [note: 'The minimum NAV threshold required for a portfolio to be eligible for inclusion in the composite.']
  notes varchar [note: 'Free-text field for additional notes or comments regarding the portfolios membership in the composite, supporting audit and compliance documentation.']
  performance_calculation_method varchar [note: 'The methodology used to calculate portfolio returns during this membership period, ensuring consistency with composite calculation standards.']
  portfolio_inception_date date [note: 'The date the portfolio was first funded and began active management, used to determine eligibility for composite inclusion.']
  portfolio_nav_at_exclusion decimal(20,2) [note: 'The portfolios net asset value at the time of exclusion from the composite, used for final weighting calculations.']
  portfolio_nav_at_inclusion decimal(20,2) [note: 'The portfolios net asset value at the time of inclusion in the composite, used for weighting and size-based eligibility checks.']
  portfolio_termination_date date [note: 'The date the portfolio was closed or terminated, marking the end of its lifecycle and composite membership.']
  record_created_timestamp timestamp [note: 'The timestamp when this composite membership record was first created in the lakehouse, supporting audit trail and data lineage.']
  record_current_flag boolean [note: 'Indicates whether this is the current active version of the composite membership record, supporting Type 2 slowly changing dimension logic.']
  record_effective_from_timestamp timestamp [note: 'The timestamp from which this version of the composite membership record is effective, supporting temporal queries and historical analysis.']
  record_effective_to_timestamp timestamp [note: 'The timestamp until which this version of the composite membership record is effective. Null indicates the current active version.']
  record_updated_timestamp timestamp [note: 'The timestamp when this composite membership record was last updated in the lakehouse, supporting change tracking and audit compliance.']
  significant_cash_flow_threshold_pct decimal(5,2) [note: 'The percentage threshold used to determine significant cash flows that trigger temporary exclusion from the composite.']
  source_system_record_code varchar [note: 'The unique identifier of this composite membership record in the source system, enabling traceability and reconciliation.']
  valuation_frequency varchar [note: 'The frequency at which the portfolio is valued for performance measurement purposes during this membership period.']

  Note: 'Transactional association record tracking which portfolios are included in each GIPS composite for each measurement period. Captures inclusion start date, exclusion date, reason for exclusion (e.g., significant cash flow, mandate change), and the'
}

Table performance.performance_benchmark {
  performance_benchmark_id varchar [pk, note: 'Unique identifier for the performance benchmark record.']
  esg_benchmark_id varchar [note: 'Foreign key linking to esg.esg_benchmark. Business justification: Pension funds measuring ESG-adjusted performance need to link traditional benchmarks to ESG equivalents.']
  approval_date date [note: 'Date when the benchmark was approved by the Investment Committee (IC) for use in performance measurement and reporting.']
  asset_class varchar [note: 'Primary asset class category that the benchmark represents for portfolio comparison. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset — 7 candidates stripped; promote to reference product]']
  base_date date [note: 'Reference date for the benchmark index base value, typically when the index was set to 100 or 1000.']
  base_value decimal(18,4) [note: 'Initial index value at the base date, used as the starting point for performance calculations.']
  benchmark_code varchar [note: 'Unique business identifier code for the benchmark used across systems and reporting.']
  benchmark_name varchar [note: 'Full descriptive name of the performance benchmark.']
  benchmark_status varchar [note: 'Current lifecycle status of the benchmark in the performance measurement system.']
  benchmark_type varchar [note: 'Classification of the benchmark methodology used for performance comparison.']
  blend_composition varchar [note: 'Detailed description of the component benchmarks and their weights if this is a custom blended benchmark.']
  bloomberg_ticker varchar [note: 'Bloomberg-specific unique identifier for the benchmark used in Bloomberg Terminal and AIM.']
  constituent_count varchar [note: 'Number of securities or components included in the benchmark index.']
  created_timestamp timestamp [note: 'Timestamp when the benchmark record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which the benchmark returns are denominated.']
  custom_blend_flag boolean [note: 'Indicates whether the benchmark is a custom blended benchmark created internally rather than a standard market index.']
  data_feed_frequency varchar [note: 'Frequency at which benchmark data is updated from the source system.']
  data_source varchar [note: 'System or vendor from which benchmark return and constituent data is sourced, such as SimCorp Dimension, Bloomberg, FactSet, or MSCI.']
  discontinuation_date date [note: 'Date when the benchmark was discontinued or retired from active use.']
  esg_integration_flag boolean [note: 'Indicates whether the benchmark incorporates ESG criteria or screens in its construction.']
  esg_methodology varchar [note: 'Description of the ESG screening, scoring, or integration approach applied to the benchmark if applicable.']
  geographic_focus varchar [note: 'Geographic region or market that the benchmark covers, such as Global, North America, Europe, Asia-Pacific, or Emerging Markets.']
  gips_compliant_flag boolean [note: 'Indicates whether the benchmark meets GIPS compliance standards for performance reporting.']
  inception_date date [note: 'Date when the benchmark was first established or when historical data begins.']
  index_provider varchar [note: 'Name of the organization providing the benchmark index data, such as MSCI, Bloomberg, FTSE, or S&P.']
  index_ticker varchar [note: 'Standard ticker or symbol used to identify the benchmark in market data systems.']
  isin varchar [note: 'ISO 6166 standard 12-character alphanumeric code uniquely identifying the benchmark security or index.']
  last_modified_timestamp timestamp [note: 'Timestamp when the benchmark record was last updated or modified.']
  last_review_date date [note: 'Date when the benchmark was last reviewed for appropriateness and alignment with investment strategy.']
  liability_matching_flag boolean [note: 'Indicates whether the benchmark is designed for Liability-Driven Investment (LDI) or Asset-Liability Management (ALM) purposes.']
  methodology_document_reference varchar [note: 'Reference to the official methodology document or URL that describes the benchmark construction and maintenance rules.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the benchmark.']
  performance_benchmark_description varchar [note: 'Detailed narrative description of the benchmark, its construction methodology, and its intended use in performance measurement.']
  performance_fee_benchmark_flag boolean [note: 'Indicates whether the benchmark is used as the hurdle rate or reference for calculating performance-based fees or carried interest.']
  rebalancing_frequency varchar [note: 'Frequency at which the benchmark composition or weights are rebalanced. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|event_driven — 7 candidates stripped; promote to reference product]']
  regulatory_reporting_flag boolean [note: 'Indicates whether the benchmark is used for regulatory or beneficiary reporting purposes.']
  return_calculation_method varchar [note: 'Methodology used to calculate benchmark returns, indicating whether dividends, fees, or taxes are included.']
  sedol varchar [note: 'Seven-character alphanumeric code identifying the benchmark in UK and Irish markets.']
  usage_scope varchar [note: 'Description of portfolios, composites, or mandates for which this benchmark is used as the performance comparison standard.']
  weighting_methodology varchar [note: 'Method used to weight constituents within the benchmark, such as market-cap weighted, equal weighted, GDP weighted, or custom strategic allocation.']

  Note: 'Master record for each performance benchmark used across portfolios, composites, and mandates. Stores benchmark name, benchmark type (absolute return, market index, custom blended, liability-relative), index provider (e.g., MSCI, Bloomberg, FTSE)'
}

Table performance.benchmark_return {
  benchmark_return_id varchar [pk, note: 'Unique identifier for the benchmark return record. Primary key for this transactional performance measurement entity.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index or composite for which this return is calculated.']
  return_period_id varchar [note: 'Foreign key linking to performance.return_period. Business justification: Benchmark returns are calculated for standard measurement periods. Adding FK to return_period normalizes period definitions and connects the currently siloed return_period table.']
  annualized_return decimal(18,8) [note: 'The benchmark return annualized for periods longer or shorter than one year, expressed as a decimal.']
  approval_timestamp timestamp [note: 'The date and time when the benchmark return was approved and finalized for reporting purposes.']
  approved_by varchar [note: 'The name or identifier of the individual or system that approved the benchmark return calculation.']
  base_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the benchmark return is expressed (e.g., USD, GBP).']
  beginning_market_value decimal(20,2) [note: 'The market value of the benchmark at the start of the measurement period, in base currency.']
  benchmark_version varchar [note: 'The version or vintage of the benchmark index used for this return calculation, capturing any index reconstitutions or methodology changes.']
  calculation_method varchar [note: 'Detailed description of the calculation methodology applied, including any adjustments or assumptions.']
  calculation_timestamp timestamp [note: 'The date and time when this benchmark return was calculated and recorded in the Performance Book of Record (PBOR).']
  capital_gain_amount decimal(20,2) [note: 'The absolute capital appreciation or depreciation of the benchmark during the period, in base currency.']
  comments varchar [note: 'Additional notes or commentary regarding the benchmark return calculation, including any anomalies or special circumstances.']
  created_timestamp timestamp [note: 'The date and time when this benchmark return record was first created in the system.']
  cumulative_return decimal(18,8) [note: 'The cumulative return of the benchmark from inception or a specified start date to the period end, expressed as a decimal.']
  currency_adjusted_return decimal(18,8) [note: 'The benchmark return adjusted for foreign exchange (FX) movements to reflect returns in the fund\'s base currency.']
  data_source varchar [note: 'The system or vendor that provided the benchmark return data (e.g., SimCorp Dimension, FactSet, Bloomberg, MSCI).']
  ending_market_value decimal(20,2) [note: 'The market value of the benchmark at the end of the measurement period, in base currency.']
  fx_impact decimal(18,8) [note: 'The impact of foreign exchange rate movements on the benchmark return, expressed as a decimal contribution to total return.']
  gips_compliant_flag boolean [note: 'Indicates whether this benchmark return calculation adheres to GIPS standards for performance reporting.']
  gross_return decimal(18,8) [note: 'The benchmark return before deduction of any fees or expenses, expressed as a decimal.']
  income_amount decimal(20,2) [note: 'The absolute income generated by the benchmark during the period, in base currency.']
  income_return decimal(18,8) [note: 'The income component of the benchmark return, including dividends, interest, and other distributions, expressed as a decimal.']
  last_modified_timestamp timestamp [note: 'The date and time when this benchmark return record was last updated or modified.']
  max_drawdown decimal(18,8) [note: 'The largest peak-to-trough decline in the benchmark value during the measurement period, expressed as a negative decimal.']
  net_return decimal(18,8) [note: 'The benchmark return after deduction of applicable fees and expenses, expressed as a decimal.']
  price_return decimal(18,8) [note: 'The price-only return component of the benchmark, excluding income distributions, expressed as a decimal.']
  restatement_flag boolean [note: 'Indicates whether this return record is a restatement or correction of a previously reported value.']
  restatement_reason varchar [note: 'Explanation for why the benchmark return was restated, if applicable.']
  return_frequency varchar [note: 'The periodicity of the return measurement (daily, weekly, monthly, quarterly, annual, or inception-to-date).']
  return_period_end_date date [note: 'The end date of the measurement period for this benchmark return calculation.']
  return_period_start_date date [note: 'The start date of the measurement period for this benchmark return calculation.']
  return_status varchar [note: 'The lifecycle status of the return record: preliminary (subject to change), final (locked), restated (corrected), or archived (historical).']
  return_type varchar [note: 'The calculation methodology used: Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), or simple return.']
  sharpe_ratio decimal(18,8) [note: 'The risk-adjusted return metric calculated as excess return over the risk-free rate divided by volatility.']
  total_return decimal(18,8) [note: 'The total return of the benchmark for the period, expressed as a decimal (e.g., 0.0523 for 5.23%). Includes price appreciation and income.']
  volatility decimal(18,8) [note: 'The standard deviation of benchmark returns over the measurement period, representing risk, expressed as a decimal.']

  Note: 'Transactional record of benchmark-level returns for each measurement period, aligned to the same periodicity as portfolio returns. Captures benchmark total return, price return, income return, and currency-adjusted return.'
}

Table performance.attribution_result {
  attribution_result_id varchar [pk, note: 'Unique identifier for the performance attribution result record.']
  attribution_model_id varchar [note: 'Foreign key linking to performance.attribution_model. Business justification: Each attribution result is generated by a specific attribution model; linking ensures referential integrity and eliminates redundant string column.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for relative performance comparison.']
  performance_calculation_run_id varchar [note: 'Reference to the batch execution run that produced this attribution result.']
  portfolio_id varchar [note: 'Reference to the portfolio for which attribution was calculated.']
  active_return_pct decimal(18,8) [note: 'Difference between portfolio return and benchmark return, representing total outperformance or underperformance.']
  allocation_effect_pct decimal(18,8) [note: 'Attribution effect from portfolio weight decisions relative to benchmark weights, measured in percentage points.']
  approval_timestamp timestamp [note: 'Date and time when this attribution result was formally approved for distribution.']
  approved_by varchar [note: 'Name or identifier of the individual who approved this attribution result for reporting.']
  attribution_level varchar [note: 'The hierarchical level at which attribution effects are measured.']
  average_market_value decimal(20,2) [note: 'Time-weighted average market value of the portfolio segment during the measurement period, in base currency.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which attribution results are reported.']
  beginning_market_value decimal(20,2) [note: 'Market value of the portfolio segment at the start of the measurement period, in base currency.']
  benchmark_return_pct decimal(18,8) [note: 'Total return of the benchmark for the measurement period, expressed as a percentage.']
  benchmark_segment_return_pct decimal(18,8) [note: 'Return of this specific segment within the benchmark for the measurement period.']
  benchmark_weight_pct decimal(18,8) [note: 'Average weight of this segment in the benchmark during the measurement period, expressed as a percentage.']
  calculation_source_system varchar [note: 'Name of the system or module that performed the attribution calculation.']
  calculation_status varchar [note: 'Current processing status of the attribution calculation for this result.']
  calculation_timestamp timestamp [note: 'Date and time when the attribution calculation was executed.']
  calculation_version varchar [note: 'Version identifier of the attribution calculation engine or methodology used.']
  currency_effect_pct decimal(18,8) [note: 'Attribution effect from foreign exchange movements on non-base currency holdings, measured in percentage points.']
  data_classification varchar [note: 'Classification level indicating the sensitivity and access restrictions for this attribution result.']
  ending_market_value decimal(20,2) [note: 'Market value of the portfolio segment at the end of the measurement period, in base currency.']
  gips_compliant_flag boolean [note: 'Indicates whether this attribution result meets GIPS compliance standards for performance reporting.']
  interaction_effect_pct decimal(18,8) [note: 'Attribution effect from the interaction between allocation and selection decisions, measured in percentage points.']
  is_active boolean [note: 'Indicates whether this attribution result record is currently active and valid for reporting purposes.']
  notes varchar [note: 'Free-text notes or commentary regarding this attribution result, including analyst observations or data quality remarks.']
  period_end_date date [note: 'End date of the measurement period for this attribution analysis.']
  period_start_date date [note: 'Start date of the measurement period for this attribution analysis.']
  portfolio_return_pct decimal(18,8) [note: 'Total return of the portfolio for the measurement period, expressed as a percentage.']
  portfolio_segment_return_pct decimal(18,8) [note: 'Return of this specific segment within the portfolio for the measurement period.']
  portfolio_weight_pct decimal(18,8) [note: 'Average weight of this segment in the portfolio during the measurement period, expressed as a percentage.']
  published_flag boolean [note: 'Indicates whether this attribution result has been published to external stakeholders or beneficiaries.']
  published_timestamp timestamp [note: 'Date and time when this attribution result was published to stakeholders.']
  reconciliation_difference decimal(18,8) [note: 'Residual difference between sum of attribution effects and total active return, used for quality control.']
  record_created_timestamp timestamp [note: 'Date and time when this attribution result record was first created in the system.']
  record_updated_by varchar [note: 'Identifier of the user or system process that last updated this attribution result record.']
  record_updated_timestamp timestamp [note: 'Date and time when this attribution result record was last modified.']
  segment_code varchar [note: 'Standardized code identifying the segment or classification dimension.']
  segment_name varchar [note: 'Name of the portfolio segment or classification dimension for this attribution result.']
  segment_return_difference_pct decimal(18,8) [note: 'Difference between portfolio segment return and benchmark segment return, expressed as percentage points.']
  selection_effect_pct decimal(18,8) [note: 'Attribution effect from security selection decisions within each segment, measured in percentage points.']
  validation_message varchar [note: 'Detailed message describing validation findings, warnings, or errors for this attribution result.']
  validation_status varchar [note: 'Status of quality validation checks applied to this attribution result.']
  weight_difference_pct decimal(18,8) [note: 'Difference between portfolio weight and benchmark weight for this segment, expressed as percentage points.']

  Note: 'Core transactional record storing the results of a performance attribution run for one portfolio and measurement period. Captures total active return decomposed into allocation, selection, interaction, and currency effects using Brinson-Hood-Beebower'
}

Table performance.attribution_segment {
  attribution_segment_id varchar [pk, note: 'Unique identifier for the attribution segment record within a performance attribution run.']
  parent_segment_attribution_segment_id varchar [note: 'Reference to the parent segment in hierarchical attribution analysis, null for top-level segments.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for comparison in this attribution segment.']
  performance_calculation_run_id varchar [note: 'Reference to the parent attribution analysis run that generated this segment.']
  portfolio_id varchar [note: 'Reference to the portfolio being analyzed in this attribution segment.']
  active_return decimal(18,8) [note: 'The difference between portfolio return and benchmark return for this segment, expressed as a decimal fraction (portfolio return minus benchmark return).']
  active_weight decimal(18,8) [note: 'The difference between portfolio weight and benchmark weight for this segment, expressed as a decimal fraction (portfolio weight minus benchmark weight).']
  allocation_effect decimal(18,8) [note: 'The attribution effect resulting from differences in portfolio weight versus benchmark weight for this segment, expressed in basis points contribution to total portfolio return.']
  attribution_method varchar [note: 'The mathematical methodology used to calculate attribution effects for this segment (e.g., Brinson, Brinson-Fachler, Brinson-Hood-Beebower, Carino smoothing, or geometric linking).']
  base_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which attribution effects are expressed (e.g., USD, EUR, GBP).']
  benchmark_return decimal(18,8) [note: 'The total return of the benchmark segment over the attribution period, expressed as a decimal fraction (e.g., 0.0412 for 4.12% return).']
  benchmark_weight_average decimal(18,8) [note: 'The average weight of this segment in the benchmark over the attribution period, typically calculated using daily or monthly averaging.']
  benchmark_weight_begin decimal(18,8) [note: 'The weight of this segment in the benchmark at the beginning of the attribution period, expressed as a decimal fraction of total benchmark value.']
  benchmark_weight_end decimal(18,8) [note: 'The weight of this segment in the benchmark at the end of the attribution period, expressed as a decimal fraction of total benchmark value.']
  calculation_run_identifier varchar [note: 'The unique batch or run identifier from the source performance system that generated this attribution segment.']
  calculation_status varchar [note: 'The current status of the attribution calculation for this segment within the performance workflow.']
  calculation_timestamp timestamp [note: 'The date and time when this attribution segment was calculated by the performance system.']
  created_timestamp timestamp [note: 'The date and time when this attribution segment record was first created in the lakehouse.']
  currency_effect decimal(18,8) [note: 'The attribution effect resulting from currency movements and hedging decisions for this segment, expressed in basis points contribution to total portfolio return.']
  data_quality_flag boolean [note: 'Indicator of data quality or completeness issues affecting this attribution segment calculation.']
  information_ratio_contribution decimal(18,8) [note: 'The contribution of this segment to the overall portfolio information ratio, calculated as active return divided by tracking error contribution.']
  interaction_effect decimal(18,8) [note: 'The attribution effect resulting from the interaction between allocation and selection decisions, expressed in basis points contribution to total portfolio return.']
  is_synthetic_segment boolean [note: 'Flag indicating whether this segment is a synthetic or derived segment created for analytical purposes rather than a natural portfolio grouping.']
  local_return decimal(18,8) [note: 'The return of the portfolio segment in local currency terms before currency translation effects, expressed as a decimal fraction.']
  notes varchar [note: 'Free-text notes or commentary regarding this attribution segment, including explanations of unusual effects or data adjustments.']
  period_end_date date [note: 'The ending date of the period covered by this attribution segment analysis.']
  period_start_date date [note: 'The beginning date of the period covered by this attribution segment analysis.']
  period_type varchar [note: 'The frequency or type of the attribution period (daily, weekly, monthly, quarterly, annual, or custom date range).']
  portfolio_return decimal(18,8) [note: 'The total return of the portfolio segment over the attribution period, expressed as a decimal fraction (e.g., 0.0523 for 5.23% return).']
  portfolio_weight_average decimal(18,8) [note: 'The average weight of this segment in the portfolio over the attribution period, typically calculated using daily or monthly averaging.']
  portfolio_weight_begin decimal(18,8) [note: 'The weight of this segment in the portfolio at the beginning of the attribution period, expressed as a decimal fraction of total portfolio value.']
  portfolio_weight_end decimal(18,8) [note: 'The weight of this segment in the portfolio at the end of the attribution period, expressed as a decimal fraction of total portfolio value.']
  security_count_benchmark varchar [note: 'The number of individual securities in the benchmark within this attribution segment.']
  security_count_portfolio varchar [note: 'The number of individual securities held in the portfolio within this attribution segment.']
  segment_dimension_type varchar [note: 'The classification dimension by which this attribution segment is defined (e.g., sector, geography, asset class, factor, currency pair, or individual security).']
  segment_dimension_value decimal(18,2) [note: 'The specific value within the dimension type (e.g., Technology for sector, North America for geography, Equities for asset class).']
  segment_level varchar [note: 'The hierarchical level of this segment within the attribution tree structure, where 1 is top-level and higher numbers represent deeper drill-down levels.']
  segment_market_value_begin decimal(20,2) [note: 'The market value of the portfolio segment at the beginning of the attribution period in base currency.']
  segment_market_value_end decimal(20,2) [note: 'The market value of the portfolio segment at the end of the attribution period in base currency.']
  segment_net_flows decimal(20,2) [note: 'The net cash flows (contributions minus distributions) for this segment during the attribution period in base currency.']
  selection_effect decimal(18,8) [note: 'The attribution effect resulting from differences in security selection or return within this segment versus the benchmark, expressed in basis points contribution to total portfolio return.']
  total_effect decimal(18,8) [note: 'The sum of allocation, selection, and interaction effects for this segment, representing the total contribution to excess return versus benchmark.']
  tracking_error_contribution decimal(18,8) [note: 'The contribution of this segment to the overall portfolio tracking error versus the benchmark, expressed in basis points.']
  updated_timestamp timestamp [note: 'The date and time when this attribution segment record was last modified in the lakehouse.']

  Note: 'Transactional record capturing attribution effects at a single segment of an attribution run. A segment is defined by a dimension (sector, geography, asset class, factor, or currency pair) and carries portfolio weight, benchmark weight, portfolio return'
}

Table performance.holding_return {
  holding_return_id varchar [pk, note: 'Unique identifier for the holding return record. Primary key for position-level return measurement within a portfolio for a specific period.']
  composite_id varchar [note: 'Reference to the GIPS composite to which this holding contributes for composite performance reporting.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Holding return analysis requires linking to instrument master for security-level performance attribution, GIPS composite reporting, and investment committee reviews.']
  listed_security_id varchar [note: 'Reference to the security or investment instrument for which return is calculated.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for relative performance comparison.']
  portfolio_id varchar [note: 'Reference to the portfolio containing this holding position.']
  accrued_income decimal(20,4) [note: 'Income accrued but not yet received at the end of the measurement period.']
  asset_class varchar [note: 'Primary asset class classification of the holding for performance attribution and reporting.']
  attribution_allocation_effect decimal(10,6) [note: 'Performance attribution effect from asset allocation decisions relative to benchmark weights.']
  attribution_interaction_effect decimal(10,6) [note: 'Performance attribution interaction effect between allocation and selection decisions.']
  attribution_selection_effect decimal(10,6) [note: 'Performance attribution effect from security selection decisions within asset classes.']
  average_market_value decimal(20,4) [note: 'Average market value of the holding during the measurement period, used for weighting and attribution.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code for the base currency in which returns are reported.']
  beginning_market_value decimal(20,4) [note: 'Market value of the holding at the start of the measurement period, used as the base for return calculation.']
  beginning_price decimal(18,6) [note: 'Unit price or market price of the security at the start of the measurement period.']
  beginning_quantity decimal(18,4) [note: 'Quantity of units or shares held at the start of the measurement period.']
  benchmark_return decimal(10,6) [note: 'Return of the benchmark index for the same measurement period, used for relative performance analysis.']
  calculation_timestamp timestamp [note: 'Date and time when the holding return was calculated and recorded in the PBOR system.']
  contribution_to_portfolio_return decimal(10,6) [note: 'The holdings contribution to the overall portfolio return, calculated as weight times return.']
  data_quality_flag boolean [note: 'Indicator of the data quality status for this holding return record.']
  ending_market_value decimal(20,4) [note: 'Market value of the holding at the end of the measurement period, reflecting price changes and position adjustments.']
  ending_price decimal(18,6) [note: 'Unit price or market price of the security at the end of the measurement period.']
  ending_quantity decimal(18,4) [note: 'Quantity of units or shares held at the end of the measurement period.']
  excess_return decimal(10,6) [note: 'Holding return minus benchmark return, representing outperformance or underperformance.']
  fx_gain_loss decimal(20,4) [note: 'Gain or loss attributable to foreign exchange rate movements during the period.']
  geographic_region varchar [note: 'Geographic region or country of the holding for geographic attribution analysis.']
  gips_compliant_flag boolean [note: 'Indicates whether this holding return calculation adheres to GIPS compliance standards.']
  income_received decimal(20,4) [note: 'Total income received during the period including dividends, interest, coupon payments, and distributions.']
  local_currency_code varchar [note: 'ISO 4217 three-letter currency code for the local currency of the security.']
  measurement_period_end_date date [note: 'Ending date of the return measurement period for this holding position.']
  measurement_period_start_date date [note: 'Beginning date of the return measurement period for this holding position.']
  mwr decimal(10,6) [note: 'Money-weighted return for the holding, reflecting the impact of cash flow timing on investment performance.']
  net_cash_flow decimal(20,4) [note: 'Net cash flow into or out of the holding during the period, including purchases, sales, and capital calls.']
  notes varchar [note: 'Free-text notes or comments regarding this holding return calculation, exceptions, or adjustments.']
  realized_gain_loss decimal(20,4) [note: 'Realized capital gain or loss from sales or disposals of the holding during the measurement period.']
  record_created_timestamp timestamp [note: 'Timestamp when this holding return record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this holding return record was last modified or recalculated.']
  return_calculation_method varchar [note: 'Methodology used to calculate the holding return for this measurement period.']
  sector varchar [note: 'Industry sector or sub-asset class classification for attribution analysis.']
  total_return_amount decimal(20,4) [note: 'Absolute total return in currency units, combining income, realized and unrealized gains/losses.']
  total_return_percent decimal(10,6) [note: 'Total return expressed as a percentage of beginning market value.']
  twr decimal(10,6) [note: 'Time-weighted return for the holding, eliminating the impact of cash flows to measure investment performance.']
  unrealized_gain_loss decimal(20,4) [note: 'Unrealized capital gain or loss from mark-to-market valuation changes during the period.']
  valuation_source varchar [note: 'Source system or vendor providing the market valuation data for this holding.']

  Note: 'Transactional record of security-level or position-level return contributions within a portfolio for a given measurement period. Captures beginning market value, ending market value, income received, realized gain/loss, unrealized gain/loss, total return'
}

Table performance.private_asset_irr {
  private_asset_irr_id varchar [pk, note: 'Unique identifier for the private asset IRR calculation record.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Private asset IRR calculations must be stress-tested under different economic scenarios for illiquid asset valuation.']
  investment_id varchar [note: 'Reference to the underlying private market investment (private equity, real estate, infrastructure, natural resources, or credit).']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Pension funds must trace private asset IRR performance back to originating deal opportunities for vintage analysis, deal team performance evaluation, investment thesis validation, and']
  portfolio_id varchar [note: 'Reference to the portfolio or fund to which this investment belongs.']
  private_asset_valuation_id varchar [note: 'Foreign key linking to valuation.private_asset_valuation. Business justification: IRR calculations for PE/infrastructure use fair values from private asset valuations as residual value inputs.']
  asset_class varchar [note: 'The private market asset class to which this investment belongs.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code for all monetary amounts in this record.']
  benchmark_irr decimal(18,6) [note: 'The IRR of the relevant benchmark or peer group for the same period, expressed as a decimal.']
  calculation_date date [note: 'The as-of date for which the IRR and related metrics were calculated.']
  calculation_method varchar [note: 'The methodology used to calculate the IRR (e.g., Daily cash flow, Modified Dietz approximation).']
  calculation_source_system varchar [note: 'The system or module that performed the IRR calculation (e.g., SimCorp Dimension, eFront, FactSet).']
  calculation_timestamp timestamp [note: 'Precise timestamp when the IRR calculation was executed.']
  created_timestamp timestamp [note: 'Timestamp when this IRR record was first created in the system.']
  cumulative_distributions decimal(20,2) [note: 'Total distributions received from the investment to date, in base currency.']
  dpi decimal(18,6) [note: 'Cumulative distributions received divided by paid-in capital, expressed as a multiple.']
  excess_irr decimal(18,6) [note: 'The difference between the investment IRR and the benchmark IRR, expressed as a decimal.']
  geographic_region varchar [note: 'Primary geographic region of the investment (e.g., North America, Europe, Asia-Pacific).']
  gips_compliant_flag boolean [note: 'Indicates whether this IRR calculation adheres to GIPS standards for performance reporting.']
  inception_date date [note: 'The date of the initial capital call or investment funding.']
  investment_strategy varchar [note: 'The specific investment strategy or sub-asset class (e.g., Buyout, Venture Capital, Core Real Estate, Value-Add Infrastructure).']
  irr_1_year decimal(18,6) [note: 'Annualized internal rate of return for the trailing 1-year period, expressed as a decimal.']
  irr_3_year decimal(18,6) [note: 'Annualized internal rate of return for the trailing 3-year period, expressed as a decimal.']
  irr_5_year decimal(18,6) [note: 'Annualized internal rate of return for the trailing 5-year period, expressed as a decimal.']
  irr_since_inception decimal(18,6) [note: 'Annualized internal rate of return from the initial investment date to the calculation date, expressed as a decimal (e.g., 0.1250 for 12.50%).']
  j_curve_status varchar [note: 'The lifecycle stage of the investment relative to the typical J-curve pattern of private equity returns.']
  moic decimal(18,6) [note: 'Total value (distributions plus residual value) divided by paid-in capital, expressed as a multiple (e.g., 2.5x).']
  net_cash_flow decimal(20,2) [note: 'Net cash flow (distributions minus paid-in capital) to date, in base currency.']
  notes varchar [note: 'Additional commentary or context regarding this IRR calculation, including any adjustments or special considerations.']
  paid_in_capital decimal(20,2) [note: 'Total capital called and funded by the investor to date, in base currency.']
  performance_status varchar [note: 'The status of this IRR calculation indicating whether it is final, preliminary, or subject to revision.']
  reporting_period varchar [note: 'The reporting period label for this calculation (e.g., Q1 2024, FY 2023).']
  residual_value decimal(20,2) [note: 'Current unrealized (mark-to-market) value of the investment, in base currency.']
  rvpi decimal(18,6) [note: 'Residual (unrealized) value divided by paid-in capital, expressed as a multiple.']
  total_value decimal(20,2) [note: 'Sum of cumulative distributions and residual value, in base currency.']
  tvpi decimal(18,6) [note: 'Total value (distributions plus residual value) divided by paid-in capital, expressed as a multiple. Equivalent to MOIC.']
  updated_timestamp timestamp [note: 'Timestamp when this IRR record was last modified.']
  valuation_date date [note: 'The date of the most recent valuation used to determine residual value for this IRR calculation.']
  valuation_method varchar [note: 'The methodology used to value the residual investment (e.g., DCF, Market Comparables, Transaction Price).']
  vintage_year varchar [note: 'The year in which the initial capital commitment or investment was made.']

  Note: 'Transactional record of IRR (Internal Rate of Return), MOIC (Multiple on Invested Capital), TVPI, DPI, and RVPI calculations for private market investments including private equity, real estate, infrastructure, natural resources, and credit.'
}

Table performance.cash_flow_record {
  cash_flow_record_id varchar [pk, note: 'Unique identifier for the cash flow record. Primary key.']
  cash_capital_call_notice_id varchar [note: 'Identifier of the capital call notice from the General Partner, applicable for private market drawdowns.']
  cash_distribution_notice_id varchar [note: 'Identifier of the distribution notice from the General Partner, applicable for private market distributions.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Pension funds must track which counterparty (GP, administrator, custodian) is involved in each capital call/distribution for cash reconciliation, regulatory reporting (EMIR), and']
  fund_id varchar [note: 'Identifier of the beneficiary fund pool (one per participating plan) associated with this cash flow.']
  investment_id varchar [note: 'Identifier of the specific investment generating this cash flow, applicable for private markets and direct investments.']
  original_cash_flow_record_id varchar [note: 'Reference to the original cash flow record if this is a reversal or correction entry.']
  portfolio_id varchar [note: 'Identifier of the portfolio to which this cash flow belongs.']
  tax_lot_id varchar [note: 'Identifier of the tax lot associated with this cash flow for cost basis tracking and tax reporting.']
  accounting_date date [note: 'The date on which the cash flow is recognized in the accounting books, which may differ from cash flow date for accrual accounting.']
  amount decimal(20,4) [note: 'The monetary value of the cash flow in the base currency. Positive for inflows (contributions, income), negative for outflows (calls, fees).']
  asset_class varchar [note: 'The asset class category to which this cash flow is attributed for performance and allocation analysis. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|cash — 7 candidates stripped; promote to']
  base_currency_amount decimal(20,4) [note: 'The cash flow amount converted to the fund or portfolio base currency for performance calculation purposes.']
  booking_status varchar [note: 'Current status of the cash flow in the accounting system: pending settlement, booked, cancelled, or reversed.']
  cash_flow_date date [note: 'The actual date on which the cash flow occurred or was settled.']
  cash_flow_direction varchar [note: 'Indicates whether the cash flow is an inflow (receipt) or outflow (payment) from the portfolio perspective.']
  cash_flow_type varchar [note: 'Classification of the cash flow transaction: capital call (drawdown), distribution, income receipt, dividend, interest, management fee payment, net contribution, or withdrawal.']
  created_timestamp timestamp [note: 'Timestamp when this cash flow record was first created in the data warehouse.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the cash flow amount.']
  data_quality_flag boolean [note: 'Indicates the data quality status of the cash flow record: verified, pending review, exception requiring investigation, or reconciled with external sources.']
  fee_type varchar [note: 'Classification of fee paid: management fee, performance fee (carried interest), transaction fee, custody fee, advisory fee, or other.']
  fx_rate decimal(18,8) [note: 'The exchange rate applied to convert the transaction currency to base currency.']
  income_type varchar [note: 'Classification of income received: dividend, interest, rental income, royalty, or other income type.']
  is_active boolean [note: 'Indicates whether this cash flow record is currently active and should be included in performance calculations.']
  is_large_cash_flow boolean [note: 'Indicates whether the cash flow exceeds the threshold for large cash flow treatment under GIPS standards, requiring special performance calculation handling.']
  is_realized_gain boolean [note: 'Indicates whether the distribution includes realized capital gains from asset sales.']
  is_recallable boolean [note: 'Indicates whether a distribution is subject to potential recall by the General Partner under the Limited Partnership Agreement.']
  is_return_of_capital boolean [note: 'Indicates whether the distribution represents a return of invested capital rather than income or gain.']
  large_cash_flow_threshold_pct decimal(5,2) [note: 'The percentage threshold of portfolio Net Asset Value (NAV) used to determine large cash flow classification.']
  modified_by varchar [note: 'User or system identifier that last modified this cash flow record.']
  modified_timestamp timestamp [note: 'Timestamp when this cash flow record was last modified in the data warehouse.']
  net_amount decimal(20,4) [note: 'The net cash flow amount after deducting withholding taxes and fees.']
  notes varchar [note: 'Free-text notes or comments providing additional context about the cash flow transaction.']
  performance_attribution_date date [note: 'The date used for performance attribution and Money-Weighted Return (MWR) / Internal Rate of Return (IRR) calculations.']
  reversal_reason varchar [note: 'Explanation for why the cash flow was reversed or cancelled, if applicable.']
  settlement_date date [note: 'The date on which the cash flow was settled and funds were transferred.']
  source_system_timestamp timestamp [note: 'The timestamp when the cash flow record was created or last updated in the source system.']
  sub_asset_class varchar [note: 'Granular sub-classification within the asset class (e.g., growth equity, value equity, core real estate, opportunistic infrastructure).']
  trade_date date [note: 'The date on which the transaction was executed, distinct from settlement date for T+2 or other settlement cycles.']
  transaction_reference varchar [note: 'External reference or transaction identifier from the source system (e.g., SimCorp transaction ID, custodian reference).']
  withholding_tax_amount decimal(18,4) [note: 'Amount of withholding tax deducted from the gross cash flow, applicable for cross-border income.']
  withholding_tax_rate decimal(5,4) [note: 'The withholding tax rate applied to the gross income, expressed as a decimal (e.g., 0.15 for 15%).']
  created_by varchar [note: 'User or system identifier that created this cash flow record.']

  Note: 'Transactional record of all cash flows used in MWR and IRR calculations, including capital calls (drawdowns), distributions, income receipts, management fee payments, and net contributions from beneficiaries.'
}

Table performance.pbor_snapshot {
  pbor_snapshot_id varchar [pk, note: 'Unique identifier for the PBOR snapshot record. Primary key.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: PBOR snapshots need to record which actuarial assumptions were in effect for consistent performance measurement.']
  composite_id varchar [note: 'Identifier of the GIPS composite to which this portfolio belongs for performance reporting.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: PBOR snapshots for pension portfolios must link to liability projections for funded status tracking.']
  performance_benchmark_id varchar [note: 'Identifier of the benchmark index used for performance comparison.']
  portfolio_id varchar [note: 'Identifier of the portfolio for which this PBOR snapshot is recorded.']
  valuation_nav_record_id varchar [note: 'Foreign key linking to valuation.valuation_nav_record. Business justification: PBOR snapshots must reference the official NAV record used for performance calculation. GIPS compliance requires traceability from reported performance to audited valuations.']
  var_calculation_id varchar [note: 'Foreign key linking to risk.var_calculation. Business justification: Pension funds must reconcile PBOR (Performance Book of Record) snapshots with official VaR calculations for regulatory reporting (IORP II) and investment committee reviews.']
  accrued_income decimal(20,2) [note: 'Income earned but not yet received as of the valuation date, including dividends and interest.']
  approval_timestamp timestamp [note: 'Timestamp when the PBOR snapshot was approved and finalized for reporting.']
  approved_by varchar [note: 'Name or identifier of the individual or system that approved the PBOR snapshot.']
  asset_class varchar [note: 'Primary asset class classification of the portfolio for performance attribution.']
  attribution_method varchar [note: 'Performance attribution methodology applied to decompose portfolio returns.']
  base_currency varchar [note: 'Three-letter ISO 4217 currency code representing the portfolio\'s reporting currency.']
  benchmark_return decimal(10,6) [note: 'Return of the assigned benchmark index for the same period, used for relative performance comparison, expressed as a decimal.']
  created_timestamp timestamp [note: 'Timestamp when this PBOR snapshot record was first created in the system.']
  custody_fee decimal(20,2) [note: 'Custodian and fund administration fees charged during the period.']
  dividend_income decimal(20,2) [note: 'Dividend income received from equity holdings during the period.']
  excess_return decimal(10,6) [note: 'Portfolio return in excess of the benchmark return (TWR minus benchmark return), expressed as a decimal.']
  fx_gain_loss decimal(20,2) [note: 'Gain or loss from foreign exchange rate movements on non-base currency holdings.']
  gav decimal(20,2) [note: 'Total market value of all portfolio assets before deducting liabilities.']
  geographic_region varchar [note: 'Primary geographic region or market focus of the portfolio for attribution analysis.']
  gips_compliant boolean [note: 'Indicates whether this PBOR snapshot adheres to GIPS compliance standards for performance reporting.']
  gross_contributions decimal(20,2) [note: 'Total cash and asset contributions received into the portfolio during the period.']
  gross_distributions decimal(20,2) [note: 'Total cash and asset distributions paid out from the portfolio during the period.']
  income_earned decimal(20,2) [note: 'Total income earned during the period, including dividends, interest, and rental income.']
  information_ratio decimal(10,6) [note: 'Ratio of excess return to tracking error, measuring active management skill.']
  interest_income decimal(20,2) [note: 'Interest income earned from fixed income securities and cash holdings during the period.']
  leverage_ratio decimal(5,4) [note: 'Ratio of borrowed capital to equity capital in the portfolio, expressed as a decimal.']
  liquidity_ratio decimal(5,4) [note: 'Proportion of portfolio assets that can be liquidated within a short timeframe, expressed as a decimal.']
  management_fee decimal(20,2) [note: 'Investment management fee charged by internal or external managers during the period.']
  modified_timestamp timestamp [note: 'Timestamp when this PBOR snapshot record was last modified or updated.']
  mwr decimal(10,6) [note: 'Money-weighted rate of return (internal rate of return) for the period, reflecting cash flow timing impact, expressed as a decimal.']
  nav decimal(20,2) [note: 'Net portfolio value after deducting all liabilities from gross asset value.']
  net_contributions decimal(20,2) [note: 'Net cash flow into the portfolio during the period, calculated as contributions minus distributions.']
  number_of_holdings varchar [note: 'Total count of distinct investment positions held in the portfolio at the valuation date.']
  performance_fee decimal(20,2) [note: 'Performance-based or carried interest fee charged when returns exceed hurdle rate or high-water mark.']
  realized_gain_loss decimal(20,2) [note: 'Actual gain or loss realized from asset sales and dispositions during the period ending on valuation date.']
  sector_allocation varchar [note: 'Dominant sector or industry allocation within the portfolio at the snapshot date.']
  sharpe_ratio decimal(10,6) [note: 'Risk-adjusted return metric calculated as excess return divided by standard deviation of returns.']
  snapshot_status varchar [note: 'Current status of the PBOR snapshot in its lifecycle (preliminary, final, restated, archived).']
  snapshot_timestamp timestamp [note: 'Precise timestamp when the PBOR snapshot was captured, including time zone.']
  strategy_type varchar [note: 'Investment strategy or mandate type applied to the portfolio (e.g., growth, value, core, opportunistic).']
  total_fees decimal(20,2) [note: 'Total investment management fees, custody fees, and other expenses charged to the portfolio during the period.']
  tracking_error decimal(10,6) [note: 'Standard deviation of the difference between portfolio returns and benchmark returns, expressed as a decimal.']
  transaction_costs decimal(20,2) [note: 'Total brokerage commissions, bid-ask spreads, and other trading costs incurred during the period.']
  twr decimal(10,6) [note: 'Time-weighted rate of return for the period, eliminating the impact of cash flows, expressed as a decimal.']
  unrealized_gain_loss decimal(20,2) [note: 'Mark-to-market gain or loss on positions held as of the valuation date, not yet realized through sale.']
  valuation_date date [note: 'The date on which this PBOR snapshot was taken and portfolio values were determined.']
  var_95 decimal(20,2) [note: 'Value at Risk at 95% confidence level, representing maximum expected loss over a specified period.']

  Note: 'Master record representing the Performance Book of Record (PBOR) snapshot for each portfolio at each valuation date. Captures total portfolio market value (GAV and NAV), accrued income, unrealized gain/loss, realized gain/loss, net contributions for the'
}

Table performance.gips_composite_report {
  gips_composite_report_id varchar [pk, note: 'Unique identifier for the GIPS composite report record.']
  approved_by_user_employee_id varchar [note: 'Reference to the user who approved this GIPS composite report for publication.']
  composite_id varchar [note: 'Reference to the investment composite for which this report is prepared.']
  employee_id varchar [note: 'Reference to the user who prepared this GIPS composite report.']
  gips_compliance_record_id varchar [note: 'Foreign key linking to compliance.gips_compliance_record. Business justification: GIPS composite reports must link to compliance records for verification workflow.']
  approval_date date [note: 'Date when this GIPS composite report was formally approved.']
  benchmark_annual_return_pct decimal(10,4) [note: 'Annual return of the benchmark index for the reporting year, expressed as a percentage.']
  benchmark_name varchar [note: 'Name of the primary benchmark index used for performance comparison.']
  benchmark_three_year_std_dev_pct decimal(10,4) [note: 'Three-year annualized ex-post standard deviation of the benchmark returns, expressed as a percentage.']
  composite_annual_return_pct decimal(10,4) [note: 'Time-Weighted Return (TWR) for the composite for the reporting year, expressed as a percentage.']
  composite_aum_end_of_year decimal(20,2) [note: 'Total market value of assets in the composite at the end of the reporting year.']
  composite_creation_date date [note: 'Date when the composite was first established.']
  composite_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which composite returns and AUM are reported.']
  composite_description varchar [note: 'Detailed description of the composite strategy, investment mandate, and inclusion criteria.']
  composite_dispersion_pct decimal(10,4) [note: 'Measure of the spread of individual portfolio returns within the composite, typically asset-weighted standard deviation.']
  composite_inception_date date [note: 'Date of the first full reporting period for the composite.']
  composite_strategy_type varchar [note: 'Primary asset class or investment strategy category of the composite.']
  composite_termination_date date [note: 'Date when the composite was discontinued or merged, if applicable.']
  composite_three_year_std_dev_pct decimal(10,4) [note: 'Three-year annualized ex-post standard deviation of the composite returns, expressed as a percentage.']
  created_timestamp timestamp [note: 'Timestamp when this GIPS composite report record was first created in the system.']
  fee_schedule_description varchar [note: 'Description of the investment management fee structure applicable to portfolios in the composite.']
  firm_aum_end_of_year decimal(20,2) [note: 'Total market value of all assets managed by the firm at the end of the reporting year.']
  gips_compliance_statement varchar [note: 'Official statement confirming the firm has complied with GIPS standards for this composite and reporting period.']
  gross_of_fees_return_pct decimal(10,4) [note: 'Composite return before deduction of investment management fees, expressed as a percentage.']
  minimum_portfolio_size decimal(20,2) [note: 'Minimum asset value threshold for a portfolio to be included in the composite.']
  net_of_fees_return_pct decimal(10,4) [note: 'Composite return after deduction of investment management fees, expressed as a percentage.']
  notes varchar [note: 'Additional explanatory notes, disclosures, or commentary relevant to the composite report.']
  number_of_portfolios varchar [note: 'Count of individual portfolios included in the composite at the end of the reporting year.']
  percentage_of_firm_assets_pct decimal(10,4) [note: 'Composite AUM as a percentage of total firm AUM at the end of the reporting year.']
  publication_date date [note: 'Date when this GIPS composite report was published or distributed to stakeholders.']
  report_preparation_date date [note: 'Date when this GIPS composite report was prepared and finalized.']
  report_status varchar [note: 'Current lifecycle status of the GIPS composite report.']
  reporting_year varchar [note: 'Calendar year for which this GIPS composite report is prepared.']
  return_calculation_method varchar [note: 'Methodology used to calculate composite returns, typically Time-Weighted Return (TWR) per GIPS standards.']
  updated_timestamp timestamp [note: 'Timestamp when this GIPS composite report record was last modified.']
  use_of_derivatives_flag boolean [note: 'Indicates whether the composite strategy uses derivative instruments.']
  use_of_leverage_flag boolean [note: 'Indicates whether the composite strategy employs leverage or derivatives for investment purposes.']
  valuation_frequency varchar [note: 'Frequency at which portfolios within the composite are valued for performance calculation purposes.']
  verification_date date [note: 'Date of the most recent independent GIPS verification covering this composite.']
  verification_status varchar [note: 'Indicates whether the firm has undergone independent GIPS verification by a qualified third party.']
  verifier_name varchar [note: 'Name of the independent third-party firm that performed the GIPS verification.']

  Note: 'Transactional record representing the annual GIPS-compliant composite presentation prepared for each composite and reporting year. Captures composite annual return, benchmark annual return, composite 3-year annualized standard deviation, benchmark 3-year'
}

Table performance.performance_factor_exposure {
  performance_factor_exposure_id varchar [pk, note: 'Unique identifier for the performance factor exposure record.']
  factor_id varchar [note: 'Reference to the specific risk factor (e.g., market beta, size, value, momentum, quality, low volatility, duration, credit spread).']
  factor_model_id varchar [note: 'Reference to the factor model used for exposure calculation (e.g., Barra, MSCI, Fama-French).']
  portfolio_id varchar [note: 'Reference to the portfolio for which factor exposure is measured.']
  active_exposure decimal(18,6) [note: 'The difference between portfolio exposure and benchmark exposure to the factor (portfolio minus benchmark).']
  adjustment_reason varchar [note: 'Explanation for any manual adjustments or overrides applied to the calculated factor exposure.']
  as_of_date date [note: 'The date for which the factor exposure is calculated and reported.']
  asset_class varchar [note: 'The asset class to which this factor exposure measurement applies. [ENUM-REF-CANDIDATE: public_equity|private_equity|fixed_income|real_estate|infrastructure|natural_resources|multi_asset — 7 candidates stripped; promote to reference product]']
  benchmark_exposure_value decimal(18,6) [note: 'The benchmark\'s exposure to the same factor, used for relative performance attribution.']
  calculation_method varchar [note: 'The methodology used to calculate factor exposure (e.g., regression, covariance, holdings-based, returns-based).']
  calculation_timestamp timestamp [note: 'The date and time when the factor exposure calculation was performed.']
  confidence_level decimal(5,2) [note: 'The statistical confidence level of the exposure estimate, expressed as a percentage (e.g., 95.00 for 95% confidence).']
  contribution_to_return decimal(18,8) [note: 'The contribution of this factor exposure to the portfolio\'s total return over the measurement period, in basis points.']
  created_timestamp timestamp [note: 'The date and time when this factor exposure record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code in which exposure values are denominated.']
  data_source varchar [note: 'The source system or vendor providing the factor exposure data (e.g., SimCorp Dimension, MSCI Barra, FactSet, Bloomberg).']
  exposure_percentage decimal(10,4) [note: 'The portfolio\'s exposure to the factor expressed as a percentage of total portfolio risk or value.']
  exposure_value decimal(18,6) [note: 'The portfolio\'s exposure to the factor, expressed as a standardized score or beta coefficient.']
  factor_return decimal(18,8) [note: 'The return of the factor itself during the measurement period, used in attribution analysis.']
  frequency varchar [note: 'The frequency at which factor exposure is calculated and reported.']
  geographic_region varchar [note: 'The geographic region or market to which the factor exposure applies (e.g., North America, Europe, Asia-Pacific, Global).']
  is_active boolean [note: 'Indicates whether this factor exposure record is currently active and should be used in reporting and attribution analysis.']
  lookback_period_days varchar [note: 'The number of days of historical data used in the factor exposure calculation.']
  marginal_contribution_to_risk decimal(18,8) [note: 'The marginal contribution of this factor exposure to the portfolio\'s total risk, measured in basis points or percentage.']
  notes varchar [note: 'Additional commentary or context regarding the factor exposure measurement.']
  quality_flag boolean [note: 'Indicates the data quality status of the factor exposure record.']
  r_squared decimal(10,6) [note: 'The proportion of portfolio variance explained by this factor, ranging from 0 to 1.']
  sector_classification varchar [note: 'The sector or industry classification to which the factor exposure applies, if sector-specific.']
  standard_error decimal(18,8) [note: 'The standard error of the factor exposure estimate, measuring estimation uncertainty.']
  t_statistic decimal(10,4) [note: 'Statistical significance measure of the factor exposure, indicating confidence level.']
  updated_timestamp timestamp [note: 'The date and time when this factor exposure record was last modified.']

  Note: 'Transactional record of portfolio-level factor exposures used in factor-based performance attribution. Captures exposure to systematic risk factors (e.g., market beta, size, value, momentum, quality, low volatility, duration, credit spread) sourced from'
}

Table performance.peer_group {
  peer_group_id varchar [pk, note: 'Unique identifier for the peer group universe used for relative performance comparison.']
  asset_class varchar [note: 'Primary asset class or investment category that this peer group covers for comparative performance analysis. [ENUM-REF-CANDIDATE: Public Equities|Private Equity|Real Estate|Infrastructure|Natural Resources|Credit|Fixed Income|Multi-Asset|Balanced|Other —']
  benchmark_comparison_flag boolean [note: 'Indicates whether this peer group is used for formal benchmark-relative performance attribution and reporting.']
  created_timestamp timestamp [note: 'Timestamp when this peer group record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which peer group returns are reported (e.g., USD, EUR).']
  data_source_description varchar [note: 'Description of the data sources and collection methodology used by the provider to gather peer group performance data.']
  geographic_scope varchar [note: 'Geographic or regional focus of the peer group (e.g., Global, North America, Emerging Markets, Europe, USA).']
  gips_compliant_flag boolean [note: 'Indicates whether the peer group construction and performance calculation methodology adheres to GIPS standards.']
  gross_of_fees_flag boolean [note: 'Indicates whether peer group returns are reported gross of investment management fees.']
  inception_date date [note: 'Date when the peer group universe was first established or when performance data collection began.']
  internal_usage_notes varchar [note: 'Internal notes documenting how this peer group is used within the organization, which portfolios it applies to, and any usage guidelines.']
  last_updated_date date [note: 'Date when the peer group definition, membership, or methodology was last updated by the provider.']
  maximum_aum_threshold decimal(20,2) [note: 'Maximum AUM threshold for peer group inclusion, used to define size-based peer cohorts, expressed in the peer group currency.']
  member_count varchar [note: 'Current number of institutional investors or portfolios included in the peer group universe.']
  methodology_description varchar [note: 'Detailed description of the methodology, selection criteria, and construction rules used by the provider to define peer group membership.']
  minimum_aum_threshold decimal(20,2) [note: 'Minimum AUM required for an institutional investor to be included in the peer group universe, expressed in the peer group currency.']
  modified_timestamp timestamp [note: 'Timestamp when this peer group record was last modified or updated in the system.']
  net_of_fees_flag boolean [note: 'Indicates whether peer group returns are reported net of investment management fees and expenses.']
  peer_group_code varchar [note: 'Short alphanumeric code or identifier for the peer group used in reporting systems and performance analytics.']
  peer_group_name varchar [note: 'Business name of the peer group universe (e.g., Global Pension Funds - Infrastructure, national Public Equities Large Cap).']
  peer_group_status varchar [note: 'Current operational status of the peer group indicating whether it is actively maintained and used for performance comparison.']
  peer_group_type varchar [note: 'Classification of the type of institutional investors included in the peer group universe. [ENUM-REF-CANDIDATE: Institutional|Pension Fund|Sovereign Wealth Fund|Endowment|Foundation|Insurance|Mutual Fund|Hedge Fund|Private Equity Fund|Other — 10']
  provider_contact_email varchar [note: 'Primary email address for contacting the peer group provider for inquiries, data updates, or methodology questions.']
  provider_name varchar [note: 'Name of the third-party provider or data vendor that maintains and publishes the peer group universe. [ENUM-REF-CANDIDATE: CEM Benchmarking|Preqin|Mercer|Cambridge Associates|eVestment|Morningstar|MSCI|Russell Investments|Other — 9 candidates stripped']
  provider_website_url varchar [note: 'Website URL of the peer group provider where methodology documentation and peer group data can be accessed.']
  quartile_calculation_method varchar [note: 'Methodology used to calculate quartile rankings within the peer group (e.g., interpolation method, discrete ranking).']
  rebalancing_frequency varchar [note: 'Frequency at which the peer group membership is reviewed and rebalanced to reflect changes in member eligibility or universe composition.']
  reporting_frequency varchar [note: 'Frequency at which peer group performance data is updated and published by the provider.']
  return_calculation_method varchar [note: 'Standardized method used to calculate returns for peer group members (Time-Weighted Return, Money-Weighted Return, Internal Rate of Return).']
  strategy_type varchar [note: 'Investment strategy or style classification for the peer group (e.g., Value, Growth, Core, Opportunistic, Core-Plus).']
  subscription_end_date date [note: 'Date when the organization subscription to this peer group ended or is scheduled to end.']
  subscription_start_date date [note: 'Date when the organization began subscribing to or using this peer group for performance comparison and reporting.']
  vintage_year varchar [note: 'For private markets peer groups, the fund commitment year or vintage year cohort that defines the peer universe.']

  Note: 'Master record defining peer group universes used for relative performance comparison. Captures peer group name, peer group provider (e.g., CEM Benchmarking, Preqin, Mercer), asset class scope, peer group inception date, and methodology description.'
}

Table performance.peer_group_return {
  peer_group_return_id varchar [pk, note: 'Unique identifier for the peer group return record.']
  benchmark_index_id varchar [note: 'Identifier of the benchmark index used for comparison alongside peer group returns, if applicable.']
  composite_id varchar [note: 'Identifier of the GIPS composite to which this peer group return is associated, if applicable.']
  peer_group_id varchar [note: 'Identifier of the peer group universe to which this return statistic applies.']
  portfolio_id varchar [note: 'Identifier of the portfolio being compared against the peer group, if applicable.']
  asset_class varchar [note: 'Asset class category for which the peer group return is measured (e.g., Public Equities, Private Equity, Real Estate, Infrastructure, Credit).']
  bottom_decile_return decimal(18,6) [note: 'Maximum return threshold for the bottom 10% performers in the peer group for the measurement period.']
  created_timestamp timestamp [note: 'Timestamp when this peer group return record was first created in the system.']
  data_as_of_date date [note: 'Date on which the peer group return data was sourced or published by the provider.']
  data_quality_flag boolean [note: 'Indicator of the data quality status: Verified (final), Preliminary (subject to revision), Estimated (modeled), or Incomplete (partial data).']
  fund_strategy varchar [note: 'Investment strategy classification of the peer group (e.g., Buyout, Venture Capital, Core Real Estate, Value-Add Infrastructure).']
  geography varchar [note: 'Geographic scope or region of the peer group (e.g., Global, North America, Europe, Asia-Pacific).']
  gips_compliant boolean [note: 'Indicates whether the peer group return calculation is compliant with GIPS standards (True/False).']
  mean_return decimal(18,6) [note: 'Arithmetic mean return of the peer group for the measurement period.']
  measurement_period_end_date date [note: 'End date of the performance measurement period for which peer group returns are calculated.']
  measurement_period_start_date date [note: 'Start date of the performance measurement period for which peer group returns are calculated.']
  median_return decimal(18,6) [note: 'Median return of the peer group for the measurement period, expressed as a decimal (e.g., 0.0825 for 8.25%).']
  notes varchar [note: 'Free-text field for additional context, caveats, or explanatory notes regarding the peer group return data.']
  number_of_peers varchar [note: 'Total count of peer entities included in the peer group universe for this measurement period.']
  peer_group_aum_currency varchar [note: 'ISO 4217 three-letter currency code for the peer group AUM total (e.g., USD, EUR).']
  peer_group_aum_total decimal(20,2) [note: 'Total Assets Under Management (AUM) across all peers in the group at the measurement period end date.']
  peer_group_provider varchar [note: 'Source provider of the peer group data (CEM Benchmarking, Preqin, Mercer, or Internal).']
  percentile_25th_return decimal(18,6) [note: 'Return at the 25th percentile of the peer group distribution for the measurement period.']
  percentile_75th_return decimal(18,6) [note: 'Return at the 75th percentile of the peer group distribution for the measurement period.']
  reporting_frequency varchar [note: 'Frequency at which peer group return statistics are reported (Daily, Monthly, Quarterly, Annual).']
  return_type varchar [note: 'Type of return calculation methodology applied: Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), Gross of Fees, or Net of Fees.']
  standard_deviation decimal(18,6) [note: 'Standard deviation of returns within the peer group, measuring dispersion and risk.']
  top_decile_return decimal(18,6) [note: 'Minimum return threshold for the top 10% performers in the peer group for the measurement period.']
  updated_timestamp timestamp [note: 'Timestamp when this peer group return record was last modified in the system.']
  vintage_year varchar [note: 'Vintage year of the peer group, applicable for private market funds (year of fund commitment or first capital call).']

  Note: 'Transactional record of peer group return statistics for each measurement period, including median return, 25th percentile, 75th percentile, top decile, bottom decile, and number of peers in the universe. Sourced from CEM Benchmarking, Preqin, and Mercer.'
}

Table performance.return_period {
  return_period_id varchar [pk, note: 'Unique identifier for the return period. Primary key.']
  annualization_factor decimal(10,6) [note: 'Factor used to annualize returns for this period (e.g., 252 for daily, 12 for monthly, 4 for quarterly, 1 for annual). Used in volatility and Sharpe ratio calculations.']
  attribution_eligible_flag boolean [note: 'Indicates whether this period supports factor, sector, and geographic attribution analysis.']
  benchmark_comparison_flag boolean [note: 'Indicates whether this period is used for benchmark-relative performance comparison and attribution analysis.']
  calculation_method varchar [note: 'Primary return calculation methodology applicable to this period: Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), simple return, or compound return.']
  composite_eligible_flag boolean [note: 'Indicates whether this period is eligible for composite construction and aggregation under GIPS standards.']
  created_timestamp timestamp [note: 'Timestamp when this return period record was first created in the system.']
  display_sequence varchar [note: 'Numeric ordering for display in performance reports and dashboards. Lower numbers appear first.']
  duration_days varchar [note: 'Standard duration of the period in calendar days. Null for variable-length periods such as inception-to-date.']
  duration_months varchar [note: 'Standard duration of the period in months. Used for rolling multi-year periods (e.g., 12 for rolling 1-year, 36 for rolling 3-year).']
  effective_from_date date [note: 'Date from which this return period definition became effective and available for performance calculations.']
  effective_to_date date [note: 'Date until which this return period definition remains effective. Null for currently active periods with no planned end date.']
  fiscal_year_end_month varchar [note: 'Month number (1-12) representing the fiscal year end for fiscal period types. Null for non-fiscal periods.']
  gips_compliant_flag boolean [note: 'Indicates whether this period definition is compliant with GIPS 2020 standards for performance reporting.']
  last_modified_timestamp timestamp [note: 'Timestamp when this return period record was last modified or updated.']
  period_code varchar [note: 'Business identifier code for the return period (e.g., DAILY, MTD, QTD, YTD, ITD, R1Y, R3Y, R5Y, R10Y).']
  period_frequency varchar [note: 'Frequency classification of the return period: daily, weekly, monthly, quarterly, semi-annual, annual, multi-year, or inception. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annual|annual|multi_year|inception — 8 candidates stripped; promote']
  period_name varchar [note: 'Human-readable name of the return period (e.g., Daily, Month-to-Date, Quarter-to-Date, Fiscal Year, Calendar Year, Inception-to-Date, Rolling 1-Year, Rolling 3-Year).']
  period_type varchar [note: 'Classification of the period type: calendar-based, fiscal-based, rolling window, inception-to-date, or custom defined.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this period is required for regulatory or beneficiary performance reporting to pension regulators, or beneficiaries.']
  return_period_description varchar [note: 'Detailed business description of the return period, including calculation rules, use cases, and any special considerations for performance measurement.']
  return_period_status varchar [note: 'Current lifecycle status of the return period definition: active for current use, inactive for temporarily disabled, deprecated for phased-out periods.']
  rolling_window_months varchar [note: 'Number of months in the rolling window for rolling period types (e.g., 12 for rolling 1-year, 36 for rolling 3-year, 60 for rolling 5-year, 120 for rolling 10-year).']

  Note: 'Reference entity defining the standard measurement periods used across all performance calculations: daily, monthly, quarterly, fiscal year, calendar year, inception-to-date, rolling 1-year, rolling 3-year, rolling 5-year, rolling 10-year.'
}

Table performance.attribution_model {
  attribution_model_id varchar [pk, note: 'Unique identifier for the attribution model configuration record.']
  allocation_effect_enabled boolean [note: 'Indicates whether the model calculates allocation effect (impact of portfolio weight decisions relative to benchmark).']
  applicable_asset_classes varchar [note: 'Comma-separated list of asset classes for which this attribution model is designed (e.g., Public Equities, Fixed Income, Private Equity, Real Estate).']
  approval_date date [note: 'The date on which this attribution model configuration was formally approved for use.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved this attribution model for production use.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which attribution results are expressed.']
  benchmark_required_flag boolean [note: 'Indicates whether a benchmark is mandatory for attribution calculations using this model.']
  calculation_engine varchar [note: 'The system or platform responsible for executing attribution calculations using this model (e.g., SimCorp Dimension, FactSet, Aladdin, custom engine).']
  calculation_frequency varchar [note: 'The standard frequency at which attribution analysis is performed using this model.']
  cash_treatment_method varchar [note: 'Defines how cash and cash equivalents are handled in the attribution calculation.']
  client_reporting_flag boolean [note: 'Indicates whether this attribution model is used for beneficiary or client-facing performance reports.']
  contact_email varchar [note: 'Email address of the team or individual responsible for questions and support related to this attribution model.']
  currency_effect_enabled boolean [note: 'Indicates whether the model isolates and calculates foreign exchange impact on returns.']
  derivative_treatment_method varchar [note: 'Defines how derivative instruments are incorporated into attribution analysis (e.g., notional exposure, delta-adjusted, look-through to underlying).']
  documentation_url varchar [note: 'Link to detailed technical and business documentation for this attribution model.']
  effective_end_date date [note: 'The date on which this attribution model configuration ceased to be active. Null if currently active.']
  effective_start_date date [note: 'The date from which this attribution model configuration became active and available for use.']
  factor_model_type varchar [note: 'The factor model framework used for factor-based attribution (e.g., Barra, Axioma, custom multi-factor model). Null if not factor-based.']
  geographic_classification_scheme varchar [note: 'The geographic taxonomy used for regional attribution analysis (e.g., MSCI country classification, custom regional groupings).']
  gips_compliant_flag boolean [note: 'Indicates whether the attribution model configuration adheres to GIPS standards for performance attribution.']
  interaction_effect_enabled boolean [note: 'Indicates whether the model calculates interaction effect (combined impact of allocation and selection decisions).']
  internal_analytics_flag boolean [note: 'Indicates whether this attribution model is used for internal investment decision-making and portfolio management analytics.']
  last_review_date date [note: 'The most recent date on which this attribution model was reviewed for accuracy, relevance, and compliance.']
  methodology_framework varchar [note: 'The foundational academic or industry-standard framework upon which this attribution model is built.']
  model_code varchar [note: 'Short alphanumeric code uniquely identifying the attribution model for system integration and reporting.']
  model_description varchar [note: 'Detailed narrative describing the purpose, methodology, and use cases for this attribution model.']
  model_name varchar [note: 'Business name of the attribution methodology (e.g., Brinson-Hood-Beebower, Brinson-Fachler, Factor-Based Attribution).']
  model_status varchar [note: 'Current lifecycle status of the attribution model configuration.']
  model_type varchar [note: 'Classification of the attribution methodology by asset class or analytical approach.']
  multi_period_linking_method varchar [note: 'The method used to link attribution effects across multiple time periods.']
  next_review_date date [note: 'The scheduled date for the next periodic review of this attribution model configuration.']
  owner_team varchar [note: 'The business unit or team responsible for maintaining and governing this attribution model (e.g., Performance Analytics, Investment Risk).']
  record_created_timestamp timestamp [note: 'The date and time when this attribution model record was first created in the system.']
  record_updated_timestamp timestamp [note: 'The date and time when this attribution model record was last modified.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this attribution model is used for regulatory or statutory performance reporting.']
  return_calculation_method varchar [note: 'The return calculation methodology used as input to the attribution analysis (Time-Weighted Return, Money-Weighted Return, etc.).']
  sector_classification_scheme varchar [note: 'The industry or sector taxonomy used for attribution grouping (e.g., GICS, ICB, BICS, custom internal classification).']
  selection_effect_enabled boolean [note: 'Indicates whether the model calculates selection effect (impact of security selection within sectors or factors).']
  smoothing_method varchar [note: 'Technique applied to smooth attribution effects over time or handle large cash flows (e.g., Modified Dietz smoothing). Null if no smoothing applied.']
  version_number varchar [note: 'Version identifier for the attribution model configuration, supporting change tracking and audit.']

  Note: 'Reference master record defining the attribution methodologies configured for use across portfolios and asset classes. Captures model name (e.g., Brinson-Hood-Beebower, Brinson-Fachler, factor-based, fixed income attribution), model type, currency'
}

Table performance.fee_hurdle {
  fee_hurdle_id varchar [pk, note: 'Unique identifier for the fee hurdle record.']
  legal_entity_id varchar [note: 'Reference to the legal entity (fund, limited partnership, or investment vehicle) to which this fee hurdle applies.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate governing this fee hurdle arrangement.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for relative hurdle rate calculations.']
  portfolio_id varchar [note: 'Reference to the portfolio to which this fee hurdle applies.']
  approval_date date [note: 'The date on which the Investment Committee (IC) or governing body approved this fee hurdle arrangement.']
  approved_by varchar [note: 'Name or identifier of the authority (e.g., Investment Committee member, Chief Investment Officer) who approved this hurdle arrangement.']
  asset_class varchar [note: 'The primary asset class to which this fee hurdle applies (e.g., Private Equity, Real Estate, Infrastructure, Credit).']
  base_currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the hurdle rate and performance fees are denominated.']
  calculation_frequency varchar [note: 'The frequency at which the hurdle rate and performance fee calculations are performed.']
  catch_up_provision_flag boolean [note: 'Indicates whether a catch-up provision exists allowing the General Partner (GP) to receive 100% of profits after the hurdle until the agreed profit split is achieved.']
  catch_up_rate decimal(8,6) [note: 'The percentage of returns allocated to the GP during the catch-up period, expressed as a decimal; null if no catch-up provision exists.']
  clawback_provision_flag boolean [note: 'Indicates whether a clawback provision exists requiring the GP to return previously paid performance fees if the fund underperforms over its lifetime.']
  compounding_method varchar [note: 'The method used to calculate the hurdle rate over time: simple (non-compounding) or compound (compounding).']
  crystallization_frequency varchar [note: 'The method by which performance fees are crystallized: deal-by-deal (per investment), whole-fund (portfolio level), or hybrid.']
  effective_end_date date [note: 'The date on which this fee hurdle arrangement ceases to be applicable; null for open-ended arrangements.']
  effective_start_date date [note: 'The date from which this fee hurdle arrangement becomes active and applicable to performance fee calculations.']
  fee_accrual_method varchar [note: 'Indicates whether performance fees are accrued continuously or only upon realization of gains.']
  gp_commitment_percentage decimal(8,6) [note: 'The percentage of the fund that the GP has committed to invest alongside LPs, which may affect hurdle rate terms.']
  high_water_mark decimal(20,4) [note: 'The highest Net Asset Value (NAV) level previously achieved by the portfolio, used to ensure performance fees are only charged on new gains.']
  high_water_mark_date date [note: 'The date on which the current high water mark was established.']
  hurdle_adjustment_provision varchar [note: 'Description of any provisions allowing for adjustment of the hurdle rate under specific circumstances (e.g., market conditions, regulatory changes).']
  hurdle_rate decimal(10,6) [note: 'The minimum annualized return threshold that must be exceeded before performance fees are earned, expressed as a decimal (e.g., 0.08 for 8%).']
  hurdle_status varchar [note: 'Current operational status of the fee hurdle arrangement.']
  hurdle_type varchar [note: 'Classification of the hurdle rate structure: absolute (fixed percentage), relative (benchmark-linked), or hybrid (combination).']
  investment_strategy varchar [note: 'The specific investment strategy or sub-strategy associated with this hurdle arrangement (e.g., Growth Equity, Value-Add Real Estate, Core Infrastructure).']
  last_calculation_date date [note: 'The most recent date on which the hurdle rate and performance fee calculation was performed for this arrangement.']
  loss_carryforward_flag boolean [note: 'Indicates whether losses from prior periods can be carried forward to offset future gains before performance fees are calculated.']
  next_calculation_date date [note: 'The scheduled date for the next hurdle rate and performance fee calculation.']
  notes varchar [note: 'Additional notes or comments regarding special terms, exceptions, or context for this fee hurdle arrangement.']
  performance_fee_rate decimal(8,6) [note: 'The percentage of excess returns above the hurdle rate that is charged as a performance fee, expressed as a decimal (e.g., 0.20 for 20% carried interest).']
  preferred_return_rate decimal(10,6) [note: 'The minimum return rate that Limited Partners (LPs) must receive before the GP participates in profits, expressed as a decimal; synonymous with hurdle rate in private equity contexts.']
  record_created_timestamp timestamp [note: 'The timestamp when this fee hurdle record was first created in the system.']
  record_updated_timestamp timestamp [note: 'The timestamp when this fee hurdle record was last modified.']
  reset_frequency varchar [note: 'The frequency at which the high water mark is reset, if applicable.']
  return_calculation_method varchar [note: 'The methodology used to calculate returns for hurdle comparison: Time-Weighted Return (TWR), Money-Weighted Return (MWR), or Internal Rate of Return (IRR).']
  vintage_year varchar [note: 'The year in which the fund or mandate was established, relevant for cohort analysis and hurdle rate benchmarking.']

  Note: 'Master record defining the performance fee hurdle rate and high-water mark parameters applicable to each portfolio or mandate for performance fee calculation purposes.'
}

Table performance.excess_return {
  excess_return_id varchar [pk, note: 'Unique identifier for the excess return record.']
  composite_id varchar [note: 'Identifier of the GIPS composite to which this portfolio belongs, if applicable.']
  performance_benchmark_id varchar [note: 'Identifier of the benchmark index used for relative performance comparison.']
  portfolio_id varchar [note: 'Identifier of the portfolio for which excess return is measured.']
  active_return decimal(18,8) [note: 'Synonym for gross excess return, representing portfolio outperformance or underperformance versus benchmark.']
  active_weight decimal(18,8) [note: 'Difference between portfolio weight and benchmark weight, indicating active positioning.']
  annualized_excess_return decimal(18,8) [note: 'Excess return annualized for periods shorter or longer than one year for comparability.']
  asset_class varchar [note: 'Primary asset class of the portfolio for which excess return is measured.']
  attribution_method varchar [note: 'Performance attribution methodology used to decompose excess return into allocation and selection effects.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which excess return is reported.']
  benchmark_return decimal(18,8) [note: 'Total return of the benchmark index for the measurement period, expressed as a decimal.']
  benchmark_type varchar [note: 'Type of benchmark used for excess return comparison, such as market index, custom blend, policy benchmark, or peer group.']
  benchmark_weight_average decimal(18,8) [note: 'Average weight of the benchmark component during the measurement period for weighted excess return calculations.']
  calculation_status varchar [note: 'Status of the excess return calculation indicating whether it is preliminary, final, restated, or audited.']
  calculation_timestamp timestamp [note: 'Date and time when the excess return was calculated in the performance system.']
  cumulative_excess_return decimal(18,8) [note: 'Compounded excess return over multiple periods, showing total alpha generation since inception or period start.']
  currency_adjusted_excess_return decimal(18,8) [note: 'Excess return adjusted for foreign exchange effects to isolate investment decision impact.']
  data_quality_flag boolean [note: 'Indicator of data quality and completeness for the excess return calculation.']
  geographic_region varchar [note: 'Primary geographic region of portfolio investments for which excess return is measured.']
  gips_compliant_flag boolean [note: 'Indicates whether the excess return calculation adheres to GIPS standards for performance reporting.']
  gross_excess_return decimal(18,8) [note: 'Portfolio return minus benchmark return before deducting fees, representing alpha generation.']
  information_ratio decimal(18,8) [note: 'Ratio of excess return to tracking error, measuring risk-adjusted alpha generation.']
  measurement_period_end_date date [note: 'End date of the performance measurement period for which excess return is calculated.']
  measurement_period_start_date date [note: 'Start date of the performance measurement period for which excess return is calculated.']
  net_excess_return decimal(18,8) [note: 'Portfolio return minus benchmark return after deducting all fees, representing net alpha to beneficiaries.']
  period_type varchar [note: 'Type of measurement period for the excess return calculation.']
  portfolio_return decimal(18,8) [note: 'Total return of the portfolio for the measurement period, expressed as a decimal.']
  portfolio_weight_average decimal(18,8) [note: 'Average weight of the portfolio within the composite or fund structure during the measurement period.']
  record_created_timestamp timestamp [note: 'Date and time when this excess return record was first created in the lakehouse.']
  record_updated_timestamp timestamp [note: 'Date and time when this excess return record was last updated in the lakehouse.']
  return_calculation_method varchar [note: 'Methodology used to calculate portfolio and benchmark returns for excess return derivation.']
  risk_free_rate decimal(18,8) [note: 'Risk-free rate used in Sharpe ratio calculation, typically SOFR or government bond yield.']
  sector varchar [note: 'Primary sector or industry focus of the portfolio for which excess return is measured.']
  sharpe_ratio decimal(18,8) [note: 'Ratio of portfolio excess return over risk-free rate to portfolio volatility, measuring risk-adjusted return.']
  strategy_type varchar [note: 'Investment strategy employed by the portfolio, such as value, growth, core, opportunistic, or distressed.']
  tracking_error decimal(18,8) [note: 'Standard deviation of excess returns, measuring consistency of relative performance.']
  valuation_source varchar [note: 'Source system or vendor providing valuation data used in excess return calculation, such as Bloomberg, FactSet, or internal pricing.']

  Note: 'Transactional record of benchmark-relative excess return (alpha) for each portfolio and measurement period. Captures gross excess return, net-of-fee excess return, currency-adjusted excess return, information ratio, tracking error, and Sharpe ratio.'
}

Table performance.currency_attribution {
  currency_attribution_id varchar [pk, note: 'Unique identifier for the currency attribution record.']
  composite_id varchar [note: 'Reference to the GIPS composite to which this portfolio belongs for currency attribution reporting.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for currency attribution comparison.']
  portfolio_id varchar [note: 'Reference to the portfolio for which currency attribution is calculated.']
  active_currency_weight decimal(18,8) [note: 'Difference between portfolio and benchmark currency weights (portfolio weight minus benchmark weight), expressed as a decimal fraction.']
  asset_class varchar [note: 'Primary asset class category for holdings denominated in this currency. [ENUM-REF-CANDIDATE: public_equities|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|multi_asset — 8 candidates stripped; promote to reference product]']
  attribution_method varchar [note: 'Methodology used to calculate currency attribution effects (e.g., Brinson, Brinson-Fachler, Carino, Geometric).']
  base_currency_code varchar [note: 'Three-letter ISO 4217 code for the base reporting currency of the portfolio.']
  benchmark_weight_average decimal(18,8) [note: 'Average benchmark weight allocated to this currency during the measurement period, expressed as a decimal fraction.']
  benchmark_weight_begin decimal(18,8) [note: 'Benchmark weight allocated to this currency at the beginning of the measurement period, expressed as a decimal fraction.']
  benchmark_weight_end decimal(18,8) [note: 'Benchmark weight allocated to this currency at the end of the measurement period, expressed as a decimal fraction.']
  calculation_status varchar [note: 'Current status of the currency attribution calculation in its lifecycle.']
  calculation_timestamp timestamp [note: 'Date and time when the currency attribution calculation was performed.']
  currency_allocation_effect decimal(18,8) [note: 'Performance impact from differences in currency weight allocation between portfolio and benchmark, expressed in basis points (bps).']
  currency_interaction_effect decimal(18,8) [note: 'Performance impact from the interaction between currency allocation and selection decisions, expressed in basis points (bps).']
  currency_pair varchar [note: 'Currency pair notation representing the foreign currency relative to base currency (e.g., EUR/USD).']
  currency_selection_effect decimal(18,8) [note: 'Performance impact from currency return differences between portfolio and benchmark holdings, expressed in basis points (bps).']
  data_quality_flag boolean [note: 'Indicator of data quality and completeness for this currency attribution record.']
  foreign_currency_code varchar [note: 'Three-letter ISO 4217 code for the foreign currency being analyzed in this attribution segment.']
  forward_contract_mtm decimal(20,2) [note: 'Mark-to-market value of foreign exchange forward contracts at period end, expressed in base currency.']
  forward_contract_notional decimal(20,2) [note: 'Total notional value of foreign exchange forward contracts used for hedging this currency exposure.']
  fx_return decimal(18,8) [note: 'Return attributable to foreign exchange rate movement during the measurement period, expressed as a decimal fraction.']
  fx_spot_rate_begin decimal(18,8) [note: 'Foreign exchange spot rate for the currency pair at the beginning of the measurement period.']
  fx_spot_rate_end decimal(18,8) [note: 'Foreign exchange spot rate for the currency pair at the end of the measurement period.']
  geographic_region varchar [note: 'Geographic region associated with this currency exposure (e.g., North America, Europe, Asia Pacific, Emerging Markets).']
  gips_compliant_flag boolean [note: 'Indicates whether this currency attribution calculation meets GIPS compliance standards.']
  hedge_ratio decimal(18,8) [note: 'Proportion of currency exposure that is hedged, expressed as a decimal fraction (0.0 = unhedged, 1.0 = fully hedged).']
  hedged_exposure_amount decimal(20,2) [note: 'Market value of hedged currency exposure in base currency at period end.']
  hedging_contribution decimal(18,8) [note: 'Performance contribution from currency hedging activities for this currency pair, expressed in basis points (bps).']
  measurement_period_end_date date [note: 'End date of the performance measurement period for currency attribution analysis.']
  measurement_period_start_date date [note: 'Start date of the performance measurement period for currency attribution analysis.']
  notes varchar [note: 'Free-text field for additional commentary, explanations, or special circumstances related to this currency attribution record.']
  period_type varchar [note: 'Type of measurement period for this currency attribution calculation.']
  portfolio_weight_average decimal(18,8) [note: 'Average portfolio weight allocated to this currency during the measurement period, expressed as a decimal fraction.']
  portfolio_weight_begin decimal(18,8) [note: 'Portfolio weight allocated to this currency at the beginning of the measurement period, expressed as a decimal fraction.']
  portfolio_weight_end decimal(18,8) [note: 'Portfolio weight allocated to this currency at the end of the measurement period, expressed as a decimal fraction.']
  record_created_timestamp timestamp [note: 'Date and time when this currency attribution record was first created in the lakehouse.']
  source_system_timestamp timestamp [note: 'Date and time when this record was created or last updated in the source system.']
  total_currency_effect decimal(18,8) [note: 'Total performance impact from all currency attribution components (allocation, selection, interaction), expressed in basis points (bps).']
  unhedged_exposure_amount decimal(20,2) [note: 'Market value of unhedged currency exposure in base currency at period end.']

  Note: 'Transactional record capturing the currency effect component of performance attribution for each portfolio and measurement period. Stores currency allocation effect, currency selection effect, and hedging contribution broken down by currency pair.'
}

Table performance.performance_calculation_run {
  performance_calculation_run_id varchar [pk, note: 'Unique identifier for each performance calculation batch execution instance.']
  original_run_performance_calculation_run_id varchar [note: 'Reference to the original performance_calculation_run_id being restated, if this is a restatement run.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Performance calculation runs must reference the valuation cycle that provides asset values. GIPS compliance requires reconciling performance to specific valuation dates.']
  approval_status varchar [note: 'Approval workflow status for performance results before publication to beneficiaries or regulators.']
  approval_timestamp timestamp [note: 'Timestamp when the calculation results were approved for publication.']
  approved_by_user varchar [note: 'Username of the performance analyst or manager who approved the calculation results for publication.']
  asset_class_scope varchar [note: 'Comma-separated list of asset classes included in this calculation run (e.g., public_equities, private_equity, real_estate, infrastructure, credit).']
  attribution_calculation_flag boolean [note: 'Indicates whether performance attribution analysis (allocation, selection, interaction effects) was executed in this run.']
  attribution_method varchar [note: 'Performance attribution methodology applied if attribution was calculated: Brinson, Brinson-Fachler, Brinson-Hood-Beebower, Carino, geometric, or arithmetic.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which performance results are reported.']
  benchmark_calculation_flag boolean [note: 'Indicates whether benchmark returns were calculated alongside portfolio returns in this run.']
  calculation_method varchar [note: 'Performance calculation methodology applied: Time-Weighted Return (TWR), Money-Weighted Return (MWR), Internal Rate of Return (IRR), simple return, or Modified Dietz.']
  calculation_status varchar [note: 'Current lifecycle status of the calculation run workflow.']
  calculation_type varchar [note: 'Type of performance calculation executed: daily NAV, month-end, quarter-end, year-end, GIPS annual composite, or ad-hoc analysis.']
  composite_count varchar [note: 'Number of GIPS composites calculated in this run, if applicable.']
  data_quality_score decimal(5,2) [note: 'Aggregate data quality score (0-100) for input data used in this calculation run, based on completeness, accuracy, and timeliness checks.']
  error_count varchar [note: 'Number of errors encountered during calculation execution.']
  error_log_reference varchar [note: 'Reference identifier or file path to detailed error log for this calculation run.']
  execution_duration_seconds varchar [note: 'Total elapsed time in seconds for the calculation run execution.']
  execution_end_timestamp timestamp [note: 'System timestamp when the calculation batch execution completed or failed.']
  execution_start_timestamp timestamp [note: 'System timestamp when the calculation batch execution began.']
  frequency varchar [note: 'Frequency interval at which this calculation type is executed.']
  gips_compliant_flag boolean [note: 'Indicates whether this calculation run adheres to GIPS compliance requirements for external reporting.']
  initiated_by_process varchar [note: 'Process type that initiated the calculation: scheduled batch, manual request, API trigger, restatement, or data correction.']
  initiated_by_user varchar [note: 'Username or system account that triggered the calculation run.']
  large_cash_flow_threshold_pct decimal(5,2) [note: 'Percentage threshold used to identify large cash flows requiring special treatment in TWR calculations, typically 5-10 percent of portfolio NAV.']
  notes varchar [note: 'Free-text notes or comments regarding this calculation run, including special circumstances, manual adjustments, or operational issues.']
  period_end_date date [note: 'Ending date of the measurement period for return calculations.']
  period_start_date date [note: 'Beginning date of the measurement period for return calculations.']
  portfolio_count varchar [note: 'Number of portfolios included in this calculation run batch.']
  publication_flag boolean [note: 'Indicates whether results from this run have been published to external stakeholders (beneficiaries, regulators, board).']
  publication_timestamp timestamp [note: 'Timestamp when the calculation results were published to external stakeholders.']
  record_created_timestamp timestamp [note: 'Timestamp when this calculation run record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this calculation run record was last modified.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this calculation run is used for regulatory reporting submissions to SEC, or other governing bodies.']
  restatement_flag boolean [note: 'Indicates whether this run is a restatement of previously published performance results.']
  restatement_reason varchar [note: 'Business justification for restatement if restatement_flag is true, such as data correction, valuation adjustment, or methodology change.']
  run_date date [note: 'Business date for which performance is being calculated, distinct from the execution timestamp.']
  run_identifier varchar [note: 'Human-readable business identifier for the calculation run, typically formatted as YYYYMMDD-HH24MISS or similar batch reference code.']
  valuation_date date [note: 'As-of date for portfolio valuations used in this calculation run, typically aligned with run date but may differ for restatements.']
  warning_count varchar [note: 'Number of warnings generated during calculation execution that did not prevent completion.']

  Note: 'Transactional record of each performance calculation batch execution, capturing run date, calculation type (daily NAV, month-end, quarter-end, GIPS annual), portfolios included, source system (SimCorp Dimension, eFront), calculation status (pending'
}

Table performance.significant_cash_flow {
  significant_cash_flow_id varchar [pk, note: 'Unique identifier for the significant cash flow record.']
  composite_id varchar [note: 'Reference to the GIPS composite from which the portfolio may be temporarily excluded due to this significant cash flow.']
  portfolio_id varchar [note: 'Reference to the portfolio experiencing the significant cash flow.']
  actual_impact_percent decimal(5,2) [note: 'The actual percentage impact of the cash flow on the portfolio NAV, calculated as cash flow amount divided by portfolio NAV before.']
  approval_status varchar [note: 'The approval status of the significant cash flow designation, indicating whether it has been reviewed and approved by performance measurement team.']
  approval_timestamp timestamp [note: 'The date and time when the significant cash flow designation was approved.']
  approved_by varchar [note: 'The name or identifier of the individual who approved the significant cash flow designation.']
  asset_class varchar [note: 'The primary asset class of the portfolio experiencing the significant cash flow.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the base currency in which the cash flow amount is denominated.']
  cash_flow_amount decimal(20,2) [note: 'The monetary value of the significant cash flow in base currency.']
  cash_flow_date date [note: 'The date on which the significant external cash flow occurred.']
  cash_flow_direction varchar [note: 'Indicates whether the cash flow is an inflow into the portfolio or an outflow from the portfolio.']
  cash_flow_type varchar [note: 'Classification of the cash flow event: contribution, distribution, capital call, redemption, transfer in, or transfer out.']
  counterparty_lei varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier for the counterparty involved in the cash flow.']
  counterparty_name varchar [note: 'The name of the counterparty or beneficiary associated with the cash flow transaction.']
  created_timestamp timestamp [note: 'The date and time when this significant cash flow record was first created in the lakehouse.']
  data_quality_flag boolean [note: 'Indicator of the data quality status for this significant cash flow record, such as verified, unverified, reconciled, or exception.']
  exclusion_end_date date [note: 'The date on which the portfolio is reinstated into the composite after the exclusion period ends.']
  exclusion_required_flag boolean [note: 'Indicates whether the portfolio must be temporarily excluded from the composite due to this significant cash flow per GIPS policy.']
  exclusion_start_date date [note: 'The date from which the portfolio is excluded from the composite due to the significant cash flow.']
  gips_compliant_flag boolean [note: 'Indicates whether the handling of this significant cash flow is compliant with GIPS standards and the firm\'s GIPS policy.']
  measurement_period_end_date date [note: 'The end date of the performance measurement period affected by the significant cash flow.']
  measurement_period_start_date date [note: 'The start date of the performance measurement period affected by the significant cash flow.']
  notes varchar [note: 'Additional free-text notes or comments regarding the significant cash flow event and its treatment.']
  override_reason varchar [note: 'Explanation for any manual override or exception to the standard significant cash flow treatment policy.']
  policy_version varchar [note: 'The version of the firm\'s significant cash flow policy that was applied to this record.']
  portfolio_nav_after decimal(20,2) [note: 'The portfolio NAV immediately after the significant cash flow occurred.']
  portfolio_nav_before decimal(20,2) [note: 'The portfolio NAV immediately before the significant cash flow occurred.']
  significance_threshold_percent decimal(5,2) [note: 'The percentage threshold used to determine whether a cash flow is significant, typically defined by the firm\'s GIPS policy.']
  source_system_timestamp timestamp [note: 'The timestamp when the cash flow record was created or last updated in the source system.']
  strategy_type varchar [note: 'The investment strategy type of the portfolio, such as growth, value, core, opportunistic, or distressed.']
  sub_period_calculation_required_flag boolean [note: 'Indicates whether sub-period return calculations are required to isolate the impact of the significant cash flow on performance measurement.']
  transaction_reference varchar [note: 'External reference number or identifier for the underlying transaction that triggered the significant cash flow.']
  updated_timestamp timestamp [note: 'The date and time when this significant cash flow record was last updated in the lakehouse.']

  Note: 'Transactional record identifying significant external cash flows that trigger portfolio exclusion from GIPS composites or require sub-period return calculations.'
}

Table performance.dispersion {
  dispersion_id varchar [pk, note: 'Unique identifier for the dispersion statistic record.']
  composite_id varchar [note: 'Reference to the GIPS composite for which dispersion is measured.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for composite performance comparison.']
  asset_class varchar [note: 'Primary asset class of the composite for which dispersion is measured.']
  asset_weighted_dispersion_flag boolean [note: 'Indicates whether the dispersion calculation is asset-weighted or equal-weighted.']
  base_currency_code varchar [note: 'ISO 4217 three-letter currency code in which dispersion is reported.']
  benchmark_return decimal(10,4) [note: 'Return of the benchmark index for the measurement period, used for relative dispersion context.']
  beneficiary_reporting_flag boolean [note: 'Indicates whether this dispersion statistic is included in beneficiary performance reporting.']
  calculation_status varchar [note: 'Current status of the dispersion calculation in the reporting workflow.']
  calculation_timestamp timestamp [note: 'Date and time when the dispersion statistic was calculated.']
  composite_aum_begin decimal(20,2) [note: 'Total assets under management in the composite at the start of the measurement period.']
  composite_aum_end decimal(20,2) [note: 'Total assets under management in the composite at the end of the measurement period.']
  composite_return decimal(10,4) [note: 'Asset-weighted return of the composite for the measurement period, used as reference for dispersion analysis.']
  data_quality_flag boolean [note: 'Indicator of data quality and completeness for the dispersion calculation.']
  geographic_region varchar [note: 'Geographic focus of the composite for which dispersion is measured.']
  gips_compliant_flag boolean [note: 'Indicates whether the dispersion calculation meets GIPS compliance requirements.']
  maximum_portfolio_return decimal(10,4) [note: 'Highest individual portfolio return within the composite for the measurement period.']
  mean_portfolio_return decimal(10,4) [note: 'Average return of all individual portfolios within the composite for the measurement period.']
  measure_type varchar [note: 'Statistical method used to calculate dispersion (e.g., standard deviation, range, interquartile range).']
  measurement_period_end_date date [note: 'End date of the annual period for which dispersion is calculated.']
  measurement_period_start_date date [note: 'Start date of the annual period for which dispersion is calculated.']
  median_portfolio_return decimal(10,4) [note: 'Median return of all individual portfolios within the composite for the measurement period.']
  minimum_portfolio_return decimal(10,4) [note: 'Lowest individual portfolio return within the composite for the measurement period.']
  notes varchar [note: 'Additional commentary or explanatory notes regarding the dispersion calculation or data quality issues.']
  percentage decimal(10,4) [note: 'Dispersion value expressed as a percentage for standardized reporting.']
  portfolio_count varchar [note: 'Number of individual portfolios included in the composite for the dispersion calculation.']
  record_created_timestamp timestamp [note: 'Date and time when this dispersion record was first created in the lakehouse.']
  record_updated_timestamp timestamp [note: 'Date and time when this dispersion record was last modified in the lakehouse.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this dispersion statistic is required for regulatory reporting to the national pension regulator or other governing bodies.']
  return_calculation_method varchar [note: 'Method used to calculate individual portfolio returns for dispersion analysis (e.g., TWR, MWR, IRR).']
  source_system_timestamp timestamp [note: 'Date and time when the dispersion record was created in the source system.']
  strategy_type varchar [note: 'Investment strategy classification of the composite (e.g., growth, value, core, opportunistic).']
  value decimal(18,6) [note: 'Calculated dispersion statistic value representing the spread of individual portfolio returns within the composite.']
  vintage_year varchar [note: 'Calendar year of the measurement period for dispersion reporting.']

  Note: 'Transactional record of internal dispersion statistics for each GIPS composite and annual period, measuring the spread of individual portfolio returns within the composite.'
}

Table performance.ldi_return {
  ldi_return_id varchar [pk, note: 'Unique identifier for the LDI return record. Primary key for the LDI return measurement.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: LDI return calculations depend on actuarial assumptions (discount rates, mortality tables).']
  composite_id varchar [note: 'Reference to the GIPS composite to which this LDI portfolio belongs for performance reporting purposes.']
  dv01_sensitivity_id varchar [note: 'Foreign key linking to risk.dv01_sensitivity. Business justification: LDI strategies require linking liability-matching returns to interest rate sensitivities.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: LDI portfolios are highly sensitive to interest rate and inflation scenarios. Pension funds must model liability-matching performance under different economic scenarios for ALM']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: LDI performance measurement requires linking to the specific liability projection being hedged.']
  nav_liability_id varchar [note: 'Foreign key linking to valuation.nav_liability. Business justification: LDI performance tracks funded ratio changes requiring liability valuations. Pension actuaries and investment teams must link LDI returns to specific liability valuations for funded']
  performance_benchmark_id varchar [note: 'Reference to the liability benchmark index used for comparison purposes in LDI performance measurement.']
  portfolio_id varchar [note: 'Reference to the LDI portfolio for which liability-relative performance is measured.']
  asset_return_amount decimal(20,2) [note: 'Absolute return on LDI portfolio assets during the measurement period, including income and capital appreciation.']
  asset_return_percent decimal(10,6) [note: 'Percentage return on LDI portfolio assets during the measurement period, expressed as a decimal.']
  asset_value_begin decimal(20,2) [note: 'Market value of LDI portfolio assets at the beginning of the measurement period.']
  asset_value_end decimal(20,2) [note: 'Market value of LDI portfolio assets at the end of the measurement period.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the base currency in which LDI returns are reported.']
  calculation_method varchar [note: 'Method used to calculate LDI returns, such as Time-Weighted Return (TWR), Money-Weighted Return (MWR), or Internal Rate of Return (IRR).']
  calculation_timestamp timestamp [note: 'Timestamp when the LDI return calculation was performed.']
  contribution_amount decimal(20,2) [note: 'Total contributions made to the LDI portfolio during the measurement period.']
  data_quality_flag boolean [note: 'Indicator of data quality status for the LDI return record.']
  discount_rate_begin decimal(10,6) [note: 'Discount rate used to calculate present value of liabilities at the beginning of the measurement period, expressed as a decimal.']
  discount_rate_change decimal(10,6) [note: 'Change in discount rate over the measurement period, expressed in basis points or decimal.']
  discount_rate_end decimal(10,6) [note: 'Discount rate used to calculate present value of liabilities at the end of the measurement period, expressed as a decimal.']
  distribution_amount decimal(20,2) [note: 'Total distributions paid from the LDI portfolio during the measurement period.']
  duration_mismatch decimal(10,4) [note: 'Difference between asset duration and liability duration at the end of the measurement period, expressed in years.']
  funded_ratio_begin decimal(10,6) [note: 'Ratio of asset value to liability value at the beginning of the measurement period, expressed as a decimal.']
  funded_ratio_change decimal(10,6) [note: 'Change in funded ratio over the measurement period, calculated as ending funded ratio minus beginning funded ratio.']
  funded_ratio_end decimal(10,6) [note: 'Ratio of asset value to liability value at the end of the measurement period, expressed as a decimal.']
  fx_gain_loss decimal(20,2) [note: 'Foreign exchange gains or losses on non-base currency holdings in the LDI portfolio during the measurement period.']
  gips_compliant_flag boolean [note: 'Indicates whether the LDI return calculation is compliant with GIPS standards.']
  hedging_effectiveness decimal(10,6) [note: 'Measure of how effectively the LDI portfolio hedged liability movements during the measurement period, expressed as a decimal.']
  hedging_ratio_begin decimal(10,6) [note: 'Ratio of hedged interest rate exposure to total liability duration at the beginning of the measurement period, expressed as a decimal.']
  hedging_ratio_end decimal(10,6) [note: 'Ratio of hedged interest rate exposure to total liability duration at the end of the measurement period, expressed as a decimal.']
  income_earned decimal(20,2) [note: 'Total income earned by the LDI portfolio during the measurement period, including interest and dividends.']
  liability_benchmark_return decimal(10,6) [note: 'Return of the liability benchmark index during the measurement period, expressed as a decimal.']
  liability_return_amount decimal(20,2) [note: 'Change in liability value driven by discount rate movements and actuarial assumptions during the measurement period.']
  liability_return_percent decimal(10,6) [note: 'Percentage change in liability value during the measurement period, expressed as a decimal.']
  liability_value_begin decimal(20,2) [note: 'Present value of pension liabilities at the beginning of the measurement period, discounted using the applicable discount rate.']
  liability_value_end decimal(20,2) [note: 'Present value of pension liabilities at the end of the measurement period, discounted using the applicable discount rate.']
  measurement_period_end_date date [note: 'End date of the performance measurement period for the LDI return calculation.']
  measurement_period_start_date date [note: 'Start date of the performance measurement period for the LDI return calculation.']
  net_cash_flow decimal(20,2) [note: 'Net contributions minus distributions for the LDI portfolio during the measurement period.']
  notes varchar [note: 'Free-text notes or comments regarding the LDI return calculation, including any adjustments or special circumstances.']
  period_type varchar [note: 'Type of measurement period for the LDI return calculation.']
  realized_gain_loss decimal(20,2) [note: 'Realized gains or losses from asset sales in the LDI portfolio during the measurement period.']
  record_created_timestamp timestamp [note: 'Timestamp when this LDI return record was first created in the system.']
  surplus_return_amount decimal(20,2) [note: 'Absolute change in surplus (assets minus liabilities) during the measurement period.']
  surplus_return_percent decimal(10,6) [note: 'Percentage return on surplus during the measurement period, expressed as a decimal.']
  tracking_error decimal(10,6) [note: 'Standard deviation of the difference between asset returns and liability returns, measuring hedging precision.']
  unrealized_gain_loss decimal(20,2) [note: 'Unrealized gains or losses from mark-to-market valuation changes in the LDI portfolio during the measurement period.']
  valuation_source varchar [note: 'Source system or vendor providing valuation data for the LDI return calculation.']
  var_95 decimal(20,2) [note: 'Value at Risk at 95 percent confidence level for the LDI portfolio surplus, representing potential loss in adverse scenarios.']

  Note: 'Transactional record of liability-relative performance for the fund\'s LDI (Liability-Driven Investment) portfolios. Captures funded ratio change, liability return (discount rate-driven), asset return, surplus return, hedging ratio effectiveness, and'
}

Table performance.notice {
  notice_id varchar [pk, note: 'Unique identifier for the performance notice record.']
  approved_by_user_employee_id varchar [note: 'Reference to the senior investment officer or committee member who approved issuance of this performance notice.']
  employee_id varchar [note: 'Reference to the internal user or investment team member who issued this performance notice.']
  gp_profile_id varchar [note: 'Reference to the external manager receiving this performance notice.']
  limit_breach_id varchar [note: 'Foreign key linking to risk.limit_breach. Business justification: Performance notices (tracking error warnings, underperformance alerts) are issued when risk limits are breached.']
  manager_mandate_id varchar [note: 'Reference to the external manager mandate that triggered this performance notice.']
  performance_benchmark_id varchar [note: 'Reference to the benchmark index used for performance comparison in this notice.']
  portfolio_id varchar [note: 'Reference to the portfolio under management that is subject to this performance notice.']
  rule_breach_id varchar [note: 'Foreign key linking to compliance.rule_breach. Business justification: Performance notices for mandate breaches (tracking error, underperformance) trigger compliance rule breaches.']
  acknowledgement_date date [note: 'Date on which the external manager formally acknowledged receipt of the performance notice.']
  asset_class varchar [note: 'Primary asset class of the portfolio subject to this performance notice, such as public equities, fixed income, private equity, real estate, infrastructure, or natural resources.']
  aum_at_notice_date decimal(20,2) [note: 'Total assets under management in the portfolio at the time the performance notice was issued, in base currency.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the base reporting currency for all monetary values in this notice.']
  benchmark_return decimal(18,6) [note: 'Benchmark return over the measurement period against which the portfolio performance is evaluated, expressed as a decimal percentage.']
  breach_description varchar [note: 'Detailed narrative description of the specific performance breach or underperformance condition that triggered the notice.']
  escalation_level varchar [note: 'Current escalation level of the performance notice within the governance hierarchy, from manager review to board-level oversight.']
  excess_return decimal(18,6) [note: 'Portfolio return minus benchmark return, representing the value added or lost by the external manager over the measurement period.']
  geographic_region varchar [note: 'Primary geographic investment region or mandate scope, such as North America, Europe, Asia-Pacific, Emerging Markets, or Global.']
  gips_compliant_flag boolean [note: 'Indicates whether the performance calculations underlying this notice were performed in compliance with GIPS standards.']
  information_ratio decimal(18,6) [note: 'Ratio of excess return to tracking error, measuring the risk-adjusted value added by the external manager.']
  internal_review_notes varchar [note: 'Confidential internal notes and commentary from the investment team regarding the performance notice, manager response, and recommended actions.']
  issue_date date [note: 'Date on which the performance notice was formally issued to the external manager.']
  manager_response_summary varchar [note: 'Summary of the external managers formal response to the performance notice, including key points from their remediation plan or explanation.']
  mandate_termination_flag boolean [note: 'Indicates whether this performance notice resulted in termination of the external manager mandate.']
  measurement_period_end_date date [note: 'End date of the rolling performance measurement period that triggered the notice.']
  measurement_period_months varchar [note: 'Duration in months of the rolling performance measurement period, typically 12, 24, or 36 months per mandate agreement.']
  measurement_period_start_date date [note: 'Start date of the rolling performance measurement period that triggered the notice.']
  notice_status varchar [note: 'Current lifecycle status of the performance notice in the remediation and resolution workflow. [ENUM-REF-CANDIDATE: draft|issued|acknowledged|under_review|remediation_in_progress|resolved|escalated|mandate_terminated — 8 candidates stripped; promote to']
  notice_type varchar [note: 'Classification of the performance notice based on the nature of the breach or underperformance trigger.']
  number varchar [note: 'Externally-known unique business identifier for this performance notice, used in formal communications with external managers.']
  portfolio_return decimal(18,6) [note: 'Actual portfolio return achieved by the external manager over the measurement period, expressed as a decimal percentage.']
  record_created_timestamp timestamp [note: 'Timestamp when this performance notice record was first created in the lakehouse.']
  record_updated_timestamp timestamp [note: 'Timestamp when this performance notice record was last modified in the lakehouse.']
  remediation_deadline_date date [note: 'Date by which the external manager must submit their remediation plan or corrective action response.']
  remediation_required_flag boolean [note: 'Indicates whether the external manager is required to submit a formal remediation plan in response to this notice.']
  resolution_date date [note: 'Date on which the performance notice was formally resolved or closed, indicating satisfactory remediation or mandate termination.']
  response_received_date date [note: 'Date on which the external managers formal response or remediation plan was received.']
  source_system_timestamp timestamp [note: 'Timestamp when the notice record was created or last updated in the source system.']
  strategy_type varchar [note: 'Investment strategy classification of the mandate, such as active equity, passive index, long-short, value, growth, or core-plus fixed income.']
  threshold_return decimal(18,6) [note: 'Minimum acceptable excess return threshold defined in the mandate agreement, breach of which triggers a performance notice.']
  tracking_error_actual decimal(18,6) [note: 'Actual tracking error measured over the period, representing the standard deviation of excess returns.']
  tracking_error_limit decimal(18,6) [note: 'Maximum allowable tracking error defined in the mandate agreement, breach of which may trigger a performance notice.']

  Note: 'Transactional record of formal performance notices issued to external managers when their mandate performance falls below agreed thresholds (e.g., underperformance vs. benchmark over rolling 3-year period, breach of tracking error band).'
}

Table performance.performance_exception {
  performance_exception_id varchar [pk, note: 'Globally unique identifier for a performance exception record.']
  actor_id varchar [note: 'Identifier of the affected entity.']
  event_composite_id varchar [note: 'Identifier of the composite affected by the exception.']
  event_portfolio_id varchar [note: 'Identifier of the portfolio affected by the exception.']
  performance_calculation_run_id varchar [note: 'Identifier of the performance calculation run during which the exception occurred.']
  event_affected_entity_name varchar [note: 'Human-readable name of the affected entity.']
  event_affected_entity_type varchar [note: 'Type of entity affected by the exception.']
  event_category varchar [note: 'Broad category of the exception event.']
  event_created_by varchar [note: 'Identifier of the user or process that created the record.']
  event_created_timestamp timestamp [note: 'Timestamp when the exception record was created in the data lake.']
  event_exception_code varchar [note: 'Alphanumeric code representing the exception type.']
  event_exception_description varchar [note: 'Detailed description of the exception event.']
  event_exception_type varchar [note: 'Specific type of exception, e.g., price missing or valuation error.']
  event_impact_description varchar [note: 'Description of the impact caused by the exception.']
  event_impact_level varchar [note: 'Level of impact of the exception on performance.']
  event_measurement_period_end_date date [note: 'End date of the measurement period for which the exception was identified.']
  event_measurement_period_start_date date [note: 'Start date of the measurement period for which the exception was identified.']
  event_notes varchar [note: 'Free-text notes or comments about the exception.']
  event_payload_or_value decimal(18,2) [note: 'Raw payload or value associated with the exception, often JSON or descriptive text.']
  event_priority varchar [note: 'Priority assigned to the exception for resolution.']
  event_reference varchar [note: 'External reference or correlation ID for the exception.']
  event_resolved_by varchar [note: 'Identifier of the user or system that resolved the exception.']
  event_resolved_flag boolean [note: 'Flag indicating whether the exception has been resolved.']
  event_resolved_timestamp timestamp [note: 'Timestamp when the exception was resolved.']
  event_severity varchar [note: 'Severity level of the exception event.']
  event_source varchar [note: 'Source of the exception event, e.g., system or process.']
  event_source_reference varchar [note: 'Identifier of the source record that generated the exception.']
  event_source_system varchar [note: 'Name of the system that generated the exception. [ENUM-REF-CANDIDATE: SimCorp Dimension|BlackRock Aladdin|Bloomberg Terminal|State Street|eFront|DealCloud|MSCI|Charles River|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]']
  event_source_timestamp timestamp [note: 'Timestamp of the event in the source system.']
  event_status varchar [note: 'Current status of the exception record.']
  event_threshold_value decimal(18,4) [note: 'Threshold value used to determine exception severity.']
  event_timestamp timestamp [note: 'Timestamp when the exception event was recorded.']
  event_type_or_channel varchar [note: 'Category of the exception event, e.g., price missing or FX rate stale.']
  event_updated_by varchar [note: 'Identifier of the user or process that last updated the record.']
  event_updated_timestamp timestamp [note: 'Timestamp when the exception record was last updated.']
  event_variance_amount decimal(18,4) [note: 'Monetary variance amount that triggered the exception.']
  event_variance_percent decimal(5,2) [note: 'Percentage variance that triggered the exception.']

  Note: 'Transactional record of performance data-quality exceptions and reconciliation breaks raised during a performance_calculation_run — e.g., PBOR-vs-ABOR market value variance beyond tolerance, missing security price, stale FX rate, negative or outlier TWR'
}

Table performance.scenario_application {
  scenario_application_id varchar [pk, note: 'Primary key for the scenario_application association']
  composite_id varchar [note: 'Foreign key linking to the GIPS-compliant composite being stress tested under this scenario']
  economic_scenario_id varchar [note: 'Foreign key linking to the macroeconomic scenario applied to the composite']
  calculation_status varchar [note: 'Current status of the stress test calculation for this composite-scenario combination, indicating whether results are draft, pending IC review, approved, or superseded by newer analysis.']
  effective_date date [note: 'Date from which this scenario-composite pairing is effective for stress testing and ALM modeling purposes.']
  weight_percentage decimal(5,4) [note: 'Probability weighting assigned to this scenario for this specific composite, used in expected return calculations and scenario-weighted performance analysis. Different composites may weight the same scenario differently based on strategy relevance.']

  Note: 'This association product represents the application of economic scenarios to GIPS-compliant composites for stress testing, ALM modeling, and Investment Committee presentations.'
}

Table performance.active_return_attribution {
  active_return_attribution_id varchar [pk, note: 'Surrogate primary key for the active return attribution table.']
  attribution_model_id varchar [note: 'Reference to performance.attribution_model.attribution_model_id.']
  factor_id varchar [note: 'Reference to risk.factor.factor_id.']
  portfolio_id varchar [note: 'Reference to portfolio.portfolio.portfolio_id.']
  factor_return_bps decimal(18,4) [note: 'The factor return bps of the active return attribution.']
  period_end_date date [note: 'Period end date of the active return attribution.']
  period_start_date date [note: 'Period start date of the active return attribution.']
  sector_allocation_return_bps decimal(18,4) [note: 'The sector allocation return bps of the active return attribution.']
  sector_name varchar [note: 'The sector name of the active return attribution.']
  security_selection_return_bps decimal(18,4) [note: 'The security selection return bps of the active return attribution.']

  Note: 'Barra-style decomposition of active return; one row per portfolio, sector, factor and period.'
}

Table actuarial.liability_projection {
  liability_projection_id varchar [pk, note: 'Unique identifier for the actuarial liability projection record.']
  assumption_set_id varchar [note: 'Reference to the comprehensive set of actuarial assumptions used in this projection, enabling traceability and scenario comparison.']
  contributor_pool_id varchar [note: 'Reference to the beneficiary contributor pool (one per participating plan) for which this liability projection is calculated.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Liability projections must be stress-tested under multiple economic scenarios per regulatory requirements (e.g., PRA).']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: ALM analysis timing: Liability projections must reference specific valuation cycles to ensure asset-liability matching uses synchronized measurement dates.']
  abo_amount decimal(20,2) [note: 'The actuarial present value of pension benefits earned to date based on current salary levels, without projection of future salary increases.']
  actuarial_gain_loss decimal(20,2) [note: 'The change in the PBO resulting from differences between actual experience and actuarial assumptions, or from changes in assumptions themselves.']
  actuary_firm varchar [note: 'The actuarial consulting firm that prepared the liability projection, if applicable.']
  actuary_name varchar [note: 'The name of the qualified actuary responsible for preparing and certifying the liability projection.']
  amortization_period_years varchar [note: 'The number of years over which unfunded actuarial liabilities or surpluses are amortized through contribution adjustments.']
  benefits_paid decimal(20,2) [note: 'The total pension benefits paid to retirees and beneficiaries during the projection period, reducing the liability.']
  cash_flow_year_1 decimal(20,2) [note: 'Projected net benefit cash flow for year 1 of the projection horizon, used for liquidity planning and ALM.']
  cash_flow_year_10 decimal(20,2) [note: 'Projected net benefit cash flow for year 10 of the projection horizon, used for long-term liquidity planning.']
  cash_flow_year_20 decimal(20,2) [note: 'Projected net benefit cash flow for year 20 of the projection horizon, used for extended-term liquidity planning.']
  cash_flow_year_30 decimal(20,2) [note: 'Projected net benefit cash flow for year 30 of the projection horizon, used for ultra-long-term liquidity planning.']
  cash_flow_year_5 decimal(20,2) [note: 'Projected net benefit cash flow for year 5 of the projection horizon, used for medium-term liquidity planning.']
  certification_date date [note: 'The date on which the actuary certified the liability projection as complete and accurate.']
  comments varchar [note: 'Free-text field for actuarial notes, qualifications, or explanations regarding the projection methodology or results.']
  contribution_rate_required decimal(8,5) [note: 'The actuarially determined contribution rate required from employers and members to fund the projected benefit obligation over time.']
  convexity decimal(10,4) [note: 'The measure of the curvature in the relationship between liability values and discount rates, used for advanced ALM risk management.']
  created_timestamp timestamp [note: 'The timestamp when this liability projection record was first created in the system.']
  disability_rate decimal(8,5) [note: 'The assumed annual rate at which active members become disabled and eligible for disability benefits.']
  discount_rate decimal(8,5) [note: 'The rate used to discount future benefit payments to present value, typically based on high-quality corporate bond yields or government bond yields for long-duration liabilities.']
  funded_ratio decimal(8,5) [note: 'The ratio of plan assets to the projected benefit obligation, expressed as a percentage, a key solvency and health metric for the pension fund.']
  funded_status_amount decimal(20,2) [note: 'The difference between plan assets and the projected benefit obligation, indicating surplus or deficit position.']
  inflation_rate decimal(8,5) [note: 'The assumed annual inflation rate used to project cost-of-living adjustments and indexation of pension benefits.']
  interest_cost decimal(20,2) [note: 'The increase in the projected benefit obligation due to the passage of time, calculated by applying the discount rate to the beginning PBO.']
  is_active boolean [note: 'Indicates whether this liability projection is the current active version for the contributor pool and valuation date.']
  liability_duration_years decimal(8,2) [note: 'The weighted average duration of the liability cash flows, a key metric for Liability-Driven Investment (LDI) and duration matching strategies.']
  model_version varchar [note: 'The version identifier of the actuarial projection model used to generate this liability projection, supporting model governance and audit trails.']
  mortality_improvement_scale varchar [note: 'The scale used to project future improvements in mortality rates over time, such as CPM-B or MP-2021.']
  mortality_table varchar [note: 'The mortality table used to estimate life expectancy and the duration of benefit payments, such as RP-2014 or Pri-2012.']
  normal_cost_rate decimal(8,5) [note: 'The portion of the contribution rate attributable to benefits earned in the current year, excluding amortization of past service costs.']
  pbo_amount decimal(20,2) [note: 'The actuarial present value of all future pension benefits earned to date, incorporating projected future salary increases and service credits.']
  projection_horizon_years varchar [note: 'The number of years into the future for which cash flows and liabilities are projected, typically ranging from 30 to 75 years for pension funds.']
  projection_scenario varchar [note: 'The scenario type under which the liability projection is modeled, supporting Asset-Liability Management (ALM) stress testing and Strategic Asset Allocation (SAA) planning.']
  regulatory_filing_date date [note: 'The date on which the liability projection was filed with the regulatory authority.']
  regulatory_filing_status varchar [note: 'The status of the liability projection in the regulatory filing process with the national pension regulator or other pension regulators.']
  retirement_age_assumption decimal(5,2) [note: 'The average assumed retirement age for active members, used to project the timing of benefit commencement.']
  salary_growth_rate decimal(8,5) [note: 'The assumed annual rate of salary increase used to project future benefit obligations for active members.']
  service_cost decimal(20,2) [note: 'The present value of pension benefits earned by active members during the current period, a key component of pension expense.']
  turnover_rate decimal(8,5) [note: 'The assumed annual rate at which active members leave employment before retirement, affecting the projected benefit obligation.']
  updated_by varchar [note: 'The user or system identifier that last modified this liability projection record.']
  updated_timestamp timestamp [note: 'The timestamp when this liability projection record was last modified.']
  valuation_date date [note: 'The as-of date for which the actuarial liability projection is calculated, typically aligned with fiscal year-end or interim valuation dates.']
  created_by varchar [note: 'The user or system identifier that created this liability projection record.']

  Note: 'Core master record of actuarial liability projections for each contributor pool (one per participating plan). Captures projected benefit obligation (PBO), accumulated benefit obligation (ABO), projected cash flows by year'
}

Table actuarial.actuarial_valuation {
  actuarial_valuation_id varchar [pk, note: 'Unique identifier for the actuarial valuation record.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Actuarial valuation uses a specific assumption set; FK provides reference and removes duplicate assumption_set_code.']
  cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Regulatory consistency: Actuarial valuations must use asset values from specific valuation cycles.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Valuations are prepared for specific regulatory authorities (the national pension regulator for federally regulated plans, state regulators for public plans).']
  active_member_count varchar [note: 'The total number of active contributing members included in the actuarial valuation as of the valuation date.']
  actuary_designation varchar [note: 'The professional designation of the lead actuary, such as Fellow of the Society of Actuaries (FSA).']
  actuary_firm_name varchar [note: 'The name of the actuarial consulting firm that performed the valuation.']
  amortization_period_years varchar [note: 'The number of years over which any unfunded liability or deficit is scheduled to be amortized through special payments.']
  asset_valuation_method varchar [note: 'The method used to value plan assets for funding purposes, indicating whether market value, smoothed value, or fair value was applied.']
  average_active_member_age decimal(4,1) [note: 'The average age of active contributing members as of the valuation date, used for demographic analysis and liability projection.']
  average_pensioner_age decimal(4,1) [note: 'The average age of retired members receiving pension benefits as of the valuation date.']
  completion_date date [note: 'The date on which the actuarial valuation report was finalized and signed by the actuary.']
  created_timestamp timestamp [note: 'The timestamp when this actuarial valuation record was first created in the system.']
  deferred_member_count varchar [note: 'The total number of deferred vested members (former employees with preserved benefits) included in the actuarial valuation as of the valuation date.']
  employer_contribution_rate decimal(5,4) [note: 'The recommended employer contribution rate as a percentage of pensionable payroll, derived from the actuarial valuation to fund ongoing benefit accruals and amortize any deficit.']
  filing_date date [note: 'The date on which the actuarial valuation was filed with the regulatory authority.']
  going_concern_discount_rate decimal(5,4) [note: 'The discount rate used to calculate the present value of future benefit payments on a going concern basis, typically based on expected long-term investment returns.']
  going_concern_funded_ratio decimal(5,4) [note: 'The ratio of plan assets to going concern liabilities, expressed as a decimal. A value of 1.0000 indicates 100 percent funded status.']
  going_concern_liability decimal(20,2) [note: 'The present value of all accrued pension benefits calculated on a going concern basis, assuming the plan continues to operate indefinitely.']
  going_concern_surplus_deficit decimal(20,2) [note: 'The difference between plan assets and going concern liabilities, indicating the funded status on a going concern basis. Positive values represent surplus; negative values represent deficit.']
  inflation_assumption decimal(5,4) [note: 'The assumed long-term rate of inflation used in the actuarial valuation for projecting salary increases, benefit indexation, and cost-of-living adjustments.']
  lead_actuary_name varchar [note: 'The name of the lead actuary who signed and is responsible for the valuation report.']
  liability_duration_years decimal(5,2) [note: 'The duration of the pension liabilities expressed in years, representing the weighted average time until benefit payments are made. Critical for Asset-Liability Management (ALM) and Liability-Driven Investment (LDI) strategies.']
  member_contribution_rate decimal(5,4) [note: 'The member contribution rate as a percentage of pensionable payroll, representing the portion of pension funding contributed by plan members.']
  mortality_improvement_scale varchar [note: 'The mortality improvement scale applied to the base mortality table to reflect expected future improvements in longevity, such as CPM-B or Scale MP-2021.']
  mortality_table varchar [note: 'The mortality table used in the valuation to estimate life expectancy and the duration of benefit payments, such as RP-2014 or Pri-2012.']
  next_required_valuation_date date [note: 'The regulatory deadline date by which the next actuarial valuation must be performed.']
  normal_cost_rate decimal(5,4) [note: 'The normal cost expressed as a percentage of pensionable payroll, representing the annual cost of benefits accruing in the current year.']
  reference_number varchar [note: 'External business reference number assigned to this actuarial valuation for reporting and audit purposes.']
  report_document_path varchar [note: 'The file path or document management system reference to the full actuarial valuation report.']
  retired_member_count varchar [note: 'The total number of retired members currently receiving pension benefits included in the actuarial valuation as of the valuation date.']
  retirement_age_assumption decimal(4,1) [note: 'The assumed average or normal retirement age used in the valuation for projecting when active members will commence pension benefits.']
  salary_increase_assumption decimal(5,4) [note: 'The assumed long-term rate of salary increases used to project future pensionable earnings for active members.']
  solvency_discount_rate decimal(5,4) [note: 'The discount rate used to calculate the present value of future benefit payments on a solvency basis, typically based on current annuity purchase rates or high-quality corporate bond yields.']
  solvency_funded_ratio decimal(5,4) [note: 'The ratio of plan assets to solvency liabilities, expressed as a decimal. A value of 1.0000 indicates 100 percent funded status on a solvency basis.']
  solvency_liability decimal(20,2) [note: 'The present value of all accrued pension benefits calculated on a solvency basis, representing the cost to settle all obligations if the plan were to wind up on the valuation date.']
  solvency_surplus_deficit decimal(20,2) [note: 'The difference between plan assets and solvency liabilities, indicating the funded status on a solvency basis. Positive values represent surplus; negative values represent deficit.']
  special_payment_amount decimal(20,2) [note: 'The total amount of special payments required to amortize any going concern or solvency deficit over the regulatory amortization period.']
  total_member_count varchar [note: 'The total number of all plan members (active, deferred, and retired) included in the actuarial valuation as of the valuation date.']
  total_plan_assets_market_value decimal(20,2) [note: 'The total market value of all pension plan assets as of the valuation date, representing the investment portfolio available to meet future obligations.']
  total_plan_assets_smoothed_value decimal(20,2) [note: 'The smoothed or actuarial value of plan assets, which may differ from market value due to asset smoothing techniques used to reduce volatility in funding calculations.']
  updated_timestamp timestamp [note: 'The timestamp when this actuarial valuation record was last modified in the system.']
  valuation_date date [note: 'The as-of date for which the actuarial valuation was performed, representing the snapshot date for all assets, liabilities, and assumptions.']
  valuation_method varchar [note: 'The actuarial cost method used in the valuation, such as Projected Unit Credit, Entry Age Normal, or Aggregate Cost Method.']
  valuation_status varchar [note: 'Current lifecycle status of the actuarial valuation indicating its approval and filing state.']
  valuation_type varchar [note: 'Classification of the actuarial valuation indicating whether it is a full triennial statutory valuation, interim update, special purpose, wind-up, or transfer valuation.']
  wind_up_liability decimal(20,2) [note: 'The estimated cost to fully settle all pension obligations through annuity purchases or lump-sum payments if the plan were terminated on the valuation date.']

  Note: 'Formal actuarial valuation record representing a full triennial or interim valuation of the pension fund AND the authoritative funded-status-at-date snapshot derived from it.'
}

Table actuarial.alm_model {
  alm_model_id varchar [pk, note: 'Unique identifier for the ALM model configuration record.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Pension fund ALM models must incorporate climate scenarios for TCFD-compliant stress testing and long-term liability projections.']
  created_by_user_employee_id varchar [note: 'Reference to the user or system account that created this ALM model configuration record.']
  discount_rate_curve_id varchar [note: 'Reference to the discount rate curve used for present value calculations of future liability cash flows in this ALM model.']
  employee_id varchar [note: 'Reference to the actuarial team member or investment professional responsible for maintaining and governing this ALM model configuration.']
  fund_id varchar [note: 'Foreign key linking to privateequity.fund. Business justification: ALM model requires reference to private equity fund to incorporate its NAV into asset allocation and liability matching.']
  performance_benchmark_id varchar [note: 'Reference to the actuarial liability benchmark or liability profile used as the target for asset matching in this ALM model.']
  updated_by_user_employee_id varchar [note: 'Reference to the user or system account that last modified this ALM model configuration record.']
  approval_date date [note: 'Date on which the ALM model configuration was formally approved by the Investment Committee or actuarial governance body for production use.']
  asset_universe_scope varchar [note: 'Description of the asset classes and investment universe included in the ALM model for portfolio construction and optimization, such as public equities, fixed income, real estate, infrastructure, private equity, and natural resources.']
  back_testing_frequency varchar [note: 'Frequency at which the ALM model predictions are back-tested against actual portfolio and liability outcomes to validate model accuracy and calibration.']
  benefit_payment_pattern varchar [note: 'Expected pattern of future benefit payments over time used in the ALM model: level for constant payments, increasing for growing obligations, decreasing for declining obligations, or custom for complex patterns.']
  computational_runtime_minutes varchar [note: 'Typical runtime in minutes required to execute a full ALM model run including all scenarios and optimizations, used for capacity planning and scheduling.']
  confidence_interval_level decimal(5,4) [note: 'Statistical confidence level used for reporting ALM model results and risk metrics, typically 0.9500 for 95 percent confidence or 0.9900 for 99 percent confidence.']
  contribution_rate_assumption decimal(8,5) [note: 'Assumed annual contribution rate as a percentage of payroll or fixed amount used in the ALM model for projecting future cash inflows from plan sponsors and members.']
  created_timestamp timestamp [note: 'Timestamp when this ALM model configuration record was first created in the system.']
  currency_hedging_policy varchar [note: 'Foreign exchange hedging strategy applied in the ALM model for managing currency risk on international investments relative to the liability currency.']
  duration_matching_strategy varchar [note: 'Strategy employed in the ALM model to align the duration of assets with the duration of liabilities to minimize interest rate risk exposure.']
  effective_from_date date [note: 'Date from which this ALM model configuration becomes active and is used for asset allocation decisions and liability matching analysis.']
  effective_to_date date [note: 'Date on which this ALM model configuration ceases to be active, nullable for models that remain in use indefinitely.']
  esg_integration_approach varchar [note: 'Approach to incorporating ESG factors into the ALM model asset selection and portfolio construction: exclusion screening, best-in-class selection, thematic investing, impact investing, ESG integration, active engagement, or none.']
  inflation_assumption_rate decimal(8,5) [note: 'Long-term inflation rate assumption used in the ALM model for indexing pension benefits and projecting real returns, expressed as a decimal proportion.']
  is_active boolean [note: 'Indicates whether this ALM model configuration is currently active and available for use in asset allocation and liability matching analysis.']
  last_calibration_date date [note: 'Date on which the ALM model parameters and assumptions were last recalibrated or updated based on current market conditions and actuarial experience.']
  liquidity_constraint_pct decimal(5,4) [note: 'Minimum percentage of portfolio assets that must be maintained in liquid form to meet near-term benefit payment obligations, expressed as a decimal proportion.']
  model_code varchar [note: 'Short alphanumeric code used as a unique business identifier for the ALM model in reports and system integrations.']
  model_complexity_rating varchar [note: 'Qualitative assessment of the ALM model computational and conceptual complexity, used for governance oversight and resource allocation.']
  model_documentation_url varchar [note: 'URL or file path to the comprehensive technical documentation describing the ALM model methodology, assumptions, and validation results.']
  model_name varchar [note: 'Business name assigned to this ALM model configuration for identification and reference by actuarial and investment teams.']
  model_notes varchar [note: 'Free-text field for additional notes, assumptions, limitations, or special considerations related to this ALM model configuration.']
  model_status varchar [note: 'Current lifecycle status of the ALM model configuration indicating whether it is in development, under governance review, approved for use, actively deployed, deprecated for future use, or archived.']
  model_type varchar [note: 'Classification of the ALM modeling approach used: deterministic for single-path projections, stochastic for probabilistic simulations, scenario-based for defined economic scenarios, hybrid for combined approaches, monte_carlo for random sampling, or']
  model_version varchar [note: 'Version number of the ALM model configuration following semantic versioning convention to track model evolution and changes.']
  mortality_assumption_table varchar [note: 'Name or identifier of the mortality table used in the ALM model for projecting longevity risk and future benefit payments, such as RP-2014 or Pri-2012.']
  next_review_date date [note: 'Scheduled date for the next formal review and validation of the ALM model configuration by the actuarial team and Investment Committee.']
  optimization_objective varchar [note: 'Primary objective function that the ALM model optimizes, such as maximizing surplus, minimizing contribution volatility, maximizing risk-adjusted return, or minimizing funded status volatility.']
  projection_horizon_years varchar [note: 'Number of years into the future that the ALM model projects asset and liability cash flows, typically aligned with the duration of pension obligations.']
  rebalancing_frequency varchar [note: 'Frequency at which the ALM model assumes portfolio rebalancing to maintain target asset allocation and duration matching.']
  regulatory_compliance_flag boolean [note: 'Indicates whether this ALM model configuration meets all applicable regulatory requirements and has been validated for compliance reporting purposes.']
  risk_tolerance_level varchar [note: 'Risk appetite classification that governs the ALM model asset allocation constraints and volatility tolerance in pursuit of return objectives.']
  scenario_count varchar [note: 'Number of economic scenarios or simulation paths generated by the ALM model for stochastic or scenario-based analysis.']
  software_platform varchar [note: 'Name and version of the software platform or actuarial system used to implement and execute this ALM model, such as Aladdin, SimCorp, or proprietary in-house systems.']
  stress_test_scenarios varchar [note: 'Comma-separated list or description of macroeconomic stress test scenarios applied in the ALM model, such as interest rate shocks, equity market crashes, inflation spikes, or credit spread widening.']
  target_funded_ratio decimal(8,5) [note: 'Target ratio of plan assets to actuarial liabilities that the ALM model aims to achieve or maintain, expressed as a decimal proportion where 1.00 represents 100 percent funded status.']
  updated_timestamp timestamp [note: 'Timestamp when this ALM model configuration record was last modified, used for audit trail and change tracking.']
  var_calculation_method varchar [note: 'Methodology used within the ALM model to calculate Value at Risk for portfolio risk assessment: historical simulation, parametric variance-covariance, Monte Carlo simulation, Cornish-Fisher expansion, or not applicable if VaR is not calculated.']
  version_effective_timestamp timestamp [note: 'Timestamp marking when this specific version of the ALM model configuration became effective, supporting temporal versioning and historical analysis.']

  Note: 'Master record for each Asset-Liability Management (ALM) model configuration maintained by the actuarial team. Captures model name, model version, model type (deterministic, stochastic, scenario-based), liability benchmark used, asset universe in scope'
}

Table actuarial.alm_scenario {
  alm_scenario_id varchar [pk, note: 'Unique identifier for the ALM scenario run. Primary key.']
  alm_model_id varchar [note: 'Reference to the ALM model configuration used for this scenario run.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: ALM scenarios use specific actuarial assumptions. While individual assumption values are captured on the scenario, linking to assumption_set provides the authoritative source and']
  created_by_user_employee_id varchar [note: 'Identifier of the analyst or system user who initiated this scenario run.']
  discount_rate_curve_id varchar [note: 'Foreign key linking to actuarial.discount_rate_curve. Business justification: ALM scenarios use specific discount rate curves for liability valuation. This links the scenario to the curve used, enabling analysis of scenario results by discount curve']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: ALM scenario analysis requires economic scenario inputs for stress testing funded ratios.']
  employee_id varchar [note: 'Identifier of the user or Investment Committee member who approved this scenario for official use.']
  risk_stress_scenario_id varchar [note: 'Foreign key linking to risk.stress_scenario. Business justification: ALM scenarios should reference standardized risk stress scenarios for integrated stress testing. Ensures actuarial and risk teams apply consistent shocks.']
  approval_timestamp timestamp [note: 'Date and time when this scenario was formally approved for reporting or decision-making purposes.']
  asset_duration_years decimal(6,2) [note: 'Macaulay or modified duration of the asset portfolio under this scenario, measured in years.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts reported in this scenario.']
  benefit_indexation_percent decimal(5,2) [note: 'Annual percentage increase applied to pension benefits in payment to reflect cost-of-living adjustments.']
  comments varchar [note: 'Free-text field for analyst notes, observations, or special considerations related to this scenario run.']
  completion_timestamp timestamp [note: 'Date and time when the scenario run finished processing, whether successfully or with errors.']
  contribution_rate_assumption_percent decimal(5,2) [note: 'Assumed employer and employee contribution rate as percentage of pensionable earnings for this scenario.']
  convergence_tolerance decimal(10,8) [note: 'Numerical tolerance threshold used to determine convergence of iterative ALM calculations.']
  created_timestamp timestamp [note: 'Date and time when this scenario record was first created in the system.']
  credit_spread_shock_bps varchar [note: 'Basis point adjustment applied to credit spreads across fixed income and credit portfolios in this scenario.']
  cvar_95_amount decimal(18,2) [note: 'Conditional Value at Risk (expected shortfall) at 95% confidence level for this scenario, in base currency.']
  discount_rate_percent decimal(6,4) [note: 'Discount rate applied to liability cash flows for present value calculation in this scenario.']
  duration_gap_years decimal(6,2) [note: 'Difference between asset duration and liability duration, indicating interest rate risk mismatch.']
  equity_return_assumption_percent decimal(5,2) [note: 'Assumed annual equity market return percentage used in this scenario for public equity asset class projections.']
  execution_timestamp timestamp [note: 'Date and time when the scenario run was initiated by the ALM system or analyst.']
  funded_ratio_result_percent decimal(6,2) [note: 'Calculated funded status ratio (assets divided by liabilities) resulting from this scenario run.']
  fx_shock_percent decimal(5,2) [note: 'Percentage change applied to foreign exchange rates for multi-currency portfolio stress testing.']
  inflation_shock_percent decimal(5,2) [note: 'Percentage point adjustment applied to baseline inflation assumptions for this scenario.']
  infrastructure_return_assumption_percent decimal(5,2) [note: 'Assumed annual return percentage for infrastructure asset class in this scenario projection.']
  interest_rate_shock_bps varchar [note: 'Parallel shift applied to the yield curve in basis points (positive for upward shock, negative for downward shock).']
  is_baseline boolean [note: 'Flag indicating whether this scenario represents the baseline or central case for comparison purposes.']
  last_modified_timestamp timestamp [note: 'Date and time when this scenario record was last updated or modified.']
  liability_duration_years decimal(6,2) [note: 'Macaulay or modified duration of the pension liability cash flows under this scenario, measured in years.']
  longevity_shock_years decimal(4,2) [note: 'Number of years added to life expectancy assumptions to stress-test longevity risk impact on pension liabilities.']
  model_version_used varchar [note: 'Specific version of the ALM model configuration used for this run, captured for auditability and reproducibility']
  mortality_assumption_adjustment_percent decimal(5,2) [note: 'Percentage adjustment to baseline mortality tables used for liability projections in this scenario.']
  output_metrics varchar [note: 'JSON or structured text containing key output metrics from this scenario run, such as projected funded ratio, surplus/deficit, VaR, and duration gap under this scenario']
  private_equity_return_assumption_percent decimal(5,2) [note: 'Assumed annual return percentage for private equity asset class in this scenario projection.']
  projection_horizon_years varchar [note: 'Number of years into the future that this scenario projects asset and liability cash flows.']
  real_estate_return_assumption_percent decimal(5,2) [note: 'Assumed annual return percentage for real estate asset class in this scenario projection.']
  regulatory_framework varchar [note: 'Regulatory or accounting framework under which this scenario was executed (IFRS, FASB, Solvency II, Basel III, Local GAAP).']
  run_date date [note: 'Date on which this ALM model was executed against this economic scenario']
  salary_growth_assumption_percent decimal(5,2) [note: 'Assumed annual salary escalation rate for active members used in liability projections.']
  scenario_description varchar [note: 'Detailed narrative description of the scenario assumptions, purpose, and business context for this run.']
  scenario_name varchar [note: 'Business-friendly name assigned to this scenario run for identification and reporting purposes.']
  scenario_run_reference varchar [note: 'Unique identifier for this ALM scenario run record']
  scenario_status varchar [note: 'Current execution status of the scenario run within its lifecycle.']
  scenario_type varchar [note: 'Classification of the scenario methodology: base case, stress test, reverse stress, stochastic path, deterministic projection, or regulatory-mandated scenario.']
  scenario_version varchar [note: 'Version number of this scenario run, incremented when scenarios are re-run with updated assumptions.']
  stochastic_path_count varchar [note: 'Number of Monte Carlo simulation paths executed for stochastic scenario types.']
  surplus_deficit_amount decimal(18,2) [note: 'Net surplus or deficit amount (assets minus liabilities) calculated in this scenario, in base currency.']
  valuation_date date [note: 'As-of date for asset and liability valuations used as the starting point for this scenario projection.']
  var_95_amount decimal(18,2) [note: 'Value at Risk at 95% confidence level calculated for the portfolio under this scenario, in base currency.']
  weight decimal(5,4) [note: 'Probability weight assigned to this scenario for this specific ALM model run, used in expected value calculations. May differ from the scenario\'s default probability_weight based on model-specific assumptions.']

  Note: 'Transactional record of each ALM scenario run executed against an ALM model. Captures scenario name, scenario type (base case, stress, reverse stress, stochastic path), interest rate shock applied, inflation shock, equity return assumption, credit spread'
}

Table actuarial.discount_rate_curve {
  discount_rate_curve_id varchar [pk, note: 'Unique identifier for the discount rate curve record. Primary key.']
  approval_date date [note: 'The date on which this discount rate curve was formally approved by the actuarial or investment committee for use in liability valuation.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved this discount rate curve for operational use.']
  benchmark_index varchar [note: 'The market benchmark index or reference rate used as the foundation for constructing this curve, such as government bond yields or swap rates.']
  calculation_methodology_document varchar [note: 'Reference to the internal or external document that describes the detailed methodology and assumptions used to construct this discount rate curve.']
  comments varchar [note: 'Free-text field for additional notes, assumptions, or context regarding the construction or application of this discount rate curve.']
  convergence_tenor_years varchar [note: 'The tenor in years at which the curve converges to the ultimate forward rate in extrapolation methodologies such as Smith-Wilson.']
  created_timestamp timestamp [note: 'The date and time when this discount rate curve record was first created in the system.']
  credit_quality_rating varchar [note: 'The minimum credit quality or rating category of the bonds used to construct the curve, relevant for IAS 19 high-quality corporate bond curves.']
  credit_spread_adjustment_bps decimal(8,2) [note: 'The credit spread adjustment in basis points applied to the base curve to reflect credit risk or regulatory requirements.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code indicating the currency denomination of the discount rates in this curve.']
  curve_construction_date date [note: 'The date on which this discount rate curve was constructed or calibrated using market data.']
  curve_name varchar [note: 'Business name or label assigned to this discount rate curve for identification and reference purposes.']
  curve_status varchar [note: 'Current lifecycle status of the discount rate curve indicating whether it is active for use, superseded by a newer curve, in draft, or archived.']
  curve_type varchar [note: 'Classification of the discount rate curve methodology. Indicates the source or construction approach for the curve such as regulator-prescribed, IAS 19 corporate bond yield, risk-free rate, or custom blend.']
  curve_version varchar [note: 'Version identifier for this discount rate curve, used to track revisions and updates over time.']
  data_source_reference varchar [note: 'Reference identifier or URL pointing to the specific market data source or dataset used to construct this curve.']
  effective_date date [note: 'The date from which this discount rate curve becomes applicable for liability valuation and actuarial calculations.']
  expiry_date date [note: 'The date on which this discount rate curve ceases to be valid or is superseded by a new curve. Nullable for currently active curves.']
  extrapolation_method varchar [note: 'The method used to extend the curve beyond the longest explicitly defined tenor for long-duration liability matching.']
  interpolation_method varchar [note: 'The mathematical interpolation technique applied to derive rates between explicitly defined tenors on the curve.']
  jurisdiction varchar [note: 'Three-letter ISO country code representing the legal or regulatory jurisdiction for which this curve is applicable.']
  last_modified_timestamp timestamp [note: 'The date and time when this discount rate curve record was last updated or modified.']
  liquid_point_tenor_years varchar [note: 'The maximum tenor in years up to which market data is considered sufficiently liquid and reliable for direct curve construction.']
  liquidity_premium_bps decimal(8,2) [note: 'The liquidity premium in basis points added to the curve to compensate for illiquidity in the underlying bond market.']
  matching_adjustment_bps decimal(8,2) [note: 'The matching adjustment in basis points applied when assets and liabilities are closely matched, reducing discount rate volatility under certain regulatory regimes.']
  maximum_tenor_years varchar [note: 'The longest maturity tenor in years for which a discount rate is explicitly defined or extrapolated in this curve.']
  minimum_tenor_years varchar [note: 'The shortest maturity tenor in years for which a discount rate is explicitly defined in this curve.']
  modified_by varchar [note: 'Identifier of the user or system process that last modified this discount rate curve record.']
  regulatory_framework varchar [note: 'The regulatory or accounting standard under which this curve is constructed and applied, such as IFRS, IAS 19, actuarial standards of practice, or the national pension regulator guidelines. [ENUM-REF-CANDIDATE: ifrs|ias19|fasb|eiopa|local_gaap — promote to reference product]']
  source_data_provider varchar [note: 'The external vendor or internal system that supplied the underlying market data used to construct this curve, such as Bloomberg, Refinitiv, or internal treasury.']
  tenor_increment_years decimal(5,2) [note: 'The standard interval in years between successive tenor points on the curve, such as 0.5 for semi-annual or 1.0 for annual.']
  term_structure_type varchar [note: 'Indicates the rate convention used in the term structure: spot rates, forward rates, par yields, or zero-coupon rates.']
  ultimate_forward_rate decimal(10,6) [note: 'The long-term forward rate assumption used for extrapolation beyond the liquid point of the curve, expressed as a decimal rate.']
  usage_scope varchar [note: 'Description of the intended use cases for this curve, such as financial reporting, regulatory reporting, internal ALM, or strategic asset allocation. [ENUM-REF-CANDIDATE: financial_reporting|regulatory_reporting|alm|saa|stress_testing|internal_valuation —']
  valuation_date date [note: 'The as-of date for which this discount rate curve is used to value pension liabilities in actuarial reports and financial statements.']
  volatility_adjustment_bps decimal(8,2) [note: 'The volatility adjustment in basis points applied under certain regulatory frameworks to dampen the impact of short-term market volatility on liability valuations.']

  Note: 'Master record for each discount rate curve used to value pension liabilities. Captures curve name, curve type (regulator-prescribed, IAS 19 corporate bond yield, risk-free, custom blend), effective date, currency, term structure (spot rates by tenor from 1Y to'
}

Table actuarial.mortality_table {
  mortality_table_id varchar [pk, note: 'Unique identifier for the mortality table record. Primary key.']
  primary_predecessor_table_mortality_table_id varchar [note: 'Reference to the previous mortality table that this table supersedes or replaces.']
  accounting_standard_alignment varchar [note: 'Accounting standard or framework the mortality table is aligned with (e.g., IFRS, ASPE, US GAAP).']
  adjustment_factor decimal(10,6) [note: 'Scalar adjustment factor applied to base mortality rates to reflect plan-specific or population-specific experience (e.g., 0.95 for 5% mortality reduction).']
  age_range_maximum varchar [note: 'Maximum age (in years) for which mortality rates are defined in the table.']
  age_range_minimum varchar [note: 'Minimum age (in years) for which mortality rates are defined in the table.']
  base_year varchar [note: 'Reference year for which the mortality rates in the table are calibrated or anchored.']
  blend_percentage decimal(5,2) [note: 'Percentage weighting used when blending multiple mortality tables to create a custom table (expressed as percentage, e.g., 75.00 for 75%).']
  collar_adjustment_type varchar [note: 'Indicates whether the table includes adjustments for white-collar, blue-collar, or mixed workforce mortality experience.']
  created_timestamp timestamp [note: 'Timestamp when the mortality table record was first created in the system.']
  credibility_weighting decimal(5,4) [note: 'Credibility weight assigned to plan-specific experience versus standard table rates (0.0 to 1.0, where 1.0 is full credibility).']
  data_source_description varchar [note: 'Detailed description of the data sources, experience studies, or research used to develop the mortality table.']
  disabled_mortality_flag boolean [note: 'Indicates whether the table is designed for disabled or ill-health populations with higher mortality rates.']
  documentation_reference varchar [note: 'Reference to external documentation, research papers, or technical reports describing the mortality table in detail.']
  effective_date date [note: 'Date from which the mortality table is effective and applicable for actuarial liability calculations.']
  expiry_date date [note: 'Date on which the mortality table is no longer valid or has been superseded by a newer table.']
  gender_applicability varchar [note: 'Indicates whether the mortality table applies to male, female, unisex, or combined populations.']
  generational_projection_flag boolean [note: 'Indicates whether the table supports generational mortality projections based on year of birth cohorts.']
  geographic_scope varchar [note: 'Geographic region or jurisdiction for which the mortality table is applicable (e.g., United States, United Kingdom, Netherlands).']
  healthy_annuitant_flag boolean [note: 'Indicates whether the table is designed for healthy annuitants (as opposed to disabled or ill-health populations).']
  improvement_scale_flag boolean [note: 'Indicates whether the table includes mortality improvement factors for generational projections.']
  internal_approval_date date [note: 'Date on which the mortality table was approved for use by the internal Investment Committee (IC) or actuarial governance body.']
  last_review_date date [note: 'Date of the most recent actuarial review or validation of the mortality table for continued appropriateness.']
  longevity_risk_adjustment decimal(10,6) [note: 'Additional adjustment factor applied to account for longevity risk or uncertainty in future mortality improvements.']
  methodology_notes varchar [note: 'Technical notes describing the actuarial methodology, smoothing techniques, or statistical models used to construct the table.']
  modified_timestamp timestamp [note: 'Timestamp when the mortality table record was last modified or updated.']
  mortality_basis varchar [note: 'Underlying data source or experience study used to construct the mortality table (e.g., pension plan experience, population census data).']
  next_review_date date [note: 'Scheduled date for the next actuarial review or reassessment of the mortality table.']
  population_segment varchar [note: 'Specific population segment or cohort the mortality table is designed for (e.g., public sector employees, private sector, annuitants, pensioners).']
  publication_year varchar [note: 'Year the mortality table was officially published or released by the source organization.']
  regulatory_approval_date date [note: 'Date on which the mortality table received regulatory approval for statutory use.']
  regulatory_approval_status varchar [note: 'Current regulatory approval status of the mortality table for use in statutory actuarial valuations.']
  source_organization varchar [note: 'Organization or body that published or developed the mortality table (e.g., Society of Actuaries, custom internal).']
  table_code varchar [note: 'Short alphanumeric code or identifier for the mortality table used in actuarial systems and calculations.']
  table_name varchar [note: 'Official name of the mortality table or improvement scale (e.g., RP-2014, Pri-2012, S3PMA).']
  table_type varchar [note: 'Classification of the mortality table indicating its purpose and application method in liability calculations.']
  usage_status varchar [note: 'Current usage status of the mortality table within the organizations actuarial valuation processes.']
  valuation_purpose varchar [note: 'Primary purpose for which the mortality table is used (e.g., going concern valuation, solvency valuation, accounting valuation, funding valuation).']
  version_number varchar [note: 'Version identifier for the mortality table, used to track revisions and updates over time.']

  Note: 'Master record for each mortality table or improvement scale used in actuarial liability calculations. Captures table name, table type (base mortality, improvement scale, generational projection), source (RP-2014, Pri-2012, custom blend)'
}

Table actuarial.assumption_set {
  assumption_set_id varchar [pk, note: 'Unique surrogate key for each actuarial assumption set.']
  capital_market_assumption_id varchar [note: 'Foreign key linking to research.capital_market_assumption. Business justification: Actuarial assumption sets require capital market assumptions for expected returns on plan assets.']
  credit_yield_curve_id varchar [note: 'Reference to the risk‑free rate curve used for discounting.']
  discount_rate_curve_id varchar [note: 'Reference to the discount rate curve used for present‑value calculations.']
  mortality_table_id varchar [note: 'Reference to the mortality table applied in the liability projection.']
  asset_liability_duration decimal(10,2) [note: 'Weighted average duration of assets versus liabilities, expressed in years.']
  assumption_set_code varchar [note: 'Business identifier or short code used in reporting and downstream systems.']
  assumption_set_description varchar [note: 'Free‑form description of the purpose, scope, and key characteristics of the assumption set.']
  assumption_set_name varchar [note: 'Human‑readable name identifying the set of actuarial assumptions.']
  assumption_set_status varchar [note: 'Current lifecycle status of the assumption set.']
  contribution_rate decimal(5,4) [note: 'Assumed annual contribution rate as a proportion of payroll.']
  created_by_role varchar [note: 'Role of the user or system that created the record.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the system.']
  currency varchar [note: 'ISO 4217 currency code for monetary assumptions.']
  effective_date date [note: 'Date on which the assumptions become effective for liability valuation.']
  expiration_date date [note: 'Optional date when the assumption set ceases to be valid; null for open‑ended sets.']
  funded_status_percent decimal(5,2) [note: 'Current funded status expressed as a percentage of total liability.']
  inflation_rate decimal(5,4) [note: 'Annual inflation rate applied to cash‑flow projections (e.g., 0.0250 = 2.5%).']
  is_default boolean [note: 'Indicates whether this set is the default for new liability runs.']
  last_review_date date [note: 'Date when the assumption set was last reviewed by actuarial governance.']
  ldi_strategy varchar [note: 'Strategic approach used to align assets with liabilities.']
  liability_projection_years varchar [note: 'Number of years forward the liability cash‑flow model projects.']
  review_cycle_months varchar [note: 'Standard interval in months between mandatory reviews of the assumption set.']
  updated_by varchar [note: 'User identifier of the person or system that performed the last update.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the record.']
  version varchar [note: 'Integer version number incremented each time the set is revised.']
  created_by varchar [note: 'User identifier of the person or system that created the assumption set.']

  Note: 'Master record defining a complete, versioned, effective-dated set of actuarial assumptions used in a liability valuation or ALM run. Captures assumption set name, effective date, discount_rate_curve reference, mortality_table reference, inflation rate'
}

Table actuarial.funded_status {
  funded_status_id varchar [pk, note: 'Unique identifier for the funded status record.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Funded status calculations use specific actuarial assumptions. Linking to assumption_set replaces the denormalized assumption_version string with a proper FK to the authoritative']
  fund_id varchar [note: 'Identifier of the pension fund to which this measurement applies.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Funded status calculations compare assets to liabilities. This links to the specific liability projection used in the funded ratio calculation.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Funded ratio reporting: Funded status calculations require reconciliation between actuarial asset values and investment portfolio valuations.']
  asset_market_value decimal(20,4) [note: 'Aggregate market value of all assets held by the fund at the measurement date.']
  asset_to_liability_ratio decimal(6,4) [note: 'Ratio of asset market value to liability on a solvency basis, expressed as a decimal.']
  created_timestamp timestamp [note: 'Timestamp when the funded status record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the reporting currency for monetary amounts.']
  discount_rate decimal(6,4) [note: 'Interest rate used to discount future cash‑flows in the actuarial liability calculation.']
  funded_ratio decimal(6,4) [note: 'Ratio of total asset market value to total actuarial liability (gross), expressed as a decimal.']
  liability_gross decimal(20,4) [note: 'Total actuarial liability on a going‑concern basis, expressed in the reporting currency.']
  liability_solvent decimal(20,4) [note: 'Total actuarial liability on a solvency basis, expressed in the reporting currency.']
  measurement_status varchar [note: 'Current status of the measurement, indicating whether it is preliminary, final, or adjusted.']
  measurement_timestamp timestamp [note: 'Exact date and time when the funded status measurement was taken.']
  notes varchar [note: 'Free‑form field for any supplemental information or comments about the measurement.']
  scenario varchar [note: 'Scenario under which the funded status was calculated, such as base case or stress scenario.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the funded status record.']

  Note: 'Transactional record capturing the funded status of the pension fund at a specific measurement date. Captures measurement date, total actuarial liability (going-concern and solvency bases), total market value of assets, funded ratio (assets/liabilities)'
}

Table actuarial.contribution_rate_model {
  contribution_rate_model_id varchar [pk, note: 'System-generated unique identifier for the contribution rate model.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Contribution rate models depend on actuarial assumptions for calculating required contribution rates. This links the model to its governing assumption set.']
  contributor_pool_id varchar [note: 'Identifier of the contributor pool (e.g., one of the participating plans) to which the model applies.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Contribution rates are calculated based on liability projections. This links the contribution model to the specific liability projection driving the rate calculation.']
  applicable_region varchar [note: 'Three‑letter ISO country code indicating the jurisdiction of the model.']
  approval_date date [note: 'Date when the model received regulatory approval.']
  comments varchar [note: 'Free‑form notes or remarks about the model.']
  contribution_rate_model_status varchar [note: 'Current lifecycle status of the model.']
  created_timestamp timestamp [note: 'Timestamp when the contribution rate model record was created.']
  effective_date date [note: 'Date on which the contribution rate model becomes effective.']
  employee_normal_cost_rate decimal(10,4) [note: 'Employee contribution rate expressed as a percentage of payroll.']
  employer_normal_cost_rate decimal(10,4) [note: 'Employer contribution rate expressed as a percentage of payroll (e.g., 0.0750 = 7.50%).']
  expiration_date date [note: 'Date on which the contribution rate model expires or is superseded; null for open‑ended models.']
  frequency varchar [note: 'Frequency at which contributions are applied.']
  is_default boolean [note: 'Flag indicating whether this model is the default for its contributor pool.']
  last_review_date date [note: 'Date of the most recent actuarial review of the model.']
  model_code varchar [note: 'Business code used to reference the model in actuarial and investment systems.']
  model_name varchar [note: 'Human‑readable name of the contribution rate model.']
  model_type varchar [note: 'Classification of the model (e.g., statutory, voluntary, special).']
  rate_basis varchar [note: 'Basis on which the contribution rates are calculated.']
  regulatory_approval_status varchar [note: 'Status of regulatory approval (e.g., the national pension regulator) for the model.']
  special_contribution_rate decimal(10,4) [note: 'Additional contribution rate applied under special circumstances (e.g., catch‑up contributions).']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the model record.']
  version_number varchar [note: 'Incremental version identifier for change management.']

  Note: 'Master record for each contribution rate model defining the required employer and employee contribution rates for a contributor pool. Captures model name, contributor pool, effective date, normal cost rate (employer), normal cost rate (employee), special'
}

Table actuarial.special_payment_schedule {
  special_payment_schedule_id varchar [pk, note: 'Unique surrogate identifier for the special payment schedule record.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Special payment schedules address funding deficits identified in liability projections.']
  amortization_period_years varchar [note: 'Number of years over which the deficiency will be amortized.']
  approval_date date [note: 'Date on which the schedule received formal approval.']
  created_timestamp timestamp [note: 'Timestamp when the schedule record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 currency identifier for monetary amounts.']
  deficiency_type varchar [note: 'Classification of the underlying deficiency that the schedule is designed to amortize.']
  discount_rate decimal(5,4) [note: 'Rate used to discount future payments to present value for reporting.']
  effective_from date [note: 'Date on which the special payment schedule becomes effective.']
  effective_until date [note: 'Date on which the special payment schedule terminates or is superseded; null for open‑ended schedules.']
  interest_rate decimal(5,4) [note: 'Annual interest rate applied to the deficiency balance for amortization calculations.']
  is_taxable boolean [note: 'Indicates whether the amortization payments are subject to tax.']
  last_review_date date [note: 'Date of the most recent internal review of the schedule.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the schedule record.']
  net_present_value decimal(20,2) [note: 'Present value of all scheduled payments using the discount rate.']
  next_review_date date [note: 'Planned date for the next scheduled review of the schedule.']
  notes varchar [note: 'Supplementary free‑text notes captured by actuaries or governance.']
  payment_amount decimal(20,2) [note: 'Calculated monetary amount of each scheduled amortization payment.']
  payment_frequency varchar [note: 'Regular interval at which amortization payments are scheduled.']
  regulatory_approval_date date [note: 'Date on which regulatory approval was granted.']
  regulatory_approval_status varchar [note: 'Status of the schedule\'s approval by relevant regulators (e.g., the national pension regulator).']
  schedule_code varchar [note: 'Alphanumeric code used to uniquely reference the special payment schedule in external systems.']
  schedule_name varchar [note: 'Human‑readable name of the special payment schedule.']
  special_payment_schedule_description varchar [note: 'Free‑form description providing context and rationale for the schedule.']
  special_payment_schedule_status varchar [note: 'Current lifecycle status of the special payment schedule.']
  tax_rate decimal(5,4) [note: 'Applicable tax rate applied to each payment when taxable.']
  total_deficiency_amount decimal(20,2) [note: 'Monetary amount of the solvency or going‑concern deficiency to be amortized.']
  version_number varchar [note: 'Incremental version identifier for change management of the schedule.']

  Note: 'Master record for each special payment (deficit amortization payment) schedule established to eliminate a solvency or going-concern deficiency. Captures schedule name, deficiency type (solvency, going-concern), total deficiency amount, amortization period'
}

Table actuarial.ldi_strategy {
  ldi_strategy_id varchar [pk, note: 'System-generated unique identifier for the LDI strategy record.']
  assumption_set_id varchar [note: 'Reference to the inflation assumption set used for liability growth forecasts.']
  discount_rate_curve_id varchar [note: 'Reference to the discount rate curve used for present‑value calculations.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: LDI strategies must be validated against economic scenarios to ensure hedge effectiveness under different rate/inflation environments.']
  inflation_assumption_assumption_set_id varchar [note: 'Reference to the inflation assumption set used for liability growth forecasts.']
  mortality_table_id varchar [note: 'Reference to the mortality table applied in actuarial projections.']
  netting_agreement_id varchar [note: 'Foreign key linking to collateral.netting_agreement. Business justification: LDI strategies execute derivative hedges governed by netting agreements that determine close-out netting rights and collateral terms.']
  approval_date date [note: 'Date on which the strategy received formal approval.']
  approved_by varchar [note: 'Name of the investment committee member or senior officer who approved the strategy.']
  created_timestamp timestamp [note: 'Timestamp when the strategy record was first created in the system.']
  currency varchar [note: 'Three‑letter ISO 4217 code of the currency used for strategy amounts.']
  duration_target_years decimal(5,2) [note: 'Target portfolio duration in years to match liability duration.']
  effective_end_date date [note: 'Date on which the strategy is scheduled to expire or be retired; null for open‑ended.']
  effective_start_date date [note: 'Date on which the strategy becomes effective for portfolio implementation.']
  funded_ratio_target decimal(5,2) [note: 'Desired funded status (assets / liabilities) expressed as a percentage.']
  governance_approval_status varchar [note: 'Current approval state of the strategy by the investment committee.']
  hedge_ratio_target decimal(5,2) [note: 'Desired percentage of liability cash‑flows hedged by assets, expressed in percent.']
  interest_rate_hedge_type varchar [note: 'Method used to hedge interest‑rate exposure.']
  last_review_date date [note: 'Date of the most recent formal review of the strategy.']
  ldi_strategy_description varchar [note: 'Detailed free‑text description of the strategy purpose, methodology and scope.']
  ldi_strategy_status varchar [note: 'Current lifecycle status of the strategy.']
  liability_hedge_method varchar [note: 'Approach used to match liabilities (duration matching, cash‑flow matching, or hybrid).']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the strategy record.']
  next_review_date date [note: 'Planned date for the next scheduled review of the strategy.']
  risk_tolerance_level varchar [note: 'Qualitative risk appetite assigned to the strategy.']
  strategy_code varchar [note: 'Short alphanumeric code used to reference the strategy in systems and reports.']
  strategy_name varchar [note: 'Human‑readable name of the LDI strategy as defined by the actuarial team.']
  strategy_type varchar [note: 'Classification of the strategy based on hedge approach.']
  stress_test_scenario varchar [note: 'Selected macro‑economic stress scenario for strategy robustness testing.']
  target_allocation_alternative_pct decimal(5,2) [note: 'Desired allocation to alternatives (private equity, real estate, infrastructure, etc.) as a percentage.']
  target_allocation_cash_pct decimal(5,2) [note: 'Desired cash or cash‑equivalent allocation as a percentage of total assets.']
  target_allocation_equity_pct decimal(5,2) [note: 'Desired equity exposure as a percentage of total assets.']
  target_allocation_fixed_income_pct decimal(5,2) [note: 'Desired fixed‑income exposure as a percentage of total assets.']

  Note: 'Master record for each Liability-Driven Investment (LDI) strategy defined by the actuarial and investment teams. Captures strategy name, strategy type (full hedge, partial hedge, dynamic de-risking), liability hedge ratio target, interest rate hedge'
}

Table actuarial.ldi_hedge_position {
  ldi_hedge_position_id varchar [pk, note: 'System-generated unique identifier for the LDI hedge position record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: LDI hedge positions represent derivative hedges (interest rate swaps, inflation swaps) executed with specific counterparties.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: LDI hedge positions implement liability hedges using specific financial instruments (interest rate swaps, inflation-linked bonds).']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: LDI hedge positions implement specific LDI strategies. This links the transactional hedge position to its governing actuarial LDI strategy definition.']
  manager_gp_profile_id varchar [note: 'Identifier of the portfolio manager responsible for the hedge position.']
  st_instrument_transaction_id varchar [note: 'External business identifier assigned to the hedge position transaction.']
  strategy_id varchar [note: 'Reference to the investment strategy for which the hedge is held.']
  comments varchar [note: 'Free‑form notes or remarks about the hedge position.']
  created_timestamp timestamp [note: 'Timestamp when the hedge position record was first created in the system.']
  dv01_unit varchar [note: 'Unit used for DV01 values (basis points).']
  effective_from date [note: 'Start date when the hedge position became effective.']
  effective_until date [note: 'End date when the hedge position expires or is terminated (nullable).']
  hedge_currency_code varchar [note: 'Three‑letter ISO currency code of the hedge notional.']
  hedge_notional_amount decimal(20,4) [note: 'Nominal amount of the hedge expressed in the hedge currency.']
  hedge_portfolio_dv01 decimal(20,6) [note: 'Dollar value of a one‑basis‑point change in the hedge portfolio\'s interest rate exposure.']
  is_hedge_active boolean [note: 'Indicates whether the hedge position is currently active.']
  last_valuation_timestamp timestamp [note: 'Timestamp of the most recent valuation run for the hedge position.']
  ldi_hedge_position_status varchar [note: 'Current lifecycle status of the hedge position.']
  liability_dv01 decimal(20,6) [note: 'Dollar value of a one‑basis‑point change in the liability curve.']
  measurement_timestamp timestamp [note: 'Date and time when the hedge position measurement was taken.']
  risk_factor varchar [note: 'Key risk factor driving the hedge (e.g., interest rate).']
  scenario_code varchar [note: 'Identifier of the economic/actuarial scenario applied to the hedge measurement.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the hedge position record.']
  valuation_method varchar [note: 'Methodology used to value the hedge position.']

  Note: 'Transactional record capturing the current LDI hedge position for a given strategy and measurement date. Captures strategy reference, measurement date, nominal hedge notional, interest rate DV01 of liabilities, interest rate DV01 of hedge portfolio'
}

Table actuarial.liability_cash_flow {
  liability_cash_flow_id varchar [pk, note: 'Unique identifier for the liability cash flow projection record.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Liability cash flows use specific actuarial assumptions. Linking to assumption_set replaces the denormalized assumptions_version string with a proper FK to the authoritative']
  contributor_pool_id varchar [note: 'Identifier of the contributor pool (e.g., one of the participating plans).']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Liability cash flows are disaggregated projections derived from a parent liability projection.']
  actuary_firm varchar [note: 'Firm of the actuary responsible.']
  actuary_name varchar [note: 'Name of the actuary responsible for the projection.']
  audit_trail_reference varchar [note: 'Identifier linking to audit trail records for this projection.']
  cash_flow_amount decimal(20,4) [note: 'Projected liability cash flow amount for the period.']
  cash_flow_year varchar [note: 'Fiscal year of the cash flow (e.g., 2025).']
  created_timestamp timestamp [note: 'Timestamp when the projection record was created.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code of the cash flow amount.']
  disability_rate_used decimal(5,4) [note: 'Assumed disability incidence rate used.']
  discount_rate_used decimal(5,4) [note: 'Discount rate applied to present value the cash flow.']
  funding_status varchar [note: 'Funding status of the liability at projection date.']
  inflation_rate_used decimal(5,4) [note: 'Assumed inflation rate for the projection period.']
  liability_cash_flow_status varchar [note: 'Current lifecycle status of the cash flow projection.']
  liability_type varchar [note: 'Type of liability component represented by the cash flow.']
  model_version varchar [note: 'Version of the actuarial model used for the projection.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent modification to the record.']
  mortality_improvement_scale_used varchar [note: 'Identifier of the mortality improvement scale applied.']
  mortality_table_used varchar [note: 'Identifier of the mortality table applied in the projection.']
  notes varchar [note: 'Free-text notes or comments regarding the projection.']
  projection_date date [note: 'Date for which the liability cash flow is projected.']
  projection_horizon_years varchar [note: 'Number of years forward the projection covers.']
  projection_scenario varchar [note: 'Scenario used for the projection (e.g., base, stress).']
  regulatory_approval_date date [note: 'Date when regulatory approval was granted.']
  regulatory_approval_status varchar [note: 'Regulatory filing status of the projection.']
  retirement_age_assumption varchar [note: 'Assumed retirement age used in the projection.']
  salary_growth_rate_used decimal(5,4) [note: 'Assumed salary growth rate used in the projection.']
  segment_type varchar [note: 'Category of members for which the cash flow is projected.']
  turnover_rate_used decimal(5,4) [note: 'Assumed employee turnover rate for the projection.']

  Note: 'Transactional record of disaggregated projected liability by contributor pool, segment, and year, derived from the actuarial liability projection. Captures projection date, contributor pool, segment type (active, deferred, retiree, survivor), projection'
}

Table actuarial.saa_constraint {
  saa_constraint_id varchar [pk, note: 'Unique system-generated identifier for the SAA constraint record.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: SAA constraints are actuarially-derived limits on asset allocation. This links the constraint to the assumption set used in deriving the constraint, ensuring consistency with']
  created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: SAA constraints govern asset allocation limits; investment policy governance requires documenting constraint creator. created_by is text, need proper FK.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: SAA constraint applies to a specific LDI strategy; FK provides reference and removes duplicate ldi_strategy_id if present.']
  applies_to_asset_class varchar [note: 'Asset class to which the constraint is applied.']
  applies_to_geography varchar [note: 'Geographic scope for which the constraint is relevant.']
  compliance_flag boolean [note: 'True if the constraint satisfies a specific regulatory requirement.']
  constraint_category varchar [note: 'High‑level grouping of the constraint purpose.']
  constraint_type varchar [note: 'Category of the constraint defining the business rule applied to the strategic asset allocation.']
  created_timestamp timestamp [note: 'Date‑time when the constraint record was first created in the system.']
  data_quality_score decimal(5,2) [note: 'Numeric score (0‑100) reflecting the confidence in the underlying data supporting the constraint.']
  effective_from date [note: 'Date on which the constraint becomes binding.']
  effective_until date [note: 'Date on which the constraint expires or is superseded; null for open‑ended.']
  is_mandatory boolean [note: 'Indicates whether the constraint must be enforced in all allocation models.']
  last_review_date date [note: 'Date of the most recent formal review of the constraint.']
  last_updated_by varchar [note: 'User identifier of the person who performed the most recent update.']
  measurement_unit varchar [note: 'Unit of measure for the measurement_value field.']
  measurement_value decimal(20,6) [note: 'Numeric value representing the constraint magnitude (e.g., % allocation, years duration).']
  modified_timestamp timestamp [note: 'Date‑time of the most recent update to the constraint record.']
  notes varchar [note: 'Free‑form field for any supplemental information or comments.']
  regulatory_reference varchar [note: 'Identifier of the regulatory rule or guideline that drives the constraint (e.g., REG-1234).']
  review_status varchar [note: 'Outcome of the latest review process for the constraint.']
  risk_weight decimal(10,4) [note: 'Weighting factor used in risk‑adjusted allocation calculations.']
  saa_constraint_code varchar [note: 'Unique alphanumeric code used to reference the constraint in systems and reports.']
  saa_constraint_description varchar [note: 'Detailed free‑text description of the business rationale and application of the constraint.']
  saa_constraint_name varchar [note: 'Human‑readable name describing the constraint.']
  saa_constraint_status varchar [note: 'Current lifecycle status of the constraint.']
  scenario_name varchar [note: 'Name of the economic or market scenario under which the constraint is evaluated.']
  threshold_max decimal(20,6) [note: 'Upper bound value for the constraint when a range is defined.']
  threshold_min decimal(20,6) [note: 'Lower bound value for the constraint when a range is defined.']
  version_number varchar [note: 'Incremental version of the constraint record for change tracking.']
  created_by varchar [note: 'User identifier of the person who initially created the constraint.']

  Note: 'Master record defining actuarially-derived constraints on the Strategic Asset Allocation (SAA) imposed by liability characteristics. Captures constraint name, constraint type (minimum duration, maximum equity allocation, minimum real asset allocation'
}

Table actuarial.experience_study {
  experience_study_id varchar [pk, note: 'System-generated unique identifier for the actuarial experience study.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Experience study uses a specific assumption set; FK provides reference and removes duplicate assumption_set_version and mortality_table_used columns.']
  mortality_table_id varchar [note: 'Foreign key linking to actuarial.mortality_table. Business justification: Experience studies compare actual mortality experience against assumed mortality tables. This links the study to the specific mortality table being validated.']
  actual_mortality_rate decimal(6,5) [note: 'Observed mortality rate derived from experience data.']
  actual_retirement_rate decimal(6,5) [note: 'Observed retirement (exit) rate from experience data.']
  actual_salary_increase decimal(5,4) [note: 'Observed average salary increase percentage from experience data.']
  assumed_mortality_rate decimal(6,5) [note: 'Mortality rate assumed in the actuarial model for comparison.']
  assumed_retirement_rate decimal(6,5) [note: 'Retirement rate assumed in the actuarial model for comparison.']
  assumed_salary_increase decimal(5,4) [note: 'Salary increase percentage assumed in the actuarial model.']
  assumptions_version varchar [note: 'Version identifier for the set of actuarial assumptions applied in the study.']
  creation_timestamp timestamp [note: 'Timestamp when the study record was first created in the system.']
  data_source varchar [note: 'Origin of the raw data used in the experience study (e.g., payroll system, HRIS).']
  deviation_metric decimal(8,4) [note: 'Numeric measure of deviation between actual and assumed experience (e.g., difference or ratio).']
  discount_rate decimal(5,4) [note: 'Annual discount rate applied to cash‑flow projections in the study.']
  end_date date [note: 'Date when the experience study period ends.']
  experience_period_years varchar [note: 'Number of years covered by the experience study period.']
  experience_study_description varchar [note: 'Free‑text description of the study purpose, scope, and methodology.']
  experience_study_status varchar [note: 'Current lifecycle status of the study.']
  inflation_rate decimal(5,4) [note: 'Assumed annual inflation rate applied to benefit cash flows.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the study record.']
  notes varchar [note: 'Additional free‑form comments or observations recorded by the actuary.']
  regulatory_approval_date date [note: 'Date when the regulatory authority approved the study.']
  regulatory_approval_status varchar [note: 'Status of regulatory review for the study results.']
  salary_growth_rate decimal(5,4) [note: 'Assumed annual growth rate of member salaries used in the study.']
  start_date date [note: 'Date when the experience study period begins.']
  study_code varchar [note: 'External or business code assigned to the study for reference in documentation.']
  study_name varchar [note: 'Descriptive name of the experience study used for reporting and analysis.']
  study_type varchar [note: 'Category of experience being analyzed, such as mortality, termination, retirement, disability, or salary.']

  Note: 'Master record for each actuarial experience study conducted to compare actual plan experience against assumed experience. Captures study name, study period (start/end date), experience type (mortality, termination, retirement, disability, salary)'
}

Table actuarial.gain_loss {
  gain_loss_id varchar [pk, note: 'Unique surrogate key for each actuarial gain or loss record.']
  assumption_set_id varchar [note: 'Identifier of the assumption set used for the valuation.']
  liability_projection_id varchar [note: 'Reference to the liability projection associated with this gain/loss.']
  valuation_asset_valuation_id varchar [note: 'Identifier of the actuarial valuation episode that produced this record.']
  amount decimal(20,4) [note: 'Monetary value of the gain or loss expressed in the reporting currency.']
  confidence_level decimal(5,2) [note: 'Statistical confidence (percentage) associated with the measurement.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created in the data lake.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency in which the amount is expressed.']
  gain_loss_status varchar [note: 'Current processing status of the gain/loss record.']
  gain_loss_type varchar [note: 'Category of the gain or loss based on its origin.']
  is_estimated boolean [note: 'Indicates whether the amount is an estimate (true) or based on actual experience (false).']
  loss_description varchar [note: 'Narrative description of the gain or loss event.']
  measurement_timestamp timestamp [note: 'Date and time when the gain or loss measurement was recorded.']
  notes varchar [note: 'Free‑form field for any supplemental information or comments.']
  regulatory_filing_status varchar [note: 'Status of any required regulatory filing for this gain/loss.']
  scenario varchar [note: 'Economic or demographic scenario applied to the measurement.']
  source_document_reference varchar [note: 'External document or file reference (e.g., PDF, spreadsheet) that supports the measurement.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  valuation_period varchar [note: 'Identifier for the valuation period (e.g., FY2024, Q1‑2025).']

  Note: 'Transactional record capturing actuarial gains and losses arising from differences between actual and assumed experience in each valuation period. Captures measurement date, gain/loss type (demographic, economic, asset return, assumption change)'
}

Table actuarial.de_risking_trigger {
  de_risking_trigger_id varchar [pk, note: 'System‑generated unique identifier for the de‑risking trigger record.']
  applicable_liability_projection_id varchar [note: 'Identifier of the liability projection scenario linked to the trigger.']
  applicable_portfolio_id varchar [note: 'Identifier of the investment portfolio to which the trigger applies.']
  ldi_strategy_id varchar [note: 'Foreign key linking to actuarial.ldi_strategy. Business justification: De-risking triggers define thresholds that adjust LDI hedge ratios. This links the trigger to the specific LDI strategy it governs, enabling strategy-specific trigger management.']
  limit_id varchar [note: 'Foreign key linking to risk.limit. Business justification: De-risking triggers (funded ratio thresholds for glide path execution) are specialized limits. Linking to risk.limit enables unified limit monitoring, breach escalation, and remediation tracking']
  macro_indicator_id varchar [note: 'Foreign key linking to research.macro_indicator. Business justification: De-risking triggers are often set based on macro indicators (interest rates, inflation).']
  comparison_operator varchar [note: 'Logical operator defining how the measured value is compared to the threshold.']
  created_timestamp timestamp [note: 'Timestamp when the trigger record was first created in the system.']
  de_risking_trigger_description varchar [note: 'Free‑form description of the trigger logic and business rationale.']
  de_risking_trigger_status varchar [note: 'Current operational status of the trigger.']
  effective_from date [note: 'Date on which the trigger becomes effective.']
  effective_until date [note: 'Date on which the trigger expires or is superseded (null if open‑ended).']
  is_automated boolean [note: 'Indicates whether the trigger is applied automatically by the LDI engine.']
  last_review_date date [note: 'Date when the trigger was last reviewed for relevance and accuracy.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the trigger record.']
  next_review_date date [note: 'Planned future date for the next trigger review.']
  notes varchar [note: 'Additional free‑text comments or operational notes about the trigger.']
  threshold_unit varchar [note: 'Unit of measure for the threshold value.']
  threshold_value decimal(12,6) [note: 'Numeric threshold that activates the trigger (e.g., 80.0 for 80% funded ratio).']
  trigger_code varchar [note: 'Short alphanumeric code used to reference the trigger in external systems and reports.']
  trigger_name varchar [note: 'Human‑readable name describing the purpose of the trigger.']
  trigger_priority varchar [note: 'Numeric priority determining evaluation order when multiple triggers are active.']
  trigger_type varchar [note: 'Category of the trigger condition (e.g., funded‑ratio threshold, interest‑rate level, surplus amount, duration mismatch).']
  version_number varchar [note: 'Incremental version of the trigger definition for change management.']

  Note: 'Master record defining funded-status-based de-risking triggers that automatically adjust the LDI hedge ratio or asset allocation glide path. Captures trigger name, trigger type (funded ratio threshold, interest rate level, surplus amount), trigger'
}

Table actuarial.de_risking_event {
  de_risking_event_id varchar [pk, note: 'Unique surrogate key for each de‑risking event record.']
  assumption_set_id varchar [note: 'Identifier of the actuarial assumption set applied in the analysis.']
  created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: De-risking events trigger significant portfolio changes; regulatory compliance requires documenting which employee recorded the breach event. created_by is text, need proper FK.']
  de_risking_trigger_id varchar [note: 'Foreign key linking to actuarial.de_risking_trigger. Business justification: De-risking events are triggered by specific de-risking triggers. This links the event to the trigger definition that was breached, enabling analysis of which triggers are most']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: De-risking events are triggered when economic conditions breach thresholds. Recording which economic scenario was active at breach time enables post-event analysis and strategy']
  fund_id varchar [note: 'Internal identifier of the fund whose liability profile triggered the event.']
  liability_projection_id varchar [note: 'Reference to the liability projection used for the breach analysis.']
  action_mandated varchar [note: 'Prescribed portfolio action required to address the breach.']
  action_status varchar [note: 'Current status of the mandated action.']
  action_taken_date date [note: 'Date on which the mandated action was executed.']
  breach_timestamp timestamp [note: 'Date and time when the de‑risking trigger was breached.']
  created_timestamp timestamp [note: 'Timestamp when the event record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary values.']
  de_risking_event_status varchar [note: 'Current lifecycle status of the event.']
  event_reference varchar [note: 'Business identifier for the de‑risking event, often a human‑readable code.']
  funded_ratio_at_breach decimal(5,4) [note: 'Funded ratio (as a decimal) measured at the moment of breach.']
  hedge_ratio_after decimal(5,4) [note: 'Proportion of portfolio hedged after the de‑risking action.']
  hedge_ratio_before decimal(5,4) [note: 'Proportion of portfolio hedged before the de‑risking action.']
  notes varchar [note: 'Free‑form comments or observations related to the event.']
  regulatory_reporting_flag boolean [note: 'Indicates whether the event must be reported to regulators.']
  trigger_threshold decimal(5,4) [note: 'The threshold value for the trigger that was breached, expressed as a decimal.']
  trigger_type varchar [note: 'Classification of the de‑risking trigger that was breached.']
  updated_by varchar [note: 'User or process that performed the last update.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the event record.']
  created_by varchar [note: 'User or process that created the event record.']

  Note: 'Transactional record of each de-risking trigger breach event and the resulting portfolio action taken. Captures trigger reference, breach date, funded ratio at breach, trigger threshold breached, action mandated, action taken date, hedge ratio before'
}

Table actuarial.indexation_policy {
  indexation_policy_id varchar [pk, note: 'System-generated unique identifier for the indexation policy record.']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Indexation policies use actuarial assumptions, particularly inflation assumptions.']
  contributor_pool_id varchar [note: 'Identifier of the contributor pool to which the policy applies.']
  created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Indexation policies affect pension payments; governance requires tracking policy creator for accountability. created_by is text, need proper FK.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Indexation policies (COLA adjustments) are governed by jurisdiction-specific pension regulations.']
  adjustment_type varchar [note: 'Indicates whether the adjustment is a percentage of benefit or a fixed monetary amount.']
  applicable_region varchar [note: 'Geographic region(s) where the policy is enforced.']
  approval_date date [note: 'Date on which regulatory approval was granted.']
  cap_rate decimal(5,4) [note: 'Maximum allowable indexation percentage; null if uncapped.']
  created_timestamp timestamp [note: 'Timestamp when the policy record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for monetary amounts.']
  effective_from date [note: 'Date on which the indexation policy becomes binding.']
  effective_until date [note: 'Date on which the policy ends; null for open‑ended policies.']
  eligibility_criteria varchar [note: 'Business rules defining which members qualify for the policy.']
  floor_rate decimal(5,4) [note: 'Minimum allowable indexation percentage; null if no floor.']
  indexation_frequency varchar [note: 'How often the indexation adjustment is applied.']
  indexation_lag_months varchar [note: 'Number of months between index publication and its application to benefits.']
  indexation_method varchar [note: 'Underlying index or methodology used for the adjustment.']
  indexation_policy_description varchar [note: 'Detailed narrative describing the purpose and mechanics of the policy.']
  indexation_policy_status varchar [note: 'Current lifecycle status of the policy.']
  indexation_rate decimal(5,4) [note: 'Base percentage rate applied to benefits (e.g., 0.0250 for 2.5%).']
  inflation_index_code varchar [note: 'Standard code of the inflation index (e.g., CPI_CA).']
  is_default boolean [note: 'True if this policy is the default for its contributor pool.']
  last_review_date date [note: 'Date when the policy was last reviewed for relevance.']
  max_adjustment_amount decimal(18,2) [note: 'Absolute ceiling on the monetary adjustment per period; null if not applicable.']
  min_adjustment_amount decimal(18,2) [note: 'Absolute floor on the monetary adjustment per period; null if not applicable.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the policy record.']
  notes varchar [note: 'Free‑form comments or operational notes about the policy.']
  policy_code varchar [note: 'Business code that uniquely identifies the policy across systems.']
  policy_name varchar [note: 'Human‑readable name of the indexation policy as used in reports and governance.']
  policy_type varchar [note: 'Classification of the policy (e.g., cost‑of‑living, wage‑growth, custom, fixed).']
  regulatory_approval_status varchar [note: 'Status of regulatory sign‑off for the policy.']
  review_cycle_months varchar [note: 'Planned interval in months between policy reviews.']
  version_number varchar [note: 'Version identifier for change management (e.g., v1.2).']
  created_by varchar [note: 'Name of the business user who created the policy record.']

  Note: 'Master record defining the benefit indexation policy for each contributor pool, governing how pension benefits are adjusted for inflation (cost-of-living adjustments).'
}

Table actuarial.plan_amendment {
  plan_amendment_id varchar [pk, note: 'Unique surrogate key for each plan amendment record.']
  contributor_pool_id varchar [note: 'Identifier of the contributor pool (e.g., one of the participating plans) affected by the amendment.']
  created_by_employee_id varchar [note: 'Foreign key linking to shared.employee. Business justification: Plan amendments affect beneficiary entitlements; governance requires tracking which employee initiated the amendment. created_by is text, need proper FK.']
  pension_plan_id varchar [note: 'Identifier of the pension plan to which this amendment applies.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Plan amendments must be approved by the governing regulatory authority. For multi-employer pension funds, different amendments may fall under different jurisdictional']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Plan amendments require regulatory filings for approval before implementation.']
  amendment_category varchar [note: 'High‑level classification of the amendment purpose.']
  amendment_code varchar [note: 'External reference code assigned to the amendment for tracking and reporting.']
  amendment_date date [note: 'Date the amendment was formally recorded in the system.']
  amendment_reason varchar [note: 'Business justification or regulatory driver for the amendment.']
  amendment_status varchar [note: 'Current lifecycle state of the amendment.']
  amendment_type varchar [note: 'Classifies the nature of the amendment to the pension plan.']
  approval_timestamp timestamp [note: 'Timestamp when the amendment received formal approval.']
  approved_by varchar [note: 'User identifier of the approver for the amendment.']
  benefit_change_amount decimal(18,2) [note: 'Monetary value of any increase or decrease to benefit payouts.']
  contribution_rate_change decimal(5,4) [note: 'Change in the contribution rate expressed in percentage points.']
  created_timestamp timestamp [note: 'Timestamp when the amendment record was first created.']
  document_reference varchar [note: 'Reference to the supporting document (e.g., amendment letter, legal filing).']
  effective_date date [note: 'Date on which the amendment becomes binding for plan participants.']
  eligibility_criteria_change varchar [note: 'Text describing any modifications to eligibility rules.']
  expiration_date date [note: 'Optional date when the amendment ceases to be in effect.']
  funding_source varchar [note: 'Source of funding for any additional contributions required by the amendment.']
  impact_assessment varchar [note: 'Summary of the financial and actuarial impact of the amendment.']
  indexation_rate decimal(5,4) [note: 'New indexation rate applied to benefits after the amendment.']
  is_confidential boolean [note: 'Indicates whether the amendment contains confidential information.']
  ldi_impact_flag boolean [note: 'True if the amendment materially changes LDI strategy assumptions.']
  modified_by varchar [note: 'User identifier of the person who last modified the amendment record.']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the amendment record.']
  notes varchar [note: 'Free‑form field for any supplemental information.']
  plan_amendment_description varchar [note: 'Narrative description of the amendment purpose and details.']
  regulatory_approval_date date [note: 'Date when regulatory approval was granted.']
  regulatory_approval_status varchar [note: 'Status of regulatory review for the amendment.']
  stakeholder_impact varchar [note: 'Description of how the amendment affects plan participants and sponsors.']
  version_number varchar [note: 'Sequential version number of the amendment record.']
  vesting_schedule_change varchar [note: 'Details of any changes to vesting schedules for accrued benefits.']
  created_by varchar [note: 'User identifier of the person who created the amendment record.']

  Note: 'Master record of each formal pension plan amendment that modifies benefit terms, contribution rates, eligibility criteria, or indexation provisions. Captures amendment date, amendment type (benefit improvement, benefit reduction, contribution change'
}

Table actuarial.actuarial_report {
  actuarial_report_id varchar [pk, note: 'Unique system-generated identifier for the actuarial report.']
  actuarial_valuation_id varchar [note: 'Foreign key linking to actuarial.actuarial_valuation. Business justification: Actuarial reports are often produced based on specific actuarial valuations. This links the report to its underlying valuation, enabling traceability from report to source']
  assumption_set_id varchar [note: 'Foreign key linking to actuarial.assumption_set. Business justification: Actuarial report is generated using a specific assumption set; FK provides reference and removes duplicate assumption_set_code.']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Actuarial reports reference specific liability projections. This links the report to the projection used, enabling verification of reported liability figures against source']
  mortality_table_id varchar [note: 'Foreign key linking to actuarial.mortality_table. Business justification: Actuarial report uses a specific mortality table; FK provides reference and removes duplicate mortality_table_code.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Actuarial reports are submitted to specific regulatory authorities. For pension funds serving several participating plans, tracking the governing authority per report']
  active_member_count varchar [note: 'Number of members actively accruing benefits at valuation date.']
  actuary_designation varchar [note: 'Professional designation or title of the lead actuary (e.g., ASA, FSA).']
  actuary_firm_name varchar [note: 'Name of the actuarial consulting firm that prepared the report.']
  amortization_period_years varchar [note: 'Number of years over which special payments are amortized.']
  approved_timestamp timestamp [note: 'Date and time when the report received final approval.']
  average_active_member_age decimal(5,2) [note: 'Mean age of active members at valuation date.']
  average_pensioner_age decimal(5,2) [note: 'Mean age of members already receiving pension benefits.']
  certification_date date [note: 'Date when the actuary\'s certification or qualification was confirmed.']
  comments varchar [note: 'Free‑text field for additional notes or commentary from the actuary.']
  creation_timestamp timestamp [note: 'Date and time when the report record was first created in the system.']
  deferred_member_count varchar [note: 'Number of members with deferred benefits (e.g., vested but not yet payable).']
  discount_rate decimal(5,4) [note: 'Rate used to discount future cash flows to present value for liability calculations.']
  employer_contribution_rate decimal(5,4) [note: 'Rate at which the employer contributes to the plan relative to payroll.']
  funded_ratio decimal(5,2) [note: 'Ratio of plan assets to liabilities expressed as a percentage.']
  going_concern_liability decimal(20,2) [note: 'Present value of projected benefit obligations assuming the plan continues operating.']
  horizon_years varchar [note: 'Number of years into the future the actuarial projection extends.']
  inflation_assumption decimal(5,4) [note: 'Assumed annual inflation rate applied to future benefit cash flows.']
  last_updated_timestamp timestamp [note: 'Date and time of the most recent modification to the report record.']
  lead_actuary_name varchar [note: 'Full name of the lead actuary responsible for the report.']
  liability_duration_years decimal(5,2) [note: 'Weighted average duration of projected liabilities.']
  member_contribution_rate decimal(5,4) [note: 'Rate at which plan members contribute to the plan relative to salary.']
  model_version varchar [note: 'Version identifier of the actuarial model used for calculations.']
  mortality_improvement_scale varchar [note: 'Scale or factor applied to adjust mortality rates over time.']
  normal_cost_rate decimal(5,4) [note: 'Annual cost of benefits accrued during the year expressed as a rate.']
  regulatory_filing_date date [note: 'Date on which the report was filed with the relevant regulator.']
  regulatory_filing_status varchar [note: 'Status of any required regulatory filing associated with the report.']
  report_name varchar [note: 'Descriptive name of the actuarial report used for display and search.']
  report_number varchar [note: 'Business identifier or reference number assigned to the report.']
  report_status varchar [note: 'Current lifecycle state of the report within the actuarial workflow.']
  report_type varchar [note: 'Category of the report indicating its purpose and methodology.']
  reporting_period_end date [note: 'End date of the fiscal period covered by the report.']
  reporting_period_start date [note: 'Start date of the fiscal period covered by the report.']
  retired_member_count varchar [note: 'Number of members already retired and receiving benefits.']
  retirement_age_assumption varchar [note: 'Assumed age at which members retire for projection purposes.']
  salary_increase_assumption decimal(5,4) [note: 'Projected annual growth rate of member salaries used in earnings projections.']
  scenario varchar [note: 'Assumed economic or demographic scenario used for the projection.']
  solvency_liability decimal(20,2) [note: 'Liability amount calculated under solvency accounting standards.']
  special_payment_amount decimal(20,2) [note: 'Amount of any special or supplemental payments included in the projection.']
  total_member_count varchar [note: 'Aggregate count of all members covered by the plan.']
  total_plan_assets_market_value decimal(20,2) [note: 'Aggregate market value of all plan assets at valuation date.']
  total_plan_assets_smoothed_value decimal(20,2) [note: 'Smoothed (e.g., moving average) value of plan assets used for liability calculations.']
  valuation_date date [note: 'Effective date of the valuation underlying the actuarial calculations.']
  wind_up_liability decimal(20,2) [note: 'Liability amount assuming the plan is terminated and assets are liquidated.']

  Note: 'Master record for each formal actuarial report produced by the internal or external actuarial team. Captures report name, report type (valuation report, experience study, ALM study, contribution rate review, regulatory filing, ad hoc analysis), reporting'
}

Table actuarial.liability_segment {
  liability_segment_id varchar [pk, note: 'Unique system-generated identifier for the liability segment record.']
  contributor_pool_id varchar [note: 'FK to beneficiary.contributor_pool']
  liability_projection_id varchar [note: 'Foreign key linking to actuarial.liability_projection. Business justification: Liability segments represent portions of total pension liabilities. This links segments to the liability projection they subdivide, enabling reconciliation of segment totals to']
  contributor_pool varchar [note: 'Identifier of the contributor pool (e.g., one of the participating plans) to which the segment belongs.']
  created_timestamp timestamp [note: 'Timestamp when the liability segment record was first created in the system.']
  discount_rate_used decimal(5,4) [note: 'Discount rate applied to project liability cash‑flows for the segment (e.g., 0.0450 = 4.50%).']
  effective_date date [note: 'Date the liability segment became effective for reporting and funding purposes.']
  expiration_date date [note: 'Date the liability segment ceases to be active, if applicable.']
  funding_gap_amount decimal(20,2) [note: 'Monetary shortfall between assets and liabilities for the segment.']
  funding_gap_percentage decimal(5,2) [note: 'Funding gap expressed as a percentage of total liability.']
  funding_status varchar [note: 'Indicates whether the segment is fully funded, under‑funded, or unfunded.']
  is_default_segment boolean [note: 'Indicates whether this segment is the default for its contributor pool.']
  last_review_date date [note: 'Date of the most recent formal review of the segment assumptions.']
  liability_amount_gav decimal(20,2) [note: 'Gross asset value associated with the segment for asset‑liability matching.']
  liability_amount_gav_currency varchar [note: 'ISO currency code for the gross asset value amount.']
  liability_amount_nav decimal(20,2) [note: 'Net asset value associated with the segment for asset‑liability matching.']
  liability_amount_nav_currency varchar [note: 'ISO currency code for the net asset value amount.']
  liability_currency varchar [note: 'Three‑letter ISO currency code of the liability amount (e.g., USD).']
  liability_duration_years decimal(5,2) [note: 'Weighted average duration of cash‑flow obligations for the segment, expressed in years.']
  liability_measurement_currency varchar [note: 'Currency in which liability amounts are measured for this segment.']
  liability_segment_status varchar [note: 'Current lifecycle status of the liability segment.']
  measurement_method varchar [note: 'Methodology used to measure the liability (market, actuarial, or hybrid).']
  modified_timestamp timestamp [note: 'Timestamp of the most recent update to the liability segment record.']
  next_review_date date [note: 'Planned date for the next review of the segment\'s assumptions.']
  notes varchar [note: 'Free‑form text for additional comments or explanations about the segment.']
  regulatory_approval_date date [note: 'Date when regulatory approval was granted or recorded.']
  regulatory_approval_status varchar [note: 'Status of regulatory approval for the segment\'s liability methodology.']
  risk_category varchar [note: 'Risk classification assigned to the segment based on volatility and duration.']
  segment_classification varchar [note: 'Higher‑level classification grouping (e.g., core, ancillary).']
  segment_code varchar [note: 'Business identifier code assigned to the liability segment for external reference.']
  segment_country varchar [note: 'Three‑letter ISO country code where the segment\'s liabilities are primarily located.']
  segment_creation_date date [note: 'Date the segment record was initially created (duplicate of effective_date for audit purposes).']
  segment_currency_exposure varchar [note: 'Comma‑separated list of currencies in which the segment has exposure.']
  segment_description varchar [note: 'Detailed description of the segment\'s purpose and composition.']
  segment_last_updated_date date [note: 'Date of the most recent update to the segment record (duplicate of modified_timestamp for audit purposes).']
  segment_liability_subtype varchar [note: 'Specific subtype of liability within the broader type.']
  segment_liability_type varchar [note: 'Type of pension liability (defined benefit or defined contribution).']
  segment_name varchar [note: 'Human‑readable name describing the liability segment.']
  segment_owner varchar [note: 'Internal team or business unit responsible for the segment.']
  segment_region varchar [note: 'Geographic region code (e.g., NA, EU, APAC) for the segment.']
  segment_source_system varchar [note: 'Originating system that supplied the segment data (e.g., SimCorp, Aladdin).']
  segment_status_reason varchar [note: 'Explanation for the current status of the segment (e.g., reason for archiving).']
  segment_type varchar [note: 'Classification of the segment by member status (e.g., active, deferred, retired, survivor).']
  total_liability_amount decimal(20,2) [note: 'Aggregated liability amount for the segment expressed in the reporting currency.']
  valuation_date date [note: 'Date on which the liability amounts were valued.']
  version_number varchar [note: 'Incremental version identifier for changes to the segment record.']
  weighted_average_duration_years decimal(5,2) [note: 'Average duration of the segment weighted by liability cash‑flows.']

  Note: 'Master record defining the segmentation of total pension liabilities for ALM and LDI purposes. Captures segment name, segment type (active members, deferred members, retirees, survivors), contributor pool, total liability amount, duration of segment'
}

Table fee.management_fee {
  management_fee_id varchar [pk, note: 'Unique identifier for the management fee arrangement record.']
  gp_entity_id varchar [note: 'Reference to the General Partner (GP) or external manager entity receiving the management fee.']
  gp_gp_entity_id varchar [note: 'Reference to the General Partner (GP) or external manager entity receiving the management fee.']
  manager_mandate_id varchar [note: 'Reference to the external manager mandate or internal investment structure to which this management fee arrangement applies.']
  approval_date date [note: 'The date on which the management fee arrangement was formally approved by the Investment Committee (IC) or authorized governance body.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee (IC) member or governance authority who approved the management fee arrangement.']
  base_fee_rate decimal(10,6) [note: 'The primary management fee rate expressed as a decimal percentage (e.g., 0.015000 for 1.5% per annum) applicable to the fee basis.']
  benchmark_index_code varchar [note: 'The market benchmark index code (e.g., MSCI World, S&P 500) used for performance comparison and potential performance-based fee adjustments.']
  calculation_frequency varchar [note: 'The frequency at which the management fee is calculated and accrued, as specified in the Limited Partnership Agreement (LPA) or mandate documentation.']
  catch_up_provision varchar [note: 'Defines whether the General Partner (GP) is entitled to a catch-up allocation of profits after the hurdle rate is met, allowing the GP to reach its full carried interest percentage.']
  clawback_provision_flag boolean [note: 'Indicates whether the Limited Partnership Agreement (LPA) includes a clawback provision requiring the General Partner (GP) to return excess carried interest or fees if final fund performance falls below agreed thresholds.']
  created_timestamp timestamp [note: 'The date and time when this management fee arrangement record was first created in the system.']
  effective_end_date date [note: 'The date on which this management fee arrangement terminates or is superseded by a new arrangement. Null indicates an open-ended arrangement.']
  effective_start_date date [note: 'The date on which this management fee arrangement becomes effective and fee calculations commence.']
  fee_arrangement_code varchar [note: 'Unique business identifier for the management fee arrangement, typically referenced in Limited Partnership Agreement (LPA) or Investment Management Agreement (IMA).']
  fee_arrangement_name varchar [note: 'Descriptive name of the management fee arrangement for business user identification and reporting purposes.']
  fee_arrangement_status varchar [note: 'Current lifecycle status of the management fee arrangement, indicating whether it is actively in force, suspended, terminated, or under review.']
  fee_basis varchar [note: 'The calculation basis for the management fee, defining whether it is computed as a percentage of Assets Under Management (AUM), committed capital, Net Asset Value (NAV), or as a flat amount.']
  fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the management fee is denominated and paid.']
  fee_offset_provision varchar [note: 'Defines whether and how transaction fees, monitoring fees, or other ancillary fees paid by portfolio companies are offset against the management fee payable to the General Partner (GP).']
  fee_rate_unit varchar [note: 'The unit of measure and time period for the fee rate, clarifying whether the rate is annualized, quarterly, monthly, or a one-time flat amount.']
  fee_transparency_disclosure_flag boolean [note: 'Indicates whether this management fee arrangement is subject to enhanced fee transparency disclosure requirements under regulatory frameworks such as Sustainable Finance Disclosure Regulation (SFDR) or MiFID II.']
  fee_type varchar [note: 'Classification of the fee arrangement by its purpose and structure within the investment mandate.']
  fee_waiver_conditions varchar [note: 'Textual description of specific conditions under which management fees may be waived, reduced, or deferred, such as fund underperformance or capital call delays.']
  hurdle_rate decimal(10,6) [note: 'The preferred return threshold (expressed as a decimal percentage) that must be achieved before performance-based fee components or carried interest become payable.']
  internal_cost_center_code varchar [note: 'The internal General Ledger (GL) cost center or account code to which management fee expenses are allocated for financial accounting and budgeting purposes.']
  investment_period_flag boolean [note: 'Indicates whether the fund is currently in its investment period, during which management fees are typically calculated on committed capital rather than invested capital.']
  last_modified_timestamp timestamp [note: 'The date and time when this management fee arrangement record was most recently updated or amended.']
  lpa_reference_section varchar [note: 'The specific section, article, or clause reference within the Limited Partnership Agreement (LPA) or Investment Management Agreement (IMA) that governs this management fee arrangement.']
  maximum_fee_amount decimal(18,2) [note: 'The contractual maximum management fee amount per period, capping the fee regardless of asset value growth.']
  minimum_fee_amount decimal(18,2) [note: 'The contractual minimum management fee amount per period, ensuring the General Partner (GP) receives at least this amount regardless of asset value fluctuations.']
  modified_by_user varchar [note: 'Identifier of the user or system process that last modified this management fee arrangement record, supporting audit trail and data lineage requirements.']
  most_favored_nation_clause boolean [note: 'Indicates whether the fee arrangement includes a Most Favored Nation (MFN) clause ensuring this Limited Partner (LP) receives fee terms no less favorable than those granted to other LPs in the same fund.']
  notes varchar [note: 'Free-text field for additional contextual information, special conditions, or clarifications regarding the management fee arrangement not captured in structured fields.']
  offset_percentage decimal(5,2) [note: 'The percentage of ancillary fees (transaction, monitoring, advisory) that must be rebated or offset against the management fee, typically ranging from 50% to 100%.']
  payment_frequency varchar [note: 'The frequency at which the calculated management fee is invoiced and paid to the General Partner (GP) or external manager.']
  payment_timing varchar [note: 'Specifies whether the management fee is paid in advance of the period, in arrears after the period, or triggered by specific capital events.']
  performance_fee_linkage_flag boolean [note: 'Indicates whether the management fee arrangement is linked to or adjusted based on investment performance relative to benchmarks or absolute return targets.']
  post_investment_period_basis varchar [note: 'The fee calculation basis that applies after the investment period ends, often shifting from committed capital to invested capital or Net Asset Value (NAV).']
  post_investment_period_rate decimal(10,6) [note: 'The reduced management fee rate that applies after the investment period concludes, typically lower than the base rate during the investment period.']
  regulatory_reporting_category varchar [note: 'Classification of the management fee for regulatory cost disclosure and reporting purposes under frameworks such as MiFID II and SFDR.']
  termination_notice_period_days varchar [note: 'The number of days advance notice required to terminate or modify the management fee arrangement, as specified in the mandate or Limited Partnership Agreement (LPA).']
  tiered_schedule_flag boolean [note: 'Indicates whether the management fee arrangement uses a tiered rate schedule with different rates applying to different asset value thresholds.']
  version_number varchar [note: 'Sequential version number tracking amendments and revisions to the management fee arrangement over its lifecycle, supporting historical analysis and audit compliance.']

  Note: 'Master record defining the management fee arrangement for each external manager mandate or internal investment structure. Captures the fee basis (AUM percentage, flat fee, tiered), applicable rate schedule, fee calculation frequency (monthly, quarterly'
}

Table fee.carried_interest {
  carried_interest_id varchar [pk, note: 'Unique identifier for the carried interest arrangement. Primary key.']
  fund_id varchar [note: 'Reference to the fund or investment vehicle to which this carried interest arrangement applies.']
  gp_entity_id varchar [note: 'Reference to the General Partner or external manager entity entitled to receive carried interest.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Carried interest calculations depend on fund valuations to determine IRR/MOIC thresholds. Pension funds must audit carry distributions against specific valuation cycles for fiduciary']
  accrued_carry_amount decimal(18,2) [note: 'Total amount of carried interest accrued to date under this arrangement, in the arrangement currency.']
  approval_date date [note: 'Date on which this carried interest arrangement was approved by the Investment Committee or governing body.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee member or authority who approved this carried interest arrangement.']
  arrangement_name varchar [note: 'Business name or label for this carried interest arrangement for identification and reporting purposes.']
  arrangement_type varchar [note: 'Classification of the carried interest structure: whole fund waterfall, deal-by-deal, hybrid, tiered, European style, or American style.']
  asset_class varchar [note: 'Asset class to which this carried interest arrangement applies: private equity, infrastructure, real estate, natural resources, or credit.']
  benchmark_irr decimal(10,6) [note: 'Benchmark IRR used for performance comparison and carried interest eligibility assessment, expressed as a decimal.']
  calculation_basis varchar [note: 'Basis for calculating carried interest: realized gains only, unrealized gains included, total value, IRR-based, or MOIC-based.']
  calculation_frequency varchar [note: 'Frequency at which carried interest is calculated: daily, monthly, quarterly, semi-annual, annual, or on specific events.']
  carried_interest_status varchar [note: 'Current lifecycle status of the carried interest arrangement: active, suspended, terminated, pending approval, or under review.']
  carry_rate decimal(10,6) [note: 'Percentage of profits above the hurdle rate that the GP is entitled to receive as carried interest, expressed as a decimal (e.g., 0.20 for 20%).']
  catchup_cap decimal(10,6) [note: 'Maximum percentage of total profits that can be allocated during the catch-up phase, expressed as a decimal.']
  catchup_rate decimal(10,6) [note: 'Percentage of profits allocated to the GP after the hurdle is met and before the final carry split, allowing GP to catch up to their target carry percentage.']
  clawback_cap_amount decimal(18,2) [note: 'Maximum amount in base currency that can be clawed back from the GP under the clawback provision.']
  clawback_provision boolean [note: 'Indicates whether a clawback provision exists requiring the GP to return excess carried interest if final fund performance falls below the hurdle.']
  clawback_reserve_amount decimal(18,2) [note: 'Amount held in reserve to cover potential clawback obligations, in the arrangement currency.']
  clawback_type varchar [note: 'Type of clawback provision: full clawback of all excess carry, partial clawback with limitations, or none.']
  created_timestamp timestamp [note: 'Timestamp when this carried interest arrangement record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which carried interest amounts are denominated and calculated.']
  distributed_carry_amount decimal(18,2) [note: 'Total amount of carried interest distributed to the GP to date under this arrangement, in the arrangement currency.']
  distribution_timing varchar [note: 'Timing of carried interest distributions to the GP: on asset realization, on LP distributions, at fund termination, quarterly, or annual.']
  effective_date date [note: 'Date on which this carried interest arrangement becomes effective and binding.']
  fee_offset_percentage decimal(10,6) [note: 'Percentage of management fees that are offset against carried interest, expressed as a decimal (e.g., 1.00 for 100% offset).']
  fee_offset_provision boolean [note: 'Indicates whether management fees paid by the fund are offset against carried interest distributions to the GP.']
  gp_commitment_amount decimal(18,2) [note: 'Amount of capital committed by the GP to the fund, which may affect carried interest entitlement, in the arrangement currency.']
  gp_commitment_percentage decimal(10,6) [note: 'Percentage of total fund commitments contributed by the GP, expressed as a decimal.']
  hurdle_rate decimal(10,6) [note: 'Minimum preferred return threshold that must be achieved before the GP is entitled to carried interest, expressed as a decimal (e.g., 0.08 for 8%).']
  hurdle_type varchar [note: 'Type of hurdle rate: hard hurdle (carry only on profits above hurdle), soft hurdle (carry on all profits once hurdle is met), or none.']
  last_calculation_date date [note: 'Date on which the carried interest was most recently calculated and updated.']
  modified_by varchar [note: 'User identifier or system account that last modified this carried interest arrangement record.']
  modified_timestamp timestamp [note: 'Timestamp when this carried interest arrangement record was last modified in the system.']
  next_calculation_date date [note: 'Scheduled date for the next carried interest calculation and update.']
  notes varchar [note: 'Free-text notes capturing additional details, special provisions, or amendments to the carried interest arrangement.']
  outstanding_carry_amount decimal(18,2) [note: 'Amount of carried interest accrued but not yet distributed to the GP, in the arrangement currency.']
  performance_threshold_moic decimal(10,4) [note: 'Minimum MOIC threshold that must be achieved for carried interest to be payable, expressed as a multiple (e.g., 1.5 for 1.5x).']
  preferred_return_compounding varchar [note: 'Method for compounding the preferred return (hurdle rate): simple interest, compound annual, compound quarterly, or compound monthly.']
  regulatory_classification varchar [note: 'Regulatory classification of the carried interest arrangement under applicable securities and investment regulations.']
  tax_treatment_code varchar [note: 'Code indicating the tax treatment of carried interest distributions for the GP under applicable tax regulations.']
  termination_date date [note: 'Date on which this carried interest arrangement terminates or expires, typically aligned with fund liquidation.']
  transaction_fee_treatment varchar [note: 'Treatment of transaction fees earned by the GP: retained by GP, shared with LPs, offset against carry, or offset against management fees.']
  vintage_year varchar [note: 'Year in which the fund associated with this carried interest arrangement held its initial closing and began investing.']
  waterfall_tier_count varchar [note: 'Number of tiers in the carried interest waterfall structure for tiered arrangements.']

  Note: 'Master record for each carried interest arrangement negotiated with a GP/external manager across PE, infrastructure, real estate, and natural resources structures.'
}

Table fee.waterfall {
  waterfall_id varchar [pk, note: 'Unique identifier for the distribution waterfall structure.']
  fund_id varchar [note: 'Reference to the private markets fund or co-investment vehicle to which this waterfall applies.']
  amendment_version varchar [note: 'Version number tracking amendments to the waterfall structure, incremented with each modification to the Limited Partnership Agreement (LPA).']
  approval_date date [note: 'Date on which the Investment Committee (IC) or Limited Partner Advisory Committee approved this waterfall structure.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee (IC) member or governance body that approved this waterfall structure.']
  calculation_basis varchar [note: 'The capital base used for waterfall calculations: Paid-In Capital (PIC), Net Asset Value (NAV), invested capital, or committed capital.']
  carry_percentage decimal(10,6) [note: 'Percentage of profits allocated to the General Partner (GP) in this tier after hurdle conditions are met, expressed as a decimal (e.g., 0.20 for 20% carry).']
  catch_up_percentage decimal(10,6) [note: 'Percentage of distributions allocated to the GP during the catch-up tier to bring GP participation to the target carry level, expressed as a decimal (e.g., 1.00 for 100% catch-up).']
  clawback_cap_amount decimal(18,2) [note: 'Maximum monetary amount subject to clawback from the GP, limiting the GPs repayment obligation under the clawback provision.']
  clawback_provision_flag boolean [note: 'Indicates whether this waterfall tier includes a clawback provision requiring the GP to return excess carry if final fund performance falls below hurdle thresholds.']
  compounding_frequency varchar [note: 'Frequency at which the hurdle rate is compounded for preferred return calculations: annual, semi-annual, quarterly, or none for simple interest.']
  created_timestamp timestamp [note: 'Timestamp when this waterfall record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which waterfall calculations and distributions are denominated.']
  distribution_priority varchar [note: 'Priority mechanism for allocating distributions among investors within a tier: pro-rata by commitment, pari passu (equal footing), sequential by seniority, or custom allocation.']
  distribution_split_gp decimal(10,6) [note: 'Proportion of distributions allocated to the General Partner in this tier, expressed as a decimal (e.g., 0.20 for 20% to GP).']
  distribution_split_lp decimal(10,6) [note: 'Proportion of distributions allocated to Limited Partners in this tier, expressed as a decimal (e.g., 0.80 for 80% to LPs).']
  effective_date date [note: 'Date on which this waterfall structure becomes effective and begins governing distribution calculations.']
  gp_commitment_percentage decimal(10,6) [note: 'Percentage of total fund commitments contributed by the GP, affecting carry calculations and alignment of interest, expressed as a decimal.']
  hurdle_rate decimal(10,6) [note: 'Preferred return threshold percentage that Limited Partners (LPs) must achieve before General Partner (GP) carry is earned in this tier, expressed as a decimal (e.g., 0.08 for 8%).']
  last_modified_timestamp timestamp [note: 'Timestamp when this waterfall record was last updated, tracking the most recent change to any field.']
  lookback_period_years varchar [note: 'Number of years over which clawback calculations are performed, determining the historical window for assessing GP carry obligations.']
  lpa_reference_section varchar [note: 'Specific section or article number in the Limited Partnership Agreement that defines this waterfall structure.']
  management_fee_offset_flag boolean [note: 'Indicates whether management fees paid to the GP are offset against carried interest distributions in this waterfall tier.']
  notes varchar [note: 'Free-text field capturing additional context, special provisions, or clarifications regarding the waterfall structure not captured in structured fields.']
  preferred_return_accrual_method varchar [note: 'Method by which preferred return accrues to LPs: simple interest, compound interest, or Internal Rate of Return (IRR) based calculation.']
  termination_date date [note: 'Date on which this waterfall structure ceases to be effective, typically at fund liquidation or amendment.']
  tier_cap_amount decimal(18,2) [note: 'Maximum monetary amount that can be distributed within this tier before overflow proceeds to the next tier.']
  tier_name varchar [note: 'Descriptive label for this tier, such as Return of Capital, Preferred Return, Catch-Up, or Carried Interest.']
  tier_sequence varchar [note: 'Ordinal position of this tier within the waterfall structure, determining the order in which distributions are allocated.']
  tier_threshold_amount decimal(18,2) [note: 'Monetary threshold that must be reached before distributions flow to the next tier in the waterfall sequence.']
  transaction_fee_rebate_percentage decimal(10,6) [note: 'Percentage of transaction fees earned by the GP that must be rebated to the fund, reducing GP economics, expressed as a decimal (e.g., 0.80 for 80% rebate).']
  waterfall_name varchar [note: 'Business-friendly name or label for this waterfall structure.']
  waterfall_status varchar [note: 'Current lifecycle status of the waterfall structure: active (in use), superseded (replaced by amendment), terminated (fund closed), or draft (pending approval).']
  waterfall_type varchar [note: 'Classification of the waterfall calculation methodology: European (whole-fund aggregation) vs American (deal-by-deal) vs hybrid or custom structures.']

  Note: 'Master record defining the distribution waterfall structure for a private markets fund or co-investment vehicle. Captures waterfall type (European whole-fund vs American deal-by-deal), tier sequence, hurdle rate per tier, carry percentage per tier'
}

Table fee.waterfall_tier {
  waterfall_tier_id varchar [pk, note: 'Unique identifier for the waterfall tier within a distribution waterfall structure.']
  waterfall_id varchar [note: 'Reference to the parent distribution waterfall structure to which this tier belongs.']
  waterfall_structure_waterfall_id varchar [note: 'Reference to the parent distribution waterfall structure to which this tier belongs.']
  calculation_basis varchar [note: 'Methodology used to calculate distributions for this tier, such as cash-on-cash return, Internal Rate of Return (IRR), or Multiple on Invested Capital (MOIC).']
  catch_up_percentage decimal(10,6) [note: 'Percentage of distributions allocated to GP during catch-up tier to equalize carried interest after preferred return is met.']
  clawback_applicable_flag boolean [note: 'Indicates whether clawback provisions apply to distributions made in this tier, requiring GP to return excess carried interest.']
  clawback_percentage decimal(10,6) [note: 'Percentage of distributions subject to clawback if final returns fall below agreed thresholds.']
  compounding_frequency varchar [note: 'Frequency at which returns are compounded for hurdle rate calculations within this tier.']
  created_timestamp timestamp [note: 'Timestamp when this waterfall tier record was first created in the system.']
  cumulative_distribution_cap_amount decimal(20,2) [note: 'Maximum cumulative distribution amount for this tier before moving to the next tier in the waterfall.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which tier amounts and thresholds are denominated.']
  distribution_frequency varchar [note: 'Frequency at which distributions are calculated and paid out for this tier.']
  distribution_reinvestment_flag boolean [note: 'Indicates whether distributions from this tier are subject to mandatory or optional reinvestment into the fund.']
  escrow_holdback_percentage decimal(10,6) [note: 'Percentage of GP distributions held in escrow to cover potential clawback obligations at fund termination.']
  gp_allocation_percentage decimal(10,6) [note: 'Percentage of distributions allocated to General Partner within this tier, expressed as a decimal.']
  hurdle_rate_percentage decimal(10,6) [note: 'Preferred return threshold that must be achieved before this tier becomes active, expressed as an annualized percentage.']
  hurdle_rate_type varchar [note: 'Method by which the hurdle rate is calculated, such as simple return, compounded return, or Internal Rate of Return (IRR) based.']
  lookback_provision_flag boolean [note: 'Indicates whether a lookback provision applies, requiring recalculation of distributions at fund termination to ensure LPs receive their full preferred return.']
  lp_allocation_percentage decimal(10,6) [note: 'Percentage of distributions allocated to Limited Partners within this tier, expressed as a decimal.']
  management_fee_offset_flag boolean [note: 'Indicates whether management fees paid by LPs are offset against distributions in this tier for carried interest calculations.']
  notes varchar [note: 'Additional comments, clarifications, or special conditions related to this waterfall tier.']
  preferred_return_shortfall_carryforward_flag boolean [note: 'Indicates whether any shortfall in preferred return from prior periods is carried forward and must be satisfied before moving to subsequent tiers.']
  priority_rank varchar [note: 'Numeric rank indicating the priority of this tier relative to other tiers in the waterfall, with lower numbers having higher priority.']
  tier_amendment_date date [note: 'Date of the most recent amendment to this tier\'s terms, reflecting changes to allocation percentages, hurdle rates, or other provisions.']
  tier_amendment_reason varchar [note: 'Business justification or regulatory reason for the most recent amendment to this tier.']
  tier_description varchar [note: 'Detailed explanation of the tier\'s purpose, calculation methodology, and conditions for distribution.']
  tier_distribution_cap_amount decimal(20,2) [note: 'Maximum distribution amount that can be allocated within this specific tier.']
  tier_effective_date date [note: 'Date from which this tier becomes active and applicable for distribution calculations.']
  tier_name varchar [note: 'Business name or label for the tier, such as Return of Capital, Preferred Return, GP Catch-Up, or Carried Interest.']
  tier_sequence_number varchar [note: 'Sequential ordering of this tier within the waterfall structure, determining distribution priority.']
  tier_status varchar [note: 'Current lifecycle status of the waterfall tier within the distribution structure.']
  tier_termination_date date [note: 'Date on which this tier ceases to be active, either due to fund liquidation or structural amendment.']
  tier_type varchar [note: 'Classification of the tier within the waterfall structure, defining its economic purpose and distribution logic.']
  transaction_fee_treatment varchar [note: 'Defines how transaction fees earned by GP are treated within this tier, such as offset to LP capital or retained by GP.']
  updated_by varchar [note: 'User or system identifier of the individual or process that last modified this waterfall tier record.']
  updated_timestamp timestamp [note: 'Timestamp when this waterfall tier record was last modified.']
  created_by varchar [note: 'User or system identifier of the individual or process that created this waterfall tier record.']

  Note: 'Reference entity defining each sequential tier within a distribution waterfall structure. Captures tier sequence number, tier type (return of capital, preferred return/hurdle, GP catch-up, carried interest split), LP allocation percentage, GP allocation'
}

Table fee.hurdle_rate {
  hurdle_rate_id varchar [pk, note: 'Unique identifier for the hurdle rate record. Primary key for this entity.']
  fund_id varchar [note: 'Reference to the fund or investment vehicle to which this hurdle rate applies.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity associated with this hurdle rate arrangement.']
  gp_gp_entity_id varchar [note: 'Reference to the General Partner entity associated with this hurdle rate arrangement.']
  approval_date date [note: 'Date on which this hurdle rate arrangement was formally approved by the Investment Committee or governing body.']
  approved_by varchar [note: 'Name or identifier of the authority or committee that approved this hurdle rate arrangement.']
  asset_class varchar [note: 'The primary asset class to which this hurdle rate arrangement applies.']
  benchmark_index_code varchar [note: 'Reference code for any benchmark index used as a basis for the hurdle rate (e.g., SOFR, LIBOR, custom index).']
  benchmark_spread_bps varchar [note: 'Spread in basis points added to the benchmark index to determine the hurdle rate. Null if hurdle is absolute.']
  calculation_method varchar [note: 'The methodology used to calculate whether the hurdle rate has been achieved (e.g., Internal Rate of Return, money-weighted return, time-weighted return).']
  carry_percentage decimal(5,4) [note: 'The percentage of profits allocated to the GP as carried interest after the hurdle rate is achieved. Expressed as a decimal (e.g., 0.20 for 20%).']
  catch_up_percentage decimal(5,4) [note: 'The percentage of distributions allocated to the GP after the hurdle is met to catch up to their carried interest share. Typically 1.0 (100%) for full catch-up.']
  clawback_cap_percentage decimal(5,4) [note: 'Maximum percentage of previously distributed carried interest subject to clawback. Null if no cap applies.']
  clawback_provision_flag boolean [note: 'Indicates whether a clawback provision exists requiring the GP to return excess carried interest if final returns fall below the hurdle.']
  compounding_frequency varchar [note: 'Indicates whether the hurdle rate is calculated on a simple or compound basis and the compounding period.']
  created_timestamp timestamp [note: 'Timestamp when this hurdle rate record was first created in the system.']
  crystallization_event varchar [note: 'Description of the event or condition that triggers the crystallization and payment of carried interest (e.g., exit, distribution, fund liquidation).']
  cumulative_carry_distributed_amount decimal(20,2) [note: 'Total cumulative carried interest distributed to the General Partner under this hurdle rate arrangement, in the specified currency.']
  cumulative_preferred_return_amount decimal(20,2) [note: 'Total cumulative preferred return amount owed to Limited Partners under this hurdle rate arrangement, in the specified currency.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the hurdle rate calculations and distributions are denominated.']
  data_classification varchar [note: 'Classification level of this hurdle rate record indicating sensitivity and access control requirements.']
  distribution_waterfall_tier varchar [note: 'The tier or sequence number of this hurdle rate within the overall distribution waterfall structure.']
  effective_date date [note: 'The date from which this hurdle rate arrangement becomes active and applicable.']
  escrow_percentage decimal(5,4) [note: 'Percentage of carried interest distributions held in escrow to cover potential clawback obligations. Null if no escrow applies.']
  expiration_date date [note: 'The date on which this hurdle rate arrangement ceases to be applicable. Null for open-ended arrangements.']
  high_water_mark_flag boolean [note: 'Indicates whether a high water mark provision applies, requiring losses to be recovered before new carry is earned.']
  hurdle_achieved_flag boolean [note: 'Indicates whether the hurdle rate has been achieved as of the last calculation date.']
  hurdle_basis varchar [note: 'The capital base against which the hurdle rate is calculated (e.g., committed capital, invested capital, paid-in capital, or net asset value).']
  hurdle_rate_name varchar [note: 'Business-friendly name or label for this hurdle rate arrangement.']
  hurdle_rate_status varchar [note: 'Current lifecycle status of the hurdle rate arrangement.']
  hurdle_reset_frequency varchar [note: 'Frequency at which the hurdle rate calculation resets or is re-evaluated.']
  hurdle_type varchar [note: 'Classification of hurdle rate structure: hard (catch-up after hurdle), soft (no catch-up), or blended (partial catch-up).']
  investment_strategy varchar [note: 'The specific investment strategy or sub-strategy associated with this hurdle rate (e.g., buyout, growth equity, value-add real estate).']
  last_calculation_date date [note: 'The most recent date on which hurdle rate achievement was calculated and evaluated.']
  lpa_reference varchar [note: 'Reference to the specific section or clause in the Limited Partnership Agreement that defines this hurdle rate arrangement.']
  measurement_period varchar [note: 'The time period over which the hurdle rate performance is measured and evaluated.']
  modified_timestamp timestamp [note: 'Timestamp when this hurdle rate record was last modified in the system.']
  notes varchar [note: 'Free-text field for additional comments, clarifications, or special conditions related to this hurdle rate arrangement.']
  percentage decimal(10,6) [note: 'The preferred return threshold percentage that must be achieved before carried interest is earned. Expressed as a decimal (e.g., 0.08 for 8%).']
  performance_fee_type varchar [note: 'Classification of the performance-based fee structure associated with this hurdle rate.']
  preferred_return_cumulative_flag boolean [note: 'Indicates whether unpaid preferred returns accumulate and must be satisfied in future periods before carry is earned.']
  record_version varchar [note: 'Version number of this hurdle rate record, incremented with each modification for audit trail purposes.']
  side_letter_flag boolean [note: 'Indicates whether this hurdle rate arrangement is subject to side letter modifications for specific Limited Partners.']
  tax_treatment_code varchar [note: 'Code indicating the tax treatment of carried interest under this hurdle rate arrangement (jurisdiction-specific).']
  vintage_year varchar [note: 'The year in which the fund or investment vehicle was established, used for cohort analysis and performance benchmarking.']

  Note: 'Master record tracking the preferred return (hurdle rate) applicable to each carried interest arrangement or fund structure. Captures hurdle rate percentage, compounding frequency (simple vs compound), hurdle basis (committed capital vs invested capital'
}

Table fee.clawback_provision {
  clawback_provision_id varchar [pk, note: 'Unique identifier for the clawback provision record within the carried interest arrangement.']
  carry_escrow_id varchar [note: 'Reference to the segregated escrow account holding withheld carried interest distributions to satisfy potential clawback obligations.']
  fund_id varchar [note: 'Reference to the private equity or alternative investment fund to which this clawback provision applies.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity subject to the clawback obligation under this provision.']
  calculation_frequency varchar [note: 'Frequency at which clawback obligation is recalculated: per distribution (each carry payment), annual (yearly true-up), fund liquidation (final settlement only), deal exit (per investment realization), or continuous (real-time monitoring).']
  carry_percent decimal(5,2) [note: 'General Partner (GP) carried interest percentage (typically 20 percent) of fund profits after hurdle and catch-up; basis for calculating maximum clawback obligation.']
  clawback_calculation_method varchar [note: 'Methodology used to compute clawback amount: Internal Rate of Return (IRR) based (comparing actual vs hurdle IRR), Multiple on Invested Capital (MOIC) based (comparing actual vs target multiple), Total Value to Paid-In (TVPI) based, hybrid (combination of']
  clawback_cap_percent decimal(5,2) [note: 'Maximum clawback obligation expressed as percentage of cumulative carried interest distributions; protects General Partner (GP) from unlimited liability (e.g., 100 percent cap means GP never owes more than carry received).']
  clawback_provision_status varchar [note: 'Current lifecycle status of the clawback provision: active (in force), suspended (temporarily inactive), waived (Limited Partners (LPs) waived enforcement), triggered (clawback event occurred), settled (obligation fulfilled), or expired (provision term']
  created_timestamp timestamp [note: 'Timestamp when this clawback provision record was first created in the system; used for audit trail and data lineage tracking.']
  cumulative_gp_distributions_amount decimal(18,2) [note: 'Total carried interest distributions (in fund base currency) paid to General Partner (GP) to date; basis for calculating maximum clawback exposure.']
  cumulative_lp_distributions_amount decimal(18,2) [note: 'Total distributions (in fund base currency) paid to Limited Partners (LPs) to date; used in waterfall calculations to determine if hurdle rate has been met.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this clawback provision record (e.g., USD, EUR, GBP); typically matches fund base currency.']
  current_clawback_liability_amount decimal(18,2) [note: 'Current estimated clawback liability (in fund base currency) owed by General Partner (GP) to Limited Partners (LPs) based on most recent calculation; may be negative (no liability) or positive (amount owed).']
  dispute_resolution_method varchar [note: 'Contractual method for resolving disputes related to clawback calculations or enforcement: arbitration (binding third-party decision), litigation (court proceedings), mediation (facilitated negotiation), or negotiation (direct party discussions).']
  effective_date date [note: 'Date on which this clawback provision becomes binding and enforceable under the Limited Partnership Agreement (LPA).']
  escrow_balance_amount decimal(18,2) [note: 'Current balance (in fund base currency) held in escrow account available to satisfy clawback obligations; updated with each carried interest distribution and clawback settlement.']
  escrow_percentage decimal(5,2) [note: 'Percentage of each carried interest distribution withheld in escrow account to fund potential clawback obligations; released to General Partner (GP) after clawback period expires.']
  expiration_date date [note: 'Date on which the clawback provision expires and the General Partner (GP) is released from further clawback obligations; typically tied to fund liquidation plus statute of limitations period.']
  fund_irr_percent decimal(7,4) [note: 'Current fund-level Internal Rate of Return (IRR) expressed as annualized percentage; compared against hurdle rate to determine clawback trigger status.']
  fund_moic decimal(7,4) [note: 'Current fund-level Multiple on Invested Capital (MOIC) ratio (total value divided by total invested capital); used in Multiple on Invested Capital (MOIC) based clawback calculations.']
  fund_tvpi decimal(7,4) [note: 'Current fund-level Total Value to Paid-In (TVPI) ratio (distributions plus residual Net Asset Value (NAV) divided by Paid-In Capital (PIC)); used in Total Value to Paid-In (TVPI) based clawback calculations.']
  gp_catch_up_percent decimal(5,2) [note: 'Percentage of distributions allocated to General Partner (GP) after hurdle is met and before final carried interest split, used in waterfall calculations to determine clawback exposure.']
  hurdle_rate_percent decimal(5,2) [note: 'Preferred return threshold (expressed as annual percentage) that Limited Partners (LPs) must achieve before General Partner (GP) participates in carried interest; clawback is triggered if final Internal Rate of Return (IRR) falls below this rate.']
  is_active boolean [note: 'Boolean flag indicating whether this clawback provision is currently active and enforceable (True) or has been terminated, expired, or superseded (False).']
  last_calculation_date date [note: 'Date of the most recent clawback obligation calculation and true-up analysis performed for this provision.']
  legal_jurisdiction varchar [note: 'Legal jurisdiction governing the enforcement and interpretation of this clawback provision, typically the fund domicile jurisdiction specified in Limited Partnership Agreement (LPA).']
  lookback_period_years varchar [note: 'Number of years after final fund liquidation during which Limited Partners (LPs) may enforce clawback claims; typically aligned with statute of limitations (e.g., 3 to 7 years).']
  lpa_section_reference varchar [note: 'Specific section, article, or clause reference in the Limited Partnership Agreement (LPA) document that defines this clawback provision (e.g., Article 7.3, Section 12.5).']
  maximum_clawback_amount decimal(18,2) [note: 'Maximum monetary amount (in fund base currency) that General Partner (GP) may be required to return to Limited Partners (LPs) under this provision; typically capped at total carried interest distributed to date.']
  next_calculation_date date [note: 'Scheduled date for the next clawback obligation calculation and true-up analysis based on calculation frequency and fund lifecycle events.']
  notes varchar [note: 'Free-text field for additional context, special conditions, amendments, or operational notes related to this clawback provision not captured in structured fields.']
  provision_name varchar [note: 'Business name or label for this clawback provision as referenced in fund documentation and Investment Committee (IC) materials.']
  provision_type varchar [note: 'Classification of the clawback mechanism: full clawback (entire carry subject to true-up), partial clawback (limited to specific percentage), rolling clawback (calculated periodically), deal-by-deal clawback (per investment basis), aggregate clawback']
  settlement_amount decimal(18,2) [note: 'Actual monetary amount (in fund base currency) paid by General Partner (GP) to Limited Partners (LPs) to settle clawback obligation; null if not yet settled.']
  settlement_date date [note: 'Actual date on which General Partner (GP) remitted clawback payment to Limited Partners (LPs) and satisfied the clawback obligation; null if not yet settled.']
  settlement_due_date date [note: 'Date by which General Partner (GP) must remit clawback payment to Limited Partners (LPs) following trigger event; typically 30 to 90 days after trigger or fund liquidation.']
  tax_treatment_code varchar [note: 'Tax classification code for clawback payments (e.g., return of capital, ordinary income, capital gain reversal) per applicable tax jurisdiction and Internal Revenue Service (IRS) or local tax authority guidance.']
  trigger_condition varchar [note: 'Detailed description of the condition(s) that activate the clawback obligation, such as final fund Internal Rate of Return (IRR) falling below hurdle rate, Total Value to Paid-In (TVPI) below threshold, or cumulative General Partner (GP) distributions']
  trigger_event_date date [note: 'Date on which the clawback trigger condition was met and clawback obligation became enforceable; null if provision has not been triggered.']
  updated_timestamp timestamp [note: 'Timestamp when this clawback provision record was last modified; used for audit trail and change tracking.']
  waiver_approval_date date [note: 'Date on which Limited Partners (LPs) formally approved a waiver or modification of this clawback provision; null if no waiver has been granted.']
  waiver_conditions varchar [note: 'Conditions under which Limited Partners (LPs) may waive or modify clawback obligations, such as Limited Partner (LP) vote threshold, Investment Committee (IC) approval, or specific performance criteria.']

  Note: 'Master record for GP clawback provisions embedded within carried interest arrangements. Captures clawback trigger conditions (GP over-distribution relative to final fund IRR), maximum clawback amount, clawback escrow percentage, clawback calculation'
}

Table fee.clawback_event {
  clawback_event_id varchar [pk, note: 'Unique identifier for the clawback event record.']
  carry_escrow_id varchar [note: 'Identifier of the escrow account from which clawback funds will be drawn if the payment method involves escrow release.']
  employee_id varchar [note: 'Identifier of the user or system process that created this clawback event record.']
  fund_id varchar [note: 'Identifier of the private equity or alternative investment fund in which the clawback event occurred.']
  gp_entity_id varchar [note: 'Identifier of the General Partner entity subject to the clawback obligation.']
  updated_by_user_employee_id varchar [note: 'Identifier of the user or system process that last modified this clawback event record.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Clawback events are triggered when fund performance falls below thresholds based on valuations.']
  auditor_verification_date date [note: 'Date on which the external auditor completed verification of the clawback calculation.']
  auditor_verified_flag boolean [note: 'Indicates whether the clawback calculation has been independently verified by the funds external auditor.']
  calculation_date date [note: 'Date on which the clawback amount was calculated based on final fund performance and carried interest waterfall reconciliation.']
  calculation_methodology varchar [note: 'Description of the calculation methodology applied to determine the clawback amount, referencing specific Limited Partnership Agreement provisions and waterfall logic.']
  carried_interest_distributed_amount decimal(18,2) [note: 'Total cumulative carried interest amount previously distributed to the General Partner prior to the clawback event.']
  carried_interest_entitled_amount decimal(18,2) [note: 'Final carried interest amount to which the General Partner is entitled based on actual fund performance and waterfall calculations.']
  carry_rate_percent decimal(5,4) [note: 'Percentage of profits above the hurdle rate to which the General Partner is entitled as carried interest, per the Limited Partnership Agreement.']
  clawback_cap_amount decimal(18,2) [note: 'Maximum clawback amount that can be enforced against the General Partner per the Limited Partnership Agreement clawback cap provisions.']
  clawback_cap_applied_flag boolean [note: 'Indicates whether the contractual clawback cap was applied to limit the clawback obligation in this event.']
  clawback_gross_amount decimal(18,2) [note: 'Gross clawback amount owed by the General Partner, calculated as the excess of distributed carried interest over entitled carried interest.']
  clawback_net_amount decimal(18,2) [note: 'Net clawback amount owed after applying any contractual adjustments, tax gross-ups, or offsets per the Limited Partnership Agreement.']
  created_timestamp timestamp [note: 'Timestamp when this clawback event record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the clawback amounts are denominated.']
  dispute_flag boolean [note: 'Indicates whether the General Partner has formally disputed the clawback calculation or obligation.']
  dispute_reason varchar [note: 'Detailed explanation provided by the General Partner for disputing the clawback event, including calculation disagreements or contractual interpretation.']
  dispute_resolution_date date [note: 'Date on which the clawback dispute was resolved through negotiation, arbitration, or other dispute resolution mechanism.']
  due_date date [note: 'Date by which the General Partner must remit the clawback amount to the fund or Limited Partners.']
  event_status varchar [note: 'Current lifecycle status of the clawback event in the resolution workflow. [ENUM-REF-CANDIDATE: triggered|calculated|notified|acknowledged|disputed|settled|paid|waived|cancelled — 9 candidates stripped; promote to reference product]']
  fund_irr_percent decimal(7,4) [note: 'Final Internal Rate of Return achieved by the fund at the time of clawback calculation, used to determine carried interest entitlement.']
  fund_moic decimal(7,4) [note: 'Final Multiple on Invested Capital achieved by the fund, representing total value divided by paid-in capital, used in clawback determination.']
  hurdle_rate_percent decimal(5,4) [note: 'Preferred return threshold percentage that Limited Partners must achieve before the General Partner is entitled to carried interest, used in clawback calculation.']
  legal_counsel_opinion_flag boolean [note: 'Indicates whether legal counsel has provided an opinion on the enforceability and calculation of the clawback obligation.']
  lp_capital_returned_amount decimal(18,2) [note: 'Total capital returned to Limited Partners at the time of clawback calculation, used to verify hurdle achievement and waterfall distribution.']
  lp_profit_distributed_amount decimal(18,2) [note: 'Total profit distributed to Limited Partners at the time of clawback calculation, used in carried interest waterfall reconciliation.']
  notes varchar [note: 'Free-text field for additional context, special circumstances, or administrative notes related to the clawback event.']
  notification_date date [note: 'Date on which the General Partner was formally notified of the clawback obligation.']
  number varchar [note: 'Business identifier or reference number assigned to this clawback event for tracking and reporting purposes.']
  offset_amount decimal(18,2) [note: 'Amount offset against the clawback obligation due to management fee rebates, expense reimbursements, or other contractual adjustments.']
  payment_method varchar [note: 'Method by which the General Partner will satisfy the clawback obligation, such as cash payment or release from escrow account.']
  settlement_date date [note: 'Actual date on which the clawback obligation was settled or paid by the General Partner.']
  tax_gross_up_amount decimal(18,2) [note: 'Additional amount added to the clawback obligation to account for tax liabilities incurred by the General Partner on previously distributed carried interest.']
  trigger_date date [note: 'Date on which the clawback event was triggered, typically at fund liquidation or final distribution when carried interest calculations are finalized.']
  trigger_reason varchar [note: 'Business reason or event that triggered the clawback calculation, such as fund liquidation or final performance reconciliation.']
  updated_timestamp timestamp [note: 'Timestamp when this clawback event record was last modified in the system.']
  waiver_approval_date date [note: 'Date on which the Limited Partner Advisory Committee or governing body approved the clawback waiver.']
  waiver_flag boolean [note: 'Indicates whether the Limited Partners or fund administrator waived the clawback obligation in whole or in part.']
  waiver_reason varchar [note: 'Business justification for waiving the clawback obligation, such as immateriality, GP relationship considerations, or administrative burden.']

  Note: 'Transactional record of a clawback event triggered against a GP when carried interest distributions exceed the GP\'s entitlement based on final fund performance.'
}

Table fee.accrual {
  accrual_id varchar [pk, note: 'Unique identifier for the fee accrual record. Primary key for the accrual entity.']
  employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who approved the accrual for posting. Supports audit trail and governance requirements.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external General Partner (GP) or fund manager when the accrual relates to an externally managed mandate or fund investment.']
  gp_profile_id varchar [note: 'Reference to the external General Partner (GP) or fund manager when the accrual relates to an externally managed mandate or fund investment.']
  investment_id varchar [note: 'Reference to the investment (fund, mandate, direct investment, or co-investment) for which the fee is being accrued.']
  accrual_status varchar [note: 'Current state of the accrual in its approval and posting workflow: draft (initial calculation), pending approval (awaiting IC or finance review), approved (ready to post), posted (recorded in GL), reversed, or cancelled.']
  adjustment_amount decimal(18,2) [note: 'Manual or system-generated adjustment to the accrual, such as true-up adjustments for prior period corrections, catch-up accruals, or Investment Committee (IC) approved modifications.']
  approval_date date [note: 'The date on which the accrual was approved by the Investment Committee (IC), finance controller, or authorized approver, allowing it to be posted to the General Ledger (GL).']
  basis varchar [note: 'The base metric used to calculate the fee accrual: Assets Under Management (AUM), Net Asset Value (NAV), committed capital, Paid-In Capital (PIC), Gross Asset Value (GAV), or transaction value for deal-specific fees.']
  basis_amount decimal(20,2) [note: 'The dollar value of the basis metric (AUM, NAV, committed capital, etc.) used to compute the fee accrual for this period. Denominated in the fund or mandate base currency.']
  benchmark_fee_rate_percent decimal(7,4) [note: 'The market benchmark or peer median fee rate for this fee type and asset class, used for fee transparency reporting and external manager fee benchmarking. Sourced from Preqin, PitchBook, or industry surveys.']
  calculation_method varchar [note: 'The methodology used to determine the accrual basis amount: average balance over the period, end-of-period snapshot, beginning-of-period snapshot, daily average, or transaction-based for deal fees.']
  calculation_timestamp timestamp [note: 'The date and time when the accrual calculation was performed by the Investment Book of Record (IBOR) or accounting system. Supports audit trail and version control for recalculations.']
  catch_up_rate_percent decimal(7,4) [note: 'The rate at which the General Partner (GP) catches up to their full carried interest share after the hurdle is met, typically 100% until the GP reaches their target carry allocation. Null for non-carry fee types.']
  clawback_provision_flag boolean [note: 'Indicates whether this accrual is subject to clawback provisions, where the General Partner (GP) may be required to return previously distributed carried interest if final fund performance falls below the hurdle rate.']
  cost_center_code varchar [note: 'The cost center or business unit code for internal allocation and reporting of the fee expense, enabling performance attribution and cost transparency by investment strategy or asset class.']
  created_timestamp timestamp [note: 'The date and time when this accrual record was first created in the data platform. Supports audit trail and data lineage tracking.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the accrual amounts (e.g., USD, EUR, GBP). Typically matches the base currency of the fund or mandate.']
  fee_rebate_amount decimal(18,2) [note: 'Any rebate or offset applied to the gross accrual, such as General Partner (GP) fee rebates on co-investments or transaction fee offsets negotiated in the Limited Partnership Agreement (LPA).']
  fee_type varchar [note: 'Classification of the fee being accrued: management fee (ongoing asset-based fee), carried interest (GP profit share above hurdle), performance fee (incentive-based), transaction fee (deal-specific), advisory fee, or administration fee.']
  fee_variance_percent decimal(7,4) [note: 'The variance between the accrued fee rate and the benchmark fee rate, expressed as a percentage. Positive values indicate fees above market; negative values indicate favorable negotiated rates.']
  frequency varchar [note: 'The frequency at which this fee type is accrued: monthly, quarterly (most common for management fees), semi-annually, annually, or event-driven (for transaction fees).']
  gl_account_code varchar [note: 'The General Ledger account code to which this accrual is posted in the corporate accounting system (e.g., Oracle Financials). Typically an expense account for management fees or a liability account for carried interest.']
  gross_accrual_amount decimal(18,2) [note: 'The gross fee amount accrued for the period before any adjustments, rebates, or offsets. Calculated as accrual_basis_amount multiplied by accrual_rate_percent, pro-rated for the period.']
  hurdle_rate_percent decimal(7,4) [note: 'The preferred return threshold that must be achieved before carried interest accrues to the General Partner (GP). Expressed as an annualized percentage (e.g., 8.0000 for 8%). Null for non-carry fee types.']
  last_modified_timestamp timestamp [note: 'The date and time when this accrual record was last updated in the data platform. Supports change tracking and audit trail for corrections or adjustments.']
  net_accrual_amount decimal(18,2) [note: 'The final net fee amount accrued for the period after applying all rebates and adjustments. This is the amount posted to the General Ledger (GL) and reflected in Net Asset Value (NAV) calculations.']
  notes varchar [note: 'Free-text field for additional context, explanations, or special instructions related to the accrual, such as non-standard calculation methods, Investment Committee (IC) guidance, or reconciliation notes.']
  number varchar [note: 'Human-readable business identifier for the accrual record, typically generated by the Investment Book of Record (IBOR) or accounting system.']
  period_end_date date [note: 'End date of the period for which the fee is being accrued, typically the last day of the calendar quarter or month. Defines the measurement window for Assets Under Management (AUM) or Net Asset Value (NAV) calculations.']
  period_start_date date [note: 'Start date of the period for which the fee is being accrued, typically the first day of the calendar quarter or month depending on fee calculation frequency.']
  posting_date date [note: 'The date on which the accrual was posted to the General Ledger (GL) and reflected in the Net Asset Value (NAV) calculation. Typically the last business day of the accrual period.']
  rate_percent decimal(7,4) [note: 'The annualized fee rate applied to the accrual basis, expressed as a percentage. For example, a 1.50% management fee or 20% carried interest rate. Stored as decimal (e.g., 1.5000 for 1.5%).']
  reversal_date date [note: 'The date on which the accrual was reversed, typically due to an error correction, true-up adjustment, or cancellation of the underlying investment or mandate. Null if the accrual has not been reversed.']
  reversal_reason varchar [note: 'Free-text explanation for why the accrual was reversed, such as calculation error, mandate termination, or Investment Committee (IC) decision. Null if the accrual has not been reversed.']
  source_system_reference varchar [note: 'The unique identifier or transaction reference for this accrual in the source system (e.g., SimCorp transaction ID, Aladdin accrual batch ID), enabling reconciliation and audit trail back to the system of record.']
  waterfall_tier varchar [note: 'Identifier for the tier or tranche in a multi-tier carried interest waterfall structure (e.g., Tier 1, Tier 2, Tier 3), where different hurdle rates and carry percentages apply at different return levels. Null for non-carry fee types.']

  Note: 'Transactional record of periodic fee accruals computed for management fees, carried interest, and other investment-related fees. Captures accrual period (start/end date), fee type, accrual basis (AUM, NAV, committed capital), accrual rate applied, gross'
}

Table fee.payment {
  payment_id varchar [pk, note: 'Unique identifier for the fee payment transaction.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) receiving the payment.']
  fund_id varchar [note: 'Reference to the fund or investment vehicle from which the payment is made.']
  gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) receiving the payment.']
  investment_id varchar [note: 'Reference to the specific investment or mandate associated with this payment.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Fee payment reconciliation requires mandate-level attribution for SLA compliance monitoring, fee schedule validation, and contractual payment term verification per LPA.']
  settlement_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Fee payment settlement process requires routing to specific treasury cash accounts. Cash management teams need this link for daily cash positioning, payment execution, and']
  settlement_instruction_id varchar [note: 'Reference to the payment instruction or settlement instruction (SSI) used for this disbursement.']
  approval_date date [note: 'Date on which the payment was approved by the authorized signatory or Investment Committee (IC).']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the payment.']
  base_currency_code varchar [note: 'Three-letter ISO 4217 currency code representing the funds base or reporting currency.']
  base_currency_gross_amount decimal(18,2) [note: 'Gross payment amount converted to the funds base currency using the FX rate.']
  base_currency_net_amount decimal(18,2) [note: 'Net payment amount converted to the funds base currency using the FX rate.']
  beneficiary_account_number varchar [note: 'Bank account number of the external manager or GP receiving the payment.']
  beneficiary_bank_bic varchar [note: 'Bank Identifier Code (BIC) or SWIFT code of the beneficiary bank.']
  beneficiary_bank_name varchar [note: 'Name of the bank receiving the payment on behalf of the external manager or GP.']
  clawback_amount decimal(18,2) [note: 'Amount clawed back or withheld from the payment due to clawback provisions in the LPA.']
  clawback_provision_applied boolean [note: 'Boolean flag indicating whether a clawback provision was applied to reduce this payment.']
  cost_center_code varchar [note: 'Cost center or business unit code to which this payment is allocated.']
  created_timestamp timestamp [note: 'Timestamp when the payment record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the payment was made (e.g., USD, EUR, GBP).']
  due_date date [note: 'Contractual due date by which the payment must be made per the Limited Partnership Agreement (LPA) or mandate terms.']
  fee_period_end_date date [note: 'End date of the period for which this fee payment applies.']
  fee_period_start_date date [note: 'Start date of the period for which this fee payment applies.']
  fee_type varchar [note: 'Classification of the fee being paid: management fee, carried interest (carry), transaction fee, monitoring fee, advisory fee, or performance fee.']
  fx_rate decimal(18,8) [note: 'Exchange rate applied to convert payment currency to base currency at the time of payment.']
  gl_account_code varchar [note: 'General ledger account code to which this payment is posted for accounting purposes.']
  gross_payment_amount decimal(18,2) [note: 'Total fee amount before any deductions, withholdings, or adjustments.']
  hurdle_rate_met boolean [note: 'Boolean flag indicating whether the preferred return hurdle rate was met for carried interest payments.']
  invoice_date date [note: 'Date on which the invoice or fee statement was issued by the external manager or GP.']
  invoice_number varchar [note: 'Reference number of the invoice or fee statement associated with this payment.']
  is_late_payment boolean [note: 'Boolean flag indicating whether the payment was made after the contractual due date.']
  last_modified_timestamp timestamp [note: 'Timestamp when the payment record was last updated or modified.']
  late_payment_penalty_amount decimal(18,2) [note: 'Amount of penalty or interest charged for late payment, if applicable per LPA terms.']
  method varchar [note: 'Method or instrument used to disburse the payment (e.g., wire transfer, ACH, check, SWIFT, SEPA).']
  net_payment_amount decimal(18,2) [note: 'Final net amount disbursed to the recipient after all deductions and withholdings.']
  notes varchar [note: 'Additional notes, comments, or special instructions related to the payment transaction.']
  other_deductions_amount decimal(18,2) [note: 'Total amount of other deductions applied to the payment, such as clawback provisions, fee rebates, or adjustments.']
  payment_date date [note: 'The date on which the fee payment was disbursed to the recipient.']
  payment_description varchar [note: 'Detailed description or narrative of the payment, including purpose and any special terms or conditions.']
  payment_status varchar [note: 'Current lifecycle status of the payment transaction. [ENUM-REF-CANDIDATE: pending|approved|disbursed|settled|cancelled|failed|reversed — 7 candidates stripped; promote to reference product]']
  reconciliation_date date [note: 'Date on which the payment was successfully reconciled with bank and custodian records.']
  reconciliation_status varchar [note: 'Status of the payment reconciliation process against bank statements and custodian records.']
  reference_number varchar [note: 'External reference number or transaction identifier for the payment, used for reconciliation and audit trail.']
  settlement_date date [note: 'Date on which the payment was settled and funds were received by the beneficiary.']
  vintage_year varchar [note: 'The year in which the fund or investment commitment was made, used for performance tracking and benchmarking.']
  withholding_tax_amount decimal(18,2) [note: 'Amount of withholding tax deducted from the gross payment per applicable tax treaties and regulations.']
  withholding_tax_rate decimal(5,4) [note: 'Percentage rate of withholding tax applied to the gross payment, expressed as a decimal (e.g., 0.15 for 15%).']

  Note: 'Transactional record of actual fee payments disbursed to external managers, GPs, or service providers. Captures payment date, fee type (management fee, carried interest, transaction fee, monitoring fee), gross payment amount, withholding tax deducted, net'
}

Table fee.invoice {
  invoice_id varchar [pk, note: 'Unique identifier for the fee invoice record. Primary key.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) who issued this invoice.']
  gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) who issued this invoice.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate or Limited Partnership Agreement (LPA) under which this fee is charged.']
  accrual_date date [note: 'Date the fee expense was accrued in the accounting system, typically at period end.']
  approval_date date [note: 'Date the invoice was approved for payment by internal finance or investment operations.']
  approved_by varchar [note: 'Name or identifier of the individual who approved the invoice for payment.']
  base_amount decimal(20,4) [note: 'Base calculation amount (e.g., Assets Under Management, committed capital, or Net Asset Value) used to compute the fee.']
  benchmark_fee_rate_bps decimal(10,4) [note: 'Industry benchmark fee rate in basis points (bps) for comparison and fee transparency reporting.']
  carry_rate_pct decimal(8,4) [note: 'Carried interest (carry) rate percentage applied to profits above the hurdle rate for performance fee calculation.']
  clawback_provision_flag boolean [note: 'Indicates whether a clawback provision applies to this invoice, requiring the General Partner (GP) to return excess carried interest if final returns fall below the hurdle.']
  cost_center_code varchar [note: 'Cost center code for internal allocation and reporting of fee expenses.']
  created_timestamp timestamp [note: 'Timestamp when this invoice record was first created in the fee administration system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the invoice amounts (e.g., USD, EUR, GBP).']
  dispute_date date [note: 'Date the invoice was flagged as disputed.']
  dispute_reason varchar [note: 'Reason for disputing the invoice, if payment status is disputed.']
  due_date date [note: 'Payment due date specified by the external manager or General Partner (GP).']
  fee_basis varchar [note: 'Basis on which the fee is calculated: Assets Under Management (AUM), committed capital, Net Asset Value (NAV), transaction value, or fixed amount.']
  fee_rate_bps decimal(10,4) [note: 'Fee rate expressed in basis points (bps) applied to the base amount. One basis point equals 0.01%.']
  fee_type varchar [note: 'Classification of the fee being invoiced: management fee, performance fee (carried interest), monitoring fee, transaction fee, advisory fee, or administration fee.']
  fee_variance_bps decimal(10,4) [note: 'Variance between the invoiced fee rate and the benchmark fee rate, expressed in basis points (bps).']
  gl_account_code varchar [note: 'General Ledger (GL) account code to which this fee expense is posted in the corporate accounting system.']
  gross_fee_amount decimal(18,2) [note: 'Gross fee amount before any adjustments, rebates, or taxes.']
  hurdle_rate_pct decimal(8,4) [note: 'Preferred return threshold (hurdle rate) percentage that must be achieved before performance fees or carried interest are payable.']
  invoice_date date [note: 'Date the invoice was issued by the external manager or General Partner (GP).']
  invoice_description varchar [note: 'Detailed description or narrative provided by the external manager or General Partner (GP) explaining the fee invoice.']
  invoicing_entity_lei varchar [note: 'Legal Entity Identifier (LEI) of the General Partner (GP) or external manager entity issuing the invoice.']
  invoicing_entity_name varchar [note: 'Legal name of the General Partner (GP) or external manager entity issuing the invoice.']
  modified_timestamp timestamp [note: 'Timestamp when this invoice record was last modified in the fee administration system.']
  net_fee_amount decimal(18,2) [note: 'Net fee amount payable after rebates and taxes. This is the final amount due to the external manager or General Partner (GP).']
  number varchar [note: 'External invoice number assigned by the General Partner (GP) or external manager for tracking and reconciliation.']
  payment_date date [note: 'Actual date the invoice was paid to the external manager or General Partner (GP).']
  payment_reference varchar [note: 'Payment reference or transaction identifier used for reconciliation with treasury and cash management systems.']
  payment_status varchar [note: 'Current payment status of the invoice: pending review, approved for payment, paid, disputed, cancelled, or overdue.']
  period_end_date date [note: 'End date of the period covered by this fee invoice.']
  period_start_date date [note: 'Start date of the period covered by this fee invoice.']
  rebate_amount decimal(18,2) [note: 'Fee rebate or discount amount applied by the General Partner (GP) or external manager, reducing the gross fee.']
  received_timestamp timestamp [note: 'Timestamp when the invoice was received by the pension fund from the external manager or General Partner (GP).']
  resolution_date date [note: 'Date the dispute was resolved and the invoice was either approved or cancelled.']
  source_document_uri varchar [note: 'Uniform Resource Identifier (URI) or file path to the original invoice document (PDF, email) stored in the document management system.']
  tax_amount decimal(18,2) [note: 'Tax amount (e.g., Value Added Tax, Goods and Services Tax) applied to the fee invoice.']
  waterfall_tier varchar [note: 'Waterfall tier or tranche identifier for multi-tier carried interest structures (e.g., Tier 1, Tier 2).']

  Note: 'Transactional record of fee invoices received from external managers or GPs for management fees, monitoring fees, and other mandate-related charges. Captures invoice date, invoice number, invoicing entity (GP/manager LEI), invoice period, fee type'
}

Table fee.transaction_fee {
  transaction_fee_id varchar [pk, note: 'Unique identifier for the transaction fee record.']
  counterparty_id varchar [note: 'Reference to the external advisor or intermediary entity that charged this fee (investment bank, consultant, legal advisor).']
  deal_opportunity_id varchar [note: 'Reference to the private market investment deal or transaction that generated this fee.']
  gp_entity_id varchar [note: 'Reference to the GP or external manager entity that charged or received this transaction fee.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Transaction fees must be attributed to GP profiles for management fee offset calculations per LPA terms and ILPA fee transparency reporting requirements.']
  investment_id varchar [note: 'Reference to the underlying investment position associated with this transaction fee.']
  opportunity_id varchar [note: 'Reference to the private market investment deal or transaction that generated this fee.']
  accrual_date date [note: 'Date on which the fee was accrued in the accounting records.']
  allocation_method varchar [note: 'Method by which the transaction fee is allocated across multiple LPs or investment vehicles if applicable.']
  benchmark_rate_percent decimal(8,5) [note: 'Industry benchmark or peer median fee rate for this type of transaction, used for fee reasonableness assessment.']
  capitalized_flag boolean [note: 'Indicates whether the transaction fee was capitalized as part of the investment cost basis rather than expensed.']
  cost_center_code varchar [note: 'Internal cost center or business unit code responsible for this transaction fee.']
  created_timestamp timestamp [note: 'Timestamp when this transaction fee record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the transaction fee is denominated.']
  dispute_flag boolean [note: 'Indicates whether this transaction fee is under dispute or subject to challenge by the LP or IC.']
  dispute_reason varchar [note: 'Explanation of the reason for disputing the transaction fee, if applicable.']
  dispute_resolution_date date [note: 'Date on which the fee dispute was resolved or settled.']
  due_date date [note: 'Date by which the transaction fee payment is contractually due.']
  fee_basis varchar [note: 'The valuation or capital base upon which the transaction fee calculation is determined.']
  fee_category varchar [note: 'High-level categorization of the fee for reporting and benchmarking purposes.']
  fee_gross_amount decimal(18,2) [note: 'Gross transaction fee amount before any offsets, rebates, or adjustments.']
  fee_net_amount decimal(18,2) [note: 'Net transaction fee amount payable after rebates and offsets, representing the actual economic cost to the fund.']
  fee_number varchar [note: 'Business identifier or invoice number for this transaction fee as assigned by the charging party.']
  fee_rate_percent decimal(8,5) [note: 'Percentage rate applied to the transaction value to calculate the fee, if fee is rate-based.']
  fee_status varchar [note: 'Current lifecycle status of the transaction fee in the payment and settlement process.']
  fee_type varchar [note: 'Classification of the transaction fee by its purpose in the deal lifecycle. [ENUM-REF-CANDIDATE: acquisition|disposition|financing|monitoring|advisory|legal|due_diligence — 7 candidates stripped; promote to reference product]']
  gl_account_code varchar [note: 'General ledger account code to which this transaction fee is posted in the accounting system.']
  ic_approval_date date [note: 'Date on which the Investment Committee approved the transaction fee.']
  ic_approval_flag boolean [note: 'Indicates whether this transaction fee was reviewed and approved by the Investment Committee.']
  invoice_date date [note: 'Date on which the fee invoice was issued by the charging party.']
  lpa_reference_clause varchar [note: 'Specific clause or section in the LPA that governs this transaction fee and its treatment.']
  notes varchar [note: 'Free-form notes or comments regarding the transaction fee, including special circumstances or approvals.']
  payment_date date [note: 'Actual date on which the transaction fee was paid or settled.']
  payment_method varchar [note: 'Method by which the transaction fee was or will be paid to the charging party.']
  payment_reference_number varchar [note: 'Bank or treasury reference number for the fee payment transaction.']
  rebate_amount decimal(18,2) [note: 'Amount of fee rebate or offset credited back to the LP from the GP under the LPA terms.']
  rebate_policy_flag boolean [note: 'Indicates whether this fee is subject to GP rebate or offset provisions under the LPA.']
  service_description varchar [note: 'Detailed description of the services rendered by the GP or advisor in connection with this transaction fee.']
  tax_treatment varchar [note: 'Tax classification of the transaction fee for corporate tax and LP tax reporting purposes.']
  transaction_date date [note: 'Date on which the underlying investment transaction occurred that triggered this fee.']
  transaction_value_amount decimal(18,2) [note: 'Total value of the underlying investment transaction used as the basis for calculating the fee.']
  updated_timestamp timestamp [note: 'Timestamp when this transaction fee record was last modified in the system.']
  variance_to_benchmark_bps decimal(8,2) [note: 'Difference in basis points between the actual fee rate and the benchmark rate, used for cost monitoring.']
  waiver_approval_date date [note: 'Date on which the fee waiver was formally approved by the GP or IC.']
  waiver_flag boolean [note: 'Indicates whether the transaction fee was waived by the GP or advisor.']
  waiver_reason varchar [note: 'Explanation of the business rationale for waiving the transaction fee.']

  Note: 'Transactional record of deal-level transaction fees charged by GPs or advisors in connection with private market investment transactions (acquisition fees, disposition fees, financing fees, monitoring fees).'
}

Table fee.gp_fee_rebate {
  gp_fee_rebate_id varchar [pk, note: 'Unique identifier for the GP fee rebate record.']
  counterparty_id varchar [note: 'Reference to the third-party fund administrator responsible for processing this rebate.']
  fund_id varchar [note: 'Reference to the private equity or alternative investment fund to which this rebate applies.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity responsible for the rebate.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Fee rebates require GP profile linkage for tracking rebate entitlements, MFN clause compliance, and management fee offset reconciliation per mandate terms.']
  lpa_terms_id varchar [note: 'Reference to the Limited Partnership Agreement governing the rebate terms.']
  portfolio_company_id varchar [note: 'Reference to the portfolio company that generated the underlying fee subject to rebate, if applicable.']
  transaction_fee_id varchar [note: 'Reference to the specific investment transaction that generated the fee subject to rebate, if applicable.']
  transaction_transaction_fee_id varchar [note: 'Reference to the specific investment transaction that generated the fee subject to rebate, if applicable.']
  application_date date [note: 'Date on which the rebate was applied to the management fee invoice or accrual.']
  approval_date date [note: 'Date on which the rebate was formally approved.']
  approval_required_flag boolean [note: 'Indicates whether this rebate requires Investment Committee or senior management approval before application.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the rebate.']
  auditor_verification_date date [note: 'Date on which the auditor completed verification of the rebate calculation.']
  auditor_verified_flag boolean [note: 'Indicates whether the rebate calculation has been verified by an external auditor.']
  calculation_date date [note: 'Date on which the rebate amount was calculated.']
  calculation_methodology varchar [note: 'Description of the methodology used to calculate the rebate, including formulas and LPA references.']
  created_timestamp timestamp [note: 'Timestamp when this rebate record was first created in the system.']
  cumulative_rebate_amount decimal(18,2) [note: 'Cumulative total of all rebates applied to date for this fund and GP relationship.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this rebate record.']
  dispute_flag boolean [note: 'Indicates whether the rebate calculation or application is under dispute by the GP or LP.']
  dispute_reason varchar [note: 'Description of the reason for the dispute, if applicable.']
  dispute_resolution_date date [note: 'Date on which the dispute was resolved, if applicable.']
  effective_date date [note: 'Date from which the rebate becomes effective and is applied to management fee calculations.']
  gross_fee_amount decimal(18,2) [note: 'Total gross amount of the fee earned by the GP before rebate application.']
  lpa_section_reference varchar [note: 'Specific section or clause in the LPA that governs this rebate provision.']
  management_fee_offset_amount decimal(18,2) [note: 'Amount by which the management fee is reduced as a result of this rebate.']
  notes varchar [note: 'Free-text field for additional comments, clarifications, or special instructions related to the rebate.']
  rebate_adjustment_amount decimal(18,2) [note: 'Any adjustment applied to the gross rebate amount due to timing differences, prior period corrections, or other factors.']
  rebate_cap_amount decimal(18,2) [note: 'Maximum rebate amount allowed per LPA terms, if applicable.']
  rebate_cap_applied_flag boolean [note: 'Indicates whether the rebate cap was reached and applied to limit the rebate amount.']
  rebate_gross_amount decimal(18,2) [note: 'Gross rebate amount calculated before any adjustments or offsets.']
  rebate_net_amount decimal(18,2) [note: 'Net rebate amount after all adjustments, representing the final offset to management fees.']
  rebate_number varchar [note: 'Business identifier for the rebate transaction, typically assigned by the fund administrator or internal system.']
  rebate_percentage decimal(5,4) [note: 'Percentage of the gross fee to be rebated to the fund as specified in the LPA, expressed as a decimal (e.g., 0.8000 for 80%).']
  rebate_status varchar [note: 'Current lifecycle status of the rebate record.']
  rebate_type varchar [note: 'Classification of the rebate based on the type of fee being offset as defined in the LPA.']
  reporting_period_end_date date [note: 'End date of the reporting period to which this rebate applies.']
  reporting_period_start_date date [note: 'Start date of the reporting period to which this rebate applies.']
  source_system_record_code varchar [note: 'Unique identifier of this rebate record in the source operational system.']
  updated_timestamp timestamp [note: 'Timestamp when this rebate record was last modified.']

  Note: 'Master record tracking GP fee rebates and offsets applied to management fees as required under LPA terms. Captures rebate type (transaction fee offset, monitoring fee offset, advisory fee offset), rebate percentage per LPA, gross rebate amount earned in'
}

Table fee.carry_distribution {
  carry_distribution_id varchar [pk, note: 'Unique identifier for the carried interest distribution transaction.']
  carry_escrow_id varchar [note: 'Reference to the escrow account holding clawback reserves, if applicable.']
  escrow_account_carry_escrow_id varchar [note: 'Reference to the escrow account holding clawback reserves, if applicable.']
  fund_id varchar [note: 'Reference to the private equity fund or investment vehicle from which the carry is distributed.']
  gp_entity_id varchar [note: 'Reference to the general partner entity receiving the carried interest distribution.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Carry distributions need GP profile attribution for performance fee transparency reporting to pension beneficiaries and manager performance evaluation.']
  investment_id varchar [note: 'Reference to the specific underlying investment that triggered this carry distribution event.']
  settlement_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Carried interest distributions to GPs require treasury cash account for payment execution.']
  approval_date date [note: 'Date on which the carry distribution was approved by the investment committee or authorized body.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the carry distribution.']
  auditor_verification_date date [note: 'Date on which the auditor completed verification of the carry distribution calculation.']
  auditor_verified_flag boolean [note: 'Indicates whether the carry distribution calculation has been verified by an independent auditor.']
  calculation_methodology varchar [note: 'Methodology used to calculate carry eligibility: deal-by-deal, whole fund, or hybrid approach.']
  carry_gross_amount decimal(20,2) [note: 'Gross carried interest amount calculated before any catch-up provisions or adjustments.']
  carry_net_amount decimal(20,2) [note: 'Net carried interest distributed to the general partner after all adjustments and provisions.']
  carry_rate_percent decimal(5,2) [note: 'Percentage of profits allocated to the general partner as carried interest, typically 20 percent.']
  catch_up_amount decimal(20,2) [note: 'Additional amount allocated to the general partner under catch-up provisions to achieve target carry split.']
  clawback_reserve_amount decimal(20,2) [note: 'Amount withheld from this distribution and held in reserve to cover potential future clawback obligations.']
  created_timestamp timestamp [note: 'Timestamp when this carry distribution record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this distribution.']
  distribution_date date [note: 'Date on which the carried interest distribution was paid to the general partner.']
  distribution_number varchar [note: 'Business identifier for the carry distribution transaction, typically sequential within a fund.']
  distribution_status varchar [note: 'Current lifecycle status of the carry distribution transaction.']
  fund_irr_percent decimal(7,4) [note: 'Fund-level internal rate of return at the time of this distribution, used for carry eligibility determination.']
  fund_moic decimal(7,4) [note: 'Fund-level multiple on invested capital at the time of this distribution.']
  gross_proceeds_amount decimal(20,2) [note: 'Total proceeds realized from the investment event before any deductions or allocations.']
  hurdle_rate_percent decimal(5,2) [note: 'Minimum annualized return threshold that must be achieved before carry is distributed to the general partner.']
  investment_irr_percent decimal(7,4) [note: 'Investment-level internal rate of return for the specific asset that generated this distribution.']
  investment_moic decimal(7,4) [note: 'Investment-level multiple on invested capital for the specific asset that generated this distribution.']
  lpa_reference_section varchar [note: 'Specific section or clause in the limited partnership agreement governing this carry distribution.']
  modified_timestamp timestamp [note: 'Timestamp when this carry distribution record was last modified.']
  net_distribution_amount decimal(20,2) [note: 'Final net amount distributed to the general partner after all reserves, withholdings, and adjustments.']
  notes varchar [note: 'Additional comments or contextual information regarding the carry distribution transaction.']
  payment_method varchar [note: 'Method used to transfer the carry distribution to the general partner.']
  payment_reference_number varchar [note: 'Bank or treasury reference number for the payment transaction.']
  preferred_return_amount decimal(20,2) [note: 'Cumulative preferred return (hurdle rate) paid to limited partners before carry is distributed.']
  profit_split_amount decimal(20,2) [note: 'Total profit available for distribution after return of capital and preferred return have been satisfied.']
  realization_date date [note: 'Date on which the underlying investment realization event occurred.']
  realization_event_type varchar [note: 'Type of liquidity event that triggered the carry distribution.']
  return_of_capital_amount decimal(20,2) [note: 'Portion of proceeds representing return of original invested capital to limited partners.']
  tax_withholding_amount decimal(20,2) [note: 'Amount withheld for tax purposes from the gross carry distribution.']
  waterfall_tier varchar [note: 'Tier within the carry waterfall structure from which this distribution was paid, reflecting performance thresholds.']

  Note: 'Transactional record of carried interest distributions paid to a GP following a realized investment event (exit, recapitalization, IPO). Captures distribution date, fund/vehicle reference, realized proceeds, return of capital amount, preferred return'
}

Table fee.carry_escrow {
  carry_escrow_id varchar [pk, note: 'Unique identifier for the carried interest escrow account record. Primary key for the carry_escrow product.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Carry escrow reserves are held in treasury-managed cash accounts for potential clawback obligations.']
  counterparty_id varchar [note: 'Reference to the financial institution or escrow agent holding the carried interest escrow funds.']
  fund_id varchar [note: 'Reference to the private equity or alternative investment fund for which this escrow account was established.']
  gp_entity_id varchar [note: 'Reference to the General Partner legal entity subject to potential clawback obligations secured by this escrow.']
  auditor_verified_flag boolean [note: 'Indicates whether the escrow account balance and calculations have been verified by external auditors as part of fund audit procedures.']
  clawback_amount_applied decimal(18,2) [note: 'Total amount drawn from this escrow account to satisfy clawback obligations to LPs.']
  clawback_triggered_flag boolean [note: 'Indicates whether a clawback event has been triggered requiring funds from this escrow account to be returned to Limited Partners (LPs).']
  created_timestamp timestamp [note: 'System timestamp indicating when this escrow account record was first created in the data platform.']
  cumulative_carry_distributed_amount decimal(18,2) [note: 'Total carried interest distributed to the GP since fund inception, used to calculate the escrow withholding base.']
  cumulative_escrow_withheld_amount decimal(18,2) [note: 'Total amount withheld in escrow across all carried interest distributions to date for this fund and GP.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the escrow amount (e.g., USD, EUR, GBP).']
  dispute_description varchar [note: 'Detailed description of the nature of the dispute affecting the escrow account, including parties involved and contested amounts.']
  dispute_flag boolean [note: 'Indicates whether the escrow account is subject to a dispute between GP and LPs regarding clawback calculations or release terms.']
  dispute_resolution_date date [note: 'Date on which the dispute was formally resolved, allowing escrow operations to resume per the resolution terms.']
  escrow_account_name varchar [note: 'Legal name or title of the escrow account as registered with the custodian or escrow agent.']
  escrow_account_number varchar [note: 'External bank or custodian account number for the escrow account holding the carried interest funds.']
  escrow_amount decimal(18,2) [note: 'Total monetary value of carried interest distributions currently held in escrow to secure potential clawback obligations.']
  escrow_percentage decimal(5,2) [note: 'Percentage of gross carried interest distributions withheld in escrow, typically ranging from 10% to 50% per LPA provisions.']
  escrow_status varchar [note: 'Current lifecycle status of the escrow account indicating whether funds are held, released, or subject to dispute.']
  establishment_date date [note: 'Date on which the escrow account was formally established and funded per the Limited Partnership Agreement (LPA) provisions.']
  expiration_date date [note: 'Final date after which the escrow obligation terminates and any remaining funds are released to the GP, typically tied to fund liquidation or statute of limitations.']
  interest_accrual_flag boolean [note: 'Indicates whether the escrow account accrues interest on held funds per LPA terms.']
  interest_allocation_method varchar [note: 'Method by which interest earned on escrow funds is allocated among General Partner (GP), Limited Partners (LPs), or the fund.']
  interest_earned_amount decimal(18,2) [note: 'Total interest earned on escrow funds to date, which may be allocated to GP or LPs per LPA terms.']
  interest_rate_percent decimal(5,4) [note: 'Annual interest rate applied to escrow funds if interest accrual is enabled, expressed as a percentage.']
  investor_disclosure_flag boolean [note: 'Indicates whether escrow details are disclosed to Limited Partners (LPs) in quarterly or annual investor reports.']
  last_audit_date date [note: 'Date of the most recent external audit verification of the escrow account balance and related calculations.']
  last_modified_timestamp timestamp [note: 'System timestamp indicating when this escrow account record was most recently updated.']
  legal_counsel_opinion_flag boolean [note: 'Indicates whether external legal counsel has provided a formal opinion on the escrow structure and clawback enforceability.']
  lpa_reference_section varchar [note: 'Specific section or article reference in the LPA governing the escrow provisions and clawback mechanics.']
  next_release_amount decimal(18,2) [note: 'Amount scheduled to be released on the next release date per the LPA release schedule.']
  next_release_date date [note: 'Next scheduled date on which a portion of the escrow funds is eligible for release to the GP per the release schedule.']
  notes varchar [note: 'Free-form text field for additional context, special conditions, or operational notes related to the escrow account.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this escrow account must be disclosed in regulatory filings or investor reports per applicable securities regulations.']
  release_date date [note: 'Date on which the escrow funds were released to the General Partner (GP) or became eligible for release per LPA terms.']
  release_schedule_type varchar [note: 'Type of release schedule governing when escrow funds are released: single release, periodic tranches, milestone-based, or performance-based.']
  release_trigger_condition varchar [note: 'Business condition or event that triggers release of escrow funds, such as fund liquidation, passage of time, or achievement of performance thresholds.']
  released_amount decimal(18,2) [note: 'Total amount released from escrow to the GP to date, reflecting partial or full releases per LPA terms.']
  remaining_balance decimal(18,2) [note: 'Current balance remaining in the escrow account after accounting for releases and any clawback settlements.']

  Note: 'Master record tracking carried interest escrow accounts established to protect LP interests against potential clawback obligations. Captures escrow account reference, GP counterparty, escrow amount held, escrow percentage (of gross carry distributions)'
}

Table fee.fee_benchmark {
  fee_benchmark_id varchar [pk, note: 'Unique identifier for the external manager fee benchmark record.']
  data_vendor_id varchar [note: 'Foreign key linking to research.data_vendor. Business justification: Fee benchmarks (management fee medians, carry percentiles by strategy/vintage) are sourced from specialized data vendors (Preqin, Cambridge Associates, Burgiss).']
  approval_date date [note: 'Date on which the benchmark data was reviewed and approved for use by the investment operations or procurement team.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the benchmark for operational use.']
  asset_class varchar [note: 'Primary asset class category to which this fee benchmark applies for manager selection and fee negotiation.']
  benchmark_code varchar [note: 'Short alphanumeric code uniquely identifying the fee benchmark within the organization\'s reference data system.']
  benchmark_name varchar [note: 'Descriptive name of the fee benchmark used for identification and reporting purposes.']
  benchmark_status varchar [note: 'Current lifecycle status of the benchmark record indicating whether it is actively used for fee assessments or has been retired.']
  carried_interest_25th_percentile_percent decimal(5,4) [note: 'Twenty-fifth percentile carried interest rate representing the lower quartile of the benchmark distribution.']
  carried_interest_75th_percentile_percent decimal(5,4) [note: 'Seventy-fifth percentile carried interest rate representing the upper quartile of the benchmark distribution.']
  carried_interest_median_percent decimal(5,4) [note: 'Median carried interest rate as a percentage of profits above the hurdle rate observed in the benchmark peer group.']
  catch_up_provision_prevalence_percent decimal(5,2) [note: 'Percentage of funds in the benchmark cohort that include a catch-up provision allowing GPs to receive a higher share of profits after the hurdle is met.']
  clawback_provision_prevalence_percent decimal(5,2) [note: 'Percentage of funds in the benchmark cohort that include clawback provisions requiring GPs to return excess carried interest if final fund performance falls below agreed thresholds.']
  created_timestamp timestamp [note: 'Timestamp when this benchmark record was first created in the system.']
  data_source varchar [note: 'Name of the external data provider or research firm that compiled the benchmark data (e.g., Preqin, PitchBook, Cambridge Associates).']
  data_source_report_reference varchar [note: 'Specific report title, publication identifier, or URL reference from the data source for audit trail and verification purposes.']
  effective_end_date date [note: 'Date on which this benchmark record ceases to be valid, typically when superseded by updated benchmark data.']
  effective_start_date date [note: 'Date from which this benchmark record is considered valid and applicable for fee negotiations and manager evaluations.']
  fund_size_currency_code varchar [note: 'Three-letter ISO 4217 currency code for fund size bounds (e.g., USD, EUR, GBP).']
  fund_size_lower_bound_amount decimal(18,2) [note: 'Minimum fund size (Assets Under Management) in millions for which this benchmark is applicable, enabling size-cohort comparisons.']
  fund_size_upper_bound_amount decimal(18,2) [note: 'Maximum fund size (Assets Under Management) in millions for which this benchmark is applicable, defining the upper limit of the size cohort.']
  geographic_focus varchar [note: 'Primary geographic region or market focus for the benchmark (e.g., North America, Europe, Asia-Pacific, Global).']
  hurdle_rate_25th_percentile_percent decimal(5,4) [note: 'Twenty-fifth percentile hurdle rate representing the lower quartile of the benchmark distribution.']
  hurdle_rate_75th_percentile_percent decimal(5,4) [note: 'Seventy-fifth percentile hurdle rate representing the upper quartile of the benchmark distribution.']
  hurdle_rate_median_percent decimal(5,4) [note: 'Median preferred return threshold (hurdle rate) that must be achieved before General Partners (GPs) earn carried interest, observed in the benchmark peer group.']
  management_fee_25th_percentile_percent decimal(5,4) [note: 'Twenty-fifth percentile management fee rate representing the lower quartile of the benchmark distribution, indicating competitive fee levels.']
  management_fee_75th_percentile_percent decimal(5,4) [note: 'Seventy-fifth percentile management fee rate representing the upper quartile of the benchmark distribution.']
  management_fee_median_percent decimal(5,4) [note: 'Median management fee rate as a percentage of committed capital or net asset value observed in the benchmark peer group.']
  most_favored_nation_prevalence_percent decimal(5,2) [note: 'Percentage of funds in the benchmark cohort that include Most Favored Nation clauses ensuring Limited Partners (LPs) receive fee terms no less favorable than those granted to other LPs.']
  publication_date date [note: 'Date on which the benchmark data was published or made available by the data source.']
  sample_size_count varchar [note: 'Number of funds or manager mandates included in the benchmark calculation, indicating statistical robustness of the benchmark data.']
  strategy_type varchar [note: 'Specific investment strategy or sub-asset class for which the benchmark fee data is applicable (e.g., growth equity, value-add real estate, core infrastructure).']
  usage_notes varchar [note: 'Free-text field capturing guidance on how to apply the benchmark, any known limitations, or special considerations for fee negotiations.']
  vintage_year varchar [note: 'The year in which the benchmark data was collected or the fund cohort was established, critical for time-series fee trend analysis.']

  Note: 'Master record of external manager fee benchmarks used to assess the competitiveness of management fee and carried interest terms across the fund\'s manager universe.'
}

Table fee.rate_schedule {
  rate_schedule_id varchar [pk, note: 'Unique identifier for the fee rate schedule. Primary key.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Rate schedules are negotiated with specific GPs; linkage enables fee benchmarking across managers and tracking negotiation history for future mandate discussions.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Rate schedules are mandate-specific fee terms; direct linkage required for fee calculation runs and contractual compliance verification.']
  superseded_by_schedule_rate_schedule_id varchar [note: 'Identifier of the rate schedule that supersedes this schedule when a new version is created or terms are updated.']
  approval_date date [note: 'Date on which this rate schedule was formally approved by the Investment Committee (IC) or authorized governance body.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved this rate schedule for use in fee calculations.']
  asset_class varchar [note: 'Asset class to which this rate schedule applies, such as public equities, private equity, real estate, infrastructure, or credit. [ENUM-REF-CANDIDATE']
  benchmark_index_code varchar [note: 'Code identifying the benchmark index used for performance fee calculations or hurdle rate determination under this schedule.']
  calculation_frequency varchar [note: 'Frequency at which fees are calculated using this rate schedule, such as daily, monthly, quarterly, or annually.']
  calculation_method varchar [note: 'Methodology used to compute fees from this schedule, including flat rate, tiered blended, tiered marginal, or performance-based methods.']
  carry_rate_percent decimal(8,4) [note: 'Percentage of profits allocated to the General Partner (GP) as carried interest after hurdle and catch-up provisions are satisfied.']
  catch_up_rate_percent decimal(8,4) [note: 'Rate applied to returns above the hurdle rate until the General Partner (GP) receives their full carried interest allocation.']
  clawback_provision_flag boolean [note: 'Indicates whether this rate schedule includes clawback provisions requiring return of carried interest if fund performance falls below thresholds.']
  created_timestamp timestamp [note: 'Timestamp when this rate schedule record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which fee amounts and thresholds are denominated.']
  effective_end_date date [note: 'Date on which this rate schedule ceases to be active. Null indicates an open-ended schedule with no expiration.']
  effective_start_date date [note: 'Date on which this rate schedule becomes active and applicable for fee calculations.']
  fee_basis varchar [note: 'The base metric upon which the fee rate is applied, such as Assets Under Management (AUM), Net Asset Value (NAV), or committed capital.']
  fee_offset_provision_flag boolean [note: 'Indicates whether this rate schedule includes provisions for offsetting management fees against transaction fees or other fee types.']
  fee_type varchar [note: 'Classification of the fee to which this rate schedule applies, such as management fee, performance fee, or transaction fee.']
  geography_scope varchar [note: 'Geographic scope or region to which this rate schedule applies, such as global, North America, Europe, Asia Pacific, or emerging markets.']
  high_water_mark_flag boolean [note: 'Indicates whether performance fees under this schedule are subject to a high water mark provision, ensuring fees are only charged on net new profits.']
  hurdle_rate_percent decimal(8,4) [note: 'Minimum return threshold that must be achieved before performance fees are calculated. Also known as preferred return.']
  investment_strategy varchar [note: 'Investment strategy or mandate type to which this rate schedule applies, such as growth equity, value, core-plus real estate, or distressed credit.']
  investor_type varchar [note: 'Type of investor or client segment to which this rate schedule applies, such as institutional, retail, high net worth, or pension funds.']
  last_modified_timestamp timestamp [note: 'Timestamp when this rate schedule record was last updated or modified in the system.']
  lpa_reference_section varchar [note: 'Section or clause reference in the Limited Partnership Agreement (LPA) or mandate document that defines this rate schedule.']
  maximum_fee_amount decimal(18,2) [note: 'Ceiling amount for fees calculated under this schedule. If the computed fee exceeds this amount, the maximum fee is charged instead.']
  minimum_fee_amount decimal(18,2) [note: 'Floor amount for fees calculated under this schedule. If the computed fee is below this amount, the minimum fee is charged instead.']
  most_favored_nation_flag boolean [note: 'Indicates whether this rate schedule includes a Most Favored Nation clause ensuring the investor receives the best fee terms offered to any investor.']
  notes varchar [note: 'Free-text field for additional notes, comments, or special conditions related to this rate schedule.']
  offset_percentage decimal(5,2) [note: 'Percentage of transaction fees or other fees that are offset against management fees when fee offset provisions apply.']
  payment_frequency varchar [note: 'Frequency at which calculated fees are invoiced and paid, such as monthly, quarterly, or annually.']
  regulatory_reporting_category varchar [note: 'Classification of this rate schedule for regulatory reporting purposes under frameworks such as SFDR, MiFID II, or GIPS.']
  schedule_code varchar [note: 'Short alphanumeric code uniquely identifying this rate schedule in operational systems and fee calculations.']
  schedule_name varchar [note: 'Business name or label assigned to this fee rate schedule for identification and reference purposes.']
  schedule_status varchar [note: 'Current lifecycle status of the rate schedule indicating whether it is draft, active, suspended, expired, or superseded by a newer version.']
  tier_1_rate_bps decimal(8,4) [note: 'Fee rate applicable to tier 1 expressed in basis points. One basis point equals 0.01 percent.']
  tier_1_threshold_amount decimal(20,2) [note: 'Lower bound amount for the first tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 1 rate.']
  tier_2_rate_bps decimal(8,4) [note: 'Fee rate applicable to tier 2 expressed in basis points. One basis point equals 0.01 percent.']
  tier_2_threshold_amount decimal(20,2) [note: 'Lower bound amount for the second tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 2 rate.']
  tier_3_rate_bps decimal(8,4) [note: 'Fee rate applicable to tier 3 expressed in basis points. One basis point equals 0.01 percent.']
  tier_3_threshold_amount decimal(20,2) [note: 'Lower bound amount for the third tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 3 rate.']
  tier_4_rate_bps decimal(8,4) [note: 'Fee rate applicable to tier 4 expressed in basis points. One basis point equals 0.01 percent.']
  tier_4_threshold_amount decimal(20,2) [note: 'Lower bound amount for the fourth tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 4 rate.']
  tier_5_rate_bps decimal(8,4) [note: 'Fee rate applicable to tier 5 expressed in basis points. One basis point equals 0.01 percent.']
  tier_5_threshold_amount decimal(20,2) [note: 'Lower bound amount for the fifth tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 5 rate.']
  version_number varchar [note: 'Version number of this rate schedule, incremented when amendments or updates are made to the schedule terms.']

  Note: 'Reference entity defining tiered fee rate schedules applied during fee computation. Captures rate schedule name, fee type, AUM/NAV tier breakpoints, applicable fee rate per tier (bps), blended rate calculation method, currency, and effective/expiry dates.'
}

Table fee.fee_calculation_run {
  fee_calculation_run_id varchar [pk, note: 'Unique identifier for the fee calculation run. Primary key.']
  employee_id varchar [note: 'Reference to the external manager or General Partner (GP) entity receiving the fee.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) entity receiving the fee.']
  fee_benchmark_id varchar [note: 'Foreign key linking to fee.fee_benchmark. Business justification: Connect fee_calculation_run to fee_benchmark to link benchmark data used in fee calculations. Remove redundant benchmark_index_code.']
  fund_id varchar [note: 'Reference to the fund or investment vehicle for which fees are being calculated.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Fee calculation audit trail requires GP attribution for reconciliation with manager invoices and fee dispute resolution processes.']
  investment_id varchar [note: 'Reference to the specific investment position for which fees are being calculated, if applicable.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate or external manager mandate for which fees are being calculated.']
  original_run_fee_calculation_run_id varchar [note: 'Reference to the original fee calculation run if this is a recalculation or correction.']
  performance_calculation_run_id varchar [note: 'Foreign key linking to performance.performance_calculation_run. Business justification: Performance-based fee calculations (incentive fees, carry) require validated performance data.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Fee calculations (management fees, performance fees) require specific valuation cycle data as basis.']
  accrual_flag boolean [note: 'Indicates whether this calculation run is for accrual purposes or actual payment processing.']
  adjustment_amount decimal(20,2) [note: 'Any manual or system-generated adjustments applied to the fee calculation.']
  approval_date date [note: 'The date on which the fee calculation run was approved by the Investment Committee (IC) or authorized personnel.']
  approval_required_flag boolean [note: 'Indicates whether this fee calculation run requires Investment Committee (IC) or management approval before payment.']
  approved_by varchar [note: 'Name or identifier of the person or committee who approved the fee calculation run.']
  aum_basis_amount decimal(20,2) [note: 'The Assets Under Management value used as the basis for calculating management fees.']
  basis_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the basis amount used in the fee calculation.']
  calculation_date date [note: 'The date on which the fee calculation was executed or processed.']
  calculation_engine varchar [note: 'The system or software module that executed the fee calculation, such as SimCorp Dimension or BlackRock Aladdin.']
  calculation_frequency varchar [note: 'The periodic frequency at which this fee calculation is executed. [ENUM-REF-CANDIDATE: daily|weekly|monthly|quarterly|semi_annually|annually|ad_hoc — 7 candidates stripped; promote to reference product]']
  calculation_methodology varchar [note: 'Description of the calculation methodology applied, including any specific formulas, waterfall structures, or computational approaches.']
  calculation_timestamp timestamp [note: 'Precise timestamp when the fee calculation run was executed, including time zone information.']
  calculation_version varchar [note: 'Version number or identifier of the calculation logic or rule set applied in this run.']
  carry_rate_percent decimal(8,5) [note: 'The percentage of profits allocated to the General Partner (GP) as carried interest.']
  catch_up_provision_applied_flag boolean [note: 'Indicates whether a catch-up provision was applied to allow the General Partner (GP) to receive additional carried interest after the hurdle is met.']
  committed_capital_amount decimal(20,2) [note: 'The total committed capital amount used as the basis for fee calculation in private equity structures.']
  cost_center_code varchar [note: 'The internal cost center or business unit code to which the fee expense is allocated.']
  created_timestamp timestamp [note: 'Timestamp when this fee calculation run record was first created in the system.']
  fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code for the calculated fee amounts.']
  fee_rate_percent decimal(8,5) [note: 'The percentage rate applied to the basis amount to calculate the gross fee.']
  fee_type varchar [note: 'Category of fee being calculated in this run, such as management fee, carried interest, or transaction fee.']
  fund_irr_percent decimal(8,5) [note: 'The Internal Rate of Return achieved by the fund during the calculation period, used for performance fee assessment.']
  gl_account_code varchar [note: 'The General Ledger account code to which the calculated fee will be posted for accounting purposes.']
  gross_fee_amount decimal(20,2) [note: 'The total fee amount calculated before any offsets, rebates, or adjustments.']
  hurdle_met_flag boolean [note: 'Indicates whether the hurdle rate threshold was met or exceeded in this calculation period.']
  hurdle_rate_percent decimal(8,5) [note: 'The preferred return threshold that must be achieved before carried interest or performance fees are calculated.']
  invested_capital_amount decimal(20,2) [note: 'The total invested or paid-in capital amount used as the basis for fee calculation.']
  lpa_reference_clause varchar [note: 'The specific section or clause in the Limited Partnership Agreement (LPA) that governs this fee calculation.']
  nav_basis_amount decimal(20,2) [note: 'The Net Asset Value used as the basis for fee calculation, particularly for private market investments.']
  net_fee_amount decimal(20,2) [note: 'The final fee amount after applying all offsets, rebates, and adjustments.']
  notes varchar [note: 'Free-text notes or comments regarding the fee calculation run, including any special circumstances or manual adjustments.']
  offset_amount decimal(20,2) [note: 'The amount of fee offset or rebate applied, such as transaction fee rebates or General Partner (GP) fee offsets.']
  payment_due_date date [note: 'The date by which the calculated fee is due for payment to the external manager or General Partner (GP).']
  performance_benchmark_code varchar [note: 'The benchmark index or reference code used to evaluate performance for performance fee calculations.']
  period_end_date date [note: 'The ending date of the period for which fees are being calculated.']
  period_start_date date [note: 'The beginning date of the period for which fees are being calculated.']
  recalculation_flag boolean [note: 'Indicates whether this run is a recalculation of a previously executed fee calculation.']
  run_number varchar [note: 'Business-friendly identifier or sequence number for the calculation run, used for tracking and reporting purposes.']
  run_status varchar [note: 'Current lifecycle status of the fee calculation run indicating its workflow state. [ENUM-REF-CANDIDATE: draft|pending|in_progress|completed|approved|rejected|cancelled — 7 candidates stripped; promote to reference product]']
  tiered_rate_applied_flag boolean [note: 'Indicates whether a tiered fee schedule was applied in this calculation run.']

  Note: 'Transactional record of each periodic fee calculation run executed for management fees, carried interest, or other investment-related fees. Captures calculation run date, fee type, calculation period, AUM/NAV basis used, rate applied, gross fee computed'
}

Table fee.dispute {
  dispute_id varchar [pk, note: 'Unique identifier for the fee dispute record.']
  assigned_to_user_employee_id varchar [note: 'Reference to the internal user or team member currently responsible for managing and resolving the dispute.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external manager or General Partner (GP) against whom the dispute is raised.']
  fund_id varchar [note: 'Reference to the fund or investment vehicle associated with the disputed fee.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Fee disputes must be attributed to specific GPs for relationship management, escalation tracking, and manager evaluation/watchlist processes.']
  identified_by_user_employee_id varchar [note: 'Reference to the internal user or analyst who identified and raised the fee dispute.']
  investment_id varchar [note: 'Reference to the specific investment or co-investment associated with the disputed fee, if applicable.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Disputes reference specific mandate terms (LPA clauses); mandate linkage required for contractual interpretation and resolution documentation.']
  valuation_asset_valuation_id varchar [note: 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Fee disputes frequently stem from valuation disagreements. When LPs challenge fees, linking to specific asset valuations enables root cause analysis.']
  auditor_notification_date date [note: 'Date when the external auditor was formally notified of the fee dispute.']
  auditor_notified_flag boolean [note: 'Indicates whether the external auditor has been notified of the dispute for financial reporting and audit trail purposes.']
  claimed_amount decimal(18,2) [note: 'Amount that the external manager or General Partner (GP) originally claimed or charged.']
  correct_amount decimal(18,2) [note: 'Amount that the pension fund believes is the correct fee based on Limited Partnership Agreement (LPA) terms and calculations.']
  created_timestamp timestamp [note: 'Timestamp when the dispute record was first created in the system.']
  currency_code varchar [note: 'Three-letter International Organization for Standardization (ISO) 4217 currency code for all monetary amounts in this dispute.']
  dispute_category varchar [note: 'Categorization of the root cause or nature of the fee dispute.']
  dispute_status varchar [note: 'Current lifecycle status of the fee dispute in the resolution workflow.']
  dispute_type varchar [note: 'Classification of the fee type that is subject to dispute.']
  disputed_amount decimal(18,2) [note: 'Total monetary amount of the fee that is under dispute.']
  escalation_date date [note: 'Date when the dispute was escalated to a higher authority or arbitration process.']
  escalation_flag boolean [note: 'Indicates whether the dispute has been escalated to senior management, legal counsel, or arbitration due to inability to resolve at operational level.']
  escalation_level varchar [note: 'Level to which the dispute has been escalated for resolution.']
  fee_period_end_date date [note: 'End date of the fee calculation period that is subject to dispute.']
  fee_period_start_date date [note: 'Start date of the fee calculation period that is subject to dispute.']
  impact_on_nav_flag boolean [note: 'Indicates whether the dispute and its resolution have a material impact on the fund Net Asset Value (NAV) calculation requiring restatement.']
  last_modified_timestamp timestamp [note: 'Timestamp when the dispute record was last updated or modified.']
  lpa_reference_clause varchar [note: 'Specific section, article, or clause number in the Limited Partnership Agreement (LPA) that governs the disputed fee calculation or terms.']
  manager_response varchar [note: 'Detailed response provided by the external manager or General Partner (GP) addressing the dispute, including their justification or acknowledgment.']
  materiality_threshold_exceeded_flag boolean [note: 'Indicates whether the disputed amount exceeds the materiality threshold requiring Investment Committee (IC) or senior management notification.']
  notification_date date [note: 'Date when the external manager or General Partner (GP) was formally notified of the dispute.']
  number varchar [note: 'Externally-known unique reference number assigned to the fee dispute for tracking and communication purposes.']
  priority varchar [note: 'Priority level assigned to the dispute based on materiality, urgency, and business impact.']
  raised_date date [note: 'Date when the fee dispute was formally raised by the investment team or operations.']
  reason varchar [note: 'Detailed explanation of why the fee is being disputed, including specific calculation errors, unauthorized charges, or Limited Partnership Agreement (LPA) non-compliance issues.']
  refund_amount decimal(18,2) [note: 'Amount to be refunded or credited to the pension fund following dispute resolution.']
  refund_due_flag boolean [note: 'Indicates whether a refund or credit is due to the pension fund as a result of the dispute resolution.']
  refund_received_date date [note: 'Date when the refund or credit was received from the external manager or General Partner (GP).']
  resolution_date date [note: 'Date when the fee dispute was formally resolved or closed.']
  resolution_notes varchar [note: 'Detailed notes documenting the resolution process, agreements reached, and any special conditions or future preventive measures.']
  resolution_outcome varchar [note: 'Final outcome of the dispute resolution process indicating how the dispute was concluded.']
  resolved_amount decimal(18,2) [note: 'Final agreed-upon fee amount after dispute resolution, which may differ from both claimed and correct amounts due to negotiation.']
  response_due_date date [note: 'Date by which the external manager or General Partner (GP) is required to respond to the dispute.']
  response_received_date date [note: 'Date when the external manager or General Partner (GP) provided their formal response to the dispute.']
  supporting_documentation_flag boolean [note: 'Indicates whether all required supporting documentation (invoices, calculations, Limited Partnership Agreement (LPA) excerpts) has been collected and attached to the dispute.']
  variance_amount decimal(18,2) [note: 'Calculated difference between the claimed amount and the correct amount (claimed minus correct).']

  Note: 'Transactional record of fee disputes raised against external managers or GPs regarding incorrect fee calculations, unauthorized charges, or LPA non-compliance.'
}

Table fee.waiver {
  waiver_id varchar [pk, note: 'Unique identifier for the management fee waiver record.']
  approved_by_user_employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who authorized the fee waiver.']
  employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who authorized the fee waiver.']
  fund_id varchar [note: 'Reference to the fund receiving the management fee waiver.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity granting the fee waiver.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Fee waivers granted to GPs require profile linkage for MFN clause compliance monitoring and tracking preferential terms across manager relationships.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: Waivers are mandate-specific per side letter terms; linkage enables fee schedule reconciliation and ensures waiver application to correct mandate.']
  amount_cap decimal(18,2) [note: 'Maximum cumulative fee waiver amount that can be granted under this arrangement, if capped.']
  application_frequency varchar [note: 'Frequency at which the fee waiver is applied to management fee calculations.']
  approval_date date [note: 'Date when the fee waiver was formally approved by the General Partner (GP) or Investment Committee (IC).']
  auditor_verification_date date [note: 'Date when external auditors last verified the fee waiver arrangement and calculations.']
  auditor_verified_flag boolean [note: 'Indicates whether the fee waiver calculation and application has been verified by external auditors.']
  basis_points varchar [note: 'Fee reduction expressed in basis points, commonly used for institutional fee negotiations.']
  benchmark_fee_rate_percent decimal(5,4) [note: 'Standard management fee rate before application of the waiver, used for variance analysis.']
  calculation_methodology varchar [note: 'Detailed description of how the fee waiver is calculated and applied to management fee invoices.']
  co_investment_linkage_flag boolean [note: 'Indicates whether the fee waiver is contingent upon Limited Partner (LP) participation in co-investment opportunities.']
  commitment_threshold_amount decimal(18,2) [note: 'Minimum capital commitment amount required to qualify for the fee waiver, if applicable.']
  created_timestamp timestamp [note: 'Timestamp when this fee waiver record was first created in the system.']
  cumulative_waiver_amount decimal(18,2) [note: 'Total cumulative fee reduction granted to date under this waiver arrangement.']
  currency_code varchar [note: 'Three-letter International Organization for Standardization (ISO) 4217 currency code for waiver amounts.']
  effective_end_date date [note: 'Date when the fee waiver arrangement expires or terminates, nullable for open-ended waivers.']
  effective_start_date date [note: 'Date when the fee waiver arrangement becomes effective and begins reducing management fees.']
  fee_transparency_disclosure_flag boolean [note: 'Indicates whether this waiver must be disclosed in fee transparency reports to Limited Partners (LPs) or regulators.']
  ic_approval_date date [note: 'Date when the Investment Committee (IC) formally approved the fee waiver arrangement.']
  ic_approval_flag boolean [note: 'Indicates whether the fee waiver required formal Investment Committee (IC) approval.']
  last_applied_date date [note: 'Most recent date when the fee waiver was applied to a management fee calculation.']
  last_modified_timestamp timestamp [note: 'Timestamp when this fee waiver record was last updated or modified.']
  legal_counsel_review_flag boolean [note: 'Indicates whether the fee waiver arrangement was reviewed and approved by legal counsel.']
  lpa_reference_section varchar [note: 'Specific section or clause in the Limited Partnership Agreement (LPA) or side letter that governs this fee waiver.']
  lpac_participation_flag boolean [note: 'Indicates whether the fee waiver is granted in exchange for active Limited Partner Advisory Committee (LPAC) participation.']
  most_favored_nation_clause_flag boolean [note: 'Indicates whether this waiver is subject to Most Favored Nation (MFN) provisions ensuring equal treatment with other Limited Partners (LPs).']
  net_fee_rate_percent decimal(5,4) [note: 'Effective management fee rate after application of the waiver.']
  notes varchar [note: 'Additional free-text notes or comments regarding the fee waiver arrangement, negotiation context, or special conditions.']
  number varchar [note: 'Externally-known business identifier for the fee waiver, typically referenced in Limited Partnership Agreement (LPA) or side letters.']
  rate_percent decimal(5,4) [note: 'Percentage reduction applied to the standard management fee rate under this waiver arrangement.']
  regulatory_reporting_category varchar [note: 'Classification code for regulatory reporting purposes under the national pension regulator, Securities and Exchange Commission (SEC), or other jurisdictional requirements.']
  revocation_date date [note: 'Date when the fee waiver was revoked or cancelled by the General Partner (GP), if applicable.']
  revocation_reason varchar [note: 'Business justification for revoking or cancelling the fee waiver arrangement.']
  side_letter_reference varchar [note: 'Reference identifier for the side letter document that formalizes the fee waiver arrangement.']
  trigger_condition varchar [note: 'Business condition that qualifies the Limited Partner (LP) for the fee waiver, such as co-investment participation, Large Portfolio Advisory Committee (LPAC) membership, or commitment size threshold.']
  waiver_status varchar [note: 'Current lifecycle status of the fee waiver arrangement.']
  waiver_type varchar [note: 'Classification of the fee type being waived by the General Partner (GP).']

  Note: 'Transactional record of management fee waivers or reductions granted by a GP to the fund, typically in connection with co-investment rights, LPAC participation, or large commitment size.'
}

Table fee.monitoring_fee {
  monitoring_fee_id varchar [pk, note: 'Unique identifier for the portfolio company monitoring fee record. Primary key for the monitoring fee entity.']
  fund_id varchar [note: 'Reference to the private equity fund through which the investment was made and monitoring fee arrangement established.']
  gp_entity_id varchar [note: 'Reference to the General Partner entity charging the monitoring fee to the portfolio company.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Monitoring fees paid to GPs require attribution for management fee offset calculations and ILPA fee transparency disclosure requirements.']
  investment_id varchar [note: 'Reference to the private equity or co-investment that this monitoring fee is associated with.']
  portfolio_company_id varchar [note: 'Reference to the portfolio company being charged the monitoring fee by the General Partner (GP).']
  annual_flat_fee_amount decimal(18,2) [note: 'Fixed annual monitoring fee amount charged to the portfolio company when fee structure is flat fee based.']
  benchmark_fee_rate_percent decimal(8,4) [note: 'Industry benchmark or peer comparison rate for similar monitoring fee arrangements, used for fairness assessment and transparency.']
  billing_frequency varchar [note: 'Frequency at which monitoring fee invoices are issued to the portfolio company by the General Partner (GP).']
  calculation_base varchar [note: 'The financial metric used as the basis for percentage-based monitoring fee calculations, such as Earnings Before Interest Taxes Depreciation and Amortization (EBITDA).']
  capitalized_flag boolean [note: 'Indicates whether monitoring fees are capitalized as part of the investment cost basis rather than expensed by the portfolio company.']
  cost_center_code varchar [note: 'Internal cost center or business unit code for allocation and tracking of monitoring fee revenue or expense.']
  created_timestamp timestamp [note: 'System timestamp indicating when this monitoring fee record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for all monetary amounts in this monitoring fee arrangement.']
  dispute_description varchar [note: 'Detailed description of the nature and basis of any dispute related to the monitoring fee arrangement or payments.']
  dispute_flag boolean [note: 'Indicates whether there is an active dispute regarding the monitoring fee arrangement, calculation, or payment between parties.']
  dispute_resolution_date date [note: 'Date when any dispute regarding the monitoring fee arrangement was formally resolved between the parties.']
  effective_end_date date [note: 'Date when the monitoring fee arrangement terminates, typically upon exit or sale of the portfolio company investment.']
  effective_start_date date [note: 'Date when the monitoring fee arrangement becomes effective and fees begin accruing, typically aligned with investment closing date.']
  escalation_clause_flag boolean [note: 'Indicates whether the monitoring fee includes an automatic escalation provision tied to inflation or other indices.']
  escalation_index varchar [note: 'Reference index used for automatic fee escalation, such as Consumer Price Index (CPI) or other inflation measure.']
  escalation_rate_percent decimal(5,2) [note: 'Annual percentage rate by which the monitoring fee automatically increases, if escalation clause is in effect.']
  fee_arrangement_status varchar [note: 'Current lifecycle status of the monitoring fee arrangement indicating whether fees are actively being charged.']
  fee_reference_number varchar [note: 'External business identifier for the monitoring fee arrangement, typically referenced in investment agreements and invoices.']
  fee_structure_type varchar [note: 'Classification of the monitoring fee calculation methodology, such as flat annual fee or percentage of portfolio company EBITDA.']
  gl_account_code varchar [note: 'General Ledger account code to which monitoring fee revenue or expense is posted for financial accounting purposes.']
  ic_approval_date date [note: 'Date when the Investment Committee formally approved the monitoring fee arrangement as part of the investment approval.']
  ic_approval_flag boolean [note: 'Indicates whether the monitoring fee arrangement received formal Investment Committee approval as part of the investment decision process.']
  investment_agreement_reference varchar [note: 'Reference to the specific investment agreement, Share Purchase Agreement (SPA), or transaction document that establishes the monitoring fee terms.']
  last_modified_timestamp timestamp [note: 'System timestamp indicating when this monitoring fee record was last updated or modified.']
  lpa_offset_percentage decimal(5,2) [note: 'Percentage of monitoring fees that must be credited back to Limited Partners (LPs) as an offset against management fees, per LPA terms.']
  lpa_offset_provision_flag boolean [note: 'Indicates whether the Limited Partnership Agreement requires monitoring fees to be offset against management fees paid by Limited Partners (LPs).']
  lpa_reference_section varchar [note: 'Specific section, article, or clause reference in the Limited Partnership Agreement that governs this monitoring fee arrangement.']
  maximum_fee_amount decimal(18,2) [note: 'Ceiling amount for the monitoring fee regardless of calculation base, capping GP compensation to protect portfolio company.']
  minimum_fee_amount decimal(18,2) [note: 'Floor amount for the monitoring fee regardless of calculation base, ensuring GP receives minimum compensation for services.']
  notes varchar [note: 'Free-form text field for additional comments, special terms, or contextual information regarding the monitoring fee arrangement.']
  payment_timing varchar [note: 'Timing of monitoring fee payment relative to the service period, indicating whether fees are paid in advance or arrears.']
  percentage_rate decimal(8,4) [note: 'Percentage rate applied to the calculation base (EBITDA or revenue) when fee structure is percentage-based, expressed as decimal.']
  regulatory_reporting_category varchar [note: 'Classification code for regulatory reporting purposes, indicating how this monitoring fee should be categorized in regulatory filings.']
  service_description varchar [note: 'Detailed description of the monitoring, advisory, and value-creation services provided by the GP to justify the monitoring fee.']
  tax_treatment_code varchar [note: 'Classification code indicating the tax treatment of monitoring fees for both GP and portfolio company tax reporting purposes.']
  termination_trigger varchar [note: 'Event or condition that triggered or will trigger the termination of the monitoring fee arrangement.']
  transparency_disclosure_flag boolean [note: 'Indicates whether this monitoring fee arrangement is subject to transparency disclosure requirements to Limited Partners (LPs) or regulators.']
  variance_to_benchmark_bps decimal(8,2) [note: 'Difference between the actual monitoring fee rate and the benchmark rate, expressed in basis points for variance analysis.']
  waiver_approval_date date [note: 'Date when the monitoring fee waiver or reduction was formally approved by authorized parties.']
  waiver_flag boolean [note: 'Indicates whether the General Partner (GP) has waived or reduced the monitoring fee for a specific period or permanently.']
  waiver_reason varchar [note: 'Business justification and rationale for any waiver or reduction of the monitoring fee by the General Partner (GP).']
  withholding_tax_applicable_flag boolean [note: 'Indicates whether withholding tax must be applied to monitoring fee payments based on jurisdiction and tax treaty provisions.']
  withholding_tax_rate_percent decimal(5,2) [note: 'Percentage rate of withholding tax to be applied to monitoring fee payments when applicable.']

  Note: 'Master record for portfolio company monitoring fees charged by GPs to investee companies post-acquisition. Captures monitoring fee structure (annual flat fee vs percentage of EBITDA), fee amount, billing frequency, LPA offset provision (percentage'
}

Table fee.organizational_expense {
  organizational_expense_id varchar [pk, note: 'Unique identifier for the organizational expense record.']
  approved_by_user_employee_id varchar [note: 'Reference to the user or approver who authorized the organizational expense for payment.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Fund organizational expenses (legal, accounting setup costs) are paid from treasury cash accounts.']
  counterparty_id varchar [note: 'Reference to the external service provider or advisor entity that rendered the service and charged the expense.']
  employee_id varchar [note: 'Reference to the user or approver who authorized the organizational expense for payment.']
  fund_id varchar [note: 'Reference to the fund that incurred this organizational expense.']
  allocation_method varchar [note: 'Method used to allocate the organizational expense across Limited Partners (LPs) or fund entities per the Limited Partnership Agreement (LPA).']
  amortization_period_months varchar [note: 'Number of months over which the capitalized organizational expense will be amortized if applicable.']
  approval_date date [note: 'Date on which the organizational expense was approved for payment by the authorized approver or Investment Committee (IC).']
  base_currency_code varchar [note: 'Three-letter International Organization for Standardization (ISO) 4217 currency code representing the funds base reporting currency.']
  base_currency_net_amount decimal(18,2) [note: 'Net expense amount converted to the funds base reporting currency using the applicable Foreign Exchange (FX) rate.']
  capitalized_flag boolean [note: 'Indicates whether the organizational expense is capitalized as part of the fund formation costs or expensed immediately.']
  cost_center_code varchar [note: 'Cost center or business unit code to which this organizational expense is allocated for internal management reporting.']
  created_timestamp timestamp [note: 'Timestamp when this organizational expense record was first created in the system.']
  currency_code varchar [note: 'Three-letter International Organization for Standardization (ISO) 4217 currency code in which the organizational expense is denominated.']
  dispute_flag boolean [note: 'Indicates whether the organizational expense is under dispute or has been contested by the fund or General Partner (GP).']
  dispute_reason varchar [note: 'Explanation or reason for disputing the organizational expense if the dispute flag is set to true.']
  dispute_resolution_date date [note: 'Date on which the dispute regarding the organizational expense was resolved or settled.']
  due_date date [note: 'Date by which the organizational expense payment is due to the service provider per contractual terms.']
  expense_category varchar [note: 'High-level categorization of the expense for financial reporting and cost allocation purposes.']
  expense_number varchar [note: 'Business reference number assigned to this organizational expense for tracking and reporting purposes.']
  expense_status varchar [note: 'Current lifecycle status of the organizational expense in the payment and approval workflow.']
  expense_type varchar [note: 'Classification of the organizational expense by nature of cost incurred during fund formation or launch. [ENUM-REF-CANDIDATE']
  fx_rate decimal(18,6) [note: 'Foreign exchange rate used to convert the expense amount from transaction currency to base currency.']
  gl_account_code varchar [note: 'General Ledger account code to which this organizational expense is posted for financial reporting and accounting purposes.']
  gross_expense_amount decimal(18,2) [note: 'Total gross amount of the organizational expense before any adjustments, rebates, or allocations.']
  incurred_date date [note: 'Date on which the organizational expense was incurred or the service was rendered.']
  invoice_date date [note: 'Date on which the service provider issued the invoice for this organizational expense.']
  invoice_number varchar [note: 'Unique invoice reference number provided by the service provider for this expense.']
  last_modified_timestamp timestamp [note: 'Timestamp when this organizational expense record was last updated or modified in the system.']
  lpa_reference_clause varchar [note: 'Specific section or clause in the Limited Partnership Agreement (LPA) that governs the treatment and allocation of this organizational expense.']
  net_expense_amount decimal(18,2) [note: 'Net amount of the organizational expense after all adjustments, taxes, and allocations have been applied.']
  non_reimbursable_amount decimal(18,2) [note: 'Portion of the organizational expense that is not reimbursable and must be borne by the General Partner (GP) or other party.']
  notes varchar [note: 'Additional free-form notes or comments regarding the organizational expense for audit trail and internal reference purposes.']
  payment_date date [note: 'Actual date on which the organizational expense was paid to the service provider.']
  payment_method varchar [note: 'Method used to remit payment for the organizational expense to the service provider.']
  payment_reference_number varchar [note: 'Unique reference number or transaction identifier associated with the payment of this organizational expense.']
  reimbursable_amount decimal(18,2) [note: 'Portion of the organizational expense that is reimbursable by the fund or Limited Partners (LPs) per the Limited Partnership Agreement (LPA).']
  service_description varchar [note: 'Detailed description of the service or work performed by the service provider that resulted in this organizational expense.']
  service_provider_name varchar [note: 'Name of the service provider or advisor firm that provided the service associated with this expense.']
  tax_amount decimal(18,2) [note: 'Total tax amount included in or applied to the organizational expense, including Value Added Tax (VAT) or Goods and Services Tax (GST).']
  vintage_year varchar [note: 'Year in which the fund was established or had its first capital commitment, used for cohort analysis and benchmarking of organizational expenses.']
  waiver_flag boolean [note: 'Indicates whether the organizational expense has been waived by the service provider or General Partner (GP) and will not be charged to the fund.']
  waiver_reason varchar [note: 'Explanation or justification for waiving the organizational expense if the waiver flag is set to true.']

  Note: 'Transactional record of fund organizational and formation expenses charged to the fund or LP during fund launch, including legal fees, placement agent fees, regulatory filing costs, and fund formation costs.'
}

Table fee.placement_fee {
  placement_fee_id varchar [pk, note: 'Unique identifier for the placement fee record.']
  cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: Placement agent fee payments at fund closing require treasury cash account routing. Treasury operations track these one-time significant outflows for fundraising cost reporting and cash']
  counterparty_id varchar [note: 'Reference to the investor entity that committed capital through the placement agent.']
  fund_id varchar [note: 'Reference to the fund for which capital was raised through the placement agent.']
  gp_entity_id varchar [note: 'Reference to the placement agent entity that facilitated the capital raising activity.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Placement fees relate to GP fundraising activities; GP profile linkage required for fee transparency reporting and total cost of ownership analysis.']
  allocation_method varchar [note: 'Method used to allocate placement fee costs across investors or fund classes.']
  capital_commitment_amount decimal(20,2) [note: 'Total capital commitment amount secured by the placement agent from the investor.']
  capitalized_flag boolean [note: 'Indicates whether the placement fee is capitalized as part of fund organizational costs or expensed immediately.']
  commitment_date date [note: 'Date on which the investor committed capital to the fund through the placement agent.']
  cost_center_code varchar [note: 'Cost center code for internal allocation and reporting of the placement fee expense.']
  created_timestamp timestamp [note: 'Timestamp when this placement fee record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the placement fee transaction.']
  dispute_flag boolean [note: 'Indicates whether the placement fee is under dispute between the fund and placement agent.']
  dispute_reason varchar [note: 'Description of the reason for disputing the placement fee amount or terms.']
  dispute_resolution_date date [note: 'Date on which the placement fee dispute was resolved.']
  due_date date [note: 'Date by which the placement fee payment is contractually due.']
  fee_accrual_date date [note: 'Date on which the placement fee was accrued in the accounting system.']
  fee_basis_percentage decimal(8,4) [note: 'Percentage of committed capital that determines the placement fee amount.']
  fee_reference_number varchar [note: 'Externally-known unique reference number for this placement fee transaction.']
  fee_status varchar [note: 'Current lifecycle status of the placement fee.']
  fee_transparency_disclosure_flag boolean [note: 'Indicates whether this placement fee is subject to fee transparency disclosure requirements for investors.']
  fee_type varchar [note: 'Classification of the placement fee structure.']
  gl_account_code varchar [note: 'General ledger account code to which the placement fee is posted.']
  gross_fee_amount decimal(18,2) [note: 'Total placement fee amount before any deductions or adjustments.']
  ic_approval_date date [note: 'Date on which the Investment Committee approved the placement fee arrangement.']
  ic_approval_flag boolean [note: 'Indicates whether the placement fee arrangement received Investment Committee approval.']
  invoice_date date [note: 'Date on which the placement agent issued the fee invoice.']
  invoice_number varchar [note: 'Unique invoice number issued by the placement agent for this fee.']
  last_modified_timestamp timestamp [note: 'Timestamp when this placement fee record was last updated in the system.']
  lpa_reference_clause varchar [note: 'Specific clause or section in the LPA that governs placement fee terms and conditions.']
  net_fee_amount decimal(18,2) [note: 'Net placement fee amount payable after withholding tax and other deductions.']
  notes varchar [note: 'Additional free-text notes or comments regarding the placement fee transaction.']
  payment_date date [note: 'Actual date on which the placement fee was paid to the placement agent.']
  payment_method varchar [note: 'Method used to remit the placement fee payment to the placement agent.']
  payment_reference_number varchar [note: 'Unique reference number for the payment transaction from treasury system.']
  placement_agreement_reference varchar [note: 'Reference to the placement agent agreement document that governs this fee arrangement.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this placement fee must be disclosed in regulatory filings or investor reports.']
  retrocession_amount decimal(18,2) [note: 'Amount of placement fee rebated to the fund or investors under retrocession arrangement.']
  retrocession_arrangement_flag boolean [note: 'Indicates whether the placement fee involves a retrocession arrangement where a portion is rebated to the fund or investors.']
  retrocession_percentage decimal(6,4) [note: 'Percentage of gross placement fee that is rebated under retrocession arrangement.']
  vintage_year varchar [note: 'Year in which the fund held its initial capital closing, used for performance benchmarking.']
  waiver_approval_date date [note: 'Date on which the placement fee waiver was approved by authorized personnel.']
  waiver_flag boolean [note: 'Indicates whether the placement fee was waived in full or in part by the placement agent.']
  waiver_reason varchar [note: 'Business justification for waiving the placement fee.']
  withholding_tax_amount decimal(18,2) [note: 'Tax amount withheld from the placement fee per applicable tax regulations.']
  withholding_tax_rate_percent decimal(6,4) [note: 'Tax rate applied to calculate withholding tax on the placement fee.']

  Note: 'Transactional record of placement agent fees paid in connection with fund capital raising activities. Captures placement agent identity, fee basis (percentage of committed capital), fee amount, payment date, retrocession arrangement (whether placement fee'
}

Table fee.transparency_report {
  transparency_report_id varchar [pk, note: 'Unique identifier for the fee transparency report disclosure record.']
  employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who approved the transparency report for publication.']
  fund_id varchar [note: 'Reference to the pension fund or investment pool for which this transparency report is prepared.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Transparency reports aggregate fees by manager for pension beneficiary disclosure; GP linkage enables manager-level fee analysis and benchmarking.']
  prepared_by_user_employee_id varchar [note: 'Reference to the user or team member who prepared the transparency report.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: Pension funds must file fee transparency reports with regulators (e.g., ILPA fee disclosure standards, fiduciary reporting).']
  transparency_employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who approved the transparency report for publication.']
  transparency_prepared_by_user_employee_id varchar [note: 'Reference to the user or team member who prepared the transparency report.']
  valuation_cycle_id varchar [note: 'Foreign key linking to valuation.cycle. Business justification: Fee transparency reports must reconcile fees to underlying valuations. Pension fund beneficiary reporting and regulatory filings require tracing total fees paid to specific valuation cycles']
  approval_date date [note: 'Date on which the transparency report was formally approved by the Investment Committee (IC) or designated authority.']
  auditor_verification_date date [note: 'Date on which external auditors completed their verification of the fee transparency report data.']
  auditor_verified_flag boolean [note: 'Indicates whether the fee amounts and calculations in this transparency report have been independently verified by external auditors.']
  average_aum_amount decimal(20,2) [note: 'Average Assets Under Management (AUM) during the reporting period, used as the basis for fee rate calculations.']
  benchmark_comparison_flag boolean [note: 'Indicates whether this transparency report includes comparative benchmarking of fees against industry peers or standards.']
  created_timestamp timestamp [note: 'System timestamp when this transparency report record was first created in the data platform.']
  credit_fees_amount decimal(20,2) [note: 'Total fees paid for credit and fixed income investment management during the reporting period.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code in which all fee amounts in this report are denominated.']
  distribution_channel varchar [note: 'Primary channel through which the transparency report was distributed to stakeholders.']
  executive_summary varchar [note: 'High-level narrative summary of the fee transparency report, highlighting key findings and trends for stakeholder communication.']
  gips_compliant_flag boolean [note: 'Indicates whether this transparency report was prepared in compliance with Global Investment Performance Standards (GIPS) for fee disclosure.']
  infrastructure_fees_amount decimal(20,2) [note: 'Total fees paid for infrastructure investment management during the reporting period.']
  last_modified_timestamp timestamp [note: 'System timestamp when this transparency report record was last updated or modified.']
  natural_resources_fees_amount decimal(20,2) [note: 'Total fees paid for natural resources investment management during the reporting period.']
  notes varchar [note: 'Additional notes, explanations, or contextual information regarding the transparency report data, methodology, or special circumstances.']
  peer_median_fee_rate_bps decimal(8,2) [note: 'Median fee rate in basis points (bps) for comparable institutional asset managers, used for benchmarking transparency.']
  preparation_date date [note: 'Date on which the transparency report was prepared and finalized by the investment accounting team.']
  private_equity_fees_amount decimal(20,2) [note: 'Total fees paid for private equity and co-investment management during the reporting period.']
  public_equities_fees_amount decimal(20,2) [note: 'Total fees paid for public equities asset class management during the reporting period.']
  publication_date date [note: 'Date on which the transparency report was published and made available to beneficiaries, regulators, and governance bodies.']
  real_estate_fees_amount decimal(20,2) [note: 'Total fees paid for real estate investment management during the reporting period.']
  recipient_category varchar [note: 'Primary audience category for whom this transparency report was prepared and disclosed.']
  regulatory_filing_flag boolean [note: 'Indicates whether this transparency report was submitted as part of a mandatory regulatory filing requirement.']
  report_reference_number varchar [note: 'Externally-known unique reference number assigned to this transparency report for tracking and audit purposes.']
  report_status varchar [note: 'Current lifecycle status of the transparency report in the approval and publication workflow.']
  report_type varchar [note: 'Classification of the transparency report based on reporting frequency and purpose.']
  reporting_period_end_date date [note: 'End date of the period covered by this fee transparency disclosure.']
  reporting_period_start_date date [note: 'Start date of the period covered by this fee transparency disclosure.']
  total_carried_interest_paid_amount decimal(20,2) [note: 'Aggregate carried interest (carry) paid to General Partners (GPs) during the reporting period across all private market investments.']
  total_custody_fees_paid_amount decimal(20,2) [note: 'Aggregate custody and safekeeping fees paid to custodian banks during the reporting period.']
  total_fee_rate_bps decimal(8,2) [note: 'Total fee rate expressed in basis points (bps) calculated as total fees paid divided by average AUM, multiplied by 10,000.']
  total_fees_paid_amount decimal(20,2) [note: 'Grand total of all fees paid across all categories during the reporting period.']
  total_management_fees_paid_amount decimal(20,2) [note: 'Aggregate management fees paid to all external managers and General Partners (GPs) during the reporting period.']
  total_other_fees_paid_amount decimal(20,2) [note: 'Aggregate of all other investment-related fees not classified in primary categories, including legal, audit, and administrative fees.']
  total_performance_fees_paid_amount decimal(20,2) [note: 'Aggregate performance-based fees paid to external managers who exceeded hurdle rates or benchmarks during the reporting period.']
  total_placement_fees_paid_amount decimal(20,2) [note: 'Aggregate placement agent fees paid for capital raising and investor relations services during the reporting period.']
  total_transaction_fees_paid_amount decimal(20,2) [note: 'Aggregate transaction fees paid for deal execution, advisory services, and other transaction-related costs during the reporting period.']
  variance_to_peer_median_bps decimal(8,2) [note: 'Difference between the funds total fee rate and the peer median fee rate, expressed in basis points (bps).']

  Note: 'Transactional record of periodic fee transparency disclosures prepared for beneficiaries, regulators, and governance bodies. Captures reporting period, total management fees paid (by asset class and manager), total carried interest paid, total transaction'
}

Table fee.incentive_fee {
  incentive_fee_id varchar [pk, note: 'Unique identifier for the incentive fee arrangement. Primary key.']
  approved_by_user_employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who approved this incentive fee arrangement.']
  employee_id varchar [note: 'Reference to the user or Investment Committee (IC) member who approved this incentive fee arrangement.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external manager subject to this incentive fee arrangement.']
  gp_profile_id varchar [note: 'Reference to the external manager subject to this incentive fee arrangement.']
  manager_mandate_id varchar [note: 'Reference to the Separately Managed Account (SMA) or liquid alternatives mandate under which this incentive fee applies.']
  payment_cash_account_id varchar [note: 'Foreign key linking to treasury.cash_account. Business justification: External manager incentive fee payments require treasury cash account for settlement.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: Incentive fee arrangements specify benchmark hurdles (e.g., beat MSCI World by 100bps).']
  approval_date date [note: 'Date on which the incentive fee arrangement was approved by the Investment Committee (IC) or authorized governance body.']
  arrangement_name varchar [note: 'Descriptive name of the incentive fee arrangement for business reference and reporting.']
  arrangement_reference_number varchar [note: 'Business identifier for the incentive fee arrangement, typically referenced in Investment Management Agreements (IMA).']
  arrangement_status varchar [note: 'Current lifecycle status of the incentive fee arrangement.']
  asset_class varchar [note: 'Primary asset class to which this incentive fee arrangement applies, such as public equities, credit, or liquid alternatives.']
  benchmark_reference varchar [note: 'Identifier or name of the benchmark index or hurdle rate against which performance is measured for incentive fee calculation.']
  calculation_frequency varchar [note: 'Frequency at which incentive fee calculations are performed.']
  clawback_provision_flag boolean [note: 'Indicates whether a clawback provision exists requiring return of previously paid incentive fees if subsequent underperformance occurs.']
  cost_center_code varchar [note: 'Internal cost center code for allocation and tracking of incentive fee expenses.']
  created_timestamp timestamp [note: 'Timestamp when this incentive fee arrangement record was first created in the system.']
  crystallization_frequency varchar [note: 'Frequency at which calculated incentive fees are crystallized and become payable.']
  cumulative_incentive_fee_paid_amount decimal(18,2) [note: 'Total cumulative incentive fees paid to the external manager under this arrangement since inception, in fee currency.']
  effective_end_date date [note: 'Date on which the incentive fee arrangement terminates or expires, if applicable.']
  effective_start_date date [note: 'Date from which the incentive fee arrangement becomes effective and performance measurement begins.']
  equalization_method varchar [note: 'Method used to ensure fair treatment of investors entering at different times relative to high water marks and performance periods.']
  fee_cap_percent decimal(8,5) [note: 'Maximum incentive fee as a percentage of Assets Under Management (AUM), providing an alternative cap mechanism.']
  fee_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which incentive fees are denominated and paid.']
  fee_transparency_disclosure_flag boolean [note: 'Indicates whether this incentive fee arrangement is subject to enhanced fee transparency disclosure requirements under regulatory frameworks.']
  fee_type varchar [note: 'Classification of the incentive fee structure type.']
  fulcrum_fee_adjustment_flag boolean [note: 'Indicates whether the arrangement includes symmetric fulcrum fee adjustments where fees increase for outperformance and decrease for underperformance.']
  gl_account_code varchar [note: 'General Ledger (GL) account code to which incentive fee expenses are posted for financial accounting.']
  high_water_mark_amount decimal(18,2) [note: 'Current high water mark value in base currency, representing the highest Net Asset Value (NAV) level at which incentive fees were previously charged.']
  high_water_mark_flag boolean [note: 'Indicates whether a high water mark provision applies, ensuring incentive fees are only charged on net new performance above previous peaks.']
  hurdle_rate_percent decimal(8,5) [note: 'Minimum return threshold that must be achieved before incentive fees are charged, expressed as annualized percentage.']
  hurdle_type varchar [note: 'Classification of hurdle rate structure: hard hurdle applies fee only to excess returns, soft hurdle applies to all returns once threshold is met.']
  ima_reference_section varchar [note: 'Specific section or clause reference in the Investment Management Agreement (IMA) governing this incentive fee arrangement.']
  investment_strategy varchar [note: 'Investment strategy classification for the mandate subject to this incentive fee, such as long-only equity, market neutral, or absolute return.']
  last_calculation_date date [note: 'Most recent date on which incentive fee calculation was performed for this arrangement.']
  last_crystallization_date date [note: 'Most recent date on which calculated incentive fees were crystallized and became payable.']
  last_modified_timestamp timestamp [note: 'Timestamp when this incentive fee arrangement record was most recently updated.']
  loss_carryforward_flag boolean [note: 'Indicates whether losses from prior periods must be recovered before new incentive fees can be charged.']
  maximum_fee_amount decimal(18,2) [note: 'Maximum incentive fee amount per calculation period, if applicable, capping performance-based compensation.']
  minimum_fee_amount decimal(18,2) [note: 'Minimum incentive fee amount per calculation period, if applicable, ensuring a floor on performance-based compensation.']
  most_favored_nation_clause_flag boolean [note: 'Indicates whether a Most Favored Nation (MFN) clause applies, entitling the investor to the most favorable fee terms offered to any other investor.']
  notes varchar [note: 'Free-form text field for additional comments, special provisions, or operational notes regarding the incentive fee arrangement.']
  payment_timing varchar [note: 'Timing convention for when crystallized incentive fees are paid relative to the calculation period.']
  performance_measurement_basis varchar [note: 'Methodology used to calculate performance for incentive fee determination: Time-Weighted Return (TWR), Money-Weighted Return (MWR), or other basis.']
  rate_percent decimal(8,5) [note: 'Percentage of outperformance above benchmark or hurdle that is charged as incentive fee, expressed as decimal percentage.']
  regulatory_reporting_category varchar [note: 'Classification code for regulatory reporting purposes under applicable frameworks such as SEC, or MiFID II.']
  side_letter_flag boolean [note: 'Indicates whether this incentive fee arrangement is subject to side letter provisions with modified terms.']
  termination_notice_period_days varchar [note: 'Number of days advance notice required to terminate the incentive fee arrangement.']

  Note: 'Master record for performance-based incentive fee arrangements applicable to external managers operating under SMA or liquid alternatives mandates. Captures incentive fee rate (percentage of outperformance), high-water mark provision, benchmark reference'
}

Table fee.high_water_mark {
  high_water_mark_id varchar [pk, note: 'Unique identifier for the high water mark record. Primary key for the high_water_mark product.']
  external_manager_gp_profile_id varchar [note: 'Reference to the external investment manager responsible for the liquid strategy subject to performance fee calculation.']
  gp_profile_id varchar [note: 'Reference to the external investment manager responsible for the liquid strategy subject to performance fee calculation.']
  manager_mandate_id varchar [note: 'Reference to the investment mandate or separately managed account (SMA) to which this high water mark applies.']
  performance_benchmark_id varchar [note: 'Foreign key linking to performance.performance_benchmark. Business justification: High water mark crystallization often requires benchmark-relative performance comparison.']
  valuation_nav_record_id varchar [note: 'Foreign key linking to valuation.valuation_nav_record. Business justification: High water marks are established/reset based on NAV records. Performance fee calculations require tracing HWM to the specific NAV record that set it.']
  approval_date date [note: 'The date on which the high water mark arrangement and its terms were formally approved by the Investment Committee or authorized signatory.']
  approved_by varchar [note: 'The name or identifier of the Investment Committee member or authorized individual who approved the high water mark arrangement.']
  auditor_verified_flag boolean [note: 'Indicates whether the high water mark calculation and current level have been independently verified by external auditors.']
  calculation_methodology varchar [note: 'Detailed description of the methodology used to calculate the high water mark, including NAV basis, timing conventions, and adjustment rules.']
  clawback_provision_flag boolean [note: 'Indicates whether a clawback provision exists requiring the manager to return performance fees if the high water mark is subsequently breached.']
  clawback_reserve_percentage decimal(5,2) [note: 'The percentage of performance fees withheld in reserve to cover potential future clawback obligations if performance deteriorates.']
  created_timestamp timestamp [note: 'The system timestamp when this high water mark record was first created in the data platform.']
  crystallization_frequency varchar [note: 'The frequency at which performance fees are crystallized and the high water mark is evaluated for potential update.']
  cumulative_performance_fee_accrued_amount decimal(20,4) [note: 'The total performance fees accrued to date since the last reset, representing fees earned above the high water mark.']
  cumulative_performance_fee_paid_amount decimal(20,4) [note: 'The total performance fees actually paid out to the manager since the last reset, used for reconciliation and clawback calculations.']
  cumulative_underperformance_amount decimal(20,4) [note: 'The cumulative loss carryforward or deficit amount that must be recovered before new performance fees can be earned. Represents NAV below the high water mark.']
  current_hwm_nav decimal(20,4) [note: 'The current high water mark net asset value level that must be exceeded before performance fees are earned. Represents the highest NAV achieved to date.']
  equalization_method varchar [note: 'The method used to equalize performance fees across investors with different entry dates: series accounting, full equalization, or none.']
  hurdle_rate_percent decimal(5,2) [note: 'The minimum return threshold that must be exceeded before performance fees are earned, applied in conjunction with the high water mark.']
  hurdle_type varchar [note: 'Classification of the hurdle rate mechanism: hard (fees only on excess above hurdle), soft (fees on all returns once hurdle is met), or none (no hurdle applies).']
  hwm_currency_code varchar [note: 'Three-letter ISO 4217 currency code in which the high water mark NAV is denominated.']
  hwm_establishment_date date [note: 'The date on which the high water mark arrangement was first established for this mandate or fund.']
  hwm_exceeded_flag boolean [note: 'Indicates whether the current NAV has exceeded the high water mark, triggering performance fee accrual eligibility.']
  hwm_reference_number varchar [note: 'Business-facing reference number or code for this high water mark arrangement, used in reporting and fee reconciliation.']
  hwm_reset_date date [note: 'The most recent date on which the high water mark was reset to a new level, typically following a full recovery or contractual reset event.']
  hwm_status varchar [note: 'Current lifecycle status of the high water mark arrangement indicating whether it is actively tracked or has been reset or terminated.']
  hwm_type varchar [note: 'Classification of the high water mark mechanism: hard (never resets), soft (resets under conditions), rolling (time-based reset), or crystallized (locked at fee payment).']
  initial_hwm_nav decimal(20,4) [note: 'The starting high water mark NAV level established at mandate inception or at the last full reset event.']
  last_audit_date date [note: 'The date of the most recent external audit verification of the high water mark calculation and supporting documentation.']
  last_calculation_date date [note: 'The date on which the high water mark was most recently calculated and updated based on current NAV.']
  last_crystallization_date date [note: 'The date of the most recent performance fee crystallization event when the high water mark was locked and performance fees were calculated and accrued.']
  last_modified_timestamp timestamp [note: 'The system timestamp when this high water mark record was most recently updated or modified.']
  lookback_period_months varchar [note: 'The number of months over which performance is evaluated for rolling high water mark calculations or reset eligibility.']
  loss_carryforward_flag boolean [note: 'Indicates whether losses must be fully recovered before performance fees resume. True if loss carryforward provision is active.']
  lpa_reference_clause varchar [note: 'The specific section or clause reference in the Limited Partnership Agreement or Investment Management Agreement governing this high water mark arrangement.']
  most_favored_nation_clause_flag boolean [note: 'Indicates whether a most favored nation clause applies, requiring that any more favorable high water mark terms offered to other investors be extended to this investor.']
  nav_basis varchar [note: 'The basis on which NAV is calculated for high water mark purposes: gross of fees, net of fees, or adjusted for specific items.']
  next_crystallization_date date [note: 'The scheduled date for the next performance fee crystallization event when the high water mark will be evaluated and performance fees calculated.']
  notes varchar [note: 'Free-form text field for additional context, special conditions, or operational notes related to this high water mark arrangement.']
  performance_fee_rate_percent decimal(5,2) [note: 'The percentage rate applied to returns above the high water mark to calculate performance-based incentive fees.']
  previous_hwm_nav decimal(20,4) [note: 'The prior high water mark NAV level before the most recent update, used for performance attribution and fee variance analysis.']
  reset_frequency varchar [note: 'The frequency or condition under which the high water mark may be reset to a new baseline level.']
  reset_trigger_condition varchar [note: 'The contractual condition or event that triggers a reset of the high water mark, such as full recovery, time period expiry, or manager change.']
  side_letter_flag boolean [note: 'Indicates whether this high water mark arrangement is subject to side letter provisions that modify standard terms.']

  Note: 'Master record tracking the high-water mark (HWM) level for each incentive fee arrangement on liquid strategy mandates. Captures current HWM NAV level, HWM reset date, cumulative underperformance deficit (loss carryforward), last crystallization date, last'
}

Table research.macro_indicator {
  macro_indicator_id varchar [pk, note: 'Unique identifier for the macroeconomic indicator. Primary key for the macro indicator master library.']
  base_year varchar [note: 'Reference year for index-based indicators (e.g., CPI base year 2015=100). Null for non-indexed indicators.']
  benchmark_threshold_high decimal(18,6) [note: 'Upper bound of the normal or target range for this indicator, used for alert generation and scenario analysis. Null if no threshold is defined.']
  benchmark_threshold_low decimal(18,6) [note: 'Lower bound of the normal or target range for this indicator, used for alert generation and scenario analysis. Null if no threshold is defined.']
  calculation_methodology varchar [note: 'Brief description of how the indicator is calculated or derived (e.g., year-over-year percentage change, quarter-over-quarter annualized, weighted average, survey-based index).']
  country_code varchar [note: 'ISO 3166-1 alpha-3 country code for country-specific indicators (e.g., USA, GBR, CAN, DEU). Null for global or regional indicators.']
  created_timestamp timestamp [note: 'Timestamp when this indicator record was first created in the system. Used for audit trail and data lineage.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for monetary indicators (e.g., USD, EUR, GBP). Null for non-monetary indicators.']
  data_quality_rating varchar [note: 'Internal assessment of the indicators data quality based on source reliability, revision frequency, and historical accuracy: high (trusted for critical decisions), medium (acceptable with caveats), or low (use with caution).']
  data_source varchar [note: 'Primary source system or vendor providing the indicator data (e.g., Bloomberg Terminal, FactSet, OECD, IMF, National Statistics Agency, Central Bank).']
  esg_relevance varchar [note: 'Indicates whether the indicator has direct relevance to ESG analysis: environmental (e.g., carbon emissions, renewable energy share), social (e.g., inequality measures), governance (e.g., corruption index), or not applicable.']
  forecast_availability boolean [note: 'Indicates whether consensus forecasts or proprietary forecasts are maintained for this indicator. True if forecasts are tracked, false otherwise.']
  frequency varchar [note: 'Frequency at which the indicator is published or updated: daily, weekly, monthly, quarterly, or annual.']
  geographic_scope varchar [note: 'Geographic coverage level of the indicator: global aggregate, regional bloc, individual country, state/province, or city-level.']
  historical_start_date date [note: 'Earliest date for which historical data is available for this indicator. Used to determine time-series depth for backtesting and stress testing.']
  indicator_category varchar [note: 'High-level classification of the indicator type: growth metrics, inflation measures, employment statistics, monetary policy rates, credit spreads, commodity prices, sentiment indices, or fiscal indicators.']
  indicator_code varchar [note: 'Standardized short code uniquely identifying the indicator across systems (e.g., GDP_GROWTH, CPI_YOY, SOFR_3M). Used for system integration and Bloomberg/FactSet mapping.']
  indicator_name varchar [note: 'Full business name of the macroeconomic indicator (e.g., Gross Domestic Product Growth Rate, Consumer Price Index Year-over-Year).']
  indicator_subcategory varchar [note: 'Detailed sub-classification within the category (e.g., GDP, Industrial Production, CPI, PPI, Unemployment Rate, Central Bank Rate, Corporate Spread, Oil Price, PMI).']
  last_review_date date [note: 'Date when the indicator definition, source, or methodology was last reviewed by the steward team. Used for data governance and quality assurance.']
  last_updated_timestamp timestamp [note: 'Timestamp when this indicator record was last modified. Used for audit trail and change tracking.']
  leading_lagging_coincident varchar [note: 'Economic timing classification: leading (predicts future economic activity), lagging (confirms trends after they occur), or coincident (moves with current economic conditions).']
  macro_indicator_description varchar [note: 'Detailed business description of the indicator, including its economic significance, typical interpretation, and key considerations for investment analysis.']
  macro_indicator_status varchar [note: 'Current lifecycle status of the indicator in the research library: active (currently tracked), discontinued (no longer published), suspended (temporarily unavailable), or under review (evaluation for inclusion).']
  next_review_date date [note: 'Scheduled date for the next periodic review of the indicator. Used to ensure ongoing relevance and data quality.']
  notes varchar [note: 'Free-text field for additional context, caveats, or special instructions related to the indicator (e.g., known data quality issues, methodology changes, usage restrictions).']
  proprietary_model_flag boolean [note: 'Indicates whether this indicator is derived from an internal proprietary model rather than sourced from external vendors. True for proprietary indicators, false for external.']
  publication_lag_days varchar [note: 'Typical number of days between the reference period end and the official publication date. Used for forecasting data availability in investment models.']
  region_code varchar [note: 'Regional bloc or economic area code for regional indicators (e.g., OECD, EU, G7, ASEAN). Null for country-specific or global indicators.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this indicator is required for regulatory reporting or compliance disclosures (e.g. stress testing, TCFD climate scenario analysis). True if required, false otherwise.']
  related_asset_classes varchar [note: 'Comma-separated list of asset classes most sensitive to this indicator (e.g., public equities, fixed income, real estate, infrastructure, commodities). Used for cross-asset correlation analysis.']
  revision_policy varchar [note: 'Indicates whether published values are subject to revision: no revision, preliminary then final, or continuous revision. Critical for risk modeling and data quality.']
  seasonal_adjustment varchar [note: 'Indicates whether the indicator data is seasonally adjusted, not seasonally adjusted, or available in both forms. Critical for time-series modeling.']
  source_identifier varchar [note: 'Native identifier or ticker symbol used by the source system (e.g., Bloomberg ticker, FactSet mnemonic, OECD series code).']
  steward_team varchar [note: 'Name of the internal research team or function responsible for maintaining and validating this indicator (e.g., Macro Research, Fixed Income Research, ESG Research).']
  unit_of_measure varchar [note: 'Unit in which the indicator is expressed (e.g., percent, basis points, index level, currency amount, ratio). Critical for interpretation and modeling.']
  usage_context varchar [note: 'Description of how the indicator is used within the organization (e.g., SAA input, risk stress testing, IC presentation, portfolio construction, macro overlay strategy).']
  volatility_classification varchar [note: 'Qualitative assessment of the indicators historical volatility: low (stable, slow-moving), moderate (typical cyclical variation), or high (subject to sharp swings).']

  Note: 'Master library of macroeconomic indicators tracked and maintained by the research team, including GDP growth rates, inflation indices (CPI, PPI), unemployment rates, central bank policy rates, yield curves, PMI, credit spreads, and commodity price'
}

Table research.macro_indicator_observation {
  macro_indicator_observation_id varchar [pk, note: 'Unique identifier for the macroeconomic indicator observation record.']
  economic_scenario_id varchar [note: 'Reference to an economic scenario or stress-test scenario if this observation is part of a modeled forecast rather than historical actuals.']
  macro_indicator_id varchar [note: 'Reference to the macroeconomic indicator being observed (e.g., GDP, CPI, unemployment rate).']
  consensus_estimate decimal(28,10) [note: 'The median or mean forecast value from external analysts or economists prior to the actual release.']
  consensus_estimate_count varchar [note: 'Number of individual forecasts or analysts contributing to the consensus estimate.']
  country_code varchar [note: 'Three-letter ISO country code for the geographic region this observation pertains to.']
  created_by_user varchar [note: 'Identifier of the user or system process that created this observation record.']
  currency_code varchar [note: 'Three-letter ISO currency code if the observation is denominated in a specific currency.']
  data_quality_flag boolean [note: 'Quality assessment flag indicating the reliability and completeness of this observation.']
  data_source varchar [note: 'Name of the external data provider or system from which this observation was sourced (e.g., Bloomberg, FactSet, OECD, IMF, national statistical agency).']
  data_source_identifier varchar [note: 'Unique identifier or ticker symbol used by the data source to reference this indicator (e.g., Bloomberg ticker, FactSet mnemonic).']
  ingestion_timestamp timestamp [note: 'Timestamp when this observation record was ingested into the lakehouse platform.']
  is_annualized boolean [note: 'Indicates whether the observation value has been annualized for comparability across different reporting periods.']
  is_seasonally_adjusted boolean [note: 'Indicates whether the observation value has been seasonally adjusted to remove cyclical patterns.']
  last_updated_timestamp timestamp [note: 'Timestamp of the most recent update to this observation record.']
  observation_date date [note: 'The date on which this macroeconomic indicator value was observed or reported.']
  observation_notes varchar [note: 'Free-text notes or commentary from the data source or internal research team regarding this observation.']
  observation_status varchar [note: 'Current lifecycle status of this observation record: active for current use, superseded by a revision, deprecated, or deleted.']
  observation_timestamp timestamp [note: 'Precise timestamp when the observation was recorded or published, including time zone.']
  observation_type varchar [note: 'Classification of the observation: actual reported value, preliminary estimate, revised figure, forecast, or external consensus estimate.']
  observation_value decimal(28,10) [note: 'The numeric value of the macroeconomic indicator at this observation point.']
  period_over_period_change decimal(18,6) [note: 'Percentage change in the indicator value compared to the immediately preceding reporting period.']
  prior_period_value decimal(28,10) [note: 'The value of this indicator from the immediately preceding reporting period, used for period-over-period analysis.']
  publication_date date [note: 'Date on which the observation was officially published or released by the data source.']
  publication_timestamp timestamp [note: 'Precise timestamp when the observation was officially published or released, including time zone.']
  region_code varchar [note: 'Code representing a broader geographic region (e.g., EUR for Eurozone, APAC for Asia-Pacific) when applicable.']
  reporting_frequency varchar [note: 'Frequency at which this indicator is reported: daily, weekly, monthly, quarterly, or annual.']
  reporting_period_end_date date [note: 'End date of the period this observation covers (e.g., Q1 2024 ends 2024-03-31).']
  reporting_period_start_date date [note: 'Start date of the period this observation covers (e.g., Q1 2024 starts 2024-01-01).']
  revision_number varchar [note: 'Sequential revision number for this observation; 0 for initial release, incremented for each subsequent revision.']
  surprise_percentage decimal(18,6) [note: 'Percentage difference between the actual observation value and the consensus estimate.']
  surprise_value decimal(28,10) [note: 'Difference between the actual observation value and the consensus estimate, indicating market surprise.']
  unit_of_measure varchar [note: 'Unit in which the observation value is expressed (e.g., percent, basis points, index level, millions USD, billions EUR).']
  updated_by_user varchar [note: 'Identifier of the user or system process that last updated this observation record.']
  year_over_year_change decimal(18,6) [note: 'Percentage change in the indicator value compared to the same period in the prior year.']

  Note: 'Transactional time-series records of macroeconomic indicator values, covering both observed/reported actuals and external consensus estimates, keyed to a macro_indicator at a point in time (daily, monthly, quarterly, annual).'
}

Table research.economic_scenario {
  economic_scenario_id varchar [pk, note: 'Unique identifier for the economic scenario record.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: TCFD-aligned scenario analysis requires economic scenarios to reference specific climate pathways (IEA NZE, NGFS).']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Regulatory stress testing (Basel III, Solvency II) requires tracking which authority mandated each scenario.']
  approval_date date [note: 'Date on which the scenario was formally approved by the Investment Committee or research governance body.']
  climate_scenario_alignment varchar [note: 'Reference to the climate scenario framework this economic scenario aligns with, such as TCFD or NGFS pathways.']
  commodity_price_assumption decimal(10,2) [note: 'Assumed representative commodity price level for the scenario period, typically in USD per unit.']
  created_timestamp timestamp [note: 'Timestamp when the scenario record was first created in the system.']
  credit_spread_assumption_bps varchar [note: 'Assumed credit spread over risk-free rate expressed in basis points for the scenario period.']
  documentation_url varchar [note: 'URL or file path to the detailed documentation, methodology paper, or research report supporting the scenario.']
  economic_scenario_description varchar [note: 'Detailed narrative describing the macroeconomic assumptions, conditions, and rationale underlying the scenario.']
  effective_date date [note: 'Date from which the scenario is effective and available for use in portfolio analysis and stress testing.']
  equity_return_assumption decimal(7,4) [note: 'Assumed annual equity market return expressed as a decimal for the scenario period.']
  expiry_date date [note: 'Date on which the scenario is no longer valid or recommended for use, typically due to updated assumptions or market conditions.']
  external_reference_code varchar [note: 'Identifier linking this scenario to an external scenario library or third-party research provider such as MSCI or FactSet.']
  fx_volatility_assumption decimal(6,4) [note: 'Assumed foreign exchange market volatility expressed as a decimal for the scenario period.']
  gdp_growth_rate_assumption decimal(6,4) [note: 'Assumed annual GDP growth rate expressed as a decimal for the scenario period.']
  geopolitical_risk_level varchar [note: 'Qualitative assessment of geopolitical risk embedded in the scenario assumptions.']
  ghg_emissions_trajectory varchar [note: 'Narrative description of the assumed greenhouse gas emissions path under this scenario.']
  inflation_rate_assumption decimal(6,4) [note: 'Assumed annual inflation rate expressed as a decimal for the scenario period.']
  infrastructure_return_assumption decimal(7,4) [note: 'Assumed annual infrastructure asset class return expressed as a decimal for the scenario period.']
  interest_rate_assumption decimal(6,4) [note: 'Assumed benchmark interest rate level expressed as a decimal for the scenario period.']
  is_baseline boolean [note: 'Boolean flag indicating whether this scenario represents the baseline or central case for planning and forecasting.']
  is_regulatory_required boolean [note: 'Boolean flag indicating whether this scenario is mandated by regulatory authorities for stress testing or disclosure purposes.']
  last_review_date date [note: 'Date of the most recent review or validation of the scenario assumptions and parameters.']
  model_version varchar [note: 'Version identifier of the source model used to ensure traceability and reproducibility.']
  modified_timestamp timestamp [note: 'Timestamp when the scenario record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next periodic review or recalibration of the scenario.']
  notes varchar [note: 'Free-text field for additional comments, caveats, or contextual information relevant to the scenario.']
  private_equity_return_assumption decimal(7,4) [note: 'Assumed annual private equity asset class return expressed as a decimal for the scenario period.']
  probability_weight decimal(5,4) [note: 'Subjective probability or weighting assigned to the scenario for use in expected value calculations and portfolio construction.']
  real_estate_return_assumption decimal(7,4) [note: 'Assumed annual real estate asset class return expressed as a decimal for the scenario period.']
  regulatory_environment varchar [note: 'Description of the assumed regulatory and policy environment under this scenario.']
  scenario_category varchar [note: 'Thematic classification grouping scenarios by their primary focus area or driver.']
  scenario_code varchar [note: 'Short alphanumeric code uniquely identifying the scenario for system integration and cross-referencing.']
  scenario_name varchar [note: 'Human-readable name of the macroeconomic scenario used for identification and reporting purposes.']
  scenario_owner varchar [note: 'Name or identifier of the research team member or group responsible for maintaining the scenario.']
  scenario_status varchar [note: 'Current lifecycle status of the scenario indicating its availability for use in analysis and reporting.']
  scenario_type varchar [note: 'Classification of the scenario indicating its purpose and nature within the modeling framework.']
  source_model varchar [note: 'Name or identifier of the proprietary or third-party macroeconomic model used to generate the scenario.']
  time_horizon_years varchar [note: 'Number of years into the future that the scenario projects, defining the temporal scope of the analysis.']
  unemployment_rate_assumption decimal(5,4) [note: 'Assumed unemployment rate expressed as a decimal for the scenario period.']
  usage_count varchar [note: 'Number of times the scenario has been used in portfolio stress tests, ALM analyses, or IC presentations.']

  Note: 'Master record of named macroeconomic scenarios defined and maintained by the research team for use in portfolio stress testing, ALM modeling, and IC presentations.'
}

Table research.scenario_assumption {
  scenario_assumption_id varchar [pk, note: 'Unique identifier for the scenario assumption record.']
  economic_scenario_id varchar [note: 'Reference to the parent economic scenario to which this assumption belongs.']
  macro_indicator_id varchar [note: 'Reference to the macroeconomic indicator being projected or shocked in this assumption.']
  approval_date date [note: 'Date on which this assumption was formally approved for use in portfolio construction, risk modeling, or IC presentations.']
  approval_status varchar [note: 'Current approval state of the assumption within the Investment Committee (IC) or research governance process.']
  approved_by varchar [note: 'Name or identifier of the Investment Committee member, Chief Economist, or research lead who approved this assumption.']
  asset_class_scope varchar [note: 'Asset class to which this assumption is relevant, enabling asset-class-specific scenario modeling. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|multi_asset — 7 candidates stripped; promote to']
  assumption_name varchar [note: 'Human-readable name or label for this specific assumption within the scenario.']
  assumption_notes varchar [note: 'Additional free-text notes, caveats, or qualifications related to this assumption, capturing nuances not covered by structured fields.']
  assumption_rationale varchar [note: 'Textual explanation of the economic reasoning, market conditions, or research insights that justify this assumption.']
  assumption_type varchar [note: 'Classification of the assumption indicating whether it represents a baseline projection, shock event, stress condition, recovery path, optimistic case, or pessimistic case.']
  benchmark_comparison decimal(20,6) [note: 'Benchmark or consensus value for the same indicator and horizon, enabling comparison of the assumption against market consensus or historical averages.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level associated with the projected value, expressed as a percentage (e.g., 95.00 for 95% confidence).']
  correlation_group varchar [note: 'Identifier for a group of correlated assumptions, enabling joint scenario modeling where multiple indicators move together.']
  created_timestamp timestamp [note: 'Timestamp when this assumption record was first created in the system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code if the assumption value is denominated in a specific currency, nullable for non-monetary indicators.']
  data_source varchar [note: 'External data provider or internal research team that supplied the underlying data for this assumption, such as Bloomberg, FactSet, MSCI, or internal macro research.']
  effective_date date [note: 'Date from which this assumption becomes applicable within the scenario.']
  expiry_date date [note: 'Date on which this assumption ceases to apply, nullable for open-ended assumptions.']
  geographic_scope varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code or region code indicating the geographic area to which this assumption applies.']
  model_version varchar [note: 'Version identifier of the source model used to derive this assumption, enabling model lineage and reproducibility.']
  next_review_date date [note: 'Scheduled date for the next formal review of this assumption.']
  probability_weight decimal(5,4) [note: 'Probability weight assigned to this assumption within the scenario, used for weighted scenario analysis and expected value calculations.']
  projected_value decimal(20,6) [note: 'The numeric value or level projected for the indicator under this assumption, expressed in the indicators native unit.']
  projection_horizon varchar [note: 'Time horizon over which this assumption applies: short-term (0-2 years), medium-term (3-5 years), long-term (5+ years), or perpetual.']
  review_frequency varchar [note: 'Scheduled frequency at which this assumption is reviewed and potentially updated by the research team.']
  sector_scope varchar [note: 'Economic sector or industry segment to which this assumption is scoped, such as financials, energy, technology, or real estate.']
  sensitivity_flag boolean [note: 'Boolean indicator of whether this assumption is subject to sensitivity analysis or stress testing in portfolio construction and risk management.']
  shock_direction varchar [note: 'Direction of the shock applied: upward (positive), downward (negative), or neutral (no directional bias).']
  shock_magnitude decimal(20,6) [note: 'The size of the shock or deviation applied to the baseline indicator value, expressed as an absolute change or percentage point shift.']
  source_model varchar [note: 'Name or identifier of the proprietary macroeconomic model, external vendor model, or research framework that generated this assumption.']
  unit_of_measure varchar [note: 'The unit in which the projected value and shock magnitude are expressed, such as percentage, basis points (bps), currency, index points, or growth rate.']
  updated_by varchar [note: 'Identifier of the research analyst or system user who last updated this assumption record.']
  updated_timestamp timestamp [note: 'Timestamp when this assumption record was last modified.']
  usage_context varchar [note: 'Description of the analytical or operational context in which this assumption is used, such as Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), Value at Risk (VaR) modeling, or Liability-Driven Investment (LDI) analysis.']
  variance_from_baseline decimal(20,6) [note: 'Calculated difference between the projected value and the baseline scenario value, expressed in the same unit of measure.']
  created_by varchar [note: 'Identifier of the research analyst or system user who created this assumption record.']

  Note: 'Detailed assumption records associated with each economic scenario, specifying the projected values or shocks applied to individual macroeconomic indicators within that scenario.'
}

Table research.market_data_feed {
  market_data_feed_id varchar [pk, note: 'Unique identifier for the market data feed subscription record.']
  data_vendor_id varchar [note: 'Foreign key linking to research.data_vendor. Business justification: Market data feeds are subscriptions to external vendors; linking to data_vendor provides authoritative vendor data and removes redundant vendor_name and vendor_contract_reference columns.']
  annual_subscription_cost decimal(18,2) [note: 'Annual cost of the feed subscription in the base currency (typically USD), excluding usage-based fees.']
  asset_class_coverage varchar [note: 'Comma-separated list of asset classes covered by this feed (e.g., Public Equities, Fixed Income, Private Equity, Real Estate, Infrastructure, Natural Resources, Credit, Derivatives, FX).']
  backup_feed_available_flag boolean [note: 'Indicates whether an alternative or backup feed is available for business continuity in case of primary feed failure (True/False).']
  business_owner_name varchar [note: 'Name of the business owner or department head accountable for the feed subscription and its business value.']
  consuming_systems varchar [note: 'Comma-separated list of internal systems that consume data from this feed (e.g., SimCorp Dimension, BlackRock Aladdin, MSCI RiskMetrics, Internal Data Lake).']
  contract_renewal_date date [note: 'Date when the vendor contract for this feed is due for renewal or renegotiation.']
  cost_currency varchar [note: 'Three-letter ISO 4217 currency code for the subscription cost (e.g., USD, GBP).']
  created_timestamp timestamp [note: 'Timestamp when this market data feed record was first created in the system.']
  data_classification_level varchar [note: 'Highest data classification level of the content delivered by this feed, per organizational data classification policy.']
  data_content_type varchar [note: 'Description of the data content provided by the feed (e.g., pricing, fundamentals, ESG ratings, macroeconomic indicators, risk analytics, performance attribution, fund manager data).']
  data_quality_sla_percentage decimal(5,2) [note: 'Contractual data quality service level agreement percentage guaranteed by the vendor (e.g., 99.5% accuracy).']
  data_retention_period_days varchar [note: 'Number of days for which historical data from this feed is retained in the organization\'s data lake, per data governance policy.']
  data_steward_name varchar [note: 'Name of the individual or team responsible for managing and governing this feed subscription within the research domain.']
  delivery_frequency varchar [note: 'Frequency at which the feed data is updated or delivered (e.g., Real-Time, Daily, Weekly, Monthly, On-Demand). [ENUM-REF-CANDIDATE: Real-Time|Intraday|Daily|Weekly|Monthly|On-Demand|Continuous Streaming — 7 candidates stripped; promote to reference']
  delivery_method varchar [note: 'Technical method by which the feed data is delivered to the organization (e.g., API, FTP, SFTP, Direct Terminal Access, Streaming). [ENUM-REF-CANDIDATE: API|FTP|SFTP|Direct Terminal Access|Managed File Transfer|Web Portal|Streaming|Batch File — 8']
  feed_code varchar [note: 'Unique alphanumeric code identifying the feed subscription for operational reference and billing reconciliation.']
  feed_criticality varchar [note: 'Business criticality rating of the feed based on its impact on investment operations, risk management, and regulatory reporting.']
  feed_documentation_url varchar [note: 'URL or file path to the vendor-provided technical documentation, data dictionary, or API specification for this feed.']
  feed_health_status varchar [note: 'Current operational health status of the feed based on monitoring and data quality checks.']
  feed_name varchar [note: 'Business name of the market data feed subscription (e.g., Bloomberg Terminal Equity Real-Time, FactSet Fixed Income Analytics).']
  feed_status varchar [note: 'Current operational status of the market data feed subscription.']
  feed_type varchar [note: 'Classification of the feed based on data delivery frequency and purpose (e.g., Real-Time, End-of-Day, Historical, Reference Data, Analytics). [ENUM-REF-CANDIDATE: Real-Time|Delayed|End-of-Day|Intraday|Historical|Reference Data|Analytics|Composite — 8']
  geographic_coverage varchar [note: 'Geographic regions or markets covered by the feed (e.g., Global, North America, Europe, Asia-Pacific, Emerging Markets).']
  last_data_refresh_timestamp timestamp [note: 'Timestamp of the most recent successful data refresh or delivery from this feed to internal systems.']
  last_health_check_timestamp timestamp [note: 'Timestamp of the most recent automated health check or monitoring validation for this feed.']
  last_modified_timestamp timestamp [note: 'Timestamp when this market data feed record was last updated or modified.']
  notes varchar [note: 'Free-text field for additional operational notes, special configurations, or historical context related to this feed subscription.']
  primary_use_case varchar [note: 'Primary business use case or application for this feed (e.g., Portfolio Valuation, Risk Analytics, Performance Attribution, Investment Research, ESG Integration, Compliance Reporting).']
  regulatory_compliance_scope varchar [note: 'Comma-separated list of regulatory frameworks or reporting requirements that this feed supports (e.g., GIPS, SFDR, TCFD, MiFID II).']
  subscription_end_date date [note: 'Date when the feed subscription is scheduled to end or was terminated (nullable for open-ended subscriptions).']
  subscription_start_date date [note: 'Date when the feed subscription became active and data delivery commenced.']
  uptime_sla_percentage decimal(5,2) [note: 'Contractual uptime service level agreement percentage guaranteed by the vendor (e.g., 99.9% availability).']
  usage_based_pricing_flag boolean [note: 'Indicates whether the feed has usage-based pricing components in addition to the base subscription cost (True/False).']
  user_license_count varchar [note: 'Number of named user licenses or concurrent access licenses included in the subscription.']
  vendor_support_contact varchar [note: 'Primary vendor support contact email or phone number for technical and operational issues related to this feed.']

  Note: 'Master catalogue of market data feed subscriptions and configurations managed by the research domain, covering Bloomberg Terminal, FactSet, Preqin, PitchBook, and MSCI data services.'
}

Table research.market_data_snapshot {
  market_data_snapshot_id varchar [pk, note: 'Unique identifier for the market data snapshot record.']
  data_source_data_vendor_id varchar [note: 'Reference to the external market data provider or feed system that supplied this snapshot.']
  data_vendor_id varchar [note: 'Reference to the external market data provider or feed system that supplied this snapshot.']
  listed_security_id varchar [note: 'Reference to the security, index, instrument, or currency pair for which market data is captured.']
  accrued_interest decimal(18,6) [note: 'The interest accumulated on a bond since the last coupon payment date.']
  ask_price decimal(24,8) [note: 'The lowest price a seller is willing to accept for the instrument at snapshot time.']
  beta decimal(12,6) [note: 'The measure of the security volatility relative to the overall market.']
  bid_price decimal(24,8) [note: 'The highest price a buyer is willing to pay for the instrument at snapshot time.']
  bloomberg_ticker varchar [note: 'Bloomberg-specific ticker symbol for the instrument.']
  close_price decimal(24,8) [note: 'The closing price of the instrument at the end of the trading session.']
  convexity decimal(12,6) [note: 'The measure of the curvature in the relationship between bond prices and yields.']
  credit_spread decimal(12,6) [note: 'The difference in yield between a corporate bond and a comparable government bond, measured in basis points.']
  currency_code varchar [note: 'Three-letter ISO currency code in which the price is denominated.']
  cusip varchar [note: 'CUSIP identifier for North American securities.']
  data_quality_flag boolean [note: 'Indicator of the quality and reliability of the market data snapshot.']
  dividend_yield decimal(12,6) [note: 'The annual dividend per share divided by the price per share, expressed as a percentage.']
  duration decimal(12,6) [note: 'The weighted average time to receive the bond cash flows, measuring interest rate sensitivity.']
  dv01 decimal(18,6) [note: 'The dollar change in value for a one basis point change in yield.']
  exchange_code varchar [note: 'The Market Identifier Code for the exchange or trading venue where the price was observed.']
  fx_rate decimal(18,8) [note: 'The exchange rate for currency pairs at the snapshot timestamp.']
  high_price decimal(24,8) [note: 'The highest price reached by the instrument during the trading session.']
  implied_volatility decimal(12,6) [note: 'The market forecast of a likely movement in the security price, derived from option prices.']
  ingestion_timestamp timestamp [note: 'The timestamp when this market data snapshot was ingested into the lakehouse platform.']
  is_end_of_day boolean [note: 'Flag indicating whether this snapshot represents end-of-day market data.']
  isin varchar [note: 'International Securities Identification Number uniquely identifying the financial instrument globally.']
  last_updated_timestamp timestamp [note: 'The timestamp when this market data snapshot record was last modified.']
  low_price decimal(24,8) [note: 'The lowest price reached by the instrument during the trading session.']
  market_cap decimal(24,2) [note: 'The total market value of the company outstanding shares.']
  mid_price decimal(24,8) [note: 'The midpoint between bid and ask prices, calculated as the average of bid and ask.']
  oas decimal(12,6) [note: 'The spread over the risk-free rate adjusted for embedded options in the security.']
  open_price decimal(24,8) [note: 'The opening price of the instrument for the trading session.']
  pe_ratio decimal(12,4) [note: 'The ratio of the market price per share to earnings per share.']
  previous_close_price decimal(24,8) [note: 'The closing price from the prior trading session, used for change calculations.']
  price decimal(24,8) [note: 'The market price value for the instrument at the snapshot timestamp.']
  price_type varchar [note: 'The type of price captured in this snapshot. [ENUM-REF-CANDIDATE: last|bid|ask|mid|open|high|low|close|settlement|nav — 10 candidates stripped; promote to reference product]']
  quote_condition varchar [note: 'Code indicating special conditions or qualifiers associated with the quoted price.']
  ric varchar [note: 'Reuters Instrument Code used by Refinitiv for instrument identification.']
  sedol varchar [note: 'SEDOL code used primarily for securities traded on the London Stock Exchange.']
  snapshot_date date [note: 'The business date for which this market data snapshot is effective.']
  snapshot_timestamp timestamp [note: 'The exact date and time when this market data snapshot was captured from the external feed.']
  source_system_timestamp timestamp [note: 'The original timestamp from the source market data feed system before ingestion.']
  trade_condition varchar [note: 'Code indicating special conditions or qualifiers associated with the trade execution.']
  turnover decimal(24,2) [note: 'The total monetary value of trades executed for the instrument during the session.']
  volume decimal(20,4) [note: 'The total quantity of the instrument traded during the session or at snapshot time.']
  ytm decimal(12,6) [note: 'The total return anticipated on a bond if held until maturity, expressed as an annual percentage rate.']

  Note: 'Transactional silver-layer store of normalized inbound market data values captured from external feeds at a point in time for a given security, index, instrument, or currency pair.'
}

Table research.macro_model {
  macro_model_id varchar [pk, note: 'Unique identifier for the proprietary macroeconomic model record.']
  accuracy_metric varchar [note: 'Statistical measure used to assess model accuracy, such as Mean Absolute Error (MAE), Root Mean Squared Error (RMSE), R-squared, or hit rate.']
  accuracy_value decimal(18,6) [note: 'Numerical value of the accuracy metric from the most recent validation or backtesting exercise.']
  approval_date date [note: 'Date when the model was formally approved for use by the Investment Committee (IC), risk committee, or regulatory authority.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that approved the model for operational use.']
  asset_class_applicability varchar [note: 'Comma-separated list or description of asset classes to which this model applies, such as public equities, private equity, real estate, infrastructure, natural resources, credit, or fixed income.']
  backtesting_period_end date [note: 'End date of the historical period used for backtesting the models predictive accuracy and performance.']
  backtesting_period_start date [note: 'Start date of the historical period used for backtesting the models predictive accuracy and performance.']
  calibration_date date [note: 'Date when the model was last calibrated or recalibrated using historical data or updated parameters.']
  climate_scenario_compatible boolean [note: 'Indicates whether the model is compatible with climate scenario analysis frameworks such as Task Force on Climate-related Financial Disclosures (TCFD) or Network for Greening the Financial System (NGFS).']
  computational_runtime_minutes decimal(10,2) [note: 'Average time in minutes required to execute a full model run, used for capacity planning and scheduling.']
  created_timestamp timestamp [note: 'Timestamp when the model record was first created in the system.']
  data_source_description varchar [note: 'Description of primary data sources feeding the model, such as Bloomberg Terminal, FactSet, MSCI, central bank publications, or proprietary internal data.']
  deprecated_date date [note: 'Date when the model was deprecated and removed from active use, if applicable.']
  deprecation_reason varchar [note: 'Explanation for why the model was deprecated, such as superseded by a new model, poor predictive performance, or changes in investment strategy.']
  documentation_url varchar [note: 'Hyperlink or file path to the detailed model documentation, methodology papers, or technical specifications.']
  esg_integration_flag boolean [note: 'Indicates whether the model incorporates Environmental, Social, and Governance (ESG) factors or climate risk scenarios in its analysis.']
  frequency varchar [note: 'Frequency at which the model is run or updated, such as daily, weekly, monthly, quarterly, annual, or ad hoc.']
  geographic_scope varchar [note: 'Geographic regions or countries covered by the model, such as global, North America, Europe, Asia-Pacific, or specific country codes.']
  integration_system varchar [note: 'Name of the operational system or platform where the model outputs are integrated, such as BlackRock Aladdin, SimCorp Dimension, MSCI RiskMetrics, or FactSet.']
  key_assumptions varchar [note: 'Summary of critical assumptions underpinning the model, such as interest rate paths, inflation expectations, GDP growth rates, or market volatility assumptions.']
  methodology_description varchar [note: 'Detailed narrative describing the modeling approach, assumptions, data inputs, calibration techniques, and theoretical foundation of the macroeconomic model.']
  model_code varchar [note: 'Short alphanumeric code or identifier used internally to reference the model in systems and documentation.']
  model_complexity_score varchar [note: 'Numerical score representing the complexity of the model based on number of variables, computational intensity, and calibration difficulty, typically on a scale of 1 to 10.']
  model_name varchar [note: 'Business name of the proprietary macroeconomic model used for identification and reference in research reports and Investment Committee (IC) presentations.']
  model_owner varchar [note: 'Name or identifier of the research team member or department responsible for developing, maintaining, and validating the model.']
  model_status varchar [note: 'Current lifecycle status of the model indicating whether it is actively used, deprecated, under review, archived, or in development.']
  model_type varchar [note: 'Classification of the macroeconomic model methodology, such as Discounted Cash Flow (DCF), factor model, yield curve model, regression, Monte Carlo simulation, or scenario analysis.']
  model_version varchar [note: 'Version identifier of the model reflecting updates, recalibrations, or methodology changes over time.']
  modified_timestamp timestamp [note: 'Timestamp when the model record was last modified or updated.']
  next_review_date date [note: 'Scheduled date for the next periodic review, recalibration, or validation of the model.']
  notes varchar [note: 'Additional free-text notes or comments about the model, including usage guidance, known limitations, or special considerations.']
  output_format varchar [note: 'Description of the models output format, such as forecasted time series, probability distributions, scenario matrices, or risk metrics.']
  primary_use_case varchar [note: 'Primary business application of the model, such as portfolio construction, risk stress testing, Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), or Investment Committee (IC) scenario analysis.']
  regulatory_approval_required boolean [note: 'Indicates whether the model requires regulatory approval or oversight from bodies such as SEC, or FCA before use in investment decisions.']
  risk_classification varchar [note: 'Risk rating assigned to the model based on its complexity, sensitivity to assumptions, and potential impact on investment decisions.']
  stress_testing_enabled boolean [note: 'Indicates whether the model supports macroeconomic stress testing and scenario analysis for risk management purposes.']
  time_horizon varchar [note: 'Forecasting or analysis time horizon for the model, such as short-term (less than 1 year), medium-term (1-5 years), long-term (5+ years), or custom.']
  validation_date date [note: 'Date when the model was last validated for accuracy, robustness, and alignment with observed market outcomes.']
  validation_status varchar [note: 'Outcome of the most recent model validation process indicating whether the model passed, failed, is pending validation, or validation is not required.']

  Note: 'Master record of proprietary macroeconomic models developed and maintained by the research team. Captures model name, model type (DCF, factor model, yield curve model, regression, Monte Carlo), asset class applicability, model version, methodology'
}

Table research.macro_model_run {
  macro_model_run_id varchar [pk, note: 'Unique identifier for each execution of a proprietary macroeconomic model.']
  analyst_assignment_id varchar [note: 'Reference to the research analyst or team member who initiated or is responsible for this model run.']
  economic_scenario_id varchar [note: 'Reference to the economic scenario definition used as input for this model run.']
  employee_id varchar [note: 'Reference to the research analyst or team member who initiated or is responsible for this model run.']
  macro_model_id varchar [note: 'Reference to the proprietary macroeconomic model that was executed in this run.']
  base_date date [note: 'Reference date from which the model projections begin, typically the valuation date or current portfolio date.']
  completion_timestamp timestamp [note: 'Date and time when the model execution finished, whether successfully or with failure.']
  confidence_level decimal(5,4) [note: 'Statistical confidence level used for risk metrics such as VaR and CVaR, expressed as a decimal proportion.']
  convergence_achieved boolean [note: 'Indicator of whether the model reached numerical convergence during execution, critical for result validity.']
  created_timestamp timestamp [note: 'Timestamp when this model run record was first created in the system.']
  cvar_estimate decimal(20,2) [note: 'Model output representing the estimated Conditional Value at Risk, measuring expected loss beyond the VaR threshold.']
  error_message varchar [note: 'Detailed error message captured if the model run failed, used for troubleshooting and audit trail.']
  execution_duration_seconds varchar [note: 'Total time in seconds required to complete the model run, used for performance monitoring and optimization.']
  fair_value_currency varchar [note: 'Three-letter ISO currency code in which the fair value estimate is denominated.']
  fair_value_estimate decimal(20,2) [note: 'Model-derived fair value estimate for the asset or portfolio under analysis, expressed in the base currency.']
  fx_currency_pair varchar [note: 'Currency pair for which the FX rate projection applies, expressed in standard format such as USD/JPY.']
  ic_presentation_flag boolean [note: 'Indicator of whether this model run output was used in an Investment Committee presentation or decision memo.']
  implied_equity_risk_premium decimal(10,6) [note: 'Model-derived equity risk premium, representing the expected excess return of equities over the risk-free rate.']
  input_parameter_count varchar [note: 'Number of input parameters supplied to the model for this run, providing metadata on model complexity.']
  iteration_count varchar [note: 'Number of computational iterations performed before the model reached convergence or termination.']
  model_version varchar [note: 'Version identifier of the macroeconomic model used in this run, enabling reproducibility and change tracking.']
  output_metric_count varchar [note: 'Number of distinct output metrics generated by the model run, indicating the breadth of results produced.']
  projected_credit_spread_bps varchar [note: 'Model output representing the forecasted credit spread over risk-free rates, expressed in basis points.']
  projected_fx_rate decimal(18,6) [note: 'Model output representing the forecasted foreign exchange rate for the primary currency pair relevant to this run.']
  projected_gdp_growth_rate decimal(10,6) [note: 'Model output representing the forecasted GDP growth rate, expressed as a decimal proportion.']
  projected_inflation_rate decimal(10,6) [note: 'Model output representing the forecasted inflation rate, critical for liability-driven investment and actuarial liability matching.']
  projected_risk_free_rate decimal(10,6) [note: 'Model output representing the forecasted risk-free interest rate, used in discounted cash flow and WACC calculations.']
  projected_wacc decimal(10,6) [note: 'Model output representing the forecasted weighted average cost of capital, used for valuation and investment decision-making.']
  projection_horizon_years varchar [note: 'Number of years into the future that this model run projects, reflecting the long-duration liability matching requirements.']
  run_identifier varchar [note: 'Business-friendly identifier or label for this model run, used for tracking and reporting purposes.']
  run_purpose varchar [note: 'Business purpose or context for this model execution, such as quarterly review, ad-hoc analysis, or regulatory reporting.']
  run_status varchar [note: 'Current lifecycle status of the model execution.']
  run_timestamp timestamp [note: 'Date and time when the model execution was initiated.']
  run_type varchar [note: 'Classification of the model run purpose, distinguishing between baseline forecasts, stress tests, and sensitivity analyses.']
  stress_test_severity varchar [note: 'Classification of the stress test intensity applied in this model run, used for macroeconomic stress testing.']
  updated_timestamp timestamp [note: 'Timestamp when this model run record was last modified, supporting audit trail and change tracking.']
  validation_notes varchar [note: 'Free-text notes documenting validation findings, exceptions, or issues identified during quality review.']
  validation_status varchar [note: 'Status of post-run validation checks, ensuring model outputs meet quality and reasonableness thresholds.']
  var_estimate decimal(20,2) [note: 'Model output representing the estimated Value at Risk, quantifying potential portfolio loss under the scenario.']

  Note: 'Transactional record of each execution of a proprietary macro model, capturing the run date, input scenario reference, model version used, key output values (e.g., projected GDP, implied equity risk premium, fair value estimate, WACC), run status, and'
}

Table research.research_report {
  research_report_id varchar [pk, note: 'Unique identifier for the research report record.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Research reports analyzing ESG regulatory impacts or framework compliance need to reference the specific framework (SFDR, TCFD, EU Taxonomy).']
  related_deal_opportunity_id varchar [note: 'Foreign key reference to a specific deal or investment opportunity in the pipeline that this report supports or evaluates.']
  related_opportunity_id varchar [note: 'Foreign key reference to a specific deal or investment opportunity in the pipeline that this report supports or evaluates.']
  superseded_by_report_research_report_id varchar [note: 'Reference to a newer report that supersedes or replaces this report, supporting version control and ensuring users access the most current analysis.']
  approval_timestamp timestamp [note: 'Date and time when the report received final approval from research leadership or compliance, authorizing publication and distribution.']
  approved_by varchar [note: 'Name or identifier of the senior analyst, research director, or compliance officer who granted final approval for publication.']
  archive_date date [note: 'Date on which the report was archived or moved to historical storage, reflecting retention policies and the end of its active lifecycle.']
  asset_class varchar [note: 'Primary asset class or investment category that the research report addresses, aligned with the organizations Strategic Asset Allocation (SAA) framework. [ENUM-REF-CANDIDATE']
  author_name varchar [note: 'Full name of the primary research analyst or team lead responsible for authoring the report.']
  author_team varchar [note: 'Name of the internal research team or division that produced the report, such as Macro Research, Equity Research, or Private Markets Research.']
  confidence_level varchar [note: 'Qualitative assessment of the research teams confidence in the reports conclusions and recommendations, based on data quality, model robustness, and market uncertainty.']
  confidentiality_level varchar [note: 'Data classification level assigned to the report, governing access controls, sharing restrictions, and retention policies.']
  created_timestamp timestamp [note: 'Date and time when the report record was first created in the research management system, supporting audit trail and data lineage requirements.']
  data_sources varchar [note: 'List of primary and secondary data sources used in the research, including Bloomberg Terminal, FactSet, Preqin, PitchBook, and proprietary internal databases.']
  distribution_list varchar [note: 'Classification of the intended audience and distribution scope for the report, reflecting confidentiality and information governance policies.']
  document_version varchar [note: 'Version identifier for the report document, supporting change tracking and audit trail requirements for regulatory and governance purposes.']
  esg_integration varchar [note: 'Analysis of Environmental, Social, and Governance factors and their materiality to the investment thesis, aligned with PRI and TCFD frameworks.']
  esg_rating varchar [note: 'Aggregated ESG rating or score assigned to the subject of the report, sourced from internal assessment or external providers such as MSCI ESG Ratings. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC — 7 candidates stripped; promote to reference product]']
  executive_summary varchar [note: 'Concise summary of the reports key findings, investment thesis, and actionable recommendations for senior leadership and IC review.']
  file_format varchar [note: 'Digital file format of the published report, such as PDF for formal publications or PowerPoint for IC presentations.']
  file_path varchar [note: 'Storage location or URI of the published report document within the enterprise content management system or data lake.']
  geographic_focus varchar [note: 'Primary geographic region, country, or market that the research report analyzes, using ISO 3166-1 alpha-3 country codes or regional designations.']
  ic_decision varchar [note: 'Formal decision rendered by the Investment Committee (IC) following review of the report and associated investment memorandum.']
  ic_submission_date date [note: 'Date on which the report was submitted to the Investment Committee (IC) for review and decision-making.']
  ic_submission_flag boolean [note: 'Indicates whether this report was formally submitted to the Investment Committee (IC) as part of an investment decision or approval process.']
  investment_horizon varchar [note: 'Time horizon for the investment outlook or recommendations presented in the report, reflecting the organizations long-duration liability matching strategy.']
  investment_recommendation varchar [note: 'Formal investment stance or action recommended by the research team, expressed in terms consistent with internal portfolio construction and Tactical Asset Allocation (TAA) processes.']
  key_findings varchar [note: 'Detailed narrative of the primary research conclusions, data insights, and analytical results that support the reports investment thesis.']
  keywords varchar [note: 'Comma-separated list of keywords or tags assigned to the report for search, discovery, and taxonomy purposes within the research library.']
  last_modified_timestamp timestamp [note: 'Date and time of the most recent update to any field in the report record, supporting change tracking and data governance.']
  macroeconomic_scenario varchar [note: 'Reference to the proprietary macroeconomic scenario or stress-test framework applied in the analysis, such as base case, recession, or inflationary environment.']
  methodology varchar [note: 'Description of the analytical methods, models, and frameworks applied, such as Discounted Cash Flow (DCF), Capital Asset Pricing Model (CAPM), or proprietary macroeconomic modeling.']
  number varchar [note: 'Externally-known unique identifier or reference code assigned to the research publication for cataloging and citation purposes.']
  page_count varchar [note: 'Total number of pages in the published report document, used for cataloging and resource planning purposes.']
  peer_review_status varchar [note: 'Status of internal peer review or quality assurance process conducted by senior analysts or research leadership prior to publication.']
  publication_date date [note: 'Date on which the research report was formally published and made available to authorized internal stakeholders and Investment Committee (IC) members.']
  publication_status varchar [note: 'Current lifecycle state of the research report within the internal publication workflow and governance process.']
  research_report_type varchar [note: 'Classification of the research publication by its primary analytical focus and intended use within the investment process.']
  revision_date date [note: 'Date of the most recent substantive revision or update to the report content, distinct from minor editorial corrections.']
  revision_notes varchar [note: 'Summary of changes made in the current version, including updated data, revised assumptions, or new analytical insights.']
  risk_assessment varchar [note: 'Comprehensive evaluation of investment risks, including market, credit, liquidity, operational, and macroeconomic risks, with quantitative and qualitative analysis.']
  sector_focus varchar [note: 'Industry sector or thematic area covered by the report, such as technology, healthcare, energy transition, or infrastructure, aligned with GICS or internal taxonomy.']
  target_return decimal(10,4) [note: 'Expected annualized return or Internal Rate of Return (IRR) projected for the investment opportunity or asset class analyzed in the report, expressed as a decimal.']
  target_return_currency varchar [note: 'ISO 4217 three-letter currency code in which the target return is denominated, such as USD, EUR, or GBP.']
  title varchar [note: 'Full title of the research report as it appears on the publication.']
  valuation_approach varchar [note: 'Primary valuation methodology employed in the report, appropriate to the asset class and investment type being analyzed.']

  Note: 'Master record of formal research publications produced by the internal research team across all publication types — sector, country/regional, thematic, asset-class, and macro outlooks plus IC-supporting investment memoranda.'
}

Table research.sector_outlook {
  sector_outlook_id varchar [pk, note: 'Unique identifier for the sector outlook assessment record.']
  previous_outlook_sector_outlook_id varchar [note: 'Reference to the prior version of this sector outlook that this record supersedes.']
  approval_date date [note: 'Date when the sector outlook was formally approved by the Investment Committee (IC) or research leadership.']
  approved_by varchar [note: 'Name and title of the senior leader or Investment Committee (IC) member who approved the sector outlook.']
  archived_date date [note: 'Date when the sector outlook was archived and superseded by a newer version.']
  archived_flag boolean [note: 'Indicates whether the sector outlook has been archived and is no longer active for investment decision-making.']
  base_case_scenario varchar [note: 'Description of the base case macroeconomic scenario underpinning the sector outlook.']
  climate_risk_assessment varchar [note: 'Assessment of climate-related physical and transition risks impacting the sector.']
  comments varchar [note: 'Additional notes, caveats, or context relevant to the sector outlook assessment.']
  confidentiality_level varchar [note: 'Data classification level governing access and distribution of the sector outlook document.']
  contributing_analysts varchar [note: 'Names of additional research team members who contributed to the sector outlook assessment.']
  conviction_level varchar [note: 'Degree of confidence the research team has in the investment view and outlook assessment.']
  created_timestamp timestamp [note: 'Timestamp when the sector outlook record was first created in the system.']
  data_sources varchar [note: 'List of primary data sources and market intelligence platforms used in the outlook analysis (e.g., Bloomberg Terminal, FactSet, MSCI, Preqin).']
  distribution_list varchar [note: 'Comma-separated list of stakeholder groups and individuals authorized to receive the sector outlook (e.g., IC members, portfolio managers, senior leadership).']
  document_url varchar [note: 'Link to the full sector outlook report document stored in the enterprise content management system.']
  downside_scenario varchar [note: 'Description of the downside macroeconomic scenario and its implications for the sector.']
  effective_from_date date [note: 'Date from which the sector outlook assessment becomes effective for portfolio construction and Tactical Asset Allocation (TAA) decisions.']
  effective_to_date date [note: 'Date until which the sector outlook remains valid, after which it is superseded or archived.']
  esg_considerations varchar [note: 'Environmental, Social, and Governance factors material to the sector outlook and investment decision-making.']
  executive_summary varchar [note: 'High-level summary of the sector outlook, key drivers, and investment implications for senior leadership and Investment Committee (IC) members.']
  geographic_focus varchar [note: 'Primary geographic regions or countries covered by the sector outlook (e.g., North America, Europe, Asia-Pacific, Global).']
  gics_industry_group_code varchar [note: 'Four-digit GICS industry group code for more granular sector classification.']
  gics_industry_group_name varchar [note: 'Full name of the GICS industry group within the sector.']
  gics_sector_code varchar [note: 'Two-digit GICS sector code identifying the primary sector covered by this outlook.']
  gics_sector_name varchar [note: 'Full name of the GICS sector (e.g., Energy, Financials, Information Technology).']
  investment_view varchar [note: 'Overall investment stance recommended by the research team for this sector relative to Strategic Asset Allocation (SAA).']
  key_drivers varchar [note: 'Primary factors and catalysts driving the sector outlook, including supply-demand dynamics, regulatory changes, and technological trends.']
  key_risks varchar [note: 'Material risks and headwinds that could negatively impact the sector outlook and investment thesis.']
  last_modified_timestamp timestamp [note: 'Timestamp when the sector outlook record was last updated or revised.']
  lead_analyst_email varchar [note: 'Business email address of the lead analyst for inquiries and collaboration.']
  lead_analyst_name varchar [note: 'Full name of the lead research analyst responsible for authoring and maintaining the sector outlook.']
  macroeconomic_context varchar [note: 'Description of the macroeconomic environment and key indicators influencing the sector outlook.']
  outlook_code varchar [note: 'Business identifier code for the sector outlook report, used for external reference and tracking.']
  outlook_status varchar [note: 'Current lifecycle status of the sector outlook assessment.']
  outlook_title varchar [note: 'Formal title of the sector outlook report as presented to the Investment Committee (IC).']
  outlook_type varchar [note: 'Classification of the outlook report by frequency and purpose.']
  portfolio_implications varchar [note: 'Recommended actions and implications for portfolio construction, asset allocation, and position sizing across public and private markets.']
  publication_date date [note: 'Date when the sector outlook was formally published and made available to portfolio managers and the Investment Committee (IC).']
  review_date date [note: 'Scheduled date for the next formal review and update of the sector outlook.']
  scenario_analysis_flag boolean [note: 'Indicates whether the sector outlook includes formal macroeconomic scenario analysis and stress testing.']
  time_horizon varchar [note: 'Investment time horizon for which the sector outlook is relevant (short-term: 0-12 months, medium-term: 1-3 years, long-term: 3+ years).']
  upside_scenario varchar [note: 'Description of the upside macroeconomic scenario and its implications for the sector.']
  valuation_assessment varchar [note: 'Overall valuation assessment of the sector relative to historical averages and fundamental metrics.']
  version_number varchar [note: 'Version identifier for the sector outlook document, incremented with each revision.']

  Note: 'Master record of formal sector and industry outlook assessments produced by the research team, covering GICS sectors and sub-industries relevant to the fund\'s equity, credit, and private markets portfolios.'
}

Table research.country_outlook {
  country_outlook_id varchar [pk, note: 'Unique identifier for the country outlook assessment record.']
  analyst_employee_id varchar [note: 'Identifier of the lead research analyst responsible for authoring and maintaining this country outlook assessment.']
  employee_id varchar [note: 'Identifier of the lead research analyst responsible for authoring and maintaining this country outlook assessment.']
  superseded_by_country_outlook_id varchar [note: 'Identifier of the newer country outlook assessment that supersedes this version, enabling historical lineage tracking.']
  approval_status varchar [note: 'Governance approval status indicating whether this country outlook has been formally approved by the Chief Investment Officer or designated research leadership.']
  approval_timestamp timestamp [note: 'Date and time when this country outlook assessment received formal approval for publication and operational use.']
  approved_by varchar [note: 'Name or identifier of the senior research or investment officer who formally approved this country outlook for publication and use in investment decisions.']
  assessment_date date [note: 'Date on which this country outlook assessment was finalized and published by the research team.']
  capital_controls_flag boolean [note: 'Indicator of whether the country maintains significant capital controls restricting cross-border investment flows and repatriation.']
  climate_risk_category varchar [note: 'Assessment of physical and transition climate risks facing the country based on exposure to climate hazards and carbon transition vulnerability.']
  comments varchar [note: 'Additional qualitative commentary, caveats, or context provided by the research team regarding this country outlook assessment.']
  corruption_perception_index varchar [note: 'Transparency International Corruption Perceptions Index score on a 0-100 scale where higher indicates lower perceived corruption.']
  country_code varchar [note: 'Three-letter ISO 3166-1 alpha-3 country code identifying the sovereign nation or territory subject to this outlook assessment.']
  country_name varchar [note: 'Full official name of the country or territory covered by this outlook assessment.']
  created_timestamp timestamp [note: 'Date and time when this country outlook assessment record was first created in the research system.']
  credit_outlook varchar [note: 'Forward-looking credit outlook indicating the expected direction of sovereign credit quality over the assessment horizon.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the country\'s primary sovereign currency used in FX risk and hedging analysis.']
  currency_outlook varchar [note: 'Forward-looking assessment of the expected direction and stability of the sovereign currency relative to major reserve currencies.']
  current_account_balance_gdp_pct decimal(6,3) [note: 'Current account balance as a percentage of GDP, reflecting external trade position and foreign exchange reserve sustainability.']
  data_source varchar [note: 'Primary external data providers and research platforms used to compile this country outlook including Bloomberg, FactSet, IMF, World Bank, and rating agencies.']
  ease_of_doing_business_rank varchar [note: 'Country\'s global ranking in the World Bank Ease of Doing Business index, reflecting regulatory efficiency and business environment quality.']
  esg_country_score decimal(5,2) [note: 'Composite ESG score for the country reflecting environmental sustainability, social development, and governance quality on a 0-100 scale.']
  fiscal_balance_gdp_pct decimal(6,3) [note: 'Government fiscal balance (surplus or deficit) expressed as a percentage of GDP, indicating fiscal sustainability and sovereign credit risk.']
  foreign_reserves_months_import decimal(5,2) [note: 'Foreign exchange reserves expressed as months of import coverage, indicating external liquidity and crisis resilience.']
  fx_volatility_category varchar [note: 'Classification of expected foreign exchange rate volatility based on historical variance and forward-looking macro factors.']
  ic_presentation_date date [note: 'Date on which this country outlook was presented to the Investment Committee for review and strategic allocation guidance.']
  ic_presentation_flag boolean [note: 'Indicator of whether this country outlook assessment has been formally presented to the Investment Committee for strategic allocation decisions.']
  investment_climate_rating varchar [note: 'Overall qualitative rating of the country\'s investment climate considering market access, capital controls, repatriation rules, and investor protections.']
  investment_recommendation varchar [note: 'Research team\'s strategic asset allocation recommendation for country exposure relative to benchmark weights.']
  key_opportunities varchar [note: 'Summary of primary investment opportunities and positive catalysts identified for the country including structural reforms, demographic trends, and sector strengths.']
  key_risks varchar [note: 'Summary of primary downside risks identified by the research team including political, economic, regulatory, and market-specific factors.']
  market_access_category varchar [note: 'Classification of foreign investor access to domestic capital markets including equities, fixed income, real estate, and private markets.']
  next_review_date date [note: 'Scheduled date for the next periodic review and update of this country outlook assessment by the research team.']
  outlook_horizon_years varchar [note: 'Forward-looking time horizon in years for which this country outlook assessment and projections are valid.']
  outlook_status varchar [note: 'Current lifecycle status of the country outlook assessment within the research governance workflow.']
  political_risk_category varchar [note: 'Categorical classification of political risk level based on governance stability, rule of law, corruption, and geopolitical tensions.']
  political_risk_score decimal(5,2) [note: 'Quantitative score assessing political stability, governance quality, regulatory predictability, and geopolitical risk on a 0-100 scale where higher indicates lower risk.']
  projected_gdp_growth_rate decimal(6,3) [note: 'Research team\'s forecast of real GDP growth rate expressed as a percentage for the outlook horizon, reflecting expected economic expansion or contraction.']
  projected_inflation_rate decimal(6,3) [note: 'Forecast of consumer price inflation rate expressed as a percentage, used for real return calculations and liability matching.']
  projected_unemployment_rate decimal(5,2) [note: 'Expected unemployment rate as a percentage of the labor force, indicating labor market health and social stability.']
  public_debt_gdp_pct decimal(6,2) [note: 'Total government debt outstanding as a percentage of GDP, key metric for sovereign credit analysis and debt sustainability assessment.']
  region varchar [note: 'Broad geographic region classification for portfolio allocation and macroeconomic analysis purposes. [ENUM-REF-CANDIDATE: North America|Latin America|Europe|Middle East|Africa|Asia Pacific|Oceania — 7 candidates stripped; promote to reference product]']
  regulatory_environment_score decimal(5,2) [note: 'Assessment score evaluating the quality, transparency, and investor-friendliness of the regulatory and legal framework on a 0-100 scale.']
  sovereign_credit_rating varchar [note: 'Current sovereign credit rating assigned by major rating agencies reflecting the country\'s creditworthiness and default risk.']
  updated_timestamp timestamp [note: 'Date and time when this country outlook assessment record was most recently modified or updated.']
  version_number varchar [note: 'Sequential version number tracking revisions and updates to this country outlook assessment over time.']

  Note: 'Master record of country and regional economic outlook assessments maintained by the research team, covering sovereign credit quality, political risk, regulatory environment, currency outlook, growth trajectory, and investment climate ratings.'
}

Table research.thematic_research {
  thematic_research_id varchar [pk, note: 'Unique identifier for the thematic research report.']
  employee_id varchar [note: 'Identifier of the principal research analyst responsible for authoring and maintaining this thematic research.']
  framework_id varchar [note: 'Foreign key linking to esg.framework. Business justification: Thematic research on ESG topics (energy transition, SFDR implications, taxonomy alignment) must reference the specific regulatory framework being analyzed.']
  peer_reviewer_employee_id varchar [note: 'Identifier of the senior analyst or research director responsible for peer reviewing this thematic research.']
  superseded_by_research_thematic_research_id varchar [note: 'Identifier of the newer thematic research report that supersedes this version, if applicable.']
  thematic_analyst_assignment_id varchar [note: 'Identifier of the principal research analyst responsible for authoring and maintaining this thematic research.']
  thematic_peer_reviewer_analyst_assignment_id varchar [note: 'Identifier of the senior analyst or research director responsible for peer reviewing this thematic research.']
  access_restriction_level varchar [note: 'Data classification level governing access permissions and distribution of the thematic research report.']
  affected_asset_classes varchar [note: 'Comma-separated list of asset classes materially impacted by this structural theme (e.g., public equities, private equity, infrastructure, real estate).']
  affected_sectors varchar [note: 'Comma-separated list of industry sectors and sub-sectors most exposed to this thematic trend.']
  approval_date date [note: 'Date when the thematic research report received final approval from research leadership for publication and distribution.']
  climate_relevance varchar [note: 'Assessment of the theme\'s relevance to climate transition, adaptation, and net-zero investment objectives.']
  confidence_level varchar [note: 'Research team\'s confidence level in the thematic thesis and projected investment outcomes based on data quality and analytical rigor.']
  created_timestamp timestamp [note: 'Timestamp when the thematic research record was first created in the research management system.']
  data_sources varchar [note: 'Comma-separated list of primary data sources, market intelligence providers, and research databases used in the thematic analysis (e.g., Bloomberg, FactSet, Preqin, PitchBook).']
  document_url varchar [note: 'Internal repository URL or file path to the full thematic research document and supporting materials.']
  esg_alignment_score decimal(5,2) [note: 'Quantitative score (0-100) assessing the alignment of this thematic trend with the fund\'s ESG and responsible investment objectives.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are materially integrated into the thematic research analysis and investment recommendations.']
  executive_summary varchar [note: 'High-level summary of the thematic research findings, key insights, and investment implications for IC and portfolio managers.']
  geographic_scope varchar [note: 'Geographic coverage and regional focus of the thematic research analysis.']
  ic_presentation_date date [note: 'Date when the thematic research was presented to the Investment Committee.']
  ic_presentation_flag boolean [note: 'Indicates whether this thematic research has been formally presented to the Investment Committee for strategic portfolio allocation decisions.']
  investment_horizon_years varchar [note: 'Long-term investment horizon in years over which this structural theme is expected to materialize and impact portfolio returns.']
  investment_implications varchar [note: 'Strategic investment implications and portfolio positioning recommendations derived from the thematic analysis.']
  key_drivers varchar [note: 'Primary macroeconomic, technological, regulatory, or social drivers underpinning this structural theme.']
  methodology_description varchar [note: 'Description of the research methodology, analytical frameworks, and modeling techniques employed in the thematic analysis.']
  next_review_date date [note: 'Scheduled date for the next formal review and potential update of the thematic research report.']
  peer_review_status varchar [note: 'Status of internal peer review process by senior research analysts and investment leadership.']
  publication_date date [note: 'Date when the thematic research report was officially published and made available to investment teams and IC.']
  related_deal_count varchar [note: 'Number of active deal pipeline opportunities and investments directly linked to this thematic research.']
  related_portfolio_exposure_aum decimal(20,2) [note: 'Total AUM in millions of base currency currently allocated to investments aligned with this thematic trend.']
  research_identifier varchar [note: 'Externally-known unique code or reference number for the thematic research report used in IC presentations and research libraries.']
  research_status varchar [note: 'Current lifecycle status of the thematic research report in the research workflow.']
  research_team varchar [note: 'Name of the research team or division that produced this thematic research report.']
  review_frequency_months varchar [note: 'Scheduled frequency in months for periodic review and update of the thematic research to reflect evolving market conditions.']
  risk_considerations varchar [note: 'Key risks, uncertainties, and potential headwinds that could impact the realization of this thematic investment opportunity.']
  tags varchar [note: 'Comma-separated metadata tags for categorization, search, and discovery of thematic research within the research library.']
  target_allocation_percentage decimal(5,2) [note: 'Strategic Asset Allocation (SAA) target percentage of total AUM recommended for investments aligned with this theme.']
  theme_category varchar [note: 'Primary thematic category classifying the structural trend covered by this research.']
  title varchar [note: 'Full title of the thematic research report describing the structural trend or investment theme.']
  updated_timestamp timestamp [note: 'Timestamp when the thematic research record was last modified or updated.']
  version_number varchar [note: 'Version identifier for tracking iterations and updates to the thematic research report over time.']

  Note: 'Master record of long-horizon thematic investment research produced by the research team covering structural trends relevant to the fund\'s long-duration mandate — e.g., energy transition, digital infrastructure, demographic shifts, deglobalization, AI'
}

Table research.coverage_universe {
  coverage_universe_id varchar [pk, note: 'Unique identifier for the coverage universe record. Primary key for the master record defining the research team\'s formally covered universe of issuers, sectors, geographies, and asset classes.']
  employee_id varchar [note: 'Identifier of the primary research analyst responsible for coverage of this entity.']
  issuer_esg_rating_id varchar [note: 'Foreign key linking to esg.issuer_esg_rating. Business justification: Research coverage of issuers requires current ESG ratings for integrated fundamental analysis. Analysts need direct access to ESG scores when evaluating investment opportunities.']
  lead_analyst_employee_id varchar [note: 'Identifier of the primary research analyst responsible for coverage of this entity.']
  asset_class varchar [note: 'Primary asset class category to which this coverage universe entry belongs, spanning all investment types managed by the pension fund.']
  aum_usd decimal(20,2) [note: 'Total assets under management for covered fund managers or asset managers, expressed in USD.']
  benchmark_index varchar [note: 'Primary benchmark index to which the covered entity is compared for performance attribution and relative valuation analysis.']
  bloomberg_ticker varchar [note: 'Bloomberg ticker symbol for the covered entity, enabling direct lookup in Bloomberg Terminal for market data and analytics.']
  coverage_initiation_date date [note: 'Date when formal research coverage of this entity was initiated by the research team.']
  coverage_status varchar [note: 'Current status of research coverage for this entity, indicating whether active analysis and monitoring is ongoing.']
  coverage_team varchar [note: 'Name of the research team or desk responsible for ongoing analysis and monitoring of this coverage universe entry.']
  coverage_tier varchar [note: 'Priority tier assigned to the coverage universe entry, reflecting depth of research effort and strategic importance to portfolio construction.']
  created_timestamp timestamp [note: 'Timestamp when the coverage universe record was first created in the system.']
  credit_rating varchar [note: 'External credit rating assigned to the covered entity by major rating agencies such as Moody\'s, S&P, or Fitch.']
  cusip varchar [note: 'CUSIP identifier for North American securities, used for trade settlement and regulatory reporting.']
  data_source varchar [note: 'Primary external data provider or system of record for market data and fundamental information on the covered entity.']
  entity_name varchar [note: 'Full legal or common name of the issuer, company, sovereign, or entity within the coverage universe.']
  esg_integration_flag boolean [note: 'Indicates whether ESG factors are formally integrated into the research coverage and investment analysis for this entity.']
  fund_strategy varchar [note: 'Investment strategy employed by covered fund managers, such as buyout, venture capital, growth equity, or distressed debt.']
  geography varchar [note: 'Primary geographic region or country of domicile for the covered entity, using ISO 3166-1 alpha-3 country codes.']
  ic_approval_required_flag boolean [note: 'Indicates whether investments in this coverage universe entry require explicit Investment Committee approval prior to execution.']
  investable_flag boolean [note: 'Indicates whether the covered entity is currently approved for investment by the Investment Committee, subject to mandate constraints.']
  investment_grade_flag boolean [note: 'Indicates whether the covered entity holds an investment grade credit rating, distinguishing IG from high yield issuers.']
  investment_style varchar [note: 'Investment approach or style characterizing the covered entity, such as value, growth, core-plus, opportunistic, or distressed.']
  isin varchar [note: 'ISO 6166 International Securities Identification Number for the covered security or instrument.']
  last_review_date date [note: 'Date of the most recent comprehensive research review or update for this coverage universe entry.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the covered entity, enabling global entity identification and regulatory reporting.']
  liquidity_classification varchar [note: 'Assessment of the liquidity profile of the covered entity or asset class, critical for portfolio construction and risk management.']
  market_cap_usd decimal(20,2) [note: 'Current market capitalization of the covered entity in USD, applicable to publicly traded issuers.']
  next_review_date date [note: 'Scheduled date for the next formal research review or coverage update, ensuring ongoing monitoring discipline.']
  regional_classification varchar [note: 'Market development classification for the geographic region, distinguishing developed, emerging, and frontier markets.']
  research_notes varchar [note: 'Internal research commentary and qualitative notes on the covered entity, capturing analyst insights and investment thesis.']
  restricted_flag boolean [note: 'Indicates whether the covered entity is subject to investment restrictions due to regulatory, ethical, or policy constraints.']
  restriction_reason varchar [note: 'Explanation of the reason for investment restriction, such as ESG exclusion, regulatory prohibition, or conflict of interest.']
  sector varchar [note: 'Industry sector classification for the covered entity, aligned with GICS or internal sector taxonomy.']
  sedol varchar [note: 'SEDOL identifier for securities traded on the London Stock Exchange and other European exchanges.']
  sub_asset_class varchar [note: 'Granular sub-category within the primary asset class, such as growth equity, value equity, core real estate, opportunistic infrastructure, or high yield credit.']
  sub_sector varchar [note: 'Detailed sub-sector or industry group within the primary sector, enabling granular thematic and sector research.']
  target_irr_percent decimal(5,2) [note: 'Target internal rate of return for private market investments or fund commitments, expressed as a percentage.']
  universe_code varchar [note: 'Business identifier code for the coverage universe entry, used for external reference and reporting.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the coverage universe record, supporting audit trail and data lineage.']
  vintage_year varchar [note: 'Year of fund commitment or initial investment for private market funds and co-investments within the coverage universe.']

  Note: 'Master record defining the research team\'s formally covered universe of issuers, sectors, geographies, and asset classes across ALL asset classes — including private markets, credit, and real assets — distinct from equity.coverage which is listed-equity'
}

Table research.analyst_assignment {
  analyst_assignment_id varchar [pk, note: 'Unique identifier for the research analyst assignment record.']
  analyst_employee_id varchar [note: 'Identifier of the research analyst assigned to coverage responsibility.']
  analyst_supervisor_employee_id varchar [note: 'Identifier of the senior analyst or research director supervising this assignment and responsible for quality assurance.']
  coverage_universe_id varchar [note: 'Identifier of the specific entity being covered, such as issuer Legal Entity Identifier (LEI), sector code, or geography code.']
  employee_id varchar [note: 'Identifier of the research analyst assigned to coverage responsibility.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: Research analysts are assigned to cover specific GP managers for ongoing due diligence monitoring.']
  primary_predecessor_assignment_analyst_assignment_id varchar [note: 'Identifier of the previous assignment record if this assignment is a continuation or transition from another analyst.']
  supervisor_employee_id varchar [note: 'Identifier of the senior analyst or research director supervising this assignment and responsible for quality assurance.']
  approval_date date [note: 'Date when the assignment was formally approved by the research director or Investment Committee (IC).']
  approval_status varchar [note: 'Approval workflow status of the assignment: draft, pending approval, approved by research director, rejected, or revision required.']
  approved_by varchar [note: 'Name or identifier of the research director or Investment Committee (IC) member who approved this assignment.']
  asset_class varchar [note: 'Primary asset class scope of the assignment: public equity, private equity, real estate, infrastructure, natural resources, credit, fixed income, or multi-asset.']
  assignment_end_timestamp timestamp [note: 'Precise timestamp when the analyst assignment was terminated or transitioned; null for active assignments.']
  assignment_identifier varchar [note: 'Business-readable unique identifier for the assignment, used in research systems and Investment Committee (IC) materials.']
  assignment_notes varchar [note: 'Free-text notes capturing special instructions, context, or historical information relevant to this assignment.']
  assignment_start_timestamp timestamp [note: 'Precise timestamp when the analyst assignment was initiated in the research management system.']
  assignment_status varchar [note: 'Current lifecycle status of the analyst assignment: active coverage, inactive, suspended, pending approval, or in transition.']
  assignment_type varchar [note: 'Role type of the assignment: primary analyst, secondary support, backup coverage, specialist consultant, or thematic research lead.']
  benchmark_index varchar [note: 'Primary benchmark index or reference portfolio used for performance comparison and relative valuation in this coverage assignment.']
  collaboration_team varchar [note: 'Names or identifiers of other analysts, portfolio managers, or teams collaborating on this coverage assignment.']
  confidentiality_level varchar [note: 'Data classification level for research outputs from this assignment: public, internal, confidential, or restricted.']
  conflict_description varchar [note: 'Description of any identified conflict of interest and mitigation measures in place, maintained for compliance and governance.']
  conflict_of_interest_flag boolean [note: 'Flag indicating whether a potential conflict of interest has been identified and documented for this assignment.']
  coverage_entity_name varchar [note: 'Human-readable name of the entity assigned for coverage, such as issuer legal name, sector name, or country name.']
  coverage_entity_type varchar [note: 'Type of entity assigned for research coverage: issuer, sector, geography, asset class, external fund manager, or portfolio.']
  coverage_priority varchar [note: 'Priority tier of the coverage assignment reflecting strategic importance and research intensity: tier 1 core, tier 2 standard, tier 3 monitoring, watchlist, or opportunistic.']
  coverage_scope varchar [note: 'Detailed description of the coverage scope, including specific mandates, thematic focus areas, or exclusions within the assigned entity.']
  created_timestamp timestamp [note: 'Timestamp when this assignment record was first created in the research management system.']
  data_source_systems varchar [note: 'Primary data source systems and platforms used for this assignment, such as Bloomberg Terminal, FactSet, Preqin, or internal Investment Book of Record (IBOR).']
  due_diligence_responsibility varchar [note: 'Level of due diligence responsibility assigned: full operational and financial due diligence, partial support, none, or advisory role.']
  effective_date date [note: 'Date when the analyst assignment becomes effective and coverage responsibility begins.']
  esg_integration_flag boolean [note: 'Flag indicating whether Environmental, Social, and Governance (ESG) analysis is required as part of this coverage assignment.']
  expiry_date date [note: 'Date when the analyst assignment expires or coverage responsibility ends; null for open-ended assignments.']
  geographic_focus varchar [note: 'Geographic region or country focus of the assignment, using three-letter ISO country codes or regional groupings.']
  ic_presentation_requirement boolean [note: 'Flag indicating whether this assignment requires regular presentations to the Investment Committee (IC).']
  last_review_date date [note: 'Date of the most recent formal review of the assignment, including scope validation and performance assessment.']
  macroeconomic_modeling_flag boolean [note: 'Flag indicating whether proprietary macroeconomic modeling and scenario analysis is required for this assignment.']
  next_review_date date [note: 'Scheduled date for the next formal review of the assignment scope, priority, and analyst performance.']
  peer_group varchar [note: 'Defined peer group or comparable set of entities used for relative analysis and benchmarking within this assignment.']
  performance_rating varchar [note: 'Most recent performance rating of the analyst on this assignment: exceeds expectations, meets expectations, below expectations, or not yet rated.']
  reporting_frequency varchar [note: 'Expected frequency of research reports and updates for this assignment: daily, weekly, monthly, quarterly, annual, or ad hoc.']
  research_mandate varchar [note: 'Formal research mandate or charter defining the analysts responsibilities, deliverables, and reporting requirements for this assignment.']
  review_frequency varchar [note: 'Scheduled frequency for formal review and reassessment of the assignment: monthly, quarterly, semi-annual, or annual.']
  sector_focus varchar [note: 'Industry sector or sub-sector focus of the assignment, using Global Industry Classification Standard (GICS) or internal taxonomy.']
  transition_reason varchar [note: 'Reason for assignment transition or termination, such as analyst departure, portfolio restructuring, or strategic reprioritization.']
  updated_by varchar [note: 'Identifier or name of the user or system that last updated this assignment record.']
  updated_timestamp timestamp [note: 'Timestamp when this assignment record was last modified, reflecting changes to scope, status, or analyst details.']
  valuation_methodology varchar [note: 'Primary valuation methodology or approach required for this assignment, such as Discounted Cash Flow (DCF), comparable company analysis, or Net Asset Value (NAV) modeling.']
  created_by varchar [note: 'Identifier or name of the user or system that created this assignment record.']

  Note: 'Transactional record of research analyst assignments to coverage entities (issuers, sectors, geographies, asset classes) within the research coverage universe.'
}

Table research.ic_research_pack {
  ic_research_pack_id varchar [pk, note: 'Unique identifier for the Investment Committee research package record.']
  due_diligence_id varchar [note: 'Foreign key linking to esg.due_diligence. Business justification: IC investment decision packs must incorporate formal ESG due diligence findings. Pension fund governance requires IC members to review ESG assessments before approval.']
  economic_scenario_id varchar [note: 'Reference to the macroeconomic scenario or stress test scenario used in the investment analysis.']
  employee_id varchar [note: 'Reference to the primary investment analyst or research professional responsible for preparing this research pack.']
  gp_profile_id varchar [note: 'Foreign key linking to manager.gp_profile. Business justification: IC research packs for manager selection/re-up decisions must identify the GP under evaluation. Core to Investment Committee manager approval workflow required by pension fund governance.']
  ic_employee_id varchar [note: 'Reference to the primary investment analyst or research professional responsible for preparing this research pack.']
  ic_meeting_id varchar [note: 'Reference to the Investment Committee meeting for which this research pack was prepared.']
  ic_peer_reviewer_employee_id varchar [note: 'Reference to the senior analyst or investment professional who conducted the peer review.']
  manager_mandate_id varchar [note: 'Foreign key linking to manager.manager_mandate. Business justification: IC packs for mandate renewals/amendments must reference the specific mandate under review. Essential for mandate lifecycle governance and IC decision tracking.']
  opportunity_id varchar [note: 'Reference to the investment opportunity or deal that this research pack supports.']
  peer_reviewer_employee_id varchar [note: 'Reference to the senior analyst or investment professional who conducted the peer review.']
  asset_class varchar [note: 'Primary asset class category of the investment opportunity covered by this research pack. [ENUM-REF-CANDIDATE: public_equity|private_equity|real_estate|infrastructure|natural_resources|credit|fixed_income|multi_asset — 8 candidates stripped; promote to']
  commitment_currency varchar [note: 'Three-letter ISO 4217 currency code for the recommended commitment amount.']
  confidentiality_level varchar [note: 'Data classification level governing access and distribution of this research pack.']
  created_timestamp timestamp [note: 'Timestamp when this research pack record was first created in the system.']
  decision_date date [note: 'Date on which the Investment Committee rendered its formal decision on this research pack.']
  decision_rationale varchar [note: 'Summary of the Investment Committee\'s reasoning and key considerations underlying the decision.']
  distribution_list varchar [note: 'Authorized recipients or distribution groups for this research pack (e.g., IC members, senior management, deal team).']
  document_version varchar [note: 'Version number or identifier of the research pack document for change control and audit purposes.']
  due_diligence_status varchar [note: 'Overall status of the due diligence process supporting this research pack.']
  esg_integration_summary varchar [note: 'Summary of how ESG factors have been integrated into the investment analysis and decision-making process.']
  esg_rating varchar [note: 'ESG rating or score assigned to the investment opportunity based on responsible investment assessment. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|not_rated — 8 candidates stripped; promote to reference product]']
  fair_value_currency varchar [note: 'Three-letter ISO 4217 currency code for the fair value estimate.']
  fair_value_estimate decimal(18,2) [note: 'Estimated fair value or enterprise value of the investment opportunity derived from valuation analysis.']
  file_path varchar [note: 'Storage location or URI of the research pack document in the enterprise document management system.']
  geographic_focus varchar [note: 'Primary geographic region or country focus of the investment opportunity (e.g., North America, Europe, Asia-Pacific, Global).']
  ic_decision varchar [note: 'Final decision outcome rendered by the Investment Committee on the investment proposal contained in this research pack.']
  ic_meeting_date date [note: 'Scheduled date of the Investment Committee meeting at which this research pack is or was presented.']
  investment_horizon_years varchar [note: 'Expected holding period or investment horizon expressed in years.']
  investment_strategy varchar [note: 'Specific investment strategy or sub-strategy within the asset class (e.g., growth equity, value-add real estate, core infrastructure).']
  investment_thesis varchar [note: 'Core investment thesis and value creation hypothesis articulated in the research pack.']
  key_risks_identified varchar [note: 'Summary of the principal investment risks identified during due diligence and research analysis.']
  mitigation_strategies varchar [note: 'Proposed strategies and actions to mitigate identified investment risks.']
  pack_reference_number varchar [note: 'Business identifier or document control number assigned to this research pack for tracking and citation purposes.']
  pack_title varchar [note: 'Formal title of the research package as presented to the Investment Committee.']
  pack_type varchar [note: 'Classification of the research pack by its purpose: new investment, follow-on capital, divestment recommendation, portfolio review, strategic asset allocation, or external manager selection.']
  page_count varchar [note: 'Total number of pages in the research pack document.']
  peer_review_status varchar [note: 'Status of internal peer review or quality assurance review of the research pack prior to Investment Committee submission.']
  recommended_commitment_amount decimal(18,2) [note: 'Proposed capital commitment amount recommended to the Investment Committee in the base currency.']
  research_team varchar [note: 'Name or identifier of the research team or investment team that prepared the research pack.']
  revision_date date [note: 'Date of the most recent revision or update to the research pack.']
  revision_notes varchar [note: 'Summary of changes or updates made in the current version of the research pack.']
  risk_rating varchar [note: 'Overall risk assessment rating assigned to the investment opportunity based on due diligence and analysis.']
  sector_focus varchar [note: 'Industry sector or sectors targeted by the investment opportunity (e.g., technology, healthcare, energy, financials).']
  submission_date date [note: 'Date on which the research pack was formally submitted to the Investment Committee for review.']
  submission_status varchar [note: 'Current lifecycle status of the research pack in the Investment Committee approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|deferred|withdrawn — 7 candidates stripped; promote to reference product]']
  target_irr decimal(5,2) [note: 'Target net Internal Rate of Return expressed as a percentage that the investment is expected to achieve.']
  target_moic decimal(5,2) [note: 'Target Multiple on Invested Capital representing the expected total value multiple relative to invested capital.']
  updated_by varchar [note: 'User identifier or name of the individual who last updated this research pack record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to this research pack record.']
  valuation_methodology varchar [note: 'Primary valuation approach or methodology employed in the investment analysis (e.g., DCF, comparable transactions, NAV).']
  created_by varchar [note: 'User identifier or name of the individual who created this research pack record.']

  Note: 'Master record of research packages formally prepared and submitted to the Investment Committee (IC) in support of investment decisions. Captures IC meeting reference, investment opportunity reference, pack type (new investment, follow-on, divestment'
}

Table research.market_consensus {
  market_consensus_id varchar [pk, note: 'Unique identifier for the market consensus record.']
  listed_security_id varchar [note: 'Reference to the security or instrument for which consensus estimates are collected.']
  macro_indicator_id varchar [note: 'Reference to the macroeconomic indicator for which consensus forecasts are collected.']
  superseded_by_consensus_market_consensus_id varchar [note: 'Reference to the newer consensus record that supersedes this estimate.']
  adjustment_rationale varchar [note: 'Explanation of the rationale for any proprietary adjustment applied to the consensus estimate.']
  analyst_count varchar [note: 'Number of analysts contributing estimates to the consensus calculation.']
  approval_status varchar [note: 'Current approval status of the consensus estimate within internal governance workflows.']
  approval_timestamp timestamp [note: 'Date and time when the consensus estimate was approved for use.']
  approved_by varchar [note: 'Name or identifier of the individual who approved the consensus estimate for use.']
  asset_class varchar [note: 'Asset class to which the consensus estimate applies. [ENUM-REF-CANDIDATE: public_equity|private_equity|fixed_income|real_estate|infrastructure|natural_resources|credit|macro — 8 candidates stripped; promote to reference product]']
  benchmark_comparison decimal(10,4) [note: 'Variance of the consensus estimate relative to a relevant benchmark or index, expressed as a percentage.']
  buy_count varchar [note: 'Number of analysts with a buy or strong buy recommendation.']
  collection_timestamp timestamp [note: 'Date and time when the consensus estimate was collected from the external data provider.']
  confidence_level decimal(5,2) [note: 'Statistical confidence level associated with the consensus estimate, expressed as a percentage.']
  consensus_identifier varchar [note: 'External identifier or ticker symbol used by the data provider to uniquely identify this consensus estimate.']
  consensus_rating varchar [note: 'Aggregated analyst recommendation rating for the security.']
  created_timestamp timestamp [note: 'Date and time when the market consensus record was first created in the system.']
  data_quality_flag boolean [note: 'Indicator of the quality and reliability of the consensus data.']
  data_source varchar [note: 'External data provider or aggregator from which the consensus estimate was sourced.']
  effective_date date [note: 'Date from which the consensus estimate is considered valid and applicable.']
  estimate_currency varchar [note: 'Three-letter ISO 4217 currency code in which the consensus estimate is denominated.']
  estimate_type varchar [note: 'Type of consensus estimate being captured (e.g., earnings per share, revenue, EBITDA, target price, macroeconomic indicator). [ENUM-REF-CANDIDATE: eps|revenue|ebitda|target_price|gdp|inflation|interest_rate|unemployment|credit_spread|fx_rate — 10']
  fiscal_quarter varchar [note: 'Fiscal quarter to which the consensus estimate applies (1-4).']
  fiscal_year varchar [note: 'Fiscal year to which the consensus estimate applies.']
  forecast_period varchar [note: 'Time period to which the consensus estimate applies (e.g., Q1 2024, FY 2025, 12M forward).']
  geographic_scope varchar [note: 'Three-letter ISO country code indicating the geographic region to which the consensus estimate applies.']
  high_estimate decimal(20,6) [note: 'Highest analyst estimate for the specified metric and period.']
  hold_count varchar [note: 'Number of analysts with a hold recommendation.']
  ic_submission_flag boolean [note: 'Indicates whether this consensus estimate was included in an Investment Committee presentation or submission.']
  last_revision_date date [note: 'Date of the most recent revision to the consensus estimate.']
  low_estimate decimal(20,6) [note: 'Lowest analyst estimate for the specified metric and period.']
  mean_estimate decimal(20,6) [note: 'Arithmetic mean of all analyst estimates for the specified metric and period.']
  median_estimate decimal(20,6) [note: 'Median value of all analyst estimates for the specified metric and period.']
  notes varchar [note: 'Additional notes or commentary regarding the consensus estimate, data quality, or usage considerations.']
  proprietary_adjustment decimal(20,6) [note: 'Internal adjustment applied to the external consensus estimate based on proprietary research or modeling.']
  revision_direction varchar [note: 'Direction of the most recent revision to the consensus estimate relative to the prior period.']
  revision_magnitude decimal(10,4) [note: 'Magnitude of the most recent revision to the consensus estimate, expressed as a percentage change.']
  sector_classification varchar [note: 'Industry sector classification of the security or indicator (e.g., GICS, ICB).']
  sell_count varchar [note: 'Number of analysts with a sell or underperform recommendation.']
  stale_threshold_days varchar [note: 'Number of days after which the consensus estimate is considered stale and requires refresh.']
  standard_deviation decimal(20,6) [note: 'Standard deviation of analyst estimates, indicating dispersion and consensus strength.']
  unit_of_measure varchar [note: 'Unit in which the estimate is expressed (e.g., millions, billions, percentage, basis points, per share).']
  updated_by varchar [note: 'Identifier of the user or system process that last updated the market consensus record.']
  updated_timestamp timestamp [note: 'Date and time when the market consensus record was last modified.']
  usage_context varchar [note: 'Business context or use case for which the consensus estimate is intended (e.g., portfolio construction, IC presentation, risk stress testing).']
  created_by varchar [note: 'Identifier of the user or system process that created the market consensus record.']

  Note: 'Transactional records of external market consensus estimates and forecasts collected from Bloomberg, FactSet, and sell-side aggregators for key macroeconomic indicators and security-level metrics (EPS, revenue, EBITDA, target price).'
}

Table research.research_yield_curve {
  research_yield_curve_id varchar [pk, note: 'Unique identifier for the yield curve definition tracked by the research team.']
  economic_scenario_id varchar [note: 'Foreign key linking to research.economic_scenario. Business justification: Yield curves are defined for specific economic scenarios; linking to economic_scenario provides scenario context and does not create a bidirectional conflict.']
  asset_class varchar [note: 'Primary asset class to which this yield curve applies.']
  benchmark_flag boolean [note: 'Indicates whether this curve is used as a benchmark for valuation and risk modeling across portfolios.']
  business_owner_name varchar [note: 'Name of the business owner or senior analyst accountable for the use and accuracy of this yield curve.']
  compounding_frequency varchar [note: 'Frequency at which interest is compounded for yield calculations on the curve.']
  country_code varchar [note: 'Three-letter ISO 3166 country code for the sovereign or primary jurisdiction of the curve.']
  created_timestamp timestamp [note: 'Timestamp when this yield curve definition record was first created in the research system.']
  currency_code varchar [note: 'Three-letter ISO 4217 currency code for the yield curve denomination.']
  curve_code varchar [note: 'Standardized code or ticker symbol for the yield curve used in market data systems and research models.']
  curve_name varchar [note: 'Human-readable name of the yield curve (e.g., US Treasury Curve, UK Gilt Curve, SOFR Swap Curve).']
  curve_status varchar [note: 'Current lifecycle status of the yield curve definition in the research library.']
  curve_type varchar [note: 'Classification of the yield curve by instrument category.']
  data_classification_level varchar [note: 'Confidentiality classification level for the yield curve data.']
  data_quality_score decimal(5,2) [note: 'Quantitative score (0-100) representing the completeness, accuracy, and timeliness of the yield curve data.']
  data_source_identifier varchar [note: 'Vendor-specific identifier or ticker used to retrieve the yield curve from the data source.']
  data_steward_name varchar [note: 'Name of the individual or team responsible for maintaining and validating this yield curve definition.']
  day_count_convention varchar [note: 'Day count convention used for calculating accrued interest and yield on the curve.']
  effective_date date [note: 'Date from which this yield curve definition became active and available for use in research and modeling.']
  expiry_date date [note: 'Date on which this yield curve definition is no longer active or was superseded by a new definition.']
  extrapolation_method varchar [note: 'Method used to extrapolate rates beyond the longest observed tenor.']
  ic_presentation_flag boolean [note: 'Indicates whether this yield curve is included in Investment Committee presentation materials.']
  interpolation_method varchar [note: 'Mathematical method used to interpolate rates between observed tenors on the yield curve.']
  issuer_type varchar [note: 'Type of issuer for the securities underlying the yield curve.']
  last_update_timestamp timestamp [note: 'Timestamp of the most recent data refresh for this yield curve.']
  model_integration_flag boolean [note: 'Indicates whether this yield curve is integrated into proprietary macroeconomic or valuation models.']
  notes varchar [note: 'Free-text field for additional context, methodology notes, or special considerations for this yield curve.']
  primary_data_source varchar [note: 'Primary vendor or system from which the yield curve data is sourced.']
  rating_category varchar [note: 'Credit rating bucket for credit spread curves, representing the average rating of underlying securities. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|unrated — 8 candidates stripped; promote to reference product]']
  regulatory_compliance_scope varchar [note: 'Regulatory frameworks and standards this yield curve must comply with (e.g., IFRS 13, GIPS, MiFID II).']
  risk_free_rate_proxy_flag boolean [note: 'Indicates whether this curve is used as a proxy for the risk-free rate in WACC and DCF calculations.']
  spread_over_benchmark_bps decimal(10,2) [note: 'Average spread in basis points over the benchmark sovereign curve, applicable for credit spread curves.']
  tenor_range_max_years decimal(10,4) [note: 'Longest maturity tenor available on the yield curve, expressed in years.']
  tenor_range_min_years decimal(10,4) [note: 'Shortest maturity tenor available on the yield curve, expressed in years.']
  update_frequency varchar [note: 'Frequency at which the yield curve data is refreshed from the source.']
  updated_by varchar [note: 'User or system identifier of the individual who last modified this yield curve definition record.']
  updated_timestamp timestamp [note: 'Timestamp when this yield curve definition record was last modified.']
  usage_context varchar [note: 'Description of the primary use cases for this yield curve within the organization (e.g., DCF valuation, risk stress testing, ALM).']
  validation_status varchar [note: 'Status of the most recent data quality validation check for this yield curve.']
  validation_timestamp timestamp [note: 'Timestamp of the most recent data quality validation check.']
  created_by varchar [note: 'User or system identifier of the individual who created this yield curve definition record.']

  Note: 'Master record of yield curve definitions tracked by the research team across sovereign and credit markets, including government yield curves (US Treasury, UK Gilts, German Bunds), swap curves (SOFR, SONIA), and credit spread curves by rating bucket (IG'
}

Table research.yield_curve_point {
  yield_curve_point_id varchar [pk, note: 'Unique identifier for the yield curve point observation record.']
  credit_yield_curve_id varchar [note: 'Reference to the parent yield curve definition to which this point belongs.']
  economic_scenario_id varchar [note: 'Reference to the economic scenario under which this yield curve point was generated or applies.']
  market_data_feed_id varchar [note: 'Reference to the market data feed configuration that delivered this observation.']
  superseded_by_yield_curve_point_id varchar [note: 'Reference to the yield curve point record that supersedes this one, if this record has been corrected or revised.']
  approval_status varchar [note: 'The approval status of this yield curve point for use in production analytics and reporting.']
  approval_timestamp timestamp [note: 'The timestamp when this yield curve point was approved for production use.']
  approved_by varchar [note: 'The name or identifier of the person who approved this yield curve point for production use.']
  benchmark_reference varchar [note: 'The benchmark rate or index this yield curve is based on (e.g., SOFR, LIBOR, Treasury, Swap).']
  compounding_frequency varchar [note: 'The compounding frequency for the yield calculation (e.g., annual, semi-annual, quarterly, continuous).']
  created_timestamp timestamp [note: 'The timestamp when this yield curve point record was first created in the system.']
  credit_rating varchar [note: 'The credit rating category for corporate or sovereign curves (e.g., AAA, AA, A, BBB, BB, B).']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code for the yield curve (e.g., USD, EUR, GBP).']
  curve_type varchar [note: 'The type of yield curve this point belongs to: zero-coupon, par, forward, or discount factor curve.']
  data_quality_flag boolean [note: 'Indicates the quality status of this data point: verified, unverified, stale, suspect, or corrected.']
  data_source varchar [note: 'The vendor or system that provided this yield curve point (e.g., Bloomberg, FactSet, internal model).']
  data_steward_name varchar [note: 'The name of the data steward or team responsible for the quality and governance of this yield curve point.']
  day_count_convention varchar [note: 'The day count convention used for yield calculation (e.g., ACT/360, ACT/365, 30/360, ACT/ACT).']
  discount_factor decimal(18,12) [note: 'The discount factor at this tenor, used for present value calculations in fixed income analytics.']
  effective_date date [note: 'The date from which this yield curve point becomes effective for use in valuation and risk calculations.']
  expiry_date date [note: 'The date after which this yield curve point is no longer valid or should not be used.']
  forward_rate decimal(12,8) [note: 'The implied forward rate starting at this tenor, derived from the yield curve structure.']
  geographic_scope varchar [note: 'The three-letter ISO country code representing the geographic market for this yield curve (e.g., USA, GBR, CAN).']
  interpolation_method varchar [note: 'The mathematical method used to interpolate this point if not directly observed (e.g., linear, cubic spline, Nelson-Siegel).']
  is_active boolean [note: 'Indicates whether this yield curve point is currently active and should be used in calculations and analytics.']
  is_interpolated boolean [note: 'Indicates whether this yield curve point was interpolated (True) or directly observed (False).']
  is_regulatory_required boolean [note: 'Indicates whether this yield curve point is required for regulatory reporting or compliance purposes.']
  market_segment varchar [note: 'The market segment this yield curve represents: government, corporate, municipal, sovereign, or swap market.']
  notes varchar [note: 'Free-text notes providing additional context, methodology details, or special considerations for this yield curve point.']
  observation_date date [note: 'The date on which this yield curve point was observed or published.']
  observation_timestamp timestamp [note: 'The precise timestamp when this yield curve point was observed or published by the source.']
  quote_type varchar [note: 'The type of market quote: mid, bid, ask, close, or open price.']
  regulatory_framework varchar [note: 'The regulatory framework or standard this yield curve point supports (e.g., IFRS 9, Basel III, SEC).']
  source_identifier varchar [note: 'The unique identifier or ticker symbol from the source system (e.g., Bloomberg ticker, FactSet ID).']
  spread_bps decimal(10,2) [note: 'The spread over a benchmark rate (e.g., SOFR, Treasury) at this tenor, expressed in basis points.']
  stress_test_flag boolean [note: 'Indicates whether this yield curve point is part of a stress testing or scenario analysis exercise.']
  tenor varchar [note: 'The maturity tenor of this yield curve point (e.g., 3M, 6M, 1Y, 2Y, 5Y, 10Y, 20Y, 30Y). [ENUM-REF-CANDIDATE: 1M|3M|6M|9M|1Y|2Y|3Y|5Y — 8 candidates stripped; promote to reference product]']
  tenor_days varchar [note: 'The tenor expressed in calendar days for precise calculation and interpolation.']
  updated_timestamp timestamp [note: 'The timestamp when this yield curve point record was last modified or updated.']
  usage_context varchar [note: 'The business context or purpose for which this yield curve point is used (e.g., valuation, risk, stress testing, IC presentation).']
  validation_notes varchar [note: 'Free-text notes documenting validation issues, corrections, or manual review findings.']
  validation_status varchar [note: 'The validation status of this yield curve point after quality checks and business rule validation.']
  version_number varchar [note: 'The version number of this yield curve point, incremented when corrections or revisions are published.']
  yield_bps decimal(10,2) [note: 'The observed yield expressed in basis points for fixed income analytics (e.g., 325 bps for 3.25%).']
  yield_rate decimal(12,8) [note: 'The observed yield or interest rate at this tenor, expressed as a decimal (e.g., 0.0325 for 3.25%).']

  Note: 'Transactional time-series records of yield curve data points at specific tenors and observation dates. Captures yield curve reference, tenor (3M, 6M, 1Y, 2Y, 5Y, 10Y, 20Y, 30Y), observed yield or spread (bps), observation date, and data source.'
}

Table research.research_fx_rate {
  research_fx_rate_id varchar [pk, note: 'Unique identifier for the foreign exchange rate record.']
  market_data_feed_id varchar [note: 'Foreign key reference to the market data feed configuration that delivered this FX rate observation.']
  ask_rate decimal(18,8) [note: 'The rate at which the market is willing to sell the base currency, expressed in quote currency units.']
  base_currency varchar [note: 'Three-letter ISO code for the base currency in the currency pair.']
  benchmark_rate_flag boolean [note: 'Indicates whether this FX rate is designated as the official benchmark rate used for portfolio valuation and Net Asset Value (NAV) calculation.']
  bid_ask_spread_bps decimal(10,4) [note: 'The difference between the ask rate and bid rate expressed in basis points, indicating market liquidity and transaction cost.']
  bid_rate decimal(18,8) [note: 'The rate at which the market is willing to buy the base currency, expressed in quote currency units.']
  central_bank_rate_flag boolean [note: 'Indicates whether this rate is sourced directly from a central bank official fixing or reference rate.']
  created_timestamp timestamp [note: 'The timestamp when this FX rate record was first created in the lakehouse silver layer.']
  cross_rate_calculation_method varchar [note: 'Description of the methodology used to derive cross rates when direct market quotes are unavailable, ensuring transparency in valuation.']
  currency_pair varchar [note: 'The foreign exchange currency pair in ISO format, representing base currency and quote currency (e.g., USD/JPY, EUR/USD).']
  data_lineage_reference varchar [note: 'Identifier or reference linking this FX rate observation to its upstream source system batch or feed ingestion event for audit trail purposes.']
  data_quality_score decimal(5,2) [note: 'Automated quality score assigned to the FX rate observation based on timeliness, completeness, and consistency checks, expressed as a percentage.']
  fixing_time timestamp [note: 'The standardized time of day when the official FX fixing rate is published, in HH:MM format (e.g., 16:00 for WMR 4pm London fix).']
  forward_points decimal(12,6) [note: 'The adjustment added to or subtracted from the spot rate to calculate the forward rate, reflecting interest rate differentials between currencies.']
  forward_rate decimal(18,8) [note: 'The agreed-upon exchange rate for a currency transaction that will occur at a future date, used for hedging FX risk.']
  forward_tenor varchar [note: 'The time period until the forward contract settlement date, expressed in standard market convention (e.g., 1M, 3M, 6M, 1Y).']
  hedging_eligible_flag boolean [note: 'Indicates whether this currency pair is approved for use in the funds foreign exchange hedging program.']
  implied_volatility decimal(8,4) [note: 'The market-implied volatility derived from FX option prices, used for risk modeling and hedging strategy.']
  last_updated_timestamp timestamp [note: 'The timestamp when this FX rate record was last refreshed or modified in the research data repository.']
  liquidity_tier varchar [note: 'Classification of the currency pair based on market liquidity and trading volume, used for risk assessment and execution strategy.']
  mid_rate decimal(18,8) [note: 'The midpoint between the bid and ask rates, commonly used for valuation and performance measurement purposes.']
  notes varchar [note: 'Free-text field for capturing additional context, exceptions, or manual adjustments related to this FX rate observation.']
  outlier_flag boolean [note: 'Indicates whether the FX rate observation was flagged as a statistical outlier requiring manual review before use in valuation.']
  quote_convention varchar [note: 'The market convention used for quoting the currency pair, indicating whether it follows direct, indirect, or cross-rate methodology.']
  quote_currency varchar [note: 'Three-letter ISO code for the quote currency in the currency pair.']
  rate_source varchar [note: 'The originating system or vendor that provided the FX rate data (e.g., Bloomberg Terminal, FactSet, internal treasury system). [ENUM-REF-CANDIDATE: bloomberg|factset|reuters|treasury_system|central_bank|broker|internal_model — 7 candidates stripped']
  rate_source_identifier varchar [note: 'The specific ticker, code, or reference identifier used by the source system to uniquely identify this FX rate feed.']
  rate_status varchar [note: 'Current status of the FX rate record indicating data quality and usability for valuation and risk calculations.']
  rate_timestamp timestamp [note: 'Precise date and time when the FX rate was observed or captured from the market data feed.']
  rate_type varchar [note: 'Classification of the FX rate indicating whether it is a spot rate, forward rate, swap rate, or cross rate.']
  regulatory_reporting_flag boolean [note: 'Indicates whether this FX rate is designated for use in regulatory reporting submissions to SEC, or other governing bodies.']
  settlement_date date [note: 'The date on which the currency exchange transaction is scheduled to settle and funds are exchanged.']
  spot_rate decimal(18,8) [note: 'The current market exchange rate for immediate delivery, expressed as units of quote currency per one unit of base currency.']
  trading_session varchar [note: 'The geographic trading session or market center during which the FX rate was observed.']
  usage_context varchar [note: 'The primary business use case for which this FX rate observation is intended, guiding appropriate application across investment processes.']
  volatility_30d decimal(8,4) [note: 'The annualized historical volatility of the currency pair over the trailing 30-day period, expressed as a percentage.']

  Note: 'Transactional records of foreign exchange (FX) spot and forward rates captured from Bloomberg and treasury systems for all currency pairs relevant to the fund\'s global investment portfolio.'
}

Table research.asset_class_outlook {
  asset_class_outlook_id varchar [pk, note: 'Unique identifier for the asset class outlook assessment record.']
  asset_employee_id varchar [note: 'Reference to the senior research analyst responsible for authoring and owning the outlook assessment.']
  asset_peer_reviewer_employee_id varchar [note: 'Reference to the senior analyst or research director who conducted the peer review of the outlook assessment.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Asset class return projections must be scenario-aligned for climate risk integration. Pension funds producing climate-adjusted CMAs need to reference specific climate scenarios (1.5°C']
  economic_scenario_id varchar [note: 'Reference to the base macroeconomic scenario used for outlook projections and stress testing.']
  employee_id varchar [note: 'Reference to the senior research analyst responsible for authoring and owning the outlook assessment.']
  peer_reviewer_employee_id varchar [note: 'Reference to the senior analyst or research director who conducted the peer review of the outlook assessment.']
  superseded_by_outlook_asset_class_outlook_id varchar [note: 'Reference to the subsequent outlook assessment that supersedes this version, enabling version lineage tracking.']
  allocation_delta_percentage decimal(8,4) [note: 'Recommended change in allocation percentage, calculated as target allocation minus current allocation.']
  approval_date date [note: 'Date when the outlook assessment received final approval from Investment Committee (IC) or designated authority.']
  asset_class varchar [note: 'Primary asset class covered by this outlook assessment, aligned with Strategic Asset Allocation (SAA) framework.']
  climate_scenario_alignment varchar [note: 'Assessment of asset class alignment with climate transition scenarios and net-zero pathways per Task Force on Climate-related Financial Disclosures (TCFD).']
  confidence_level varchar [note: 'Research team confidence in the outlook projections and investment view, reflecting data quality and forecast uncertainty.']
  confidentiality_level varchar [note: 'Data classification level governing access and distribution of the outlook assessment per information security policy.']
  created_timestamp timestamp [note: 'Timestamp when the outlook assessment record was first created in the system.']
  current_allocation_percentage decimal(8,4) [note: 'Current portfolio allocation percentage to the asset class at the time of outlook publication.']
  data_sources varchar [note: 'Primary data sources and market intelligence platforms used for outlook analysis, such as Bloomberg Terminal, FactSet, or Preqin.']
  document_url varchar [note: 'File path or URL to the full outlook assessment document, typically stored in document management system.']
  effective_date date [note: 'Date from which the outlook assessment becomes effective for portfolio construction and Strategic Asset Allocation (SAA) decisions.']
  esg_integration_flag boolean [note: 'Indicates whether Environmental, Social, and Governance (ESG) factors were formally integrated into the outlook assessment.']
  esg_rating varchar [note: 'Overall Environmental, Social, and Governance (ESG) rating for the asset class, using MSCI ESG rating scale. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC — 7 candidates stripped; promote to reference product]']
  expected_return_percentage decimal(8,4) [note: 'Projected annualized return for the asset class over the outlook horizon, expressed as a percentage.']
  expected_volatility_percentage decimal(8,4) [note: 'Projected annualized volatility (standard deviation of returns) for the asset class, expressed as a percentage.']
  expiry_date date [note: 'Date when the outlook assessment expires and is superseded by a subsequent outlook, nullable for open-ended outlooks.']
  geographic_focus varchar [note: 'Primary geographic regions or countries covered by the outlook assessment, using 3-letter ISO country codes or regional groupings.']
  ic_decision varchar [note: 'Investment Committee (IC) decision outcome following presentation and review of the outlook assessment.']
  ic_presentation_date date [note: 'Date when the outlook assessment was presented to the Investment Committee (IC) for review and approval.']
  ic_presentation_flag boolean [note: 'Indicates whether the outlook assessment was formally presented to the Investment Committee (IC) for approval.']
  investment_opportunities varchar [note: 'Specific investment themes, strategies, or opportunities identified within the asset class for portfolio construction.']
  investment_view varchar [note: 'Overall investment stance recommended by the research team relative to Strategic Asset Allocation (SAA) benchmark weights.']
  key_drivers varchar [note: 'Primary macroeconomic, market, and structural factors driving the outlook assessment and investment view.']
  key_risks varchar [note: 'Principal downside risks and uncertainties that could cause actual outcomes to deviate from the outlook projections.']
  methodology_description varchar [note: 'Summary of analytical methodology and modeling approach used to develop the outlook assessment and return projections.']
  next_review_date date [note: 'Scheduled date for the next formal review and update of the outlook assessment.']
  notes varchar [note: 'Additional commentary, caveats, or contextual information relevant to the outlook assessment.']
  outlook_horizon_years varchar [note: 'Time horizon in years for which the outlook assessment provides forward-looking projections and investment recommendations.']
  outlook_identifier varchar [note: 'Business-readable identifier for the outlook assessment, typically combining asset class and publication period.']
  outlook_status varchar [note: 'Current lifecycle status of the outlook assessment within the research and approval workflow.']
  peer_review_status varchar [note: 'Status of internal peer review process for quality assurance and validation of outlook methodology and conclusions.']
  publication_date date [note: 'Date when the outlook assessment was formally published and made available to Investment Committee (IC) and portfolio managers.']
  research_team varchar [note: 'Name of the research team or division responsible for producing the outlook assessment.']
  review_frequency_months varchar [note: 'Scheduled frequency in months for updating and refreshing the outlook assessment, typically quarterly or semi-annually.']
  sector_focus varchar [note: 'Primary economic sectors or industries covered by the outlook assessment, using standard sector classification frameworks.']
  sharpe_ratio decimal(8,4) [note: 'Risk-adjusted return metric calculated as excess return over risk-free rate divided by volatility.']
  sub_asset_class varchar [note: 'Granular sub-category within the primary asset class, such as Investment Grade (IG), High Yield (HY), or private credit for credit asset class.']
  target_allocation_percentage decimal(8,4) [note: 'Recommended allocation percentage for the asset class within the total portfolio, aligned with Tactical Asset Allocation (TAA) framework.']
  title varchar [note: 'Formal title of the asset class outlook assessment as presented to Investment Committee (IC) and stakeholders.']
  updated_timestamp timestamp [note: 'Timestamp when the outlook assessment record was last modified, supporting audit trail and change tracking.']
  valuation_assessment varchar [note: 'Overall valuation judgment for the asset class relative to historical norms and fundamental fair value estimates.']
  valuation_metric varchar [note: 'Primary valuation metric used for assessment, such as Price-to-Earnings (P/E), Yield to Maturity (YTM), or Net Operating Income (NOI) yield.']
  valuation_metric_value decimal(12,4) [note: 'Current value of the primary valuation metric at the time of outlook publication.']
  version_number varchar [note: 'Version identifier for the outlook assessment, supporting revision control and change tracking.']

  Note: 'Master record of formal asset class outlook assessments produced by the research team covering all asset classes in the fund\'s SAA: public equities, private equity, real estate, infrastructure, natural resources, credit (IG, HY, private credit), and'
}

Table research.capital_market_assumption {
  capital_market_assumption_id varchar [pk, note: 'Unique identifier for the capital market assumption record.']
  climate_scenario_id varchar [note: 'Foreign key linking to esg.climate_scenario. Business justification: Capital market assumptions used for SAA must incorporate climate transition impacts. Net-zero committed pension funds require CMAs calibrated to specific climate scenarios for']
  superseded_by_assumption_id varchar [note: 'Reference to the capital market assumption ID that supersedes this assumption, enabling version control and historical tracking of assumption evolution.']
  approval_date date [note: 'The date on which this capital market assumption was formally approved by the investment committee (IC) or designated authority for use in portfolio construction and modeling.']
  approval_status varchar [note: 'Current approval status of the capital market assumption within the governance workflow, indicating whether it is draft, pending review, approved for use, rejected, or superseded by a newer version.']
  approved_by varchar [note: 'Name or identifier of the individual or committee that formally approved this capital market assumption for use in strategic asset allocation (SAA) and investment decision-making.']
  asset_class varchar [note: 'The asset class to which this capital market assumption applies, such as public equities, private equity, real estate, infrastructure, natural resources, or credit investments.']
  assumption_code varchar [note: 'Short code or identifier for the capital market assumption set, used for reference in investment committee (IC) materials and system integration.']
  assumption_name varchar [note: 'Descriptive name of the capital market assumption set used for strategic asset allocation (SAA) and asset-liability management (ALM) modeling.']
  assumption_owner varchar [note: 'Name or identifier of the research team member or analyst responsible for maintaining and updating this capital market assumption.']
  assumption_type varchar [note: 'Type of capital market assumption, such as expected return, volatility, correlation, risk premium, inflation, or interest rate projection.']
  benchmark_reference varchar [note: 'Reference to the market benchmark or index against which this capital market assumption is compared or calibrated, such as MSCI World, S&P 500, or Bloomberg Barclays Aggregate.']
  calibration_date date [note: 'The date on which the capital market assumption was calibrated or derived using historical data and forward-looking projections.']
  climate_scenario_alignment varchar [note: 'Reference to the climate scenario framework to which this capital market assumption is aligned, such as Task Force on Climate-related Financial Disclosures (TCFD) scenarios or Paris Agreement pathways.']
  confidence_level varchar [note: 'Qualitative assessment of the confidence level in the accuracy and reliability of this capital market assumption, based on data quality, model robustness, and market stability.']
  correlation_coefficient decimal(5,4) [note: 'The expected correlation coefficient between this asset class and a reference benchmark or other asset classes, ranging from -1 to +1, used in portfolio diversification analysis.']
  created_timestamp timestamp [note: 'Timestamp indicating when this capital market assumption record was first created in the system, supporting audit trail and data lineage requirements.']
  currency_code varchar [note: 'The three-letter ISO 4217 currency code in which the capital market assumption returns and values are denominated, such as USD, EUR, GBP, or JPY.']
  data_source varchar [note: 'Primary data sources used to develop the capital market assumption, such as Bloomberg Terminal, FactSet, MSCI, or proprietary macroeconomic models.']
  documentation_url varchar [note: 'Uniform resource locator (URL) or file path to the detailed documentation, research report, or investment memorandum (IM) supporting this capital market assumption.']
  effective_date date [note: 'The date from which this capital market assumption becomes effective and is formally adopted for use in strategic asset allocation (SAA) and asset-liability management (ALM) modeling.']
  esg_integration_flag boolean [note: 'Boolean flag indicating whether environmental, social, and governance (ESG) factors were integrated into the development of this capital market assumption.']
  expected_return_percentage decimal(10,4) [note: 'The long-term expected annualized return for the asset class or market segment, expressed as a percentage, used in strategic asset allocation (SAA) optimization.']
  expected_volatility_percentage decimal(10,4) [note: 'The expected annualized standard deviation of returns, expressed as a percentage, representing the anticipated risk level for the asset class or market segment.']
  expiry_date date [note: 'The date on which this capital market assumption expires or is scheduled for review and potential revision, ensuring assumptions remain current and relevant.']
  geographic_scope varchar [note: 'Geographic region or market to which this assumption applies, such as global, developed markets, emerging markets, or specific country codes (ISO 3166-1 alpha-3).']
  ic_presentation_date date [note: 'The date on which this capital market assumption was presented to the investment committee (IC) for review, discussion, and approval.']
  ic_presentation_flag boolean [note: 'Boolean flag indicating whether this capital market assumption was presented to the investment committee (IC) for formal review and approval.']
  inflation_assumption_percentage decimal(10,4) [note: 'The long-term expected inflation rate assumption, expressed as a percentage, used to calculate real returns and for liability-driven investment (LDI) modeling.']
  last_review_date date [note: 'The most recent date on which this capital market assumption was formally reviewed by the research team or investment committee (IC).']
  methodology_description varchar [note: 'Detailed description of the methodology and analytical approach used to derive the capital market assumption, including models, data sources, and calibration techniques.']
  model_version varchar [note: 'Version identifier of the proprietary macroeconomic or capital market model used to generate this assumption, enabling traceability and reproducibility.']
  next_review_date date [note: 'The scheduled date for the next formal review of this capital market assumption, ensuring timely updates to reflect changing market conditions.']
  notes varchar [note: 'Additional notes, comments, or qualitative observations related to this capital market assumption, including key assumptions, limitations, or contextual information.']
  real_return_percentage decimal(10,4) [note: 'The expected return adjusted for inflation, expressed as a percentage, representing the purchasing power growth of the investment over the time horizon.']
  review_frequency_months varchar [note: 'The frequency in months at which this capital market assumption is scheduled for formal review and potential update by the research team.']
  risk_free_rate_percentage decimal(10,4) [note: 'The assumed risk-free rate of return, typically based on government bond yields such as Treasury bills (T-Bills) or Secured Overnight Financing Rate (SOFR), expressed as a percentage.']
  risk_premium_bps varchar [note: 'The expected risk premium over the risk-free rate, expressed in basis points (bps), representing the additional return required for bearing investment risk.']
  sector_scope varchar [note: 'Economic sector or industry classification to which this assumption applies, using standard sector classification frameworks such as GICS or ICB.']
  sharpe_ratio decimal(10,4) [note: 'The expected risk-adjusted return metric calculated as excess return over the risk-free rate divided by volatility, used to compare investment efficiency across asset classes.']
  stress_testing_enabled boolean [note: 'Boolean flag indicating whether this capital market assumption is enabled for use in macroeconomic stress testing and scenario analysis for risk management purposes.']
  time_horizon_years varchar [note: 'The projection time horizon in years for which this capital market assumption is applicable, typically aligned with strategic asset allocation (SAA) planning cycles.']
  updated_timestamp timestamp [note: 'Timestamp indicating when this capital market assumption record was last modified, supporting audit trail and change tracking requirements.']
  usage_context varchar [note: 'Description of the primary use cases and contexts in which this capital market assumption is applied, such as strategic asset allocation (SAA), asset-liability management (ALM), or actuarial liability matching.']
  version_number varchar [note: 'Version number or identifier for this capital market assumption, enabling tracking of revisions and updates over time.']

  Note: 'Master record of long-term capital market assumptions (CMAs) formally adopted by the research team for use in SAA optimization, ALM modeling, and actuarial liability matching.'
}

Table research.calendar {
  calendar_id varchar [pk, note: 'Unique identifier for the research calendar entry.']
  analyst_assignment_id varchar [note: 'Foreign key reference to the analyst or researcher responsible for this calendar event.']
  employee_id varchar [note: 'Foreign key reference to the analyst or researcher responsible for this calendar event.']
  macro_indicator_id varchar [note: 'Foreign key reference to the macroeconomic indicator master record, if applicable.']
  parent_event_calendar_id varchar [note: 'Foreign key reference to the parent calendar entry for recurring events.']
  research_report_id varchar [note: 'Foreign key reference to the research report scheduled for publication on this date.']
  actual_date date [note: 'The date on which the event actually occurred, if different from scheduled.']
  actual_end_time timestamp [note: 'Precise timestamp when the event actually concluded.']
  actual_start_time timestamp [note: 'Precise timestamp when the event actually began.']
  approval_required_flag boolean [note: 'Indicates whether the event requires formal approval before being finalized.']
  approval_status varchar [note: 'Current approval state of the calendar event.']
  approval_timestamp timestamp [note: 'Timestamp when the event was approved.']
  approved_by varchar [note: 'Name or identifier of the person who approved the event.']
  asset_class_relevance varchar [note: 'Asset classes to which this event is most relevant, such as public equities, private equity, real estate, infrastructure, credit, or natural resources.']
  attendee_count varchar [note: 'Number of expected or actual attendees for the event.']
  created_timestamp timestamp [note: 'Timestamp when this calendar entry was first created in the system.']
  distribution_list varchar [note: 'Comma-separated list of stakeholder groups or individuals who should receive information about this event.']
  duration_minutes varchar [note: 'Expected duration of the event in minutes.']
  event_category varchar [note: 'High-level grouping of the event for organizational and filtering purposes.']
  event_description varchar [note: 'Detailed narrative describing the purpose, scope, and content of the calendar event.']
  event_identifier varchar [note: 'Business-readable unique code or reference number for the calendar event.']
  event_source varchar [note: 'Origin or provider of the event information.']
  event_status varchar [note: 'Current lifecycle state of the calendar event.']
  event_title varchar [note: 'Descriptive title of the scheduled research event or publication.']
  event_type varchar [note: 'Classification of the calendar event indicating the nature of the scheduled activity. [ENUM-REF-CANDIDATE']
  external_reference_code varchar [note: 'Identifier from external systems such as Bloomberg or FactSet for cross-referencing.']
  external_url varchar [note: 'Web link to external event details or related documentation.']
  geographic_scope varchar [note: 'Geographic region or country to which the event is relevant, using 3-letter ISO country codes or regional identifiers.']
  ic_meeting_date date [note: 'Date of the Investment Committee meeting associated with this event.']
  ic_presentation_flag boolean [note: 'Indicates whether this event is an Investment Committee presentation.']
  indicator_name varchar [note: 'Name of the macroeconomic indicator being released, if applicable (e.g., CPI, GDP, unemployment rate).']
  location varchar [note: 'Physical or virtual location where the event takes place.']
  notes varchar [note: 'Additional free-text notes or comments about the event.']
  notification_required_flag boolean [note: 'Indicates whether stakeholders should be notified about this event.']
  notification_sent_timestamp timestamp [note: 'Timestamp when notification was sent to stakeholders.']
  owner_team varchar [note: 'Name of the research team or department responsible for the event.']
  priority_level varchar [note: 'Importance ranking of the event for research and investment decision-making.']
  recurrence_end_date date [note: 'Date when the recurring event series is scheduled to end.']
  recurrence_pattern varchar [note: 'Frequency pattern for recurring events.']
  scheduled_date date [note: 'The date on which the event is planned to occur.']
  scheduled_end_time timestamp [note: 'Precise timestamp when the event is scheduled to conclude.']
  scheduled_start_time timestamp [note: 'Precise timestamp when the event is scheduled to begin.']
  sector_relevance varchar [note: 'Industry sectors or thematic areas to which the event applies.']
  tags varchar [note: 'Comma-separated keywords or labels for categorization and search.']
  time_zone varchar [note: 'Time zone in which the event is scheduled, using IANA time zone database identifiers.']
  updated_timestamp timestamp [note: 'Timestamp when this calendar entry was last modified.']
  visibility_scope varchar [note: 'Access level determining who can view this calendar entry.']

  Note: 'Master record of the research team\'s planned publication and event calendar, including scheduled macro indicator releases (e.g., CPI release dates, central bank meeting dates, earnings seasons), planned research report publication dates, IC presentation'
}

Table research.data_vendor {
  data_vendor_id varchar [pk, note: 'Unique identifier for the external data vendor. Primary key.']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Data vendors are external legal entities requiring unified counterparty management. Linking to actor enables consolidated vendor risk assessment, contract management, and regulatory reporting']
  kyc_record_id varchar [note: 'Foreign key linking to compliance.kyc_record. Business justification: Pension funds must perform KYC on all counterparties including data vendors per AML regulations. Vendor onboarding requires KYC verification.']
  annual_cost decimal(18,2) [note: 'Total annual cost of the vendor subscription or service agreement.']
  asset_class_coverage varchar [note: 'Comma-separated list of asset classes covered by the vendor data.']
  auto_renewal_flag boolean [note: 'Indicates whether the vendor contract automatically renews unless explicitly terminated.']
  backup_vendor_available_flag boolean [note: 'Indicates whether an alternative backup vendor is available for business continuity.']
  business_owner_name varchar [note: 'Name of the business owner or sponsor responsible for the vendor relationship.']
  consuming_systems varchar [note: 'Comma-separated list of internal systems that consume data from this vendor.']
  contract_end_date date [note: 'Date when the vendor contract or subscription is scheduled to expire or terminate.']
  contract_renewal_date date [note: 'Next scheduled date for contract renewal or renegotiation with the vendor.']
  contract_start_date date [note: 'Date when the vendor contract or subscription agreement became effective.']
  cost_currency varchar [note: 'ISO 4217 three-letter currency code for the annual cost.']
  created_timestamp timestamp [note: 'Timestamp when the vendor record was first created in the system.']
  data_classification_level varchar [note: 'Highest data classification level of the data provided by this vendor.']
  data_coverage_scope varchar [note: 'Description of the asset classes, geographies, or data domains covered by the vendor.']
  data_delivery_method varchar [note: 'Primary method by which the vendor delivers data to the organization.']
  data_quality_sla_pct decimal(5,2) [note: 'Contractual data quality service level agreement expressed as a percentage.']
  data_retention_period_days varchar [note: 'Number of days the organization is contractually permitted to retain vendor data.']
  data_steward_name varchar [note: 'Name of the data steward responsible for managing data quality and governance for this vendor.']
  delivery_frequency varchar [note: 'Frequency at which the vendor provides data updates or refreshes.']
  documentation_url varchar [note: 'URL or file path to the vendor contract, service documentation, or data dictionary.']
  geographic_coverage varchar [note: 'Geographic regions or countries covered by the vendor data feeds.']
  last_vendor_review_date date [note: 'Date of the most recent vendor performance or compliance review.']
  lei varchar [note: 'ISO 17442 Legal Entity Identifier for the vendor, enabling global counterparty identification.']
  next_vendor_review_date date [note: 'Scheduled date for the next vendor performance or compliance review.']
  notes varchar [note: 'Free-text notes or comments regarding the vendor relationship, service issues, or special considerations.']
  notice_period_days varchar [note: 'Number of days advance notice required to terminate or modify the vendor contract.']
  primary_use_case varchar [note: 'Primary business use case or purpose for which the vendor data is consumed.']
  regulatory_compliance_scope varchar [note: 'Regulatory frameworks or compliance requirements the vendor data supports.']
  updated_timestamp timestamp [note: 'Timestamp when the vendor record was last modified or updated.']
  uptime_sla_pct decimal(5,2) [note: 'Contractual uptime or availability service level agreement expressed as a percentage.']
  usage_based_pricing_flag boolean [note: 'Indicates whether the vendor charges based on usage metrics rather than flat subscription fees.']
  user_license_count varchar [note: 'Number of user licenses or seats included in the vendor subscription agreement.']
  vendor_code varchar [note: 'Internal short code or abbreviation used to identify the vendor in operational systems.']
  vendor_contact_email varchar [note: 'Email address of the primary vendor contact for support and communications.']
  vendor_contact_name varchar [note: 'Primary contact person at the vendor organization for support and escalations.']
  vendor_contact_phone varchar [note: 'Phone number of the primary vendor contact for support and escalations.']
  vendor_criticality varchar [note: 'Business criticality rating of the vendor based on operational dependency and impact.']
  vendor_name varchar [note: 'Full legal name of the data vendor organization as registered.']
  vendor_performance_score decimal(5,2) [note: 'Quantitative performance score assigned to the vendor based on service quality metrics.']
  vendor_status varchar [note: 'Current lifecycle status of the vendor relationship.']
  vendor_support_tier varchar [note: 'Level of support service contracted with the vendor.']
  vendor_type varchar [note: 'Primary classification of the data vendor based on the type of data or service provided.']

  Note: 'Reference master of external market data and research data vendors contracted by the fund, including Bloomberg, FactSet, Preqin, PitchBook, MSCI, and Refinitiv.'
}

Table compliance.regulatory_filing {
  regulatory_filing_id varchar [pk, note: 'System-generated unique identifier for the regulatory filing record.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Regulatory filings are made to fulfill specific compliance obligations. Each filing satisfies one obligation requirement.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link regulatory_filing to regulatory_authority to capture the authority receiving the filing. Redundant authority attributes removed.']
  stress_test_result_id varchar [note: 'Foreign key linking to risk.stress_test_result. Business justification: Pension fund regulatory filings (IORP II, local pension regulations) require stress test results as supporting evidence.']
  acceptance_date timestamp [note: 'Timestamp when the regulator accepted the filing (null if not accepted).']
  attached_document_url varchar [note: 'Link to the electronic copy of the filing stored in the lakehouse.']
  comments varchar [note: 'Additional notes or remarks entered by the filing preparer.']
  compliance_flag boolean [note: 'Indicates whether the filing meets all regulatory compliance checks (true) or has outstanding issues (false).']
  created_timestamp timestamp [note: 'Timestamp when the filing record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the filing fee.']
  filing_deadline date [note: 'Date by which the filing must be submitted to the regulator.']
  filing_fee_amount decimal(18,2) [note: 'Monetary fee charged by the regulator for processing the filing.']
  filing_format varchar [note: 'File format of the submitted filing.']
  filing_name varchar [note: 'Descriptive name of the filing used for display and reporting.']
  filing_number varchar [note: 'External reference number assigned by the regulator or internal system for this filing.']
  filing_status varchar [note: 'Current lifecycle status of the filing.']
  filing_type varchar [note: 'Category of filing based on reporting frequency or purpose.']
  rejection_date timestamp [note: 'Timestamp when the regulator rejected the filing (null if not rejected).']
  rejection_reason varchar [note: 'Free‑text explanation provided by the regulator for a rejected filing.']
  reporting_period_end date [note: 'Last day of the period covered by the filing.']
  reporting_period_start date [note: 'First day of the financial or regulatory period covered by the filing.']
  submission_date timestamp [note: 'Exact date and time the filing was submitted.']
  submission_method varchar [note: 'Channel used to submit the filing to the regulator.']
  updated_by varchar [note: 'Identifier of the user or system that last updated the filing record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the filing record.']
  version_number varchar [note: 'Incremental version of the filing when resubmitted or amended.']
  created_by varchar [note: 'Identifier of the user or system that created the filing record.']

  Note: 'Master record for each formal regulatory filing submitted to governing bodies (SEC, FCA, ESMA, IOSCO). Captures filing type, regulatory authority, reporting period, submission date, filing status (draft, submitted, acknowledged, accepted, rejected)'
}

Table compliance.filing_submission {
  filing_submission_id varchar [pk, note: 'System-generated unique identifier for the filing submission record.']
  regulatory_filing_id varchar [note: 'Foreign key linking to compliance.regulatory_filing. Business justification: filing_submission is a transactional record of each submission event for a regulatory filing.']
  acknowledgement_reference varchar [note: 'Reference number or receipt provided by the regulator confirming receipt.']
  comments varchar [note: 'Free‑form notes or remarks added by the submitter or reviewer.']
  error_code varchar [note: 'Code returned by the regulator or internal system when submission fails.']
  error_description varchar [note: 'Human‑readable description of the error associated with the submission.']
  file_checksum varchar [note: 'SHA-256 checksum of the submitted file for integrity verification.']
  file_name varchar [note: 'Name of the electronic file submitted to the regulator.']
  file_size_bytes varchar [note: 'Size of the submitted file in bytes.']
  filing_period_end date [note: 'End date of the reporting period covered by the filing.']
  filing_period_start date [note: 'Start date of the reporting period covered by the filing.']
  filing_submission_status varchar [note: 'Current processing state of the filing submission.']
  filing_type varchar [note: 'Category of regulatory filing (e.g., annual report, quarterly report).']
  record_audit_created timestamp [note: 'Timestamp when the filing submission record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the filing submission record.']
  regulator varchar [note: 'Regulatory authority to which the filing is submitted.']
  submission_method varchar [note: 'Channel used to submit the filing (e.g., portal, XBRL, API, manual upload).']
  submission_number varchar [note: 'External sequential number assigned to each filing submission for tracking.']
  submission_timestamp timestamp [note: 'Date and time when the filing was actually submitted to the regulator.']
  submitted_by varchar [note: 'Identifier of the employee or system that performed the submission.']

  Note: 'Transactional record of each individual submission event for a regulatory filing, capturing submission timestamp, submission method (portal, XBRL, API, manual), submitted by (officer/system), submission status, acknowledgement receipt reference, regulator'
}

Table compliance.regulatory_calendar {
  regulatory_calendar_id varchar [pk, note: 'Unique identifier for the regulatory calendar record.']
  obligation_id varchar [note: 'Foreign key linking to compliance.obligation. Business justification: Link regulatory_calendar to obligation to represent each calendar entry belonging to a specific obligation. Redundant obligation attributes removed.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link regulatory_calendar to regulatory_authority to capture the authority responsible for the obligation. Redundant authority attributes removed.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Link regulatory_calendar to rule to capture the compliance rule governing the obligation. No redundant columns to remove.']
  compliance_status varchar [note: 'Current compliance outcome for the obligation.']
  created_timestamp timestamp [note: 'Timestamp when the calendar record was created.']
  data_classification varchar [note: 'Internal classification of the record (e.g., public, internal, confidential).']
  effective_end_date date [note: 'Date when the regulatory obligation ends or is superseded (nullable).']
  effective_start_date date [note: 'Date when the regulatory obligation becomes effective.']
  escalation_contact varchar [note: 'Email address for escalation if the filing is missed or delayed.']
  filing_deadline date [note: 'Official deadline by which the filing must be submitted.']
  filing_frequency varchar [note: 'How often the filing must be submitted.']
  filing_method varchar [note: 'Channel used to submit the filing.']
  filing_reference_number varchar [note: 'External reference number assigned by the regulator upon filing.']
  filing_status varchar [note: 'Current status of the filing for the upcoming period.']
  is_external boolean [note: 'True if the requirement originates from an external regulator; false if internal policy.']
  is_mandatory boolean [note: 'Indicates whether the filing is mandatory (true) or optional (false).']
  last_filed_date date [note: 'Date when the obligation was most recently filed.']
  last_reviewed_date date [note: 'Date when the obligation details were last reviewed for accuracy.']
  next_due_date date [note: 'Upcoming deadline for the next filing of this obligation.']
  next_review_date date [note: 'Planned date for the next review of the obligation.']
  notes varchar [note: 'Free‑form comments or observations about the obligation.']
  penalty_risk_level varchar [note: 'Risk rating of potential penalties for non‑compliance.']
  regulatory_calendar_status varchar [note: 'Current lifecycle status of the regulatory obligation.']
  required_documentation varchar [note: 'List or description of documents required for the filing.']
  responsible_party varchar [note: 'Internal team or function accountable for meeting the obligation.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']

  Note: 'Authoritative register of every compliance obligation the pension fund must fulfil and its scheduled due dates across all jurisdictions and regulations. Captures obligation name, obligation type (regulatory reporting, disclosure, certification, record'
}

Table compliance.rule {
  rule_id varchar [pk, note: 'Unique identifier for the compliance monitoring rule.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Compliance rules are mandated by specific regulatory authorities. Linking rule to regulatory_authority enables tracking which authority requires each rule.']
  action varchar [note: 'Action taken when the rule condition is met.']
  approval_by varchar [note: 'User ID of the approver.']
  approval_date date [note: 'Date the rule was approved.']
  approval_status varchar [note: 'Approval state of the rule definition.']
  created_at timestamp [note: 'Timestamp when the rule was first created.']
  criteria varchar [note: 'JSON or expression defining the rule logic and thresholds.']
  document_reference varchar [note: 'Link or identifier to the rule documentation.']
  effective_from date [note: 'Date the rule becomes active.']
  effective_until date [note: 'Date the rule ceases to be active; null for open‑ended rules.']
  frequency varchar [note: 'How often the rule is evaluated.']
  is_active boolean [note: 'Indicates if the rule is currently active.']
  is_archived boolean [note: 'True if the rule has been archived and is no longer active.']
  is_automated boolean [note: 'True if the rule is executed automatically by the system.']
  is_compliance boolean [note: 'True if the rule enforces compliance obligations.']
  is_confidential boolean [note: 'True if the rule contains confidential business logic.']
  is_custom boolean [note: 'True if the rule was created by a user or business unit.']
  is_default boolean [note: 'True if the rule is a system default rule.']
  is_external boolean [note: 'True if the rule originates from an external vendor or regulator.']
  is_internal boolean [note: 'True if the rule is defined internally by the firm.']
  is_legal boolean [note: 'True if the rule is derived from legal requirements.']
  is_pii boolean [note: 'True if the rule processes personally identifiable information.']
  is_policy boolean [note: 'True if the rule is based on internal policy.']
  is_procedure boolean [note: 'True if the rule defines a procedural step.']
  is_process boolean [note: 'True if the rule is part of a larger process.']
  is_public boolean [note: 'True if the rule is publicly disclosed.']
  is_regulatory boolean [note: 'True if the rule is mandated by a regulator.']
  is_restricted boolean [note: 'True if the rule is restricted to certain users.']
  is_sensitive boolean [note: 'True if the rule handles sensitive data or processes.']
  is_template boolean [note: 'True if the rule is a reusable template.']
  is_test boolean [note: 'True if the rule is a test or sandbox rule.']
  is_workflow boolean [note: 'True if the rule is part of a workflow.']
  last_run_at timestamp [note: 'Timestamp of the last execution of the rule.']
  next_run_at timestamp [note: 'Scheduled timestamp for the next rule execution.']
  owner varchar [note: 'Business unit or department responsible for the rule.']
  priority varchar [note: 'Priority level for rule execution and escalation.']
  rule_description varchar [note: 'Detailed description of the rule logic and purpose.']
  rule_name varchar [note: 'Human‑readable name of the rule used in reporting and dashboards.']
  rule_status varchar [note: 'Current lifecycle state of the rule.']
  rule_type varchar [note: 'Category of the rule such as KYC, AML, ESG, Trade Reporting, Regulatory Filing, Risk Management, Governance, or Asset Allocation. [ENUM-REF-CANDIDATE: KYC|AML|ESG|Trade Reporting|Regulatory Filing|Risk Management|Governance|Asset Allocation] ']
  scope varchar [note: 'Business area the rule applies to such as portfolio, trade, counterparty, or beneficiary. [ENUM-REF-CANDIDATE: portfolio|trade|counterparty|beneficiary|investment|risk|liquidity|treasury|regulatory] ']
  severity varchar [note: 'Severity of the rule violation.']
  updated_at timestamp [note: 'Timestamp of the most recent rule update.']
  version varchar [note: 'Version identifier for the rule definition.']
  created_by varchar [note: 'User ID of the person who created the rule.']

  Note: 'Master record defining each compliance monitoring rule configured in the rules engine (sourced from BlackRock Aladdin and Charles River IMS compliance modules).'
}

Table compliance.rule_breach {
  rule_breach_id varchar [pk, note: 'Unique identifier for the compliance rule breach record.']
  actor_id varchar [note: 'Identifier of the senior stakeholder to whom the breach was escalated.']
  blotter_id varchar [note: 'Foreign key linking to trade.blotter. Business justification: Compliance breach investigation requires tracing to the specific trade that violated rules. Pension funds must document which trades triggered UCITS/regulatory breaches for regulatory exams and']
  employee_id varchar [note: 'Identifier of the internal party accountable for investigating the breach.']
  infra_asset_id varchar [note: 'Foreign key linking to infrastructure.infra_asset. Business justification: Each rule breach is tied to an asset for breach tracking.']
  instrument_id varchar [note: 'Identifier of the investment asset or portfolio component affected by the breach.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link rule_breach to regulatory_authority to capture the authority overseeing the breach. Redundant authority attributes removed.']
  resolved_by_employee_id varchar [note: 'Identifier of the individual or team that closed the breach.']
  rule_id varchar [note: 'Identifier of the compliance rule that was violated.']
  settlement_fail_id varchar [note: 'Foreign key linking to trade.settlement_fail. Business justification: CSDR settlement discipline regime requires tracking settlement fails that trigger penalty breaches.']
  amount_adjustment decimal(18,2) [note: 'Adjustments (e.g., recoveries, offsets) applied to the gross impact.']
  amount_gross decimal(18,2) [note: 'Estimated gross monetary impact of the breach before adjustments.']
  amount_net decimal(18,2) [note: 'Net monetary impact after adjustments, representing the final loss or penalty.']
  breach_description varchar [note: 'Detailed narrative of the compliance violation, including context and observed behavior.']
  breach_number varchar [note: 'Human‑readable reference number assigned to the breach for tracking and reporting.']
  breach_timestamp timestamp [note: 'Exact date‑time when the rule breach was detected by the monitoring engine.']
  compliance_area varchar [note: 'Functional compliance domain to which the breach belongs.']
  created_timestamp timestamp [note: 'Timestamp when the breach record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the monetary impact fields.']
  data_classification varchar [note: 'Classification level indicating sensitivity of the breach record.']
  detection_method varchar [note: 'Methodology used to identify the breach.']
  detection_source varchar [note: 'System or platform that generated the breach detection.']
  evidence_document_code varchar [note: 'Reference to supporting documentation or file stored in the evidence repository.']
  is_critical boolean [note: 'Indicates whether the breach is deemed critical to the fund\'s operations or reputation.']
  is_repeat boolean [note: 'True if the same rule has been breached previously for the same asset or party.']
  is_reported boolean [note: 'True if the breach has been reported to the relevant regulator.']
  notes varchar [note: 'Free‑form comments or observations added by investigators.']
  penalty_amount decimal(18,2) [note: 'Monetary penalty imposed by the regulator, if any.']
  penalty_currency varchar [note: 'ISO currency code for the penalty amount.']
  remediation_action varchar [note: 'Planned or executed corrective action to address the breach.']
  remediation_due_date date [note: 'Target date by which remediation must be completed.']
  repeat_count varchar [note: 'Number of times this specific rule has been breached within the reporting period.']
  reporting_date date [note: 'Date on which the breach was filed with the regulator.']
  resolution_timestamp timestamp [note: 'Date‑time when the breach was formally resolved.']
  risk_score decimal(5,2) [note: 'Numeric risk score (0‑100) quantifying the breach\'s potential impact.']
  rule_breach_status varchar [note: 'Current lifecycle status of the breach.']
  severity_level varchar [note: 'Risk severity assigned to the breach based on impact and likelihood.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the breach record.']

  Note: 'Operational record of each compliance rule breach detected by the rules engine (Aladdin, Charles River IMS), tracked through its full breach-to-resolution lifecycle.'
}

Table compliance.breach_remediation {
  breach_remediation_id varchar [pk, note: 'Unique identifier for the breach remediation record.']
  employee_id varchar [note: 'Identifier of the compliance officer responsible for executing the remediation.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: breach_remediation has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  regulatory_calendar_id varchar [note: 'Link to the regulatory calendar entry governing filing deadlines for this breach.']
  rule_breach_id varchar [note: 'Identifier of the compliance rule breach that this remediation addresses.']
  actual_completion_date date [note: 'Date when remediation was actually finished.']
  assigned_officer_name varchar [note: 'Full name of the officer assigned to the remediation.']
  breach_detection_timestamp timestamp [note: 'Exact time the compliance breach was identified by the monitoring system.']
  breach_severity varchar [note: 'Severity classification of the compliance breach.']
  compliance_rule_code varchar [note: 'Code identifying the specific compliance rule that was breached.']
  compliance_rule_description varchar [note: 'Human‑readable description of the breached compliance rule.']
  created_timestamp timestamp [note: 'Timestamp when the remediation record was created in the system.']
  currency_code varchar [note: 'ISO 4217 currency code for the remediation cost.']
  escalation_contact_email varchar [note: 'Email address for escalation contact.']
  escalation_contact_name varchar [note: 'Name of the person to contact for escalation of the remediation.']
  escalation_contact_phone varchar [note: 'Phone number for escalation contact.']
  is_waiver_requested boolean [note: 'Indicates whether a regulatory waiver was requested for this breach.']
  jurisdiction varchar [note: 'ISO 3166‑1 alpha‑3 country code of the jurisdiction affected.']
  last_updated_by varchar [note: 'Name of the user or system that performed the latest update.']
  notes varchar [note: 'Additional free‑form notes captured by the officer during remediation.']
  penalty_risk_estimate decimal(5,2) [note: 'Estimated financial penalty risk (as a percentage) if remediation is not completed.']
  related_document_reference varchar [note: 'Path or identifier for supporting documents attached to the remediation.']
  remediation_action_details varchar [note: 'Free‑text description of the specific steps performed during remediation.']
  remediation_action_type varchar [note: 'Category of action taken to resolve the breach.']
  remediation_cost_amount decimal(18,2) [note: 'Monetary cost incurred to execute the remediation actions.']
  remediation_effectiveness_score decimal(5,2) [note: 'Post‑remediation score (0‑100) indicating how effectively the issue was resolved.']
  remediation_plan_description varchar [note: 'Narrative of the planned remediation approach and objectives.']
  remediation_reference_code varchar [note: 'Business identifier code for the remediation workflow, used for external tracking.']
  remediation_start_timestamp timestamp [note: 'Timestamp of the first remediation activity after breach detection.']
  remediation_status varchar [note: 'Current lifecycle status of the remediation effort.']
  risk_level varchar [note: 'Overall risk rating associated with the breach and its remediation.']
  target_remediation_date date [note: 'Planned date by which remediation actions should be completed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the remediation record.']
  waiver_approval_status varchar [note: 'Current approval status of the waiver request.']
  waiver_approval_timestamp timestamp [note: 'Timestamp when the waiver request was approved or rejected.']
  created_by varchar [note: 'Name of the user or system that initially created the remediation record.']

  Note: 'Transactional record tracking the remediation workflow for each compliance rule breach. Captures remediation plan description, assigned officer, target remediation date, remediation actions taken (trade reversal, position reduction, waiver request, policy'
}

Table compliance.kyc_record {
  kyc_record_id varchar [pk, note: 'System-generated unique identifier for the KYC record.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: KYC verification is mandatory before engaging counterparties in collateral transactions.']
  policy_document_id varchar [note: 'Unique identifier or number on the KYC document.']
  address_line1 varchar [note: 'Primary street address of the party.']
  address_line2 varchar [note: 'Secondary address information (suite, unit, etc.).']
  aml_check_status varchar [note: 'Outcome of anti‑money‑laundering checks.']
  beneficial_owner_name varchar [note: 'Name of the ultimate beneficial owner, if applicable.']
  beneficial_owner_percentage decimal(5,2) [note: 'Ownership share held by the beneficial owner, expressed as a percentage.']
  city varchar [note: 'City component of the party\'s address.']
  country_code varchar [note: 'Three‑letter ISO country code for the party\'s location.']
  created_timestamp timestamp [note: 'Timestamp when the KYC record was first created in the system.']
  data_classification varchar [note: 'Internal classification indicating sensitivity of the KYC data.']
  document_expiry_date date [note: 'Expiration date of the KYC document.']
  document_issue_date date [note: 'Date the KYC document was issued.']
  document_status varchar [note: 'Current validity status of the KYC document.']
  document_type varchar [note: 'Type of identification or supporting document provided.']
  email_address varchar [note: 'Primary email address used for KYC communications.']
  jurisdiction varchar [note: 'Country or jurisdiction where the party is legally established.']
  kyc_expiry_date date [note: 'Date when the KYC record expires and must be refreshed.']
  kyc_review_date date [note: 'Date when the KYC record was last reviewed.']
  kyc_status varchar [note: 'Current lifecycle status of the KYC record.']
  last_updated_by varchar [note: 'User identifier of the analyst who performed the latest update.']
  legal_entity_identifier varchar [note: 'Global identifier for the legal entity as defined by the LEI system.']
  notes varchar [note: 'Free‑form notes captured by compliance analysts.']
  party_name varchar [note: 'Full legal name of the individual or organization subject to KYC.']
  party_type varchar [note: 'Category of the party for KYC purposes.']
  pep_status varchar [note: 'Indicates whether the party is a PEP or related.']
  phone_number varchar [note: 'Primary telephone number for the party.']
  postal_code varchar [note: 'Postal or ZIP code for the party\'s address.']
  registration_number varchar [note: 'Official registration number assigned by the corporate registry.']
  risk_rating varchar [note: 'Qualitative risk rating derived from the risk score.']
  risk_score varchar [note: 'Numerical risk score (0‑100) assigned after KYC assessment.']
  sanctions_screening_status varchar [note: 'Result of sanctions list screening for the party.']
  source_of_funds varchar [note: 'Narrative description of the origin of the party\'s funds.']
  state_province varchar [note: 'State or province component of the party\'s address.']
  tax_identifier varchar [note: 'Government‑issued tax identification number for the party.']
  trade_name varchar [note: 'Operating name or DBA (Doing Business As) used for the party.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the KYC record.']
  website_url varchar [note: 'Public website associated with the party.']

  Note: 'Master KYC (Know Your Customer) and AML (Anti-Money Laundering) compliance record for each counterparty, external manager, co-investor, or institutional relationship managed by the pension fund.'
}

Table compliance.sanctions_screening {
  sanctions_screening_id varchar [pk, note: 'Unique identifier for the sanctions screening event.']
  counterparty_id varchar [note: 'Foreign key linking to collateral.counterparty. Business justification: Sanctions screenings are performed on counterparties before collateral transactions.']
  created_timestamp timestamp [note: 'Timestamp when the screening record was first created.']
  is_false_positive boolean [note: 'Indicates whether a match was later determined to be a false positive.']
  match_detail varchar [note: 'Free‑text description of any matches found.']
  notes varchar [note: 'Free‑form comments or observations about the screening.']
  performed_by varchar [note: 'User or system that executed the screening.']
  record_status varchar [note: 'Current lifecycle status of the screening record.']
  remediation_action varchar [note: 'Planned corrective action for a positive match.']
  remediation_due_date date [note: 'Date by which remediation must be completed.']
  risk_score decimal(5,2) [note: 'Numeric risk rating (0‑100) assigned to the screening result.']
  screened_entity_lei varchar [note: 'Global identifier for the screened legal entity.']
  screened_entity_name varchar [note: 'Legal name of the screened party (individual or organization).']
  screened_entity_type varchar [note: 'Category of the screened party.']
  screening_list varchar [note: 'Regulatory or watch‑list used for the screening.']
  screening_result varchar [note: 'Outcome of the screening process.']
  screening_timestamp timestamp [note: 'Date and time when the screening was performed.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the screening record.']

  Note: 'Transactional record of each sanctions and PEP screening event conducted against a counterparty, issuer, manager, or individual. Captures screening date, screened entity name and LEI, screening list(s) applied (OFAC, UN, EU, HMT), screening result (clear'
}

Table compliance.trade_report {
  trade_report_id varchar [pk, note: 'System-generated unique identifier for each trade report record.']
  broker_id varchar [note: 'Identifier of the broker or intermediary facilitating the trade.']
  execution_id varchar [note: 'Unique identifier for the execution event provided by the venue.']
  fx_forward_id varchar [note: 'Foreign key linking to treasury.fx_forward. Business justification: EMIR/MiFID regulatory reporting requires pension funds to report OTC FX forward trades to trade repositories.']
  fx_swap_id varchar [note: 'Foreign key linking to treasury.fx_swap. Business justification: FX swaps are reportable OTC derivatives under EMIR/MiFID. Pension fund compliance teams must link trade reports to specific fx_swap transactions for regulatory submission and reconciliation']
  fx_trade_id varchar [note: 'Foreign key linking to trade.fx_trade. Business justification: EMIR/MiFID II mandate FX derivative reporting. Pension funds executing FX hedges must link trades directly to regulatory reports for transaction reporting compliance.']
  order_id varchar [note: 'Identifier of the order that generated the trade.']
  otc_derivative_id varchar [note: 'Foreign key linking to trade.otc_derivative. Business justification: EMIR requires OTC derivative trade reporting to trade repositories. Pension funds must link each OTC trade to its regulatory report for compliance audit trail.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: trade_report is submitted under specific regulatory regimes (EMIR, MiFID II). Should link to the governing regulatory authority.']
  sfdr_disclosure_id varchar [note: 'Foreign key linking to compliance.sfdr_disclosure. Business justification: Trade report belongs to a specific SFDR disclosure period; adding a child-to-parent FK aligns with standard 1:N modeling.']
  asset_class varchar [note: 'Broad classification of the instrument (e.g., Equity, Fixed Income, Real Estate).']
  commission decimal(20,2) [note: 'Commission charged by the broker for executing the trade.']
  compliance_status varchar [note: 'Result of compliance validation for the trade report.']
  counterparty_lei varchar [note: 'Global identifier for the counterparty to the trade, as defined by the LEI system.']
  created_timestamp timestamp [note: 'Timestamp when the trade report record was first created in the lakehouse.']
  data_classification varchar [note: 'Internal classification of the report data (e.g., public, internal, confidential, restricted).']
  emir_reportable boolean [note: 'Indicates whether the trade falls under EMIR reporting obligations.']
  execution_venue varchar [note: 'Market or platform where the trade was executed.']
  fee_amount decimal(20,2) [note: 'Total fees and commissions charged on the trade.']
  gross_amount decimal(20,2) [note: 'Total monetary value of the trade before fees and adjustments.']
  instrument_isin varchar [note: 'Standardized security identifier for the traded instrument.']
  lifecycle_status varchar [note: 'Current processing state of the trade report within the compliance workflow.']
  mifid_reportable boolean [note: 'Indicates whether the trade falls under MiFID II reporting obligations.']
  net_amount decimal(20,2) [note: 'Net monetary value after subtracting fees from the gross amount.']
  notes varchar [note: 'Free‑form comments or observations related to the trade report.']
  penalty_risk_level varchar [note: 'Risk level for potential regulatory penalties if the report is non‑compliant.']
  price decimal(20,6) [note: 'Price per unit at which the trade was executed.']
  quantity decimal(20,6) [note: 'Number of units or shares traded.']
  regulatory_status varchar [note: 'Current status of the report with the regulator.']
  report_reference varchar [note: 'External reference number assigned by the reporting regime or internal system.']
  reporting_regime varchar [note: 'Regulatory framework under which the trade is reported (EMIR or MiFID II).']
  reporting_timestamp timestamp [note: 'Date and time when the trade report was submitted to the repository.']
  settlement_amount decimal(20,2) [note: 'Monetary amount settled, typically matching net_amount in cash trades.']
  settlement_date date [note: 'Date on which cash and securities are exchanged.']
  trade_currency varchar [note: 'ISO 4217 currency code of the trade price.']
  trade_repository varchar [note: 'Name of the trade repository where the report is submitted (e.g., DTCC, REGIS-TR).']
  trade_timestamp timestamp [note: 'Exact date and time when the trade was executed in the market.']
  trade_type varchar [note: 'Classification of the transaction (e.g., Buy, Sell, Swap).']
  unique_trade_identifier varchar [note: 'Globally unique identifier for the trade as required by EMIR/MiFID II.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the trade report record.']

  Note: 'Transactional record of each trade report submitted to a trade repository under EMIR or MiFID II transaction reporting obligations. Captures trade report reference, reporting regime (EMIR, MiFID II), trade repository (DTCC, REGIS-TR), UTI (Unique Trade'
}

Table compliance.lei_record {
  lei_record_id varchar [pk, note: 'Unique identifier for the lei_record record.']
  created_timestamp timestamp [note: 'Timestamp when the lei_record was first created in the system.']
  entity_address varchar [note: 'Physical address of the entity.']
  entity_city varchar [note: 'City where the entity is located.']
  entity_classification varchar [note: 'Classification of the entity\'s role in the organization.']
  entity_country varchar [note: 'ISO 3166-1 alpha-3 country code of the entity. [ENUM-REF-CANDIDATE: USA|CAN|GBR|FRA|DEU|CHN|JPN|AUS|IND|BRA — 10 candidates stripped; promote to reference product]']
  entity_description varchar [note: 'Brief description of the entity\'s purpose or nature.']
  entity_email varchar [note: 'Primary email address for the entity.']
  entity_fax varchar [note: 'Primary fax number for the entity.']
  entity_name varchar [note: 'Human-readable name of the legal entity.']
  entity_phone varchar [note: 'Primary phone number for the entity.']
  entity_postal_code varchar [note: 'Postal code of the entity\'s address.']
  entity_state varchar [note: 'State or province of the entity\'s location.']
  entity_status varchar [note: 'Current lifecycle status of the entity.']
  entity_subtype varchar [note: 'Specific subtype of the entity within its primary type.']
  entity_type varchar [note: 'Primary category of the entity (e.g., Fund, SPV, Counterparty).']
  entity_website varchar [note: 'Official website URL of the entity.']
  lei varchar [note: '20-character alphanumeric code that uniquely identifies a legal entity.']
  lei_expiry_date date [note: 'Date the LEI expires or is set to expire.']
  lei_issue_date date [note: 'Date the LEI was issued.']
  lei_last_updated timestamp [note: 'Timestamp of the last update to the LEI record.']
  lei_source_system varchar [note: 'Name of the system that provided the LEI data.']
  lei_source_system_active_flag boolean [note: 'Flag indicating if the source system record is active.']
  lei_source_system_code varchar [note: 'Identifier of the source system record for the LEI.']
  lei_source_system_created timestamp [note: 'Timestamp when the source system record was created.']
  lei_source_system_deleted timestamp [note: 'Timestamp when the source system record was deleted, if applicable.']
  lei_source_system_description varchar [note: 'Detailed description of the source system.']
  lei_source_system_name varchar [note: 'Human-readable name of the source system.']
  lei_source_system_notes varchar [note: 'Additional notes about the source system entry.']
  lei_source_system_reference varchar [note: 'Reference or identifier used within the source system for the LEI.']
  lei_source_system_remarks varchar [note: 'Free-text remarks about the source system record.']
  lei_source_system_timestamp timestamp [note: 'Timestamp when the source system recorded the LEI data.']
  lei_source_system_type varchar [note: 'Type of source system (e.g., ERP, CRM, Data Lake). [ENUM-REF-CANDIDATE: SimCorp|BlackRock|Bloomberg|StateStreet|eFront|DealCloud|MSCI|CharlesRiver|Oracle|SAP|Diligent|Preqin|PitchBook|FactSet — promote to reference product]']
  lei_source_system_updated timestamp [note: 'Timestamp when the source system record was last updated.']
  lei_source_system_version varchar [note: 'Version of the source system that provided the LEI.']
  lei_status varchar [note: 'Current status of the LEI registration.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the lei_record.']

  Note: 'Master record for each Legal Entity Identifier (LEI) managed or tracked by the pension fund, covering the fund itself, its subsidiaries, SPVs, and key counterparties.'
}

Table compliance.ic_governance_record {
  ic_governance_record_id varchar [pk, note: 'System-generated unique identifier for the Investment Committee governance record.']
  policy_document_id varchar [note: 'Reference to the stored minutes document for the meeting.']
  action_items varchar [note: 'List of follow‑up actions resulting from meeting decisions.']
  agenda_items varchar [note: 'Structured list of agenda items discussed during the meeting.']
  attendees_count varchar [note: 'Number of participants present at the meeting.']
  attendees_roles varchar [note: 'Roles represented among attendees (enumerated).']
  compliance_review_date date [note: 'Date when the compliance review was completed.']
  compliance_review_status varchar [note: 'Status of the compliance review for the meeting record.']
  created_timestamp timestamp [note: 'Timestamp when the governance record was first created.']
  decisions_made varchar [note: 'Summary of formal decisions approved by the Investment Committee.']
  end_time timestamp [note: 'Exact timestamp when the meeting concluded.']
  is_confidential boolean [note: 'Indicates whether the meeting record contains confidential information.']
  location varchar [note: 'Physical location or venue of the meeting (if applicable).']
  meeting_date date [note: 'Calendar date on which the meeting took place.']
  meeting_number varchar [note: 'Business identifier assigned to the meeting (e.g., sequential number or code).']
  meeting_status varchar [note: 'Current lifecycle status of the meeting.']
  meeting_title varchar [note: 'Descriptive title of the Investment Committee meeting.']
  meeting_type varchar [note: 'Category of the meeting: regular IC, special IC, sub‑committee, or ad‑hoc session.']
  notes varchar [note: 'Free‑form notes or comments captured by the recorder.']
  quorum_status varchar [note: 'Indicates whether the required quorum was achieved.']
  regulatory_filing_reference varchar [note: 'Reference number linking the meeting to a specific regulatory filing obligation.']
  risk_assessment_score decimal(5,2) [note: 'Numeric risk score assigned to the meeting outcomes (e.g., based on ESG or governance risk models).']
  start_time timestamp [note: 'Exact timestamp when the meeting started.']
  updated_by varchar [note: 'User identifier of the person who last modified the record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the governance record.']
  virtual_meeting_link varchar [note: 'URL or access link for virtual attendance.']
  created_by varchar [note: 'User identifier of the person who created the record.']

  Note: 'Master record for each Investment Committee (IC) governance session managed via Diligent/BoardEffect. Captures IC meeting date, meeting type (regular IC, special IC, sub-committee), quorum status, agenda items, attendees and roles, decisions made'
}

Table compliance.ic_decision {
  ic_decision_id varchar [pk, note: 'Unique system-generated identifier for each Investment Committee decision.']
  fund_id varchar [note: 'Identifier of the fund or investment vehicle associated with the decision.']
  ic_governance_record_id varchar [note: 'Foreign key linking to compliance.ic_governance_record. Business justification: ic_decision is a decision made during an IC governance session. Each decision belongs to one governance session.']
  infra_asset_id varchar [note: 'Identifier of the specific asset or security affected by the decision.']
  attached_document_reference varchar [note: 'Link or identifier to supporting documents (e.g., PDFs, presentations).']
  committee_code varchar [note: 'Identifier of the Investment Committee session during which the decision was made.']
  compliance_status varchar [note: 'Result of compliance checks related to the decision.']
  created_timestamp timestamp [note: 'Timestamp when the decision record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the approved investment amount.']
  decision_maker varchar [note: 'Name of the individual who recorded or signed off the decision (e.g., Chairperson).']
  decision_maker_role varchar [note: 'Role of the person who authored or signed the decision.']
  decision_number varchar [note: 'Human‑readable identifier assigned to the decision (e.g., D‑2024‑0012).']
  decision_status varchar [note: 'Current workflow status of the decision record.']
  decision_timestamp timestamp [note: 'Exact date‑time when the Investment Committee formally recorded the decision.']
  decision_type varchar [note: 'Category of the decision made by the Investment Committee.']
  effective_date date [note: 'Date on which the decision becomes operationally effective.']
  expiration_date date [note: 'Date when the decision ceases to be effective, if applicable.']
  filing_deadline date [note: 'Latest date by which required regulatory filings must be submitted.']
  investment_amount_approved decimal(20,2) [note: 'Monetary amount approved by the Committee for the investment or commitment.']
  investment_vehicle_type varchar [note: 'Asset class or vehicle to which the decision applies.']
  mandate_change_flag boolean [note: 'True if the decision results in a change to the investment mandate.']
  notes varchar [note: 'Additional comments, rationale, or observations recorded by the Committee.']
  policy_exception_flag boolean [note: 'True if the decision grants an exception to existing investment policy.']
  regulatory_filing_required boolean [note: 'Indicates whether the decision triggers a regulatory filing obligation.']
  risk_rating_after varchar [note: 'Risk rating after the decision is applied.']
  risk_rating_before varchar [note: 'Risk rating of the investment or portfolio before the decision.']
  subject varchar [note: 'Brief description of what the decision addresses (e.g., new fund approval, mandate amendment).']
  updated_by varchar [note: 'User identifier of the person who last modified the decision record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the decision record.']
  votes_abstain varchar [note: 'Number of Committee members who abstained from voting.']
  votes_against varchar [note: 'Number of Committee members who voted against.']
  votes_for varchar [note: 'Number of Committee members who voted in favor.']
  voting_outcome varchar [note: 'Result of the Committee vote on the decision.']
  created_by varchar [note: 'User identifier of the person who initially entered the decision record.']

  Note: 'Transactional record of each formal Investment Committee decision made during an IC governance session. Captures decision date, IC session reference, decision subject (investment approval, mandate change, SAA revision, policy exception), decision type'
}

Table compliance.conflict_of_interest {
  conflict_of_interest_id varchar [pk, note: 'System-generated unique identifier for each conflict of interest record.']
  declarant_employee_id varchar [note: 'Internal employee identifier assigned to the declarant.']
  opportunity_id varchar [note: 'Foreign key linking to deal.opportunity. Business justification: Conflicts of interest must be linked to specific deal opportunities for compliance screening. The conflict_related_deal attribute suggests this relationship exists denormalized.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: conflict_of_interest has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  conflict_audit_trail varchar [note: 'JSON‑encoded log of changes made to the conflict record.']
  conflict_category varchar [note: 'High‑level domain to which the conflict belongs.']
  conflict_confidentiality_level varchar [note: 'Level of confidentiality required for the conflict record.']
  conflict_description varchar [note: 'Narrative explanation of the conflict circumstances.']
  conflict_end_date date [note: 'Date when the conflict ceased or was resolved (nullable).']
  conflict_esg_impact varchar [note: 'Assessment of how the conflict affects ESG considerations.']
  conflict_identifier varchar [note: 'External reference code used for regulatory filings or audit trails.']
  conflict_last_reviewed_timestamp timestamp [note: 'Timestamp of the most recent review activity.']
  conflict_of_interest_status varchar [note: 'Current processing state of the conflict record.']
  conflict_publication_date date [note: 'Date the conflict information was made public or disclosed to stakeholders.']
  conflict_related_asset varchar [note: 'Identifier of the asset (e.g., security, property) involved in the conflict.']
  conflict_related_fund varchar [note: 'Identifier of the fund potentially impacted by the conflict.']
  conflict_resolution_action varchar [note: 'Action taken to resolve or mitigate the conflict.']
  conflict_resolution_by varchar [note: 'Name of the individual who executed the resolution action.']
  conflict_resolution_comments varchar [note: 'Additional notes about how the conflict was resolved.']
  conflict_review_comments varchar [note: 'Comments recorded during the conflict review.']
  conflict_review_date date [note: 'Date of the most recent formal review of the conflict.']
  conflict_reviewed_by varchar [note: 'Name of the compliance officer or committee member who reviewed the conflict.']
  conflict_risk_assessment_date date [note: 'Date the risk score was calculated.']
  conflict_risk_score decimal(5,2) [note: 'Quantitative risk score (0‑100) assigned after assessment.']
  conflict_start_date date [note: 'Date when the underlying conflict situation began.']
  conflict_status_reason varchar [note: 'Explanation for the current status value.']
  conflict_title varchar [note: 'Brief title summarizing the conflict (e.g., "Family Investment in Real Estate").']
  conflict_type varchar [note: 'Category describing the nature of the conflict.']
  created_timestamp timestamp [note: 'Date‑time when the conflict record was first created in the system.']
  data_classification varchar [note: 'Enterprise data classification level for the record.']
  declarant_name varchar [note: 'Legal full name of the individual declaring the conflict.']
  declarant_role varchar [note: 'Job function or position of the declarant within the pension fund.']
  disclosure_date date [note: 'Date the conflict was formally disclosed to the compliance function.']
  effective_from date [note: 'Date from which the conflict declaration is considered effective.']
  effective_until date [note: 'Date after which the conflict declaration is no longer in effect (nullable).']
  is_mandatory boolean [note: 'Indicates if the conflict disclosure is mandatory under policy.']
  mitigation_action varchar [note: 'Planned or executed action to mitigate the conflict.']
  notes varchar [note: 'Free‑form comments or observations related to the conflict.']
  related_party_identifier varchar [note: 'Unique identifier (e.g., LEI, CUSIP) for the related party.']
  related_party_name varchar [note: 'Name of the individual or entity with which the conflict exists.']
  related_party_relationship varchar [note: 'Nature of the relationship between declarant and related party.']
  reporting_status varchar [note: 'Whether the conflict has been reported to the relevant regulator or internal board.']
  resolution_date date [note: 'Date the conflict was formally resolved or mitigated.']
  severity_level varchar [note: 'Risk severity assigned to the conflict after assessment.']
  updated_timestamp timestamp [note: 'Date‑time of the most recent modification to the conflict record.']

  Note: 'Master record of declared conflicts of interest by investment professionals, committee members, and officers of the pension fund. Captures declarant name and role, conflict type (personal investment, related party, board membership, prior employment)'
}

Table compliance.policy_document {
  policy_document_id varchar [pk, note: 'Unique system-generated identifier for each policy document.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link policy_document to regulatory_authority to capture the authority overseeing the policy. Redundant policy attributes removed.']
  approval_date date [note: 'Date the policy was formally approved.']
  approved_by varchar [note: 'Name of the person or committee that approved the policy.']
  author_name varchar [note: 'Name of the individual who authored the policy.']
  checksum varchar [note: 'SHA‑256 checksum for integrity verification of the document file.']
  compliance_area varchar [note: 'Specific compliance domain addressed by the policy.']
  confidentiality_level varchar [note: 'Data classification level assigned to the policy document.']
  created_timestamp timestamp [note: 'Timestamp when the policy record was first created in the system.']
  document_format varchar [note: 'File format of the stored policy document.']
  effective_date date [note: 'Date on which the policy becomes effective.']
  expiration_date date [note: 'Date on which the policy expires or is superseded, if applicable.']
  file_path varchar [note: 'Location path of the policy document in the lakehouse storage.']
  file_size_bytes varchar [note: 'Size of the document file in bytes.']
  is_mandatory boolean [note: 'Flag indicating whether compliance with the policy is mandatory.']
  last_reviewed_timestamp timestamp [note: 'Timestamp when the policy was last reviewed.']
  owner_department varchar [note: 'Business department responsible for the policy.']
  policy_document_category varchar [note: 'Higher‑level grouping of policies (e.g., operational, regulatory, strategic).']
  policy_document_description varchar [note: 'Full textual description outlining the purpose and scope of the policy.']
  policy_document_status varchar [note: 'Current lifecycle state of the policy.']
  policy_owner_contact varchar [note: 'Email address of the primary owner responsible for the policy.']
  policy_type varchar [note: 'Category of policy indicating its functional area.']
  retention_period_days varchar [note: 'Number of days the policy document must be retained for compliance purposes.']
  review_date date [note: 'Date of the most recent policy review.']
  reviewed_by varchar [note: 'Name of the individual who performed the latest review.']
  revision_number varchar [note: 'Sequential integer indicating the revision count of the policy.']
  title varchar [note: 'Descriptive title of the policy document.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the policy record.']
  version_number varchar [note: 'Version identifier following the document\'s revision scheme.']

  Note: 'Master record for each internal compliance policy, investment policy statement, or regulatory procedure document maintained by the compliance function. Captures policy name, policy category (investment policy, AML policy, ESG policy, trading policy'
}

Table compliance.policy_exception {
  policy_exception_id varchar [pk, note: 'Unique identifier for the policy exception record.']
  approver_employee_id varchar [note: 'System identifier of the compliance officer or committee member who approved or rejected the exception.']
  employee_id varchar [note: 'System identifier of the employee or party who submitted the exception request.']
  policy_document_id varchar [note: 'Foreign key linking to compliance.policy_document. Business justification: policy_exception is an exception granted to a compliance policy. Each exception relates to one policy document.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link policy_exception to regulatory_authority to capture the authority overseeing the exception. No redundant columns to remove.']
  related_calendar_regulatory_calendar_id varchar [note: 'Identifier linking the exception to a regulatory calendar obligation, if applicable.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Policy exceptions are granted against specific compliance rules. related_policy_rule_code can be removed as it becomes redundant with the FK to rule.']
  approval_status varchar [note: 'Result of the approval workflow for the exception.']
  approval_timestamp timestamp [note: 'Date‑time when the exception was formally approved or rejected.']
  approver_name varchar [note: 'Legal full name of the individual who made the approval decision.']
  created_timestamp timestamp [note: 'Timestamp when the exception record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO 4217 code of the currency for the monetary limit.']
  effective_from date [note: 'Date on which the granted exception becomes effective.']
  effective_until date [note: 'Date on which the exception expires or is no longer valid (null for permanent).']
  exception_number varchar [note: 'Human‑readable identifier assigned to the exception request.']
  exception_type varchar [note: 'Indicates whether the exception is temporary or permanent.']
  expiration_timestamp timestamp [note: 'Date‑time when a temporary exception automatically expires.']
  is_active boolean [note: 'Indicates whether the exception is currently active (true) or not (false).']
  justification varchar [note: 'Narrative explanation describing why the exception is required and how it aligns with business objectives.']
  monetary_limit_amount decimal(20,2) [note: 'Maximum monetary amount or exposure permitted under the granted exception.']
  notes varchar [note: 'Free‑form comments or additional information captured by reviewers.']
  policy_exception_status varchar [note: 'Current lifecycle status of the exception request.']
  request_timestamp timestamp [note: 'Date‑time when the exception was originally submitted.']
  requestor_department varchar [note: 'Organizational department or business unit of the requestor.']
  requestor_name varchar [note: 'Legal full name of the individual requesting the exception.']
  updated_by varchar [note: 'User identifier of the person or process that performed the latest update.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the exception record.']
  created_by varchar [note: 'User identifier of the person or process that created the record.']

  Note: 'Transactional record of each formal exception granted to a compliance policy or investment guideline. Captures exception request date, policy or rule being excepted, exception requestor, business justification, exception type (temporary, permanent'
}

Table compliance.regulatory_change {
  regulatory_change_id varchar [pk, note: 'Unique identifier for the regulatory change record.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link regulatory_change to regulatory_authority to capture the authority responsible for the change. Redundant authority attributes removed.']
  amendment_number varchar [note: 'Sequential number of the amendment if the change is an amendment.']
  change_type varchar [note: 'Nature of the regulatory change: new regulation, amendment, or guidance.']
  compliance_deadline date [note: 'Date by which required compliance actions must be completed.']
  compliance_status varchar [note: 'Current compliance status of the organization with respect to this change.']
  created_timestamp timestamp [note: 'Timestamp when the regulatory change record was created.']
  document_reference varchar [note: 'Identifier of the supporting regulatory document or filing.']
  effective_date date [note: 'Date when the regulation becomes effective.']
  expiry_date date [note: 'Date when the regulation expires or is superseded, if applicable.']
  impact_assessment varchar [note: 'Qualitative assessment of the impact on the pension fund operations.']
  is_external boolean [note: 'True if the regulation originates from an external authority, false if internal policy.']
  is_mandatory boolean [note: 'Indicates whether compliance with this change is mandatory (true) or optional (false).']
  last_reviewed_date date [note: 'Date when the regulatory change was last reviewed for relevance.']
  next_review_date date [note: 'Planned date for the next review of the regulatory change.']
  notes varchar [note: 'Additional free‑form comments or observations.']
  penalty_risk_estimate decimal(12,2) [note: 'Estimated financial penalty risk if non‑compliant, in local currency.']
  regulation_code varchar [note: 'Unique code or identifier assigned by the issuing authority.']
  regulatory_body_contact varchar [note: 'Contact information for the issuing authority (e.g., email or phone).']
  regulatory_change_description varchar [note: 'Full textual description of the regulatory change.']
  regulatory_change_status varchar [note: 'Current lifecycle status of the regulatory change record.']
  related_regulation_code varchar [note: 'Identifier of a related regulatory change, if any.']
  required_action varchar [note: 'Specific actions the organization must take to comply.']
  responsible_party varchar [note: 'Individual or team accountable for implementing compliance.']
  risk_level varchar [note: 'Overall risk rating associated with non‑compliance.']
  severity varchar [note: 'Severity of the regulatory change\'s impact.']
  title varchar [note: 'Official title of the regulation or amendment.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']

  Note: 'Master record tracking regulatory changes, new regulations, and amendments to existing rules that impact the pension fund\'s operations. Captures regulation name, issuing authority (SEC, FCA, ESMA), change type (new regulation, amendment, guidance'
}

Table compliance.regulatory_exam {
  regulatory_exam_id varchar [pk, note: 'Unique system-generated identifier for the regulatory examination record.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link regulatory_exam to regulatory_authority to capture the authority conducting the exam. Redundant authority attributes removed.']
  compliance_status varchar [note: 'Overall compliance determination after the examination.']
  corrective_action_deadline date [note: 'Date by which all required corrective actions must be completed.']
  corrective_action_required boolean [note: 'Indicates whether the regulator mandated corrective actions.']
  created_timestamp timestamp [note: 'Timestamp when the examination record was first created in the system.']
  currency_code varchar [note: 'Three‑letter ISO currency code for any monetary amounts.']
  documentation_url varchar [note: 'Link to the full examination report or supporting documents stored in the DMS.']
  exam_number varchar [note: 'External reference number assigned by the regulator or internal tracking system.']
  exam_outcome varchar [note: 'Result of the examination as determined by the regulator.']
  exam_timestamp timestamp [note: 'Date and time when the examination was conducted or officially recorded.']
  exam_type varchar [note: 'Category of the examination, indicating its purpose or scope.']
  examiner_email varchar [note: 'Email address for the examiner or examination team contact.']
  examiner_name varchar [note: 'Name of the primary individual or team conducting the examination.']
  findings_summary varchar [note: 'High‑level narrative of key findings and observations from the exam.']
  notes varchar [note: 'Additional free‑form comments or observations captured by compliance staff.']
  penalty_amount decimal(18,2) [note: 'Monetary penalty assessed by the regulator, if any.']
  regulatory_exam_status varchar [note: 'Current lifecycle state of the examination.']
  risk_rating varchar [note: 'Internal risk rating assigned based on the exam findings.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the examination record.']

  Note: 'Master record for each regulatory examination, inspection, or supervisory review conducted by a regulatory authority (SEC, FCA, ESMA) against the pension fund.'
}

Table compliance.exam_finding {
  exam_finding_id varchar [pk, note: 'Unique identifier for the exam finding record.']
  actor_id varchar [note: 'Identifier of the regulator or examiner who raised the finding.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: exam_finding has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  regulatory_exam_id varchar [note: 'Identifier of the supervisory examination to which this finding belongs.']
  actual_resolution_date date [note: 'Date on which remediation was actually completed.']
  compliance_rule_code varchar [note: 'Code of the internal compliance rule that was breached.']
  compliance_rule_description varchar [note: 'Human‑readable description of the compliance rule.']
  created_timestamp timestamp [note: 'System timestamp when the finding record was first created.']
  currency_code varchar [note: 'Three‑letter ISO currency code for any monetary amounts.']
  data_classification varchar [note: 'Classification of the record for security handling (e.g., confidential, internal).']
  due_date date [note: 'Target date by which remediation actions should be completed.']
  escalation_contact_email varchar [note: 'Email address of the escalation contact.']
  escalation_contact_name varchar [note: 'Name of the person to contact for escalation of the finding.']
  escalation_contact_phone varchar [note: 'Phone number of the escalation contact.']
  exam_finding_category varchar [note: 'High‑level classification of the finding type.']
  exam_finding_description varchar [note: 'Detailed narrative describing the observation, deficiency, or violation.']
  exam_finding_status varchar [note: 'Current processing state of the finding.']
  examiner_name varchar [note: 'Full legal name of the examiner who raised the finding.']
  finding_reference varchar [note: 'Unique reference code assigned to the finding by the examiner.']
  is_waiver_requested boolean [note: 'Indicates whether a waiver for the finding has been requested.']
  jurisdiction varchar [note: 'Country or jurisdiction relevant to the finding.']
  notes varchar [note: 'Free‑form notes captured by the examiner or remediation team.']
  penalty_amount decimal(18,2) [note: 'Monetary penalty assessed for the finding, if any.']
  recommendation varchar [note: 'Suggested corrective action or improvement recommended by the examiner.']
  regulation_code varchar [note: 'Identifier of the specific regulation or rule implicated.']
  remediation_plan varchar [note: 'Planned steps and responsibilities to remediate the finding.']
  reported_timestamp timestamp [note: 'Date‑time when the examiner recorded the finding.']
  resolved_timestamp timestamp [note: 'Date‑time when the finding was marked as resolved or closed.']
  risk_score varchar [note: 'Numeric risk score (0‑100) derived from severity and other risk factors.']
  severity varchar [note: 'Severity rating indicating the potential impact of the finding.']
  sub_category varchar [note: 'More granular classification within the main category.']
  supporting_document_url varchar [note: 'Link to any external document that supports the finding.']
  updated_timestamp timestamp [note: 'System timestamp of the most recent modification to the finding record.']
  waiver_approval_timestamp timestamp [note: 'Date‑time when a waiver request was approved or denied.']
  waiver_status varchar [note: 'Current status of any waiver request.']

  Note: 'Transactional record of each finding or observation raised by a regulatory examiner during a supervisory examination. Captures finding reference, examination reference, finding category (deficiency, observation, recommendation, violation), finding'
}

Table compliance.beneficiary_disclosure {
  beneficiary_disclosure_id varchar [pk, note: 'System-generated unique identifier for each beneficiary disclosure record.']
  beneficiary_member_id varchar [note: 'Identifier of the individual or entity receiving the disclosure.']
  member_id varchar [note: 'Identifier of the individual or entity receiving the disclosure.']
  participating_employer_id varchar [note: 'Identifier of the sponsoring employer or contributor pool associated with the disclosure.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: beneficiary_disclosure has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  acceptance_date date [note: 'Date the regulator accepted the disclosure as compliant.']
  adjustment_amount decimal(15,2) [note: 'Any fees, taxes, or discounts applied to the gross amount.']
  attached_document_url varchar [note: 'Link to the stored disclosure document in the content repository.']
  beneficiary_disclosure_status varchar [note: 'Current processing state of the disclosure record.']
  comments varchar [note: 'Free‑form notes entered by compliance staff.']
  compliance_flag boolean [note: 'Indicates whether the disclosure meets all applicable compliance requirements.']
  created_timestamp timestamp [note: 'Timestamp when the disclosure record was first created in the system.']
  currency_code varchar [note: 'ISO 4217 three‑letter code of the currency used for monetary amounts.']
  disclosure_number varchar [note: 'External reference number assigned to the disclosure by the compliance team.']
  disclosure_type varchar [note: 'Category of the disclosure (e.g., annual pension statement, benefit entitlement notice, plan amendment, SFDR disclosure).']
  filing_deadline date [note: 'Date by which the disclosure must be filed with the regulator.']
  filing_fee_amount decimal(15,2) [note: 'Monetary fee charged by the regulator for processing the filing.']
  filing_format varchar [note: 'File format of the submitted disclosure document.']
  filing_status varchar [note: 'Current status of the filing within the regulator\'s workflow.']
  gross_amount decimal(15,2) [note: 'Total monetary amount disclosed before adjustments.']
  is_mandatory boolean [note: 'True if the disclosure is required by law or regulation; otherwise false.']
  issuance_timestamp timestamp [note: 'Date and time when the disclosure was formally issued to the beneficiary or regulator.']
  jurisdiction varchar [note: 'Three‑letter ISO country code of the regulatory jurisdiction for the disclosure.']
  net_amount decimal(15,2) [note: 'Final monetary amount after adjustments, representing the amount disclosed to the beneficiary.']
  rejection_date date [note: 'Date the regulator rejected the disclosure, if applicable.']
  rejection_reason varchar [note: 'Explanation provided by the regulator for a rejected filing.']
  reporting_period_end date [note: 'End date of the financial/reporting period covered by the disclosure.']
  reporting_period_start date [note: 'Start date of the financial/reporting period covered by the disclosure.']
  submission_date date [note: 'Date the disclosure was submitted to the regulator or beneficiary.']
  submission_method varchar [note: 'Channel used to submit the disclosure.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent modification to the disclosure record.']
  version_number varchar [note: 'Sequential version of the disclosure document.']

  Note: 'Transactional record of each formal disclosure or regulatory report issued to pension beneficiaries, contributor pools, or sponsoring employers. Captures disclosure type (annual pension statement, benefit entitlement notice, plan amendment notice, SFDR'
}

Table compliance.audit_finding {
  audit_finding_id varchar [pk, note: 'Unique identifier for the audit finding record.']
  employee_id varchar [note: 'Identifier of the auditor party.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: audit_finding has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Audit findings may relate to specific compliance rules. compliance_rule_code and compliance_rule_description can be removed as they become redundant with the FK to rule.']
  audit_finding_status varchar [note: 'Current lifecycle status of the audit finding.']
  audit_period_end date [note: 'End date of the audit period covering the finding.']
  audit_period_start date [note: 'Start date of the audit period covering the finding.']
  audit_reference_number varchar [note: 'Reference number linking to the original audit documentation.']
  audit_source_system varchar [note: 'Source system where the audit finding originated (e.g., Diligent, BlackRock Aladdin).']
  audit_type varchar [note: 'Type of audit that generated the finding (e.g., internal, external, SOC 2, ISO 27001).']
  auditor_name varchar [note: 'Full name of the auditor who identified the finding.']
  compliance_impact varchar [note: 'Description of compliance impact resulting from the finding.']
  control_code varchar [note: 'Identifier of the internal control linked to the finding.']
  control_name varchar [note: 'Descriptive name of the control associated with the finding.']
  created_timestamp timestamp [note: 'Timestamp when the audit finding record was created in the system.']
  currency_code varchar [note: 'ISO 4217 currency code for monetary amounts.']
  escalation_contact_email varchar [note: 'Email address of the escalation contact.']
  escalation_contact_name varchar [note: 'Name of the escalation contact for the finding.']
  evidence_document_code varchar [note: 'Identifier of the supporting evidence document.']
  evidence_document_url varchar [note: 'URL linking to the evidence document for the finding.']
  financial_impact_amount decimal(18,2) [note: 'Estimated financial impact resulting from the finding.']
  financial_impact_currency varchar [note: 'Currency code for the financial impact amount.']
  finding_category varchar [note: 'Broad category of the audit finding.']
  finding_description varchar [note: 'Detailed narrative describing the audit finding.']
  finding_number varchar [note: 'Unique business identifier assigned to the audit finding.']
  impact_assessment varchar [note: 'Overall impact assessment (financial, operational, reputational).']
  is_critical boolean [note: 'Indicates whether the finding is classified as critical.']
  is_repeat_finding boolean [note: 'Indicates whether this finding repeats a prior issue.']
  jurisdiction varchar [note: 'Geographic jurisdiction relevant to the finding.']
  operational_impact varchar [note: 'Description of operational impact caused by the finding.']
  recommendation varchar [note: 'Suggested corrective action to address the finding.']
  related_process varchar [note: 'Name of the business process associated with the finding.']
  remediation_action varchar [note: 'Planned action to address and resolve the finding.']
  remediation_cost_amount decimal(18,2) [note: 'Estimated monetary cost to remediate the finding.']
  remediation_due_date date [note: 'Target date by which remediation actions should be completed.']
  remediation_effectiveness_score varchar [note: 'Score (0-100) indicating effectiveness of remediation after closure.']
  remediation_owner varchar [note: 'Name of the individual responsible for executing remediation.']
  remediation_status varchar [note: 'Current status of the remediation effort.']
  reported_timestamp timestamp [note: 'Date and time when the audit finding was reported.']
  risk_rating varchar [note: 'Overall risk rating assigned to the finding.']
  root_cause_analysis varchar [note: 'Analysis of the underlying root cause of the finding.']
  severity_level varchar [note: 'Severity rating assigned to the finding based on impact.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the audit finding record.']

  Note: 'Transactional record of each internal or external audit finding raised against the compliance, investment, or operational functions of the pension fund. Captures audit type (internal audit, external audit, SOC 2, ISO 27001), audit period, finding category'
}

Table compliance.personal_account_dealing {
  personal_account_dealing_id varchar [pk, note: 'Unique identifier for the personal account dealing disclosure record.']
  employee_id varchar [note: 'Unique identifier of the employee submitting the dealing request.']
  instrument_id varchar [note: 'Foreign key linking to trade.instrument. Business justification: Employee pre-clearance requires checking requested securities against restricted lists and fund holdings.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: personal_account_dealing has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Link personal_account_dealing to rule to capture the rule that governs the transaction. Redundant regulation code removed.']
  business_event_timestamp timestamp [note: 'Timestamp representing when the dealing is intended to be executed.']
  compliance_review_status varchar [note: 'Status of the downstream compliance review.']
  compliance_review_timestamp timestamp [note: 'Timestamp of the most recent compliance review action.']
  currency_code varchar [note: 'Three‑letter ISO currency code for the transaction.']
  data_classification varchar [note: 'Classification of the record for data governance (e.g., restricted, confidential, internal, public).']
  effective_date date [note: 'Date on which the dealing becomes effective.']
  employee_role varchar [note: 'Role or position of the employee within the pension fund (e.g., Portfolio Manager).']
  expiration_date date [note: 'Date after which the dealing request is no longer valid, if applicable.']
  fee_amount decimal(20,2) [note: 'Total fees associated with the dealing request.']
  gross_amount decimal(20,2) [note: 'Total amount before fees and adjustments.']
  is_waiver_requested boolean [note: 'Indicates whether a regulatory or policy waiver was requested for the dealing.']
  jurisdiction varchar [note: 'Country jurisdiction applicable to the dealing request. [ENUM-REF-CANDIDATE: USA|CAN|GBR|AUS|FRA|DEU|JPN|CHN|IND|BRA] ']
  justification_text varchar [note: 'Narrative explanation provided by the employee for the dealing request.']
  lifecycle_status varchar [note: 'Overall lifecycle status of the dealing request.']
  net_amount decimal(20,2) [note: 'Net amount after fees (gross minus fees).']
  notes varchar [note: 'Free‑form notes captured by compliance or investment staff.']
  preclearance_approval_timestamp timestamp [note: 'Timestamp when the pre‑clearance request was approved or rejected.']
  preclearance_approver varchar [note: 'Name of the compliance officer who approved or rejected the request.']
  preclearance_request_timestamp timestamp [note: 'Timestamp when the employee submitted the pre‑clearance request.']
  preclearance_status varchar [note: 'Current status of the pre‑clearance request.']
  record_audit_created timestamp [note: 'Timestamp when the dealing record was first created in the system.']
  record_audit_updated timestamp [note: 'Timestamp of the most recent update to the dealing record.']
  related_document_reference varchar [note: 'Reference (e.g., URL or document ID) to supporting documentation attached to the request.']
  request_number varchar [note: 'Business identifier assigned to each dealing request.']
  risk_rating varchar [note: 'Risk rating assigned to the dealing based on compliance assessment.']
  trade_execution_venue varchar [note: 'Venue or platform where the trade would be executed.']
  transaction_price decimal(20,4) [note: 'Price per share/unit at which the dealing is proposed.']
  transaction_quantity decimal(20,4) [note: 'Number of shares or units involved in the dealing.']
  transaction_reason varchar [note: 'Business reason for the dealing (e.g., portfolio rebalancing, liquidity need).']
  transaction_type varchar [note: 'Type of dealing transaction requested.']
  waiver_approval_status varchar [note: 'Current approval status of the waiver request.']
  waiver_approval_timestamp timestamp [note: 'Timestamp when the waiver request was approved or denied.']

  Note: 'Transactional record of personal account dealing (PAD) disclosures and pre-clearance requests submitted by investment staff and officers. Captures employee name and role, security identifier (ISIN/CUSIP), transaction type (buy, sell, short), proposed'
}

Table compliance.regulatory_authority {
  regulatory_authority_id varchar [pk, note: 'Unique identifier for the regulatory authority record.']
  abbreviation varchar [note: 'Common abbreviation or acronym for the authority.']
  authority_code varchar [note: 'Alphanumeric code uniquely identifying the authority.']
  authority_regulation_areas varchar [note: 'Comma-separated list of regulatory areas or domains the authority covers.']
  authority_regulation_areas_description varchar [note: 'Detailed description of the regulatory areas covered.']
  authority_regulation_areas_end_date date [note: 'End date when the authority ceased overseeing the area, if applicable.']
  authority_regulation_areas_notes varchar [note: 'Additional notes about the regulatory areas.']
  authority_regulation_areas_start_date date [note: 'Start date when the authority began overseeing the area.']
  authority_regulation_areas_status varchar [note: 'Operational status of each regulatory area.']
  authority_regulation_areas_type varchar [note: 'Type classification of the regulatory area (e.g., market, conduct).']
  authority_regulation_areas_type_code varchar [note: 'Code identifying the regulatory area type.']
  authority_regulation_areas_type_description varchar [note: 'Detailed description of the regulatory area type.']
  authority_regulation_areas_type_end_date date [note: 'End date of the regulatory area type, if applicable.']
  authority_regulation_areas_type_name varchar [note: 'Human-readable name of the regulatory area type.']
  authority_regulation_areas_type_notes varchar [note: 'Additional notes about the regulatory area type.']
  authority_regulation_areas_type_start_date date [note: 'Start date of the regulatory area type.']
  authority_regulation_areas_type_status varchar [note: 'Operational status of the regulatory area type.']
  authority_regulation_codes varchar [note: 'Comma-separated list of regulation codes overseen by the authority.']
  authority_regulation_names varchar [note: 'Comma-separated list of regulation names overseen by the authority.']
  authority_type varchar [note: 'Category of regulatory authority (prudential, conduct, market, other).']
  authority_website varchar [note: 'Official website URL of the authority.']
  contact_address varchar [note: 'Street address of the authority\'s main office.']
  contact_city varchar [note: 'City component of the authority\'s address.']
  contact_country varchar [note: 'Country of the authority\'s address (ISO 3166-1 alpha-3).']
  contact_email varchar [note: 'Primary email address for contacting the authority.']
  contact_fax varchar [note: 'Fax number for the authority.']
  contact_person_email varchar [note: 'Email address of the primary contact person.']
  contact_person_name varchar [note: 'Full name of the primary contact person at the authority.']
  contact_person_phone varchar [note: 'Telephone number of the primary contact person.']
  contact_person_title varchar [note: 'Job title of the primary contact person.']
  contact_phone varchar [note: 'Primary telephone number for contacting the authority.']
  contact_postal_code varchar [note: 'Postal code of the authority\'s address.']
  contact_state varchar [note: 'State or province of the authority\'s address.']
  contact_website varchar [note: 'Website URL for the authority\'s contact page.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  effective_date date [note: 'Date the authority became effective.']
  jurisdiction varchar [note: 'ISO 3166-1 alpha-3 country code of the authority\'s jurisdiction.']
  legal_name varchar [note: 'Full legal name of the regulatory authority as registered.']
  notes varchar [note: 'Free-text notes or remarks about the authority.']
  regulatory_authority_name varchar [note: 'Human-readable name of the regulatory authority.']
  regulatory_authority_status varchar [note: 'Current operational status of the authority.']
  termination_date date [note: 'Date the authority ceased operations, if applicable.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent record update.']

  Note: 'Reference master of all regulatory authorities and governing bodies with jurisdiction over the pension fund\'s operations. Captures authority name (SEC, FCA, ESMA, IOSCO, local pension regulator), authority type (prudential, conduct, market'
}

Table compliance.obligation {
  obligation_id varchar [pk, note: 'Unique identifier for the compliance obligation.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: Link obligation to regulatory_authority to capture the authority overseeing the obligation. Redundant authority attributes removed.']
  rule_id varchar [note: 'Foreign key linking to compliance.rule. Business justification: Link obligation to rule to capture the rule that defines the obligation. Redundant rule attributes removed.']
  compliance_status varchar [note: 'Current compliance status of the obligation.']
  created_timestamp timestamp [note: 'Timestamp when the record was created.']
  currency_code varchar [note: 'ISO 4217 currency code for monetary amounts.']
  data_classification varchar [note: 'Classification level of the obligation data.']
  effective_end_date date [note: 'Date the obligation expires or is terminated.']
  effective_start_date date [note: 'Date the obligation becomes effective.']
  escalation_contact varchar [note: 'Contact for escalation of compliance issues.']
  filing_deadline date [note: 'Deadline for filing the obligation.']
  filing_frequency varchar [note: 'Required reporting frequency for the obligation.']
  filing_method varchar [note: 'Method used to submit the filing (e.g., electronic, paper).']
  filing_reference_number varchar [note: 'Reference number assigned to the filing.']
  filing_status varchar [note: 'Current status of the filing submission.']
  is_external boolean [note: 'Flag indicating if the obligation originates from an external regulator.']
  is_mandatory boolean [note: 'Flag indicating if the obligation is mandatory.']
  is_reported boolean [note: 'Flag indicating if the obligation has been reported.']
  last_filed_date date [note: 'Date the obligation was last filed.']
  last_reviewed_date date [note: 'Date the obligation was last reviewed.']
  next_due_date date [note: 'Next scheduled filing date.']
  next_review_date date [note: 'Scheduled next review date.']
  notes varchar [note: 'Free‑text notes about the obligation.']
  obligation_code varchar [note: 'Alphanumeric code assigned to the obligation by the fund.']
  obligation_description varchar [note: 'Detailed description of the obligation.']
  obligation_name varchar [note: 'Descriptive name of the obligation.']
  obligation_status varchar [note: 'Current lifecycle status of the obligation.']
  obligation_type varchar [note: 'Category of the obligation (e.g., regulatory, policy, mandate).']
  penalty_amount decimal(15,2) [note: 'Monetary penalty associated with the obligation.']
  penalty_currency varchar [note: 'Currency of the penalty amount.']
  penalty_risk_level varchar [note: 'Risk level of potential penalties.']
  remediation_action varchar [note: 'Action required to remediate a breach.']
  remediation_cost_amount decimal(15,2) [note: 'Monetary cost of remediation.']
  remediation_due_date date [note: 'Target date for completing remediation.']
  remediation_status varchar [note: 'Current status of the remediation effort.']
  reporting_date date [note: 'Date the obligation was reported.']
  required_documentation varchar [note: 'Documents required for compliance filing.']
  responsible_party varchar [note: 'Party accountable for the obligation.']
  risk_level varchar [note: 'Overall risk level of the obligation.']
  risk_score decimal(10,2) [note: 'Quantitative risk score for the obligation.']
  updated_timestamp timestamp [note: 'Timestamp of the last record update.']

  Note: 'Master record defining each specific compliance obligation the pension fund must fulfill under applicable regulations, internal policies, or mandate terms.'
}

Table compliance.sfdr_disclosure {
  sfdr_disclosure_id varchar [pk, note: 'Primary key, unique identifier for the SFDR disclosure record.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: sfdr_disclosure has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  classification_or_type varchar [note: 'Specifies whether the disclosure is entity-level PAI, product-level pre-contractual, or periodic report.']
  compliance_flag boolean [note: 'Indicates whether the disclosure meets all compliance criteria.']
  created_timestamp timestamp [note: 'Timestamp when the record was first created.']
  currency_code varchar [note: 'ISO 4217 currency code for the filing fee.']
  disclosure_reference varchar [note: 'External reference or number assigned to the disclosure for tracking.']
  effective_from date [note: 'Date when the disclosure becomes effective.']
  effective_until date [note: 'Date when the disclosure ceases to be effective, if applicable.']
  filing_acceptance_date date [note: 'Date the regulator accepted the filing.']
  filing_deadline date [note: 'Deadline by which the disclosure must be filed.']
  filing_document_url varchar [note: 'URL to the filed document.']
  filing_fee_amount decimal(15,2) [note: 'Fee paid for filing the disclosure.']
  filing_format varchar [note: 'File format of the submitted disclosure.']
  filing_method varchar [note: 'Method used to submit the filing.']
  filing_period_end date [note: 'End date of the reporting period for the disclosure.']
  filing_period_start date [note: 'Start date of the reporting period for the disclosure.']
  filing_reference_number varchar [note: 'Unique reference number assigned by the regulator.']
  filing_rejection_date date [note: 'Date the regulator rejected the filing, if applicable.']
  filing_rejection_reason varchar [note: 'Reason for filing rejection, if any.']
  filing_status varchar [note: 'Current status of the filing process.']
  filing_submission_date date [note: 'Date the disclosure was submitted to the regulator.']
  filing_version varchar [note: 'Version number of the filing format.']
  jurisdiction varchar [note: 'Country code where the filing is submitted.']
  lifecycle_status varchar [note: 'Current state of the disclosure record in its lifecycle.']
  notes varchar [note: 'Free-text notes or comments about the disclosure.']
  updated_by varchar [note: 'User or system that last updated the record.']
  updated_timestamp timestamp [note: 'Timestamp of the most recent update to the record.']
  created_by varchar [note: 'User or system that created the record.']

  Note: 'Master record of SFDR (Sustainable Finance Disclosure Regulation) product-level and entity-level disclosures prepared and filed by the pension fund. Captures disclosure type (entity-level PAI statement, product-level pre-contractual, periodic report)'
}

Table compliance.gips_compliance_record {
  gips_compliance_record_id varchar [pk, note: 'Unique identifier for the GIPS compliance record.']
  composite_id varchar [note: 'Identifier of the composite for which compliance is asserted.']
  policy_document_id varchar [note: 'Identifier of the compliance assertion document.']
  assertion_date date [note: 'Date when the GIPS compliance assertion was made.']
  compliance_status varchar [note: 'Current compliance status of the entity under GIPS.']
  composite_end_date date [note: 'Date when the composite was closed or terminated.']
  composite_start_date date [note: 'Date when the composite became active.']
  composite_status varchar [note: 'Lifecycle status of the composite.']
  composite_type varchar [note: 'Asset class of the composite: public equity, private equity, real estate, etc.']
  document_checksum varchar [note: 'MD5 checksum of the document for integrity verification.']
  document_created_by varchar [note: 'User who created the document.']
  document_created_timestamp timestamp [note: 'Timestamp when the document was first created.']
  document_date date [note: 'Date the document was issued or published.']
  document_format varchar [note: 'File format of the document.']
  document_is_active boolean [note: 'Flag indicating if the document is currently active.']
  document_is_approved boolean [note: 'Flag indicating if the document has been approved.']
  document_is_archived boolean [note: 'Flag indicating if the document has been archived.']
  document_is_confidential boolean [note: 'Flag indicating if the document contains confidential information.']
  document_is_draft boolean [note: 'Flag indicating if the document is in draft status.']
  document_is_external boolean [note: 'Flag indicating if the document originates from an external source.']
  document_is_final boolean [note: 'Flag indicating if the document is finalized.']
  document_is_in_review boolean [note: 'Flag indicating if the document is currently under review.']
  document_is_pending boolean [note: 'Flag indicating if the document is pending approval.']
  document_is_pii boolean [note: 'Flag indicating if the document contains personally identifiable information.']
  document_is_restricted boolean [note: 'Flag indicating if the document is restricted to certain users.']
  document_is_reviewed boolean [note: 'Flag indicating if the document has been reviewed.']
  document_is_sensitive boolean [note: 'Flag indicating if the document contains sensitive data.']
  document_is_signed boolean [note: 'Flag indicating if the document has been signed.']
  document_is_verified boolean [note: 'Flag indicating if the document has been verified.']
  document_notes varchar [note: 'Additional notes or comments about the document.']
  document_path varchar [note: 'File system or cloud path to the document.']
  document_retention_period_days varchar [note: 'Number of days the document must be retained.']
  document_size_bytes varchar [note: 'Size of the document in bytes.']
  document_source_system varchar [note: 'System that supplied the document. [ENUM-REF-CANDIDATE: SimCorp|BlackRock|Bloomberg|StateStreet|eFront|DealCloud|MSCI|CharlesRiver|Oracle|SAP|Diligent|Preqin|FactSet — promote to reference product]']
  document_status varchar [note: 'Lifecycle status of the document.']
  document_type varchar [note: 'Type of the compliance document.']
  document_updated_by varchar [note: 'User who last updated the document.']
  document_updated_timestamp timestamp [note: 'Timestamp of the last update to the document.']
  document_version varchar [note: 'Version identifier of the document.']
  firm_code varchar [note: 'Identifier of the firm.']
  firm_name varchar [note: 'Name of the investment firm.']
  firm_status varchar [note: 'Current operational status of the firm.']
  method varchar [note: 'Method used to assert compliance: manual, automated, or third-party.']
  scope varchar [note: 'Scope of the compliance assertion: firm-wide or composite-specific.']

  Note: 'Master record tracking the pension fund\'s GIPS (Global Investment Performance Standards) compliance status at the composite and firm level. Captures GIPS compliance assertion date, compliance scope (firm-wide, composite-specific), composite reference'
}

Table compliance.certification {
  certification_id varchar [pk, note: 'Unique system-generated identifier for the certification record.']
  employee_id varchar [note: 'Internal identifier of the staff member who completed the certification.']
  regulatory_authority_id varchar [note: 'Foreign key linking to compliance.regulatory_authority. Business justification: certification has regulatory_body as string but should link to regulatory_authority for proper normalization. regulatory_body string can be removed.']
  certification_date date [note: 'Date when the certification was issued or recorded.']
  certification_status varchar [note: 'Current lifecycle state of the certification record.']
  certification_type varchar [note: 'Category of the certification, e.g., annual compliance attestation or AML training.']
  completion_date date [note: 'Date when the certification was completed by the staff member.']
  compliance_area varchar [note: 'Business area covered by the certification.']
  created_timestamp timestamp [note: 'Timestamp when the certification record was created.']
  document_url varchar [note: 'Link to the digital copy of the certification document.']
  is_active boolean [note: 'Flag indicating whether the certification record is currently active.']
  notes varchar [note: 'Free-text notes related to the certification record.']
  number varchar [note: 'External reference number assigned to the certification by the organization.']
  regulatory_requirement_code varchar [note: 'Code identifying the specific regulatory requirement.']
  regulatory_requirement_name varchar [note: 'Full name of the regulatory requirement.']
  staff_department varchar [note: 'Department where the staff member works.']
  staff_email varchar [note: 'Primary email address of the staff member.']
  staff_name varchar [note: 'Full legal name of the staff member.']
  staff_phone varchar [note: 'Primary phone number of the staff member.']
  staff_role varchar [note: 'Job role of the staff member within the organization.']
  training_certificate_number varchar [note: 'Certificate number issued for the completed training.']
  training_certificate_url varchar [note: 'Link to the digital copy of the training certificate.']
  training_completion_date date [note: 'Date when the training module was completed.']
  training_module varchar [note: 'Name of the training module completed as part of the certification.']
  training_passed boolean [note: 'Indicates whether the staff member passed the training assessment.']
  training_score decimal(5,2) [note: 'Numeric score achieved in the training assessment.']
  training_version varchar [note: 'Version identifier of the training module.']
  updated_timestamp timestamp [note: 'Timestamp when the certification record was last updated.']

  Note: 'Transactional record of periodic compliance certifications completed by investment staff, officers, and committee members. Captures certification type (annual compliance attestation, AML training completion, code of ethics acknowledgement, GIPS compliance'
}

Table shared.actor {
  actor_id varchar [pk, note: 'Primary key for actor']
  actor_status varchar [note: 'Current lifecycle status of the actor.']
  address_line1 varchar [note: 'Primary street address of the actor.']
  address_line2 varchar [note: 'Secondary address information (e.g., suite, floor).']
  aml_status varchar [note: 'Anti-Money Laundering status of the actor.']
  city varchar [note: 'City of the actor\'s address.']
  compliance_status varchar [note: 'Compliance status of the actor with regulatory requirements.']
  country varchar [note: 'Country of the actor\'s address.']
  created_at timestamp [note: 'Timestamp when the actor record was first created.']
  default_currency varchar [note: 'Preferred currency for transactions.']
  email varchar [note: 'Primary email address of the actor.']
  entity_subtype varchar [note: 'Specific subtype of the actor (e.g., pension fund, private equity manager).']
  entity_type varchar [note: 'Category of the actor (e.g., individual, organization, fund).']
  external_system_code varchar [note: 'Identifier used in external systems for the actor.']
  family_name varchar [note: 'Last name of the actor.']
  given_name varchar [note: 'First name of the actor.']
  industry_code varchar [note: 'Industry classification code of the actor.']
  investment_profile varchar [note: 'Investment style and preferences of the actor.']
  kyc_status varchar [note: 'Know Your Customer verification status.']
  last_contact_date date [note: 'Date of the most recent contact with the actor.']
  legal_name varchar [note: 'Full legal name of the actor.']
  net_income decimal(18,2) [note: 'Annual net income of the actor.']
  net_worth decimal(18,2) [note: 'Estimated net worth of the actor.']
  phone varchar [note: 'Primary contact phone number of the actor.']
  postal_code varchar [note: 'Postal code of the actor\'s address.']
  preferred_contact_method varchar [note: 'Preferred method of contact for the actor.']
  preferred_language varchar [note: 'Preferred language for communication.']
  registration_number varchar [note: 'Official registration number of the actor.']
  risk_profile varchar [note: 'Risk tolerance profile of the actor.']
  sanctions_status varchar [note: 'Sanctions list status of the actor.']
  sector varchar [note: 'Sector of the actor\'s business activities.']
  state varchar [note: 'State or province of the actor\'s address.']
  tax_identifier varchar [note: 'Government-issued tax ID for the actor.']
  updated_at timestamp [note: 'Timestamp when the actor record was last updated.']

  Note: 'Master reference table for actor. '
}

Table shared.employee {
  employee_id varchar [pk, note: 'Primary key for employee']
  actor_id varchar [note: 'Foreign key linking to shared.actor. Business justification: Employee is a type of actor; linking via actor_id provides a single source of truth for personal and contact details, enabling normalization and eliminating duplicate data.']
  department_id varchar [note: 'Identifier of the department the employee belongs to.']
  manager_employee_id varchar [note: 'Identifier of the employee\'s direct manager.']
  bonus decimal(15,2) [note: 'Annual bonus awarded to the employee.']
  date_of_birth date [note: 'Date of birth of the employee.']
  emergency_contact_address_line1 varchar [note: 'First line of the emergency contact\'s address.']
  emergency_contact_address_line2 varchar [note: 'Second line of the emergency contact\'s address.']
  emergency_contact_city varchar [note: 'City component of the emergency contact\'s address.']
  emergency_contact_country varchar [note: 'ISO 3166-1 alpha-3 country code of the emergency contact\'s residence.']
  emergency_contact_email varchar [note: 'Email address of the employee\'s emergency contact.']
  emergency_contact_name varchar [note: 'Name of the employee\'s emergency contact.']
  emergency_contact_phone varchar [note: 'Phone number of the employee\'s emergency contact.']
  emergency_contact_postal_code varchar [note: 'Postal or ZIP code of the emergency contact\'s address.']
  emergency_contact_relationship varchar [note: 'Relationship of the emergency contact to the employee.']
  emergency_contact_state varchar [note: 'State or province component of the emergency contact\'s address.']
  employee_code varchar [note: 'Alphanumeric code used for employee identification in external systems.']
  employment_end_date date [note: 'Date when the employee\'s employment ended, if applicable.']
  employment_start_date date [note: 'Date when the employee commenced employment.']
  employment_status varchar [note: 'Current employment status of the employee.']
  employment_type varchar [note: 'Classification of employment arrangement.']
  gender varchar [note: 'Gender of the employee.']
  job_level varchar [note: 'Hierarchical level of the employee within the organization. [ENUM-REF-CANDIDATE: junior|mid|senior|lead|director|vp|c-level — 7 candidates stripped; promote to reference product]']
  job_title varchar [note: 'Official job title of the employee.']
  marital_status varchar [note: 'Marital status of the employee.']
  national_identifier varchar [note: 'National identification number of the employee.']
  number varchar [note: 'Internal employee number assigned by the organization.']
  payroll_account_number varchar [note: 'Bank account number for direct deposit of employee salary.']
  payroll_bank_bic varchar [note: 'Bank Identifier Code for employee payroll account.']
  payroll_bank_iban varchar [note: 'International Bank Account Number for employee payroll account.']
  payroll_bank_name varchar [note: 'Name of the bank where the employee\'s payroll account is held.']
  payroll_frequency varchar [note: 'Frequency of payroll disbursement.']
  record_audit_created timestamp [note: 'Timestamp when the employee record was first created.']
  record_audit_updated timestamp [note: 'Timestamp when the employee record was last updated.']
  salary decimal(15,2) [note: 'Base annual salary of the employee.']
  salary_currency varchar [note: 'Currency code for the employee\'s salary.']
  ssn varchar [note: 'Social Security Number of the employee.']

  Note: 'Master reference table for employee. '
}

Table shared.legal_entity {
  legal_entity_id varchar [pk, note: 'Primary key for legal_entity']
  parent_entity_id varchar [note: 'Reference to the immediate parent legal entity in the corporate ownership hierarchy.']
  ultimate_parent_entity_id varchar [note: 'Reference to the ultimate parent legal entity at the top of the corporate ownership chain.']
  aml_risk_rating varchar [note: 'Risk rating assigned for anti-money laundering compliance and monitoring purposes.']
  base_currency_code varchar [note: 'ISO 4217 three-letter code for the primary operating currency of the entity.']
  counterparty_classification varchar [note: 'Classification of the entity role in investment operations for risk management and reporting.']
  credit_rating varchar [note: 'Current credit rating assigned by major rating agencies for counterparty risk assessment.']
  credit_rating_agency varchar [note: 'Name of the rating agency that assigned the current credit rating.']
  credit_rating_date date [note: 'Date when the current credit rating was assigned or last updated.']
  effective_from_date date [note: 'Date from which this legal entity record becomes effective in the system.']
  effective_to_date date [note: 'Date until which this legal entity record remains effective, null if currently active.']
  entity_status varchar [note: 'Current operational status of the legal entity within the investment management ecosystem.']
  entity_type varchar [note: 'Classification of the legal structure of the entity for regulatory and operational purposes.']
  esg_rating varchar [note: 'Current ESG rating for responsible investment screening and sustainability assessment.']
  esg_rating_provider varchar [note: 'Name of the provider that assigned the current ESG rating.']
  fiscal_year_end_month varchar [note: 'Month number (1-12) when the entity fiscal year ends for financial reporting purposes.']
  gics_code varchar [note: 'Eight-digit GICS code for standardized industry classification in investment analysis.']
  incorporation_country_code varchar [note: 'ISO 3166-1 alpha-3 country code where the entity is legally incorporated or registered.']
  incorporation_date date [note: 'Date when the legal entity was officially incorporated or registered with authorities.']
  industry_sector varchar [note: 'Primary industry sector classification of the entity for investment analysis and reporting.']
  is_broker_dealer boolean [note: 'Indicates whether the entity is registered as a broker-dealer for securities transactions.']
  is_custodian boolean [note: 'Indicates whether the entity provides custodial services for investment assets.']
  is_internal_entity boolean [note: 'Indicates whether the entity is part of the pension fund internal corporate structure.']
  is_investment_manager boolean [note: 'Indicates whether the entity operates as an investment manager or asset manager.']
  is_issuer boolean [note: 'Indicates whether the entity issues securities or investment instruments.']
  kyc_expiry_date date [note: 'Date when the current KYC verification expires and requires renewal.']
  kyc_status varchar [note: 'Current status of Know Your Customer due diligence verification for the entity.']
  kyc_verification_date date [note: 'Date when the most recent KYC verification was completed.']
  legal_name varchar [note: 'Official registered legal name of the entity as filed with regulatory authorities.']
  lei_code varchar [note: '20-character alphanumeric code assigned by GLEIF for global identification of legal entities in financial transactions.']
  ownership_percentage decimal(5,2) [note: 'Percentage of ownership held by the parent entity, used for consolidation and control assessment.']
  primary_contact_email varchar [note: 'Primary email address for official communications with the legal entity.']
  primary_contact_phone varchar [note: 'Primary telephone number for official communications with the legal entity.']
  primary_regulator varchar [note: 'Name of the primary financial regulatory authority overseeing the entity.']
  record_created_timestamp timestamp [note: 'Timestamp when this legal entity record was first created in the system.']
  registered_address_line_1 varchar [note: 'First line of the official registered address of the legal entity.']
  registered_address_line_2 varchar [note: 'Second line of the official registered address for additional location details.']
  registered_city varchar [note: 'City of the official registered address of the legal entity.']
  registered_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the registered address location.']
  registered_postal_code varchar [note: 'Postal or ZIP code of the official registered address.']
  registration_number varchar [note: 'Official company registration number assigned by the incorporation authority.']
  regulatory_status varchar [note: 'Current regulatory standing of the entity with relevant financial supervisory authorities.']
  short_name varchar [note: 'Abbreviated or commonly used short name for the entity in internal systems and reports.']
  tax_identification_number varchar [note: 'Government-issued tax identification number for the entity in its primary tax jurisdiction.']
  tax_jurisdiction_code varchar [note: 'ISO 3166-1 alpha-3 country code of the primary tax jurisdiction for the entity.']
  trading_name varchar [note: 'Commercial or trading name under which the entity conducts business, may differ from legal name.']
  website_url varchar [note: 'Official website address of the legal entity.']

  Note: 'Master reference table for legal_entity. Referenced by legal_entity_id.'
}

Table shared.document {
  document_id varchar [pk, note: 'Primary key for document']
  approval_date date [note: 'Date when the document received formal approval for publication or distribution.']
  approver_name varchar [note: 'Name of the individual who approved the document for publication or distribution.']
  archive_date date [note: 'Date when the document was moved to archival storage.']
  author_name varchar [note: 'Name of the individual or team who authored or created the document.']
  checksum_hash varchar [note: 'SHA-256 hash value of the document content for integrity verification and tamper detection.']
  document_category varchar [note: 'Business domain category indicating the functional area to which the document relates.']
  document_description varchar [note: 'Detailed narrative description of the document content, purpose, and context for discovery and retrieval.']
  document_status varchar [note: 'Current state of the document within its lifecycle from creation through archival or supersession.']
  document_type varchar [note: 'Primary classification of the document by its functional purpose within the organization.']
  effective_date date [note: 'Date from which the document becomes effective or binding for business purposes.']
  expiration_date date [note: 'Date on which the document expires or is no longer valid for business use. Null for documents with no expiration.']
  external_reference_code varchar [note: 'External system reference identifier used to link the document to counterparty or third-party systems.']
  file_format varchar [note: 'File format or extension indicating the technical format of the stored document.']
  file_size_bytes varchar [note: 'Size of the document file in bytes for storage management and transfer planning.']
  is_archived boolean [note: 'Boolean flag indicating whether the document has been moved to archival storage.']
  is_confidential boolean [note: 'Boolean flag indicating whether the document contains confidential or sensitive information requiring restricted access.']
  is_legally_binding boolean [note: 'Boolean flag indicating whether the document has legal or contractual binding effect.']
  is_regulatory_required boolean [note: 'Boolean flag indicating whether the document is required for regulatory compliance or reporting purposes.']
  keywords varchar [note: 'Comma-separated list of keywords or tags for document search and discovery purposes.']
  language_code varchar [note: 'ISO 639-1 language code indicating the primary language of the document content.']
  last_modified_timestamp timestamp [note: 'Timestamp of the most recent modification to the document content or metadata.']
  next_review_date date [note: 'Scheduled date for the next periodic review of the document content and applicability.']
  owner_department varchar [note: 'Business department or organizational unit responsible for maintaining and governing the document.']
  reference_number varchar [note: 'Externally-known business reference number used to identify the document across systems and in correspondence with counterparties.']
  retention_end_date date [note: 'Calculated date when the document retention period expires and the document may be disposed.']
  retention_period_years varchar [note: 'Number of years the document must be retained per regulatory or business retention policies.']
  review_frequency_months varchar [note: 'Number of months between required periodic reviews of the document for accuracy and relevance.']
  security_classification varchar [note: 'Data classification level indicating the sensitivity and access restrictions for the document.']
  source_system varchar [note: 'Name or identifier of the originating system from which the document was ingested or created.']
  storage_location varchar [note: 'Logical or physical storage path indicating where the document is stored in the document management system.']
  title varchar [note: 'Human-readable title or name of the document describing its content or purpose.']
  version_number varchar [note: 'Version identifier indicating the revision level of the document in major.minor format.']
  creation_date date [note: 'Date when the document was originally created or authored.']

  Note: 'Master reference table for document. Referenced by confirmation_document_id.'
}

Table shared.fund_administrator {
  fund_administrator_id varchar [pk, note: 'Primary key for fund_administrator']
  administrator_type varchar [note: 'Classification of the fund administrator based on the scope of services provided to investment funds.']
  aum_reporting_date date [note: 'The as-of date for the reported assets under administration figure.']
  aum_usd decimal(18,2) [note: 'Total assets under administration by the fund administrator, expressed in US dollars for comparability.']
  credit_rating varchar [note: 'The current credit rating assigned by major rating agencies to the fund administrator or parent company.']
  credit_rating_agency varchar [note: 'The name of the credit rating agency that assigned the current credit rating.']
  domicile_country_code varchar [note: 'The ISO 3166-1 alpha-3 country code representing the legal domicile jurisdiction of the fund administrator.']
  due_diligence_rating varchar [note: 'The overall rating assigned following the most recent operational due diligence review.']
  employee_count varchar [note: 'The total number of employees at the fund administrator organization.']
  fund_administrator_status varchar [note: 'Current operational status of the fund administrator relationship with the pension fund.']
  giin varchar [note: 'The 19-character identifier assigned by the IRS for FATCA reporting purposes to identify participating foreign financial institutions.']
  headquarters_address varchar [note: 'The full street address of the fund administrator\'s global headquarters location.']
  headquarters_city varchar [note: 'The city where the fund administrator\'s global headquarters is located.']
  headquarters_country_code varchar [note: 'The ISO 3166-1 alpha-3 country code for the fund administrator\'s headquarters location.']
  incorporation_date date [note: 'The date when the fund administrator entity was legally incorporated or established.']
  is_publicly_traded boolean [note: 'Indicates whether the fund administrator or its parent company is publicly traded on a stock exchange.']
  isae3402_certified boolean [note: 'Indicates whether the fund administrator holds current ISAE 3402 Type II certification for service organizations.']
  iso27001_certified boolean [note: 'Indicates whether the fund administrator holds current ISO 27001 certification for information security management.']
  last_due_diligence_date date [note: 'The date of the most recent operational due diligence review conducted by the pension fund on this administrator.']
  legal_name varchar [note: 'The official registered legal name of the fund administrator as it appears in regulatory filings and contracts.']
  lei_code varchar [note: 'The 20-character alphanumeric Legal Entity Identifier assigned by a Local Operating Unit under the Global LEI System.']
  next_due_diligence_date date [note: 'The scheduled date for the next operational due diligence review of this fund administrator.']
  notes varchar [note: 'Free-text field for additional notes or comments about the fund administrator relationship.']
  number_of_funds_serviced varchar [note: 'The total count of investment funds currently serviced by the fund administrator globally.']
  parent_company_name varchar [note: 'The name of the parent company or ultimate holding company if the fund administrator is a subsidiary.']
  primary_contact_email varchar [note: 'The email address of the primary relationship contact at the fund administrator.']
  primary_contact_name varchar [note: 'The name of the primary relationship contact person at the fund administrator for the pension fund.']
  primary_contact_phone varchar [note: 'The direct phone number of the primary relationship contact at the fund administrator.']
  primary_regulator varchar [note: 'Name of the primary financial regulatory authority that oversees the fund administrator\'s operations.']
  record_created_timestamp timestamp [note: 'The timestamp when this fund administrator record was first created in the system.']
  record_updated_timestamp timestamp [note: 'The timestamp when this fund administrator record was last modified in the system.']
  registration_date date [note: 'The date when the fund administrator was officially registered with the primary regulatory authority.']
  registration_number varchar [note: 'The official registration or license number assigned by the primary regulatory authority.']
  regulatory_jurisdiction varchar [note: 'The primary regulatory jurisdiction under which the fund administrator operates and is licensed.']
  relationship_end_date date [note: 'The date when the relationship with this fund administrator was terminated, if applicable.']
  relationship_start_date date [note: 'The date when the pension fund first engaged this fund administrator for services.']
  service_tier varchar [note: 'Classification of the administrator based on assets under administration, global reach, and service capabilities.']
  soc1_certified boolean [note: 'Indicates whether the fund administrator holds a current SOC 1 Type II certification for internal controls.']
  soc2_certified boolean [note: 'Indicates whether the fund administrator holds a current SOC 2 Type II certification for security controls.']
  stock_ticker varchar [note: 'The stock exchange ticker symbol if the fund administrator or parent company is publicly traded.']
  termination_reason varchar [note: 'The reason for terminating the relationship with the fund administrator, if the relationship has ended.']
  trading_name varchar [note: 'The commercial or trading name under which the fund administrator operates in the market, may differ from legal name.']
  website_url varchar [note: 'The official corporate website URL of the fund administrator.']
  year_established varchar [note: 'The calendar year when the fund administrator commenced operations in the fund administration business.']

  Note: 'Master reference table for fund_administrator. Referenced by administrator_id.'
}

Table shared.vendor {
  vendor_id varchar [pk, note: 'Primary key for vendor']
  bank_account_name varchar [note: 'The name on the vendors bank account used for receiving payments.']
  bank_account_number varchar [note: 'The vendors bank account number for payment processing purposes.']
  bank_swift_code varchar [note: 'The SWIFT/BIC code identifying the vendors bank for international wire transfers.']
  country_of_incorporation varchar [note: 'The ISO 3166-1 alpha-3 country code where the vendor is legally incorporated or registered.']
  criticality_tier varchar [note: 'Risk-based classification indicating the vendors importance to business operations and continuity.']
  diversity_certification_type varchar [note: 'The type of diversity certification held by the vendor, if any, such as MBE, WBE, DVBE, or similar.']
  due_diligence_status varchar [note: 'Current status of the vendor due diligence review process required for onboarding and periodic renewal.']
  esg_rating varchar [note: 'The ESG rating assigned to the vendor based on environmental, social, and governance assessment criteria.']
  headquarters_address varchar [note: 'The full street address of the vendors principal place of business or corporate headquarters.']
  headquarters_city varchar [note: 'The city where the vendors corporate headquarters is located.']
  headquarters_country varchar [note: 'The ISO 3166-1 alpha-3 country code where the vendors headquarters is physically located.']
  is_minority_owned boolean [note: 'Indicates whether the vendor is certified as a minority-owned business enterprise for diversity tracking.']
  is_women_owned boolean [note: 'Indicates whether the vendor is certified as a women-owned business enterprise for diversity tracking.']
  last_due_diligence_date date [note: 'The date when the most recent due diligence review of the vendor was completed.']
  legal_entity_identifier varchar [note: 'The 20-character ISO 17442 Legal Entity Identifier assigned to the vendor for regulatory reporting purposes.']
  next_due_diligence_date date [note: 'The scheduled date for the next periodic due diligence review of the vendor.']
  notes varchar [note: 'Free-form notes and comments about the vendor for internal reference and relationship management.']
  onboarding_date date [note: 'The date when the vendor was formally onboarded and approved for use by the organization.']
  payment_currency varchar [note: 'The ISO 4217 three-letter currency code in which the vendor prefers to receive payments.']
  payment_terms_days varchar [note: 'The standard number of days from invoice date within which payment is due to the vendor.']
  postal_code varchar [note: 'The postal or ZIP code for the vendors headquarters address.']
  primary_contact_email varchar [note: 'The email address of the designated primary contact person at the vendor.']
  primary_contact_name varchar [note: 'The name of the designated primary contact person at the vendor organization for relationship management.']
  primary_contact_phone varchar [note: 'The direct telephone number of the designated primary contact person at the vendor.']
  primary_email varchar [note: 'The main email address for general business correspondence with the vendor organization.']
  primary_phone varchar [note: 'The main telephone number for contacting the vendor organization.']
  registration_number varchar [note: 'The official company registration or incorporation number issued by the vendors home jurisdiction.']
  risk_rating varchar [note: 'Overall risk assessment rating assigned to the vendor based on due diligence and ongoing monitoring.']
  tax_identification_number varchar [note: 'The tax registration number assigned by the relevant tax authority in the vendors jurisdiction of incorporation.']
  termination_date date [note: 'The date when the vendor relationship was terminated, if applicable.']
  termination_reason varchar [note: 'The documented reason for terminating the vendor relationship, if applicable.']
  trading_name varchar [note: 'The commercial or trading name under which the vendor conducts business, if different from the legal name.']
  vendor_category varchar [note: 'Broad functional category indicating the business area the vendor primarily supports.']
  vendor_name varchar [note: 'The official registered legal name of the vendor organization as it appears on contracts and legal documents.']
  vendor_status varchar [note: 'Current operational status of the vendor relationship indicating whether they can be engaged for services.']
  vendor_type varchar [note: 'Classification of the vendor by the nature of goods or services provided to the pension fund.']
  website_url varchar [note: 'The official corporate website address of the vendor.']

  Note: 'Master reference table for vendor. Referenced by vendor_id.'
}

Table shared.auditor {
  auditor_id varchar [pk, note: 'Primary key for auditor']
  approved_for_fund_audit_flag boolean [note: 'Indicates whether the auditor is approved to conduct audits of the pension fund\'s investment vehicles.']
  approved_for_manager_audit_flag boolean [note: 'Indicates whether the auditor is approved to audit external fund managers on behalf of the pension fund.']
  auditor_name varchar [note: 'The official registered name of the auditing firm or individual auditor.']
  auditor_status varchar [note: 'Current operational status of the auditor relationship with the pension fund.']
  auditor_type varchar [note: 'Classification of the auditor based on firm size and market position within the audit industry.']
  created_timestamp timestamp [note: 'Timestamp when the auditor record was first created in the system.']
  employee_count varchar [note: 'Total number of employees at the auditing firm, indicating firm capacity and scale.']
  engagement_end_date date [note: 'Date when the auditor relationship with the pension fund ended or is scheduled to end.']
  engagement_start_date date [note: 'Date when the auditor relationship with the pension fund commenced.']
  esg_audit_capability_flag boolean [note: 'Indicates whether the auditor has capability to perform ESG-related assurance engagements.']
  global_network_affiliation varchar [note: 'Name of the global audit network or alliance the auditor is affiliated with (e.g., Deloitte, PwC, BDO).']
  headquarters_address varchar [note: 'Full street address of the auditor firm\'s headquarters or principal place of business.']
  headquarters_city varchar [note: 'City where the auditor firm\'s headquarters is located.']
  headquarters_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the auditor firm\'s headquarters location.']
  independence_review_date date [note: 'Date of the most recent independence assessment conducted for this auditor relationship.']
  independence_status varchar [note: 'Current independence status of the auditor with respect to the pension fund per regulatory requirements.']
  inspection_result varchar [note: 'Outcome of the most recent regulatory inspection of the auditor.']
  insurance_expiry_date date [note: 'Expiration date of the auditor\'s professional liability insurance policy.']
  jurisdiction_country_code varchar [note: 'ISO 3166-1 alpha-3 country code of the primary regulatory jurisdiction governing the auditor.']
  last_inspection_date date [note: 'Date of the most recent regulatory inspection of the auditor by oversight bodies.']
  legal_entity_name varchar [note: 'The full legal entity name as registered with regulatory authorities and corporate registries.']
  lei_code varchar [note: 'The 20-character Legal Entity Identifier assigned by a Local Operating Unit for global identification.']
  notes varchar [note: 'Free-text notes and comments regarding the auditor relationship or special considerations.']
  partner_count varchar [note: 'Number of partners at the auditing firm, indicating firm seniority depth.']
  pcaob_registered_flag boolean [note: 'Indicates whether the auditor is registered with the PCAOB for US public company audits.']
  primary_contact_email varchar [note: 'Email address of the primary contact person for audit-related communications.']
  primary_contact_name varchar [note: 'Name of the primary contact person at the auditing firm responsible for the pension fund engagement.']
  primary_contact_phone varchar [note: 'Phone number of the primary contact person at the auditing firm.']
  professional_liability_coverage_amount decimal(18,2) [note: 'Amount of professional liability insurance coverage maintained by the auditor in base currency.']
  professional_liability_currency_code varchar [note: 'ISO 4217 currency code for the professional liability coverage amount.']
  quality_rating varchar [note: 'Internal quality rating assigned to the auditor based on performance assessments.']
  registration_number varchar [note: 'The unique registration number assigned by the primary regulatory body (e.g., PCAOB, FRC).']
  regulatory_body varchar [note: 'Name of the primary regulatory body overseeing the auditor (e.g., PCAOB, FRC, ASIC).']
  rotation_due_date date [note: 'Date by which mandatory auditor rotation must occur per regulatory requirements.']
  service_offering varchar [note: 'Types of audit and assurance services offered (e.g., financial statement audit, SOC 1, SOC 2, ISAE 3402).']
  specialization_area varchar [note: 'Primary area of audit specialization relevant to institutional asset management (e.g., pension funds, investment management, financial services).']
  tax_identification_number varchar [note: 'Tax identification number of the auditing firm for invoicing and regulatory purposes.']
  tenure_years varchar [note: 'Number of consecutive years the auditor has served the pension fund, relevant for rotation compliance.']
  updated_timestamp timestamp [note: 'Timestamp when the auditor record was last modified.']
  website_url varchar [note: 'Official website URL of the auditing firm.']

  Note: 'Master reference table for auditor. Referenced by auditor_id.'
}

Table shared.contract {
  contract_id varchar [pk, note: 'Primary key for contract']
  counterparty_legal_entity_id varchar [note: 'Reference to the external party (fund manager, custodian, broker) with whom the contract is established.']
  fund_id varchar [note: 'Reference to the specific investment fund or portfolio governed by this contract.']
  legal_entity_id varchar [note: 'Reference to the internal legal entity that is party to this contract on behalf of the pension fund.']
  parent_contract_id varchar [note: 'Reference to the master or parent contract if this is a sub-agreement, amendment, or schedule.']
  arbitration_venue varchar [note: 'City or institution designated for arbitration proceedings if disputes arise.']
  audit_rights_indicator boolean [note: 'Indicates whether the contract grants the pension fund rights to audit the counterparty.']
  co_investment_rights varchar [note: 'Type of co-investment rights granted to the investor under this contract.']
  confidentiality_level varchar [note: 'Level of confidentiality obligations imposed by the contract on information sharing.']
  contract_category varchar [note: 'Hierarchical classification indicating whether this is a master agreement, sub-agreement, or supporting document.']
  contract_name varchar [note: 'Descriptive name or title of the contract used for identification and reporting purposes.']
  contract_number varchar [note: 'Externally-facing unique business identifier assigned to the contract for reference in correspondence and legal documents.']
  contract_status varchar [note: 'Current lifecycle state of the contract indicating its operational validity and enforceability.']
  contract_type varchar [note: 'Classification of the contract by its primary purpose and legal structure within institutional asset management.']
  created_timestamp timestamp [note: 'System timestamp when the contract record was first created in the database.']
  currency_code varchar [note: 'ISO 4217 three-letter currency code for monetary values and fee calculations under this contract.']
  dispute_resolution_method varchar [note: 'Contractually agreed mechanism for resolving disputes between parties.']
  document_storage_path varchar [note: 'File system or document management system path where the executed contract document is stored.']
  effective_date date [note: 'Date on which the contract terms become legally binding and enforceable.']
  esg_compliance_required boolean [note: 'Indicates whether the contract mandates adherence to ESG investment principles and reporting.']
  execution_date date [note: 'Date on which all parties formally signed and executed the contract.']
  expiration_date date [note: 'Date on which the contract naturally expires unless renewed or terminated earlier. Null for evergreen contracts.']
  fee_calculation_basis varchar [note: 'Basis on which management fees are calculated under the contract terms.']
  governing_law_country varchar [note: 'ISO 3166-1 alpha-3 country code indicating the jurisdiction whose laws govern contract interpretation.']
  hurdle_rate decimal(8,6) [note: 'Minimum return threshold that must be achieved before performance fees are payable.']
  internal_owner_name varchar [note: 'Name of the internal team member or department responsible for managing this contract.']
  is_auto_renewal boolean [note: 'Indicates whether the contract includes automatic renewal provisions for successive terms.']
  is_evergreen boolean [note: 'Indicates whether the contract automatically renews unless explicitly terminated by either party.']
  management_fee_rate decimal(8,6) [note: 'Annual management fee rate expressed as a decimal (e.g., 0.015 for 1.5%) charged under this contract.']
  mfn_clause_indicator boolean [note: 'Indicates whether the contract includes a most favored nation clause entitling the investor to best terms.']
  notes varchar [note: 'Free-text field for additional context, special provisions, or internal commentary about the contract.']
  notice_period_days varchar [note: 'Number of days advance notice required for termination or non-renewal of the contract.']
  performance_fee_rate decimal(8,6) [note: 'Carried interest or performance fee rate expressed as a decimal charged on returns above hurdle.']
  renewal_date date [note: 'Date by which renewal notice must be provided or automatic renewal occurs.']
  reporting_frequency varchar [note: 'Frequency at which the counterparty must provide performance and financial reports.']
  termination_date date [note: 'Actual date the contract was terminated, if applicable. Distinct from scheduled expiration.']
  total_commitment_amount decimal(18,2) [note: 'Total capital commitment or notional value governed by this contract in the contract currency.']
  version_number varchar [note: 'Sequential version number tracking amendments and revisions to the contract terms.']

  Note: 'Master reference table for contract. Referenced by contract_id.'
}

Table shared.contractor {
  contractor_id varchar [pk, note: 'Primary key for contractor']
  address_line_1 varchar [note: 'Primary street address or first line of the contractors registered address.']
  address_line_2 varchar [note: 'Secondary address line for suite, unit, or additional location details.']
  bank_account_number varchar [note: 'Bank account number for contractor payment disbursements.']
  bank_routing_code varchar [note: 'Bank routing number, SWIFT code, or sort code for payment processing.']
  city varchar [note: 'City or municipality of the contractors registered address.']
  contractor_name varchar [note: 'Legal registered name of the contractor individual or entity.']
  contractor_status varchar [note: 'Current lifecycle status of the contractor relationship.']
  contractor_type varchar [note: 'Classification of the contractor entity structure.']
  country varchar [note: 'ISO 3166-1 alpha-3 country code of the contractors registered address.']
  created_timestamp timestamp [note: 'Timestamp when the contractor record was first created in the system.']
  engagement_end_date date [note: 'Date when the contractor relationship ended or is scheduled to end. Null if ongoing.']
  engagement_start_date date [note: 'Date when the contractor relationship was first established with the organization.']
  esg_compliance_certified boolean [note: 'Indicates whether the contractor meets ESG compliance standards required by the pension fund.']
  external_reference_code varchar [note: 'External or legacy system identifier for the contractor used for cross-system reconciliation.']
  insurance_expiry_date date [note: 'Expiration date of the contractors professional liability insurance coverage.']
  insurance_policy_number varchar [note: 'Professional liability or indemnity insurance policy number held by the contractor.']
  is_approved_for_sensitive_work boolean [note: 'Indicates whether the contractor has been vetted and approved for sensitive or confidential work.']
  is_preferred_vendor boolean [note: 'Indicates whether the contractor is designated as a preferred vendor for procurement.']
  kyc_verification_date date [note: 'Date when the most recent KYC verification was completed.']
  kyc_verification_status varchar [note: 'Status of Know Your Customer verification for anti-money laundering compliance.']
  legal_entity_name varchar [note: 'Official corporate or business entity name as registered with authorities.']
  modified_timestamp timestamp [note: 'Timestamp when the contractor record was last modified.']
  notes varchar [note: 'Free-text notes or comments about the contractor for internal reference.']
  payment_currency varchar [note: 'ISO 4217 three-letter currency code for contractor payments.']
  payment_terms_days varchar [note: 'Standard payment terms in days from invoice date for contractor payments.']
  postal_code varchar [note: 'Postal or ZIP code of the contractors registered address.']
  primary_email varchar [note: 'Primary email address for contractor communications and notifications.']
  primary_phone varchar [note: 'Primary contact phone number for the contractor.']
  registration_country varchar [note: 'ISO 3166-1 alpha-3 country code where the contractor is legally registered.']
  registration_number varchar [note: 'Official business or company registration number issued by incorporation authority.']
  security_clearance_level varchar [note: 'Level of security clearance held by the contractor for accessing sensitive information.']
  service_category varchar [note: 'Primary category of services provided by the contractor (e.g., consulting, technology, legal).']
  specialization varchar [note: 'Specific area of expertise or specialization within the contractors service category.']
  state_province varchar [note: 'State, province, or administrative region of the contractors address.']
  tax_identification_number varchar [note: 'Government-issued tax identification number for the contractor.']
  tax_jurisdiction_country varchar [note: 'ISO 3166-1 alpha-3 country code of the contractors primary tax jurisdiction.']
  trading_name varchar [note: 'Business trading name or doing-business-as (DBA) name if different from legal name.']

  Note: 'Master reference table for contractor. Referenced by contractor_id.'
}

Table shared.department {
  department_id varchar [pk, note: 'Primary key for department']
  legal_entity_id varchar [note: 'Reference to the legal entity under which this department operates for regulatory and reporting purposes.']
  parent_department_id varchar [note: 'Reference to the parent department in the organizational hierarchy. Null for top-level departments.']
  annual_operating_budget decimal(18,2) [note: 'Total annual operating budget allocated to the department in the base reporting currency.']
  asset_class_focus varchar [note: 'Primary asset class focus for investment-related departments. Null for non-investment departments.']
  budget_currency_code varchar [note: 'ISO 4217 three-letter currency code for the department\'s budget denomination.']
  cost_center_code varchar [note: 'Financial cost center code assigned to the department for budget allocation and expense tracking.']
  created_timestamp timestamp [note: 'Timestamp when the department record was first created in the system.']
  department_code varchar [note: 'Short alphanumeric code uniquely identifying the department for internal reference and system integration.']
  department_description varchar [note: 'Detailed description of the department\'s purpose, responsibilities, and scope within the organization.']
  department_name varchar [note: 'Official name of the department as recognized within the organization.']
  department_status varchar [note: 'Current operational status of the department indicating whether it is actively functioning.']
  department_type varchar [note: 'Classification of the department by functional area within the institutional asset management structure.']
  dissolution_date date [note: 'Date when the department was dissolved or merged. Null if the department is still active.']
  effective_from_date date [note: 'Date from which the current department configuration became effective.']
  effective_to_date date [note: 'Date until which the current department configuration is effective. Null for currently active configurations.']
  establishment_date date [note: 'Date when the department was officially established or created within the organization.']
  external_reporting_code varchar [note: 'Code used for external regulatory or statutory reporting purposes to identify the department.']
  functional_area varchar [note: 'Primary functional area the department belongs to within the pension fund organization. [ENUM-REF-CANDIDATE: investments|operations|risk|compliance|finance|technology|hr|legal|audit|strategy — promote to reference product]']
  gl_account_segment varchar [note: 'General ledger account segment code used for financial reporting and journal entry allocation.']
  head_employee_id varchar [note: 'Reference to the employee who serves as the head or director of the department.']
  headcount_budget varchar [note: 'Approved number of full-time equivalent positions budgeted for the department.']
  hierarchy_level varchar [note: 'Numeric level in the organizational hierarchy where 1 represents the top-level department.']
  hierarchy_path varchar [note: 'Full path from root to this department in the organizational tree, typically slash-delimited.']
  is_active boolean [note: 'Indicates whether the department is currently active and operational.']
  is_investment_team boolean [note: 'Indicates whether the department is directly involved in investment decision-making activities.']
  is_regulated boolean [note: 'Indicates whether the department is subject to specific regulatory oversight or licensing requirements.']
  is_revenue_generating boolean [note: 'Indicates whether the department directly contributes to revenue generation or investment returns.']
  location_code varchar [note: 'Reference to the primary physical location or office where the department is headquartered.']
  modified_timestamp timestamp [note: 'Timestamp when the department record was last modified.']
  profit_center_code varchar [note: 'Financial profit center code for departments that generate revenue or manage investment returns.']
  regulatory_jurisdiction varchar [note: 'Primary regulatory jurisdiction governing the department\'s activities if subject to regulation.']
  sort_order varchar [note: 'Numeric value determining the display order of the department in reports and user interfaces.']

  Note: 'Master reference table for department. Referenced by department_id.'
}

Table shared.loan_servicer {
  loan_servicer_id varchar [pk, note: 'Primary key for loan_servicer']
  asset_class_specialization varchar [note: 'Primary asset classes the servicer specializes in (e.g., residential mortgage, commercial mortgage, consumer loans, CLO).']
  contract_effective_date date [note: 'Date when the current servicing agreement with this servicer became effective.']
  contract_termination_date date [note: 'Date when the current servicing agreement is scheduled to terminate or was terminated.']
  current_portfolio_upb_usd decimal(18,2) [note: 'Total unpaid principal balance of loans currently being serviced, expressed in USD.']
  esg_rating varchar [note: 'ESG rating assigned to the servicer reflecting environmental, social, and governance practices.']
  esg_rating_provider varchar [note: 'Name of the organization that provided the ESG rating (e.g., MSCI, Sustainalytics, ISS).']
  headquarters_address varchar [note: 'Full street address of the loan servicer\'s corporate headquarters or principal place of business.']
  headquarters_city varchar [note: 'City where the loan servicer\'s corporate headquarters is located.']
  headquarters_country_code varchar [note: 'ISO 3166-1 alpha-3 country code for the loan servicer\'s headquarters location.']
  is_approved_servicer boolean [note: 'Indicates whether the servicer has been approved through the fund\'s due diligence and counterparty approval process.']
  is_fha_approved boolean [note: 'Indicates whether the servicer is approved by FHA to service government-insured mortgage loans.']
  is_gse_approved boolean [note: 'Indicates whether the servicer is approved by GSEs such as Fannie Mae or Freddie Mac for agency loan servicing.']
  jurisdiction_country_code varchar [note: 'ISO 3166-1 alpha-3 country code indicating the primary regulatory jurisdiction of the loan servicer.']
  last_due_diligence_date date [note: 'Date when the most recent operational due diligence review of the servicer was completed.']
  legal_name varchar [note: 'Official registered legal name of the loan servicing organization as filed with regulatory authorities.']
  lei_code varchar [note: '20-character alphanumeric Legal Entity Identifier assigned by GLEIF for global counterparty identification.']
  license_expiry_date date [note: 'Date when the loan servicer\'s operating license expires and requires renewal.']
  license_number varchar [note: 'Regulatory license number authorizing the entity to perform loan servicing activities in applicable jurisdictions.']
  loan_count varchar [note: 'Total number of individual loans currently being serviced by this servicer.']
  next_due_diligence_date date [note: 'Scheduled date for the next operational due diligence review of the servicer.']
  notes varchar [note: 'Free-text field for additional notes, observations, or comments about the loan servicer.']
  onboarding_date date [note: 'Date when the loan servicer was initially onboarded and approved as an authorized servicing counterparty.']
  parent_company_name varchar [note: 'Name of the parent company or ultimate beneficial owner if the servicer is a subsidiary.']
  primary_contact_email varchar [note: 'Email address of the primary business contact for operational communications and notifications.']
  primary_contact_name varchar [note: 'Name of the primary business contact person at the loan servicer for relationship management purposes.']
  primary_contact_phone varchar [note: 'Phone number of the primary business contact for urgent communications and escalations.']
  record_created_timestamp timestamp [note: 'Timestamp when this loan servicer record was first created in the system.']
  record_updated_timestamp timestamp [note: 'Timestamp when this loan servicer record was last modified or updated.']
  registration_number varchar [note: 'Official corporate registration or incorporation number assigned by the jurisdiction of incorporation.']
  regulatory_rating varchar [note: 'Rating assigned by regulatory bodies or rating agencies reflecting the servicer\'s operational and financial soundness.']
  servicer_code varchar [note: 'Unique alphanumeric business code assigned to the loan servicer for external identification and reporting purposes.']
  servicer_rating_agency varchar [note: 'Name of the rating agency that assigned the servicer rating (e.g., S&P, Moody\'s, Fitch).']
  servicer_status varchar [note: 'Current operational status of the loan servicer indicating their ability to perform servicing activities.']
  servicer_type varchar [note: 'Classification of the servicer role in the loan servicing hierarchy (primary, master, sub-servicer, special servicer, backup, interim).']
  servicing_capacity_usd decimal(18,2) [note: 'Maximum unpaid principal balance in USD that the servicer can effectively manage based on operational capacity.']
  servicing_fee_rate_bps decimal(8,4) [note: 'Standard servicing fee rate charged by the servicer expressed in basis points of outstanding principal balance.']
  soc_report_date date [note: 'Date of the most recent SOC report issued for the servicer\'s internal controls.']
  soc_report_type varchar [note: 'Type of SOC report the servicer maintains for internal control attestation (SOC1, SOC2, SOC3, or none).']
  special_servicing_fee_rate_bps decimal(8,4) [note: 'Fee rate charged for special servicing activities on distressed or non-performing loans, in basis points.']
  tax_identification_number varchar [note: 'Government-issued tax identification number for the loan servicer entity used for regulatory and tax reporting.']
  trading_name varchar [note: 'Commercial or trading name under which the loan servicer conducts business, may differ from legal name.']
  website_url varchar [note: 'Official website URL of the loan servicer for reference and verification purposes.']

  Note: 'Master reference table for loan_servicer. Referenced by servicer_id.'
}

