    rdfs:label 'Return Volatility Percent' ;
    rdfs:comment 'Add column return_volatility_percent (annualized standard deviation of the portfolios period returns, same unit as twr_net) to performance.portfolio_return. performance.portfolio_return: add return_volatility_percent (annualized standard de' ;
    rdfs:domain ind:PortfolioReturn ;
    rdf:type owl:DatatypeProperty ;
