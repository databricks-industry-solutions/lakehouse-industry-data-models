    rdfs:label 'Annualized Return Percent' ;
    rdfs:comment 'On performance.portfolio_return add annualized_return_percent, the annualized return for the period in the same unit as drawdown_percent. annualized_return_percent (annualized return for the period, same unit as drawdown_percent)' ;
    rdfs:domain ind:PortfolioReturn ;
    rdf:type owl:DatatypeProperty ;
