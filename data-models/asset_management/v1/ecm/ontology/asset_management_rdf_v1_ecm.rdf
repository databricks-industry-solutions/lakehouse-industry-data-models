ind:sourceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Source Document Reference' ;
    rdfs:comment 'External document or file reference (e.g., PDF, spreadsheet) that supports the measurement.' ;
    rdfs:domain ind:GainLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationPeriod rdf:type rdf:Property ;
    rdfs:label 'Valuation Period' ;
    rdfs:comment 'Identifier for the valuation period (e.g., FY2024, Q1-2025).' ;
    rdfs:domain ind:GainLoss ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deRiskingTriggerId rdf:type rdf:Property ;
    rdfs:label 'De Risking Trigger Id' ;
    rdfs:comment 'System-generated unique identifier for the de-risking trigger record.' ;
    rdfs:domain ind:Actuarial ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DeRiskingTrigger .

ind:applicableLiabilityProjectionId rdf:type rdf:Property ;
    rdfs:label 'Applicable Liability Projection Id' ;
    rdfs:comment 'Identifier of the liability projection scenario linked to the trigger.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiabilityProjection .

ind:applicablePortfolioId rdf:type rdf:Property ;
    rdfs:label 'Applicable Portfolio Id' ;
    rdfs:comment 'Identifier of the investment portfolio to which the trigger applies.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Portfolio .

ind:comparisonOperator rdf:type rdf:Property ;
    rdfs:label 'Comparison Operator' ;
    rdfs:comment 'Logical operator defining how the measured value is compared to the threshold.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deRiskingTriggerStatus rdf:type rdf:Property ;
    rdfs:label 'De Risking Trigger Status' ;
    rdfs:comment 'Current operational status of the trigger.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deRiskingTriggerDescription rdf:type rdf:Property ;
    rdfs:label 'De Risking Trigger Description' ;
    rdfs:comment 'Free-form description of the trigger logic and business rationale.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerCode rdf:type rdf:Property ;
    rdfs:label 'Trigger Code' ;
    rdfs:comment 'Short alphanumeric code used to reference the trigger in external systems and reports.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerName rdf:type rdf:Property ;
    rdfs:label 'Trigger Name' ;
    rdfs:comment 'Human-readable name describing the purpose of the trigger.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerPriority rdf:type rdf:Property ;
    rdfs:label 'Trigger Priority' ;
    rdfs:comment 'Numeric priority determining evaluation order when multiple triggers are active.' ;
    rdfs:domain ind:DeRiskingTrigger ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deRiskingEventId rdf:type rdf:Property ;
    rdfs:label 'De Risking Event Id' ;
    rdfs:comment 'Unique surrogate key for each de-risking event record.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionMandated rdf:type rdf:Property ;
    rdfs:label 'Action Mandated' ;
    rdfs:comment 'Prescribed portfolio action required to address the breach.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTakenDate rdf:type rdf:Property ;
    rdfs:label 'Action Taken Date' ;
    rdfs:comment 'Date on which the mandated action was executed.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deRiskingEventStatus rdf:type rdf:Property ;
    rdfs:label 'De Risking Event Status' ;
    rdfs:comment 'Current lifecycle status of the event.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundedRatioAtBreach rdf:type rdf:Property ;
    rdfs:label 'Funded Ratio At Breach' ;
    rdfs:comment 'Funded ratio (as a decimal) measured at the moment of breach.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioAfter rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio After' ;
    rdfs:comment 'Proportion of portfolio hedged after the de-risking action.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioBefore rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Before' ;
    rdfs:comment 'Proportion of portfolio hedged before the de-risking action.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:triggerThreshold rdf:type rdf:Property ;
    rdfs:label 'Trigger Threshold' ;
    rdfs:comment 'The threshold value for the trigger that was breached, expressed as a decimal.' ;
    rdfs:domain ind:DeRiskingEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationPolicyDescription rdf:type rdf:Property ;
    rdfs:label 'Indexation Policy Description' ;
    rdfs:comment 'Detailed narrative describing the purpose and mechanics of the policy.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorRate rdf:type rdf:Property ;
    rdfs:label 'Floor Rate' ;
    rdfs:comment 'Minimum allowable indexation percentage; null if no floor.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationFrequency rdf:type rdf:Property ;
    rdfs:label 'Indexation Frequency' ;
    rdfs:comment 'How often the indexation adjustment is applied.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexationLagMonths rdf:type rdf:Property ;
    rdfs:label 'Indexation Lag Months' ;
    rdfs:comment 'Number of months between index publication and its application to benefits.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indexationMethod rdf:type rdf:Property ;
    rdfs:label 'Indexation Method' ;
    rdfs:comment 'Underlying index or methodology used for the adjustment.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexationPolicyStatus rdf:type rdf:Property ;
    rdfs:label 'Indexation Policy Status' ;
    rdfs:comment 'Current lifecycle status of the policy.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationIndexCode rdf:type rdf:Property ;
    rdfs:label 'Inflation Index Code' ;
    rdfs:comment 'Standard code of the inflation index (e.g., CPI_CA).' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maxAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Max Adjustment Amount' ;
    rdfs:comment 'Absolute ceiling on the monetary adjustment per period; null if not applicable.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Min Adjustment Amount' ;
    rdfs:comment 'Absolute floor on the monetary adjustment per period; null if not applicable.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyCode rdf:type rdf:Property ;
    rdfs:label 'Policy Code' ;
    rdfs:comment 'Business code that uniquely identifies the policy across systems.' ;
    rdfs:domain ind:IndexationPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Plan Amendment Id' ;
    rdfs:comment 'Unique surrogate key for each plan amendment record.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentCategory rdf:type rdf:Property ;
    rdfs:label 'Amendment Category' ;
    rdfs:comment 'High-level classification of the amendment purpose.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentCode rdf:type rdf:Property ;
    rdfs:label 'Amendment Code' ;
    rdfs:comment 'External reference code assigned to the amendment for tracking and reporting.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benefitChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Benefit Change Amount' ;
    rdfs:comment 'Monetary value of any increase or decrease to benefit payouts.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contributionRateChange rdf:type rdf:Property ;
    rdfs:label 'Contribution Rate Change' ;
    rdfs:comment 'Change in the contribution rate expressed in percentage points.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planAmendmentDescription rdf:type rdf:Property ;
    rdfs:label 'Plan Amendment Description' ;
    rdfs:comment 'Narrative description of the amendment purpose and details.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibilityCriteriaChange rdf:type rdf:Property ;
    rdfs:label 'Eligibility Criteria Change' ;
    rdfs:comment 'Text describing any modifications to eligibility rules.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ldiImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Ldi Impact Flag' ;
    rdfs:comment 'True if the amendment materially changes LDI strategy assumptions.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stakeholderImpact rdf:type rdf:Property ;
    rdfs:label 'Stakeholder Impact' ;
    rdfs:comment 'Description of how the amendment affects plan participants and sponsors.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vestingScheduleChange rdf:type rdf:Property ;
    rdfs:label 'Vesting Schedule Change' ;
    rdfs:comment 'Details of any changes to vesting schedules for accrued benefits.' ;
    rdfs:domain ind:PlanAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actuarialReportId rdf:type rdf:Property ;
    rdfs:label 'Actuarial Report Id' ;
    rdfs:comment 'Unique system-generated identifier for the actuarial report.' ;
    rdfs:domain ind:ActuarialReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:horizonYears rdf:type rdf:Property ;
    rdfs:label 'Horizon Years' ;
    rdfs:comment 'Number of years into the future the actuarial projection extends.' ;
    rdfs:domain ind:ActuarialReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reportName rdf:type rdf:Property ;
    rdfs:label 'Report Name' ;
    rdfs:comment 'Descriptive name of the actuarial report used for display and search.' ;
    rdfs:domain ind:ActuarialReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilitySegmentId rdf:type rdf:Property ;
    rdfs:label 'Liability Segment Id' ;
    rdfs:comment 'Unique system-generated identifier for the liability segment record.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundingGapAmount rdf:type rdf:Property ;
    rdfs:label 'Funding Gap Amount' ;
    rdfs:comment 'Monetary shortfall between assets and liabilities for the segment.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingGapPercentage rdf:type rdf:Property ;
    rdfs:label 'Funding Gap Percentage' ;
    rdfs:comment 'Funding gap expressed as a percentage of total liability.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDefaultSegment rdf:type rdf:Property ;
    rdfs:label 'Is Default Segment' ;
    rdfs:comment 'Indicates whether this segment is the default for its contributor pool.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liabilityAmountGav rdf:type rdf:Property ;
    rdfs:label 'Liability Amount Gav' ;
    rdfs:comment 'Gross asset value associated with the segment for asset-liability matching.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityAmountGavCurrency rdf:type rdf:Property ;
    rdfs:label 'Liability Amount Gav Currency' ;
    rdfs:comment 'ISO currency code for the gross asset value amount.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityAmountNav rdf:type rdf:Property ;
    rdfs:label 'Liability Amount Nav' ;
    rdfs:comment 'Net asset value associated with the segment for asset-liability matching.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityAmountNavCurrency rdf:type rdf:Property ;
    rdfs:label 'Liability Amount Nav Currency' ;
    rdfs:comment 'ISO currency code for the net asset value amount.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityMeasurementCurrency rdf:type rdf:Property ;
    rdfs:label 'Liability Measurement Currency' ;
    rdfs:comment 'Currency in which liability amounts are measured for this segment.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilitySegmentStatus rdf:type rdf:Property ;
    rdfs:label 'Liability Segment Status' ;
    rdfs:comment 'Current lifecycle status of the liability segment.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentClassification rdf:type rdf:Property ;
    rdfs:label 'Segment Classification' ;
    rdfs:comment 'Higher-level classification grouping (e.g., core, ancillary).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCountry rdf:type rdf:Property ;
    rdfs:label 'Segment Country' ;
    rdfs:comment 'Three-letter ISO country code where the segment\'s liabilities are primarily located.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentCreationDate rdf:type rdf:Property ;
    rdfs:label 'Segment Creation Date' ;
    rdfs:comment 'Date the segment record was initially created (duplicate of effective_date for audit purposes).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:segmentCurrencyExposure rdf:type rdf:Property ;
    rdfs:label 'Segment Currency Exposure' ;
    rdfs:comment 'Comma-separated list of currencies in which the segment has exposure.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentDescription rdf:type rdf:Property ;
    rdfs:label 'Segment Description' ;
    rdfs:comment 'Detailed description of the segment\'s purpose and composition.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Segment Last Updated Date' ;
    rdfs:comment 'Date of the most recent update to the segment record (duplicate of modified_timestamp for audit purposes).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:segmentLiabilitySubtype rdf:type rdf:Property ;
    rdfs:label 'Segment Liability Subtype' ;
    rdfs:comment 'Specific subtype of liability within the broader type.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentLiabilityType rdf:type rdf:Property ;
    rdfs:label 'Segment Liability Type' ;
    rdfs:comment 'Type of pension liability (defined benefit or defined contribution).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentOwner rdf:type rdf:Property ;
    rdfs:label 'Segment Owner' ;
    rdfs:comment 'Internal team or business unit responsible for the segment.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentRegion rdf:type rdf:Property ;
    rdfs:label 'Segment Region' ;
    rdfs:comment 'Geographic region code (e.g., NA, EU, APAC) for the segment.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Segment Source System' ;
    rdfs:comment 'Originating system that supplied the segment data (e.g., SimCorp, Aladdin).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:segmentStatusReason rdf:type rdf:Property ;
    rdfs:label 'Segment Status Reason' ;
    rdfs:comment 'Explanation for the current status of the segment (e.g., reason for archiving).' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Total Liability Amount' ;
    rdfs:comment 'Aggregated liability amount for the segment expressed in the reporting currency.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAverageDurationYears rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Duration Years' ;
    rdfs:comment 'Average duration of the segment weighted by liability cash-flows.' ;
    rdfs:domain ind:LiabilitySegment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseFeeRate rdf:type rdf:Property ;
    rdfs:label 'Base Fee Rate' ;
    rdfs:comment 'The primary management fee rate expressed as a decimal percentage (e.g., 0.015000 for 1.5% per annum) applicable to the fee basis.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeArrangementCode rdf:type rdf:Property ;
    rdfs:label 'Fee Arrangement Code' ;
    rdfs:comment 'Unique business identifier for the management fee arrangement, typically referenced in Limited Partnership Agreement (LPA) or Investment Management Agreement (IMA).' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeArrangementName rdf:type rdf:Property ;
    rdfs:label 'Fee Arrangement Name' ;
    rdfs:comment 'Descriptive name of the management fee arrangement for business user identification and reporting purposes.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeArrangementStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Arrangement Status' ;
    rdfs:comment 'Current lifecycle status of the management fee arrangement, indicating whether it is actively in force, suspended, terminated, or under review.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeOffsetProvision rdf:type rdf:Property ;
    rdfs:label 'Fee Offset Provision' ;
    rdfs:comment 'Defines whether and how transaction fees, monitoring fees, or other ancillary fees paid by portfolio companies are offset against the management fee payable to the General Partner (GP).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeRateUnit rdf:type rdf:Property ;
    rdfs:label 'Fee Rate Unit' ;
    rdfs:comment 'The unit of measure and time period for the fee rate, clarifying whether the rate is annualized, quarterly, monthly, or a one-time flat amount.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeTransparencyDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Fee Transparency Disclosure Flag' ;
    rdfs:comment 'Indicates whether this management fee arrangement is subject to enhanced fee transparency disclosure requirements under regulatory frameworks such as Sustainable Finance Disclosure Regulation (SFDR) or MiFID II.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeWaiverConditions rdf:type rdf:Property ;
    rdfs:label 'Fee Waiver Conditions' ;
    rdfs:comment 'Textual description of specific conditions under which management fees may be waived, reduced, or deferred, such as fund underperformance or capital call delays.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalCostCenterCode rdf:type rdf:Property ;
    rdfs:label 'Internal Cost Center Code' ;
    rdfs:comment 'The internal General Ledger (GL) cost center or account code to which management fee expenses are allocated for financial accounting and budgeting purposes.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentPeriodFlag rdf:type rdf:Property ;
    rdfs:label 'Investment Period Flag' ;
    rdfs:comment 'Indicates whether the fund is currently in its investment period, during which management fees are typically calculated on committed capital rather than invested capital.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpaReferenceSection rdf:type rdf:Property ;
    rdfs:label 'Lpa Reference Section' ;
    rdfs:comment 'The specific section, article, or clause reference within the Limited Partnership Agreement (LPA) or Investment Management Agreement (IMA) that governs this management fee arrangement.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Fee Amount' ;
    rdfs:comment 'The contractual maximum management fee amount per period, capping the fee regardless of asset value growth.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Fee Amount' ;
    rdfs:comment 'The contractual minimum management fee amount per period, ensuring the General Partner (GP) receives at least this amount regardless of asset value fluctuations.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mostFavoredNationClause rdf:type rdf:Property ;
    rdfs:label 'Most Favored Nation Clause' ;
    rdfs:comment 'Indicates whether the fee arrangement includes a Most Favored Nation (MFN) clause ensuring this Limited Partner (LP) receives fee terms no less favorable than those granted to other LPs in the same fund.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:offsetPercentage rdf:type rdf:Property ;
    rdfs:label 'Offset Percentage' ;
    rdfs:comment 'The percentage of ancillary fees (transaction, monitoring, advisory) that must be rebated or offset against the management fee, typically ranging from 50% to 100%.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceFeeLinkageFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Linkage Flag' ;
    rdfs:comment 'Indicates whether the management fee arrangement is linked to or adjusted based on investment performance relative to benchmarks or absolute return targets.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postInvestmentPeriodBasis rdf:type rdf:Property ;
    rdfs:label 'Post Investment Period Basis' ;
    rdfs:comment 'The fee calculation basis that applies after the investment period ends, often shifting from committed capital to invested capital or Net Asset Value (NAV).' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postInvestmentPeriodRate rdf:type rdf:Property ;
    rdfs:label 'Post Investment Period Rate' ;
    rdfs:comment 'The reduced management fee rate that applies after the investment period concludes, typically lower than the base rate during the investment period.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryReportingCategory rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reporting Category' ;
    rdfs:comment 'Classification of the management fee for regulatory cost disclosure and reporting purposes under frameworks such as MiFID II and SFDR.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationNoticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Period Days' ;
    rdfs:comment 'The number of days advance notice required to terminate or modify the management fee arrangement, as specified in the mandate or Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tieredScheduleFlag rdf:type rdf:Property ;
    rdfs:label 'Tiered Schedule Flag' ;
    rdfs:comment 'Indicates whether the management fee arrangement uses a tiered rate schedule with different rates applying to different asset value thresholds.' ;
    rdfs:domain ind:ManagementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:accruedCarryAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Carry Amount' ;
    rdfs:comment 'Total amount of carried interest accrued to date under this arrangement, in the arrangement currency.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:arrangementName rdf:type rdf:Property ;
    rdfs:label 'Arrangement Name' ;
    rdfs:comment 'Business name or label for this carried interest arrangement for identification and reporting purposes.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementType rdf:type rdf:Property ;
    rdfs:label 'Arrangement Type' ;
    rdfs:comment 'Classification of the carried interest structure: whole fund waterfall, deal-by-deal, hybrid, tiered, European style, or American style.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationBasis rdf:type rdf:Property ;
    rdfs:label 'Calculation Basis' ;
    rdfs:comment 'Basis for calculating carried interest: realized gains only, unrealized gains included, total value, IRR-based, or MOIC-based.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carriedInterestStatus rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Status' ;
    rdfs:comment 'Current lifecycle status of the carried interest arrangement: active, suspended, terminated, pending approval, or under review.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catchupCap rdf:type rdf:Property ;
    rdfs:label 'Catchup Cap' ;
    rdfs:comment 'Maximum percentage of total profits that can be allocated during the catch-up phase, expressed as a decimal.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchupRate rdf:type rdf:Property ;
    rdfs:label 'Catchup Rate' ;
    rdfs:comment 'Percentage of profits allocated to the GP after the hurdle is met and before the final carry split, allowing GP to catch up to their target carry percentage.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackCapAmount rdf:type rdf:Property ;
    rdfs:label 'Clawback Cap Amount' ;
    rdfs:comment 'Maximum amount in base currency that can be clawed back from the GP under the clawback provision.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackReserveAmount rdf:type rdf:Property ;
    rdfs:label 'Clawback Reserve Amount' ;
    rdfs:comment 'Amount held in reserve to cover potential clawback obligations, in the arrangement currency.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackType rdf:type rdf:Property ;
    rdfs:label 'Clawback Type' ;
    rdfs:comment 'Type of clawback provision: full clawback of all excess carry, partial clawback with limitations, or none.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributedCarryAmount rdf:type rdf:Property ;
    rdfs:label 'Distributed Carry Amount' ;
    rdfs:comment 'Total amount of carried interest distributed to the GP to date under this arrangement, in the arrangement currency.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionTiming rdf:type rdf:Property ;
    rdfs:label 'Distribution Timing' ;
    rdfs:comment 'Timing of carried interest distributions to the GP: on asset realization, on LP distributions, at fund termination, quarterly, or annual.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeOffsetPercentage rdf:type rdf:Property ;
    rdfs:label 'Fee Offset Percentage' ;
    rdfs:comment 'Percentage of management fees that are offset against carried interest, expressed as a decimal (e.g., 1.00 for 100% offset).' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingCarryAmount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Carry Amount' ;
    rdfs:comment 'Amount of carried interest accrued but not yet distributed to the GP, in the arrangement currency.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceThresholdMoic rdf:type rdf:Property ;
    rdfs:label 'Performance Threshold Moic' ;
    rdfs:comment 'Minimum MOIC threshold that must be achieved for carried interest to be payable, expressed as a multiple (e.g., 1.5 for 1.5x).' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnCompounding rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Compounding' ;
    rdfs:comment 'Method for compounding the preferred return (hurdle rate): simple interest, compound annual, compound quarterly, or compound monthly.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeeTreatment rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Treatment' ;
    rdfs:comment 'Treatment of transaction fees earned by the GP: retained by GP, shared with LPs, offset against carry, or offset against management fees.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterfallTierCount rdf:type rdf:Property ;
    rdfs:label 'Waterfall Tier Count' ;
    rdfs:comment 'Number of tiers in the carried interest waterfall structure for tiered arrangements.' ;
    rdfs:domain ind:CarriedInterest ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carryPercentage rdf:type rdf:Property ;
    rdfs:label 'Carry Percentage' ;
    rdfs:comment 'Percentage of profits allocated to the General Partner (GP) in this tier after hurdle conditions are met, expressed as a decimal (e.g., 0.20 for 20% carry).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpPercentage rdf:type rdf:Property ;
    rdfs:label 'Catch Up Percentage' ;
    rdfs:comment 'Percentage of distributions allocated to the GP during the catch-up tier to bring GP participation to the target carry level, expressed as a decimal (e.g., 1.00 for 100% catch-up).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionPriority rdf:type rdf:Property ;
    rdfs:label 'Distribution Priority' ;
    rdfs:comment 'Priority mechanism for allocating distributions among investors within a tier: pro-rata by commitment, pari passu (equal footing), sequential by seniority, or custom allocation.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionSplitGp rdf:type rdf:Property ;
    rdfs:label 'Distribution Split Gp' ;
    rdfs:comment 'Proportion of distributions allocated to the General Partner in this tier, expressed as a decimal (e.g., 0.20 for 20% to GP).' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionSplitLp rdf:type rdf:Property ;
    rdfs:label 'Distribution Split Lp' ;
    rdfs:comment 'Proportion of distributions allocated to Limited Partners in this tier, expressed as a decimal (e.g., 0.80 for 80% to LPs).' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lookbackPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Years' ;
    rdfs:comment 'Number of years over which clawback calculations are performed, determining the historical window for assessing GP carry obligations.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managementFeeOffsetFlag rdf:type rdf:Property ;
    rdfs:label 'Management Fee Offset Flag' ;
    rdfs:comment 'Indicates whether management fees paid to the GP are offset against carried interest distributions in this waterfall tier.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waterfallName rdf:type rdf:Property ;
    rdfs:label 'Waterfall Name' ;
    rdfs:comment 'Business-friendly name or label for this waterfall structure.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredReturnAccrualMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Accrual Method' ;
    rdfs:comment 'Method by which preferred return accrues to LPs: simple interest, compound interest, or Internal Rate of Return (IRR) based calculation.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierCapAmount rdf:type rdf:Property ;
    rdfs:label 'Tier Cap Amount' ;
    rdfs:comment 'Maximum monetary amount that can be distributed within this tier before overflow proceeds to the next tier.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierName rdf:type rdf:Property ;
    rdfs:label 'Tier Name' ;
    rdfs:comment 'Descriptive label for this tier, such as Return of Capital, Preferred Return, Catch-Up, or Carried Interest.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierSequence rdf:type rdf:Property ;
    rdfs:label 'Tier Sequence' ;
    rdfs:comment 'Ordinal position of this tier within the waterfall structure, determining the order in which distributions are allocated.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier Threshold Amount' ;
    rdfs:comment 'Monetary threshold that must be reached before distributions flow to the next tier in the waterfall sequence.' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionFeeRebatePercentage rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Rebate Percentage' ;
    rdfs:comment 'Percentage of transaction fees earned by the GP that must be rebated to the fund, reducing GP economics, expressed as a decimal (e.g., 0.80 for 80% rebate).' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterfallStatus rdf:type rdf:Property ;
    rdfs:label 'Waterfall Status' ;
    rdfs:comment 'Current lifecycle status of the waterfall structure: active (in use), superseded (replaced by amendment), terminated (fund closed), or draft (pending approval).' ;
    rdfs:domain ind:Waterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterfallTierId rdf:type rdf:Property ;
    rdfs:label 'Waterfall Tier Id' ;
    rdfs:comment 'Unique identifier for the waterfall tier within a distribution waterfall structure.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waterfallStructureWaterfallId rdf:type rdf:Property ;
    rdfs:label 'Waterfall Structure Waterfall Id' ;
    rdfs:comment 'Reference to the parent distribution waterfall structure to which this tier belongs.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Waterfall .

ind:clawbackApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Applicable Flag' ;
    rdfs:comment 'Indicates whether clawback provisions apply to distributions made in this tier, requiring GP to return excess carried interest.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clawbackPercentage rdf:type rdf:Property ;
    rdfs:label 'Clawback Percentage' ;
    rdfs:comment 'Percentage of distributions subject to clawback if final returns fall below agreed thresholds.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDistributionCapAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Distribution Cap Amount' ;
    rdfs:comment 'Maximum cumulative distribution amount for this tier before moving to the next tier in the waterfall.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionReinvestmentFlag rdf:type rdf:Property ;
    rdfs:label 'Distribution Reinvestment Flag' ;
    rdfs:comment 'Indicates whether distributions from this tier are subject to mandatory or optional reinvestment into the fund.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowHoldbackPercentage rdf:type rdf:Property ;
    rdfs:label 'Escrow Holdback Percentage' ;
    rdfs:comment 'Percentage of GP distributions held in escrow to cover potential clawback obligations at fund termination.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpAllocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Gp Allocation Percentage' ;
    rdfs:comment 'Percentage of distributions allocated to General Partner within this tier, expressed as a decimal.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Percentage' ;
    rdfs:comment 'Preferred return threshold that must be achieved before this tier becomes active, expressed as an annualized percentage.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRateType rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Type' ;
    rdfs:comment 'Method by which the hurdle rate is calculated, such as simple return, compounded return, or Internal Rate of Return (IRR) based.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Lookback Provision Flag' ;
    rdfs:comment 'Indicates whether a lookback provision applies, requiring recalculation of distributions at fund termination to ensure LPs receive their full preferred return.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpAllocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Lp Allocation Percentage' ;
    rdfs:comment 'Percentage of distributions allocated to Limited Partners within this tier, expressed as a decimal.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnShortfallCarryforwardFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Shortfall Carryforward Flag' ;
    rdfs:comment 'Indicates whether any shortfall in preferred return from prior periods is carried forward and must be satisfied before moving to subsequent tiers.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tierAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Tier Amendment Date' ;
    rdfs:comment 'Date of the most recent amendment to this tier\'s terms, reflecting changes to allocation percentages, hurdle rates, or other provisions.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tierAmendmentReason rdf:type rdf:Property ;
    rdfs:label 'Tier Amendment Reason' ;
    rdfs:comment 'Business justification or regulatory reason for the most recent amendment to this tier.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDescription rdf:type rdf:Property ;
    rdfs:label 'Tier Description' ;
    rdfs:comment 'Detailed explanation of the tier\'s purpose, calculation methodology, and conditions for distribution.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierDistributionCapAmount rdf:type rdf:Property ;
    rdfs:label 'Tier Distribution Cap Amount' ;
    rdfs:comment 'Maximum distribution amount that can be allocated within this specific tier.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tierEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Tier Effective Date' ;
    rdfs:comment 'Date from which this tier becomes active and applicable for distribution calculations.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tierSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Tier Sequence Number' ;
    rdfs:comment 'Sequential ordering of this tier within the waterfall structure, determining distribution priority.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tierStatus rdf:type rdf:Property ;
    rdfs:label 'Tier Status' ;
    rdfs:comment 'Current lifecycle status of the waterfall tier within the distribution structure.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tierTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Tier Termination Date' ;
    rdfs:comment 'Date on which this tier ceases to be active, either due to fund liquidation or structural amendment.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:tierType rdf:type rdf:Property ;
    rdfs:label 'Tier Type' ;
    rdfs:comment 'Classification of the tier within the waterfall structure, defining its economic purpose and distribution logic.' ;
    rdfs:domain ind:WaterfallTier ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurdleRateId rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Id' ;
    rdfs:comment 'Unique identifier for the hurdle rate record. Primary key for this entity.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Benchmark Spread Bps' ;
    rdfs:comment 'Spread in basis points added to the benchmark index to determine the hurdle rate. Null if hurdle is absolute.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clawbackCapPercentage rdf:type rdf:Property ;
    rdfs:label 'Clawback Cap Percentage' ;
    rdfs:comment 'Maximum percentage of previously distributed carried interest subject to clawback. Null if no cap applies.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crystallizationEvent rdf:type rdf:Property ;
    rdfs:label 'Crystallization Event' ;
    rdfs:comment 'Description of the event or condition that triggers the crystallization and payment of carried interest (e.g., exit, distribution, fund liquidation).' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeCarryDistributedAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Carry Distributed Amount' ;
    rdfs:comment 'Total cumulative carried interest distributed to the General Partner under this hurdle rate arrangement, in the specified currency.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePreferredReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Preferred Return Amount' ;
    rdfs:comment 'Total cumulative preferred return amount owed to Limited Partners under this hurdle rate arrangement, in the specified currency.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escrowPercentage rdf:type rdf:Property ;
    rdfs:label 'Escrow Percentage' ;
    rdfs:comment 'Percentage of carried interest distributions held in escrow to cover potential clawback obligations. Null if no escrow applies.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleAchievedFlag rdf:type rdf:Property ;
    rdfs:label 'Hurdle Achieved Flag' ;
    rdfs:comment 'Indicates whether the hurdle rate has been achieved as of the last calculation date.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hurdleBasis rdf:type rdf:Property ;
    rdfs:label 'Hurdle Basis' ;
    rdfs:comment 'The capital base against which the hurdle rate is calculated (e.g., committed capital, invested capital, paid-in capital, or net asset value).' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurdleRateStatus rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Status' ;
    rdfs:comment 'Current lifecycle status of the hurdle rate arrangement.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurdleResetFrequency rdf:type rdf:Property ;
    rdfs:label 'Hurdle Reset Frequency' ;
    rdfs:comment 'Frequency at which the hurdle rate calculation resets or is re-evaluated.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hurdleRateName rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Name' ;
    rdfs:comment 'Business-friendly name or label for this hurdle rate arrangement.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceFeeType rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Type' ;
    rdfs:comment 'Classification of the performance-based fee structure associated with this hurdle rate.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredReturnCumulativeFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Cumulative Flag' ;
    rdfs:comment 'Indicates whether unpaid preferred returns accumulate and must be satisfied in future periods before carry is earned.' ;
    rdfs:domain ind:HurdleRate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clawbackProvisionId rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision Id' ;
    rdfs:comment 'Unique identifier for the clawback provision record within the carried interest arrangement.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carryEscrowId rdf:type rdf:Property ;
    rdfs:label 'Carry Escrow Id' ;
    rdfs:comment 'Reference to the segregated escrow account holding withheld carried interest distributions to satisfy potential clawback obligations.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CarryEscrow .

ind:carryPercent rdf:type rdf:Property ;
    rdfs:label 'Carry Percent' ;
    rdfs:comment 'General Partner (GP) carried interest percentage (typically 20 percent) of fund profits after hurdle and catch-up; basis for calculating maximum clawback obligation.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackCalculationMethod rdf:type rdf:Property ;
    rdfs:label 'Clawback Calculation Method' ;
    rdfs:comment 'Methodology used to compute clawback amount: Internal Rate of Return (IRR) based (comparing actual vs hurdle IRR), Multiple on Invested Capital (MOIC) based (comparing actual vs target multiple), Total Value to Paid-In (TVPI) based, hybrid (combination of' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clawbackCapPercent rdf:type rdf:Property ;
    rdfs:label 'Clawback Cap Percent' ;
    rdfs:comment 'Maximum clawback obligation expressed as percentage of cumulative carried interest distributions; protects General Partner (GP) from unlimited liability (e.g., 100 percent cap means GP never owes more than carry received).' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackProvisionStatus rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision Status' ;
    rdfs:comment 'Current lifecycle status of the clawback provision: active (in force), suspended (temporarily inactive), waived (Limited Partners (LPs) waived enforcement), triggered (clawback event occurred), settled (obligation fulfilled), or expired (provision term' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeGpDistributionsAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Gp Distributions Amount' ;
    rdfs:comment 'Total carried interest distributions (in fund base currency) paid to General Partner (GP) to date; basis for calculating maximum clawback exposure.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeLpDistributionsAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Lp Distributions Amount' ;
    rdfs:comment 'Total distributions (in fund base currency) paid to Limited Partners (LPs) to date; used in waterfall calculations to determine if hurdle rate has been met.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentClawbackLiabilityAmount rdf:type rdf:Property ;
    rdfs:label 'Current Clawback Liability Amount' ;
    rdfs:comment 'Current estimated clawback liability (in fund base currency) owed by General Partner (GP) to Limited Partners (LPs) based on most recent calculation; may be negative (no liability) or positive (amount owed).' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escrowBalanceAmount rdf:type rdf:Property ;
    rdfs:label 'Escrow Balance Amount' ;
    rdfs:comment 'Current balance (in fund base currency) held in escrow account available to satisfy clawback obligations; updated with each carried interest distribution and clawback settlement.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Fund Irr Percent' ;
    rdfs:comment 'Current fund-level Internal Rate of Return (IRR) expressed as annualized percentage; compared against hurdle rate to determine clawback trigger status.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundMoic rdf:type rdf:Property ;
    rdfs:label 'Fund Moic' ;
    rdfs:comment 'Current fund-level Multiple on Invested Capital (MOIC) ratio (total value divided by total invested capital); used in Multiple on Invested Capital (MOIC) based clawback calculations.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundTvpi rdf:type rdf:Property ;
    rdfs:label 'Fund Tvpi' ;
    rdfs:comment 'Current fund-level Total Value to Paid-In (TVPI) ratio (distributions plus residual Net Asset Value (NAV) divided by Paid-In Capital (PIC)); used in Total Value to Paid-In (TVPI) based clawback calculations.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpCatchUpPercent rdf:type rdf:Property ;
    rdfs:label 'Gp Catch Up Percent' ;
    rdfs:comment 'Percentage of distributions allocated to General Partner (GP) after hurdle is met and before final carried interest split, used in waterfall calculations to determine clawback exposure.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpaSectionReference rdf:type rdf:Property ;
    rdfs:label 'Lpa Section Reference' ;
    rdfs:comment 'Specific section, article, or clause reference in the Limited Partnership Agreement (LPA) document that defines this clawback provision (e.g., Article 7.3, Section 12.5).' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumClawbackAmount rdf:type rdf:Property ;
    rdfs:label 'Maximum Clawback Amount' ;
    rdfs:comment 'Maximum monetary amount (in fund base currency) that General Partner (GP) may be required to return to Limited Partners (LPs) under this provision; typically capped at total carried interest distributed to date.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:provisionName rdf:type rdf:Property ;
    rdfs:label 'Provision Name' ;
    rdfs:comment 'Business name or label for this clawback provision as referenced in fund documentation and Investment Committee (IC) materials.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:provisionType rdf:type rdf:Property ;
    rdfs:label 'Provision Type' ;
    rdfs:comment 'Classification of the clawback mechanism: full clawback (entire carry subject to true-up), partial clawback (limited to specific percentage), rolling clawback (calculated periodically), deal-by-deal clawback (per investment basis), aggregate clawback' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementDueDate rdf:type rdf:Property ;
    rdfs:label 'Settlement Due Date' ;
    rdfs:comment 'Date by which General Partner (GP) must remit clawback payment to Limited Partners (LPs) following trigger event; typically 30 to 90 days after trigger or fund liquidation.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:triggerCondition rdf:type rdf:Property ;
    rdfs:label 'Trigger Condition' ;
    rdfs:comment 'Detailed description of the condition(s) that activate the clawback obligation, such as final fund Internal Rate of Return (IRR) falling below hurdle rate, Total Value to Paid-In (TVPI) below threshold, or cumulative General Partner (GP) distributions' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEventDate rdf:type rdf:Property ;
    rdfs:label 'Trigger Event Date' ;
    rdfs:comment 'Date on which the clawback trigger condition was met and clawback obligation became enforceable; null if provision has not been triggered.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Approval Date' ;
    rdfs:comment 'Date on which Limited Partners (LPs) formally approved a waiver or modification of this clawback provision; null if no waiver has been granted.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverConditions rdf:type rdf:Property ;
    rdfs:label 'Waiver Conditions' ;
    rdfs:comment 'Conditions under which Limited Partners (LPs) may waive or modify clawback obligations, such as Limited Partner (LP) vote threshold, Investment Committee (IC) approval, or specific performance criteria.' ;
    rdfs:domain ind:ClawbackProvision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clawbackEventId rdf:type rdf:Property ;
    rdfs:label 'Clawback Event Id' ;
    rdfs:comment 'Unique identifier for the clawback event record.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditorVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Auditor Verification Date' ;
    rdfs:comment 'Date on which the external auditor completed verification of the clawback calculation.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditorVerifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Auditor Verified Flag' ;
    rdfs:comment 'Indicates whether the clawback calculation has been independently verified by the funds external auditor.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carriedInterestDistributedAmount rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Distributed Amount' ;
    rdfs:comment 'Total cumulative carried interest amount previously distributed to the General Partner prior to the clawback event.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterestEntitledAmount rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Entitled Amount' ;
    rdfs:comment 'Final carried interest amount to which the General Partner is entitled based on actual fund performance and waterfall calculations.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryRatePercent rdf:type rdf:Property ;
    rdfs:label 'Carry Rate Percent' ;
    rdfs:comment 'Percentage of profits above the hurdle rate to which the General Partner is entitled as carried interest, per the Limited Partnership Agreement.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackCapAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Cap Applied Flag' ;
    rdfs:comment 'Indicates whether the contractual clawback cap was applied to limit the clawback obligation in this event.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clawbackGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Clawback Gross Amount' ;
    rdfs:comment 'Gross clawback amount owed by the General Partner, calculated as the excess of distributed carried interest over entitled carried interest.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackNetAmount rdf:type rdf:Property ;
    rdfs:label 'Clawback Net Amount' ;
    rdfs:comment 'Net clawback amount owed after applying any contractual adjustments, tax gross-ups, or offsets per the Limited Partnership Agreement.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalCounselOpinionFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Opinion Flag' ;
    rdfs:comment 'Indicates whether legal counsel has provided an opinion on the enforceability and calculation of the clawback obligation.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpCapitalReturnedAmount rdf:type rdf:Property ;
    rdfs:label 'Lp Capital Returned Amount' ;
    rdfs:comment 'Total capital returned to Limited Partners at the time of clawback calculation, used to verify hurdle achievement and waterfall distribution.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpProfitDistributedAmount rdf:type rdf:Property ;
    rdfs:label 'Lp Profit Distributed Amount' ;
    rdfs:comment 'Total profit distributed to Limited Partners at the time of clawback calculation, used in carried interest waterfall reconciliation.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offsetAmount rdf:type rdf:Property ;
    rdfs:label 'Offset Amount' ;
    rdfs:comment 'Amount offset against the clawback obligation due to management fee rebates, expense reimbursements, or other contractual adjustments.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxGrossUpAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Gross Up Amount' ;
    rdfs:comment 'Additional amount added to the clawback obligation to account for tax liabilities incurred by the General Partner on previously distributed carried interest.' ;
    rdfs:domain ind:ClawbackEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accrualId rdf:type rdf:Property ;
    rdfs:label 'Accrual Id' ;
    rdfs:comment 'Unique identifier for the fee accrual record. Primary key for the accrual entity.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:externalManagerGpProfileId rdf:type rdf:Property ;
    rdfs:label 'External Manager Gp Profile Id' ;
    rdfs:comment 'Reference to the external General Partner (GP) or fund manager when the accrual relates to an externally managed mandate or fund investment.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:accrualStatus rdf:type rdf:Property ;
    rdfs:label 'Accrual Status' ;
    rdfs:comment 'Current state of the accrual in its approval and posting workflow: draft (initial calculation), pending approval (awaiting IC or finance review), approved (ready to post), posted (recorded in GL), reversed, or cancelled.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basisAmount rdf:type rdf:Property ;
    rdfs:label 'Basis Amount' ;
    rdfs:comment 'The dollar value of the basis metric (AUM, NAV, committed capital, etc.) used to compute the fee accrual for this period. Denominated in the fund or mandate base currency.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkFeeRatePercent rdf:type rdf:Property ;
    rdfs:label 'Benchmark Fee Rate Percent' ;
    rdfs:comment 'The market benchmark or peer median fee rate for this fee type and asset class, used for fee transparency reporting and external manager fee benchmarking. Sourced from Preqin, PitchBook, or industry surveys.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeRebateAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Rebate Amount' ;
    rdfs:comment 'Any rebate or offset applied to the gross accrual, such as General Partner (GP) fee rebates on co-investments or transaction fee offsets negotiated in the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeVariancePercent rdf:type rdf:Property ;
    rdfs:label 'Fee Variance Percent' ;
    rdfs:comment 'The variance between the accrued fee rate and the benchmark fee rate, expressed as a percentage. Positive values indicate fees above market; negative values indicate favorable negotiated rates.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossAccrualAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Accrual Amount' ;
    rdfs:comment 'The gross fee amount accrued for the period before any adjustments, rebates, or offsets. Calculated as accrual_basis_amount multiplied by accrual_rate_percent, pro-rated for the period.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netAccrualAmount rdf:type rdf:Property ;
    rdfs:label 'Net Accrual Amount' ;
    rdfs:comment 'The final net fee amount accrued for the period after applying all rebates and adjustments. This is the amount posted to the General Ledger (GL) and reflected in Net Asset Value (NAV) calculations.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postingDate rdf:type rdf:Property ;
    rdfs:label 'Posting Date' ;
    rdfs:comment 'The date on which the accrual was posted to the General Ledger (GL) and reflected in the Net Asset Value (NAV) calculation. Typically the last business day of the accrual period.' ;
    rdfs:domain ind:Accrual ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentId rdf:type rdf:Property ;
    rdfs:label 'Payment Id' ;
    rdfs:comment 'Unique identifier for the fee payment transaction.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:baseCurrencyGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Gross Amount' ;
    rdfs:comment 'Gross payment amount converted to the funds base currency using the FX rate.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseCurrencyNetAmount rdf:type rdf:Property ;
    rdfs:label 'Base Currency Net Amount' ;
    rdfs:comment 'Net payment amount converted to the funds base currency using the FX rate.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryBankBic rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Bank Bic' ;
    rdfs:comment 'Bank Identifier Code (BIC) or SWIFT code of the beneficiary bank.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryBankName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Bank Name' ;
    rdfs:comment 'Name of the bank receiving the payment on behalf of the external manager or GP.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clawbackProvisionApplied rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision Applied' ;
    rdfs:comment 'Boolean flag indicating whether a clawback provision was applied to reduce this payment.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentDescription rdf:type rdf:Property ;
    rdfs:label 'Payment Description' ;
    rdfs:comment 'Detailed description or narrative of the payment, including purpose and any special terms or conditions.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Payment Amount' ;
    rdfs:comment 'Total fee amount before any deductions, withholdings, or adjustments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRateMet rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Met' ;
    rdfs:comment 'Boolean flag indicating whether the preferred return hurdle rate was met for carried interest payments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isLatePayment rdf:type rdf:Property ;
    rdfs:label 'Is Late Payment' ;
    rdfs:comment 'Boolean flag indicating whether the payment was made after the contractual due date.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:method rdf:type rdf:Property ;
    rdfs:label 'Method' ;
    rdfs:comment 'Method or instrument used to disburse the payment (e.g., wire transfer, ACH, check, SWIFT, SEPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherDeductionsAmount rdf:type rdf:Property ;
    rdfs:label 'Other Deductions Amount' ;
    rdfs:comment 'Total amount of other deductions applied to the payment, such as clawback provisions, fee rebates, or adjustments.' ;
    rdfs:domain ind:Payment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceId rdf:type rdf:Property ;
    rdfs:label 'Invoice Id' ;
    rdfs:comment 'Unique identifier for the fee invoice record. Primary key.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Benchmark Fee Rate Bps' ;
    rdfs:comment 'Industry benchmark fee rate in basis points (bps) for comparison and fee transparency reporting.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryRatePct rdf:type rdf:Property ;
    rdfs:label 'Carry Rate Pct' ;
    rdfs:comment 'Carried interest (carry) rate percentage applied to profits above the hurdle rate for performance fee calculation.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoiceDescription rdf:type rdf:Property ;
    rdfs:label 'Invoice Description' ;
    rdfs:comment 'Detailed description or narrative provided by the external manager or General Partner (GP) explaining the fee invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeRateBps rdf:type rdf:Property ;
    rdfs:label 'Fee Rate Bps' ;
    rdfs:comment 'Fee rate expressed in basis points (bps) applied to the base amount. One basis point equals 0.01%.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeVarianceBps rdf:type rdf:Property ;
    rdfs:label 'Fee Variance Bps' ;
    rdfs:comment 'Variance between the invoiced fee rate and the benchmark fee rate, expressed in basis points (bps).' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoicingEntityLei rdf:type rdf:Property ;
    rdfs:label 'Invoicing Entity Lei' ;
    rdfs:comment 'Legal Entity Identifier (LEI) of the General Partner (GP) or external manager entity issuing the invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoicingEntityName rdf:type rdf:Property ;
    rdfs:label 'Invoicing Entity Name' ;
    rdfs:comment 'Legal name of the General Partner (GP) or external manager entity issuing the invoice.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Amount' ;
    rdfs:comment 'Fee rebate or discount amount applied by the General Partner (GP) or external manager, reducing the gross fee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceDocumentUri rdf:type rdf:Property ;
    rdfs:label 'Source Document Uri' ;
    rdfs:comment 'Uniform Resource Identifier (URI) or file path to the original invoice document (PDF, email) stored in the document management system.' ;
    rdfs:domain ind:Invoice ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionFeeId rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Id' ;
    rdfs:comment 'Unique identifier for the transaction fee record.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionFee .

ind:benchmarkRatePercent rdf:type rdf:Property ;
    rdfs:label 'Benchmark Rate Percent' ;
    rdfs:comment 'Industry benchmark or peer median fee rate for this type of transaction, used for fee reasonableness assessment.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Gross Amount' ;
    rdfs:comment 'Gross transaction fee amount before any offsets, rebates, or adjustments.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeNetAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Net Amount' ;
    rdfs:comment 'Net transaction fee amount payable after rebates and offsets, representing the actual economic cost to the fund.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeNumber rdf:type rdf:Property ;
    rdfs:label 'Fee Number' ;
    rdfs:comment 'Business identifier or invoice number for this transaction fee as assigned by the charging party.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeRatePercent rdf:type rdf:Property ;
    rdfs:label 'Fee Rate Percent' ;
    rdfs:comment 'Percentage rate applied to the transaction value to calculate the fee, if fee is rate-based.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icApprovalFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Flag' ;
    rdfs:comment 'Indicates whether this transaction fee was reviewed and approved by the Investment Committee.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpaReferenceClause rdf:type rdf:Property ;
    rdfs:label 'Lpa Reference Clause' ;
    rdfs:comment 'Specific clause or section in the LPA that governs this transaction fee and its treatment.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebatePolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Rebate Policy Flag' ;
    rdfs:comment 'Indicates whether this fee is subject to GP rebate or offset provisions under the LPA.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transactionValueAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Value Amount' ;
    rdfs:comment 'Total value of the underlying investment transaction used as the basis for calculating the fee.' ;
    rdfs:domain ind:TransactionFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceToBenchmarkBps rdf:type rdf:Property ;
    rdfs:label 'Variance To Benchmark Bps' ;
    rdfs:comment 'Difference in basis points between the actual fee rate and the benchmark rate, used for cost monitoring.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpFeeRebateId rdf:type rdf:Property ;
    rdfs:label 'Gp Fee Rebate Id' ;
    rdfs:comment 'Unique identifier for the GP fee rebate record.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transactionFeeId rdf:type rdf:Property ;
    rdfs:label 'Transaction Transaction Fee Id' ;
    rdfs:comment 'Reference to the specific investment transaction that generated the fee subject to rebate, if applicable.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TransactionFee .

ind:applicationDate rdf:type rdf:Property ;
    rdfs:label 'Application Date' ;
    rdfs:comment 'Date on which the rebate was applied to the management fee invoice or accrual.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cumulativeRebateAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Rebate Amount' ;
    rdfs:comment 'Cumulative total of all rebates applied to date for this fund and GP relationship.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Adjustment Amount' ;
    rdfs:comment 'Any adjustment applied to the gross rebate amount due to timing differences, prior period corrections, or other factors.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateCapAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Cap Amount' ;
    rdfs:comment 'Maximum rebate amount allowed per LPA terms, if applicable.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateCapAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Rebate Cap Applied Flag' ;
    rdfs:comment 'Indicates whether the rebate cap was reached and applied to limit the rebate amount.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebateGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Gross Amount' ;
    rdfs:comment 'Gross rebate amount calculated before any adjustments or offsets.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateNetAmount rdf:type rdf:Property ;
    rdfs:label 'Rebate Net Amount' ;
    rdfs:comment 'Net rebate amount after all adjustments, representing the final offset to management fees.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateNumber rdf:type rdf:Property ;
    rdfs:label 'Rebate Number' ;
    rdfs:comment 'Business identifier for the rebate transaction, typically assigned by the fund administrator or internal system.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebatePercentage rdf:type rdf:Property ;
    rdfs:label 'Rebate Percentage' ;
    rdfs:comment 'Percentage of the gross fee to be rebated to the fund as specified in the LPA, expressed as a decimal (e.g., 0.8000 for 80%).' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rebateStatus rdf:type rdf:Property ;
    rdfs:label 'Rebate Status' ;
    rdfs:comment 'Current lifecycle status of the rebate record.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebateType rdf:type rdf:Property ;
    rdfs:label 'Rebate Type' ;
    rdfs:comment 'Classification of the rebate based on the type of fee being offset as defined in the LPA.' ;
    rdfs:domain ind:GpFeeRebate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carryDistributionId rdf:type rdf:Property ;
    rdfs:label 'Carry Distribution Id' ;
    rdfs:comment 'Unique identifier for the carried interest distribution transaction.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escrowAccountCarryEscrowId rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Carry Escrow Id' ;
    rdfs:comment 'Reference to the escrow account holding clawback reserves, if applicable.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CarryEscrow .

ind:carryGrossAmount rdf:type rdf:Property ;
    rdfs:label 'Carry Gross Amount' ;
    rdfs:comment 'Gross carried interest amount calculated before any catch-up provisions or adjustments.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryNetAmount rdf:type rdf:Property ;
    rdfs:label 'Carry Net Amount' ;
    rdfs:comment 'Net carried interest distributed to the general partner after all adjustments and provisions.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Investment Irr Percent' ;
    rdfs:comment 'Investment-level internal rate of return for the specific asset that generated this distribution.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentMoic rdf:type rdf:Property ;
    rdfs:label 'Investment Moic' ;
    rdfs:comment 'Investment-level multiple on invested capital for the specific asset that generated this distribution.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:profitSplitAmount rdf:type rdf:Property ;
    rdfs:label 'Profit Split Amount' ;
    rdfs:comment 'Total profit available for distribution after return of capital and preferred return have been satisfied.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizationDate rdf:type rdf:Property ;
    rdfs:label 'Realization Date' ;
    rdfs:comment 'Date on which the underlying investment realization event occurred.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:realizationEventType rdf:type rdf:Property ;
    rdfs:label 'Realization Event Type' ;
    rdfs:comment 'Type of liquidity event that triggered the carry distribution.' ;
    rdfs:domain ind:CarryDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clawbackAmountApplied rdf:type rdf:Property ;
    rdfs:label 'Clawback Amount Applied' ;
    rdfs:comment 'Total amount drawn from this escrow account to satisfy clawback obligations to LPs.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackTriggeredFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Triggered Flag' ;
    rdfs:comment 'Indicates whether a clawback event has been triggered requiring funds from this escrow account to be returned to Limited Partners (LPs).' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cumulativeEscrowWithheldAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Escrow Withheld Amount' ;
    rdfs:comment 'Total amount withheld in escrow across all carried interest distributions to date for this fund and GP.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeDescription rdf:type rdf:Property ;
    rdfs:label 'Dispute Description' ;
    rdfs:comment 'Detailed description of the nature of the dispute affecting the escrow account, including parties involved and contested amounts.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountName rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Name' ;
    rdfs:comment 'Legal name or title of the escrow account as registered with the custodian or escrow agent.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Number' ;
    rdfs:comment 'External bank or custodian account number for the escrow account holding the carried interest funds.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowStatus rdf:type rdf:Property ;
    rdfs:label 'Escrow Status' ;
    rdfs:comment 'Current lifecycle status of the escrow account indicating whether funds are held, released, or subject to dispute.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:establishmentDate rdf:type rdf:Property ;
    rdfs:label 'Establishment Date' ;
    rdfs:comment 'Date on which the escrow account was formally established and funded per the Limited Partnership Agreement (LPA) provisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:interestAccrualFlag rdf:type rdf:Property ;
    rdfs:label 'Interest Accrual Flag' ;
    rdfs:comment 'Indicates whether the escrow account accrues interest on held funds per LPA terms.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:interestAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Interest Allocation Method' ;
    rdfs:comment 'Method by which interest earned on escrow funds is allocated among General Partner (GP), Limited Partners (LPs), or the fund.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestEarnedAmount rdf:type rdf:Property ;
    rdfs:label 'Interest Earned Amount' ;
    rdfs:comment 'Total interest earned on escrow funds to date, which may be allocated to GP or LPs per LPA terms.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRatePercent rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Percent' ;
    rdfs:comment 'Annual interest rate applied to escrow funds if interest accrual is enabled, expressed as a percentage.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investorDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Investor Disclosure Flag' ;
    rdfs:comment 'Indicates whether escrow details are disclosed to Limited Partners (LPs) in quarterly or annual investor reports.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextReleaseAmount rdf:type rdf:Property ;
    rdfs:label 'Next Release Amount' ;
    rdfs:comment 'Amount scheduled to be released on the next release date per the LPA release schedule.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Next Release Date' ;
    rdfs:comment 'Next scheduled date on which a portion of the escrow funds is eligible for release to the GP per the release schedule.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:releaseDate rdf:type rdf:Property ;
    rdfs:label 'Release Date' ;
    rdfs:comment 'Date on which the escrow funds were released to the General Partner (GP) or became eligible for release per LPA terms.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:releaseScheduleType rdf:type rdf:Property ;
    rdfs:label 'Release Schedule Type' ;
    rdfs:comment 'Type of release schedule governing when escrow funds are released: single release, periodic tranches, milestone-based, or performance-based.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releaseTriggerCondition rdf:type rdf:Property ;
    rdfs:label 'Release Trigger Condition' ;
    rdfs:comment 'Business condition or event that triggers release of escrow funds, such as fund liquidation, passage of time, or achievement of performance thresholds.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:releasedAmount rdf:type rdf:Property ;
    rdfs:label 'Released Amount' ;
    rdfs:comment 'Total amount released from escrow to the GP to date, reflecting partial or full releases per LPA terms.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingBalance rdf:type rdf:Property ;
    rdfs:label 'Remaining Balance' ;
    rdfs:comment 'Current balance remaining in the escrow account after accounting for releases and any clawback settlements.' ;
    rdfs:domain ind:CarryEscrow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterest25thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest 25th Percentile Percent' ;
    rdfs:comment 'Twenty-fifth percentile carried interest rate representing the lower quartile of the benchmark distribution.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterest75thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest 75th Percentile Percent' ;
    rdfs:comment 'Seventy-fifth percentile carried interest rate representing the upper quartile of the benchmark distribution.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterestMedianPercent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Median Percent' ;
    rdfs:comment 'Median carried interest rate as a percentage of profits above the hurdle rate observed in the benchmark peer group.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpProvisionPrevalencePercent rdf:type rdf:Property ;
    rdfs:label 'Catch Up Provision Prevalence Percent' ;
    rdfs:comment 'Percentage of funds in the benchmark cohort that include a catch-up provision allowing GPs to receive a higher share of profits after the hurdle is met.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackProvisionPrevalencePercent rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision Prevalence Percent' ;
    rdfs:comment 'Percentage of funds in the benchmark cohort that include clawback provisions requiring GPs to return excess carried interest if final fund performance falls below agreed thresholds.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataSourceReportReference rdf:type rdf:Property ;
    rdfs:label 'Data Source Report Reference' ;
    rdfs:comment 'Specific report title, publication identifier, or URL reference from the data source for audit trail and verification purposes.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundSizeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Fund Size Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for fund size bounds (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundSizeLowerBoundAmount rdf:type rdf:Property ;
    rdfs:label 'Fund Size Lower Bound Amount' ;
    rdfs:comment 'Minimum fund size (Assets Under Management) in millions for which this benchmark is applicable, enabling size-cohort comparisons.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundSizeUpperBoundAmount rdf:type rdf:Property ;
    rdfs:label 'Fund Size Upper Bound Amount' ;
    rdfs:comment 'Maximum fund size (Assets Under Management) in millions for which this benchmark is applicable, defining the upper limit of the size cohort.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRate25thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate 25th Percentile Percent' ;
    rdfs:comment 'Twenty-fifth percentile hurdle rate representing the lower quartile of the benchmark distribution.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRate75thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate 75th Percentile Percent' ;
    rdfs:comment 'Seventy-fifth percentile hurdle rate representing the upper quartile of the benchmark distribution.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRateMedianPercent rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Median Percent' ;
    rdfs:comment 'Median preferred return threshold (hurdle rate) that must be achieved before General Partners (GPs) earn carried interest, observed in the benchmark peer group.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFee25thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Management Fee 25th Percentile Percent' ;
    rdfs:comment 'Twenty-fifth percentile management fee rate representing the lower quartile of the benchmark distribution, indicating competitive fee levels.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFee75thPercentilePercent rdf:type rdf:Property ;
    rdfs:label 'Management Fee 75th Percentile Percent' ;
    rdfs:comment 'Seventy-fifth percentile management fee rate representing the upper quartile of the benchmark distribution.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFeeMedianPercent rdf:type rdf:Property ;
    rdfs:label 'Management Fee Median Percent' ;
    rdfs:comment 'Median management fee rate as a percentage of committed capital or net asset value observed in the benchmark peer group.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mostFavoredNationPrevalencePercent rdf:type rdf:Property ;
    rdfs:label 'Most Favored Nation Prevalence Percent' ;
    rdfs:comment 'Percentage of funds in the benchmark cohort that include Most Favored Nation clauses ensuring Limited Partners (LPs) receive fee terms no less favorable than those granted to other LPs.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sampleSizeCount rdf:type rdf:Property ;
    rdfs:label 'Sample Size Count' ;
    rdfs:comment 'Number of funds or manager mandates included in the benchmark calculation, indicating statistical robustness of the benchmark data.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:usageNotes rdf:type rdf:Property ;
    rdfs:label 'Usage Notes' ;
    rdfs:comment 'Free-text field capturing guidance on how to apply the benchmark, any known limitations, or special considerations for fee negotiations.' ;
    rdfs:domain ind:FeeBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededByScheduleRateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Schedule Rate Schedule Id' ;
    rdfs:comment 'Identifier of the rate schedule that supersedes this schedule when a new version is created or terms are updated.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:feeOffsetProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Fee Offset Provision Flag' ;
    rdfs:comment 'Indicates whether this rate schedule includes provisions for offsetting management fees against transaction fees or other fee types.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:geographyScope rdf:type rdf:Property ;
    rdfs:label 'Geography Scope' ;
    rdfs:comment 'Geographic scope or region to which this rate schedule applies, such as global, North America, Europe, Asia Pacific, or emerging markets.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investorType rdf:type rdf:Property ;
    rdfs:label 'Investor Type' ;
    rdfs:comment 'Type of investor or client segment to which this rate schedule applies, such as institutional, retail, high net worth, or pension funds.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tier1RateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 1 Rate Bps' ;
    rdfs:comment 'Fee rate applicable to tier 1 expressed in basis points. One basis point equals 0.01 percent.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier1ThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier 1 Threshold Amount' ;
    rdfs:comment 'Lower bound amount for the first tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 1 rate.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier2RateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 2 Rate Bps' ;
    rdfs:comment 'Fee rate applicable to tier 2 expressed in basis points. One basis point equals 0.01 percent.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier2ThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier 2 Threshold Amount' ;
    rdfs:comment 'Lower bound amount for the second tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 2 rate.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier3RateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 3 Rate Bps' ;
    rdfs:comment 'Fee rate applicable to tier 3 expressed in basis points. One basis point equals 0.01 percent.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier3ThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier 3 Threshold Amount' ;
    rdfs:comment 'Lower bound amount for the third tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 3 rate.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier4RateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 4 Rate Bps' ;
    rdfs:comment 'Fee rate applicable to tier 4 expressed in basis points. One basis point equals 0.01 percent.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier4ThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier 4 Threshold Amount' ;
    rdfs:comment 'Lower bound amount for the fourth tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 4 rate.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier5RateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 5 Rate Bps' ;
    rdfs:comment 'Fee rate applicable to tier 5 expressed in basis points. One basis point equals 0.01 percent.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier5ThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Tier 5 Threshold Amount' ;
    rdfs:comment 'Lower bound amount for the fifth tier in a tiered fee schedule. Amounts at or above this threshold apply the tier 5 rate.' ;
    rdfs:domain ind:RateSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalRunFeeCalculationRunId rdf:type rdf:Property ;
    rdfs:label 'Original Run Fee Calculation Run Id' ;
    rdfs:comment 'Reference to the original fee calculation run if this is a recalculation or correction.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FeeCalculationRun .

ind:accrualFlag rdf:type rdf:Property ;
    rdfs:label 'Accrual Flag' ;
    rdfs:comment 'Indicates whether this calculation run is for accrual purposes or actual payment processing.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:aumBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Aum Basis Amount' ;
    rdfs:comment 'The Assets Under Management value used as the basis for calculating management fees.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basisCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Basis Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the basis amount used in the fee calculation.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catchUpProvisionAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Catch Up Provision Applied Flag' ;
    rdfs:comment 'Indicates whether a catch-up provision was applied to allow the General Partner (GP) to receive additional carried interest after the hurdle is met.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hurdleMetFlag rdf:type rdf:Property ;
    rdfs:label 'Hurdle Met Flag' ;
    rdfs:comment 'Indicates whether the hurdle rate threshold was met or exceeded in this calculation period.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investedCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Invested Capital Amount' ;
    rdfs:comment 'The total invested or paid-in capital amount used as the basis for fee calculation.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Nav Basis Amount' ;
    rdfs:comment 'The Net Asset Value used as the basis for fee calculation, particularly for private market investments.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBenchmarkCode rdf:type rdf:Property ;
    rdfs:label 'Performance Benchmark Code' ;
    rdfs:comment 'The benchmark index or reference code used to evaluate performance for performance fee calculations.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recalculationFlag rdf:type rdf:Property ;
    rdfs:label 'Recalculation Flag' ;
    rdfs:comment 'Indicates whether this run is a recalculation of a previously executed fee calculation.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tieredRateAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Tiered Rate Applied Flag' ;
    rdfs:comment 'Indicates whether a tiered fee schedule was applied in this calculation run.' ;
    rdfs:domain ind:FeeCalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeId rdf:type rdf:Property ;
    rdfs:label 'Dispute Id' ;
    rdfs:comment 'Unique identifier for the fee dispute record.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedToUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned To User Employee Id' ;
    rdfs:comment 'Reference to the internal user or team member currently responsible for managing and resolving the dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:identifiedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Identified By User Employee Id' ;
    rdfs:comment 'Reference to the internal user or analyst who identified and raised the fee dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:auditorNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Auditor Notification Date' ;
    rdfs:comment 'Date when the external auditor was formally notified of the fee dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditorNotifiedFlag rdf:type rdf:Property ;
    rdfs:label 'Auditor Notified Flag' ;
    rdfs:comment 'Indicates whether the external auditor has been notified of the dispute for financial reporting and audit trail purposes.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disputeCategory rdf:type rdf:Property ;
    rdfs:label 'Dispute Category' ;
    rdfs:comment 'Categorization of the root cause or nature of the fee dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimedAmount rdf:type rdf:Property ;
    rdfs:label 'Claimed Amount' ;
    rdfs:comment 'Amount that the external manager or General Partner (GP) originally claimed or charged.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correctAmount rdf:type rdf:Property ;
    rdfs:label 'Correct Amount' ;
    rdfs:comment 'Amount that the pension fund believes is the correct fee based on Limited Partnership Agreement (LPA) terms and calculations.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeStatus rdf:type rdf:Property ;
    rdfs:label 'Dispute Status' ;
    rdfs:comment 'Current lifecycle status of the fee dispute in the resolution workflow.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeType rdf:type rdf:Property ;
    rdfs:label 'Dispute Type' ;
    rdfs:comment 'Classification of the fee type that is subject to dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialityThresholdExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Materiality Threshold Exceeded Flag' ;
    rdfs:comment 'Indicates whether the disputed amount exceeds the materiality threshold requiring Investment Committee (IC) or senior management notification.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:raisedDate rdf:type rdf:Property ;
    rdfs:label 'Raised Date' ;
    rdfs:comment 'Date when the fee dispute was formally raised by the investment team or operations.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:refundAmount rdf:type rdf:Property ;
    rdfs:label 'Refund Amount' ;
    rdfs:comment 'Amount to be refunded or credited to the pension fund following dispute resolution.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:refundDueFlag rdf:type rdf:Property ;
    rdfs:label 'Refund Due Flag' ;
    rdfs:comment 'Indicates whether a refund or credit is due to the pension fund as a result of the dispute resolution.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refundReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Refund Received Date' ;
    rdfs:comment 'Date when the refund or credit was received from the external manager or General Partner (GP).' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolvedAmount rdf:type rdf:Property ;
    rdfs:label 'Resolved Amount' ;
    rdfs:comment 'Final agreed-upon fee amount after dispute resolution, which may differ from both claimed and correct amounts due to negotiation.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responseDueDate rdf:type rdf:Property ;
    rdfs:label 'Response Due Date' ;
    rdfs:comment 'Date by which the external manager or General Partner (GP) is required to respond to the dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportingDocumentationFlag rdf:type rdf:Property ;
    rdfs:label 'Supporting Documentation Flag' ;
    rdfs:comment 'Indicates whether all required supporting documentation (invoices, calculations, Limited Partnership Agreement (LPA) excerpts) has been collected and attached to the dispute.' ;
    rdfs:domain ind:Dispute ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waiverId rdf:type rdf:Property ;
    rdfs:label 'Waiver Id' ;
    rdfs:comment 'Unique identifier for the management fee waiver record.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amountCap rdf:type rdf:Property ;
    rdfs:label 'Amount Cap' ;
    rdfs:comment 'Maximum cumulative fee waiver amount that can be granted under this arrangement, if capped.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:applicationFrequency rdf:type rdf:Property ;
    rdfs:label 'Application Frequency' ;
    rdfs:comment 'Frequency at which the fee waiver is applied to management fee calculations.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:basisPoints rdf:type rdf:Property ;
    rdfs:label 'Basis Points' ;
    rdfs:comment 'Fee reduction expressed in basis points, commonly used for institutional fee negotiations.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coInvestmentLinkageFlag rdf:type rdf:Property ;
    rdfs:label 'Co Investment Linkage Flag' ;
    rdfs:comment 'Indicates whether the fee waiver is contingent upon Limited Partner (LP) participation in co-investment opportunities.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Commitment Threshold Amount' ;
    rdfs:comment 'Minimum capital commitment amount required to qualify for the fee waiver, if applicable.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeWaiverAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Waiver Amount' ;
    rdfs:comment 'Total cumulative fee reduction granted to date under this waiver arrangement.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastAppliedDate rdf:type rdf:Property ;
    rdfs:label 'Last Applied Date' ;
    rdfs:comment 'Most recent date when the fee waiver was applied to a management fee calculation.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalCounselReviewFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Review Flag' ;
    rdfs:comment 'Indicates whether the fee waiver arrangement was reviewed and approved by legal counsel.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpacParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Lpac Participation Flag' ;
    rdfs:comment 'Indicates whether the fee waiver is granted in exchange for active Limited Partner Advisory Committee (LPAC) participation.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netFeeRatePercent rdf:type rdf:Property ;
    rdfs:label 'Net Fee Rate Percent' ;
    rdfs:comment 'Effective management fee rate after application of the waiver.' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waiverStatus rdf:type rdf:Property ;
    rdfs:label 'Waiver Status' ;
    rdfs:comment 'Current lifecycle status of the fee waiver arrangement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverType rdf:type rdf:Property ;
    rdfs:label 'Waiver Type' ;
    rdfs:comment 'Classification of the fee type being waived by the General Partner (GP).' ;
    rdfs:domain ind:Waiver ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFeeId rdf:type rdf:Property ;
    rdfs:label 'Monitoring Fee Id' ;
    rdfs:comment 'Unique identifier for the portfolio company monitoring fee record. Primary key for the monitoring fee entity.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualFlatFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Flat Fee Amount' ;
    rdfs:comment 'Fixed annual monitoring fee amount charged to the portfolio company when fee structure is flat fee based.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingFrequency rdf:type rdf:Property ;
    rdfs:label 'Billing Frequency' ;
    rdfs:comment 'Frequency at which monitoring fee invoices are issued to the portfolio company by the General Partner (GP).' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationBase rdf:type rdf:Property ;
    rdfs:label 'Calculation Base' ;
    rdfs:comment 'The financial metric used as the basis for percentage-based monitoring fee calculations, such as Earnings Before Interest Taxes Depreciation and Amortization (EBITDA).' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Clause Flag' ;
    rdfs:comment 'Indicates whether the monitoring fee includes an automatic escalation provision tied to inflation or other indices.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Escalation Rate Percent' ;
    rdfs:comment 'Annual percentage rate by which the monitoring fee automatically increases, if escalation clause is in effect.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fee Reference Number' ;
    rdfs:comment 'External business identifier for the monitoring fee arrangement, typically referenced in investment agreements and invoices.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Investment Agreement Reference' ;
    rdfs:comment 'Reference to the specific investment agreement, Share Purchase Agreement (SPA), or transaction document that establishes the monitoring fee terms.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaOffsetPercentage rdf:type rdf:Property ;
    rdfs:label 'Lpa Offset Percentage' ;
    rdfs:comment 'Percentage of monitoring fees that must be credited back to Limited Partners (LPs) as an offset against management fees, per LPA terms.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpaOffsetProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Lpa Offset Provision Flag' ;
    rdfs:comment 'Indicates whether the Limited Partnership Agreement requires monitoring fees to be offset against management fees paid by Limited Partners (LPs).' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentageRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rate' ;
    rdfs:comment 'Percentage rate applied to the calculation base (EBITDA or revenue) when fee structure is percentage-based, expressed as decimal.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminationTrigger rdf:type rdf:Property ;
    rdfs:label 'Termination Trigger' ;
    rdfs:comment 'Event or condition that triggered or will trigger the termination of the monitoring fee arrangement.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transparencyDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Transparency Disclosure Flag' ;
    rdfs:comment 'Indicates whether this monitoring fee arrangement is subject to transparency disclosure requirements to Limited Partners (LPs) or regulators.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:withholdingTaxApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Applicable Flag' ;
    rdfs:comment 'Indicates whether withholding tax must be applied to monitoring fee payments based on jurisdiction and tax treaty provisions.' ;
    rdfs:domain ind:MonitoringFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:organizationalExpenseId rdf:type rdf:Property ;
    rdfs:label 'Organizational Expense Id' ;
    rdfs:comment 'Unique identifier for the organizational expense record.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expenseNumber rdf:type rdf:Property ;
    rdfs:label 'Expense Number' ;
    rdfs:comment 'Business reference number assigned to this organizational expense for tracking and reporting purposes.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseStatus rdf:type rdf:Property ;
    rdfs:label 'Expense Status' ;
    rdfs:comment 'Current lifecycle status of the organizational expense in the payment and approval workflow.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseType rdf:type rdf:Property ;
    rdfs:label 'Expense Type' ;
    rdfs:comment 'Classification of the organizational expense by nature of cost incurred during fund formation or launch. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Expense Amount' ;
    rdfs:comment 'Total gross amount of the organizational expense before any adjustments, rebates, or allocations.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incurredDate rdf:type rdf:Property ;
    rdfs:label 'Incurred Date' ;
    rdfs:comment 'Date on which the organizational expense was incurred or the service was rendered.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonReimbursableAmount rdf:type rdf:Property ;
    rdfs:label 'Non Reimbursable Amount' ;
    rdfs:comment 'Portion of the organizational expense that is not reimbursable and must be borne by the General Partner (GP) or other party.' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reimbursableAmount rdf:type rdf:Property ;
    rdfs:label 'Reimbursable Amount' ;
    rdfs:comment 'Portion of the organizational expense that is reimbursable by the fund or Limited Partners (LPs) per the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:OrganizationalExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementFeeId rdf:type rdf:Property ;
    rdfs:label 'Placement Fee Id' ;
    rdfs:comment 'Unique identifier for the placement fee record.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:feeAccrualDate rdf:type rdf:Property ;
    rdfs:label 'Fee Accrual Date' ;
    rdfs:comment 'Date on which the placement fee was accrued in the accounting system.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeBasisPercentage rdf:type rdf:Property ;
    rdfs:label 'Fee Basis Percentage' ;
    rdfs:comment 'Percentage of committed capital that determines the placement fee amount.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:placementAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Placement Agreement Reference' ;
    rdfs:comment 'Reference to the placement agent agreement document that governs this fee arrangement.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retrocessionAmount rdf:type rdf:Property ;
    rdfs:label 'Retrocession Amount' ;
    rdfs:comment 'Amount of placement fee rebated to the fund or investors under retrocession arrangement.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retrocessionArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Retrocession Arrangement Flag' ;
    rdfs:comment 'Indicates whether the placement fee involves a retrocession arrangement where a portion is rebated to the fund or investors.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:retrocessionPercentage rdf:type rdf:Property ;
    rdfs:label 'Retrocession Percentage' ;
    rdfs:comment 'Percentage of gross placement fee that is rebated under retrocession arrangement.' ;
    rdfs:domain ind:PlacementFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transparencyReportId rdf:type rdf:Property ;
    rdfs:label 'Transparency Report Id' ;
    rdfs:comment 'Unique identifier for the fee transparency report disclosure record.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transparencyEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Transparency Employee Id' ;
    rdfs:comment 'Reference to the user or Investment Committee (IC) member who approved the transparency report for publication.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:transparencyPreparedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Transparency Prepared By User Employee Id' ;
    rdfs:comment 'Reference to the user or team member who prepared the transparency report.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:averageAumAmount rdf:type rdf:Property ;
    rdfs:label 'Average Aum Amount' ;
    rdfs:comment 'Average Assets Under Management (AUM) during the reporting period, used as the basis for fee rate calculations.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Fees Amount' ;
    rdfs:comment 'Total fees paid for credit and fixed income investment management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:infrastructureFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Fees Amount' ;
    rdfs:comment 'Total fees paid for infrastructure investment management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:naturalResourcesFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Natural Resources Fees Amount' ;
    rdfs:comment 'Total fees paid for natural resources investment management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerMedianFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Peer Median Fee Rate Bps' ;
    rdfs:comment 'Median fee rate in basis points (bps) for comparable institutional asset managers, used for benchmarking transparency.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privateEquityFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Private Equity Fees Amount' ;
    rdfs:comment 'Total fees paid for private equity and co-investment management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicEquitiesFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Public Equities Fees Amount' ;
    rdfs:comment 'Total fees paid for public equities asset class management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realEstateFeesAmount rdf:type rdf:Property ;
    rdfs:label 'Real Estate Fees Amount' ;
    rdfs:comment 'Total fees paid for real estate investment management during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recipientCategory rdf:type rdf:Property ;
    rdfs:label 'Recipient Category' ;
    rdfs:comment 'Primary audience category for whom this transparency report was prepared and disclosed.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Flag' ;
    rdfs:comment 'Indicates whether this transparency report was submitted as part of a mandatory regulatory filing requirement.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalCarriedInterestPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Carried Interest Paid Amount' ;
    rdfs:comment 'Aggregate carried interest (carry) paid to General Partners (GPs) during the reporting period across all private market investments.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCustodyFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Custody Fees Paid Amount' ;
    rdfs:comment 'Aggregate custody and safekeeping fees paid to custodian banks during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Total Fee Rate Bps' ;
    rdfs:comment 'Total fee rate expressed in basis points (bps) calculated as total fees paid divided by average AUM, multiplied by 10,000.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Fees Paid Amount' ;
    rdfs:comment 'Grand total of all fees paid across all categories during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalManagementFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Management Fees Paid Amount' ;
    rdfs:comment 'Aggregate management fees paid to all external managers and General Partners (GPs) during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalOtherFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Other Fees Paid Amount' ;
    rdfs:comment 'Aggregate of all other investment-related fees not classified in primary categories, including legal, audit, and administrative fees.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPerformanceFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Performance Fees Paid Amount' ;
    rdfs:comment 'Aggregate performance-based fees paid to external managers who exceeded hurdle rates or benchmarks during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPlacementFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Placement Fees Paid Amount' ;
    rdfs:comment 'Aggregate placement agent fees paid for capital raising and investor relations services during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalTransactionFeesPaidAmount rdf:type rdf:Property ;
    rdfs:label 'Total Transaction Fees Paid Amount' ;
    rdfs:comment 'Aggregate transaction fees paid for deal execution, advisory services, and other transaction-related costs during the reporting period.' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceToPeerMedianBps rdf:type rdf:Property ;
    rdfs:label 'Variance To Peer Median Bps' ;
    rdfs:comment 'Difference between the funds total fee rate and the peer median fee rate, expressed in basis points (bps).' ;
    rdfs:domain ind:TransparencyReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveFeeId rdf:type rdf:Property ;
    rdfs:label 'Incentive Fee Id' ;
    rdfs:comment 'Unique identifier for the incentive fee arrangement. Primary key.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arrangementReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Arrangement Reference Number' ;
    rdfs:comment 'Business identifier for the incentive fee arrangement, typically referenced in Investment Management Agreements (IMA).' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementStatus rdf:type rdf:Property ;
    rdfs:label 'Arrangement Status' ;
    rdfs:comment 'Current lifecycle status of the incentive fee arrangement.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkReference rdf:type rdf:Property ;
    rdfs:label 'Benchmark Reference' ;
    rdfs:comment 'Identifier or name of the benchmark index or hurdle rate against which performance is measured for incentive fee calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeIncentiveFeePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Incentive Fee Paid Amount' ;
    rdfs:comment 'Total cumulative incentive fees paid to the external manager under this arrangement since inception, in fee currency.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equalizationMethod rdf:type rdf:Property ;
    rdfs:label 'Equalization Method' ;
    rdfs:comment 'Method used to ensure fair treatment of investors entering at different times relative to high water marks and performance periods.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCapPercent rdf:type rdf:Property ;
    rdfs:label 'Fee Cap Percent' ;
    rdfs:comment 'Maximum incentive fee as a percentage of Assets Under Management (AUM), providing an alternative cap mechanism.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fulcrumFeeAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Fulcrum Fee Adjustment Flag' ;
    rdfs:comment 'Indicates whether the arrangement includes symmetric fulcrum fee adjustments where fees increase for outperformance and decrease for underperformance.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highWaterMarkAmount rdf:type rdf:Property ;
    rdfs:label 'High Water Mark Amount' ;
    rdfs:comment 'Current high water mark value in base currency, representing the highest Net Asset Value (NAV) level at which incentive fees were previously charged.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:imaReferenceSection rdf:type rdf:Property ;
    rdfs:label 'Ima Reference Section' ;
    rdfs:comment 'Specific section or clause reference in the Investment Management Agreement (IMA) governing this incentive fee arrangement.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastCrystallizationDate rdf:type rdf:Property ;
    rdfs:label 'Last Crystallization Date' ;
    rdfs:comment 'Most recent date on which calculated incentive fees were crystallized and became payable.' ;
    rdfs:domain ind:Fee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceMeasurementBasis rdf:type rdf:Property ;
    rdfs:label 'Performance Measurement Basis' ;
    rdfs:comment 'Methodology used to calculate performance for incentive fee determination: Time-Weighted Return (TWR), Money-Weighted Return (MWR), or other basis.' ;
    rdfs:domain ind:IncentiveFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:highWaterMarkId rdf:type rdf:Property ;
    rdfs:label 'High Water Mark Id' ;
    rdfs:comment 'Unique identifier for the high water mark record. Primary key for the high_water_mark product.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clawbackReservePercentage rdf:type rdf:Property ;
    rdfs:label 'Clawback Reserve Percentage' ;
    rdfs:comment 'The percentage of performance fees withheld in reserve to cover potential future clawback obligations if performance deteriorates.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePerformanceFeeAccruedAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Performance Fee Accrued Amount' ;
    rdfs:comment 'The total performance fees accrued to date since the last reset, representing fees earned above the high water mark.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePerformanceFeePaidAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Performance Fee Paid Amount' ;
    rdfs:comment 'The total performance fees actually paid out to the manager since the last reset, used for reconciliation and clawback calculations.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeUnderperformanceAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Underperformance Amount' ;
    rdfs:comment 'The cumulative loss carryforward or deficit amount that must be recovered before new performance fees can be earned. Represents NAV below the high water mark.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentHwmNav rdf:type rdf:Property ;
    rdfs:label 'Current Hwm Nav' ;
    rdfs:comment 'The current high water mark net asset value level that must be exceeded before performance fees are earned. Represents the highest NAV achieved to date.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hwmCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Hwm Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the high water mark NAV is denominated.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hwmEstablishmentDate rdf:type rdf:Property ;
    rdfs:label 'Hwm Establishment Date' ;
    rdfs:comment 'The date on which the high water mark arrangement was first established for this mandate or fund.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hwmExceededFlag rdf:type rdf:Property ;
    rdfs:label 'Hwm Exceeded Flag' ;
    rdfs:comment 'Indicates whether the current NAV has exceeded the high water mark, triggering performance fee accrual eligibility.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hwmReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Hwm Reference Number' ;
    rdfs:comment 'Business-facing reference number or code for this high water mark arrangement, used in reporting and fee reconciliation.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hwmResetDate rdf:type rdf:Property ;
    rdfs:label 'Hwm Reset Date' ;
    rdfs:comment 'The most recent date on which the high water mark was reset to a new level, typically following a full recovery or contractual reset event.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:hwmStatus rdf:type rdf:Property ;
    rdfs:label 'Hwm Status' ;
    rdfs:comment 'Current lifecycle status of the high water mark arrangement indicating whether it is actively tracked or has been reset or terminated.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hwmType rdf:type rdf:Property ;
    rdfs:label 'Hwm Type' ;
    rdfs:comment 'Classification of the high water mark mechanism: hard (never resets), soft (resets under conditions), rolling (time-based reset), or crystallized (locked at fee payment).' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialHwmNav rdf:type rdf:Property ;
    rdfs:label 'Initial Hwm Nav' ;
    rdfs:comment 'The starting high water mark NAV level established at mandate inception or at the last full reset event.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lookbackPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Months' ;
    rdfs:comment 'The number of months over which performance is evaluated for rolling high water mark calculations or reset eligibility.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:navBasis rdf:type rdf:Property ;
    rdfs:label 'Nav Basis' ;
    rdfs:comment 'The basis on which NAV is calculated for high water mark purposes: gross of fees, net of fees, or adjusted for specific items.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextCrystallizationDate rdf:type rdf:Property ;
    rdfs:label 'Next Crystallization Date' ;
    rdfs:comment 'The scheduled date for the next performance fee crystallization event when the high water mark will be evaluated and performance fees calculated.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:performanceFeeRatePercent rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Rate Percent' ;
    rdfs:comment 'The percentage rate applied to returns above the high water mark to calculate performance-based incentive fees.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:previousHwmNav rdf:type rdf:Property ;
    rdfs:label 'Previous Hwm Nav' ;
    rdfs:comment 'The prior high water mark NAV level before the most recent update, used for performance attribution and fee variance analysis.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resetTriggerCondition rdf:type rdf:Property ;
    rdfs:label 'Reset Trigger Condition' ;
    rdfs:comment 'The contractual condition or event that triggers a reset of the high water mark, such as full recovery, time period expiry, or manager change.' ;
    rdfs:domain ind:HighWaterMark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkThresholdHigh rdf:type rdf:Property ;
    rdfs:label 'Benchmark Threshold High' ;
    rdfs:comment 'Upper bound of the normal or target range for this indicator, used for alert generation and scenario analysis. Null if no threshold is defined.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkThresholdLow rdf:type rdf:Property ;
    rdfs:label 'Benchmark Threshold Low' ;
    rdfs:comment 'Lower bound of the normal or target range for this indicator, used for alert generation and scenario analysis. Null if no threshold is defined.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macroIndicatorDescription rdf:type rdf:Property ;
    rdfs:label 'Macro Indicator Description' ;
    rdfs:comment 'Detailed business description of the indicator, including its economic significance, typical interpretation, and key considerations for investment analysis.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRelevance rdf:type rdf:Property ;
    rdfs:label 'Esg Relevance' ;
    rdfs:comment 'Indicates whether the indicator has direct relevance to ESG analysis: environmental (e.g., carbon emissions, renewable energy share), social (e.g., inequality measures), governance (e.g., corruption index), or not applicable.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastAvailability rdf:type rdf:Property ;
    rdfs:label 'Forecast Availability' ;
    rdfs:comment 'Indicates whether consensus forecasts or proprietary forecasts are maintained for this indicator. True if forecasts are tracked, false otherwise.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:historicalStartDate rdf:type rdf:Property ;
    rdfs:label 'Historical Start Date' ;
    rdfs:comment 'Earliest date for which historical data is available for this indicator. Used to determine time-series depth for backtesting and stress testing.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indicatorCategory rdf:type rdf:Property ;
    rdfs:label 'Indicator Category' ;
    rdfs:comment 'High-level classification of the indicator type: growth metrics, inflation measures, employment statistics, monetary policy rates, credit spreads, commodity prices, sentiment indices, or fiscal indicators.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorSubcategory rdf:type rdf:Property ;
    rdfs:label 'Indicator Subcategory' ;
    rdfs:comment 'Detailed sub-classification within the category (e.g., GDP, Industrial Production, CPI, PPI, Unemployment Rate, Central Bank Rate, Corporate Spread, Oil Price, PMI).' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadingLaggingCoincident rdf:type rdf:Property ;
    rdfs:label 'Leading Lagging Coincident' ;
    rdfs:comment 'Economic timing classification: leading (predicts future economic activity), lagging (confirms trends after they occur), or coincident (moves with current economic conditions).' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:macroIndicatorStatus rdf:type rdf:Property ;
    rdfs:label 'Macro Indicator Status' ;
    rdfs:comment 'Current lifecycle status of the indicator in the research library: active (currently tracked), discontinued (no longer published), suspended (temporarily unavailable), or under review (evaluation for inclusion).' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proprietaryModelFlag rdf:type rdf:Property ;
    rdfs:label 'Proprietary Model Flag' ;
    rdfs:comment 'Indicates whether this indicator is derived from an internal proprietary model rather than sourced from external vendors. True for proprietary indicators, false for external.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicationLagDays rdf:type rdf:Property ;
    rdfs:label 'Publication Lag Days' ;
    rdfs:comment 'Typical number of days between the reference period end and the official publication date. Used for forecasting data availability in investment models.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regionCode rdf:type rdf:Property ;
    rdfs:label 'Region Code' ;
    rdfs:comment 'Regional bloc or economic area code for regional indicators (e.g., OECD, EU, G7, ASEAN). Null for country-specific or global indicators.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Related Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset classes most sensitive to this indicator (e.g., public equities, fixed income, real estate, infrastructure, commodities). Used for cross-asset correlation analysis.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionPolicy rdf:type rdf:Property ;
    rdfs:label 'Revision Policy' ;
    rdfs:comment 'Indicates whether published values are subject to revision: no revision, preliminary then final, or continuous revision. Critical for risk modeling and data quality.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seasonalAdjustment rdf:type rdf:Property ;
    rdfs:label 'Seasonal Adjustment' ;
    rdfs:comment 'Indicates whether the indicator data is seasonally adjusted, not seasonally adjusted, or available in both forms. Critical for time-series modeling.' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stewardTeam rdf:type rdf:Property ;
    rdfs:label 'Steward Team' ;
    rdfs:comment 'Name of the internal research team or function responsible for maintaining and validating this indicator (e.g., Macro Research, Fixed Income Research, ESG Research).' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volatilityClassification rdf:type rdf:Property ;
    rdfs:label 'Volatility Classification' ;
    rdfs:comment 'Qualitative assessment of the indicators historical volatility: low (stable, slow-moving), moderate (typical cyclical variation), or high (subject to sharp swings).' ;
    rdfs:domain ind:MacroIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:macroIndicatorObservationId rdf:type rdf:Property ;
    rdfs:label 'Macro Indicator Observation Id' ;
    rdfs:comment 'Unique identifier for the macroeconomic indicator observation record.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consensusEstimate rdf:type rdf:Property ;
    rdfs:label 'Consensus Estimate' ;
    rdfs:comment 'The median or mean forecast value from external analysts or economists prior to the actual release.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consensusEstimateCount rdf:type rdf:Property ;
    rdfs:label 'Consensus Estimate Count' ;
    rdfs:comment 'Number of individual forecasts or analysts contributing to the consensus estimate.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataSourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Data Source Identifier' ;
    rdfs:comment 'Unique identifier or ticker symbol used by the data source to reference this indicator (e.g., Bloomberg ticker, FactSet mnemonic).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ingestionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Ingestion Timestamp' ;
    rdfs:comment 'Timestamp when this observation record was ingested into the lakehouse platform.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:isAnnualized rdf:type rdf:Property ;
    rdfs:label 'Is Annualized' ;
    rdfs:comment 'Indicates whether the observation value has been annualized for comparability across different reporting periods.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSeasonallyAdjusted rdf:type rdf:Property ;
    rdfs:label 'Is Seasonally Adjusted' ;
    rdfs:comment 'Indicates whether the observation value has been seasonally adjusted to remove cyclical patterns.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:observationDate rdf:type rdf:Property ;
    rdfs:label 'Observation Date' ;
    rdfs:comment 'The date on which this macroeconomic indicator value was observed or reported.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:observationNotes rdf:type rdf:Property ;
    rdfs:label 'Observation Notes' ;
    rdfs:comment 'Free-text notes or commentary from the data source or internal research team regarding this observation.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationStatus rdf:type rdf:Property ;
    rdfs:label 'Observation Status' ;
    rdfs:comment 'Current lifecycle status of this observation record: active for current use, superseded by a revision, deprecated, or deleted.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Observation Timestamp' ;
    rdfs:comment 'Precise timestamp when the observation was recorded or published, including time zone.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:observationType rdf:type rdf:Property ;
    rdfs:label 'Observation Type' ;
    rdfs:comment 'Classification of the observation: actual reported value, preliminary estimate, revised figure, forecast, or external consensus estimate.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:observationValue rdf:type rdf:Property ;
    rdfs:label 'Observation Value' ;
    rdfs:comment 'The numeric value of the macroeconomic indicator at this observation point.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodOverPeriodChange rdf:type rdf:Property ;
    rdfs:label 'Period Over Period Change' ;
    rdfs:comment 'Percentage change in the indicator value compared to the immediately preceding reporting period.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodValue rdf:type rdf:Property ;
    rdfs:label 'Prior Period Value' ;
    rdfs:comment 'The value of this indicator from the immediately preceding reporting period, used for period-over-period analysis.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surprisePercentage rdf:type rdf:Property ;
    rdfs:label 'Surprise Percentage' ;
    rdfs:comment 'Percentage difference between the actual observation value and the consensus estimate.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:surpriseValue rdf:type rdf:Property ;
    rdfs:label 'Surprise Value' ;
    rdfs:comment 'Difference between the actual observation value and the consensus estimate, indicating market surprise.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearOverYearChange rdf:type rdf:Property ;
    rdfs:label 'Year Over Year Change' ;
    rdfs:comment 'Percentage change in the indicator value compared to the same period in the prior year.' ;
    rdfs:domain ind:MacroIndicatorObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditSpreadAssumptionBps rdf:type rdf:Property ;
    rdfs:label 'Credit Spread Assumption Bps' ;
    rdfs:comment 'Assumed credit spread over risk-free rate expressed in basis points for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:economicScenarioDescription rdf:type rdf:Property ;
    rdfs:label 'Economic Scenario Description' ;
    rdfs:comment 'Detailed narrative describing the macroeconomic assumptions, conditions, and rationale underlying the scenario.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityReturnAssumption rdf:type rdf:Property ;
    rdfs:label 'Equity Return Assumption' ;
    rdfs:comment 'Assumed annual equity market return expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxVolatilityAssumption rdf:type rdf:Property ;
    rdfs:label 'Fx Volatility Assumption' ;
    rdfs:comment 'Assumed foreign exchange market volatility expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gdpGrowthRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Gdp Growth Rate Assumption' ;
    rdfs:comment 'Assumed annual GDP growth rate expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geopoliticalRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Geopolitical Risk Level' ;
    rdfs:comment 'Qualitative assessment of geopolitical risk embedded in the scenario assumptions.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsTrajectory rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Trajectory' ;
    rdfs:comment 'Narrative description of the assumed greenhouse gas emissions path under this scenario.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureReturnAssumption rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Return Assumption' ;
    rdfs:comment 'Assumed annual infrastructure asset class return expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Assumption' ;
    rdfs:comment 'Assumed benchmark interest rate level expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:privateEquityReturnAssumption rdf:type rdf:Property ;
    rdfs:label 'Private Equity Return Assumption' ;
    rdfs:comment 'Assumed annual private equity asset class return expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityWeight rdf:type rdf:Property ;
    rdfs:label 'Probability Weight' ;
    rdfs:comment 'Subjective probability or weighting assigned to the scenario for use in expected value calculations and portfolio construction.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realEstateReturnAssumption rdf:type rdf:Property ;
    rdfs:label 'Real Estate Return Assumption' ;
    rdfs:comment 'Assumed annual real estate asset class return expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryEnvironment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Environment' ;
    rdfs:comment 'Description of the assumed regulatory and policy environment under this scenario.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioOwner rdf:type rdf:Property ;
    rdfs:label 'Scenario Owner' ;
    rdfs:comment 'Name or identifier of the research team member or group responsible for maintaining the scenario.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceModel rdf:type rdf:Property ;
    rdfs:label 'Source Model' ;
    rdfs:comment 'Name or identifier of the proprietary or third-party macroeconomic model used to generate the scenario.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizonYears rdf:type rdf:Property ;
    rdfs:label 'Time Horizon Years' ;
    rdfs:comment 'Number of years into the future that the scenario projects, defining the temporal scope of the analysis.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:unemploymentRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Unemployment Rate Assumption' ;
    rdfs:comment 'Assumed unemployment rate expressed as a decimal for the scenario period.' ;
    rdfs:domain ind:EconomicScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scenarioAssumptionId rdf:type rdf:Property ;
    rdfs:label 'Scenario Assumption Id' ;
    rdfs:comment 'Unique identifier for the scenario assumption record.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assumptionName rdf:type rdf:Property ;
    rdfs:label 'Assumption Name' ;
    rdfs:comment 'Human-readable name or label for this specific assumption within the scenario.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assumptionNotes rdf:type rdf:Property ;
    rdfs:label 'Assumption Notes' ;
    rdfs:comment 'Additional free-text notes, caveats, or qualifications related to this assumption, capturing nuances not covered by structured fields.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assumptionRationale rdf:type rdf:Property ;
    rdfs:label 'Assumption Rationale' ;
    rdfs:comment 'Textual explanation of the economic reasoning, market conditions, or research insights that justify this assumption.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assumptionType rdf:type rdf:Property ;
    rdfs:label 'Assumption Type' ;
    rdfs:comment 'Classification of the assumption indicating whether it represents a baseline projection, shock event, stress condition, recovery path, optimistic case, or pessimistic case.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkComparison rdf:type rdf:Property ;
    rdfs:label 'Benchmark Comparison' ;
    rdfs:comment 'Benchmark or consensus value for the same indicator and horizon, enabling comparison of the assumption against market consensus or historical averages.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:correlationGroup rdf:type rdf:Property ;
    rdfs:label 'Correlation Group' ;
    rdfs:comment 'Identifier for a group of correlated assumptions, enabling joint scenario modeling where multiple indicators move together.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectedValue rdf:type rdf:Property ;
    rdfs:label 'Projected Value' ;
    rdfs:comment 'The numeric value or level projected for the indicator under this assumption, expressed in the indicators native unit.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectionHorizon rdf:type rdf:Property ;
    rdfs:label 'Projection Horizon' ;
    rdfs:comment 'Time horizon over which this assumption applies: short-term (0-2 years), medium-term (3-5 years), long-term (5+ years), or perpetual.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorScope rdf:type rdf:Property ;
    rdfs:label 'Sector Scope' ;
    rdfs:comment 'Economic sector or industry segment to which this assumption is scoped, such as financials, energy, technology, or real estate.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityFlag rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Flag' ;
    rdfs:comment 'Boolean indicator of whether this assumption is subject to sensitivity analysis or stress testing in portfolio construction and risk management.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:varianceFromBaseline rdf:type rdf:Property ;
    rdfs:label 'Variance From Baseline' ;
    rdfs:comment 'Calculated difference between the projected value and the baseline scenario value, expressed in the same unit of measure.' ;
    rdfs:domain ind:ScenarioAssumption ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:backupFeedAvailableFlag rdf:type rdf:Property ;
    rdfs:label 'Backup Feed Available Flag' ;
    rdfs:comment 'Indicates whether an alternative or backup feed is available for business continuity in case of primary feed failure (True/False).' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessOwnerName rdf:type rdf:Property ;
    rdfs:label 'Business Owner Name' ;
    rdfs:comment 'Name of the business owner or department head accountable for the feed subscription and its business value.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consumingSystems rdf:type rdf:Property ;
    rdfs:label 'Consuming Systems' ;
    rdfs:comment 'Comma-separated list of internal systems that consume data from this feed (e.g., SimCorp Dimension, BlackRock Aladdin, MSCI RiskMetrics, Internal Data Lake).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractRenewalDate rdf:type rdf:Property ;
    rdfs:label 'Contract Renewal Date' ;
    rdfs:comment 'Date when the vendor contract for this feed is due for renewal or renegotiation.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costCurrency rdf:type rdf:Property ;
    rdfs:label 'Cost Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the subscription cost (e.g., USD, GBP).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataClassificationLevel rdf:type rdf:Property ;
    rdfs:label 'Data Classification Level' ;
    rdfs:comment 'Highest data classification level of the content delivered by this feed, per organizational data classification policy.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataContentType rdf:type rdf:Property ;
    rdfs:label 'Data Content Type' ;
    rdfs:comment 'Description of the data content provided by the feed (e.g., pricing, fundamentals, ESG ratings, macroeconomic indicators, risk analytics, performance attribution, fund manager data).' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualitySlaPercentage rdf:type rdf:Property ;
    rdfs:label 'Data Quality Sla Percentage' ;
    rdfs:comment 'Contractual data quality service level agreement percentage guaranteed by the vendor (e.g., 99.5% accuracy).' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataRetentionPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Data Retention Period Days' ;
    rdfs:comment 'Number of days for which historical data from this feed is retained in the organization\'s data lake, per data governance policy.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataStewardName rdf:type rdf:Property ;
    rdfs:label 'Data Steward Name' ;
    rdfs:comment 'Name of the individual or team responsible for managing and governing this feed subscription within the research domain.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryFrequency rdf:type rdf:Property ;
    rdfs:label 'Delivery Frequency' ;
    rdfs:comment 'Frequency at which the feed data is updated or delivered (e.g., Real-Time, Daily, Weekly, Monthly, On-Demand). [ENUM-REF-CANDIDATE: Real-Time|Intraday|Daily|Weekly|Monthly|On-Demand|Continuous Streaming — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Delivery Method' ;
    rdfs:comment 'Technical method by which the feed data is delivered to the organization (e.g., API, FTP, SFTP, Direct Terminal Access, Streaming). [ENUM-REF-CANDIDATE: API|FTP|SFTP|Direct Terminal Access|Managed File Transfer|Web Portal|Streaming|Batch File — 8' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedCode rdf:type rdf:Property ;
    rdfs:label 'Feed Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the feed subscription for operational reference and billing reconciliation.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedCriticality rdf:type rdf:Property ;
    rdfs:label 'Feed Criticality' ;
    rdfs:comment 'Business criticality rating of the feed based on its impact on investment operations, risk management, and regulatory reporting.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Feed Documentation Url' ;
    rdfs:comment 'URL or file path to the vendor-provided technical documentation, data dictionary, or API specification for this feed.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedHealthStatus rdf:type rdf:Property ;
    rdfs:label 'Feed Health Status' ;
    rdfs:comment 'Current operational health status of the feed based on monitoring and data quality checks.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedName rdf:type rdf:Property ;
    rdfs:label 'Feed Name' ;
    rdfs:comment 'Business name of the market data feed subscription (e.g., Bloomberg Terminal Equity Real-Time, FactSet Fixed Income Analytics).' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedStatus rdf:type rdf:Property ;
    rdfs:label 'Feed Status' ;
    rdfs:comment 'Current operational status of the market data feed subscription.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feedType rdf:type rdf:Property ;
    rdfs:label 'Feed Type' ;
    rdfs:comment 'Classification of the feed based on data delivery frequency and purpose (e.g., Real-Time, End-of-Day, Historical, Reference Data, Analytics). [ENUM-REF-CANDIDATE: Real-Time|Delayed|End-of-Day|Intraday|Historical|Reference Data|Analytics|Composite — 8' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastDataRefreshTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Data Refresh Timestamp' ;
    rdfs:comment 'Timestamp of the most recent successful data refresh or delivery from this feed to internal systems.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:lastHealthCheckTimestamp rdf:type rdf:Property ;
    rdfs:label 'Last Health Check Timestamp' ;
    rdfs:comment 'Timestamp of the most recent automated health check or monitoring validation for this feed.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryComplianceScope rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Scope' ;
    rdfs:comment 'Comma-separated list of regulatory frameworks or reporting requirements that this feed supports (e.g., GIPS, SFDR, TCFD, MiFID II).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uptimeSlaPercentage rdf:type rdf:Property ;
    rdfs:label 'Uptime Sla Percentage' ;
    rdfs:comment 'Contractual uptime service level agreement percentage guaranteed by the vendor (e.g., 99.9% availability).' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usageBasedPricingFlag rdf:type rdf:Property ;
    rdfs:label 'Usage Based Pricing Flag' ;
    rdfs:comment 'Indicates whether the feed has usage-based pricing components in addition to the base subscription cost (True/False).' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:userLicenseCount rdf:type rdf:Property ;
    rdfs:label 'User License Count' ;
    rdfs:comment 'Number of named user licenses or concurrent access licenses included in the subscription.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vendorSupportContact rdf:type rdf:Property ;
    rdfs:label 'Vendor Support Contact' ;
    rdfs:comment 'Primary vendor support contact email or phone number for technical and operational issues related to this feed.' ;
    rdfs:domain ind:MarketDataFeed ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataSourceDataVendorId rdf:type rdf:Property ;
    rdfs:label 'Data Source Data Vendor Id' ;
    rdfs:comment 'Reference to the external market data provider or feed system that supplied this snapshot.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DataVendor .

ind:creditSpread rdf:type rdf:Property ;
    rdfs:label 'Credit Spread' ;
    rdfs:comment 'The difference in yield between a corporate bond and a comparable government bond, measured in basis points.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impliedVolatility rdf:type rdf:Property ;
    rdfs:label 'Implied Volatility' ;
    rdfs:comment 'The market forecast of a likely movement in the security price, derived from option prices.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEndOfDay rdf:type rdf:Property ;
    rdfs:label 'Is End Of Day' ;
    rdfs:comment 'Flag indicating whether this snapshot represents end-of-day market data.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:peRatio rdf:type rdf:Property ;
    rdfs:label 'Pe Ratio' ;
    rdfs:comment 'The ratio of the market price per share to earnings per share.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quoteCondition rdf:type rdf:Property ;
    rdfs:label 'Quote Condition' ;
    rdfs:comment 'Code indicating special conditions or qualifiers associated with the quoted price.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ric rdf:type rdf:Property ;
    rdfs:label 'Ric' ;
    rdfs:comment 'Reuters Instrument Code used by Refinitiv for instrument identification.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeCondition rdf:type rdf:Property ;
    rdfs:label 'Trade Condition' ;
    rdfs:comment 'Code indicating special conditions or qualifiers associated with the trade execution.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnover rdf:type rdf:Property ;
    rdfs:label 'Turnover' ;
    rdfs:comment 'The total monetary value of trades executed for the instrument during the session.' ;
    rdfs:domain ind:MarketDataSnapshot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:accuracyMetric rdf:type rdf:Property ;
    rdfs:label 'Accuracy Metric' ;
    rdfs:comment 'Statistical measure used to assess model accuracy, such as Mean Absolute Error (MAE), Root Mean Squared Error (RMSE), R-squared, or hit rate.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accuracyValue rdf:type rdf:Property ;
    rdfs:label 'Accuracy Value' ;
    rdfs:comment 'Numerical value of the accuracy metric from the most recent validation or backtesting exercise.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:calibrationDate rdf:type rdf:Property ;
    rdfs:label 'Calibration Date' ;
    rdfs:comment 'Date when the model was last calibrated or recalibrated using historical data or updated parameters.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:climateScenarioCompatible rdf:type rdf:Property ;
    rdfs:label 'Climate Scenario Compatible' ;
    rdfs:comment 'Indicates whether the model is compatible with climate scenario analysis frameworks such as Task Force on Climate-related Financial Disclosures (TCFD) or Network for Greening the Financial System (NGFS).' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deprecatedDate rdf:type rdf:Property ;
    rdfs:label 'Deprecated Date' ;
    rdfs:comment 'Date when the model was deprecated and removed from active use, if applicable.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:deprecationReason rdf:type rdf:Property ;
    rdfs:label 'Deprecation Reason' ;
    rdfs:comment 'Explanation for why the model was deprecated, such as superseded by a new model, poor predictive performance, or changes in investment strategy.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationSystem rdf:type rdf:Property ;
    rdfs:label 'Integration System' ;
    rdfs:comment 'Name of the operational system or platform where the model outputs are integrated, such as BlackRock Aladdin, SimCorp Dimension, MSCI RiskMetrics, or FactSet.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelComplexityScore rdf:type rdf:Property ;
    rdfs:label 'Model Complexity Score' ;
    rdfs:comment 'Numerical score representing the complexity of the model based on number of variables, computational intensity, and calibration difficulty, typically on a scale of 1 to 10.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:modelOwner rdf:type rdf:Property ;
    rdfs:label 'Model Owner' ;
    rdfs:comment 'Name or identifier of the research team member or department responsible for developing, maintaining, and validating the model.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputFormat rdf:type rdf:Property ;
    rdfs:label 'Output Format' ;
    rdfs:comment 'Description of the models output format, such as forecasted time series, probability distributions, scenario matrices, or risk metrics.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskClassification rdf:type rdf:Property ;
    rdfs:label 'Risk Classification' ;
    rdfs:comment 'Risk rating assigned to the model based on its complexity, sensitivity to assumptions, and potential impact on investment decisions.' ;
    rdfs:domain ind:MacroModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressTestingEnabled rdf:type rdf:Property ;
    rdfs:label 'Stress Testing Enabled' ;
    rdfs:comment 'Indicates whether the model supports macroeconomic stress testing and scenario analysis for risk management purposes.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:convergenceAchieved rdf:type rdf:Property ;
    rdfs:label 'Convergence Achieved' ;
    rdfs:comment 'Indicator of whether the model reached numerical convergence during execution, critical for result validity.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:cvarEstimate rdf:type rdf:Property ;
    rdfs:label 'Cvar Estimate' ;
    rdfs:comment 'Model output representing the estimated Conditional Value at Risk, measuring expected loss beyond the VaR threshold.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxCurrencyPair rdf:type rdf:Property ;
    rdfs:label 'Fx Currency Pair' ;
    rdfs:comment 'Currency pair for which the FX rate projection applies, expressed in standard format such as USD/JPY.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icPresentationFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Presentation Flag' ;
    rdfs:comment 'Indicator of whether this model run output was used in an Investment Committee presentation or decision memo.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impliedEquityRiskPremium rdf:type rdf:Property ;
    rdfs:label 'Implied Equity Risk Premium' ;
    rdfs:comment 'Model-derived equity risk premium, representing the expected excess return of equities over the risk-free rate.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inputParameterCount rdf:type rdf:Property ;
    rdfs:label 'Input Parameter Count' ;
    rdfs:comment 'Number of input parameters supplied to the model for this run, providing metadata on model complexity.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:iterationCount rdf:type rdf:Property ;
    rdfs:label 'Iteration Count' ;
    rdfs:comment 'Number of computational iterations performed before the model reached convergence or termination.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outputMetricCount rdf:type rdf:Property ;
    rdfs:label 'Output Metric Count' ;
    rdfs:comment 'Number of distinct output metrics generated by the model run, indicating the breadth of results produced.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectedCreditSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Projected Credit Spread Bps' ;
    rdfs:comment 'Model output representing the forecasted credit spread over risk-free rates, expressed in basis points.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectedFxRate rdf:type rdf:Property ;
    rdfs:label 'Projected Fx Rate' ;
    rdfs:comment 'Model output representing the forecasted foreign exchange rate for the primary currency pair relevant to this run.' ;
    rdfs:domain ind:MacroModelRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedGdpGrowthRate rdf:type rdf:Property ;
    rdfs:label 'Projected Gdp Growth Rate' ;
    rdfs:comment 'Model output representing the forecasted GDP growth rate, expressed as a decimal proportion.' ;
    rdfs:domain ind:Research ;
    rdf:type owl:DatatypeProperty ;
