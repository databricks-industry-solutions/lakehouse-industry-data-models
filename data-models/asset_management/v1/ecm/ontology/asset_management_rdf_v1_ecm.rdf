    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costBasisMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Basis Method' ;
    rdfs:comment 'Method used to calculate cost basis for tax purposes such as FIFO, LIFO, HIFO, specific identification, or average cost.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Holding Period Days' ;
    rdfs:comment 'Number of days the position has been held from acquisition date for holding period determination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:holdingPeriodType rdf:type rdf:Property ;
    rdfs:label 'Holding Period Type' ;
    rdfs:comment 'Tax classification of holding period as short-term (one year or less) or long-term (more than one year).' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incomeReceived rdf:type rdf:Property ;
    rdfs:label 'Income Received' ;
    rdfs:comment 'Total income received from this tax lot including dividends, interest, and distributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lotReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Lot Reference Number' ;
    rdfs:comment 'External business reference number uniquely identifying this tax lot for reporting and reconciliation.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lotType rdf:type rdf:Property ;
    rdfs:label 'Lot Type' ;
    rdfs:comment 'Classification of the tax lot position type indicating long, short, or covered positions.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalUnits rdf:type rdf:Property ;
    rdfs:label 'Original Units' ;
    rdfs:comment 'Original number of units, shares, or par value acquired when the tax lot was opened.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizedGainLoss rdf:type rdf:Property ;
    rdfs:label 'Realized Gain Loss' ;
    rdfs:comment 'Total realized gain or loss from disposed units in this tax lot.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystem rdf:type rdf:Property ;
    rdfs:label 'Source System' ;
    rdfs:comment 'Name of the operational system from which this tax lot record originated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxLotStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Lot Status' ;
    rdfs:comment 'Current lifecycle status of the tax lot indicating whether the position is open, closed, or partially disposed.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Tax Jurisdiction' ;
    rdfs:comment 'Country or jurisdiction code governing the tax treatment of this lot.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionCosts rdf:type rdf:Property ;
    rdfs:label 'Transaction Costs' ;
    rdfs:comment 'Total transaction costs including commissions and fees incurred when acquiring this tax lot.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unitsDisposed rdf:type rdf:Property ;
    rdfs:label 'Units Disposed' ;
    rdfs:comment 'Total number of units that have been sold or disposed from this tax lot.' ;
    rdfs:domain ind:TaxLot ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedGainLoss rdf:type rdf:Property ;
    rdfs:label 'Unrealized Gain Loss' ;
    rdfs:comment 'Difference between current market value and adjusted cost basis representing unrealized profit or loss.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:washSaleAdjustment rdf:type rdf:Property ;
    rdfs:label 'Wash Sale Adjustment' ;
    rdfs:comment 'Amount of disallowed loss added to cost basis due to wash sale rules.' ;
