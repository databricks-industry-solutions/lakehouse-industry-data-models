ind:parentEntityName rdf:type rdf:Property ;
    rdfs:label 'Parent Entity Name' ;
    rdfs:comment 'The name of the parent or ultimate beneficial owner entity if the tenant is a subsidiary, used for group exposure analysis.' ;
