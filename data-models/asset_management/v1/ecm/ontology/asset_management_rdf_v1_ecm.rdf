    rdfs:domain ind:OtcDerivative ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:markToMarketValue rdf:type rdf:Property ;
    rdfs:label 'Mark To Market Value' ;
    rdfs:comment 'Current fair value of the OTC derivative position based on market prices or valuation models.' ;
