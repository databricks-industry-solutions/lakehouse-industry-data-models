    rdfs:comment 'Identifier of the senior analyst or research director supervising this assignment and responsible for quality assurance.' ;
    rdfs:domain ind:AnalystAssignment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assignmentEndTimestamp rdf:type rdf:Property ;
