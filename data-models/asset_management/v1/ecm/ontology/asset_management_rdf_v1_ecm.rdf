    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:analystName rdf:type rdf:Property ;
    rdfs:label 'Analyst Name' ;
    rdfs:comment 'Full name of the lead equity research analyst responsible for this coverage.' ;
