ind:primaryListingCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Primary Listing Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the issuers primary listed equity securities are denominated and traded.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
