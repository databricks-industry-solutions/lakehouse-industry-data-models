    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentGradeFlag rdf:type rdf:Property ;
    rdfs:label 'Investment Grade Flag' ;
    rdfs:comment 'Boolean indicator of whether the issuer holds investment grade credit ratings (BBB-/Baa3 or higher) from major rating agencies.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
