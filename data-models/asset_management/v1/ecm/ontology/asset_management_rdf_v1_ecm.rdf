ind:marketDataSnapshotId rdf:type rdf:Property ;
    rdfs:label 'Market Data Snapshot Id' ;
    rdfs:comment 'Reference to the market data and position data snapshot used as input for this calculation run.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarketDataSnapshot .

ind:parentRunId rdf:type rdf:Property ;
    rdfs:label 'Parent Run Id' ;
    rdfs:comment 'Reference to the original calculation run if this is a rerun or child run in a hierarchical execution.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CalculationRun .

ind:actualEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual End Timestamp' ;
    rdfs:comment 'Actual date and time when the calculation run execution completed or terminated.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:actualStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Actual Start Timestamp' ;
    rdfs:comment 'Actual date and time when the calculation run execution began.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:errorCount rdf:type rdf:Property ;
    rdfs:label 'Error Count' ;
    rdfs:comment 'Number of errors or exceptions encountered during the calculation run execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:executionDurationSeconds rdf:type rdf:Property ;
    rdfs:label 'Execution Duration Seconds' ;
    rdfs:comment 'Total elapsed time in seconds for the calculation run from start to completion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failureReason rdf:type rdf:Property ;
    rdfs:label 'Failure Reason' ;
    rdfs:comment 'Description of the primary reason for calculation run failure if the run did not complete successfully.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isOfficialRun rdf:type rdf:Property ;
    rdfs:label 'Is Official Run' ;
    rdfs:comment 'Indicates whether this is the official production run for the valuation date versus a test or draft run.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatorySubmission rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Submission' ;
    rdfs:comment 'Indicates whether this calculation run is intended for regulatory reporting submission.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRerun rdf:type rdf:Property ;
    rdfs:label 'Is Rerun' ;
    rdfs:comment 'Indicates whether this calculation run is a rerun of a previous execution due to corrections or updates.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:marketDataVersion rdf:type rdf:Property ;
    rdfs:label 'Market Data Version' ;
    rdfs:comment 'Version identifier of the market data set used for pricing and risk factor inputs.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:outputFilePath rdf:type rdf:Property ;
    rdfs:label 'Output File Path' ;
    rdfs:comment 'File system or storage path where calculation run output files and reports are stored.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runCode rdf:type rdf:Property ;
    rdfs:label 'Run Code' ;
    rdfs:comment 'Business-readable alphanumeric code uniquely identifying the calculation run for external reference and audit trails.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runName rdf:type rdf:Property ;
    rdfs:label 'Run Name' ;
    rdfs:comment 'Descriptive name assigned to the calculation run for identification in reports and dashboards.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runPriority rdf:type rdf:Property ;
    rdfs:label 'Run Priority' ;
    rdfs:comment 'Execution priority level determining resource allocation and processing order in the calculation queue.' ;
    rdfs:domain ind:CalculationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runType rdf:type rdf:Property ;
    rdfs:label 'Run Type' ;
    rdfs:comment 'Classification of the calculation run purpose such as scheduled production, ad-hoc analysis, regulatory submission, or stress testing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioSetCode rdf:type rdf:Property ;
    rdfs:label 'Scenario Set Code' ;
    rdfs:comment 'Reference to the set of stress scenarios or macroeconomic scenarios applied in this calculation run.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:scheduledStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Timestamp' ;
    rdfs:comment 'Planned start date and time for the calculation run execution.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:warningCount rdf:type rdf:Property ;
    rdfs:label 'Warning Count' ;
    rdfs:comment 'Number of warnings or data quality issues flagged during the calculation run execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByUserActorId rdf:type rdf:Property ;
    rdfs:label 'Approved By User Actor Id' ;
    rdfs:comment 'Reference to the senior risk officer or committee member who approved the stress test run results.' ;
    rdfs:domain ind:Risk ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:breachThresholdExceeded rdf:type rdf:Property ;
    rdfs:label 'Breach Threshold Exceeded' ;
    rdfs:comment 'Indicates whether the stress test results exceeded predefined risk tolerance thresholds.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:counterpartyDefaultRate rdf:type rdf:Property ;
    rdfs:label 'Counterparty Default Rate' ;
    rdfs:comment 'Assumed default rate for counterparty credit risk assessment in the stress scenario.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityHaircutPercent rdf:type rdf:Property ;
    rdfs:label 'Liquidity Haircut Percent' ;
    rdfs:comment 'Percentage haircut applied to illiquid assets to reflect potential liquidation costs under stress.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pnlImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Pnl Impact Amount' ;
    rdfs:comment 'Estimated profit or loss impact from the stress scenario, calculated as stressed NAV minus base NAV.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pnlImpactPercent rdf:type rdf:Property ;
    rdfs:label 'Pnl Impact Percent' ;
    rdfs:comment 'Percentage change in portfolio value resulting from the stress scenario relative to base NAV.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioNavBase rdf:type rdf:Property ;
    rdfs:label 'Portfolio Nav Base' ;
    rdfs:comment 'Net Asset Value of the portfolio at the valuation date before applying stress scenario, in base currency.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatorySubmissionRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Required' ;
    rdfs:comment 'Indicates whether this stress test run is part of a regulatory reporting requirement.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:runEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run End Timestamp' ;
    rdfs:comment 'Timestamp when the stress test run execution completed or terminated.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:runStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Run Start Timestamp' ;
    rdfs:comment 'Timestamp when the stress test run execution began processing.' ;
    rdfs:domain ind:StressTestRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:christoffersenPValue rdf:type rdf:Property ;
    rdfs:label 'Christoffersen P Value' ;
    rdfs:comment 'Statistical p-value from the Christoffersen independence test for exception clustering analysis.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:christoffersenTestResult rdf:type rdf:Property ;
    rdfs:label 'Christoffersen Test Result' ;
    rdfs:comment 'Outcome of the Christoffersen conditional coverage test assessing exception clustering.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:errorMessage rdf:type rdf:Property ;
    rdfs:label 'Error Message' ;
    rdfs:comment 'Descriptive error message captured if the validation run failed or encountered issues during execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionThreshold rdf:type rdf:Property ;
    rdfs:label 'Exception Threshold' ;
    rdfs:comment 'Maximum allowable number of exceptions before the model is flagged for review under regulatory guidelines.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kupiecPofPValue rdf:type rdf:Property ;
    rdfs:label 'Kupiec Pof P Value' ;
    rdfs:comment 'Statistical p-value from the Kupiec proportion of failures test for model validation.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kupiecPofTestResult rdf:type rdf:Property ;
    rdfs:label 'Kupiec Pof Test Result' ;
    rdfs:comment 'Outcome of the Kupiec unconditional coverage test for backtesting VaR model accuracy.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:missingDataPercentage rdf:type rdf:Property ;
    rdfs:label 'Missing Data Percentage' ;
    rdfs:comment 'Percentage of required data points that were missing or imputed during the validation run.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelMultiplier rdf:type rdf:Property ;
    rdfs:label 'Model Multiplier' ;
    rdfs:comment 'Regulatory capital multiplier applied based on backtesting results, ranging from 3.0 to 4.0 under Basel guidelines.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:observationEndDate rdf:type rdf:Property ;
    rdfs:label 'Observation End Date' ;
    rdfs:comment 'Ending date of the historical data window used in the validation analysis.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:observationStartDate rdf:type rdf:Property ;
    rdfs:label 'Observation Start Date' ;
    rdfs:comment 'Beginning date of the historical data window used in the validation analysis.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallValidationResult rdf:type rdf:Property ;
    rdfs:label 'Overall Validation Result' ;
    rdfs:comment 'Aggregate outcome of all validation tests determining model fitness for continued use.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorySubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Submission Flag' ;
    rdfs:comment 'Indicates whether this validation run is intended for regulatory reporting submission.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:validationRunStatus rdf:type rdf:Property ;
    rdfs:label 'Validation Run Status' ;
    rdfs:comment 'Current lifecycle state of the validation run execution process.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalExceptionsCount rdf:type rdf:Property ;
    rdfs:label 'Total Exceptions Count' ;
    rdfs:comment 'Number of backtesting exceptions or breaches identified during the validation run.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalMarketValueBase rdf:type rdf:Property ;
    rdfs:label 'Total Market Value Base' ;
    rdfs:comment 'Aggregate market value of positions validated expressed in the base currency.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalPositionsValidated rdf:type rdf:Property ;
    rdfs:label 'Total Positions Validated' ;
    rdfs:comment 'Count of individual portfolio positions included in the validation run scope.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trafficLightZone rdf:type rdf:Property ;
    rdfs:label 'Traffic Light Zone' ;
    rdfs:comment 'Basel traffic light classification indicating model performance based on exception count relative to thresholds.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationMethodology rdf:type rdf:Property ;
    rdfs:label 'Validation Methodology' ;
    rdfs:comment 'The statistical or analytical methodology applied during validation such as historical simulation, Monte Carlo, or parametric approaches.' ;
    rdfs:domain ind:ValidationRun ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorIcObservationId rdf:type rdf:Property ;
    rdfs:label 'Factor Ic Observation Id' ;
    rdfs:comment 'Unique identifier for the factor ic observation record (factor ic observation id).' ;
    rdfs:domain ind:FactorIcObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:informationCoefficient rdf:type rdf:Property ;
    rdfs:label 'Information Coefficient' ;
    rdfs:comment 'Information coefficient measuring the correlation between the factor signal and subsequent realized returns for this observation.' ;
    rdfs:domain ind:FactorIcObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:universeSize rdf:type rdf:Property ;
    rdfs:label 'Universe Size' ;
    rdfs:comment 'The universe size of the factor ic observation.' ;
    rdfs:domain ind:FactorIcObservation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:factorSignalPredictionId rdf:type rdf:Property ;
    rdfs:label 'Factor Signal Prediction Id' ;
    rdfs:comment 'Primary key identifier for the factor signal prediction record.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:directionCorrectFlag rdf:type rdf:Property ;
    rdfs:label 'Direction Correct Flag' ;
    rdfs:comment 'Indicator for direction correct flag on the factor signal prediction.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:predictedDirection rdf:type rdf:Property ;
    rdfs:label 'Predicted Direction' ;
    rdfs:comment 'The predicted direction of the factor signal prediction.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:predictionDate rdf:type rdf:Property ;
    rdfs:label 'Prediction Date' ;
    rdfs:comment 'Prediction date of the factor signal prediction.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:realizedReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Realized Return Percent' ;
    rdfs:comment 'The realized return percent of the factor signal prediction.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signalValue rdf:type rdf:Property ;
    rdfs:label 'Signal Value' ;
    rdfs:comment 'The signal value of the factor signal prediction.' ;
    rdfs:domain ind:FactorSignalPrediction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategyBacktestResultId rdf:type rdf:Property ;
    rdfs:label 'Strategy Backtest Result Id' ;
    rdfs:comment 'Surrogate primary key.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sampleType rdf:type rdf:Property ;
    rdfs:label 'Sample Type' ;
    rdfs:comment 'Sample type: in_sample, out_of_sample.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:simulatedDrawdownPercent rdf:type rdf:Property ;
    rdfs:label 'Simulated Drawdown Percent' ;
    rdfs:comment 'Simulated drawdown percent, stored as a negative number.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:simulatedPnlAmount rdf:type rdf:Property ;
    rdfs:label 'Simulated Pnl Amount' ;
    rdfs:comment 'Simulated PnL amount.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:simulatedReturnPercent rdf:type rdf:Property ;
    rdfs:label 'Simulated Return Percent' ;
    rdfs:comment 'Simulated return percent.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vintageDate rdf:type rdf:Property ;
    rdfs:label 'Vintage Date' ;
    rdfs:comment 'Backtest start or signal activation date.' ;
    rdfs:domain ind:StrategyBacktestResult ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:factorIcCorrelationId rdf:type rdf:Property ;
    rdfs:label 'Factor Ic Correlation Id' ;
    rdfs:comment 'Surrogate primary key.' ;
    rdfs:domain ind:FactorIcCorrelation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pairedFactorId rdf:type rdf:Property ;
    rdfs:label 'Paired Factor Id' ;
    rdfs:comment 'FK to risk.factor, the second factor of the pair.' ;
    rdfs:domain ind:FactorIcCorrelation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Factor .

ind:correlationValue rdf:type rdf:Property ;
    rdfs:label 'Correlation Value' ;
    rdfs:comment 'Correlation value between -1 and 1.' ;
    rdfs:domain ind:FactorIcCorrelation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:emissionsDataSource rdf:type rdf:Property ;
    rdfs:label 'Emissions Data Source' ;
    rdfs:comment 'Indicates whether the issuer\'s GHG emissions data is directly reported by the issuer, estimated by the rating provider, or modeled. Affects data quality weighting in TCFD and SFDR disclosures.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementPriorityFlag rdf:type rdf:Property ;
    rdfs:label 'Engagement Priority Flag' ;
    rdfs:comment 'Indicates whether the issuer has been designated as a priority for active ESG engagement by the responsible investment stewardship team, based on ESG rating, controversy level, or portfolio weight.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalScore rdf:type rdf:Property ;
    rdfs:label 'Environmental Score' ;
    rdfs:comment 'Numeric score for the Environmental pillar of the ESG rating, covering climate change, natural resources, pollution, and environmental opportunities. Sourced from MSCI ESG Ratings.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgControversyLevel rdf:type rdf:Property ;
    rdfs:label 'Esg Controversy Level' ;
    rdfs:comment 'Categorical severity level of ESG controversies for the issuer per MSCI methodology (0–10 scale mapped to levels). Used in exclusion screening and engagement prioritization workflows.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgControversyScore rdf:type rdf:Property ;
    rdfs:label 'Esg Controversy Score' ;
    rdfs:comment 'Numeric score reflecting the severity of ESG-related controversies involving the issuer, sourced from MSCI ESG Controversy Scores. High controversy scores may trigger exclusion list review.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgDataCoveragePct rdf:type rdf:Property ;
    rdfs:label 'Esg Data Coverage Pct' ;
    rdfs:comment 'Percentage of ESG key issues for which underlying data is available for this issuer, as reported by the rating provider. Indicates data completeness and reliability of the ESG rating.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgRatingCategory rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Category' ;
    rdfs:comment 'Broad categorical classification of the issuer\'s ESG performance: Leader (AAA–AA), Average (A–BBB–BB), or Laggard (B–CCC). Used for portfolio-level ESG reporting and SAA constraints.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingGrade rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Grade' ;
    rdfs:comment 'Letter-grade ESG rating assigned by the provider (e.g., MSCI scale: AAA to CCC). Represents the issuer\'s ESG risk category used in investment screening, exclusion lists, and SFDR classification.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingMethodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Methodology Version' ;
    rdfs:comment 'Version identifier of the ESG rating methodology applied by the provider (e.g., MSCI ESG Ratings v3.1). Required for audit trail and to identify ratings produced under different methodology vintages.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingScore rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Score' ;
    rdfs:comment 'Numeric ESG score assigned by the rating provider, typically on a 0–10 scale for MSCI. Represents the issuer\'s overall ESG risk management performance used in portfolio construction and IC reporting.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:governanceScore rdf:type rdf:Property ;
    rdfs:label 'Governance Score' ;
    rdfs:comment 'Numeric score for the Governance pillar of the ESG rating, covering corporate governance, corporate behavior, and board structure. Sourced from MSCI ESG Ratings.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:industryAdjustedScore rdf:type rdf:Property ;
    rdfs:label 'Industry Adjusted Score' ;
    rdfs:comment 'ESG score normalized relative to the issuer\'s GICS industry peer group, enabling cross-sector comparison. Used in BlackRock Aladdin ESG analytics for relative ESG positioning within sector allocations.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalEsgOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Esg Override Flag' ;
    rdfs:comment 'Indicates whether the pension fund\'s internal ESG team has applied an override to the external provider\'s rating based on proprietary due diligence or investment committee decision.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalEsgOverrideGrade rdf:type rdf:Property ;
    rdfs:label 'Internal Esg Override Grade' ;
    rdfs:comment 'The internally assigned ESG rating grade when the internal team overrides the external provider\'s rating. Null if no override is applied. Used in IC reporting and investment decision documentation.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leiCode rdf:type rdf:Property ;
    rdfs:label 'Lei Code' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier uniquely identifying the issuer globally. Used for cross-system reconciliation and regulatory reporting under EMIR and MiFID II.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netZeroTargetFlag rdf:type rdf:Property ;
    rdfs:label 'Net Zero Target Flag' ;
    rdfs:comment 'Indicates whether the issuer has publicly committed to a net-zero GHG emissions target. Used in portfolio net-zero alignment analysis and TCFD transition risk assessment.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onExclusionList rdf:type rdf:Property ;
    rdfs:label 'On Exclusion List' ;
    rdfs:comment 'Indicates whether the issuer is currently on the pension fund\'s internal exclusion list, prohibiting new investment. Driven by ESG screening, UNGC non-compliance, or IC-approved exclusion decisions.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorEsgRatingGrade rdf:type rdf:Property ;
    rdfs:label 'Prior Esg Rating Grade' ;
    rdfs:comment 'The issuer\'s ESG rating grade from the immediately preceding rating cycle. Used to identify rating upgrades or downgrades and assess ESG momentum for engagement prioritization.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVotingPolicyAlignment rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Policy Alignment' ;
    rdfs:comment 'Assessment of the issuer\'s governance practices alignment with the pension fund\'s proxy voting policy. Used in stewardship reporting and annual proxy voting disclosure to beneficiaries.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingChangeDirection rdf:type rdf:Property ;
    rdfs:label 'Rating Change Direction' ;
    rdfs:comment 'Direction of change from the prior ESG rating grade to the current grade. Upgrade or Downgrade triggers internal review and potential engagement action per the responsible investment stewardship policy.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingDate rdf:type rdf:Property ;
    rdfs:label 'Rating Date' ;
    rdfs:comment 'The date on which the ESG rating was officially assigned or last updated by the rating provider. Used to determine rating currency and trigger review workflows in BlackRock Aladdin.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Rating Expiry Date' ;
    rdfs:comment 'Date on which this ESG rating version expires or is superseded by a new rating. Null if the rating remains current. Used to manage rating staleness and trigger re-assessment workflows.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingProvider rdf:type rdf:Property ;
    rdfs:label 'Rating Provider' ;
    rdfs:comment 'Organization that produced the ESG rating. Primary source is MSCI ESG Ratings via MSCI RiskMetrics and Barra; supplemented by internal assessments. [ENUM-REF-CANDIDATE: MSCI|Sustainalytics|ISS ESG|Bloomberg ESG|Internal|Refinitiv|S&P Global ESG — promote' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingStatus rdf:type rdf:Property ;
    rdfs:label 'Rating Status' ;
    rdfs:comment 'Current lifecycle status of this ESG rating record. Active ratings are used in portfolio analytics; Superseded records are retained for historical point-in-time analysis and GIPS compliance.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope1Emissions rdf:type rdf:Property ;
    rdfs:label 'Scope1 Emissions' ;
    rdfs:comment 'Issuer\'s direct Scope 1 GHG emissions in tonnes of CO2 equivalent, as reported or estimated. Required for TCFD climate risk disclosure and SFDR Principal Adverse Impact (PAI) indicator reporting.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope2Emissions rdf:type rdf:Property ;
    rdfs:label 'Scope2 Emissions' ;
    rdfs:comment 'Issuer\'s indirect Scope 2 GHG emissions from purchased energy in tonnes of CO2 equivalent. Required for TCFD climate risk disclosure and SFDR PAI indicator reporting.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope3Emissions rdf:type rdf:Property ;
    rdfs:label 'Scope3 Emissions' ;
    rdfs:comment 'Issuer\'s value chain Scope 3 GHG emissions in tonnes of CO2 equivalent. Used in portfolio-level financed emissions calculations and net-zero pathway alignment assessments per TCFD.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sfdrPaiFlag rdf:type rdf:Property ;
    rdfs:label 'Sfdr Pai Flag' ;
    rdfs:comment 'Indicates whether this issuer contributes to one or more SFDR Principal Adverse Impact indicators at the portfolio level. True triggers inclusion in mandatory PAI statement disclosures.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:socialScore rdf:type rdf:Property ;
    rdfs:label 'Social Score' ;
    rdfs:comment 'Numeric score for the Social pillar of the ESG rating, covering human capital, product liability, stakeholder opposition, and social opportunities. Sourced from MSCI ESG Ratings.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceSystemRatingCode rdf:type rdf:Property ;
    rdfs:label 'Source System Rating Code' ;
    rdfs:comment 'Native identifier of this ESG rating record in the originating source system (e.g., MSCI ESG Ratings platform or BlackRock Aladdin ESG module). Used for upstream reconciliation and data lineage tracing.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdAlignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Tcfd Alignment Status' ;
    rdfs:comment 'Assessment of the issuer\'s climate-related financial disclosures against TCFD recommendations. Used in portfolio-level TCFD reporting and climate risk integration into investment decisions.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ungcComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ungc Compliance Status' ;
    rdfs:comment 'Issuer\'s compliance status with the UN Global Compact principles covering human rights, labor, environment, and anti-corruption. Non-compliant issuers are candidates for exclusion list review per PRI commitments.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weaponsInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Weapons Involvement Flag' ;
    rdfs:comment 'Indicates whether the issuer is involved in the manufacture or sale of controversial weapons (cluster munitions, anti-personnel mines, biological/chemical weapons). Triggers mandatory exclusion screening.' ;
    rdfs:domain ind:IssuerEsgRating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:abbreviation rdf:type rdf:Property ;
    rdfs:label 'Abbreviation' ;
    rdfs:comment 'Widely recognised acronym or abbreviation for the framework (e.g., PRI, SFDR, TCFD, GRI). Distinct from code where the code may include versioning or internal suffixes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:adoptionStatus rdf:type rdf:Property ;
    rdfs:label 'Adoption Status' ;
    rdfs:comment 'Current lifecycle status of the framework within the fund\'s ESG programme: adopted (in active use), under_review (being assessed), pending_adoption, superseded (replaced by newer version), withdrawn, or not_applicable.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Applicable Jurisdiction' ;
    rdfs:comment 'Geographic or regulatory jurisdiction(s) where the framework applies or is mandated (e.g., \'EU\', \'GBR\', \'CAN\', \'Global\'). Pipe-delimited ISO 3166-1 alpha-3 codes or \'Global\' for universal frameworks.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentScore rdf:type rdf:Property ;
    rdfs:label 'Assessment Score' ;
    rdfs:comment 'Quantitative compliance assessment score for this framework-obligation combination, typically 0-100' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assuranceProvider rdf:type rdf:Property ;
    rdfs:label 'Assurance Provider' ;
    rdfs:comment 'Name of the external assurance or audit firm engaged to verify the fund\'s compliance disclosures under this framework (e.g., \'PwC\', \'Deloitte\', \'EY\'). Null if external assurance is not required or not yet engaged.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkAlignment rdf:type rdf:Property ;
    rdfs:label 'Benchmark Alignment' ;
    rdfs:comment 'Name of any ESG benchmark, index, or reference portfolio aligned to this framework (e.g., \'Paris-Aligned Benchmark\', \'EU Climate Transition Benchmark\', \'MSCI ESG Leaders Index\'). Null if no benchmark alignment.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateRelated rdf:type rdf:Property ;
    rdfs:label 'Climate Related' ;
    rdfs:comment 'Indicates whether this framework specifically addresses climate-related financial risks and disclosures (True), such as TCFD, TNFD, SFDR PAI climate indicators, or GHG reporting standards.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:frameworkCode rdf:type rdf:Property ;
    rdfs:label 'Framework Code' ;
    rdfs:comment 'Short, unique alphanumeric code identifying the ESG framework (e.g., PRI, SFDR, TCFD, UNGC, SASB, GRI, TNFD). Used as the business key across systems and reporting outputs.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceCategory rdf:type rdf:Property ;
    rdfs:label 'Compliance Category' ;
    rdfs:comment 'Categorises the basis of the fund\'s obligation to the framework: regulatory (legally mandated), voluntary (self-elected commitment), best_practice (industry norm), or contractual (required by LPA or mandate terms).' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceScore rdf:type rdf:Property ;
    rdfs:label 'Compliance Score' ;
    rdfs:comment 'Numeric score (0.00–100.00) representing the fund\'s assessed level of compliance or alignment with this framework at the last assessment date. Sourced from internal ESG assessments or PRI assessment results.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:engagementApplicable rdf:type rdf:Property ;
    rdfs:label 'Engagement Applicable' ;
    rdfs:comment 'Indicates whether this framework requires or recommends active engagement with investee companies or external fund managers on ESG matters (True). Supports engagement activity logging and stewardship reporting.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionListApplicable rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Applicable' ;
    rdfs:comment 'Indicates whether this framework mandates or recommends maintaining an investment exclusion list (e.g., controversial weapons under UNGC, fossil fuel exclusions under certain SFDR Article 9 mandates).' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalAssuranceRequired rdf:type rdf:Property ;
    rdfs:label 'External Assurance Required' ;
    rdfs:comment 'Indicates whether the framework requires or recommends third-party external assurance or audit of the fund\'s disclosures (True). Relevant for GRI, SFDR RTS, and TCFD-aligned reporting.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalReferenceUrl rdf:type rdf:Property ;
    rdfs:label 'External Reference Url' ;
    rdfs:comment 'Official URL to the governing body\'s published framework documentation, standard text, or regulatory guidance. Enables direct access to source material for compliance and due diligence teams.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:frameworkType rdf:type rdf:Property ;
    rdfs:label 'Framework Type' ;
    rdfs:comment 'Categorical classification of the ESG framework by its nature: regulatory regime (SFDR, EMIR), voluntary principle (PRI, UNGC), disclosure framework (TCFD, TNFD), reporting standard (GRI, SASB), or rating methodology (MSCI ESG).' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Ghg Reporting Required' ;
    rdfs:comment 'Indicates whether the framework mandates or recommends Greenhouse Gas (GHG) emissions reporting (Scope 1, 2, or 3) as part of the fund\'s disclosure obligations.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:governingBody rdf:type rdf:Property ;
    rdfs:label 'Governing Body' ;
    rdfs:comment 'Name of the organisation or regulatory authority that owns, maintains, and publishes the framework (e.g., \'UN PRI Association\', \'European Commission\', \'TCFD Secretariat / IFRS Foundation\', \'GRI Standards Board\').' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrationLevel rdf:type rdf:Property ;
    rdfs:label 'Integration Level' ;
    rdfs:comment 'Degree to which this framework is integrated into the fund\'s investment decision-making process: full (embedded in IC process), partial (considered but not binding), monitoring_only, or not_integrated.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialityApproach rdf:type rdf:Property ;
    rdfs:label 'Materiality Approach' ;
    rdfs:comment 'Materiality concept applied by the framework: single_materiality (financial impact on the fund), double_materiality (financial + societal/environmental impact), dynamic_materiality, or not_specified. Relevant for GRI vs SASB vs SFDR.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paiIndicatorRequired rdf:type rdf:Property ;
    rdfs:label 'Pai Indicator Required' ;
    rdfs:comment 'Indicates whether the framework requires disclosure of Principal Adverse Impact (PAI) indicators on sustainability factors, as defined under SFDR Article 7 and Regulatory Technical Standards.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priModule rdf:type rdf:Property ;
    rdfs:label 'Pri Module' ;
    rdfs:comment 'Specific PRI Transparency Report module(s) associated with this framework (e.g., \'Strategy & Governance\', \'Listed Equity\', \'Private Equity\', \'Infrastructure\'). Null if framework is not PRI-related.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVotingApplicable rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Applicable' ;
    rdfs:comment 'Indicates whether this framework includes requirements or guidance on proxy voting and shareholder engagement stewardship activities (True). Relevant for PRI, UK Stewardship Code, and similar frameworks.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportingDeadlineMonth rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline Month' ;
    rdfs:comment 'Calendar month (1–12) by which the fund\'s annual or periodic disclosure under this framework must be submitted to the governing body or published publicly. Supports ESG reporting calendar management.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:signatoryDate rdf:type rdf:Property ;
    rdfs:label 'Signatory Date' ;
    rdfs:comment 'Date on which the fund formally became a signatory to the framework or voluntary principle. Null if the fund is not a signatory. Relevant for PRI, UNGC, TCFD supporter declarations.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:signatoryStatus rdf:type rdf:Property ;
    rdfs:label 'Signatory Status' ;
    rdfs:comment 'The fund\'s formal signatory status with the framework\'s governing body: signatory (committed member), non_signatory, pending (application submitted), or former_signatory (previously committed, now withdrawn).' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyAlignment rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Alignment' ;
    rdfs:comment 'Sustainable finance taxonomy to which this framework aligns for classifying environmentally sustainable economic activities (e.g., EU Taxonomy Regulation, UK Green Taxonomy, ASEAN Taxonomy). Supports SFDR and TCFD reporting.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdPillar rdf:type rdf:Property ;
    rdfs:label 'Tcfd Pillar' ;
    rdfs:comment 'TCFD disclosure pillar addressed by this framework: Governance, Strategy, Risk Management, or Metrics and Targets. Null or not_applicable for non-TCFD frameworks. Supports TCFD alignment mapping.' ;
    rdfs:domain ind:Framework ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supersededPolicyEsgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Superseded Policy Esg Policy Id' ;
    rdfs:comment 'Identifier of the previous policy version that this policy replaces.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:baselineYear rdf:type rdf:Property ;
    rdfs:label 'Baseline Year' ;
    rdfs:comment 'Reference year for measuring progress against climate or ESG targets (e.g., 2020, 2019).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachEscalationProcedure rdf:type rdf:Property ;
    rdfs:label 'Breach Escalation Procedure' ;
    rdfs:comment 'Description of the procedure to follow when a policy breach is detected (e.g., notify IC, divest within 90 days, escalate to Board).' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateAlignmentTarget rdf:type rdf:Property ;
    rdfs:label 'Climate Alignment Target' ;
    rdfs:comment 'Specific climate-related target or commitment defined by the policy (e.g., net-zero by 2050, Paris Agreement alignment, 1.5°C pathway).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyCode rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Code' ;
    rdfs:comment 'Externally-known unique code for the policy (e.g., RIP-2024, EXCL-POL-01, PROXY-V3).' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceMonitoringMethod rdf:type rdf:Property ;
    rdfs:label 'Compliance Monitoring Method' ;
    rdfs:comment 'Method used to monitor compliance with the policy (automated system checks, manual review, or hybrid approach).' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementMandate rdf:type rdf:Property ;
    rdfs:label 'Engagement Mandate' ;
    rdfs:comment 'Indicates whether the policy mandates active engagement with portfolio companies on ESG issues.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgPolicyStatus rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Status' ;
    rdfs:comment 'Current lifecycle status of the policy within the governance framework.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyType rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Type' ;
    rdfs:comment 'Classification of the policy by its primary ESG (Environmental, Social, and Governance) focus area.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAuditRequired rdf:type rdf:Property ;
    rdfs:label 'External Audit Required' ;
    rdfs:comment 'Indicates whether compliance with the policy requires external third-party audit or verification.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghgReductionTargetPct rdf:type rdf:Property ;
    rdfs:label 'Ghg Reduction Target Pct' ;
    rdfs:comment 'Target percentage reduction in portfolio GHG emissions intensity or absolute emissions as defined by the policy.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Legal Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the primary legal jurisdiction governing the policy (e.g., CAN, USA, GBR).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyName rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Name' ;
    rdfs:comment 'Full official name of the responsible investment policy (e.g., Responsible Investment Policy, Climate Change Policy, Exclusion Policy).' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAuditDate rdf:type rdf:Property ;
    rdfs:label 'Next Audit Date' ;
    rdfs:comment 'Scheduled date for the next audit of policy compliance.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyVotingMandate rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Mandate' ;
    rdfs:comment 'Indicates whether the policy mandates proxy voting on ESG-related shareholder resolutions.' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Public Disclosure Required' ;
    rdfs:comment 'Indicates whether the policy or its compliance metrics must be publicly disclosed.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryAlignment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Alignment' ;
    rdfs:comment 'Comma-separated list of regulatory frameworks the policy aligns with (e.g., SFDR, TCFD, PRI).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relatedPolicyIds rdf:type rdf:Property ;
    rdfs:label 'Related Policy Ids' ;
    rdfs:comment 'Comma-separated list of policy_id values for related or dependent policies (e.g., parent policy, superseded policy).' ;
    rdfs:domain ind:EsgPolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Review Frequency Months' ;
    rdfs:comment 'Number of months between mandatory policy reviews (e.g., 12, 24, 36).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetYear rdf:type rdf:Property ;
    rdfs:label 'Target Year' ;
    rdfs:comment 'Year by which the policy targets or commitments are to be achieved (e.g., 2030, 2050).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:breachResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Breach Resolution Date' ;
    rdfs:comment 'Date on which a detected compliance breach was resolved through divestment, override, or policy amendment.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:controversyLevel rdf:type rdf:Property ;
    rdfs:label 'Controversy Level' ;
    rdfs:comment 'Severity level of ESG controversies associated with the issuer: low, medium, high, or severe, as assessed by ESG data providers or internal due diligence.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divestmentDeadline rdf:type rdf:Property ;
    rdfs:label 'Divestment Deadline' ;
    rdfs:comment 'Target date by which existing holdings of the excluded security must be divested to achieve full compliance with the exclusion policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:divestmentStatus rdf:type rdf:Property ;
    rdfs:label 'Divestment Status' ;
    rdfs:comment 'Current status of divestment for legacy holdings: not applicable (no holdings), pending (divestment planned), in progress (actively divesting), completed (fully divested), or exempted (override granted).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCategory rdf:type rdf:Property ;
    rdfs:label 'Exclusion Category' ;
    rdfs:comment 'Specific category or theme of the exclusion, such as controversial weapons, tobacco, thermal coal, oil sands, human rights violations, or labor rights violations.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionIdentifier rdf:type rdf:Property ;
    rdfs:label 'Exclusion Identifier' ;
    rdfs:comment 'Business-facing unique identifier or code for this exclusion entry, used for external reference and reporting.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Override Flag' ;
    rdfs:comment 'Boolean flag indicating whether an exception or override has been granted for this exclusion, allowing investment despite the exclusion criteria being met.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionScope rdf:type rdf:Property ;
    rdfs:label 'Exclusion Scope' ;
    rdfs:comment 'Asset class or portfolio scope to which this exclusion applies: all portfolios, public equity only, private equity, fixed income, real estate, or infrastructure.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusion Status' ;
    rdfs:comment 'Current lifecycle status of the exclusion entry: active (enforced), suspended (temporarily inactive), expired (no longer valid), under review (being reassessed), pending approval (awaiting IC decision), or revoked (formally withdrawn).' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionType rdf:type rdf:Property ;
    rdfs:label 'Exclusion Type' ;
    rdfs:comment 'Classification of the exclusion basis: norm-based (international norms violations), sector-based (industry exclusion), product-based (specific products), issuer-based (entity-level), geography-based (country/region), or conduct-based (corporate behavior).' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsIntensity rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Intensity' ;
    rdfs:comment 'GHG emissions intensity metric (e.g., tonnes CO2e per million USD revenue) for the issuer, used as a quantitative exclusion criterion for high-carbon emitters.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastHoldingsCheckDate rdf:type rdf:Property ;
    rdfs:label 'Last Holdings Check Date' ;
    rdfs:comment 'Date of the most recent portfolio holdings check to verify compliance with this exclusion across all portfolios and asset classes.' ;
    rdfs:domain ind:ExclusionList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proxyVotingRestriction rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Restriction' ;
    rdfs:comment 'Boolean flag indicating whether proxy voting rights are restricted or prohibited for this excluded security, if still held in legacy positions.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Revenue Threshold Pct' ;
    rdfs:comment 'Revenue exposure threshold percentage that triggers exclusion. For example, companies deriving more than 5% of revenue from thermal coal may be excluded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:securityIdentifierType rdf:type rdf:Property ;
    rdfs:label 'Security Identifier Type' ;
    rdfs:comment 'Type of security identifier used: ISIN (International Securities Identification Number), CUSIP, SEDOL, TICKER, or INTERNAL (proprietary identifier).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdClimateRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Tcfd Climate Risk Flag' ;
    rdfs:comment 'Boolean flag indicating whether the exclusion is driven by TCFD-identified climate-related financial risks, such as transition risk or physical risk exposure.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:unGlobalCompactViolation rdf:type rdf:Property ;
    rdfs:label 'Un Global Compact Violation' ;
    rdfs:comment 'Boolean flag indicating whether the issuer has been identified as violating UN Global Compact principles (human rights, labor, environment, anti-corruption).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sfdrClassificationId rdf:type rdf:Property ;
    rdfs:label 'Sfdr Classification Id' ;
    rdfs:comment 'Unique identifier for the SFDR classification record.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkIsEsgAligned rdf:type rdf:Property ;
    rdfs:label 'Benchmark Is Esg Aligned' ;
    rdfs:comment 'Indicates whether the designated benchmark is itself an ESG or Paris-aligned benchmark as defined under the EU Benchmark Regulation.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:classificationApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Classification Approval Date' ;
    rdfs:comment 'The date on which this SFDR classification was formally approved by the Investment Committee or designated governance body.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:classificationApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Classification Approved By' ;
    rdfs:comment 'Name or identifier of the Investment Committee member or governance body that approved this SFDR classification.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Classification Effective Date' ;
    rdfs:comment 'The date from which this SFDR classification becomes effective and must be disclosed to investors.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:classificationEndDate rdf:type rdf:Property ;
    rdfs:label 'Classification End Date' ;
    rdfs:comment 'The date on which this SFDR classification ceases to be effective, typically due to reclassification or fund closure. Null for currently active classifications.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:classificationRationale rdf:type rdf:Property ;
    rdfs:label 'Classification Rationale' ;
    rdfs:comment 'Detailed business and regulatory rationale explaining why this fund or mandate was assigned this specific SFDR article classification, including reference to investment objectives, ESG integration approach, and sustainability commitments.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataCoveragePercentage rdf:type rdf:Property ;
    rdfs:label 'Data Coverage Percentage' ;
    rdfs:comment 'Percentage of the funds portfolio (by market value or number of holdings) for which ESG data is available to support SFDR classification and PAI disclosures.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:doNoSignificantHarmAssessment rdf:type rdf:Property ;
    rdfs:label 'Do No Significant Harm Assessment' ;
    rdfs:comment 'Summary of the assessment process and conclusion regarding whether the funds sustainable investments do no significant harm to any environmental or social objective, as required under SFDR.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementStrategyApplied rdf:type rdf:Property ;
    rdfs:label 'Engagement Strategy Applied' ;
    rdfs:comment 'Indicates whether an active engagement strategy with investee companies on ESG matters is part of the responsible investment approach for this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalObjectiveAlignment rdf:type rdf:Property ;
    rdfs:label 'Environmental Objective Alignment' ;
    rdfs:comment 'Indicates whether the fund or mandate promotes or has as its objective alignment with one or more environmental objectives as defined under the EU Taxonomy Regulation.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgMethodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Esg Methodology Version' ;
    rdfs:comment 'Version identifier of the ESG assessment methodology or framework applied to determine this SFDR classification and ongoing monitoring.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionPolicyApplied rdf:type rdf:Property ;
    rdfs:label 'Exclusion Policy Applied' ;
    rdfs:comment 'Indicates whether a formal exclusion policy (e.g., fossil fuels, controversial weapons, tobacco) is applied as part of the ESG integration strategy for this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionPolicyDescription rdf:type rdf:Property ;
    rdfs:label 'Exclusion Policy Description' ;
    rdfs:comment 'Detailed description of the exclusion criteria and sectors or activities that are excluded from the investment universe for this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goodGovernanceAssessment rdf:type rdf:Property ;
    rdfs:label 'Good Governance Assessment' ;
    rdfs:comment 'Summary of the assessment process and conclusion regarding whether investee companies follow good governance practices, particularly with respect to sound management structures, employee relations, remuneration of staff, and tax compliance.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumSustainableInvestmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Sustainable Investment Percentage' ;
    rdfs:comment 'For Article 9 funds, the minimum proportion of the portfolio (as a percentage) that must be invested in sustainable investments as defined by SFDR. Null for Article 6 and Article 8 funds unless they commit to a minimum sustainable investment threshold.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paiDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Pai Disclosure Required' ;
    rdfs:comment 'Indicates whether this fund or mandate is required to disclose Principal Adverse Impacts on sustainability factors under SFDR Article 4 or 7.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paiIndicatorsConsidered rdf:type rdf:Property ;
    rdfs:label 'Pai Indicators Considered' ;
    rdfs:comment 'Comma-separated list of PAI indicator codes or names that are considered and disclosed for this fund or mandate, drawn from the mandatory and optional PAI indicators defined in SFDR RTS.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:periodicDisclosureUrl rdf:type rdf:Property ;
    rdfs:label 'Periodic Disclosure Url' ;
    rdfs:comment 'URL or document reference to the periodic (annual) disclosure report that contains the SFDR-mandated sustainability performance and PAI disclosures for this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preContractualDisclosureUrl rdf:type rdf:Property ;
    rdfs:label 'Pre Contractual Disclosure Url' ;
    rdfs:comment 'URL or document reference to the pre-contractual disclosure document (e.g., prospectus annex) that contains the SFDR-mandated sustainability disclosures for this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVotingPolicyApplied rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Policy Applied' ;
    rdfs:comment 'Indicates whether a formal proxy voting policy aligned with ESG principles is applied to portfolio holdings in this fund or mandate.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:socialObjectiveAlignment rdf:type rdf:Property ;
    rdfs:label 'Social Objective Alignment' ;
    rdfs:comment 'Indicates whether the fund or mandate promotes or has as its objective alignment with one or more social objectives as defined under SFDR and related frameworks.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxonomyAlignmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Alignment Percentage' ;
    rdfs:comment 'The percentage of the funds investments that are aligned with the EU Taxonomy for sustainable activities. Required disclosure for Article 8 and Article 9 funds.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:websiteDisclosureUrl rdf:type rdf:Property ;
    rdfs:label 'Website Disclosure Url' ;
    rdfs:comment 'URL to the dedicated website section where SFDR sustainability information for this fund or mandate is published and maintained.' ;
    rdfs:domain ind:SfdrClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netZeroCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Net Zero Commitment Id' ;
    rdfs:comment 'Foreign key linking to esg.net_zero_commitment. Business justification: TCFD disclosures report on net zero commitment progress. The net_zero_commitment_flag and net_zero_target_year are disclosure-specific values, the FK links to the commitment record.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NetZeroCommitment .

ind:assuranceLevel rdf:type rdf:Property ;
    rdfs:label 'Assurance Level' ;
    rdfs:comment 'Level of assurance provided by the external auditor, either limited or reasonable assurance.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardOversightDescription rdf:type rdf:Property ;
    rdfs:label 'Board Oversight Description' ;
    rdfs:comment 'Description of the board\'s oversight of climate-related risks and opportunities, including committee structure and frequency of review.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonFootprintPortfolioTco2ePerMillion rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint Portfolio Tco2e Per Million' ;
    rdfs:comment 'Portfolio-level carbon footprint metric representing financed emissions per million dollars invested, calculated according to PCAF methodology.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:climateOpportunitySummary rdf:type rdf:Property ;
    rdfs:label 'Climate Opportunity Summary' ;
    rdfs:comment 'Summary of climate-related opportunities identified by the organization, including resource efficiency, energy sources, products and services, markets, and resilience.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateRelatedFinancialImpactEstimate rdf:type rdf:Property ;
    rdfs:label 'Climate Related Financial Impact Estimate' ;
    rdfs:comment 'Qualitative or quantitative estimate of the financial impact of climate-related risks and opportunities on the organization\'s financial position and performance.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateRiskIntegrationApproach rdf:type rdf:Property ;
    rdfs:label 'Climate Risk Integration Approach' ;
    rdfs:comment 'Description of how climate-related risks are integrated into the organization\'s overall risk management framework and investment decision-making processes.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateVarEstimate rdf:type rdf:Property ;
    rdfs:label 'Climate Var Estimate' ;
    rdfs:comment 'Estimated potential loss in portfolio value due to climate-related risks under specified scenarios, expressed in monetary terms.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:climateVarMethodology rdf:type rdf:Property ;
    rdfs:label 'Climate Var Methodology' ;
    rdfs:comment 'Description of the methodology and assumptions used to calculate the climate VaR estimate.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Disclosure Status' ;
    rdfs:comment 'Current lifecycle status of the TCFD disclosure submission.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureVersion rdf:type rdf:Property ;
    rdfs:label 'Disclosure Version' ;
    rdfs:comment 'Version identifier for the disclosure document, used to track revisions and amendments.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureYear rdf:type rdf:Property ;
    rdfs:label 'Disclosure Year' ;
    rdfs:comment 'Calendar year in which the TCFD disclosure was published or submitted.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:emissionsIntensityMetric rdf:type rdf:Property ;
    rdfs:label 'Emissions Intensity Metric' ;
    rdfs:comment 'Description of the emissions intensity metric used, such as tCO2e per million dollars of Assets Under Management (AUM) or tCO2e per million dollars of revenue.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionsIntensityValue rdf:type rdf:Property ;
    rdfs:label 'Emissions Intensity Value' ;
    rdfs:comment 'Calculated emissions intensity value based on the specified metric, enabling comparison across periods and peers.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalAssuranceObtained rdf:type rdf:Property ;
    rdfs:label 'External Assurance Obtained' ;
    rdfs:comment 'Indicates whether the TCFD disclosure and underlying climate data have been subject to external third-party assurance or verification.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fossilFuelExposurePct rdf:type rdf:Property ;
    rdfs:label 'Fossil Fuel Exposure Pct' ;
    rdfs:comment 'Percentage of portfolio value exposed to fossil fuel-related assets, used to assess transition risk exposure.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:governanceNarrative rdf:type rdf:Property ;
    rdfs:label 'Governance Narrative' ;
    rdfs:comment 'Textual description of the organization\'s governance around climate-related risks and opportunities, including board oversight and management\'s role.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:greenRevenueAlignmentPct rdf:type rdf:Property ;
    rdfs:label 'Green Revenue Alignment Pct' ;
    rdfs:comment 'Percentage of portfolio companies\' revenues aligned with green or low-carbon activities, as defined by relevant taxonomies such as EU Taxonomy.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interimEmissionsReductionTargetPct rdf:type rdf:Property ;
    rdfs:label 'Interim Emissions Reduction Target Pct' ;
    rdfs:comment 'Interim percentage reduction target for GHG emissions relative to a baseline year, used to track progress toward long-term net-zero goals.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interimTargetYear rdf:type rdf:Property ;
    rdfs:label 'Interim Target Year' ;
    rdfs:comment 'Year by which the interim emissions reduction target is to be achieved.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managementRoleDescription rdf:type rdf:Property ;
    rdfs:label 'Management Role Description' ;
    rdfs:comment 'Description of management\'s role in assessing and managing climate-related risks and opportunities, including specific roles and responsibilities.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:metricsTargetsNarrative rdf:type rdf:Property ;
    rdfs:label 'Metrics Targets Narrative' ;
    rdfs:comment 'Textual description of the metrics and targets used to assess and manage relevant climate-related risks and opportunities.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalRiskExposureSummary rdf:type rdf:Property ;
    rdfs:label 'Physical Risk Exposure Summary' ;
    rdfs:comment 'Summary of the organization\'s exposure to physical climate risks such as extreme weather events, sea-level rise, and temperature changes.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:publicationUrl rdf:type rdf:Property ;
    rdfs:label 'Publication Url' ;
    rdfs:comment 'Web address where the published TCFD disclosure document can be accessed by stakeholders.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskManagementNarrative rdf:type rdf:Property ;
    rdfs:label 'Risk Management Narrative' ;
    rdfs:comment 'Textual description of the processes used by the organization to identify, assess, and manage climate-related risks.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioAnalysisApproach rdf:type rdf:Property ;
    rdfs:label 'Scenario Analysis Approach' ;
    rdfs:comment 'Description of the scenario analysis methodology used to assess the resilience of the organization\'s strategy under different climate-related scenarios.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioTemperaturePathways rdf:type rdf:Property ;
    rdfs:label 'Scenario Temperature Pathways' ;
    rdfs:comment 'Temperature pathways or scenarios analyzed, such as 1.5C, 2C, or higher warming scenarios, used in the scenario analysis.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope1EmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Scope 1 Emissions Tco2e' ;
    rdfs:comment 'Total direct GHG emissions from sources owned or controlled by the organization, measured in metric tons of carbon dioxide equivalent.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope2EmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Scope 2 Emissions Tco2e' ;
    rdfs:comment 'Total indirect GHG emissions from the generation of purchased electricity, steam, heating, and cooling consumed by the organization, measured in metric tons of carbon dioxide equivalent.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope3EmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Scope 3 Emissions Tco2e' ;
    rdfs:comment 'Total indirect GHG emissions from the organization\'s value chain, including financed emissions from investment portfolio, measured in metric tons of carbon dioxide equivalent.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strandedAssetRiskAssessment rdf:type rdf:Property ;
    rdfs:label 'Stranded Asset Risk Assessment' ;
    rdfs:comment 'Qualitative assessment of the risk that portfolio assets may become stranded due to climate policy, technology shifts, or market changes.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyNarrative rdf:type rdf:Property ;
    rdfs:label 'Strategy Narrative' ;
    rdfs:comment 'Textual description of the actual and potential impacts of climate-related risks and opportunities on the organization\'s businesses, strategy, and financial planning.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizonsAssessed rdf:type rdf:Property ;
    rdfs:label 'Time Horizons Assessed' ;
    rdfs:comment 'Time horizons considered in the climate risk assessment, such as short-term (0-5 years), medium-term (5-15 years), and long-term (15+ years).' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Total Emissions Tco2e' ;
    rdfs:comment 'Sum of Scope 1, Scope 2, and Scope 3 emissions, representing the organization\'s total carbon footprint in metric tons of carbon dioxide equivalent.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transitionRiskExposureSummary rdf:type rdf:Property ;
    rdfs:label 'Transition Risk Exposure Summary' ;
    rdfs:comment 'Summary of the organization\'s exposure to transition risks arising from policy, legal, technology, and market changes as the economy shifts toward a lower-carbon future.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightedAverageCarbonIntensityWaci rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Carbon Intensity Waci' ;
    rdfs:comment 'Portfolio-weighted average of investee companies\' carbon intensities, measured in tCO2e per million dollars of revenue, used to assess portfolio climate risk.' ;
    rdfs:domain ind:TcfdDisclosure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgEmissionRecordId rdf:type rdf:Property ;
    rdfs:label 'Ghg Emission Record Id' ;
    rdfs:comment 'Unique identifier for the greenhouse gas emission record.' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:portfolioHoldingId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Holding Id' ;
    rdfs:comment 'Reference to the specific portfolio holding or investment position to which this emission data applies.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Holding .

ind:attributedEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Attributed Emissions Tco2e' ;
    rdfs:comment 'Emissions attributed to the funds investment based on ownership percentage or other allocation method, measured in tCO2e.' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonFootprintPerMillionInvested rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint Per Million Invested' ;
    rdfs:comment 'Carbon footprint metric expressed as tCO2e per million dollars invested, used for portfolio-level aggregation.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataCollectionMethod rdf:type rdf:Property ;
    rdfs:label 'Data Collection Method' ;
    rdfs:comment 'Description of the method used to collect or obtain the emissions data (e.g., direct reporting, survey, estimation model, third-party data feed).' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emissionFactorSource rdf:type rdf:Property ;
    rdfs:label 'Emission Factor Source' ;
    rdfs:comment 'Source of the emission factors used in calculations (e.g., IPCC, EPA, DEFRA, IEA).' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parisAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Paris Alignment Flag' ;
    rdfs:comment 'Indicates whether the emissions trajectory is aligned with Paris Agreement climate goals (1.5 or 2 degree scenarios).' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reductionTargetPct rdf:type rdf:Property ;
    rdfs:label 'Reduction Target Pct' ;
    rdfs:comment 'Target percentage reduction in emissions relative to the baseline year.' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope2LocationBasedEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Scope 2 Location Based Emissions Tco2e' ;
    rdfs:comment 'Indirect emissions from purchased electricity, steam, heating, and cooling using average emission factors for the grid, measured in tCO2e.' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope2MarketBasedEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Scope 2 Market Based Emissions Tco2e' ;
    rdfs:comment 'Indirect emissions from purchased energy using contractual instruments and supplier-specific emission factors, measured in tCO2e.' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scope3Category rdf:type rdf:Property ;
    rdfs:label 'Scope 3 Category' ;
    rdfs:comment 'Specific Scope 3 category classification per GHG Protocol (e.g., Category 1 Purchased Goods, Category 11 Use of Sold Products). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:GhgEmissionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Tcfd Alignment Flag' ;
    rdfs:comment 'Indicates whether the emissions data meets TCFD disclosure requirements.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedForUseFlag rdf:type rdf:Property ;
    rdfs:label 'Approved For Use Flag' ;
    rdfs:comment 'Indicates whether the scenario has been formally approved by the Investment Committee or Risk Committee for use in investment decision-making and risk management.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assetClassApplicability rdf:type rdf:Property ;
    rdfs:label 'Asset Class Applicability' ;
    rdfs:comment 'Investment asset classes for which this scenario is relevant and applicable (e.g., public equities, private equity, real estate, infrastructure, credit).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseYear rdf:type rdf:Property ;
    rdfs:label 'Base Year' ;
    rdfs:comment 'Starting year for the climate scenario projections and baseline measurements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carbonBudgetGt rdf:type rdf:Property ;
    rdfs:label 'Carbon Budget Gt' ;
    rdfs:comment 'Total cumulative carbon dioxide emissions budget in gigatonnes allowed under this scenario pathway from base year to target year.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonPriceTrajectory rdf:type rdf:Property ;
    rdfs:label 'Carbon Price Trajectory' ;
    rdfs:comment 'Qualitative classification of the carbon pricing pathway assumed in the scenario (low, medium, high, very high).' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateScenarioStatus rdf:type rdf:Property ;
    rdfs:label 'Climate Scenario Status' ;
    rdfs:comment 'Current lifecycle status of the climate scenario within the organization\'s stress testing framework.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodologySummary rdf:type rdf:Property ;
    rdfs:label 'Methodology Summary' ;
    rdfs:comment 'Brief summary of the modeling approach, assumptions, and methodologies used to construct the climate scenario (maximum 500 characters).' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netZeroYear rdf:type rdf:Property ;
    rdfs:label 'Net Zero Year' ;
    rdfs:comment 'Year in which net greenhouse gas emissions reach zero under this scenario pathway (null if net zero is not achieved).' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:peakEmissionsYear rdf:type rdf:Property ;
    rdfs:label 'Peak Emissions Year' ;
    rdfs:comment 'Year in which global greenhouse gas emissions reach their maximum level before declining under this scenario.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalRiskSeverity rdf:type rdf:Property ;
    rdfs:label 'Physical Risk Severity' ;
    rdfs:comment 'Overall severity level of physical climate risks (acute and chronic) under this scenario.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStringency rdf:type rdf:Property ;
    rdfs:label 'Policy Stringency' ;
    rdfs:comment 'Assessment of the strength and comprehensiveness of climate policy measures assumed in the scenario.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rcpClassification rdf:type rdf:Property ;
    rdfs:label 'Rcp Classification' ;
    rdfs:comment 'IPCC Representative Concentration Pathway classification indicating radiative forcing level (W/m2) by 2100.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorCoverage rdf:type rdf:Property ;
    rdfs:label 'Sector Coverage' ;
    rdfs:comment 'Economic sectors and industries covered by the scenario\'s projections and impact assessments (e.g., energy, transport, agriculture, buildings, industry).' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sfdrDisclosureFlag rdf:type rdf:Property ;
    rdfs:label 'Sfdr Disclosure Flag' ;
    rdfs:comment 'Indicates whether the scenario is used for SFDR principal adverse impact and sustainability risk disclosures.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceOrganization rdf:type rdf:Property ;
    rdfs:label 'Source Organization' ;
    rdfs:comment 'Name of the organization or consortium that published the climate scenario (e.g., NGFS, IEA, IPCC, UNEP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sspClassification rdf:type rdf:Property ;
    rdfs:label 'Ssp Classification' ;
    rdfs:comment 'IPCC Shared Socioeconomic Pathway classification describing socioeconomic development trajectory (e.g., SSP1, SSP2, SSP3, SSP4, SSP5).' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stressTestUsageFlag rdf:type rdf:Property ;
    rdfs:label 'Stress Test Usage Flag' ;
    rdfs:comment 'Indicates whether this scenario is actively used in the organization\'s climate risk stress testing and scenario analysis exercises.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technologyChangeAssumption rdf:type rdf:Property ;
    rdfs:label 'Technology Change Assumption' ;
    rdfs:comment 'Assumed pace of technological innovation and deployment for decarbonization and adaptation technologies.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:temperaturePathway rdf:type rdf:Property ;
    rdfs:label 'Temperature Pathway' ;
    rdfs:comment 'Global mean temperature increase pathway associated with the scenario (e.g., 1.5C, 2C, 3C, 4C+) by end of century relative to pre-industrial levels.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timeHorizon rdf:type rdf:Property ;
    rdfs:label 'Time Horizon' ;
    rdfs:comment 'Number of years from base year to the scenario\'s target projection year (e.g., 30 for 2050 target from 2020 base).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionRiskSeverity rdf:type rdf:Property ;
    rdfs:label 'Transition Risk Severity' ;
    rdfs:comment 'Overall severity level of transition risks (policy, technology, market, reputation) under this scenario.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageGuidance rdf:type rdf:Property ;
    rdfs:label 'Usage Guidance' ;
    rdfs:comment 'Internal guidance on appropriate use cases, interpretation, and integration of the scenario into investment analysis and risk management processes.' ;
    rdfs:domain ind:ClimateScenario ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collaborativeInitiativeName rdf:type rdf:Property ;
    rdfs:label 'Collaborative Initiative Name' ;
    rdfs:comment 'Name of the formal collaborative engagement initiative or investor coalition through which the engagement was conducted, if applicable.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementIdentifier rdf:type rdf:Property ;
    rdfs:label 'Engagement Identifier' ;
    rdfs:comment 'Human-readable unique business identifier for the engagement activity, used for external reference and reporting.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementMilestone rdf:type rdf:Property ;
    rdfs:label 'Engagement Milestone' ;
    rdfs:comment 'Key progress indicator or achievement reached during the engagement, used to track effectiveness and outcomes over time.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementOutcome rdf:type rdf:Property ;
    rdfs:label 'Engagement Outcome' ;
    rdfs:comment 'Assessment of the result or impact achieved from the engagement activity, measuring the effectiveness of stewardship efforts. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementParticipantsExternal rdf:type rdf:Property ;
    rdfs:label 'Engagement Participants External' ;
    rdfs:comment 'Names or roles of external stakeholders from the investee entity or collaborative partners who participated in the engagement.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementParticipantsInternal rdf:type rdf:Property ;
    rdfs:label 'Engagement Participants Internal' ;
    rdfs:comment 'Names or roles of internal fund personnel who participated in the engagement activity, supporting accountability and knowledge management.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementSubTopic rdf:type rdf:Property ;
    rdfs:label 'Engagement Sub Topic' ;
    rdfs:comment 'Detailed sub-category or specific aspect within the primary engagement topic, providing granular classification of the engagement focus area.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementSummary rdf:type rdf:Property ;
    rdfs:label 'Engagement Summary' ;
    rdfs:comment 'Narrative summary of the engagement discussion, key points raised, investee responses, and any commitments or action items agreed upon.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementTopic rdf:type rdf:Property ;
    rdfs:label 'Engagement Topic' ;
    rdfs:comment 'Primary Environmental, Social, and Governance (ESG) theme or issue that is the focus of the engagement activity. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingAtEngagement rdf:type rdf:Property ;
    rdfs:label 'Esg Rating At Engagement' ;
    rdfs:comment 'MSCI ESG rating or equivalent third-party ESG assessment of the investee entity at the time of engagement, providing risk context.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdingValueAtEngagement rdf:type rdf:Property ;
    rdfs:label 'Holding Value At Engagement' ;
    rdfs:comment 'Market value of the funds holding in the investee entity at the time of engagement, providing materiality context for stewardship prioritization.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Holding Value Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the holding value amount, supporting multi-currency portfolio reporting.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investeeCountry rdf:type rdf:Property ;
    rdfs:label 'Investee Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the primary jurisdiction or headquarters location of the investee entity.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investeeEntityName rdf:type rdf:Property ;
    rdfs:label 'Investee Entity Name' ;
    rdfs:comment 'Legal name of the portfolio company, external manager, or other investee entity that is the subject of the engagement activity.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investeeLei rdf:type rdf:Property ;
    rdfs:label 'Investee Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the investee entity, providing globally unique identification for regulatory and reporting purposes.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investeeSector rdf:type rdf:Property ;
    rdfs:label 'Investee Sector' ;
    rdfs:comment 'Industry sector classification of the investee entity using Global Industry Classification Standard (GICS) or equivalent taxonomy.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextAction rdf:type rdf:Property ;
    rdfs:label 'Next Action' ;
    rdfs:comment 'Planned follow-up activity or next step in the engagement process, supporting continuity and accountability in stewardship efforts.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextActionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Action Due Date' ;
    rdfs:comment 'Target date by which the next engagement action or follow-up is scheduled to occur, enabling tracking of engagement cadence.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unGlobalCompactViolationFlag rdf:type rdf:Property ;
    rdfs:label 'Un Global Compact Violation Flag' ;
    rdfs:comment 'Indicates whether the engagement was triggered by or relates to a potential violation of UN Global Compact principles by the investee entity.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:votingActionTaken rdf:type rdf:Property ;
    rdfs:label 'Voting Action Taken' ;
    rdfs:comment 'Indicates whether proxy voting action was taken as part of or in connection with this engagement activity.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:votingDecision rdf:type rdf:Property ;
    rdfs:label 'Voting Decision' ;
    rdfs:comment 'The funds voting decision on the resolution associated with this engagement activity.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votingMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Voting Meeting Date' ;
    rdfs:comment 'Date of the Annual General Meeting (AGM) or Extraordinary General Meeting (EGM) where voting action related to this engagement occurred.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:votingResolutionDescription rdf:type rdf:Property ;
    rdfs:label 'Voting Resolution Description' ;
    rdfs:comment 'Description of the shareholder resolution or management proposal that was the subject of voting action related to this engagement.' ;
    rdfs:domain ind:EngagementActivity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementActivityId rdf:type rdf:Property ;
    rdfs:label 'Engagement Engagement Activity Id' ;
    rdfs:comment 'Reference to the parent engagement program or activity under which this objective is defined.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EngagementActivity .

ind:engagementEsgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Engagement Esg Policy Id' ;
    rdfs:comment 'Reference to the ESG policy or responsible investment policy that mandates or guides this engagement objective.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:engagementRelatedPolicyEsgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Engagement Related Policy Esg Policy Id' ;
    rdfs:comment 'Reference to the ESG policy or responsible investment policy that mandates or guides this engagement objective.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:ownerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Engagement objectives require accountable owners to drive progress. PRI reporting requires tracking who owns each engagement objective for stewardship accountability.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:achievementDate rdf:type rdf:Property ;
    rdfs:label 'Achievement Date' ;
    rdfs:comment 'Actual date on which the objective was achieved, if applicable.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:baselineValue rdf:type rdf:Property ;
    rdfs:label 'Baseline Value' ;
    rdfs:comment 'Baseline or starting value of the target metric at the time the objective was established.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closureReason rdf:type rdf:Property ;
    rdfs:label 'Closure Reason' ;
    rdfs:comment 'Explanation for why the objective was closed, including achievement rationale or reasons for non-achievement or cancellation.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collaborationInitiativeName rdf:type rdf:Property ;
    rdfs:label 'Collaboration Initiative Name' ;
    rdfs:comment 'Name of the external collaborative engagement initiative or coalition, if applicable, such as Climate Action 100+ or Investor Alliance for Human Rights.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementApproach rdf:type rdf:Property ;
    rdfs:label 'Engagement Approach' ;
    rdfs:comment 'Method or strategy employed to achieve the objective, such as direct dialogue, collaborative engagement, proxy voting, or public advocacy.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementObjectiveStatus rdf:type rdf:Property ;
    rdfs:label 'Engagement Objective Status' ;
    rdfs:comment 'Current lifecycle status of the engagement objective, tracking progress from definition through completion. [ENUM-REF-CANDIDATE: draft|active|on_track|at_risk|achieved|not_achieved|deferred|cancelled — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIssue rdf:type rdf:Property ;
    rdfs:label 'Esg Issue' ;
    rdfs:comment 'Specific ESG issue or topic that the objective targets, such as climate risk, board diversity, labor practices, or supply chain transparency.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalCollaborationFlag rdf:type rdf:Property ;
    rdfs:label 'External Collaboration Flag' ;
    rdfs:comment 'Indicates whether this objective is pursued in collaboration with other institutional investors or engagement coalitions.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:milestoneDescription rdf:type rdf:Property ;
    rdfs:label 'Milestone Description' ;
    rdfs:comment 'Specific, measurable, achievable, relevant, and time-bound (SMART) milestone definition for tracking progress toward the objective.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectiveCode rdf:type rdf:Property ;
    rdfs:label 'Objective Code' ;
    rdfs:comment 'Business-assigned unique code or identifier for the engagement objective.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectiveDescription rdf:type rdf:Property ;
    rdfs:label 'Objective Description' ;
    rdfs:comment 'Detailed description of the engagement objective, including the desired outcome and rationale.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectiveName rdf:type rdf:Property ;
    rdfs:label 'Objective Name' ;
    rdfs:comment 'Short descriptive name or title of the engagement objective.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:objectiveType rdf:type rdf:Property ;
    rdfs:label 'Objective Type' ;
    rdfs:comment 'Classification of the engagement objective by its strategic or operational nature.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownerDepartment rdf:type rdf:Property ;
    rdfs:label 'Owner Department' ;
    rdfs:comment 'Department or business unit to which the objective owner belongs, such as ESG team, investment team, or stewardship team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:progressPercentage rdf:type rdf:Property ;
    rdfs:label 'Progress Percentage' ;
    rdfs:comment 'Estimated percentage completion of the objective, ranging from 0.00 to 100.00 percent.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sfdrPrincipalAdverseImpact rdf:type rdf:Property ;
    rdfs:label 'Sfdr Principal Adverse Impact' ;
    rdfs:comment 'SFDR Principal Adverse Impact indicator that this objective addresses, if applicable.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetMetric rdf:type rdf:Property ;
    rdfs:label 'Target Metric' ;
    rdfs:comment 'Quantitative or qualitative metric used to measure achievement of the objective, such as GHG emissions reduction percentage, board independence ratio, or policy adoption.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetValue rdf:type rdf:Property ;
    rdfs:label 'Target Value' ;
    rdfs:comment 'Specific target value or threshold for the metric that defines successful achievement of the objective.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tcfdAlignment rdf:type rdf:Property ;
    rdfs:label 'Tcfd Alignment' ;
    rdfs:comment 'Alignment of the objective with TCFD disclosure pillars: governance, strategy, risk management, or metrics and targets.' ;
    rdfs:domain ind:EngagementObjective ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unSdgAlignment rdf:type rdf:Property ;
    rdfs:label 'Un Sdg Alignment' ;
    rdfs:comment 'UN Sustainable Development Goals that this objective supports, specified as goal numbers or names.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVoteRecordId rdf:type rdf:Property ;
    rdfs:label 'Proxy Vote Record Id' ;
    rdfs:comment 'Unique identifier for the proxy vote record. Primary key for this transactional voting record.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:climateAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Climate Alignment Flag' ;
    rdfs:comment 'Indicates whether the resolution relates to climate change alignment and net-zero transition goals (True) or not (False).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:disclosureDate rdf:type rdf:Property ;
    rdfs:label 'Disclosure Date' ;
    rdfs:comment 'Date on which the proxy vote record was publicly disclosed or reported.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementActivityFlag rdf:type rdf:Property ;
    rdfs:label 'Engagement Activity Flag' ;
    rdfs:comment 'Indicates whether this vote was preceded by direct engagement with the investee company (True) or not (False).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:glassLewisRecommendation rdf:type rdf:Property ;
    rdfs:label 'Glass Lewis Recommendation' ;
    rdfs:comment 'Voting recommendation provided by Glass Lewis proxy advisory service.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issRecommendation rdf:type rdf:Property ;
    rdfs:label 'Iss Recommendation' ;
    rdfs:comment 'Voting recommendation provided by ISS proxy advisory service.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyAgentName rdf:type rdf:Property ;
    rdfs:label 'Proxy Agent Name' ;
    rdfs:comment 'Name of the third-party proxy voting service or agent used to execute the vote (e.g., Broadridge, ISS ProxyExchange).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionType rdf:type rdf:Property ;
    rdfs:label 'Resolution Type' ;
    rdfs:comment 'Indicates whether the resolution was proposed by Management or by a Shareholder.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteAlignmentWithIss rdf:type rdf:Property ;
    rdfs:label 'Vote Alignment With Iss' ;
    rdfs:comment 'Indicates whether the vote cast was aligned with ISS recommendation (True) or not (False).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voteAlignmentWithManagement rdf:type rdf:Property ;
    rdfs:label 'Vote Alignment With Management' ;
    rdfs:comment 'Indicates whether the vote cast was aligned with management recommendation (True) or not (False).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voteDirection rdf:type rdf:Property ;
    rdfs:label 'Vote Direction' ;
    rdfs:comment 'Direction of the vote cast: For, Against, Abstain, Withhold, or Do Not Vote.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteExecutionMethod rdf:type rdf:Property ;
    rdfs:label 'Vote Execution Method' ;
    rdfs:comment 'Method by which the vote was submitted: Electronic platform, Paper ballot, Proxy Agent, or Direct submission.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteRecommendationSource rdf:type rdf:Property ;
    rdfs:label 'Vote Recommendation Source' ;
    rdfs:comment 'Source of the voting recommendation consulted: Institutional Shareholder Services (ISS), Glass Lewis, Internal research, Management recommendation, or Other.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteRejectionReason rdf:type rdf:Property ;
    rdfs:label 'Vote Rejection Reason' ;
    rdfs:comment 'Reason provided if the vote was rejected by the custodian or proxy agent (e.g., late submission, insufficient shares).' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteStatus rdf:type rdf:Property ;
    rdfs:label 'Vote Status' ;
    rdfs:comment 'Current status of the proxy vote: Submitted, Confirmed, Rejected, Pending, or Cancelled.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:voteSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Vote Submission Date' ;
    rdfs:comment 'Date on which the proxy vote was submitted to the custodian or proxy agent.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:votesAgainstPercentage rdf:type rdf:Property ;
    rdfs:label 'Votes Against Percentage' ;
    rdfs:comment 'Percentage of total votes cast against the resolution at the meeting.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:votesForPercentage rdf:type rdf:Property ;
    rdfs:label 'Votes For Percentage' ;
    rdfs:comment 'Percentage of total votes cast in favor of the resolution at the meeting.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:votingPowerPercentage rdf:type rdf:Property ;
    rdfs:label 'Voting Power Percentage' ;
    rdfs:comment 'Percentage of total outstanding shares represented by the shares voted, indicating voting power.' ;
    rdfs:domain ind:ProxyVoteRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priReportingSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Pri Reporting Submission Id' ;
    rdfs:comment 'Unique identifier for the PRI reporting submission record.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentBand rdf:type rdf:Property ;
    rdfs:label 'Assessment Band' ;
    rdfs:comment 'The overall assessment band awarded by PRI for the module (e.g., Five Stars, Four Stars, Three Stars, Two Stars, One Star).' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aumCoverageAmount rdf:type rdf:Property ;
    rdfs:label 'Aum Coverage Amount' ;
    rdfs:comment 'The total AUM (in base currency) covered by this indicator response, representing the asset base to which the ESG practice applies.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aumCoveragePercentage rdf:type rdf:Property ;
    rdfs:label 'Aum Coverage Percentage' ;
    rdfs:comment 'The percentage of total AUM covered by this indicator response (0.00 to 100.00).' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indicatorCode rdf:type rdf:Property ;
    rdfs:label 'Indicator Code' ;
    rdfs:comment 'The specific indicator code within the module (e.g., SG01, LE02.1, PE03) as defined by PRI reporting taxonomy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorDescription rdf:type rdf:Property ;
    rdfs:label 'Indicator Description' ;
    rdfs:comment 'Full text description of the indicator question or requirement being addressed in this submission.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moduleName rdf:type rdf:Property ;
    rdfs:label 'Module Name' ;
    rdfs:comment 'The specific PRI reporting module being submitted (e.g., Strategy & Governance, Listed Equity, Private Equity, Real Estate, Infrastructure, Fixed Income).' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:peerComparisonPercentile rdf:type rdf:Property ;
    rdfs:label 'Peer Comparison Percentile' ;
    rdfs:comment 'The percentile ranking of this submission relative to peer signatories in the same asset class and region (0.00 to 100.00).' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingYear rdf:type rdf:Property ;
    rdfs:label 'Reporting Year' ;
    rdfs:comment 'The calendar year for which the PRI assessment is being reported (e.g., 2023).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responseUnit rdf:type rdf:Property ;
    rdfs:label 'Response Unit' ;
    rdfs:comment 'Unit of measure for quantitative responses (e.g., USD millions, percentage, tonnes CO2e, number of holdings).' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseValue rdf:type rdf:Property ;
    rdfs:label 'Response Value' ;
    rdfs:comment 'The actual response value submitted for this indicator. May contain numeric values, text descriptions, or categorical selections depending on response_type.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Submission Deadline' ;
    rdfs:comment 'The deadline date by which this submission must be completed and submitted to PRI.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:supportingEvidenceUrl rdf:type rdf:Property ;
    rdfs:label 'Supporting Evidence Url' ;
    rdfs:comment 'URL or document reference to supporting evidence, policies, or documentation that substantiates this submission response.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transparencyReportUrl rdf:type rdf:Property ;
    rdfs:label 'Transparency Report Url' ;
    rdfs:comment 'URL to the published PRI Transparency Report containing this submission data.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationErrors rdf:type rdf:Property ;
    rdfs:label 'Validation Errors' ;
    rdfs:comment 'Description of any validation errors or warnings identified by PRI during submission review.' ;
    rdfs:domain ind:PriReportingSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assignedAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned Analyst Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: ESG controversy monitoring requires analyst assignment for investigation and escalation. Pension funds track which employee is responsible for monitoring each controversy for workload' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:analystNotes rdf:type rdf:Property ;
    rdfs:label 'Analyst Notes' ;
    rdfs:comment 'Internal notes and commentary from the ESG analyst or investment team regarding the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyCategory rdf:type rdf:Property ;
    rdfs:label 'Controversy Category' ;
    rdfs:comment 'Detailed sub-category or theme of the controversy within the primary type.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyCode rdf:type rdf:Property ;
    rdfs:label 'Controversy Code' ;
    rdfs:comment 'Business-assigned unique code for the controversy event.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyStatus rdf:type rdf:Property ;
    rdfs:label 'Controversy Status' ;
    rdfs:comment 'Current lifecycle status of the controversy within the investment risk management process.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyType rdf:type rdf:Property ;
    rdfs:label 'Controversy Type' ;
    rdfs:comment 'Primary classification of the controversy event.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divestmentRecommendation rdf:type rdf:Property ;
    rdfs:label 'Divestment Recommendation' ;
    rdfs:comment 'Investment action recommendation resulting from the controversy assessment.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementInitiatedFlag rdf:type rdf:Property ;
    rdfs:label 'Engagement Initiated Flag' ;
    rdfs:comment 'Indicates whether active engagement with the investee has been initiated in response to the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionListFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Flag' ;
    rdfs:comment 'Indicates whether the investee has been added to the exclusion list as a result of this controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Penalty Amount' ;
    rdfs:comment 'Monetary value of fines or penalties imposed on the investee related to the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geographicLocation rdf:type rdf:Property ;
    rdfs:label 'Geographic Location' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the controversy incident occurred.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsRelated rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Related' ;
    rdfs:comment 'Indicates whether the controversy involves greenhouse gas emissions or climate impact.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icSubmissionFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Flag' ;
    rdfs:comment 'Indicates whether the controversy has been formally submitted to the Investment Committee for review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identificationDate rdf:type rdf:Property ;
    rdfs:label 'Identification Date' ;
    rdfs:comment 'Date when the controversy was first identified and recorded by the ESG team.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:incidentDate rdf:type rdf:Property ;
    rdfs:label 'Incident Date' ;
    rdfs:comment 'Date when the controversy event or incident occurred or was first reported publicly.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investeeName rdf:type rdf:Property ;
    rdfs:label 'Investee Name' ;
    rdfs:comment 'Legal or common name of the investee company or fund manager involved in the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investeeResponseSummary rdf:type rdf:Property ;
    rdfs:label 'Investee Response Summary' ;
    rdfs:comment 'Summary of the investee\'s response, remediation actions, or public statement regarding the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mediaUrl rdf:type rdf:Property ;
    rdfs:label 'Media Url' ;
    rdfs:comment 'URL link to the primary media article or public disclosure reporting the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVotingAction rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Action' ;
    rdfs:comment 'Proxy voting action taken or recommended in response to the controversy.' ;
    rdfs:domain ind:Controversy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sfdrPaiIndicator rdf:type rdf:Property ;
    rdfs:label 'Sfdr Pai Indicator' ;
    rdfs:comment 'SFDR Principal Adverse Impact indicator code associated with the controversy.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dueDiligenceId rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Id' ;
    rdfs:comment 'Unique identifier for the ESG due diligence assessment record. Primary key for the due diligence product.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DueDiligence .

ind:leadAssessorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Assessor Employee Id' ;
    rdfs:comment 'Reference to the internal ESG specialist or analyst responsible for leading the due diligence assessment.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assessmentTeamMembers rdf:type rdf:Property ;
    rdfs:label 'Assessment Team Members' ;
    rdfs:comment 'Comma-separated list of employee identifiers representing the full ESG due diligence assessment team.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonIntensityMetric rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Metric' ;
    rdfs:comment 'Unit of measure for carbon intensity calculation, such as tCO2e per million revenue or tCO2e per unit produced.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonIntensityValue rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Value' ;
    rdfs:comment 'Calculated carbon intensity value for the target entity using the specified metric denominator.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:climateRiskAssessment rdf:type rdf:Property ;
    rdfs:label 'Climate Risk Assessment' ;
    rdfs:comment 'Assessment of physical and transition climate risks facing the target entity under TCFD framework.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementTopics rdf:type rdf:Property ;
    rdfs:label 'Engagement Topics' ;
    rdfs:comment 'Comma-separated list of ESG topics identified for active engagement with the target entity management or board.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgOverallScore rdf:type rdf:Property ;
    rdfs:label 'Esg Overall Score' ;
    rdfs:comment 'Composite ESG score assigned to the target entity, typically on a 0-100 scale, reflecting overall ESG performance.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exclusionCriteriaBreached rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Breached' ;
    rdfs:comment 'Comma-separated list of specific exclusion criteria breached by the target entity, if applicable.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionPolicyBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusion Policy Breach Flag' ;
    rdfs:comment 'Indicates whether the target entity breaches any of the pension funds ESG exclusion policies or criteria.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalAdvisorName rdf:type rdf:Property ;
    rdfs:label 'External Advisor Name' ;
    rdfs:comment 'Name of external ESG consultant or advisory firm engaged to support the due diligence assessment, if applicable.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEntityCountry rdf:type rdf:Property ;
    rdfs:label 'Target Entity Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the primary jurisdiction of the investment target entity.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyAlignmentPct rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Alignment Pct' ;
    rdfs:comment 'Percentage of target entity revenue or activities aligned with EU Taxonomy for sustainable activities.' ;
    rdfs:domain ind:DueDiligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kpiTargetId rdf:type rdf:Property ;
    rdfs:label 'Kpi Target Id' ;
    rdfs:comment 'Unique identifier for the ESG KPI target record.' ;
    rdfs:domain ind:Esg ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KpiTarget .

ind:achievementStatus rdf:type rdf:Property ;
    rdfs:label 'Achievement Status' ;
    rdfs:comment 'Current assessment of progress toward the KPI target, indicating whether achievement is on track, at risk, off track, already achieved, or not yet started.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Pct' ;
    rdfs:comment 'Percentage deviation from the target trajectory that triggers escalation to senior management or the Investment Committee.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interimTargetValue rdf:type rdf:Property ;
    rdfs:label 'Interim Target Value' ;
    rdfs:comment 'Intermediate target value set for a milestone year between the baseline and final target year.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:kpiCategory rdf:type rdf:Property ;
    rdfs:label 'Kpi Category' ;
    rdfs:comment 'High-level category classifying the KPI into environmental, social, governance, climate, diversity, or health and safety domains.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiCode rdf:type rdf:Property ;
    rdfs:label 'Kpi Code' ;
    rdfs:comment 'Standardized code identifying the specific ESG KPI being targeted.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiName rdf:type rdf:Property ;
    rdfs:label 'Kpi Name' ;
    rdfs:comment 'Human-readable name of the ESG KPI, such as carbon intensity, board diversity percentage, renewable energy percentage, water intensity, or employee safety rate.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiSubcategory rdf:type rdf:Property ;
    rdfs:label 'Kpi Subcategory' ;
    rdfs:comment 'Detailed subcategory providing granular classification of the KPI within its primary category.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMeasuredValue rdf:type rdf:Property ;
    rdfs:label 'Last Measured Value' ;
    rdfs:comment 'Most recent measured value of the KPI, used to assess current progress toward the target.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastMeasurementDate rdf:type rdf:Property ;
    rdfs:label 'Last Measurement Date' ;
    rdfs:comment 'Date on which the most recent KPI measurement was taken.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:progressPct rdf:type rdf:Property ;
    rdfs:label 'Progress Pct' ;
    rdfs:comment 'Percentage of progress achieved toward the KPI target, calculated as the ratio of improvement to total required improvement.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sbtiValidatedFlag rdf:type rdf:Property ;
    rdfs:label 'Sbti Validated Flag' ;
    rdfs:comment 'Indicates whether the KPI target has been validated by the Science Based Targets initiative as science-based.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetScope rdf:type rdf:Property ;
    rdfs:label 'Target Scope' ;
    rdfs:comment 'Scope level at which the KPI target is set, such as entire portfolio, specific asset class, individual holding, or fund.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetUnit rdf:type rdf:Property ;
    rdfs:label 'Target Unit' ;
    rdfs:comment 'Unit of measure for the target value, such as percentage, tonnes CO2e per million revenue, or incidents per employee.' ;
    rdfs:domain ind:KpiTarget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kpiMeasurementId rdf:type rdf:Property ;
    rdfs:label 'Kpi Measurement Id' ;
    rdfs:comment 'Unique identifier for the ESG KPI measurement record.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:kpiTargetId rdf:type rdf:Property ;
    rdfs:label 'Kpi Kpi Target Id' ;
    rdfs:comment 'Reference to the ESG KPI definition being measured.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:KpiTarget .

ind:griIndicatorCode rdf:type rdf:Property ;
    rdfs:label 'Gri Indicator Code' ;
    rdfs:comment 'The GRI indicator code that this measurement corresponds to, if applicable.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialityAssessment rdf:type rdf:Property ;
    rdfs:label 'Materiality Assessment' ;
    rdfs:comment 'Assessment of whether this KPI measurement is material to investment decision-making or reporting.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementMethodology rdf:type rdf:Property ;
    rdfs:label 'Measurement Methodology' ;
    rdfs:comment 'Description of the methodology or approach used to measure or calculate the KPI value.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementNotes rdf:type rdf:Property ;
    rdfs:label 'Measurement Notes' ;
    rdfs:comment 'Additional notes, comments, or context regarding the KPI measurement.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onTrackFlag rdf:type rdf:Property ;
    rdfs:label 'On Track Flag' ;
    rdfs:comment 'Boolean indicator of whether the KPI measurement is on track to meet its target.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:progressToTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Progress To Target Percentage' ;
    rdfs:comment 'The percentage of progress achieved toward the target value from the baseline.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sasbMetricCode rdf:type rdf:Property ;
    rdfs:label 'Sasb Metric Code' ;
    rdfs:comment 'The SASB metric code that this measurement corresponds to, if applicable.' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceValue rdf:type rdf:Property ;
    rdfs:label 'Variance Value' ;
    rdfs:comment 'The calculated variance between actual and target values (actual minus target).' ;
    rdfs:domain ind:KpiMeasurement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:integrationChecklistId rdf:type rdf:Property ;
    rdfs:label 'Integration Checklist Id' ;
    rdfs:comment 'Unique identifier for the ESG integration checklist record. Primary key for the integration checklist entity.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignedToEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Assigned To Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: ESG integration checklists in deal process require assignment to specific analysts. Tracks who is responsible for completing ESG due diligence items before Investment Committee.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:checklistIdentifier rdf:type rdf:Property ;
    rdfs:label 'Checklist Identifier' ;
    rdfs:comment 'Business-readable unique identifier or reference code for the checklist instance, used for tracking and reporting purposes.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistType rdf:type rdf:Property ;
    rdfs:label 'Checklist Type' ;
    rdfs:comment 'Category of ESG integration checklist defining the stage in the investment lifecycle where ESG factors are assessed. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedItems rdf:type rdf:Property ;
    rdfs:label 'Completed Items' ;
    rdfs:comment 'Number of checklist items that have been completed and assessed as of the current status.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engagementRequired rdf:type rdf:Property ;
    rdfs:label 'Engagement Required' ;
    rdfs:comment 'Flag indicating whether active engagement with the investee entity is required to address ESG concerns identified in the checklist.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionDetails rdf:type rdf:Property ;
    rdfs:label 'Exclusion Details' ;
    rdfs:comment 'Description of specific exclusion criteria breached, including policy references and severity of the breach.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialEsgRisksIdentified rdf:type rdf:Property ;
    rdfs:label 'Material Esg Risks Identified' ;
    rdfs:comment 'Flag indicating whether material ESG risks were identified during the checklist assessment that require mitigation or escalation.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mitigationActionsRequired rdf:type rdf:Property ;
    rdfs:label 'Mitigation Actions Required' ;
    rdfs:comment 'Flag indicating whether specific mitigation actions or remediation steps are required based on the checklist findings.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mitigationPlan rdf:type rdf:Property ;
    rdfs:label 'Mitigation Plan' ;
    rdfs:comment 'Description of planned actions to address identified ESG risks or deficiencies, including timelines and responsible parties.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewer rdf:type rdf:Property ;
    rdfs:label 'Reviewer' ;
    rdfs:comment 'Name or identifier of the individual responsible for reviewing and approving the completed ESG integration checklist.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskSummary rdf:type rdf:Property ;
    rdfs:label 'Risk Summary' ;
    rdfs:comment 'Narrative summary of key ESG risks identified through the checklist assessment, including severity and potential impact.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalItems rdf:type rdf:Property ;
    rdfs:label 'Total Items' ;
    rdfs:comment 'Total number of assessment items or questions included in this ESG integration checklist.' ;
    rdfs:domain ind:IntegrationChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:netEsgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Net Esg Policy Id' ;
    rdfs:comment 'Reference to the ESG or climate policy that governs or supports this net-zero commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:netRelatedPolicyEsgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Net Related Policy Esg Policy Id' ;
    rdfs:comment 'Reference to the ESG or climate policy that governs or supports this net-zero commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:baseYearEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Base Year Emissions Tco2e' ;
    rdfs:comment 'Total greenhouse gas emissions in tonnes of carbon dioxide equivalent for the baseline year, covering applicable scopes.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonOffsetAllowed rdf:type rdf:Property ;
    rdfs:label 'Carbon Offset Allowed' ;
    rdfs:comment 'Indicates whether carbon offsets or credits are permitted to meet the net-zero target, and under what conditions.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carbonRemovalAllowed rdf:type rdf:Property ;
    rdfs:label 'Carbon Removal Allowed' ;
    rdfs:comment 'Indicates whether carbon removal technologies or nature-based solutions are permitted to neutralize residual emissions.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentCode rdf:type rdf:Property ;
    rdfs:label 'Commitment Code' ;
    rdfs:comment 'Business identifier code for the net-zero commitment, used for external reference and reporting.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentOwner rdf:type rdf:Property ;
    rdfs:label 'Commitment Owner' ;
    rdfs:comment 'Name or department of the internal owner responsible for managing and delivering the net-zero commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentScope rdf:type rdf:Property ;
    rdfs:label 'Commitment Scope' ;
    rdfs:comment 'The scope of the commitment, indicating whether it applies to the total portfolio, specific asset class, sector, geography, or fund.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decarbonizationStrategy rdf:type rdf:Property ;
    rdfs:label 'Decarbonization Strategy' ;
    rdfs:comment 'High-level description of the strategy to achieve the net-zero commitment, including engagement, divestment, green investment, and transition finance approaches.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divestmentThresholdDefined rdf:type rdf:Property ;
    rdfs:label 'Divestment Threshold Defined' ;
    rdfs:comment 'Indicates whether specific divestment thresholds or criteria have been defined as part of the commitment strategy.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:externalVerificationRequired rdf:type rdf:Property ;
    rdfs:label 'External Verification Required' ;
    rdfs:comment 'Indicates whether external third-party verification or assurance of emissions data and progress is required.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financedEmissionsMethodology rdf:type rdf:Property ;
    rdfs:label 'Financed Emissions Methodology' ;
    rdfs:comment 'The methodology used to calculate financed emissions for portfolio holdings, such as Partnership for Carbon Accounting Financials (PCAF) or SBTi Financial Institutions standard.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:greenInvestmentTargetPct rdf:type rdf:Property ;
    rdfs:label 'Green Investment Target Pct' ;
    rdfs:comment 'Target percentage of portfolio allocated to green or climate-aligned investments as part of the net-zero strategy.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interimReductionTargetPct rdf:type rdf:Property ;
    rdfs:label 'Interim Reduction Target Pct' ;
    rdfs:comment 'The percentage reduction in greenhouse gas emissions targeted for the interim target year, relative to the baseline year.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netZeroDefinition rdf:type rdf:Property ;
    rdfs:label 'Net Zero Definition' ;
    rdfs:comment 'The specific definition of net-zero used for this commitment, including treatment of residual emissions, carbon offsets, and removals.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scope1Included rdf:type rdf:Property ;
    rdfs:label 'Scope 1 Included' ;
    rdfs:comment 'Indicates whether Scope 1 direct emissions from owned or controlled sources are included in the commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scope2Included rdf:type rdf:Property ;
    rdfs:label 'Scope 2 Included' ;
    rdfs:comment 'Indicates whether Scope 2 indirect emissions from purchased electricity, heat, or steam are included in the commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scope3Included rdf:type rdf:Property ;
    rdfs:label 'Scope 3 Included' ;
    rdfs:comment 'Indicates whether Scope 3 indirect emissions from the value chain, including financed emissions, are included in the commitment.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:temperatureAlignmentTarget rdf:type rdf:Property ;
    rdfs:label 'Temperature Alignment Target' ;
    rdfs:comment 'The global warming temperature pathway that the commitment is aligned with, typically 1.5 degrees Celsius consistent with the Paris Agreement.' ;
    rdfs:domain ind:NetZeroCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:administrator rdf:type rdf:Property ;
    rdfs:label 'Administrator' ;
    rdfs:comment 'Legal entity responsible for the administration and governance of the benchmark under applicable regulatory frameworks (e.g., EU Benchmark Regulation).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseIndexName rdf:type rdf:Property ;
    rdfs:label 'Base Index Name' ;
    rdfs:comment 'Name of the parent or underlying broad market index from which the ESG benchmark is derived (e.g., MSCI ACWI, S&P 500).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonIntensityReductionTargetPct rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Reduction Target Pct' ;
    rdfs:comment 'Target percentage reduction in weighted average carbon intensity (WACI) relative to the base index (e.g., 30% lower carbon intensity than parent index).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgBenchmarkStatus rdf:type rdf:Property ;
    rdfs:label 'Esg Benchmark Status' ;
    rdfs:comment 'Current lifecycle status of the benchmark indicating whether it is actively maintained and available for use.' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:euClimateBenchmarkFlag rdf:type rdf:Property ;
    rdfs:label 'Eu Climate Benchmark Flag' ;
    rdfs:comment 'Indicates whether the benchmark is designated as an EU Climate Transition Benchmark (CTB) or EU Paris-Aligned Benchmark (PAB) under EU regulations.' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fossilFuelExposureLimitPct rdf:type rdf:Property ;
    rdfs:label 'Fossil Fuel Exposure Limit Pct' ;
    rdfs:comment 'Maximum allowable percentage of benchmark weight allocated to fossil fuel-related companies (e.g., 5% cap on coal, oil, gas producers).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumEsgRating rdf:type rdf:Property ;
    rdfs:label 'Minimum Esg Rating' ;
    rdfs:comment 'Minimum ESG rating threshold required for constituent inclusion in the benchmark (e.g., BBB or above on MSCI ESG scale).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthorization rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authorization' ;
    rdfs:comment 'Regulatory approval or registration status of the benchmark under applicable jurisdictions (e.g., EU BMR authorized, IOSCO compliant).' ;
    rdfs:domain ind:EsgBenchmark ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:usageScope rdf:type rdf:Property ;
    rdfs:label 'Usage Scope' ;
    rdfs:comment 'Description of the portfolios, mandates, or asset classes for which this benchmark is designated as the primary performance comparison standard.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:annualSubscriptionCost rdf:type rdf:Property ;
    rdfs:label 'Annual Subscription Cost' ;
    rdfs:comment 'Total annual cost of the subscription or service agreement with the provider in the contract currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractEndDate rdf:type rdf:Property ;
    rdfs:label 'Contract End Date' ;
    rdfs:comment 'Scheduled expiration or renewal date of the current contractual agreement. Null for evergreen contracts.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:contractStartDate rdf:type rdf:Property ;
    rdfs:label 'Contract Start Date' ;
    rdfs:comment 'Effective start date of the current contractual agreement with the provider.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the annual subscription cost (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Coverage Asset Classes' ;
    rdfs:comment 'Asset classes covered by the provider\'s data (e.g., public equities, corporate bonds, sovereign debt, private equity, real estate, infrastructure).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageGeography rdf:type rdf:Property ;
    rdfs:label 'Coverage Geography' ;
    rdfs:comment 'Geographic scope of the provider\'s data coverage (e.g., global, North America, Europe, Asia-Pacific, emerging markets).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageIssuerCount rdf:type rdf:Property ;
    rdfs:label 'Coverage Issuer Count' ;
    rdfs:comment 'Approximate number of unique issuers or entities covered by the provider\'s data universe.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataDeliveryFrequency rdf:type rdf:Property ;
    rdfs:label 'Data Delivery Frequency' ;
    rdfs:comment 'Frequency at which data updates are delivered by the provider (real-time, daily, weekly, monthly, quarterly, annual, or on-demand). [ENUM-REF-CANDIDATE: real_time|daily|weekly|monthly|quarterly|annual|on_demand — 7 candidates stripped; promote to' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Data Delivery Method' ;
    rdfs:comment 'Primary method by which data is delivered from the provider (API, SFTP, web portal, email, vendor platform, or data feed).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataFormat rdf:type rdf:Property ;
    rdfs:label 'Data Format' ;
    rdfs:comment 'Technical format of delivered data (e.g., JSON, XML, CSV, Excel, Parquet, proprietary format).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataProductsSubscribed rdf:type rdf:Property ;
    rdfs:label 'Data Products Subscribed' ;
    rdfs:comment 'Comma-separated list or description of specific data products, feeds, or services subscribed from this provider (e.g., ESG ratings, carbon data, controversy alerts, proxy research).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityLastReviewDate rdf:type rdf:Property ;
    rdfs:label 'Data Quality Last Review Date' ;
    rdfs:comment 'Date of the most recent internal data quality assessment or audit of the provider\'s data.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataUsageRestrictions rdf:type rdf:Property ;
    rdfs:label 'Data Usage Restrictions' ;
    rdfs:comment 'Description of any contractual restrictions on data usage, redistribution, or publication imposed by the provider.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodologyFramework rdf:type rdf:Property ;
    rdfs:label 'Methodology Framework' ;
    rdfs:comment 'Description or reference to the provider\'s ESG assessment methodology, rating framework, or data collection approach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodologyLastUpdatedDate rdf:type rdf:Property ;
    rdfs:label 'Methodology Last Updated Date' ;
    rdfs:comment 'Date when the provider last updated or revised their methodology framework.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentTerms rdf:type rdf:Property ;
    rdfs:label 'Payment Terms' ;
    rdfs:comment 'Description of payment terms and schedule (e.g., annual in advance, quarterly in arrears, monthly billing).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:portalUrl rdf:type rdf:Property ;
    rdfs:label 'Portal Url' ;
    rdfs:comment 'Web portal URL for accessing provider data, reports, or analytics tools.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerCode rdf:type rdf:Property ;
    rdfs:label 'Provider Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the provider (e.g., MSCI_ESG, SUSTAINALYTICS, ISS_ESG, REPRISK, CDP, BBGESG).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerStatus rdf:type rdf:Property ;
    rdfs:label 'Provider Status' ;
    rdfs:comment 'Current lifecycle status of the provider relationship (active, inactive, suspended, under review, or terminated).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:providerType rdf:type rdf:Property ;
    rdfs:label 'Provider Type' ;
    rdfs:comment 'Classification of the provider\'s primary service offering (rating agency, data vendor, research provider, index provider, disclosure platform, or multi-service).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sfdrPaiCoverageFlag rdf:type rdf:Property ;
    rdfs:label 'Sfdr Pai Coverage Flag' ;
    rdfs:comment 'Indicates whether the provider supplies data for SFDR Principal Adverse Impact indicators (True/False).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sftpHost rdf:type rdf:Property ;
    rdfs:label 'Sftp Host' ;
    rdfs:comment 'SFTP server hostname or IP address if SFTP delivery is used. Confidential operational information.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaSupportResponseTimeHours rdf:type rdf:Property ;
    rdfs:label 'Sla Support Response Time Hours' ;
    rdfs:comment 'Contractual maximum response time in hours for support requests or incidents.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaUptimePercentage rdf:type rdf:Property ;
    rdfs:label 'Sla Uptime Percentage' ;
    rdfs:comment 'Contractual service level agreement uptime commitment as a percentage (e.g., 99.5 for 99.5% uptime).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vendorRiskLastAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Vendor Risk Last Assessment Date' ;
    rdfs:comment 'Date of the most recent vendor risk assessment or due diligence review.' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:vendorRiskRating rdf:type rdf:Property ;
    rdfs:label 'Vendor Risk Rating' ;
    rdfs:comment 'Internal risk assessment rating for the provider based on operational, financial, and reputational risk (low, medium, high, or critical).' ;
    rdfs:domain ind:DataProvider ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchListId rdf:type rdf:Property ;
    rdfs:label 'Watch List Id' ;
    rdfs:comment 'Unique identifier for the ESG watch list record. Primary key for the watch list entity.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:watchListCategory rdf:type rdf:Property ;
    rdfs:label 'Watch List Category' ;
    rdfs:comment 'Primary category or reason for watch list placement: ESG rating deterioration, controversy, policy breach, regulatory violation, engagement escalation, or exclusion candidate.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:divestmentRecommendationFlag rdf:type rdf:Property ;
    rdfs:label 'Divestment Recommendation Flag' ;
    rdfs:comment 'Boolean flag indicating whether divestment or exclusion from portfolio has been recommended as a result of watch list review.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:entityLei rdf:type rdf:Property ;
    rdfs:label 'Entity Lei' ;
    rdfs:comment '20-character Legal Entity Identifier for the entity on watch list, enabling global entity identification.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityName rdf:type rdf:Property ;
    rdfs:label 'Entity Name' ;
    rdfs:comment 'Full legal or registered name of the entity placed on the ESG watch list.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingChangeDate rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Change Date' ;
    rdfs:comment 'Date when the ESG rating change occurred that contributed to watch list placement.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:esgRatingCurrent rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Current' ;
    rdfs:comment 'Current ESG rating of the entity at the time of watch list placement or most recent update, from provider such as MSCI, Sustainalytics, or internal rating.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRatingPrevious rdf:type rdf:Property ;
    rdfs:label 'Esg Rating Previous' ;
    rdfs:comment 'Previous ESG rating before the deterioration or change that triggered watch list placement, enabling trend analysis.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdingValueAtPlacement rdf:type rdf:Property ;
    rdfs:label 'Holding Value At Placement' ;
    rdfs:comment 'Market value of the holding or exposure to the entity at the time of watch list placement, used to assess materiality and portfolio impact.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyBreachType rdf:type rdf:Property ;
    rdfs:label 'Policy Breach Type' ;
    rdfs:comment 'Type or category of policy breach that triggered watch list placement, such as exclusion criteria violation, engagement mandate breach, or climate target misalignment.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyReference rdf:type rdf:Property ;
    rdfs:label 'Policy Reference' ;
    rdfs:comment 'Reference to the specific ESG policy, exclusion policy, or responsible investment policy that was breached or triggered the watch list placement.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resolutionAction rdf:type rdf:Property ;
    rdfs:label 'Resolution Action' ;
    rdfs:comment 'Specific action or milestone required to resolve the watch list issue and enable removal from watch list, such as rating upgrade, controversy resolution, or policy compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggerEvent rdf:type rdf:Property ;
    rdfs:label 'Trigger Event' ;
    rdfs:comment 'Specific event or incident that triggered the placement on the watch list, such as rating downgrade, controversy emergence, or policy violation.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchListStatus rdf:type rdf:Property ;
    rdfs:label 'Watch List Status' ;
    rdfs:comment 'Current lifecycle status of the watch list entry: active, under review, escalated, resolved, or closed.' ;
    rdfs:domain ind:WatchList ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsibleInvestmentReportId rdf:type rdf:Property ;
    rdfs:label 'Responsible Investment Report Id' ;
    rdfs:comment 'Unique identifier for the responsible investment report record.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededReportResponsibleInvestmentReportId rdf:type rdf:Property ;
    rdfs:label 'Superseded Report Responsible Investment Report Id' ;
    rdfs:comment 'Identifier of the previous report that this report supersedes or replaces, if applicable.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResponsibleInvestmentReport .

ind:assuranceProviderName rdf:type rdf:Property ;
    rdfs:label 'Assurance Provider Name' ;
    rdfs:comment 'Name of the external assurance or audit provider, if applicable.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aumCovered rdf:type rdf:Property ;
    rdfs:label 'Aum Covered' ;
    rdfs:comment 'Total assets under management covered by the responsible investment report, in the reporting currency.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:climateActionSummary rdf:type rdf:Property ;
    rdfs:label 'Climate Action Summary' ;
    rdfs:comment 'Summary of climate-related actions, commitments, and progress during the reporting period.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureLevel rdf:type rdf:Property ;
    rdfs:label 'Disclosure Level' ;
    rdfs:comment 'Classification of the report\'s disclosure level, determining who may access the document.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementActivitySummary rdf:type rdf:Property ;
    rdfs:label 'Engagement Activity Summary' ;
    rdfs:comment 'Summary of stewardship and engagement activities undertaken with investee companies during the reporting period.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIntegrationSummary rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Summary' ;
    rdfs:comment 'High-level narrative summary of how ESG factors are integrated into investment decision-making during the reporting period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionCriteriaSummary rdf:type rdf:Property ;
    rdfs:label 'Exclusion Criteria Summary' ;
    rdfs:comment 'Summary of exclusion criteria applied to investments during the reporting period.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAssuranceObtainedFlag rdf:type rdf:Property ;
    rdfs:label 'External Assurance Obtained Flag' ;
    rdfs:comment 'Indicates whether the report has been externally assured or audited by a third party.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextPublicationDate rdf:type rdf:Property ;
    rdfs:label 'Next Publication Date' ;
    rdfs:comment 'Expected or scheduled date for the next responsible investment report publication.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priSignatoryStatus rdf:type rdf:Property ;
    rdfs:label 'Pri Signatory Status' ;
    rdfs:comment 'Indicates whether the fund is a signatory to the UN Principles for Responsible Investment at the time of report publication.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proxyVotingSummary rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Summary' ;
    rdfs:comment 'Summary of proxy voting activities and outcomes during the reporting period.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportCode rdf:type rdf:Property ;
    rdfs:label 'Report Code' ;
    rdfs:comment 'Business identifier or reference code for the responsible investment report, used for external citation and tracking.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportYear rdf:type rdf:Property ;
    rdfs:label 'Report Year' ;
    rdfs:comment 'Calendar or fiscal year to which the responsible investment report primarily relates.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:targetAudience rdf:type rdf:Property ;
    rdfs:label 'Target Audience' ;
    rdfs:comment 'Primary intended audience for the responsible investment report.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalGhgEmissionsTco2e rdf:type rdf:Property ;
    rdfs:label 'Total Ghg Emissions Tco2e' ;
    rdfs:comment 'Total portfolio greenhouse gas emissions reported in the responsible investment report, measured in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:ResponsibleInvestmentReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paiIndicatorId rdf:type rdf:Property ;
    rdfs:label 'Pai Indicator Id' ;
    rdfs:comment 'Unique identifier for the PAI indicator record.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:indicatorName rdf:type rdf:Property ;
    rdfs:label 'Indicator Name' ;
    rdfs:comment 'Human-readable name of the PAI indicator.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorPaiDisclosureDate rdf:type rdf:Property ;
    rdfs:label 'Indicator Pai Disclosure Date' ;
    rdfs:comment 'Date when the PAI indicator was disclosed to regulators or investors.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indicatorPaiDisclosureDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Indicator Pai Disclosure Document Url' ;
    rdfs:comment 'URL to the official disclosure document for the PAI indicator.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorPaiDisclosureNotes rdf:type rdf:Property ;
    rdfs:label 'Indicator Pai Disclosure Notes' ;
    rdfs:comment 'Additional notes or comments regarding the PAI disclosure.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorPaiDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Indicator Pai Disclosure Required' ;
    rdfs:comment 'Flag indicating if the PAI indicator requires disclosure under SFDR Article 7.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indicatorPaiDisclosureStatus rdf:type rdf:Property ;
    rdfs:label 'Indicator Pai Disclosure Status' ;
    rdfs:comment 'Current status of the PAI disclosure process.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorSource rdf:type rdf:Property ;
    rdfs:label 'Indicator Source' ;
    rdfs:comment 'Source of the indicator data (e.g., MSCI, Bloomberg).' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorSourceDate rdf:type rdf:Property ;
    rdfs:label 'Indicator Source Date' ;
    rdfs:comment 'Date when the source data was published or updated.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indicatorSourceVersion rdf:type rdf:Property ;
    rdfs:label 'Indicator Source Version' ;
    rdfs:comment 'Version or release of the source data used for the indicator.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorType rdf:type rdf:Property ;
    rdfs:label 'Indicator Type' ;
    rdfs:comment 'Classification of the PAI indicator as environmental, social, or governance.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorUnit rdf:type rdf:Property ;
    rdfs:label 'Indicator Unit' ;
    rdfs:comment 'Unit of measurement for the indicator value (e.g., percentage, absolute).' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indicatorValue rdf:type rdf:Property ;
    rdfs:label 'Indicator Value' ;
    rdfs:comment 'Quantitative value of the PAI indicator for the reporting period.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paiIndicatorStatus rdf:type rdf:Property ;
    rdfs:label 'Pai Indicator Status' ;
    rdfs:comment 'Current lifecycle status of the PAI indicator record.' ;
    rdfs:domain ind:PaiIndicator ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityCode rdf:type rdf:Property ;
    rdfs:label 'Activity Code' ;
    rdfs:comment 'Identifier for the specific economic activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:activityDescription rdf:type rdf:Property ;
    rdfs:label 'Activity Description' ;
    rdfs:comment 'Description of the economic activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alignmentEndDate rdf:type rdf:Property ;
    rdfs:label 'Alignment End Date' ;
    rdfs:comment 'Date when the alignment ended or is scheduled to end.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alignmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Alignment Percentage' ;
    rdfs:comment 'Percentage of alignment to the taxonomy objective.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:alignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Alignment Start Date' ;
    rdfs:comment 'Date when the alignment became effective.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:alignmentStatus rdf:type rdf:Property ;
    rdfs:label 'Alignment Status' ;
    rdfs:comment 'Current status of the alignment record.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:alignmentType rdf:type rdf:Property ;
    rdfs:label 'Alignment Type' ;
    rdfs:comment 'Type of investment alignment (direct, co-investment, fund).' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditTrailFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Trail Flag' ;
    rdfs:comment 'Indicates if an audit trail exists for the record.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:biodiversityObjective rdf:type rdf:Property ;
    rdfs:label 'Biodiversity Objective' ;
    rdfs:comment 'Biodiversity objective of the activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:circularEconomyObjective rdf:type rdf:Property ;
    rdfs:label 'Circular Economy Objective' ;
    rdfs:comment 'Circular economy objective of the activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateObjective rdf:type rdf:Property ;
    rdfs:label 'Climate Objective' ;
    rdfs:comment 'Climate-related objective of the activity (e.g., mitigation, adaptation).' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleCapexPct rdf:type rdf:Property ;
    rdfs:label 'Eligible Capex Pct' ;
    rdfs:comment 'Percentage of capital expenditure eligible under the taxonomy.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleOpexPct rdf:type rdf:Property ;
    rdfs:label 'Eligible Opex Pct' ;
    rdfs:comment 'Percentage of operating expenditure eligible under the taxonomy.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eligibleRevenuePct rdf:type rdf:Property ;
    rdfs:label 'Eligible Revenue Pct' ;
    rdfs:comment 'Percentage of revenue eligible under the taxonomy.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pollutionObjective rdf:type rdf:Property ;
    rdfs:label 'Pollution Objective' ;
    rdfs:comment 'Pollution-related objective of the activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Flag' ;
    rdfs:comment 'Indicates if a risk assessment has been performed.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxonomyCode rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Code' ;
    rdfs:comment 'Code identifying the EU Taxonomy activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyEligibilityReason rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Eligibility Reason' ;
    rdfs:comment 'Reason for the eligibility status.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyEligibilityStatus rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Eligibility Status' ;
    rdfs:comment 'Eligibility status of the activity under the taxonomy.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyName rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Name' ;
    rdfs:comment 'Human-readable name of the EU Taxonomy activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxonomyVersion rdf:type rdf:Property ;
    rdfs:label 'Taxonomy Version' ;
    rdfs:comment 'Version of the EU Taxonomy used.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterObjective rdf:type rdf:Property ;
    rdfs:label 'Water Objective' ;
    rdfs:comment 'Water-related objective of the activity.' ;
    rdfs:domain ind:TaxonomyAlignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:orderId rdf:type rdf:Property ;
    rdfs:label 'Order Id' ;
    rdfs:comment 'Unique system identifier for the investment order record. Primary key for the order entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:orderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Order Employee Id' ;
    rdfs:comment 'Reference to the portfolio manager or investment professional who originated the order. Links to employee or user entity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:orderTraderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Order Trader Employee Id' ;
    rdfs:comment 'Reference to the trader assigned to execute the order. May differ from portfolio manager. Links to employee or user entity.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:parentOrderId rdf:type rdf:Property ;
    rdfs:label 'Parent Order Id' ;
    rdfs:comment 'Reference to the parent order if this is a child order resulting from order splitting or algorithmic slicing. Null for top-level orders.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Order .

ind:averageExecutionPrice rdf:type rdf:Property ;
    rdfs:label 'Average Execution Price' ;
    rdfs:comment 'Volume-weighted average price of all fills for this order. Calculated from execution records. Null until first fill occurs.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionAmount rdf:type rdf:Property ;
    rdfs:label 'Commission Amount' ;
    rdfs:comment 'Total brokerage commission charged for executing the order. Expressed in order currency. Null until execution occurs.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionBasisPoints rdf:type rdf:Property ;
    rdfs:label 'Commission Basis Points' ;
    rdfs:comment 'Commission rate expressed in basis points of notional value. One basis point equals 0.01%. Used for performance attribution and TCA.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Completed Timestamp' ;
    rdfs:comment 'Date and time when the order reached a terminal state (filled, cancelled, rejected, or expired). Null for active orders.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:complianceApprovedFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Approved Flag' ;
    rdfs:comment 'Boolean indicator whether the order has passed pre-trade compliance checks (position limits, restricted lists, concentration rules). True if approved, False otherwise.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceOverrideReason rdf:type rdf:Property ;
    rdfs:label 'Compliance Override Reason' ;
    rdfs:comment 'Explanation for any compliance rule override or exception granted for this order. Null if no override was required.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionVenue rdf:type rdf:Property ;
    rdfs:label 'Execution Venue' ;
    rdfs:comment 'Name or code of the exchange, trading platform, or OTC venue where the order is to be executed (e.g., NYSE, NASDAQ, LSE, OTC).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:filledQuantity rdf:type rdf:Property ;
    rdfs:label 'Filled Quantity' ;
    rdfs:comment 'Cumulative number of units executed to date. Updated as partial fills occur. Equals quantity when order is fully filled.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:instructions rdf:type rdf:Property ;
    rdfs:label 'Instructions' ;
    rdfs:comment 'Free-text field capturing special handling instructions, execution preferences, or notes from the portfolio manager to the trader or broker.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:limitPrice rdf:type rdf:Property ;
    rdfs:label 'Limit Price' ;
    rdfs:comment 'Maximum price for buy orders or minimum price for sell orders. Null for market orders. Expressed in order currency.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:orderDate rdf:type rdf:Property ;
    rdfs:label 'Order Date' ;
    rdfs:comment 'Business date on which the order was created by the portfolio manager. Distinct from order_timestamp which captures precise creation time.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remainingQuantity rdf:type rdf:Property ;
    rdfs:label 'Remaining Quantity' ;
    rdfs:comment 'Outstanding quantity yet to be executed. Calculated as quantity minus filled_quantity. Zero when order is complete.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:side rdf:type rdf:Property ;
    rdfs:label 'Side' ;
    rdfs:comment 'Direction of the order: buy (long), sell, short sell, or cover (close short position).' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stopPrice rdf:type rdf:Property ;
    rdfs:label 'Stop Price' ;
    rdfs:comment 'Trigger price for stop and stop-limit orders. Order becomes active when market reaches this level. Null for non-stop orders.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:submittedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submitted Timestamp' ;
    rdfs:comment 'Date and time when the order was submitted to the broker or execution venue. Null if order has not yet been submitted.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:timeInForce rdf:type rdf:Property ;
    rdfs:label 'Time In Force' ;
    rdfs:comment 'Duration for which the order remains active: Day (expires end of trading day), GTC (Good Till Cancelled), IOC (Immediate or Cancel), FOK (Fill or Kill), GTD (Good Till Date), At Open, At Close.' ;
    rdfs:domain ind:Order ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:timestamp rdf:type rdf:Property ;
    rdfs:label 'Timestamp' ;
    rdfs:comment 'Precise date and time when the order was created in the OMS. Primary business event timestamp for order lifecycle tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:orderAllocationId rdf:type rdf:Property ;
    rdfs:label 'Order Allocation Id' ;
    rdfs:comment 'Unique identifier for the order allocation record.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationGroupId rdf:type rdf:Property ;
    rdfs:label 'Allocation Group Id' ;
    rdfs:comment 'Grouping identifier for allocations that are part of the same allocation batch or block trade split.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AllocationGroup .

ind:clearingHouseId rdf:type rdf:Property ;
    rdfs:label 'Clearing House Id' ;
    rdfs:comment 'Central Counterparty (CCP) or clearing house used for this allocation, applicable for exchange-traded and cleared Over-The-Counter (OTC) derivatives.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClearingHouse .

ind:standingSettlementInstructionId rdf:type rdf:Property ;
    rdfs:label 'Standing Settlement Instruction Id' ;
    rdfs:comment 'Reference to the Standard Settlement Instructions (SSI) used for Delivery Versus Payment (DVP) settlement of this allocation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StandingSettlementInstruction .

ind:allocatedNotional rdf:type rdf:Property ;
    rdfs:label 'Allocated Notional' ;
    rdfs:comment 'Notional value of the allocation in the trade currency, calculated as allocated quantity multiplied by execution price.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocatedQuantity rdf:type rdf:Property ;
    rdfs:label 'Allocated Quantity' ;
    rdfs:comment 'Number of units or shares allocated to this portfolio or account from the parent order.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationInstructionType rdf:type rdf:Property ;
    rdfs:label 'Allocation Instruction Type' ;
    rdfs:comment 'Method by which the allocation was determined: automatic system allocation, manual trader instruction, model-driven, or pro-rata distribution.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationReason rdf:type rdf:Property ;
    rdfs:label 'Allocation Reason' ;
    rdfs:comment 'Business rationale or comment explaining the allocation decision, particularly for manual or non-standard allocations.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Allocation Timestamp' ;
    rdfs:comment 'Date and time when the allocation was created or confirmed by the Order Management System (OMS).' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:allocationVersion rdf:type rdf:Property ;
    rdfs:label 'Allocation Version' ;
    rdfs:comment 'Version number of the allocation record, incremented when amendments or corrections are made post-confirmation.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:averagePrice rdf:type rdf:Property ;
    rdfs:label 'Average Price' ;
    rdfs:comment 'Average price at which the allocated quantity was executed, used for settlement and performance attribution.' ;
    rdfs:domain ind:OrderAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmation Timestamp' ;
    rdfs:comment 'Date and time when the allocation was confirmed by the broker or counterparty.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Settlement Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which settlement will occur, may differ from trade currency due to Foreign Exchange (FX) conversion.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionVenueId rdf:type rdf:Property ;
    rdfs:label 'Execution Venue Id' ;
    rdfs:comment 'Foreign key linking to trade.execution_venue. Business justification: Trade executions occur at specific execution venues. The existing venue and venue_mic_code are string identifiers but there is no FK to the execution_venue master table.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ExecutionVenue .

ind:algorithm rdf:type rdf:Property ;
    rdfs:label 'Algorithm' ;
    rdfs:comment 'Name or identifier of the algorithmic trading strategy used for execution.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averagePriceFlag rdf:type rdf:Property ;
    rdfs:label 'Average Price Flag' ;
    rdfs:comment 'Indicates whether this execution is part of an average price order.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkPrice rdf:type rdf:Property ;
    rdfs:label 'Benchmark Price' ;
    rdfs:comment 'Reference benchmark price used for execution quality analysis.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capacity rdf:type rdf:Property ;
    rdfs:label 'Capacity' ;
    rdfs:comment 'Capacity in which the broker executed the trade.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingHouse rdf:type rdf:Property ;
    rdfs:label 'Clearing House' ;
    rdfs:comment 'Name or identifier of the central counterparty clearing house.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionCurrency rdf:type rdf:Property ;
    rdfs:label 'Commission Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the commission amount.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationReceivedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Confirmation Received Timestamp' ;
    rdfs:comment 'Date and time when trade confirmation was received from the broker or venue.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dvpIndicator rdf:type rdf:Property ;
    rdfs:label 'Dvp Indicator' ;
    rdfs:comment 'Indicates whether the execution will settle on a delivery versus payment basis.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:executedPrice rdf:type rdf:Property ;
    rdfs:label 'Executed Price' ;
    rdfs:comment 'Price per unit at which the execution occurred.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executedQuantity rdf:type rdf:Property ;
    rdfs:label 'Executed Quantity' ;
    rdfs:comment 'Number of units or shares executed in this fill event.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executingTrader rdf:type rdf:Property ;
    rdfs:label 'Executing Trader' ;
    rdfs:comment 'Name or identifier of the trader who executed the order.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionStatus rdf:type rdf:Property ;
    rdfs:label 'Execution Status' ;
    rdfs:comment 'Current lifecycle status of the execution event.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionType rdf:type rdf:Property ;
    rdfs:label 'Execution Type' ;
    rdfs:comment 'Classification of the execution event type per FIX protocol standards. [ENUM-REF-CANDIDATE: new|partial_fill|fill|cancelled|replaced|pending_cancel|rejected — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastMarketFlag rdf:type rdf:Property ;
    rdfs:label 'Last Market Flag' ;
    rdfs:comment 'Indicates whether this is the final execution for the parent order.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:liquidityIndicator rdf:type rdf:Property ;
    rdfs:label 'Liquidity Indicator' ;
    rdfs:comment 'Indicates whether the execution added or removed liquidity from the market.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Net Settlement Amount' ;
    rdfs:comment 'Net amount payable or receivable after commissions and fees.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceDeviationBps rdf:type rdf:Property ;
    rdfs:label 'Price Deviation Bps' ;
    rdfs:comment 'Deviation of executed price from benchmark price expressed in basis points.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementCycle rdf:type rdf:Property ;
    rdfs:label 'Settlement Cycle' ;
    rdfs:comment 'Number of business days between trade date and settlement date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeReportingIndicator rdf:type rdf:Property ;
    rdfs:label 'Trade Reporting Indicator' ;
    rdfs:comment 'Status of regulatory trade reporting for this execution.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venue rdf:type rdf:Property ;
    rdfs:label 'Venue' ;
    rdfs:comment 'Name or code of the exchange, ECN, or trading venue where the execution occurred.' ;
    rdfs:domain ind:Execution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:venueMicCode rdf:type rdf:Property ;
    rdfs:label 'Venue Mic Code' ;
    rdfs:comment 'ISO 10383 four-character Market Identifier Code for the execution venue.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerLei rdf:type rdf:Property ;
    rdfs:label 'Broker Lei' ;
    rdfs:comment 'ISO 17442 standard 20-character alphanumeric code uniquely identifying the broker legal entity globally.' ;
    rdfs:domain ind:Blotter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commission rdf:type rdf:Property ;
    rdfs:label 'Commission' ;
    rdfs:comment 'Brokerage commission charged for executing the trade. Paid to the executing broker.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceRuleBreached rdf:type rdf:Property ;
    rdfs:label 'Compliance Rule Breached' ;
    rdfs:comment 'Identifier of the compliance rule that was breached, if any. Used for exception reporting and audit trail.' ;
    rdfs:domain ind:Blotter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fees rdf:type rdf:Property ;
    rdfs:label 'Fees' ;
    rdfs:comment 'Additional fees associated with the trade execution. Includes exchange fees, clearing fees, and regulatory fees.' ;
    rdfs:domain ind:Blotter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:micCode rdf:type rdf:Property ;
    rdfs:label 'Mic Code' ;
    rdfs:comment 'ISO 10383 standard 4-character code identifying the exchange or trading venue.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:price rdf:type rdf:Property ;
    rdfs:label 'Price' ;
    rdfs:comment 'Execution price per unit of the security. For bonds, may be expressed as percentage of par; for equities, price per share.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceCurrency rdf:type rdf:Property ;
    rdfs:label 'Price Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the trade price is denominated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Trade Confirmation Number' ;
    rdfs:comment 'Confirmation reference number provided by the broker or counterparty. Used for trade matching and reconciliation.' ;
    rdfs:domain ind:Blotter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeNotes rdf:type rdf:Property ;
    rdfs:label 'Trade Notes' ;
    rdfs:comment 'Free-text notes or comments about the trade. Captures trader rationale, special instructions, or execution commentary.' ;
    rdfs:domain ind:Blotter ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeStatus rdf:type rdf:Property ;
    rdfs:label 'Trade Status' ;
    rdfs:comment 'Current lifecycle state of the trade in the settlement workflow. Tracks progression from execution to final settlement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeTimestamp rdf:type rdf:Property ;
    rdfs:label 'Trade Timestamp' ;
    rdfs:comment 'Precise date and time when the trade was executed. Includes timezone for global trading operations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:affirmationStatus rdf:type rdf:Property ;
    rdfs:label 'Affirmation Status' ;
    rdfs:comment 'Status indicating whether the institutional investor has affirmed the trade details with the broker or custodian.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:affirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Affirmation Timestamp' ;
    rdfs:comment 'Date and time when the trade was affirmed by the institutional investor.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ccpClearingMember rdf:type rdf:Property ;
    rdfs:label 'Ccp Clearing Member' ;
    rdfs:comment 'Name of the clearing member through which the trade is cleared at the CCP.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Counterparty Account Number' ;
    rdfs:comment 'The account number at the counterparty\'s custodian or depository where securities or cash will be delivered or received.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyCustodianBic rdf:type rdf:Property ;
    rdfs:label 'Counterparty Custodian Bic' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code (SWIFT code) of the counterparty\'s custodian institution.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianBic rdf:type rdf:Property ;
    rdfs:label 'Custodian Bic' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code (SWIFT code) of the custodian institution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositoryCode rdf:type rdf:Property ;
    rdfs:label 'Depository Code' ;
    rdfs:comment 'Standard code identifying the central securities depository or clearing system.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositoryName rdf:type rdf:Property ;
    rdfs:label 'Depository Name' ;
    rdfs:comment 'Name of the central securities depository or clearing system where the securities are held (e.g., DTC, Euroclear, Clearstream).' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failureCode rdf:type rdf:Property ;
    rdfs:label 'Failure Code' ;
    rdfs:comment 'Standardized code representing the category of settlement failure.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionGenerationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Instruction Generation Timestamp' ;
    rdfs:comment 'Date and time when the settlement instruction was generated by the order management or portfolio management system.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:instructionReference rdf:type rdf:Property ;
    rdfs:label 'Instruction Reference' ;
    rdfs:comment 'External reference number or identifier for the settlement instruction, used for reconciliation and communication with counterparties and custodians.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionSentTimestamp rdf:type rdf:Property ;
    rdfs:label 'Instruction Sent Timestamp' ;
    rdfs:comment 'Date and time when the settlement instruction was transmitted to the custodian or depository.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:instructionStatus rdf:type rdf:Property ;
    rdfs:label 'Instruction Status' ;
    rdfs:comment 'Current lifecycle status of the settlement instruction in the settlement workflow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instructionType rdf:type rdf:Property ;
    rdfs:label 'Instruction Type' ;
    rdfs:comment 'Indicates whether this instruction is for delivery of securities, receipt of securities, payment of cash, or receipt of cash.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchingStatus rdf:type rdf:Property ;
    rdfs:label 'Matching Status' ;
    rdfs:comment 'Status indicating whether the settlement instruction has been matched with the counterparty\'s instruction.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partialSettlementAllowed rdf:type rdf:Property ;
    rdfs:label 'Partial Settlement Allowed' ;
    rdfs:comment 'Indicates whether partial settlement of the instruction is permitted if the full quantity is not available.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placeOfSettlement rdf:type rdf:Property ;
    rdfs:label 'Place Of Settlement' ;
    rdfs:comment 'Three-letter ISO 3166 country code indicating the jurisdiction where settlement occurs.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementFees rdf:type rdf:Property ;
    rdfs:label 'Settlement Fees' ;
    rdfs:comment 'Total fees charged by custodians, depositories, or clearing systems for processing the settlement.' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementPriority rdf:type rdf:Property ;
    rdfs:label 'Settlement Priority' ;
    rdfs:comment 'Priority level assigned to the settlement instruction for processing by custodians and clearing systems.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Settlement Timestamp' ;
    rdfs:comment 'Date and time when the settlement was actually completed and confirmed by the depository or custodian.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:settlementType rdf:type rdf:Property ;
    rdfs:label 'Settlement Type' ;
    rdfs:comment 'Classification of the settlement cycle: regular (T+2), cash (T+0), next day (T+1), or seller option (custom date).' ;
    rdfs:domain ind:SettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeConfirmationReference rdf:type rdf:Property ;
    rdfs:label 'Trade Confirmation Reference' ;
    rdfs:comment 'Reference number from the trade confirmation document linking this settlement instruction to the original trade.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementFailId rdf:type rdf:Property ;
    rdfs:label 'Settlement Fail Id' ;
    rdfs:comment 'Unique identifier for the settlement failure event record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementFail .

ind:actualSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Actual Settlement Date' ;
    rdfs:comment 'The date on which the trade ultimately settled successfully, resolving the fail.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assignedTo rdf:type rdf:Property ;
    rdfs:label 'Assigned To' ;
    rdfs:comment 'Name or identifier of the operations team member or desk responsible for resolving the settlement failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyInExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Buy In Execution Date' ;
    rdfs:comment 'Date on which a buy-in transaction was executed in the market to cover the failed settlement.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:buyInNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Buy In Notice Date' ;
    rdfs:comment 'Date on which a formal buy-in notice was issued to the failing party under CSDR mandatory buy-in rules.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:buyInRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Buy In Risk Flag' ;
    rdfs:comment 'Indicates whether the settlement failure has reached a threshold that triggers buy-in risk under CSDR or contractual terms.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clearingSystem rdf:type rdf:Property ;
    rdfs:label 'Clearing System' ;
    rdfs:comment 'Name of the central securities depository or clearing system where the settlement failure occurred.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dvpModel rdf:type rdf:Property ;
    rdfs:label 'Dvp Model' ;
    rdfs:comment 'The DVP settlement model applicable to this trade as defined by the Bank for International Settlements.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failAmount rdf:type rdf:Property ;
    rdfs:label 'Fail Amount' ;
    rdfs:comment 'Monetary value of the securities that failed to settle, in the trade currency.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failCurrency rdf:type rdf:Property ;
    rdfs:label 'Fail Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the monetary value of the failed settlement.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failDate rdf:type rdf:Property ;
    rdfs:label 'Fail Date' ;
    rdfs:comment 'The contractual settlement date on which the trade failed to settle as expected.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:failDetectedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Fail Detected Timestamp' ;
    rdfs:comment 'System timestamp when the settlement failure was first identified and recorded in the operations system.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:failDurationDays rdf:type rdf:Property ;
    rdfs:label 'Fail Duration Days' ;
    rdfs:comment 'Number of business days the settlement has been outstanding since the original fail date.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:failPartyType rdf:type rdf:Property ;
    rdfs:label 'Fail Party Type' ;
    rdfs:comment 'Classification of the party responsible for or contributing to the settlement failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failQuantity rdf:type rdf:Property ;
    rdfs:label 'Fail Quantity' ;
    rdfs:comment 'Number of units or shares that failed to settle on the contractual settlement date.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:failReasonCode rdf:type rdf:Property ;
    rdfs:label 'Fail Reason Code' ;
    rdfs:comment 'Standardized code indicating the root cause of the settlement failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Fail Reason Description' ;
    rdfs:comment 'Detailed narrative explanation of the circumstances that caused the settlement failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fail Reference Number' ;
    rdfs:comment 'External reference number assigned by custodian or clearing system to track the settlement failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failSide rdf:type rdf:Property ;
    rdfs:label 'Fail Side' ;
    rdfs:comment 'Indicates whether the failure occurred on the buy side or sell side of the transaction.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:failStatus rdf:type rdf:Property ;
    rdfs:label 'Fail Status' ;
    rdfs:comment 'Current lifecycle status of the settlement failure event.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Revised Settlement Date' ;
    rdfs:comment 'Updated target settlement date negotiated or projected after the initial failure.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ssiCorrectionDate rdf:type rdf:Property ;
    rdfs:label 'Ssi Correction Date' ;
    rdfs:comment 'Date on which corrected Standard Settlement Instructions were provided to resolve the mismatch.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ssiMismatchFlag rdf:type rdf:Property ;
    rdfs:label 'Ssi Mismatch Flag' ;
    rdfs:comment 'Indicates whether the failure was caused by a mismatch in Standard Settlement Instructions between counterparties.' ;
    rdfs:domain ind:SettlementFail ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confirmationId rdf:type rdf:Property ;
    rdfs:label 'Confirmation Id' ;
    rdfs:comment 'Unique identifier for the trade confirmation record.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clearingHouseLei rdf:type rdf:Property ;
    rdfs:label 'Clearing House Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier of the clearing house or CCP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationStatus rdf:type rdf:Property ;
    rdfs:label 'Confirmation Status' ;
    rdfs:comment 'Current lifecycle status of the trade confirmation indicating matching and affirmation state. [ENUM-REF-CANDIDATE: unconfirmed|matched|mismatched|affirmed|pending_affirmation|cancelled|rejected — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmationType rdf:type rdf:Property ;
    rdfs:label 'Confirmation Type' ;
    rdfs:comment 'Method by which the confirmation was received or transmitted, such as electronic via SWIFT or FIX, verbal, or written.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confirmedPrice rdf:type rdf:Property ;
    rdfs:label 'Confirmed Price' ;
    rdfs:comment 'Price per unit confirmed by the counterparty, used for matching against executed price.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedQuantity rdf:type rdf:Property ;
    rdfs:label 'Confirmed Quantity' ;
    rdfs:comment 'Quantity of the instrument confirmed by the counterparty, used for matching against executed quantity.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedSettlementAmount rdf:type rdf:Property ;
    rdfs:label 'Confirmed Settlement Amount' ;
    rdfs:comment 'Net settlement amount confirmed by the counterparty, including adjustments for accrued interest, commissions, and fees.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confirmedTradeValue rdf:type rdf:Property ;
    rdfs:label 'Confirmed Trade Value' ;
    rdfs:comment 'Total trade value confirmed by the counterparty, calculated as confirmed quantity multiplied by confirmed price.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyConfirmationNumber rdf:type rdf:Property ;
    rdfs:label 'Counterparty Confirmation Number' ;
    rdfs:comment 'Confirmation reference number assigned by the counterparty for cross-referencing and reconciliation purposes.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixMessageType rdf:type rdf:Property ;
    rdfs:label 'Fix Message Type' ;
    rdfs:comment 'FIX protocol message type used for electronic confirmation, such as ExecutionReport or AllocationReport.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchedBy rdf:type rdf:Property ;
    rdfs:label 'Matched By' ;
    rdfs:comment 'User or system that performed the confirmation matching and affirmation process.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:matchedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Matched Timestamp' ;
    rdfs:comment 'Date and time when the confirmation was successfully matched against internal execution records.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:mismatchReason rdf:type rdf:Property ;
    rdfs:label 'Mismatch Reason' ;
    rdfs:comment 'Description of any discrepancies between internal execution records and counterparty confirmation, such as quantity, price, or settlement date mismatches.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiReference rdf:type rdf:Property ;
    rdfs:label 'Ssi Reference' ;
    rdfs:comment 'Reference to the Standard Settlement Instructions used for this trade, defining payment and delivery details.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:swiftMessageType rdf:type rdf:Property ;
    rdfs:label 'Swift Message Type' ;
    rdfs:comment 'SWIFT message type used for electronic confirmation transmission, such as MT515 for client confirmation or MT518 for market-side confirmation.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeSide rdf:type rdf:Property ;
    rdfs:label 'Trade Side' ;
    rdfs:comment 'Indicates whether the pension fund is buying or selling the instrument in this trade.' ;
    rdfs:domain ind:Confirmation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underlyingInstrumentId rdf:type rdf:Property ;
    rdfs:label 'Underlying Instrument Id' ;
    rdfs:comment 'Reference to the underlying instrument for derivatives. Links to another instrument record.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Instrument .

ind:cfiCode rdf:type rdf:Property ;
    rdfs:label 'Cfi Code' ;
    rdfs:comment '6-character ISO 10962 code classifying the instrument by category, group, and attributes.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractSize rdf:type rdf:Property ;
    rdfs:label 'Contract Size' ;
    rdfs:comment 'Notional size or multiplier for derivative contracts (e.g., number of shares per option contract).' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:convertibleFlag rdf:type rdf:Property ;
    rdfs:label 'Convertible Flag' ;
    rdfs:comment 'Boolean indicator of whether the instrument can be converted into another security (typically equity).' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exerciseStyle rdf:type rdf:Property ;
    rdfs:label 'Exercise Style' ;
    rdfs:comment 'Style of option exercise: American (any time), European (expiry only), or Bermudan (specific dates).' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:figi rdf:type rdf:Property ;
    rdfs:label 'Figi' ;
    rdfs:comment '12-character alphanumeric code providing a universal identifier for financial instruments per Bloomberg Open Symbology.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:instrumentName rdf:type rdf:Property ;
    rdfs:label 'Instrument Name' ;
    rdfs:comment 'Full legal or common name of the financial instrument as recognized in the market.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strikePrice rdf:type rdf:Property ;
    rdfs:label 'Strike Price' ;
    rdfs:comment 'Exercise price for options and other derivative instruments.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tickSize rdf:type rdf:Property ;
    rdfs:label 'Tick Size' ;
    rdfs:comment 'Minimum price increment for trading the instrument on the exchange.' ;
    rdfs:domain ind:Instrument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finraMemberId rdf:type rdf:Property ;
    rdfs:label 'Finra Member Id' ;
    rdfs:comment 'FINRA member identifier for U.S. broker-dealers subject to FINRA oversight.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Member .

ind:approvedAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Approved Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset classes for which the broker is approved to execute trades (e.g., equities, fixed income, FX, derivatives, commodities).' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bic rdf:type rdf:Property ;
    rdfs:label 'Bic' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code (SWIFT code) used for settlement instructions and payment routing to the broker.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerStatus rdf:type rdf:Property ;
    rdfs:label 'Broker Status' ;
    rdfs:comment 'Current operational status of the broker relationship indicating whether the broker is approved for trade execution.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:brokerType rdf:type rdf:Property ;
    rdfs:label 'Broker Type' ;
    rdfs:comment 'Classification of the broker-dealer by service model and execution capability.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingArrangement rdf:type rdf:Property ;
    rdfs:label 'Clearing Arrangement' ;
    rdfs:comment 'Type of clearing arrangement used by the broker for trade settlement.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingHouseName rdf:type rdf:Property ;
    rdfs:label 'Clearing House Name' ;
    rdfs:comment 'Name of the central counterparty (CCP) or clearing house used by the broker for trade clearing and settlement.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionStructure rdf:type rdf:Property ;
    rdfs:label 'Commission Structure' ;
    rdfs:comment 'Description of the commission and fee structure applicable to trades executed through this broker (e.g., basis points, fixed per trade, tiered).' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyRiskLimit rdf:type rdf:Property ;
    rdfs:label 'Counterparty Risk Limit' ;
    rdfs:comment 'Maximum exposure limit (in base currency) allowed with this broker for counterparty risk management purposes.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:csaFlag rdf:type rdf:Property ;
    rdfs:label 'Csa Flag' ;
    rdfs:comment 'Indicates whether a Credit Support Annex is in place with this broker for collateral management on OTC derivatives.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:csaThresholdAmount rdf:type rdf:Property ;
    rdfs:label 'Csa Threshold Amount' ;
    rdfs:comment 'Threshold amount (in base currency) below which collateral is not required under the CSA with this broker.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dvpCapabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Dvp Capability Flag' ;
    rdfs:comment 'Indicates whether the broker supports Delivery Versus Payment (DVP) settlement to mitigate settlement risk.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:executionCapabilities rdf:type rdf:Property ;
    rdfs:label 'Execution Capabilities' ;
    rdfs:comment 'Description of the brokers execution capabilities including algorithmic trading, direct market access (DMA), high-touch services, and electronic trading platforms.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fcaFirmReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Fca Firm Reference Number' ;
    rdfs:comment 'FCA-issued firm reference number for UK-regulated broker-dealers.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isdaAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Isda Agreement Date' ;
    rdfs:comment 'Date on which the ISDA Master Agreement with this broker was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isdaMasterAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Isda Master Agreement Flag' ;
    rdfs:comment 'Indicates whether an ISDA Master Agreement is in place with this broker for over-the-counter (OTC) derivatives trading.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:secRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Sec Registration Number' ;
    rdfs:comment 'SEC-issued registration number for U.S.-registered broker-dealers.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiOnFileFlag rdf:type rdf:Property ;
    rdfs:label 'Ssi On File Flag' ;
    rdfs:comment 'Indicates whether Standard Settlement Instructions (SSI) are on file and current for this broker.' ;
    rdfs:domain ind:Broker ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:brokerCommissionId rdf:type rdf:Property ;
    rdfs:label 'Broker Commission Id' ;
    rdfs:comment 'Unique identifier for the broker commission record.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentCashAccountId rdf:type rdf:Property ;
    rdfs:label 'Payment Cash Account Id' ;
    rdfs:comment 'Foreign key linking to treasury.cash_account. Business justification: Commission payments to brokers settle through specific cash accounts. Finance teams need this link for commission payment processing, cash forecasting, and broker payables' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashAccount .

ind:commissionBasis rdf:type rdf:Property ;
    rdfs:label 'Commission Basis' ;
    rdfs:comment 'Method by which the commission is calculated: per share, percentage of trade value, flat fee per trade, tiered schedule, notional-based, or ticket charge.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Commission Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the commission is denominated.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionRateBps rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Bps' ;
    rdfs:comment 'Commission rate expressed in basis points of the trade notional value.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionRatePerShare rdf:type rdf:Property ;
    rdfs:label 'Commission Rate Per Share' ;
    rdfs:comment 'Commission charge per share or unit traded, applicable for per-share commission structures.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commissionReference rdf:type rdf:Property ;
    rdfs:label 'Commission Reference' ;
    rdfs:comment 'External reference or invoice number assigned by the broker for this commission charge.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commissionSharingArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Commission Sharing Arrangement Flag' ;
    rdfs:comment 'Indicates whether this commission is part of a commission sharing arrangement with multiple brokers.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commissionType rdf:type rdf:Property ;
    rdfs:label 'Commission Type' ;
    rdfs:comment 'Classification of the commission structure: explicit fee, soft dollar arrangement, research payment account, bundled service, execution-only, or full-service.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:executionQualityTier rdf:type rdf:Property ;
    rdfs:label 'Execution Quality Tier' ;
    rdfs:comment 'Internal rating of the brokers execution quality for this trade, used for best execution monitoring.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchPaymentAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Research Payment Account Flag' ;
    rdfs:comment 'Indicates whether this commission is allocated to a research payment account under MiFID II unbundling rules.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:softDollarFlag rdf:type rdf:Property ;
    rdfs:label 'Soft Dollar Flag' ;
    rdfs:comment 'Indicates whether this commission includes soft dollar benefits or bundled research services.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tradeNotionalValue rdf:type rdf:Property ;
    rdfs:label 'Trade Notional Value' ;
    rdfs:comment 'Gross notional value of the underlying trade used as the basis for commission calculation.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradeQuantity rdf:type rdf:Property ;
    rdfs:label 'Trade Quantity' ;
    rdfs:comment 'Number of shares or units traded, used for per-share commission calculations.' ;
    rdfs:domain ind:BrokerCommission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficiaryAccountName rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Account Name' ;
    rdfs:comment 'Name on the beneficiary account for settlement proceeds.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:beneficiaryAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Beneficiary Account Number' ;
    rdfs:comment 'Account number for the beneficiary receiving settlement proceeds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingSystemCode rdf:type rdf:Property ;
    rdfs:label 'Clearing System Code' ;
    rdfs:comment 'Code identifying the clearing system or Central Counterparty (CCP) used.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositoryAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Depository Account Number' ;
    rdfs:comment 'Account number at the depository or custodian where securities are held.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositoryBic rdf:type rdf:Property ;
    rdfs:label 'Depository Bic' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code for the depository institution.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:emirReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Emir Reporting Flag' ;
    rdfs:comment 'Indicates whether this SSI requires EMIR trade reporting for derivatives.' ;
    rdfs:domain ind:Trade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:intermediaryAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Intermediary Account Number' ;
    rdfs:comment 'Account number at the intermediary institution, if applicable.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryBic rdf:type rdf:Property ;
    rdfs:label 'Intermediary Bic' ;
    rdfs:comment 'ISO 9362 Bank Identifier Code for any intermediary institution in the settlement chain.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityIndicator rdf:type rdf:Property ;
    rdfs:label 'Priority Indicator' ;
    rdfs:comment 'Priority level for settlement processing of trades using this SSI.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safekeepingAccount rdf:type rdf:Property ;
    rdfs:label 'Safekeeping Account' ;
    rdfs:comment 'Account number for safekeeping of securities at the custodian.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specialInstructions rdf:type rdf:Property ;
    rdfs:label 'Special Instructions' ;
    rdfs:comment 'Free-text field for any special settlement instructions or conditions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiStatus rdf:type rdf:Property ;
    rdfs:label 'Ssi Status' ;
    rdfs:comment 'Current lifecycle status of the SSI record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ssiVersion rdf:type rdf:Property ;
    rdfs:label 'Ssi Version' ;
    rdfs:comment 'Version number of this SSI record, incremented with each update.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standingInstructionType rdf:type rdf:Property ;
    rdfs:label 'Standing Instruction Type' ;
    rdfs:comment 'Indicates whether this SSI applies to receive, deliver, or both directions.' ;
    rdfs:domain ind:StandingSettlementInstruction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxTradeId rdf:type rdf:Property ;
    rdfs:label 'Fx Trade Id' ;
    rdfs:comment 'Unique identifier for the foreign exchange trade transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FxTrade .

ind:isdaMasterId rdf:type rdf:Property ;
    rdfs:label 'Isda Master Id' ;
    rdfs:comment 'Foreign key linking to collateral.isda_master. Business justification: FX forwards and swaps are governed by ISDA agreements. Pension funds hedge currency exposure extensively; ISDA linkage enables netting and close-out netting calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IsdaMaster .

ind:baseAmount rdf:type rdf:Property ;
    rdfs:label 'Base Amount' ;
    rdfs:comment 'The notional amount in the base currency being sold or exchanged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkSource rdf:type rdf:Property ;
    rdfs:label 'Benchmark Source' ;
    rdfs:comment 'Source or provider of the benchmark exchange rate, such as WM/Reuters, ECB, or Bloomberg.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exchangeRate rdf:type rdf:Property ;
    rdfs:label 'Exchange Rate' ;
    rdfs:comment 'The agreed exchange rate at which the base currency is converted to the quote currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionMethod rdf:type rdf:Property ;
    rdfs:label 'Execution Method' ;
    rdfs:comment 'Method by which the FX trade was executed: electronic platform, voice broker, request for quote, or algorithmic trading.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forwardPoints rdf:type rdf:Property ;
    rdfs:label 'Forward Points' ;
    rdfs:comment 'The adjustment to the spot rate to derive the forward rate, reflecting interest rate differentials between the two currencies.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeDesignation rdf:type rdf:Property ;
    rdfs:label 'Hedge Designation' ;
    rdfs:comment 'Accounting classification of the FX trade for hedge accounting purposes under IFRS 9 or equivalent standards.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgeEffectivenessTest rdf:type rdf:Property ;
    rdfs:label 'Hedge Effectiveness Test' ;
    rdfs:comment 'Type of hedge effectiveness testing applied to this FX trade if designated as a hedge.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndfFixingDate rdf:type rdf:Property ;
    rdfs:label 'Ndf Fixing Date' ;
    rdfs:comment 'The date on which the reference exchange rate is determined for settlement of a non-deliverable forward contract.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndfFixingSource rdf:type rdf:Property ;
    rdfs:label 'Ndf Fixing Source' ;
    rdfs:comment 'The reference rate source used to determine the fixing rate for NDF settlement, such as central bank or Reuters page.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notionalAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Notional Amount Usd' ;
    rdfs:comment 'The total notional value of the FX trade converted to USD for reporting and risk aggregation purposes.' ;
    rdfs:domain ind:FxTrade ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quoteAmount rdf:type rdf:Property ;
    rdfs:label 'Quote Amount' ;
    rdfs:comment 'The notional amount in the quote currency being bought or received.' ;
