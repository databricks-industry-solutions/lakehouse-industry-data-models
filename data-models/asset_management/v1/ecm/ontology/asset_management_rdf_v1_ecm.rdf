    rdfs:comment 'Market development classification for the geographic region, distinguishing developed, emerging, and frontier markets.' ;
    rdfs:domain ind:CoverageUniverse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:researchNotes rdf:type rdf:Property ;
    rdfs:label 'Research Notes' ;
    rdfs:comment 'Internal research commentary and qualitative notes on the covered entity, capturing analyst insights and investment thesis.' ;
    rdfs:domain ind:CoverageUniverse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:universeCode rdf:type rdf:Property ;
