ind:assignmentStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Timestamp' ;
    rdfs:comment 'Precise timestamp when the analyst assignment was initiated in the research management system.' ;
    rdfs:domain ind:AnalystAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:collaborationTeam rdf:type rdf:Property ;
    rdfs:label 'Collaboration Team' ;
    rdfs:comment 'Names or identifiers of other analysts, portfolio managers, or teams collaborating on this coverage assignment.' ;
    rdfs:domain ind:AnalystAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conflictDescription rdf:type rdf:Property ;
    rdfs:label 'Conflict Description' ;
