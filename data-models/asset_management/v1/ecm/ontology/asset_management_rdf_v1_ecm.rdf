ind:complianceSystemFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance System Flag' ;
    rdfs:comment 'Indicates whether this restriction is actively enforced by automated compliance monitoring systems.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgCriteria rdf:type rdf:Property ;
    rdfs:label 'Esg Criteria' ;
    rdfs:comment 'ESG criteria or exclusion rationale for this restriction, if applicable.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionLevel rdf:type rdf:Property ;
    rdfs:label 'Restriction Level' ;
    rdfs:comment 'Hierarchical level at which the restriction applies: fund, portfolio, security, issuer, sector, country, or asset class. [ENUM-REF-CANDIDATE: fund|portfolio|security|issuer|sector|country|asset_class — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateReference rdf:type rdf:Property ;
    rdfs:label 'Mandate Reference' ;
    rdfs:comment 'Reference to the investment mandate or Limited Partnership Agreement (LPA) clause imposing this restriction.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionName rdf:type rdf:Property ;
    rdfs:label 'Restriction Name' ;
    rdfs:comment 'Human-readable name or title of the restriction rule.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationRecipientList rdf:type rdf:Property ;
    rdfs:label 'Notification Recipient List' ;
    rdfs:comment 'Comma-separated list of roles or individuals to be notified upon breach.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Override Allowed Flag' ;
    rdfs:comment 'Indicates whether this restriction can be overridden with appropriate approval.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideApprovalLevel rdf:type rdf:Property ;
    rdfs:label 'Override Approval Level' ;
    rdfs:comment 'Required approval authority level for override: Chief Investment Officer (CIO), Chief Risk Officer (CRO), Investment Committee (IC), Board, or none.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Policy Document Reference' ;
    rdfs:comment 'Reference to the policy document or regulation defining this restriction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryAuthority rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority' ;
    rdfs:comment 'Name of the regulatory body mandating this restriction, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionStatus rdf:type rdf:Property ;
    rdfs:label 'Restriction Status' ;
    rdfs:comment 'Current lifecycle status of the restriction rule.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restrictionType rdf:type rdf:Property ;
    rdfs:label 'Restriction Type' ;
    rdfs:comment 'Category of restriction: regulatory, mandate, ESG exclusion, sanctions, internal policy, or concentration limit.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsList rdf:type rdf:Property ;
    rdfs:label 'Sanctions List' ;
    rdfs:comment 'Name of the sanctions list or watchlist triggering this restriction, if applicable.' ;
    rdfs:domain ind:Restriction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexRebalanceEventId rdf:type rdf:Property ;
    rdfs:label 'Index Rebalance Event Id' ;
    rdfs:comment 'Unique identifier for the index rebalancing event record.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:announcementDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Announcement Document Url' ;
    rdfs:comment 'Web link to the official rebalancing announcement document published by the index provider.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:announcementTimestamp rdf:type rdf:Property ;
    rdfs:label 'Announcement Timestamp' ;
    rdfs:comment 'Precise date and time when the rebalancing announcement was published.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:cappingAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Capping Applied Flag' ;
    rdfs:comment 'Indicates whether constituent weight capping rules were applied during rebalancing.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Review Required Flag' ;
    rdfs:comment 'Indicates whether internal compliance review is required before trading on this rebalancing.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:constituentListUrl rdf:type rdf:Property ;
    rdfs:label 'Constituent List Url' ;
    rdfs:comment 'Web link to the detailed list of additions, deletions, and weight changes.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Effective Timestamp' ;
    rdfs:comment 'Precise date and time when the rebalancing changes take effect.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:esgCriteriaAppliedFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Criteria Applied Flag' ;
    rdfs:comment 'Indicates whether ESG screening or criteria were applied in this rebalancing.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedTradingVolume rdf:type rdf:Property ;
    rdfs:label 'Estimated Trading Volume' ;
    rdfs:comment 'Projected total trading volume in base currency required to implement rebalancing.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedTurnoverPercent rdf:type rdf:Property ;
    rdfs:label 'Estimated Turnover Percent' ;
    rdfs:comment 'Projected portfolio turnover percentage resulting from the rebalancing changes.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freeFloatMinimumPercent rdf:type rdf:Property ;
    rdfs:label 'Free Float Minimum Percent' ;
    rdfs:comment 'Minimum free float percentage required for a security to be eligible for inclusion.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impactAssessmentSummary rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment Summary' ;
    rdfs:comment 'Internal summary of the expected portfolio impact from this rebalancing event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityThreshold rdf:type rdf:Property ;
    rdfs:label 'Liquidity Threshold' ;
    rdfs:comment 'Minimum average daily trading volume or turnover required for index inclusion.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketCapCutoff rdf:type rdf:Property ;
    rdfs:label 'Market Cap Cutoff' ;
    rdfs:comment 'Minimum market capitalization threshold applied for index inclusion eligibility.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumConstituentWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Maximum Constituent Weight Percent' ;
    rdfs:comment 'Maximum allowable weight for any single constituent after capping rules are applied.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Methodology Version' ;
    rdfs:comment 'Version identifier of the index methodology applied for this rebalancing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfAdditions rdf:type rdf:Property ;
    rdfs:label 'Number Of Additions' ;
    rdfs:comment 'Count of securities added to the index during this rebalancing event.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfDeletions rdf:type rdf:Property ;
    rdfs:label 'Number Of Deletions' ;
    rdfs:comment 'Count of securities removed from the index during this rebalancing event.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfWeightChanges rdf:type rdf:Property ;
    rdfs:label 'Number Of Weight Changes' ;
    rdfs:comment 'Count of existing constituents with modified index weights.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:portfolioExposureFlag rdf:type rdf:Property ;
    rdfs:label 'Portfolio Exposure Flag' ;
    rdfs:comment 'Indicates whether the pension fund holds positions that are affected by this rebalancing.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rebalanceRationale rdf:type rdf:Property ;
    rdfs:label 'Rebalance Rationale' ;
    rdfs:comment 'Business reason or trigger for the rebalancing event as stated by the index provider.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalanceStatus rdf:type rdf:Property ;
    rdfs:label 'Rebalance Status' ;
    rdfs:comment 'Current lifecycle state of the rebalancing event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rebalanceType rdf:type rdf:Property ;
    rdfs:label 'Rebalance Type' ;
    rdfs:comment 'Classification of the rebalancing event based on schedule and trigger.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Review Period End Date' ;
    rdfs:comment 'End date of the data observation period used to determine rebalancing changes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reviewPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Review Period Start Date' ;
    rdfs:comment 'Start date of the data observation period used to determine rebalancing changes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sectorRebalanceFlag rdf:type rdf:Property ;
    rdfs:label 'Sector Rebalance Flag' ;
    rdfs:comment 'Indicates whether sector classification changes are part of this rebalancing event.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalConstituentsPostRebalance rdf:type rdf:Property ;
    rdfs:label 'Total Constituents Post Rebalance' ;
    rdfs:comment 'Total number of securities in the index after rebalancing is complete.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:tradingStrategyRecommendation rdf:type rdf:Property ;
    rdfs:label 'Trading Strategy Recommendation' ;
    rdfs:comment 'Internal recommendation for how to execute trades in response to the rebalancing event.' ;
    rdfs:domain ind:IndexRebalanceEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:earningsAnnouncementId rdf:type rdf:Property ;
    rdfs:label 'Earnings Announcement Id' ;
    rdfs:comment 'Unique identifier for the earnings announcement record.' ;
    rdfs:domain ind:EarningsAnnouncement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marketConsensusId rdf:type rdf:Property ;
    rdfs:label 'Market Consensus Id' ;
    rdfs:comment 'Reference to research.market_consensus.market_consensus_id.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarketConsensus .

ind:actualEps rdf:type rdf:Property ;
    rdfs:label 'Actual Eps' ;
    rdfs:comment 'Actual reported earnings per share for the earnings announcement.' ;
    rdfs:domain ind:EarningsAnnouncement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consensusEps rdf:type rdf:Property ;
    rdfs:label 'Consensus Eps' ;
    rdfs:comment 'Consensus analyst estimate for earnings per share for this earnings announcement.' ;
    rdfs:domain ind:EarningsAnnouncement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:epsBasis rdf:type rdf:Property ;
    rdfs:label 'Eps Basis' ;
    rdfs:comment 'Basis used for the EPS figure reported in the earnings announcement (e.g., GAAP, non-GAAP, diluted, basic).' ;
    rdfs:domain ind:EarningsAnnouncement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceTargetEvaluationId rdf:type rdf:Property ;
    rdfs:label 'Price Target Evaluation Id' ;
    rdfs:comment 'Surrogate primary key.' ;
    rdfs:domain ind:PriceTargetEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluationDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Date' ;
    rdfs:comment 'Evaluation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:horizonDays rdf:type rdf:Property ;
    rdfs:label 'Horizon Days' ;
    rdfs:comment 'Evaluation horizon in days: 90, 180, 365.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:issuePrice rdf:type rdf:Property ;
    rdfs:label 'Issue Price' ;
    rdfs:comment 'Security price on the notes publication date.' ;
    rdfs:domain ind:PriceTargetEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizedPrice rdf:type rdf:Property ;
    rdfs:label 'Realized Price' ;
    rdfs:comment 'Security price at the horizon, same currency as the target.' ;
    rdfs:domain ind:PriceTargetEvaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundAdministratorId rdf:type rdf:Property ;
    rdfs:label 'Fund Administrator Id' ;
    rdfs:comment 'Reference to the third-party fund administrator responsible for NAV calculation, capital call processing, and LP reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundAdministrator .

ind:auditorId rdf:type rdf:Property ;
    rdfs:label 'Auditor Id' ;
    rdfs:comment 'Reference to the external audit firm responsible for annual financial statement audits of the fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Auditor .

ind:climateScenarioId rdf:type rdf:Property ;
    rdfs:label 'Climate Scenario Id' ;
    rdfs:comment 'Foreign key linking to esg.climate_scenario. Business justification: Funds use climate scenarios for stress testing and risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ClimateScenario .

ind:controversyId rdf:type rdf:Property ;
    rdfs:label 'Controversy Id' ;
    rdfs:comment 'Foreign key linking to esg.controversy. Business justification: Funds track controversies affecting portfolio companies for risk management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Controversy .

ind:engagementActivityId rdf:type rdf:Property ;
    rdfs:label 'Engagement Activity Id' ;
    rdfs:comment 'Foreign key linking to esg.engagement_activity. Business justification: Funds record engagement activities with investees to drive ESG outcomes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EngagementActivity .

ind:engagementObjectiveId rdf:type rdf:Property ;
    rdfs:label 'Engagement Objective Id' ;
    rdfs:comment 'Foreign key linking to esg.engagement_objective. Business justification: Funds set specific engagement objectives for ESG improvement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EngagementObjective .

ind:esgBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Esg Benchmark Id' ;
    rdfs:comment 'Foreign key linking to esg.esg_benchmark. Business justification: Funds benchmark ESG performance against industry standards.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgBenchmark .

ind:esgPolicyId rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Id' ;
    rdfs:comment 'Foreign key linking to esg.policy. Business justification: Each fund follows an ESG policy that sets integration level and compliance requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EsgPolicy .

ind:gpEntityId rdf:type rdf:Property ;
    rdfs:label 'Gp Entity Id' ;
    rdfs:comment 'Reference to the General Partner entity responsible for managing the fund and making investment decisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:masterFundId rdf:type rdf:Property ;
    rdfs:label 'Master Fund Id' ;
    rdfs:comment 'Reference to the master fund if this is a feeder fund in a master-feeder structure.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:riskModelId rdf:type rdf:Property ;
    rdfs:label 'Risk Model Id' ;
    rdfs:comment 'Foreign key linking to risk.model. Business justification: Fund risk model FK required for VaR calculation and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Model .

ind:stressScenarioId rdf:type rdf:Property ;
    rdfs:label 'Stress Scenario Id' ;
    rdfs:comment 'Foreign key linking to risk.stress_scenario. Business justification: Fund stress scenario FK needed for scenario-based VaR and capital adequacy testing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressScenario .

ind:tcfdDisclosureId rdf:type rdf:Property ;
    rdfs:label 'Tcfd Disclosure Id' ;
    rdfs:comment 'Foreign key linking to esg.tcfd_disclosure. Business justification: Funds file TCF disclosures for their portfolio, requiring a link to the disclosure record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TcfdDisclosure .

ind:carriedInterestRate rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Rate' ;
    rdfs:comment 'The performance fee rate (carry) paid to the GP from fund profits after the hurdle rate is achieved, expressed as a decimal percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpRate rdf:type rdf:Property ;
    rdfs:label 'Catch Up Rate' ;
    rdfs:comment 'The percentage of profits allocated to the GP after the hurdle is met and before the carried interest split, allowing GP to catch up to its target carry percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackProvision rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision' ;
    rdfs:comment 'Indicates whether the LPA includes a clawback provision requiring the GP to return excess carried interest if final fund performance falls below the hurdle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:domicileCountry rdf:type rdf:Property ;
    rdfs:label 'Domicile Country' ;
    rdfs:comment 'The country of legal domicile or incorporation for the fund vehicle, using ISO 3166-1 alpha-3 country code.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:domicileJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Domicile Jurisdiction' ;
    rdfs:comment 'The specific legal jurisdiction or state within the domicile country where the fund is registered (e.g., Delaware, Cayman Islands).' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgStrategy rdf:type rdf:Property ;
    rdfs:label 'Esg Strategy' ;
    rdfs:comment 'Description of the funds Environmental, Social, and Governance (ESG) integration approach, responsible investment policies, and sustainability commitments.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalCloseDate rdf:type rdf:Property ;
    rdfs:label 'Final Close Date' ;
    rdfs:comment 'The date of the funds final capital close when fundraising concluded and no further LP commitments are accepted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstCloseDate rdf:type rdf:Property ;
    rdfs:label 'First Close Date' ;
    rdfs:comment 'The date of the funds initial capital close when the first Limited Partner (LP) commitments were accepted and the fund began operations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundStatus rdf:type rdf:Property ;
    rdfs:label 'Fund Status' ;
    rdfs:comment 'Current lifecycle stage of the fund: fundraising (capital raising), investing (deployment period), harvesting (realization period), liquidated (fully exited), or dissolved.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundType rdf:type rdf:Property ;
    rdfs:label 'Fund Type' ;
    rdfs:comment 'Classification of the private equity fund strategy: buyout, venture capital, growth equity, secondaries, fund-of-funds (FoF), or co-investment vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hardCap rdf:type rdf:Property ;
    rdfs:label 'Hard Cap' ;
    rdfs:comment 'The maximum total capital commitment amount the fund is permitted to accept from LPs, as specified in the PPM or LPA.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRate rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate' ;
    rdfs:comment 'The minimum annualized Internal Rate of Return (IRR) that LPs must achieve before the GP is entitled to carried interest, expressed as a decimal percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Investment Period End Date' ;
    rdfs:comment 'The date on which the funds investment period concludes, after which new investments are generally prohibited per LPA terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Investment Period Start Date' ;
    rdfs:comment 'The date on which the funds investment period commenced, typically aligned with first close or final close per LPA terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isEvergreen rdf:type rdf:Property ;
    rdfs:label 'Is Evergreen' ;
    rdfs:comment 'Indicates whether the fund is an evergreen (open-ended) structure with no fixed termination date, allowing continuous capital raising and redemptions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isFeederFund rdf:type rdf:Property ;
    rdfs:label 'Is Feeder Fund' ;
    rdfs:comment 'Indicates whether this fund is a feeder vehicle that channels LP capital into a master fund structure.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementFeeBasis rdf:type rdf:Property ;
    rdfs:label 'Management Fee Basis' ;
    rdfs:comment 'The basis on which the management fee is calculated: committed capital (during investment period), invested capital (post-investment period), or Net Asset Value (NAV).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementFeeRate rdf:type rdf:Property ;
    rdfs:label 'Management Fee Rate' ;
    rdfs:comment 'The annual management fee rate charged by the GP, expressed as a decimal percentage of committed or invested capital per LPA terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maximumInvestmentSize rdf:type rdf:Property ;
    rdfs:label 'Maximum Investment Size' ;
    rdfs:comment 'The maximum equity check size for individual portfolio company investments, typically expressed as a percentage of total commitments or absolute amount.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumInvestmentSize rdf:type rdf:Property ;
    rdfs:label 'Minimum Investment Size' ;
    rdfs:comment 'The minimum equity check size for individual portfolio company investments, as specified in the funds investment guidelines.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundName rdf:type rdf:Property ;
    rdfs:label 'Fund Name' ;
    rdfs:comment 'The full legal name of the private equity fund as registered in the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sfdrClassification rdf:type rdf:Property ;
    rdfs:label 'Sfdr Classification' ;
    rdfs:comment 'EU SFDR classification: Article 6 (no sustainability focus), Article 8 (promotes ESG characteristics), or Article 9 (sustainable investment objective).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetFundSize rdf:type rdf:Property ;
    rdfs:label 'Target Fund Size' ;
    rdfs:comment 'The target total capital commitment amount the General Partner (GP) aims to raise from Limited Partners (LPs) during fundraising.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetGeographies rdf:type rdf:Property ;
    rdfs:label 'Target Geographies' ;
    rdfs:comment 'Comma-separated list of target geographic regions or countries for fund investments (e.g., North America, Europe, Asia-Pacific).' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetSectors rdf:type rdf:Property ;
    rdfs:label 'Target Sectors' ;
    rdfs:comment 'Comma-separated list of target industry sectors or verticals the fund focuses on for investment (e.g., technology, healthcare, industrials).' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termYears rdf:type rdf:Property ;
    rdfs:label 'Term Years' ;
    rdfs:comment 'The total contractual life of the fund in years as specified in the LPA, typically 10-12 years with extension options.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalCommitments rdf:type rdf:Property ;
    rdfs:label 'Total Commitments' ;
    rdfs:comment 'The aggregate capital commitment amount pledged by all Limited Partners (LPs) to the fund, representing total dry powder available for capital calls.' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationPolicy rdf:type rdf:Property ;
    rdfs:label 'Valuation Policy' ;
    rdfs:comment 'Summary of the funds valuation methodology for portfolio company holdings, including frequency and approach (e.g., IPEV Guidelines, ASC 820 Fair Value).' ;
    rdfs:domain ind:Fund ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterfallStructure rdf:type rdf:Property ;
    rdfs:label 'Waterfall Structure' ;
    rdfs:comment 'The carried interest distribution methodology: European (whole-fund basis), American (deal-by-deal basis), or hybrid.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Fund Commitment Id' ;
    rdfs:comment 'Unique identifier for the Limited Partner (LP) capital commitment record to a private equity fund.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FundCommitment .

ind:gpEntityId rdf:type rdf:Property ;
    rdfs:label 'Gp Gp Entity Id' ;
    rdfs:comment 'Reference to the General Partner managing the fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:carriedInterestRatePercent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Rate Percent' ;
    rdfs:comment 'Performance fee percentage paid to the GP after the hurdle rate is achieved, typically 20% of profits above the hurdle.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpRatePercent rdf:type rdf:Property ;
    rdfs:label 'Catch Up Rate Percent' ;
    rdfs:comment 'Percentage of distributions allocated to the GP after the hurdle is met to bring their total carry to the target rate, typically 80%.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commitmentNumber rdf:type rdf:Property ;
    rdfs:label 'Commitment Number' ;
    rdfs:comment 'External business identifier for the commitment, often referenced in Limited Partnership Agreement (LPA) and capital call notices.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Capital Amount' ;
    rdfs:comment 'Total capital amount the pension fund committed to invest in the fund over its investment period, subject to capital calls.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dpiMultiple rdf:type rdf:Property ;
    rdfs:label 'Dpi Multiple' ;
    rdfs:comment 'Cash-on-cash return metric calculated as Total Distributions / Paid-In Capital, representing realized value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionOptionsCount rdf:type rdf:Property ;
    rdfs:label 'Extension Options Count' ;
    rdfs:comment 'Number of one-year extension periods available to the GP beyond the base fund term, typically requiring LP approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundStrategy rdf:type rdf:Property ;
    rdfs:label 'Fund Strategy' ;
    rdfs:comment 'Primary investment strategy of the fund: buyout, growth equity, venture capital, distressed, real assets, or infrastructure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundTermYears rdf:type rdf:Property ;
    rdfs:label 'Fund Term Years' ;
    rdfs:comment 'Total duration of the fund from first close to final liquidation, typically 10-12 years with extension options per the LPA.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:irrPercent rdf:type rdf:Property ;
    rdfs:label 'Irr Percent' ;
    rdfs:comment 'Annualized time-weighted return on the commitment, calculated using cash flow timing and current NAV.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyPersonClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Key Person Clause Flag' ;
    rdfs:comment 'Indicates whether the LPA includes key person provisions that suspend investment period if key investment professionals depart.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCapitalCallDate rdf:type rdf:Property ;
    rdfs:label 'Last Capital Call Date' ;
    rdfs:comment 'Date of the most recent capital call notice issued by the GP for this commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastDistributionDate rdf:type rdf:Property ;
    rdfs:label 'Last Distribution Date' ;
    rdfs:comment 'Date of the most recent distribution received from the fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managementFeeRatePercent rdf:type rdf:Property ;
    rdfs:label 'Management Fee Rate Percent' ;
    rdfs:comment 'Annual management fee rate charged by the GP, typically 1.5-2.0% of committed capital during investment period and NAV thereafter.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moicMultiple rdf:type rdf:Property ;
    rdfs:label 'Moic Multiple' ;
    rdfs:comment 'Gross return multiple calculated as (Distributions + NAV) / Paid-In Capital, synonymous with TVPI.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mostFavoredNationFlag rdf:type rdf:Property ;
    rdfs:label 'Most Favored Nation Flag' ;
    rdfs:comment 'Indicates whether the commitment includes Most Favored Nation rights to receive terms granted to other LPs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noFaultDivorceFlag rdf:type rdf:Property ;
    rdfs:label 'No Fault Divorce Flag' ;
    rdfs:comment 'Indicates whether LPs have the right to remove the GP without cause under specified voting thresholds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paidInCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Paid In Capital Amount' ;
    rdfs:comment 'Cumulative capital amount drawn down by the General Partner (GP) through capital calls to date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Commitment Amount' ;
    rdfs:comment 'Uncalled committed capital available for future capital calls, also known as dry powder.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvpiMultiple rdf:type rdf:Property ;
    rdfs:label 'Rvpi Multiple' ;
    rdfs:comment 'Unrealized value metric calculated as NAV / Paid-In Capital, representing remaining investment value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sideLetterFlag rdf:type rdf:Property ;
    rdfs:label 'Side Letter Flag' ;
    rdfs:comment 'Indicates whether a side letter agreement with special terms or rights exists for this commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetFundSizeAmount rdf:type rdf:Property ;
    rdfs:label 'Target Fund Size Amount' ;
    rdfs:comment 'Total capital the fund aims to raise from all Limited Partners (LPs), representing the funds target size.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDistributionsAmount rdf:type rdf:Property ;
    rdfs:label 'Total Distributions Amount' ;
    rdfs:comment 'Cumulative distributions received from the fund to date, including return of capital and realized gains.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tvpiMultiple rdf:type rdf:Property ;
    rdfs:label 'Tvpi Multiple' ;
    rdfs:comment 'Performance metric calculated as (Distributions + NAV) / Paid-In Capital, representing total value creation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterfallStructureType rdf:type rdf:Property ;
    rdfs:label 'Waterfall Structure Type' ;
    rdfs:comment 'Distribution waterfall methodology: American (deal-by-deal carry), European (whole-fund carry), or Hybrid.' ;
    rdfs:domain ind:FundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealOpportunityId rdf:type rdf:Property ;
    rdfs:label 'Deal Opportunity Id' ;
    rdfs:comment 'Reference to the specific private equity deal or investment transaction for which capital is being called.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opportunity .

ind:settlementInstructionId rdf:type rdf:Property ;
    rdfs:label 'Settlement Instruction Id' ;
    rdfs:comment 'Reference to the treasury payment instruction record used to execute the capital call funding.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SettlementInstruction .

ind:portfolioCompanyId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Company Id' ;
    rdfs:comment 'Reference to the portfolio company receiving the investment funded by this capital call.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PortfolioCompany .

ind:callAmount rdf:type rdf:Property ;
    rdfs:label 'Call Amount' ;
    rdfs:comment 'Total amount requested from the Limited Partner (LP) in this capital call, denominated in call currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callCurrency rdf:type rdf:Property ;
    rdfs:label 'Call Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the capital call amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Call Document Url' ;
    rdfs:comment 'Link to the official capital call notice document stored in the document management system.' ;
    rdfs:domain ind:PrivateequityCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callDueDate rdf:type rdf:Property ;
    rdfs:label 'Call Due Date' ;
    rdfs:comment 'Date by which the Limited Partner (LP) must fund the capital call amount to the fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:callNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Call Notice Date' ;
    rdfs:comment 'Date on which the General Partner (GP) issued the capital call notice to Limited Partners (LPs).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:callNoticeNumber rdf:type rdf:Property ;
    rdfs:label 'Call Notice Number' ;
    rdfs:comment 'Unique business identifier assigned by the General Partner (GP) to this capital call notice.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callPurpose rdf:type rdf:Property ;
    rdfs:label 'Call Purpose' ;
    rdfs:comment 'Primary purpose for which the capital is being called by the General Partner (GP). [ENUM-REF-CANDIDATE: investment|management_fee|fund_expense|organizational_expense|bridge_financing|follow_on_investment|co_investment — 7 candidates stripped; promote to' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Call Sequence Number' ;
    rdfs:comment 'Sequential number of this capital call within the fund lifecycle, starting from 1 for the first drawdown.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:callStatus rdf:type rdf:Property ;
    rdfs:label 'Call Status' ;
    rdfs:comment 'Current lifecycle status of the capital call from issuance through funding completion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callType rdf:type rdf:Property ;
    rdfs:label 'Call Type' ;
    rdfs:comment 'Classification of the capital call based on urgency and timing characteristics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancelledDate rdf:type rdf:Property ;
    rdfs:label 'Cancelled Date' ;
    rdfs:comment 'Date on which the capital call was cancelled by the General Partner (GP).' ;
    rdfs:domain ind:PrivateequityCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cancelledFlag rdf:type rdf:Property ;
    rdfs:label 'Cancelled Flag' ;
    rdfs:comment 'Indicates whether this capital call has been cancelled by the General Partner (GP) prior to funding.' ;
    rdfs:domain ind:PrivateequityCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:defaultInterestAccrued rdf:type rdf:Property ;
    rdfs:label 'Default Interest Accrued' ;
    rdfs:comment 'Total default interest accrued on unfunded or late capital call amounts.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultInterestRate rdf:type rdf:Property ;
    rdfs:label 'Default Interest Rate' ;
    rdfs:comment 'Annual interest rate applied to late or unfunded capital call amounts as specified in the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:excuseApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Excuse Approval Status' ;
    rdfs:comment 'Status of the General Partner (GP) decision on the Limited Partner (LP) excuse request.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:excuseRequestFlag rdf:type rdf:Property ;
    rdfs:label 'Excuse Request Flag' ;
    rdfs:comment 'Indicates whether the Limited Partner (LP) has requested an excuse or deferral from funding this capital call.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excuseRequestReason rdf:type rdf:Property ;
    rdfs:label 'Excuse Request Reason' ;
    rdfs:comment 'Narrative explanation provided by the Limited Partner (LP) for requesting excuse or deferral from the capital call.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Fund Expense Amount' ;
    rdfs:comment 'Portion of the capital call allocated to fund-level operating expenses such as legal, audit, and administrative costs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundedDate rdf:type rdf:Property ;
    rdfs:label 'Funded Date' ;
    rdfs:comment 'Date on which the Limited Partner (LP) transferred funds to the fund in response to the capital call.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentAmount rdf:type rdf:Property ;
    rdfs:label 'Investment Amount' ;
    rdfs:comment 'Portion of the capital call allocated to direct investment activities, excluding fees and expenses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentDescription rdf:type rdf:Property ;
    rdfs:label 'Investment Description' ;
    rdfs:comment 'Narrative description of the underlying investment or purpose for which capital is being called.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpAcknowledgementDate rdf:type rdf:Property ;
    rdfs:label 'Lp Acknowledgement Date' ;
    rdfs:comment 'Date on which the Limited Partner (LP) formally acknowledged the capital call notice.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lpAcknowledgementFlag rdf:type rdf:Property ;
    rdfs:label 'Lp Acknowledgement Flag' ;
    rdfs:comment 'Indicates whether the Limited Partner (LP) has formally acknowledged receipt of the capital call notice.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Management Fee Amount' ;
    rdfs:comment 'Portion of the capital call allocated to General Partner (GP) management fees as per Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeMethod rdf:type rdf:Property ;
    rdfs:label 'Notice Method' ;
    rdfs:comment 'Method by which the General Partner (GP) delivered the capital call notice to the Limited Partner (LP).' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Notice Received Date' ;
    rdfs:comment 'Date on which the Limited Partner (LP) acknowledged receipt of the capital call notice.' ;
    rdfs:domain ind:PrivateequityCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:organizationalExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Organizational Expense Amount' ;
    rdfs:comment 'Portion of the capital call allocated to one-time fund formation and organizational expenses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Settlement Account Number' ;
    rdfs:comment 'Bank account number to which the Limited Partner (LP) must transfer the capital call funds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementBankBic rdf:type rdf:Property ;
    rdfs:label 'Settlement Bank Bic' ;
    rdfs:comment 'Bank Identifier Code (BIC) or SWIFT code for the settlement bank receiving capital call funds.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:settlementBankName rdf:type rdf:Property ;
    rdfs:label 'Settlement Bank Name' ;
    rdfs:comment 'Name of the bank holding the settlement account for capital call funding.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:underlyingInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Underlying Investment Id' ;
    rdfs:comment 'Reference to the specific portfolio company or direct investment that generated the distribution.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:amountBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Amount Base Currency' ;
    rdfs:comment 'Distribution amount converted to the pension fund\'s base reporting currency using the effective date foreign exchange (FX) rate.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDistributionsToDate rdf:type rdf:Property ;
    rdfs:label 'Cumulative Distributions To Date' ;
    rdfs:comment 'Total cumulative distributions received by the Limited Partner (LP) from the fund inception through this distribution, used for Distributions to Paid-In (DPI) calculation.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionStatus rdf:type rdf:Property ;
    rdfs:label 'Distribution Status' ;
    rdfs:comment 'Current lifecycle status of the distribution transaction in the settlement and accounting workflow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionType rdf:type rdf:Property ;
    rdfs:label 'Distribution Type' ;
    rdfs:comment 'Classification of the distribution by its economic nature: return of capital, realized gain, dividend income, interest income, in-kind asset transfer, or recallable distribution subject to clawback.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpiRatio rdf:type rdf:Property ;
    rdfs:label 'Dpi Ratio' ;
    rdfs:comment 'Ratio of cumulative distributions to cumulative capital called, calculated as of this distribution date, measuring cash-on-cash return realized to date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inKindAssetDescription rdf:type rdf:Property ;
    rdfs:label 'In Kind Asset Description' ;
    rdfs:comment 'Description of the asset transferred in-kind if the distribution type is in-kind (e.g., publicly traded shares, real estate, infrastructure asset).' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inKindAssetFairValue rdf:type rdf:Property ;
    rdfs:label 'In Kind Asset Fair Value' ;
    rdfs:comment 'Fair market value of the in-kind asset at the distribution effective date, used for accounting and Net Asset Value (NAV) purposes.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:inKindAssetQuantity rdf:type rdf:Property ;
    rdfs:label 'In Kind Asset Quantity' ;
    rdfs:comment 'Quantity or number of units of the in-kind asset transferred (e.g., number of shares, square meters of real estate).' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:irrContribution rdf:type rdf:Property ;
    rdfs:label 'Irr Contribution' ;
    rdfs:comment 'Contribution of this distribution to the fund\'s cumulative Internal Rate of Return (IRR) calculation, expressed as a percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Lp Commitment Amount' ;
    rdfs:comment 'Total capital commitment made by the Limited Partner (LP) to the fund, used to calculate distribution ratios and Distributions to Paid-In (DPI) metrics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:memo rdf:type rdf:Property ;
    rdfs:label 'Memo' ;
    rdfs:comment 'Free-text memo or commentary provided by the General Partner (GP) explaining the distribution context, source, and any special conditions.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:moicContribution rdf:type rdf:Property ;
    rdfs:label 'Moic Contribution' ;
    rdfs:comment 'Contribution of this distribution to the fund\'s cumulative Multiple on Invested Capital (MOIC) calculation.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Nav Impact Amount' ;
    rdfs:comment 'Impact of the distribution on the fund\'s Net Asset Value (NAV) as of the effective date, typically a reduction equal to the distribution amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Net Distribution Amount' ;
    rdfs:comment 'Net distribution amount received by the Limited Partner (LP) after withholding taxes and any applicable fees.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeDate rdf:type rdf:Property ;
    rdfs:label 'Notice Date' ;
    rdfs:comment 'Date on which the General Partner (GP) issued the distribution notice to Limited Partners (LPs).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noticeNumber rdf:type rdf:Property ;
    rdfs:label 'Notice Number' ;
    rdfs:comment 'External reference number assigned by the General Partner (GP) to the distribution notice document.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recallableExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Recallable Expiry Date' ;
    rdfs:comment 'Date after which the distribution is no longer subject to clawback or recall provisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recallableFlag rdf:type rdf:Property ;
    rdfs:label 'Recallable Flag' ;
    rdfs:comment 'Indicates whether the distribution is subject to potential clawback or recall under the Limited Partnership Agreement (LPA) terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceEvent rdf:type rdf:Property ;
    rdfs:label 'Source Event' ;
    rdfs:comment 'Type of underlying transaction or event that triggered the distribution (e.g., exit, initial public offering, dividend, refinancing). [ENUM-REF-CANDIDATE: exit|ipo|dividend|interest|refinancing|partial_sale|recapitalization|liquidation — 8 candidates' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxTreatyApplicableFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Treaty Applicable Flag' ;
    rdfs:comment 'Indicates whether a bilateral tax treaty was applied to reduce the withholding tax rate on the distribution.' ;
    rdfs:domain ind:Distribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investmentGpEntityId rdf:type rdf:Property ;
    rdfs:label 'Investment Gp Entity Id' ;
    rdfs:comment 'Reference to the General Partner (GP) or external manager entity managing this investment.' ;
    rdfs:domain ind:Investment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:investmentGpGpEntityId rdf:type rdf:Property ;
    rdfs:label 'Investment Gp Gp Entity Id' ;
    rdfs:comment 'FK to privateequity.gp_entity' ;
    rdfs:domain ind:Investment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:researchReportId rdf:type rdf:Property ;
    rdfs:label 'Research Report Id' ;
    rdfs:comment 'Foreign key linking to research.report. Business justification: Investment decisions are supported by specific research reports that justify the investment thesis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchReport .

ind:distributionsReceived rdf:type rdf:Property ;
    rdfs:label 'Distributions Received' ;
    rdfs:comment 'Cumulative cash distributions returned to the Limited Partner (LP) from the investment, including realized gains and income.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dpi rdf:type rdf:Property ;
    rdfs:label 'Dpi' ;
    rdfs:comment 'Multiple of cumulative distributions divided by paid-in capital, measuring realized cash-on-cash return.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitDate rdf:type rdf:Property ;
    rdfs:label 'Exit Date' ;
    rdfs:comment 'Date on which the investment was fully exited or realized, marking the end of the holding period.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundSize rdf:type rdf:Property ;
    rdfs:label 'Fund Size' ;
    rdfs:comment 'Total capital raised by the fund at final close, representing the aggregate commitments from all Limited Partners (LPs).' ;
    rdfs:domain ind:Investment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentDate rdf:type rdf:Property ;
    rdfs:label 'Investment Date' ;
    rdfs:comment 'Date on which the investment was executed and capital was deployed into the portfolio company or fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentStatus rdf:type rdf:Property ;
    rdfs:label 'Investment Status' ;
    rdfs:comment 'Current lifecycle status of the investment: committed but not yet funded, actively held, partially or fully exited, or written off.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irr rdf:type rdf:Property ;
    rdfs:label 'Irr' ;
    rdfs:comment 'Annualized time-weighted rate of return on the investment, calculated using cash flows and Net Asset Value (NAV), expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moic rdf:type rdf:Property ;
    rdfs:label 'Moic' ;
    rdfs:comment 'Total value divided by paid-in capital, representing the gross multiple of capital returned and remaining, synonymous with Total Value to Paid-In (TVPI).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentName rdf:type rdf:Property ;
    rdfs:label 'Investment Name' ;
    rdfs:comment 'Business name or title of the private equity investment, typically the portfolio company name or fund name.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nav rdf:type rdf:Property ;
    rdfs:label 'Nav' ;
    rdfs:comment 'Current fair market value of the investment as of the most recent valuation date, representing unrealized value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navDate rdf:type rdf:Property ;
    rdfs:label 'Nav Date' ;
    rdfs:comment 'As-of date for the reported Net Asset Value (NAV), typically the end of the most recent reporting quarter.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paidInCapital rdf:type rdf:Property ;
    rdfs:label 'Paid In Capital' ;
    rdfs:comment 'Cumulative capital called and paid by the Limited Partner (LP) to date, representing actual cash deployed into the investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rvpi rdf:type rdf:Property ;
    rdfs:label 'Rvpi' ;
    rdfs:comment 'Multiple of current Net Asset Value (NAV) divided by paid-in capital, representing unrealized value remaining in the investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategy rdf:type rdf:Property ;
    rdfs:label 'Strategy' ;
    rdfs:comment 'Private equity strategy classification: buyout, growth equity, venture capital, distressed debt, mezzanine financing, or turnaround.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subSector rdf:type rdf:Property ;
    rdfs:label 'Sub Sector' ;
    rdfs:comment 'Detailed sub-sector or industry vertical within the primary sector, providing granular classification for portfolio analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalValue rdf:type rdf:Property ;
    rdfs:label 'Total Value' ;
    rdfs:comment 'Sum of distributions received plus current Net Asset Value (NAV), representing the total realized and unrealized value of the investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tvpi rdf:type rdf:Property ;
    rdfs:label 'Tvpi' ;
    rdfs:comment 'Multiple of total value divided by paid-in capital, a key performance metric indicating total return on invested capital.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationMethod rdf:type rdf:Property ;
    rdfs:label 'Valuation Method' ;
    rdfs:comment 'Methodology used to determine the fair value of the investment, such as Discounted Cash Flow (DCF), comparable company analysis, or recent transaction price.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpFundId rdf:type rdf:Property ;
    rdfs:label 'Gp Fund Id' ;
    rdfs:comment 'Reference to the main GP fund vehicle alongside which this co-investment is being made.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:actualExitDate rdf:type rdf:Property ;
    rdfs:label 'Actual Exit Date' ;
    rdfs:comment 'Actual date on which the co-investment position was fully exited and realized.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coinvestmentCode rdf:type rdf:Property ;
    rdfs:label 'Coinvestment Code' ;
    rdfs:comment 'External business identifier or deal code used for reporting and communication with the GP and internal stakeholders.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinvestmentStatus rdf:type rdf:Property ;
    rdfs:label 'Coinvestment Status' ;
    rdfs:comment 'Current lifecycle status of the co-investment opportunity from initial pipeline through exit. [ENUM-REF-CANDIDATE: pipeline|due_diligence|ic_review|approved|committed|funded|active|exited|declined — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryEbitdaMultiple rdf:type rdf:Property ;
    rdfs:label 'Entry Ebitda Multiple' ;
    rdfs:comment 'Valuation multiple at entry calculated as enterprise value divided by trailing or forward EBITDA.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entryValuation rdf:type rdf:Property ;
    rdfs:label 'Entry Valuation' ;
    rdfs:comment 'Enterprise value or equity valuation of the portfolio company at the time of initial investment in base currency.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitProceeds rdf:type rdf:Property ;
    rdfs:label 'Exit Proceeds' ;
    rdfs:comment 'Total cash proceeds realized from the exit of the co-investment in base currency.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitType rdf:type rdf:Property ;
    rdfs:label 'Exit Type' ;
    rdfs:comment 'Method or transaction type through which the co-investment was exited or is expected to be exited.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedExitDate rdf:type rdf:Property ;
    rdfs:label 'Expected Exit Date' ;
    rdfs:comment 'Projected or target date for full exit from the co-investment position.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedHoldPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Expected Hold Period Years' ;
    rdfs:comment 'Anticipated investment holding period in years from initial funding to expected exit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstCapitalCallDate rdf:type rdf:Property ;
    rdfs:label 'First Capital Call Date' ;
    rdfs:comment 'Date of the initial capital call or drawdown notice for this co-investment.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentStructure rdf:type rdf:Property ;
    rdfs:label 'Investment Structure' ;
    rdfs:comment 'Capital structure layer or instrument type through which the co-investment is made.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentThesis rdf:type rdf:Property ;
    rdfs:label 'Investment Thesis' ;
    rdfs:comment 'Summary of the strategic rationale and value creation hypothesis supporting the co-investment decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadInvestmentProfessional rdf:type rdf:Property ;
    rdfs:label 'Lead Investment Professional' ;
    rdfs:comment 'Name or identifier of the internal investment team member responsible for originating and managing this co-investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coinvestmentName rdf:type rdf:Property ;
    rdfs:label 'Coinvestment Name' ;
    rdfs:comment 'Business name or title of the co-investment opportunity, typically including the portfolio company name and vintage year.' ;
    rdfs:domain ind:Coinvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetIrr rdf:type rdf:Property ;
    rdfs:label 'Target Irr' ;
    rdfs:comment 'Underwritten or target IRR percentage established at investment approval, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:secondaryTransactionId rdf:type rdf:Property ;
    rdfs:label 'Secondary Transaction Id' ;
    rdfs:comment 'Unique identifier for the secondary market transaction of Limited Partner (LP) interests in private equity funds.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:brokerFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Broker Fee Amount' ;
    rdfs:comment 'Fee paid to the broker or intermediary for facilitating the secondary transaction.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerIntermediaryName rdf:type rdf:Property ;
    rdfs:label 'Broker Intermediary Name' ;
    rdfs:comment 'Name of the broker, advisor, or intermediary who facilitated the secondary transaction, if applicable.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdByUser rdf:type rdf:Property ;
    rdfs:label 'Created By User' ;
    rdfs:comment 'User identifier of the person who created this secondary transaction record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:discountPremiumToNavPercent rdf:type rdf:Property ;
    rdfs:label 'Discount Premium To Nav Percent' ;
    rdfs:comment 'Percentage discount (negative) or premium (positive) of the transaction price relative to the NAV at transaction date, calculated as ((transaction_price - nav_at_transaction) / nav_at_transaction) * 100.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dpiAtTransaction rdf:type rdf:Property ;
    rdfs:label 'Dpi At Transaction' ;
    rdfs:comment 'Distributions to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, representing realized returns.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faceValueCommitment rdf:type rdf:Property ;
    rdfs:label 'Face Value Commitment' ;
    rdfs:comment 'Original committed capital amount of the LP interest being transacted, representing the full commitment value before any capital calls or distributions.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpConsentDate rdf:type rdf:Property ;
    rdfs:label 'Gp Consent Date' ;
    rdfs:comment 'Date on which General Partner consent was formally received for the secondary transaction.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gpConsentReceivedFlag rdf:type rdf:Property ;
    rdfs:label 'Gp Consent Received Flag' ;
    rdfs:comment 'Indicates whether General Partner consent was obtained for this secondary transaction if required.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gpConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Gp Consent Required Flag' ;
    rdfs:comment 'Indicates whether General Partner consent was required for this secondary transaction per the Limited Partnership Agreement terms.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investmentCommitteeMemoReference rdf:type rdf:Property ;
    rdfs:label 'Investment Committee Memo Reference' ;
    rdfs:comment 'Reference identifier for the Investment Committee memorandum documenting the rationale and approval for the secondary transaction.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irrAtTransactionPercent rdf:type rdf:Property ;
    rdfs:label 'Irr At Transaction Percent' ;
    rdfs:comment 'Internal Rate of Return of the LP interest calculated at the time of the secondary transaction, reflecting historical performance up to transaction date.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastModifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Last Modified By User' ;
    rdfs:comment 'User identifier of the person who last modified this secondary transaction record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalAdvisorName rdf:type rdf:Property ;
    rdfs:label 'Legal Advisor Name' ;
    rdfs:comment 'Name of the legal advisor or law firm engaged to support the secondary transaction due diligence and documentation.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Legal Fee Amount' ;
    rdfs:comment 'Legal fees incurred for the secondary transaction including due diligence, documentation review, and closing support.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navAtTransaction rdf:type rdf:Property ;
    rdfs:label 'Nav At Transaction' ;
    rdfs:comment 'Net Asset Value of the LP interest at the time of the secondary transaction, used as the baseline for discount or premium calculation.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioAllocationStrategy rdf:type rdf:Property ;
    rdfs:label 'Portfolio Allocation Strategy' ;
    rdfs:comment 'Strategic rationale for the secondary transaction within the broader portfolio allocation framework (e.g., rebalancing, liquidity management, vintage diversification).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rvpiAtTransaction rdf:type rdf:Property ;
    rdfs:label 'Rvpi At Transaction' ;
    rdfs:comment 'Residual Value to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, representing unrealized value.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalTransactionCosts rdf:type rdf:Property ;
    rdfs:label 'Total Transaction Costs' ;
    rdfs:comment 'Aggregate of all costs incurred in executing the secondary transaction including broker fees, legal fees, and other transaction expenses.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionNotes rdf:type rdf:Property ;
    rdfs:label 'Transaction Notes' ;
    rdfs:comment 'Free-text field capturing additional context, special terms, or conditions associated with the secondary transaction.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionPrice rdf:type rdf:Property ;
    rdfs:label 'Transaction Price' ;
    rdfs:comment 'Actual purchase or sale price paid for the LP interest in the secondary transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transaction Reference Number' ;
    rdfs:comment 'External reference number or deal code assigned to this secondary transaction for tracking and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionStatus rdf:type rdf:Property ;
    rdfs:label 'Transaction Status' ;
    rdfs:comment 'Current lifecycle status of the secondary transaction from initiation through settlement or cancellation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transactionType rdf:type rdf:Property ;
    rdfs:label 'Transaction Type' ;
    rdfs:comment 'Indicates whether this is a purchase (buy) or sale (sell) of LP interests in the secondary market.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tvpiAtTransaction rdf:type rdf:Property ;
    rdfs:label 'Tvpi At Transaction' ;
    rdfs:comment 'Total Value to Paid-In Capital multiple of the LP interest at the time of the secondary transaction, calculated as (distributions + NAV) / paid-in capital.' ;
    rdfs:domain ind:SecondaryTransaction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpaTermsId rdf:type rdf:Property ;
    rdfs:label 'Lpa Terms Id' ;
    rdfs:comment 'Unique identifier for the LPA terms record. Primary key for the LPA terms entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LpaTerms .

ind:advisoryCommitteeFlag rdf:type rdf:Property ;
    rdfs:label 'Advisory Committee Flag' ;
    rdfs:comment 'Indicates whether the LPA establishes a Limited Partner Advisory Committee for governance and conflict resolution.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amendmentNumber rdf:type rdf:Property ;
    rdfs:label 'Amendment Number' ;
    rdfs:comment 'Sequential number of amendments to the original LPA, starting at 0 for original and incrementing with each amendment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Requirement Flag' ;
    rdfs:comment 'Indicates whether the LPA requires annual audited financial statements prepared by independent auditor.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carriedInterestRatePct rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Rate Pct' ;
    rdfs:comment 'Percentage of profits allocated to the GP as performance incentive, typically 20% (carry).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:catchUpRatePct rdf:type rdf:Property ;
    rdfs:label 'Catch Up Rate Pct' ;
    rdfs:comment 'Percentage of distributions allocated to GP after hurdle is met to catch up to target carry split, typically 80-100%.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Provision Flag' ;
    rdfs:comment 'Indicates whether the LPA includes a clawback provision requiring GP to return excess carried interest at fund termination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coInvestmentRightFlag rdf:type rdf:Property ;
    rdfs:label 'Co Investment Right Flag' ;
    rdfs:comment 'Indicates whether LPs have the right to participate in co-investment opportunities alongside the fund.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgPolicyDescription rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Description' ;
    rdfs:comment 'Textual description of ESG policies, exclusions, or responsible investment commitments specified in the LPA.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Flag' ;
    rdfs:comment 'Indicates whether the LPA includes specific ESG investment policies or exclusions that the GP must follow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionOptionYears rdf:type rdf:Property ;
    rdfs:label 'Extension Option Years' ;
    rdfs:comment 'Number of years by which the fund term may be extended at GP discretion, typically 1-2 one-year extensions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundDomicile rdf:type rdf:Property ;
    rdfs:label 'Fund Domicile' ;
    rdfs:comment 'Legal domicile or jurisdiction where the fund is established and registered.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicRestriction rdf:type rdf:Property ;
    rdfs:label 'Geographic Restriction' ;
    rdfs:comment 'Geographic investment mandate or restrictions specified in the LPA (e.g., North America, Europe, Global).' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Governing Law Jurisdiction' ;
    rdfs:comment 'Legal jurisdiction whose laws govern the interpretation and enforcement of the LPA (e.g., Delaware, Cayman Islands).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Gp Commitment Amount' ;
    rdfs:comment 'Total capital amount committed by the GP to the fund, demonstrating alignment of interest with LPs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpCommitmentPct rdf:type rdf:Property ;
    rdfs:label 'Gp Commitment Pct' ;
    rdfs:comment 'GP commitment expressed as percentage of total fund commitments, typically 1-5%.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRatePct rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Pct' ;
    rdfs:comment 'Minimum annualized return threshold (preferred return) that LPs must achieve before GP receives carried interest, typically 8%.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleType rdf:type rdf:Property ;
    rdfs:label 'Hurdle Type' ;
    rdfs:comment 'Type of hurdle rate structure: hard (GP only receives carry on returns above hurdle), soft (GP receives catch-up), or none.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentConcentrationLimitPct rdf:type rdf:Property ;
    rdfs:label 'Investment Concentration Limit Pct' ;
    rdfs:comment 'Maximum percentage of fund capital that may be invested in a single portfolio company, typically 15-25%.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Investment Period Years' ;
    rdfs:comment 'Duration in years during which the GP may make new investments, typically 3-5 years from fund inception.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keyPersonNames rdf:type rdf:Property ;
    rdfs:label 'Key Person Names' ;
    rdfs:comment 'Comma-separated list of key persons named in the LPA whose departure may trigger key person provisions.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leverageLimitMultiple rdf:type rdf:Property ;
    rdfs:label 'Leverage Limit Multiple' ;
    rdfs:comment 'Maximum debt-to-equity or debt-to-EBITDA multiple permitted for portfolio company investments.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpaEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Lpa Effective Date' ;
    rdfs:comment 'Date from which the LPA terms become effective and operational.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lpaTermsStatus rdf:type rdf:Property ;
    rdfs:label 'Lpa Terms Status' ;
    rdfs:comment 'Current lifecycle status of the LPA terms record: active, amended, superseded by new version, or terminated.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementFeeRatePct rdf:type rdf:Property ;
    rdfs:label 'Management Fee Rate Pct' ;
    rdfs:comment 'Annual management fee rate charged by the GP, expressed as a percentage. Typically 1.5-2.0% during investment period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFeeStepDownDate rdf:type rdf:Property ;
    rdfs:label 'Management Fee Step Down Date' ;
    rdfs:comment 'Date at which management fee rate or basis changes, typically at end of investment period.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:mostFavoredNationClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Most Favored Nation Clause Flag' ;
    rdfs:comment 'Indicates whether the LPA includes MFN provisions ensuring LPs receive terms no less favorable than other LPs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noFaultDivorceClauseFlag rdf:type rdf:Property ;
    rdfs:label 'No Fault Divorce Clause Flag' ;
    rdfs:comment 'Indicates whether LPs have the right to remove the GP without cause, typically requiring supermajority vote.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:postInvestmentFeeRatePct rdf:type rdf:Property ;
    rdfs:label 'Post Investment Fee Rate Pct' ;
    rdfs:comment 'Reduced management fee rate applicable after the investment period ends, typically 1.0-1.5%.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recyclingLimitPct rdf:type rdf:Property ;
    rdfs:label 'Recycling Limit Pct' ;
    rdfs:comment 'Maximum percentage of distributions that may be recycled into new investments, typically 10-20% of commitments.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recyclingProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Recycling Provision Flag' ;
    rdfs:comment 'Indicates whether the LPA permits recycling of early distributions back into new investments during investment period.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:removalThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Removal Threshold Pct' ;
    rdfs:comment 'Percentage of LP votes required to remove the GP, typically 66.67% or 75% supermajority.' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sectorRestriction rdf:type rdf:Property ;
    rdfs:label 'Sector Restriction' ;
    rdfs:comment 'Industry sector focus or restrictions specified in the LPA (e.g., technology, healthcare, industrials).' ;
    rdfs:domain ind:LpaTerms ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transferRestrictionType rdf:type rdf:Property ;
    rdfs:label 'Transfer Restriction Type' ;
    rdfs:comment 'Type of restriction on LP ability to transfer fund interests: prohibited, requires GP consent, ROFR, or free transfer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carriedInterestWaterfallId rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Waterfall Id' ;
    rdfs:comment 'Unique identifier for the carried interest waterfall calculation record. Primary key.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:calculationDate rdf:type rdf:Property ;
    rdfs:label 'Calculation Date' ;
    rdfs:comment 'The reporting period date or valuation date as of which this carried interest waterfall was calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:calculationNotes rdf:type rdf:Property ;
    rdfs:label 'Calculation Notes' ;
    rdfs:comment 'Free-text notes documenting assumptions, adjustments, or special circumstances affecting this waterfall calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationStatus rdf:type rdf:Property ;
    rdfs:label 'Calculation Status' ;
    rdfs:comment 'Current lifecycle status of this waterfall calculation indicating whether it is draft, preliminary, final, revised, or superseded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carryAccruedUnpaid rdf:type rdf:Property ;
    rdfs:label 'Carry Accrued Unpaid' ;
    rdfs:comment 'Carried interest earned but not yet distributed to the GP, representing the accrued liability.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryDistributed rdf:type rdf:Property ;
    rdfs:label 'Carry Distributed' ;
    rdfs:comment 'Cumulative carried interest amount actually distributed to the GP to date.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryEarned rdf:type rdf:Property ;
    rdfs:label 'Carry Earned' ;
    rdfs:comment 'Total carried interest earned by the GP based on the waterfall calculation as of the calculation date.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carryRate rdf:type rdf:Property ;
    rdfs:label 'Carry Rate' ;
    rdfs:comment 'The GP profit share percentage (e.g., 0.2000 for 20%) applied to profits after preferred return and catch-up are satisfied.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackReserve rdf:type rdf:Property ;
    rdfs:label 'Clawback Reserve' ;
    rdfs:comment 'Amount reserved or withheld from GP distributions to cover potential clawback obligations at fund termination.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpCatchupAmount rdf:type rdf:Property ;
    rdfs:label 'Gp Catchup Amount' ;
    rdfs:comment 'Cumulative amount distributed to GP during the catch-up phase after LPs receive return of capital and preferred return.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpCatchupRate rdf:type rdf:Property ;
    rdfs:label 'Gp Catchup Rate' ;
    rdfs:comment 'The percentage of distributions allocated to GP during the catch-up phase to bring GP to its target carried interest share.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpProfitShare rdf:type rdf:Property ;
    rdfs:label 'Gp Profit Share' ;
    rdfs:comment 'Cumulative profit distributions allocated to GP including catch-up and carried interest.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpProfitShare rdf:type rdf:Property ;
    rdfs:label 'Lp Profit Share' ;
    rdfs:comment 'Cumulative profit distributions allocated to LPs after return of capital and preferred return, net of GP carry.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnAccrued rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Accrued' ;
    rdfs:comment 'Cumulative preferred return amount accrued to LPs based on the hurdle rate applied to outstanding capital over time.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnPaid rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Paid' ;
    rdfs:comment 'Cumulative preferred return amount distributed to LPs to date, satisfying the hurdle before GP catch-up.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnRate rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Rate' ;
    rdfs:comment 'The hurdle rate (expressed as decimal, e.g., 0.0800 for 8%) that LPs must achieve before GP participates in carried interest.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnOfCapital rdf:type rdf:Property ;
    rdfs:label 'Return Of Capital' ;
    rdfs:comment 'The portion of total distributions allocated to returning LP contributed capital before profit sharing begins.' ;
    rdfs:domain ind:CarriedInterestWaterfall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalContributions rdf:type rdf:Property ;
    rdfs:label 'Total Contributions' ;
    rdfs:comment 'Cumulative capital contributions (Paid-In Capital / PIC) called from LPs to date for this fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDistributions rdf:type rdf:Property ;
    rdfs:label 'Total Distributions' ;
    rdfs:comment 'Cumulative distributions paid to LPs and GP from the fund to date, including return of capital and profits.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterfallType rdf:type rdf:Property ;
    rdfs:label 'Waterfall Type' ;
    rdfs:comment 'The carried interest distribution methodology: American (deal-by-deal), European (whole-fund), or hybrid structure as defined in the LPA.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navId rdf:type rdf:Property ;
    rdfs:label 'Nav Id' ;
    rdfs:comment 'Unique identifier for the nav data product (auto-inserted during validation).' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gpReportId rdf:type rdf:Property ;
    rdfs:label 'Gp Report Id' ;
    rdfs:comment 'Reference identifier for the source GP report document from which this NAV data was extracted.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpReport .

ind:auditOpinion rdf:type rdf:Property ;
    rdfs:label 'Audit Opinion' ;
    rdfs:comment 'The auditors opinion on the funds financial statements, if this NAV is from an audited period.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedFlag rdf:type rdf:Property ;
    rdfs:label 'Audited Flag' ;
    rdfs:comment 'Indicates whether this NAV has been audited by an independent auditor as part of the funds annual audit process.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carriedInterestAccrued rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Accrued' ;
    rdfs:comment 'The cumulative carried interest accrued by the GP as of the valuation date, subject to hurdle rate and waterfall provisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fairValueHierarchyLevel rdf:type rdf:Property ;
    rdfs:label 'Fair Value Hierarchy Level' ;
    rdfs:comment 'The IFRS 13 fair value hierarchy level classification for this NAV valuation, indicating the observability of inputs used.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundAgeYears rdf:type rdf:Property ;
    rdfs:label 'Fund Age Years' ;
    rdfs:comment 'The number of years since the funds first closing or investment date, calculated as of the valuation date.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fxRateToBase rdf:type rdf:Property ;
    rdfs:label 'Fx Rate To Base' ;
    rdfs:comment 'The exchange rate used to convert the NAV reporting currency to the LPs base currency as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpReportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Gp Report Received Date' ;
    rdfs:comment 'The date on which the GP capital account statement or NAV report was received by the LP.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irrSinceInception rdf:type rdf:Property ;
    rdfs:label 'Irr Since Inception' ;
    rdfs:comment 'The annualized internal rate of return from the first capital call to the valuation date, representing time-weighted performance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCurrentRecord rdf:type rdf:Property ;
    rdfs:label 'Is Current Record' ;
    rdfs:comment 'Flag indicating whether this is the current active version of the NAV record for the given fund commitment and valuation date.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jCurvePhase rdf:type rdf:Property ;
    rdfs:label 'J Curve Phase' ;
    rdfs:comment 'The current phase of the funds J-curve lifecycle, indicating whether it is in investment, harvesting, mature, or liquidation phase.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementFeeAccrued rdf:type rdf:Property ;
    rdfs:label 'Management Fee Accrued' ;
    rdfs:comment 'The cumulative management fees accrued and charged to the LP capital account as of the valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfPortfolioCompanies rdf:type rdf:Property ;
    rdfs:label 'Number Of Portfolio Companies' ;
    rdfs:comment 'The count of active portfolio companies or investments held by the fund as of the valuation date.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:otherExpensesAccrued rdf:type rdf:Property ;
    rdfs:label 'Other Expenses Accrued' ;
    rdfs:comment 'Other fund-level expenses accrued and allocated to the LP capital account, excluding management fees and carried interest.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizedValue rdf:type rdf:Property ;
    rdfs:label 'Realized Value' ;
    rdfs:comment 'The cumulative proceeds from exits, sales, and distributions received to date from the investment.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordEffectiveFromDate rdf:type rdf:Property ;
    rdfs:label 'Record Effective From Date' ;
    rdfs:comment 'The date from which this version of the NAV record is effective, supporting slowly changing dimension type 2 historization.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:recordEffectiveToDate rdf:type rdf:Property ;
    rdfs:label 'Record Effective To Date' ;
    rdfs:comment 'The date until which this version of the NAV record is effective, supporting slowly changing dimension type 2 historization. Null indicates current record.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingCurrency rdf:type rdf:Property ;
    rdfs:label 'Reporting Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the NAV is reported by the GP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End Date' ;
    rdfs:comment 'The end date of the reporting period covered by this NAV statement, aligning with GP reporting cycles.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:totalCommitment rdf:type rdf:Property ;
    rdfs:label 'Total Commitment' ;
    rdfs:comment 'The total capital commitment made by the LP to the fund or investment, representing the maximum callable amount.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unrealizedValue rdf:type rdf:Property ;
    rdfs:label 'Unrealized Value' ;
    rdfs:comment 'The fair value of investments still held in the portfolio, not yet realized through exit or distribution.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Valuation Adjustment Amount' ;
    rdfs:comment 'Any adjustment made to the GP-reported NAV by the LP for internal valuation policy, risk overlay, or fair value hierarchy alignment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationAdjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Valuation Adjustment Reason' ;
    rdfs:comment 'Explanation for any valuation adjustment applied by the LP, documenting the rationale for deviation from GP-reported NAV.' ;
    rdfs:domain ind:Nav ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jcurveProjectionId rdf:type rdf:Property ;
    rdfs:label 'Jcurve Projection Id' ;
    rdfs:comment 'Unique identifier for the J-Curve projection record. Primary key for this entity.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approved By Employee Id' ;
    rdfs:comment 'Reference to the senior investment professional or Investment Committee (IC) member who approved this projection.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:jcurveApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Jcurve Approved By Employee Id' ;
    rdfs:comment 'Reference to the senior investment professional or Investment Committee (IC) member who approved this projection.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:jcurveEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Jcurve Employee Id' ;
    rdfs:comment 'Reference to the analyst or investment professional who created or approved this projection.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:assumedCarriedInterestRate rdf:type rdf:Property ;
    rdfs:label 'Assumed Carried Interest Rate' ;
    rdfs:comment 'The carried interest (carry) rate assumed in this projection, expressed as a decimal (e.g., 0.20 for 20%).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assumedManagementFeeRate rdf:type rdf:Property ;
    rdfs:label 'Assumed Management Fee Rate' ;
    rdfs:comment 'The annual management fee rate assumed in this projection, expressed as a decimal (e.g., 0.0150 for 1.50%).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkCohort rdf:type rdf:Property ;
    rdfs:label 'Benchmark Cohort' ;
    rdfs:comment 'The benchmark cohort or peer group used as a reference for this projection (e.g., Global Buyout 2020 Vintage, North America VC 2019-2021).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakevenPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Breakeven Period Months' ;
    rdfs:comment 'The number of months from fund inception until the cumulative distributions equal cumulative capital called, marking the J-Curve inflection point.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalCallFrequency rdf:type rdf:Property ;
    rdfs:label 'Capital Call Frequency' ;
    rdfs:comment 'The expected frequency pattern of capital calls (drawdowns) in this projection: monthly, quarterly, semi-annual, annual, or irregular.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:catchUpProvision rdf:type rdf:Property ;
    rdfs:label 'Catch Up Provision' ;
    rdfs:comment 'Description of the catch-up provision in the waterfall structure, if applicable (e.g., 100% catch-up until GP receives 20% of total profits).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedCapitalCurrency rdf:type rdf:Property ;
    rdfs:label 'Committed Capital Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the committed capital amount (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionFrequency rdf:type rdf:Property ;
    rdfs:label 'Distribution Frequency' ;
    rdfs:comment 'The expected frequency pattern of distributions in this projection: monthly, quarterly, semi-annual, annual, or irregular.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelRunDate rdf:type rdf:Property ;
    rdfs:label 'Model Run Date' ;
    rdfs:comment 'The date on which this J-Curve projection model was executed and results were generated.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:peakNegativeNavAmount rdf:type rdf:Property ;
    rdfs:label 'Peak Negative Nav Amount' ;
    rdfs:comment 'The maximum negative NAV position expected during the J-Curve trough, representing the deepest point of unrealized loss.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakNegativeNavPeriod rdf:type rdf:Property ;
    rdfs:label 'Peak Negative Nav Period' ;
    rdfs:comment 'The period number (in months or quarters) at which the peak negative NAV is expected to occur.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:projectedDpi rdf:type rdf:Property ;
    rdfs:label 'Projected Dpi' ;
    rdfs:comment 'The projected Distributions to Paid-In multiple, calculated as Distributions / Capital Called, representing realized cash returns.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedFinalNav rdf:type rdf:Property ;
    rdfs:label 'Projected Final Nav' ;
    rdfs:comment 'The expected Net Asset Value (NAV) at the end of the projection period, representing unrealized value remaining.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedGrossIrr rdf:type rdf:Property ;
    rdfs:label 'Projected Gross Irr' ;
    rdfs:comment 'The projected gross Internal Rate of Return before management fees and carried interest, expressed as a decimal (e.g., 0.15 for 15%).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedMoic rdf:type rdf:Property ;
    rdfs:label 'Projected Moic' ;
    rdfs:comment 'The projected Multiple on Invested Capital, representing the total value multiple expected from the investment.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedNetIrr rdf:type rdf:Property ;
    rdfs:label 'Projected Net Irr' ;
    rdfs:comment 'The projected net Internal Rate of Return after management fees and carried interest, expressed as a decimal (e.g., 0.12 for 12%).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedRvpi rdf:type rdf:Property ;
    rdfs:label 'Projected Rvpi' ;
    rdfs:comment 'The projected Residual Value to Paid-In multiple, calculated as NAV / Capital Called, representing unrealized value remaining.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedTotalCapitalCalled rdf:type rdf:Property ;
    rdfs:label 'Projected Total Capital Called' ;
    rdfs:comment 'The total amount of capital expected to be called (drawn down) over the life of the fund based on this projection scenario.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedTotalDistributions rdf:type rdf:Property ;
    rdfs:label 'Projected Total Distributions' ;
    rdfs:comment 'The total amount of distributions expected to be returned to the Limited Partner (LP) over the life of the fund.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedTvpi rdf:type rdf:Property ;
    rdfs:label 'Projected Tvpi' ;
    rdfs:comment 'The projected Total Value to Paid-In multiple, calculated as (Distributions + NAV) / Capital Called, representing total value creation.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectionConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Projection Confidence Level' ;
    rdfs:comment 'Qualitative assessment of confidence in this projection: high (based on strong data), medium (moderate uncertainty), or low (highly uncertain).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionEndDate rdf:type rdf:Property ;
    rdfs:label 'Projection End Date' ;
    rdfs:comment 'The date at which the J-Curve projection concludes, typically aligned with the expected fund liquidation date.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectionMethodology rdf:type rdf:Property ;
    rdfs:label 'Projection Methodology' ;
    rdfs:comment 'Description of the methodology used to generate this J-Curve projection (e.g., historical cohort analysis, GP-provided forecast, Monte Carlo simulation).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionName rdf:type rdf:Property ;
    rdfs:label 'Projection Name' ;
    rdfs:comment 'Business-friendly name or label for this J-Curve projection scenario (e.g., Base Case, Optimistic, Pessimistic).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionStartDate rdf:type rdf:Property ;
    rdfs:label 'Projection Start Date' ;
    rdfs:comment 'The date from which the J-Curve projection begins, typically the fund commitment date or first capital call date.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectionStatus rdf:type rdf:Property ;
    rdfs:label 'Projection Status' ;
    rdfs:comment 'Current lifecycle status of the J-Curve projection: draft, approved for use, active, superseded by newer version, or archived.' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionVersion rdf:type rdf:Property ;
    rdfs:label 'Projection Version' ;
    rdfs:comment 'Version identifier for this projection, enabling tracking of revisions over time (e.g., v1.0, v2.1, Q1-2024).' ;
    rdfs:domain ind:JcurveProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scenarioType rdf:type rdf:Property ;
    rdfs:label 'Scenario Type' ;
    rdfs:comment 'Classification of the projection scenario: base case, optimistic, pessimistic, stress test, or custom.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sensitivityAnalysisPerformed rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Performed' ;
    rdfs:comment 'Indicates whether sensitivity analysis has been performed on this projection to test robustness under varying assumptions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuerEsgRatingId rdf:type rdf:Property ;
    rdfs:label 'Issuer Esg Rating Id' ;
    rdfs:comment 'Foreign key linking to esg.issuer_esg_rating. Business justification: ESG rating of each portfolio company is required for investment decisions and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IssuerEsgRating .

ind:boardRepresentation rdf:type rdf:Property ;
    rdfs:label 'Board Representation' ;
    rdfs:comment 'Indicates whether the pension fund holds a board seat or observer rights at the portfolio company.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:businessDescription rdf:type rdf:Property ;
    rdfs:label 'Business Description' ;
    rdfs:comment 'Detailed narrative describing the portfolio company\'s business model, operations, products, services, and competitive positioning.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonFootprintTonnes rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint Tonnes' ;
    rdfs:comment 'Total greenhouse gas emissions attributable to the portfolio company, measured in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestors rdf:type rdf:Property ;
    rdfs:label 'Co Investors' ;
    rdfs:comment 'Comma-separated list of other institutional investors participating in the investment alongside the pension fund.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:companyName rdf:type rdf:Property ;
    rdfs:label 'Company Name' ;
    rdfs:comment 'Full legal name of the portfolio company as registered in its jurisdiction of incorporation.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentFairValue rdf:type rdf:Property ;
    rdfs:label 'Current Fair Value' ;
    rdfs:comment 'Most recent mark-to-market valuation of the pension fund\'s stake in the portfolio company, in base currency.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaLatest rdf:type rdf:Property ;
    rdfs:label 'Ebitda Latest' ;
    rdfs:comment 'Most recent annual or trailing twelve-month EBITDA reported by the portfolio company, in base currency.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enterpriseValue rdf:type rdf:Property ;
    rdfs:label 'Enterprise Value' ;
    rdfs:comment 'Total enterprise value of the portfolio company including equity and net debt, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialsAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Financials As Of Date' ;
    rdfs:comment 'Date to which the latest revenue and EBITDA figures correspond.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:headquartersCountry rdf:type rdf:Property ;
    rdfs:label 'Headquarters Country' ;
    rdfs:comment 'Three-letter ISO country code representing the location of the portfolio company\'s headquarters.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialInvestmentDate rdf:type rdf:Property ;
    rdfs:label 'Initial Investment Date' ;
    rdfs:comment 'Date when the pension fund first invested in the portfolio company.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentStage rdf:type rdf:Property ;
    rdfs:label 'Investment Stage' ;
    rdfs:comment 'Stage of the company at the time of investment indicating maturity and risk profile.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jurisdictionOfIncorporation rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction Of Incorporation' ;
    rdfs:comment 'Three-letter ISO country code representing the legal jurisdiction where the company is incorporated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadInvestor rdf:type rdf:Property ;
    rdfs:label 'Lead Investor' ;
    rdfs:comment 'Name of the lead investor or General Partner (GP) in the deal, if applicable.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueLatest rdf:type rdf:Property ;
    rdfs:label 'Revenue Latest' ;
    rdfs:comment 'Most recent annual or trailing twelve-month revenue reported by the portfolio company, in base currency.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDistributionsReceived rdf:type rdf:Property ;
    rdfs:label 'Total Distributions Received' ;
    rdfs:comment 'Cumulative cash distributions received by the pension fund from the portfolio company, including dividends and exit proceeds, in base currency.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalInvestedCapital rdf:type rdf:Property ;
    rdfs:label 'Total Invested Capital' ;
    rdfs:comment 'Cumulative amount of capital invested by the pension fund in the portfolio company across all rounds and capital calls, in base currency.' ;
    rdfs:domain ind:PortfolioCompany ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:activeFundCount rdf:type rdf:Property ;
    rdfs:label 'Active Fund Count' ;
    rdfs:comment 'Number of funds in active investment period or still holding portfolio assets.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aumAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Aum As Of Date' ;
    rdfs:comment 'Date as of which the total AUM figure was reported or calculated.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:aumCurrency rdf:type rdf:Property ;
    rdfs:label 'Aum Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the reported AUM figure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageFundIrr rdf:type rdf:Property ;
    rdfs:label 'Average Fund Irr' ;
    rdfs:comment 'Average net IRR across all realized and partially realized funds managed by this GP, expressed as a decimal.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageFundMoic rdf:type rdf:Property ;
    rdfs:label 'Average Fund Moic' ;
    rdfs:comment 'Average MOIC across all realized and partially realized funds managed by this GP.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:entityType rdf:type rdf:Property ;
    rdfs:label 'Entity Type' ;
    rdfs:comment 'Legal structure type of the General Partner entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundCount rdf:type rdf:Property ;
    rdfs:label 'Fund Count' ;
    rdfs:comment 'Total number of private equity funds currently managed by this General Partner.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gpEntityStatus rdf:type rdf:Property ;
    rdfs:label 'Gp Entity Status' ;
    rdfs:comment 'Current operational status of the General Partner entity in the pension fund\'s records.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:headquartersPostalCode rdf:type rdf:Property ;
    rdfs:label 'Headquarters Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the General Partner\'s headquarters location.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentTeamSize rdf:type rdf:Property ;
    rdfs:label 'Investment Team Size' ;
    rdfs:comment 'Total number of investment professionals employed by the General Partner.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keyInvestmentProfessionals rdf:type rdf:Property ;
    rdfs:label 'Key Investment Professionals' ;
    rdfs:comment 'Comma-separated list of key investment professionals and senior partners at the GP firm.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Completion Date' ;
    rdfs:comment 'Date when the most recent KYC review was completed and approved.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kycExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Expiry Date' ;
    rdfs:comment 'Date when the current KYC approval expires and requires renewal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:kycStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Status' ;
    rdfs:comment 'Current status of the Know Your Customer due diligence process for this GP entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipStructure rdf:type rdf:Property ;
    rdfs:label 'Ownership Structure' ;
    rdfs:comment 'Classification of the General Partner\'s ownership and organizational structure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentOrganization rdf:type rdf:Property ;
    rdfs:label 'Parent Organization' ;
    rdfs:comment 'Name of the parent or holding company if the GP is part of a larger organization.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priSignatory rdf:type rdf:Property ;
    rdfs:label 'Pri Signatory' ;
    rdfs:comment 'Indicates whether the GP is a signatory to the UN Principles for Responsible Investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:primaryRegulator rdf:type rdf:Property ;
    rdfs:label 'Primary Regulator' ;
    rdfs:comment 'Name of the primary financial regulatory authority overseeing the General Partner.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryStrategy rdf:type rdf:Property ;
    rdfs:label 'Primary Strategy' ;
    rdfs:comment 'Primary private equity investment strategy focus of the General Partner.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Status' ;
    rdfs:comment 'Current regulatory registration status of the GP with relevant financial authorities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipEndDate rdf:type rdf:Property ;
    rdfs:label 'Relationship End Date' ;
    rdfs:comment 'Date when the pension fund\'s Limited Partner relationship with this GP ended, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipStartDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Start Date' ;
    rdfs:comment 'Date when the pension fund first established a Limited Partner relationship with this GP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskRating rdf:type rdf:Property ;
    rdfs:label 'Risk Rating' ;
    rdfs:comment 'Internal risk rating assigned to the General Partner based on operational and counterparty risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryStrategy rdf:type rdf:Property ;
    rdfs:label 'Secondary Strategy' ;
    rdfs:comment 'Secondary or complementary investment strategy pursued by the General Partner, if applicable.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAum rdf:type rdf:Property ;
    rdfs:label 'Total Aum' ;
    rdfs:comment 'Total assets under management across all funds managed by this General Partner, in USD.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalEmployeeCount rdf:type rdf:Property ;
    rdfs:label 'Total Employee Count' ;
    rdfs:comment 'Total number of employees across all functions at the General Partner firm.' ;
    rdfs:domain ind:GpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:trackRecordSummary rdf:type rdf:Property ;
    rdfs:label 'Track Record Summary' ;
    rdfs:comment 'Narrative summary of the GP\'s historical performance track record and key achievements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpAdvisoryCommitteeId rdf:type rdf:Property ;
    rdfs:label 'Lp Advisory Committee Id' ;
    rdfs:comment 'Unique identifier for the LP Advisory Committee membership record.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lpEntityId rdf:type rdf:Property ;
    rdfs:label 'Lp Entity Id' ;
    rdfs:comment 'Foreign key linking to privateequity.lp_entity. Business justification: LPAC members are LP investors in the fund. The member_organization and member_organization_lei fields are denormalized LP entity data.' ;
    rdfs:domain ind:Privateequity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LpEntity .

ind:alternateMemberName rdf:type rdf:Property ;
    rdfs:label 'Alternate Member Name' ;
    rdfs:comment 'Name of the designated alternate who may represent the member in their absence.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentAuthority rdf:type rdf:Property ;
    rdfs:label 'Appointment Authority' ;
    rdfs:comment 'Name or title of the entity or individual who appointed the member to the advisory committee.' ;
    rdfs:domain ind:LpAdvisoryCommittee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appointmentDate rdf:type rdf:Property ;
    rdfs:label 'Appointment Date' ;
    rdfs:comment 'Date on which the member was formally appointed to the LP Advisory Committee.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:committeeRole rdf:type rdf:Property ;
    rdfs:label 'Committee Role' ;
