    rdfs:comment 'Date when the quote source was last validated for data quality and compliance with internal standards.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:licenseExpiryDate rdf:type rdf:Property ;
