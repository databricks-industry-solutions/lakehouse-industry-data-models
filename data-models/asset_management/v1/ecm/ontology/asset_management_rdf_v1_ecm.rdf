ind:websiteUrl rdf:type rdf:Property ;
    rdfs:label 'Website Url' ;
    rdfs:comment 'The primary corporate website URL for the issuer providing investor relations and company information.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerFinancialsId rdf:type rdf:Property ;
    rdfs:label 'Issuer Financials Id' ;
    rdfs:comment 'Unique identifier for the issuer financial record.' ;
