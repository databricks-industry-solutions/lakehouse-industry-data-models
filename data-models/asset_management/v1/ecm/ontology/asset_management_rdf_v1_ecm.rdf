    rdfs:domain ind:IcResearchPack ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:packTitle rdf:type rdf:Property ;
    rdfs:label 'Pack Title' ;
    rdfs:comment 'Formal title of the research package as presented to the Investment Committee.' ;
