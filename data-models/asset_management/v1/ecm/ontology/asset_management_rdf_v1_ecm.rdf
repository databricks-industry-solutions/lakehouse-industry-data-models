ind:assetQuantity rdf:type rdf:Property ;
    rdfs:label 'Asset Quantity' ;
    rdfs:comment 'Number of units of the posted asset (e.g., shares, bond face value).' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetValue rdf:type rdf:Property ;
    rdfs:label 'Asset Value' ;
    rdfs:comment 'Market value of the posted asset at the time of posting, expressed in the posting currency.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralQuality rdf:type rdf:Property ;
    rdfs:label 'Collateral Quality' ;
    rdfs:comment 'Regulatory eligibility status of the posted collateral.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralSource rdf:type rdf:Property ;
    rdfs:label 'Collateral Source' ;
    rdfs:comment 'Origin of the collateral (e.g., cash pool, bond portfolio).' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:direction rdf:type rdf:Property ;
    rdfs:label 'Direction' ;
    rdfs:comment 'Indicates whether collateral was posted to, received from, or returned to the counterparty.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalReference rdf:type rdf:Property ;
    rdfs:label 'Internal Reference' ;
    rdfs:comment 'Internal reference or memo number used for reconciliation across systems.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:postingStatus rdf:type rdf:Property ;
    rdfs:label 'Posting Status' ;
    rdfs:comment 'Current lifecycle state of the posting record.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryReported rdf:type rdf:Property ;
    rdfs:label 'Regulatory Reported' ;
    rdfs:comment 'Indicates whether the posting has been reported to EMIR or other regulatory regimes.' ;
    rdfs:domain ind:Posting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ccpMembershipId rdf:type rdf:Property ;
    rdfs:label 'Ccp Ccp Membership Id' ;
    rdfs:comment 'Identifier of the clearing house (CCP) when collateral is posted to a CCP.' ;
    rdfs:domain ind:CollateralPosition ;
