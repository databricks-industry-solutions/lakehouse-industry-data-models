ind:investmentRecommendation rdf:type rdf:Property ;
    rdfs:label 'Investment Recommendation' ;
    rdfs:comment 'The analysts formal investment recommendation for the covered security. [ENUM-REF-CANDIDATE: strong_buy|buy|hold|reduce|sell|under_review|not_rated — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyCatalysts rdf:type rdf:Property ;
    rdfs:label 'Key Catalysts' ;
