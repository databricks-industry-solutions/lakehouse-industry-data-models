    rdfs:range xsd:string .

ind:examFindingDescription rdf:type rdf:Property ;
    rdfs:label 'Exam Finding Description' ;
    rdfs:comment 'Detailed narrative describing the observation, deficiency, or violation.' ;
    rdfs:domain ind:ExamFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:examFindingStatus rdf:type rdf:Property ;
    rdfs:label 'Exam Finding Status' ;
    rdfs:comment 'Current processing state of the finding.' ;
    rdfs:domain ind:ExamFinding ;
