ind:isSyndicated rdf:type rdf:Property ;
    rdfs:label 'Is Syndicated' ;
    rdfs:comment 'Indicates whether the facility is part of a syndicated loan arrangement.' ;
    rdfs:domain ind:PrivateCreditFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lossGivenDefaultPercent rdf:type rdf:Property ;
    rdfs:label 'Loss Given Default Percent' ;
    rdfs:comment 'Expected loss percentage of exposure in the event of borrower default.' ;
    rdfs:domain ind:PrivateCreditFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:probabilityOfDefaultPercent rdf:type rdf:Property ;
    rdfs:label 'Probability Of Default Percent' ;
    rdfs:comment 'Estimated one-year probability of default percentage for credit risk modeling.' ;
    rdfs:domain ind:PrivateCreditFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seniorityRank rdf:type rdf:Property ;
    rdfs:label 'Seniority Rank' ;
    rdfs:comment 'Position in the capital structure determining payment priority in default scenarios.' ;
    rdfs:domain ind:PrivateCreditFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upfrontFeePercent rdf:type rdf:Property ;
    rdfs:label 'Upfront Fee Percent' ;
    rdfs:comment 'One-time origination fee percentage charged at facility closing.' ;
    rdfs:domain ind:PrivateCreditFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataProviderId rdf:type rdf:Property ;
    rdfs:label 'Data Provider Id' ;
    rdfs:comment 'Foreign key linking to esg.data_provider. Business justification: ESG data for an opportunity is sourced from a specific data provider; tracking the provider ensures data provenance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DataProvider .

ind:frameworkId rdf:type rdf:Property ;
    rdfs:label 'Framework Id' ;
    rdfs:comment 'Foreign key linking to esg.framework. Business justification: Each opportunity is evaluated against a specific ESG framework; the investment team selects the framework during opportunity creation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Framework .

ind:originationSourceId rdf:type rdf:Property ;
    rdfs:label 'Origination Source Id' ;
    rdfs:comment 'Foreign key linking to deal.origination_source. Business justification: Opportunity records originate from a specific source; adding a FK to origination_source links the siloed origination_source table and captures the source of each opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OriginationSource .

ind:targetEntityId rdf:type rdf:Property ;
    rdfs:label 'Target Entity Id' ;
    rdfs:comment 'Foreign key linking to deal.target_entity. Business justification: Opportunity should reference the target entity; adding a FK to target_entity removes redundant columns and ensures consistency across the model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TargetEntity .

ind:actualCloseDate rdf:type rdf:Property ;
    rdfs:label 'Actual Close Date' ;
    rdfs:comment 'Actual date on which the transaction closed and capital was deployed, if applicable.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opportunityCode rdf:type rdf:Property ;
    rdfs:label 'Opportunity Code' ;
    rdfs:comment 'Internal tracking code or reference number assigned to the opportunity for pipeline management and reporting purposes.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRoomUrl rdf:type rdf:Property ;
    rdfs:label 'Data Room Url' ;
    rdfs:comment 'Web address or link to the virtual data room containing confidential due diligence materials for the opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReason rdf:type rdf:Property ;
    rdfs:label 'Decline Reason' ;
    rdfs:comment 'Primary rationale for declining or passing on the opportunity, captured for pipeline analytics and lessons learned.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgExclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Exclusion Flag' ;
    rdfs:comment 'Boolean indicator of whether the opportunity triggers any ESG exclusion criteria per the funds responsible investment policy.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedCloseDate rdf:type rdf:Property ;
    rdfs:label 'Expected Close Date' ;
    rdfs:comment 'Anticipated date for final transaction closing and capital deployment.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedInvestmentAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Investment Amount' ;
    rdfs:comment 'Anticipated capital commitment or investment size in base currency for this opportunity.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpSponsorName rdf:type rdf:Property ;
    rdfs:label 'Gp Sponsor Name' ;
    rdfs:comment 'Name of the General Partner, fund manager, or sponsor presenting or managing the opportunity.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icDecision rdf:type rdf:Property ;
    rdfs:label 'Ic Decision' ;
    rdfs:comment 'Final decision outcome from the Investment Committee regarding the opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Ic Decision Date' ;
    rdfs:comment 'Date on which the Investment Committee rendered a formal decision on the opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Date' ;
    rdfs:comment 'Date on which the opportunity was formally submitted to the Investment Committee for approval consideration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:intermediaryName rdf:type rdf:Property ;
    rdfs:label 'Intermediary Name' ;
    rdfs:comment 'Name of the investment bank, advisor, or intermediary facilitating the opportunity, if applicable.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Investment Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the expected investment amount.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loiStatus rdf:type rdf:Property ;
    rdfs:label 'Loi Status' ;
    rdfs:comment 'Current status of the Letter of Intent submission indicating preliminary commitment interest.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loiSubmissionDate rdf:type rdf:Property ;
    rdfs:label 'Loi Submission Date' ;
    rdfs:comment 'Date on which the Letter of Intent was formally submitted to the General Partner (GP) or seller.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opportunityName rdf:type rdf:Property ;
    rdfs:label 'Opportunity Name' ;
    rdfs:comment 'Business name or title of the investment opportunity as presented by the General Partner (GP) or intermediary.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Nda Execution Date' ;
    rdfs:comment 'Date on which the Non-Disclosure Agreement was fully executed by all parties.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndaStatus rdf:type rdf:Property ;
    rdfs:label 'Nda Status' ;
    rdfs:comment 'Current status of the Non-Disclosure Agreement required to access confidential information for the opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opportunityStatus rdf:type rdf:Property ;
    rdfs:label 'Opportunity Status' ;
    rdfs:comment 'Current lifecycle stage of the opportunity in the investment pipeline workflow. [ENUM-REF-CANDIDATE: prospecting|screening|due_diligence|ic_review|approved|declined|on_hold|closed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opportunityType rdf:type rdf:Property ;
    rdfs:label 'Opportunity Type' ;
    rdfs:comment 'Classification of the investment structure: direct investment, co-investment alongside a General Partner (GP), fund commitment, secondary market transaction, joint venture, or club deal.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorityTier rdf:type rdf:Property ;
    rdfs:label 'Priority Tier' ;
    rdfs:comment 'Internal prioritization ranking for resource allocation and pipeline management, with Tier 1 representing highest priority opportunities.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourcingChannel rdf:type rdf:Property ;
    rdfs:label 'Sourcing Channel' ;
    rdfs:comment 'Method by which the opportunity was originated: proprietary off-market deal, GP-introduced, intermediated through advisor, inbound inquiry, or network referral.' ;
    rdfs:domain ind:Opportunity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategicFitScore rdf:type rdf:Property ;
    rdfs:label 'Strategic Fit Score' ;
    rdfs:comment 'Quantitative score (typically 1-10 scale) assessing alignment with Strategic Asset Allocation (SAA) and portfolio construction objectives.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pipelineStageId rdf:type rdf:Property ;
    rdfs:label 'Pipeline Stage Id' ;
    rdfs:comment 'Unique identifier for the pipeline stage record.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PipelineStage .

ind:alternateExitStages rdf:type rdf:Property ;
    rdfs:label 'Alternate Exit Stages' ;
    rdfs:comment 'Comma-separated list of stage codes representing valid non-sequential exit paths (e.g., rejection, withdrawal, fast-track approval).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableAssetClasses rdf:type rdf:Property ;
    rdfs:label 'Applicable Asset Classes' ;
    rdfs:comment 'Comma-separated list of asset classes for which this stage is applicable (e.g., Private Equity, Real Estate, Infrastructure, Credit). Empty if applicable to all.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:applicableDealTypes rdf:type rdf:Property ;
    rdfs:label 'Applicable Deal Types' ;
    rdfs:comment 'Comma-separated list of deal types for which this stage is applicable (e.g., Direct Investment, Co-Investment, Fund Commitment, Secondary). Empty if applicable to all.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceCheckpoints rdf:type rdf:Property ;
    rdfs:label 'Compliance Checkpoints' ;
    rdfs:comment 'Comma-separated list of regulatory, legal, or internal compliance checks required at this stage (e.g., KYC, AML, EMIR, SFDR pre-contractual disclosure).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entryCriteria rdf:type rdf:Property ;
    rdfs:label 'Entry Criteria' ;
    rdfs:comment 'Textual description of conditions or prerequisites that must be met for a deal to enter this stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationContact rdf:type rdf:Property ;
    rdfs:label 'Escalation Contact' ;
    rdfs:comment 'Role, title, or individual to whom deals are escalated when escalation threshold is breached.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationThresholdDays rdf:type rdf:Property ;
    rdfs:label 'Escalation Threshold Days' ;
    rdfs:comment 'Number of days in stage after which automatic escalation or alert is triggered to senior management or deal governance committee.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Esg Review Required' ;
    rdfs:comment 'Indicates whether an Environmental, Social, and Governance (ESG) assessment is required at this stage per PRI and SFDR obligations.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exitCriteria rdf:type rdf:Property ;
    rdfs:label 'Exit Criteria' ;
    rdfs:comment 'Textual description of conditions, deliverables, or approvals required for a deal to exit this stage and progress to the next.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceFramework rdf:type rdf:Property ;
    rdfs:label 'Governance Framework' ;
    rdfs:comment 'Reference to the governance policy, Investment Committee (IC) charter, or procedural document governing this stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icSubmissionRequired rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Required' ;
    rdfs:comment 'Indicates whether a formal Investment Committee (IC) submission and Investment Memorandum (IM) are required at this stage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isApprovalGate rdf:type rdf:Property ;
    rdfs:label 'Is Approval Gate' ;
    rdfs:comment 'Indicates whether this stage requires formal Investment Committee (IC) or other governance approval before progression.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTerminal rdf:type rdf:Property ;
    rdfs:label 'Is Terminal' ;
    rdfs:comment 'Indicates whether this stage represents a terminal state (deal closed, deal rejected, deal withdrawn) with no further progression.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewRequired rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required' ;
    rdfs:comment 'Indicates whether legal counsel review and sign-off is required before exiting this stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maximumDwellDays rdf:type rdf:Property ;
    rdfs:label 'Maximum Dwell Days' ;
    rdfs:comment 'Maximum allowable calendar days in this stage before escalation or review is triggered, preventing pipeline stagnation.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minimumDwellDays rdf:type rdf:Property ;
    rdfs:label 'Minimum Dwell Days' ;
    rdfs:comment 'Minimum number of calendar days a deal must remain in this stage before progression, enforcing process discipline and thoroughness.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predecessorStageCode rdf:type rdf:Property ;
    rdfs:label 'Predecessor Stage Code' ;
    rdfs:comment 'Stage code of the immediately preceding stage in the standard pipeline sequence. Null for the first stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingLabel rdf:type rdf:Property ;
    rdfs:label 'Reporting Label' ;
    rdfs:comment 'Abbreviated or alternative label used for this stage in executive reports, dashboards, and external communications.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredApprovers rdf:type rdf:Property ;
    rdfs:label 'Required Approvers' ;
    rdfs:comment 'Comma-separated list or structured text identifying roles or individuals whose approval is required to exit this stage (e.g., CIO, IC Chair, Legal Counsel).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiredDeliverables rdf:type rdf:Property ;
    rdfs:label 'Required Deliverables' ;
    rdfs:comment 'Comma-separated list or structured text defining mandatory deliverables, documents, or milestones required for stage completion (e.g., NDA, LOI, IM, FDD report).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskAssessmentRequired rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Required' ;
    rdfs:comment 'Indicates whether a formal risk assessment or risk rating is required before exiting this stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stageCategory rdf:type rdf:Property ;
    rdfs:label 'Stage Category' ;
    rdfs:comment 'High-level grouping of the stage within the investment lifecycle (origination, screening, diligence, approval, execution, post-close).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageCode rdf:type rdf:Property ;
    rdfs:label 'Stage Code' ;
    rdfs:comment 'Short alphanumeric code uniquely identifying the pipeline stage (e.g., SCREEN, DD, IC_PREP, IC_APPR, CLOSING).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageColorCode rdf:type rdf:Property ;
    rdfs:label 'Stage Color Code' ;
    rdfs:comment 'Hexadecimal color code used for visual representation of this stage in dashboards and reporting tools (e.g., #4CAF50 for green).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageDescription rdf:type rdf:Property ;
    rdfs:label 'Stage Description' ;
    rdfs:comment 'Detailed narrative description of the purpose, activities, and objectives of this pipeline stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageIcon rdf:type rdf:Property ;
    rdfs:label 'Stage Icon' ;
    rdfs:comment 'Icon identifier or Unicode character used for visual representation of this stage in user interfaces.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageName rdf:type rdf:Property ;
    rdfs:label 'Stage Name' ;
    rdfs:comment 'Full descriptive name of the pipeline stage (e.g., Initial Screening, Due Diligence, Investment Committee Approval).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageNotes rdf:type rdf:Property ;
    rdfs:label 'Stage Notes' ;
    rdfs:comment 'Free-form text field for additional notes, guidance, or context relevant to this pipeline stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageOwnerRole rdf:type rdf:Property ;
    rdfs:label 'Stage Owner Role' ;
    rdfs:comment 'Role or function responsible for managing and driving deals through this stage (e.g., Deal Lead, Due Diligence Manager, Legal Counsel).' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stageSequence rdf:type rdf:Property ;
    rdfs:label 'Stage Sequence' ;
    rdfs:comment 'Numeric ordering of the stage within the deal pipeline lifecycle, enabling chronological sorting and progression tracking.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:stageType rdf:type rdf:Property ;
    rdfs:label 'Stage Type' ;
    rdfs:comment 'Classification indicating whether the stage is mandatory for all deals, optional, or conditional based on deal characteristics.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successorStageCode rdf:type rdf:Property ;
    rdfs:label 'Successor Stage Code' ;
    rdfs:comment 'Stage code of the immediately following stage in the standard pipeline sequence. Null for terminal stages.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDwellDays rdf:type rdf:Property ;
    rdfs:label 'Target Dwell Days' ;
    rdfs:comment 'Target number of calendar days for deal completion within this stage, used for pipeline velocity tracking and performance management.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationRequired rdf:type rdf:Property ;
    rdfs:label 'Valuation Required' ;
    rdfs:comment 'Indicates whether a formal valuation (DCF, comparable company analysis, or third-party appraisal) is required at this stage.' ;
    rdfs:domain ind:PipelineStage ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stageTransitionId rdf:type rdf:Property ;
    rdfs:label 'Stage Transition Id' ;
    rdfs:comment 'Unique identifier for the stage transition event record.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dealIcSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Deal Ic Submission Id' ;
    rdfs:comment 'Reference to the Investment Committee submission record associated with this transition.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealIcSubmission .

ind:approvingCommittee rdf:type rdf:Property ;
    rdfs:label 'Approving Committee' ;
    rdfs:comment 'Name of the Investment Committee or governance body that approved this transition, if applicable.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvingUserName rdf:type rdf:Property ;
    rdfs:label 'Approving User Name' ;
    rdfs:comment 'Full name of the user who approved or executed this stage transition, captured for audit trail.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsImposed rdf:type rdf:Property ;
    rdfs:label 'Conditions Imposed' ;
    rdfs:comment 'List of conditions or requirements imposed as part of a conditional approval decision.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeDaysInPipeline rdf:type rdf:Property ;
    rdfs:label 'Cumulative Days In Pipeline' ;
    rdfs:comment 'Total number of calendar days the opportunity has been in the pipeline as of this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:daysInPriorStage rdf:type rdf:Property ;
    rdfs:label 'Days In Prior Stage' ;
    rdfs:comment 'Number of calendar days the opportunity spent in the prior stage before this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:decisionOutcome rdf:type rdf:Property ;
    rdfs:label 'Decision Outcome' ;
    rdfs:comment 'Result of the gate or screening decision: pass (approved to advance), fail (rejected), conditional (approved with conditions), deferred (postponed), withdrawn (sponsor pulled).' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionType rdf:type rdf:Property ;
    rdfs:label 'Decision Type' ;
    rdfs:comment 'Nature of the decision that triggered the transition: automatic (system-driven), manual (user-initiated), ic_decision (Investment Committee), screening (preliminary filter), gate_review (formal checkpoint).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gateCriteriaChecklist rdf:type rdf:Property ;
    rdfs:label 'Gate Criteria Checklist' ;
    rdfs:comment 'Summary of gate criteria evaluated and their pass/fail status for this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gateCriteriaMet rdf:type rdf:Property ;
    rdfs:label 'Gate Criteria Met' ;
    rdfs:comment 'Indicates whether all formal gate criteria were satisfied for this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icApprovalReceived rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Received' ;
    rdfs:comment 'Indicates whether Investment Committee approval was obtained for this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMilestoneTransition rdf:type rdf:Property ;
    rdfs:label 'Is Milestone Transition' ;
    rdfs:comment 'Indicates whether this transition represents a major milestone in the deal lifecycle.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newStageCode rdf:type rdf:Property ;
    rdfs:label 'New Stage Code' ;
    rdfs:comment 'Code representing the pipeline stage the opportunity moved to in this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newStageName rdf:type rdf:Property ;
    rdfs:label 'New Stage Name' ;
    rdfs:comment 'Human-readable name of the pipeline stage the opportunity moved to in this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Notification Timestamp' ;
    rdfs:comment 'Date and time when stakeholder notifications were sent for this transition.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:priorStageCode rdf:type rdf:Property ;
    rdfs:label 'Prior Stage Code' ;
    rdfs:comment 'Code representing the pipeline stage the opportunity was in before this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStageName rdf:type rdf:Property ;
    rdfs:label 'Prior Stage Name' ;
    rdfs:comment 'Human-readable name of the pipeline stage the opportunity was in before this transition.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordCreatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Created By' ;
    rdfs:comment 'User or system identifier that created this stage transition record.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requiresIcApproval rdf:type rdf:Property ;
    rdfs:label 'Requires Ic Approval' ;
    rdfs:comment 'Indicates whether this stage transition required formal Investment Committee approval.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supportingDocumentCount rdf:type rdf:Property ;
    rdfs:label 'Supporting Document Count' ;
    rdfs:comment 'Number of supporting documents attached to this stage transition for audit and review purposes.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:systemGenerated rdf:type rdf:Property ;
    rdfs:label 'System Generated' ;
    rdfs:comment 'Indicates whether this transition was automatically generated by the system versus manually recorded by a user.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:transitionDate rdf:type rdf:Property ;
    rdfs:label 'Transition Date' ;
    rdfs:comment 'Calendar date of the stage transition, used for day-level reporting and analytics.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transitionNotes rdf:type rdf:Property ;
    rdfs:label 'Transition Notes' ;
    rdfs:comment 'Free-text notes and commentary captured during the stage transition, providing additional context.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionNumber rdf:type rdf:Property ;
    rdfs:label 'Transition Number' ;
    rdfs:comment 'Business-facing identifier for this stage transition event, used for audit trail and reporting purposes.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonCode rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Code' ;
    rdfs:comment 'Standardized code indicating the primary reason for the stage transition.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Transition Reason Description' ;
    rdfs:comment 'Detailed explanation of why the stage transition occurred, capturing business rationale and context.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:transitionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Transition Sequence Number' ;
    rdfs:comment 'Sequential order of this transition within the opportunity lifecycle, starting from 1.' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:transitionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Transition Timestamp' ;
    rdfs:comment 'Precise date and time when the stage transition occurred, capturing the business event moment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:transitionType rdf:type rdf:Property ;
    rdfs:label 'Transition Type' ;
    rdfs:comment 'Classification of the transition movement: advance (forward progress), retreat (moved back), reopen (reactivated), reject (declined), approve (gate passed), hold (paused).' ;
    rdfs:domain ind:StageTransition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaId rdf:type rdf:Property ;
    rdfs:label 'Nda Id' ;
    rdfs:comment 'Unique identifier for the non-disclosure agreement record.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:counterpartyLegalEntityCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Counterparty Legal Entity Counterparty Id' ;
    rdfs:comment 'Reference to the legal entity with whom the NDA is executed.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:supersededByNdaId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Nda Id' ;
    rdfs:comment 'Reference to a subsequent NDA that replaces or supersedes this agreement.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Nda .

ind:breachDescription rdf:type rdf:Property ;
    rdfs:label 'Breach Description' ;
    rdfs:comment 'Detailed description of the nature and circumstances of any reported NDA breach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachReportedFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Reported Flag' ;
    rdfs:comment 'Indicates whether a breach or suspected breach of the NDA has been reported.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Period Years' ;
    rdfs:comment 'Duration in years for which confidential information must be protected under the NDA.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartySignatoryName rdf:type rdf:Property ;
    rdfs:label 'Counterparty Signatory Name' ;
    rdfs:comment 'Full name of the individual who signed the NDA on behalf of the counterparty.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartySignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Counterparty Signatory Title' ;
    rdfs:comment 'Job title or role of the counterparty signatory (e.g., Chief Executive Officer, General Counsel).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRoomAccessGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Data Room Access Granted Flag' ;
    rdfs:comment 'Indicates whether the NDA has been executed and data room access has been granted to the investment team.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dealOriginationSource rdf:type rdf:Property ;
    rdfs:label 'Deal Origination Source' ;
    rdfs:comment 'Channel through which the deal opportunity was sourced, determining NDA negotiation context.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureToAdvisorsPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure To Advisors Permitted Flag' ;
    rdfs:comment 'Indicates whether the NDA permits disclosure of confidential information to external advisors (legal, financial, operational) under confidentiality.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentStorageLocation rdf:type rdf:Property ;
    rdfs:label 'Document Storage Location' ;
    rdfs:comment 'File path or document management system reference where the executed NDA is stored.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedDealSizeUsdMillions rdf:type rdf:Property ;
    rdfs:label 'Estimated Deal Size Usd Millions' ;
    rdfs:comment 'Estimated transaction size in millions of US dollars at the time of NDA execution.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalCounselFirm rdf:type rdf:Property ;
    rdfs:label 'External Counsel Firm' ;
    rdfs:comment 'Name of the external law firm that advised on or reviewed the NDA, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intermediaryFirmName rdf:type rdf:Property ;
    rdfs:label 'Intermediary Firm Name' ;
    rdfs:comment 'Name of the investment bank, broker, or advisor facilitating the deal, if applicable.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalCounselApprovalFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Counsel Approval Flag' ;
    rdfs:comment 'Indicates whether the NDA has been reviewed and approved by internal legal counsel.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Internal Signatory Name' ;
    rdfs:comment 'Full name of the individual who signed the NDA on behalf of the pension fund.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalSignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Internal Signatory Title' ;
    rdfs:comment 'Job title or role of the internal signatory (e.g., Senior Managing Director, Chief Investment Officer).' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPerpetual rdf:type rdf:Property ;
    rdfs:label 'Is Perpetual' ;
    rdfs:comment 'Indicates whether the NDA has no expiry date and confidentiality obligations continue indefinitely.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndaType rdf:type rdf:Property ;
    rdfs:label 'Nda Type' ;
    rdfs:comment 'Classification of the NDA structure: mutual (both parties bound), one-way (unilateral), or multilateral (multiple parties).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonSolicitationFlag rdf:type rdf:Property ;
    rdfs:label 'Non Solicitation Flag' ;
    rdfs:comment 'Indicates whether the NDA includes a non-solicitation clause prohibiting hiring or soliciting employees of the disclosing party.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:permittedUseScope rdf:type rdf:Property ;
    rdfs:label 'Permitted Use Scope' ;
    rdfs:comment 'Description of the permitted purposes for which confidential information may be used (e.g., evaluation of investment opportunity, due diligence).' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDisclosureCarveoutFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Disclosure Carveout Flag' ;
    rdfs:comment 'Indicates whether the NDA includes a carveout permitting disclosure to regulatory authorities or as required by law.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationActionTaken rdf:type rdf:Property ;
    rdfs:label 'Remediation Action Taken' ;
    rdfs:comment 'Description of corrective or remedial actions taken in response to an NDA breach.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnOrDestroyObligationFlag rdf:type rdf:Property ;
    rdfs:label 'Return Or Destroy Obligation Flag' ;
    rdfs:comment 'Indicates whether the NDA requires the receiving party to return or destroy confidential materials upon request or termination.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standstillPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Standstill Period Months' ;
    rdfs:comment 'Duration in months for which the standstill provision applies, if present.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:standstillProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Standstill Provision Flag' ;
    rdfs:comment 'Indicates whether the NDA includes a standstill clause restricting the counterparty from making unsolicited offers or acquiring securities.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetCompanyName rdf:type rdf:Property ;
    rdfs:label 'Target Company Name' ;
    rdfs:comment 'Name of the target company or asset that is the subject of the confidential evaluation.' ;
    rdfs:domain ind:Nda ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetGeography rdf:type rdf:Property ;
    rdfs:label 'Target Geography' ;
    rdfs:comment 'Primary geographic location or jurisdiction of the target asset or company.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:templateVersion rdf:type rdf:Property ;
    rdfs:label 'Template Version' ;
    rdfs:comment 'Version identifier of the NDA template used as the basis for this agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loiId rdf:type rdf:Property ;
    rdfs:label 'Loi Id' ;
    rdfs:comment 'Unique identifier for the Letter of Intent record.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByLoiId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Loi Id' ;
    rdfs:comment 'Reference to a subsequent LOI that supersedes this one.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Loi .

ind:acceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Acceptance Date' ;
    rdfs:comment 'Date on which the counterparty formally accepted the LOI terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Break Fee Amount' ;
    rdfs:comment 'Monetary penalty payable if either party terminates the LOI under specified conditions.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidentialityClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Clause Flag' ;
    rdfs:comment 'Indicates whether the LOI includes a confidentiality clause binding the parties.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depositAmount rdf:type rdf:Property ;
    rdfs:label 'Deposit Amount' ;
    rdfs:comment 'Good faith deposit or earnest money amount required under the LOI terms.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depositDueDate rdf:type rdf:Property ;
    rdfs:label 'Deposit Due Date' ;
    rdfs:comment 'Date by which the deposit amount must be paid.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dueDiligencePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Period Days' ;
    rdfs:comment 'Number of days allocated for conducting due diligence as specified in the LOI.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusivityEndDate rdf:type rdf:Property ;
    rdfs:label 'Exclusivity End Date' ;
    rdfs:comment 'Date on which the exclusivity period ends.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusivityFlag rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Flag' ;
    rdfs:comment 'Indicates whether the LOI includes an exclusivity provision preventing the seller from negotiating with other parties.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityStartDate rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Start Date' ;
    rdfs:comment 'Date from which the exclusivity period begins, preventing the seller from negotiating with other parties.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financingContingencyFlag rdf:type rdf:Property ;
    rdfs:label 'Financing Contingency Flag' ;
    rdfs:comment 'Indicates whether the LOI is contingent upon securing financing.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indicativeEnterpriseValue rdf:type rdf:Property ;
    rdfs:label 'Indicative Enterprise Value' ;
    rdfs:comment 'Proposed total enterprise value of the target asset or company as stated in the LOI.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indicativeEquityValue rdf:type rdf:Property ;
    rdfs:label 'Indicative Equity Value' ;
    rdfs:comment 'Proposed equity value of the target asset or company as stated in the LOI.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loiType rdf:type rdf:Property ;
    rdfs:label 'Loi Type' ;
    rdfs:comment 'Classification of the LOI indicating whether it creates legally binding obligations or is indicative only.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Nda Reference Number' ;
    rdfs:comment 'Reference number of the NDA executed prior to LOI issuance.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedDealStructure rdf:type rdf:Property ;
    rdfs:label 'Proposed Deal Structure' ;
    rdfs:comment 'Type of transaction structure proposed in the LOI.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedOwnershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Proposed Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership stake proposed to be acquired, expressed as a decimal (e.g., 51.00 for 51%).' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rejectionDate rdf:type rdf:Property ;
    rdfs:label 'Rejection Date' ;
    rdfs:comment 'Date on which the counterparty formally rejected the LOI.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEntityName rdf:type rdf:Property ;
    rdfs:label 'Target Entity Name' ;
    rdfs:comment 'Legal name of the target company or asset being acquired.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetLei rdf:type rdf:Property ;
    rdfs:label 'Target Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier of the target entity if available.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termSheetReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Term Sheet Reference Number' ;
    rdfs:comment 'Reference number of the term sheet that preceded or accompanies this LOI.' ;
    rdfs:domain ind:Loi ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termSheetId rdf:type rdf:Property ;
    rdfs:label 'Term Sheet Id' ;
    rdfs:comment 'Unique identifier for the term sheet record. Primary key.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:bindingStatus rdf:type rdf:Property ;
    rdfs:label 'Binding Status' ;
    rdfs:comment 'Indicates whether the term sheet is legally binding or non-binding.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:closingConditions rdf:type rdf:Property ;
    rdfs:label 'Closing Conditions' ;
    rdfs:comment 'Key conditions precedent that must be satisfied before transaction closing.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealStructureType rdf:type rdf:Property ;
    rdfs:label 'Deal Structure Type' ;
    rdfs:comment 'Proposed structure of the investment transaction.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentStoragePath rdf:type rdf:Property ;
    rdfs:label 'Document Storage Path' ;
    rdfs:comment 'File path or URI to the physical term sheet document in the document management system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityValue rdf:type rdf:Property ;
    rdfs:label 'Equity Value' ;
    rdfs:comment 'Proposed equity value of the target asset or company.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgConsiderations rdf:type rdf:Property ;
    rdfs:label 'Esg Considerations' ;
    rdfs:comment 'Summary of ESG factors and responsible investment considerations relevant to the term sheet.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Period Days' ;
    rdfs:comment 'Number of days during which the counterparty grants exclusive negotiation rights.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:governanceRights rdf:type rdf:Property ;
    rdfs:label 'Governance Rights' ;
    rdfs:comment 'Summary of proposed governance rights including board seats, veto rights, and consent provisions.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icSubmissionPlannedDate rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Planned Date' ;
    rdfs:comment 'Planned date for submission of the investment opportunity to the Investment Committee.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentHorizonYears rdf:type rdf:Property ;
    rdfs:label 'Investment Horizon Years' ;
    rdfs:comment 'Expected holding period for the investment expressed in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keyTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Key Terms Summary' ;
    rdfs:comment 'High-level summary of the principal economic and structural terms of the proposed deal.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loiReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Loi Reference Number' ;
    rdfs:comment 'Reference number of the associated Letter of Intent if one was issued prior to term sheet.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedInvestmentAmount rdf:type rdf:Property ;
    rdfs:label 'Proposed Investment Amount' ;
    rdfs:comment 'Total capital amount proposed for investment in base currency.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryApprovalsRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approvals Required' ;
    rdfs:comment 'List of regulatory approvals or filings required to complete the transaction.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceChannel rdf:type rdf:Property ;
    rdfs:label 'Source Channel' ;
    rdfs:comment 'Channel through which the deal opportunity was sourced.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termSheetStatus rdf:type rdf:Property ;
    rdfs:label 'Term Sheet Status' ;
    rdfs:comment 'Current lifecycle status of the term sheet in the negotiation process.' ;
    rdfs:domain ind:TermSheet ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentMemoId rdf:type rdf:Property ;
    rdfs:label 'Investment Memo Id' ;
    rdfs:comment 'Unique identifier for the investment memorandum record. Primary key.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadAuthorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Author Employee Id' ;
    rdfs:comment 'Employee identifier of the primary investment professional responsible for preparing the memorandum.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:competitiveLandscape rdf:type rdf:Property ;
    rdfs:label 'Competitive Landscape' ;
    rdfs:comment 'Assessment of the competitive environment, market positioning, and key competitors relevant to the target investment.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealStructure rdf:type rdf:Property ;
    rdfs:label 'Deal Structure' ;
    rdfs:comment 'Proposed transaction structure including equity stake, debt instruments, preferred shares, or other investment vehicles.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealType rdf:type rdf:Property ;
    rdfs:label 'Deal Type' ;
    rdfs:comment 'Type of investment structure being proposed in the memorandum.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentLocation rdf:type rdf:Property ;
    rdfs:label 'Document Location' ;
    rdfs:comment 'File path or URI reference to the full investment memorandum document stored in the document management system.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icConditions rdf:type rdf:Property ;
    rdfs:label 'Ic Conditions' ;
    rdfs:comment 'Specific conditions or requirements stipulated by the Investment Committee that must be satisfied before proceeding with the investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icDecisionNotes rdf:type rdf:Property ;
    rdfs:label 'Ic Decision Notes' ;
    rdfs:comment 'Additional commentary, rationale, or guidance provided by the Investment Committee regarding their decision.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icRecommendation rdf:type rdf:Property ;
    rdfs:label 'Ic Recommendation' ;
    rdfs:comment 'Formal recommendation presented to the Investment Committee regarding the proposed investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementAssessment rdf:type rdf:Property ;
    rdfs:label 'Management Assessment' ;
    rdfs:comment 'Evaluation of the target company management team quality, experience, track record, and alignment with investment objectives.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memoNumber rdf:type rdf:Property ;
    rdfs:label 'Memo Number' ;
    rdfs:comment 'Business identifier for the investment memorandum, typically formatted as IM-YYYY-NNNN.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:memoStatus rdf:type rdf:Property ;
    rdfs:label 'Memo Status' ;
    rdfs:comment 'Current lifecycle status of the investment memorandum in the approval workflow.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationStrategies rdf:type rdf:Property ;
    rdfs:label 'Mitigation Strategies' ;
    rdfs:comment 'Proposed strategies and actions to mitigate identified investment risks.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparationDate rdf:type rdf:Property ;
    rdfs:label 'Preparation Date' ;
    rdfs:comment 'Date when the investment memorandum was initially prepared by the investment team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:proposedCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Proposed Commitment Amount' ;
    rdfs:comment 'Total capital commitment amount being recommended for Investment Committee approval, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetCountry rdf:type rdf:Property ;
    rdfs:label 'Target Country' ;
    rdfs:comment 'Three-letter ISO country code representing the primary geographic location of the target asset or company headquarters.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDescription rdf:type rdf:Property ;
    rdfs:label 'Target Description' ;
    rdfs:comment 'Detailed business description of the target company or asset, including operations, market position, and strategic rationale.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetName rdf:type rdf:Property ;
    rdfs:label 'Target Name' ;
    rdfs:comment 'Name of the target company, asset, or fund that is the subject of the investment proposal.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetRegion rdf:type rdf:Property ;
    rdfs:label 'Target Region' ;
    rdfs:comment 'Broader geographic region classification of the target investment.' ;
    rdfs:domain ind:InvestmentMemo ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetSector rdf:type rdf:Property ;
    rdfs:label 'Target Sector' ;
    rdfs:comment 'Primary industry sector or vertical of the target company or asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationAmount rdf:type rdf:Property ;
    rdfs:label 'Valuation Amount' ;
    rdfs:comment 'Enterprise or asset valuation of the target at the proposed transaction price, in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dealEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Deal Employee Id' ;
    rdfs:comment 'Reference to the investment professional or deal team lead responsible for originating and presenting this opportunity to the IC.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:dealExternalAdvisorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Deal External Advisor Employee Id' ;
    rdfs:comment 'Reference to the external advisor, investment bank, or intermediary that originated or facilitated the deal opportunity, if applicable.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:feeBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Fee Benchmark Id' ;
    rdfs:comment 'Foreign key linking to fee.fee_benchmark. Business justification: Investment Committee approval process requires fee reasonableness assessment. IC members review proposed deal fees against market benchmarks to ensure fiduciary duty compliance and' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FeeBenchmark .

ind:gpManagerGpProfileId rdf:type rdf:Property ;
    rdfs:label 'Gp Manager Gp Profile Id' ;
    rdfs:comment 'Reference to the General Partner or external fund manager for fund commitments or co-investments.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:icGovernanceRecordId rdf:type rdf:Property ;
    rdfs:label 'Ic Governance Record Id' ;
    rdfs:comment 'Foreign key linking to compliance.ic_governance_record. Business justification: IC submissions must link to formal governance meeting records for audit trail and regulatory compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcGovernanceRecord .

ind:leadInvestmentProfessionalEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Investment Professional Employee Id' ;
    rdfs:comment 'Reference to the investment professional or deal team lead responsible for originating and presenting this opportunity to the IC.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:liabilityProjectionId rdf:type rdf:Property ;
    rdfs:label 'Liability Projection Id' ;
    rdfs:comment 'Foreign key linking to actuarial.liability_projection. Business justification: IC submissions must demonstrate liability alignment. Pension fund governance requires IC to review how proposed investments support liability matching.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LiabilityProjection .

ind:approvalConditions rdf:type rdf:Property ;
    rdfs:label 'Approval Conditions' ;
    rdfs:comment 'Text description of any conditions, covenants, or requirements attached to a conditional IC approval that must be satisfied before investment execution.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddCompletionStatus rdf:type rdf:Property ;
    rdfs:label 'Dd Completion Status' ;
    rdfs:comment 'Status of due diligence workstreams at the time of IC submission, indicating readiness for investment decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Expected Irr Percent' ;
    rdfs:comment 'Projected Internal Rate of Return for the investment as presented in the Investment Memorandum, expressed as a percentage.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedMoic rdf:type rdf:Property ;
    rdfs:label 'Expected Moic' ;
    rdfs:comment 'Projected Multiple on Invested Capital for the investment as presented in the Investment Memorandum.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icFeedback rdf:type rdf:Property ;
    rdfs:label 'Ic Feedback' ;
    rdfs:comment 'Free-text feedback, questions, or guidance provided by IC members during or after the review of this submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icType rdf:type rdf:Property ;
    rdfs:label 'Ic Type' ;
    rdfs:comment 'Type or level of IC review being requested: preliminary review, full committee approval, special session, emergency approval, or written consent.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentMemoVersion rdf:type rdf:Property ;
    rdfs:label 'Investment Memo Version' ;
    rdfs:comment 'Version identifier of the Investment Memorandum document submitted to the IC for this opportunity.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:presentationDocumentUri rdf:type rdf:Property ;
    rdfs:label 'Presentation Document Uri' ;
    rdfs:comment 'URI or file path reference to the IC presentation deck or Investment Memorandum document submitted for this opportunity.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rejectionRationale rdf:type rdf:Property ;
    rdfs:label 'Rejection Rationale' ;
    rdfs:comment 'Text description of the reasons and rationale provided by the IC for rejecting the investment submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:requestedCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Requested Commitment Amount' ;
    rdfs:comment 'Total investment commitment amount being requested for IC approval, expressed in the base currency.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:requestedCommitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Requested Commitment Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the requested commitment amount.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledIcMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Ic Meeting Date' ;
    rdfs:comment 'Date on which the IC meeting is scheduled to review and vote on this submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sponsoringDepartment rdf:type rdf:Property ;
    rdfs:label 'Sponsoring Department' ;
    rdfs:comment 'Internal department or investment team sponsoring the IC submission, such as Private Equity, Real Estate, or Infrastructure.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionNotes rdf:type rdf:Property ;
    rdfs:label 'Submission Notes' ;
    rdfs:comment 'Free-text notes or commentary from the deal team providing additional context, updates, or clarifications for the IC submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Submission Reference Number' ;
    rdfs:comment 'Business-facing unique reference number or code assigned to this IC submission for tracking and communication purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionStatus rdf:type rdf:Property ;
    rdfs:label 'Submission Status' ;
    rdfs:comment 'Current lifecycle status of the IC submission indicating its position in the approval workflow. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|conditional_approval|withdrawn|deferred — 8 candidates stripped; promote to reference' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supportingMaterialsUri rdf:type rdf:Property ;
    rdfs:label 'Supporting Materials Uri' ;
    rdfs:comment 'URI or file path reference to supporting materials, appendices, or due diligence reports accompanying the IC submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votingQuorumMet rdf:type rdf:Property ;
    rdfs:label 'Voting Quorum Met' ;
    rdfs:comment 'Boolean flag indicating whether the required quorum of IC members was present for a valid vote on this submission.' ;
    rdfs:domain ind:DealIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dealIcConditionId rdf:type rdf:Property ;
    rdfs:label 'Deal Ic Condition Id' ;
    rdfs:comment 'Unique identifier for the Investment Committee condition record. Primary key for the deal IC condition entity.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conditionCategory rdf:type rdf:Property ;
    rdfs:label 'Condition Category' ;
    rdfs:comment 'Functional category of the condition indicating which workstream or domain it pertains to for assignment and tracking purposes. [ENUM-REF-CANDIDATE: legal|financial|operational|esg|regulatory|commercial|technical — 7 candidates stripped; promote to' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionDescription rdf:type rdf:Property ;
    rdfs:label 'Condition Description' ;
    rdfs:comment 'Detailed narrative description of the condition requirement as documented in the IC approval resolution or investment memorandum.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionNotes rdf:type rdf:Property ;
    rdfs:label 'Condition Notes' ;
    rdfs:comment 'Additional notes, comments, or context regarding the condition, its interpretation, satisfaction progress, or any special circumstances.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionNumber rdf:type rdf:Property ;
    rdfs:label 'Condition Number' ;
    rdfs:comment 'Business-facing reference number or code assigned to this condition for tracking and communication purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionOwner rdf:type rdf:Property ;
    rdfs:label 'Condition Owner' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for ensuring the condition is satisfied and providing evidence of completion.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionRationale rdf:type rdf:Property ;
    rdfs:label 'Condition Rationale' ;
    rdfs:comment 'Business justification or risk mitigation rationale explaining why the IC imposed this condition on the investment approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionStatus rdf:type rdf:Property ;
    rdfs:label 'Condition Status' ;
    rdfs:comment 'Current lifecycle status of the condition indicating whether it remains outstanding, has been fulfilled, or has been waived by authorized parties.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionType rdf:type rdf:Property ;
    rdfs:label 'Condition Type' ;
    rdfs:comment 'Classification of the condition based on timing and enforceability. Pre-close must be satisfied before transaction closes, post-close after closing, ongoing covenant throughout holding period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationRequired rdf:type rdf:Property ;
    rdfs:label 'Escalation Required' ;
    rdfs:comment 'Indicator of whether the condition status or breach requires escalation to senior management or the Investment Committee for resolution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evidenceDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Evidence Document Reference' ;
    rdfs:comment 'Reference identifier or location of the documentation evidencing satisfaction of the condition, stored in data room or document management system.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icResolutionReference rdf:type rdf:Property ;
    rdfs:label 'Ic Resolution Reference' ;
    rdfs:comment 'Reference number or identifier of the formal IC resolution document that contains the condition language and approval terms.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:satisfactionDate rdf:type rdf:Property ;
    rdfs:label 'Satisfaction Date' ;
    rdfs:comment 'Actual date on which the condition was confirmed as satisfied and evidence was accepted by the responsible oversight function.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverAuthority rdf:type rdf:Property ;
    rdfs:label 'Waiver Authority' ;
    rdfs:comment 'Name or role of the individual or committee that authorized the waiver of this condition, ensuring proper governance and accountability.' ;
    rdfs:domain ind:DealIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverRationale rdf:type rdf:Property ;
    rdfs:label 'Waiver Rationale' ;
    rdfs:comment 'Business justification and risk assessment supporting the decision to waive the condition rather than require full satisfaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamId rdf:type rdf:Property ;
    rdfs:label 'Team Id' ;
    rdfs:comment 'Unique identifier for the deal_team data product (auto-inserted during validation).' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:teamApprovedByEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Team Approved By Employee Id' ;
    rdfs:comment 'Reference to the employee who approved this team assignment.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:teamEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Team Employee Id' ;
    rdfs:comment 'Reference to the employee or team member assigned to this deal.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:actualHours rdf:type rdf:Property ;
    rdfs:label 'Actual Hours' ;
    rdfs:comment 'Actual total hours the team member has spent on this deal to date.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:advisorEngagementType rdf:type rdf:Property ;
    rdfs:label 'Advisor Engagement Type' ;
    rdfs:comment 'Type of advisory engagement for external advisors: financial (financial due diligence), legal (legal counsel), technical (technical assessment), esg (ESG assessment), operational (operational due diligence), tax (tax advisory).' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationPercentage rdf:type rdf:Property ;
    rdfs:label 'Allocation Percentage' ;
    rdfs:comment 'Percentage of the team member\'s time allocated to this deal, expressed as a decimal (e.g., 25.00 for 25% allocation).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assignmentStartDate rdf:type rdf:Property ;
    rdfs:label 'Assignment Start Date' ;
    rdfs:comment 'Date when the team member was assigned to the deal.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conflictCheckDate rdf:type rdf:Property ;
    rdfs:label 'Conflict Check Date' ;
    rdfs:comment 'Date when the conflict of interest check was completed.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conflictCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Conflict Check Status' ;
    rdfs:comment 'Status of conflict of interest check for this team member on this deal: not_required (no check needed), pending (check in progress), cleared (no conflicts found), flagged (potential conflict identified).' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRoomAccessDate rdf:type rdf:Property ;
    rdfs:label 'Data Room Access Date' ;
    rdfs:comment 'Date when the team member was granted access to the deal data room.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataRoomAccessGranted rdf:type rdf:Property ;
    rdfs:label 'Data Room Access Granted' ;
    rdfs:comment 'Indicates whether the team member has been granted access to the deal data room. True if access granted, False otherwise.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedHours rdf:type rdf:Property ;
    rdfs:label 'Estimated Hours' ;
    rdfs:comment 'Estimated total hours the team member is expected to spend on this deal.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isIcPresenter rdf:type rdf:Property ;
    rdfs:label 'Is Ic Presenter' ;
    rdfs:comment 'Indicates whether this team member will present the Investment Memorandum (IM) to the Investment Committee (IC). True if presenter, False otherwise.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimaryContact rdf:type rdf:Property ;
    rdfs:label 'Is Primary Contact' ;
    rdfs:comment 'Indicates whether this team member is the primary point of contact for the deal. True if primary contact, False otherwise.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndaSignedDate rdf:type rdf:Property ;
    rdfs:label 'Nda Signed Date' ;
    rdfs:comment 'Date when the team member signed the Non-Disclosure Agreement (NDA) for this deal.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndaSignedFlag rdf:type rdf:Property ;
    rdfs:label 'Nda Signed Flag' ;
    rdfs:comment 'Indicates whether the team member has signed a Non-Disclosure Agreement (NDA) for this deal. True if signed, False otherwise.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:roleCode rdf:type rdf:Property ;
    rdfs:label 'Role Code' ;
    rdfs:comment 'Role of the team member on this deal: LEAD (deal lead or principal), ASSOCIATE (senior associate), ANALYST (junior analyst), LEGAL (legal counsel), ESG (ESG advisor), EXTERNAL (external advisor or consultant).' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleDescription rdf:type rdf:Property ;
    rdfs:label 'Role Description' ;
    rdfs:comment 'Detailed description of the team member\'s responsibilities and scope of work on this deal.' ;
    rdfs:domain ind:Team ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetClassFocus rdf:type rdf:Property ;
    rdfs:label 'Asset Class Focus' ;
    rdfs:comment 'Primary asset classes or sectors in which the origination source specializes, such as private equity, real estate, infrastructure, or credit. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityScope rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Scope' ;
    rdfs:comment 'Description of the scope of any exclusive arrangement, including asset classes, geographies, or deal size ranges covered.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeArrangementType rdf:type rdf:Property ;
    rdfs:label 'Fee Arrangement Type' ;
    rdfs:comment 'Type of fee or compensation arrangement with the origination source for deal introductions.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstDealDate rdf:type rdf:Property ;
    rdfs:label 'First Deal Date' ;
    rdfs:comment 'Date on which the first deal opportunity was received from this origination source.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isExclusive rdf:type rdf:Property ;
    rdfs:label 'Is Exclusive' ;
    rdfs:comment 'Indicates whether the origination source has an exclusive deal flow arrangement with the organization for specific sectors or geographies.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastDealDate rdf:type rdf:Property ;
    rdfs:label 'Last Deal Date' ;
    rdfs:comment 'Date on which the most recent deal opportunity was received from this origination source.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndaExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Nda Expiry Date' ;
    rdfs:comment 'Date on which the NDA with the origination source expires and requires renewal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:organizationAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Organization Address Line1' ;
    rdfs:comment 'First line of the origination source organization\'s registered or primary business address.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Organization Address Line2' ;
    rdfs:comment 'Second line of the origination source organization\'s address, including suite or floor details.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationCity rdf:type rdf:Property ;
    rdfs:label 'Organization City' ;
    rdfs:comment 'City or municipality of the origination source organization\'s primary address.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Organization Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the origination source organization\'s primary address.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationPostalCode rdf:type rdf:Property ;
    rdfs:label 'Organization Postal Code' ;
    rdfs:comment 'Postal or ZIP code of the origination source organization\'s primary address.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationStateProvince rdf:type rdf:Property ;
    rdfs:label 'Organization State Province' ;
    rdfs:comment 'State, province, or region of the origination source organization\'s primary address.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:partyType rdf:type rdf:Property ;
    rdfs:label 'Party Type' ;
    rdfs:comment 'Indicates whether the source is an individual contact, an organization, or an intermediary entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipTier rdf:type rdf:Property ;
    rdfs:label 'Relationship Tier' ;
    rdfs:comment 'Strategic importance tier of the origination source based on deal quality, volume, and historical performance.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryContactEmail rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Email' ;
    rdfs:comment 'Secondary email address for backup communication with the origination source.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryContactName rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Name' ;
    rdfs:comment 'Full name of the secondary or backup contact at the origination source for continuity of deal flow.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:secondaryContactPhone rdf:type rdf:Property ;
    rdfs:label 'Secondary Contact Phone' ;
    rdfs:comment 'Secondary telephone number for backup contact at the origination source.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceName rdf:type rdf:Property ;
    rdfs:label 'Source Name' ;
    rdfs:comment 'Full legal or trading name of the origination source party, intermediary, or contact organization.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:successRatePercent rdf:type rdf:Property ;
    rdfs:label 'Success Rate Percent' ;
    rdfs:comment 'Percentage of deals sourced by this origination source that resulted in closed investments, calculated as total deals closed divided by total deals sourced.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalDealsClosed rdf:type rdf:Property ;
    rdfs:label 'Total Deals Closed' ;
    rdfs:comment 'Cumulative count of deal opportunities from this origination source that resulted in executed investments.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalDealsSourced rdf:type rdf:Property ;
    rdfs:label 'Total Deals Sourced' ;
    rdfs:comment 'Cumulative count of deal opportunities introduced by this origination source since relationship inception.' ;
    rdfs:domain ind:OriginationSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coverageUniverseId rdf:type rdf:Property ;
    rdfs:label 'Coverage Universe Id' ;
    rdfs:comment 'Foreign key linking to research.coverage_universe. Business justification: Target entities under deal evaluation should link to research coverage when actively covered.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoverageUniverse .

ind:leiRecordId rdf:type rdf:Property ;
    rdfs:label 'Lei Record Id' ;
    rdfs:comment 'Foreign key linking to compliance.lei_record. Business justification: Target entities need LEI linkage for regulatory transaction reporting (EMIR, MiFID II). The lei attribute on target_entity is denormalized.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LeiRecord .

ind:sanctionsScreeningId rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Id' ;
    rdfs:comment 'Foreign key linking to compliance.sanctions_screening. Business justification: All investment targets must be screened against sanctions lists (OFAC, EU, UN) before capital deployment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SanctionsScreening .

ind:ebitdaAmount rdf:type rdf:Property ;
    rdfs:label 'Ebitda Amount' ;
    rdfs:comment 'EBITDA for the target entity in its most recent fiscal year, representing operating profitability before financing and non-cash charges.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaCurrency rdf:type rdf:Property ;
    rdfs:label 'Ebitda Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the currency in which the EBITDA amount is denominated.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:enterpriseValueAmount rdf:type rdf:Property ;
    rdfs:label 'Enterprise Value Amount' ;
    rdfs:comment 'Estimated or reported enterprise value of the target entity representing the total value of the business including debt and excluding cash.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:enterpriseValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Enterprise Value Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the currency in which the enterprise value amount is denominated.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrySubsector rdf:type rdf:Property ;
    rdfs:label 'Industry Subsector' ;
    rdfs:comment 'More granular industry subsector classification providing additional detail on the target entity\'s business focus.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isPubliclyListed rdf:type rdf:Property ;
    rdfs:label 'Is Publicly Listed' ;
    rdfs:comment 'Boolean flag indicating whether the target entity is publicly listed on a stock exchange.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:parentCompanyLei rdf:type rdf:Property ;
    rdfs:label 'Parent Company Lei' ;
    rdfs:comment 'Legal Entity Identifier of the parent company or ultimate beneficial owner of the target entity.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentCompanyName rdf:type rdf:Property ;
    rdfs:label 'Parent Company Name' ;
    rdfs:comment 'Legal name of the parent company or ultimate beneficial owner if the target entity is a subsidiary or controlled entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryBusinessDescription rdf:type rdf:Property ;
    rdfs:label 'Primary Business Description' ;
    rdfs:comment 'Detailed narrative description of the target entity\'s core business operations, products, services, and value proposition.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactTitle rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Title' ;
    rdfs:comment 'Job title or role of the primary contact person at the target entity.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetLegalName rdf:type rdf:Property ;
    rdfs:label 'Target Legal Name' ;
    rdfs:comment 'Full legal name of the target company, asset, fund, or investment vehicle as registered in its jurisdiction of incorporation.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetShortName rdf:type rdf:Property ;
    rdfs:label 'Target Short Name' ;
    rdfs:comment 'Abbreviated or commonly used name for the target entity used in internal communications and reporting.' ;
    rdfs:domain ind:TargetEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetStatus rdf:type rdf:Property ;
    rdfs:label 'Target Status' ;
    rdfs:comment 'Current lifecycle status of the target entity within the deal pipeline indicating whether it is actively being pursued, inactive, under review, archived, or has been merged or acquired.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetType rdf:type rdf:Property ;
    rdfs:label 'Target Type' ;
    rdfs:comment 'Classification of the target entity indicating whether it is an operating company, real asset, infrastructure asset, natural resource asset, fund, or co-investment vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealValuationId rdf:type rdf:Property ;
    rdfs:label 'Deal Valuation Id' ;
    rdfs:comment 'Unique identifier for the deal valuation record.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:discountRateCurveId rdf:type rdf:Property ;
    rdfs:label 'Discount Rate Curve Id' ;
    rdfs:comment 'Foreign key linking to actuarial.discount_rate_curve. Business justification: Deal valuations for pension investments should use liability-consistent discount rates. Actuarial discount curves ensure valuation consistency with ALM framework.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiscountRateCurve .

ind:reviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Employee Id' ;
    rdfs:comment 'Reference to the senior professional who reviewed and approved the valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:reviewerId rdf:type rdf:Property ;
    rdfs:label 'Reviewer Id' ;
    rdfs:comment 'Reference to the senior professional who reviewed and approved the valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByValuationDealValuationId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Valuation Deal Valuation Id' ;
    rdfs:comment 'Reference to the subsequent valuation that supersedes this record, if applicable.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealValuation .

ind:comparableCount rdf:type rdf:Property ;
    rdfs:label 'Comparable Count' ;
    rdfs:comment 'Number of comparable companies or precedent transactions used in the analysis.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:midpoint rdf:type rdf:Property ;
    rdfs:label 'Midpoint' ;
    rdfs:comment 'Midpoint of the valuation range, representing the central estimate.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelFilePath rdf:type rdf:Property ;
    rdfs:label 'Model File Path' ;
    rdfs:comment 'File path or document management system reference to the detailed valuation model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navPerShare rdf:type rdf:Property ;
    rdfs:label 'Nav Per Share' ;
    rdfs:comment 'Calculated net asset value per share for equity investments.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netDebt rdf:type rdf:Property ;
    rdfs:label 'Net Debt' ;
    rdfs:comment 'Net debt position of the target entity used to bridge enterprise value to equity value.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rangeHigh rdf:type rdf:Property ;
    rdfs:label 'Range High' ;
    rdfs:comment 'Upper bound of the valuation range estimate.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rangeLow rdf:type rdf:Property ;
    rdfs:label 'Range Low' ;
    rdfs:comment 'Lower bound of the valuation range estimate.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueMultiple rdf:type rdf:Property ;
    rdfs:label 'Revenue Multiple' ;
    rdfs:comment 'Revenue multiple applied in comparable company or precedent transaction analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewerName rdf:type rdf:Property ;
    rdfs:label 'Reviewer Name' ;
    rdfs:comment 'Name of the senior professional who reviewed and approved the valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetEbitda rdf:type rdf:Property ;
    rdfs:label 'Target Ebitda' ;
    rdfs:comment 'Target company EBITDA used as basis for multiple-based valuation.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetRevenue rdf:type rdf:Property ;
    rdfs:label 'Target Revenue' ;
    rdfs:comment 'Target company revenue used as basis for multiple-based valuation.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationNumber rdf:type rdf:Property ;
    rdfs:label 'Valuation Number' ;
    rdfs:comment 'Business identifier for this valuation record, used for tracking and reference.' ;
    rdfs:domain ind:DealValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Valuation Timestamp' ;
    rdfs:comment 'Precise timestamp when the valuation was completed or submitted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:dealPortfolioManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Deal Portfolio Manager Employee Id' ;
    rdfs:comment 'Identifier for the portfolio manager responsible for overseeing this commitment within the broader portfolio.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:commitmentExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Commitment Expiry Date' ;
    rdfs:comment 'Date after which the capital commitment expires if not drawn or legally executed.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:commitmentName rdf:type rdf:Property ;
    rdfs:label 'Commitment Name' ;
    rdfs:comment 'Descriptive name for the capital commitment, typically referencing the target entity and commitment type.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dryPowderAllocation rdf:type rdf:Property ;
    rdfs:label 'Dry Powder Allocation' ;
    rdfs:comment 'Amount of uncalled committed capital (dry powder) reserved for this commitment at approval.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedFinalCloseDate rdf:type rdf:Property ;
    rdfs:label 'Expected Final Close Date' ;
    rdfs:comment 'Expected date by which the investment will reach final close and the commitment becomes legally binding.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedFirstDrawdownDate rdf:type rdf:Property ;
    rdfs:label 'Expected First Drawdown Date' ;
    rdfs:comment 'Anticipated date for the first capital call or drawdown against this commitment.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expectedInvestmentPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Expected Investment Period Years' ;
    rdfs:comment 'Expected duration in years over which the committed capital will be deployed.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fxRateAtApproval rdf:type rdf:Property ;
    rdfs:label 'Fx Rate At Approval' ;
    rdfs:comment 'Exchange rate used to convert commitment amount to base currency at the time of IC approval.' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icDecisionOutcome rdf:type rdf:Property ;
    rdfs:label 'Ic Decision Outcome' ;
    rdfs:comment 'Final decision outcome from the Investment Committee: approved, approved with conditions, deferred, or rejected.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaSignedFlag rdf:type rdf:Property ;
    rdfs:label 'Lpa Signed Flag' ;
    rdfs:comment 'Indicates whether the Limited Partnership Agreement has been executed (True if signed, False otherwise).' ;
    rdfs:domain ind:DealCapitalCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Target Jurisdiction' ;
    rdfs:comment 'Three-letter ISO country code for the primary jurisdiction of the target entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppmReviewId rdf:type rdf:Property ;
    rdfs:label 'Ppm Review Id' ;
    rdfs:comment 'Unique identifier for the PPM review record. Primary key.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgPolicySummary rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Summary' ;
    rdfs:comment 'Summary of the funds ESG policy, responsible investment approach, and sustainability commitments as disclosed in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpActions rdf:type rdf:Property ;
    rdfs:label 'Follow Up Actions' ;
    rdfs:comment 'List of follow-up actions, additional diligence items, or clarifications required before proceeding.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundAssetClass rdf:type rdf:Property ;
    rdfs:label 'Fund Asset Class' ;
    rdfs:comment 'Primary asset class focus of the fund being reviewed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundVintageYear rdf:type rdf:Property ;
    rdfs:label 'Fund Vintage Year' ;
    rdfs:comment 'Vintage year of the fund, representing the year of first capital commitment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gpAumAmount rdf:type rdf:Property ;
    rdfs:label 'Gp Aum Amount' ;
    rdfs:comment 'Total assets under management by the GP as disclosed in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpAumCurrency rdf:type rdf:Property ;
    rdfs:label 'Gp Aum Currency' ;
    rdfs:comment 'Currency code for the GP assets under management amount.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpPriorFundCount rdf:type rdf:Property ;
    rdfs:label 'Gp Prior Fund Count' ;
    rdfs:comment 'Number of prior funds managed by the GP as disclosed in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gpTrackRecordAssessment rdf:type rdf:Property ;
    rdfs:label 'Gp Track Record Assessment' ;
    rdfs:comment 'Qualitative assessment of the GPs historical performance and track record based on PPM disclosures and external research.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentRestrictions rdf:type rdf:Property ;
    rdfs:label 'Investment Restrictions' ;
    rdfs:comment 'Summary of investment restrictions, concentration limits, and prohibited activities specified in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyPersonProvisions rdf:type rdf:Property ;
    rdfs:label 'Key Person Provisions' ;
    rdfs:comment 'Summary of key person provisions and conditions outlined in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Commitment Amount' ;
    rdfs:comment 'Minimum investment commitment required from Limited Partners as specified in the PPM.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCommitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Minimum Commitment Currency' ;
    rdfs:comment 'Currency code for the minimum commitment amount.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ppmDocumentDate rdf:type rdf:Property ;
    rdfs:label 'Ppm Document Date' ;
    rdfs:comment 'Issuance or effective date of the PPM document under review.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ppmDocumentVersion rdf:type rdf:Property ;
    rdfs:label 'Ppm Document Version' ;
    rdfs:comment 'Version identifier of the Private Placement Memorandum document being reviewed.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendationRationale rdf:type rdf:Property ;
    rdfs:label 'Recommendation Rationale' ;
    rdfs:comment 'Detailed rationale supporting the reviewers recommendation, including key strengths and concerns.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redFlagsIdentified rdf:type rdf:Property ;
    rdfs:label 'Red Flags Identified' ;
    rdfs:comment 'Summary of any red flags, concerns, or material issues identified during the PPM review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCode rdf:type rdf:Property ;
    rdfs:label 'Review Code' ;
    rdfs:comment 'Business identifier for the PPM review, typically combining opportunity code and review sequence.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewCompletedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Completed Timestamp' ;
    rdfs:comment 'Timestamp when the PPM review was completed and findings finalized.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewDate rdf:type rdf:Property ;
    rdfs:label 'Review Date' ;
    rdfs:comment 'Date when the PPM review was conducted or completed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewInitiatedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Review Initiated Timestamp' ;
    rdfs:comment 'Timestamp when the PPM review process was formally initiated.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:reviewTeam rdf:type rdf:Property ;
    rdfs:label 'Review Team' ;
    rdfs:comment 'Name or identifier of the investment team responsible for the PPM review.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetFundSizeCurrency rdf:type rdf:Property ;
    rdfs:label 'Target Fund Size Currency' ;
    rdfs:comment 'Currency code for the target fund size amount.' ;
    rdfs:domain ind:PpmReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningDecisionId rdf:type rdf:Property ;
    rdfs:label 'Screening Decision Id' ;
    rdfs:comment 'Unique identifier for the screening decision record. Primary key for the screening decision entity.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Reviewer Employee Id' ;
    rdfs:comment 'Reference to the investment professional who led the screening analysis and presented to the committee. Primary deal sponsor.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:screeningEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Screening Employee Id' ;
    rdfs:comment 'Reference to the individual who chaired the screening committee meeting. Senior investment professional responsible for decision governance.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:screeningLeadReviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Screening Lead Reviewer Employee Id' ;
    rdfs:comment 'Reference to the investment professional who led the screening analysis and presented to the committee. Primary deal sponsor.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:committeeChairName rdf:type rdf:Property ;
    rdfs:label 'Committee Chair Name' ;
    rdfs:comment 'Full name of the committee chair who presided over the screening decision. Denormalized for reporting convenience.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeMemberCount rdf:type rdf:Property ;
    rdfs:label 'Committee Member Count' ;
    rdfs:comment 'Number of committee members present at the screening review. Used to validate quorum requirements.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:declineReasonCode rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Code' ;
    rdfs:comment 'Standardized code categorizing the primary reason for declining the opportunity. Used for pipeline analytics and sourcing strategy refinement.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declineReasonDescription rdf:type rdf:Property ;
    rdfs:label 'Decline Reason Description' ;
    rdfs:comment 'Detailed explanation of why the opportunity was declined. Captures investment thesis misalignment, valuation concerns, risk factors, or strategic fit issues.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:holdReason rdf:type rdf:Property ;
    rdfs:label 'Hold Reason' ;
    rdfs:comment 'Explanation for placing the opportunity on hold. Identifies missing information, pending external events, or conditions that must be satisfied before proceeding.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadReviewerName rdf:type rdf:Property ;
    rdfs:label 'Lead Reviewer Name' ;
    rdfs:comment 'Full name of the lead investment professional who conducted the screening review. Denormalized for reporting convenience.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Concern Flag' ;
    rdfs:comment 'Indicates whether legal or regulatory concerns were identified during screening. True if material legal risks require further assessment.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetingReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Meeting Reference Number' ;
    rdfs:comment 'Reference identifier for the committee meeting where the screening decision was made. Links to Investment Committee (IC) meeting minutes.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Operational Concern Flag' ;
    rdfs:comment 'Indicates whether operational due diligence (ODD) concerns were identified. True if material operational risks require further investigation.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:quorumMet rdf:type rdf:Property ;
    rdfs:label 'Quorum Met' ;
    rdfs:comment 'Indicates whether the required quorum of committee members was present for the screening decision. True if quorum requirements were satisfied.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:screeningCommitteeName rdf:type rdf:Property ;
    rdfs:label 'Screening Committee Name' ;
    rdfs:comment 'Name of the committee or review body that made the screening decision. May be asset class-specific committee or central Investment Committee (IC).' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningDate rdf:type rdf:Property ;
    rdfs:label 'Screening Date' ;
    rdfs:comment 'Date when the screening decision was formally made. Principal business event timestamp for the screening review.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningNotes rdf:type rdf:Property ;
    rdfs:label 'Screening Notes' ;
    rdfs:comment 'Free-text notes and commentary from the screening committee. Captures key discussion points, concerns raised, and rationale for the decision.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningNumber rdf:type rdf:Property ;
    rdfs:label 'Screening Number' ;
    rdfs:comment 'Business identifier for the screening decision. Human-readable reference number used in Investment Committee (IC) documentation and pipeline tracking.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningTimestamp rdf:type rdf:Property ;
    rdfs:label 'Screening Timestamp' ;
    rdfs:comment 'Precise timestamp when the screening decision was recorded in the system. Captures exact moment of decision finalization.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:screeningType rdf:type rdf:Property ;
    rdfs:label 'Screening Type' ;
    rdfs:comment 'Classification of the screening review. Initial screening is preliminary assessment; full screening is comprehensive due diligence (DD) gate review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unanimousDecision rdf:type rdf:Property ;
    rdfs:label 'Unanimous Decision' ;
    rdfs:comment 'Indicates whether the screening decision was unanimous. True if all voting members agreed on the outcome.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:valuationConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Valuation Concern Flag' ;
    rdfs:comment 'Indicates whether the screening committee identified material valuation concerns. True if pricing appears misaligned with intrinsic value or market comparables.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:voteAbstainCount rdf:type rdf:Property ;
    rdfs:label 'Vote Abstain Count' ;
    rdfs:comment 'Number of committee members who abstained from voting. Typically due to conflict of interest or insufficient information.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voteAgainstCount rdf:type rdf:Property ;
    rdfs:label 'Vote Against Count' ;
    rdfs:comment 'Number of committee members who voted against proceeding with the opportunity. Used for governance audit trail.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:voteForCount rdf:type rdf:Property ;
    rdfs:label 'Vote For Count' ;
    rdfs:comment 'Number of committee members who voted in favor of proceeding with the opportunity. Used for governance audit trail.' ;
    rdfs:domain ind:ScreeningDecision ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dealDocumentId rdf:type rdf:Property ;
    rdfs:label 'Deal Document Id' ;
    rdfs:comment 'Unique identifier for the deal document record. Primary key.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner User Employee Id' ;
    rdfs:comment 'Identifier of the internal user responsible for managing and maintaining this document.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:supersededByDocumentDealDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Document Deal Document Id' ;
    rdfs:comment 'Reference to the newer document that supersedes this document, if applicable.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DealDocument .

ind:accessRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Access Restriction Flag' ;
    rdfs:comment 'Indicates whether access to this document is restricted to specific users or roles.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:approvedByUserName rdf:type rdf:Property ;
    rdfs:label 'Approved By User Name' ;
    rdfs:comment 'Full name of the user who approved the document.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:authorName rdf:type rdf:Property ;
    rdfs:label 'Author Name' ;
    rdfs:comment 'Name of the individual or organization that authored or prepared the document.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealStageCode rdf:type rdf:Property ;
    rdfs:label 'Deal Stage Code' ;
    rdfs:comment 'Code representing the deal pipeline stage at which this document was created or uploaded.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalSignatoryName rdf:type rdf:Property ;
    rdfs:label 'External Signatory Name' ;
    rdfs:comment 'Name of the external counterparty representative who signed the document.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalSignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'External Signatory Title' ;
    rdfs:comment 'Job title or role of the external signatory.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileName rdf:type rdf:Property ;
    rdfs:label 'File Name' ;
    rdfs:comment 'Original file name of the uploaded document including file extension.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fileSizeBytes rdf:type rdf:Property ;
    rdfs:label 'File Size Bytes' ;
    rdfs:comment 'Size of the document file in bytes for storage and retrieval tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:hash rdf:type rdf:Property ;
    rdfs:label 'Hash' ;
    rdfs:comment 'Cryptographic hash (e.g., SHA-256) of the document file to ensure integrity and detect tampering.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalCounselFirm rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Firm' ;
    rdfs:comment 'Name of the external legal counsel firm that reviewed or advised on this document, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Legal Review Required Flag' ;
    rdfs:comment 'Indicates whether this document requires review by internal or external legal counsel.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ownerUserName rdf:type rdf:Property ;
    rdfs:label 'Owner User Name' ;
    rdfs:comment 'Full name of the internal user who owns this document.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:storageLocation rdf:type rdf:Property ;
    rdfs:label 'Storage Location' ;
    rdfs:comment 'Physical or logical storage path where the document is stored (e.g., cloud storage URI, file share path, data room location).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeCode rdf:type rdf:Property ;
    rdfs:label 'Type Code' ;
    rdfs:comment 'Categorical code classifying the document type: Non-Disclosure Agreement (NDA), Letter of Intent (LOI), Term Sheet, Investment Memorandum (IM), Private Placement Memorandum (PPM), Financial Model, Legal Opinion, Management Presentation, Data Room Index' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typeName rdf:type rdf:Property ;
    rdfs:label 'Type Name' ;
    rdfs:comment 'Human-readable name of the document type for display and reporting purposes.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uploadDate rdf:type rdf:Property ;
    rdfs:label 'Upload Date' ;
    rdfs:comment 'Date when the document was uploaded into the deal pipeline system.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:uploadTimestamp rdf:type rdf:Property ;
    rdfs:label 'Upload Timestamp' ;
    rdfs:comment 'Precise timestamp when the document was uploaded into the system, including time zone information.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:uploadedByUserName rdf:type rdf:Property ;
    rdfs:label 'Uploaded By User Name' ;
    rdfs:comment 'Full name of the internal user who uploaded the document.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:versionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Version Sequence Number' ;
    rdfs:comment 'Numeric sequence number indicating the version order for sorting and comparison purposes.' ;
    rdfs:domain ind:DealDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:exclusivityAgreementId rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Agreement Id' ;
    rdfs:comment 'Unique identifier for the exclusivity agreement record. Primary key.' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arbitrationVenue rdf:type rdf:Property ;
    rdfs:label 'Arbitration Venue' ;
    rdfs:comment 'City or institution designated for arbitration proceedings if arbitration is the chosen dispute resolution mechanism (e.g., London, New York, ICC Paris).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breakFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Break Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the break fee amount (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositCurrency rdf:type rdf:Property ;
    rdfs:label 'Deposit Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the exclusivity deposit amount.' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depositRefundableFlag rdf:type rdf:Property ;
    rdfs:label 'Deposit Refundable Flag' ;
    rdfs:comment 'Indicates whether the exclusivity deposit is refundable to the buyer if the deal does not close (true) or is forfeited to the seller (false).' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the exclusivity agreement: draft (under negotiation), executed (signed), active (in force), expired (period ended), terminated (ended early), or breached (violated).' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extensionCount rdf:type rdf:Property ;
    rdfs:label 'Extension Count' ;
    rdfs:comment 'Number of times the exclusivity period has been extended beyond the original expiry date.' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extensionPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Permitted Flag' ;
    rdfs:comment 'Indicates whether the exclusivity period may be extended by mutual agreement or under predefined conditions (true) or is fixed with no extension provision (false).' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fiduciaryOutClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Fiduciary Out Clause Flag' ;
    rdfs:comment 'Indicates whether the agreement includes a fiduciary out clause allowing the counterparty to consider superior proposals if required by fiduciary duty to shareholders or beneficiaries.' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:noShopProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'No Shop Provision Flag' ;
    rdfs:comment 'Indicates whether the agreement includes a no-shop provision prohibiting the counterparty from actively soliciting or entertaining competing offers during the exclusivity period.' ;
    rdfs:domain ind:ExclusivityAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:scopeDescription rdf:type rdf:Property ;
    rdfs:label 'Scope Description' ;
    rdfs:comment 'Detailed narrative describing the scope and boundaries of the exclusivity arrangement, including any carve-outs, permitted actions, or restrictions on counterparty behavior.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneId rdf:type rdf:Property ;
    rdfs:label 'Milestone Id' ;
    rdfs:comment 'Unique identifier for the deal_milestone data product (auto-inserted during validation).' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Completed By User Employee Id' ;
    rdfs:comment 'System identifier of the user who marked this milestone as completed.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:conditionsMet rdf:type rdf:Property ;
    rdfs:label 'Conditions Met' ;
    rdfs:comment 'Flag indicating whether all conditions precedent for this milestone have been satisfied.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentExecutionDate rdf:type rdf:Property ;
    rdfs:label 'Document Execution Date' ;
    rdfs:comment 'Date when the associated legal or business document was formally executed by all parties.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:esgReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Esg Review Status' ;
    rdfs:comment 'Current status of the Environmental, Social, and Governance due diligence review for this milestone.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gateDecision rdf:type rdf:Property ;
    rdfs:label 'Gate Decision' ;
    rdfs:comment 'Decision outcome for gate milestones requiring formal approval or go/no-go determination.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCriticalPath rdf:type rdf:Property ;
    rdfs:label 'Is Critical Path' ;
    rdfs:comment 'Flag indicating whether this milestone is on the critical path for deal closure.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isGateMilestone rdf:type rdf:Property ;
    rdfs:label 'Is Gate Milestone' ;
    rdfs:comment 'Flag indicating whether this milestone represents a formal approval gate requiring Investment Committee (IC) or governance decision.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:milestoneTimestamp rdf:type rdf:Property ;
    rdfs:label 'Milestone Timestamp' ;
    rdfs:comment 'Precise timestamp when the milestone event occurred for audit trail and sequencing.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatoryApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required' ;
    rdfs:comment 'Flag indicating whether regulatory or governmental approval is required to complete this milestone.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulatory Jurisdiction' ;
    rdfs:comment 'Jurisdiction or regulatory body whose approval is required for this milestone such as the national pension regulator, Securities and Exchange Commission (SEC), or Financial Conduct Authority (FCA).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Date' ;
    rdfs:comment 'Planned or target date for achieving this milestone as per deal execution plan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sequence rdf:type rdf:Property ;
    rdfs:label 'Sequence' ;
    rdfs:comment 'Ordinal position of this milestone within the deal execution timeline for chronological ordering.' ;
    rdfs:domain ind:Milestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coInvestAllocationId rdf:type rdf:Property ;
    rdfs:label 'Co Invest Allocation Id' ;
    rdfs:comment 'Unique identifier for the co-investment allocation record.' ;
    rdfs:domain ind:Deal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoInvestAllocation .

ind:relationshipManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Relationship Manager Employee Id' ;
    rdfs:comment 'Foreign key linking to shared.employee. Business justification: Co-investment relationship management requires tracking assigned employee for LP/co-investor communications and reporting. New FK replaces denormalized relationship_manager_name.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:allocatedAmount rdf:type rdf:Property ;
    rdfs:label 'Allocated Amount' ;
    rdfs:comment 'The monetary amount of co-investment capital allocated to or accepted by the co-investor for this opportunity.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allocationAcceptanceDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Acceptance Date' ;
    rdfs:comment 'Date on which the co-investor formally accepted the co-investment allocation offer.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationCommitmentDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Commitment Date' ;
    rdfs:comment 'Date on which the co-investor legally committed capital to the co-investment, typically via signed commitment letter or Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Expiry Date' ;
    rdfs:comment 'Date by which the co-investor must accept the allocation offer, after which the offer becomes void.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationFundingDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Funding Date' ;
    rdfs:comment 'Date on which the co-investor transferred funds to fulfill their co-investment allocation.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationNotes rdf:type rdf:Property ;
    rdfs:label 'Allocation Notes' ;
    rdfs:comment 'Free-text field for additional context, special terms, conditions, or internal commentary related to this co-investment allocation.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationOfferDate rdf:type rdf:Property ;
    rdfs:label 'Allocation Offer Date' ;
    rdfs:comment 'Date on which the co-investment opportunity was formally offered to the co-investor.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:allocationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Allocation Reference Number' ;
    rdfs:comment 'Externally-known unique reference number for this co-investment allocation, used in communications with co-investors and internal tracking.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestorEntityName rdf:type rdf:Property ;
    rdfs:label 'Co Investor Entity Name' ;
    rdfs:comment 'Full legal name of the co-investing entity or institution participating in this allocation.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestorJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Co Investor Jurisdiction' ;
    rdfs:comment 'Three-letter ISO country code representing the legal jurisdiction of the co-investor entity.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestorLei rdf:type rdf:Property ;
    rdfs:label 'Co Investor Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the co-investing party, enabling global counterparty identification.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestorType rdf:type rdf:Property ;
    rdfs:label 'Co Investor Type' ;
    rdfs:comment 'Classification of the co-investor by institutional type, reflecting their investment mandate and regulatory framework.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeArrangement rdf:type rdf:Property ;
    rdfs:label 'Fee Arrangement' ;
    rdfs:comment 'Classification of the fee structure applied to this co-investment allocation, indicating whether management fees, carried interest, or both are charged.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycAmlStatus rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Status' ;
    rdfs:comment 'Current status of KYC and AML due diligence and compliance checks for the co-investor entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Lpa Reference Number' ;
    rdfs:comment 'Reference number for the Limited Partnership Agreement or co-investment agreement governing this allocation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sideLetterReference rdf:type rdf:Property ;
    rdfs:label 'Side Letter Reference' ;
    rdfs:comment 'Reference number or document identifier for the side letter agreement, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionAgreementReference rdf:type rdf:Property ;
    rdfs:label 'Subscription Agreement Reference' ;
    rdfs:comment 'Reference number for the subscription agreement executed by the co-investor to formalize their capital commitment.' ;
    rdfs:domain ind:CoInvestAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealFeeId rdf:type rdf:Property ;
    rdfs:label 'Deal Fee Id' ;
    rdfs:comment 'Unique identifier for the deal fee transaction record.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rateScheduleId rdf:type rdf:Property ;
    rdfs:label 'Rate Schedule Id' ;
    rdfs:comment 'Foreign key linking to fee.rate_schedule. Business justification: Deal fee calculations require standardized rate structures per LPA terms. Investment professionals reference rate_schedule when negotiating/validating advisor fees, ensuring consistency' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RateSchedule .

ind:amountUsd rdf:type rdf:Property ;
    rdfs:label 'Amount Usd' ;
    rdfs:comment 'Fee amount converted to USD using the applicable exchange rate for consolidated reporting and analysis.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:basis rdf:type rdf:Property ;
    rdfs:label 'Basis' ;
    rdfs:comment 'Methodology or structure used to calculate the fee amount such as fixed amount or percentage of transaction value.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Calculation Base Amount' ;
    rdfs:comment 'The underlying transaction value or asset amount upon which percentage-based fees are calculated.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dealStage rdf:type rdf:Property ;
    rdfs:label 'Deal Stage' ;
    rdfs:comment 'Pipeline stage or phase of the deal at which this fee was incurred such as due diligence or closing.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementLetterReference rdf:type rdf:Property ;
    rdfs:label 'Engagement Letter Reference' ;
    rdfs:comment 'Reference number or identifier of the engagement letter or service agreement governing this fee arrangement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCategory rdf:type rdf:Property ;
    rdfs:label 'Fee Category' ;
    rdfs:comment 'High-level grouping of the fee for financial reporting and cost allocation purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Status' ;
    rdfs:comment 'Current lifecycle status of the fee transaction indicating its progression from estimation through payment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeType rdf:type rdf:Property ;
    rdfs:label 'Fee Type' ;
    rdfs:comment 'Classification of the fee based on the service or purpose it represents during deal origination and execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceDueDate rdf:type rdf:Property ;
    rdfs:label 'Invoice Due Date' ;
    rdfs:comment 'Date by which payment of the invoiced fee amount is contractually due to the service provider.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isCapitalizable rdf:type rdf:Property ;
    rdfs:label 'Is Capitalizable' ;
    rdfs:comment 'Indicates whether this fee is eligible to be capitalized as part of the investment cost basis per accounting standards.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isReimbursable rdf:type rdf:Property ;
    rdfs:label 'Is Reimbursable' ;
    rdfs:comment 'Indicates whether this fee is eligible for reimbursement from a co-investor or counterparty per transaction agreements.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reimbursementAmount rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Amount' ;
    rdfs:comment 'Portion of the fee amount that has been or will be reimbursed by a co-investor or counterparty.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reimbursementDate rdf:type rdf:Property ;
    rdfs:label 'Reimbursement Date' ;
    rdfs:comment 'Date on which the reimbursement amount was received from the co-investor or counterparty.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:serviceDescription rdf:type rdf:Property ;
    rdfs:label 'Service Description' ;
    rdfs:comment 'Detailed description of the professional service or advisory work performed for which this fee is charged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceProviderLei rdf:type rdf:Property ;
    rdfs:label 'Service Provider Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the service provider enabling global counterparty identification.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceProviderName rdf:type rdf:Property ;
    rdfs:label 'Service Provider Name' ;
    rdfs:comment 'Legal name of the external firm or advisor providing the service for which this fee is charged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceProviderType rdf:type rdf:Property ;
    rdfs:label 'Service Provider Type' ;
    rdfs:comment 'Classification of the service provider based on their professional specialty and role in the transaction.' ;
    rdfs:domain ind:DealFee ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealContactId rdf:type rdf:Property ;
    rdfs:label 'Deal Contact Id' ;
    rdfs:comment 'Unique identifier for the deal contact record. Primary key.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:conflictOfInterestFlag rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Flag' ;
    rdfs:comment 'Indicates whether a potential conflict of interest has been identified with this contact.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contactRole rdf:type rdf:Property ;
    rdfs:label 'Contact Role' ;
    rdfs:comment 'Specific role or title of the contact within their organization (e.g., Managing Director, Chief Executive Officer, Partner, General Counsel).' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:decisionMakerFlag rdf:type rdf:Property ;
    rdfs:label 'Decision Maker Flag' ;
    rdfs:comment 'Indicates whether this contact has decision-making authority for the deal.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:firstContactDate rdf:type rdf:Property ;
    rdfs:label 'First Contact Date' ;
    rdfs:comment 'Date when initial contact was established with this person for the deal opportunity.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstName rdf:type rdf:Property ;
    rdfs:label 'First Name' ;
    rdfs:comment 'First name of the contact person.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastContactDate rdf:type rdf:Property ;
    rdfs:label 'Last Contact Date' ;
    rdfs:comment 'Date of the most recent interaction with this contact.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastName rdf:type rdf:Property ;
    rdfs:label 'Last Name' ;
    rdfs:comment 'Last name of the contact person.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linkedinProfileUrl rdf:type rdf:Property ;
    rdfs:label 'Linkedin Profile Url' ;
    rdfs:comment 'URL to the contact\'s LinkedIn profile for professional background verification.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobileNumber rdf:type rdf:Property ;
    rdfs:label 'Mobile Number' ;
    rdfs:comment 'Mobile phone number for the contact.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaSignatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Nda Signatory Flag' ;
    rdfs:comment 'Indicates whether this contact is an authorized signatory for NDA execution.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:officeAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Office Address Line1' ;
    rdfs:comment 'First line of the contact\'s office address.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Office Address Line2' ;
    rdfs:comment 'Second line of the contact\'s office address.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeCity rdf:type rdf:Property ;
    rdfs:label 'Office City' ;
    rdfs:comment 'City of the contact\'s office location.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeCountryCode rdf:type rdf:Property ;
    rdfs:label 'Office Country Code' ;
    rdfs:comment 'Three-letter ISO country code for the contact\'s office location.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officePostalCode rdf:type rdf:Property ;
    rdfs:label 'Office Postal Code' ;
    rdfs:comment 'Postal code of the contact\'s office location.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeStateProvince rdf:type rdf:Property ;
    rdfs:label 'Office State Province' ;
    rdfs:comment 'State or province of the contact\'s office location.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationLei rdf:type rdf:Property ;
    rdfs:label 'Organization Lei' ;
    rdfs:comment 'Legal Entity Identifier for the contact\'s organization.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationName rdf:type rdf:Property ;
    rdfs:label 'Organization Name' ;
    rdfs:comment 'Name of the organization or firm the contact represents.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:organizationType rdf:type rdf:Property ;
    rdfs:label 'Organization Type' ;
    rdfs:comment 'Type of organization the contact represents (investment bank, advisory firm, law firm, GP sponsor, intermediary, or broker-dealer).' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryContactFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Contact Flag' ;
    rdfs:comment 'Indicates whether this is the primary contact for the deal opportunity.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:professionalBiography rdf:type rdf:Property ;
    rdfs:label 'Professional Biography' ;
    rdfs:comment 'Brief professional biography or background summary of the contact.' ;
    rdfs:domain ind:DealContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:specializationArea rdf:type rdf:Property ;
    rdfs:label 'Specialization Area' ;
    rdfs:comment 'Area of specialization or expertise (e.g., private equity, real estate, infrastructure, mergers and acquisitions).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsOfExperience rdf:type rdf:Property ;
    rdfs:label 'Years Of Experience' ;
    rdfs:comment 'Number of years of professional experience in the relevant industry or role.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dealCheckId rdf:type rdf:Property ;
    rdfs:label 'Deal Check Id' ;
    rdfs:comment 'Primary key for the check association' ;
    rdfs:domain ind:DealCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ruleId rdf:type rdf:Property ;
    rdfs:label 'Rule Id' ;
    rdfs:comment 'Foreign key linking to the compliance rule being evaluated against the opportunity' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rule .

ind:dealCheckDate rdf:type rdf:Property ;
    rdfs:label 'Deal Check Date' ;
    rdfs:comment 'Date when the compliance check was performed against the opportunity.' ;
    rdfs:domain ind:DealCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dealCheckStatus rdf:type rdf:Property ;
    rdfs:label 'Deal Check Status' ;
    rdfs:comment 'Outcome of the compliance check indicating whether the opportunity passed, failed, is pending review, received an exception, or the rule was not applicable.' ;
    rdfs:domain ind:DealCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionFlag rdf:type rdf:Property ;
    rdfs:label 'Exception Flag' ;
    rdfs:comment 'Indicates whether an exception to the compliance rule was granted for this opportunity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ddEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Dd Employee Id' ;
    rdfs:comment 'Internal employee identifier for the primary analyst responsible for coordinating and executing the DD engagement. Sourced from SAP SuccessFactors HR system.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:ddIcSponsorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Dd Ic Sponsor Employee Id' ;
    rdfs:comment 'Internal employee identifier for the senior investment professional sponsoring this DD engagement at the Investment Committee level. Sourced from Diligent/BoardEffect.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:icSponsorEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Ic Sponsor Employee Id' ;
    rdfs:comment 'Internal employee identifier for the senior investment professional sponsoring this DD engagement at the Investment Committee level. Sourced from Diligent/BoardEffect.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:managerGpProfileId rdf:type rdf:Property ;
    rdfs:label 'Manager Gp Profile Id' ;
    rdfs:comment 'Reference to the external fund manager record in the manager domain when the DD engagement is a manager-level ODD or mandate review. Null for direct investment engagements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:priorEngagementDdEngagementId rdf:type rdf:Property ;
    rdfs:label 'Prior Engagement Dd Engagement Id' ;
    rdfs:comment 'Reference to the previous DD engagement record for the same target entity when this is a repeat or re-underwriting engagement. Enables longitudinal DD history tracking.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdEngagement .

ind:cddRating rdf:type rdf:Property ;
    rdfs:label 'Cdd Rating' ;
    rdfs:comment 'Outcome rating for the Commercial Due Diligence workstream evaluating market position, competitive dynamics, revenue quality, and business model sustainability.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRoomLocation rdf:type rdf:Property ;
    rdfs:label 'Data Room Location' ;
    rdfs:comment 'URL or system reference to the virtual data room (VDR) where confidential DD documents, financial statements, and legal materials are stored for this engagement.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddType rdf:type rdf:Property ;
    rdfs:label 'Dd Type' ;
    rdfs:comment 'Classification of the due diligence engagement by discipline: ODD (Operational), FDD (Financial), CDD (Commercial), Legal, ESG, or Combined multi-workstream engagement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementName rdf:type rdf:Property ;
    rdfs:label 'Engagement Name' ;
    rdfs:comment 'Descriptive name for the DD engagement, typically referencing the target entity and DD type (e.g., \'Acme Infrastructure Fund IV - ODD 2024\'). Used for display and search.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementPriority rdf:type rdf:Property ;
    rdfs:label 'Engagement Priority' ;
    rdfs:comment 'Business priority level assigned to the DD engagement reflecting deal urgency, strategic importance, and resource allocation. Drives analyst bandwidth and timeline management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementReference rdf:type rdf:Property ;
    rdfs:label 'Engagement Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to the DD engagement at initiation (e.g., DD-2024-00123). Used for cross-system tracking in eFront and Dealpath/DealCloud.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementScope rdf:type rdf:Property ;
    rdfs:label 'Engagement Scope' ;
    rdfs:comment 'Narrative description of the defined scope, boundaries, and objectives of the DD engagement including specific workstreams, geographic coverage, and exclusions agreed at initiation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgDdRating rdf:type rdf:Property ;
    rdfs:label 'Esg Dd Rating' ;
    rdfs:comment 'Outcome rating for the ESG Due Diligence workstream assessing environmental risks, social practices, and governance quality per PRI and TCFD frameworks.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgMaterialIssues rdf:type rdf:Property ;
    rdfs:label 'Esg Material Issues' ;
    rdfs:comment 'Description of material ESG issues identified during the ESG DD workstream, including GHG exposure, social risks, and governance deficiencies per TCFD and PRI frameworks.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fddRating rdf:type rdf:Property ;
    rdfs:label 'Fdd Rating' ;
    rdfs:comment 'Outcome rating for the Financial Due Diligence workstream covering financial statement analysis, EBITDA quality, cash flow, and capital structure assessment.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:imReference rdf:type rdf:Property ;
    rdfs:label 'Im Reference' ;
    rdfs:comment 'Document reference or identifier for the Investment Memorandum (IM) prepared as the primary IC submission document summarizing DD findings and investment recommendation.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyRisksSummary rdf:type rdf:Property ;
    rdfs:label 'Key Risks Summary' ;
    rdfs:comment 'Narrative summary of the most material risks identified across all DD workstreams. Included in the IC submission package and Investment Memorandum for decision-maker review.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycAmlCleared rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Cleared' ;
    rdfs:comment 'Indicates whether the target entity has passed KYC/AML screening as required by FATF guidelines prior to investment. Mandatory compliance gate for all engagements.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycClearedDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Cleared Date' ;
    rdfs:comment 'Date on which KYC/AML clearance was formally confirmed for the target entity. Required for regulatory audit trail and compliance reporting to FATF.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDdRating rdf:type rdf:Property ;
    rdfs:label 'Legal Dd Rating' ;
    rdfs:comment 'Outcome rating for the Legal Due Diligence workstream covering corporate structure, title, regulatory compliance, litigation exposure, and contractual obligations.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaExecuted rdf:type rdf:Property ;
    rdfs:label 'Nda Executed' ;
    rdfs:comment 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity prior to commencement of the DD engagement. Required before confidential data sharing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oddRating rdf:type rdf:Property ;
    rdfs:label 'Odd Rating' ;
    rdfs:comment 'Outcome rating for the Operational Due Diligence workstream assessing governance, controls, technology, and operational infrastructure of the target entity.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallDdRating rdf:type rdf:Property ;
    rdfs:label 'Overall Dd Rating' ;
    rdfs:comment 'Consolidated DD outcome rating summarizing findings across all workstreams. Represents the lead analyst and DD team\'s aggregate assessment of the target entity\'s suitability.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFlags rdf:type rdf:Property ;
    rdfs:label 'Regulatory Flags' ;
    rdfs:comment 'Free-text notation of any regulatory concerns, sanctions screening results, or compliance flags raised during the DD process requiring escalation or legal review.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repeatEngagement rdf:type rdf:Property ;
    rdfs:label 'Repeat Engagement' ;
    rdfs:comment 'Indicates whether this is a repeat or re-underwriting DD engagement on a previously reviewed entity (e.g., re-up fund commitment, periodic ODD refresh on existing manager).' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Target Completion Date' ;
    rdfs:comment 'Planned date by which all DD workstreams must be completed and findings consolidated for IC submission. Used for project tracking and SLA monitoring.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetEntityType rdf:type rdf:Property ;
    rdfs:label 'Target Entity Type' ;
    rdfs:comment 'Classification of the entity under DD review: Direct Investment, Co-Investment, External Fund Manager, Real Asset, or Credit Issuer. Determines applicable DD checklist and workstream scope.' ;
    rdfs:domain ind:DdEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAdvisor rdf:type rdf:Property ;
    rdfs:label 'Third Party Advisor' ;
    rdfs:comment 'Name of the external advisory firm engaged to support the DD process (e.g., legal counsel, accounting firm, technical advisor, ESG consultant). Multiple advisors noted as comma-separated.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddWorkstreamId rdf:type rdf:Property ;
    rdfs:label 'Dd Workstream Id' ;
    rdfs:comment 'Unique surrogate identifier for a distinct functional workstream within a due diligence engagement. Primary key for the dd_workstream entity.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdWorkstream .

ind:advisorEngagementRef rdf:type rdf:Property ;
    rdfs:label 'Advisor Engagement Ref' ;
    rdfs:comment 'External engagement or mandate reference number assigned by the third-party advisor firm for this workstream. Used for invoice reconciliation and report tracking.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advisorFeeCurrency rdf:type rdf:Property ;
    rdfs:label 'Advisor Fee Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the advisor fee amount (e.g., USD, GBP). Required for multi-currency deal cost consolidation.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlKycConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Aml Kyc Concern Flag' ;
    rdfs:comment 'Indicates whether AML or KYC concerns were identified during this workstream. Triggers mandatory escalation to compliance per FATF AML requirements.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:checklistCompletionPct rdf:type rdf:Property ;
    rdfs:label 'Checklist Completion Pct' ;
    rdfs:comment 'Percentage of checklist items within this workstream that have been completed. Provides a granular progress indicator beyond binary status fields.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:checklistTemplateRef rdf:type rdf:Property ;
    rdfs:label 'Checklist Template Ref' ;
    rdfs:comment 'Reference code or version identifier of the standardized DD checklist template applied to this workstream. Ensures consistency and regulatory alignment across engagements.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalFindingCount rdf:type rdf:Property ;
    rdfs:label 'Critical Finding Count' ;
    rdfs:comment 'Number of findings rated as Critical or deal-breaker severity within this workstream. A non-zero value typically triggers IC escalation or deal suspension.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataRoomAccessFlag rdf:type rdf:Property ;
    rdfs:label 'Data Room Access Flag' ;
    rdfs:comment 'Indicates whether the DD team has been granted access to the virtual data room (VDR) for this workstream. Access is a prerequisite for FDD and Legal DD execution.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataRoomPlatform rdf:type rdf:Property ;
    rdfs:label 'Data Room Platform' ;
    rdfs:comment 'Name of the virtual data room platform used for document sharing in this workstream (e.g., Intralinks, Datasite, Ansarada). Used for access audit and document provenance.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgMaterialityFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Materiality Flag' ;
    rdfs:comment 'Indicates whether ESG factors identified in this workstream are material to the investment decision. Triggers mandatory ESG DD escalation per PRI and TCFD commitments.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:findingCount rdf:type rdf:Property ;
    rdfs:label 'Finding Count' ;
    rdfs:comment 'Total number of findings identified within this workstream. Provides a quantitative measure of diligence depth and issue density for IC reporting.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:icSubmissionDeadline rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Deadline' ;
    rdfs:comment 'Hard deadline by which this workstream findings must be incorporated into the Investment Memorandum (IM) for IC review and approval.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:keyFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Key Findings Summary' ;
    rdfs:comment 'Executive summary of the principal findings from this workstream. Incorporated into the Investment Memorandum (IM) for IC review. Confidential deal-sensitive content.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ndaExecutedFlag rdf:type rdf:Property ;
    rdfs:label 'Nda Executed Flag' ;
    rdfs:comment 'Indicates whether a Non-Disclosure Agreement (NDA) has been executed with the target entity prior to commencement of this workstream. Required before accessing confidential data room.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:openFindingCount rdf:type rdf:Property ;
    rdfs:label 'Open Finding Count' ;
    rdfs:comment 'Number of findings that remain unresolved or unmitigated at the time of reporting. Tracks outstanding diligence items blocking workstream sign-off.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallRiskRating rdf:type rdf:Property ;
    rdfs:label 'Overall Risk Rating' ;
    rdfs:comment 'Aggregate risk rating assigned to this workstream based on findings. Informs IC decision-making and determines whether deal-breaker conditions exist.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Concern Flag' ;
    rdfs:comment 'Indicates whether this workstream has identified a regulatory, compliance, or legal concern requiring escalation to the Chief Compliance Officer or Legal counsel.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportIssuedDate rdf:type rdf:Property ;
    rdfs:label 'Report Issued Date' ;
    rdfs:comment 'Date on which the final or most recent version of the DD report for this workstream was formally issued to the investment team and IC.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportVersion rdf:type rdf:Property ;
    rdfs:label 'Report Version' ;
    rdfs:comment 'Version identifier of the most recent DD report produced for this workstream (e.g., v1.0, v2.3). Tracks report iteration history for IC audit trail.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signOffTimestamp rdf:type rdf:Property ;
    rdfs:label 'Sign Off Timestamp' ;
    rdfs:comment 'Timestamp at which the workstream owner formally signed off on the completeness and accuracy of this workstream. Constitutes the official DD completion event for audit purposes.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:targetEntityLei rdf:type rdf:Property ;
    rdfs:label 'Target Entity Lei' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier (LEI) of the target entity. Used for regulatory reporting, counterparty identification, and KYC/AML verification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstreamCode rdf:type rdf:Property ;
    rdfs:label 'Workstream Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this workstream within the DD engagement. Used for cross-system referencing in eFront and Dealpath.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstreamName rdf:type rdf:Property ;
    rdfs:label 'Workstream Name' ;
    rdfs:comment 'Human-readable descriptive name for the workstream (e.g., \'Financial Due Diligence — Project Maple\'). Used in IC memoranda and reporting dashboards.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstreamOwner rdf:type rdf:Property ;
    rdfs:label 'Workstream Owner' ;
    rdfs:comment 'Name or title of the senior investment professional accountable for the quality and completeness of this workstream. Typically a Managing Director or VP.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstreamStatus rdf:type rdf:Property ;
    rdfs:label 'Workstream Status' ;
    rdfs:comment 'Current lifecycle state of the workstream. Drives IC governance reporting and tracks progress toward DD completion sign-off.' ;
    rdfs:domain ind:DdWorkstream ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workstreamType rdf:type rdf:Property ;
    rdfs:label 'Workstream Type' ;
    rdfs:comment 'Functional category of the workstream: Operational DD (ODD), Financial DD (FDD), Commercial DD (CDD), Legal DD, ESG DD, or Tax DD. Determines the checklist and risk framework applied.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddChecklistId rdf:type rdf:Property ;
    rdfs:label 'Dd Checklist Id' ;
    rdfs:comment 'Unique surrogate identifier for a DD checklist record within the diligence domain. Primary key for the dd_checklist product.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdChecklist .

ind:parentTemplateDdChecklistId rdf:type rdf:Property ;
    rdfs:label 'Parent Template Dd Checklist Id' ;
    rdfs:comment 'Reference to the standard master template from which this checklist was derived or customized. Enables lineage tracking between standard and customized checklists.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdChecklist .

ind:assignedDate rdf:type rdf:Property ;
    rdfs:label 'Assigned Date' ;
    rdfs:comment 'Date on which this checklist was formally assigned to the DD team or workstream lead for the current engagement.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:checklistCode rdf:type rdf:Property ;
    rdfs:label 'Checklist Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this checklist template instance, used for cross-system referencing in eFront and Dealpath/DealCloud.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistName rdf:type rdf:Property ;
    rdfs:label 'Checklist Name' ;
    rdfs:comment 'Human-readable name of the checklist template, e.g., \'Infrastructure ODD Checklist v3\' or \'Private Equity FDD Standard Checklist\'.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistStatus rdf:type rdf:Property ;
    rdfs:label 'Checklist Status' ;
    rdfs:comment 'Current lifecycle status of the checklist template. Draft=in preparation, Active=approved for use, Deprecated=superseded by newer version, Archived=retired, Under Review=pending approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checklistVersion rdf:type rdf:Property ;
    rdfs:label 'Checklist Version' ;
    rdfs:comment 'Version identifier of the checklist template (e.g., \'1.0\', \'2.3\'), enabling tracking of template evolution and ensuring the correct version is applied to each engagement.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedItemCount rdf:type rdf:Property ;
    rdfs:label 'Completed Item Count' ;
    rdfs:comment 'Number of checklist items that have been marked as completed within this checklist instance. Enables real-time progress monitoring by the DD team.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:completionStatus rdf:type rdf:Property ;
    rdfs:label 'Completion Status' ;
    rdfs:comment 'Operational completion status of this checklist instance within its assigned engagement. Tracks progress from initiation through completion or waiver.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalItemCount rdf:type rdf:Property ;
    rdfs:label 'Critical Item Count' ;
    rdfs:comment 'Number of checklist items flagged as critical or mandatory. Critical items must be resolved before IC approval can be granted.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dataRoomAccess rdf:type rdf:Property ;
    rdfs:label 'Data Room Access' ;
    rdfs:comment 'Indicates whether the DD team has been granted access to the virtual data room (VDR) for this engagement, enabling document review and checklist completion.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgScopeIncluded rdf:type rdf:Property ;
    rdfs:label 'Esg Scope Included' ;
    rdfs:comment 'Indicates whether ESG due diligence items are included within this checklist. Mandatory for all new investments per PRI and TCFD commitments.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isCustomized rdf:type rdf:Property ;
    rdfs:label 'Is Customized' ;
    rdfs:comment 'Indicates whether this checklist has been customized from the standard template for a specific engagement. Customized checklists require additional approval before use.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycAmlScopeIncluded rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Scope Included' ;
    rdfs:comment 'Indicates whether KYC/AML screening items are included in this checklist. Required for all new counterparties per FATF AML guidelines.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ndaInPlace rdf:type rdf:Property ;
    rdfs:label 'Nda In Place' ;
    rdfs:comment 'Indicates whether a signed NDA is in place with the target entity prior to commencement of this DD workstream. Required before accessing confidential materials.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingItemCount rdf:type rdf:Property ;
    rdfs:label 'Outstanding Item Count' ;
    rdfs:comment 'Number of checklist items that remain open or unresolved. Derived operationally from total minus completed, but stored for reporting and IC governance dashboards.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallDdRecommendation rdf:type rdf:Property ;
    rdfs:label 'Overall Dd Recommendation' ;
    rdfs:comment 'Workstream-level recommendation arising from this checklist. Aggregated with other workstream recommendations to form the overall DD conclusion for IC.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalItemCount rdf:type rdf:Property ;
    rdfs:label 'Total Item Count' ;
    rdfs:comment 'Total number of checklist items defined within this checklist template version. Used for progress tracking and completion percentage calculations.' ;
    rdfs:domain ind:DdChecklist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ddChecklistItemId rdf:type rdf:Property ;
    rdfs:label 'Dd Checklist Item Id' ;
    rdfs:comment 'Unique surrogate identifier for an individual due diligence checklist line item. Primary key for the dd_checklist_item product.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdChecklistItem .

ind:advisorReportReference rdf:type rdf:Property ;
    rdfs:label 'Advisor Report Reference' ;
    rdfs:comment 'Reference number or document identifier for the third-party advisor report that addresses this checklist item. Links to the document management system.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddChecklistItemCategory rdf:type rdf:Property ;
    rdfs:label 'Dd Checklist Item Category' ;
    rdfs:comment 'Business category grouping for this item within its DD type (e.g., Governance, Financial Statements, ESG Policy, AML/KYC, Valuation, Fund Terms, Cybersecurity). Enables thematic reporting.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:completedDate rdf:type rdf:Property ;
    rdfs:label 'Completed Date' ;
    rdfs:comment 'Date on which this checklist item was marked as satisfactory or closed by the assigned analyst or reviewer. Supports DD completion tracking.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataRoomReference rdf:type rdf:Property ;
    rdfs:label 'Data Room Reference' ;
    rdfs:comment 'Reference path or identifier for the supporting document in the virtual data room (VDR) that satisfies this checklist item.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effrontItemCode rdf:type rdf:Property ;
    rdfs:label 'Effront Item Code' ;
    rdfs:comment 'Native identifier for this checklist item in the eFront Private Markets platform. Enables reconciliation and bi-directional synchronization with the system of record.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationReason rdf:type rdf:Property ;
    rdfs:label 'Escalation Reason' ;
    rdfs:comment 'Narrative explanation for why this item was escalated, including the nature of the concern (e.g., missing document, adverse finding, counterparty non-response).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgDimension rdf:type rdf:Property ;
    rdfs:label 'Esg Dimension' ;
    rdfs:comment 'ESG pillar this item relates to, if applicable. Enables ESG-specific DD tracking aligned with PRI, TCFD, and SFDR reporting obligations.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extendedDueDate rdf:type rdf:Property ;
    rdfs:label 'Extended Due Date' ;
    rdfs:comment 'Revised due date following a formal extension approval. Captures timeline changes for audit trail and DD project management reporting.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:findingSummary rdf:type rdf:Property ;
    rdfs:label 'Finding Summary' ;
    rdfs:comment 'Concise analyst summary of the key finding or observation for this checklist item. Included in the DD report and Investment Memorandum (IM) submitted to the IC.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:guidanceNotes rdf:type rdf:Property ;
    rdfs:label 'Guidance Notes' ;
    rdfs:comment 'Internal guidance text for the assigned analyst explaining the intent of the question, acceptable evidence, and evaluation criteria. Not shared with the counterparty.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIcBlocking rdf:type rdf:Property ;
    rdfs:label 'Is Ic Blocking' ;
    rdfs:comment 'Indicates whether an unresolved or escalated status on this item will block submission to the Investment Committee (IC). Supports IC governance gate controls.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:itemReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Item Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this checklist item within the DD engagement (e.g., DD-FDD-00042). Used in advisor reports and IC submissions.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:itemSequence rdf:type rdf:Property ;
    rdfs:label 'Item Sequence' ;
    rdfs:comment 'Ordinal position of this checklist item within its parent checklist section, used to maintain structured ordering for IC presentation and reporting.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:itemStatus rdf:type rdf:Property ;
    rdfs:label 'Item Status' ;
    rdfs:comment 'Current workflow status of the checklist item. [ENUM-REF-CANDIDATE: open|in_progress|received|satisfactory|escalated|waived|closed — promote to reference product]' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priority rdf:type rdf:Property ;
    rdfs:label 'Priority' ;
    rdfs:comment 'Business priority assigned to this checklist item, indicating urgency and materiality to the investment decision. Critical items may block IC approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:questionText rdf:type rdf:Property ;
    rdfs:label 'Question Text' ;
    rdfs:comment 'Full text of the diligence question, information request, or verification task as presented to the counterparty or assigned analyst. Core content of the checklist item.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationNotes rdf:type rdf:Property ;
    rdfs:label 'Remediation Notes' ;
    rdfs:comment 'Description of the required remediation action, condition precedent, or post-close monitoring obligation associated with this checklist item finding.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationRequired rdf:type rdf:Property ;
    rdfs:label 'Remediation Required' ;
    rdfs:comment 'Indicates whether a remediation action or condition precedent is required to address the finding before or after investment close.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Response Received Date' ;
    rdfs:comment 'Date on which a response or supporting document was received from the counterparty or data room for this checklist item.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responseText rdf:type rdf:Property ;
    rdfs:label 'Response Text' ;
    rdfs:comment 'Free-text or structured response provided by the counterparty or analyst for this checklist item. Captured when response_type is text or yes_no.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseType rdf:type rdf:Property ;
    rdfs:label 'Response Type' ;
    rdfs:comment 'Format of the expected response for this item: document upload, free text, numeric value, date, yes/no confirmation, or multi-select. Drives UI rendering in eFront.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewedDate rdf:type rdf:Property ;
    rdfs:label 'Reviewed Date' ;
    rdfs:comment 'Date on which the reviewer assessed and approved or rejected the response for this checklist item. Supports DD quality control audit trail.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceTemplateCode rdf:type rdf:Property ;
    rdfs:label 'Source Template Code' ;
    rdfs:comment 'Code identifying the standardized DD checklist template from which this item was instantiated (e.g., PE-FDD-V3, INFRA-ODD-V2). Enables template version tracking.' ;
    rdfs:domain ind:DdChecklistItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverApproved rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved' ;
    rdfs:comment 'Indicates whether a formal waiver has been approved for this checklist item, allowing the DD process to proceed despite an incomplete or unsatisfactory response.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ddFindingId rdf:type rdf:Property ;
    rdfs:label 'Dd Finding Id' ;
    rdfs:comment 'Unique surrogate identifier for a formal due diligence finding record within the diligence domain.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dealCurrency rdf:type rdf:Property ;
    rdfs:label 'Deal Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the deal in which this finding arises, used to denominate price adjustment and indemnity amounts.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dealImpactType rdf:type rdf:Property ;
    rdfs:label 'Deal Impact Type' ;
    rdfs:comment 'Classification of how this finding impacts the deal structure: deal-breaker, price adjustment, condition precedent in SPA, warranty/indemnity clause, or ongoing monitoring.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgSubTheme rdf:type rdf:Property ;
    rdfs:label 'Esg Sub Theme' ;
    rdfs:comment 'Granular ESG sub-category for the finding (e.g., GHG emissions, water usage, labour practices, board independence, anti-corruption). Applicable when esg_theme is set.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingCategory rdf:type rdf:Property ;
    rdfs:label 'Finding Category' ;
    rdfs:comment 'Granular business category of the finding within its workstream (e.g., revenue recognition, AML controls, governance structure, GHG emissions). [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingDescription rdf:type rdf:Property ;
    rdfs:label 'Finding Description' ;
    rdfs:comment 'Detailed narrative description of the finding, including the specific issue observed, context, and relevant facts gathered during the DD workstream.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingReference rdf:type rdf:Property ;
    rdfs:label 'Finding Reference' ;
    rdfs:comment 'Externally-visible alphanumeric reference code uniquely identifying this finding across DD workstreams and investment committee (IC) documentation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingStatus rdf:type rdf:Property ;
    rdfs:label 'Finding Status' ;
    rdfs:comment 'Current lifecycle status of the finding from identification through resolution: open, under review, remediated, accepted (risk accepted), escalated to IC, or closed.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:findingTitle rdf:type rdf:Property ;
    rdfs:label 'Finding Title' ;
    rdfs:comment 'Concise human-readable title summarizing the nature of the finding, used in IC memos, investment memoranda (IM), and DD summary reports.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:followUpDueDate rdf:type rdf:Property ;
    rdfs:label 'Follow Up Due Date' ;
    rdfs:comment 'Target date by which the follow-up information or clarification for this finding must be received, applicable when follow_up_required is true.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:followUpRequired rdf:type rdf:Property ;
    rdfs:label 'Follow Up Required' ;
    rdfs:comment 'Indicates whether this finding requires a follow-up action or additional information request from the target company, GP, or third-party advisor.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icDisposition rdf:type rdf:Property ;
    rdfs:label 'Ic Disposition' ;
    rdfs:comment 'Investment Committee (IC) decision on how to handle this finding: proceed, proceed with conditions, escalate for further review, reject the deal, or defer decision.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedBy rdf:type rdf:Property ;
    rdfs:label 'Identified By' ;
    rdfs:comment 'Name or employee identifier of the internal analyst or team member who formally identified and raised this DD finding during the diligence process.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:identifiedDate rdf:type rdf:Property ;
    rdfs:label 'Identified Date' ;
    rdfs:comment 'Calendar date on which the DD finding was formally identified and documented by the diligence team during the due diligence process.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Impact Confidence Level' ;
    rdfs:comment 'Analyst confidence level in the estimated financial impact amount: high (well-supported), medium (estimated), low (speculative), or unquantifiable.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactCurrency rdf:type rdf:Property ;
    rdfs:label 'Impact Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the potential financial impact amount (e.g., USD, GBP, EUR).' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indemnityAmount rdf:type rdf:Property ;
    rdfs:label 'Indemnity Amount' ;
    rdfs:comment 'Monetary value of any indemnity or escrow arrangement negotiated with the vendor as a result of this finding, expressed in the deal currency.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isDealCondition rdf:type rdf:Property ;
    rdfs:label 'Is Deal Condition' ;
    rdfs:comment 'Indicates whether this finding has been elevated to a formal condition precedent in the Share Purchase Agreement (SPA) or Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIcReportable rdf:type rdf:Property ;
    rdfs:label 'Is Ic Reportable' ;
    rdfs:comment 'Indicates whether this finding must be formally reported to the Investment Committee (IC) as part of the IC submission package and investment memorandum (IM).' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:likelihoodRating rdf:type rdf:Property ;
    rdfs:label 'Likelihood Rating' ;
    rdfs:comment 'Analyst assessment of the probability that the risk identified in this finding will materialize, used in conjunction with severity to derive the composite risk rating.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:potentialFinancialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Potential Financial Impact Amount' ;
    rdfs:comment 'Estimated monetary value of the potential financial impact of this finding on the investment, expressed in the base currency. Used in IC risk quantification.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Price Adjustment Amount' ;
    rdfs:comment 'Monetary value of any purchase price adjustment negotiated as a result of this finding, expressed in the deal currency. Relevant for FDD and legal DD findings.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Breach Flag' ;
    rdfs:comment 'Indicates whether this finding involves a potential or confirmed breach of applicable regulatory requirements (e.g., AML, KYC, EMIR, MiFID II guidelines).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Completed Date' ;
    rdfs:comment 'Actual date on which the remediation action for this finding was completed and verified by the DD team or post-acquisition monitoring team.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationDueDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Due Date' ;
    rdfs:comment 'Target date by which the remediation action for this finding must be completed, as agreed between the DD team and the responsible party.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationOwner rdf:type rdf:Property ;
    rdfs:label 'Remediation Owner' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for driving remediation of this finding, either internally or at the target company / GP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCause rdf:type rdf:Property ;
    rdfs:label 'Root Cause' ;
    rdfs:comment 'Analyst-documented root cause analysis explaining the underlying reason or systemic driver behind the identified finding.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityRating rdf:type rdf:Property ;
    rdfs:label 'Severity Rating' ;
    rdfs:comment 'Standardized severity classification of the finding: critical (deal-breaker risk), major (significant issue requiring remediation), minor (manageable issue), or informational (noted for monitoring).' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceSystemFindingCode rdf:type rdf:Property ;
    rdfs:label 'Source System Finding Code' ;
    rdfs:comment 'Native identifier of this finding in the originating operational system (e.g., eFront finding ID, Dealpath issue ID), enabling bi-directional traceability.' ;
    rdfs:domain ind:DdFinding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddRiskAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Dd Risk Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for the consolidated risk assessment record produced at the conclusion of a due diligence engagement or workstream. Entity role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorAssessmentDdRiskAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Prior Assessment Dd Risk Assessment Id' ;
    rdfs:comment 'Reference to the previous version of this risk assessment, enabling version chain navigation for audit, re-underwriting, and IC re-submission scenarios.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdRiskAssessment .

ind:assessmentReference rdf:type rdf:Property ;
    rdfs:label 'Assessment Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this risk assessment, used for cross-referencing with eFront, DealCloud, and IC governance documentation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentVersion rdf:type rdf:Property ;
    rdfs:label 'Assessment Version' ;
    rdfs:comment 'Version number of this risk assessment record, incremented when material updates are made post-initial completion, supporting audit trail and IC re-submission tracking.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgRiskScore rdf:type rdf:Property ;
    rdfs:label 'Esg Risk Score' ;
    rdfs:comment 'Quantitative ESG risk score derived from MSCI ESG ratings, TCFD alignment assessment, GHG emissions data, and PRI responsible investment criteria.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialRiskRating rdf:type rdf:Property ;
    rdfs:label 'Financial Risk Rating' ;
    rdfs:comment 'Categorical risk rating for the financial dimension of the DD assessment, summarizing findings on earnings quality, balance sheet strength, and valuation risk.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialRiskScore rdf:type rdf:Property ;
    rdfs:label 'Financial Risk Score' ;
    rdfs:comment 'Quantitative risk score for the financial risk dimension, assessing quality of earnings, leverage, liquidity, EBITDA sustainability, and DCF/WACC sensitivity.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyMitigants rdf:type rdf:Property ;
    rdfs:label 'Key Mitigants' ;
    rdfs:comment 'Narrative description of the principal risk mitigants, structural protections, and value creation levers identified to offset the key risk factors in this assessment.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyRiskFactors rdf:type rdf:Property ;
    rdfs:label 'Key Risk Factors' ;
    rdfs:comment 'Narrative summary of the principal risk factors identified across all DD workstreams, used in the Investment Memorandum (IM) and IC presentation. Confidential deal-sensitive content.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAnalyst rdf:type rdf:Property ;
    rdfs:label 'Lead Analyst' ;
    rdfs:comment 'Name or employee identifier of the lead internal analyst responsible for coordinating and producing this risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Legal Risk Rating' ;
    rdfs:comment 'Categorical risk rating for the legal dimension, summarizing findings on contractual terms, regulatory exposure, and litigation risk identified during legal DD.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRiskScore rdf:type rdf:Property ;
    rdfs:label 'Legal Risk Score' ;
    rdfs:comment 'Quantitative risk score for the legal risk dimension, covering LPA terms, regulatory compliance, litigation exposure, IP ownership, and contractual obligations.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementQualityRating rdf:type rdf:Property ;
    rdfs:label 'Management Quality Rating' ;
    rdfs:comment 'Categorical rating for management team quality, covering investment track record, key-person risk, succession planning, and GP/LP alignment of interests.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementQualityScore rdf:type rdf:Property ;
    rdfs:label 'Management Quality Score' ;
    rdfs:comment 'Quantitative score assessing the quality, depth, track record, and alignment of the target\'s management team or GP investment professionals.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketRiskRating rdf:type rdf:Property ;
    rdfs:label 'Market Risk Rating' ;
    rdfs:comment 'Categorical rating for market risk, reflecting the investment\'s sensitivity to macroeconomic cycles, sector dynamics, and capital market conditions.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketRiskScore rdf:type rdf:Property ;
    rdfs:label 'Market Risk Score' ;
    rdfs:comment 'Quantitative score for market risk exposure including macro sensitivity, sector concentration, FX risk, interest rate risk, and cyclicality of the target\'s business.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Operational Risk Rating' ;
    rdfs:comment 'Categorical risk rating for the operational dimension, summarizing findings on fund administration, compliance infrastructure, and operational controls.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalRiskScore rdf:type rdf:Property ;
    rdfs:label 'Operational Risk Score' ;
    rdfs:comment 'Quantitative risk score for the operational risk dimension, covering fund operations, middle/back-office controls, technology infrastructure, and service provider quality.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallRiskScore rdf:type rdf:Property ;
    rdfs:label 'Overall Risk Score' ;
    rdfs:comment 'Quantitative composite risk score (typically on a 0–100 scale) derived from weighted individual risk dimension scores, used for portfolio-level risk aggregation and benchmarking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sanctionsScreeningStatus rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screening Status' ;
    rdfs:comment 'Result of sanctions list screening (OFAC, UN, EU) conducted on the target entity and key principals as part of the DD compliance process.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetDomicile rdf:type rdf:Property ;
    rdfs:label 'Target Domicile' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the investment target or fund is domiciled, used for regulatory, tax, and FX risk analysis.' ;
    rdfs:domain ind:DdRiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:advisorEngagementId rdf:type rdf:Property ;
    rdfs:label 'Advisor Engagement Id' ;
    rdfs:comment 'Unique surrogate identifier for the advisor engagement record within the due diligence domain. Primary key for this master agreement entity.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdvisorEngagement .

ind:internalDealOpportunityId rdf:type rdf:Property ;
    rdfs:label 'Internal Deal Opportunity Id' ;
    rdfs:comment 'Reference to the deal or investment opportunity in the deal origination pipeline (DealCloud/Dealpath) for which this advisor engagement was initiated.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Opportunity .

ind:advisorFirmLei rdf:type rdf:Property ;
    rdfs:label 'Advisor Firm Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier (LEI) of the advisor firm, used for regulatory counterparty identification and KYC/AML compliance verification.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreedFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Agreed Fee Amount' ;
    rdfs:comment 'Total contracted fee amount agreed with the advisor firm for the full scope of the engagement, expressed in the fee currency. For hourly/retainer structures, represents the estimated or capped total.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:conflictOfInterestChecked rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Checked' ;
    rdfs:comment 'Indicates whether a formal conflict of interest check has been completed for the advisor firm relative to the target investment or fund manager prior to engagement.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conflictOfInterestNotes rdf:type rdf:Property ;
    rdfs:label 'Conflict Of Interest Notes' ;
    rdfs:comment 'Free-text notes documenting the outcome of the conflict of interest review, including any identified conflicts, mitigants applied, or waivers granted by the IC or compliance team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddReportDueDate rdf:type rdf:Property ;
    rdfs:label 'Dd Report Due Date' ;
    rdfs:comment 'Contractually agreed date by which the advisor must deliver the final DD report or key deliverable to the internal deal team, used for timeline management and IC scheduling.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ddReportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Dd Report Received Date' ;
    rdfs:comment 'Actual date on which the final DD report or principal deliverable was received from the advisor firm. Compared against dd_report_due_date to assess advisor performance.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dealGeography rdf:type rdf:Property ;
    rdfs:label 'Deal Geography' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the primary geographic jurisdiction of the investment or fund manager under due diligence, used for regulatory and reporting purposes.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effrontEngagementRef rdf:type rdf:Property ;
    rdfs:label 'Effront Engagement Ref' ;
    rdfs:comment 'System reference identifier for this advisor engagement record within the eFront Private Markets platform, enabling data lineage and reconciliation with the source system of record.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementChannel rdf:type rdf:Property ;
    rdfs:label 'Engagement Channel' ;
    rdfs:comment 'Method by which the advisor was selected and engaged: directly appointed, sourced via intermediary, selected through panel rotation, or awarded via competitive tender/RFP process.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:engagementEndDate rdf:type rdf:Property ;
    rdfs:label 'Engagement End Date' ;
    rdfs:comment 'Contractual end date of the advisor engagement. Nullable for open-ended engagements. Represents the effective-until date of the agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementLetterDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Letter Date' ;
    rdfs:comment 'Date on which the formal engagement letter or statement of work was signed by both parties, establishing the binding contractual relationship.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:engagementStartDate rdf:type rdf:Property ;
    rdfs:label 'Engagement Start Date' ;
    rdfs:comment 'Date on which the advisor engagement formally commences, as stipulated in the signed engagement letter or contract. Marks the effective-from date of the agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeCapAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Cap Amount' ;
    rdfs:comment 'Maximum fee amount payable to the advisor under the engagement, regardless of hours incurred. Applicable for capped_fee and blended fee structures. Null if no cap applies.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hourlyRate rdf:type rdf:Property ;
    rdfs:label 'Hourly Rate' ;
    rdfs:comment 'Agreed hourly billing rate for the advisor engagement, applicable where the fee structure type is hourly_rate or blended. Expressed in the fee currency.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Required' ;
    rdfs:comment 'Indicates whether Investment Committee (IC) approval is required to authorize this advisor engagement, based on fee thresholds or deal materiality per internal governance policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Insurance Expiry Date' ;
    rdfs:comment 'Expiry date of the advisor firm\'s professional indemnity insurance policy. Used to trigger renewal verification before the policy lapses during an active engagement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:insuranceVerified rdf:type rdf:Property ;
    rdfs:label 'Insurance Verified' ;
    rdfs:comment 'Indicates whether the advisor firm\'s professional indemnity and liability insurance coverage has been verified and meets the minimum requirements stipulated in the engagement letter.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalDealLead rdf:type rdf:Property ;
    rdfs:label 'Internal Deal Lead' ;
    rdfs:comment 'Name of the internal investment professional (deal lead or portfolio manager) responsible for managing the advisor engagement and overseeing DD deliverables.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAdvisorEmail rdf:type rdf:Property ;
    rdfs:label 'Lead Advisor Email' ;
    rdfs:comment 'Primary email address of the lead advisor at the engaged firm, used for formal engagement correspondence and document exchange.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadAdvisorName rdf:type rdf:Property ;
    rdfs:label 'Lead Advisor Name' ;
    rdfs:comment 'Full name of the primary individual (partner, director, or senior specialist) at the advisor firm who leads the engagement and is the principal point of contact.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateScope rdf:type rdf:Property ;
    rdfs:label 'Mandate Scope' ;
    rdfs:comment 'Narrative description of the specific scope of work, deliverables, and boundaries of the advisor\'s mandate as defined in the engagement letter or statement of work.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredPanelAdvisor rdf:type rdf:Property ;
    rdfs:label 'Preferred Panel Advisor' ;
    rdfs:comment 'Indicates whether the advisor firm is on the pension fund\'s pre-approved preferred advisor panel for this engagement type, streamlining procurement and governance approval.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportQualityRating rdf:type rdf:Property ;
    rdfs:label 'Report Quality Rating' ;
    rdfs:comment 'Internal qualitative rating assigned by the deal team to the advisor\'s final deliverable, used for advisor performance tracking and future panel selection decisions.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfpConducted rdf:type rdf:Property ;
    rdfs:label 'Rfp Conducted' ;
    rdfs:comment 'Indicates whether a formal Request for Proposal (RFP) process was conducted to select this advisor, as required for engagements above the procurement threshold.' ;
    rdfs:domain ind:AdvisorEngagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:advisorReportId rdf:type rdf:Property ;
    rdfs:label 'Advisor Report Id' ;
    rdfs:comment 'Unique surrogate identifier for the third-party advisor report record within the due diligence engagement.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByReportAdvisorReportId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Report Advisor Report Id' ;
    rdfs:comment 'Reference to the newer advisor report record that supersedes this version, enabling version chain tracking across draft and final report iterations.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdvisorReport .

ind:advisorLei rdf:type rdf:Property ;
    rdfs:label 'Advisor Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier (LEI) of the third-party advisor firm, enabling unambiguous global identification for regulatory and counterparty management purposes.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsAndRecommendations rdf:type rdf:Property ;
    rdfs:label 'Conditions And Recommendations' ;
    rdfs:comment 'Narrative description of conditions precedent, remediation actions, or recommendations made by the advisor that must be addressed prior to or post-investment close.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityClassification rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Classification' ;
    rdfs:comment 'Confidentiality level assigned to the advisor report as stipulated by the advisor or engagement letter: Strictly Confidential, Confidential, Internal, or Restricted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddScope rdf:type rdf:Property ;
    rdfs:label 'Dd Scope' ;
    rdfs:comment 'Scope of the due diligence engagement for which this report was produced: Direct Investment, Co-Investment, Fund Investment, Manager Selection, or Secondary transaction.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIssuesIdentified rdf:type rdf:Property ;
    rdfs:label 'Esg Issues Identified' ;
    rdfs:comment 'Indicates whether the advisor identified material Environmental, Social, or Governance (ESG) issues within the scope of this report, triggering ESG escalation review.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeAmount rdf:type rdf:Property ;
    rdfs:label 'Fee Amount' ;
    rdfs:comment 'Total fee charged by the third-party advisor for producing this report, as invoiced under the engagement letter. Used for DD cost tracking and budget management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icSubmissionIncluded rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Included' ;
    rdfs:comment 'Indicates whether this advisor report has been included as a supporting document in the Investment Committee (IC) submission pack for the related DD engagement.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalReviewNotes rdf:type rdf:Property ;
    rdfs:label 'Internal Review Notes' ;
    rdfs:comment 'Free-text notes from the internal reviewer capturing their assessment, challenges, or additional context on the advisor\'s findings for IC and investment team use.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalReviewerName rdf:type rdf:Property ;
    rdfs:label 'Internal Reviewer Name' ;
    rdfs:comment 'Name of the internal investment team member (analyst, associate, or VP) responsible for reviewing, challenging, and summarizing the advisor report findings.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:invoiceReference rdf:type rdf:Property ;
    rdfs:label 'Invoice Reference' ;
    rdfs:comment 'Reference number of the advisor\'s invoice for this report engagement, linking to the Oracle Financials AP module for payment processing and cost allocation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialIssuesCount rdf:type rdf:Property ;
    rdfs:label 'Material Issues Count' ;
    rdfs:comment 'Total number of material issues or red flags identified by the advisor in the report, providing a quantitative signal of report severity for IC prioritization.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ndaReference rdf:type rdf:Property ;
    rdfs:label 'Nda Reference' ;
    rdfs:comment 'Reference number of the Non-Disclosure Agreement (NDA) executed with the advisor firm governing the confidentiality of information exchanged during the DD engagement.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallConclusion rdf:type rdf:Property ;
    rdfs:label 'Overall Conclusion' ;
    rdfs:comment 'High-level conclusion of the advisor\'s report: Satisfactory, Satisfactory with Conditions, Unsatisfactory, or Inconclusive. Feeds into the IC\'s overall DD rating for the engagement.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryIssuesIdentified rdf:type rdf:Property ;
    rdfs:label 'Regulatory Issues Identified' ;
    rdfs:comment 'Indicates whether the advisor identified material regulatory, legal, or compliance issues within the report scope, requiring escalation to legal counsel or compliance.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:relianceLetterReference rdf:type rdf:Property ;
    rdfs:label 'Reliance Letter Reference' ;
    rdfs:comment 'Reference number of the formal reliance letter issued by the advisor permitting the pension fund to rely on the report findings for investment decision purposes.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reliancePermitted rdf:type rdf:Property ;
    rdfs:label 'Reliance Permitted' ;
    rdfs:comment 'Indicates whether the advisor has granted the pension fund permission to rely on the report for investment decision-making purposes, as stipulated in the engagement letter.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reportPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Report Period End' ;
    rdfs:comment 'End date of the historical period covered by the advisor\'s analysis, typically the most recent audited financial year-end or ESG reporting period.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Report Period Start' ;
    rdfs:comment 'Start date of the historical period covered by the advisor\'s analysis, e.g., the earliest financial year reviewed in an FDD or the earliest ESG data period assessed.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportReference rdf:type rdf:Property ;
    rdfs:label 'Report Reference' ;
    rdfs:comment 'Externally assigned unique reference number or code for the advisor report, as issued by the third-party advisor firm. Used for cross-referencing with the advisor\'s own document management system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportSubtype rdf:type rdf:Property ;
    rdfs:label 'Report Subtype' ;
    rdfs:comment 'Further classification within the report type, e.g., \'Quality of Earnings\' under FDD, \'IT Infrastructure\' under ODD, \'TCFD Climate Assessment\' under ESG. Free-text to accommodate evolving DD practice.' ;
    rdfs:domain ind:AdvisorReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportTitle rdf:type rdf:Property ;
    rdfs:label 'Report Title' ;
    rdfs:comment 'Full descriptive title of the advisor report as submitted by the third-party advisor, e.g., \'Financial Due Diligence Report – Target Co Ltd – Q3 2024\'.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:oddAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Odd Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for the ODD assessment record. Primary key for the odd_assessment product in the diligence domain.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadOddAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Odd Analyst Employee Id' ;
    rdfs:comment 'Internal analyst responsible for leading and coordinating the ODD assessment. Accountable for the completeness and accuracy of the ODD findings.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:aumAtAssessment rdf:type rdf:Property ;
    rdfs:label 'Aum At Assessment' ;
    rdfs:comment 'Total AUM managed by the external fund manager at the time of the ODD assessment, expressed in the reporting currency. Used to contextualise operational scale and resource adequacy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bcpTestedFlag rdf:type rdf:Property ;
    rdfs:label 'Bcp Tested Flag' ;
    rdfs:comment 'Indicates whether the manager has conducted a documented and tested Business Continuity Plan (BCP) and Disaster Recovery (DR) exercise within the past 12 months.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceAmlRating rdf:type rdf:Property ;
    rdfs:label 'Compliance Aml Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s compliance programme, AML/KYC controls, regulatory licensing status, and adherence to applicable regulations (MiFID II, EMIR, FATF).' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cybersecurityRating rdf:type rdf:Property ;
    rdfs:label 'Cybersecurity Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s cybersecurity posture, data protection controls, incident response procedures, and alignment with ISO 27001 and SOC 2 standards.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddqReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Ddq Received Date' ;
    rdfs:comment 'Date on which the completed ILPA or proprietary Due Diligence Questionnaire (DDQ) was received from the manager. Marks the start of substantive ODD analysis.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundAdminRating rdf:type rdf:Property ;
    rdfs:label 'Fund Admin Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s fund administration arrangements, use of independent third-party administrators, NAV calculation controls, and investor reporting quality.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceRating rdf:type rdf:Property ;
    rdfs:label 'Governance Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s governance framework, ownership structure, key-person dependencies, succession planning, and organizational stability.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:independentAdminFlag rdf:type rdf:Property ;
    rdfs:label 'Independent Admin Flag' ;
    rdfs:comment 'Indicates whether the manager uses a fully independent third-party fund administrator for NAV calculation and investor reporting, a key ODD best-practice indicator.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyPersonRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Key Person Risk Flag' ;
    rdfs:comment 'Indicates whether the ODD assessment identified material key-person dependency risk at the manager, where the departure of one or more individuals would significantly impair operations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:litigationFlag rdf:type rdf:Property ;
    rdfs:label 'Litigation Flag' ;
    rdfs:comment 'Indicates whether the ODD assessment identified material pending or historical litigation, arbitration, or legal proceedings involving the manager or its principals.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Material Findings Summary' ;
    rdfs:comment 'Narrative summary of material operational findings, red flags, or concerns identified during the ODD assessment. Key input to IC memorandum and investment decision.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:numberOfInvestmentProfessionals rdf:type rdf:Property ;
    rdfs:label 'Number Of Investment Professionals' ;
    rdfs:comment 'Total headcount of investment professionals (portfolio managers, analysts, associates) at the manager as reported during the ODD assessment. Indicator of operational capacity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:numberOfOperationsStaff rdf:type rdf:Property ;
    rdfs:label 'Number Of Operations Staff' ;
    rdfs:comment 'Total headcount of operations, middle-office, and back-office staff at the manager as reported during ODD. Assesses operational infrastructure relative to AUM and strategy complexity.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:oddRecommendation rdf:type rdf:Property ;
    rdfs:label 'Odd Recommendation' ;
    rdfs:comment 'Formal ODD team recommendation on whether to proceed with the investment based on operational findings: proceed, proceed with conditions, defer pending remediation, or decline.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onsiteVisitConducted rdf:type rdf:Property ;
    rdfs:label 'Onsite Visit Conducted' ;
    rdfs:comment 'Indicates whether an in-person on-site visit to the manager\'s offices was conducted as part of this ODD assessment, as opposed to a purely desk-based or remote review.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onsiteVisitDate rdf:type rdf:Property ;
    rdfs:label 'Onsite Visit Date' ;
    rdfs:comment 'Date on which the on-site visit to the manager\'s offices was conducted. Populated only when onsite_visit_conducted is true.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:overallOddRating rdf:type rdf:Property ;
    rdfs:label 'Overall Odd Rating' ;
    rdfs:comment 'Composite qualitative rating summarising the manager\'s overall operational infrastructure quality across all ODD dimensions. Used as a key input to IC approval decisions.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primeBrokerNames rdf:type rdf:Property ;
    rdfs:label 'Prime Broker Names' ;
    rdfs:comment 'Names of the manager\'s primary prime brokerage counterparties as identified during ODD. Relevant for counterparty concentration risk assessment and settlement infrastructure review.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryActionFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Action Flag' ;
    rdfs:comment 'Indicates whether the manager or its principals are subject to any current or historical regulatory sanctions, enforcement actions, or material regulatory findings identified during ODD.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Remediation Required Flag' ;
    rdfs:comment 'Indicates whether the ODD assessment identified operational deficiencies requiring formal remediation actions by the manager prior to or as a condition of investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:riskManagementRating rdf:type rdf:Property ;
    rdfs:label 'Risk Management Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s risk management framework, including VaR/CVaR monitoring, counterparty risk controls, liquidity risk management, and stress testing capabilities.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:soc2ReportAvailable rdf:type rdf:Property ;
    rdfs:label 'Soc2 Report Available' ;
    rdfs:comment 'Indicates whether the manager or its key service providers have a current SOC 2 Type II report available, evidencing controls over security, availability, and confidentiality.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:technologySystemsRating rdf:type rdf:Property ;
    rdfs:label 'Technology Systems Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s technology infrastructure, portfolio management systems, cybersecurity controls, disaster recovery, and business continuity capabilities.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyOddProvider rdf:type rdf:Property ;
    rdfs:label 'Third Party Odd Provider' ;
    rdfs:comment 'Name of any external specialist ODD firm engaged to assist with or independently conduct the operational due diligence review (e.g., Albourne Partners, PAAMCO, Aksia).' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tradeExecutionRating rdf:type rdf:Property ;
    rdfs:label 'Trade Execution Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s order management, best execution policies, prime brokerage arrangements, settlement processes, and DVP controls.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationRating rdf:type rdf:Property ;
    rdfs:label 'Valuation Rating' ;
    rdfs:comment 'ODD sub-dimension rating for the manager\'s valuation policies, independence of valuation function, NAV/GAV calculation methodology, and use of third-party valuation agents.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:yearsInOperation rdf:type rdf:Property ;
    rdfs:label 'Years In Operation' ;
    rdfs:comment 'Number of years the manager has been in operation as of the assessment date. Provides context for organisational maturity and track record depth.' ;
    rdfs:domain ind:OddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fddAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Fdd Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for the Financial Due Diligence (FDD) assessment record within the diligence domain.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FddAssessment .

ind:leadFddAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Fdd Analyst Employee Id' ;
    rdfs:comment 'Reference to the internal analyst responsible for leading the FDD workstream, accountable for QoE findings and EBITDA normalization conclusions.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adjustedNetDebt rdf:type rdf:Property ;
    rdfs:label 'Adjusted Net Debt' ;
    rdfs:comment 'Net debt after FDD reconciliation adjustments including debt-like items, contingent liabilities, pension deficits, and off-balance-sheet obligations.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditFirm rdf:type rdf:Property ;
    rdfs:label 'Audit Firm' ;
    rdfs:comment 'Name of the external auditor that issued the audit opinion on the target\'s financial statements reviewed during FDD.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditOpinionType rdf:type rdf:Property ;
    rdfs:label 'Audit Opinion Type' ;
    rdfs:comment 'Type of audit opinion issued on the most recent audited financial statements, flagging any qualifications or adverse opinions as key FDD risk indicators.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexGrowth rdf:type rdf:Property ;
    rdfs:label 'Capex Growth' ;
    rdfs:comment 'Annual growth capital expenditure identified during FDD for capacity expansion or new initiatives, distinct from maintenance CapEx, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexMaintenance rdf:type rdf:Property ;
    rdfs:label 'Capex Maintenance' ;
    rdfs:comment 'Annual maintenance capital expenditure required to sustain current operating capacity, as identified during FDD, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingentLiabilitiesAmount rdf:type rdf:Property ;
    rdfs:label 'Contingent Liabilities Amount' ;
    rdfs:comment 'Estimated aggregate value of contingent liabilities identified during FDD, used in net debt reconciliation and risk-adjusted valuation, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingentLiabilitiesIdentified rdf:type rdf:Property ;
    rdfs:label 'Contingent Liabilities Identified' ;
    rdfs:comment 'Indicates whether material contingent liabilities (litigation, tax exposures, warranties, guarantees) were identified during FDD requiring IC disclosure.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ebitdaMarginPct rdf:type rdf:Property ;
    rdfs:label 'Ebitda Margin Pct' ;
    rdfs:comment 'Normalized EBITDA as a percentage of revenue for the most recent full fiscal year, a key profitability metric used in valuation and peer benchmarking.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaNormalizationTotal rdf:type rdf:Property ;
    rdfs:label 'Ebitda Normalization Total' ;
    rdfs:comment 'Net aggregate of all EBITDA normalization adjustments identified during FDD, being the difference between reported and normalized EBITDA.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgFinancialMaterialityFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Financial Materiality Flag' ;
    rdfs:comment 'Indicates whether ESG factors with financial materiality (e.g., carbon liabilities, stranded assets, regulatory fines) were identified and incorporated into FDD findings.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialControlsRating rdf:type rdf:Property ;
    rdfs:label 'Financial Controls Rating' ;
    rdfs:comment 'Assessment of the adequacy of the target\'s internal financial controls and reporting processes, informing post-acquisition integration planning.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialModelVersion rdf:type rdf:Property ;
    rdfs:label 'Financial Model Version' ;
    rdfs:comment 'Version identifier of the financial model (DCF, LBO, or returns model) used in conjunction with FDD findings for investment valuation and IC submission.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:financialStatementsPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Financial Statements Period End' ;
    rdfs:comment 'End date of the historical financial period reviewed during FDD, anchoring the most recent audited or management accounts period analyzed.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialStatementsPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Financial Statements Period Start' ;
    rdfs:comment 'Start date of the historical financial period reviewed during FDD, typically covering 3–5 fiscal years of audited financial statements.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icSubmissionReady rdf:type rdf:Property ;
    rdfs:label 'Ic Submission Ready' ;
    rdfs:comment 'Indicates whether the FDD assessment has been reviewed, signed off, and is ready for inclusion in the Investment Committee (IC) submission package.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyFinancialRisksSummary rdf:type rdf:Property ;
    rdfs:label 'Key Financial Risks Summary' ;
    rdfs:comment 'Narrative summary of the most material financial risks identified during FDD, including earnings quality concerns, leverage risks, and structural financial issues.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementAccountsQuality rdf:type rdf:Property ;
    rdfs:label 'Management Accounts Quality' ;
    rdfs:comment 'Quality rating of the target\'s management reporting and internal accounts, assessing timeliness, accuracy, and granularity for post-acquisition monitoring.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netDebtAdjustmentNotes rdf:type rdf:Property ;
    rdfs:label 'Net Debt Adjustment Notes' ;
    rdfs:comment 'Narrative description of material adjustments made to reported net debt during FDD, including debt-like items, earn-outs, and pension obligations identified.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:normalizedEbitda rdf:type rdf:Property ;
    rdfs:label 'Normalized Ebitda' ;
    rdfs:comment 'EBITDA after all FDD normalization adjustments (one-time items, non-recurring charges, run-rate adjustments), representing sustainable earnings power.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:normalizedWorkingCapital rdf:type rdf:Property ;
    rdfs:label 'Normalized Working Capital' ;
    rdfs:comment 'Normalized working capital peg established during FDD, representing the level of working capital required to operate the business at a normalized level.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallFddRating rdf:type rdf:Property ;
    rdfs:label 'Overall Fdd Rating' ;
    rdfs:comment 'Aggregate FDD rating summarizing the overall financial health and risk profile of the target, used as a key input to the IC investment decision.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionDeficit rdf:type rdf:Property ;
    rdfs:label 'Pension Deficit' ;
    rdfs:comment 'Defined benefit pension scheme deficit identified during FDD, treated as a debt-like item in net debt reconciliation, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qoeFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Qoe Findings Summary' ;
    rdfs:comment 'Narrative summary of key QoE findings including revenue recognition practices, earnings sustainability, and material accounting policy concerns identified in FDD.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qoeRating rdf:type rdf:Property ;
    rdfs:label 'Qoe Rating' ;
    rdfs:comment 'FDD analyst\'s assessment of the quality and sustainability of the target\'s reported earnings, reflecting reliability of financial statements for investment decisions.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedEbitda rdf:type rdf:Property ;
    rdfs:label 'Reported Ebitda' ;
    rdfs:comment 'EBITDA as reported by management or derived from audited financials before any normalization adjustments, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedNetDebt rdf:type rdf:Property ;
    rdfs:label 'Reported Net Debt' ;
    rdfs:comment 'Net debt as reported by management (gross debt minus cash and cash equivalents) prior to FDD adjustments, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedRevenue rdf:type rdf:Property ;
    rdfs:label 'Reported Revenue' ;
    rdfs:comment 'Total revenue as reported in the target\'s audited financial statements for the most recent full fiscal year reviewed, in the FDD reporting currency.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueCagrPct rdf:type rdf:Property ;
    rdfs:label 'Revenue Cagr Pct' ;
    rdfs:comment 'Compound annual growth rate of the target\'s revenue over the FDD review period, expressed as a percentage, used to assess historical growth trajectory.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueConcentrationRisk rdf:type rdf:Property ;
    rdfs:label 'Revenue Concentration Risk' ;
    rdfs:comment 'Risk rating reflecting the degree of revenue concentration by customer, product, or geography identified during FDD, impacting earnings sustainability assessment.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signOffDate rdf:type rdf:Property ;
    rdfs:label 'Sign Off Date' ;
    rdfs:comment 'Date on which the lead FDD analyst or senior investment professional formally signed off on the completed FDD assessment for IC submission.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:taxStructureRisk rdf:type rdf:Property ;
    rdfs:label 'Tax Structure Risk' ;
    rdfs:comment 'FDD analyst\'s risk rating of the target\'s tax structure, including transfer pricing, deferred tax positions, and unresolved tax authority disputes.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyAdvisorFirm rdf:type rdf:Property ;
    rdfs:label 'Third Party Advisor Firm' ;
    rdfs:comment 'Name of the external accounting or advisory firm engaged to conduct or support the FDD (e.g., Big 4 accounting firm), if applicable.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thirdPartyReportDate rdf:type rdf:Property ;
    rdfs:label 'Third Party Report Date' ;
    rdfs:comment 'Date on which the external advisor issued the final FDD report, used to assess report currency and relevance at IC submission.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:workingCapitalFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Working Capital Findings Summary' ;
    rdfs:comment 'Narrative summary of working capital analysis findings including seasonality, cash conversion cycle, and any unusual movements identified during FDD.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workingCapitalPegBasis rdf:type rdf:Property ;
    rdfs:label 'Working Capital Peg Basis' ;
    rdfs:comment 'Methodology used to establish the normalized working capital peg in the SPA, determining the reference period for working capital adjustment at closing.' ;
    rdfs:domain ind:FddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cddAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Cdd Assessment Id' ;
    rdfs:comment 'Unique system-generated identifier for the Commercial Due Diligence (CDD) assessment record. Primary key for this entity.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advisorReportDate rdf:type rdf:Property ;
    rdfs:label 'Advisor Report Date' ;
    rdfs:comment 'Date on which the third-party CDD advisor delivered their final report, used to track timeliness of DD completion relative to IC submission deadlines.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cddScopeNotes rdf:type rdf:Property ;
    rdfs:label 'Cdd Scope Notes' ;
    rdfs:comment 'Narrative description of the scope, limitations, and key assumptions of the CDD assessment, including any areas excluded from scope or subject to information constraints.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitiveIntensity rdf:type rdf:Property ;
    rdfs:label 'Competitive Intensity' ;
    rdfs:comment 'Analyst-assigned rating of the overall competitive intensity in the target\'s market, reflecting pricing pressure, new entrant threat, and substitute product risk.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitiveMoatAssessment rdf:type rdf:Property ;
    rdfs:label 'Competitive Moat Assessment' ;
    rdfs:comment 'Analyst assessment of the durability and width of the target\'s competitive moat, including barriers to entry such as IP, switching costs, network effects, and regulatory licences.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:competitivePositionRating rdf:type rdf:Property ;
    rdfs:label 'Competitive Position Rating' ;
    rdfs:comment 'Assessment of the target entity\'s competitive standing within its primary market, reflecting market share, brand strength, pricing power, and differentiation.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractedRevenuePct rdf:type rdf:Property ;
    rdfs:label 'Contracted Revenue Pct' ;
    rdfs:comment 'Percentage of total revenue covered by long-term contracts or take-or-pay agreements, a key indicator of revenue predictability and downside protection.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:customerChurnRatePct rdf:type rdf:Property ;
    rdfs:label 'Customer Churn Rate Pct' ;
    rdfs:comment 'Annual customer attrition rate expressed as a percentage of total customers, used to assess revenue retention quality and commercial durability of the target.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgCommercialRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Commercial Risk Flag' ;
    rdfs:comment 'Indicates whether material ESG-related commercial risks (e.g., carbon transition risk, social licence to operate) were identified during the CDD assessment.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:growthStrategyAssessment rdf:type rdf:Property ;
    rdfs:label 'Growth Strategy Assessment' ;
    rdfs:comment 'Classification of the target\'s primary growth strategy as assessed during CDD, used to evaluate execution risk, capital requirements, and alignment with investment thesis.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyCommercialOpportunities rdf:type rdf:Property ;
    rdfs:label 'Key Commercial Opportunities' ;
    rdfs:comment 'Narrative summary of the primary commercial value creation opportunities identified during CDD, including market expansion, pricing improvement, and customer growth levers.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyCommercialRisks rdf:type rdf:Property ;
    rdfs:label 'Key Commercial Risks' ;
    rdfs:comment 'Narrative summary of the most material commercial risks identified during the CDD assessment, including market, competitive, customer, and regulatory risk factors.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:macroSensitivityRating rdf:type rdf:Property ;
    rdfs:label 'Macro Sensitivity Rating' ;
    rdfs:comment 'Assessment of the target\'s revenue and earnings sensitivity to macroeconomic variables (GDP, interest rates, inflation, FX), used in stress testing and LDI alignment.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketCycleStage rdf:type rdf:Property ;
    rdfs:label 'Market Cycle Stage' ;
    rdfs:comment 'Analyst assessment of the current stage of the target\'s market cycle at the time of CDD, informing entry timing, valuation, and macroeconomic sensitivity analysis.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketGrowthAssessment rdf:type rdf:Property ;
    rdfs:label 'Market Growth Assessment' ;
    rdfs:comment 'Qualitative classification of the target market\'s growth trajectory based on analyst assessment of structural drivers, cyclicality, and secular trends.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketGrowthRatePct rdf:type rdf:Property ;
    rdfs:label 'Market Growth Rate Pct' ;
    rdfs:comment 'Projected compound annual growth rate (CAGR) of the target\'s addressable market expressed as a percentage, used to assess long-term revenue trajectory and market tailwinds.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketSharePct rdf:type rdf:Property ;
    rdfs:label 'Market Share Pct' ;
    rdfs:comment 'Estimated percentage of the target\'s primary addressable market captured by the target entity, used to benchmark competitive position and revenue sustainability.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketSizeUsdMm rdf:type rdf:Property ;
    rdfs:label 'Market Size Usd Mm' ;
    rdfs:comment 'Estimated total addressable market (TAM) size in USD millions for the target\'s primary market, derived from third-party research and proprietary analysis.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfCompetitors rdf:type rdf:Property ;
    rdfs:label 'Number Of Competitors' ;
    rdfs:comment 'Count of direct competitors identified in the CDD competitive landscape analysis, used to assess market concentration and competitive intensity.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallCddRating rdf:type rdf:Property ;
    rdfs:label 'Overall Cdd Rating' ;
    rdfs:comment 'Composite qualitative rating summarising the overall commercial viability of the target investment based on all CDD workstreams, used in IC submission and investment decision.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingPowerAssessment rdf:type rdf:Property ;
    rdfs:label 'Pricing Power Assessment' ;
    rdfs:comment 'Analyst assessment of the target\'s ability to sustain or increase prices without material volume loss, reflecting brand strength, switching costs, and market position.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRiskRating rdf:type rdf:Property ;
    rdfs:label 'Regulatory Risk Rating' ;
    rdfs:comment 'Assessment of the regulatory risk exposure facing the target entity, including licensing requirements, sector-specific regulation, and potential for adverse regulatory change.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueBaseYear rdf:type rdf:Property ;
    rdfs:label 'Revenue Base Year' ;
    rdfs:comment 'The fiscal year used as the baseline for market size, revenue, and growth rate estimates in the CDD assessment, ensuring temporal consistency across analyses.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueVisibility rdf:type rdf:Property ;
    rdfs:label 'Revenue Visibility' ;
    rdfs:comment 'Classification of the target\'s revenue model by predictability and contractual certainty, informing cash flow forecasting and risk-adjusted return analysis.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplyChainRiskRating rdf:type rdf:Property ;
    rdfs:label 'Supply Chain Risk Rating' ;
    rdfs:comment 'Assessment of the target\'s exposure to supply chain disruption risk, including supplier concentration, geographic risk, and input cost volatility identified during CDD.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:top5CustomerConcentrationPct rdf:type rdf:Property ;
    rdfs:label 'Top 5 Customer Concentration Pct' ;
    rdfs:comment 'Combined revenue percentage attributable to the five largest customers, used to assess customer diversification risk and revenue resilience in the CDD analysis.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:topCustomerConcentrationPct rdf:type rdf:Property ;
    rdfs:label 'Top Customer Concentration Pct' ;
    rdfs:comment 'Revenue percentage attributable to the single largest customer, a key risk indicator for customer concentration and revenue sustainability in the CDD assessment.' ;
    rdfs:domain ind:CddAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgDdAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Esg Dd Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for the ESG due diligence assessment record within the diligence domain.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:climateStressScenarioId rdf:type rdf:Property ;
    rdfs:label 'Climate Stress Scenario Id' ;
    rdfs:comment 'Foreign key linking to risk.stress_scenario. Business justification: ESG DD requires TCFD-aligned climate scenario analysis. Product already has climate_transition_risk_rating and tcfd_disclosure_assessed - linking to stress_scenario enables formal' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:StressScenario .

ind:esgEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Esg Employee Id' ;
    rdfs:comment 'Internal analyst responsible for conducting and owning this ESG due diligence assessment.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:boardIndependencePct rdf:type rdf:Property ;
    rdfs:label 'Board Independence Pct' ;
    rdfs:comment 'Percentage of independent directors on the target entity\'s board of directors, a key governance quality indicator assessed during ESG DD.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:climateTransitionRiskRating rdf:type rdf:Property ;
    rdfs:label 'Climate Transition Risk Rating' ;
    rdfs:comment 'Assessment of the target entity\'s exposure to policy, technology, and market risks arising from the transition to a low-carbon economy per TCFD framework.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyDescription rdf:type rdf:Property ;
    rdfs:label 'Controversy Description' ;
    rdfs:comment 'Narrative description of identified ESG controversies, including nature, severity, and current resolution status, populated when controversy_flag is true.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controversyFlag rdf:type rdf:Property ;
    rdfs:label 'Controversy Flag' ;
    rdfs:comment 'Indicates whether the target entity has active or recent material ESG controversies (e.g., environmental violations, labor disputes, governance scandals) identified during DD.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Environmental Risk Rating' ;
    rdfs:comment 'Risk rating for the environmental dimension of the ESG assessment, covering climate, GHG emissions, biodiversity, water, and waste factors.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgConditionsPrecedent rdf:type rdf:Property ;
    rdfs:label 'Esg Conditions Precedent' ;
    rdfs:comment 'ESG-specific conditions that must be satisfied prior to investment close, such as adoption of an ESG policy, remediation of identified risks, or third-party certification.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgEngagementPlan rdf:type rdf:Property ;
    rdfs:label 'Esg Engagement Plan' ;
    rdfs:comment 'Description of planned post-investment ESG engagement actions and stewardship activities to address identified ESG risks and improvement opportunities.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyInPlace rdf:type rdf:Property ;
    rdfs:label 'Esg Policy In Place' ;
    rdfs:comment 'Indicates whether the target entity has a formal, documented ESG policy or responsible investment policy in place at the time of assessment.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgReportingStandard rdf:type rdf:Property ;
    rdfs:label 'Esg Reporting Standard' ;
    rdfs:comment 'Primary ESG reporting framework adopted by the target entity (e.g., GRI, SASB, TCFD, ISSB/IFRS S1/S2), indicating disclosure quality and comparability. [ENUM-REF-CANDIDATE: GRI|SASB|TCFD|ISSB|CDP|UNPRI|none|multiple — 8 candidates stripped; promote to' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgScoreProvider rdf:type rdf:Property ;
    rdfs:label 'Esg Score Provider' ;
    rdfs:comment 'Source or provider of the ESG score used in the assessment, distinguishing between internal proprietary scoring and third-party rating agencies. [ENUM-REF-CANDIDATE: internal|MSCI|Sustainalytics|ISS|Bloomberg|FTSE_Russell|proprietary — 7 candidates' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionListCheck rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Check' ;
    rdfs:comment 'Indicates whether the target entity has been screened against the fund\'s responsible investment exclusion list (e.g., weapons, tobacco, coal) per investment policy.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusionListResult rdf:type rdf:Property ;
    rdfs:label 'Exclusion List Result' ;
    rdfs:comment 'Outcome of the exclusion list screening: pass (no exclusion triggers), fail (investment prohibited), or conditional pass (subject to conditions or waivers).' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsYear rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Year' ;
    rdfs:comment 'The reporting year to which the GHG Scope 1, 2, and 3 emissions figures relate, enabling year-over-year trend analysis.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ghgScope1Emissions rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope1 Emissions' ;
    rdfs:comment 'Target entity\'s direct Scope 1 GHG emissions in tonnes of CO2 equivalent (tCO2e) as reported or estimated during the ESG DD process.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgScope2Emissions rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope2 Emissions' ;
    rdfs:comment 'Target entity\'s indirect Scope 2 GHG emissions from purchased energy in tCO2e as reported or estimated during the ESG DD process.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgScope3Emissions rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope3 Emissions' ;
    rdfs:comment 'Target entity\'s value chain Scope 3 GHG emissions in tCO2e where available, covering upstream and downstream indirect emissions.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:governanceRiskRating rdf:type rdf:Property ;
    rdfs:label 'Governance Risk Rating' ;
    rdfs:comment 'Risk rating for the governance dimension covering board composition, ownership structure, executive compensation, anti-corruption, and shareholder rights.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:humanRightsRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Human Rights Risk Flag' ;
    rdfs:comment 'Indicates whether material human rights risks were identified during the social dimension of the ESG DD, including supply chain labor and community impacts.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icEsgRecommendation rdf:type rdf:Property ;
    rdfs:label 'Ic Esg Recommendation' ;
    rdfs:comment 'ESG analyst\'s recommendation to the Investment Committee based on the assessment outcome, indicating whether to proceed with the investment from an ESG perspective.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyEsgRisksSummary rdf:type rdf:Property ;
    rdfs:label 'Key Esg Risks Summary' ;
    rdfs:comment 'Executive summary of the most material ESG risks identified during the assessment, used in the Investment Memorandum (IM) and IC submission package.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netZeroAlignment rdf:type rdf:Property ;
    rdfs:label 'Net Zero Alignment' ;
    rdfs:comment 'Assessment of whether the target entity\'s strategy and emissions trajectory are aligned with a net-zero by 2050 pathway per Paris Agreement commitments.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallEsgRating rdf:type rdf:Property ;
    rdfs:label 'Overall Esg Rating' ;
    rdfs:comment 'Composite ESG risk rating assigned at the conclusion of the assessment, summarizing environmental, social, and governance dimensions for IC reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:physicalClimateRiskRating rdf:type rdf:Property ;
    rdfs:label 'Physical Climate Risk Rating' ;
    rdfs:comment 'Assessment of the target entity\'s exposure to acute and chronic physical climate risks (e.g., flooding, extreme heat, sea-level rise) per TCFD framework.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sfdrArticleClassification rdf:type rdf:Property ;
    rdfs:label 'Sfdr Article Classification' ;
    rdfs:comment 'SFDR product classification of the investment or fund: Article 6 (no sustainability objective), Article 8 (promotes ESG), or Article 9 (sustainable investment objective).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:socialRiskRating rdf:type rdf:Property ;
    rdfs:label 'Social Risk Rating' ;
    rdfs:comment 'Risk rating for the social dimension covering labor practices, human rights, supply chain standards, health and safety, and community impact.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdDisclosureAssessed rdf:type rdf:Property ;
    rdfs:label 'Tcfd Disclosure Assessed' ;
    rdfs:comment 'Indicates whether the target entity\'s TCFD-aligned climate disclosure was reviewed and assessed as part of the ESG DD process.' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyEsgAdvisor rdf:type rdf:Property ;
    rdfs:label 'Third Party Esg Advisor' ;
    rdfs:comment 'Name of the external ESG advisory firm or specialist engaged to support the ESG DD assessment (e.g., ERM, Sustainalytics, specialist ESG consultants).' ;
    rdfs:domain ind:EsgDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalDdAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Legal Dd Assessment Id' ;
    rdfs:comment 'Unique surrogate identifier for the legal due diligence assessment record. Primary key for this entity. TRANSACTION_HEADER role.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:leadLegalCounselEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lead Legal Counsel Employee Id' ;
    rdfs:comment 'Reference to the internal legal counsel or external legal advisor leading the legal due diligence review.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:conditionsPrecedentIdentified rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent Identified' ;
    rdfs:comment 'Indicates whether legal conditions precedent to closing have been identified, including regulatory approvals, third-party consents, or restructuring steps required before investment completion.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:conditionsPrecedentSummary rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent Summary' ;
    rdfs:comment 'Summary of identified legal conditions precedent to closing, including required regulatory approvals, consent requirements, and outstanding restructuring steps.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corporateStructureFindings rdf:type rdf:Property ;
    rdfs:label 'Corporate Structure Findings' ;
    rdfs:comment 'Summary of key findings from the corporate structure review, including any structural complexities, offshore entities, or holding company arrangements identified.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corporateStructureReviewed rdf:type rdf:Property ;
    rdfs:label 'Corporate Structure Reviewed' ;
    rdfs:comment 'Indicates whether the corporate structure, ownership hierarchy, and entity formation documents of the target have been reviewed and verified as part of the legal DD.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataPrivacyFindings rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Findings' ;
    rdfs:comment 'Summary of data privacy and cybersecurity legal findings, including identified GDPR non-compliance, data breach history, or inadequate data processing agreements.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataPrivacyReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Data Privacy Review Status' ;
    rdfs:comment 'Status of the data privacy and cybersecurity legal review, assessing the target\'s compliance with applicable data protection regulations such as GDPR.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentFindings rdf:type rdf:Property ;
    rdfs:label 'Employment Findings' ;
    rdfs:comment 'Summary of employment and labour law findings, including identified unfunded pension liabilities, change-of-control clauses in executive contracts, or material employment disputes.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employmentReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Employment Review Status' ;
    rdfs:comment 'Status of the employment and labour law review covering key management contracts, collective bargaining agreements, pension obligations, and employment liability exposure.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalLegalAdvisor rdf:type rdf:Property ;
    rdfs:label 'External Legal Advisor' ;
    rdfs:comment 'Name of the external law firm engaged to conduct or support the legal due diligence review on behalf of the pension fund.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipFindings rdf:type rdf:Property ;
    rdfs:label 'Ip Findings' ;
    rdfs:comment 'Summary of findings from the IP review, including unregistered IP risks, licensing gaps, third-party IP claims, or freedom-to-operate concerns identified.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ipReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Ip Review Status' ;
    rdfs:comment 'Status of the intellectual property review covering ownership, registration, licensing, and freedom-to-operate of material IP assets held by the target.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalAdvisorReportReference rdf:type rdf:Property ;
    rdfs:label 'Legal Advisor Report Reference' ;
    rdfs:comment 'Document reference or data room identifier for the external legal advisor\'s formal legal DD report or legal opinion letter.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalRiskFlags rdf:type rdf:Property ;
    rdfs:label 'Legal Risk Flags' ;
    rdfs:comment 'Free-text summary of the most material legal risk flags identified across all workstreams, intended for Investment Committee (IC) briefing and investment memorandum (IM) inclusion.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalSignOffDate rdf:type rdf:Property ;
    rdfs:label 'Legal Sign Off Date' ;
    rdfs:comment 'Date on which the lead legal counsel formally signed off the legal DD assessment as complete and satisfactory for investment committee purposes.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:litigationFindings rdf:type rdf:Property ;
    rdfs:label 'Litigation Findings' ;
    rdfs:comment 'Summary of identified litigation, arbitration proceedings, regulatory investigations, or material threatened claims, including estimated financial exposure where disclosed.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:litigationReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Litigation Review Status' ;
    rdfs:comment 'Status of the litigation and dispute review, covering pending, threatened, and historical legal proceedings against the target entity.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaKeyTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Lpa Key Terms Summary' ;
    rdfs:comment 'Summary of material LPA terms reviewed, including hurdle rate, carried interest, clawback provisions, key-man clauses, no-fault divorce rights, and LP transfer restrictions.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaReviewed rdf:type rdf:Property ;
    rdfs:label 'Lpa Reviewed' ;
    rdfs:comment 'Indicates whether the Limited Partnership Agreement (LPA) has been reviewed for key terms including GP removal rights, LPAC governance, fee and carry provisions, and transfer restrictions.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialContractsFindings rdf:type rdf:Property ;
    rdfs:label 'Material Contracts Findings' ;
    rdfs:comment 'Summary of findings from the material contracts review, including identified change-of-control triggers, consent requirements, termination rights, and unusual commercial terms.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:materialContractsReviewed rdf:type rdf:Property ;
    rdfs:label 'Material Contracts Reviewed' ;
    rdfs:comment 'Indicates whether key commercial agreements (e.g., customer contracts, supplier agreements, joint ventures, licences) have been reviewed for change-of-control provisions and assignment restrictions.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:materialLitigationIdentified rdf:type rdf:Property ;
    rdfs:label 'Material Litigation Identified' ;
    rdfs:comment 'Indicates whether material litigation, arbitration, regulatory investigations, or threatened claims have been identified that could adversely affect the investment.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overallLegalRating rdf:type rdf:Property ;
    rdfs:label 'Overall Legal Rating' ;
    rdfs:comment 'Composite legal risk rating assigned by the lead legal counsel upon completion of the legal DD, summarising the aggregate legal risk profile of the target entity or transaction.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceFindings rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Findings' ;
    rdfs:comment 'Summary of findings from the regulatory compliance review, including identified licence gaps, regulatory breaches, pending enforcement actions, or AML/KYC deficiencies.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceReviewed rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Reviewed' ;
    rdfs:comment 'Indicates whether the target entity\'s regulatory licences, permits, and compliance with applicable laws (including AML, KYC, and sector-specific regulations) have been reviewed.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spaKeyTermsSummary rdf:type rdf:Property ;
    rdfs:label 'Spa Key Terms Summary' ;
    rdfs:comment 'Summary of material SPA terms including representations and warranties, indemnification caps, baskets, escrow arrangements, and conditions precedent to closing.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spaReviewed rdf:type rdf:Property ;
    rdfs:label 'Spa Reviewed' ;
    rdfs:comment 'Indicates whether the Share Purchase Agreement (SPA) or equivalent acquisition agreement has been reviewed for representations, warranties, indemnities, and conditions precedent.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:titleOwnershipFindings rdf:type rdf:Property ;
    rdfs:label 'Title Ownership Findings' ;
    rdfs:comment 'Summary of findings from the title and ownership verification, including any identified encumbrances, liens, pledges, or unresolved ownership disputes.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:titleOwnershipVerified rdf:type rdf:Property ;
    rdfs:label 'Title Ownership Verified' ;
    rdfs:comment 'Indicates whether title to the target assets and ownership interests have been verified as free and clear of undisclosed encumbrances, liens, or competing claims.' ;
    rdfs:domain ind:LegalDdAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:diligenceEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Diligence Employee Id' ;
    rdfs:comment 'Reference to the senior investment professional sponsoring and presenting this submission to the Investment Committee, accountable for the recommendation.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:diligenceLeadAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Diligence Lead Analyst Employee Id' ;
    rdfs:comment 'Reference to the lead analyst who conducted the due diligence and authored the Investment Memorandum (IM) supporting this IC submission.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:priorSubmissionDiligenceIcSubmissionId rdf:type rdf:Property ;
    rdfs:label 'Prior Submission Diligence Ic Submission Id' ;
    rdfs:comment 'Self-referencing identifier linking to the previous IC submission for the same deal or manager, enabling tracking of resubmissions and IC round history.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DiligenceIcSubmission .

ind:coInvestmentFlag rdf:type rdf:Property ;
    rdfs:label 'Co Investment Flag' ;
    rdfs:comment 'Indicates whether this IC submission relates to a co-investment opportunity alongside a GP, as distinct from a primary fund commitment or direct investment.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commitmentAmountBaseEquivalent rdf:type rdf:Property ;
    rdfs:label 'Commitment Amount Base Equivalent' ;
    rdfs:comment 'Recommended commitment amount converted to national Dollars (Base Currency) at the submission date FX rate, used for consolidated portfolio exposure and SAA compliance reporting.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icRound rdf:type rdf:Property ;
    rdfs:label 'Ic Round' ;
    rdfs:comment 'Sequential round number of this IC submission for the same deal or manager (e.g., 1 for initial submission, 2 for resubmission after deferral), tracking iterative IC review cycles.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:imVersion rdf:type rdf:Property ;
    rdfs:label 'Im Version' ;
    rdfs:comment 'Version number of the Investment Memorandum submitted with this IC package (e.g., v1.0, v2.3), tracking document revisions through the IC review process.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loiExecuted rdf:type rdf:Property ;
    rdfs:label 'Loi Executed' ;
    rdfs:comment 'Indicates whether a Letter of Intent (LOI) or term sheet has been executed with the target entity prior to IC submission, signaling advanced deal progression.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:portfolioWeightPct rdf:type rdf:Property ;
    rdfs:label 'Portfolio Weight Pct' ;
    rdfs:comment 'Proposed weight of this investment as a percentage of total fund AUM at the time of IC submission, used for concentration risk assessment and SAA compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recommendedCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Recommended Commitment Amount' ;
    rdfs:comment 'The gross capital commitment amount recommended by the investment team for IC approval, expressed in the commitment currency. Represents the proposed Paid-In Capital (PIC) obligation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saaAssetClassBucket rdf:type rdf:Property ;
    rdfs:label 'Saa Asset Class Bucket' ;
    rdfs:comment 'The SAA portfolio bucket to which this investment is allocated (e.g., Global Equities, Private Equity, Real Assets, Credit), used for SAA compliance monitoring and rebalancing.' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionReference rdf:type rdf:Property ;
    rdfs:label 'Submission Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code uniquely identifying this IC submission package, used in board governance systems and audit trails (e.g., IC-2024-00123).' ;
    rdfs:domain ind:DiligenceIcSubmission ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:diligenceIcConditionId rdf:type rdf:Property ;
    rdfs:label 'Diligence Ic Condition Id' ;
    rdfs:comment 'Unique surrogate identifier for an individual condition or requirement attached to an Investment Committee (IC) approval decision within the due diligence process.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownerAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Owner Analyst Employee Id' ;
    rdfs:comment 'Reference to the internal analyst or investment professional assigned as the primary owner accountable for tracking and driving resolution of this IC condition.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:riskAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Id' ;
    rdfs:comment 'Reference to the DD risk assessment record that informed the IC decision and gave rise to this condition.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RiskAssessment .

ind:actualResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Actual Resolution Date' ;
    rdfs:comment 'Date on which the IC condition was actually satisfied, waived, or formally closed, enabling resolution cycle time analysis and governance reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:conditionReference rdf:type rdf:Property ;
    rdfs:label 'Condition Reference' ;
    rdfs:comment 'Externally-known alphanumeric reference code uniquely identifying this IC condition, used in IC minutes, governance records, and Diligent/BoardEffect board documentation.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionSequence rdf:type rdf:Property ;
    rdfs:label 'Condition Sequence' ;
    rdfs:comment 'Ordinal sequence number of this condition within the set of conditions attached to the same IC decision, used for ordering in IC minutes and governance reports.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:extendedResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Extended Resolution Date' ;
    rdfs:comment 'Revised target resolution date if the original deadline was formally extended, capturing the approved extension for audit and governance tracking purposes.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icDecisionReference rdf:type rdf:Property ;
    rdfs:label 'Ic Decision Reference' ;
    rdfs:comment 'Reference number or identifier of the IC approval decision to which this condition is attached, linking back to the formal IC minutes or resolution document.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isConditionsPrecedent rdf:type rdf:Property ;
    rdfs:label 'Is Conditions Precedent' ;
    rdfs:comment 'Indicates whether this condition is a formal condition precedent (CP) that must be satisfied before capital can be committed or the transaction can close.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastReviewedBy rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed By' ;
    rdfs:comment 'Name or identifier of the analyst, compliance officer, or IC member who conducted the most recent formal review of this condition\'s status.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastReviewedDate rdf:type rdf:Property ;
    rdfs:label 'Last Reviewed Date' ;
    rdfs:comment 'Date on which this IC condition was most recently formally reviewed and its status updated by the responsible analyst or governance team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionEvidence rdf:type rdf:Property ;
    rdfs:label 'Resolution Evidence' ;
    rdfs:comment 'Description or reference to documentary evidence (e.g., signed SPA, legal opinion, KYC clearance certificate, ESG policy submission) confirming the condition has been satisfied.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responsiblePartyType rdf:type rdf:Property ;
    rdfs:label 'Responsible Party Type' ;
    rdfs:comment 'Classification of the party responsible for resolving the condition: internal analyst, legal counsel, external advisor, GP/manager, compliance, or finance team.' ;
    rdfs:domain ind:DiligenceIcCondition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetResolutionDate rdf:type rdf:Property ;
    rdfs:label 'Target Resolution Date' ;
    rdfs:comment 'Target date by which the responsible party must satisfy or resolve this IC condition, as agreed at the time of IC approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ndaRecordId rdf:type rdf:Property ;
    rdfs:label 'Nda Record Id' ;
    rdfs:comment 'Unique surrogate identifier for the NDA record within the diligence domain. Primary key for this entity.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:confidentialityScope rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Scope' ;
    rdfs:comment 'Narrative description of the scope of confidential information covered by the NDA, including categories of information (financial, operational, strategic) and any explicit exclusions.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyDomicile rdf:type rdf:Property ;
    rdfs:label 'Counterparty Domicile' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code representing the jurisdiction of incorporation or domicile of the counterparty, used for governing law and regulatory screening.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyType rdf:type rdf:Property ;
    rdfs:label 'Counterparty Type' ;
    rdfs:comment 'Classification of the counterparty entity type for the NDA, distinguishing between target companies, fund managers (GPs), intermediaries, advisors, co-investors, and lenders. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Expiry Date' ;
    rdfs:comment 'Date on which any exclusivity provision within the NDA expires. Null if no exclusivity clause is included. Critical for deal timeline management in the origination pipeline.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exclusivityIncluded rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Included' ;
    rdfs:comment 'Indicates whether the NDA includes an exclusivity clause granting the fund exclusive negotiation rights for a defined period, preventing the counterparty from engaging other buyers.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundSignatoryName rdf:type rdf:Property ;
    rdfs:label 'Fund Signatory Name' ;
    rdfs:comment 'Full name of the authorized signatory representing the pension fund who executed the NDA on behalf of the fund. Used for legal record and governance audit trail.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundSignatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Fund Signatory Title' ;
    rdfs:comment 'Job title or role of the authorized signatory from the pension fund who executed the NDA (e.g., Managing Director, General Counsel, Chief Investment Officer).' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawDetail rdf:type rdf:Property ;
    rdfs:label 'Governing Law Detail' ;
    rdfs:comment 'Specific governing law clause detail, including state or province where applicable (e.g., \'England and Wales\', \'New York, USA\') for precise legal enforceability.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycAmlScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Screening Required' ;
    rdfs:comment 'Indicates whether KYC/AML screening of the counterparty is required as a condition of or concurrent with NDA execution, per the fund\'s compliance policy.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalCounselInternal rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Internal' ;
    rdfs:comment 'Name of the internal legal counsel or legal team responsible for reviewing and approving the NDA on behalf of the pension fund.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nonSolicitIncluded rdf:type rdf:Property ;
    rdfs:label 'Non Solicit Included' ;
    rdfs:comment 'Indicates whether the NDA includes a non-solicitation clause restricting either party from soliciting the other\'s employees or clients during and after the evaluation period.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originationChannel rdf:type rdf:Property ;
    rdfs:label 'Origination Channel' ;
    rdfs:comment 'Channel through which the deal or manager relationship was originated, indicating whether the NDA arose from proprietary sourcing, an intermediary, a secondary market process, or an RFP.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:permittedUseDescription rdf:type rdf:Property ;
    rdfs:label 'Permitted Use Description' ;
    rdfs:comment 'Description of the permitted purposes for which confidential information may be used under the NDA, typically limited to evaluation of the specific investment opportunity.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalRequired rdf:type rdf:Property ;
    rdfs:label 'Renewal Required' ;
    rdfs:comment 'Indicates whether this NDA requires renewal prior to expiry to maintain confidentiality coverage for an ongoing due diligence or investment monitoring process.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsScreened rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screened' ;
    rdfs:comment 'Indicates whether the counterparty has been screened against applicable sanctions lists (OFAC, UN, EU) prior to or concurrent with NDA execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:standstillExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Standstill Expiry Date' ;
    rdfs:comment 'Date on which the standstill provision within the NDA expires, after which the fund may freely acquire securities of the counterparty. Null if no standstill provision exists.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:standstillIncluded rdf:type rdf:Property ;
    rdfs:label 'Standstill Included' ;
    rdfs:comment 'Indicates whether the NDA includes a standstill provision restricting the fund from acquiring securities of the counterparty for a defined period. Relevant for public equity transactions.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:supersededByAgreement rdf:type rdf:Property ;
    rdfs:label 'Superseded By Agreement' ;
    rdfs:comment 'Reference to the definitive agreement (e.g., Share Purchase Agreement (SPA), Limited Partnership Agreement (LPA), or ISDA Master Agreement) that supersedes this NDA upon deal execution.' ;
    rdfs:domain ind:NdaRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataRoomAccessId rdf:type rdf:Property ;
    rdfs:label 'Data Room Access Id' ;
    rdfs:comment 'Unique surrogate identifier for a virtual data room (VDR) access record within a due diligence engagement.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Access Expiry Date' ;
    rdfs:comment 'Date on which the VDR access is scheduled to expire. After this date, the investment team can no longer access documents unless access is extended.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accessExtensionCount rdf:type rdf:Property ;
    rdfs:label 'Access Extension Count' ;
    rdfs:comment 'Number of times the VDR access expiry date has been extended. Repeated extensions may indicate deal complexity or delays in the DD process.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accessGrantDate rdf:type rdf:Property ;
    rdfs:label 'Access Grant Date' ;
    rdfs:comment 'Date on which access to the virtual data room was formally granted to the investment team. Marks the start of the document review period.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accessNotes rdf:type rdf:Property ;
    rdfs:label 'Access Notes' ;
    rdfs:comment 'Free-text notes recorded by the DD team regarding the VDR access, such as access limitations, counterparty restrictions, or document quality observations.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessReference rdf:type rdf:Property ;
    rdfs:label 'Access Reference' ;
    rdfs:comment 'Unique business reference code assigned to this VDR access grant, used for tracking and audit purposes across the DD lifecycle.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessRevocationDate rdf:type rdf:Property ;
    rdfs:label 'Access Revocation Date' ;
    rdfs:comment 'Date on which VDR access was revoked prior to the scheduled expiry, typically upon deal termination, NDA breach, or completion of the DD process.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accessStatus rdf:type rdf:Property ;
    rdfs:label 'Access Status' ;
    rdfs:comment 'Current lifecycle status of the VDR access grant. Active indicates current access; expired indicates the access period has lapsed; revoked indicates early termination.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessType rdf:type rdf:Property ;
    rdfs:label 'Access Type' ;
    rdfs:comment 'Level of access permissions granted within the VDR, controlling whether users can view only, download documents, or have full access including printing.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accessUserCount rdf:type rdf:Property ;
    rdfs:label 'Access User Count' ;
    rdfs:comment 'Number of internal investment team members provisioned with access to this VDR. Used for access governance and information security monitoring.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advisorAccessGranted rdf:type rdf:Property ;
    rdfs:label 'Advisor Access Granted' ;
    rdfs:comment 'Indicates whether the third-party advisor has been granted access to the VDR in addition to the internal investment team.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:documentCategories rdf:type rdf:Property ;
    rdfs:label 'Document Categories' ;
    rdfs:comment 'Comma-separated list of document category folders available in the VDR (e.g., Financial Statements, Legal Agreements, ESG Reports, Management Presentations).' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentCount rdf:type rdf:Property ;
    rdfs:label 'Document Count' ;
    rdfs:comment 'Total number of documents available in the VDR at the time of access grant. Provides a baseline for tracking document completeness during the DD process.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentsDownloadedCount rdf:type rdf:Property ;
    rdfs:label 'Documents Downloaded Count' ;
    rdfs:comment 'Cumulative number of documents downloaded from the VDR by the investment team. Tracked for information security audit and NDA compliance purposes.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentsViewedCount rdf:type rdf:Property ;
    rdfs:label 'Documents Viewed Count' ;
    rdfs:comment 'Cumulative number of distinct documents viewed by the investment team within this VDR access grant. Indicates DD thoroughness and document review progress.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:downloadEnabled rdf:type rdf:Property ;
    rdfs:label 'Download Enabled' ;
    rdfs:comment 'Indicates whether downloading of documents is permitted for users with this access grant. Restricted access may allow viewing only without download capability.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgDocumentsAvailable rdf:type rdf:Property ;
    rdfs:label 'Esg Documents Available' ;
    rdfs:comment 'Indicates whether ESG-related documents (e.g., sustainability reports, GHG disclosures, governance policies) are available in the VDR for ESG DD review.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialStatementsAvailable rdf:type rdf:Property ;
    rdfs:label 'Financial Statements Available' ;
    rdfs:comment 'Indicates whether audited financial statements are available in the VDR, a prerequisite for Financial Due Diligence (FDD) workstream completion.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:grantedBy rdf:type rdf:Property ;
    rdfs:label 'Granted By' ;
    rdfs:comment 'Name or identifier of the individual (typically the deal lead or DD coordinator) who authorized and provisioned the VDR access for the investment team.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycAmlDocumentsAvailable rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Documents Available' ;
    rdfs:comment 'Indicates whether KYC/AML documentation (e.g., ownership structure, beneficial ownership, source of funds) is available in the VDR for compliance review.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastAccessedDate rdf:type rdf:Property ;
    rdfs:label 'Last Accessed Date' ;
    rdfs:comment 'Most recent date on which a member of the investment team accessed the VDR. Used to monitor engagement activity and identify stale or inactive access grants.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalDocumentsAvailable rdf:type rdf:Property ;
    rdfs:label 'Legal Documents Available' ;
    rdfs:comment 'Indicates whether key legal documents (e.g., LPA, SPA, constitutional documents, material contracts) are available in the VDR for legal DD review.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingDocumentRequests rdf:type rdf:Property ;
    rdfs:label 'Outstanding Document Requests' ;
    rdfs:comment 'Number of document requests submitted to the target entity via the VDR that remain unfulfilled. Tracks information gaps in the DD process.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:printEnabled rdf:type rdf:Property ;
    rdfs:label 'Print Enabled' ;
    rdfs:comment 'Indicates whether printing of documents is permitted for users with this access grant. Controlled to limit physical distribution of confidential deal materials.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revocationReason rdf:type rdf:Property ;
    rdfs:label 'Revocation Reason' ;
    rdfs:comment 'Reason for early revocation of VDR access. Supports audit trail and compliance reporting on information security and deal lifecycle management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vdrPlatform rdf:type rdf:Property ;
    rdfs:label 'Vdr Platform' ;
    rdfs:comment 'Name of the virtual data room platform hosting the DD documents (e.g., Intralinks, Datasite, Ansarada). Determines integration and access protocols.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vdrRoomCode rdf:type rdf:Property ;
    rdfs:label 'Vdr Room Code' ;
    rdfs:comment 'Platform-assigned unique identifier for the data room instance, used for API integration and cross-referencing with the VDR platform\'s own records.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vdrRoomName rdf:type rdf:Property ;
    rdfs:label 'Vdr Room Name' ;
    rdfs:comment 'Name of the specific data room instance on the VDR platform, typically reflecting the target entity or deal name. Treated as confidential deal information.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vdrUrl rdf:type rdf:Property ;
    rdfs:label 'Vdr Url' ;
    rdfs:comment 'Web URL for accessing the virtual data room. Classified as confidential as it provides direct access to sensitive deal documents under NDA.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watermarkingEnabled rdf:type rdf:Property ;
    rdfs:label 'Watermarking Enabled' ;
    rdfs:comment 'Indicates whether document watermarking is enabled in the VDR to deter unauthorized distribution and support document traceability.' ;
    rdfs:domain ind:DataRoomAccess ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementInterviewId rdf:type rdf:Property ;
    rdfs:label 'Management Interview Id' ;
    rdfs:comment 'Unique surrogate identifier for a management interview or reference check record within the due diligence process.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managerContactId rdf:type rdf:Property ;
    rdfs:label 'Manager Contact Id' ;
    rdfs:comment 'Foreign key linking to manager.manager_contact. Business justification: Management interviews must link to specific GP contacts interviewed. This supports key person clause monitoring, tracks interview history per individual, and enables cross-referencing' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ManagerContact .

ind:additionalAttendees rdf:type rdf:Property ;
    rdfs:label 'Additional Attendees' ;
    rdfs:comment 'Names and roles of other internal team members or advisors who attended the interview, recorded for completeness of the DD audit trail.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:durationMinutes rdf:type rdf:Property ;
    rdfs:label 'Duration Minutes' ;
    rdfs:comment 'Actual duration of the interview or reference check in minutes, used to assess depth of engagement and completeness of coverage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Esg Findings Summary' ;
    rdfs:comment 'Summary of ESG-related findings from the interview, including management\'s approach to climate risk, governance practices, and responsible investment integration.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgTopicsDiscussed rdf:type rdf:Property ;
    rdfs:label 'Esg Topics Discussed' ;
    rdfs:comment 'Indicates whether Environmental, Social, and Governance (ESG) topics were explicitly discussed during the interview, supporting ESG DD completeness tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpDescription rdf:type rdf:Property ;
    rdfs:label 'Follow Up Description' ;
    rdfs:comment 'Description of the specific follow-up actions required, including outstanding questions, additional document requests, or further interviews needed.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewFormat rdf:type rdf:Property ;
    rdfs:label 'Interview Format' ;
    rdfs:comment 'The medium through which the interview was conducted: in-person meeting, video call, phone call, or written questionnaire response.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewLocation rdf:type rdf:Property ;
    rdfs:label 'Interview Location' ;
    rdfs:comment 'Physical location or virtual platform where the interview took place (e.g., target HQ city, office address, or video platform name for remote sessions).' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewReference rdf:type rdf:Property ;
    rdfs:label 'Interview Reference' ;
    rdfs:comment 'Unique human-readable reference code for this interview or reference check record, used for tracking and cross-referencing in IC submissions and DD reports.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewSequence rdf:type rdf:Property ;
    rdfs:label 'Interview Sequence' ;
    rdfs:comment 'Sequential number of this interview within the DD engagement, indicating whether it is the first, second, or subsequent session with the target or referee.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interviewStatus rdf:type rdf:Property ;
    rdfs:label 'Interview Status' ;
    rdfs:comment 'Current lifecycle status of the interview: scheduled, completed, cancelled, rescheduled, or pending notes/write-up after completion.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewType rdf:type rdf:Property ;
    rdfs:label 'Interview Type' ;
    rdfs:comment 'Classification of the engagement: formal management interview with target, on-site visit, third-party reference check, expert network call, or advisor debrief.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervieweeName rdf:type rdf:Property ;
    rdfs:label 'Interviewee Name' ;
    rdfs:comment 'Full name of the primary individual interviewed (management representative) or the referee providing a reference check response.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervieweeOrganization rdf:type rdf:Property ;
    rdfs:label 'Interviewee Organization' ;
    rdfs:comment 'Name of the organization the interviewee represents. For reference checks, this is the referee\'s employer, not the target entity.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervieweeRelationship rdf:type rdf:Property ;
    rdfs:label 'Interviewee Relationship' ;
    rdfs:comment 'Nature of the interviewee\'s relationship to the target entity, critical for assessing objectivity and relevance of information provided. [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intervieweeTitle rdf:type rdf:Property ;
    rdfs:label 'Interviewee Title' ;
    rdfs:comment 'Professional title or role of the interviewee at their organization (e.g., CEO, CFO, Head of Risk, Portfolio Manager).' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyFindings rdf:type rdf:Property ;
    rdfs:label 'Key Findings' ;
    rdfs:comment 'Analyst\'s summary of the most significant insights, observations, and conclusions drawn from the interview relevant to the investment decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementQualityAssessment rdf:type rdf:Property ;
    rdfs:label 'Management Quality Assessment' ;
    rdfs:comment 'Narrative assessment of management team quality, depth, experience, and alignment of interests based on the interview, feeding into the DD risk assessment management quality score.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notesCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Notes Completed Date' ;
    rdfs:comment 'Date on which the interview notes or write-up were finalized and submitted, used for DD timeline tracking.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:notesCompletedFlag rdf:type rdf:Property ;
    rdfs:label 'Notes Completed Flag' ;
    rdfs:comment 'Indicates whether the formal interview notes or write-up have been completed and submitted by the lead analyst.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overallImpressionRating rdf:type rdf:Property ;
    rdfs:label 'Overall Impression Rating' ;
    rdfs:comment 'Analyst\'s qualitative rating of the overall impression from the interview, used to inform the management quality score in the DD risk assessment.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordingConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Recording Consent Obtained' ;
    rdfs:comment 'Indicates whether explicit consent was obtained from the interviewee to record the session, required for compliance with privacy regulations.' ;
    rdfs:domain ind:ManagementInterview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refereeSourcedBy rdf:type rdf:Property ;
    rdfs:label 'Referee Sourced By' ;
    rdfs:comment 'How the referee or interviewee was identified: analyst-sourced independently, provided by the GP/target, via third-party advisor, expert network, or internal network. Indicates potential bias.' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledStartTime rdf:type rdf:Property ;
    rdfs:label 'Scheduled Start Time' ;
    rdfs:comment 'Precise date and time the interview is scheduled to begin, including timezone offset, for calendar coordination across geographies.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:topicsCovered rdf:type rdf:Property ;
    rdfs:label 'Topics Covered' ;
    rdfs:comment 'Summary of the key subject areas and agenda items discussed during the interview (e.g., investment process, risk management, team stability, ESG integration).' ;
    rdfs:domain ind:Diligence ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceCheckId rdf:type rdf:Property ;
    rdfs:label 'Reference Check Id' ;
    rdfs:comment 'Unique surrogate identifier for the reference check record within the diligence domain.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interviewerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Interviewer Employee Id' ;
    rdfs:comment 'Internal identifier of the investment team analyst or associate who conducted the reference check interview.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:checkDate rdf:type rdf:Property ;
    rdfs:label 'Check Date' ;
    rdfs:comment 'Date on which the reference check conversation or interview was conducted with the referee.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:checkReference rdf:type rdf:Property ;
    rdfs:label 'Check Reference' ;
    rdfs:comment 'Unique human-readable business identifier for the reference check, used for tracking and cross-referencing in IC submissions and DD reports.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkStatus rdf:type rdf:Property ;
    rdfs:label 'Check Status' ;
    rdfs:comment 'Current lifecycle status of the reference check, tracking progress from planning through completion or cancellation.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:checkType rdf:type rdf:Property ;
    rdfs:label 'Check Type' ;
    rdfs:comment 'Category of reference check indicating whether it covers a target company management team member, GP investment professional, co-investor, or other party. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityRequested rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Requested' ;
    rdfs:comment 'Indicates whether the referee requested that their identity be kept confidential and not disclosed to the subject or third parties.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgConcernsNoted rdf:type rdf:Property ;
    rdfs:label 'Esg Concerns Noted' ;
    rdfs:comment 'Indicates whether the reference check surfaced any Environmental, Social, or Governance concerns about the subject, feeding into ESG DD and responsible investment assessment.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:followUpNotes rdf:type rdf:Property ;
    rdfs:label 'Follow Up Notes' ;
    rdfs:comment 'Description of required follow-up actions, open questions, or additional investigation steps identified as a result of this reference check.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:integrityRating rdf:type rdf:Property ;
    rdfs:label 'Integrity Rating' ;
    rdfs:comment 'Referee\'s assessment of the subject\'s integrity and ethical conduct, a critical dimension in ODD for institutional investors.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewDurationMinutes rdf:type rdf:Property ;
    rdfs:label 'Interview Duration Minutes' ;
    rdfs:comment 'Duration of the reference check interview in minutes, providing context for the depth and thoroughness of the reference conversation.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interviewMethod rdf:type rdf:Property ;
    rdfs:label 'Interview Method' ;
    rdfs:comment 'Mode by which the reference check interview was conducted: phone call, video conference, in-person meeting, or written questionnaire.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interviewerName rdf:type rdf:Property ;
    rdfs:label 'Interviewer Name' ;
    rdfs:comment 'Full name of the internal analyst or investment professional who conducted the reference check, for audit and IC submission purposes.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentAcumenRating rdf:type rdf:Property ;
    rdfs:label 'Investment Acumen Rating' ;
    rdfs:comment 'Referee\'s assessment of the subject\'s investment judgment, deal sourcing capability, and track record quality, relevant for GP and management team evaluations.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyFeedbackSummary rdf:type rdf:Property ;
    rdfs:label 'Key Feedback Summary' ;
    rdfs:comment 'Narrative summary of the most significant feedback provided by the referee, capturing key strengths, concerns, and notable observations for IC and DD report inclusion.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadershipRating rdf:type rdf:Property ;
    rdfs:label 'Leadership Rating' ;
    rdfs:comment 'Referee\'s qualitative assessment of the subject\'s leadership capabilities, team management, and strategic decision-making effectiveness.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallRating rdf:type rdf:Property ;
    rdfs:label 'Overall Rating' ;
    rdfs:comment 'Consolidated qualitative rating summarizing the overall outcome of the reference check, used in DD risk assessment and IC submission materials.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redFlagsDescription rdf:type rdf:Property ;
    rdfs:label 'Red Flags Description' ;
    rdfs:comment 'Detailed narrative description of any red flags or material concerns identified during the reference check, required when red_flags_noted is True.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:redFlagsNoted rdf:type rdf:Property ;
    rdfs:label 'Red Flags Noted' ;
    rdfs:comment 'Boolean flag indicating whether the reference check surfaced any material red flags, concerns, or adverse findings requiring escalation or further investigation.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refereeConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Referee Consent Obtained' ;
    rdfs:comment 'Confirms that the referee provided informed consent for their feedback to be recorded and used in the DD process, required under GDPR and applicable privacy regulations.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refereeContactEmail rdf:type rdf:Property ;
    rdfs:label 'Referee Contact Email' ;
    rdfs:comment 'Professional email address of the referee, used for follow-up correspondence and audit trail. Classified as restricted PII per GDPR.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refereeContactPhone rdf:type rdf:Property ;
    rdfs:label 'Referee Contact Phone' ;
    rdfs:comment 'Direct phone number of the referee for scheduling and follow-up. Classified as restricted PII per GDPR and applicable privacy regulations.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refereeName rdf:type rdf:Property ;
    rdfs:label 'Referee Name' ;
    rdfs:comment 'Full name of the individual who provided the reference. Treated as confidential to protect the referee\'s identity in IC and reporting contexts.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refereeOrganization rdf:type rdf:Property ;
    rdfs:label 'Referee Organization' ;
    rdfs:comment 'Name of the organization where the referee is currently employed or was employed during their relationship with the subject.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refereeRelationship rdf:type rdf:Property ;
    rdfs:label 'Referee Relationship' ;
    rdfs:comment 'Nature of the professional relationship between the referee and the subject being referenced, critical for assessing objectivity and relevance of feedback.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:refereeTitle rdf:type rdf:Property ;
    rdfs:label 'Referee Title' ;
    rdfs:comment 'Professional title or designation of the referee at the time of the reference check (e.g., CFO, Managing Partner, Head of Infrastructure).' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipDurationYears rdf:type rdf:Property ;
    rdfs:label 'Relationship Duration Years' ;
    rdfs:comment 'Approximate number of years the referee has known or worked with the subject, providing context for the depth and relevance of the reference.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subjectName rdf:type rdf:Property ;
    rdfs:label 'Subject Name' ;
    rdfs:comment 'Full name of the individual being referenced — typically a management team member of the target company or an investment professional at the GP being evaluated.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectOrganization rdf:type rdf:Property ;
    rdfs:label 'Subject Organization' ;
    rdfs:comment 'Name of the organization where the subject individual is employed or was previously employed at the time of the reference check.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectTitle rdf:type rdf:Property ;
    rdfs:label 'Subject Title' ;
    rdfs:comment 'Professional title or role of the individual being referenced (e.g., CEO, Managing Director, Portfolio Manager) at the target entity.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wouldWorkAgain rdf:type rdf:Property ;
    rdfs:label 'Would Work Again' ;
    rdfs:comment 'Referee\'s response to whether they would work with or invest alongside the subject again, a standard qualitative indicator in institutional ODD reference checks.' ;
    rdfs:domain ind:ReferenceCheck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddDocumentId rdf:type rdf:Property ;
    rdfs:label 'Dd Document Id' ;
    rdfs:comment 'Unique surrogate identifier for a due diligence document record in the metadata registry.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByDocumentDdDocumentId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Document Dd Document Id' ;
    rdfs:comment 'Reference to the newer document record that supersedes this version, enabling document version chain tracking.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DdDocument .

ind:documentCurrency rdf:type rdf:Property ;
    rdfs:label 'Document Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code of the primary currency used in the document (e.g., USD, GBP, EUR).' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentSummary rdf:type rdf:Property ;
    rdfs:label 'Document Summary' ;
    rdfs:comment 'Brief analyst-authored summary of the document\'s key content, findings, or relevance to the DD engagement.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isFinalVersion rdf:type rdf:Property ;
    rdfs:label 'Is Final Version' ;
    rdfs:comment 'Indicates whether this document represents the final, authoritative version superseding all prior drafts.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isIcRelevant rdf:type rdf:Property ;
    rdfs:label 'Is Ic Relevant' ;
    rdfs:comment 'Indicates whether this document is designated as material evidence for the Investment Committee (IC) submission package.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isNdaRequired rdf:type rdf:Property ;
    rdfs:label 'Is Nda Required' ;
    rdfs:comment 'Indicates whether a signed NDA is required before this document may be accessed or distributed.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:originatingPartyName rdf:type rdf:Property ;
    rdfs:label 'Originating Party Name' ;
    rdfs:comment 'Name of the entity that produced or provided the document (e.g., target company, GP, external advisor, legal counsel, auditor).' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originatingPartyType rdf:type rdf:Property ;
    rdfs:label 'Originating Party Type' ;
    rdfs:comment 'Classification of the party that produced the document, distinguishing internal from external sources. [ENUM-REF-CANDIDATE: target_company|GP|external_advisor|legal_counsel|auditor|regulator|internal — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Reporting Period End' ;
    rdfs:comment 'End date of the financial or operational reporting period covered by the document.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportingPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Reporting Period Start' ;
    rdfs:comment 'Start date of the financial or operational reporting period covered by the document (e.g., for audited financials or management accounts).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskRelevanceRating rdf:type rdf:Property ;
    rdfs:label 'Risk Relevance Rating' ;
    rdfs:comment 'Analyst assessment of the degree to which this document\'s content is material to the overall DD risk assessment.' ;
    rdfs:domain ind:DdDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ddStatusEventId rdf:type rdf:Property ;
    rdfs:label 'Dd Status Event Id' ;
    rdfs:comment 'Unique surrogate identifier for each DD status transition event record in the audit trail.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:triggeredByAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Triggered By Analyst Employee Id' ;
    rdfs:comment 'Identifier of the internal analyst or user who manually triggered this status transition. Null when the transition was system-initiated.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:escalatedTo rdf:type rdf:Property ;
    rdfs:label 'Escalated To' ;
    rdfs:comment 'Name or role of the senior stakeholder, committee, or governance body to whom this status event was escalated (e.g., IC Sponsor, Chief Investment Officer, Investment Committee).' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escalationFlag rdf:type rdf:Property ;
    rdfs:label 'Escalation Flag' ;
    rdfs:comment 'Indicates whether this status event was accompanied by a formal escalation to senior management, the IC sponsor, or the Investment Committee due to a critical finding or risk.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:eventReference rdf:type rdf:Property ;
    rdfs:label 'Event Reference' ;
    rdfs:comment 'Human-readable unique reference code for this status event, used in audit reports and IC governance documentation (e.g., DDSE-2024-000123).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventScope rdf:type rdf:Property ;
    rdfs:label 'Event Scope' ;
    rdfs:comment 'Indicates whether this status event applies to the overall DD engagement or to a specific workstream within the engagement.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMilestoneEvent rdf:type rdf:Property ;
    rdfs:label 'Is Milestone Event' ;
    rdfs:comment 'Indicates whether this status transition represents a key DD lifecycle milestone (e.g., initiation, IC submission readiness, completion) for reporting and governance dashboards.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newStatus rdf:type rdf:Property ;
    rdfs:label 'New Status' ;
    rdfs:comment 'The status of the DD engagement or workstream after this transition event. Represents the current state post-transition. [ENUM-REF-CANDIDATE: not_started|in_progress|on_hold|pending_ic|pending_information|completed|terminated|waived|escalated — promote to' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:onHoldReason rdf:type rdf:Property ;
    rdfs:label 'On Hold Reason' ;
    rdfs:comment 'Reason the DD engagement or workstream was placed on hold, captured when new_status is on_hold (e.g., pending NDA execution, awaiting data room access, counterparty unresponsive).' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStatus rdf:type rdf:Property ;
    rdfs:label 'Prior Status' ;
    rdfs:comment 'The status of the DD engagement or workstream immediately before this transition event. Null for the initial status assignment. [ENUM-REF-CANDIDATE: not_started|in_progress|on_hold|pending_ic|pending_information|completed|terminated|waived|escalated —' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorStatusDurationDays rdf:type rdf:Property ;
    rdfs:label 'Prior Status Duration Days' ;
    rdfs:comment 'Number of calendar days the DD engagement or workstream remained in the prior status before this transition. Used for SLA monitoring and DD cycle time analytics.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourceSystemEventRef rdf:type rdf:Property ;
    rdfs:label 'Source System Event Ref' ;
    rdfs:comment 'The native event or transaction identifier from the originating source system (e.g., eFront workflow event ID), enabling traceability back to the system of record.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredByAnalystName rdf:type rdf:Property ;
    rdfs:label 'Triggered By Analyst Name' ;
    rdfs:comment 'Display name of the internal analyst or user who triggered this status transition, captured at the time of the event for audit immutability.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredBySystem rdf:type rdf:Property ;
    rdfs:label 'Triggered By System' ;
    rdfs:comment 'Name of the operational system that automatically triggered this status transition (e.g., eFront workflow engine, Dealpath pipeline update). Null for manually triggered events.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeredByType rdf:type rdf:Property ;
    rdfs:label 'Triggered By Type' ;
    rdfs:comment 'Indicates the category of actor or mechanism that triggered the status transition: an analyst, an IC decision, an automated system process, the external manager, a third-party advisor, or a compliance control.' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:triggeringEventDescription rdf:type rdf:Property ;
    rdfs:label 'Triggering Event Description' ;
    rdfs:comment 'Free-text narrative describing the specific business event, decision, or condition that caused this status transition (e.g., IC approval received, data room access granted, critical finding identified).' ;
    rdfs:domain ind:DdStatusEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Flag' ;
    rdfs:comment 'Indicates whether this status event involved the approval of a waiver for an outstanding DD item or condition, allowing the engagement to progress despite an unresolved finding.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycAmlRecordId rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Record Id' ;
    rdfs:comment 'Unique system-generated identifier for the KYC/AML screening record. Primary key for this entity. Role: TRANSACTION_HEADER.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Compliance Officer Employee Id' ;
    rdfs:comment 'Reference to the compliance officer responsible for reviewing and approving this KYC/AML screening record and its final determination.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:kycComplianceOfficerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Kyc Compliance Officer Employee Id' ;
    rdfs:comment 'Reference to the compliance officer responsible for reviewing and approving this KYC/AML screening record and its final determination.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:kycEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Kyc Employee Id' ;
    rdfs:comment 'Reference to the internal analyst or compliance officer who initiated this KYC/AML screening request.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:adverseMediaFlag rdf:type rdf:Property ;
    rdfs:label 'Adverse Media Flag' ;
    rdfs:comment 'Indicates whether adverse media screening identified negative news coverage related to financial crime, fraud, corruption, or regulatory violations for the subject.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:adverseMediaSummary rdf:type rdf:Property ;
    rdfs:label 'Adverse Media Summary' ;
    rdfs:comment 'Brief narrative summary of adverse media findings identified during screening, including nature of allegations and source references. Null if no adverse media found.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlRiskScore rdf:type rdf:Property ;
    rdfs:label 'Aml Risk Score' ;
    rdfs:comment 'Quantitative AML risk score assigned to the subject by the screening model or third-party provider, on a standardized scale used for risk-tiering decisions.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:beneficialOwnerVerified rdf:type rdf:Property ;
    rdfs:label 'Beneficial Owner Verified' ;
    rdfs:comment 'Indicates whether the ultimate beneficial owner(s) (UBO) of the subject entity have been identified and verified per the applicable ownership threshold (typically 25%).' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Compliance Approval Date' ;
    rdfs:comment 'Date on which the compliance officer formally approved the KYC/AML screening outcome, marking the completion of the compliance sign-off process.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:eddCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Edd Completed Date' ;
    rdfs:comment 'Date on which Enhanced Due Diligence (EDD) was completed for this subject, applicable when EDD was required. Null if EDD was not required.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:enhancedDueDiligenceRequired rdf:type rdf:Property ;
    rdfs:label 'Enhanced Due Diligence Required' ;
    rdfs:comment 'Indicates whether Enhanced Due Diligence (EDD) is required for this subject based on risk rating, PEP status, sanctions proximity, or high-risk jurisdiction.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highRiskJurisdictionFlag rdf:type rdf:Property ;
    rdfs:label 'High Risk Jurisdiction Flag' ;
    rdfs:comment 'Indicates whether the subject is domiciled in or primarily operates from a FATF-identified high-risk or non-cooperative jurisdiction, triggering enhanced scrutiny.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:identityVerificationMethod rdf:type rdf:Property ;
    rdfs:label 'Identity Verification Method' ;
    rdfs:comment 'Method used to verify the identity of the subject, such as document review, third-party database check, official registry search, or electronic verification.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallKycAmlOutcome rdf:type rdf:Property ;
    rdfs:label 'Overall Kyc Aml Outcome' ;
    rdfs:comment 'Final determination of the KYC/AML screening process, indicating whether the subject is cleared for onboarding, cleared with conditions, escalated, or rejected.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepCategory rdf:type rdf:Property ;
    rdfs:label 'Pep Category' ;
    rdfs:comment 'Classification of the PEP designation: domestic, foreign, international organisation PEP, or close associate, per FATF R.12 taxonomy.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepFlag rdf:type rdf:Property ;
    rdfs:label 'Pep Flag' ;
    rdfs:comment 'Indicates whether the subject or a beneficial owner has been identified as a Politically Exposed Person (PEP), triggering enhanced due diligence requirements.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:periodicReviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Periodic Review Frequency' ;
    rdfs:comment 'Frequency at which this subject\'s KYC/AML record must be periodically refreshed, determined by the assigned risk rating and regulatory requirements.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordReference rdf:type rdf:Property ;
    rdfs:label 'Record Reference' ;
    rdfs:comment 'Externally-visible business reference code for this KYC/AML screening record, used in correspondence, audit trails, and regulatory submissions.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsHitFlag rdf:type rdf:Property ;
    rdfs:label 'Sanctions Hit Flag' ;
    rdfs:comment 'Indicates whether the subject returned a positive match against any sanctions list (OFAC, UN, EU, or other applicable lists) during screening.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sanctionsListMatched rdf:type rdf:Property ;
    rdfs:label 'Sanctions List Matched' ;
    rdfs:comment 'Name(s) of the specific sanctions list(s) on which the subject returned a match (e.g., OFAC SDN, UN Consolidated, EU Consolidated). Null if no match.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningCompletedDate rdf:type rdf:Property ;
    rdfs:label 'Screening Completed Date' ;
    rdfs:comment 'Calendar date on which the KYC/AML screening was concluded and a final determination was reached, used for SLA and regulatory timeliness tracking.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningInitiatedDate rdf:type rdf:Property ;
    rdfs:label 'Screening Initiated Date' ;
    rdfs:comment 'Calendar date on which the KYC/AML screening process was formally initiated, marking the start of the compliance clock for regulatory timeliness requirements.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:screeningProvider rdf:type rdf:Property ;
    rdfs:label 'Screening Provider' ;
    rdfs:comment 'Name of the third-party screening provider or internal system used to conduct the KYC/AML checks (e.g., Refinitiv World-Check, Dow Jones Risk, LexisNexis).' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningProviderReference rdf:type rdf:Property ;
    rdfs:label 'Screening Provider Reference' ;
    rdfs:comment 'Unique reference or case number assigned by the third-party screening provider for this screening event, used for audit trail and provider reconciliation.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:screeningStatus rdf:type rdf:Property ;
    rdfs:label 'Screening Status' ;
    rdfs:comment 'Current lifecycle status of the KYC/AML screening process for this record, driving workflow routing and onboarding gate decisions.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceOfFundsDescription rdf:type rdf:Property ;
    rdfs:label 'Source Of Funds Description' ;
    rdfs:comment 'Narrative description of the verified source of funds or wealth for the subject, documenting the basis for the fund origin determination.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceOfFundsVerified rdf:type rdf:Property ;
    rdfs:label 'Source Of Funds Verified' ;
    rdfs:comment 'Indicates whether the source of funds or wealth for the subject has been verified as part of the KYC/AML process, required for high-risk and PEP subjects.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subjectDomicileCountry rdf:type rdf:Property ;
    rdfs:label 'Subject Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the subject\'s country of domicile or incorporation, used for jurisdiction risk assessment and sanctions screening.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectLegalName rdf:type rdf:Property ;
    rdfs:label 'Subject Legal Name' ;
    rdfs:comment 'Full registered legal name of the entity or individual being screened, as per official incorporation documents or government-issued identification.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectLei rdf:type rdf:Property ;
    rdfs:label 'Subject Lei' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier (LEI) of the subject being screened, used for global entity identification and regulatory reporting.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectOperatingCountry rdf:type rdf:Property ;
    rdfs:label 'Subject Operating Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the primary country where the subject conducts its principal business operations, which may differ from domicile.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Subject Registration Number' ;
    rdfs:comment 'Official corporate registration or incorporation number issued by the relevant national registry for the subject entity, used for identity verification.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subjectType rdf:type rdf:Property ;
    rdfs:label 'Subject Type' ;
    rdfs:comment 'Category of the entity being screened: counterparty, target company, external fund manager, beneficial owner, co-investor, custodian, or service provider. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:uboOwnershipThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Ubo Ownership Threshold Pct' ;
    rdfs:comment 'Ownership percentage threshold applied to identify ultimate beneficial owners (UBOs) for this screening, typically 25% per FATF standards.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:watchlistMatchFlag rdf:type rdf:Property ;
    rdfs:label 'Watchlist Match Flag' ;
    rdfs:comment 'Indicates whether the subject matched any internal or external watchlist beyond formal sanctions lists, such as internal restricted counterparty lists.' ;
    rdfs:domain ind:KycAmlRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ddAdvisorCostId rdf:type rdf:Property ;
    rdfs:label 'Dd Advisor Cost Id' ;
    rdfs:comment 'Unique identifier for the advisor cost record.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ddAdvisorEngagementId rdf:type rdf:Property ;
    rdfs:label 'Dd Advisor Engagement Id' ;
    rdfs:comment 'Identifier of the advisor engagement associated with this cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AdvisorEngagement .

ind:accruedAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Amount' ;
    rdfs:comment 'Amount accrued to date for the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costAccrualDate rdf:type rdf:Property ;
    rdfs:label 'Cost Accrual Date' ;
    rdfs:comment 'Date when the cost was accrued.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Cost Approval Date' ;
    rdfs:comment 'Date when the cost was approved.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Approval Status' ;
    rdfs:comment 'Approval status of the cost record.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Cost Approved By' ;
    rdfs:comment 'Name of the approver for the cost record.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCategory rdf:type rdf:Property ;
    rdfs:label 'Cost Category' ;
    rdfs:comment 'Classification of the cost item.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costCurrencyRate rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Rate' ;
    rdfs:comment 'Exchange rate used for currency conversion.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costCurrencyRateDate rdf:type rdf:Property ;
    rdfs:label 'Cost Currency Rate Date' ;
    rdfs:comment 'Date of the exchange rate applied.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costDate rdf:type rdf:Property ;
    rdfs:label 'Cost Date' ;
    rdfs:comment 'Date of the cost event.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costDescription rdf:type rdf:Property ;
    rdfs:label 'Cost Description' ;
    rdfs:comment 'Detailed description of the cost item.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costEndDate rdf:type rdf:Property ;
    rdfs:label 'Cost End Date' ;
    rdfs:comment 'End date of the cost period.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costInvoiceDate rdf:type rdf:Property ;
    rdfs:label 'Cost Invoice Date' ;
    rdfs:comment 'Date of the invoice for the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costInvoiceNumber rdf:type rdf:Property ;
    rdfs:label 'Cost Invoice Number' ;
    rdfs:comment 'Invoice number issued for the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costInvoicedDate rdf:type rdf:Property ;
    rdfs:label 'Cost Invoiced Date' ;
    rdfs:comment 'Date when the cost was invoiced.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costNotes rdf:type rdf:Property ;
    rdfs:label 'Cost Notes' ;
    rdfs:comment 'Free-text notes related to the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPaidDate rdf:type rdf:Property ;
    rdfs:label 'Cost Paid Date' ;
    rdfs:comment 'Date when the cost was paid.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Cost Payment Date' ;
    rdfs:comment 'Date when the payment was processed.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costPaymentMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Payment Method' ;
    rdfs:comment 'Method used to pay the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costPaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Payment Status' ;
    rdfs:comment 'Status of the payment for the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costStartDate rdf:type rdf:Property ;
    rdfs:label 'Cost Start Date' ;
    rdfs:comment 'Start date of the cost period.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:costStatus rdf:type rdf:Property ;
    rdfs:label 'Cost Status' ;
    rdfs:comment 'Current status of the cost line item.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Tax Amount' ;
    rdfs:comment 'Tax amount applied to the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costTaxCode rdf:type rdf:Property ;
    rdfs:label 'Cost Tax Code' ;
    rdfs:comment 'Tax code used for the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costTaxRate rdf:type rdf:Property ;
    rdfs:label 'Cost Tax Rate' ;
    rdfs:comment 'Tax rate applied to the cost.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costType rdf:type rdf:Property ;
    rdfs:label 'Cost Type' ;
    rdfs:comment 'Fee structure type for the advisor engagement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:createdAt rdf:type rdf:Property ;
    rdfs:label 'Created At' ;
    rdfs:comment 'Timestamp when the cost record was first created.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ddAdvisorCostStatus rdf:type rdf:Property ;
    rdfs:label 'Dd Advisor Cost Status' ;
    rdfs:comment 'Current lifecycle status of the cost record.' ;
    rdfs:domain ind:DdAdvisorCost ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reference rdf:type rdf:Property ;
    rdfs:label 'Reference' ;
    rdfs:comment 'Human-readable reference for the advisor cost record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedAt rdf:type rdf:Property ;
    rdfs:label 'Updated At' ;
    rdfs:comment 'Timestamp of the most recent update to the cost record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assessmentId rdf:type rdf:Property ;
    rdfs:label 'Assessment Id' ;
    rdfs:comment 'Primary key for the assessment association' ;
    rdfs:domain ind:Assessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:applicabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Applicability Status' ;
    rdfs:comment 'Indicates whether the compliance rule applies to this specific DD engagement based on asset class, geography, and entity type. Some rules only apply to certain engagement types.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceRating rdf:type rdf:Property ;
    rdfs:label 'Compliance Rating' ;
    rdfs:comment 'Outcome rating of the compliance assessment indicating whether the DD engagement satisfies the requirements of the specific rule.' ;
    rdfs:domain ind:Assessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyId rdf:type rdf:Property ;
    rdfs:label 'Strategy Id' ;
    rdfs:comment 'Foreign key linking to manager.strategy. Business justification: gp_profile.primary_strategy is a string that duplicates strategy information; replacing it with a FK to strategy.strategy_id normalizes the data and removes redundancy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Strategy .

ind:adoptionDate rdf:type rdf:Property ;
    rdfs:label 'Adoption Date' ;
    rdfs:comment 'Date on which the GP formally adopted or committed to this ESG framework. Used to assess maturity of ESG integration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedMandateTypes rdf:type rdf:Property ;
    rdfs:label 'Approved Mandate Types' ;
    rdfs:comment 'Comma-separated list of mandate types for which this GP is approved (e.g., LP fund commitment, co-investment, SMA, advisory). Constrains permissible transaction types in the deal pipeline.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aumReportingDate rdf:type rdf:Property ;
    rdfs:label 'Aum Reporting Date' ;
    rdfs:comment 'Date as of which the reported AUM figure was calculated or disclosed by the GP. Required to assess data currency and staleness for manager monitoring purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:aumUsd rdf:type rdf:Property ;
    rdfs:label 'Aum Usd' ;
    rdfs:comment 'Total Assets Under Management (AUM) reported by the GP firm in USD as of the most recent reporting date. Key sizing metric for manager selection, capacity constraints, and peer benchmarking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificationStatus rdf:type rdf:Property ;
    rdfs:label 'Certification Status' ;
    rdfs:comment 'Status of formal certification or verification under this framework: certified (valid certification), pending (certification in progress), expired (certification lapsed), not_applicable (framework does not offer certification).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Co Invest Rights Flag' ;
    rdfs:comment 'Indicates whether the pension fund has secured co-investment rights with this GP, enabling direct participation in individual deals alongside the fund. Key for deal origination pipeline.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:complianceLevel rdf:type rdf:Property ;
    rdfs:label 'Compliance Level' ;
    rdfs:comment 'Current level of GP compliance with the framework requirements: full (meets all requirements), partial (meets some requirements), non_compliant (does not meet requirements), in_progress (actively working toward compliance).' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dryPowderUsd rdf:type rdf:Property ;
    rdfs:label 'Dry Powder Usd' ;
    rdfs:comment 'Total uncalled committed capital (Dry Powder) available to the GP across all active funds in USD. Indicates deployment capacity and competitive positioning for new deal origination.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:efrontManagerCode rdf:type rdf:Property ;
    rdfs:label 'Efront Manager Code' ;
    rdfs:comment 'Unique manager identifier within the eFront private markets portfolio monitoring system, which serves as the operational system of record for private fund investment data and GP reporting.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firmFoundedYear rdf:type rdf:Property ;
    rdfs:label 'Firm Founded Year' ;
    rdfs:comment 'Calendar year in which the GP firm was established. Used to assess organizational maturity, track record length, and key-person risk in manager due diligence.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:lastAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Assessment Date' ;
    rdfs:comment 'Date of the most recent compliance assessment or review conducted by the pension fund or external assessor for this GP-framework combination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:managerRiskRating rdf:type rdf:Property ;
    rdfs:label 'Manager Risk Rating' ;
    rdfs:comment 'Internal risk rating assigned to the GP based on operational, financial, regulatory, and reputational risk assessment. Used for monitoring frequency tiering and mandate eligibility gating.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerStatus rdf:type rdf:Property ;
    rdfs:label 'Manager Status' ;
    rdfs:comment 'Current lifecycle status of the GP relationship within the pension fund\'s approved manager universe. Drives eligibility for new mandates and capital commitments.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerType rdf:type rdf:Property ;
    rdfs:label 'Manager Type' ;
    rdfs:comment 'Classification of the external manager relationship: General Partner (GP), sub-advisor, Fund-of-Funds (FoF) manager, co-investment manager, or Separately Managed Account (SMA) manager.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalDueDiligenceDate rdf:type rdf:Property ;
    rdfs:label 'Operational Due Diligence Date' ;
    rdfs:comment 'Date on which the most recent Operational Due Diligence (ODD) review was completed for this GP. Tracks compliance with the pension fund\'s periodic ODD refresh policy.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pitchbookManagerCode rdf:type rdf:Property ;
    rdfs:label 'Pitchbook Manager Code' ;
    rdfs:comment 'Unique manager identifier assigned by PitchBook, used for cross-referencing GP data, fund performance benchmarks, and deal flow analytics from the PitchBook platform.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLpTermsFlag rdf:type rdf:Property ;
    rdfs:label 'Preferred Lp Terms Flag' ;
    rdfs:comment 'Indicates whether the pension fund has negotiated preferred LP terms (e.g., reduced management fees, enhanced co-investment rights, MFN clause) with this GP. Drives fee administration and mandate tracking.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preqinManagerCode rdf:type rdf:Property ;
    rdfs:label 'Preqin Manager Code' ;
    rdfs:comment 'Unique manager identifier assigned by Preqin, the primary external market intelligence source for private markets manager data. Enables automated data enrichment and benchmarking feeds.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationCountry rdf:type rdf:Property ;
    rdfs:label 'Registration Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction where the GP firm is incorporated or registered. May differ from domicile for tax-efficient structures (e.g., Cayman Islands).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRegistrationNumber rdf:type rdf:Property ;
    rdfs:label 'Regulatory Registration Number' ;
    rdfs:comment 'Primary regulatory registration or licence number issued by the GP\'s home regulator (e.g., SEC CRD number, FCA FRN registration). Required for KYC and counterparty onboarding.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipInceptionDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Inception Date' ;
    rdfs:comment 'Date on which the pension fund first established a formal investment relationship with this GP (first capital commitment or mandate execution). Measures relationship tenure for loyalty and negotiation leverage.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:relationshipTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Relationship Termination Date' ;
    rdfs:comment 'Date on which the pension fund formally terminated its investment relationship with this GP. Null for active relationships. Used for historical manager universe reporting and post-mortem analysis.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:subStrategy rdf:type rdf:Property ;
    rdfs:label 'Sub Strategy' ;
    rdfs:comment 'More granular strategy classification within the primary asset class (e.g., large-cap buyout, core-plus real estate, greenfield infrastructure, direct lending). Used for portfolio diversification analysis.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tcfdAlignedFlag rdf:type rdf:Property ;
    rdfs:label 'Tcfd Aligned Flag' ;
    rdfs:comment 'Indicates whether the GP firm\'s reporting is aligned with TCFD recommendations for climate-related financial disclosures. Required for pension fund\'s climate risk stewardship obligations.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:trackRecordYears rdf:type rdf:Property ;
    rdfs:label 'Track Record Years' ;
    rdfs:comment 'Number of years of audited investment performance track record available for the GP firm. Minimum track record thresholds are defined in the pension fund\'s manager selection policy.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vintageYearFirst rdf:type rdf:Property ;
    rdfs:label 'Vintage Year First' ;
    rdfs:comment 'Earliest vintage year of a fund managed by the GP for which performance track record data is available. Defines the start of the GP\'s measurable investment history for IRR and MOIC benchmarking.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vintageYearLatest rdf:type rdf:Property ;
    rdfs:label 'Vintage Year Latest' ;
    rdfs:comment 'Most recent vintage year of a fund managed by the GP. Used to assess recency of deployment activity and alignment with current market cycle positioning.' ;
    rdfs:domain ind:GpProfile ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:icApprovalIcDecisionId rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Ic Decision Id' ;
    rdfs:comment 'Reference to the Investment Committee approval record that authorized this mandate. Links to the IC governance record in Diligent/BoardEffect.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcDecision .

ind:icDecisionId rdf:type rdf:Property ;
    rdfs:label 'Ic Decision Id' ;
    rdfs:comment 'Reference to the Investment Committee approval record that authorized this mandate. Links to the IC governance record in Diligent/BoardEffect.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IcDecision .

ind:investmentStrategyId rdf:type rdf:Property ;
    rdfs:label 'Investment Strategy Id' ;
    rdfs:comment 'Foreign key linking to manager.strategy. Business justification: manager_mandate.investment_strategy is a string that duplicates strategy information; replacing it with a FK to strategy.strategy_id normalizes the data and removes redundancy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Strategy .

ind:managerBenchmarkId rdf:type rdf:Property ;
    rdfs:label 'Manager Benchmark Id' ;
    rdfs:comment 'Reference to the performance benchmark assigned to this mandate (e.g., MSCI World, CPI+4%, Cambridge Associates PE Benchmark). Used for TWR/MWR attribution and GIPS-compliant reporting.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ManagerBenchmark .

ind:coInvestmentRights rdf:type rdf:Property ;
    rdfs:label 'Co Investment Rights' ;
    rdfs:comment 'Indicates whether the mandate agreement grants the pension fund co-investment rights alongside the GP\'s fund investments. Co-invest rights are a key negotiated term for large LP commitments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governingLawCountry rdf:type rdf:Property ;
    rdfs:label 'Governing Law Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction whose laws govern the mandate agreement (e.g., CAN, USA, GBR, LUX). Critical for legal enforceability and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastOddReviewDate rdf:type rdf:Property ;
    rdfs:label 'Last Odd Review Date' ;
    rdfs:comment 'Date of the most recent Operational Due Diligence (ODD) review conducted on the external manager for this mandate. Drives scheduling of next review per internal ODD policy.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lpAdvisoryCommitteeSeat rdf:type rdf:Property ;
    rdfs:label 'Lp Advisory Committee Seat' ;
    rdfs:comment 'Indicates whether the pension fund holds a seat on the LP Advisory Committee (LPAC) for this fund mandate, granting governance rights over conflicts of interest and valuation matters.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:maxAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Max Allocation Pct' ;
    rdfs:comment 'Maximum permissible portfolio weight for this mandate per investment guidelines. Breach triggers a compliance alert. Expressed as a decimal fraction of total AUM.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:maxExtensionYears rdf:type rdf:Property ;
    rdfs:label 'Max Extension Years' ;
    rdfs:comment 'Maximum number of years by which the mandate term can be extended under the contractual extension option. Typically 1 or 2 years for PE/RE/Infrastructure LP funds.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:minAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Min Allocation Pct' ;
    rdfs:comment 'Minimum permissible portfolio weight for this mandate per investment guidelines. Breach triggers a rebalancing review. Expressed as a decimal fraction of total AUM.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextOddReviewDate rdf:type rdf:Property ;
    rdfs:label 'Next Odd Review Date' ;
    rdfs:comment 'Scheduled date for the next Operational Due Diligence (ODD) review of the external manager. Determined by manager risk rating and internal ODD review cycle policy.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:referenceCode rdf:type rdf:Property ;
    rdfs:label 'Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this mandate across internal systems (SimCorp, eFront, Dealpath). Used in counterparty correspondence and regulatory reporting.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaReportingBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Sla Reporting Breach Flag' ;
    rdfs:comment 'Indicates whether the external manager is currently in breach of contractual SLA reporting obligations (e.g., late quarterly reports, missing capital account statements). Triggers manager oversight review.' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Target Allocation Pct' ;
    rdfs:comment 'Target portfolio weight for this mandate expressed as a decimal fraction of total AUM (e.g., 0.025 = 2.5%). Used in SAA compliance monitoring and rebalancing triggers.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termExtensionOption rdf:type rdf:Property ;
    rdfs:label 'Term Extension Option' ;
    rdfs:comment 'Indicates whether the LPA or SMA agreement includes an option to extend the mandate term beyond the initial expiry date (typically 1+1 year extensions for PE funds).' ;
    rdfs:domain ind:ManagerMandate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rfpId rdf:type rdf:Property ;
    rdfs:label 'Rfp Id' ;
    rdfs:comment 'Unique system-generated identifier for each Request for Proposal or Request for Information issued to external managers during the manager selection process.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rfp .

ind:awardTargetDate rdf:type rdf:Property ;
    rdfs:label 'Award Target Date' ;
    rdfs:comment 'Target date by which the RFP evaluation is expected to conclude and a mandate award decision is expected to be communicated to the selected manager.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:closedDate rdf:type rdf:Property ;
    rdfs:label 'Closed Date' ;
    rdfs:comment 'The actual date on which the RFP process was formally closed, either through award, cancellation, or withdrawal. Null if still active.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:distributionChannel rdf:type rdf:Property ;
    rdfs:label 'Distribution Channel' ;
    rdfs:comment 'Channel through which the RFP was distributed to prospective managers: directly, via investment consultant, through an intermediary, public tender, or manager platform.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRequirement rdf:type rdf:Property ;
    rdfs:label 'Esg Requirement' ;
    rdfs:comment 'Specifies whether ESG (Environmental, Social, and Governance) integration by the responding manager is mandatory, preferred, or not required for this mandate.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationStartDate rdf:type rdf:Property ;
    rdfs:label 'Evaluation Start Date' ;
    rdfs:comment 'The date on which the formal evaluation and scoring of received manager responses commences following the response deadline.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gipsComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Gips Compliance Required' ;
    rdfs:comment 'Indicates whether responding managers are required to be compliant with CFA Institute Global Investment Performance Standards (GIPS) for performance reporting.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:kycAmlRequired rdf:type rdf:Property ;
    rdfs:label 'Kyc Aml Required' ;
    rdfs:comment 'Indicates whether responding managers must demonstrate Know Your Customer (KYC) and Anti-Money Laundering (AML) compliance as part of the RFP eligibility criteria.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mandateSize rdf:type rdf:Property ;
    rdfs:label 'Mandate Size' ;
    rdfs:comment 'Indicative capital commitment or mandate size being sought through this RFP, expressed in the mandate currency. Confidential as it reveals investment sizing intentions.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minStrategyAum rdf:type rdf:Property ;
    rdfs:label 'Min Strategy Aum' ;
    rdfs:comment 'Minimum AUM specifically in the target strategy (not total firm AUM) required for a manager to be eligible to respond to this RFP.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minTrackRecordYears rdf:type rdf:Property ;
    rdfs:label 'Min Track Record Years' ;
    rdfs:comment 'Minimum number of years of audited performance track record required from responding managers for the relevant strategy to be considered eligible.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ndaRequired rdf:type rdf:Property ;
    rdfs:label 'Nda Required' ;
    rdfs:comment 'Indicates whether a signed Non-Disclosure Agreement (NDA) is required from prospective managers before they may access the full RFP documentation.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responseDeadline rdf:type rdf:Property ;
    rdfs:label 'Response Deadline' ;
    rdfs:comment 'The deadline by which prospective managers must submit their responses to the RFP or RFI. Responses received after this date are typically disqualified.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:responsesReceived rdf:type rdf:Property ;
    rdfs:label 'Responses Received' ;
    rdfs:comment 'Total count of manager responses received by the response deadline. Used to assess market interest and competitiveness of the RFP process.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rfpStatus rdf:type rdf:Property ;
    rdfs:label 'Rfp Status' ;
    rdfs:comment 'Current lifecycle status of the RFP. Tracks progression from drafting through issuance, evaluation, and final award or cancellation. [ENUM-REF-CANDIDATE: draft|issued|under_review|shortlisted|awarded|cancelled|closed — promote to reference product]' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rfpType rdf:type rdf:Property ;
    rdfs:label 'Rfp Type' ;
    rdfs:comment 'Classifies the solicitation document type: RFP (Request for Proposal), RFI (Request for Information), RFQ (Request for Quotation), or DDQ (Due Diligence Questionnaire).' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortlistedCount rdf:type rdf:Property ;
    rdfs:label 'Shortlisted Count' ;
    rdfs:comment 'Number of managers advanced to the shortlist stage following initial screening and evaluation of RFP responses.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sourcingOrigin rdf:type rdf:Property ;
    rdfs:label 'Sourcing Origin' ;
    rdfs:comment 'Indicates how this RFP was initiated: proactively by the investment team, reactively in response to an inbound manager pitch, consultant-recommended, board-directed, or regulatory-driven.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyDescription rdf:type rdf:Property ;
    rdfs:label 'Strategy Description' ;
    rdfs:comment 'Detailed narrative describing the investment strategy, mandate scope, and return objectives being sought through this RFP, as communicated to prospective managers.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAumMax rdf:type rdf:Property ;
    rdfs:label 'Target Aum Max' ;
    rdfs:comment 'Maximum AUM threshold for responding managers, used to screen for boutique or capacity-constrained managers where strategy capacity is a consideration.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetAumMin rdf:type rdf:Property ;
    rdfs:label 'Target Aum Min' ;
    rdfs:comment 'Minimum Assets Under Management (AUM) threshold required of responding managers to qualify for consideration, expressed in the mandate currency.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightEsg rdf:type rdf:Property ;
    rdfs:label 'Weight Esg' ;
    rdfs:comment 'Percentage weight assigned to the ESG Integration criterion in the RFP evaluation scoring framework, reflecting the importance of responsible investment practices.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightFees rdf:type rdf:Property ;
    rdfs:label 'Weight Fees' ;
    rdfs:comment 'Percentage weight assigned to the Fee Structure criterion in the RFP evaluation scoring framework, covering management fees, carried interest, and total expense ratios.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightInvestmentProcess rdf:type rdf:Property ;
    rdfs:label 'Weight Investment Process' ;
    rdfs:comment 'Percentage weight assigned to the Investment Process criterion in the RFP evaluation scoring framework. All evaluation weights must sum to 100%.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightOperationalDd rdf:type rdf:Property ;
    rdfs:label 'Weight Operational Dd' ;
    rdfs:comment 'Percentage weight assigned to the Operational Due Diligence (ODD) criterion, covering back-office infrastructure, compliance, cybersecurity, and business continuity.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightRiskManagement rdf:type rdf:Property ;
    rdfs:label 'Weight Risk Management' ;
    rdfs:comment 'Percentage weight assigned to the Risk Management Framework criterion in the RFP evaluation scoring framework, covering VaR, drawdown controls, and risk governance.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightTeamExperience rdf:type rdf:Property ;
    rdfs:label 'Weight Team Experience' ;
    rdfs:comment 'Percentage weight assigned to the Team and Key Personnel Experience criterion in the RFP evaluation scoring framework.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightTrackRecord rdf:type rdf:Property ;
    rdfs:label 'Weight Track Record' ;
    rdfs:comment 'Percentage weight assigned to the Performance Track Record criterion in the RFP evaluation scoring framework, reflecting historical returns and consistency.' ;
    rdfs:domain ind:Rfp ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rfpResponseId rdf:type rdf:Property ;
    rdfs:label 'Rfp Response Id' ;
    rdfs:comment 'Unique surrogate identifier for each manager\'s formal response to an RFP. Primary key of the rfp_response product.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aumAtSubmissionUsd rdf:type rdf:Property ;
    rdfs:label 'Aum At Submission Usd' ;
    rdfs:comment 'Total AUM reported by the manager at the time of RFP response submission in USD, used to assess manager scale and operational capacity.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgPolicyDisclosed rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Disclosed' ;
    rdfs:comment 'Indicates whether the manager disclosed a formal ESG (Environmental, Social, and Governance) policy or responsible investment framework in their RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:evaluationLead rdf:type rdf:Property ;
    rdfs:label 'Evaluation Lead' ;
    rdfs:comment 'Name or identifier of the internal investment professional designated as the lead evaluator for this RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationNotes rdf:type rdf:Property ;
    rdfs:label 'Evaluation Notes' ;
    rdfs:comment 'Free-text internal commentary and qualitative observations recorded by the evaluation team regarding the manager\'s RFP response, strengths, weaknesses, and concerns.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeCompetitivenessScore rdf:type rdf:Property ;
    rdfs:label 'Fee Competitiveness Score' ;
    rdfs:comment 'Sub-score assigned by the internal team assessing the competitiveness and alignment of the proposed fee schedule relative to market benchmarks and peer managers.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icPresentationRequired rdf:type rdf:Property ;
    rdfs:label 'Ic Presentation Required' ;
    rdfs:comment 'Indicates whether this RFP response has been escalated to require a formal presentation to the Investment Committee (IC) as part of the manager selection process.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investmentMeritScore rdf:type rdf:Property ;
    rdfs:label 'Investment Merit Score' ;
    rdfs:comment 'Sub-score assigned by the internal team assessing the investment thesis, strategy quality, and return potential of the proposed mandate.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyPersonnelCount rdf:type rdf:Property ;
    rdfs:label 'Key Personnel Count' ;
    rdfs:comment 'Number of key investment professionals (partners, managing directors, portfolio managers) disclosed in the team composition section of the RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managementFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Management Fee Rate Bps' ;
    rdfs:comment 'Annual management fee rate proposed by the manager expressed in basis points (bps) on committed or invested capital, as stated in the RFP response.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallEvaluationScore rdf:type rdf:Property ;
    rdfs:label 'Overall Evaluation Score' ;
    rdfs:comment 'Composite evaluation score assigned by the internal manager selection team to this RFP response, aggregating scores across all evaluation criteria dimensions.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorFundCount rdf:type rdf:Property ;
    rdfs:label 'Prior Fund Count' ;
    rdfs:comment 'Number of prior funds or strategies managed by the GP in the same asset class and strategy type, as disclosed in the RFP response track record section.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:proposedCommitmentUsd rdf:type rdf:Property ;
    rdfs:label 'Proposed Commitment Usd' ;
    rdfs:comment 'The specific capital commitment amount proposed or requested from the pension fund in USD, as stated in the manager\'s RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedFundSizeUsd rdf:type rdf:Property ;
    rdfs:label 'Proposed Fund Size Usd' ;
    rdfs:comment 'Total target fund size proposed by the manager in USD, representing the aggregate capital the manager intends to raise for the strategy.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proposedStrategyDescription rdf:type rdf:Property ;
    rdfs:label 'Proposed Strategy Description' ;
    rdfs:comment 'Detailed narrative description of the proposed investment strategy, including investment thesis, target sectors, geographies, and value creation approach as stated by the manager.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:proposedStrategyName rdf:type rdf:Property ;
    rdfs:label 'Proposed Strategy Name' ;
    rdfs:comment 'Name of the investment strategy proposed by the manager in their RFP response (e.g., \'Global Infrastructure Equity Fund IV\', \'Senior Secured Credit Strategy\').' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Response Document Reference' ;
    rdfs:comment 'Document management system reference or URL pointing to the manager\'s full RFP response submission package stored in the deal management platform.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:responseReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Response Reference Number' ;
    rdfs:comment 'Externally assigned or manager-generated reference number for this RFP response submission, used for correspondence and audit trail purposes.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:shortlistRecommendation rdf:type rdf:Property ;
    rdfs:label 'Shortlist Recommendation' ;
    rdfs:comment 'Indicates whether the internal evaluation team has recommended this manager\'s RFP response for advancement to the shortlist stage of the selection process.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:strategyAumUsd rdf:type rdf:Property ;
    rdfs:label 'Strategy Aum Usd' ;
    rdfs:comment 'AUM specifically attributable to the proposed strategy or asset class at the time of submission, distinct from the manager\'s total firm-wide AUM.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategyType rdf:type rdf:Property ;
    rdfs:label 'Strategy Type' ;
    rdfs:comment 'Sub-classification of the proposed strategy (e.g., buyout, venture, core, value-add, opportunistic, direct lending, mezzanine, co-invest, FoF, SMA). [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:submissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Submission Timestamp' ;
    rdfs:comment 'Precise date and time at which the manager\'s RFP response was received and recorded in the system, used for deadline compliance verification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:tcfdAligned rdf:type rdf:Property ;
    rdfs:label 'Tcfd Aligned' ;
    rdfs:comment 'Indicates whether the manager\'s proposed strategy and reporting framework is aligned with TCFD recommendations as disclosed in the RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:teamCompositionDescription rdf:type rdf:Property ;
    rdfs:label 'Team Composition Description' ;
    rdfs:comment 'Narrative description of the investment team structure, key personnel roles, experience, and stability as presented in the RFP response.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamQualityScore rdf:type rdf:Property ;
    rdfs:label 'Team Quality Score' ;
    rdfs:comment 'Sub-score assigned by the internal team assessing the depth, experience, stability, and succession planning of the manager\'s investment team.' ;
    rdfs:domain ind:RfpResponse ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mandateTermId rdf:type rdf:Property ;
    rdfs:label 'Mandate Term Id' ;
    rdfs:comment 'Unique surrogate identifier for each mandate term record in the Silver layer. Primary key for the mandate_term data product.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carrySplitLpPct rdf:type rdf:Property ;
    rdfs:label 'Carry Split Lp Pct' ;
    rdfs:comment 'LP share of profits in the carried interest waterfall after the GP catch-up phase. Typically 80% in a standard 80/20 carry structure.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Flag' ;
    rdfs:comment 'Indicates whether a GP clawback provision exists, requiring the GP to return previously distributed carry if the fund underperforms over its life.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:clawbackLookbackYears rdf:type rdf:Property ;
    rdfs:label 'Clawback Lookback Years' ;
    rdfs:comment 'Number of years over which the clawback obligation is assessed. Defines the GP\'s liability window for returning excess carry distributions.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coInvestCarryRatePct rdf:type rdf:Property ;
    rdfs:label 'Co Invest Carry Rate Pct' ;
    rdfs:comment 'Carried interest rate applicable to co-investment transactions, typically lower than the main fund carry rate.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Co Invest Fee Rate Bps' ;
    rdfs:comment 'Management fee rate in basis points applicable to co-investment capital deployed alongside the fund, often reduced or zero.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgSideLetterFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Side Letter Flag' ;
    rdfs:comment 'Indicates whether an ESG-specific side letter or addendum is attached to the mandate, imposing additional responsible investment obligations on the GP.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:excuseRightFlag rdf:type rdf:Property ;
    rdfs:label 'Excuse Right Flag' ;
    rdfs:comment 'Indicates whether the LP has the right to excuse itself from specific investments (e.g., for regulatory, ESG, or conflict-of-interest reasons).' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeBase rdf:type rdf:Property ;
    rdfs:label 'Fee Base' ;
    rdfs:comment 'The capital base on which management fees are calculated: committed capital, invested capital, NAV, GAV, or AUM. Critical for fee accrual and reconciliation.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeFrequency rdf:type rdf:Property ;
    rdfs:label 'Fee Frequency' ;
    rdfs:comment 'Frequency at which management fees are calculated and payable to the GP, as stipulated in the LPA or SMA.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feePaymentTiming rdf:type rdf:Property ;
    rdfs:label 'Fee Payment Timing' ;
    rdfs:comment 'Specifies whether management fees are paid in advance (at the start of the period) or in arrears (at the end of the period).' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundAdministrator rdf:type rdf:Property ;
    rdfs:label 'Fund Administrator' ;
    rdfs:comment 'Name of the third-party fund administrator responsible for NAV calculation, capital account maintenance, and investor reporting.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpCatchUpRatePct rdf:type rdf:Property ;
    rdfs:label 'Gp Catch Up Rate Pct' ;
    rdfs:comment 'Rate at which the GP receives profits during the catch-up phase after the LP preferred return is met, before the standard carry split applies.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpAdvisoryCommitteeFlag rdf:type rdf:Property ;
    rdfs:label 'Lp Advisory Committee Flag' ;
    rdfs:comment 'Indicates whether the LP has a seat or observer rights on the Limited Partner Advisory Committee (LPAC) for this fund mandate.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mgmtFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Mgmt Fee Rate Bps' ;
    rdfs:comment 'Annual management fee rate expressed in basis points (bps) applied to the fee base. Represents the primary tier or flat rate where tiered schedules are not applicable.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:mgmtFeeTierSchedule rdf:type rdf:Property ;
    rdfs:label 'Mgmt Fee Tier Schedule' ;
    rdfs:comment 'Textual or structured description of tiered management fee breakpoints by AUM band (e.g., 100bps on first $500M, 75bps above). Stored as structured text pending normalization.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringFeeOffsetPct rdf:type rdf:Property ;
    rdfs:label 'Monitoring Fee Offset Pct' ;
    rdfs:comment 'Percentage of portfolio company monitoring, transaction, or advisory fees received by the GP that must be credited back to offset LP management fees.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:organizationalExpenseCapPct rdf:type rdf:Property ;
    rdfs:label 'Organizational Expense Cap Pct' ;
    rdfs:comment 'Maximum percentage of committed capital that the GP may charge as organizational and formation expenses to the fund.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postInvestmentFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Post Investment Fee Rate Bps' ;
    rdfs:comment 'Reduced management fee rate in basis points applicable after the investment period ends, typically applied to invested (not committed) capital.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Term Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this version of the mandate term, used in LPA schedules, SMA agreements, and co-investment side letters.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termStatus rdf:type rdf:Property ;
    rdfs:label 'Term Status' ;
    rdfs:comment 'Current lifecycle state of the mandate term record, governing whether the economic terms are operationally binding.' ;
    rdfs:domain ind:MandateTerm ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mandateAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Mandate Amendment Id' ;
    rdfs:comment 'Unique surrogate identifier for each formal amendment record to an external manager mandate. Primary key for the mandate_amendment product in the Silver layer.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:mandateDealcloudAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Mandate Dealcloud Amendment Id' ;
    rdfs:comment 'Native amendment record identifier from DealCloud (Deal Pipeline and Origination CRM), used for amendments originating from the deal pipeline or manager relationship management workflow.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Amendment .

ind:mandateEfrontAmendmentId rdf:type rdf:Property ;
    rdfs:label 'Mandate Efront Amendment Id' ;
    rdfs:comment 'Native amendment record identifier from eFront (Private Markets Portfolio Monitoring system), the primary system of record for private market mandate amendments. Enables reconciliation.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Amendment .

ind:amendmentRationale rdf:type rdf:Property ;
    rdfs:label 'Amendment Rationale' ;
    rdfs:comment 'Business justification for the amendment as documented in the IC memo or negotiation record. Captures the strategic or operational reason driving the change.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentReference rdf:type rdf:Property ;
    rdfs:label 'Amendment Reference' ;
    rdfs:comment 'Externally-known unique reference code assigned to this amendment (e.g., AMD-MAND0042-2024-001). Used in legal correspondence, IC memos, and audit trails.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentStatus rdf:type rdf:Property ;
    rdfs:label 'Amendment Status' ;
    rdfs:comment 'Current workflow state of the amendment from drafting through execution. Controls downstream processing and reporting inclusion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentType rdf:type rdf:Property ;
    rdfs:label 'Amendment Type' ;
    rdfs:comment 'Classification of the amendment by its primary business purpose. Drives workflow routing and legal review requirements. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amendmentVersion rdf:type rdf:Property ;
    rdfs:label 'Amendment Version' ;
    rdfs:comment 'Sequential version number for amendments to the same clause or provision within the same mandate. Enables tracking of iterative renegotiations over the mandate lifecycle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Level' ;
    rdfs:comment 'Governance tier at which the amendment was approved, reflecting the materiality and delegation of authority framework (e.g., CIO for minor fee adjustments, Board for material term changes).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseDescription rdf:type rdf:Property ;
    rdfs:label 'Clause Description' ;
    rdfs:comment 'Plain-language description of the clause or provision being amended, providing business context for the change beyond the clause reference number.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clauseReference rdf:type rdf:Property ;
    rdfs:label 'Clause Reference' ;
    rdfs:comment 'Specific section, article, or clause number within the original mandate agreement (LPA, SMA, or co-investment agreement) that is being modified by this amendment.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartySignedDate rdf:type rdf:Property ;
    rdfs:label 'Counterparty Signed Date' ;
    rdfs:comment 'Date on which the external manager (GP or sub-advisor) executed their signature on the amendment document. May differ from amendment_date if signing occurred in stages.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:feeTypeAmended rdf:type rdf:Property ;
    rdfs:label 'Fee Type Amended' ;
    rdfs:comment 'Specific fee component modified by this amendment when amendment_type is fee_renegotiation. Null for non-fee amendments. [ENUM-REF-CANDIDATE: management_fee|carried_interest|hurdle_rate|preferred_return|transaction_fee|monitoring_fee|setup_fee|clawback —' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalSignedDate rdf:type rdf:Property ;
    rdfs:label 'Internal Signed Date' ;
    rdfs:comment 'Date on which the pension fund\'s authorized signatory executed the amendment on behalf of the fund. Completes the bilateral execution of the amendment.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentGuidelineCategory rdf:type rdf:Property ;
    rdfs:label 'Investment Guideline Category' ;
    rdfs:comment 'Category of investment guideline modified when amendment_type is guideline_change. Drives compliance monitoring updates in BlackRock Aladdin and Charles River IMS.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isMaterialAmendment rdf:type rdf:Property ;
    rdfs:label 'Is Material Amendment' ;
    rdfs:comment 'Indicates whether this amendment is classified as material under the fund\'s internal governance policy, triggering enhanced IC approval, legal review, and regulatory disclosure requirements.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSideLetter rdf:type rdf:Property ;
    rdfs:label 'Is Side Letter' ;
    rdfs:comment 'Indicates whether this amendment is structured as a side letter (a separate bilateral agreement supplementing the main LPA or SMA) rather than a formal amendment to the primary document.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalReviewCompleted rdf:type rdf:Property ;
    rdfs:label 'Legal Review Completed' ;
    rdfs:comment 'Indicates whether the internal or external legal review of this amendment has been formally completed and signed off prior to execution.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mfnApplicable rdf:type rdf:Property ;
    rdfs:label 'Mfn Applicable' ;
    rdfs:comment 'Indicates whether a Most Favoured Nation (MFN) clause applies to this amendment, entitling the pension fund to the most favourable terms granted to any other LP in the fund.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:negotiationSummary rdf:type rdf:Property ;
    rdfs:label 'Negotiation Summary' ;
    rdfs:comment 'Summary of the negotiation process, key concessions, and counterparty positions leading to the agreed amendment terms. Supports post-deal review and future renegotiations.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorCarryRate rdf:type rdf:Property ;
    rdfs:label 'Prior Carry Rate' ;
    rdfs:comment 'The carried interest (carry) rate as a decimal (e.g., 0.20 for 20%) in effect before this amendment. Populated when fee_type_amended includes carried_interest.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorHurdleRate rdf:type rdf:Property ;
    rdfs:label 'Prior Hurdle Rate' ;
    rdfs:comment 'The preferred return / hurdle rate as a decimal (e.g., 0.08 for 8%) before this amendment. The threshold IRR the GP must exceed before earning carry.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorManagementFeeRate rdf:type rdf:Property ;
    rdfs:label 'Prior Management Fee Rate' ;
    rdfs:comment 'The management fee rate (as a decimal, e.g., 0.015 for 1.5%) in effect before this amendment. Populated only when fee_type_amended includes management_fee.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Prior Term End Date' ;
    rdfs:comment 'The original contractual end date of the mandate or fund term before this amendment. Populated for term extension amendments to document the change.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priorValue rdf:type rdf:Property ;
    rdfs:label 'Prior Value' ;
    rdfs:comment 'The original contractual value, rate, limit, or text of the clause before this amendment. Stored as STRING to accommodate numeric, percentage, date, and free-text clause values.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryDisclosureRequired rdf:type rdf:Property ;
    rdfs:label 'Regulatory Disclosure Required' ;
    rdfs:comment 'Indicates whether this amendment triggers a regulatory disclosure obligation (e.g., SFDR, SEC reporting). Drives compliance workflow and regulatory reporting queue.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revisedCarryRate rdf:type rdf:Property ;
    rdfs:label 'Revised Carry Rate' ;
    rdfs:comment 'The carried interest (carry) rate as a decimal after this amendment. Tracks renegotiated economics for performance attribution and fee analysis.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedHurdleRate rdf:type rdf:Property ;
    rdfs:label 'Revised Hurdle Rate' ;
    rdfs:comment 'The preferred return / hurdle rate as a decimal after this amendment. Impacts IRR and MOIC calculations for performance attribution.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedManagementFeeRate rdf:type rdf:Property ;
    rdfs:label 'Revised Management Fee Rate' ;
    rdfs:comment 'The management fee rate (as a decimal) after this amendment. Enables fee savings tracking and benchmarking against Preqin/PitchBook market data.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisedTermEndDate rdf:type rdf:Property ;
    rdfs:label 'Revised Term End Date' ;
    rdfs:comment 'The new contractual end date of the mandate or fund term after this amendment. Used in ALM, liquidity forecasting, and commitment scheduling.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:revisedValue rdf:type rdf:Property ;
    rdfs:label 'Revised Value' ;
    rdfs:comment 'The new contractual value, rate, limit, or text of the clause after this amendment. Stored as STRING to accommodate numeric, percentage, date, and free-text clause values.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sideLetterType rdf:type rdf:Property ;
    rdfs:label 'Side Letter Type' ;
    rdfs:comment 'Classification of the side letter if is_side_letter is true. MFN (Most Favoured Nation) clauses, co-investment rights, and fee discounts are common LP-negotiated side letter types.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termExtensionYears rdf:type rdf:Property ;
    rdfs:label 'Term Extension Years' ;
    rdfs:comment 'Number of years by which the mandate or fund term is extended under this amendment. Populated when amendment_type is term_extension. Supports ALM and liquidity planning.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueUnit rdf:type rdf:Property ;
    rdfs:label 'Value Unit' ;
    rdfs:comment 'Unit of measure for prior_value and revised_value (e.g., percentage for management fee rate, bps for spread, currency for hard cap). Enables correct interpretation of the change.' ;
    rdfs:domain ind:MandateAmendment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerFirmGpProfileId rdf:type rdf:Property ;
    rdfs:label 'Manager Firm Gp Profile Id' ;
    rdfs:comment 'Reference to the external manager firm (GP, sub-advisor, or FoF manager) that this contact is associated with. Links to the manager master record.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:coverageAssetClass rdf:type rdf:Property ;
    rdfs:label 'Coverage Asset Class' ;
    rdfs:comment 'Primary asset class covered by this contact within the external manager firm, aligning to the pension fund\'s asset allocation domains (e.g., private equity, infrastructure, credit).' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageStrategy rdf:type rdf:Property ;
    rdfs:label 'Coverage Strategy' ;
    rdfs:comment 'Specific investment strategy or sub-strategy the contact oversees or represents (e.g., buyout, growth equity, core infrastructure, senior secured credit, value-add real estate).' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataConsentDate rdf:type rdf:Property ;
    rdfs:label 'Data Consent Date' ;
    rdfs:comment 'Date on which data processing consent was obtained from this contact, used to track consent validity and trigger renewal workflows per GDPR and applicable privacy law requirements.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dataConsentObtained rdf:type rdf:Property ;
    rdfs:label 'Data Consent Obtained' ;
    rdfs:comment 'Indicates whether explicit consent for processing personal data has been obtained from this contact in jurisdictions where GDPR or equivalent privacy regulations apply.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dateJoinedFirm rdf:type rdf:Property ;
    rdfs:label 'Date Joined Firm' ;
    rdfs:comment 'Date the contact joined the external manager firm, used to calculate tenure and assess team stability as part of ongoing manager oversight and ODD.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:departureDate rdf:type rdf:Property ;
    rdfs:label 'Departure Date' ;
    rdfs:comment 'Date the contact departed the external manager firm, populated when contact_status transitions to departed. Triggers key-person event review if is_key_person is true.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:departureReason rdf:type rdf:Property ;
    rdfs:label 'Departure Reason' ;
    rdfs:comment 'Reason for the contact\'s departure from the external manager firm, used in key-person event analysis and manager stability risk assessment.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:directPhone rdf:type rdf:Property ;
    rdfs:label 'Direct Phone' ;
    rdfs:comment 'Direct business telephone number for the contact, in E.164 international format, used for investment committee follow-ups and urgent mandate communications.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:educationalBackground rdf:type rdf:Property ;
    rdfs:label 'Educational Background' ;
    rdfs:comment 'Summary of the contact\'s highest academic qualification and institution (e.g., MBA Harvard Business School), used in qualitative manager team assessment during ODD.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isKeyPerson rdf:type rdf:Property ;
    rdfs:label 'Is Key Person' ;
    rdfs:comment 'Indicates whether this contact is designated as a key person under the terms of an LPA or mandate agreement, triggering key-person event monitoring and notification obligations.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:jobTitle rdf:type rdf:Property ;
    rdfs:label 'Job Title' ;
    rdfs:comment 'Official job title of the contact at the external manager firm (e.g., Portfolio Manager, Chief Investment Officer, Investor Relations Director, Chief Compliance Officer).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyPersonMandateRef rdf:type rdf:Property ;
    rdfs:label 'Key Person Mandate Ref' ;
    rdfs:comment 'Reference identifier of the LPA, SMA, or co-investment agreement in which this contact is named as a key person, enabling traceability to contractual key-person provisions.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:kycVerifiedDate rdf:type rdf:Property ;
    rdfs:label 'Kyc Verified Date' ;
    rdfs:comment 'Date on which KYC verification was last completed for this contact, used to track compliance with AML/CTF refresh cycles and regulatory obligations.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastInteractionDate rdf:type rdf:Property ;
    rdfs:label 'Last Interaction Date' ;
    rdfs:comment 'Date of the most recent recorded interaction between the pension fund\'s team and this contact (e.g., LP advisory call, annual meeting, IC presentation), used for relationship health monitoring.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastInteractionType rdf:type rdf:Property ;
    rdfs:label 'Last Interaction Type' ;
    rdfs:comment 'Type of the most recent recorded interaction with this contact, used to assess engagement quality and frequency as part of ongoing manager relationship management.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:linkedinUrl rdf:type rdf:Property ;
    rdfs:label 'Linkedin Url' ;
    rdfs:comment 'LinkedIn profile URL for the contact, used for background verification, professional history review during ODD, and ongoing key-person monitoring.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mobilePhone rdf:type rdf:Property ;
    rdfs:label 'Mobile Phone' ;
    rdfs:comment 'Mobile phone number for the contact in E.164 international format, used for time-sensitive communications such as capital call notices or NAV queries.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeLocationCity rdf:type rdf:Property ;
    rdfs:label 'Office Location City' ;
    rdfs:comment 'City of the contact\'s primary office location at the external manager firm, used for time-zone management and in-person meeting logistics.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:officeLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Office Location Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the contact\'s primary office location, used for regulatory jurisdiction mapping and travel planning.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pepStatus rdf:type rdf:Property ;
    rdfs:label 'Pep Status' ;
    rdfs:comment 'Politically Exposed Person classification for the contact per FATF Recommendation 12, required for enhanced due diligence and AML compliance screening.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredContactMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Contact Method' ;
    rdfs:comment 'The contact\'s preferred communication channel for routine LP-GP interactions, capital call notices, and investor relations correspondence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredLanguage rdf:type rdf:Property ;
    rdfs:label 'Preferred Language' ;
    rdfs:comment 'Preferred language for communications with this contact, expressed as an IETF BCP 47 language tag (e.g., en-CA, fr-FR), used for LP reporting and correspondence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorEmployer rdf:type rdf:Property ;
    rdfs:label 'Prior Employer' ;
    rdfs:comment 'Most recent prior employer of the contact before joining the current manager firm, used in background verification and key-person track record assessment during ODD.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:professionalDesignation rdf:type rdf:Property ;
    rdfs:label 'Professional Designation' ;
    rdfs:comment 'Primary professional credential or designation held by the contact (e.g., CFA, CPA, CAIA, FRM), used in qualitative assessment of manager team quality during DD.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:roleType rdf:type rdf:Property ;
    rdfs:label 'Role Type' ;
    rdfs:comment 'Functional classification of the contact\'s role within the external manager firm, used to route communications and oversight activities. [ENUM-REF-CANDIDATE: investment|investor_relations|compliance|operations|legal|executive|risk|finance — promote to' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sanctionsScreenedDate rdf:type rdf:Property ;
    rdfs:label 'Sanctions Screened Date' ;
    rdfs:comment 'Date on which the most recent sanctions screening was performed for this contact, used to ensure compliance with periodic AML/CTF refresh requirements.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:sourceSystemContactCode rdf:type rdf:Property ;
    rdfs:label 'Source System Contact Code' ;
    rdfs:comment 'The unique identifier assigned to this contact in the originating source system (Preqin, PitchBook, or DealCloud), used for data lineage tracing and cross-system reconciliation.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenureAtFirmYears rdf:type rdf:Property ;
    rdfs:label 'Tenure At Firm Years' ;
    rdfs:comment 'Number of years the contact has been employed at the current external manager firm, a key metric in key-person risk assessment and manager stability evaluation.' ;
    rdfs:domain ind:ManagerContact ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:timeZone rdf:type rdf:Property ;
    rdfs:label 'Time Zone' ;
    rdfs:comment 'IANA time zone identifier for the contact\'s primary office location (e.g., America/New_York, Europe/London), used for scheduling IC meetings and capital call deadlines.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeScheduleId rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Id' ;
    rdfs:comment 'Unique surrogate identifier for the fee schedule record within the pension fund\'s manager domain.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:clawbackEscrowPct rdf:type rdf:Property ;
    rdfs:label 'Clawback Escrow Pct' ;
    rdfs:comment 'Percentage of carried interest distributions held in escrow to fund potential clawback obligations. Null if no clawback escrow is required by the LPA.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:crystallizationFrequency rdf:type rdf:Property ;
    rdfs:label 'Crystallization Frequency' ;
    rdfs:comment 'Frequency at which performance fees (carried interest or incentive fees) are crystallized and become payable: annual, quarterly, at realization, or at fund end.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeRebateEligible rdf:type rdf:Property ;
    rdfs:label 'Fee Rebate Eligible' ;
    rdfs:comment 'Indicates whether the pension fund is eligible for fee rebates based on commitment size, co-investment rights, or negotiated LP-specific terms in the side letter.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:feeRebateRateBps rdf:type rdf:Property ;
    rdfs:label 'Fee Rebate Rate Bps' ;
    rdfs:comment 'Basis point reduction applied to the standard management fee rate as a rebate for large LP commitments or co-investment participation. Null if not eligible.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeReportingStandard rdf:type rdf:Property ;
    rdfs:label 'Fee Reporting Standard' ;
    rdfs:comment 'Reporting standard under which fee disclosures are made: ILPA Fee Reporting Template, GIPS, SFDR Article 8/9, or custom bilateral agreement.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Fee Schedule Status' ;
    rdfs:comment 'Current lifecycle state of the fee schedule record: active (in force), superseded (replaced by a newer version), terminated, draft, or pending IC approval.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpCatchupRatePct rdf:type rdf:Property ;
    rdfs:label 'Gp Catchup Rate Pct' ;
    rdfs:comment 'Rate at which the GP receives distributions during the catch-up phase after the LP preferred return hurdle is met, before the standard carry split applies.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentPeriodFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Investment Period Fee Rate Bps' ;
    rdfs:comment 'Management fee rate in basis points applicable during the fund\'s active investment period (typically years 1–5 for PE). May differ from the post-investment-period rate.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isTiered rdf:type rdf:Property ;
    rdfs:label 'Is Tiered' ;
    rdfs:comment 'Indicates whether the management fee schedule uses AUM-band tiers (True) or a flat rate (False). Tiered details are stored in the fee_schedule_tier product.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managementFeeOffsetPct rdf:type rdf:Property ;
    rdfs:label 'Management Fee Offset Pct' ;
    rdfs:comment 'Percentage of transaction fees, monitoring fees, or other GP income credited back to reduce the LP\'s management fee obligation, per ILPA best practice.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:monitoringFeeAnnualUsd rdf:type rdf:Property ;
    rdfs:label 'Monitoring Fee Annual Usd' ;
    rdfs:comment 'Fixed annual monitoring fee in USD charged by the GP for portfolio company oversight services. Subject to management fee offset per LPA terms.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:postInvestmentPeriodFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Post Investment Period Fee Rate Bps' ;
    rdfs:comment 'Reduced management fee rate in basis points applicable after the fund\'s investment period ends, typically based on invested (not committed) capital.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scheduleCode rdf:type rdf:Property ;
    rdfs:label 'Schedule Code' ;
    rdfs:comment 'Unique business identifier for the fee schedule, used in mandate documentation, fee invoices, and reconciliation with eFront and Oracle Financials.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tier1UpperBoundUsd rdf:type rdf:Property ;
    rdfs:label 'Tier 1 Upper Bound Usd' ;
    rdfs:comment 'Upper AUM boundary in USD for the first management fee tier. Fees on committed/invested capital up to this amount are charged at the Tier 1 rate.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tier2FeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Tier 2 Fee Rate Bps' ;
    rdfs:comment 'Management fee rate in basis points applicable to the AUM band above the Tier 1 upper bound. Null if the schedule is not tiered.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionFeeRateBps rdf:type rdf:Property ;
    rdfs:label 'Transaction Fee Rate Bps' ;
    rdfs:comment 'Fee rate in basis points charged by the GP on deal transaction value (acquisition, disposition). Subject to management fee offset provisions per ILPA guidelines.' ;
    rdfs:domain ind:FeeSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:evaluationId rdf:type rdf:Property ;
    rdfs:label 'Evaluation Id' ;
    rdfs:comment 'Unique surrogate identifier for each periodic external manager evaluation record within the manager domain.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:evaluationEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Evaluation Employee Id' ;
    rdfs:comment 'Senior investment professional or IC member who formally approved and signed off on this evaluation. Links to the internal employee record.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:evaluationLeadAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Evaluation Lead Analyst Employee Id' ;
    rdfs:comment 'Internal staff member responsible for authoring and coordinating this manager evaluation. Links to the internal employee/analyst record.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:benchmarkIrrPct rdf:type rdf:Property ;
    rdfs:label 'Benchmark Irr Pct' ;
    rdfs:comment 'The target or benchmark Internal Rate of Return (IRR) percentage against which the manager\'s performance is evaluated during this review period.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:complianceBreachDetails rdf:type rdf:Property ;
    rdfs:label 'Compliance Breach Details' ;
    rdfs:comment 'Narrative description of any compliance breaches, regulatory incidents, or mandate violations identified during the review period.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:complianceBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Compliance Breach Flag' ;
    rdfs:comment 'Indicates whether the manager reported any regulatory, mandate, or investment guideline compliance breaches during the review period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgIntegrationNotes rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Notes' ;
    rdfs:comment 'Qualitative narrative on the manager\'s ESG policies, stewardship activities, TCFD alignment, and PRI signatory status.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgIntegrationScore rdf:type rdf:Property ;
    rdfs:label 'Esg Integration Score' ;
    rdfs:comment 'Numeric score assessing the depth and quality of Environmental, Social, and Governance (ESG) integration within the manager\'s investment process.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgMaturityLevel rdf:type rdf:Property ;
    rdfs:label 'Esg Maturity Level' ;
    rdfs:comment 'Categorical maturity tier for the manager\'s ESG integration, from nascent (minimal) to leading (best-in-class), used for portfolio-level ESG reporting.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationStatus rdf:type rdf:Property ;
    rdfs:label 'Evaluation Status' ;
    rdfs:comment 'Current lifecycle state of the evaluation record from initial drafting through IC approval and final publication.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:evaluationType rdf:type rdf:Property ;
    rdfs:label 'Evaluation Type' ;
    rdfs:comment 'Classification of the evaluation cycle: annual review, interim review triggered by an event, onboarding assessment, termination review, or ad hoc. [ENUM-REF-CANDIDATE: annual_review|interim_review|onboarding|termination_review|ad_hoc — promote to' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeComplianceFlag rdf:type rdf:Property ;
    rdfs:label 'Fee Compliance Flag' ;
    rdfs:comment 'Indicates whether the manager\'s fee charges (management fee, carried interest, and expenses) were compliant with the agreed LPA or mandate terms during the review period.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icReviewRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Review Required Flag' ;
    rdfs:comment 'Indicates whether this evaluation outcome requires formal escalation to the Investment Committee (IC) for review and decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:investmentProcessNotes rdf:type rdf:Property ;
    rdfs:label 'Investment Process Notes' ;
    rdfs:comment 'Qualitative narrative describing the analyst\'s assessment of the manager\'s investment process, strategy differentiation, and edge.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentProcessScore rdf:type rdf:Property ;
    rdfs:label 'Investment Process Score' ;
    rdfs:comment 'Numeric score assessing the quality, repeatability, and differentiation of the manager\'s investment process and philosophy.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyPersonDepartureFlag rdf:type rdf:Property ;
    rdfs:label 'Key Person Departure Flag' ;
    rdfs:comment 'Indicates whether a key-person departure event occurred at the manager during the review period, triggering enhanced monitoring.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextEvaluationDate rdf:type rdf:Property ;
    rdfs:label 'Next Evaluation Date' ;
    rdfs:comment 'Scheduled date for the next periodic evaluation of this manager, set based on conviction rating and watch-list status.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:onSiteVisitConductedFlag rdf:type rdf:Property ;
    rdfs:label 'On Site Visit Conducted Flag' ;
    rdfs:comment 'Indicates whether an on-site operational due diligence (ODD) visit to the manager\'s offices was conducted as part of this evaluation cycle.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:onSiteVisitDate rdf:type rdf:Property ;
    rdfs:label 'On Site Visit Date' ;
    rdfs:comment 'Date on which the on-site operational due diligence visit was conducted at the manager\'s premises during this evaluation cycle.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:operationalInfrastructureNotes rdf:type rdf:Property ;
    rdfs:label 'Operational Infrastructure Notes' ;
    rdfs:comment 'Qualitative narrative on the manager\'s operational setup, technology stack, fund administration quality, and cybersecurity posture.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalInfrastructureScore rdf:type rdf:Property ;
    rdfs:label 'Operational Infrastructure Score' ;
    rdfs:comment 'Numeric score from Operational Due Diligence (ODD) assessing the manager\'s back-office, technology, compliance, and operational controls.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallConvictionRating rdf:type rdf:Property ;
    rdfs:label 'Overall Conviction Rating' ;
    rdfs:comment 'Composite qualitative conviction rating summarising the investment team\'s overall confidence in the manager. Drives mandate continuation or termination decisions.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overallScore rdf:type rdf:Property ;
    rdfs:label 'Overall Score' ;
    rdfs:comment 'Composite weighted numeric score (e.g., 0.00–100.00) aggregating all qualitative and quantitative sub-scores into a single manager evaluation rating.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceAssessmentRating rdf:type rdf:Property ;
    rdfs:label 'Performance Assessment Rating' ;
    rdfs:comment 'Qualitative rating of the manager\'s investment performance relative to benchmark and peers over the review period, based on TWR and IRR analysis.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorConvictionRating rdf:type rdf:Property ;
    rdfs:label 'Prior Conviction Rating' ;
    rdfs:comment 'The overall conviction rating assigned in the immediately preceding evaluation cycle, enabling trend analysis and rating migration tracking.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingChangeFlag rdf:type rdf:Property ;
    rdfs:label 'Rating Change Flag' ;
    rdfs:comment 'Indicates whether the overall conviction rating changed from the prior evaluation cycle, flagging upgrades or downgrades for IC attention.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recommendedAction rdf:type rdf:Property ;
    rdfs:label 'Recommended Action' ;
    rdfs:comment 'Formal recommendation arising from this evaluation for the Investment Committee (IC) regarding the mandate relationship. [ENUM-REF-CANDIDATE: continue|continue_with_conditions|increase_allocation|reduce_allocation|terminate|place_on_watch — promote to' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedIrrPct rdf:type rdf:Property ;
    rdfs:label 'Reported Irr Pct' ;
    rdfs:comment 'The manager\'s reported net IRR percentage for the mandate or fund as of the review period end date, sourced from eFront or manager reporting.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedMoic rdf:type rdf:Property ;
    rdfs:label 'Reported Moic' ;
    rdfs:comment 'The manager\'s reported Multiple on Invested Capital (MOIC) as of the review period end date, reflecting gross investment return multiple.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedTvpi rdf:type rdf:Property ;
    rdfs:label 'Reported Tvpi' ;
    rdfs:comment 'Total Value to Paid-In (TVPI) ratio reported by the manager as of the review period end date, combining DPI and RVPI.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingQualityScore rdf:type rdf:Property ;
    rdfs:label 'Reporting Quality Score' ;
    rdfs:comment 'Numeric score assessing the accuracy, completeness, timeliness, and transparency of the manager\'s investor reporting and capital account statements.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskManagementNotes rdf:type rdf:Property ;
    rdfs:label 'Risk Management Notes' ;
    rdfs:comment 'Qualitative narrative on the manager\'s risk governance, portfolio risk controls, and alignment with the pension fund\'s risk appetite.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:riskManagementScore rdf:type rdf:Property ;
    rdfs:label 'Risk Management Score' ;
    rdfs:comment 'Numeric score evaluating the robustness of the manager\'s risk management framework, including VaR, drawdown controls, and stress testing practices.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaComplianceRating rdf:type rdf:Property ;
    rdfs:label 'Sla Compliance Rating' ;
    rdfs:comment 'Assessment of the manager\'s adherence to Service Level Agreement (SLA) obligations including reporting timeliness, data quality, and operational deliverables.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamStabilityNotes rdf:type rdf:Property ;
    rdfs:label 'Team Stability Notes' ;
    rdfs:comment 'Qualitative narrative on key-person risk, team tenure, succession planning, and any notable personnel changes since the last evaluation.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:teamStabilityScore rdf:type rdf:Property ;
    rdfs:label 'Team Stability Score' ;
    rdfs:comment 'Numeric score reflecting the stability, depth, and continuity of the manager\'s investment team, including key-person risk assessment.' ;
    rdfs:domain ind:Evaluation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:watchListFlag rdf:type rdf:Property ;
    rdfs:label 'Watch List Flag' ;
    rdfs:comment 'Indicates whether the manager has been placed on the internal watch list as a result of this evaluation, triggering enhanced monitoring and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:assessmentMethodologyVersion rdf:type rdf:Property ;
    rdfs:label 'Assessment Methodology Version' ;
    rdfs:comment 'Version identifier of the internal risk assessment scoring methodology applied (e.g., v2.1), enabling comparability across assessments and audit of methodology changes.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentNotes rdf:type rdf:Property ;
    rdfs:label 'Assessment Notes' ;
    rdfs:comment 'Free-text narrative field capturing qualitative analyst commentary, contextual observations, and IC discussion points not captured in structured scoring fields.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessContinuityRating rdf:type rdf:Property ;
    rdfs:label 'Business Continuity Rating' ;
    rdfs:comment 'Assessment of the manager\'s business continuity and disaster recovery capabilities, including documented BCP, testing frequency, and technology resilience.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concentrationRiskRating rdf:type rdf:Property ;
    rdfs:label 'Concentration Risk Rating' ;
    rdfs:comment 'Categorical rating for concentration risk, reflecting the fund\'s exposure to single issuers, sectors, geographies, or counterparties relative to mandate limits.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concentrationRiskScore rdf:type rdf:Property ;
    rdfs:label 'Concentration Risk Score' ;
    rdfs:comment 'Quantitative score measuring the degree of portfolio or counterparty concentration risk attributable to this manager, including single-name, sector, and geographic concentration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyRiskRating rdf:type rdf:Property ;
    rdfs:label 'Counterparty Risk Rating' ;
    rdfs:comment 'Categorical rating for counterparty risk, covering prime broker credit quality, CSA terms, CCP usage, and collateral management practices of the external manager.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:counterpartyRiskScore rdf:type rdf:Property ;
    rdfs:label 'Counterparty Risk Score' ;
    rdfs:comment 'Quantitative score assessing the credit and settlement risk arising from the manager\'s prime brokerage, custodian, OTC derivative, and other counterparty relationships.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:criticalFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Critical Findings Count' ;
    rdfs:comment 'Number of critical-severity findings identified in this assessment requiring immediate remediation or escalation to the Investment Committee.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:enforcementActionExists rdf:type rdf:Property ;
    rdfs:label 'Enforcement Action Exists' ;
    rdfs:comment 'Indicates whether the manager or its principals have been subject to any regulatory enforcement actions, sanctions, or material investigations within the lookback period.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keymanClauseExists rdf:type rdf:Property ;
    rdfs:label 'Keyman Clause Exists' ;
    rdfs:comment 'Indicates whether the governing LPA or mandate agreement contains a key-man clause that triggers suspension of capital calls or investor rights upon departure of named individuals.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keymanRiskRating rdf:type rdf:Property ;
    rdfs:label 'Keyman Risk Rating' ;
    rdfs:comment 'Categorical rating for key-man risk. Elevated when the manager\'s investment process is highly dependent on a single portfolio manager or founding partner.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keymanRiskScore rdf:type rdf:Property ;
    rdfs:label 'Keyman Risk Score' ;
    rdfs:comment 'Quantitative score assessing the degree of dependency on one or more key investment professionals at the manager firm, and the adequacy of succession planning.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityRiskRating rdf:type rdf:Property ;
    rdfs:label 'Liquidity Risk Rating' ;
    rdfs:comment 'Categorical rating for liquidity risk, reflecting the manager\'s redemption terms, lock-up provisions, side pocket usage, and alignment with the pension fund\'s liquidity needs.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityRiskScore rdf:type rdf:Property ;
    rdfs:label 'Liquidity Risk Score' ;
    rdfs:comment 'Quantitative score assessing the liquidity risk of the manager\'s strategy, including redemption terms, lock-up periods, gate provisions, and underlying asset liquidity profile.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:oddFindingsSummary rdf:type rdf:Property ;
    rdfs:label 'Odd Findings Summary' ;
    rdfs:comment 'Narrative summary of key findings from the Operational Due Diligence (ODD) review, including material control weaknesses, remediation actions, and outstanding items.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openFindingsCount rdf:type rdf:Property ;
    rdfs:label 'Open Findings Count' ;
    rdfs:comment 'Number of unresolved risk findings or remediation action items outstanding from this assessment, used to track manager remediation progress and escalation triggers.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pensionFundAumPct rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Aum Pct' ;
    rdfs:comment 'The pension fund\'s total committed capital to this manager expressed as a percentage of the manager\'s total AUM, used to assess investor concentration and influence risk.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryRiskScore rdf:type rdf:Property ;
    rdfs:label 'Regulatory Risk Score' ;
    rdfs:comment 'Quantitative score reflecting the manager\'s exposure to regulatory sanctions, licensing issues, enforcement actions, or non-compliance with applicable regulations.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reputationalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Reputational Risk Rating' ;
    rdfs:comment 'Categorical rating for reputational risk, covering adverse media coverage, ESG controversies, sanctions screening results, and alignment with PRI commitments.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reputationalRiskScore rdf:type rdf:Property ;
    rdfs:label 'Reputational Risk Score' ;
    rdfs:comment 'Quantitative score assessing reputational risk associated with the manager, including adverse media, ESG controversies, litigation, and alignment with the pension fund\'s values.' ;
    rdfs:domain ind:RiskAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:slaAgreementId rdf:type rdf:Property ;
    rdfs:label 'Sla Agreement Id' ;
    rdfs:comment 'Unique surrogate identifier for each SLA agreement record between the pension fund and an external manager or fund administrator.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SlaAgreement .

ind:agreementVersion rdf:type rdf:Property ;
    rdfs:label 'Agreement Version' ;
    rdfs:comment 'Version identifier of the SLA agreement document, incremented upon each formal amendment or renegotiation (e.g., v1.0, v2.1).' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditedFinancialsDeliveryDays rdf:type rdf:Property ;
    rdfs:label 'Audited Financials Delivery Days' ;
    rdfs:comment 'Maximum number of calendar days after fiscal year-end by which the manager must deliver audited financial statements to the pension fund under this SLA.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:autoRenewalFlag rdf:type rdf:Property ;
    rdfs:label 'Auto Renewal Flag' ;
    rdfs:comment 'Indicates whether the SLA agreement automatically renews upon expiry unless either party provides written notice of termination within the notice period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:breachNotificationHours rdf:type rdf:Property ;
    rdfs:label 'Breach Notification Hours' ;
    rdfs:comment 'Maximum number of hours within which the manager must notify the pension fund of an SLA breach or material reporting failure, as stipulated in the agreement.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalAccountDeliveryDays rdf:type rdf:Property ;
    rdfs:label 'Capital Account Delivery Days' ;
    rdfs:comment 'Maximum number of business days after period end by which the manager must deliver capital account statements showing Paid-In Capital (PIC), distributions, and RVPI.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceCertDeliveryDays rdf:type rdf:Property ;
    rdfs:label 'Compliance Cert Delivery Days' ;
    rdfs:comment 'Maximum number of business days after period end by which the manager must deliver compliance certificates confirming adherence to investment guidelines and regulatory requirements.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:custodianInvolved rdf:type rdf:Property ;
    rdfs:label 'Custodian Involved' ;
    rdfs:comment 'Indicates whether a third-party custodian (e.g., State Street, Northern Trust) is a party to or referenced in the SLA obligations, particularly for settlement and NAV reporting.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dataDeliveryChannel rdf:type rdf:Property ;
    rdfs:label 'Data Delivery Channel' ;
    rdfs:comment 'Transmission channel through which the manager delivers reports and data to the pension fund under this SLA (e.g., SFTP, API, custodian platform portal). [ENUM-REF-CANDIDATE: sftp|api|email|portal|swift|custodian_platform|other — 7 candidates stripped' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataDeliveryFormat rdf:type rdf:Property ;
    rdfs:label 'Data Delivery Format' ;
    rdfs:comment 'Contractually agreed file or transmission format in which the manager must deliver reports and data under this SLA (e.g., SWIFT, SFTP, API feed, Excel). [ENUM-REF-CANDIDATE: promote to reference product]' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Distribution Notice Days' ;
    rdfs:comment 'Minimum number of business days advance notice the GP must provide before making a distribution to the pension fund, enabling treasury and cash management planning.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgReportDeliveryDays rdf:type rdf:Property ;
    rdfs:label 'Esg Report Delivery Days' ;
    rdfs:comment 'Maximum number of business days after period end by which the manager must deliver ESG and responsible investment reports, including GHG emissions data and TCFD disclosures.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgReportingRequired rdf:type rdf:Property ;
    rdfs:label 'Esg Reporting Required' ;
    rdfs:comment 'Indicates whether the SLA mandates periodic ESG reporting from the manager, including PRI alignment, TCFD disclosures, and GHG emissions data.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundAdminInvolved rdf:type rdf:Property ;
    rdfs:label 'Fund Admin Involved' ;
    rdfs:comment 'Indicates whether a separate fund administrator (distinct from the GP) is a party to the SLA obligations for NAV calculation, capital account statements, and investor reporting.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:gipsCompliantReporting rdf:type rdf:Property ;
    rdfs:label 'Gips Compliant Reporting' ;
    rdfs:comment 'Indicates whether the manager is contractually required to deliver performance reports in compliance with CFA Institute GIPS standards under this SLA.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:independentValuationRequired rdf:type rdf:Property ;
    rdfs:label 'Independent Valuation Required' ;
    rdfs:comment 'Indicates whether the SLA mandates an independent third-party valuation agent for illiquid or private asset valuations, as required for NAV/GAV determination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:navDeliveryDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Nav Delivery Deadline Days' ;
    rdfs:comment 'Maximum number of business days after the reference period end date by which the manager must deliver the NAV statement, as stipulated in the SLA.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:navDeliveryFrequency rdf:type rdf:Property ;
    rdfs:label 'Nav Delivery Frequency' ;
    rdfs:comment 'Contractually agreed frequency at which the manager or administrator must deliver NAV statements to the pension fund under this SLA.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyBasisPoints rdf:type rdf:Property ;
    rdfs:label 'Penalty Basis Points' ;
    rdfs:comment 'Fee rebate or penalty rate expressed in basis points (bps) applied to management fees upon confirmed SLA breach, as defined in the agreement.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:penaltyClauseApplicable rdf:type rdf:Property ;
    rdfs:label 'Penalty Clause Applicable' ;
    rdfs:comment 'Indicates whether financial penalty or fee rebate clauses are contractually applicable upon SLA breach by the manager or fund administrator.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:performanceReportDeliveryDays rdf:type rdf:Property ;
    rdfs:label 'Performance Report Delivery Days' ;
    rdfs:comment 'Maximum number of business days after period end by which the manager must deliver performance attribution reports including TWR, MWR, IRR, MOIC, TVPI, DPI, and RVPI metrics.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Sla Agreement Status' ;
    rdfs:comment 'Current lifecycle state of the SLA agreement, governing whether obligations are enforceable and being monitored.' ;
    rdfs:domain ind:SlaAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Sla Reference Number' ;
    rdfs:comment 'Externally-known alphanumeric reference code assigned to this SLA agreement, used in correspondence with the manager and in regulatory reporting.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaBreachId rdf:type rdf:Property ;
    rdfs:label 'Sla Breach Id' ;
    rdfs:comment 'Unique surrogate identifier for each SLA breach event record within the manager domain.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:slaObligationId rdf:type rdf:Property ;
    rdfs:label 'Sla Obligation Id' ;
    rdfs:comment 'Reference to the specific SLA obligation definition that was breached, as catalogued in the SLA obligation register.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Obligation .

ind:affectedAssetClass rdf:type rdf:Property ;
    rdfs:label 'Affected Asset Class' ;
    rdfs:comment 'The asset class of the mandate affected by the breach, enabling portfolio-level SLA compliance analysis across the fund\'s diversified allocation. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachCategory rdf:type rdf:Property ;
    rdfs:label 'Breach Category' ;
    rdfs:comment 'Functional category of the SLA obligation that was breached. [ENUM-REF-CANDIDATE: reporting|valuation|capital_call|distribution|compliance|operational|esg|risk_disclosure — promote to reference product]' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDetectedDate rdf:type rdf:Property ;
    rdfs:label 'Breach Detected Date' ;
    rdfs:comment 'The calendar date on which the SLA breach was first identified or detected by the internal oversight team or monitoring system.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:daysToResolution rdf:type rdf:Property ;
    rdfs:label 'Days To Resolution' ;
    rdfs:comment 'Number of calendar days elapsed between the breach detection date and the resolution date. Null if unresolved. Used for manager performance benchmarking.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:detectionSource rdf:type rdf:Property ;
    rdfs:label 'Detection Source' ;
    rdfs:comment 'The mechanism or source through which the SLA breach was identified, distinguishing automated system alerts from manual reviews or manager self-reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRelated rdf:type rdf:Property ;
    rdfs:label 'Esg Related' ;
    rdfs:comment 'Indicates whether the breached SLA obligation relates to Environmental, Social, and Governance (ESG) reporting or stewardship commitments under the mandate.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:financialImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Amount' ;
    rdfs:comment 'Estimated or actual financial impact of the breach on the fund, including any NAV misstatement, delayed distributions, or operational losses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:financialImpactCurrency rdf:type rdf:Property ;
    rdfs:label 'Financial Impact Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the financial impact amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impactAssessment rdf:type rdf:Property ;
    rdfs:label 'Impact Assessment' ;
    rdfs:comment 'Narrative assessment of the actual or potential impact of the breach on fund operations, NAV accuracy, beneficiary interests, or regulatory compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalOwner rdf:type rdf:Property ;
    rdfs:label 'Internal Owner' ;
    rdfs:comment 'Name or identifier of the internal relationship manager or oversight officer responsible for managing and resolving this breach event.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isContractualPenaltyTriggered rdf:type rdf:Property ;
    rdfs:label 'Is Contractual Penalty Triggered' ;
    rdfs:comment 'Indicates whether the breach has triggered a contractual penalty, fee reduction, or other financial remedy as defined in the LPA or SMA.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryReportable rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Reportable' ;
    rdfs:comment 'Indicates whether this breach must be disclosed to a regulatory body (e.g., FCA, SEC) under applicable reporting obligations.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRepeatBreach rdf:type rdf:Property ;
    rdfs:label 'Is Repeat Breach' ;
    rdfs:comment 'Indicates whether this breach is a recurrence of a previously recorded breach of the same SLA obligation by the same manager, flagging systemic non-compliance.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerResponse rdf:type rdf:Property ;
    rdfs:label 'Manager Response' ;
    rdfs:comment 'Verbatim or summarised formal response provided by the external manager acknowledging the breach and explaining their position or corrective intent.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerResponseDate rdf:type rdf:Property ;
    rdfs:label 'Manager Response Date' ;
    rdfs:comment 'Date on which the external manager formally responded to the breach notification. Used to measure manager responsiveness against SLA response time commitments.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:obligationDescription rdf:type rdf:Property ;
    rdfs:label 'Obligation Description' ;
    rdfs:comment 'Narrative description of the specific SLA obligation that was breached, including the contractual clause reference and expected deliverable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorBreachCount rdf:type rdf:Property ;
    rdfs:label 'Prior Breach Count' ;
    rdfs:comment 'Number of prior breach events recorded for the same SLA obligation and manager within the current mandate term, used for escalation threshold monitoring.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:regulatoryBody rdf:type rdf:Property ;
    rdfs:label 'Regulatory Body' ;
    rdfs:comment 'The regulatory authority to which this breach must be reported, if applicable. Populated only when is_regulatory_reportable is true.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remediationTargetDate rdf:type rdf:Property ;
    rdfs:label 'Remediation Target Date' ;
    rdfs:comment 'Agreed target date by which the manager is expected to complete the remediation plan and restore full SLA compliance.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rootCauseCategory rdf:type rdf:Property ;
    rdfs:label 'Root Cause Category' ;
    rdfs:comment 'Categorical classification of the root cause of the breach. [ENUM-REF-CANDIDATE: system_failure|process_failure|data_error|staffing|third_party|regulatory_change|force_majeure|unknown — promote to reference product]' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseDescription rdf:type rdf:Property ;
    rdfs:label 'Root Cause Description' ;
    rdfs:comment 'Detailed narrative of the root cause analysis conducted by the manager or internal oversight team explaining why the SLA obligation was not met.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:severityClassification rdf:type rdf:Property ;
    rdfs:label 'Severity Classification' ;
    rdfs:comment 'Categorical severity rating assigned to the breach based on its impact on fund operations, regulatory obligations, or beneficiary interests.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaObligationDate rdf:type rdf:Property ;
    rdfs:label 'Sla Obligation Date' ;
    rdfs:comment 'The contractually agreed date by which the manager was required to fulfil the SLA obligation that was subsequently breached.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Approved Date' ;
    rdfs:comment 'Date on which the waiver of the breach was formally approved by the authorised internal governance body. Null if no waiver granted.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:waiverJustification rdf:type rdf:Property ;
    rdfs:label 'Waiver Justification' ;
    rdfs:comment 'Narrative justification for waiving the breach without penalty or escalation, including approver details. Populated only when breach_status is waived.' ;
    rdfs:domain ind:SlaBreach ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistId rdf:type rdf:Property ;
    rdfs:label 'Watchlist Id' ;
    rdfs:comment 'Unique surrogate identifier for a manager watchlist record. Primary key for this entity.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvingOfficer rdf:type rdf:Property ;
    rdfs:label 'Approving Officer' ;
    rdfs:comment 'Name or employee identifier of the senior officer (e.g., CIO, Head of External Managers) who formally approved the watchlist placement decision.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aumAtPlacement rdf:type rdf:Property ;
    rdfs:label 'Aum At Placement' ;
    rdfs:comment 'The pension fund\'s total committed or invested capital with this manager (AUM) at the time of watchlist placement, in base currency. Used to assess financial exposure.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:watchlistCategory rdf:type rdf:Property ;
    rdfs:label 'Watchlist Category' ;
    rdfs:comment 'Primary classification of the reason for watchlist placement. [ENUM-REF-CANDIDATE: performance|key_man|regulatory|odd_finding|strategic_misalignment|esg_concern|fee_dispute|legal — promote to reference product]' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consecutiveUnderperformanceQuarters rdf:type rdf:Property ;
    rdfs:label 'Consecutive Underperformance Quarters' ;
    rdfs:comment 'Number of consecutive calendar quarters in which the manager has underperformed their agreed benchmark or hurdle rate, as recorded at the time of watchlist placement.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:engagementLogSummary rdf:type rdf:Property ;
    rdfs:label 'Engagement Log Summary' ;
    rdfs:comment 'Summary of formal engagement activities with the manager since watchlist placement, including calls, meetings, and written correspondence. Full log maintained in DealCloud.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgConcernCategory rdf:type rdf:Property ;
    rdfs:label 'Esg Concern Category' ;
    rdfs:comment 'Classifies the ESG dimension driving the concern: environmental (E), social (S), governance (G), or a combination. Populated when esg_concern_flag is true.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Concern Flag' ;
    rdfs:comment 'Indicates whether ESG-related concerns (e.g., governance failures, environmental violations, social controversies) contributed to the watchlist placement.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:icReviewDate rdf:type rdf:Property ;
    rdfs:label 'Ic Review Date' ;
    rdfs:comment 'The date on which the Investment Committee (IC) formally reviewed this watchlist entry and issued a decision or deferred for further monitoring.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:keyManClauseTriggered rdf:type rdf:Property ;
    rdfs:label 'Key Man Clause Triggered' ;
    rdfs:comment 'Indicates whether the formal key-man clause in the Limited Partnership Agreement (LPA) or mandate has been contractually triggered, potentially suspending capital calls or enabling early redemption.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyManDepartureFlag rdf:type rdf:Property ;
    rdfs:label 'Key Man Departure Flag' ;
    rdfs:comment 'Indicates whether the watchlist placement was triggered by the departure or announced departure of a key investment professional covered under a key-man clause in the LPA or mandate agreement.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerResponseReceived rdf:type rdf:Property ;
    rdfs:label 'Manager Response Received' ;
    rdfs:comment 'Indicates whether the external manager has formally responded to the watchlist notification and provided a remediation plan or explanation.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:managerStrategy rdf:type rdf:Property ;
    rdfs:label 'Manager Strategy' ;
    rdfs:comment 'The specific investment strategy employed by the manager under the mandate (e.g., buyout, venture capital, core real estate, direct lending, long/short equity, infrastructure core-plus).' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newCapitalDeploymentSuspended rdf:type rdf:Property ;
    rdfs:label 'New Capital Deployment Suspended' ;
    rdfs:comment 'Indicates whether new capital commitments or capital calls to this manager have been suspended as a result of the watchlist placement, pending resolution.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oddFindingFlag rdf:type rdf:Property ;
    rdfs:label 'Odd Finding Flag' ;
    rdfs:comment 'Indicates whether a material finding from an Operational Due Diligence (ODD) review contributed to the watchlist placement, such as control failures, valuation concerns, or compliance gaps.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:oddFindingSummary rdf:type rdf:Property ;
    rdfs:label 'Odd Finding Summary' ;
    rdfs:comment 'Concise summary of the material ODD findings that contributed to watchlist placement. Classified confidential due to sensitive operational assessment content.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceConcernFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Concern Flag' ;
    rdfs:comment 'Indicates whether underperformance relative to benchmark or hurdle rate is a contributing factor to the watchlist placement. Enables performance-driven watchlist analytics.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:placementDate rdf:type rdf:Property ;
    rdfs:label 'Placement Date' ;
    rdfs:comment 'The formal date on which the manager was officially placed on the internal watchlist following Investment Committee or risk team approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:portfolioExposurePct rdf:type rdf:Property ;
    rdfs:label 'Portfolio Exposure Pct' ;
    rdfs:comment 'The pension fund\'s exposure to this manager as a percentage of total fund AUM at the time of watchlist placement. Used for concentration risk assessment.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:redemptionNoticeDate rdf:type rdf:Property ;
    rdfs:label 'Redemption Notice Date' ;
    rdfs:comment 'The date on which the formal redemption or withdrawal notice was issued to the manager. Populated when redemption_notice_issued is true.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:redemptionNoticeIssued rdf:type rdf:Property ;
    rdfs:label 'Redemption Notice Issued' ;
    rdfs:comment 'Indicates whether a formal redemption or withdrawal notice has been issued to the manager as a result of the watchlist review process.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryInvestigationFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Investigation Flag' ;
    rdfs:comment 'Indicates whether the manager is subject to an active regulatory investigation by a governing body (e.g., SEC, FCA) that contributed to watchlist placement.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationPlanAgreed rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan Agreed' ;
    rdfs:comment 'Indicates whether a formal remediation plan has been agreed between the pension fund and the external manager to address the watchlist concerns.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationPlanDeadline rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan Deadline' ;
    rdfs:comment 'The agreed deadline by which the manager must demonstrate completion of remediation actions. Populated when remediation_plan_agreed is true.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resolutionOutcome rdf:type rdf:Property ;
    rdfs:label 'Resolution Outcome' ;
    rdfs:comment 'The formal outcome decision upon closure of the watchlist entry. Indicates whether the manager relationship was retained, redeemed, or terminated following review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategicMisalignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Strategic Misalignment Flag' ;
    rdfs:comment 'Indicates whether the watchlist placement is driven by a strategic misalignment between the manager\'s investment approach and the pension fund\'s evolving Strategic Asset Allocation (SAA) or mandate objectives.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:triggerDate rdf:type rdf:Property ;
    rdfs:label 'Trigger Date' ;
    rdfs:comment 'The date on which the triggering event or finding occurred that led to watchlist placement. Distinct from the formal placement date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:triggerReason rdf:type rdf:Property ;
    rdfs:label 'Trigger Reason' ;
    rdfs:comment 'Detailed narrative description of the specific event or finding that triggered placement of the manager on the watchlist (e.g., lead PM departure, SEC investigation opened, consecutive quarters of underperformance).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchlistStatus rdf:type rdf:Property ;
    rdfs:label 'Watchlist Status' ;
    rdfs:comment 'Current lifecycle status of the watchlist entry. Active indicates ongoing monitoring; resolved indicates concerns addressed; closed indicates formal removal from watchlist.' ;
    rdfs:domain ind:Watchlist ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingId rdf:type rdf:Property ;
    rdfs:label 'Meeting Id' ;
    rdfs:comment 'Unique surrogate identifier for each formal manager interaction record within the external manager oversight domain.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionItemsCount rdf:type rdf:Property ;
    rdfs:label 'Action Items Count' ;
    rdfs:comment 'Total number of formal action items or follow-up tasks recorded as outcomes of this meeting. Supports SLA and accountability tracking.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:agendaSummary rdf:type rdf:Property ;
    rdfs:label 'Agenda Summary' ;
    rdfs:comment 'Structured summary of the agenda items discussed, including key topics such as performance attribution, risk review, ESG updates, and operational matters.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endTimestamp rdf:type rdf:Property ;
    rdfs:label 'End Timestamp' ;
    rdfs:comment 'Precise date and time the meeting concluded, including timezone offset. Used alongside start_timestamp to derive meeting duration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:esgTopicsSummary rdf:type rdf:Property ;
    rdfs:label 'Esg Topics Summary' ;
    rdfs:comment 'Free-text summary of ESG-related topics discussed, including climate risk, GHG targets, governance concerns, or social impact matters raised during the meeting.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:externalAttendeeCount rdf:type rdf:Property ;
    rdfs:label 'External Attendee Count' ;
    rdfs:comment 'Number of external manager representatives (GP principals, IR staff, portfolio managers) who attended the meeting.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:format rdf:type rdf:Property ;
    rdfs:label 'Format' ;
    rdfs:comment 'Delivery format of the meeting: in-person, video conference, telephone, or hybrid. Relevant for travel cost attribution and engagement quality assessment.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icMemberPresent rdf:type rdf:Property ;
    rdfs:label 'Ic Member Present' ;
    rdfs:comment 'Indicates whether a member of the internal Investment Committee (IC) attended this meeting, relevant for governance and escalation tracking.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalAttendeeCount rdf:type rdf:Property ;
    rdfs:label 'Internal Attendee Count' ;
    rdfs:comment 'Number of internal pension fund staff members who attended the meeting. Used for engagement intensity and resource utilisation reporting.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:keyRisksIdentified rdf:type rdf:Property ;
    rdfs:label 'Key Risks Identified' ;
    rdfs:comment 'Narrative summary of material risks identified during the meeting, including operational, market, liquidity, counterparty, or ESG risks flagged by either party.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCity rdf:type rdf:Property ;
    rdfs:label 'Location City' ;
    rdfs:comment 'City where the in-person or hybrid meeting took place (e.g., London, New York, Singapore). Null for fully remote meetings.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationCountryCode rdf:type rdf:Property ;
    rdfs:label 'Location Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the jurisdiction where the meeting physically occurred (e.g., GBR, USA, CAN). Null for fully remote meetings.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:locationVenue rdf:type rdf:Property ;
    rdfs:label 'Location Venue' ;
    rdfs:comment 'Name of the specific venue, office, or facility where the meeting was held (e.g., manager HQ, fund administrator office, pension fund offices).' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerConvictionRating rdf:type rdf:Property ;
    rdfs:label 'Manager Conviction Rating' ;
    rdfs:comment 'Internal conviction rating assigned to the manager following this meeting: high, medium, low, or under review. Feeds into manager scoring and allocation decisions.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managerSeniorRepPresent rdf:type rdf:Property ;
    rdfs:label 'Manager Senior Rep Present' ;
    rdfs:comment 'Indicates whether a senior representative (partner, CIO, or managing director) of the external manager was present. Relevant for escalation and governance quality assessment.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:meetingStatus rdf:type rdf:Property ;
    rdfs:label 'Meeting Status' ;
    rdfs:comment 'Current lifecycle state of the meeting record: scheduled, completed, cancelled, rescheduled, or pending minutes approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minutesApproved rdf:type rdf:Property ;
    rdfs:label 'Minutes Approved' ;
    rdfs:comment 'Indicates whether the formal meeting minutes have been reviewed and approved by the designated internal approver, completing the governance record.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:minutesApprovedDate rdf:type rdf:Property ;
    rdfs:label 'Minutes Approved Date' ;
    rdfs:comment 'Date on which the meeting minutes were formally approved. Null if minutes are pending or not yet approved.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minutesDocumentRef rdf:type rdf:Property ;
    rdfs:label 'Minutes Document Ref' ;
    rdfs:comment 'Document management system reference or URL pointing to the formal meeting minutes stored in the governance platform (e.g., Diligent / BoardEffect).' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Next Meeting Date' ;
    rdfs:comment 'Tentative or confirmed date for the next formal interaction with this manager, supporting engagement cadence planning and SLA compliance.' ;
    rdfs:domain ind:Manager ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextMeetingType rdf:type rdf:Property ;
    rdfs:label 'Next Meeting Type' ;
    rdfs:comment 'Anticipated type of the next scheduled meeting with this manager. Supports forward engagement planning and oversight cadence management.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openActionItemsCount rdf:type rdf:Property ;
    rdfs:label 'Open Action Items Count' ;
    rdfs:comment 'Number of action items from this meeting that remain open or unresolved at the time of record update. Used for follow-up governance monitoring.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:overallSentiment rdf:type rdf:Property ;
    rdfs:label 'Overall Sentiment' ;
    rdfs:comment 'Internal qualitative assessment of the overall tone and outcome of the meeting: positive, neutral, negative, or cautionary. Supports manager scoring and watch-list decisions.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceReviewPeriod rdf:type rdf:Property ;
    rdfs:label 'Performance Review Period' ;
    rdfs:comment 'The reporting period covered in the performance discussion (e.g., Q3 2024, FY2023). Aligns with GIPS-compliant performance reporting cycles.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:slaCompliant rdf:type rdf:Property ;
    rdfs:label 'Sla Compliant' ;
    rdfs:comment 'Indicates whether this meeting was conducted within the required SLA engagement frequency for this manager tier (e.g., annual review within 12 months of prior).' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceSystemRefCode rdf:type rdf:Property ;
    rdfs:label 'Source System Ref Code' ;
    rdfs:comment 'The native identifier of this meeting record in the originating source system (e.g., DealCloud activity ID, eFront interaction ID). Supports data lineage and reconciliation.' ;
    rdfs:domain ind:Meeting ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:startTimestamp rdf:type rdf:Property ;
    rdfs:label 'Start Timestamp' ;
    rdfs:comment 'Precise date and time the meeting commenced, including timezone offset. Used for duration calculation and audit trail.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:coInvestRightId rdf:type rdf:Property ;
    rdfs:label 'Co Invest Right Id' ;
    rdfs:comment 'Unique surrogate identifier for a co-investment right record negotiated within an LP mandate. Primary key for this entity. Role: MASTER_AGREEMENT.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationBasis rdf:type rdf:Property ;
    rdfs:label 'Allocation Basis' ;
    rdfs:comment 'Basis on which the co-investment allocation right is measured: as a percentage of deal size, percentage of LP commitment, a fixed dollar cap, or uncapped.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allocationCapAmount rdf:type rdf:Property ;
    rdfs:label 'Allocation Cap Amount' ;
    rdfs:comment 'Maximum dollar amount the pension fund may invest per co-investment opportunity under this right. Applicable when allocation_basis is fixed_dollar_cap. Expressed in the mandate currency.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualUtilizationCapAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Utilization Cap Amount' ;
    rdfs:comment 'Maximum aggregate amount (in mandate currency) the pension fund may deploy under this co-investment right within a single calendar or fiscal year.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvalProcessType rdf:type rdf:Property ;
    rdfs:label 'Approval Process Type' ;
    rdfs:comment 'Internal approval process required to exercise this co-investment right: Investment Committee (IC) approval, delegated authority, CIO approval, or committee approval.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:confidentialityObligation rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Obligation' ;
    rdfs:comment 'Indicates whether the terms of this co-investment right are subject to confidentiality obligations under the LPA or NDA, restricting disclosure to third parties.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:decisionDeadlineDays rdf:type rdf:Property ;
    rdfs:label 'Decision Deadline Days' ;
    rdfs:comment 'Maximum number of calendar days within which the pension fund must communicate its investment decision (accept or decline) after receiving a co-investment opportunity notice from the GP.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgScreeningRequired rdf:type rdf:Property ;
    rdfs:label 'Esg Screening Required' ;
    rdfs:comment 'Indicates whether co-investment opportunities under this right must pass the pension fund\'s ESG screening and responsible investment assessment prior to acceptance.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityApplicable rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Applicable' ;
    rdfs:comment 'Indicates whether an exclusivity window applies to this co-investment right, preventing the GP from offering the same opportunity to other LPs during the pension fund\'s review period.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exclusivityWindowDays rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Window Days' ;
    rdfs:comment 'Number of calendar days the pension fund has exclusive right to evaluate and accept or decline a co-investment opportunity before the GP may offer it to other LPs.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:maxDealSizeAmount rdf:type rdf:Property ;
    rdfs:label 'Max Deal Size Amount' ;
    rdfs:comment 'Maximum total deal or transaction size (in mandate currency) for which this co-investment right applies. Null if no upper deal size restriction is stipulated.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minDealSizeAmount rdf:type rdf:Property ;
    rdfs:label 'Min Deal Size Amount' ;
    rdfs:comment 'Minimum total deal or transaction size (in mandate currency) for which this co-investment right is triggered. Deals below this threshold may not qualify for co-investment.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:negotiationDate rdf:type rdf:Property ;
    rdfs:label 'Negotiation Date' ;
    rdfs:comment 'Date on which this co-investment right was formally negotiated and agreed between the pension fund and the GP, typically coinciding with LPA signing or side-letter execution.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:opportunitiesAcceptedCount rdf:type rdf:Property ;
    rdfs:label 'Opportunities Accepted Count' ;
    rdfs:comment 'Cumulative number of co-investment opportunities accepted and funded by the pension fund under this right since inception. Numerator for acceptance rate analytics.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:opportunitiesDeclinedCount rdf:type rdf:Property ;
    rdfs:label 'Opportunities Declined Count' ;
    rdfs:comment 'Cumulative number of co-investment opportunities formally declined by the pension fund under this right since inception. Supports GP relationship and pipeline analytics.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:opportunitiesOfferedCount rdf:type rdf:Property ;
    rdfs:label 'Opportunities Offered Count' ;
    rdfs:comment 'Cumulative number of co-investment opportunities formally offered by the GP to the pension fund under this right since inception. Used for utilization tracking and GP relationship assessment.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:remainingCapacityAmount rdf:type rdf:Property ;
    rdfs:label 'Remaining Capacity Amount' ;
    rdfs:comment 'Remaining investable capacity under the total right cap (total_right_cap_amount minus total_deployed_amount). Null if the right is uncapped. Supports portfolio construction decisions.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightName rdf:type rdf:Property ;
    rdfs:label 'Right Name' ;
    rdfs:comment 'Descriptive human-readable name for this co-investment right, typically referencing the fund name and right type (e.g., \'Buyout Fund V Co-Invest Pro-Rata Right\').' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Right Reference Code' ;
    rdfs:comment 'Externally-known alphanumeric code uniquely identifying this co-investment right, as referenced in the LPA side-letter or mandate agreement documentation.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightStatus rdf:type rdf:Property ;
    rdfs:label 'Right Status' ;
    rdfs:comment 'Current lifecycle status of the co-investment right: active (exercisable), suspended, expired (past effective period), terminated (cancelled), or pending_negotiation.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightType rdf:type rdf:Property ;
    rdfs:label 'Right Type' ;
    rdfs:comment 'Classification of the co-investment right structure: pro_rata (proportional to LP commitment), discretionary (GP discretion), first_look, last_look, or capped_allocation.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalDeployedAmount rdf:type rdf:Property ;
    rdfs:label 'Total Deployed Amount' ;
    rdfs:comment 'Cumulative capital deployed (invested) by the pension fund under this co-investment right since inception, expressed in mandate currency. Tracks historical utilization against caps.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRightCapAmount rdf:type rdf:Property ;
    rdfs:label 'Total Right Cap Amount' ;
    rdfs:comment 'Maximum aggregate amount (in mandate currency) the pension fund may deploy under this co-investment right over the full fund term. Null if uncapped.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transferabilityPermitted rdf:type rdf:Property ;
    rdfs:label 'Transferability Permitted' ;
    rdfs:comment 'Indicates whether the pension fund may transfer or assign this co-investment right to an affiliated entity or co-investor. Governed by LPA transfer restriction clauses.' ;
    rdfs:domain ind:CoInvestRight ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lpacMembershipId rdf:type rdf:Property ;
    rdfs:label 'Lpac Membership Id' ;
    rdfs:comment 'Unique surrogate identifier for each LPAC membership position held by the pension fund across LP fund mandates. Primary key for this entity.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:alternateRepresentativeName rdf:type rdf:Property ;
    rdfs:label 'Alternate Representative Name' ;
    rdfs:comment 'Full name of the designated alternate representative who may attend and vote on behalf of the pension fund when the primary representative is unavailable.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consentMattersVotedCount rdf:type rdf:Property ;
    rdfs:label 'Consent Matters Voted Count' ;
    rdfs:comment 'Total number of GP consent matters (e.g., conflict approvals, valuation overrides, key person waivers) on which the pension fund has cast a vote via this LPAC seat.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgOversightScope rdf:type rdf:Property ;
    rdfs:label 'Esg Oversight Scope' ;
    rdfs:comment 'Scope of ESG oversight rights exercised through this LPAC seat, as defined in the LPA or side letter. Full scope includes ESG reporting review; limited scope covers specific ESG consent matters only.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundDomicileCountry rdf:type rdf:Property ;
    rdfs:label 'Fund Domicile Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the jurisdiction in which the fund is legally domiciled (e.g., CYM for Cayman Islands, LUX for Luxembourg, GBR for United Kingdom).' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundLegalEntityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Fund Legal Entity Identifier' ;
    rdfs:comment '20-character ISO 17442 Legal Entity Identifier (LEI) of the fund vehicle. Used for regulatory reporting and counterparty identification under EMIR and MiFID II.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceReviewDate rdf:type rdf:Property ;
    rdfs:label 'Governance Review Date' ;
    rdfs:comment 'Date of the most recent internal governance review of this LPAC membership, including assessment of representative suitability, conflict of interest status, and seat value to the pension fund.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gpConsentRequired rdf:type rdf:Property ;
    rdfs:label 'Gp Consent Required' ;
    rdfs:comment 'Indicates whether the General Partner (GP) must provide consent for the pension fund to transfer or assign its LPAC seat to another LP or representative.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasConflictOfInterestWaiver rdf:type rdf:Property ;
    rdfs:label 'Has Conflict Of Interest Waiver' ;
    rdfs:comment 'Indicates whether the pension fund has executed a conflict of interest waiver in connection with this LPAC seat, as required by the LPA for certain GP-related transactions.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalApprovalReference rdf:type rdf:Property ;
    rdfs:label 'Internal Approval Reference' ;
    rdfs:comment 'Reference number of the internal Investment Committee (IC) or governance body approval authorizing the pension fund\'s participation in this LPAC seat.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isLeadLp rdf:type rdf:Property ;
    rdfs:label 'Is Lead Lp' ;
    rdfs:comment 'Indicates whether the pension fund holds the lead LP designation on this LPAC, conferring additional governance rights such as chairing meetings or coordinating LP responses to GP consent requests.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Last Meeting Date' ;
    rdfs:comment 'Date of the most recent LPAC meeting attended or scheduled for this fund. Used for monitoring engagement recency and governance activity.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lpCommitmentPctOfFund rdf:type rdf:Property ;
    rdfs:label 'Lp Commitment Pct Of Fund' ;
    rdfs:comment 'The pension fund\'s committed capital as a percentage of total fund commitments at final close. Determines voting weight and LPAC seat eligibility.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpaSideLetterReference rdf:type rdf:Property ;
    rdfs:label 'Lpa Side Letter Reference' ;
    rdfs:comment 'Reference number or identifier of any side letter executed between the pension fund and the GP that modifies or supplements LPAC rights beyond the standard LPA terms.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingsAttendedCount rdf:type rdf:Property ;
    rdfs:label 'Meetings Attended Count' ;
    rdfs:comment 'Total number of LPAC meetings attended by the pension fund\'s representative since appointment or within the current reporting period. Used for attendance compliance tracking.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:meetingsScheduledCount rdf:type rdf:Property ;
    rdfs:label 'Meetings Scheduled Count' ;
    rdfs:comment 'Total number of LPAC meetings formally scheduled for this fund during the current reporting period or since appointment. Used to compute attendance rate.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:representativeName rdf:type rdf:Property ;
    rdfs:label 'Representative Name' ;
    rdfs:comment 'Full name of the internal pension fund officer or employee formally designated to represent the fund on this LPAC seat.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:representativeTitle rdf:type rdf:Property ;
    rdfs:label 'Representative Title' ;
    rdfs:comment 'Job title or role of the internal representative assigned to this LPAC seat (e.g., Managing Director, Portfolio Manager, General Counsel).' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:seatEligibilityThresholdPct rdf:type rdf:Property ;
    rdfs:label 'Seat Eligibility Threshold Pct' ;
    rdfs:comment 'Minimum LP commitment percentage of total fund commitments required to qualify for an LPAC seat, as stipulated in the LPA. Expressed as a percentage (e.g., 5.0000 = 5%).' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seatSource rdf:type rdf:Property ;
    rdfs:label 'Seat Source' ;
    rdfs:comment 'Indicates the contractual basis under which the LPAC seat was obtained: standard LPA provision, side letter negotiation, LPA amendment, or transfer from another LP.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:termExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Term Expiry Date' ;
    rdfs:comment 'Date on which the current LPAC membership term expires or is subject to renewal. Null if the seat is held for the full life of the fund with no fixed term.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:votingWeightPct rdf:type rdf:Property ;
    rdfs:label 'Voting Weight Pct' ;
    rdfs:comment 'Percentage of total LPAC voting rights held by the pension fund on this committee, as defined in the LPA. Applicable only for voting seat types; null for observer seats.' ;
    rdfs:domain ind:LpacMembership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategyCode rdf:type rdf:Property ;
    rdfs:label 'Strategy Code' ;
    rdfs:comment 'Alphanumeric code used to identify the strategy in external systems.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategyStatus rdf:type rdf:Property ;
    rdfs:label 'Strategy Status' ;
    rdfs:comment 'Current lifecycle status of the strategy.' ;
    rdfs:domain ind:Strategy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subStrategyType rdf:type rdf:Property ;
    rdfs:label 'Sub Strategy Type' ;
    rdfs:comment 'Specific sub-strategy focus. [ENUM-REF-CANDIDATE: Buyout|Venture|Growth|Distressed|Core Real Estate|Value-Add|Infrastructure Greenfield|... — promote to reference product]' ;
    rdfs:domain ind:Strategy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetCarryRate rdf:type rdf:Property ;
    rdfs:label 'Target Carry Rate' ;
    rdfs:comment 'Target carried interest rate for the strategy.' ;
    rdfs:domain ind:Strategy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetCoInvestmentFlag rdf:type rdf:Property ;
    rdfs:label 'Target Co Investment Flag' ;
    rdfs:comment 'Flag indicating if co-investment is allowed for the strategy.' ;
    rdfs:domain ind:Strategy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetCommitment rdf:type rdf:Property ;
