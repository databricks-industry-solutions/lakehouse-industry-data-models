    rdfs:domain ind:AnalystAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:assignmentIdentifier rdf:type rdf:Property ;
    rdfs:label 'Assignment Identifier' ;
    rdfs:comment 'Business-readable unique identifier for the assignment, used in research systems and Investment Committee (IC) materials.' ;
