    rdf:type owl:ObjectProperty ;
    rdfs:range ind:IssuerFinancials .

ind:capitalExpenditures rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditures' ;
    rdfs:comment 'Cash spent on property, plant, equipment, and intangible assets during the period, in reporting currency.' ;
    rdfs:domain ind:IssuerFinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costOfRevenue rdf:type rdf:Property ;
    rdfs:label 'Cost Of Revenue' ;
    rdfs:comment 'Direct costs attributable to revenue generation, in reporting currency.' ;
    rdfs:domain ind:IssuerFinancials ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dataProvider rdf:type rdf:Property ;
