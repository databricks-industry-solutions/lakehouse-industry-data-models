    rdfs:comment 'List of United Nations Sustainable Development Goals that the carbon project contributes to.' ;
    rdfs:domain ind:CarbonCredit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationBody rdf:type rdf:Property ;
    rdfs:label 'Verification Body' ;
    rdfs:comment 'Name of the independent third-party organization that verified the carbon project.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationStandard rdf:type rdf:Property ;
    rdfs:label 'Verification Standard' ;
    rdfs:comment 'Name of the verification standard or methodology applied to validate the carbon reduction or sequestration.' ;
    rdfs:domain ind:CarbonCredit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:offtakeAgreementId rdf:type rdf:Property ;
    rdfs:label 'Offtake Agreement Id' ;
    rdfs:comment 'Unique identifier for the offtake agreement record. Primary key for this master agreement entity.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OfftakeAgreement .

ind:annualVolumeQuantity rdf:type rdf:Property ;
    rdfs:label 'Annual Volume Quantity' ;
    rdfs:comment 'Contracted annual volume of commodity to be delivered under this offtake agreement, expressed in the unit of measure specified.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:benchmarkIndexName rdf:type rdf:Property ;
    rdfs:label 'Benchmark Index Name' ;
    rdfs:comment 'Name of the commodity price index or benchmark used for floating or indexed pricing mechanisms, such as LME, ICE, or regional spot indices.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceilingPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Ceiling Price Amount' ;
    rdfs:comment 'Maximum price per unit capped under the offtake agreement, providing cost certainty for the buyer.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commoditySpecification rdf:type rdf:Property ;
    rdfs:label 'Commodity Specification' ;
    rdfs:comment 'Detailed specification of the commodity including grade, quality standards, physical characteristics, and delivery specifications as defined in the agreement.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Contract Document Reference' ;
    rdfs:comment 'Document management system reference or file path to the executed offtake agreement legal document.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditSupportAmount rdf:type rdf:Property ;
    rdfs:label 'Credit Support Amount' ;
    rdfs:comment 'Monetary value of credit support or collateral required from the counterparty to mitigate payment default risk.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditSupportRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Support Required Flag' ;
    rdfs:comment 'Indicates whether the counterparty is required to provide credit support such as letters of credit, guarantees, or collateral to secure payment obligations.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:deliveryIncoterm rdf:type rdf:Property ;
    rdfs:label 'Delivery Incoterm' ;
    rdfs:comment 'International Commercial Terms code defining the allocation of costs, risks, and responsibilities between buyer and seller for commodity delivery. [ENUM-REF-CANDIDATE: EXW|FCA|CPT|CIP|DAP|DPU|DDP|FAS|FOB|CFR|CIF — 11 candidates stripped; promote to' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deliveryPointLocation rdf:type rdf:Property ;
    rdfs:label 'Delivery Point Location' ;
    rdfs:comment 'Physical location or facility where commodity delivery and title transfer occurs under the terms of this offtake agreement.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgCertificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Certification Required Flag' ;
    rdfs:comment 'Indicates whether the offtake agreement mandates ESG certifications or sustainability standards for the commodity production and delivery.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgCertificationType rdf:type rdf:Property ;
    rdfs:label 'Esg Certification Type' ;
    rdfs:comment 'Type or name of ESG certification or sustainability standard required under the offtake agreement, such as FSC, Fairtrade, or ISO 14001.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixedPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Fixed Price Amount' ;
    rdfs:comment 'Fixed price per unit for commodity sales if the pricing mechanism is fixed, representing the locked-in sale price.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floorPriceAmount rdf:type rdf:Property ;
    rdfs:label 'Floor Price Amount' ;
    rdfs:comment 'Minimum price per unit guaranteed under the offtake agreement, providing downside protection for the seller.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureClause rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Clause' ;
    rdfs:comment 'Text or reference to the force majeure provisions defining events that excuse non-performance by either party without liability.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumOfftakePercentage rdf:type rdf:Property ;
    rdfs:label 'Minimum Offtake Percentage' ;
    rdfs:comment 'Minimum percentage of contracted annual volume that the buyer is obligated to purchase under take-or-pay or minimum purchase provisions.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Price Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for all pricing and payment terms in this offtake agreement.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricingMechanism rdf:type rdf:Property ;
    rdfs:label 'Pricing Mechanism' ;
    rdfs:comment 'Type of pricing structure governing commodity sales under this agreement, determining how prices are set or adjusted over time.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Flag' ;
    rdfs:comment 'Indicates whether the offtake agreement includes an option for either party to renew or extend the contract term beyond the initial expiry date.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:takeOrPayFlag rdf:type rdf:Property ;
    rdfs:label 'Take Or Pay Flag' ;
    rdfs:comment 'Indicates whether the agreement includes a take-or-pay provision requiring the buyer to pay for minimum volumes regardless of actual offtake.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalContractVolumeQuantity rdf:type rdf:Property ;
    rdfs:label 'Total Contract Volume Quantity' ;
    rdfs:comment 'Total cumulative volume of commodity committed over the entire term of the offtake agreement.' ;
    rdfs:domain ind:OfftakeAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volumeUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Volume Unit Of Measure' ;
    rdfs:comment 'Standard unit of measure for commodity volumes specified in this offtake agreement. [ENUM-REF-CANDIDATE: tonnes|barrels|cubic_meters|board_feet|bushels|pounds|kilograms|megawatt_hours|troy_ounces — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketDataFeedId rdf:type rdf:Property ;
    rdfs:label 'Market Data Feed Id' ;
    rdfs:comment 'Foreign key linking to research.market_data_feed. Business justification: Price decks are sourced from market data feeds for real-time pricing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarketDataFeed .

ind:deckName rdf:type rdf:Property ;
    rdfs:label 'Deck Name' ;
    rdfs:comment 'Business name or label for this commodity price deck.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckStatus rdf:type rdf:Property ;
    rdfs:label 'Deck Status' ;
    rdfs:comment 'Current lifecycle status of the price deck.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deckVersion rdf:type rdf:Property ;
    rdfs:label 'Deck Version' ;
    rdfs:comment 'Version identifier for this price deck iteration.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgImpactConsideration rdf:type rdf:Property ;
    rdfs:label 'Esg Impact Consideration' ;
    rdfs:comment 'Description of ESG factors considered in the price forecast (e.g., carbon pricing, regulatory changes).' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastQuarter rdf:type rdf:Property ;
    rdfs:label 'Forecast Quarter' ;
    rdfs:comment 'Calendar quarter within the forecast year (1-4), if applicable.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forecastYear rdf:type rdf:Property ;
    rdfs:label 'Forecast Year' ;
    rdfs:comment 'Calendar year for which this price forecast applies.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:geopoliticalRiskFactor rdf:type rdf:Property ;
    rdfs:label 'Geopolitical Risk Factor' ;
    rdfs:comment 'Assessment of geopolitical risk impacting commodity price stability.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationAdjustmentFlag rdf:type rdf:Property ;
    rdfs:label 'Inflation Adjustment Flag' ;
    rdfs:comment 'Indicates whether the price forecast includes inflation adjustment (real vs nominal prices).' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:inflationRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Inflation Rate Assumption' ;
    rdfs:comment 'Annual inflation rate assumption used in the price forecast, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketConditionsSummary rdf:type rdf:Property ;
    rdfs:label 'Market Conditions Summary' ;
    rdfs:comment 'Summary of macroeconomic and market conditions underlying the price forecast.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceCeiling rdf:type rdf:Property ;
    rdfs:label 'Price Ceiling' ;
    rdfs:comment 'Maximum price assumption used in upside scenario analysis.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceFloor rdf:type rdf:Property ;
    rdfs:label 'Price Floor' ;
    rdfs:comment 'Minimum price assumption used in stress testing or downside scenario analysis.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceHorizon rdf:type rdf:Property ;
    rdfs:label 'Price Horizon' ;
    rdfs:comment 'Time horizon for the price forecast (spot, short-term 1-3 years, medium-term 3-10 years, long-term 10+ years).' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Price Per Unit' ;
    rdfs:comment 'Forecasted price per unit of the commodity.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Frequency' ;
    rdfs:comment 'Frequency at which this price deck is reviewed and updated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceProvider rdf:type rdf:Property ;
    rdfs:label 'Source Provider' ;
    rdfs:comment 'Name of the external provider or internal team that generated the price forecast.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceReportReference rdf:type rdf:Property ;
    rdfs:label 'Source Report Reference' ;
    rdfs:comment 'Reference identifier or document name of the source report or research publication.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sourceType rdf:type rdf:Property ;
    rdfs:label 'Source Type' ;
    rdfs:comment 'Source of the price forecast (internal research, external consultant, market consensus, proprietary model).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:supplyDemandBalance rdf:type rdf:Property ;
    rdfs:label 'Supply Demand Balance' ;
    rdfs:comment 'Assumed supply-demand balance for the commodity in the forecast period.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:volatilityAssumption rdf:type rdf:Property ;
    rdfs:label 'Volatility Assumption' ;
    rdfs:comment 'Price volatility assumption used in scenario modeling, expressed as a decimal.' ;
    rdfs:domain ind:CommodityPriceDeck ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceBudgetId rdf:type rdf:Property ;
    rdfs:label 'Resource Budget Id' ;
    rdfs:comment 'Unique identifier for the natural resource asset budget record.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Asset Manager Employee Id' ;
    rdfs:comment 'Reference to the asset manager responsible for this natural resource asset and its budget.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:preparedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Prepared By User Employee Id' ;
    rdfs:comment 'Identifier of the user who prepared the budget.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:budgetAmount rdf:type rdf:Property ;
    rdfs:label 'Budget Amount' ;
    rdfs:comment 'Total budgeted amount for this category and period in local currency.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Category' ;
    rdfs:comment 'Detailed category of expenditure within the budget type such as labor, equipment, materials, utilities, maintenance, or environmental compliance.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNotes rdf:type rdf:Property ;
    rdfs:label 'Budget Notes' ;
    rdfs:comment 'Additional notes, assumptions, or commentary supporting the budget submission.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetNumber rdf:type rdf:Property ;
    rdfs:label 'Budget Number' ;
    rdfs:comment 'Externally-known unique identifier for this budget submission or version.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Status' ;
    rdfs:comment 'Current approval and lifecycle status of the budget. [ENUM-REF-CANDIDATE: draft|submitted|under_review|approved|rejected|revised|active|closed — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetType rdf:type rdf:Property ;
    rdfs:label 'Budget Type' ;
    rdfs:comment 'Classification of budget expenditure: operating expense, capital expense, sustaining capital, growth capital, reclamation, closure, exploration, or development.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetYear rdf:type rdf:Property ;
    rdfs:label 'Budget Year' ;
    rdfs:comment 'Fiscal year for which this budget is prepared.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cashFlowForecast rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Forecast' ;
    rdfs:comment 'Forecasted net cash flow from operations for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyReserve rdf:type rdf:Property ;
    rdfs:label 'Contingency Reserve' ;
    rdfs:comment 'Budgeted contingency reserve for unforeseen costs or operational variability.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionExpense rdf:type rdf:Property ;
    rdfs:label 'Depletion Expense' ;
    rdfs:comment 'Budgeted depletion expense for natural resource extraction during the period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationExpense rdf:type rdf:Property ;
    rdfs:label 'Depreciation Expense' ;
    rdfs:comment 'Budgeted depreciation expense for property, plant, and equipment during the period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaForecast rdf:type rdf:Property ;
    rdfs:label 'Ebitda Forecast' ;
    rdfs:comment 'Forecasted EBITDA for the budget period reflecting operating performance before non-cash charges.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyConsumptionTargetMwh rdf:type rdf:Property ;
    rdfs:label 'Energy Consumption Target Mwh' ;
    rdfs:comment 'Target energy consumption in megawatt hours for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalComplianceCost rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Cost' ;
    rdfs:comment 'Budgeted cost for environmental monitoring, reporting, and compliance activities.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgEmissionsTargetTonnes rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Target Tonnes' ;
    rdfs:comment 'Target greenhouse gas emissions in tonnes of carbon dioxide equivalent for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionVolumeTarget rdf:type rdf:Property ;
    rdfs:label 'Production Volume Target' ;
    rdfs:comment 'Approved target production volume for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reclamationProvision rdf:type rdf:Property ;
    rdfs:label 'Reclamation Provision' ;
    rdfs:comment 'Budgeted provision for asset retirement and land reclamation obligations.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueForecast rdf:type rdf:Property ;
    rdfs:label 'Revenue Forecast' ;
    rdfs:comment 'Forecasted gross revenue for the budget period based on production and commodity price assumptions.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionNumber rdf:type rdf:Property ;
    rdfs:label 'Revision Number' ;
    rdfs:comment 'Sequential revision number for tracking budget versions and amendments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:safetyIncidentTarget rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Target' ;
    rdfs:comment 'Target maximum number of recordable safety incidents for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:varianceThresholdPercentage rdf:type rdf:Property ;
    rdfs:label 'Variance Threshold Percentage' ;
    rdfs:comment 'Acceptable variance threshold percentage for budget versus actual performance before escalation is required.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterUsageTargetCubicMeters rdf:type rdf:Property ;
    rdfs:label 'Water Usage Target Cubic Meters' ;
    rdfs:comment 'Target water consumption in cubic meters for the budget period.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workforceHeadcountTarget rdf:type rdf:Property ;
    rdfs:label 'Workforce Headcount Target' ;
    rdfs:comment 'Planned workforce headcount for the budget period including direct employees and contractors.' ;
    rdfs:domain ind:ResourceBudget ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reclamationLiabilityId rdf:type rdf:Property ;
    rdfs:label 'Reclamation Liability Id' ;
    rdfs:comment 'Unique identifier for the asset retirement obligation and site reclamation liability record.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accretionExpenseCurrentPeriod rdf:type rdf:Property ;
    rdfs:label 'Accretion Expense Current Period' ;
    rdfs:comment 'Periodic increase in the carrying amount of the ARO liability due to passage of time, recognized as operating expense in the current reporting period.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualExpenditureToDate rdf:type rdf:Property ;
    rdfs:label 'Actual Expenditure To Date' ;
    rdfs:comment 'Cumulative cash outflows incurred for reclamation activities to date, reducing the outstanding liability balance as work is performed.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaToReclaimHectares rdf:type rdf:Property ;
    rdfs:label 'Area To Reclaim Hectares' ;
    rdfs:comment 'Total land area in hectares requiring reclamation work including disturbed surface, tailings ponds, waste rock piles, and access roads.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:aroReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Aro Reference Number' ;
    rdfs:comment 'Business identifier for the asset retirement obligation used in financial reporting and regulatory filings.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bondExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Bond Expiry Date' ;
    rdfs:comment 'Expiration date of the reclamation bond requiring renewal or replacement to maintain regulatory compliance and permit validity.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:bondProvider rdf:type rdf:Property ;
    rdfs:label 'Bond Provider' ;
    rdfs:comment 'Name of the financial institution or surety company providing the reclamation bond or financial assurance instrument.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contingentLiabilityFlag rdf:type rdf:Property ;
    rdfs:label 'Contingent Liability Flag' ;
    rdfs:comment 'Indicates whether the reclamation obligation is contingent on future events (e.g., permit expiry, production cessation) rather than a present obligation requiring immediate recognition.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costEstimationMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Estimation Method' ;
    rdfs:comment 'Methodology used to develop the undiscounted reclamation cost estimate, determining the reliability and audit trail of the liability valuation.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costEstimatorName rdf:type rdf:Property ;
    rdfs:label 'Cost Estimator Name' ;
    rdfs:comment 'Name of the engineering firm, consultant, or internal team responsible for preparing the reclamation cost estimate and supporting documentation.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeAccretionExpense rdf:type rdf:Property ;
    rdfs:label 'Cumulative Accretion Expense' ;
    rdfs:comment 'Total accretion expense recognized since initial recognition of the ARO, representing the time-value growth of the liability to date.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimateDate rdf:type rdf:Property ;
    rdfs:label 'Estimate Date' ;
    rdfs:comment 'Date when the current reclamation cost estimate was prepared or last updated, establishing the baseline for financial reporting and regulatory compliance.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:estimatedDurationMonths rdf:type rdf:Property ;
    rdfs:label 'Estimated Duration Months' ;
    rdfs:comment 'Expected time period in months required to complete all reclamation activities from commencement to final regulatory certification.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:expectedSettlementDate rdf:type rdf:Property ;
    rdfs:label 'Expected Settlement Date' ;
    rdfs:comment 'Estimated date when the reclamation work is expected to be completed and the liability settled, typically aligned with end of asset productive life.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundingStatus rdf:type rdf:Property ;
    rdfs:label 'Funding Status' ;
    rdfs:comment 'Assessment of whether adequate financial resources (bonds, trust funds, restricted cash) are in place to cover the estimated reclamation liability.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:initialRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Initial Recognition Date' ;
    rdfs:comment 'Date when the asset retirement obligation was first recognized on the balance sheet per accounting standards.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Last Revision Date' ;
    rdfs:comment 'Date of the most recent update to the reclamation cost estimate or ARO liability valuation assumptions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:liabilityStatus rdf:type rdf:Property ;
    rdfs:label 'Liability Status' ;
    rdfs:comment 'Current state of the reclamation liability in its lifecycle from initial estimation through final completion and regulatory sign-off.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityType rdf:type rdf:Property ;
    rdfs:label 'Liability Type' ;
    rdfs:comment 'Classification of the reclamation obligation based on the nature of the extractive activity and required remediation work. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:monitoringPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Monitoring Period Years' ;
    rdfs:comment 'Required post-reclamation monitoring and maintenance period in years before final regulatory sign-off and liability release can be obtained.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:presentValueAro rdf:type rdf:Property ;
    rdfs:label 'Present Value Aro' ;
    rdfs:comment 'Discounted present value of the estimated reclamation cost recognized as a liability on the balance sheet per accounting standards.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reclamationBondAmount rdf:type rdf:Property ;
    rdfs:label 'Reclamation Bond Amount' ;
    rdfs:comment 'Financial assurance or surety bond posted with regulatory authorities to guarantee funding for site reclamation if the operator defaults.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reclamationPlanReference rdf:type rdf:Property ;
    rdfs:label 'Reclamation Plan Reference' ;
    rdfs:comment 'Document identifier or reference number for the approved site reclamation plan filed with environmental regulators detailing closure activities and timeline.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reclamationScopeDescription rdf:type rdf:Property ;
    rdfs:label 'Reclamation Scope Description' ;
    rdfs:comment 'Detailed narrative of the required reclamation activities including land recontouring, revegetation, water treatment, structure removal, and monitoring obligations.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Deadline Date' ;
    rdfs:comment 'Mandatory completion date imposed by environmental regulators or permit conditions for site reclamation activities.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remainingLiabilityBalance rdf:type rdf:Property ;
    rdfs:label 'Remaining Liability Balance' ;
    rdfs:comment 'Current outstanding ARO liability after adjusting for accretion, revisions, and actual expenditures, representing the present value of future reclamation obligations.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revisionAmount rdf:type rdf:Property ;
    rdfs:label 'Revision Amount' ;
    rdfs:comment 'Change in the ARO liability due to revised cost estimates, timing changes, or discount rate adjustments, recorded as adjustment to asset carrying value or expense.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trustFundBalance rdf:type rdf:Property ;
    rdfs:label 'Trust Fund Balance' ;
    rdfs:comment 'Current balance of dedicated reclamation trust fund or restricted cash account set aside to fund future site closure and remediation activities.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:undiscountedCostEstimate rdf:type rdf:Property ;
    rdfs:label 'Undiscounted Cost Estimate' ;
    rdfs:comment 'Total estimated cost of reclamation activities in nominal future dollars before applying present value discount, representing the full expected cash outflow.' ;
    rdfs:domain ind:ReclamationLiability ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biodiversityCommitmentFlag rdf:type rdf:Property ;
    rdfs:label 'Biodiversity Commitment Flag' ;
    rdfs:comment 'Indicates whether the fund has explicit biodiversity protection or enhancement commitments in its investment mandate.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:carbonIntensityTarget rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Target' ;
    rdfs:comment 'Target greenhouse gas (GHG) emissions intensity for the fund portfolio, measured in tonnes CO2 equivalent per unit of production or revenue, aligned with climate commitments.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dealTeamLead rdf:type rdf:Property ;
    rdfs:label 'Deal Team Lead' ;
    rdfs:comment 'Name of the internal investment professional responsible for originating, underwriting, and monitoring this fund commitment.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:finalClosingDate rdf:type rdf:Property ;
    rdfs:label 'Final Closing Date' ;
    rdfs:comment 'Date of the funds final closing after which no additional Limited Partners (LPs) may join and total fund size is fixed.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstClosingDate rdf:type rdf:Property ;
    rdfs:label 'First Closing Date' ;
    rdfs:comment 'Date of the funds initial closing when the General Partner (GP) began accepting capital commitments.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fundSizeTotal rdf:type rdf:Property ;
    rdfs:label 'Fund Size Total' ;
    rdfs:comment 'Total capital commitments raised by the fund from all Limited Partners (LPs) at final closing, representing the funds aggregate investment capacity.' ;
    rdfs:domain ind:ResourceFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpLei rdf:type rdf:Property ;
    rdfs:label 'Gp Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the General Partner, used for regulatory reporting and counterparty identification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyPersonClause rdf:type rdf:Property ;
    rdfs:label 'Key Person Clause' ;
    rdfs:comment 'Description of the key person provisions in the Limited Partnership Agreement (LPA) that suspend the investment period if specified senior investment professionals leave the General Partner (GP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceCashflowId rdf:type rdf:Property ;
    rdfs:label 'Resource Cashflow Id' ;
    rdfs:comment 'Unique identifier for the natural resource cash flow record.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalExpenditureAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Amount' ;
    rdfs:comment 'Capital expenditures for asset development or infrastructure.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashflowCategory rdf:type rdf:Property ;
    rdfs:label 'Cashflow Category' ;
    rdfs:comment 'Detailed business category of the cash flow transaction.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashflowPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Cashflow Period End Date' ;
    rdfs:comment 'End date of the period covered by this cash flow record.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cashflowPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Cashflow Period Start Date' ;
    rdfs:comment 'Start date of the period covered by this cash flow record.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cashflowStatus rdf:type rdf:Property ;
    rdfs:label 'Cashflow Status' ;
    rdfs:comment 'Current status of the cash flow record in its lifecycle.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashflowType rdf:type rdf:Property ;
    rdfs:label 'Cashflow Type' ;
    rdfs:comment 'Classification of the cash flow by activity type per accounting standards.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Per Unit' ;
    rdfs:comment 'Realized price per unit of commodity for revenue cash flows.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:counterpartyLegalEntityCode rdf:type rdf:Property ;
    rdfs:label 'Counterparty Legal Entity Code' ;
    rdfs:comment 'Reference to the counterparty legal entity involved in the transaction.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depletionChargeAmount rdf:type rdf:Property ;
    rdfs:label 'Depletion Charge Amount' ;
    rdfs:comment 'Non-cash depletion charge allocated to this period for resource consumption.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Revenue Amount' ;
    rdfs:comment 'Total gross revenue before deductions for the period.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCashflowAmount rdf:type rdf:Property ;
    rdfs:label 'Net Cashflow Amount' ;
    rdfs:comment 'Net cash flow amount after all inflows and outflows for the period.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCashflowBaseAmount rdf:type rdf:Property ;
    rdfs:label 'Net Cashflow Base Amount' ;
    rdfs:comment 'Net cash flow amount converted to base reporting currency.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Operating Expense Amount' ;
    rdfs:comment 'Operating expenses incurred for resource extraction or production.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reclamationContributionAmount rdf:type rdf:Property ;
    rdfs:label 'Reclamation Contribution Amount' ;
    rdfs:comment 'Contributions to reclamation or environmental restoration funds.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Royalty Amount' ;
    rdfs:comment 'Royalty payment amount to landowners or government entities.' ;
    rdfs:domain ind:ResourceCashflow ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationalIncidentId rdf:type rdf:Property ;
    rdfs:label 'Operational Incident Id' ;
    rdfs:comment 'Unique identifier for the operational incident record affecting natural resource asset operations.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:correctiveActionPlan rdf:type rdf:Property ;
    rdfs:label 'Corrective Action Plan' ;
    rdfs:comment 'Summary of the corrective action plan implemented to prevent recurrence including process changes, equipment upgrades, and training initiatives.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:downtimeHours rdf:type rdf:Property ;
    rdfs:label 'Downtime Hours' ;
    rdfs:comment 'Total number of hours that operations were halted or significantly impaired due to the incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalImpactDescription rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Description' ;
    rdfs:comment 'Description of the environmental impacts resulting from the incident including affected ecosystems, contamination extent, and species or habitat damage.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Impact Flag' ;
    rdfs:comment 'Indicates whether the incident resulted in environmental damage, contamination, or ecological harm requiring assessment and remediation.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:estimatedFinancialImpact rdf:type rdf:Property ;
    rdfs:label 'Estimated Financial Impact' ;
    rdfs:comment 'Estimated total financial impact of the incident including lost revenue, remediation costs, penalties, and asset damage in base currency.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fatalityCount rdf:type rdf:Property ;
    rdfs:label 'Fatality Count' ;
    rdfs:comment 'Number of fatalities resulting from the operational incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:forceMajeureFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Flag' ;
    rdfs:comment 'Indicates whether the incident qualifies as a force majeure event under applicable contracts and legal agreements.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghgEmissionsImpact rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Impact' ;
    rdfs:comment 'Estimated greenhouse gas emissions resulting from the incident measured in tonnes of carbon dioxide equivalent for climate impact assessment.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incidentDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Description' ;
    rdfs:comment 'Comprehensive narrative description of the operational incident including circumstances, contributing factors, immediate impacts, and initial response actions taken.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentEndTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident End Timestamp' ;
    rdfs:comment 'Date and time when the operational incident was resolved or contained, allowing resumption of normal operations.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentLocationDescription rdf:type rdf:Property ;
    rdfs:label 'Incident Location Description' ;
    rdfs:comment 'Detailed description of the specific location within the natural resource asset where the incident occurred including parcel, facility, or operational area.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentNotes rdf:type rdf:Property ;
    rdfs:label 'Incident Notes' ;
    rdfs:comment 'Additional notes, observations, or supplementary information related to the incident not captured in other structured fields.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentNumber rdf:type rdf:Property ;
    rdfs:label 'Incident Number' ;
    rdfs:comment 'Externally-known unique reference number assigned to this operational incident for tracking and reporting purposes.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentStartTimestamp rdf:type rdf:Property ;
    rdfs:label 'Incident Start Timestamp' ;
    rdfs:comment 'Date and time when the operational incident began or was first detected at the natural resource asset location.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:incidentStatus rdf:type rdf:Property ;
    rdfs:label 'Incident Status' ;
    rdfs:comment 'Current state of the incident in its lifecycle from initial reporting through investigation, containment, resolution, and closure.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incidentType rdf:type rdf:Property ;
    rdfs:label 'Incident Type' ;
    rdfs:comment 'Classification of the operational incident affecting natural resource operations including weather events, equipment failures, regulatory actions, labor disputes, environmental incidents, and natural disasters.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:injuryCount rdf:type rdf:Property ;
    rdfs:label 'Injury Count' ;
    rdfs:comment 'Number of personnel injuries resulting from the operational incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insuranceClaimFlag rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Flag' ;
    rdfs:comment 'Indicates whether an insurance claim has been filed for losses or damages resulting from this operational incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceClaimNumber rdf:type rdf:Property ;
    rdfs:label 'Insurance Claim Number' ;
    rdfs:comment 'Reference number assigned by the insurance carrier for the claim filed in relation to this incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Insurance Recovery Amount' ;
    rdfs:comment 'Amount recovered or expected to be recovered from insurance coverage for losses incurred from the incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investigationCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Investigation Completion Date' ;
    rdfs:comment 'Date when the formal investigation into the incident was completed and final report issued.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investigationStatus rdf:type rdf:Property ;
    rdfs:label 'Investigation Status' ;
    rdfs:comment 'Current status of the formal investigation into the incident causes, impacts, and corrective actions.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lessonsLearned rdf:type rdf:Property ;
    rdfs:label 'Lessons Learned' ;
    rdfs:comment 'Documentation of key lessons learned from the incident for knowledge sharing and continuous improvement of operational risk management practices.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Production Impact Flag' ;
    rdfs:comment 'Indicates whether the incident resulted in disruption or reduction of production output from the natural resource asset.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:productionLossUnit rdf:type rdf:Property ;
    rdfs:label 'Production Loss Unit' ;
    rdfs:comment 'Unit of measure for the production loss volume such as cubic meters, barrels, tonnes, board feet, or megawatt hours depending on resource type.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionLossVolume rdf:type rdf:Property ;
    rdfs:label 'Production Loss Volume' ;
    rdfs:comment 'Quantified volume of production lost due to the operational incident measured in the assets standard unit of production.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryAuthorityName rdf:type rdf:Property ;
    rdfs:label 'Regulatory Authority Name' ;
    rdfs:comment 'Name of the regulatory authority or government agency notified of the incident.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Date' ;
    rdfs:comment 'Date when regulatory authorities were formally notified of the operational incident as required by applicable regulations.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryNotificationRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Notification Required Flag' ;
    rdfs:comment 'Indicates whether the incident requires mandatory notification to regulatory authorities or government agencies.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:remediationCost rdf:type rdf:Property ;
    rdfs:label 'Remediation Cost' ;
    rdfs:comment 'Actual or estimated cost of remediation activities including cleanup, repair, restoration, and corrective actions required to address the incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportedByName rdf:type rdf:Property ;
    rdfs:label 'Reported By Name' ;
    rdfs:comment 'Name of the individual or entity who first reported the operational incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Reported Timestamp' ;
    rdfs:comment 'Date and time when the incident was formally reported to management or regulatory authorities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:responseTeamAssigned rdf:type rdf:Property ;
    rdfs:label 'Response Team Assigned' ;
    rdfs:comment 'Name or identifier of the incident response team or emergency response unit assigned to manage and resolve the incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rootCauseAnalysis rdf:type rdf:Property ;
    rdfs:label 'Root Cause Analysis' ;
    rdfs:comment 'Summary of the root cause analysis findings identifying underlying factors that led to the incident and systemic issues requiring remediation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:safetyIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Flag' ;
    rdfs:comment 'Indicates whether the operational incident involved worker safety issues, injuries, or occupational health hazards.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyInvolvementFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Involvement Flag' ;
    rdfs:comment 'Indicates whether third-party contractors, vendors, or external parties were involved in or contributed to the incident.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:thirdPartyName rdf:type rdf:Property ;
    rdfs:label 'Third Party Name' ;
    rdfs:comment 'Name of the third-party entity involved in the incident if applicable.' ;
    rdfs:domain ind:OperationalIncident ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:harvestPlanId rdf:type rdf:Property ;
    rdfs:label 'Harvest Plan Id' ;
    rdfs:comment 'Unique identifier for the harvest plan record.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualHarvestEndDate rdf:type rdf:Property ;
    rdfs:label 'Actual Harvest End Date' ;
    rdfs:comment 'Actual date when harvest operations concluded, used for performance tracking and variance analysis.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualHarvestStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Harvest Start Date' ;
    rdfs:comment 'Actual date when harvest operations commenced, used for performance tracking and variance analysis.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:actualHarvestVolume rdf:type rdf:Property ;
    rdfs:label 'Actual Harvest Volume' ;
    rdfs:comment 'Actual total volume or quantity of resource harvested, used for reconciliation against planned volume.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:biodiversityImpactAssessment rdf:type rdf:Property ;
    rdfs:label 'Biodiversity Impact Assessment' ;
    rdfs:comment 'Qualitative assessment of the harvest plans impact on local biodiversity and ecosystem services.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonSequestrationImpact rdf:type rdf:Property ;
    rdfs:label 'Carbon Sequestration Impact' ;
    rdfs:comment 'Estimated net change in carbon sequestration resulting from the harvest, expressed in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedCost rdf:type rdf:Property ;
    rdfs:label 'Estimated Cost' ;
    rdfs:comment 'Projected total cost of harvest operations including labor, equipment, transportation, and regulatory compliance.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedRevenue rdf:type rdf:Property ;
    rdfs:label 'Estimated Revenue' ;
    rdfs:comment 'Projected gross revenue from the planned harvest based on current commodity prices and volume assumptions.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedYieldPerHectare rdf:type rdf:Property ;
    rdfs:label 'Estimated Yield Per Hectare' ;
    rdfs:comment 'Projected average yield per hectare based on site productivity, stand age, and historical performance.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:harvestAreaHectares rdf:type rdf:Property ;
    rdfs:label 'Harvest Area Hectares' ;
    rdfs:comment 'Total land area in hectares designated for harvest activities under this plan.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planEndDate rdf:type rdf:Property ;
    rdfs:label 'Plan End Date' ;
    rdfs:comment 'Planned date when harvest activities are scheduled to conclude under this plan.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedHarvestVolume rdf:type rdf:Property ;
    rdfs:label 'Planned Harvest Volume' ;
    rdfs:comment 'Estimated total volume or quantity of resource planned for harvest expressed in the unit of measure specified.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reforestationDeadlineDate rdf:type rdf:Property ;
    rdfs:label 'Reforestation Deadline Date' ;
    rdfs:comment 'Regulatory or contractual deadline by which reforestation or regeneration activities must be completed.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reforestationPlanFlag rdf:type rdf:Property ;
    rdfs:label 'Reforestation Plan Flag' ;
    rdfs:comment 'Indicates whether a formal reforestation or regeneration plan is required and documented for this harvest area.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:rotationAgeYears rdf:type rdf:Property ;
    rdfs:label 'Rotation Age Years' ;
    rdfs:comment 'Age of the timber stand or crop rotation cycle at the time of planned harvest, relevant for sustainable yield calculations.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:speciesType rdf:type rdf:Property ;
    rdfs:label 'Species Type' ;
    rdfs:comment 'Primary timber species or agricultural crop type targeted for harvest under this plan.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weatherDependencyFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Dependency Flag' ;
    rdfs:comment 'Indicates whether harvest timing and execution are significantly dependent on favorable weather conditions.' ;
    rdfs:domain ind:HarvestPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:additionalityType rdf:type rdf:Property ;
    rdfs:label 'Additionality Type' ;
    rdfs:comment 'Method used to demonstrate that carbon reductions would not occur without project intervention.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:article6EligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Article 6 Eligible Flag' ;
    rdfs:comment 'Indicates whether credits qualify for Paris Agreement Article 6 international transfers.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:bufferPoolContributionPercent rdf:type rdf:Property ;
    rdfs:label 'Buffer Pool Contribution Percent' ;
    rdfs:comment 'Percentage of issued credits contributed to the registry buffer pool for permanence risk.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ccbCertificationFlag rdf:type rdf:Property ;
    rdfs:label 'Ccb Certification Flag' ;
    rdfs:comment 'Indicates whether the project holds Climate Community and Biodiversity Standards certification.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coBenefitsFlag rdf:type rdf:Property ;
    rdfs:label 'Co Benefits Flag' ;
    rdfs:comment 'Indicates whether the project delivers verified co-benefits beyond carbon reduction.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:corsiaEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Corsia Eligible Flag' ;
    rdfs:comment 'Indicates whether credits are eligible for ICAO CORSIA aviation offsetting compliance.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:creditingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Crediting Period End Date' ;
    rdfs:comment 'Date when the carbon credit generation crediting period is scheduled to end.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Crediting Period Start Date' ;
    rdfs:comment 'Date when the carbon credit generation crediting period officially begins.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditingPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Crediting Period Years' ;
    rdfs:comment 'Total duration of the crediting period measured in years as defined in project documentation.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditsIssuedToDateTonnes rdf:type rdf:Property ;
    rdfs:label 'Credits Issued To Date Tonnes' ;
    rdfs:comment 'Cumulative carbon credits issued by the registry to date in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditsRetiredToDateTonnes rdf:type rdf:Property ;
    rdfs:label 'Credits Retired To Date Tonnes' ;
    rdfs:comment 'Cumulative carbon credits permanently retired from circulation in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentValuationUsd rdf:type rdf:Property ;
    rdfs:label 'Current Valuation Usd' ;
    rdfs:comment 'Current fair market valuation of the pension funds stake in US dollars.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonProjectDescription rdf:type rdf:Property ;
    rdfs:label 'Carbon Project Description' ;
    rdfs:comment 'Detailed narrative description of the carbon project activities and objectives.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedAnnualCreditsTonnes rdf:type rdf:Property ;
    rdfs:label 'Estimated Annual Credits Tonnes' ;
    rdfs:comment 'Projected annual carbon credit generation capacity measured in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Internal Risk Rating' ;
    rdfs:comment 'Internal investment risk classification assigned by the pension fund risk team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentAmountUsd rdf:type rdf:Property ;
    rdfs:label 'Investment Amount Usd' ;
    rdfs:comment 'Total capital invested by the pension fund in this carbon project in US dollars.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:methodologyCode rdf:type rdf:Property ;
    rdfs:label 'Methodology Code' ;
    rdfs:comment 'Standardized methodology code defining the carbon accounting and quantification approach used.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonProjectName rdf:type rdf:Property ;
    rdfs:label 'Carbon Project Name' ;
    rdfs:comment 'Official registered name of the carbon project as filed with the carbon registry.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Next Verification Date' ;
    rdfs:comment 'Scheduled date for the next third-party verification of carbon credit claims.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectAreaHectares rdf:type rdf:Property ;
    rdfs:label 'Project Area Hectares' ;
    rdfs:comment 'Total land area covered by the carbon project measured in hectares.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectDeveloperName rdf:type rdf:Property ;
    rdfs:label 'Project Developer Name' ;
    rdfs:comment 'Name of the organization responsible for developing and implementing the carbon project.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registrationDate rdf:type rdf:Property ;
    rdfs:label 'Registration Date' ;
    rdfs:comment 'Date when the carbon project was officially registered with the carbon credit registry.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:registryProjectCode rdf:type rdf:Property ;
    rdfs:label 'Registry Project Code' ;
    rdfs:comment 'Unique project identifier assigned by the carbon registry for tracking and verification purposes.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sdgAlignmentCodes rdf:type rdf:Property ;
    rdfs:label 'Sdg Alignment Codes' ;
    rdfs:comment 'Comma-separated UN Sustainable Development Goal numbers the project contributes to.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonProjectStatus rdf:type rdf:Property ;
    rdfs:label 'Carbon Project Status' ;
    rdfs:comment 'Current lifecycle status of the carbon project from development through active credit generation.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalEstimatedCreditsTonnes rdf:type rdf:Property ;
    rdfs:label 'Total Estimated Credits Tonnes' ;
    rdfs:comment 'Total projected carbon credits over the full crediting period in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:validationBodyName rdf:type rdf:Property ;
    rdfs:label 'Validation Body Name' ;
    rdfs:comment 'Name of the accredited third-party organization that validated the project design.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:validationDate rdf:type rdf:Property ;
    rdfs:label 'Validation Date' ;
    rdfs:comment 'Date when the carbon project was validated by an accredited third-party validation body.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationBodyName rdf:type rdf:Property ;
    rdfs:label 'Verification Body Name' ;
    rdfs:comment 'Name of the accredited third-party organization that verifies credit issuance claims.' ;
    rdfs:domain ind:CarbonProject ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calledCapital rdf:type rdf:Property ;
    rdfs:label 'Called Capital' ;
    rdfs:comment 'Cumulative capital called from investors to date for investments and expenses in base currency.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonIntensityScore rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Score' ;
    rdfs:comment 'Measure of carbon emissions intensity per unit of revenue or production for climate risk assessment.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commodityExposureType rdf:type rdf:Property ;
    rdfs:label 'Commodity Exposure Type' ;
    rdfs:comment 'Primary commodity types the vehicle has exposure to such as oil, gas, timber, agricultural products, or metals.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceVehicleDescription rdf:type rdf:Property ;
    rdfs:label 'Resource Vehicle Description' ;
    rdfs:comment 'Detailed narrative description of the resource vehicles investment mandate, strategy, and objectives.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributedCapital rdf:type rdf:Property ;
    rdfs:label 'Distributed Capital' ;
    rdfs:comment 'Cumulative distributions returned to investors from the resource vehicle in base currency.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionYearsAvailable rdf:type rdf:Property ;
    rdfs:label 'Extension Years Available' ;
    rdfs:comment 'Number of additional years the fund term may be extended beyond the original termination date per partnership agreement.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:isOpenEnded rdf:type rdf:Property ;
    rdfs:label 'Is Open Ended' ;
    rdfs:comment 'Indicates whether the vehicle is open-ended with ongoing subscriptions and redemptions versus closed-end structure.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalStructure rdf:type rdf:Property ;
    rdfs:label 'Legal Structure' ;
    rdfs:comment 'Legal entity structure of the vehicle such as limited partnership, LLC, trust, or corporation for tax and liability purposes.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceVehicleName rdf:type rdf:Property ;
    rdfs:label 'Resource Vehicle Name' ;
    rdfs:comment 'Human-readable name of the resource investment vehicle as registered or commonly known in the market.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceCategory rdf:type rdf:Property ;
    rdfs:label 'Resource Category' ;
    rdfs:comment 'Primary natural resource category that the investment vehicle focuses on for asset allocation classification.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceVehicleStatus rdf:type rdf:Property ;
    rdfs:label 'Resource Vehicle Status' ;
    rdfs:comment 'Current lifecycle status of the resource investment vehicle indicating operational state.' ;
    rdfs:domain ind:ResourceVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subCategory rdf:type rdf:Property ;
    rdfs:label 'Sub Category' ;
    rdfs:comment 'Secondary classification within the primary resource category for granular portfolio segmentation and analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accruedInterest rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest' ;
    rdfs:comment 'Interest accumulated on the security since the last coupon payment date, calculated as of the current valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callableFlag rdf:type rdf:Property ;
    rdfs:label 'Callable Flag' ;
    rdfs:comment 'Indicates whether the issuer has the right to redeem the security before maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:convexity rdf:type rdf:Property ;
    rdfs:label 'Convexity' ;
    rdfs:comment 'Measure of the curvature in the relationship between bond prices and yields, indicating how duration changes as yields change.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponFrequency rdf:type rdf:Property ;
    rdfs:label 'Coupon Frequency' ;
    rdfs:comment 'Frequency at which coupon interest payments are made to bondholders.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:duration rdf:type rdf:Property ;
    rdfs:label 'Duration' ;
    rdfs:comment 'Weighted average time to receive the bond\'s cash flows, measuring interest rate sensitivity in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dv01 rdf:type rdf:Property ;
    rdfs:label 'Dv01' ;
    rdfs:comment 'Change in the market value of the security for a one basis point change in yield, expressed in currency units.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:faceValue rdf:type rdf:Property ;
    rdfs:label 'Face Value' ;
    rdfs:comment 'Par or nominal value of the security at issuance, representing the principal amount to be repaid at maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:firstCouponDate rdf:type rdf:Property ;
    rdfs:label 'First Coupon Date' ;
    rdfs:comment 'Date on which the first coupon payment is scheduled to be made to bondholders.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fixedIncomeSecurityStatus rdf:type rdf:Property ;
    rdfs:label 'Fixed Income Security Status' ;
    rdfs:comment 'Current lifecycle status of the fixed income security.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floatingRateFlag rdf:type rdf:Property ;
    rdfs:label 'Floating Rate Flag' ;
    rdfs:comment 'Indicates whether the coupon rate is variable and resets periodically based on a reference rate.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:greenBondFlag rdf:type rdf:Property ;
    rdfs:label 'Green Bond Flag' ;
    rdfs:comment 'Indicates whether the security is classified as a green bond with proceeds dedicated to environmental projects.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastCouponDate rdf:type rdf:Property ;
    rdfs:label 'Last Coupon Date' ;
    rdfs:comment 'Date on which the most recent coupon payment was made to bondholders.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextCouponDate rdf:type rdf:Property ;
    rdfs:label 'Next Coupon Date' ;
    rdfs:comment 'Date on which the next coupon payment is scheduled to be made to bondholders.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:oas rdf:type rdf:Property ;
    rdfs:label 'Oas' ;
    rdfs:comment 'Spread over the risk-free rate adjusted for embedded options, measured in basis points.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:puttableFlag rdf:type rdf:Property ;
    rdfs:label 'Puttable Flag' ;
    rdfs:comment 'Indicates whether the holder has the right to sell the security back to the issuer before maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sinkingFundFlag rdf:type rdf:Property ;
    rdfs:label 'Sinking Fund Flag' ;
    rdfs:comment 'Indicates whether the issuer is required to set aside funds periodically to retire portions of the debt before maturity.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:spreadOverReference rdf:type rdf:Property ;
    rdfs:label 'Spread Over Reference' ;
    rdfs:comment 'Fixed spread in basis points added to the reference rate to determine the floating coupon rate.' ;
    rdfs:domain ind:FixedIncomeSecurity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subordinationLevel rdf:type rdf:Property ;
    rdfs:label 'Subordination Level' ;
    rdfs:comment 'Ranking of the security in the issuer\'s capital structure determining priority in bankruptcy or liquidation.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditPositionId rdf:type rdf:Property ;
    rdfs:label 'Credit Position Id' ;
    rdfs:comment 'Unique identifier for the credit position record in the Investment Book of Record (IBOR).' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditPosition .

ind:cashPositionId rdf:type rdf:Property ;
    rdfs:label 'Cash Position Id' ;
    rdfs:comment 'Foreign key linking to treasury.cash_position. Business justification: Pension fund reconciles each credit position with the cash position that funded the purchase for regulatory reporting and internal audit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashPosition .

ind:creditBlotterId rdf:type rdf:Property ;
    rdfs:label 'Credit Blotter Id' ;
    rdfs:comment 'Foreign key linking to trade.blotter. Business justification: Audit trail linking position to the trade that created it for regulatory reporting.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Blotter .

ind:creditCustodianBlotterId rdf:type rdf:Property ;
    rdfs:label 'Credit Custodian Blotter Id' ;
    rdfs:comment 'Reference to the custody bank holding the physical or electronic securities.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Blotter .

ind:custodianActorId rdf:type rdf:Property ;
    rdfs:label 'Custodian Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Custodian bank details are required for settlement, regulatory reporting, and risk management of each position.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:bookCost rdf:type rdf:Property ;
    rdfs:label 'Book Cost' ;
    rdfs:comment 'Original acquisition cost of the position including transaction costs, recorded in base currency.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalCreditRating rdf:type rdf:Property ;
    rdfs:label 'Internal Credit Rating' ;
    rdfs:comment 'Proprietary credit rating assigned by the pension funds internal credit research team.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isCallable rdf:type rdf:Property ;
    rdfs:label 'Is Callable' ;
    rdfs:comment 'Indicates whether the issuer has the right to redeem the bond before maturity.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPuttable rdf:type rdf:Property ;
    rdfs:label 'Is Puttable' ;
    rdfs:comment 'Indicates whether the holder has the right to sell the bond back to the issuer before maturity.' ;
    rdfs:domain ind:CreditPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:couponScheduleId rdf:type rdf:Property ;
    rdfs:label 'Coupon Schedule Id' ;
    rdfs:comment 'Unique identifier for the coupon schedule record.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referenceSofrRateId rdf:type rdf:Property ;
    rdfs:label 'Reference Sofr Rate Id' ;
    rdfs:comment 'Foreign key linking to credit.sofr_rate. Business justification: Coupon schedules reference a reference rate; adding reference_sofr_rate_id links to the specific SOFR rate record, enabling consistent rate lookups.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SofrRate .

ind:accrualDays rdf:type rdf:Property ;
    rdfs:label 'Accrual Days' ;
    rdfs:comment 'Number of days in the coupon accrual period calculated according to the day count convention.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accrualEndDate rdf:type rdf:Property ;
    rdfs:label 'Accrual End Date' ;
    rdfs:comment 'Date on which interest stops accruing for this coupon period.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accrualStartDate rdf:type rdf:Property ;
    rdfs:label 'Accrual Start Date' ;
    rdfs:comment 'Date from which interest begins accruing for this coupon period.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:businessDayConvention rdf:type rdf:Property ;
    rdfs:label 'Business Day Convention' ;
    rdfs:comment 'Rule applied to adjust payment dates that fall on non-business days to the nearest valid business day.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationAgentLei rdf:type rdf:Property ;
    rdfs:label 'Calculation Agent Lei' ;
    rdfs:comment 'Legal Entity Identifier of the institution responsible for calculating floating rate coupons and determining payment amounts.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:compoundingMethod rdf:type rdf:Property ;
    rdfs:label 'Compounding Method' ;
    rdfs:comment 'Method used for compounding interest when reference rates are observed daily or multiple times within a coupon period, such as simple, compounded, or averaged.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponAmount rdf:type rdf:Property ;
    rdfs:label 'Coupon Amount' ;
    rdfs:comment 'Calculated cash payment amount for this coupon period based on coupon rate, notional principal, and day count convention.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponCapRate rdf:type rdf:Property ;
    rdfs:label 'Coupon Cap Rate' ;
    rdfs:comment 'Maximum coupon rate that will be paid regardless of how high the reference rate rises, limiting issuer exposure to rate increases.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponCurrency rdf:type rdf:Property ;
    rdfs:label 'Coupon Currency' ;
    rdfs:comment 'Three-letter ISO currency code in which the coupon payment will be made.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponFloorRate rdf:type rdf:Property ;
    rdfs:label 'Coupon Floor Rate' ;
    rdfs:comment 'Minimum coupon rate that will be paid regardless of how low the reference rate falls, providing downside protection to investors.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponRateType rdf:type rdf:Property ;
    rdfs:label 'Coupon Rate Type' ;
    rdfs:comment 'Classification of the coupon rate structure indicating whether the rate is fixed, floating, zero-coupon, or variable.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Coupon Sequence Number' ;
    rdfs:comment 'Sequential ordering number of this coupon payment within the overall schedule for the security.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:dayCountConvention rdf:type rdf:Property ;
    rdfs:label 'Day Count Convention' ;
    rdfs:comment 'Method used to calculate the number of days in the coupon period for interest accrual purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fixedReferenceRateValue rdf:type rdf:Property ;
    rdfs:label 'Fixed Reference Rate Value' ;
    rdfs:comment 'Actual observed value of the reference rate on the fixing date, used to calculate the floating coupon rate.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fixingDate rdf:type rdf:Property ;
    rdfs:label 'Fixing Date' ;
    rdfs:comment 'Date on which the reference rate is observed or fixed for floating rate coupon calculation, typically a few days before the period start.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:isFinalCoupon rdf:type rdf:Property ;
    rdfs:label 'Is Final Coupon' ;
    rdfs:comment 'Flag indicating whether this is the final coupon payment before the security matures and principal is repaid.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:notionalPrincipal rdf:type rdf:Property ;
    rdfs:label 'Notional Principal' ;
    rdfs:comment 'Face value or principal amount on which the coupon payment is calculated for this period.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payingAgentLei rdf:type rdf:Property ;
    rdfs:label 'Paying Agent Lei' ;
    rdfs:comment 'Legal Entity Identifier of the financial institution acting as paying agent responsible for distributing coupon payments to bondholders.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentCalendar rdf:type rdf:Property ;
    rdfs:label 'Payment Calendar' ;
    rdfs:comment 'Financial center or holiday calendar used to determine business days for payment date adjustments.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceRateTenor rdf:type rdf:Property ;
    rdfs:label 'Reference Rate Tenor' ;
    rdfs:comment 'Maturity period of the reference rate used for floating rate calculation, such as 1M, 3M, 6M, or 12M.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resetFrequency rdf:type rdf:Property ;
    rdfs:label 'Reset Frequency' ;
    rdfs:comment 'Frequency at which the floating coupon rate is reset based on the reference rate, such as daily, monthly, quarterly, or semi-annually.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleEffectiveTimestamp rdf:type rdf:Property ;
    rdfs:label 'Schedule Effective Timestamp' ;
    rdfs:comment 'Timestamp when this version of the coupon schedule became effective and valid for use in portfolio valuation and cash flow forecasting.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:scheduleSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Schedule Source System' ;
    rdfs:comment 'Operational system from which this coupon schedule record was sourced, such as Bloomberg, SimCorp Dimension, or custodian platform.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleVersionNumber rdf:type rdf:Property ;
    rdfs:label 'Schedule Version Number' ;
    rdfs:comment 'Version number of this coupon schedule record, incremented when schedule terms are amended or recalculated.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:spreadOverReferenceRateBps rdf:type rdf:Property ;
    rdfs:label 'Spread Over Reference Rate Bps' ;
    rdfs:comment 'Fixed spread in basis points added to the reference rate to determine the total coupon rate for floating rate securities.' ;
    rdfs:domain ind:CouponSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponPaymentId rdf:type rdf:Property ;
    rdfs:label 'Coupon Payment Id' ;
    rdfs:comment 'Unique identifier for the coupon payment transaction record.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accruedInterestLocal rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest Local' ;
    rdfs:comment 'Accrued interest amount at settlement in local currency, used for reconciliation and accounting.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponAmountBase rdf:type rdf:Property ;
    rdfs:label 'Coupon Amount Base' ;
    rdfs:comment 'Gross coupon payment amount converted to the fund base reporting currency.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:couponAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Coupon Amount Local' ;
    rdfs:comment 'Gross coupon payment amount received in the local currency of the security.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingQuantity rdf:type rdf:Property ;
    rdfs:label 'Holding Quantity' ;
    rdfs:comment 'Quantity of the security held in the portfolio on the record date for this coupon payment.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCouponAmountBase rdf:type rdf:Property ;
    rdfs:label 'Net Coupon Amount Base' ;
    rdfs:comment 'Net coupon payment amount after withholding tax converted to base reporting currency.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netCouponAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Net Coupon Amount Local' ;
    rdfs:comment 'Net coupon payment amount after withholding tax deduction in local currency.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payingAgentName rdf:type rdf:Property ;
    rdfs:label 'Paying Agent Name' ;
    rdfs:comment 'Name of the financial institution acting as paying agent for the coupon payment.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Scheduled Payment Date' ;
    rdfs:comment 'Contractual date the coupon payment was scheduled per the bond indenture or prospectus.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:varianceAmountBase rdf:type rdf:Property ;
    rdfs:label 'Variance Amount Base' ;
    rdfs:comment 'Difference between expected and actual coupon payment in base currency, used for reconciliation.' ;
    rdfs:domain ind:CouponPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:durationConvexityId rdf:type rdf:Property ;
    rdfs:label 'Duration Convexity Id' ;
    rdfs:comment 'Unique identifier for the duration and convexity measurement record.' ;
    rdfs:domain ind:DurationConvexity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:creditYieldCurveId rdf:type rdf:Property ;
    rdfs:label 'Credit Yield Curve Id' ;
    rdfs:comment 'Foreign key linking to credit.yield_curve. Business justification: Duration and convexity metrics are calculated against a specific yield curve; adding yield_curve_id links the metrics to the curve definition.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditYieldCurve .

ind:benchmarkCurveName rdf:type rdf:Property ;
    rdfs:label 'Benchmark Curve Name' ;
    rdfs:comment 'Name of the benchmark yield curve used for duration and spread calculations.' ;
    rdfs:domain ind:DurationConvexity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationEngine rdf:type rdf:Property ;
    rdfs:label 'Calculation Engine' ;
    rdfs:comment 'Analytics engine or platform that performed the duration and convexity calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:calculationErrorMessage rdf:type rdf:Property ;
    rdfs:label 'Calculation Error Message' ;
    rdfs:comment 'Error message or diagnostic information if the calculation failed or encountered issues.' ;
    rdfs:domain ind:DurationConvexity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:effectiveDuration rdf:type rdf:Property ;
    rdfs:label 'Effective Duration' ;
    rdfs:comment 'Effective duration accounting for embedded options and expected cash flow changes, expressed in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isPortfolioLevel rdf:type rdf:Property ;
    rdfs:label 'Is Portfolio Level' ;
    rdfs:comment 'Flag indicating whether this record represents portfolio-level aggregated metrics or security-level metrics.' ;
    rdfs:domain ind:DurationConvexity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:keyRateDuration10y rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 10y' ;
    rdfs:comment 'Key rate duration for the 10-year point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration1y rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 1y' ;
    rdfs:comment 'Key rate duration for the 1-year point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration2y rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 2y' ;
    rdfs:comment 'Key rate duration for the 2-year point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration30y rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 30y' ;
    rdfs:comment 'Key reach duration for the 30-year point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration3m rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 3m' ;
    rdfs:comment 'Key rate duration for the 3-month point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration5y rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 5y' ;
    rdfs:comment 'Key rate duration for the 5-year point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyRateDuration6m rdf:type rdf:Property ;
    rdfs:label 'Key Rate Duration 6m' ;
    rdfs:comment 'Key rate duration for the 6-month point on the yield curve, measuring sensitivity to that specific maturity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:macaulayDuration rdf:type rdf:Property ;
    rdfs:label 'Macaulay Duration' ;
    rdfs:comment 'Macaulay duration representing the weighted average time to receive all cash flows, expressed in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedDuration rdf:type rdf:Property ;
    rdfs:label 'Modified Duration' ;
    rdfs:comment 'Modified duration measuring the percentage change in price for a 1% change in yield, expressed in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pv01 rdf:type rdf:Property ;
    rdfs:label 'Pv01' ;
    rdfs:comment 'Present value change for a one basis point parallel shift in the yield curve.' ;
    rdfs:domain ind:DurationConvexity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:spreadDuration rdf:type rdf:Property ;
    rdfs:label 'Spread Duration' ;
    rdfs:comment 'Spread duration measuring sensitivity to changes in credit spread over the benchmark yield curve.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yieldCurveSource rdf:type rdf:Property ;
    rdfs:label 'Yield Curve Source' ;
    rdfs:comment 'Source system or vendor providing the benchmark yield curve used in calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingId rdf:type rdf:Property ;
    rdfs:label 'Rating Id' ;
    rdfs:comment 'Unique identifier for the credit rating record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Rating .

ind:action rdf:type rdf:Property ;
    rdfs:label 'Action' ;
    rdfs:comment 'Type of rating action taken: new rating assignment, upgrade, downgrade, affirmation, withdrawal, or suspension.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agency rdf:type rdf:Property ;
    rdfs:label 'Agency' ;
    rdfs:comment 'Name of the rating agency that issued the rating (Moodys, S&P, Fitch, DBRS) or Internal for proprietary credit assessments.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingCategory rdf:type rdf:Property ;
    rdfs:label 'Rating Category' ;
    rdfs:comment 'Broad classification of the rating: Investment Grade (BBB-/Baa3 and above), High Yield (below BBB-/Baa3), Non-Rated, or Default.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeDate rdf:type rdf:Property ;
    rdfs:label 'Committee Date' ;
    rdfs:comment 'Date on which the rating committee met to approve or review the rating decision.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defaultProbability rdf:type rdf:Property ;
    rdfs:label 'Default Probability' ;
    rdfs:comment 'Estimated probability of default associated with this rating grade, expressed as a decimal (e.g., 0.001 for 0.1%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Internal Override Flag' ;
    rdfs:comment 'Indicates whether the internal credit assessment team has applied an override or adjustment to the external agency rating.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:internalOverrideRationale rdf:type rdf:Property ;
    rdfs:label 'Internal Override Rationale' ;
    rdfs:comment 'Explanation for any internal override or adjustment applied to the external rating.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:methodology rdf:type rdf:Property ;
    rdfs:label 'Methodology' ;
    rdfs:comment 'Name or reference to the rating methodology framework applied by the agency for this rating.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notch rdf:type rdf:Property ;
    rdfs:label 'Notch' ;
    rdfs:comment 'Numeric representation of the rating for quantitative analysis, where higher numbers represent better credit quality.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:outlook rdf:type rdf:Property ;
    rdfs:label 'Outlook' ;
    rdfs:comment 'Forward-looking opinion on the potential direction of the rating over the medium term.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousRatingValue rdf:type rdf:Property ;
    rdfs:label 'Previous Rating Value' ;
    rdfs:comment 'The rating grade that was in effect immediately prior to this rating action, for tracking rating transitions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:publicFlag rdf:type rdf:Property ;
    rdfs:label 'Public Flag' ;
    rdfs:comment 'Indicates whether the rating is publicly disclosed or is a private rating for internal use only.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingType rdf:type rdf:Property ;
    rdfs:label 'Rating Type' ;
    rdfs:comment 'Type of rating indicating what is being rated: issuer-level credit quality, specific issue, or debt seniority class.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryRate rdf:type rdf:Property ;
    rdfs:label 'Recovery Rate' ;
    rdfs:comment 'Expected recovery rate in the event of default, expressed as a percentage (e.g., 40.00 for 40%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportUrl rdf:type rdf:Property ;
    rdfs:label 'Report Url' ;
    rdfs:comment 'URL or document reference to the full rating report or press release published by the rating agency.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scale rdf:type rdf:Property ;
    rdfs:label 'Scale' ;
    rdfs:comment 'Scale on which the rating is expressed: long-term, short-term, national scale, or global scale.' ;
    rdfs:domain ind:Rating ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:solicitedFlag rdf:type rdf:Property ;
    rdfs:label 'Solicited Flag' ;
    rdfs:comment 'Indicates whether the rating was requested by the issuer (solicited) or assigned without issuer request (unsolicited).' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Source Identifier' ;
    rdfs:comment 'Unique identifier or reference code for this rating in the source system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:value rdf:type rdf:Property ;
    rdfs:label 'Value' ;
    rdfs:comment 'The actual rating grade assigned (e.g., AAA, Aa1, BBB+, B-, CCC, D). Format varies by agency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:watchStatus rdf:type rdf:Property ;
    rdfs:label 'Watch Status' ;
    rdfs:comment 'Indicates whether the rating is under review for potential upgrade, downgrade, or not on watch.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withdrawalDate rdf:type rdf:Property ;
    rdfs:label 'Withdrawal Date' ;
    rdfs:comment 'Date on which the rating was withdrawn by the rating agency, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ratingActionId rdf:type rdf:Property ;
    rdfs:label 'Rating Action Id' ;
    rdfs:comment 'Unique identifier for the rating action event record.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actionSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Action Source System' ;
    rdfs:comment 'Name of the source system or data feed from which the rating action was ingested.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionTriggerEvent rdf:type rdf:Property ;
    rdfs:label 'Action Trigger Event' ;
    rdfs:comment 'Description of the key event or development that triggered the rating action.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committeeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Committee Approval Date' ;
    rdfs:comment 'Date on which the rating agencys rating committee formally approved the action.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditSpreadImpactBps rdf:type rdf:Property ;
    rdfs:label 'Credit Spread Impact Bps' ;
    rdfs:comment 'Estimated impact of the rating action on the credit spread, measured in basis points.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:defaultProbabilityEstimate rdf:type rdf:Property ;
    rdfs:label 'Default Probability Estimate' ;
    rdfs:comment 'Estimated probability of default associated with the new rating, expressed as a decimal fraction.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:internalReviewDate rdf:type rdf:Property ;
    rdfs:label 'Internal Review Date' ;
    rdfs:comment 'Date on which the internal credit team completed their review of the rating action.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalReviewStatus rdf:type rdf:Property ;
    rdfs:label 'Internal Review Status' ;
    rdfs:comment 'Status of the pension funds internal credit team review of the rating action.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentPolicyBreachFlag rdf:type rdf:Property ;
    rdfs:label 'Investment Policy Breach Flag' ;
    rdfs:comment 'Indicates whether the new rating causes a breach of the funds investment policy constraints.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newOutlook rdf:type rdf:Property ;
    rdfs:label 'New Outlook' ;
    rdfs:comment 'The outlook designation assigned as a result of this action, indicating the likely direction of future rating changes.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newRating rdf:type rdf:Property ;
    rdfs:label 'New Rating' ;
    rdfs:comment 'The credit rating assigned as a result of this action, using agency-specific rating scale notation.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notchChange rdf:type rdf:Property ;
    rdfs:label 'Notch Change' ;
    rdfs:comment 'Number of rating notches changed in this action; positive for upgrades, negative for downgrades, zero for affirmations.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:portfolioImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Portfolio Impact Flag' ;
    rdfs:comment 'Indicates whether this rating action materially impacts the pension funds investment portfolio holdings.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:priorOutlook rdf:type rdf:Property ;
    rdfs:label 'Prior Outlook' ;
    rdfs:comment 'The outlook designation assigned before this action, indicating the likely direction of future rating changes.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorRating rdf:type rdf:Property ;
    rdfs:label 'Prior Rating' ;
    rdfs:comment 'The credit rating assigned immediately before this action, using agency-specific rating scale notation.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ratingAgencyCode rdf:type rdf:Property ;
    rdfs:label 'Rating Agency Code' ;
    rdfs:comment 'Reference to the credit rating agency that issued the rating action.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ratingScale rdf:type rdf:Property ;
    rdfs:label 'Rating Scale' ;
    rdfs:comment 'The rating scale used by the agency for this action, distinguishing issuer vs. issue, long-term vs. short-term, and sovereign ratings.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rationaleSummary rdf:type rdf:Property ;
    rdfs:label 'Rationale Summary' ;
    rdfs:comment 'Brief summary of the key factors and rationale provided by the rating agency for the action.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryRateEstimate rdf:type rdf:Property ;
    rdfs:label 'Recovery Rate Estimate' ;
    rdfs:comment 'Estimated recovery rate in the event of default, expressed as a percentage.' ;
    rdfs:domain ind:RatingAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdsPositionId rdf:type rdf:Property ;
    rdfs:label 'Cds Position Id' ;
    rdfs:comment 'Unique identifier for the credit default swap position record.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:referenceEntityActorId rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Reference entity is the underlying issuer; required for CDS pricing, risk analytics, and event monitoring.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:referenceEntityCreditIssuerId rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Credit Issuer Id' ;
    rdfs:comment 'Identifier of the underlying reference entity (corporate or sovereign) on which credit protection is written.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditIssuer .

ind:accruedPremium rdf:type rdf:Property ;
    rdfs:label 'Accrued Premium' ;
    rdfs:comment 'Premium accrued since last payment date but not yet paid, calculated on a pro-rata basis.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ccpName rdf:type rdf:Property ;
    rdfs:label 'Ccp Name' ;
    rdfs:comment 'Name of the central counterparty clearing house if the CDS is centrally cleared.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:clearingStatus rdf:type rdf:Property ;
    rdfs:label 'Clearing Status' ;
    rdfs:comment 'Indicates whether the CDS is centrally cleared through a CCP or remains bilateral OTC.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralCurrency rdf:type rdf:Property ;
    rdfs:label 'Collateral Currency' ;
    rdfs:comment 'Three-letter ISO currency code for collateral posted and received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPosted rdf:type rdf:Property ;
    rdfs:label 'Collateral Posted' ;
    rdfs:comment 'Amount of collateral posted by the pension fund to the counterparty or CCP under CSA or margin agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:collateralReceived rdf:type rdf:Property ;
    rdfs:label 'Collateral Received' ;
    rdfs:comment 'Amount of collateral received by the pension fund from the counterparty or CCP under CSA or margin agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractIdentifier rdf:type rdf:Property ;
    rdfs:label 'Contract Identifier' ;
    rdfs:comment 'External business identifier or trade reference number for the CDS contract.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditEventDate rdf:type rdf:Property ;
    rdfs:label 'Credit Event Date' ;
    rdfs:comment 'Date on which a credit event was determined to have occurred for the reference entity.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:creditEventFlag rdf:type rdf:Property ;
    rdfs:label 'Credit Event Flag' ;
    rdfs:comment 'Indicates whether a credit event (bankruptcy, failure to pay, restructuring) has occurred on the reference entity.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indexFlag rdf:type rdf:Property ;
    rdfs:label 'Index Flag' ;
    rdfs:comment 'Indicates whether this is a single-name CDS or part of a CDS index (e.g., CDX, iTraxx).' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:indexName rdf:type rdf:Property ;
    rdfs:label 'Index Name' ;
    rdfs:comment 'Name of the CDS index if this position is part of an index (e.g., CDX.NA.IG, iTraxx Europe).' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexSeries rdf:type rdf:Property ;
    rdfs:label 'Index Series' ;
    rdfs:comment 'Series number of the CDS index if applicable.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indexVersion rdf:type rdf:Property ;
    rdfs:label 'Index Version' ;
    rdfs:comment 'Version number of the CDS index if applicable.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Market Spread Bps' ;
    rdfs:comment 'Current market credit spread for the reference entity at the CDS tenor, expressed in basis points.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Market Value Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the market value.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notionalAmount rdf:type rdf:Property ;
    rdfs:label 'Notional Amount' ;
    rdfs:comment 'Face value or notional principal amount of credit protection bought or sold under the CDS contract.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:notionalCurrency rdf:type rdf:Property ;
    rdfs:label 'Notional Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the notional amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:protectionDirection rdf:type rdf:Property ;
    rdfs:label 'Protection Direction' ;
    rdfs:comment 'Indicates whether the pension fund bought protection (long credit risk hedge) or sold protection (short credit risk exposure).' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Recovery Rate Assumption' ;
    rdfs:comment 'Assumed recovery rate on reference obligation in event of default, expressed as decimal (e.g., 0.40 for 40 percent).' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:referenceEntityLei rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Lei' ;
    rdfs:comment 'Legal Entity Identifier of the reference entity on which credit protection is written.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:restructuringClause rdf:type rdf:Property ;
    rdfs:label 'Restructuring Clause' ;
    rdfs:comment 'Type of restructuring credit event covered: CR (cumulative restructuring), MR (modified restructuring), MM (modified-modified restructuring), XR (old restructuring), or none.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:runningSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Running Spread Bps' ;
    rdfs:comment 'Annual premium or coupon rate paid by the protection buyer expressed in basis points of the notional amount.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:upfrontPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Upfront Payment Amount' ;
    rdfs:comment 'One-time upfront payment made at inception to compensate for difference between running spread and market spread.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:upfrontPaymentCurrency rdf:type rdf:Property ;
    rdfs:label 'Upfront Payment Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the upfront payment.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upfrontPaymentDirection rdf:type rdf:Property ;
    rdfs:label 'Upfront Payment Direction' ;
    rdfs:comment 'Indicates whether the pension fund paid or received the upfront payment.' ;
    rdfs:domain ind:CdsPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsMarketDataId rdf:type rdf:Property ;
    rdfs:label 'Cds Market Data Id' ;
    rdfs:comment 'Unique identifier for the CDS market data record.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:askSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Ask Spread Bps' ;
    rdfs:comment 'Ask-side CDS spread in basis points, representing the spread at which market makers are willing to sell protection.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bidSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Bid Spread Bps' ;
    rdfs:comment 'Bid-side CDS spread in basis points, representing the spread at which market makers are willing to buy protection.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cdsIndexSeries rdf:type rdf:Property ;
    rdfs:label 'Cds Index Series' ;
    rdfs:comment 'Series identifier for CDS indices (e.g., CDX.NA.IG.39, iTraxx Europe S36). Null for single-name CDS.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cdsIndexVersion rdf:type rdf:Property ;
    rdfs:label 'Cds Index Version' ;
    rdfs:comment 'Version number of the CDS index series. Null for single-name CDS.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:couponRateBps rdf:type rdf:Property ;
    rdfs:label 'Coupon Rate Bps' ;
    rdfs:comment 'Standard fixed coupon rate in basis points for the CDS contract (typically 100 bps or 500 bps for standard contracts).' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cs01 rdf:type rdf:Property ;
    rdfs:label 'Cs01' ;
    rdfs:comment 'Dollar value change in CDS contract for a 1 basis point change in credit spread, measuring credit risk sensitivity.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:impliedProbabilityOfDefault rdf:type rdf:Property ;
    rdfs:label 'Implied Probability Of Default' ;
    rdfs:comment 'Market-implied cumulative probability of default over the CDS tenor, derived from the CDS spread.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:midSpreadBps rdf:type rdf:Property ;
    rdfs:label 'Mid Spread Bps' ;
    rdfs:comment 'Mid-market CDS spread in basis points, calculated as the average of bid and ask spreads.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingDate rdf:type rdf:Property ;
    rdfs:label 'Pricing Date' ;
    rdfs:comment 'Business date for which the CDS market data is observed and recorded.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:pricingTimestamp rdf:type rdf:Property ;
    rdfs:label 'Pricing Timestamp' ;
    rdfs:comment 'Precise timestamp when the CDS market data was captured, including time zone.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:ratingOutlook rdf:type rdf:Property ;
    rdfs:label 'Rating Outlook' ;
    rdfs:comment 'Consensus or primary rating agency outlook for the reference entity credit rating.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceEntityName rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Name' ;
    rdfs:comment 'Full legal name of the reference entity or index (e.g., corporate issuer, sovereign nation, CDX.NA.IG, iTraxx Europe).' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceEntityTicker rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Ticker' ;
    rdfs:comment 'Market ticker or short code for the reference entity or CDS index.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceEntityType rdf:type rdf:Property ;
    rdfs:label 'Reference Entity Type' ;
    rdfs:comment 'Classification of the reference entity underlying the CDS.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenor rdf:type rdf:Property ;
    rdfs:label 'Tenor' ;
    rdfs:comment 'Maturity tenor of the CDS contract (1-year, 3-year, 5-year, 7-year, 10-year).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upfrontPoints rdf:type rdf:Property ;
    rdfs:label 'Upfront Points' ;
    rdfs:comment 'Upfront payment expressed as percentage points of notional, paid at inception for off-market CDS contracts.' ;
    rdfs:domain ind:CdsMarketData ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentManagerActorId rdf:type rdf:Property ;
    rdfs:label 'Investment Manager Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Investment manager entity is needed for performance attribution, compliance, and stakeholder reporting.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:borrowerLegalName rdf:type rdf:Property ;
    rdfs:label 'Borrower Legal Name' ;
    rdfs:comment 'Full legal name of the borrowing entity or obligor under the credit agreement.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:borrowerLei rdf:type rdf:Property ;
    rdfs:label 'Borrower Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the borrower, enabling global counterparty identification.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCreditLoss rdf:type rdf:Property ;
    rdfs:label 'Expected Credit Loss' ;
    rdfs:comment 'Expected credit loss provision calculated under IFRS 9 for the private credit investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:externalCreditRating rdf:type rdf:Property ;
    rdfs:label 'External Credit Rating' ;
    rdfs:comment 'Credit rating assigned by external rating agencies such as Moodys, S&P, or Fitch if applicable.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fairValue rdf:type rdf:Property ;
    rdfs:label 'Fair Value' ;
    rdfs:comment 'Current fair value of the private credit investment as determined by the valuation team for Net Asset Value (NAV) calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:floatingRateIndex rdf:type rdf:Property ;
    rdfs:label 'Floating Rate Index' ;
    rdfs:comment 'Reference rate index for floating-rate private credit investments, such as Secured Overnight Financing Rate (SOFR). [ENUM-REF-CANDIDATE: SOFR|LIBOR|EURIBOR|SONIA|CDOR|BBSY|none — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industrySector rdf:type rdf:Property ;
    rdfs:label 'Industry Sector' ;
    rdfs:comment 'Primary industry sector or GICS classification of the borrower for portfolio diversification analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanToValueRatio rdf:type rdf:Property ;
    rdfs:label 'Loan To Value Ratio' ;
    rdfs:comment 'Ratio of the loan amount to the appraised value of the underlying collateral, expressed as a decimal.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lossGivenDefault rdf:type rdf:Property ;
    rdfs:label 'Loss Given Default' ;
    rdfs:comment 'Estimated loss severity as a percentage of exposure at default, expressed as a decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingPrincipal rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal' ;
    rdfs:comment 'Current outstanding principal balance of the private credit investment as of the valuation date.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pikToggleFlag rdf:type rdf:Property ;
    rdfs:label 'Pik Toggle Flag' ;
    rdfs:comment 'Indicates whether the borrower has the option to pay interest in kind rather than cash.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prepaymentPenaltyFlag rdf:type rdf:Property ;
    rdfs:label 'Prepayment Penalty Flag' ;
    rdfs:comment 'Indicates whether the credit agreement includes prepayment penalties or call protection provisions.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:syndicationFlag rdf:type rdf:Property ;
    rdfs:label 'Syndication Flag' ;
    rdfs:comment 'Indicates whether the private credit investment is part of a syndicated loan with multiple lenders.' ;
    rdfs:domain ind:PrivateCreditInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privateCreditDrawdownId rdf:type rdf:Property ;
    rdfs:label 'Private Credit Drawdown Id' ;
    rdfs:comment 'Unique identifier for the private credit drawdown transaction.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:blotterId rdf:type rdf:Property ;
    rdfs:label 'Blotter Id' ;
    rdfs:comment 'Foreign key linking to trade.blotter. Business justification: Associate drawdown with the trade that funded it for audit and reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Blotter .

ind:bookingEntityActorId rdf:type rdf:Property ;
    rdfs:label 'Booking Entity Actor Id' ;
    rdfs:comment 'Reference to the legal entity or fund vehicle in whose books this drawdown is recorded.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:borrowerActorId rdf:type rdf:Property ;
    rdfs:label 'Borrower Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Borrower entity is a corporate counterparty; required for covenant monitoring, credit risk assessment, and regulatory reporting.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:privateCreditFacilityId rdf:type rdf:Property ;
    rdfs:label 'Private Credit Facility Id' ;
    rdfs:comment 'Reference to the parent private credit facility from which capital is being drawn.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PrivateCreditFacility .

ind:availableCommitment rdf:type rdf:Property ;
    rdfs:label 'Available Commitment' ;
    rdfs:comment 'Remaining undrawn commitment available on the facility after this drawdown.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRateType rdf:type rdf:Property ;
    rdfs:label 'Base Rate Type' ;
    rdfs:comment 'The reference rate index used as the base for interest calculation, such as SOFR, LIBOR, EURIBOR, or Prime.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralPledged rdf:type rdf:Property ;
    rdfs:label 'Collateral Pledged' ;
    rdfs:comment 'Indicates whether collateral was pledged or updated as part of this drawdown transaction.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:collateralValue rdf:type rdf:Property ;
    rdfs:label 'Collateral Value' ;
    rdfs:comment 'Fair market value of collateral pledged or securing this drawdown at the time of execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commitmentFeeWaived rdf:type rdf:Property ;
    rdfs:label 'Commitment Fee Waived' ;
    rdfs:comment 'Indicates whether the commitment fee on the undrawn portion was waived for this drawdown period.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:covenantComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Covenant Compliance Status' ;
    rdfs:comment 'Status of borrower compliance with financial and operational covenants at the time of drawdown.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeDrawnBalance rdf:type rdf:Property ;
    rdfs:label 'Cumulative Drawn Balance' ;
    rdfs:comment 'Total outstanding drawn balance on the facility after this drawdown, including all prior drawdowns less repayments.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drawdownAmount rdf:type rdf:Property ;
    rdfs:label 'Drawdown Amount' ;
    rdfs:comment 'The principal amount drawn down from the facility in this transaction.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:drawdownCurrency rdf:type rdf:Property ;
    rdfs:label 'Drawdown Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the drawdown amount.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawdownDate rdf:type rdf:Property ;
    rdfs:label 'Drawdown Date' ;
    rdfs:comment 'The date on which the capital drawdown was executed and funds were disbursed.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:drawdownNumber rdf:type rdf:Property ;
    rdfs:label 'Drawdown Number' ;
    rdfs:comment 'Business identifier for the drawdown event, typically sequential within the facility.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawdownPurpose rdf:type rdf:Property ;
    rdfs:label 'Drawdown Purpose' ;
    rdfs:comment 'Business purpose or use of proceeds for this drawdown, such as acquisition financing, working capital, refinancing, or capital expenditure.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:drawdownStatus rdf:type rdf:Property ;
    rdfs:label 'Drawdown Status' ;
    rdfs:comment 'Current lifecycle status of the drawdown transaction.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRateAtDrawdown rdf:type rdf:Property ;
    rdfs:label 'Interest Rate At Drawdown' ;
    rdfs:comment 'The applicable interest rate (expressed as a decimal) in effect at the time of drawdown, including base rate plus spread.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaymentAllowed rdf:type rdf:Property ;
    rdfs:label 'Prepayment Allowed' ;
    rdfs:comment 'Indicates whether the borrower is permitted to prepay this drawdown without penalty.' ;
    rdfs:domain ind:PrivateCreditDrawdown ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:privateCreditRepaymentId rdf:type rdf:Property ;
    rdfs:label 'Private Credit Repayment Id' ;
    rdfs:comment 'Unique identifier for the private credit repayment transaction. Primary key for this entity.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amortizationScheduleId rdf:type rdf:Property ;
    rdfs:label 'Amortization Schedule Id' ;
    rdfs:comment 'Reference to the amortization schedule entry that this repayment corresponds to, if applicable.' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AmortizationSchedule .

ind:privateCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Private Counterparty Id' ;
    rdfs:comment 'Reference to the borrower entity making the repayment, linking to the counterparty master data.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:privateServicerEntityCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Private Servicer Entity Counterparty Id' ;
    rdfs:comment 'Reference to the loan servicer entity responsible for processing and administering this repayment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:servicerEntityCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Servicer Entity Counterparty Id' ;
    rdfs:comment 'Reference to the loan servicer entity responsible for processing and administering this repayment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:accountingTreatment rdf:type rdf:Property ;
    rdfs:label 'Accounting Treatment' ;
    rdfs:comment 'Description of the accounting treatment applied to this repayment transaction per IFRS or local GAAP standards.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:accruedInterestEndDate rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest End Date' ;
    rdfs:comment 'End date of the interest accrual period covered by this repayment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:accruedInterestStartDate rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest Start Date' ;
    rdfs:comment 'Start date of the interest accrual period covered by this repayment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:daysAccrued rdf:type rdf:Property ;
    rdfs:label 'Days Accrued' ;
    rdfs:comment 'Number of days in the interest accrual period for which interest was calculated and repaid.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:interestAmountRepaid rdf:type rdf:Property ;
    rdfs:label 'Interest Amount Repaid' ;
    rdfs:comment 'The interest amount repaid in this transaction, representing accrued interest paid by the borrower.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:interestRateApplied rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Applied' ;
    rdfs:comment 'The interest rate applied to calculate the interest component of this repayment, expressed as a decimal.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isEarlyRepayment rdf:type rdf:Property ;
    rdfs:label 'Is Early Repayment' ;
    rdfs:comment 'Boolean flag indicating whether this repayment occurred before the scheduled maturity or payment date.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPartialRepayment rdf:type rdf:Property ;
    rdfs:label 'Is Partial Repayment' ;
    rdfs:comment 'Boolean flag indicating whether this is a partial repayment of the outstanding principal rather than full repayment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:outstandingPrincipalBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Principal Balance' ;
    rdfs:comment 'Remaining outstanding principal balance of the private credit investment after this repayment has been applied.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaymentPremium rdf:type rdf:Property ;
    rdfs:label 'Prepayment Premium' ;
    rdfs:comment 'Additional fee or premium charged to the borrower for early repayment of principal before the scheduled maturity date.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:principalAmountRepaid rdf:type rdf:Property ;
    rdfs:label 'Principal Amount Repaid' ;
    rdfs:comment 'The principal amount repaid in this transaction, representing the reduction in outstanding loan balance.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:repaymentDate rdf:type rdf:Property ;
    rdfs:label 'Repayment Date' ;
    rdfs:comment 'The date on which the repayment was received or is scheduled to be received from the borrower.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:repaymentReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Repayment Reference Number' ;
    rdfs:comment 'External reference number or identifier assigned to this repayment transaction by the borrower or servicer.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repaymentSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Repayment Sequence Number' ;
    rdfs:comment 'Sequential number of this repayment within the series of repayments for the private credit investment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:repaymentStatus rdf:type rdf:Property ;
    rdfs:label 'Repayment Status' ;
    rdfs:comment 'Current lifecycle status of the repayment transaction indicating whether it is pending settlement, settled, failed, reversed, cancelled, or reconciled.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repaymentType rdf:type rdf:Property ;
    rdfs:label 'Repayment Type' ;
    rdfs:comment 'Classification of the repayment indicating whether it is a scheduled principal payment, scheduled interest payment, prepayment, partial prepayment, full prepayment, or amortization payment.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduledRepaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Scheduled Repayment Amount' ;
    rdfs:comment 'The originally scheduled repayment amount per the loan agreement or amortization schedule.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRepaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Repayment Amount' ;
    rdfs:comment 'Total amount repaid in this transaction including principal, interest, prepayment premium, and any other fees.' ;
    rdfs:domain ind:PrivateCreditRepayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:borrowerName rdf:type rdf:Property ;
    rdfs:label 'Borrower Name' ;
    rdfs:comment 'Legal name of the borrower entity whose financial covenants are being monitored.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:breachDate rdf:type rdf:Property ;
    rdfs:label 'Breach Date' ;
    rdfs:comment 'Date on which the covenant breach was identified or became effective, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:breachFlag rdf:type rdf:Property ;
    rdfs:label 'Breach Flag' ;
    rdfs:comment 'Boolean indicator of whether the covenant is currently in breach (True) or compliant (False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:covenantCategory rdf:type rdf:Property ;
    rdfs:label 'Covenant Category' ;
    rdfs:comment 'Broad category of covenant: affirmative (actions required), negative (restrictions), financial (ratio/threshold), or reporting (disclosure obligations).' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:covenantDescription rdf:type rdf:Property ;
    rdfs:label 'Covenant Description' ;
    rdfs:comment 'Detailed textual description of the covenant terms and conditions as specified in the credit agreement.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:covenantType rdf:type rdf:Property ;
    rdfs:label 'Covenant Type' ;
    rdfs:comment 'Type of financial covenant being monitored: leverage ratio, interest coverage ratio, Loan to Value (LTV), Debt Service Coverage Ratio (DSCR), minimum liquidity, or net worth.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cureDate rdf:type rdf:Property ;
    rdfs:label 'Cure Date' ;
    rdfs:comment 'Date on which a previously breached covenant was cured and returned to compliance.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cureMechanism rdf:type rdf:Property ;
    rdfs:label 'Cure Mechanism' ;
    rdfs:comment 'Description of the mechanism or actions taken to cure the covenant breach (e.g., equity injection, asset sale, debt repayment).' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cushionAmount rdf:type rdf:Property ;
    rdfs:label 'Cushion Amount' ;
    rdfs:comment 'Absolute difference between the actual value and threshold value, representing the margin of safety or breach magnitude.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cushionPercentage rdf:type rdf:Property ;
    rdfs:label 'Cushion Percentage' ;
    rdfs:comment 'Percentage difference between actual value and threshold, expressed as a percentage of the threshold value.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lenderAction rdf:type rdf:Property ;
    rdfs:label 'Lender Action' ;
    rdfs:comment 'Actions taken or contemplated by the lender in response to covenant breach (e.g., waiver negotiation, default notice, acceleration).' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriodEnd rdf:type rdf:Property ;
    rdfs:label 'Measurement Period End' ;
    rdfs:comment 'End date of the financial period over which the covenant metric is calculated.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementPeriodStart rdf:type rdf:Property ;
    rdfs:label 'Measurement Period Start' ;
    rdfs:comment 'Start date of the financial period over which the covenant metric is calculated (e.g., trailing twelve months).' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nextTestDate rdf:type rdf:Property ;
    rdfs:label 'Next Test Date' ;
    rdfs:comment 'Scheduled date for the next covenant compliance test or measurement.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:remediationPlan rdf:type rdf:Property ;
    rdfs:label 'Remediation Plan' ;
    rdfs:comment 'Description of the borrowers plan to address covenant breach or prevent future breach, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportingDeadline rdf:type rdf:Property ;
    rdfs:label 'Reporting Deadline' ;
    rdfs:comment 'Deadline by which the borrower must report covenant compliance to the lender.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:testingFrequency rdf:type rdf:Property ;
    rdfs:label 'Testing Frequency' ;
    rdfs:comment 'Frequency at which the covenant must be tested and reported as specified in the credit agreement.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:thresholdOperator rdf:type rdf:Property ;
    rdfs:label 'Threshold Operator' ;
    rdfs:comment 'Comparison operator defining the covenant compliance condition relative to the threshold value.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trendDirection rdf:type rdf:Property ;
    rdfs:label 'Trend Direction' ;
    rdfs:comment 'Directional trend of covenant compliance over recent measurement periods: improving, stable, or deteriorating.' ;
    rdfs:domain ind:CovenantMonitoring ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverDate rdf:type rdf:Property ;
    rdfs:label 'Waiver Date' ;
    rdfs:comment 'Date on which the covenant waiver was granted by the lender or syndicate.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:structuredProductId rdf:type rdf:Property ;
    rdfs:label 'Structured Product Id' ;
    rdfs:comment 'Unique identifier for the structured credit instrument record.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collateralPoolSize rdf:type rdf:Property ;
    rdfs:label 'Collateral Pool Size' ;
    rdfs:comment 'Total value of the underlying collateral pool backing the structured product.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constantPrepaymentRate rdf:type rdf:Property ;
    rdfs:label 'Constant Prepayment Rate' ;
    rdfs:comment 'Annualized rate at which the underlying collateral is expected to prepay, expressed as a decimal.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditEnhancementPct rdf:type rdf:Property ;
    rdfs:label 'Credit Enhancement Pct' ;
    rdfs:comment 'Total credit enhancement as a percentage of the tranche, including subordination, overcollateralization, and reserve accounts.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentFaceValue rdf:type rdf:Property ;
    rdfs:label 'Current Face Value' ;
    rdfs:comment 'Current outstanding principal balance after amortization, prepayments, and write-downs.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:defaultRate rdf:type rdf:Property ;
    rdfs:label 'Default Rate' ;
    rdfs:comment 'Percentage of underlying collateral that has defaulted or is expected to default.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedMaturityDate rdf:type rdf:Property ;
    rdfs:label 'Expected Maturity Date' ;
    rdfs:comment 'Expected date of full principal repayment based on prepayment assumptions, may differ from legal maturity.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossSeverityRate rdf:type rdf:Property ;
    rdfs:label 'Loss Severity Rate' ;
    rdfs:comment 'Expected loss as a percentage of exposure upon default, after recovery.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:numberOfCollateralAssets rdf:type rdf:Property ;
    rdfs:label 'Number Of Collateral Assets' ;
    rdfs:comment 'Count of individual assets or loans in the underlying collateral pool.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:originalFaceValue rdf:type rdf:Property ;
    rdfs:label 'Original Face Value' ;
    rdfs:comment 'Original principal amount of the structured product at issuance.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overcollateralizationPct rdf:type rdf:Property ;
    rdfs:label 'Overcollateralization Pct' ;
    rdfs:comment 'Excess collateral value over outstanding note balance, expressed as a percentage.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productType rdf:type rdf:Property ;
    rdfs:label 'Product Type' ;
    rdfs:comment 'Classification of structured credit instrument: Asset-Backed Securities, Mortgage-Backed Securities, Residential MBS, Commercial MBS, Collateralized Loan Obligation, Collateralized Debt Obligation, Collateralized Bond Obligation, Covered Bond, Synthetic' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spreadOverReferenceBps rdf:type rdf:Property ;
    rdfs:label 'Spread Over Reference Bps' ;
    rdfs:comment 'Credit spread added to the reference rate for floating rate instruments, expressed in basis points.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subordinationPct rdf:type rdf:Property ;
    rdfs:label 'Subordination Pct' ;
    rdfs:comment 'Percentage of junior tranches providing loss protection to this tranche.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:trancheName rdf:type rdf:Property ;
    rdfs:label 'Tranche Name' ;
    rdfs:comment 'Name or designation of the specific tranche within the structured product (e.g., Senior, Mezzanine, Equity, Class A, Class B).' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:trancheSeniority rdf:type rdf:Property ;
    rdfs:label 'Tranche Seniority' ;
    rdfs:comment 'Seniority ranking of the tranche in the capital structure determining payment priority and loss absorption.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightedAverageCoupon rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Coupon' ;
    rdfs:comment 'Weighted average interest rate of the underlying collateral pool.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAverageLifeYears rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Life Years' ;
    rdfs:comment 'Expected average time until principal is repaid, accounting for prepayments and amortization.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightedAverageMaturityMonths rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Maturity Months' ;
    rdfs:comment 'Weighted average remaining term to maturity of the underlying collateral, expressed in months.' ;
    rdfs:domain ind:StructuredProduct ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sovereignDebtHoldingId rdf:type rdf:Property ;
    rdfs:label 'Sovereign Debt Holding Id' ;
    rdfs:comment 'Unique identifier for the sovereign debt holding record.' ;
    rdfs:domain ind:SovereignDebtHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountingClassification rdf:type rdf:Property ;
    rdfs:label 'Accounting Classification' ;
    rdfs:comment 'IFRS 9 accounting treatment category for the sovereign debt holding.' ;
    rdfs:domain ind:SovereignDebtHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageCost rdf:type rdf:Property ;
    rdfs:label 'Average Cost' ;
    rdfs:comment 'Weighted average cost per unit of the sovereign debt holding across multiple purchases.' ;
    rdfs:domain ind:SovereignDebtHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianAccount rdf:type rdf:Property ;
    rdfs:label 'Custodian Account' ;
    rdfs:comment 'Account number at the custodian where the sovereign debt holding is held.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationLinkedFlag rdf:type rdf:Property ;
    rdfs:label 'Inflation Linked Flag' ;
    rdfs:comment 'Indicates whether the sovereign debt principal and coupons are indexed to inflation.' ;
    rdfs:domain ind:SovereignDebtHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:issuerCountry rdf:type rdf:Property ;
    rdfs:label 'Issuer Country' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the sovereign issuer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketValueDate rdf:type rdf:Property ;
    rdfs:label 'Market Value Date' ;
    rdfs:comment 'As-of date for the market value measurement.' ;
    rdfs:domain ind:SovereignDebtHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:benchmarkFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Flag' ;
    rdfs:comment 'Indicates whether this is a benchmark curve used as a standard reference for valuation and risk analytics (True/False).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compoundingFrequency rdf:type rdf:Property ;
    rdfs:label 'Compounding Frequency' ;
    rdfs:comment 'Frequency at which interest is compounded for rate calculations (annual, semi-annual, quarterly, monthly, continuous).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditQuality rdf:type rdf:Property ;
    rdfs:label 'Credit Quality' ;
    rdfs:comment 'Credit quality classification for credit spread curves (AAA, AA, A, BBB, BB, B, CCC, unrated). Not applicable for government curves. [ENUM-REF-CANDIDATE: aaa|aa|a|bbb|bb|b|ccc|unrated — 8 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:Credit ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:curveDate rdf:type rdf:Property ;
