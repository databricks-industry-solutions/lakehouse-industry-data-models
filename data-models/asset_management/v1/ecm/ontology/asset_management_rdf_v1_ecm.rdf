ind:investorRelationsEmail rdf:type rdf:Property ;
    rdfs:label 'Investor Relations Email' ;
    rdfs:comment 'Primary email contact for investor relations inquiries and shareholder communications.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investorRelationsPhone rdf:type rdf:Property ;
    rdfs:label 'Investor Relations Phone' ;
    rdfs:comment 'Primary telephone contact number for investor relations department and shareholder inquiries.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerStatus rdf:type rdf:Property ;
    rdfs:label 'Issuer Status' ;
    rdfs:comment 'Current operational and market status of the issuer reflecting its lifecycle state. [ENUM-REF-CANDIDATE: active|inactive|merged|acquired|delisted|bankrupt|liquidated — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:issuerType rdf:type rdf:Property ;
    rdfs:label 'Issuer Type' ;
    rdfs:comment 'Classification of the issuer entity type indicating its legal and organizational structure. [ENUM-REF-CANDIDATE: public_corporation|private_corporation|government_entity|supranational|reit|trust|partnership — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:msciEsgRating rdf:type rdf:Property ;
    rdfs:label 'Msci Esg Rating' ;
    rdfs:comment 'The MSCI ESG rating assessing the issuers management of financially relevant environmental, social, and governance risks. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC — 7 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netZeroCommitmentFlag rdf:type rdf:Property ;
    rdfs:label 'Net Zero Commitment Flag' ;
