    rdfs:comment 'CDISC-aligned submission value or mapping used when the ATC level 4 term is referenced in regulatory CDISC SDTM concomitant medication datasets.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classificationSource rdf:type rdf:Property ;
    rdfs:label 'Classification Source' ;
    rdfs:comment 'Authoritative source that assigned or maintains this ATC level 4 classification entry.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deprecatedFlag rdf:type rdf:Property ;
    rdfs:label 'Deprecated Flag' ;
    rdfs:comment 'Indicates whether this ATC level 4 classification code has been deprecated and should no longer be used for new coding.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:dictionaryFormat rdf:type rdf:Property ;
    rdfs:label 'Dictionary Format' ;
    rdfs:comment 'WHODrug file format in which the dictionary was delivered, such as B3 or C3, affecting the structure of the ATC hierarchy records.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dictionaryName rdf:type rdf:Property ;
