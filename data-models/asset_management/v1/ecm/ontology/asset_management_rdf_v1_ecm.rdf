ind:calledCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Called Capital Amount' ;
    rdfs:comment 'Cumulative capital that has been drawn down from limited partners through capital calls.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributedCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Distributed Capital Amount' ;
    rdfs:comment 'Cumulative distributions returned to limited partners from the fund of funds vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:domicileCountryCode rdf:type rdf:Property ;
    rdfs:label 'Domicile Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code indicating the legal domicile jurisdiction of the fund of funds vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extensionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Extension Period Years' ;
    rdfs:comment 'Number of years by which the fund term may be extended beyond the original termination date.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:gpCommitmentPercentage rdf:type rdf:Property ;
    rdfs:label 'Gp Commitment Percentage' ;
    rdfs:comment 'Percentage of total fund commitments contributed by the general partner to align interests with LPs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hardCapAmount rdf:type rdf:Property ;
    rdfs:label 'Hard Cap Amount' ;
    rdfs:comment 'Maximum capital commitment amount the fund of funds vehicle is permitted to accept from all limited partners.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isErisaEligible rdf:type rdf:Property ;
    rdfs:label 'Is Erisa Eligible' ;
    rdfs:comment 'Indicates whether the fund of funds vehicle is structured to accept ERISA plan assets from US pension funds.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isEsgCompliant rdf:type rdf:Property ;
    rdfs:label 'Is Esg Compliant' ;
    rdfs:comment 'Indicates whether the fund of funds vehicle follows Environmental, Social, and Governance investment criteria.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalCounselName rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Name' ;
    rdfs:comment 'Name of the primary legal counsel firm advising the fund of funds vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navAsOfDate rdf:type rdf:Property ;
    rdfs:label 'Nav As Of Date' ;
    rdfs:comment 'Valuation date as of which the net asset value was calculated for the fund of funds vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netAssetValue rdf:type rdf:Property ;
    rdfs:label 'Net Asset Value' ;
    rdfs:comment 'Current net asset value of the fund of funds vehicle representing fair value of all underlying holdings.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Target Commitment Amount' ;
    rdfs:comment 'Target total capital commitment amount the fund of funds vehicle aims to raise from limited partners.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCommittedCapital rdf:type rdf:Property ;
    rdfs:label 'Total Committed Capital' ;
    rdfs:comment 'Aggregate capital commitments received from all limited partners in the fund of funds vehicle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:uncalledCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Uncalled Capital Amount' ;
    rdfs:comment 'Remaining committed capital not yet called from limited partners, representing available dry powder.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vehicleCode rdf:type rdf:Property ;
    rdfs:label 'Vehicle Code' ;
    rdfs:comment 'Internal alphanumeric code used to identify the fund of funds vehicle across investment systems.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleName rdf:type rdf:Property ;
    rdfs:label 'Vehicle Name' ;
    rdfs:comment 'Official legal name of the fund of funds vehicle as registered with regulatory authorities.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleStatus rdf:type rdf:Property ;
    rdfs:label 'Vehicle Status' ;
    rdfs:comment 'Current lifecycle status of the fund of funds vehicle indicating its operational phase.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleStructure rdf:type rdf:Property ;
    rdfs:label 'Vehicle Structure' ;
    rdfs:comment 'Legal structure under which the fund of funds vehicle is organized and operates.' ;
    rdfs:domain ind:FofVehicle ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vehicleType rdf:type rdf:Property ;
    rdfs:label 'Vehicle Type' ;
    rdfs:comment 'Classification of the fund of funds vehicle by investment strategy approach.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlKycExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Aml Kyc Expiry Date' ;
    rdfs:comment 'Date when the current AML/KYC verification expires and requires renewal for the limited partner.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amlKycStatus rdf:type rdf:Property ;
    rdfs:label 'Aml Kyc Status' ;
    rdfs:comment 'Current status of anti-money laundering and know-your-customer verification for the limited partner.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:amlKycVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Aml Kyc Verification Date' ;
    rdfs:comment 'Date when the most recent AML/KYC verification was completed for the limited partner entity.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:aumCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Aum Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the total assets under management amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:crsStatus rdf:type rdf:Property ;
    rdfs:label 'Crs Status' ;
    rdfs:comment 'OECD Common Reporting Standard classification for automatic exchange of financial account information.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:entityStatus rdf:type rdf:Property ;
    rdfs:label 'Entity Status' ;
    rdfs:comment 'Current operational status of the limited partner entity in the fund relationship lifecycle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:erisaStatus rdf:type rdf:Property ;
    rdfs:label 'Erisa Status' ;
    rdfs:comment 'Classification indicating whether the limited partner is subject to ERISA regulations for benefit plan investments.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPolicyIndicator rdf:type rdf:Property ;
    rdfs:label 'Esg Policy Indicator' ;
    rdfs:comment 'Indicates whether the limited partner has formal ESG investment policy requirements.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fatcaStatus rdf:type rdf:Property ;
    rdfs:label 'Fatca Status' ;
    rdfs:comment 'FATCA classification of the limited partner for US tax withholding and reporting compliance purposes.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investorClassification rdf:type rdf:Property ;
    rdfs:label 'Investor Classification' ;
    rdfs:comment 'Regulatory classification of the limited partner based on applicable securities law investor qualification standards.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isGovernmentEntity rdf:type rdf:Property ;
    rdfs:label 'Is Government Entity' ;
    rdfs:comment 'Indicates whether the limited partner is a government or sovereign entity for regulatory classification.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isMostFavoredNationEligible rdf:type rdf:Property ;
    rdfs:label 'Is Most Favored Nation Eligible' ;
    rdfs:comment 'Indicates whether the limited partner is eligible for most favored nation provisions in fund terms.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isSideLetterHolder rdf:type rdf:Property ;
    rdfs:label 'Is Side Letter Holder' ;
    rdfs:comment 'Indicates whether the limited partner has negotiated side letter agreements with special terms.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isTaxExempt rdf:type rdf:Property ;
    rdfs:label 'Is Tax Exempt' ;
    rdfs:comment 'Indicates whether the limited partner entity has tax-exempt status affecting distribution calculations.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:preferredCommunicationMethod rdf:type rdf:Property ;
    rdfs:label 'Preferred Communication Method' ;
    rdfs:comment 'The limited partners preferred method for receiving fund communications and reports.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine1 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line 1' ;
    rdfs:comment 'First line of the official registered address of the limited partner entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredAddressLine2 rdf:type rdf:Property ;
    rdfs:label 'Registered Address Line 2' ;
    rdfs:comment 'Second line of the official registered address of the limited partner entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:registeredCountryCode rdf:type rdf:Property ;
    rdfs:label 'Registered Country Code' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code for the registered address of the limited partner entity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:relationshipManagerName rdf:type rdf:Property ;
    rdfs:label 'Relationship Manager Name' ;
    rdfs:comment 'Name of the internal relationship manager responsible for the limited partner account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPrivateEquityAllocationPct rdf:type rdf:Property ;
    rdfs:label 'Target Private Equity Allocation Pct' ;
    rdfs:comment 'The limited partners target allocation percentage to private equity as part of their investment policy.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxIdentificationNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Identification Number' ;
    rdfs:comment 'The tax identification number of the limited partner entity used for tax reporting and withholding purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalAssetsUnderManagement rdf:type rdf:Property ;
    rdfs:label 'Total Assets Under Management' ;
    rdfs:comment 'Total assets under management by the limited partner entity, used for investor capacity assessment.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unpriSignatoryIndicator rdf:type rdf:Property ;
    rdfs:label 'Unpri Signatory Indicator' ;
    rdfs:comment 'Indicates whether the limited partner is a signatory to the UN Principles for Responsible Investment.' ;
    rdfs:domain ind:LpEntity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capRatePercent rdf:type rdf:Property ;
    rdfs:label 'Cap Rate Percent' ;
    rdfs:comment 'The capitalization rate used in valuation, calculated as NOI divided by property value, expressed as a percentage.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexBudgetAnnual rdf:type rdf:Property ;
    rdfs:label 'Capex Budget Annual' ;
    rdfs:comment 'Annual capital expenditure budget allocated for property improvements, renovations, and value creation initiatives.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyCode rdf:type rdf:Property ;
    rdfs:label 'Property Code' ;
    rdfs:comment 'The externally-known unique identifier or asset tag for the property used in portfolio reporting and fund administration systems.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionDate rdf:type rdf:Property ;
    rdfs:label 'Disposition Date' ;
    rdfs:comment 'The date on which the pension fund disposed of or sold the property, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dispositionPrice rdf:type rdf:Property ;
    rdfs:label 'Disposition Price' ;
    rdfs:comment 'The total sale price received upon disposition of the property, net of transaction costs, if applicable.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dscr rdf:type rdf:Property ;
    rdfs:label 'Dscr' ;
    rdfs:comment 'Debt Service Coverage Ratio calculated as NOI divided by annual debt service obligations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyConsumptionKwhAnnual rdf:type rdf:Property ;
    rdfs:label 'Energy Consumption Kwh Annual' ;
    rdfs:comment 'Total annual energy consumption of the property measured in kilowatt-hours for ESG reporting and operational efficiency tracking.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgCertification rdf:type rdf:Property ;
    rdfs:label 'Esg Certification' ;
    rdfs:comment 'ESG or green building certification held by the property (e.g., LEED Gold, BREEAM Excellent, ENERGY STAR).' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gav rdf:type rdf:Property ;
    rdfs:label 'Gav' ;
    rdfs:comment 'Gross Asset Value representing the total fair market value of the property before deducting any debt or liabilities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgEmissionsTonnesCo2eAnnual rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Tonnes Co2e Annual' ;
    rdfs:comment 'Total annual greenhouse gas emissions from property operations measured in tonnes of carbon dioxide equivalent for ESG and TCFD reporting.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossLeasableAreaSqft rdf:type rdf:Property ;
    rdfs:label 'Gross Leasable Area Sqft' ;
    rdfs:comment 'Total leasable floor area of the property measured in square feet, excluding common areas and structural elements.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:landAreaAcres rdf:type rdf:Property ;
    rdfs:label 'Land Area Acres' ;
    rdfs:comment 'Total land area of the property parcel measured in acres.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lifecycleStatus rdf:type rdf:Property ;
    rdfs:label 'Lifecycle Status' ;
    rdfs:comment 'Current operational and investment lifecycle status of the property.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ltvRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Ltv Ratio Percent' ;
    rdfs:comment 'Loan-to-Value ratio calculated as outstanding debt divided by GAV, expressed as a percentage.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managerName rdf:type rdf:Property ;
    rdfs:label 'Manager Name' ;
    rdfs:comment 'Name of the third-party property management firm or internal team responsible for day-to-day operations.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyName rdf:type rdf:Property ;
    rdfs:label 'Property Name' ;
    rdfs:comment 'The business or marketing name of the real estate asset (e.g., Tower One Office Complex, Maple Logistics Center).' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noiAnnual rdf:type rdf:Property ;
    rdfs:label 'Noi Annual' ;
    rdfs:comment 'Annual Net Operating Income calculated as gross rental income less operating expenses, excluding debt service and capital expenditures.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyRatePercent rdf:type rdf:Property ;
    rdfs:label 'Occupancy Rate Percent' ;
    rdfs:comment 'Current physical occupancy rate of the property expressed as a percentage of gross leasable area.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingDebt rdf:type rdf:Property ;
    rdfs:label 'Outstanding Debt' ;
    rdfs:comment 'Total outstanding mortgage or loan balance secured against the property.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyType rdf:type rdf:Property ;
    rdfs:label 'Property Type' ;
    rdfs:comment 'Detailed property type within the asset class (e.g., Class A Office, Distribution Warehouse, Shopping Mall, Multifamily Apartment).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stateProvince rdf:type rdf:Property ;
    rdfs:label 'State Province' ;
    rdfs:comment 'The state, province, or administrative region where the property is located.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:streetAddress rdf:type rdf:Property ;
    rdfs:label 'Street Address' ;
    rdfs:comment 'The full street address of the property including building number and street name.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxParcelNumber rdf:type rdf:Property ;
    rdfs:label 'Tax Parcel Number' ;
    rdfs:comment 'The local government tax parcel or assessment identifier for the property used for property tax administration.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterConsumptionCubicMetersAnnual rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Cubic Meters Annual' ;
    rdfs:comment 'Total annual water consumption of the property measured in cubic meters for ESG reporting and resource management.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:yearBuilt rdf:type rdf:Property ;
    rdfs:label 'Year Built' ;
    rdfs:comment 'The year in which the property was originally constructed.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:yearRenovated rdf:type rdf:Property ;
    rdfs:label 'Year Renovated' ;
    rdfs:comment 'The most recent year in which the property underwent major renovation or capital improvement, if applicable.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:zoningClassification rdf:type rdf:Property ;
    rdfs:label 'Zoning Classification' ;
    rdfs:comment 'The municipal zoning classification or land use designation for the property parcel.' ;
    rdfs:domain ind:Property ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyValuationId rdf:type rdf:Property ;
    rdfs:label 'Property Valuation Id' ;
    rdfs:comment 'Unique identifier for the property valuation record.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cycleId rdf:type rdf:Property ;
    rdfs:label 'Cycle Id' ;
    rdfs:comment 'Foreign key linking to valuation.cycle. Business justification: Property valuations are grouped into valuation cycles for periodic reporting and regulatory compliance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Cycle .

ind:valuationAssetValuationId rdf:type rdf:Property ;
    rdfs:label 'Valuation Asset Valuation Id' ;
    rdfs:comment 'Foreign key linking to valuation.valuation_asset_valuation. Business justification: Each property_valuation must reference the formal valuation report in valuation_asset_valuation for audit and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ValuationAssetValuation .

ind:appraiserContactName rdf:type rdf:Property ;
    rdfs:label 'Appraiser Contact Name' ;
    rdfs:comment 'Name of the lead appraiser or valuation professional responsible for the valuation report.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appraiserFirmName rdf:type rdf:Property ;
    rdfs:label 'Appraiser Firm Name' ;
    rdfs:comment 'Name of the independent appraisal firm or valuation provider that performed the valuation.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:appraiserLicenseNumber rdf:type rdf:Property ;
    rdfs:label 'Appraiser License Number' ;
    rdfs:comment 'Professional license or certification number of the lead appraiser.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capRate rdf:type rdf:Property ;
    rdfs:label 'Cap Rate' ;
    rdfs:comment 'Capitalization rate applied in the income approach valuation, expressed as a decimal (e.g., 0.0650 for 6.50%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:comparableSalesCount rdf:type rdf:Property ;
    rdfs:label 'Comparable Sales Count' ;
    rdfs:comment 'Number of comparable sales transactions analyzed in the sales comparison approach.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:deferredMaintenanceEstimate rdf:type rdf:Property ;
    rdfs:label 'Deferred Maintenance Estimate' ;
    rdfs:comment 'Estimated cost of deferred maintenance and immediate capital repairs identified during the valuation inspection.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalRiskDescription rdf:type rdf:Property ;
    rdfs:label 'Environmental Risk Description' ;
    rdfs:comment 'Description of any environmental risks, contamination, or remediation requirements identified.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalRiskFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Risk Flag' ;
    rdfs:comment 'Boolean indicator of whether environmental risks or contamination issues were identified during the valuation process.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:highestBestUse rdf:type rdf:Property ;
    rdfs:label 'Highest Best Use' ;
    rdfs:comment 'Determination of the highest and best use of the property as concluded by the appraiser (e.g., current use, alternative use, redevelopment).' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inspectionDate rdf:type rdf:Property ;
    rdfs:label 'Inspection Date' ;
    rdfs:comment 'Date on which the physical property inspection was conducted by the appraiser.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:marketLiquidityAssessment rdf:type rdf:Property ;
    rdfs:label 'Market Liquidity Assessment' ;
    rdfs:comment 'Assessment of the liquidity of the market for this property type and location.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketRentPsf rdf:type rdf:Property ;
    rdfs:label 'Market Rent Psf' ;
    rdfs:comment 'Estimated market rent per square foot used in the valuation analysis.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noi rdf:type rdf:Property ;
    rdfs:label 'Noi' ;
    rdfs:comment 'Net Operating Income used in the income approach valuation, representing stabilized annual income after operating expenses but before debt service.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorValuationAmount rdf:type rdf:Property ;
    rdfs:label 'Prior Valuation Amount' ;
    rdfs:comment 'Gross Asset Value (GAV) from the most recent prior valuation for variance comparison.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorValuationDate rdf:type rdf:Property ;
    rdfs:label 'Prior Valuation Date' ;
    rdfs:comment 'Date of the most recent prior valuation for variance comparison purposes.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:propertyConditionRating rdf:type rdf:Property ;
    rdfs:label 'Property Condition Rating' ;
    rdfs:comment 'Overall physical condition rating of the property as assessed by the appraiser (excellent, good, average, fair, or poor).' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stabilizedOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Stabilized Occupancy Rate' ;
    rdfs:comment 'Stabilized occupancy rate assumption used in the valuation, expressed as a decimal (e.g., 0.9500 for 95.00%).' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminalCapRate rdf:type rdf:Property ;
    rdfs:label 'Terminal Cap Rate' ;
    rdfs:comment 'Terminal capitalization rate applied to calculate the reversion value at the end of the DCF projection period, expressed as a decimal.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationBasis rdf:type rdf:Property ;
    rdfs:label 'Valuation Basis' ;
    rdfs:comment 'The basis of value applied in the valuation (market value, fair value, investment value, liquidation value, or insurance replacement value).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Valuation Confidence Level' ;
    rdfs:comment 'Appraiser\'s confidence level in the valuation conclusion based on data availability and market conditions (high, medium, or low).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationCurrency rdf:type rdf:Property ;
    rdfs:label 'Valuation Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the valuation amounts are denominated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationNotes rdf:type rdf:Property ;
    rdfs:label 'Valuation Notes' ;
    rdfs:comment 'Free-text notes capturing key assumptions, qualifications, or special considerations noted in the valuation report.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationPurpose rdf:type rdf:Property ;
    rdfs:label 'Valuation Purpose' ;
    rdfs:comment 'The business purpose for which the valuation was commissioned (acquisition due diligence, portfolio reporting, financial statement reporting, loan collateral, disposition, or regulatory compliance).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationReportDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Report Date' ;
    rdfs:comment 'Date on which the formal valuation report was issued by the appraiser.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:valuationReportReference rdf:type rdf:Property ;
    rdfs:label 'Valuation Report Reference' ;
    rdfs:comment 'External reference number or identifier assigned by the appraiser to the valuation report.' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationStatus rdf:type rdf:Property ;
    rdfs:label 'Valuation Status' ;
    rdfs:comment 'Current lifecycle status of the valuation record (draft, under review, approved, final, superseded, or rejected).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationType rdf:type rdf:Property ;
    rdfs:label 'Valuation Type' ;
    rdfs:comment 'The type or scope of valuation performed (full appraisal, desktop review, automated valuation model, broker price opinion, internal assessment, or annual revaluation).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationVariancePct rdf:type rdf:Property ;
    rdfs:label 'Valuation Variance Pct' ;
    rdfs:comment 'Percentage variance between current valuation and prior valuation, expressed as a decimal (e.g., 0.0350 for 3.50% increase).' ;
    rdfs:domain ind:PropertyValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noiRecordId rdf:type rdf:Property ;
    rdfs:label 'Noi Record Id' ;
    rdfs:comment 'Unique identifier for the NOI record. Primary key.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:NoiRecord .

ind:administrativeExpense rdf:type rdf:Property ;
    rdfs:label 'Administrative Expense' ;
    rdfs:comment 'General administrative costs including office supplies, communications, and overhead.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizationRate rdf:type rdf:Property ;
    rdfs:label 'Capitalization Rate' ;
    rdfs:comment 'Market cap rate applied to NOI for property valuation purposes, expressed as a decimal.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concessionsAmount rdf:type rdf:Property ;
    rdfs:label 'Concessions Amount' ;
    rdfs:comment 'Rental discounts, free rent periods, or other tenant incentives reducing effective rent.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:creditLoss rdf:type rdf:Property ;
    rdfs:label 'Credit Loss' ;
    rdfs:comment 'Revenue loss due to tenant defaults, non-payment, or bad debt write-offs.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveGrossIncome rdf:type rdf:Property ;
    rdfs:label 'Effective Gross Income' ;
    rdfs:comment 'Gross potential rent minus vacancy and credit losses, plus other income. Total revenue before operating expenses.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossPotentialRent rdf:type rdf:Property ;
    rdfs:label 'Gross Potential Rent' ;
    rdfs:comment 'Total rental income if the property were fully leased at market rates with no vacancies.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceExpense rdf:type rdf:Property ;
    rdfs:label 'Insurance Expense' ;
    rdfs:comment 'Property insurance premiums covering casualty, liability, and other risks.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalProfessionalFees rdf:type rdf:Property ;
    rdfs:label 'Legal Professional Fees' ;
    rdfs:comment 'Legal, accounting, consulting, and other professional service fees related to property operations.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketingLeasingExpense rdf:type rdf:Property ;
    rdfs:label 'Marketing Leasing Expense' ;
    rdfs:comment 'Costs for advertising, tenant acquisition, leasing commissions, and promotional activities.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netOperatingIncome rdf:type rdf:Property ;
    rdfs:label 'Net Operating Income' ;
    rdfs:comment 'Effective gross income minus total operating expenses. Key metric for property performance before debt service and capital expenditures.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noiMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Noi Margin Percent' ;
    rdfs:comment 'NOI as a percentage of effective gross income, indicating operational efficiency.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noiStatus rdf:type rdf:Property ;
    rdfs:label 'Noi Status' ;
    rdfs:comment 'Current status of the NOI record in the reporting and approval workflow.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherIncome rdf:type rdf:Property ;
    rdfs:label 'Other Income' ;
    rdfs:comment 'Non-rental income such as parking fees, laundry, storage, antenna leases, or service charges.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherOperatingExpenses rdf:type rdf:Property ;
    rdfs:label 'Other Operating Expenses' ;
    rdfs:comment 'Miscellaneous operating expenses not classified in other categories.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payrollExpense rdf:type rdf:Property ;
    rdfs:label 'Payroll Expense' ;
    rdfs:comment 'Salaries, wages, and benefits for on-site staff including leasing agents, maintenance, and security.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyManagementFee rdf:type rdf:Property ;
    rdfs:label 'Property Management Fee' ;
    rdfs:comment 'Fees paid to third-party or internal property management for day-to-day operations.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyTaxes rdf:type rdf:Property ;
    rdfs:label 'Property Taxes' ;
    rdfs:comment 'Real estate taxes levied by local government authorities on the property.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:repairsMaintenanceExpense rdf:type rdf:Property ;
    rdfs:label 'Repairs Maintenance Expense' ;
    rdfs:comment 'Routine maintenance, repairs, and upkeep costs to maintain property condition.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalOperatingExpenses rdf:type rdf:Property ;
    rdfs:label 'Total Operating Expenses' ;
    rdfs:comment 'Sum of all operating expenses incurred to maintain and operate the property.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:utilitiesExpense rdf:type rdf:Property ;
    rdfs:label 'Utilities Expense' ;
    rdfs:comment 'Costs for electricity, water, gas, sewer, and other utilities not recovered from tenants.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vacancyLoss rdf:type rdf:Property ;
    rdfs:label 'Vacancy Loss' ;
    rdfs:comment 'Revenue loss due to unoccupied units or spaces during the reporting period.' ;
    rdfs:domain ind:NoiRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaseId rdf:type rdf:Property ;
    rdfs:label 'Lease Id' ;
    rdfs:comment 'Unique identifier for the lease agreement record.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Lease .

ind:leaseEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lease Employee Id' ;
    rdfs:comment 'Reference to the party providing financial guarantee or credit support for tenant lease obligations.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:leasePropertyManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Lease Property Manager Employee Id' ;
    rdfs:comment 'Reference to the internal employee or external party responsible for managing this lease relationship and property operations.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:propertyManagerActorId rdf:type rdf:Property ;
    rdfs:label 'Property Manager Actor Id' ;
    rdfs:comment 'Reference to the internal employee or external party responsible for managing this lease relationship and property operations.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:tenantId rdf:type rdf:Property ;
    rdfs:label 'Tenant Id' ;
    rdfs:comment 'Reference to the tenant party occupying the leased premises.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Tenant .

ind:assignmentSubleaseRights rdf:type rdf:Property ;
    rdfs:label 'Assignment Sublease Rights' ;
    rdfs:comment 'Tenant rights to assign the lease or sublease the premises to third parties (prohibited, permitted with landlord consent, or freely assignable).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:baseRentAmount rdf:type rdf:Property ;
    rdfs:label 'Base Rent Amount' ;
    rdfs:comment 'Initial base rent amount payable by tenant per payment period, excluding escalations, operating expenses, and additional charges.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commencementDate rdf:type rdf:Property ;
    rdfs:label 'Commencement Date' ;
    rdfs:comment 'Date when the lease term begins and tenant occupancy rights commence.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:escalationFrequencyMonths rdf:type rdf:Property ;
    rdfs:label 'Escalation Frequency Months' ;
    rdfs:comment 'Number of months between rent escalation events (e.g., 12 for annual escalations, 24 for biennial).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:escalationRate rdf:type rdf:Property ;
    rdfs:label 'Escalation Rate' ;
    rdfs:comment 'Annual percentage or fixed amount by which base rent increases, expressed as a decimal (e.g., 0.0300 for 3 percent annual increase).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationType rdf:type rdf:Property ;
    rdfs:label 'Escalation Type' ;
    rdfs:comment 'Method by which base rent increases over the lease term (fixed amount, CPI-indexed, percentage increase, or none).' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusivityClause rdf:type rdf:Property ;
    rdfs:label 'Exclusivity Clause' ;
    rdfs:comment 'Contractual provision granting tenant exclusive rights to conduct specific business activities within the property, preventing landlord from leasing to competing tenants.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:floorNumber rdf:type rdf:Property ;
    rdfs:label 'Floor Number' ;
    rdfs:comment 'Floor number or level identifier where the leased premises are located within the property.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:freeRentMonths rdf:type rdf:Property ;
    rdfs:label 'Free Rent Months' ;
    rdfs:comment 'Number of months at lease commencement during which tenant is not required to pay base rent, used as a lease incentive.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:glaSquareFeet rdf:type rdf:Property ;
    rdfs:label 'Gla Square Feet' ;
    rdfs:comment 'Total floor area of the leased premises measured in square feet, representing the space available for tenant use and the basis for rent calculations.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaseStatus rdf:type rdf:Property ;
    rdfs:label 'Lease Status' ;
    rdfs:comment 'Current state of the lease agreement in its lifecycle (draft, active, expired, terminated, renewed, holdover).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaseType rdf:type rdf:Property ;
    rdfs:label 'Lease Type' ;
    rdfs:comment 'Classification of lease structure defining tenant and landlord expense responsibilities (gross, net, triple-net, modified gross, percentage, ground).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatingExpenseRecoveryType rdf:type rdf:Property ;
    rdfs:label 'Operating Expense Recovery Type' ;
    rdfs:comment 'Method by which landlord recovers property operating expenses from tenant (base-year, expense-stop, pro-rata share, or none for gross leases).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parkingRentAmount rdf:type rdf:Property ;
    rdfs:label 'Parking Rent Amount' ;
    rdfs:comment 'Additional monthly or annual rent charged for tenant parking spaces, separate from base rent.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parkingSpacesCount rdf:type rdf:Property ;
    rdfs:label 'Parking Spaces Count' ;
    rdfs:comment 'Number of parking spaces allocated to tenant as part of the lease agreement.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:percentageRentBreakpoint rdf:type rdf:Property ;
    rdfs:label 'Percentage Rent Breakpoint' ;
    rdfs:comment 'Annual sales revenue threshold above which percentage rent becomes payable by tenant.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:percentageRentFlag rdf:type rdf:Property ;
    rdfs:label 'Percentage Rent Flag' ;
    rdfs:comment 'Indicates whether lease includes percentage rent provisions based on tenant sales revenue, common in retail leases.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:percentageRentRate rdf:type rdf:Property ;
    rdfs:label 'Percentage Rent Rate' ;
    rdfs:comment 'Percentage of tenant gross sales revenue payable as additional rent above base rent, expressed as decimal (e.g., 0.0500 for 5 percent).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:possessionDate rdf:type rdf:Property ;
    rdfs:label 'Possession Date' ;
    rdfs:comment 'Date when tenant takes physical possession of the leased premises, which may differ from commencement date for build-out periods.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:renewalNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Renewal Notice Days' ;
    rdfs:comment 'Number of days prior to lease expiry by which tenant must notify landlord of intent to exercise renewal option.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalOptionCount rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Count' ;
    rdfs:comment 'Number of renewal option periods available to the tenant beyond the initial lease term.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:renewalOptionTermMonths rdf:type rdf:Property ;
    rdfs:label 'Renewal Option Term Months' ;
    rdfs:comment 'Duration in months of each renewal option period if tenant exercises the renewal right.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rentCommencementDate rdf:type rdf:Property ;
    rdfs:label 'Rent Commencement Date' ;
    rdfs:comment 'Date when tenant rent payment obligations begin, which may differ from lease commencement if free rent period is granted.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rentPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Rent Payment Frequency' ;
    rdfs:comment 'Frequency at which rent payments are due from the tenant (monthly, quarterly, annually, semi-annually).' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rentPerSquareFoot rdf:type rdf:Property ;
    rdfs:label 'Rent Per Square Foot' ;
    rdfs:comment 'Base rent amount expressed as a rate per square foot of GLA, used for market comparison and valuation analysis.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:securityDepositAmount rdf:type rdf:Property ;
    rdfs:label 'Security Deposit Amount' ;
    rdfs:comment 'Refundable deposit amount held by landlord as security against tenant default or property damage.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:suiteNumber rdf:type rdf:Property ;
    rdfs:label 'Suite Number' ;
    rdfs:comment 'Suite or unit number identifier for the specific leased premises within the property.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenantImprovementAllowance rdf:type rdf:Property ;
    rdfs:label 'Tenant Improvement Allowance' ;
    rdfs:comment 'Dollar amount provided by landlord to tenant for build-out and customization of leased premises.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:termMonths rdf:type rdf:Property ;
    rdfs:label 'Term Months' ;
    rdfs:comment 'Total duration of the lease agreement expressed in months from commencement to expiry.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Termination Notice Days' ;
    rdfs:comment 'Number of days advance notice tenant must provide to landlord to exercise early termination right.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminationOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Termination Option Flag' ;
    rdfs:comment 'Indicates whether tenant has the contractual right to terminate the lease prior to expiry date.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:terminationPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Termination Penalty Amount' ;
    rdfs:comment 'Financial penalty or fee payable by tenant to landlord upon early termination of the lease.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:useClause rdf:type rdf:Property ;
    rdfs:label 'Use Clause' ;
    rdfs:comment 'Contractual description of permitted business activities and uses for the leased premises, restricting tenant operations to specified purposes.' ;
    rdfs:domain ind:Lease ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaseRentScheduleId rdf:type rdf:Property ;
    rdfs:label 'Lease Rent Schedule Id' ;
    rdfs:comment 'Unique identifier for the lease rent schedule record. Primary key.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:abatementAmount rdf:type rdf:Property ;
    rdfs:label 'Abatement Amount' ;
    rdfs:comment 'The rent amount waived or reduced during this period as a lease concession.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Payment Amount' ;
    rdfs:comment 'The actual rent amount received for this period, which may differ from scheduled amount due to adjustments or disputes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualPaymentDate rdf:type rdf:Property ;
    rdfs:label 'Actual Payment Date' ;
    rdfs:comment 'The date on which the rent payment for this period was actually received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:cpiAdjustedAmount rdf:type rdf:Property ;
    rdfs:label 'Cpi Adjusted Amount' ;
    rdfs:comment 'The additional rent amount resulting from CPI indexation for this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cpiAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Cpi Adjustment Factor' ;
    rdfs:comment 'The inflation adjustment multiplier applied to base rent based on CPI movement for this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeRentToDate rdf:type rdf:Property ;
    rdfs:label 'Cumulative Rent To Date' ;
    rdfs:comment 'The sum of all rent amounts from lease commencement through the end of this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:effectiveRentPerSqft rdf:type rdf:Property ;
    rdfs:label 'Effective Rent Per Sqft' ;
    rdfs:comment 'The total rent amount divided by leased square footage, representing the effective rate for this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationAmount rdf:type rdf:Property ;
    rdfs:label 'Escalation Amount' ;
    rdfs:comment 'The incremental rent increase applied in this period due to contractual step-up provisions.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:freeRentFlag rdf:type rdf:Property ;
    rdfs:label 'Free Rent Flag' ;
    rdfs:comment 'Indicates whether this period is a rent abatement or free rent period per lease concessions.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leaseModificationFlag rdf:type rdf:Property ;
    rdfs:label 'Lease Modification Flag' ;
    rdfs:comment 'Indicates whether this rent schedule entry was affected by a lease amendment or modification.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:modificationEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Modification Effective Date' ;
    rdfs:comment 'The date on which a lease modification affecting this rent period became effective.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noiContribution rdf:type rdf:Property ;
    rdfs:label 'Noi Contribution' ;
    rdfs:comment 'The net operating income contribution from this rent period after deducting direct property expenses.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingExpenseRecovery rdf:type rdf:Property ;
    rdfs:label 'Operating Expense Recovery' ;
    rdfs:comment 'Tenant reimbursement for property operating expenses allocated to this rent period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherChargesAmount rdf:type rdf:Property ;
    rdfs:label 'Other Charges Amount' ;
    rdfs:comment 'Additional charges such as parking, utilities, or amenity fees for this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentDueDate rdf:type rdf:Property ;
    rdfs:label 'Payment Due Date' ;
    rdfs:comment 'The contractual date by which the rent payment for this period must be received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:percentageRentAmount rdf:type rdf:Property ;
    rdfs:label 'Percentage Rent Amount' ;
    rdfs:comment 'Variable rent based on tenant revenue or property performance metrics for this period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:periodSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Period Sequence Number' ;
    rdfs:comment 'Sequential ordering of the rent period within the lease term, starting from 1.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:rentCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Rent Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all rent amounts in this schedule entry.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rentType rdf:type rdf:Property ;
    rdfs:label 'Rent Type' ;
    rdfs:comment 'The lease structure type defining which expenses are included in or excluded from base rent.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:straightLineRentAmount rdf:type rdf:Property ;
    rdfs:label 'Straight Line Rent Amount' ;
    rdfs:comment 'The average rent amount per period calculated on a straight-line basis over the lease term for accounting purposes.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRecoveryAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Recovery Amount' ;
    rdfs:comment 'Tenant reimbursement for property taxes allocated to this rent period.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalRentAmount rdf:type rdf:Property ;
    rdfs:label 'Total Rent Amount' ;
    rdfs:comment 'The aggregate rent amount for this period including base rent, escalations, adjustments, and recoveries.' ;
    rdfs:domain ind:LeaseRentSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rentCollectionId rdf:type rdf:Property ;
    rdfs:label 'Rent Collection Id' ;
    rdfs:comment 'Unique identifier for the rent collection transaction record.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:arrearsBalance rdf:type rdf:Property ;
    rdfs:label 'Arrears Balance' ;
    rdfs:comment 'Outstanding unpaid rent balance owed by the tenant as of the collection date.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:billingPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period End Date' ;
    rdfs:comment 'End date of the rental period covered by this collection transaction.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:billingPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Billing Period Start Date' ;
    rdfs:comment 'Start date of the rental period covered by this collection transaction.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:collectionNotes rdf:type rdf:Property ;
    rdfs:label 'Collection Notes' ;
    rdfs:comment 'Free-text notes or comments regarding the rent collection transaction, disputes, or follow-up actions.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collectionStatus rdf:type rdf:Property ;
    rdfs:label 'Collection Status' ;
    rdfs:comment 'Current status of the rent collection transaction in the receivables lifecycle.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:daysOverdue rdf:type rdf:Property ;
    rdfs:label 'Days Overdue' ;
    rdfs:comment 'Number of days the rent payment is overdue past the due date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:discountAmount rdf:type rdf:Property ;
    rdfs:label 'Discount Amount' ;
    rdfs:comment 'Discount or concession applied to the invoiced rent amount.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:invoicedAmount rdf:type rdf:Property ;
    rdfs:label 'Invoiced Amount' ;
    rdfs:comment 'Total rent amount invoiced to the tenant for the billing period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lateFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Late Fee Amount' ;
    rdfs:comment 'Additional late payment fee charged to the tenant for overdue rent.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netAmountDue rdf:type rdf:Property ;
    rdfs:label 'Net Amount Due' ;
    rdfs:comment 'Net rent amount due after applying discounts, late fees, and adjustments.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Payment Received Date' ;
    rdfs:comment 'Actual date on which the rent payment was received from the tenant.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:receivedAmount rdf:type rdf:Property ;
    rdfs:label 'Received Amount' ;
    rdfs:comment 'Actual amount of rent payment received from the tenant.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxAmount rdf:type rdf:Property ;
    rdfs:label 'Tax Amount' ;
    rdfs:comment 'Tax component included in the rent collection transaction, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:writeOffFlag rdf:type rdf:Property ;
    rdfs:label 'Write Off Flag' ;
    rdfs:comment 'Indicates whether the uncollected rent has been written off as uncollectible.' ;
    rdfs:domain ind:RentCollection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:amlScreeningDate rdf:type rdf:Property ;
    rdfs:label 'Aml Screening Date' ;
    rdfs:comment 'The date of the most recent AML screening performed on the tenant.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:amlStatus rdf:type rdf:Property ;
    rdfs:label 'Aml Status' ;
    rdfs:comment 'The current Anti-Money Laundering screening status of the tenant.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:anchorTenantFlag rdf:type rdf:Property ;
    rdfs:label 'Anchor Tenant Flag' ;
    rdfs:comment 'Boolean indicator of whether the tenant is classified as an anchor tenant, typically occupying significant space and driving property value.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:annualRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue Amount' ;
    rdfs:comment 'The most recent annual revenue of the tenant entity in the reporting currency, used for creditworthiness assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
