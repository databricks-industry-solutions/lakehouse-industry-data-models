    rdfs:domain ind:ResearchNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priorTargetPrice rdf:type rdf:Property ;
    rdfs:label 'Prior Target Price' ;
    rdfs:comment 'The previous target price before this research note, if this is an update or change.' ;
