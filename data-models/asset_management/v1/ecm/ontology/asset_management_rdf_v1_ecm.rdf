    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitda rdf:type rdf:Property ;
    rdfs:label 'Ebitda' ;
    rdfs:comment 'Earnings before interest, taxes, depreciation, and amortization, in reporting currency.' ;
