    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdCount rdf:type rdf:Property ;
    rdfs:label 'Hold Count' ;
    rdfs:comment 'Number of analysts with a hold recommendation.' ;
