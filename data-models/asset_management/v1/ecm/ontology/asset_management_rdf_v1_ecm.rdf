    rdfs:range xsd:string .

ind:supersededByConsensusMarketConsensusId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Consensus Market Consensus Id' ;
    rdfs:comment 'Reference to the newer consensus record that supersedes this estimate.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:MarketConsensus .

ind:adjustmentRationale rdf:type rdf:Property ;
    rdfs:label 'Adjustment Rationale' ;
    rdfs:comment 'Explanation of the rationale for any proprietary adjustment applied to the consensus estimate.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:analystCount rdf:type rdf:Property ;
    rdfs:label 'Analyst Count' ;
    rdfs:comment 'Number of analysts contributing estimates to the consensus calculation.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buyCount rdf:type rdf:Property ;
    rdfs:label 'Buy Count' ;
    rdfs:comment 'Number of analysts with a buy or strong buy recommendation.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:collectionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Collection Timestamp' ;
    rdfs:comment 'Date and time when the consensus estimate was collected from the external data provider.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:consensusIdentifier rdf:type rdf:Property ;
    rdfs:label 'Consensus Identifier' ;
    rdfs:comment 'External identifier or ticker symbol used by the data provider to uniquely identify this consensus estimate.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:consensusRating rdf:type rdf:Property ;
    rdfs:label 'Consensus Rating' ;
    rdfs:comment 'Aggregated analyst recommendation rating for the security.' ;
    rdfs:domain ind:MarketConsensus ;
    rdf:type owl:DatatypeProperty ;
