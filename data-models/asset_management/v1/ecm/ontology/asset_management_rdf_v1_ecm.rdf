ind:primaryExchangeCode rdf:type rdf:Property ;
    rdfs:label 'Primary Exchange Code' ;
    rdfs:comment 'Market Identifier Code (MIC) of the primary stock exchange where the issuers equity securities are listed and traded.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
