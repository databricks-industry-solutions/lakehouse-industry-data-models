    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:collateralTypeAllowed rdf:type rdf:Property ;
    rdfs:label 'Collateral Type Allowed' ;
    rdfs:comment 'Types of assets that can be used as collateral for this membership.' ;
