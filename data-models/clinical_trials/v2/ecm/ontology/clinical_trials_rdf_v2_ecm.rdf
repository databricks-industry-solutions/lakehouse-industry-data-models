ind:designTypeCodelistTermId rdf:type rdf:Property ;
    rdfs:label 'Design Type Codelist Term Id' ;
    rdfs:comment 'add column design_type_codelist_term_id (BIGINT) with FK to datamanagement.codelist_term.codelist_term_id — per user vibes instruction 1, study_design (interventional or observational) must reference controlled terminology' ;
    rdfs:domain ind:StudyDesign ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CodelistTerm .

ind:designName rdf:type rdf:Property ;
