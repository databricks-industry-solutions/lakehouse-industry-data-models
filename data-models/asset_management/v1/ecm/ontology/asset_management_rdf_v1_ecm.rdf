    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:batchReference rdf:type rdf:Property ;
    rdfs:label 'Batch Reference' ;
    rdfs:comment 'Identifier of the ETL batch process that loaded this price record, supporting data lineage and troubleshooting.' ;
    rdfs:domain ind:PriceHistory ;
