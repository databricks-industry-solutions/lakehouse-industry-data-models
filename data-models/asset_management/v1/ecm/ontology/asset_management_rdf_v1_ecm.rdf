ind:industrySectorCode rdf:type rdf:Property ;
    rdfs:label 'Industry Sector Code' ;
    rdfs:comment 'The GICS industry sector code classifying the tenants primary business activity for concentration risk analysis.' ;
    rdfs:domain ind:Tenant ;
    rdf:type owl:DatatypeProperty ;
