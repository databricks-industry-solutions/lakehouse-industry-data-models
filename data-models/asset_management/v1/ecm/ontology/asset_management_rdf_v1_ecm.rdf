    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:wordCount rdf:type rdf:Property ;
    rdfs:label 'Word Count' ;
    rdfs:comment 'Total word count of the research note document for content depth tracking.' ;
    rdfs:domain ind:ResearchNote ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceHistoryId rdf:type rdf:Property ;
    rdfs:label 'Price History Id' ;
    rdfs:comment 'Unique identifier for each daily price history record.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:adjustedClosePrice rdf:type rdf:Property ;
    rdfs:label 'Adjusted Close Price' ;
    rdfs:comment 'Closing price adjusted for corporate actions including dividends, stock splits, and rights offerings to enable accurate historical return calculations.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:askPrice rdf:type rdf:Property ;
    rdfs:label 'Ask Price' ;
    rdfs:comment 'Lowest ask price at market close, representing the price sellers are willing to accept.' ;
