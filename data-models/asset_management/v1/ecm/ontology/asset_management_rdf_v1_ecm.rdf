ind:actualSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Actual Spend Amount' ;
    rdfs:comment 'Total capital expenditure actually incurred and paid as of the reporting date, representing cash outflows or accrued liabilities.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualStartDate rdf:type rdf:Property ;
    rdfs:label 'Actual Start Date' ;
    rdfs:comment 'Actual date when capital expenditure program activities commenced, used for schedule variance analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvedBudgetAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Budget Amount' ;
    rdfs:comment 'Total capital expenditure budget amount approved by the Investment Committee (IC) or delegated authority for the program.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Budget Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the approved budget and all financial amounts in the program.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:businessCaseReference rdf:type rdf:Property ;
    rdfs:label 'Business Case Reference' ;
    rdfs:comment 'Reference identifier or document number for the Investment Memorandum (IM) or business case supporting the capital expenditure program.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:committedSpendAmount rdf:type rdf:Property ;
    rdfs:label 'Committed Spend Amount' ;
    rdfs:comment 'Total amount of capital expenditure committed through contracts, purchase orders, and binding agreements as of the reporting date.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:completionPercentage rdf:type rdf:Property ;
    rdfs:label 'Completion Percentage' ;
    rdfs:comment 'Current percentage of program completion based on milestones achieved, work completed, or budget spent.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyAmount rdf:type rdf:Property ;
    rdfs:label 'Contingency Amount' ;
    rdfs:comment 'Budget contingency or reserve amount set aside to cover unforeseen costs, scope changes, or risk events during program execution.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyPercentage rdf:type rdf:Property ;
    rdfs:label 'Contingency Percentage' ;
    rdfs:comment 'Contingency amount expressed as a percentage of the approved budget, indicating the risk buffer allocated.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractorName rdf:type rdf:Property ;
    rdfs:label 'Contractor Name' ;
    rdfs:comment 'Name of the primary contractor or construction firm engaged to execute the capital expenditure program.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realestateCapexProgramDescription rdf:type rdf:Property ;
    rdfs:label 'Realestate Capex Program Description' ;
    rdfs:comment 'Detailed narrative description of the capital expenditure program scope, objectives, and key activities.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyEfficiencyImprovementPercentage rdf:type rdf:Property ;
    rdfs:label 'Energy Efficiency Improvement Percentage' ;
    rdfs:comment 'Expected percentage improvement in energy efficiency or reduction in energy consumption resulting from the capital expenditure program.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgImpactCategory rdf:type rdf:Property ;
    rdfs:label 'Esg Impact Category' ;
    rdfs:comment 'Classification of the Environmental, Social, and Governance (ESG) impact or benefit delivered by the capital expenditure program.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedIrrPercentage rdf:type rdf:Property ;
    rdfs:label 'Expected Irr Percentage' ;
    rdfs:comment 'Projected Internal Rate of Return (IRR) for the capital expenditure program, used to evaluate value creation and investment efficiency.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedNavIncreaseAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Nav Increase Amount' ;
    rdfs:comment 'Projected increase in property Net Asset Value (NAV) or Gross Asset Value (GAV) resulting from the capital expenditure program.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedNoiIncreaseAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Noi Increase Amount' ;
    rdfs:comment 'Projected annual increase in Net Operating Income (NOI) resulting from the capital expenditure program upon completion.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Completion Date' ;
    rdfs:comment 'Latest forecast date for program completion based on current progress and known delays or accelerations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastTotalCostAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast Total Cost Amount' ;
    rdfs:comment 'Latest forecast of the total capital expenditure cost at completion, including all approved changes and anticipated overruns.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingSource rdf:type rdf:Property ;
    rdfs:label 'Funding Source' ;
    rdfs:comment 'Source of capital funding for the expenditure program, such as equity, debt, joint venture contribution, or asset-level cash flow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgReductionTargetTonnes rdf:type rdf:Property ;
    rdfs:label 'Ghg Reduction Target Tonnes' ;
    rdfs:comment 'Target reduction in annual Greenhouse Gas (GHG) emissions measured in tonnes of carbon dioxide equivalent resulting from the program.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lastStatusUpdateDate rdf:type rdf:Property ;
    rdfs:label 'Last Status Update Date' ;
    rdfs:comment 'Date when the program status, forecast, or financial data was last updated in the system.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Planned Completion Date' ;
    rdfs:comment 'Scheduled date for the completion of all capital expenditure program activities as per the original project plan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:plannedStartDate rdf:type rdf:Property ;
    rdfs:label 'Planned Start Date' ;
    rdfs:comment 'Scheduled date for the commencement of capital expenditure program activities as per the original project plan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:programCode rdf:type rdf:Property ;
    rdfs:label 'Program Code' ;
    rdfs:comment 'Unique business identifier or code assigned to the capital expenditure program for tracking and reference.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programManagerName rdf:type rdf:Property ;
    rdfs:label 'Program Manager Name' ;
    rdfs:comment 'Name of the individual responsible for managing and delivering the capital expenditure program.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programName rdf:type rdf:Property ;
    rdfs:label 'Program Name' ;
    rdfs:comment 'Business name or title of the capital expenditure program for identification and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programStatus rdf:type rdf:Property ;
    rdfs:label 'Program Status' ;
    rdfs:comment 'Current lifecycle status of the capital expenditure program indicating its execution stage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programType rdf:type rdf:Property ;
    rdfs:label 'Program Type' ;
    rdfs:comment 'Classification of the capital expenditure program by its strategic purpose and scope.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:strategicObjective rdf:type rdf:Property ;
    rdfs:label 'Strategic Objective' ;
    rdfs:comment 'High-level business objective or value creation goal that the capital expenditure program is designed to achieve.' ;
    rdfs:domain ind:RealestateCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexExpenditureId rdf:type rdf:Property ;
    rdfs:label 'Capex Expenditure Id' ;
    rdfs:comment 'Unique identifier for the capital expenditure transaction record.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approverEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Approver Employee Id' ;
    rdfs:comment 'Reference to the employee or user entity who approved this expenditure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:budgetLineItemId rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item Id' ;
    rdfs:comment 'Reference to the specific budget line item within the capital expenditure program budget against which this expenditure is tracked.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:BudgetLineItem .

ind:contractId rdf:type rdf:Property ;
    rdfs:label 'Contract Id' ;
    rdfs:comment 'Reference to the vendor contract or service agreement under which this expenditure is authorized.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Contract .

ind:vendorId rdf:type rdf:Property ;
    rdfs:label 'Vendor Id' ;
    rdfs:comment 'Reference to the vendor or contractor entity in the vendor master data.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Vendor .

ind:approvedAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Amount' ;
    rdfs:comment 'Amount approved for payment after review and validation, which may differ from the invoiced amount due to adjustments or disputes.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approverName rdf:type rdf:Property ;
    rdfs:label 'Approver Name' ;
    rdfs:comment 'Name of the individual or committee that approved this capital expenditure transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalizationFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalization Flag' ;
    rdfs:comment 'Indicates whether this expenditure qualifies for capitalization as a fixed asset addition under accounting standards (True) or should be expensed (False).' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:depreciationMethod rdf:type rdf:Property ;
    rdfs:label 'Depreciation Method' ;
    rdfs:comment 'Depreciation method to be applied to the capitalized expenditure: straight-line, declining balance, units of production, or other.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexExpenditureDescription rdf:type rdf:Property ;
    rdfs:label 'Capex Expenditure Description' ;
    rdfs:comment 'Detailed narrative description of the work performed, materials purchased, or services rendered for this capital expenditure.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureCategory rdf:type rdf:Property ;
    rdfs:label 'Expenditure Category' ;
    rdfs:comment 'Classification of the capital expenditure by cost type: hard costs (construction, materials), soft costs (design, engineering), furniture fixtures and equipment, contingency reserves, professional fees, or permits and regulatory fees.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure Date' ;
    rdfs:comment 'The date on which the capital expenditure transaction occurred or was incurred.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenditureReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Expenditure Reference Number' ;
    rdfs:comment 'Business identifier for the expenditure transaction, typically a work order number, invoice number, or payment reference.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenditureStatus rdf:type rdf:Property ;
    rdfs:label 'Expenditure Status' ;
    rdfs:comment 'Current lifecycle status of the expenditure transaction within the approval and payment workflow.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneReference rdf:type rdf:Property ;
    rdfs:label 'Milestone Reference' ;
    rdfs:comment 'Reference to the project milestone or phase associated with this expenditure, used for progress tracking and payment scheduling.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidAmount rdf:type rdf:Property ;
    rdfs:label 'Paid Amount' ;
    rdfs:comment 'Actual amount paid to the vendor for this expenditure transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectCode rdf:type rdf:Property ;
    rdfs:label 'Project Code' ;
    rdfs:comment 'Project or capital program code under which this expenditure is tracked for budgeting and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchaseOrderNumber rdf:type rdf:Property ;
    rdfs:label 'Purchase Order Number' ;
    rdfs:comment 'Purchase order number issued to the vendor authorizing the work or procurement associated with this expenditure.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retainageAmount rdf:type rdf:Property ;
    rdfs:label 'Retainage Amount' ;
    rdfs:comment 'Amount withheld from payment as retainage per contract terms, to be released upon project completion or milestone achievement.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:retainagePercentage rdf:type rdf:Property ;
    rdfs:label 'Retainage Percentage' ;
    rdfs:comment 'Percentage of the invoiced amount withheld as retainage, expressed as a decimal (e.g., 0.1000 for 10%).' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scopeOfWork rdf:type rdf:Property ;
    rdfs:label 'Scope Of Work' ;
    rdfs:comment 'Detailed scope of work or deliverables associated with this expenditure, often referencing contract terms or work order specifications.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxRate rdf:type rdf:Property ;
    rdfs:label 'Tax Rate' ;
    rdfs:comment 'Tax rate applied to the expenditure, expressed as a decimal (e.g., 0.0700 for 7%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:usefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Useful Life Years' ;
    rdfs:comment 'Estimated useful life in years for depreciation purposes if the expenditure is capitalized.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:vendorName rdf:type rdf:Property ;
    rdfs:label 'Vendor Name' ;
    rdfs:comment 'Name of the vendor, contractor, or service provider to whom the expenditure was paid.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:workOrderReference rdf:type rdf:Property ;
    rdfs:label 'Work Order Reference' ;
    rdfs:comment 'Reference number of the work order or project task associated with this expenditure.' ;
    rdfs:domain ind:CapexExpenditure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realestateDebtFacilityId rdf:type rdf:Property ;
    rdfs:label 'Realestate Debt Facility Id' ;
    rdfs:comment 'Unique identifier for the real estate debt facility record. Primary key.' ;
    rdfs:domain ind:Realestate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RealestateDebtFacility .

ind:creditIssuerId rdf:type rdf:Property ;
    rdfs:label 'Credit Issuer Id' ;
    rdfs:comment 'Reference to the financial institution or counterparty providing the debt facility.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CreditIssuer .

ind:lenderCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Lender Counterparty Id' ;
    rdfs:comment 'Foreign key linking to collateral.counterparty. Business justification: The lender of a debt facility is a counterparty; linking facilitates loan origination, servicing, and regulatory reporting.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:loanServicerId rdf:type rdf:Property ;
    rdfs:label 'Loan Servicer Id' ;
    rdfs:comment 'Reference to the third-party servicer administering the loan, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LoanServicer .

ind:accruedInterestAmount rdf:type rdf:Property ;
    rdfs:label 'Accrued Interest Amount' ;
    rdfs:comment 'Interest accrued but not yet paid as of the current valuation date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Amortization Period Months' ;
    rdfs:comment 'Total number of months over which the loan principal is scheduled to amortize.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amortizationType rdf:type rdf:Property ;
    rdfs:label 'Amortization Type' ;
    rdfs:comment 'Principal repayment structure: interest-only, amortizing, bullet, or balloon payment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentFeeRate rdf:type rdf:Property ;
    rdfs:label 'Commitment Fee Rate' ;
    rdfs:comment 'Annual fee rate applied to the undrawn portion of the facility, expressed as a decimal.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:covenantPackage rdf:type rdf:Property ;
    rdfs:label 'Covenant Package' ;
    rdfs:comment 'Summary description of financial and operational covenants attached to the facility.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultDate rdf:type rdf:Property ;
    rdfs:label 'Default Date' ;
    rdfs:comment 'Date when the facility entered default status, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:defaultFlag rdf:type rdf:Property ;
    rdfs:label 'Default Flag' ;
    rdfs:comment 'Indicates whether the facility is currently in default or breach of covenants.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:drawnAmount rdf:type rdf:Property ;
    rdfs:label 'Drawn Amount' ;
    rdfs:comment 'Current principal amount drawn down and outstanding under the facility.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:extensionOptionFlag rdf:type rdf:Property ;
    rdfs:label 'Extension Option Flag' ;
    rdfs:comment 'Indicates whether the facility includes an option to extend the maturity date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:extensionPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Extension Period Months' ;
    rdfs:comment 'Number of months by which the facility maturity can be extended if the option is exercised.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:facilityIdentifier rdf:type rdf:Property ;
    rdfs:label 'Facility Identifier' ;
    rdfs:comment 'External loan or facility reference number assigned by the lender or internal system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Facility Limit Amount' ;
    rdfs:comment 'Maximum principal amount available under the debt facility agreement.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityStatus rdf:type rdf:Property ;
    rdfs:label 'Facility Status' ;
    rdfs:comment 'Current lifecycle status of the debt facility: active, committed, drawn, matured, repaid, or defaulted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityType rdf:type rdf:Property ;
    rdfs:label 'Facility Type' ;
    rdfs:comment 'Classification of the debt facility structure: senior mortgage, mezzanine, construction loan, revolving credit, bridge loan, or term loan.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestRateType rdf:type rdf:Property ;
    rdfs:label 'Interest Rate Type' ;
    rdfs:comment 'Classification of the interest rate structure: fixed, floating, variable, or hybrid.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:loanAgreementDate rdf:type rdf:Property ;
    rdfs:label 'Loan Agreement Date' ;
    rdfs:comment 'Date when the formal loan agreement was signed by all parties.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ltvRatio rdf:type rdf:Property ;
    rdfs:label 'Ltv Ratio' ;
    rdfs:comment 'Loan-to-value ratio calculated as drawn amount divided by property valuation, expressed as a decimal (e.g., 0.6500 for 65%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modifiedByUser rdf:type rdf:Property ;
    rdfs:label 'Modified By User' ;
    rdfs:comment 'User identifier of the person who last modified this record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originationDate rdf:type rdf:Property ;
    rdfs:label 'Origination Date' ;
    rdfs:comment 'Date when the debt facility was originated and the loan agreement was executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:originationFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Origination Fee Amount' ;
    rdfs:comment 'One-time fee paid to the lender at facility origination.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaymentAllowedFlag rdf:type rdf:Property ;
    rdfs:label 'Prepayment Allowed Flag' ;
    rdfs:comment 'Indicates whether prepayment of principal is permitted under the facility terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:prepaymentPenaltyRate rdf:type rdf:Property ;
    rdfs:label 'Prepayment Penalty Rate' ;
    rdfs:comment 'Penalty rate applied to prepayments, expressed as a decimal percentage of prepaid principal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recourseType rdf:type rdf:Property ;
    rdfs:label 'Recourse Type' ;
    rdfs:comment 'Extent of borrower liability beyond collateral: full recourse, non-recourse, or limited recourse.' ;
    rdfs:domain ind:RealestateDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:referenceRate rdf:type rdf:Property ;
    rdfs:label 'Reference Rate' ;
    rdfs:comment 'Benchmark rate used for floating rate facilities (e.g., SOFR, LIBOR, EURIBOR).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:seniority rdf:type rdf:Property ;
    rdfs:label 'Seniority' ;
    rdfs:comment 'Priority ranking of the debt facility in the capital structure: senior, subordinated, mezzanine, or junior.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spreadBps rdf:type rdf:Property ;
    rdfs:label 'Spread Bps' ;
    rdfs:comment 'Credit spread over the reference rate, expressed in basis points (e.g., 250 for 2.50%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:undrawnAmount rdf:type rdf:Property ;
    rdfs:label 'Undrawn Amount' ;
    rdfs:comment 'Remaining available principal amount that can be drawn under the facility limit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ltvDscrCovenantId rdf:type rdf:Property ;
    rdfs:label 'Ltv Dscr Covenant Id' ;
    rdfs:comment 'Unique identifier for the LTV and DSCR covenant compliance record.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualDebtService rdf:type rdf:Property ;
    rdfs:label 'Annual Debt Service' ;
    rdfs:comment 'Total annual debt service obligation including principal and interest payments for the debt facility.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appraiserName rdf:type rdf:Property ;
    rdfs:label 'Appraiser Name' ;
    rdfs:comment 'Name of the independent appraiser or valuation firm that provided the property valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:covenantNotes rdf:type rdf:Property ;
    rdfs:label 'Covenant Notes' ;
    rdfs:comment 'Additional notes or commentary regarding the covenant measurement, compliance status, or special circumstances.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cureActionTaken rdf:type rdf:Property ;
    rdfs:label 'Cure Action Taken' ;
    rdfs:comment 'Description of remedial actions taken to cure a covenant breach, such as capital injection or debt paydown.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cureCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Cure Completion Date' ;
    rdfs:comment 'Date on which the covenant breach was cured and compliance was restored.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dscrBreachAmount rdf:type rdf:Property ;
    rdfs:label 'Dscr Breach Amount' ;
    rdfs:comment 'Monetary shortfall by which the DSCR covenant is breached, if applicable; null if compliant.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dscrComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Dscr Compliance Status' ;
    rdfs:comment 'Current compliance status of the DSCR covenant at the measurement date.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dscrCovenantThreshold rdf:type rdf:Property ;
    rdfs:label 'Dscr Covenant Threshold' ;
    rdfs:comment 'Minimum required DSCR as specified in the loan agreement or debt facility covenant.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dscrRatio rdf:type rdf:Property ;
    rdfs:label 'Dscr Ratio' ;
    rdfs:comment 'Calculated DSCR expressed as a decimal, representing NOI divided by annual debt service.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lenderNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Lender Notification Date' ;
    rdfs:comment 'Date on which the lender was formally notified of the covenant measurement results.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:ltvBreachAmount rdf:type rdf:Property ;
    rdfs:label 'Ltv Breach Amount' ;
    rdfs:comment 'Monetary amount by which the LTV covenant is breached, if applicable; null if compliant.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ltvComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Ltv Compliance Status' ;
    rdfs:comment 'Current compliance status of the LTV covenant at the measurement date.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ltvCovenantThreshold rdf:type rdf:Property ;
    rdfs:label 'Ltv Covenant Threshold' ;
    rdfs:comment 'Maximum allowable LTV ratio as specified in the loan agreement or debt facility covenant.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementDate rdf:type rdf:Property ;
    rdfs:label 'Measurement Date' ;
    rdfs:comment 'The date on which the LTV and DSCR covenant compliance was measured and calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:measurementFrequency rdf:type rdf:Property ;
    rdfs:label 'Measurement Frequency' ;
    rdfs:comment 'Frequency at which covenant compliance must be measured and reported per the loan agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:nextMeasurementDate rdf:type rdf:Property ;
    rdfs:label 'Next Measurement Date' ;
    rdfs:comment 'Scheduled date for the next covenant compliance measurement as per the loan agreement.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noiTrailingTwelveMonths rdf:type rdf:Property ;
    rdfs:label 'Noi Trailing Twelve Months' ;
    rdfs:comment 'Net operating income for the property over the trailing twelve months, used in DSCR calculation.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outstandingDebtBalance rdf:type rdf:Property ;
    rdfs:label 'Outstanding Debt Balance' ;
    rdfs:comment 'Total outstanding principal balance of the debt facility at the measurement date.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:overallCovenantStatus rdf:type rdf:Property ;
    rdfs:label 'Overall Covenant Status' ;
    rdfs:comment 'Aggregate compliance status considering both LTV and DSCR covenants for the measurement period.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preparedBy rdf:type rdf:Property ;
    rdfs:label 'Prepared By' ;
    rdfs:comment 'Name or identifier of the individual or team responsible for preparing the covenant compliance report.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyGav rdf:type rdf:Property ;
    rdfs:label 'Property Gav' ;
    rdfs:comment 'Current gross asset value of the property used in the LTV calculation, typically based on the most recent appraisal or valuation.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyNav rdf:type rdf:Property ;
    rdfs:label 'Property Nav' ;
    rdfs:comment 'Net asset value of the property after deducting liabilities, used for alternative covenant calculations.' ;
    rdfs:domain ind:LtvDscrCovenant ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewedBy rdf:type rdf:Property ;
    rdfs:label 'Reviewed By' ;
    rdfs:comment 'Name or identifier of the individual or team that reviewed and approved the covenant compliance report.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waiverGrantedFlag rdf:type rdf:Property ;
    rdfs:label 'Waiver Granted Flag' ;
    rdfs:comment 'Indicates whether a covenant waiver was granted by the lender for this measurement period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reitPositionId rdf:type rdf:Property ;
    rdfs:label 'Reit Position Id' ;
    rdfs:comment 'Unique identifier for the REIT position record within the portfolio management system.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Distribution Amount' ;
    rdfs:comment 'Total cash distributions received from the REIT over the trailing twelve months in position currency.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:averageCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Average Cost Per Unit' ;
    rdfs:comment 'Weighted average acquisition cost per unit in the position currency, calculated across all purchase transactions.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseCurrencyMarketValue rdf:type rdf:Property ;
    rdfs:label 'Base Currency Market Value' ;
    rdfs:comment 'Market value of the position converted to the fund base currency using the current foreign exchange rate for consolidated reporting.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dividendYield rdf:type rdf:Property ;
    rdfs:label 'Dividend Yield' ;
    rdfs:comment 'Annualized dividend income as a percentage of current market price, calculated from trailing twelve-month distributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextDistributionDate rdf:type rdf:Property ;
    rdfs:label 'Next Distribution Date' ;
    rdfs:comment 'Expected date of the next scheduled dividend or distribution payment based on the REIT declared distribution calendar.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:positionCurrency rdf:type rdf:Property ;
    rdfs:label 'Position Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the REIT is denominated and traded on the primary exchange.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reitName rdf:type rdf:Property ;
    rdfs:label 'Reit Name' ;
    rdfs:comment 'Full legal name of the REIT issuer as registered with the exchange or regulatory authority.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reitSector rdf:type rdf:Property ;
    rdfs:label 'Reit Sector' ;
    rdfs:comment 'Primary real estate sector classification of the REIT based on underlying property holdings.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reitType rdf:type rdf:Property ;
    rdfs:label 'Reit Type' ;
    rdfs:comment 'Structural classification indicating whether the REIT primarily holds equity in properties, mortgages, or a hybrid combination.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalCostBasis rdf:type rdf:Property ;
    rdfs:label 'Total Cost Basis' ;
    rdfs:comment 'Aggregate acquisition cost of the entire position in the position currency, including transaction costs if capitalized.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightInPortfolio rdf:type rdf:Property ;
    rdfs:label 'Weight In Portfolio' ;
    rdfs:comment 'Position market value as a percentage of total portfolio net asset value, used for asset allocation and risk monitoring.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weightInRealEstateAllocation rdf:type rdf:Property ;
    rdfs:label 'Weight In Real Estate Allocation' ;
    rdfs:comment 'Position market value as a percentage of the total real estate asset class allocation within the portfolio.' ;
    rdfs:domain ind:ReitPosition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedTerminationDate rdf:type rdf:Property ;
    rdfs:label 'Expected Termination Date' ;
    rdfs:comment 'Projected date on which the real estate fund will terminate and complete all distributions, based on fund term and extension provisions.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:finalFundSize rdf:type rdf:Property ;
    rdfs:label 'Final Fund Size' ;
    rdfs:comment 'Actual total capital commitments raised by the real estate fund at final close, representing the aggregate Limited Partner (LP) commitments.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundManagerName rdf:type rdf:Property ;
    rdfs:label 'Fund Manager Name' ;
    rdfs:comment 'Name of the investment management firm or General Partner (GP) responsible for managing the real estate fund.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gresbParticipationFlag rdf:type rdf:Property ;
    rdfs:label 'Gresb Participation Flag' ;
    rdfs:comment 'Boolean indicator of whether the real estate fund participates in Global Real Estate Sustainability Benchmark (GRESB) reporting and assessment.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pic rdf:type rdf:Property ;
    rdfs:label 'Pic' ;
    rdfs:comment 'Cumulative amount of capital called and paid by the pension fund to the real estate fund to date, representing actual funded capital.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priSignatoryFlag rdf:type rdf:Property ;
    rdfs:label 'Pri Signatory Flag' ;
    rdfs:comment 'Boolean indicator of whether the General Partner (GP) is a signatory to the United Nations Principles for Responsible Investment (PRI).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyTypeFocus rdf:type rdf:Property ;
    rdfs:label 'Property Type Focus' ;
    rdfs:comment 'Primary property type or sector focus of the real estate fund, such as office, retail, industrial, multifamily, hospitality, healthcare, or mixed-use.' ;
    rdfs:domain ind:ReFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reCapitalCallId rdf:type rdf:Property ;
    rdfs:label 'Re Capital Call Id' ;
    rdfs:comment 'Unique identifier for the real estate capital call transaction record.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:acquisitionAmount rdf:type rdf:Property ;
    rdfs:label 'Acquisition Amount' ;
    rdfs:comment 'Portion of the capital call allocated to property acquisition costs.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:callCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Call Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the capital call amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:callNoticeDocumentUri rdf:type rdf:Property ;
    rdfs:label 'Call Notice Document Uri' ;
    rdfs:comment 'Document management system URI or path to the official capital call notice document issued by the General Partner (GP).' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexAmount rdf:type rdf:Property ;
    rdfs:label 'Capex Amount' ;
    rdfs:comment 'Portion of the capital call allocated to capital expenditure programs for post-acquisition value creation.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commitmentPercentageCalled rdf:type rdf:Property ;
    rdfs:label 'Commitment Percentage Called' ;
    rdfs:comment 'Percentage of the total Limited Partnership Agreement (LPA) commitment that will be called after this capital call is funded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePicPostCall rdf:type rdf:Property ;
    rdfs:label 'Cumulative Pic Post Call' ;
    rdfs:comment 'Total Paid-In Capital (PIC) from the Limited Partner (LP) to the fund after this capital call is funded.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativePicPreCall rdf:type rdf:Property ;
    rdfs:label 'Cumulative Pic Pre Call' ;
    rdfs:comment 'Total Paid-In Capital (PIC) from the Limited Partner (LP) to the fund immediately before this capital call.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpBankAccountNumber rdf:type rdf:Property ;
    rdfs:label 'Gp Bank Account Number' ;
    rdfs:comment 'Bank account number of the General Partner (GP) receiving the capital call funds.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpBankBic rdf:type rdf:Property ;
    rdfs:label 'Gp Bank Bic' ;
    rdfs:comment 'Bank Identifier Code (BIC) or SWIFT code for the General Partner (GP) receiving bank.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpBankName rdf:type rdf:Property ;
    rdfs:label 'Gp Bank Name' ;
    rdfs:comment 'Name of the financial institution holding the General Partner (GP) receiving account.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Internal Approval Date' ;
    rdfs:comment 'Date on which internal approval was granted to fund this capital call.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalApproverName rdf:type rdf:Property ;
    rdfs:label 'Internal Approver Name' ;
    rdfs:comment 'Name of the internal pension fund officer who approved funding this capital call.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherAmount rdf:type rdf:Property ;
    rdfs:label 'Other Amount' ;
    rdfs:comment 'Portion of the capital call allocated to purposes not classified in standard categories.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workingCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Working Capital Amount' ;
    rdfs:comment 'Portion of the capital call allocated to property-level working capital requirements.' ;
    rdfs:domain ind:ReCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reDistributionId rdf:type rdf:Property ;
    rdfs:label 'Re Distribution Id' ;
    rdfs:comment 'Unique identifier for the real estate distribution transaction record.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:reFundInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Re Fund Investment Id' ;
    rdfs:comment 'Reference to the underlying real estate fund investment position from which this distribution originated.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:underlyingPropertyId rdf:type rdf:Property ;
    rdfs:label 'Underlying Property Id' ;
    rdfs:comment 'Reference to the specific real estate property asset that generated this distribution, if attributable.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Property .

ind:capitalGainComponent rdf:type rdf:Property ;
    rdfs:label 'Capital Gain Component' ;
    rdfs:comment 'The portion of the distribution classified as capital gains for tax reporting purposes.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterestComponent rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Component' ;
    rdfs:comment 'The portion of the distribution representing carried interest or performance fees paid to the GP.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionAmountBase rdf:type rdf:Property ;
    rdfs:label 'Distribution Amount Base' ;
    rdfs:comment 'The gross distribution amount converted to the pension fund\'s base reporting currency (typically USD).' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Distribution Amount Local' ;
    rdfs:comment 'The gross distribution amount in the fund\'s local reporting currency before any withholding or adjustments.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionDate rdf:type rdf:Property ;
    rdfs:label 'Distribution Date' ;
    rdfs:comment 'The date on which the distribution was paid or is scheduled to be paid by the GP to the LP.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:distributionNotes rdf:type rdf:Property ;
    rdfs:label 'Distribution Notes' ;
    rdfs:comment 'Free-text commentary from the GP or internal investment team regarding the distribution context or special circumstances.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionNoticeNumber rdf:type rdf:Property ;
    rdfs:label 'Distribution Notice Number' ;
    rdfs:comment 'External reference number assigned by the GP on the distribution notice or capital account statement.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionPerUnit rdf:type rdf:Property ;
    rdfs:label 'Distribution Per Unit' ;
    rdfs:comment 'The distribution amount per LP unit or per share of fund ownership.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionSequenceNumber rdf:type rdf:Property ;
    rdfs:label 'Distribution Sequence Number' ;
    rdfs:comment 'Sequential numbering of distributions from this fund investment for tracking and reconciliation purposes.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionSource rdf:type rdf:Property ;
    rdfs:label 'Distribution Source' ;
    rdfs:comment 'The underlying economic event or transaction that generated this distribution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dpiImpact rdf:type rdf:Property ;
    rdfs:label 'Dpi Impact' ;
    rdfs:comment 'The incremental impact of this distribution on the DPI multiple for the fund investment.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hurdleRateMetFlag rdf:type rdf:Property ;
    rdfs:label 'Hurdle Rate Met Flag' ;
    rdfs:comment 'Indicates whether the preferred return hurdle rate threshold has been met, triggering carried interest participation.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:incomeComponent rdf:type rdf:Property ;
    rdfs:label 'Income Component' ;
    rdfs:comment 'The portion of the distribution classified as ordinary income for tax and accounting purposes.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:k1ScheduleReference rdf:type rdf:Property ;
    rdfs:label 'K1 Schedule Reference' ;
    rdfs:comment 'Reference to the IRS Schedule K-1 or equivalent tax document line item associated with this distribution.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:returnOfCapitalComponent rdf:type rdf:Property ;
    rdfs:label 'Return Of Capital Component' ;
    rdfs:comment 'The portion of the distribution representing a return of the LP\'s original invested capital.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxYear rdf:type rdf:Property ;
    rdfs:label 'Tax Year' ;
    rdfs:comment 'The fiscal or calendar year to which this distribution is allocated for tax reporting purposes.' ;
    rdfs:domain ind:ReDistribution ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:waterfallTier rdf:type rdf:Property ;
    rdfs:label 'Waterfall Tier' ;
    rdfs:comment 'The distribution waterfall tier or tranche from which this distribution was paid per the LPA.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyAcquisitionId rdf:type rdf:Property ;
    rdfs:label 'Property Acquisition Id' ;
    rdfs:comment 'Unique identifier for each direct property acquisition transaction executed by the pension fund.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:sellerActorId rdf:type rdf:Property ;
    rdfs:label 'Seller Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Acquisition records need to reference the seller entity for audit and regulatory reporting; linking to actor provides a structured reference.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:acquisitionNotes rdf:type rdf:Property ;
    rdfs:label 'Acquisition Notes' ;
    rdfs:comment 'Free-text field capturing additional context, conditions, or observations about the acquisition.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionStatus rdf:type rdf:Property ;
    rdfs:label 'Acquisition Status' ;
    rdfs:comment 'Current lifecycle status of the acquisition transaction.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionStrategy rdf:type rdf:Property ;
    rdfs:label 'Acquisition Strategy' ;
    rdfs:comment 'Risk-return classification of the acquisition strategy employed.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionStructure rdf:type rdf:Property ;
    rdfs:label 'Acquisition Structure' ;
    rdfs:comment 'Legal structure through which the property was acquired.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:acquisitionYield rdf:type rdf:Property ;
    rdfs:label 'Acquisition Yield' ;
    rdfs:comment 'Initial yield calculated as first-year NOI divided by total acquisition cost, expressed as a percentage.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:advisoryFees rdf:type rdf:Property ;
    rdfs:label 'Advisory Fees' ;
    rdfs:comment 'Investment advisory, brokerage, and consulting fees paid for the acquisition.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestorFlag rdf:type rdf:Property ;
    rdfs:label 'Co Investor Flag' ;
    rdfs:comment 'Indicates whether the acquisition was executed with one or more co-investment partners.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:debtAmount rdf:type rdf:Property ;
    rdfs:label 'Debt Amount' ;
    rdfs:comment 'Portion of the acquisition financed through debt or leverage.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dueDiligenceCosts rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Costs' ;
    rdfs:comment 'Total costs incurred for operational, financial, legal, and ESG due diligence activities.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityAmount rdf:type rdf:Property ;
    rdfs:label 'Equity Amount' ;
    rdfs:comment 'Portion of the acquisition financed through pension fund equity capital.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgRatingAtAcquisition rdf:type rdf:Property ;
    rdfs:label 'Esg Rating At Acquisition' ;
    rdfs:comment 'ESG rating or score assigned to the property at acquisition based on due diligence assessment.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:goingInIrr rdf:type rdf:Property ;
    rdfs:label 'Going In Irr' ;
    rdfs:comment 'Projected internal rate of return at acquisition based on underwriting assumptions.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalFees rdf:type rdf:Property ;
    rdfs:label 'Legal Fees' ;
    rdfs:comment 'Legal advisory and conveyancing fees incurred in the acquisition transaction.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:loiDate rdf:type rdf:Property ;
    rdfs:label 'Loi Date' ;
    rdfs:comment 'Date on which the non-binding Letter of Intent was executed with the seller.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:noiAtAcquisition rdf:type rdf:Property ;
    rdfs:label 'Noi At Acquisition' ;
    rdfs:comment 'Trailing twelve-month Net Operating Income at the time of acquisition.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupancyRateAtAcquisition rdf:type rdf:Property ;
    rdfs:label 'Occupancy Rate At Acquisition' ;
    rdfs:comment 'Physical occupancy rate of the property at the time of acquisition, expressed as a percentage.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherTransactionCosts rdf:type rdf:Property ;
    rdfs:label 'Other Transaction Costs' ;
    rdfs:comment 'Miscellaneous acquisition costs not captured in other specific cost categories.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:portfolioAllocation rdf:type rdf:Property ;
    rdfs:label 'Portfolio Allocation' ;
    rdfs:comment 'Strategic portfolio segment or sleeve to which this acquisition is allocated.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCity rdf:type rdf:Property ;
    rdfs:label 'Property City' ;
    rdfs:comment 'City or metropolitan area where the property is located.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyCountry rdf:type rdf:Property ;
    rdfs:label 'Property Country' ;
    rdfs:comment 'Three-letter ISO country code where the property is located.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertySector rdf:type rdf:Property ;
    rdfs:label 'Property Sector' ;
    rdfs:comment 'Primary real estate sector classification of the acquired property.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:purchasePrice rdf:type rdf:Property ;
    rdfs:label 'Purchase Price' ;
    rdfs:comment 'Total consideration paid for the property acquisition excluding transaction costs.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sellerLei rdf:type rdf:Property ;
    rdfs:label 'Seller Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier of the seller if applicable.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sellerName rdf:type rdf:Property ;
    rdfs:label 'Seller Name' ;
    rdfs:comment 'Legal name of the entity or individual from whom the property was acquired.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spaDate rdf:type rdf:Property ;
    rdfs:label 'Spa Date' ;
    rdfs:comment 'Date on which the binding Share Purchase Agreement or Sale and Purchase Agreement was signed.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:stampDuty rdf:type rdf:Property ;
    rdfs:label 'Stamp Duty' ;
    rdfs:comment 'Government stamp duty or transfer tax paid on the property acquisition.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetHoldPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Target Hold Period Years' ;
    rdfs:comment 'Planned investment horizon in years from acquisition to anticipated disposition.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:totalAcquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Total Acquisition Cost' ;
    rdfs:comment 'Sum of purchase price and all transaction costs representing total capital deployed.' ;
    rdfs:domain ind:PropertyAcquisition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transactionCurrency rdf:type rdf:Property ;
    rdfs:label 'Transaction Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the acquisition was denominated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyDisposalId rdf:type rdf:Property ;
    rdfs:label 'Property Disposal Id' ;
    rdfs:comment 'Unique identifier for each property disposal transaction executed by the pension fund.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:buyerActorId rdf:type rdf:Property ;
    rdfs:label 'Buyer Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Disposal transactions require a buyer entity for financial reconciliation and compliance; linking to actor ensures traceability.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:advisorFirmName rdf:type rdf:Property ;
    rdfs:label 'Advisor Firm Name' ;
    rdfs:comment 'Name of the external advisory firm engaged to support the disposal transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bookValueAtDisposal rdf:type rdf:Property ;
    rdfs:label 'Book Value At Disposal' ;
    rdfs:comment 'Carrying value of the property on the balance sheet at the disposal date per accounting records.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyerLegalName rdf:type rdf:Property ;
    rdfs:label 'Buyer Legal Name' ;
    rdfs:comment 'Full legal name of the acquiring party or buyer entity.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerLei rdf:type rdf:Property ;
    rdfs:label 'Buyer Lei' ;
    rdfs:comment 'Twenty-character ISO 17442 Legal Entity Identifier (LEI) of the buyer.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:buyerType rdf:type rdf:Property ;
    rdfs:label 'Buyer Type' ;
    rdfs:comment 'Classification of the buyer entity by investor type.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalGainsTaxAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Gains Tax Amount' ;
    rdfs:comment 'Estimated or actual capital gains tax liability arising from the disposal transaction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractSigningDate rdf:type rdf:Property ;
    rdfs:label 'Contract Signing Date' ;
    rdfs:comment 'Date when the Share Purchase Agreement (SPA) or sale contract was executed.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalDate rdf:type rdf:Property ;
    rdfs:label 'Disposal Date' ;
    rdfs:comment 'Legal completion date when ownership transferred to the buyer and proceeds were received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:disposalNotes rdf:type rdf:Property ;
    rdfs:label 'Disposal Notes' ;
    rdfs:comment 'Free-text field capturing additional context, special conditions, or commentary on the disposal transaction.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalRationale rdf:type rdf:Property ;
    rdfs:label 'Disposal Rationale' ;
    rdfs:comment 'Strategic business rationale for disposing of the property including portfolio rebalancing, capital recycling, or underperformance.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalStatus rdf:type rdf:Property ;
    rdfs:label 'Disposal Status' ;
    rdfs:comment 'Current lifecycle status of the disposal transaction.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalTransactionNumber rdf:type rdf:Property ;
    rdfs:label 'Disposal Transaction Number' ;
    rdfs:comment 'Externally-known unique transaction reference number for the disposal event.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disposalType rdf:type rdf:Property ;
    rdfs:label 'Disposal Type' ;
    rdfs:comment 'Classification of the disposal transaction structure.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:escrowAccountFlag rdf:type rdf:Property ;
    rdfs:label 'Escrow Account Flag' ;
    rdfs:comment 'Indicates whether an escrow account was used to hold proceeds pending final settlement conditions.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:exitCapRate rdf:type rdf:Property ;
    rdfs:label 'Exit Cap Rate' ;
    rdfs:comment 'Capitalization rate implied by the sale price calculated as Net Operating Income (NOI) divided by gross sale price.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitNoi rdf:type rdf:Property ;
    rdfs:label 'Exit Noi' ;
    rdfs:comment 'Trailing twelve-month Net Operating Income (NOI) at the time of disposal used for exit cap rate calculation.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossSalePrice rdf:type rdf:Property ;
    rdfs:label 'Gross Sale Price' ;
    rdfs:comment 'Total sale price agreed before deducting transaction costs and adjustments.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:holdingPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Holding Period Years' ;
    rdfs:comment 'Total number of years the property was held from acquisition to disposal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:legalCounselFirmName rdf:type rdf:Property ;
    rdfs:label 'Legal Counsel Firm Name' ;
    rdfs:comment 'Name of the law firm providing legal counsel for the disposal transaction.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netProceeds rdf:type rdf:Property ;
    rdfs:label 'Net Proceeds' ;
    rdfs:comment 'Net cash proceeds received after deducting all transaction costs from gross sale price.' ;
    rdfs:domain ind:PropertyDisposal ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:settlementMethod rdf:type rdf:Property ;
    rdfs:label 'Settlement Method' ;
    rdfs:comment 'Method used to settle the disposal transaction and transfer proceeds.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyRecordId rdf:type rdf:Property ;
    rdfs:label 'Occupancy Record Id' ;
    rdfs:comment 'Unique identifier for the occupancy measurement record.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:absorptionRate rdf:type rdf:Property ;
    rdfs:label 'Absorption Rate' ;
    rdfs:comment 'Net change in occupied space during the measurement period, expressed in area units.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaUnit rdf:type rdf:Property ;
    rdfs:label 'Area Unit' ;
    rdfs:comment 'Unit of measure for area calculations (square feet or square meters).' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:averageTenantSize rdf:type rdf:Property ;
    rdfs:label 'Average Tenant Size' ;
    rdfs:comment 'Average GLA per tenant, calculated as total occupied GLA divided by tenant count.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:economicOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Economic Occupancy Rate' ;
    rdfs:comment 'Percentage of potential rental income being collected, accounting for rent concessions and free rent periods.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:largestTenantGla rdf:type rdf:Property ;
    rdfs:label 'Largest Tenant Gla' ;
    rdfs:comment 'GLA occupied by the largest single tenant, used for concentration risk assessment.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaseExpiryExposure12m rdf:type rdf:Property ;
    rdfs:label 'Lease Expiry Exposure 12m' ;
    rdfs:comment 'Total GLA with leases expiring within the next 12 months from measurement date.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leaseExpiryExposure24m rdf:type rdf:Property ;
    rdfs:label 'Lease Expiry Exposure 24m' ;
    rdfs:comment 'Total GLA with leases expiring within the next 24 months from measurement date.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leasingVelocity rdf:type rdf:Property ;
    rdfs:label 'Leasing Velocity' ;
    rdfs:comment 'Total GLA leased during the measurement period, indicating leasing activity momentum.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:marketOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Market Occupancy Rate' ;
    rdfs:comment 'Average occupancy rate for comparable properties in the same submarket as of the measurement date.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:measurementMethod rdf:type rdf:Property ;
    rdfs:label 'Measurement Method' ;
    rdfs:comment 'Method used to determine occupancy: actual (physical inspection), estimated (based on lease data), or prorated (partial period calculation).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementPeriod rdf:type rdf:Property ;
    rdfs:label 'Measurement Period' ;
    rdfs:comment 'The reporting period for this occupancy measurement (e.g., 2024-Q1, 2024-03).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:measurementStatus rdf:type rdf:Property ;
    rdfs:label 'Measurement Status' ;
    rdfs:comment 'Status of the occupancy measurement record in the reporting workflow.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyTrend rdf:type rdf:Property ;
    rdfs:label 'Occupancy Trend' ;
    rdfs:comment 'Directional trend of occupancy over recent measurement periods.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occupancyVariancePct rdf:type rdf:Property ;
    rdfs:label 'Occupancy Variance Pct' ;
    rdfs:comment 'Variance between actual physical occupancy rate and target occupancy rate, expressed as a percentage.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:occupiedGla rdf:type rdf:Property ;
    rdfs:label 'Occupied Gla' ;
    rdfs:comment 'Gross leasable area currently occupied by tenants in square feet or square meters.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:physicalOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Physical Occupancy Rate' ;
    rdfs:comment 'Percentage of total GLA that is physically occupied, calculated as occupied GLA divided by total GLA.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priorPeriodOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Prior Period Occupancy Rate' ;
    rdfs:comment 'Physical occupancy rate from the previous measurement period for trend analysis.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:renewalRate rdf:type rdf:Property ;
    rdfs:label 'Renewal Rate' ;
    rdfs:comment 'Percentage of expiring leases that were renewed during the measurement period.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stabilizedOccupancyFlag rdf:type rdf:Property ;
    rdfs:label 'Stabilized Occupancy Flag' ;
    rdfs:comment 'Indicates whether the property has reached stabilized occupancy levels as defined in the investment underwriting.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:stabilizedOccupancyTarget rdf:type rdf:Property ;
    rdfs:label 'Stabilized Occupancy Target' ;
    rdfs:comment 'Target occupancy rate defined at acquisition or development completion for stabilized operations.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tenantCount rdf:type rdf:Property ;
    rdfs:label 'Tenant Count' ;
    rdfs:comment 'Number of active tenants occupying space as of the measurement date.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:topFiveTenantConcentration rdf:type rdf:Property ;
    rdfs:label 'Top Five Tenant Concentration' ;
    rdfs:comment 'Percentage of total GLA occupied by the five largest tenants.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalGla rdf:type rdf:Property ;
    rdfs:label 'Total Gla' ;
    rdfs:comment 'Total gross leasable area of the property in square feet or square meters.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalUnitCount rdf:type rdf:Property ;
    rdfs:label 'Total Unit Count' ;
    rdfs:comment 'Total number of leasable units or spaces in the property.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:turnoverRate rdf:type rdf:Property ;
    rdfs:label 'Turnover Rate' ;
    rdfs:comment 'Percentage of GLA that experienced tenant turnover during the measurement period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vacancyType rdf:type rdf:Property ;
    rdfs:label 'Vacancy Type' ;
    rdfs:comment 'Classification of vacancy: structural (long-term market condition), transitional (between tenants), development (pre-lease), seasonal, strategic (held for repositioning), or frictional (normal turnover).' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vacantGla rdf:type rdf:Property ;
    rdfs:label 'Vacant Gla' ;
    rdfs:comment 'Gross leasable area currently vacant in square feet or square meters.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vacantUnitCount rdf:type rdf:Property ;
    rdfs:label 'Vacant Unit Count' ;
    rdfs:comment 'Number of leasable units or spaces that are currently vacant.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:verifiedBy rdf:type rdf:Property ;
    rdfs:label 'Verified By' ;
    rdfs:comment 'Name or identifier of the asset manager or analyst who verified the occupancy data.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:weightedAverageLeaseTerm rdf:type rdf:Property ;
    rdfs:label 'Weighted Average Lease Term' ;
    rdfs:comment 'Weighted average remaining lease term across all tenants, weighted by GLA, expressed in years.' ;
    rdfs:domain ind:OccupancyRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:propertyOperatingExpenseId rdf:type rdf:Property ;
    rdfs:label 'Property Operating Expense Id' ;
    rdfs:comment 'Unique identifier for the property operating expense record.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:budgetLineItem rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item' ;
    rdfs:comment 'The budget line item or category against which this operating expense is tracked for variance analysis.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetedAmount rdf:type rdf:Property ;
    rdfs:label 'Budgeted Amount' ;
    rdfs:comment 'The budgeted or forecasted amount for this expense category in the accounting period, used for variance analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalizedFlag rdf:type rdf:Property ;
    rdfs:label 'Capitalized Flag' ;
    rdfs:comment 'Indicates whether this expense qualifies for capitalization as a capital expenditure rather than an operating expense under accounting standards.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:propertyOperatingExpenseDescription rdf:type rdf:Property ;
    rdfs:label 'Property Operating Expense Description' ;
    rdfs:comment 'Detailed narrative description of the operating expense, including the nature of the goods or services provided.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseAmount rdf:type rdf:Property ;
    rdfs:label 'Expense Amount' ;
    rdfs:comment 'The gross amount of the operating expense before any adjustments, discounts, or recoveries.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenseCategory rdf:type rdf:Property ;
    rdfs:label 'Expense Category' ;
    rdfs:comment 'Classification of the operating expense type: property tax, insurance, utilities, maintenance, cleaning, security, management fee, or leasing commission. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseCurrency rdf:type rdf:Property ;
    rdfs:label 'Expense Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the operating expense was incurred.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expenseDate rdf:type rdf:Property ;
    rdfs:label 'Expense Date' ;
    rdfs:comment 'The date on which the operating expense was incurred or recognized for accounting purposes.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:expenseSubcategory rdf:type rdf:Property ;
    rdfs:label 'Expense Subcategory' ;
    rdfs:comment 'Detailed subcategory within the primary expense category for granular expense tracking and analysis.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Net Expense Amount' ;
    rdfs:comment 'The net operating expense after deducting any recoverable amounts from tenants, representing the true cost to the property owner.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoverableAmount rdf:type rdf:Property ;
    rdfs:label 'Recoverable Amount' ;
    rdfs:comment 'The portion of the operating expense that is recoverable from tenants, reducing the net expense impact on NOI.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoverableFlag rdf:type rdf:Property ;
    rdfs:label 'Recoverable Flag' ;
    rdfs:comment 'Indicates whether this operating expense is recoverable from tenants through lease agreements or operating expense pass-throughs.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vatAmount rdf:type rdf:Property ;
    rdfs:label 'Vat Amount' ;
    rdfs:comment 'The value-added tax or goods and services tax component included in the operating expense amount.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:vatRate rdf:type rdf:Property ;
    rdfs:label 'Vat Rate' ;
    rdfs:comment 'The VAT or GST rate percentage applied to this operating expense.' ;
    rdfs:domain ind:PropertyOperatingExpense ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jvStructureId rdf:type rdf:Property ;
    rdfs:label 'Jv Structure Id' ;
    rdfs:comment 'Unique identifier for the joint venture structure record.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:accountingMethod rdf:type rdf:Property ;
    rdfs:label 'Accounting Method' ;
    rdfs:comment 'Accounting treatment applied to the joint venture investment: equity method, proportionate consolidation, cost method, or full consolidation.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:controlClassification rdf:type rdf:Property ;
    rdfs:label 'Control Classification' ;
    rdfs:comment 'Classification of the pension fund\'s level of control or influence over the joint venture: controlled (consolidate), joint control (equity method), significant influence (equity method), or no control.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionWaterfallType rdf:type rdf:Property ;
    rdfs:label 'Distribution Waterfall Type' ;
    rdfs:comment 'Type of distribution waterfall structure governing profit distributions: European (whole-fund), American (deal-by-deal), or hybrid.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:formationDate rdf:type rdf:Property ;
    rdfs:label 'Formation Date' ;
    rdfs:comment 'Date when the joint venture entity was legally formed or incorporated.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gpName rdf:type rdf:Property ;
    rdfs:label 'Gp Name' ;
    rdfs:comment 'Name of the General Partner managing the joint venture, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpOwnershipPct rdf:type rdf:Property ;
    rdfs:label 'Gp Ownership Pct' ;
    rdfs:comment 'Percentage ownership stake held by the General Partner in the joint venture entity.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:jurisdiction rdf:type rdf:Property ;
    rdfs:label 'Jurisdiction' ;
    rdfs:comment 'Legal jurisdiction or country where the joint venture entity is registered and governed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jvArrangementType rdf:type rdf:Property ;
    rdfs:label 'Jv Arrangement Type' ;
    rdfs:comment 'Classification of the joint arrangement: joint operation (rights to assets and obligations for liabilities), joint venture (rights to net assets), or co-investment.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jvEntityCode rdf:type rdf:Property ;
    rdfs:label 'Jv Entity Code' ;
    rdfs:comment 'Internal code or identifier for the joint venture entity.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jvEntityName rdf:type rdf:Property ;
    rdfs:label 'Jv Entity Name' ;
    rdfs:comment 'Legal name of the joint venture entity or partnership vehicle.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:jvStatus rdf:type rdf:Property ;
    rdfs:label 'Jv Status' ;
    rdfs:comment 'Current lifecycle status of the joint venture arrangement.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAuditDate rdf:type rdf:Property ;
    rdfs:label 'Last Audit Date' ;
    rdfs:comment 'Date of the most recent external audit of the joint venture.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:legalStructureType rdf:type rdf:Property ;
    rdfs:label 'Legal Structure Type' ;
    rdfs:comment 'Legal form of the joint venture entity (Limited Partnership, Limited Liability Company, Trust, Real Estate Investment Trust, Corporation, Partnership).' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lpaReference rdf:type rdf:Property ;
    rdfs:label 'Lpa Reference' ;
    rdfs:comment 'Reference identifier or document number for the Limited Partnership Agreement governing the joint venture.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:pensionFundCapitalCommitment rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Capital Commitment' ;
    rdfs:comment 'Total capital commitment amount by the pension fund to the joint venture.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionFundOwnershipPct rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Ownership Pct' ;
    rdfs:comment 'Percentage ownership stake held by the pension fund in the joint venture entity.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionFundPaidInCapital rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Paid In Capital' ;
    rdfs:comment 'Actual capital contributed by the pension fund to date (Paid-In Capital).' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryCoInvestorName rdf:type rdf:Property ;
    rdfs:label 'Primary Co Investor Name' ;
    rdfs:comment 'Name of the primary co-investor or partner in the joint venture.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryCoInvestorOwnershipPct rdf:type rdf:Property ;
    rdfs:label 'Primary Co Investor Ownership Pct' ;
    rdfs:comment 'Percentage ownership stake held by the primary co-investor in the joint venture entity.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryCoInvestorType rdf:type rdf:Property ;
    rdfs:label 'Primary Co Investor Type' ;
    rdfs:comment 'Classification of the primary co-investor by investor type.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetIrrPct rdf:type rdf:Property ;
    rdfs:label 'Target Irr Pct' ;
    rdfs:comment 'Target Internal Rate of Return for the joint venture investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalCoInvestorsCount rdf:type rdf:Property ;
    rdfs:label 'Total Co Investors Count' ;
    rdfs:comment 'Total number of co-investors or partners in the joint venture structure.' ;
    rdfs:domain ind:JvStructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyInsuranceId rdf:type rdf:Property ;
    rdfs:label 'Property Insurance Id' ;
    rdfs:comment 'Unique identifier for the property insurance policy record.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:additionalInsuredParties rdf:type rdf:Property ;
    rdfs:label 'Additional Insured Parties' ;
    rdfs:comment 'Other parties named on the policy who are entitled to coverage benefits, such as property managers or co-investors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:aggregateLimit rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit' ;
    rdfs:comment 'Maximum total amount the insurer will pay for all covered losses during the policy period, capping total exposure.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualPremium rdf:type rdf:Property ;
    rdfs:label 'Annual Premium' ;
    rdfs:comment 'Total annual cost paid to the insurer for maintaining coverage, used for budgeting and expense allocation.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:brokerName rdf:type rdf:Property ;
    rdfs:label 'Broker Name' ;
    rdfs:comment 'Name of the insurance broker or intermediary who arranged the policy on behalf of the pension fund.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cancellationNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Cancellation Notice Days' ;
    rdfs:comment 'Number of days advance notice required by either party to cancel the policy per contractual terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:certificateOfInsuranceReference rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Insurance Reference' ;
    rdfs:comment 'Reference to the certificate of insurance document provided as proof of coverage to third parties.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsHistorySummary rdf:type rdf:Property ;
    rdfs:label 'Claims History Summary' ;
    rdfs:comment 'Summary of prior insurance claims filed against this property impacting underwriting and premium pricing.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsMadeBasisFlag rdf:type rdf:Property ;
    rdfs:label 'Claims Made Basis Flag' ;
    rdfs:comment 'Indicates whether the policy covers claims made during the policy period versus occurrence-based coverage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coinsurancePercentage rdf:type rdf:Property ;
    rdfs:label 'Coinsurance Percentage' ;
    rdfs:comment 'Percentage of loss shared between the insured and insurer after deductible, typically expressed as a ratio.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageDescription rdf:type rdf:Property ;
    rdfs:label 'Coverage Description' ;
    rdfs:comment 'Detailed narrative describing the specific risks covered, exclusions, and special conditions of the insurance policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageLimit rdf:type rdf:Property ;
    rdfs:label 'Coverage Limit' ;
    rdfs:comment 'Maximum amount the insurer will pay for a covered loss under this policy, defining the upper bound of risk transfer.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coverageType rdf:type rdf:Property ;
    rdfs:label 'Coverage Type' ;
    rdfs:comment 'Primary category of insurance coverage provided by this policy for risk classification and portfolio management. [ENUM-REF-CANDIDATE: property_damage|liability|business_interruption|environmental|flood|earthquake|terrorism — 7 candidates stripped; promote' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleAmount rdf:type rdf:Property ;
    rdfs:label 'Deductible Amount' ;
    rdfs:comment 'Amount the pension fund must pay out-of-pocket before insurance coverage applies, impacting net risk exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:endorsements rdf:type rdf:Property ;
    rdfs:label 'Endorsements' ;
    rdfs:comment 'Amendments or riders attached to the base policy that modify coverage terms, limits, or conditions.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusions rdf:type rdf:Property ;
    rdfs:label 'Exclusions' ;
    rdfs:comment 'Specific perils, conditions, or circumstances explicitly excluded from coverage under this insurance policy.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuredValue rdf:type rdf:Property ;
    rdfs:label 'Insured Value' ;
    rdfs:comment 'Maximum amount of coverage provided by the policy representing the replacement cost or agreed value of the property asset.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insurerLei rdf:type rdf:Property ;
    rdfs:label 'Insurer Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the insurance carrier enabling global counterparty identification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insurerName rdf:type rdf:Property ;
    rdfs:label 'Insurer Name' ;
    rdfs:comment 'Legal name of the insurance company providing coverage for the property asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Last Inspection Date' ;
    rdfs:comment 'Date of the most recent property inspection conducted by the insurer for underwriting or renewal purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lossPayee rdf:type rdf:Property ;
    rdfs:label 'Loss Payee' ;
    rdfs:comment 'Entity designated to receive insurance proceeds in the event of a covered loss, often a lender or mortgagee.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Loss Ratio Percent' ;
    rdfs:comment 'Ratio of claims paid to premiums collected expressed as a percentage, indicating policy profitability for the insurer.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInspectionDueDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Due Date' ;
    rdfs:comment 'Scheduled date for the next required property inspection to maintain coverage compliance.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:perOccurrenceLimit rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit' ;
    rdfs:comment 'Maximum amount the insurer will pay for a single covered loss event, defining per-incident exposure.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyNumber rdf:type rdf:Property ;
    rdfs:label 'Policy Number' ;
    rdfs:comment 'Unique policy number assigned by the insurance carrier for identification and claims processing.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyStatus rdf:type rdf:Property ;
    rdfs:label 'Policy Status' ;
    rdfs:comment 'Current state of the insurance policy in its lifecycle for risk monitoring and compliance tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTermMonths rdf:type rdf:Property ;
    rdfs:label 'Policy Term Months' ;
    rdfs:comment 'Duration of the insurance policy coverage period in months, typically 12 for annual policies.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:premiumCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Premium Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code for the premium and insured value amounts enabling multi-currency portfolio management.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalDate rdf:type rdf:Property ;
    rdfs:label 'Renewal Date' ;
    rdfs:comment 'Scheduled date for policy renewal negotiation and premium renegotiation with the insurer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:retroactiveDate rdf:type rdf:Property ;
    rdfs:label 'Retroactive Date' ;
    rdfs:comment 'Earliest date for which claims will be covered under a claims-made policy, defining the lookback period.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:riskAssessmentRating rdf:type rdf:Property ;
    rdfs:label 'Risk Assessment Rating' ;
    rdfs:comment 'Insurers evaluation of the property risk profile used for underwriting and premium calculation.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalClaimsPaidToDate rdf:type rdf:Property ;
    rdfs:label 'Total Claims Paid To Date' ;
    rdfs:comment 'Cumulative amount paid by the insurer for all claims under this policy since inception for loss ratio analysis.' ;
    rdfs:domain ind:PropertyInsurance ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underwriterName rdf:type rdf:Property ;
    rdfs:label 'Underwriter Name' ;
    rdfs:comment 'Name of the underwriting professional or team at the insurer who assessed and approved the policy.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waitingPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Waiting Period Days' ;
    rdfs:comment 'Number of days after a loss event before business interruption coverage begins paying benefits.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:esgPropertyAssessmentId rdf:type rdf:Property ;
    rdfs:label 'Esg Property Assessment Id' ;
    rdfs:comment 'Unique identifier for the ESG property assessment record.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assessmentDate rdf:type rdf:Property ;
    rdfs:label 'Assessment Date' ;
    rdfs:comment 'Date when the ESG assessment was conducted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assessmentMethodology rdf:type rdf:Property ;
    rdfs:label 'Assessment Methodology' ;
    rdfs:comment 'Description of the methodology or framework used to conduct the ESG assessment (e.g., GRESB, proprietary framework).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentStatus rdf:type rdf:Property ;
    rdfs:label 'Assessment Status' ;
    rdfs:comment 'Current status of the ESG assessment in its lifecycle.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessmentType rdf:type rdf:Property ;
    rdfs:label 'Assessment Type' ;
    rdfs:comment 'Type of ESG assessment conducted for the property.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Assessor Contact Email' ;
    rdfs:comment 'Email address of the primary assessor contact.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorContactName rdf:type rdf:Property ;
    rdfs:label 'Assessor Contact Name' ;
    rdfs:comment 'Primary contact person at the assessor firm responsible for this assessment.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assessorFirmName rdf:type rdf:Property ;
    rdfs:label 'Assessor Firm Name' ;
    rdfs:comment 'Name of the third-party firm or internal team that conducted the ESG assessment.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationDate rdf:type rdf:Property ;
    rdfs:label 'Certification Date' ;
    rdfs:comment 'Date when the environmental certification was awarded.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Certification Expiry Date' ;
    rdfs:comment 'Date when the environmental certification expires and requires renewal.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationLevel rdf:type rdf:Property ;
    rdfs:label 'Certification Level' ;
    rdfs:comment 'Level or rating achieved within the certification scheme (e.g., Platinum, Gold, Silver, Bronze, or numeric rating).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificationReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Certification Reference Number' ;
    rdfs:comment 'Unique reference or registration number assigned by the certifying body.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:climateRiskAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Climate Risk Assessment Flag' ;
    rdfs:comment 'Indicates whether a formal climate risk assessment (physical and transition risks) has been conducted for the property.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyConsumptionKwh rdf:type rdf:Property ;
    rdfs:label 'Energy Consumption Kwh' ;
    rdfs:comment 'Total energy consumed by the property during the reporting period, measured in kilowatt-hours.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:energyIntensityKwhPerSqm rdf:type rdf:Property ;
    rdfs:label 'Energy Intensity Kwh Per Sqm' ;
    rdfs:comment 'Energy consumption normalized by gross leasable area, expressed as kWh per square meter.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalCertificationType rdf:type rdf:Property ;
    rdfs:label 'Environmental Certification Type' ;
    rdfs:comment 'Type of green building certification held by the property. [ENUM-REF-CANDIDATE: LEED|BREEAM|NABERS|ENERGY_STAR|WELL|GREEN_STAR|DGNB|HQE|none — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgRiskRating rdf:type rdf:Property ;
    rdfs:label 'Esg Risk Rating' ;
    rdfs:comment 'Overall ESG risk rating assigned to the property based on assessment findings.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgEmissionsIntensityKgCo2ePerSqm rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Intensity Kg Co2e Per Sqm' ;
    rdfs:comment 'GHG emissions normalized by gross leasable area, expressed as kg CO2e per square meter.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgScope1EmissionsTonnesCo2e rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope 1 Emissions Tonnes Co2e' ;
    rdfs:comment 'Direct GHG emissions from sources owned or controlled by the property (e.g., on-site fuel combustion, refrigerants).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgScope2EmissionsTonnesCo2e rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope 2 Emissions Tonnes Co2e' ;
    rdfs:comment 'Indirect GHG emissions from purchased electricity, steam, heating, and cooling consumed by the property.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ghgScope3EmissionsTonnesCo2e rdf:type rdf:Property ;
    rdfs:label 'Ghg Scope 3 Emissions Tonnes Co2e' ;
    rdfs:comment 'Other indirect GHG emissions from value chain activities (e.g., tenant activities, waste disposal, business travel).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:greenLeaseClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Green Lease Clause Flag' ;
    rdfs:comment 'Indicates whether the property has green lease clauses in tenant agreements that promote sustainability practices.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:greenLeaseCoveragePercentage rdf:type rdf:Property ;
    rdfs:label 'Green Lease Coverage Percentage' ;
    rdfs:comment 'Percentage of gross leasable area covered by leases with green lease clauses.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:healthSafetyIncidentsCount rdf:type rdf:Property ;
    rdfs:label 'Health Safety Incidents Count' ;
    rdfs:comment 'Number of health and safety incidents reported at the property during the reporting period.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:physicalClimateRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Physical Climate Risk Level' ;
    rdfs:comment 'Assessment of physical climate risks (flooding, extreme weather, sea level rise) facing the property.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableEnergyPercentage rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Percentage' ;
    rdfs:comment 'Percentage of total energy consumption sourced from renewable energy (solar, wind, hydro, etc.).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialImpactAssessmentFlag rdf:type rdf:Property ;
    rdfs:label 'Social Impact Assessment Flag' ;
    rdfs:comment 'Indicates whether a social impact assessment (community engagement, tenant wellbeing, accessibility) has been conducted.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tenantSatisfactionScore rdf:type rdf:Property ;
    rdfs:label 'Tenant Satisfaction Score' ;
    rdfs:comment 'Tenant satisfaction score from surveys, typically on a 0-100 scale, reflecting social performance.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:thirdPartyVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Verification Flag' ;
    rdfs:comment 'Indicates whether the ESG assessment data has been verified by an independent third party.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalGhgEmissionsTonnesCo2e rdf:type rdf:Property ;
    rdfs:label 'Total Ghg Emissions Tonnes Co2e' ;
    rdfs:comment 'Total GHG emissions across all scopes (Scope 1 + Scope 2 + Scope 3).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:transitionClimateRiskLevel rdf:type rdf:Property ;
    rdfs:label 'Transition Climate Risk Level' ;
    rdfs:comment 'Assessment of transition climate risks (policy changes, carbon pricing, market shifts) affecting the property.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:verificationFirmName rdf:type rdf:Property ;
    rdfs:label 'Verification Firm Name' ;
    rdfs:comment 'Name of the third-party firm that verified the ESG assessment data.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wasteDiversionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Waste Diversion Rate Percentage' ;
    rdfs:comment 'Percentage of total waste diverted from landfill (waste diverted / waste generated * 100).' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wasteDivertedTonnes rdf:type rdf:Property ;
    rdfs:label 'Waste Diverted Tonnes' ;
    rdfs:comment 'Total waste diverted from landfill through recycling, composting, or reuse, measured in tonnes.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:wasteGeneratedTonnes rdf:type rdf:Property ;
    rdfs:label 'Waste Generated Tonnes' ;
    rdfs:comment 'Total waste generated by the property during the reporting period, measured in tonnes.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterConsumptionCubicMeters rdf:type rdf:Property ;
    rdfs:label 'Water Consumption Cubic Meters' ;
    rdfs:comment 'Total water consumed by the property during the reporting period, measured in cubic meters.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:waterIntensityCubicMetersPerSqm rdf:type rdf:Property ;
    rdfs:label 'Water Intensity Cubic Meters Per Sqm' ;
    rdfs:comment 'Water consumption normalized by gross leasable area, expressed as cubic meters per square meter.' ;
    rdfs:domain ind:EsgPropertyAssessment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetBusinessPlanId rdf:type rdf:Property ;
    rdfs:label 'Asset Business Plan Id' ;
    rdfs:comment 'Unique identifier for the asset business plan record.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capexBudget rdf:type rdf:Property ;
    rdfs:label 'Capex Budget' ;
    rdfs:comment 'Total capital expenditure budget allocated for the property during the plan year for value creation and asset improvement initiatives.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexCurrency rdf:type rdf:Property ;
    rdfs:label 'Capex Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the CAPEX budget amount.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexProgramDescription rdf:type rdf:Property ;
    rdfs:label 'Capex Program Description' ;
    rdfs:comment 'Detailed narrative of planned capital improvement projects and programs for the plan year, including scope, objectives, and expected value creation.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionConsiderationFlag rdf:type rdf:Property ;
    rdfs:label 'Disposition Consideration Flag' ;
    rdfs:comment 'Indicates whether the property is under consideration for potential disposition or sale during or following the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:energyEfficiencyTarget rdf:type rdf:Property ;
    rdfs:label 'Energy Efficiency Target' ;
    rdfs:comment 'Target percentage improvement in energy efficiency for the property during the plan year, measured in kilowatt-hours per square foot or similar metric.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgInitiatives rdf:type rdf:Property ;
    rdfs:label 'Esg Initiatives' ;
    rdfs:comment 'Description of planned ESG initiatives for the property during the plan year, including energy efficiency upgrades, sustainability certifications, and responsible investment stewardship activities.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ghgReductionTarget rdf:type rdf:Property ;
    rdfs:label 'Ghg Reduction Target' ;
    rdfs:comment 'Target percentage reduction in greenhouse gas emissions for the property during the plan year, aligned with ESG and climate commitments.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icMeetingReference rdf:type rdf:Property ;
    rdfs:label 'Ic Meeting Reference' ;
    rdfs:comment 'Reference identifier for the IC meeting at which this business plan was reviewed and approved.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leaseExpirySqft rdf:type rdf:Property ;
    rdfs:label 'Lease Expiry Sqft' ;
    rdfs:comment 'Total square footage of leases expiring during the plan year, representing rollover risk and re-leasing opportunity.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:leasingStrategy rdf:type rdf:Property ;
    rdfs:label 'Leasing Strategy' ;
    rdfs:comment 'Narrative description of the leasing strategy for the plan year, including target tenant profiles, rental rate objectives, lease term preferences, and tenant retention initiatives.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:majorCapexProjects rdf:type rdf:Property ;
    rdfs:label 'Major Capex Projects' ;
    rdfs:comment 'List or description of major capital projects planned for execution during the plan year, such as renovations, system upgrades, or repositioning initiatives.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:marketOutlook rdf:type rdf:Property ;
    rdfs:label 'Market Outlook' ;
    rdfs:comment 'Assessment of the local real estate market conditions and outlook for the plan year, including supply-demand dynamics, rental rate trends, and competitive positioning.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newLeasingTargetSqft rdf:type rdf:Property ;
    rdfs:label 'New Leasing Target Sqft' ;
    rdfs:comment 'Target square footage of new leasing activity planned for vacant or expiring space during the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingExpenseBudget rdf:type rdf:Property ;
    rdfs:label 'Operating Expense Budget' ;
    rdfs:comment 'Total operating expense budget for the property during the plan year, covering property management, maintenance, utilities, taxes, and insurance.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:planApprovedBy rdf:type rdf:Property ;
    rdfs:label 'Plan Approved By' ;
    rdfs:comment 'Name or identifier of the Investment Committee member or executive who formally approved this asset business plan.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planEffectiveDate rdf:type rdf:Property ;
    rdfs:label 'Plan Effective Date' ;
    rdfs:comment 'Date from which this asset business plan becomes operationally effective and guides asset management activities.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Plan Expiry Date' ;
    rdfs:comment 'Date when this asset business plan expires and is superseded by the next annual plan.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:planNotes rdf:type rdf:Property ;
    rdfs:label 'Plan Notes' ;
    rdfs:comment 'Additional notes, comments, or context regarding the asset business plan, including assumptions, dependencies, or special considerations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planPreparedBy rdf:type rdf:Property ;
    rdfs:label 'Plan Prepared By' ;
    rdfs:comment 'Name or identifier of the individual or team who prepared this asset business plan.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planVersion rdf:type rdf:Property ;
    rdfs:label 'Plan Version' ;
    rdfs:comment 'Version number of the business plan, allowing for revisions and updates throughout the year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:planYear rdf:type rdf:Property ;
    rdfs:label 'Plan Year' ;
    rdfs:comment 'Calendar year for which this asset business plan is prepared and approved.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:propertyManagerName rdf:type rdf:Property ;
    rdfs:label 'Property Manager Name' ;
    rdfs:comment 'Name of the external property management firm or internal team responsible for day-to-day property operations during the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewalTargetRate rdf:type rdf:Property ;
    rdfs:label 'Renewal Target Rate' ;
    rdfs:comment 'Target percentage of expiring leases planned to be renewed with existing tenants during the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:riskFactors rdf:type rdf:Property ;
    rdfs:label 'Risk Factors' ;
    rdfs:comment 'Identified risk factors and mitigation strategies for the property during the plan year, including market risks, tenant concentration, lease rollover, and operational risks.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAverageRentPsf rdf:type rdf:Property ;
    rdfs:label 'Target Average Rent Psf' ;
    rdfs:comment 'Planned average rental rate per square foot for the property, reflecting market positioning and leasing strategy.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetExitDate rdf:type rdf:Property ;
    rdfs:label 'Target Exit Date' ;
    rdfs:comment 'Planned or target date for disposition of the property if disposition is under consideration.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:targetGav rdf:type rdf:Property ;
    rdfs:label 'Target Gav' ;
    rdfs:comment 'Planned Gross Asset Value for the property at the end of the plan year, reflecting expected value appreciation from asset management activities.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetNav rdf:type rdf:Property ;
    rdfs:label 'Target Nav' ;
    rdfs:comment 'Planned Net Asset Value for the property at the end of the plan year, net of outstanding debt and liabilities.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetNoi rdf:type rdf:Property ;
    rdfs:label 'Target Noi' ;
    rdfs:comment 'Planned Net Operating Income target for the property during the plan year, representing the strategic income objective.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetNoiCurrency rdf:type rdf:Property ;
    rdfs:label 'Target Noi Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the target NOI amount.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetOccupancyRate rdf:type rdf:Property ;
    rdfs:label 'Target Occupancy Rate' ;
    rdfs:comment 'Planned occupancy rate percentage for the property during the plan year, reflecting leasing strategy goals.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetTenantProfile rdf:type rdf:Property ;
    rdfs:label 'Target Tenant Profile' ;
    rdfs:comment 'Description of the ideal tenant characteristics and industry sectors targeted for new leasing activity during the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tenantIncentiveBudget rdf:type rdf:Property ;
    rdfs:label 'Tenant Incentive Budget' ;
    rdfs:comment 'Budgeted amount allocated for tenant incentives including free rent periods, tenant improvement allowances, and leasing commissions.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valueCreationStrategy rdf:type rdf:Property ;
    rdfs:label 'Value Creation Strategy' ;
    rdfs:comment 'Strategic narrative describing post-acquisition active asset management initiatives planned to unlock operational efficiency and sustainable value during the plan year.' ;
    rdfs:domain ind:AssetBusinessPlan ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:propertyAllocationId rdf:type rdf:Property ;
    rdfs:label 'Property Allocation Id' ;
    rdfs:comment 'Unique identifier for the property allocation record' ;
    rdfs:domain ind:PropertyAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allocationStrategy rdf:type rdf:Property ;
    rdfs:label 'Allocation Strategy' ;
    rdfs:comment 'The investment strategy classification for this allocation, indicating whether it aligns with Strategic Asset Allocation (SAA), Tactical Asset Allocation (TAA), or other investment mandates' ;
    rdfs:domain ind:PropertyAllocation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Project Investment Id' ;
    rdfs:comment 'Reference to the capital project associated with this budget line item if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ProjectInvestment .

ind:budgetPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period End Date' ;
    rdfs:comment 'End date of the fiscal period covered by this budget line item.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Budget Period Start Date' ;
    rdfs:comment 'Start date of the fiscal period covered by this budget line item.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:budgetLineItemCategory rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item Category' ;
    rdfs:comment 'High-level classification of the budget line item for financial reporting and analysis purposes.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetLineItemDescription rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item Description' ;
    rdfs:comment 'Detailed narrative description of the budget line item purpose and scope.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastAmount rdf:type rdf:Property ;
    rdfs:label 'Forecast Amount' ;
    rdfs:comment 'Latest forecast amount for this line item based on current projections and trends.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCapitalExpenditure rdf:type rdf:Property ;
    rdfs:label 'Is Capital Expenditure' ;
    rdfs:comment 'Indicates whether this line item represents a capital expenditure requiring capitalization.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecoverable rdf:type rdf:Property ;
    rdfs:label 'Is Recoverable' ;
    rdfs:comment 'Indicates whether this expense is recoverable from tenants under lease agreements.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRecurring rdf:type rdf:Property ;
    rdfs:label 'Is Recurring' ;
    rdfs:comment 'Indicates whether this budget line item represents a recurring expense or one-time cost.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:justification rdf:type rdf:Property ;
    rdfs:label 'Justification' ;
    rdfs:comment 'Business justification narrative supporting the budget request for approval purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineItemCode rdf:type rdf:Property ;
    rdfs:label 'Line Item Code' ;
    rdfs:comment 'Standardized alphanumeric code identifying the budget line item category per institutional accounting standards.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lineNumber rdf:type rdf:Property ;
    rdfs:label 'Line Number' ;
    rdfs:comment 'Sequential ordering number of this line item within the parent budget document.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priorityLevel rdf:type rdf:Property ;
    rdfs:label 'Priority Level' ;
    rdfs:comment 'Priority classification for capital allocation and expenditure sequencing decisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoveryPercentage rdf:type rdf:Property ;
    rdfs:label 'Recovery Percentage' ;
    rdfs:comment 'Percentage of the expense amount that can be recovered from tenants.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recurrenceFrequency rdf:type rdf:Property ;
    rdfs:label 'Recurrence Frequency' ;
    rdfs:comment 'Frequency of recurring expenses for cash flow planning and forecasting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisedAmount rdf:type rdf:Property ;
    rdfs:label 'Revised Amount' ;
    rdfs:comment 'Current revised budget amount after any approved amendments or reforecasts.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:budgetLineItemStatus rdf:type rdf:Property ;
    rdfs:label 'Budget Line Item Status' ;
    rdfs:comment 'Current lifecycle status of the budget line item in the approval workflow.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subcategory rdf:type rdf:Property ;
    rdfs:label 'Subcategory' ;
    rdfs:comment 'Detailed classification within the primary category for granular expense and revenue tracking.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:unitCost rdf:type rdf:Property ;
    rdfs:label 'Unit Cost' ;
    rdfs:comment 'Cost per unit for quantity-based budget calculations and analysis.' ;
    rdfs:domain ind:BudgetLineItem ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Variance Explanation' ;
    rdfs:comment 'Explanation of significant variances between budgeted and actual amounts.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:covenantMonitoringId rdf:type rdf:Property ;
    rdfs:label 'Covenant Monitoring Id' ;
    rdfs:comment 'Foreign key linking to credit.covenant_monitoring. Business justification: Tracking covenants for each asset\'s debt instrument in the pension fund\'s covenant monitoring process.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CovenantMonitoring .

ind:fixedIncomeSecurityId rdf:type rdf:Property ;
    rdfs:label 'Fixed Income Security Id' ;
    rdfs:comment 'Foreign key linking to credit.fixed_income_security. Business justification: Mapping each infrastructure asset to its dedicated bond for cash flow and risk reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:FixedIncomeSecurity .

ind:infrastructureSectorClassificationId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Sector Classification Id' ;
    rdfs:comment 'Foreign key linking to infrastructure.infrastructure_sector_classification. Business justification: Infra_asset has a sector classification that is captured in infrastructure_sector_classification.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:InfrastructureSectorClassification .

ind:privateCreditInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Private Credit Investment Id' ;
    rdfs:comment 'Foreign key linking to credit.private_credit_investment. Business justification: Linking infrastructure asset to the private credit investment that finances it for performance attribution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PrivateCreditInvestment .

ind:regulatoryCalendarId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Calendar Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_calendar. Business justification: Asset-level regulatory calendar for compliance deadlines.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryCalendar .

ind:regulatoryFilingId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Id' ;
    rdfs:comment 'Foreign key linking to compliance.regulatory_filing. Business justification: Asset-level regulatory filing for compliance reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatoryFiling .

ind:resourceAssetId rdf:type rdf:Property ;
    rdfs:label 'Resource Asset Id' ;
    rdfs:comment 'Foreign key linking to naturalresource.resource_asset. Business justification: Infrastructure assets that are natural resource extraction facilities need to reference the underlying resource asset for reserve, ESG, and regulatory reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceAsset .

ind:acquisitionCost rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost' ;
    rdfs:comment 'Total capital deployed at acquisition including purchase price, transaction costs, and initial capital commitments in base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:address rdf:type rdf:Property ;
    rdfs:label 'Address' ;
    rdfs:comment 'Full physical address of the infrastructure asset including street, postal code, and administrative subdivisions.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedReturnRate rdf:type rdf:Property ;
    rdfs:label 'Allowed Return Rate' ;
    rdfs:comment 'Regulated rate of return on capital permitted by the regulatory authority, expressed as an annual percentage.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualRevenue rdf:type rdf:Property ;
    rdfs:label 'Annual Revenue' ;
    rdfs:comment 'Total annual revenue generated by the infrastructure asset from operations, tariffs, tolls, or service fees.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetCode rdf:type rdf:Property ;
    rdfs:label 'Asset Code' ;
    rdfs:comment 'Internal unique alphanumeric code assigned to the infrastructure asset for portfolio tracking and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetManagerName rdf:type rdf:Property ;
    rdfs:label 'Asset Manager Name' ;
    rdfs:comment 'Name of the investment manager or asset management firm overseeing the infrastructure investment on behalf of the pension fund.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capacityUnit rdf:type rdf:Property ;
    rdfs:label 'Capacity Unit' ;
    rdfs:comment 'Unit of measure for operational capacity such as passengers per year, megawatts, cubic meters per day, or vehicles per day.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonEmissionsAnnual rdf:type rdf:Property ;
    rdfs:label 'Carbon Emissions Annual' ;
    rdfs:comment 'Total annual greenhouse gas emissions attributable to the infrastructure asset operations, measured in metric tons of CO2 equivalent.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concessionAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Concession Agreement Flag' ;
    rdfs:comment 'Indicates whether the infrastructure asset operates under a government or public authority concession agreement.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:concessionEndDate rdf:type rdf:Property ;
    rdfs:label 'Concession End Date' ;
    rdfs:comment 'Expiration or termination date of the concession agreement after which operational rights revert to the grantor.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concessionStartDate rdf:type rdf:Property ;
    rdfs:label 'Concession Start Date' ;
    rdfs:comment 'Effective start date of the concession agreement granting operational rights for the infrastructure asset.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concessionTermYears rdf:type rdf:Property ;
    rdfs:label 'Concession Term Years' ;
    rdfs:comment 'Total duration of the concession agreement in years from start to end date.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:currentValuation rdf:type rdf:Property ;
    rdfs:label 'Current Valuation' ;
    rdfs:comment 'Most recent fair value or mark-to-market valuation of the infrastructure asset as determined by internal or external appraisal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtOutstanding rdf:type rdf:Property ;
    rdfs:label 'Debt Outstanding' ;
    rdfs:comment 'Total outstanding debt or leverage associated with the infrastructure asset at the asset or project level.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disposalProceeds rdf:type rdf:Property ;
    rdfs:label 'Disposal Proceeds' ;
    rdfs:comment 'Total cash proceeds received from the sale or disposal of the infrastructure asset net of transaction costs.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operationalCapacity rdf:type rdf:Property ;
    rdfs:label 'Operational Capacity' ;
    rdfs:comment 'Maximum operational throughput or service capacity of the infrastructure asset in relevant units.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorLei rdf:type rdf:Property ;
    rdfs:label 'Operator Lei' ;
    rdfs:comment 'Twenty-character ISO Legal Entity Identifier for the operator entity managing the infrastructure asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorName rdf:type rdf:Property ;
    rdfs:label 'Operator Name' ;
    rdfs:comment 'Name of the entity or organization responsible for day-to-day operations and management of the infrastructure asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatedAssetFlag rdf:type rdf:Property ;
    rdfs:label 'Regulated Asset Flag' ;
    rdfs:comment 'Indicates whether the infrastructure asset operates under a regulated return or tariff framework set by a government authority.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryFramework rdf:type rdf:Property ;
    rdfs:label 'Regulatory Framework' ;
    rdfs:comment 'Name or description of the regulatory regime governing tariffs, returns, or operational standards for the asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:renewableEnergyFlag rdf:type rdf:Property ;
    rdfs:label 'Renewable Energy Flag' ;
    rdfs:comment 'Indicates whether the infrastructure asset generates or transmits renewable energy such as wind, solar, or hydro power.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:utilizationRate rdf:type rdf:Property ;
    rdfs:label 'Utilization Rate' ;
    rdfs:comment 'Current utilization of operational capacity expressed as a percentage of maximum capacity.' ;
    rdfs:domain ind:InfraAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carriedInterestId rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Id' ;
    rdfs:comment 'Foreign key linking to fee.carried_interest. Business justification: Carried interest terms are defined per fund; linking infra_fund_commitment to carried_interest allows calculation of carried interest distributions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CarriedInterest .

ind:managementFeeId rdf:type rdf:Property ;
    rdfs:label 'Management Fee Id' ;
    rdfs:comment 'Foreign key linking to fee.management_fee. Business justification: Each infrastructure fund has a specific management fee arrangement; linking infra_fund_commitment to management_fee enables fee schedule retrieval for accounting and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ManagementFee .

ind:waterfallId rdf:type rdf:Property ;
    rdfs:label 'Waterfall Id' ;
    rdfs:comment 'Foreign key linking to fee.waterfall. Business justification: The distribution waterfall structure is specific to each fund; linking infra_fund_commitment to waterfall supports accurate distribution waterfall calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Waterfall .

ind:actualNetIrr rdf:type rdf:Property ;
    rdfs:label 'Actual Net Irr' ;
    rdfs:comment 'Actual net IRR performance of the infrastructure fund to date, calculated using cash flows and current NAV.' ;
    rdfs:domain ind:InfraFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestmentRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Co Investment Rights Flag' ;
    rdfs:comment 'Indicates whether the pension fund has negotiated co-investment rights to participate in direct deals alongside the fund.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:fundIdentifier rdf:type rdf:Property ;
    rdfs:label 'Fund Identifier' ;
    rdfs:comment 'External unique identifier or code assigned to the infrastructure fund by the General Partner (GP) or administrator.' ;
    rdfs:domain ind:InfraFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundMaturityDate rdf:type rdf:Property ;
    rdfs:label 'Fund Maturity Date' ;
    rdfs:comment 'Expected final maturity date of the infrastructure fund when all assets should be liquidated and capital returned to LPs.' ;
    rdfs:domain ind:InfraFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalAssetClass rdf:type rdf:Property ;
    rdfs:label 'Internal Asset Class' ;
    rdfs:comment 'Internal Strategic Asset Allocation (SAA) asset class bucket to which this infrastructure fund commitment is assigned.' ;
    rdfs:domain ind:InfraFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryCapitalTreatment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Capital Treatment' ;
    rdfs:comment 'Regulatory capital classification of the infrastructure fund commitment for pension solvency and capital adequacy reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetNetIrr rdf:type rdf:Property ;
    rdfs:label 'Target Net Irr' ;
    rdfs:comment 'Target net IRR return objective for the infrastructure fund as stated in the Private Placement Memorandum (PPM), expressed as a decimal.' ;
    rdfs:domain ind:InfraFundCommitment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:concessionAgreementId rdf:type rdf:Property ;
    rdfs:label 'Concession Agreement Id' ;
    rdfs:comment 'Unique identifier for the concession agreement record. Primary key.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConcessionAgreement .

ind:concessionaireEntityActorId rdf:type rdf:Property ;
    rdfs:label 'Concessionaire Entity Actor Id' ;
    rdfs:comment 'Reference to the legal entity holding the concession rights, typically the fund or special purpose vehicle.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:agreementName rdf:type rdf:Property ;
    rdfs:label 'Agreement Name' ;
    rdfs:comment 'Human-readable name or title of the concession agreement, often referencing the asset or project covered.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementNumber rdf:type rdf:Property ;
    rdfs:label 'Agreement Number' ;
    rdfs:comment 'Externally-known unique business identifier for the concession agreement, typically assigned by the grantor or regulatory authority.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementStatus rdf:type rdf:Property ;
    rdfs:label 'Agreement Status' ;
    rdfs:comment 'Current lifecycle status of the concession agreement, indicating whether it is under negotiation, active, or concluded. [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|terminated|expired — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agreementType rdf:type rdf:Property ;
    rdfs:label 'Agreement Type' ;
    rdfs:comment 'Classification of the concession structure, such as Build-Operate-Transfer (BOT), Build-Own-Operate (BOO), Design-Build-Finance-Operate (DBFO), or traditional concession.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedReturnRatePercent rdf:type rdf:Property ;
    rdfs:label 'Allowed Return Rate Percent' ;
    rdfs:comment 'Regulatory-approved rate of return on invested capital, expressed as a percentage, applicable under regulated return mechanisms.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualConcessionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Concession Fee Amount' ;
    rdfs:comment 'Recurring annual fee payable to the grantor throughout the concession term, in concession currency.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:auditRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Audit Rights Description' ;
    rdfs:comment 'Summary of the grantor\'s rights to audit the concessionaire\'s financial records, operational performance, and compliance.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexResponsibility rdf:type rdf:Property ;
    rdfs:label 'Capex Responsibility' ;
    rdfs:comment 'Party responsible for funding capital expenditures during the concession term: concessionaire, grantor, or shared.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:changeInLawProtectionFlag rdf:type rdf:Property ;
    rdfs:label 'Change In Law Protection Flag' ;
    rdfs:comment 'Indicates whether the agreement includes provisions protecting the concessionaire from adverse changes in law or regulation.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:compensationOnTerminationBasis rdf:type rdf:Property ;
    rdfs:label 'Compensation On Termination Basis' ;
    rdfs:comment 'Methodology for calculating compensation payable to the concessionaire in the event of early termination by the grantor.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concessionCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Concession Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all financial terms and payments under the concession agreement.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disputeResolutionMechanism rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Mechanism' ;
    rdfs:comment 'Primary method for resolving disputes between parties: litigation, arbitration, mediation, or expert determination.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgComplianceRequirements rdf:type rdf:Property ;
    rdfs:label 'Esg Compliance Requirements' ;
    rdfs:comment 'Summary of Environmental, Social, and Governance obligations and standards the concessionaire must adhere to under the agreement.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:extensionTermYears rdf:type rdf:Property ;
    rdfs:label 'Extension Term Years' ;
    rdfs:comment 'Additional years available under extension provisions, if applicable.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureProvisions rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Provisions' ;
    rdfs:comment 'Summary of force majeure clauses defining events beyond parties\' control that excuse performance or trigger relief mechanisms.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:handbackConditionRequirements rdf:type rdf:Property ;
    rdfs:label 'Handback Condition Requirements' ;
    rdfs:comment 'Specifications for the physical and operational condition in which the asset must be returned to the grantor at concession end.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:insuranceRequirements rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirements' ;
    rdfs:comment 'Summary of insurance coverage types and minimum limits the concessionaire must maintain throughout the concession term.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRevenueGuaranteeAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Revenue Guarantee Amount' ;
    rdfs:comment 'Guaranteed minimum annual revenue amount provided by the grantor, if applicable, in the concession currency.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumRevenueGuaranteeFlag rdf:type rdf:Property ;
    rdfs:label 'Minimum Revenue Guarantee Flag' ;
    rdfs:comment 'Indicates whether the grantor provides a minimum revenue guarantee to protect the concessionaire from demand risk.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:opexResponsibility rdf:type rdf:Property ;
    rdfs:label 'Opex Responsibility' ;
    rdfs:comment 'Party responsible for funding operating expenditures during the concession term: concessionaire, grantor, or shared.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:penaltyRegimeDescription rdf:type rdf:Property ;
    rdfs:label 'Penalty Regime Description' ;
    rdfs:comment 'Summary of penalties, liquidated damages, or deductions applicable for failure to meet service quality or performance standards.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceBondAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Amount' ;
    rdfs:comment 'Value of the performance bond or guarantee required, if applicable, in concession currency.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceBondRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Performance Bond Required Flag' ;
    rdfs:comment 'Indicates whether the concessionaire is required to post a performance bond or guarantee to secure obligations.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refinancingConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Refinancing Consent Required Flag' ;
    rdfs:comment 'Indicates whether the concessionaire must obtain grantor consent before refinancing the project debt.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:refinancingGainSharingPercent rdf:type rdf:Property ;
    rdfs:label 'Refinancing Gain Sharing Percent' ;
    rdfs:comment 'Percentage of refinancing gains that must be shared with the grantor, if applicable.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatedReturnMechanism rdf:type rdf:Property ;
    rdfs:label 'Regulated Return Mechanism' ;
    rdfs:comment 'Type of return structure governing concessionaire compensation: Regulated Asset Return (RAR), Rate of Return (ROR), availability payment, revenue share, or hybrid model.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharingPercent rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Percent' ;
    rdfs:comment 'Percentage of gross revenues that must be shared with the grantor under revenue-sharing concession structures.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:serviceQualityStandards rdf:type rdf:Property ;
    rdfs:label 'Service Quality Standards' ;
    rdfs:comment 'Description of the service quality, availability, and performance standards the concessionaire must meet under the agreement.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stepInRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Step In Rights Description' ;
    rdfs:comment 'Summary of the grantor\'s or lenders\' rights to step in and assume control of operations in the event of concessionaire default.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffIndexationMechanism rdf:type rdf:Property ;
    rdfs:label 'Tariff Indexation Mechanism' ;
    rdfs:comment 'Description of the formula or index used to adjust tariffs over time, such as Consumer Price Index (CPI), Retail Price Index (RPI), or custom formula.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffSettingAuthority rdf:type rdf:Property ;
    rdfs:label 'Tariff Setting Authority' ;
    rdfs:comment 'Entity or mechanism responsible for setting user tariffs or charges: concessionaire discretion, grantor approval, independent regulator, or formula-based indexation.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:terminationRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Termination Rights Description' ;
    rdfs:comment 'Summary of conditions under which either party may terminate the concession agreement prior to the scheduled end date.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:upfrontConcessionFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Upfront Concession Fee Amount' ;
    rdfs:comment 'One-time fee paid by the concessionaire to the grantor at the start of the concession term, in concession currency.' ;
    rdfs:domain ind:ConcessionAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatedReturnModelId rdf:type rdf:Property ;
    rdfs:label 'Regulated Return Model Id' ;
    rdfs:comment 'Unique identifier for the regulated return model record. Primary key.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RegulatedReturnModel .

ind:capexAllowanceAmount rdf:type rdf:Property ;
    rdfs:label 'Capex Allowance Amount' ;
    rdfs:comment 'Regulatory allowance for capital expenditure during the determination period, which may be added to the RAB.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:clawbackMechanismFlag rdf:type rdf:Property ;
    rdfs:label 'Clawback Mechanism Flag' ;
    rdfs:comment 'Indicates whether a clawback or true-up mechanism exists to adjust future returns based on actual performance versus allowed returns.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costOfDebtPercent rdf:type rdf:Property ;
    rdfs:label 'Cost Of Debt Percent' ;
    rdfs:comment 'Regulatory cost of debt component used in the WACC calculation, expressed as a percentage.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:costOfEquityPercent rdf:type rdf:Property ;
    rdfs:label 'Cost Of Equity Percent' ;
    rdfs:comment 'Regulatory cost of equity component used in the WACC calculation, expressed as a percentage.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depreciationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Depreciation Rate Percent' ;
    rdfs:comment 'Annual depreciation rate applied to the RAB, expressed as a percentage of the asset base.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:determinationDate rdf:type rdf:Property ;
    rdfs:label 'Determination Date' ;
    rdfs:comment 'Date on which the regulatory authority issued the price determination or return decision for this model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:determinationDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Determination Document Url' ;
    rdfs:comment 'URL or document repository link to the official regulatory determination or price control decision document.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gearingRatioPercent rdf:type rdf:Property ;
    rdfs:label 'Gearing Ratio Percent' ;
    rdfs:comment 'Regulatory gearing or leverage ratio (debt to total capital) assumed in the WACC calculation, expressed as a percentage.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incentiveMechanismType rdf:type rdf:Property ;
    rdfs:label 'Incentive Mechanism Type' ;
    rdfs:comment 'Type of regulatory incentive mechanism applied, such as efficiency sharing, performance bonuses, or penalty regimes.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationIndexationMethod rdf:type rdf:Property ;
    rdfs:label 'Inflation Indexation Method' ;
    rdfs:comment 'Method by which the RAB and allowed returns are indexed for inflation: real, nominal, CPI-indexed, RPI-indexed, or none.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationRatePercent rdf:type rdf:Property ;
    rdfs:label 'Inflation Rate Percent' ;
    rdfs:comment 'Assumed or actual inflation rate used for indexation of the RAB and returns, expressed as a percentage per annum.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:modelCode rdf:type rdf:Property ;
    rdfs:label 'Model Code' ;
    rdfs:comment 'Unique business identifier or code for the regulated return model, used for external reporting and regulatory filings.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelName rdf:type rdf:Property ;
    rdfs:label 'Model Name' ;
    rdfs:comment 'Business name or title of the regulated return model, typically referencing the regulatory framework or determination period.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opexAllowanceAmount rdf:type rdf:Property ;
    rdfs:label 'Opex Allowance Amount' ;
    rdfs:comment 'Regulatory allowance for operating expenditure during the determination period, used to set revenue caps or price controls.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:performanceTargetDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Target Description' ;
    rdfs:comment 'Description of performance targets or service quality standards that the asset must meet under the regulatory determination.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceCapAmount rdf:type rdf:Property ;
    rdfs:label 'Price Cap Amount' ;
    rdfs:comment 'Maximum price or tariff the infrastructure asset is permitted to charge under the regulatory determination, if a price cap framework applies.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rabClosingValue rdf:type rdf:Property ;
    rdfs:label 'Rab Closing Value' ;
    rdfs:comment 'Closing value of the Regulatory Asset Base at the end of the determination period, reflecting capital additions, depreciation, and disposals.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rabCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Rab Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the Regulatory Asset Base valuation.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rabOpeningValue rdf:type rdf:Property ;
    rdfs:label 'Rab Opening Value' ;
    rdfs:comment 'Opening value of the Regulatory Asset Base at the start of the determination period, representing the capital base on which returns are calculated.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatorName rdf:type rdf:Property ;
    rdfs:label 'Regulator Name' ;
    rdfs:comment 'Name of the regulatory authority or body that sets and oversees the allowed return for this infrastructure asset.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryFilingReference rdf:type rdf:Property ;
    rdfs:label 'Regulatory Filing Reference' ;
    rdfs:comment 'Reference number or identifier of the regulatory filing or determination document associated with this return model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Regulatory Period Years' ;
    rdfs:comment 'Duration in years of the regulatory review period or price control period for this determination.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueCapAmount rdf:type rdf:Property ;
    rdfs:label 'Revenue Cap Amount' ;
    rdfs:comment 'Maximum revenue the infrastructure asset is permitted to earn under the regulatory determination, if a revenue cap framework applies.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reviewCycleFrequency rdf:type rdf:Property ;
    rdfs:label 'Review Cycle Frequency' ;
    rdfs:comment 'Frequency at which the regulatory return model is reviewed and updated by the regulator: annual, biennial, triennial, quinquennial, or ad hoc.' ;
    rdfs:domain ind:RegulatedReturnModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:updatedByUser rdf:type rdf:Property ;
    rdfs:label 'Updated By User' ;
    rdfs:comment 'User identifier or name of the person who last updated this regulated return model record.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waccPercent rdf:type rdf:Property ;
    rdfs:label 'Wacc Percent' ;
    rdfs:comment 'Weighted Average Cost of Capital used by the regulator to determine the allowed return, expressed as a percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:actualIrr rdf:type rdf:Property ;
    rdfs:label 'Actual Irr' ;
    rdfs:comment 'Actual internal rate of return (IRR) percentage achieved to date on the infrastructure project investment.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commercialOperationDate rdf:type rdf:Property ;
    rdfs:label 'Commercial Operation Date' ;
    rdfs:comment 'Date when the infrastructure project commenced full commercial operations and began generating revenue or providing services.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:concessionDurationYears rdf:type rdf:Property ;
    rdfs:label 'Concession Duration Years' ;
    rdfs:comment 'Total duration of the concession agreement or operating license in years.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:constructionCompletionPercentage rdf:type rdf:Property ;
    rdfs:label 'Construction Completion Percentage' ;
    rdfs:comment 'Percentage of construction or development work completed for the infrastructure project, applicable during construction phase.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionContractor rdf:type rdf:Property ;
    rdfs:label 'Construction Contractor' ;
    rdfs:comment 'Name of the primary construction contractor responsible for building or developing the infrastructure project.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractedRevenuePercentage rdf:type rdf:Property ;
    rdfs:label 'Contracted Revenue Percentage' ;
    rdfs:comment 'Percentage of total project revenue that is contracted or guaranteed under long-term agreements, providing revenue stability.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentNav rdf:type rdf:Property ;
    rdfs:label 'Current Nav' ;
    rdfs:comment 'Current net asset value (NAV) of the pension funds stake in the infrastructure project investment as of the latest valuation date.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:debtFinancingAmount rdf:type rdf:Property ;
    rdfs:label 'Debt Financing Amount' ;
    rdfs:comment 'Total debt financing amount raised for the infrastructure project, including senior debt, subordinated debt, and other borrowings.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:developmentStage rdf:type rdf:Property ;
    rdfs:label 'Development Stage' ;
    rdfs:comment 'Current lifecycle stage of the infrastructure project: pre-construction, construction, operational ramp-up, steady-state, decommissioning, or exited.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:equityCommitment rdf:type rdf:Property ;
    rdfs:label 'Equity Commitment' ;
    rdfs:comment 'Total equity capital committed by the pension fund to the infrastructure project investment.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityDeployed rdf:type rdf:Property ;
    rdfs:label 'Equity Deployed' ;
    rdfs:comment 'Cumulative equity capital deployed or drawn down into the infrastructure project to date.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitStrategy rdf:type rdf:Property ;
    rdfs:label 'Exit Strategy' ;
    rdfs:comment 'Planned exit strategy for the infrastructure project investment (e.g., hold to maturity, secondary sale, IPO, refinancing, asset sale).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:expectedCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Expected Completion Date' ;
    rdfs:comment 'Expected or scheduled completion date for construction or development of the infrastructure project.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:financialCloseDate rdf:type rdf:Property ;
    rdfs:label 'Financial Close Date' ;
    rdfs:comment 'Date when all financing documentation was executed and conditions precedent were satisfied, enabling project construction or acquisition to proceed.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:greenfieldBrownfieldFlag rdf:type rdf:Property ;
    rdfs:label 'Greenfield Brownfield Flag' ;
    rdfs:comment 'Indicator of whether the infrastructure project is a greenfield (new development) or brownfield (existing asset acquisition) investment.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:leverageRatio rdf:type rdf:Property ;
    rdfs:label 'Leverage Ratio' ;
    rdfs:comment 'Debt-to-equity leverage ratio for the infrastructure project, calculated as total debt divided by total equity.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:offtakeContractExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Offtake Contract Expiry Date' ;
    rdfs:comment 'Expiry date of the primary offtake or revenue contract for the infrastructure project.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:offtakeCounterparty rdf:type rdf:Property ;
    rdfs:label 'Offtake Counterparty' ;
    rdfs:comment 'Primary offtake counterparty or customer purchasing the output or services of the infrastructure project under long-term contract.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectName rdf:type rdf:Property ;
    rdfs:label 'Project Name' ;
    rdfs:comment 'Full legal or commercial name of the infrastructure project investment.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectType rdf:type rdf:Property ;
    rdfs:label 'Project Type' ;
    rdfs:comment 'Classification of the infrastructure project investment structure: Public-Private Partnership (PPP), Private Finance Initiative (PFI), availability-payment, merchant, regulated utility, or concession.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueModel rdf:type rdf:Property ;
    rdfs:label 'Revenue Model' ;
    rdfs:comment 'Primary revenue generation model for the infrastructure project: availability payment, usage-based, merchant, regulated return, or hybrid.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalProjectCost rdf:type rdf:Property ;
    rdfs:label 'Total Project Cost' ;
    rdfs:comment 'Total estimated or actual cost to develop, construct, and commission the infrastructure project, including all capital expenditures.' ;
    rdfs:domain ind:ProjectInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:infrastructureCapitalCallId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Capital Call Id' ;
    rdfs:comment 'Unique identifier for the infrastructure capital call record.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:infrastructureFundId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Fund Id' ;
    rdfs:comment 'Reference to the infrastructure fund issuing the capital call.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Fund .

ind:capitalCallNoticeDocumentId rdf:type rdf:Property ;
    rdfs:label 'Capital Call Notice Document Id' ;
    rdfs:comment 'Reference to the stored capital call notice document received from the General Partner (GP).' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalCallNoticeDocument .

ind:callNotes rdf:type rdf:Property ;
    rdfs:label 'Call Notes' ;
    rdfs:comment 'Additional notes, instructions, or commentary provided by the General Partner (GP) or fund administrator regarding the capital call.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativePic rdf:type rdf:Property ;
    rdfs:label 'Cumulative Pic' ;
    rdfs:comment 'Total Paid-In Capital (PIC) to date including this capital call, representing cumulative capital drawn from the Limited Partner (LP).' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundingDate rdf:type rdf:Property ;
    rdfs:label 'Funding Date' ;
    rdfs:comment 'Actual date on which the Limited Partner (LP) funded the capital call amount.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:internalApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Internal Approval Status' ;
    rdfs:comment 'Status of internal approval workflow for funding the capital call within the pension fund organization.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isEmergencyCall rdf:type rdf:Property ;
    rdfs:label 'Is Emergency Call' ;
    rdfs:comment 'Indicates whether this capital call was issued on an emergency or expedited basis requiring shorter notice period.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePaymentPenalty rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty' ;
    rdfs:comment 'Penalty amount assessed for late or partial funding of the capital call.' ;
    rdfs:domain ind:InfrastructureCapitalCall ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Notice Period Days' ;
    rdfs:comment 'Number of days between the capital call notice date and the due date, representing the advance notice provided to the Limited Partner (LP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:distributionEventId rdf:type rdf:Property ;
    rdfs:label 'Distribution Event Id' ;
    rdfs:comment 'Unique identifier for the distribution event record.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:cashFlowEventId rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Event Id' ;
    rdfs:comment 'Foreign key linking to treasury.cash_flow_event. Business justification: Distribution event triggers a cash flow event in treasury for cash movement recording.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CashFlowEvent .

ind:distributionEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Distribution Employee Id' ;
    rdfs:comment 'Reference to the user who created this distribution event record.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:distributionNoticeDocumentId rdf:type rdf:Property ;
    rdfs:label 'Distribution Notice Document Id' ;
    rdfs:comment 'Reference to the formal distribution notice document received from the General Partner (GP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AssetManagement .

ind:distributionUpdatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Distribution Updated By User Employee Id' ;
    rdfs:comment 'Reference to the user who last updated this distribution event record.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:distributionAmount rdf:type rdf:Property ;
    rdfs:label 'Distribution Amount' ;
    rdfs:comment 'The gross amount of the distribution received in the fund or asset base currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionCurrency rdf:type rdf:Property ;
    rdfs:label 'Distribution Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the distribution amount.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionMemo rdf:type rdf:Property ;
    rdfs:label 'Distribution Memo' ;
    rdfs:comment 'Narrative description or memo provided by the General Partner (GP) explaining the nature and context of the distribution.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionNumber rdf:type rdf:Property ;
    rdfs:label 'Distribution Number' ;
    rdfs:comment 'External reference number or identifier assigned by the General Partner (GP) or asset operator to this distribution event.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpNotificationDate rdf:type rdf:Property ;
    rdfs:label 'Gp Notification Date' ;
    rdfs:comment 'Date on which the General Partner (GP) notified the Limited Partner (LP) of the upcoming distribution.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:irrImpact rdf:type rdf:Property ;
    rdfs:label 'Irr Impact' ;
    rdfs:comment 'Incremental impact of this distribution on the cumulative Internal Rate of Return (IRR) of the fund or asset, expressed as a decimal.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liabilityMatchingAllocation rdf:type rdf:Property ;
    rdfs:label 'Liability Matching Allocation' ;
    rdfs:comment 'Portion of the distribution allocated to liability-driven investment (LDI) strategies for actuarial liability matching.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:moicImpact rdf:type rdf:Property ;
    rdfs:label 'Moic Impact' ;
    rdfs:comment 'Incremental impact of this distribution on the cumulative Multiple on Invested Capital (MOIC) of the fund or asset.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recallExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Recall Expiry Date' ;
    rdfs:comment 'Date after which the distribution can no longer be recalled by the General Partner (GP), if applicable.' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reconciliationVarianceAmount rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Variance Amount' ;
    rdfs:comment 'Variance amount identified during reconciliation between expected and actual distribution received.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxTreatyRate rdf:type rdf:Property ;
    rdfs:label 'Tax Treaty Rate' ;
    rdfs:comment 'Applicable withholding tax rate under bilateral tax treaty, expressed as a decimal (e.g., 0.15 for 15%).' ;
    rdfs:domain ind:DistributionEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashflowProjectionId rdf:type rdf:Property ;
    rdfs:label 'Cashflow Projection Id' ;
    rdfs:comment 'Unique identifier for the cash flow projection record.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetLifecycleStage rdf:type rdf:Property ;
    rdfs:label 'Asset Lifecycle Stage' ;
    rdfs:comment 'The lifecycle stage of the infrastructure asset: greenfield development, brownfield expansion, operational, mature, or decommissioning.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concessionExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Concession Expiry Date' ;
    rdfs:comment 'The date on which the concession agreement or operating license for the infrastructure asset expires, impacting long-duration cash flow projections.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:esgAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Esg Adjustment Factor' ;
    rdfs:comment 'Adjustment factor applied to cash flow projections to account for ESG risks or opportunities, such as carbon pricing or social license impacts.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastFrequency rdf:type rdf:Property ;
    rdfs:label 'Forecast Frequency' ;
    rdfs:comment 'The periodicity of the cash flow projection: annual, semi-annual, quarterly, or monthly.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period End Date' ;
    rdfs:comment 'The ending date of the forecast period for this cash flow projection.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:forecastPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Start Date' ;
    rdfs:comment 'The beginning date of the forecast period for this cash flow projection.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:inflationAssumption rdf:type rdf:Property ;
    rdfs:label 'Inflation Assumption' ;
    rdfs:comment 'The assumed inflation rate used in the cash flow projection model for revenue and cost escalation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedCapex rdf:type rdf:Property ;
    rdfs:label 'Projected Capex' ;
    rdfs:comment 'Forecasted capital expenditures required for maintenance, expansion, or improvement of the infrastructure asset during the forecast period.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedDebtService rdf:type rdf:Property ;
    rdfs:label 'Projected Debt Service' ;
    rdfs:comment 'Forecasted debt service payments including principal and interest for the infrastructure asset during the forecast period.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedDistribution rdf:type rdf:Property ;
    rdfs:label 'Projected Distribution' ;
    rdfs:comment 'Forecasted cash distribution to the pension fund as LP from the infrastructure asset during the forecast period.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedEbitda rdf:type rdf:Property ;
    rdfs:label 'Projected Ebitda' ;
    rdfs:comment 'Forecasted EBITDA for the infrastructure asset during the forecast period, representing operational cash generation capacity.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedFreeCashflow rdf:type rdf:Property ;
    rdfs:label 'Projected Free Cashflow' ;
    rdfs:comment 'Forecasted free cash flow available to equity holders after operating expenses, capital expenditures, and debt service.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedOperatingExpense rdf:type rdf:Property ;
    rdfs:label 'Projected Operating Expense' ;
    rdfs:comment 'Forecasted operating expenses for the infrastructure asset during the forecast period.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectedRevenue rdf:type rdf:Property ;
    rdfs:label 'Projected Revenue' ;
    rdfs:comment 'Forecasted revenue for the infrastructure asset during the forecast period.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:projectionDate rdf:type rdf:Property ;
    rdfs:label 'Projection Date' ;
    rdfs:comment 'The date on which this cash flow projection was generated or last updated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:projectionModelVersion rdf:type rdf:Property ;
    rdfs:label 'Projection Model Version' ;
    rdfs:comment 'Version identifier of the cash flow projection model or template used to generate this forecast.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:projectionScenario rdf:type rdf:Property ;
    rdfs:label 'Projection Scenario' ;
    rdfs:comment 'Scenario classification for the cash flow projection: base case, upside, downside, stress test, or sensitivity analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatedReturnRate rdf:type rdf:Property ;
    rdfs:label 'Regulated Return Rate' ;
    rdfs:comment 'The regulated rate of return allowed by regulatory authorities for regulated infrastructure assets such as utilities.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueGrowthAssumption rdf:type rdf:Property ;
    rdfs:label 'Revenue Growth Assumption' ;
    rdfs:comment 'The assumed annual revenue growth rate applied in the cash flow projection.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivityAdjustment rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Adjustment' ;
    rdfs:comment 'The magnitude of adjustment applied to the sensitivity parameter for scenario analysis, expressed as a percentage or absolute value.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sensitivityParameter rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Parameter' ;
    rdfs:comment 'The key variable being stress-tested in sensitivity scenarios, such as discount rate, revenue growth, or inflation.' ;
    rdfs:domain ind:CashflowProjection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureAssetValuationId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Asset Valuation Id' ;
    rdfs:comment 'Unique identifier for the infrastructure asset valuation record.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:appraisalReportDate rdf:type rdf:Property ;
    rdfs:label 'Appraisal Report Date' ;
    rdfs:comment 'The date the independent appraisal report was issued.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capexAssumption rdf:type rdf:Property ;
    rdfs:label 'Capex Assumption' ;
    rdfs:comment 'The annual capital expenditure assumption used in the cash flow projections.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashFlowProjectionPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Projection Period Years' ;
    rdfs:comment 'The number of years of explicit cash flow projections used in the Discounted Cash Flow (DCF) valuation model.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:comparableCompanyCount rdf:type rdf:Property ;
    rdfs:label 'Comparable Company Count' ;
    rdfs:comment 'The number of comparable publicly traded companies analyzed to derive valuation multiples.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:comparableTransactionCount rdf:type rdf:Property ;
    rdfs:label 'Comparable Transaction Count' ;
    rdfs:comment 'The number of comparable market transactions analyzed to derive valuation multiples.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:concessionRemainingTermYears rdf:type rdf:Property ;
    rdfs:label 'Concession Remaining Term Years' ;
    rdfs:comment 'The number of years remaining in the concession agreement or regulatory license at the valuation date.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:controlPremiumRate rdf:type rdf:Property ;
    rdfs:label 'Control Premium Rate' ;
    rdfs:comment 'The control premium rate applied to reflect the value of controlling interest, expressed as a decimal (e.g., 0.15000 for 15%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:countryRiskPremium rdf:type rdf:Property ;
    rdfs:label 'Country Risk Premium' ;
    rdfs:comment 'The country risk premium added to the discount rate to reflect sovereign and political risk, expressed as a decimal (e.g., 0.02500 for 2.5%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaMultiple rdf:type rdf:Property ;
    rdfs:label 'Ebitda Multiple' ;
    rdfs:comment 'The Enterprise Value to Earnings Before Interest Taxes Depreciation and Amortization (EV/EBITDA) multiple applied in comparable company or transaction valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fairValueAmount rdf:type rdf:Property ;
    rdfs:label 'Fair Value Amount' ;
    rdfs:comment 'The assessed fair value of the infrastructure asset in the reporting currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fairValueCurrency rdf:type rdf:Property ;
    rdfs:label 'Fair Value Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the fair value amount.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:independentAppraiser rdf:type rdf:Property ;
    rdfs:label 'Independent Appraiser' ;
    rdfs:comment 'The name of the independent third-party valuation firm or appraiser engaged to perform the fair value assessment.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityDiscountRate rdf:type rdf:Property ;
    rdfs:label 'Liquidity Discount Rate' ;
    rdfs:comment 'The liquidity discount rate applied to reflect the illiquidity of the infrastructure asset, expressed as a decimal (e.g., 0.20000 for 20%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netWorkingCapitalAssumption rdf:type rdf:Property ;
    rdfs:label 'Net Working Capital Assumption' ;
    rdfs:comment 'The net working capital requirement assumption used in the cash flow projections.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingMarginAssumption rdf:type rdf:Property ;
    rdfs:label 'Operating Margin Assumption' ;
    rdfs:comment 'The assumed operating margin (Earnings Before Interest Taxes Depreciation and Amortization (EBITDA) margin) used in the valuation model, expressed as a decimal (e.g., 0.35000 for 35%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rabMultiple rdf:type rdf:Property ;
    rdfs:label 'Rab Multiple' ;
    rdfs:comment 'The Regulated Asset Base (RAB) multiple applied for valuing regulated infrastructure assets, representing the ratio of enterprise value to RAB.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueForecastBaseYear rdf:type rdf:Property ;
    rdfs:label 'Revenue Forecast Base Year' ;
    rdfs:comment 'The base year from which revenue projections were extrapolated in the valuation model.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:revenueGrowthRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Revenue Growth Rate Assumption' ;
    rdfs:comment 'The assumed compound annual revenue growth rate used in the cash flow projections, expressed as a decimal (e.g., 0.03000 for 3%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxRateAssumption rdf:type rdf:Property ;
    rdfs:label 'Tax Rate Assumption' ;
    rdfs:comment 'The effective tax rate assumption applied in the cash flow projections, expressed as a decimal (e.g., 0.25000 for 25%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminalGrowthRate rdf:type rdf:Property ;
    rdfs:label 'Terminal Growth Rate' ;
    rdfs:comment 'The perpetual growth rate assumption applied to calculate terminal value in Discounted Cash Flow (DCF) models, expressed as a decimal (e.g., 0.02500 for 2.5%).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminalValue rdf:type rdf:Property ;
    rdfs:label 'Terminal Value' ;
    rdfs:comment 'The terminal value component of the Discounted Cash Flow (DCF) valuation representing the asset value beyond the explicit forecast period.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationChangeAmount rdf:type rdf:Property ;
    rdfs:label 'Valuation Change Amount' ;
    rdfs:comment 'The absolute change in fair value from the prior valuation to the current valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationChangePercentage rdf:type rdf:Property ;
    rdfs:label 'Valuation Change Percentage' ;
    rdfs:comment 'The percentage change in fair value from the prior valuation, expressed as a decimal (e.g., 0.05000 for 5%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationCommitteeApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Valuation Committee Approval Date' ;
    rdfs:comment 'The date the valuation was approved by the internal Valuation Committee or Investment Committee (IC).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:valuationPreparer rdf:type rdf:Property ;
    rdfs:label 'Valuation Preparer' ;
    rdfs:comment 'The name or identifier of the internal analyst or team who prepared the valuation.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationReviewer rdf:type rdf:Property ;
    rdfs:label 'Valuation Reviewer' ;
    rdfs:comment 'The name or identifier of the senior analyst or manager who reviewed and validated the valuation.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationSensitivityScenario rdf:type rdf:Property ;
    rdfs:label 'Valuation Sensitivity Scenario' ;
    rdfs:comment 'The sensitivity scenario applied (e.g., base case, upside case, downside case, stress scenario) for risk assessment.' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationVarianceExplanation rdf:type rdf:Property ;
    rdfs:label 'Valuation Variance Explanation' ;
    rdfs:comment 'Narrative explanation of the key drivers of valuation change from the prior period (e.g., operational performance, market conditions, discount rate movement).' ;
    rdfs:domain ind:InfrastructureAssetValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureDebtFacilityId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Debt Facility Id' ;
    rdfs:comment 'Unique identifier for the infrastructure debt facility record.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allInRatePercent rdf:type rdf:Property ;
    rdfs:label 'All In Rate Percent' ;
    rdfs:comment 'Total effective interest rate including base rate, spread, and fees expressed as a percentage.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:amortizationSchedule rdf:type rdf:Property ;
    rdfs:label 'Amortization Schedule' ;
    rdfs:comment 'Structure of principal repayment over the life of the facility.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:arrangementFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Arrangement Fee Amount' ;
    rdfs:comment 'Upfront fee paid to the lender for arranging and structuring the debt facility.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:baseRateIndex rdf:type rdf:Property ;
    rdfs:label 'Base Rate Index' ;
    rdfs:comment 'Reference rate index for floating rate facilities such as SOFR, EURIBOR, or LIBOR successor rates.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commitmentFeeBps rdf:type rdf:Property ;
    rdfs:label 'Commitment Fee Bps' ;
    rdfs:comment 'Annual fee charged on the undrawn portion of the facility expressed in basis points.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dscrCovenant rdf:type rdf:Property ;
    rdfs:label 'Dscr Covenant' ;
    rdfs:comment 'Minimum required DSCR covenant threshold that must be maintained throughout the facility life.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgLinkedPricing rdf:type rdf:Property ;
    rdfs:label 'Esg Linked Pricing' ;
    rdfs:comment 'Indicates whether the facility includes ESG-linked pricing adjustments based on sustainability performance.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:expectedCreditLossAmount rdf:type rdf:Property ;
    rdfs:label 'Expected Credit Loss Amount' ;
    rdfs:comment 'Calculated expected credit loss provision under IFRS 9 impairment model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityAgent rdf:type rdf:Property ;
    rdfs:label 'Facility Agent' ;
    rdfs:comment 'Name of the institution acting as facility agent responsible for administration and coordination.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityAmount rdf:type rdf:Property ;
    rdfs:label 'Facility Amount' ;
    rdfs:comment 'Total committed amount of the debt facility as documented in the credit agreement.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:facilityCurrency rdf:type rdf:Property ;
    rdfs:label 'Facility Currency' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the facility is denominated.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:facilityName rdf:type rdf:Property ;
    rdfs:label 'Facility Name' ;
    rdfs:comment 'Business name or title of the debt facility as documented in the credit agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:firstDrawdownDate rdf:type rdf:Property ;
    rdfs:label 'First Drawdown Date' ;
    rdfs:comment 'Date of the first principal drawdown from the facility.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:governingLaw rdf:type rdf:Property ;
    rdfs:label 'Governing Law' ;
    rdfs:comment 'Legal jurisdiction whose laws govern the facility agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:greenBondCertified rdf:type rdf:Property ;
    rdfs:label 'Green Bond Certified' ;
    rdfs:comment 'Indicates whether the facility is certified as a green bond under recognized ESG standards.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impairmentStage rdf:type rdf:Property ;
    rdfs:label 'Impairment Stage' ;
    rdfs:comment 'Current IFRS 9 impairment stage classification for expected credit loss provisioning.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:interestPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Interest Payment Frequency' ;
    rdfs:comment 'Frequency at which interest payments are due under the facility agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadArranger rdf:type rdf:Property ;
    rdfs:label 'Lead Arranger' ;
    rdfs:comment 'Name of the lead arranger or bookrunner for syndicated facilities.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderLei rdf:type rdf:Property ;
    rdfs:label 'Lender Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the lender institution.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lenderName rdf:type rdf:Property ;
    rdfs:label 'Lender Name' ;
    rdfs:comment 'Name of the financial institution or syndicate providing the debt facility.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ltvCovenantPercent rdf:type rdf:Property ;
    rdfs:label 'Ltv Covenant Percent' ;
    rdfs:comment 'Maximum permitted LTV ratio covenant expressed as a percentage of asset value.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaymentPenaltyPercent rdf:type rdf:Property ;
    rdfs:label 'Prepayment Penalty Percent' ;
    rdfs:comment 'Penalty rate applied to voluntary prepayments expressed as a percentage of prepaid principal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prepaymentPermitted rdf:type rdf:Property ;
    rdfs:label 'Prepayment Permitted' ;
    rdfs:comment 'Indicates whether voluntary prepayment of principal is permitted under the facility terms.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ratingAgency rdf:type rdf:Property ;
    rdfs:label 'Rating Agency' ;
    rdfs:comment 'Name of the rating agency that assigned the credit rating.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:repaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Repayment Frequency' ;
    rdfs:comment 'Frequency at which principal repayments are scheduled.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:syndicatedFacility rdf:type rdf:Property ;
    rdfs:label 'Syndicated Facility' ;
    rdfs:comment 'Indicates whether the facility is syndicated among multiple lenders.' ;
    rdfs:domain ind:InfrastructureDebtFacility ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tenorYears rdf:type rdf:Property ;
    rdfs:label 'Tenor Years' ;
    rdfs:comment 'Total duration of the facility from origination to maturity expressed in years.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Co Investment Id' ;
    rdfs:comment 'Unique identifier for the infrastructure co-investment transaction record.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CoInvestment .

ind:gpSponsorGpEntityId rdf:type rdf:Property ;
    rdfs:label 'Gp Sponsor Gp Entity Id' ;
    rdfs:comment 'Reference to the lead general partner or sponsor alongside whom the pension fund is co-investing.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpEntity .

ind:assetLocationCountry rdf:type rdf:Property ;
    rdfs:label 'Asset Location Country' ;
    rdfs:comment 'Three-letter ISO country code representing the primary geographic location of the underlying infrastructure asset.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Board Approval Date' ;
    rdfs:comment 'Date on which the Board of Directors approved the co-investment, if board approval was required.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:boardApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Board Approval Required Flag' ;
    rdfs:comment 'Boolean indicator of whether Board of Directors approval was required for this co-investment due to size or strategic significance.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:coInvestmentCode rdf:type rdf:Property ;
    rdfs:label 'Co Investment Code' ;
    rdfs:comment 'Unique alphanumeric code assigned to the co-investment for internal tracking and system integration.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgAssessmentDate rdf:type rdf:Property ;
    rdfs:label 'Esg Assessment Date' ;
    rdfs:comment 'Date on which the most recent ESG rating or assessment was conducted.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:firstFundingDate rdf:type rdf:Property ;
    rdfs:label 'First Funding Date' ;
    rdfs:comment 'Date of the initial capital drawdown or funding event for this co-investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:infrastructureSector rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Sector' ;
    rdfs:comment 'Specific infrastructure sector classification such as transportation, energy, utilities, social infrastructure, or telecommunications.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentTeam rdf:type rdf:Property ;
    rdfs:label 'Investment Team' ;
    rdfs:comment 'Name of the internal investment team or department responsible for this co-investment.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentVehicleStructure rdf:type rdf:Property ;
    rdfs:label 'Investment Vehicle Structure' ;
    rdfs:comment 'Legal structure of the co-investment vehicle such as limited partnership, special purpose vehicle, or direct holding entity.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coInvestmentName rdf:type rdf:Property ;
    rdfs:label 'Co Investment Name' ;
    rdfs:comment 'Business name or title of the co-investment transaction for identification and reporting purposes.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordActiveFlag rdf:type rdf:Property ;
    rdfs:label 'Record Active Flag' ;
    rdfs:comment 'Boolean indicator of whether this co-investment record is currently active in the system for reporting and analytics.' ;
    rdfs:domain ind:CoInvestment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Tariff Schedule Id' ;
    rdfs:comment 'Unique identifier for the tariff schedule record. Primary key for the tariff schedule entity.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:supersededByTariffScheduleId rdf:type rdf:Property ;
    rdfs:label 'Superseded By Tariff Schedule Id' ;
    rdfs:comment 'Reference to the tariff schedule that supersedes this schedule. Null if this is the current active schedule.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:TariffSchedule .

ind:baseTariffRate rdf:type rdf:Property ;
    rdfs:label 'Base Tariff Rate' ;
    rdfs:comment 'Base rate or charge per unit of usage before any adjustments, escalations, or discounts. Expressed in the tariff currency per unit of measure.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountEligibilityFlag rdf:type rdf:Property ;
    rdfs:label 'Discount Eligibility Flag' ;
    rdfs:comment 'Indicates whether this tariff schedule is eligible for discounts, such as volume discounts, loyalty discounts, or social tariffs for vulnerable users.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalLevyFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Levy Flag' ;
    rdfs:comment 'Indicates whether the tariff schedule includes an environmental levy or surcharge to fund environmental mitigation, carbon offset, or sustainability initiatives.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalLevyRate rdf:type rdf:Property ;
    rdfs:label 'Environmental Levy Rate' ;
    rdfs:comment 'Rate of the environmental levy or surcharge included in the tariff, expressed in the tariff currency per unit of measure. Null if environmental levy flag is false.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escalationIndex rdf:type rdf:Property ;
    rdfs:label 'Escalation Index' ;
    rdfs:comment 'Specific inflation index or benchmark used for tariff escalation, such as national CPI, regional RPI, or sector-specific index.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationEscalationMethod rdf:type rdf:Property ;
    rdfs:label 'Inflation Escalation Method' ;
    rdfs:comment 'Method by which the tariff rate is escalated over time to account for inflation, such as Consumer Price Index (CPI) linkage, Retail Price Index (RPI) linkage, fixed annual percentage increase, revenue cap, price cap, or no escalation.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:maximumCharge rdf:type rdf:Property ;
    rdfs:label 'Maximum Charge' ;
    rdfs:comment 'Maximum charge or cap applicable under this tariff schedule, used to protect users from excessive charges or to comply with regulatory price caps.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:minimumCharge rdf:type rdf:Property ;
    rdfs:label 'Minimum Charge' ;
    rdfs:comment 'Minimum charge applicable under this tariff schedule, regardless of usage volume. Used to ensure cost recovery for fixed infrastructure costs.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peakOffPeakFlag rdf:type rdf:Property ;
    rdfs:label 'Peak Off Peak Flag' ;
    rdfs:comment 'Indicates whether the tariff schedule includes differentiated rates for peak and off-peak usage periods, common in utilities and transport infrastructure.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:publicConsultationFlag rdf:type rdf:Property ;
    rdfs:label 'Public Consultation Flag' ;
    rdfs:comment 'Indicates whether the tariff schedule was subject to public consultation as part of the regulatory approval process.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatedReturnModel rdf:type rdf:Property ;
    rdfs:label 'Regulated Return Model' ;
    rdfs:comment 'Regulatory return model governing the tariff schedule, such as Regulated Asset Base (RAB) return, Rate of Return (ROR), price cap, revenue cap, hybrid model, or unregulated.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryApprovalDate rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Date' ;
    rdfs:comment 'Date on which the tariff schedule received regulatory approval from the governing authority.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryApprovalStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Status' ;
    rdfs:comment 'Current status of the tariff schedule in the regulatory approval process, indicating whether it is draft, submitted for approval, under regulatory review, approved, rejected, or superseded by a newer schedule.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueSharingFlag rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Flag' ;
    rdfs:comment 'Indicates whether revenues generated under this tariff schedule are subject to revenue sharing arrangements with government, concession grantor, or other stakeholders.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:revenueSharingPercentage rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Percentage' ;
    rdfs:comment 'Percentage of tariff revenues that must be shared with government or concession grantor under revenue sharing arrangements. Null if revenue sharing flag is false.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:socialTariffFlag rdf:type rdf:Property ;
    rdfs:label 'Social Tariff Flag' ;
    rdfs:comment 'Indicates whether this is a social tariff designed to provide subsidized rates for vulnerable or low-income users, as mandated by regulatory or social policy.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tariffCategory rdf:type rdf:Property ;
    rdfs:label 'Tariff Category' ;
    rdfs:comment 'Classification of the tariff by user or usage type, such as vehicle class for toll roads, passenger type for transit, commodity type for ports, capacity band for utilities, time-of-use for peak/off-peak pricing, or distance band for usage-based charges.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffCode rdf:type rdf:Property ;
    rdfs:label 'Tariff Code' ;
    rdfs:comment 'Business identifier or code for the tariff schedule, used for external reference and regulatory reporting.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffCurrency rdf:type rdf:Property ;
    rdfs:label 'Tariff Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the tariff rate is denominated.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffDescription rdf:type rdf:Property ;
    rdfs:label 'Tariff Description' ;
    rdfs:comment 'Detailed description of the tariff schedule, including its purpose, applicability, calculation methodology, and any special terms or conditions.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffFilingReference rdf:type rdf:Property ;
    rdfs:label 'Tariff Filing Reference' ;
    rdfs:comment 'Reference number or identifier for the regulatory filing or submission associated with this tariff schedule.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffName rdf:type rdf:Property ;
    rdfs:label 'Tariff Name' ;
    rdfs:comment 'Descriptive name of the tariff schedule, identifying the tariff type and applicable user segment.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffReviewFrequency rdf:type rdf:Property ;
    rdfs:label 'Tariff Review Frequency' ;
    rdfs:comment 'Frequency at which the tariff schedule is subject to regulatory review and potential adjustment, such as annual, biennial, quinquennial (every five years), ad hoc, or continuous review.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:tariffStructureType rdf:type rdf:Property ;
    rdfs:label 'Tariff Structure Type' ;
    rdfs:comment 'Type of tariff structure used, such as flat rate, tiered pricing, block pricing, time-of-use pricing, distance-based pricing, or capacity-based pricing.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:userClass rdf:type rdf:Property ;
    rdfs:label 'User Class' ;
    rdfs:comment 'Specific user class or segment to which the tariff applies, such as light vehicle, heavy goods vehicle, passenger, freight, residential, commercial, or industrial user.' ;
    rdfs:domain ind:TariffSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureCapexProgramId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Capex Program Id' ;
    rdfs:comment 'Unique identifier for the infrastructure capital expenditure program record.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetClassImpact rdf:type rdf:Property ;
    rdfs:label 'Asset Class Impact' ;
    rdfs:comment 'Description of how the capital expenditure program impacts the infrastructure asset class valuation and operational performance.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:budgetVariance rdf:type rdf:Property ;
    rdfs:label 'Budget Variance' ;
    rdfs:comment 'Variance between total approved budget and current forecast total expenditure, indicating over or under budget position.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contingencyBudget rdf:type rdf:Property ;
    rdfs:label 'Contingency Budget' ;
    rdfs:comment 'Additional budget allocation reserved for unforeseen costs and risk mitigation during program execution.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractType rdf:type rdf:Property ;
    rdfs:label 'Contract Type' ;
    rdfs:comment 'Type of contractual arrangement used for executing the capital expenditure program with external contractors or vendors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:energyEfficiencyImprovementPct rdf:type rdf:Property ;
    rdfs:label 'Energy Efficiency Improvement Pct' ;
    rdfs:comment 'Expected percentage improvement in energy efficiency resulting from the capital expenditure program implementation.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedIrr rdf:type rdf:Property ;
    rdfs:label 'Expected Irr' ;
    rdfs:comment 'Projected Internal Rate of Return for the capital expenditure program based on investment analysis and cash flow modeling.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedPaybackPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Expected Payback Period Years' ;
    rdfs:comment 'Projected number of years required to recover the capital expenditure investment through generated cash flows.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expenditureToDate rdf:type rdf:Property ;
    rdfs:label 'Expenditure To Date' ;
    rdfs:comment 'Cumulative capital expenditure amount spent on the program from inception to the current reporting date.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastRemainingExpenditure rdf:type rdf:Property ;
    rdfs:label 'Forecast Remaining Expenditure' ;
    rdfs:comment 'Projected capital expenditure amount remaining to be spent to complete the program based on current forecasts.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navImpactEstimate rdf:type rdf:Property ;
    rdfs:label 'Nav Impact Estimate' ;
    rdfs:comment 'Estimated impact on the infrastructure assets Net Asset Value upon successful completion of the capital expenditure program.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:primaryContractor rdf:type rdf:Property ;
    rdfs:label 'Primary Contractor' ;
    rdfs:comment 'Name of the main contractor or Engineering Procurement and Construction (EPC) firm responsible for program delivery.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programDescription rdf:type rdf:Property ;
    rdfs:label 'Program Description' ;
    rdfs:comment 'Detailed narrative describing the scope, objectives, and business rationale for the capital expenditure program.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programManager rdf:type rdf:Property ;
    rdfs:label 'Program Manager' ;
    rdfs:comment 'Name of the individual responsible for managing and overseeing execution of the capital expenditure program.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:programNotes rdf:type rdf:Property ;
    rdfs:label 'Program Notes' ;
    rdfs:comment 'Additional commentary, observations, or contextual information regarding the capital expenditure program execution and status.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recordStatus rdf:type rdf:Property ;
    rdfs:label 'Record Status' ;
    rdfs:comment 'Operational status of the capital expenditure program record in the data system for data lifecycle management.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryRequirementFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Requirement Flag' ;
    rdfs:comment 'Indicates whether the capital expenditure program is mandated by regulatory or compliance requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:totalApprovedBudget rdf:type rdf:Property ;
    rdfs:label 'Total Approved Budget' ;
    rdfs:comment 'Total capital expenditure budget amount approved by the Investment Committee (IC) for the program.' ;
    rdfs:domain ind:InfrastructureCapexProgram ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availabilityPaymentId rdf:type rdf:Property ;
    rdfs:label 'Availability Payment Id' ;
    rdfs:comment 'Unique identifier for the availability payment transaction record.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetOperatorName rdf:type rdf:Property ;
    rdfs:label 'Asset Operator Name' ;
    rdfs:comment 'Name of the entity responsible for operating the infrastructure asset and delivering the availability performance.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:availabilityActualPercentage rdf:type rdf:Property ;
    rdfs:label 'Availability Actual Percentage' ;
    rdfs:comment 'Actual availability percentage achieved during the payment period based on operational performance metrics.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availabilityDeductionAmount rdf:type rdf:Property ;
    rdfs:label 'Availability Deduction Amount' ;
    rdfs:comment 'Total deduction amount applied to the contracted payment due to availability performance falling below target thresholds.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:availabilityTargetPercentage rdf:type rdf:Property ;
    rdfs:label 'Availability Target Percentage' ;
    rdfs:comment 'Contractual target availability percentage required to receive full payment for the period, typically 95-99%.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:bonusPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Bonus Payment Amount' ;
    rdfs:comment 'Additional bonus payment earned for exceeding availability or performance targets during the period.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:contractedPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Contracted Payment Amount' ;
    rdfs:comment 'Base availability payment amount as specified in the concession agreement for the period, assuming 100% availability.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forceMajeureHours rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Hours' ;
    rdfs:comment 'Hours of unavailability attributed to force majeure events, typically excluded from performance calculations.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:glPostingDate rdf:type rdf:Property ;
    rdfs:label 'Gl Posting Date' ;
    rdfs:comment 'Date on which the availability payment was posted to the general ledger.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:indexationAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Indexation Adjustment Amount' ;
    rdfs:comment 'Inflation or indexation adjustment applied to the base payment amount per contractual escalation clauses.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationRateApplied rdf:type rdf:Property ;
    rdfs:label 'Indexation Rate Applied' ;
    rdfs:comment 'The inflation or indexation rate percentage applied to adjust the payment amount for the period.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netPaymentAmount rdf:type rdf:Property ;
    rdfs:label 'Net Payment Amount' ;
    rdfs:comment 'Final net payment amount after all adjustments, deductions, bonuses, and withholdings have been applied.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Payment Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the availability payment.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentPeriodEndDate rdf:type rdf:Property ;
    rdfs:label 'Payment Period End Date' ;
    rdfs:comment 'End date of the service period for which this availability payment is calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentPeriodStartDate rdf:type rdf:Property ;
    rdfs:label 'Payment Period Start Date' ;
    rdfs:comment 'Start date of the service period for which this availability payment is calculated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:paymentType rdf:type rdf:Property ;
    rdfs:label 'Payment Type' ;
    rdfs:comment 'Classification of the payment within the contract lifecycle, distinguishing regular periodic payments from adjustments or settlements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceDeductionAmount rdf:type rdf:Property ;
    rdfs:label 'Performance Deduction Amount' ;
    rdfs:comment 'Additional deduction amount applied for performance failures beyond availability metrics, such as quality or service level breaches.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:plannedMaintenanceHours rdf:type rdf:Property ;
    rdfs:label 'Planned Maintenance Hours' ;
    rdfs:comment 'Hours of scheduled maintenance during the period, which may be excluded from availability calculations per contract terms.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueRecognitionDate rdf:type rdf:Property ;
    rdfs:label 'Revenue Recognition Date' ;
    rdfs:comment 'Date on which revenue from this availability payment is recognized under IFRS 15 principles.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:unavailabilityHours rdf:type rdf:Property ;
    rdfs:label 'Unavailability Hours' ;
    rdfs:comment 'Total hours during the payment period when the asset was unavailable or failed to meet service requirements.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:unplannedOutageHours rdf:type rdf:Property ;
    rdfs:label 'Unplanned Outage Hours' ;
    rdfs:comment 'Hours of unplanned downtime or service interruption that count against availability performance.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingAmount rdf:type rdf:Property ;
    rdfs:label 'Withholding Amount' ;
    rdfs:comment 'Amount withheld from payment for tax, retention, or contractual holdback purposes.' ;
    rdfs:domain ind:AvailabilityPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetOwnershipId rdf:type rdf:Property ;
    rdfs:label 'Asset Ownership Id' ;
    rdfs:comment 'Unique identifier for the infrastructure asset ownership record.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:ownershipAgreementId rdf:type rdf:Property ;
    rdfs:label 'Ownership Agreement Id' ;
    rdfs:comment 'Reference to the legal agreement governing the ownership structure and rights for the infrastructure asset.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:OwnershipAgreement .

ind:assetClassAlignment rdf:type rdf:Property ;
    rdfs:label 'Asset Class Alignment' ;
    rdfs:comment 'Risk-return profile classification of the infrastructure ownership stake within the pension funds strategic asset allocation framework.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:boardSeatsCount rdf:type rdf:Property ;
    rdfs:label 'Board Seats Count' ;
    rdfs:comment 'Number of board or advisory committee seats held by the pension fund for the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:coInvestEquityStakePct rdf:type rdf:Property ;
    rdfs:label 'Co Invest Equity Stake Pct' ;
    rdfs:comment 'Percentage of equity held by co-investment partners alongside the pension fund.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:coInvestorCount rdf:type rdf:Property ;
    rdfs:label 'Co Investor Count' ;
    rdfs:comment 'Number of co-investment partners participating alongside the pension fund in the infrastructure asset ownership.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:consolidationMethod rdf:type rdf:Property ;
    rdfs:label 'Consolidation Method' ;
    rdfs:comment 'Accounting method used to consolidate the infrastructure asset in the pension funds financial statements.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionWaterfallTier rdf:type rdf:Property ;
    rdfs:label 'Distribution Waterfall Tier' ;
    rdfs:comment 'Current tier in the distribution waterfall structure determining how cash flows are allocated among stakeholders.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dragAlongRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Drag Along Rights Flag' ;
    rdfs:comment 'Indicates whether majority shareholders can compel the pension fund to participate in a sale transaction.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:effectiveOwnershipDate rdf:type rdf:Property ;
    rdfs:label 'Effective Ownership Date' ;
    rdfs:comment 'Date when legal and beneficial ownership rights became effective for the pension fund.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:esgOwnershipRating rdf:type rdf:Property ;
    rdfs:label 'Esg Ownership Rating' ;
    rdfs:comment 'ESG rating assigned to the ownership structure and governance practices for the infrastructure asset. [ENUM-REF-CANDIDATE: AAA|AA|A|BBB|BB|B|CCC|CC|C — 9 candidates stripped; promote to reference product]' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:governanceRightsDescription rdf:type rdf:Property ;
    rdfs:label 'Governance Rights Description' ;
    rdfs:comment 'Description of the pension funds governance rights including board seats, veto rights, and approval authorities for the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpCarriedInterestPct rdf:type rdf:Property ;
    rdfs:label 'Gp Carried Interest Pct' ;
    rdfs:comment 'Percentage of profits allocated to the general partner as carried interest after hurdle rate is achieved.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:gpHurdleRatePct rdf:type rdf:Property ;
    rdfs:label 'Gp Hurdle Rate Pct' ;
    rdfs:comment 'Preferred return threshold that limited partners must achieve before general partner receives carried interest.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentVehicleLei rdf:type rdf:Property ;
    rdfs:label 'Investment Vehicle Lei' ;
    rdfs:comment 'Legal Entity Identifier for the investment vehicle holding the ownership stake.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentVehicleType rdf:type rdf:Property ;
    rdfs:label 'Investment Vehicle Type' ;
    rdfs:comment 'Type of legal vehicle through which the pension fund holds its ownership stake in the infrastructure asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leadSponsorEquityStakePct rdf:type rdf:Property ;
    rdfs:label 'Lead Sponsor Equity Stake Pct' ;
    rdfs:comment 'Percentage of equity owned by the lead sponsor or general partner in the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lockUpEndDate rdf:type rdf:Property ;
    rdfs:label 'Lock Up End Date' ;
    rdfs:comment 'Date when contractual restrictions on transferring or selling the ownership stake expire.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:minorityPartnerEquityStakePct rdf:type rdf:Property ;
    rdfs:label 'Minority Partner Equity Stake Pct' ;
    rdfs:comment 'Aggregate percentage of equity held by minority partners or other limited partners in the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownershipNotes rdf:type rdf:Property ;
    rdfs:label 'Ownership Notes' ;
    rdfs:comment 'Additional notes or commentary regarding the ownership structure, special terms, or unique arrangements for the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipStatus rdf:type rdf:Property ;
    rdfs:label 'Ownership Status' ;
    rdfs:comment 'Current lifecycle status of the ownership stake in the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipStructureType rdf:type rdf:Property ;
    rdfs:label 'Ownership Structure Type' ;
    rdfs:comment 'Classification of the ownership arrangement for the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ownershipVintageYear rdf:type rdf:Property ;
    rdfs:label 'Ownership Vintage Year' ;
    rdfs:comment 'Year in which the pension fund initially committed capital to acquire its ownership stake in the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:pensionFundEquityStakePct rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Equity Stake Pct' ;
    rdfs:comment 'Percentage of total equity owned directly by the pension fund in the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pensionFundVotingRightsPct rdf:type rdf:Property ;
    rdfs:label 'Pension Fund Voting Rights Pct' ;
    rdfs:comment 'Percentage of voting rights held by the pension fund, which may differ from equity stake due to share class structures.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnPct rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Pct' ;
    rdfs:comment 'Preferred return rate that the pension fund is entitled to receive before other profit distributions.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordSourceSystem rdf:type rdf:Property ;
    rdfs:label 'Record Source System' ;
    rdfs:comment 'Name of the operational system from which this ownership record originated.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rightOfFirstRefusalFlag rdf:type rdf:Property ;
    rdfs:label 'Right Of First Refusal Flag' ;
    rdfs:comment 'Indicates whether the pension fund has right of first refusal on additional equity issuances or stake sales.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:tagAlongRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Tag Along Rights Flag' ;
    rdfs:comment 'Indicates whether the pension fund has tag-along rights to participate in third-party sale transactions.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:vetoRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Veto Rights Flag' ;
    rdfs:comment 'Indicates whether the pension fund holds veto rights over major decisions for the infrastructure asset.' ;
    rdfs:domain ind:AssetOwnership ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryReviewId rdf:type rdf:Property ;
    rdfs:label 'Regulatory Review Id' ;
    rdfs:comment 'Unique identifier for the regulatory price review record. Primary key for the regulatory review entity.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:allowedReturnOnEquityPercent rdf:type rdf:Property ;
    rdfs:label 'Allowed Return On Equity Percent' ;
    rdfs:comment 'Regulator-determined allowed return on equity expressed as a decimal percentage (e.g., 0.0650 for 6.50%), representing the cost of equity component in the Weighted Average Cost of Capital (WACC).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowedRevenueAmount rdf:type rdf:Property ;
    rdfs:label 'Allowed Revenue Amount' ;
    rdfs:comment 'Total allowed revenue determined by the regulator for the control period, representing the maximum revenue the asset operator may recover from customers.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:allowedRevenueCurrency rdf:type rdf:Property ;
    rdfs:label 'Allowed Revenue Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the allowed revenue amount (e.g., GBP, USD, EUR).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:allowedWaccPercent rdf:type rdf:Property ;
    rdfs:label 'Allowed Wacc Percent' ;
    rdfs:comment 'Regulator-determined Weighted Average Cost of Capital (WACC) expressed as a decimal percentage, used to calculate allowed returns on the Regulated Asset Base (RAB).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:appealDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Date' ;
    rdfs:comment 'Date on which an appeal was formally filed with the regulatory appeals body or tribunal.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Appeal Decision Date' ;
    rdfs:comment 'Date on which the appeals body or tribunal issued its decision on the appeal.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:appealFiledFlag rdf:type rdf:Property ;
    rdfs:label 'Appeal Filed Flag' ;
    rdfs:comment 'Boolean flag indicating whether the asset operator or other stakeholder has filed an appeal or challenge against the final determination.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:appealOutcome rdf:type rdf:Property ;
    rdfs:label 'Appeal Outcome' ;
    rdfs:comment 'Outcome of the regulatory appeal: pending, upheld (determination overturned), partially upheld (determination modified), dismissed (determination stands), or withdrawn.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capexAllowance rdf:type rdf:Property ;
    rdfs:label 'Capex Allowance' ;
    rdfs:comment 'Total capital expenditure allowance approved by the regulator for the control period, covering investment in new infrastructure, asset replacement, and enhancement projects.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:consultationEndDate rdf:type rdf:Property ;
    rdfs:label 'Consultation End Date' ;
    rdfs:comment 'End date of the public consultation period for stakeholder feedback on the draft determination.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:consultationStartDate rdf:type rdf:Property ;
    rdfs:label 'Consultation Start Date' ;
    rdfs:comment 'Start date of the public consultation period during which stakeholders may submit responses to the draft determination.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:draftDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Draft Determination Date' ;
    rdfs:comment 'Date on which the regulator published the draft determination or provisional decision for stakeholder consultation.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:efficiencyTargetPercent rdf:type rdf:Property ;
    rdfs:label 'Efficiency Target Percent' ;
    rdfs:comment 'Regulator-imposed efficiency improvement target expressed as a decimal percentage, requiring the operator to reduce costs or improve productivity over the control period.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:finalDeterminationDate rdf:type rdf:Property ;
    rdfs:label 'Final Determination Date' ;
    rdfs:comment 'Date on which the regulator issued the final determination, setting allowed revenues, tariffs, and performance obligations for the control period.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:gearingAssumptionPercent rdf:type rdf:Property ;
    rdfs:label 'Gearing Assumption Percent' ;
    rdfs:comment 'Regulator-assumed gearing ratio (debt-to-equity ratio) expressed as a decimal percentage, used in calculating the allowed WACC.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:indexationMechanism rdf:type rdf:Property ;
    rdfs:label 'Indexation Mechanism' ;
    rdfs:comment 'Description of the inflation indexation mechanism applied to the RAB and allowed revenues (e.g., RPI, CPI, CPIH indexation).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalReviewLead rdf:type rdf:Property ;
    rdfs:label 'Internal Review Lead' ;
    rdfs:comment 'Name or identifier of the internal team member or department responsible for managing the regulatory review process and stakeholder engagement.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:opexAllowance rdf:type rdf:Property ;
    rdfs:label 'Opex Allowance' ;
    rdfs:comment 'Total operating expenditure allowance approved by the regulator for the control period, covering day-to-day operational costs, maintenance, and administration.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outputDeliveryTargets rdf:type rdf:Property ;
    rdfs:label 'Output Delivery Targets' ;
    rdfs:comment 'Summary of key output delivery targets or performance commitments set by the regulator (e.g., service reliability, customer satisfaction, environmental outcomes).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorContactEmail rdf:type rdf:Property ;
    rdfs:label 'Regulator Contact Email' ;
    rdfs:comment 'Primary email address for regulatory correspondence and inquiries related to this price review.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatorJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Regulator Jurisdiction' ;
    rdfs:comment 'Geographic or legal jurisdiction of the regulatory authority (country, state, or region code).' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Review Document Url' ;
    rdfs:comment 'URL or document reference to the published regulatory determination, business plan submission, or consultation document.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Review Reference Number' ;
    rdfs:comment 'External reference number or code assigned by the regulator to uniquely identify this price review proceeding.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewStatus rdf:type rdf:Property ;
    rdfs:label 'Review Status' ;
    rdfs:comment 'Current lifecycle status of the regulatory review: initiated, submission pending, under review, draft determination issued, consultation period, final determination published, appeal filed, or closed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reviewType rdf:type rdf:Property ;
    rdfs:label 'Review Type' ;
    rdfs:comment 'Classification of the regulatory review process: periodic determination (scheduled multi-year reset), interim review (mid-cycle adjustment), appeal (challenge of prior determination), reopener, mid-period adjustment, or extraordinary review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totexAllowance rdf:type rdf:Property ;
    rdfs:label 'Totex Allowance' ;
    rdfs:comment 'Combined total expenditure allowance (CAPEX plus OPEX) approved by the regulator for the control period, used in TOTEX-based regulatory frameworks.' ;
    rdfs:domain ind:RegulatoryReview ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:constructionMilestoneId rdf:type rdf:Property ;
    rdfs:label 'Construction Milestone Id' ;
    rdfs:comment 'Unique identifier for the construction milestone record.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:predecessorMilestoneConstructionMilestoneId rdf:type rdf:Property ;
    rdfs:label 'Predecessor Milestone Construction Milestone Id' ;
    rdfs:comment 'Reference to the preceding milestone that must be completed before this milestone can begin, used for dependency tracking.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ConstructionMilestone .

ind:actualDate rdf:type rdf:Property ;
    rdfs:label 'Actual Date' ;
    rdfs:comment 'Date on which the milestone was actually achieved and certified by the project team or independent engineer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:certificationDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Certification Document Reference' ;
    rdfs:comment 'Reference number or identifier of the certification document or report confirming milestone achievement.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certifyingParty rdf:type rdf:Property ;
    rdfs:label 'Certifying Party' ;
    rdfs:comment 'Name of the independent engineer, surveyor, or authority responsible for certifying milestone achievement.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractReference rdf:type rdf:Property ;
    rdfs:label 'Contract Reference' ;
    rdfs:comment 'Reference to the construction contract, Engineering Procurement Construction (EPC) agreement, or concession agreement governing this milestone.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:criticalPathFlag rdf:type rdf:Property ;
    rdfs:label 'Critical Path Flag' ;
    rdfs:comment 'Indicates whether this milestone is on the project critical path and directly impacts Commercial Operation Date (COD).' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:delayCategory rdf:type rdf:Property ;
    rdfs:label 'Delay Category' ;
    rdfs:comment 'Standardized category of delay cause for portfolio-level risk analysis and reporting. [ENUM-REF-CANDIDATE: weather|permitting|supply_chain|labor|design_change|force_majeure|financing|regulatory|technical|other — promote to reference product]' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:delayReason rdf:type rdf:Property ;
    rdfs:label 'Delay Reason' ;
    rdfs:comment 'Explanation of the cause of delay if the milestone is behind schedule, used for risk management and Operational Due Diligence (ODD).' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dependencyType rdf:type rdf:Property ;
    rdfs:label 'Dependency Type' ;
    rdfs:comment 'Type of scheduling dependency relationship with the predecessor milestone per Project Management Institute (PMI) standards.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forecastDate rdf:type rdf:Property ;
    rdfs:label 'Forecast Date' ;
    rdfs:comment 'Current best-estimate date for milestone achievement based on project progress and risk assessment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Reporting Flag' ;
    rdfs:comment 'Indicates whether this milestone is material and must be reported to the Investment Committee (IC) in quarterly portfolio reviews.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lenderReportingFlag rdf:type rdf:Property ;
    rdfs:label 'Lender Reporting Flag' ;
    rdfs:comment 'Indicates whether this milestone must be reported to project lenders or debt providers per loan covenants.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:milestoneCode rdf:type rdf:Property ;
    rdfs:label 'Milestone Code' ;
    rdfs:comment 'Standardized code or abbreviation for the milestone type used for reporting and tracking.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneName rdf:type rdf:Property ;
    rdfs:label 'Milestone Name' ;
    rdfs:comment 'Business name or title of the construction milestone (e.g., Financial Close, Mechanical Completion, Commercial Operation Date).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneStatus rdf:type rdf:Property ;
    rdfs:label 'Milestone Status' ;
    rdfs:comment 'Current lifecycle status of the milestone indicating progress and completion state.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:milestoneType rdf:type rdf:Property ;
    rdfs:label 'Milestone Type' ;
    rdfs:comment 'Category of the construction milestone. COD refers to Commercial Operation Date. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:mitigationAction rdf:type rdf:Property ;
    rdfs:label 'Mitigation Action' ;
    rdfs:comment 'Description of corrective actions or mitigation measures being taken to address delays or risks to milestone achievement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentAmount rdf:type rdf:Property ;
    rdfs:label 'Payment Amount' ;
    rdfs:comment 'Payment amount in the project currency triggered upon milestone achievement, used for cash flow forecasting and capital call planning.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentTriggerFlag rdf:type rdf:Property ;
    rdfs:label 'Payment Trigger Flag' ;
    rdfs:comment 'Indicates whether achievement of this milestone triggers a capital call, drawdown, or payment to the General Partner (GP) or contractor.' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:plannedDate rdf:type rdf:Property ;
    rdfs:label 'Planned Date' ;
    rdfs:comment 'Originally scheduled date for milestone achievement as defined in the project plan or Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:ConstructionMilestone ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:regulatoryApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Regulatory Approval Required Flag' ;
    rdfs:comment 'Indicates whether this milestone requires regulatory approval or permit issuance before it can be achieved.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:responsibleParty rdf:type rdf:Property ;
    rdfs:label 'Responsible Party' ;
    rdfs:comment 'Name of the party responsible for delivering this milestone, typically the General Partner (GP), contractor, or engineering firm.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:varianceDays rdf:type rdf:Property ;
    rdfs:label 'Variance Days' ;
    rdfs:comment 'Number of days between baseline and actual or forecast date, positive indicating delay and negative indicating early completion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:fundNavReportId rdf:type rdf:Property ;
    rdfs:label 'Fund Nav Report Id' ;
    rdfs:comment 'Unique identifier for the fund NAV report record.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:capitalCalledAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Called Amount' ;
    rdfs:comment 'Amount of capital called from the LP during the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capitalDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Capital Distribution Amount' ;
    rdfs:comment 'Portion of distributions attributable to return of capital during the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:closingNav rdf:type rdf:Property ;
    rdfs:label 'Closing Nav' ;
    rdfs:comment 'LP share NAV at the end of the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fundTotalNav rdf:type rdf:Property ;
    rdfs:label 'Fund Total Nav' ;
    rdfs:comment 'Total Net Asset Value of the entire fund as reported by the GP for the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:incomeDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Income Distribution Amount' ;
    rdfs:comment 'Portion of distributions attributable to income during the reporting period.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:independentValuationFlag rdf:type rdf:Property ;
    rdfs:label 'Independent Valuation Flag' ;
    rdfs:comment 'Indicates whether an independent third-party valuation was performed for this reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:irrSinceInceptionPercent rdf:type rdf:Property ;
    rdfs:label 'Irr Since Inception Percent' ;
    rdfs:comment 'Internal Rate of Return for the LP investment since fund inception.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpShareNav rdf:type rdf:Property ;
    rdfs:label 'Lp Share Nav' ;
    rdfs:comment 'Net Asset Value attributable to the pension funds LP interest in the fund.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:materialEventsDescription rdf:type rdf:Property ;
    rdfs:label 'Material Events Description' ;
    rdfs:comment 'Description of any material events affecting the fund during the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:navCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Nav Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all NAV and financial amounts in this report.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:openingNav rdf:type rdf:Property ;
    rdfs:label 'Opening Nav' ;
    rdfs:comment 'LP share NAV at the beginning of the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:otherFeesExpenses rdf:type rdf:Property ;
    rdfs:label 'Other Fees Expenses' ;
    rdfs:comment 'Other fees and expenses charged to the LP during the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reconciliationNotes rdf:type rdf:Property ;
    rdfs:label 'Reconciliation Notes' ;
    rdfs:comment 'Notes documenting any discrepancies or issues identified during reconciliation.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportCommentary rdf:type rdf:Property ;
    rdfs:label 'Report Commentary' ;
    rdfs:comment 'Narrative commentary provided by the GP regarding fund performance and market conditions during the reporting period.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reportReceivedDate rdf:type rdf:Property ;
    rdfs:label 'Report Received Date' ;
    rdfs:comment 'Date on which the NAV report was received from the GP.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reportReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Report Reference Number' ;
    rdfs:comment 'External reference number or identifier assigned by the GP to this NAV report.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:rvpiRatio rdf:type rdf:Property ;
    rdfs:label 'Rvpi Ratio' ;
    rdfs:comment 'Residual Value to Paid-In capital multiple as of the reporting period end.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tvpiRatio rdf:type rdf:Property ;
    rdfs:label 'Tvpi Ratio' ;
    rdfs:comment 'Total Value to Paid-In capital multiple as of the reporting period end.' ;
    rdfs:domain ind:FundNavReport ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insurancePolicyId rdf:type rdf:Property ;
    rdfs:label 'Insurance Policy Id' ;
    rdfs:comment 'Unique identifier for the insurance policy record covering infrastructure assets.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:aggregateLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Aggregate Limit Amount' ;
    rdfs:comment 'Total maximum amount the insurer will pay for all claims combined during the entire policy period.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:annualPremiumAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Premium Amount' ;
    rdfs:comment 'Total annual premium cost payable to the insurer for maintaining the insurance coverage.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificateHolderName rdf:type rdf:Property ;
    rdfs:label 'Certificate Holder Name' ;
    rdfs:comment 'Name of the entity to whom a certificate of insurance is issued as proof of coverage.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:certificateOfInsuranceUrl rdf:type rdf:Property ;
    rdfs:label 'Certificate Of Insurance Url' ;
    rdfs:comment 'URL or file path to the certificate of insurance document issued for this policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsContactEmail rdf:type rdf:Property ;
    rdfs:label 'Claims Contact Email' ;
    rdfs:comment 'Email address for the claims contact at the insurer for electronic claims submission and correspondence.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsContactName rdf:type rdf:Property ;
    rdfs:label 'Claims Contact Name' ;
    rdfs:comment 'Name of the primary contact person at the insurer for filing and managing claims under this policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:claimsContactPhone rdf:type rdf:Property ;
    rdfs:label 'Claims Contact Phone' ;
    rdfs:comment 'Phone number for the claims contact at the insurer for reporting incidents and filing claims.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:endorsementsSummary rdf:type rdf:Property ;
    rdfs:label 'Endorsements Summary' ;
    rdfs:comment 'Summary of amendments, riders, or endorsements that modify the standard policy terms and conditions.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exclusionsSummary rdf:type rdf:Property ;
    rdfs:label 'Exclusions Summary' ;
    rdfs:comment 'Summary of perils, events, or circumstances explicitly excluded from coverage under the insurance policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicCoverageScope rdf:type rdf:Property ;
    rdfs:label 'Geographic Coverage Scope' ;
    rdfs:comment 'Description of the geographic territories or jurisdictions where the insurance coverage applies.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lossPayeeName rdf:type rdf:Property ;
    rdfs:label 'Loss Payee Name' ;
    rdfs:comment 'Name of the entity designated to receive insurance claim payments, typically a lender or secured creditor.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:occurrenceBasisFlag rdf:type rdf:Property ;
    rdfs:label 'Occurrence Basis Flag' ;
    rdfs:comment 'Indicates whether the policy covers incidents that occur during the policy period regardless of when the claim is filed.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:perOccurrenceLimitAmount rdf:type rdf:Property ;
    rdfs:label 'Per Occurrence Limit Amount' ;
    rdfs:comment 'Maximum amount the insurer will pay for a single claim event or occurrence under the policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Policy Document Url' ;
    rdfs:comment 'URL or file path to the complete insurance policy document and terms and conditions.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyNotes rdf:type rdf:Property ;
    rdfs:label 'Policy Notes' ;
    rdfs:comment 'Free-text field for additional notes, special conditions, or internal comments regarding the insurance policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:policyTermYears rdf:type rdf:Property ;
    rdfs:label 'Policy Term Years' ;
    rdfs:comment 'Duration of the insurance policy coverage period expressed in years from inception to expiry.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:policyType rdf:type rdf:Property ;
    rdfs:label 'Policy Type' ;
    rdfs:comment 'Classification of insurance coverage type aligned with infrastructure asset risk categories.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:premiumPaymentFrequency rdf:type rdf:Property ;
    rdfs:label 'Premium Payment Frequency' ;
    rdfs:comment 'Frequency at which premium payments are due to the insurer during the policy term.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reinsuranceArrangementFlag rdf:type rdf:Property ;
    rdfs:label 'Reinsurance Arrangement Flag' ;
    rdfs:comment 'Indicates whether the insurer has arranged reinsurance to transfer a portion of the risk to other insurers.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reinsurerNames rdf:type rdf:Property ;
    rdfs:label 'Reinsurer Names' ;
    rdfs:comment 'Names of reinsurance companies participating in the risk transfer arrangement for this policy.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sumInsuredAmount rdf:type rdf:Property ;
    rdfs:label 'Sum Insured Amount' ;
    rdfs:comment 'Maximum amount the insurer will pay in the event of a total loss or claim under the policy terms.' ;
    rdfs:domain ind:InsurancePolicy ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorContractId rdf:type rdf:Property ;
    rdfs:label 'Operator Contract Id' ;
    rdfs:comment 'Unique identifier for the operator contract record. Primary key for the operator contract entity.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:annualBaseFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Annual Base Fee Amount' ;
    rdfs:comment 'Fixed annual base fee payable to the operator for contracted services, excluding performance incentives or variable costs.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:changeOfControlConsentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Change Of Control Consent Required Flag' ;
    rdfs:comment 'Indicates whether the operator must obtain owner consent before undergoing a change of control or ownership.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:contractDocumentUrl rdf:type rdf:Property ;
    rdfs:label 'Contract Document Url' ;
    rdfs:comment 'Reference link or storage location for the executed operator contract document and related legal agreements.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractName rdf:type rdf:Property ;
    rdfs:label 'Contract Name' ;
    rdfs:comment 'Human-readable name or title of the operator contract for identification and reporting purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractNotes rdf:type rdf:Property ;
    rdfs:label 'Contract Notes' ;
    rdfs:comment 'Free-text field for additional notes, comments, or context regarding the operator contract.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Number' ;
    rdfs:comment 'Externally-known unique business identifier for the operator contract, used in legal documents and communications.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractStatus rdf:type rdf:Property ;
    rdfs:label 'Contract Status' ;
    rdfs:comment 'Current lifecycle status of the operator contract, indicating whether it is in negotiation, active, suspended, or terminated. [ENUM-REF-CANDIDATE: draft|negotiation|executed|active|suspended|terminated|expired — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractTermYears rdf:type rdf:Property ;
    rdfs:label 'Contract Term Years' ;
    rdfs:comment 'Duration of the operator contract in years, representing the initial term before any extensions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:feeCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Fee Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for all fee amounts in this contract.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeIndexationMechanism rdf:type rdf:Property ;
    rdfs:label 'Fee Indexation Mechanism' ;
    rdfs:comment 'Description of how fees are adjusted over time, such as inflation indexation, Consumer Price Index (CPI) linkage, or fixed escalation rates.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:feeStructureType rdf:type rdf:Property ;
    rdfs:label 'Fee Structure Type' ;
    rdfs:comment 'Classification of the fee arrangement, such as fixed fee, cost-plus, performance-based, or hybrid models.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:incentiveFeePercent rdf:type rdf:Property ;
    rdfs:label 'Incentive Fee Percent' ;
    rdfs:comment 'Percentage of performance-based incentive fee that can be earned by the operator for exceeding performance targets.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:insuranceResponsibility rdf:type rdf:Property ;
    rdfs:label 'Insurance Responsibility' ;
    rdfs:comment 'Party responsible for procuring and maintaining insurance coverage for the infrastructure asset and operations.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:keyPersonnelClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Key Personnel Clause Flag' ;
    rdfs:comment 'Indicates whether the contract includes key personnel provisions requiring specific individuals to remain assigned to the contract.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:paymentTermsDays rdf:type rdf:Property ;
    rdfs:label 'Payment Terms Days' ;
    rdfs:comment 'Number of days from invoice date within which payment to the operator is due.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:performanceKpiDescription rdf:type rdf:Property ;
    rdfs:label 'Performance Kpi Description' ;
    rdfs:comment 'Description of the key performance indicators and metrics used to measure operator performance, such as availability, uptime, and response times.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scopeOfServices rdf:type rdf:Property ;
    rdfs:label 'Scope Of Services' ;
    rdfs:comment 'Detailed description of the operational and management services the operator is contracted to provide, including maintenance, monitoring, and performance obligations.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:serviceLevelAgreementFlag rdf:type rdf:Property ;
    rdfs:label 'Service Level Agreement Flag' ;
    rdfs:comment 'Indicates whether the contract includes formal Service Level Agreement (SLA) performance targets and metrics.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:subcontractingPermittedFlag rdf:type rdf:Property ;
    rdfs:label 'Subcontracting Permitted Flag' ;
    rdfs:comment 'Indicates whether the operator is permitted to subcontract services to third parties.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:variableFeeBasis rdf:type rdf:Property ;
    rdfs:label 'Variable Fee Basis' ;
    rdfs:comment 'Description of the basis for variable or performance-based fees, such as revenue share, throughput, or availability metrics.' ;
    rdfs:domain ind:OperatorContract ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:infrastructureIcApprovalId rdf:type rdf:Property ;
    rdfs:label 'Infrastructure Ic Approval Id' ;
    rdfs:comment 'Unique identifier for the infrastructure Investment Committee approval record.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:approvalAuthorityLevel rdf:type rdf:Property ;
    rdfs:label 'Approval Authority Level' ;
    rdfs:comment 'The level of authority that granted this approval, indicating whether it was full Investment Committee, delegated authority, or Board-level approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvalDecisionDate rdf:type rdf:Property ;
    rdfs:label 'Approval Decision Date' ;
    rdfs:comment 'The date on which the Investment Committee formally rendered its approval decision.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Approval Expiry Date' ;
    rdfs:comment 'The date on which this Investment Committee approval expires if the investment has not been executed.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:approvalNotes rdf:type rdf:Property ;
    rdfs:label 'Approval Notes' ;
    rdfs:comment 'Additional notes, comments, or observations recorded by the Investment Committee regarding this infrastructure investment approval.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedCommitmentAmount rdf:type rdf:Property ;
    rdfs:label 'Approved Commitment Amount' ;
    rdfs:comment 'The total capital commitment amount approved by the Investment Committee for this infrastructure investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:approvedCommitmentCurrency rdf:type rdf:Property ;
    rdfs:label 'Approved Commitment Currency' ;
    rdfs:comment 'The three-letter ISO 4217 currency code for the approved commitment amount.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:approvedStructure rdf:type rdf:Property ;
    rdfs:label 'Approved Structure' ;
    rdfs:comment 'The investment structure approved by the Investment Committee for this infrastructure investment. [ENUM-REF-CANDIDATE: direct_equity|co_investment|fund_commitment|joint_venture|preferred_equity|mezzanine|debt — 7 candidates stripped; promote to reference' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetSubClass rdf:type rdf:Property ;
    rdfs:label 'Asset Sub Class' ;
    rdfs:comment 'The detailed sub-classification of the infrastructure asset within its primary asset class.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsPrecedent rdf:type rdf:Property ;
    rdfs:label 'Conditions Precedent' ;
    rdfs:comment 'Any conditions precedent that must be satisfied before the approved infrastructure investment can proceed to execution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:conditionsSubsequent rdf:type rdf:Property ;
    rdfs:label 'Conditions Subsequent' ;
    rdfs:comment 'Any conditions subsequent that must be satisfied after the infrastructure investment is executed.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icApprovalNumber rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Number' ;
    rdfs:comment 'Unique business identifier for the IC approval, used for tracking and reference in governance documentation.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icMeetingDate rdf:type rdf:Property ;
    rdfs:label 'Ic Meeting Date' ;
    rdfs:comment 'The date on which the Investment Committee convened to review and approve this infrastructure investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:icMemoReference rdf:type rdf:Property ;
    rdfs:label 'Ic Memo Reference' ;
    rdfs:comment 'Reference identifier for the Investment Memorandum presented to the Investment Committee for this approval.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:leverageRatioApproved rdf:type rdf:Property ;
    rdfs:label 'Leverage Ratio Approved' ;
    rdfs:comment 'The maximum leverage ratio approved by the Investment Committee for this infrastructure investment.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownershipPercentageApproved rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage Approved' ;
    rdfs:comment 'The percentage ownership stake in the infrastructure asset approved by the Investment Committee.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:strategicAlignmentScore rdf:type rdf:Property ;
    rdfs:label 'Strategic Alignment Score' ;
    rdfs:comment 'A score representing how well this infrastructure investment aligns with the organizations strategic asset allocation and investment objectives.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetNetIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Target Net Irr Percent' ;
    rdfs:comment 'The target net Internal Rate of Return percentage approved by the Investment Committee for this infrastructure investment.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:votingMembersPresent rdf:type rdf:Property ;
    rdfs:label 'Voting Members Present' ;
    rdfs:comment 'The number of Investment Committee voting members present at the meeting when this approval was granted.' ;
    rdfs:domain ind:InfrastructureIcApproval ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assetDispositionId rdf:type rdf:Property ;
    rdfs:label 'Asset Disposition Id' ;
    rdfs:comment 'Unique identifier for the infrastructure asset disposition transaction.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:advisorEntityActorId rdf:type rdf:Property ;
    rdfs:label 'Advisor Entity Actor Id' ;
    rdfs:comment 'Reference to the sell-side financial advisor or investment bank engaged to execute the disposition transaction.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:legalAdvisorEntityActorId rdf:type rdf:Property ;
    rdfs:label 'Legal Advisor Entity Actor Id' ;
    rdfs:comment 'Reference to the legal counsel engaged to advise on the disposition transaction and draft sale agreements.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:advisorFeeAmount rdf:type rdf:Property ;
    rdfs:label 'Advisor Fee Amount' ;
    rdfs:comment 'Total fees paid to sell-side financial advisors and investment banks for executing the disposition.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:buyerName rdf:type rdf:Property ;
    rdfs:label 'Buyer Name' ;
    rdfs:comment 'Legal name of the buyer or acquiring entity for the disposition transaction.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionName rdf:type rdf:Property ;
    rdfs:label 'Disposition Name' ;
    rdfs:comment 'Human-readable name or title of the disposition transaction for internal tracking and reporting.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionNotes rdf:type rdf:Property ;
    rdfs:label 'Disposition Notes' ;
    rdfs:comment 'Free-text notes capturing additional context, special conditions, or commentary on the disposition transaction.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionNumber rdf:type rdf:Property ;
    rdfs:label 'Disposition Number' ;
    rdfs:comment 'Externally-known unique transaction reference number for the disposition event.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionRationale rdf:type rdf:Property ;
    rdfs:label 'Disposition Rationale' ;
    rdfs:comment 'Strategic rationale and business justification for the disposition decision, including portfolio rebalancing, liquidity needs, or value realization objectives.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionStatus rdf:type rdf:Property ;
    rdfs:label 'Disposition Status' ;
    rdfs:comment 'Current state of the disposition transaction in its lifecycle workflow: planned for future exit, actively marketed to buyers, under negotiation with counterparty, legally signed awaiting close, completed and settled, cancelled or withdrawn, or temporarily' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dispositionType rdf:type rdf:Property ;
    rdfs:label 'Disposition Type' ;
    rdfs:comment 'Classification of the disposition structure: full exit of entire holding, partial sell-down of ownership stake, secondary sale of Limited Partner (LP) interest, Initial Public Offering (IPO) or public listing, trade sale to strategic buyer, management' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:distributionToLpsAmount rdf:type rdf:Property ;
    rdfs:label 'Distribution To Lps Amount' ;
    rdfs:comment 'Total amount distributed to Limited Partners (LPs) from the disposition proceeds after carried interest and fees.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnoutPotentialAmount rdf:type rdf:Property ;
    rdfs:label 'Earnout Potential Amount' ;
    rdfs:comment 'Maximum potential additional proceeds from earn-out provisions if performance targets are achieved.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:earnoutProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Earnout Provision Flag' ;
    rdfs:comment 'Boolean flag indicating whether the disposition includes an earn-out or contingent consideration provision based on future performance.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escrowAmount rdf:type rdf:Property ;
    rdfs:label 'Escrow Amount' ;
    rdfs:comment 'Amount of proceeds held in escrow to cover indemnity claims, representations and warranties, or earn-out provisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:escrowReleaseDate rdf:type rdf:Property ;
    rdfs:label 'Escrow Release Date' ;
    rdfs:comment 'Scheduled date for release of escrowed funds to the seller, subject to no claims being made.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exitEnterpriseValueAmount rdf:type rdf:Property ;
    rdfs:label 'Exit Enterprise Value Amount' ;
    rdfs:comment 'Total enterprise value of the asset at disposition, representing equity value plus net debt.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exitValuationMultiple rdf:type rdf:Property ;
    rdfs:label 'Exit Valuation Multiple' ;
    rdfs:comment 'Valuation multiple at exit such as Enterprise Value (EV) to Earnings Before Interest Taxes Depreciation and Amortization (EBITDA) multiple, used to benchmark exit pricing.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Gross Irr Percent' ;
    rdfs:comment 'Gross Internal Rate of Return (IRR) achieved on the investment from acquisition through disposition, before fees and carried interest.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossProceedsAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Proceeds Amount' ;
    rdfs:comment 'Total gross proceeds received from the buyer before deducting transaction costs, fees, and expenses.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netIrrPercent rdf:type rdf:Property ;
    rdfs:label 'Net Irr Percent' ;
    rdfs:comment 'Net Internal Rate of Return (IRR) achieved on the investment after deducting management fees, transaction costs, and carried interest.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netProceedsAmount rdf:type rdf:Property ;
    rdfs:label 'Net Proceeds Amount' ;
    rdfs:comment 'Net proceeds received after deducting all transaction costs, fees, and expenses from gross proceeds.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalCostBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Original Cost Basis Amount' ;
    rdfs:comment 'Original acquisition cost or invested capital amount in the asset being disposed, used for gain/loss calculation.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownershipPercentageDisposed rdf:type rdf:Property ;
    rdfs:label 'Ownership Percentage Disposed' ;
    rdfs:comment 'Percentage of total ownership stake being disposed in this transaction, expressed as a decimal percentage (e.g., 100.00 for full exit, 50.00 for half).' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proceedsCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Proceeds Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the disposition proceeds (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:retainedOwnershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Retained Ownership Percentage' ;
    rdfs:comment 'Percentage of ownership stake retained by the fund after the disposition transaction, relevant for partial sell-downs.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:saleStructure rdf:type rdf:Property ;
    rdfs:label 'Sale Structure' ;
    rdfs:comment 'Legal structure of the sale: asset sale transferring underlying assets, share sale transferring equity ownership, Limited Partner (LP) interest transfer in fund context, dual-track process running multiple exit routes, or stapled transaction combining' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signingDate rdf:type rdf:Property ;
    rdfs:label 'Signing Date' ;
    rdfs:comment 'Date on which the Share Purchase Agreement (SPA) or equivalent sale agreement was executed by all parties.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:transactionCostsAmount rdf:type rdf:Property ;
    rdfs:label 'Transaction Costs Amount' ;
    rdfs:comment 'Total transaction costs including advisory fees, legal fees, due diligence costs, and other expenses incurred to complete the disposition.' ;
    rdfs:domain ind:AssetDisposition ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonIntensityCategory rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Category' ;
    rdfs:comment 'Typical carbon emissions profile for assets in this sector (high for fossil fuel infrastructure, low for renewables, net zero for carbon-neutral operations).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:concessionBasedFlag rdf:type rdf:Property ;
    rdfs:label 'Concession Based Flag' ;
    rdfs:comment 'Indicates whether assets in this sector typically operate under concession agreements with government or public entities (True) or under freehold ownership (False).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:demandElasticity rdf:type rdf:Property ;
    rdfs:label 'Demand Elasticity' ;
    rdfs:comment 'Sensitivity of demand to economic cycles for assets in this sector (inelastic for essential utilities, elastic for discretionary transport).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgMaterialityRating rdf:type rdf:Property ;
    rdfs:label 'Esg Materiality Rating' ;
    rdfs:comment 'Assessment of ESG factor materiality for this sector (high for carbon-intensive sectors, medium for social infrastructure, low for digital).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geographicConcentration rdf:type rdf:Property ;
    rdfs:label 'Geographic Concentration' ;
    rdfs:comment 'Typical geographic scope of investments in this sector (global for digital infrastructure, regional for transport, domestic for utilities).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationLinkageType rdf:type rdf:Property ;
    rdfs:label 'Inflation Linkage Type' ;
    rdfs:comment 'Mechanism by which revenues in this sector are linked to inflation (direct for CPI-indexed tariffs, indirect for volume-driven, none for fixed contracts).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liabilityMatchingSuitability rdf:type rdf:Property ;
    rdfs:label 'Liability Matching Suitability' ;
    rdfs:comment 'Assessment of how well cash flows from this sector align with long-duration pension liabilities (high for regulated utilities, medium for contracted assets, low for merchant).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:liquidityProfile rdf:type rdf:Property ;
    rdfs:label 'Liquidity Profile' ;
    rdfs:comment 'Assessment of secondary market liquidity for assets in this sector (highly liquid for listed infrastructure, illiquid for direct private assets).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operationalComplexity rdf:type rdf:Property ;
    rdfs:label 'Operational Complexity' ;
    rdfs:comment 'Assessment of operational management requirements for assets in this sector (high for airports, medium for toll roads, low for fiber networks).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:parentSectorCode rdf:type rdf:Property ;
    rdfs:label 'Parent Sector Code' ;
    rdfs:comment 'Code of the parent sector in a hierarchical taxonomy; null for top-level sectors.' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatedFlag rdf:type rdf:Property ;
    rdfs:label 'Regulated Flag' ;
    rdfs:comment 'Indicates whether assets in this sector are typically subject to regulatory rate-of-return frameworks (True) or operate in competitive markets (False).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:regulatoryComplexity rdf:type rdf:Property ;
    rdfs:label 'Regulatory Complexity' ;
    rdfs:comment 'Assessment of regulatory oversight and compliance burden for assets in this sector (high for utilities, medium for transport, low for digital).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueModelType rdf:type rdf:Property ;
    rdfs:label 'Revenue Model Type' ;
    rdfs:comment 'Predominant revenue generation model for assets in this sector (availability payment, user pay, merchant, hybrid, regulated tariff, contracted).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sectorDescription rdf:type rdf:Property ;
    rdfs:label 'Sector Description' ;
    rdfs:comment 'Detailed description of the infrastructure sector, including typical asset types and investment characteristics.' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subSectorCode rdf:type rdf:Property ;
    rdfs:label 'Sub Sector Code' ;
    rdfs:comment 'Unique alphanumeric code identifying the infrastructure sub-sector (e.g., TOLL, ARPT, RAIL, SOLR, WIND, WATR, SEWG, HOSP, SCHL, FBRP, TWRS).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subSectorDescription rdf:type rdf:Property ;
    rdfs:label 'Sub Sector Description' ;
    rdfs:comment 'Detailed description of the infrastructure sub-sector, including operational characteristics and typical revenue models.' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subSectorName rdf:type rdf:Property ;
    rdfs:label 'Sub Sector Name' ;
    rdfs:comment 'Full name of the infrastructure sub-sector (e.g., Toll Roads, Airports, Rail, Solar, Wind, Water, Sewage, Hospitals, Schools, Fiber Optic, Towers).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:technologyDisruptionRisk rdf:type rdf:Property ;
    rdfs:label 'Technology Disruption Risk' ;
    rdfs:comment 'Assessment of exposure to technological obsolescence or disruption for assets in this sector (high for legacy telecom, low for essential utilities).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:typicalConcessionTermYears rdf:type rdf:Property ;
    rdfs:label 'Typical Concession Term Years' ;
    rdfs:comment 'Standard concession duration in years for assets in this sector (e.g., 25-30 years for toll roads, 50-99 years for airports).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:typicalLeverageRatio rdf:type rdf:Property ;
    rdfs:label 'Typical Leverage Ratio' ;
    rdfs:comment 'Standard debt-to-equity ratio for assets in this sector, expressed as a decimal (e.g., 0.60 represents 60% debt, 40% equity).' ;
    rdfs:domain ind:InfrastructureSectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:originalNoticeId rdf:type rdf:Property ;
    rdfs:label 'Original Notice Id' ;
    rdfs:comment 'Reference to the original capital call notice if this document is an amendment.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CapitalCallNoticeDocument .

ind:acknowledgmentDate rdf:type rdf:Property ;
    rdfs:label 'Acknowledgment Date' ;
    rdfs:comment 'Date when the limited partner acknowledged receipt of the capital call notice.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:assetSector rdf:type rdf:Property ;
    rdfs:label 'Asset Sector' ;
    rdfs:comment 'Sector classification of the target infrastructure asset or investment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountName rdf:type rdf:Property ;
    rdfs:label 'Bank Account Name' ;
    rdfs:comment 'Name of the bank account to which capital call funds should be transferred.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankSwiftCode rdf:type rdf:Property ;
    rdfs:label 'Bank Swift Code' ;
    rdfs:comment 'SWIFT/BIC code identifying the receiving bank for international wire transfers.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeCalledPercentage rdf:type rdf:Property ;
    rdfs:label 'Cumulative Called Percentage' ;
    rdfs:comment 'Total percentage of the limited partners commitment that has been called to date including this notice.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:documentFileName rdf:type rdf:Property ;
    rdfs:label 'Document File Name' ;
    rdfs:comment 'Name of the electronic file containing the capital call notice document.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFilePath rdf:type rdf:Property ;
    rdfs:label 'Document File Path' ;
    rdfs:comment 'Storage location path for the capital call notice document in the document management system.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentFormat rdf:type rdf:Property ;
    rdfs:label 'Document Format' ;
    rdfs:comment 'File format of the capital call notice document.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentVersion rdf:type rdf:Property ;
    rdfs:label 'Document Version' ;
    rdfs:comment 'Version number of the capital call notice document for tracking revisions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:investmentPurpose rdf:type rdf:Property ;
    rdfs:label 'Investment Purpose' ;
    rdfs:comment 'Description of the intended use of called capital such as acquisition, development, or follow-on investment.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isAmended rdf:type rdf:Property ;
    rdfs:label 'Is Amended' ;
    rdfs:comment 'Indicates whether this notice is an amendment to a previously issued capital call.' ;
    rdfs:domain ind:Infrastructure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:latePaymentInterestRate rdf:type rdf:Property ;
    rdfs:label 'Late Payment Interest Rate' ;
    rdfs:comment 'Interest rate applicable to late capital call payments as specified in the fund agreement.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:latePaymentPenaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Late Payment Penalty Amount' ;
    rdfs:comment 'Penalty amount assessed for late payment of the capital call.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:noticeDeliveryMethod rdf:type rdf:Property ;
    rdfs:label 'Notice Delivery Method' ;
    rdfs:comment 'Method by which the capital call notice was delivered to the limited partner.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:otherExpenseAmount rdf:type rdf:Property ;
    rdfs:label 'Other Expense Amount' ;
    rdfs:comment 'Portion of the capital call allocated to miscellaneous fund expenses not classified elsewhere.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:shortfallAmount rdf:type rdf:Property ;
    rdfs:label 'Shortfall Amount' ;
    rdfs:comment 'Difference between called amount and funded amount if the limited partner underfunded.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:signatoryName rdf:type rdf:Property ;
    rdfs:label 'Signatory Name' ;
    rdfs:comment 'Name of the authorized signatory who executed the capital call notice on behalf of the general partner.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:signatoryTitle rdf:type rdf:Property ;
    rdfs:label 'Signatory Title' ;
    rdfs:comment 'Title or position of the authorized signatory executing the capital call notice.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetAssetName rdf:type rdf:Property ;
    rdfs:label 'Target Asset Name' ;
    rdfs:comment 'Name of the infrastructure asset or project for which capital is being called, if disclosed.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireTransferInstructions rdf:type rdf:Property ;
    rdfs:label 'Wire Transfer Instructions' ;
    rdfs:comment 'Banking and wire transfer instructions for remitting the called capital to the fund.' ;
    rdfs:domain ind:CapitalCallNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:originalNoticeDocumentId rdf:type rdf:Property ;
    rdfs:label 'Original Notice Document Id' ;
    rdfs:comment 'Reference to the original distribution notice document if this is an amended notice.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DistributionNoticeDocument .

ind:amendmentReason rdf:type rdf:Property ;
    rdfs:label 'Amendment Reason' ;
    rdfs:comment 'Explanation for why the distribution notice was amended, if applicable.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:bankAccountDetails rdf:type rdf:Property ;
    rdfs:label 'Bank Account Details' ;
    rdfs:comment 'Designated bank account information for receiving the distribution payment (masked or tokenized for security).' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cumulativeContributions rdf:type rdf:Property ;
    rdfs:label 'Cumulative Contributions' ;
    rdfs:comment 'Total cumulative capital contributions made by the limited partner to the fund as of the distribution date.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionCategory rdf:type rdf:Property ;
    rdfs:label 'Distribution Category' ;
    rdfs:comment 'Category indicating the source or nature of the distribution (operating cash flow, asset realization, refinancing proceeds, dividend, other).' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:documentNumber rdf:type rdf:Property ;
    rdfs:label 'Document Number' ;
    rdfs:comment 'Externally-known unique business reference number assigned to the distribution notice document for tracking and correspondence.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossDistributionAmount rdf:type rdf:Property ;
    rdfs:label 'Gross Distribution Amount' ;
    rdfs:comment 'Total gross distribution amount before any withholding taxes, fees, or adjustments.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:lpOwnershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Lp Ownership Percentage' ;
    rdfs:comment 'Percentage ownership interest of the limited partner in the fund at the time of distribution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:managementFeeOffsetAmount rdf:type rdf:Property ;
    rdfs:label 'Management Fee Offset Amount' ;
    rdfs:comment 'Amount of management fee offset applied to the distribution as per partnership agreement terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navAfterDistribution rdf:type rdf:Property ;
    rdfs:label 'Nav After Distribution' ;
    rdfs:comment 'Limited partners net asset value in the fund immediately after the distribution.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:navBeforeDistribution rdf:type rdf:Property ;
    rdfs:label 'Nav Before Distribution' ;
    rdfs:comment 'Limited partners net asset value in the fund immediately before the distribution.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:realizedGainAmount rdf:type rdf:Property ;
    rdfs:label 'Realized Gain Amount' ;
    rdfs:comment 'Portion of the distribution representing realized capital gains from asset dispositions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingUnfundedCommitment rdf:type rdf:Property ;
    rdfs:label 'Remaining Unfunded Commitment' ;
    rdfs:comment 'Remaining unfunded capital commitment of the limited partner after accounting for all contributions and recallable distributions.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:returnOfCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Return Of Capital Amount' ;
    rdfs:comment 'Portion of the distribution representing return of the limited partners original capital contribution.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:underlyingAssetName rdf:type rdf:Property ;
    rdfs:label 'Underlying Asset Name' ;
    rdfs:comment 'Name of the underlying infrastructure asset or investment generating the distribution proceeds.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:wireInstructionsReference rdf:type rdf:Property ;
    rdfs:label 'Wire Instructions Reference' ;
    rdfs:comment 'Reference to standing wire instructions on file for the limited partner.' ;
    rdfs:domain ind:DistributionNoticeDocument ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditRightsFlag rdf:type rdf:Property ;
    rdfs:label 'Audit Rights Flag' ;
    rdfs:comment 'Indicates whether the pension fund has contractual rights to audit the asset or vehicle financials.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:boardSeatCount rdf:type rdf:Property ;
    rdfs:label 'Board Seat Count' ;
    rdfs:comment 'Number of board seats or governance positions allocated to the pension fund under this agreement.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carriedInterestPercentage rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Percentage' ;
    rdfs:comment 'Performance fee or carried interest rate payable to the general partner or manager on profits.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:disputeResolutionMethod rdf:type rdf:Property ;
    rdfs:label 'Dispute Resolution Method' ;
    rdfs:comment 'Contractually agreed mechanism for resolving disputes arising under the ownership agreement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:economicInterestPercentage rdf:type rdf:Property ;
    rdfs:label 'Economic Interest Percentage' ;
    rdfs:comment 'Percentage of economic interest entitling the fund to distributions and capital returns from the asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Esg Compliance Required' ;
    rdfs:comment 'Indicates whether the agreement mandates Environmental, Social, and Governance compliance standards.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgReportingFrequency rdf:type rdf:Property ;
    rdfs:label 'Esg Reporting Frequency' ;
    rdfs:comment 'Frequency at which ESG performance reports must be provided under the agreement terms.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundedCapitalAmount rdf:type rdf:Property ;
    rdfs:label 'Funded Capital Amount' ;
    rdfs:comment 'Cumulative capital amount actually funded or drawn down under this ownership agreement to date.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hasAntiDilutionProtection rdf:type rdf:Property ;
    rdfs:label 'Has Anti Dilution Protection' ;
    rdfs:comment 'Indicates whether the agreement includes anti-dilution provisions protecting the ownership percentage.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasInformationRights rdf:type rdf:Property ;
    rdfs:label 'Has Information Rights' ;
    rdfs:comment 'Indicates whether the agreement grants enhanced information and reporting rights to the pension fund.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:hasVetoRights rdf:type rdf:Property ;
    rdfs:label 'Has Veto Rights' ;
    rdfs:comment 'Indicates whether the pension fund holds veto rights over material decisions under this agreement.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:legalEntityJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code where the holding legal entity is domiciled.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:legalEntityName rdf:type rdf:Property ;
    rdfs:label 'Legal Entity Name' ;
    rdfs:comment 'Name of the special purpose vehicle or legal entity holding the ownership interest.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lockUpPeriodMonths rdf:type rdf:Property ;
    rdfs:label 'Lock Up Period Months' ;
    rdfs:comment 'Duration in months during which the ownership interest cannot be transferred or sold.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:managementFeePercentage rdf:type rdf:Property ;
    rdfs:label 'Management Fee Percentage' ;
    rdfs:comment 'Annual management fee rate charged on committed or invested capital under this ownership structure.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:preferredReturnPercentage rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Percentage' ;
    rdfs:comment 'Hurdle rate or preferred return threshold that must be achieved before carried interest is payable.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ownershipAgreementStatus rdf:type rdf:Property ;
    rdfs:label 'Ownership Agreement Status' ;
    rdfs:comment 'Current state of the ownership agreement within its lifecycle from inception to termination.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:votingRightsPercentage rdf:type rdf:Property ;
    rdfs:label 'Voting Rights Percentage' ;
    rdfs:comment 'Percentage of voting rights allocated to the pension fund under the governance provisions of the agreement.' ;
    rdfs:domain ind:OwnershipAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:assetManagerGpProfileId rdf:type rdf:Property ;
    rdfs:label 'Asset Manager Gp Profile Id' ;
    rdfs:comment 'Foreign key linking to manager.gp_profile. Business justification: Asset manager assignment is required for performance reporting and regulatory compliance.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:GpProfile .

ind:auditFindingId rdf:type rdf:Property ;
    rdfs:label 'Audit Finding Id' ;
    rdfs:comment 'Foreign key linking to compliance.audit_finding. Business justification: Audit findings related to asset operations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:AuditFinding .

ind:certificationId rdf:type rdf:Property ;
    rdfs:label 'Certification Id' ;
    rdfs:comment 'Foreign key linking to compliance.certification. Business justification: Certifications (ISO, etc.) for asset.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Certification .

ind:operatorActorId rdf:type rdf:Property ;
    rdfs:label 'Operator Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Captures operator entity for regulatory and ESG reporting, required for compliance and reporting.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:policyDocumentId rdf:type rdf:Property ;
    rdfs:label 'Policy Document Id' ;
    rdfs:comment 'Foreign key linking to compliance.policy_document. Business justification: Asset-specific ESG policy documents.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:PolicyDocument .

ind:sfdrDisclosureId rdf:type rdf:Property ;
    rdfs:label 'Sfdr Disclosure Id' ;
    rdfs:comment 'Foreign key linking to compliance.sfdr_disclosure. Business justification: SFDR disclosure for asset sustainability metrics.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:SfdrDisclosure .

ind:annualProductionCapacity rdf:type rdf:Property ;
    rdfs:label 'Annual Production Capacity' ;
    rdfs:comment 'Estimated annual production or harvest capacity of the resource asset in the unit specified by production_unit_of_measure.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:areaUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Area Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the total_area field.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:assetIdentifier rdf:type rdf:Property ;
    rdfs:label 'Asset Identifier' ;
    rdfs:comment 'Externally-recognized unique code or registration number for the resource asset (e.g., cadastral parcel ID, mining concession number, lease block identifier, title deed reference).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonFootprint rdf:type rdf:Property ;
    rdfs:label 'Carbon Footprint' ;
    rdfs:comment 'Estimated annual greenhouse gas (GHG) emissions attributable to the resource asset, measured in tonnes of CO2 equivalent.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionMethod rdf:type rdf:Property ;
    rdfs:label 'Depletion Method' ;
    rdfs:comment 'Accounting method used to allocate the cost of the resource asset over its productive life.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalCertification rdf:type rdf:Property ;
    rdfs:label 'Environmental Certification' ;
    rdfs:comment 'Environmental or sustainability certifications held by the resource asset (e.g., FSC for timberland, ISO 14001, LEED, organic certification for farmland).' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedUsefulLifeYears rdf:type rdf:Property ;
    rdfs:label 'Estimated Useful Life Years' ;
    rdfs:comment 'Estimated remaining productive life of the resource asset in years, based on current reserve estimates and production rates.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:insuranceCoverage rdf:type rdf:Property ;
    rdfs:label 'Insurance Coverage' ;
    rdfs:comment 'Total insurance coverage amount for the resource asset, including property, liability, and operational risk insurance, in base currency (USD).' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:nextInspectionDate rdf:type rdf:Property ;
    rdfs:label 'Next Inspection Date' ;
    rdfs:comment 'Scheduled date for the next physical inspection, audit, or operational review of the resource asset.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:permitExpiryDate rdf:type rdf:Property ;
    rdfs:label 'Permit Expiry Date' ;
    rdfs:comment 'Expiration date of the primary regulatory permit or concession for the resource asset.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:productionUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Production Unit Of Measure' ;
    rdfs:comment 'Unit of measure for annual_production_capacity (e.g., \'barrels_per_day\', \'tonnes_per_year\', \'megawatt_hours\').' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productiveArea rdf:type rdf:Property ;
    rdfs:label 'Productive Area' ;
    rdfs:comment 'Portion of total area that is actively productive or economically harvestable, in the same unit as total_area.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryPermits rdf:type rdf:Property ;
    rdfs:label 'Regulatory Permits' ;
    rdfs:comment 'Key regulatory permits, licenses, or concessions held for the operation of the resource asset (e.g., mining permit, drilling license, water rights).' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveClassification rdf:type rdf:Property ;
    rdfs:label 'Reserve Classification' ;
    rdfs:comment 'Confidence classification of the reserve estimate per industry standards (e.g., PRMS for oil & gas, JORC for mining).' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveQuantity rdf:type rdf:Property ;
    rdfs:label 'Reserve Quantity' ;
    rdfs:comment 'Estimated proven or probable reserves of the resource (e.g., barrels of oil, cubic meters of timber, tonnes of ore) in the unit specified by reserve_unit_of_measure.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Reserve Unit Of Measure' ;
    rdfs:comment 'Unit of measure for reserve_quantity (e.g., \'barrels\', \'cubic_meters\', \'tonnes\', \'board_feet\').' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceSubtype rdf:type rdf:Property ;
    rdfs:label 'Resource Subtype' ;
    rdfs:comment 'Detailed sub-classification within the resource type (e.g., \'softwood timberland\', \'row crop farmland\', \'gold mining\', \'offshore oil\', \'solar farm\', \'wind farm\').' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceType rdf:type rdf:Property ;
    rdfs:label 'Resource Type' ;
    rdfs:comment 'Primary classification of the natural resource asset by resource category.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalArea rdf:type rdf:Property ;
    rdfs:label 'Total Area' ;
    rdfs:comment 'Total physical area or acreage of the resource asset in the unit specified by area_unit_of_measure.' ;
    rdfs:domain ind:ResourceAsset ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceHoldingId rdf:type rdf:Property ;
    rdfs:label 'Resource Holding Id' ;
    rdfs:comment 'Unique identifier for the natural resource holding record. Primary key for the resource holding entity.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceHolding .

ind:generalPartnerActorId rdf:type rdf:Property ;
    rdfs:label 'General Partner Actor Id' ;
    rdfs:comment 'Foreign key linking to shared.actor. Business justification: Links general partner legal entity for capital call, fee calculation, and compliance monitoring.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Actor .

ind:resourceVehicleId rdf:type rdf:Property ;
    rdfs:label 'Resource Vehicle Id' ;
    rdfs:comment 'Reference to the natural resource investment vehicle or fund in which the pension fund holds an economic interest.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceVehicle .

ind:commodityPriceExposure rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Exposure' ;
    rdfs:comment 'Primary commodity or commodities to which this natural resource holding has price exposure, such as timber, corn, gold, crude oil, or natural gas.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:costBasisAmount rdf:type rdf:Property ;
    rdfs:label 'Cost Basis Amount' ;
    rdfs:comment 'Original acquisition cost or book value of the natural resource holding, used for gain/loss calculation and accounting purposes.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDistributionsAmount rdf:type rdf:Property ;
    rdfs:label 'Cumulative Distributions Amount' ;
    rdfs:comment 'Total distributions received by the pension fund from this natural resource holding since inception, including income, return of capital, and realized gains.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:custodianCode rdf:type rdf:Property ;
    rdfs:label 'Custodian Code' ;
    rdfs:comment 'Reference to the custodian bank or fund administrator holding legal custody of the investment documents and assets.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:depletionRatePercentage rdf:type rdf:Property ;
    rdfs:label 'Depletion Rate Percentage' ;
    rdfs:comment 'Annual depletion rate applied to the natural resource asset for accounting and valuation purposes, expressed as a percentage.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:expectedHarvestDate rdf:type rdf:Property ;
    rdfs:label 'Expected Harvest Date' ;
    rdfs:comment 'Anticipated date for major harvest or production event for the natural resource asset, such as timber harvest, crop harvest, or mine production commencement.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:holdingType rdf:type rdf:Property ;
    rdfs:label 'Holding Type' ;
    rdfs:comment 'Classification of the natural resource holding structure: direct ownership of physical assets, limited partner commitment to a fund, co-investment alongside a sponsor, fund of funds allocation, secondary market purchase, or joint venture participation.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:irrPercentage rdf:type rdf:Property ;
    rdfs:label 'Irr Percentage' ;
    rdfs:comment 'Annualized internal rate of return on the natural resource holding, calculated using cash flows and current NAV.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:isCoInvestment rdf:type rdf:Property ;
    rdfs:label 'Is Co Investment' ;
    rdfs:comment 'Boolean flag indicating whether this holding represents a co-investment alongside a general partner or lead investor, typically with reduced or no management fees.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:nextValuationDate rdf:type rdf:Property ;
    rdfs:label 'Next Valuation Date' ;
    rdfs:comment 'Scheduled date for the next formal valuation of the natural resource holding, typically quarterly or annually.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:productionUnit rdf:type rdf:Property ;
    rdfs:label 'Production Unit' ;
    rdfs:comment 'Unit of measure for production volume, such as board feet, metric tons, bushels, barrels, cubic meters, or troy ounces.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionVolume rdf:type rdf:Property ;
    rdfs:label 'Production Volume' ;
    rdfs:comment 'Current or projected annual production volume from the natural resource asset, measured in asset-specific units such as board feet for timber, bushels for crops, ounces for precious metals, or barrels for oil.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceAssetClass rdf:type rdf:Property ;
    rdfs:label 'Resource Asset Class' ;
    rdfs:comment 'Primary natural resource asset class category for this holding: timberland, farmland, mining operations, energy assets, or commodity-linked investments.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:resourceSubClass rdf:type rdf:Property ;
    rdfs:label 'Resource Sub Class' ;
    rdfs:comment 'Detailed sub-classification within the resource asset class, such as softwood timberland, row crop farmland, precious metals mining, oil and gas upstream, or commodity futures strategy.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:sustainabilityCertification rdf:type rdf:Property ;
    rdfs:label 'Sustainability Certification' ;
    rdfs:comment 'Sustainability or environmental certification held by the natural resource asset, such as Forest Stewardship Council (FSC) for timberland, USDA Organic for farmland, or Responsible Mining Initiative certification.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalValueAmount rdf:type rdf:Property ;
    rdfs:label 'Total Value Amount' ;
    rdfs:comment 'Sum of current NAV and cumulative distributions, representing the total value generated by the holding to date.' ;
    rdfs:domain ind:ResourceHolding ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionRecordId rdf:type rdf:Property ;
    rdfs:label 'Production Record Id' ;
    rdfs:comment 'Unique identifier for the production record. Primary key for the production record entity.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:auditCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Audit Completion Date' ;
    rdfs:comment 'Date when external audit or verification of the production record was completed. Marks transition to final status for NAV purposes.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:auditorVerificationFlag rdf:type rdf:Property ;
    rdfs:label 'Auditor Verification Flag' ;
    rdfs:comment 'Indicates whether the production record has been independently verified by external auditors. Required for final NAV calculation and regulatory reporting.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkCommodityPrice rdf:type rdf:Property ;
    rdfs:label 'Benchmark Commodity Price' ;
    rdfs:comment 'Market benchmark price for the commodity during the reporting period (e.g., WTI crude, LME copper, regional timber index). Used for performance attribution and variance analysis.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:certificationType rdf:type rdf:Property ;
    rdfs:label 'Certification Type' ;
    rdfs:comment 'Type of sustainability or responsible sourcing certification held by the asset (e.g., FSC for timber, organic certification for farmland, Equator Principles for mining). Enhances ESG profile and market access.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityGrade rdf:type rdf:Property ;
    rdfs:label 'Commodity Grade' ;
    rdfs:comment 'Quality classification or grade of the produced commodity. Affects pricing and marketability (e.g., timber grade, ore purity, crude oil API gravity, crop quality).' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contractReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Contract Reference Number' ;
    rdfs:comment 'Reference identifier for the production or offtake contract governing this production activity. Links production data to contractual terms and pricing mechanisms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dataQualityScore rdf:type rdf:Property ;
    rdfs:label 'Data Quality Score' ;
    rdfs:comment 'Quality score for the production data on a scale of 0.00 to 1.00. Reflects completeness, accuracy, and timeliness. Used to assess confidence in valuation inputs.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depletionCharge rdf:type rdf:Property ;
    rdfs:label 'Depletion Charge' ;
    rdfs:comment 'Accounting charge representing the reduction in resource reserves due to extraction. Calculated using units-of-production method for natural resource assets.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalIncidentFlag rdf:type rdf:Property ;
    rdfs:label 'Environmental Incident Flag' ;
    rdfs:comment 'Indicates whether an environmental incident (spill, contamination, habitat damage) occurred during the production period. Critical for ESG reporting and risk management.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:ghgEmissionsTonnesCo2e rdf:type rdf:Property ;
    rdfs:label 'Ghg Emissions Tonnes Co2e' ;
    rdfs:comment 'Total greenhouse gas emissions generated during production, measured in tonnes of CO2 equivalent. Required for ESG integration and TCFD climate risk reporting.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossRevenue rdf:type rdf:Property ;
    rdfs:label 'Gross Revenue' ;
    rdfs:comment 'Total revenue generated from production before deducting operating costs, royalties, and taxes. Calculated as production volume multiplied by realized price.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:harvestMethod rdf:type rdf:Property ;
    rdfs:label 'Harvest Method' ;
    rdfs:comment 'Operational method used to extract or harvest the resource. Impacts cost structure, ESG metrics, and depletion rate calculations. [ENUM-REF-CANDIDATE' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:hedgingInstrumentFlag rdf:type rdf:Property ;
    rdfs:label 'Hedging Instrument Flag' ;
    rdfs:comment 'Indicates whether commodity price hedging instruments (futures, swaps, collars) were in place for this production. Affects realized price and risk exposure.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatingCost rdf:type rdf:Property ;
    rdfs:label 'Operating Cost' ;
    rdfs:comment 'Direct operating expenses incurred to produce the resource output during the reporting period. Includes labor, equipment, materials, and site maintenance.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceRealizationPercentage rdf:type rdf:Property ;
    rdfs:label 'Price Realization Percentage' ;
    rdfs:comment 'Percentage of benchmark commodity price achieved in actual sales. Measures pricing effectiveness and quality premium/discount relative to market.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:pricingCurrency rdf:type rdf:Property ;
    rdfs:label 'Pricing Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the realized price. Natural resource commodities often priced in USD but may vary by market and contract.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionEfficiencyRate rdf:type rdf:Property ;
    rdfs:label 'Production Efficiency Rate' ;
    rdfs:comment 'Percentage of planned production achieved during the reporting period. Measures operational performance against targets and identifies underperforming assets.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionStatus rdf:type rdf:Property ;
    rdfs:label 'Production Status' ;
    rdfs:comment 'Current validation status of the production record. Tracks progression from preliminary field data through audit and final confirmation for NAV calculation.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:realizedPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Realized Price Per Unit' ;
    rdfs:comment 'Actual price received per unit of production during the reporting period. Used for revenue recognition and performance attribution analysis.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recordUpdatedBy rdf:type rdf:Property ;
    rdfs:label 'Record Updated By' ;
    rdfs:comment 'Identifier of the user or system that last updated the production record. Supports accountability and audit trail requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:regulatoryComplianceStatus rdf:type rdf:Property ;
    rdfs:label 'Regulatory Compliance Status' ;
    rdfs:comment 'Current compliance status with applicable environmental, safety, and operational regulations. Non-compliance can trigger operational shutdowns and financial penalties.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:remainingReservesEstimate rdf:type rdf:Property ;
    rdfs:label 'Remaining Reserves Estimate' ;
    rdfs:comment 'Estimated quantity of recoverable resource remaining after this production period. Updated based on production data and reserve studies for long-term planning.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveLifeYears rdf:type rdf:Property ;
    rdfs:label 'Reserve Life Years' ;
    rdfs:comment 'Estimated number of years of remaining production at current extraction rates. Critical metric for long-duration liability matching and asset allocation decisions.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyPayment rdf:type rdf:Property ;
    rdfs:label 'Royalty Payment' ;
    rdfs:comment 'Royalty or lease payment owed to landowners, governments, or mineral rights holders based on production volume or revenue. Common in mining and oil/gas.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:safetyIncidentCount rdf:type rdf:Property ;
    rdfs:label 'Safety Incident Count' ;
    rdfs:comment 'Number of recordable safety incidents (injuries, near-misses) during the production period. Key operational risk and ESG metric for natural resource operations.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:thirdPartyOperatorFlag rdf:type rdf:Property ;
    rdfs:label 'Third Party Operator Flag' ;
    rdfs:comment 'Indicates whether production operations are managed by a third-party operator under contract rather than directly by the fund. Affects operational control and risk profile.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:waterUsageUnit rdf:type rdf:Property ;
    rdfs:label 'Water Usage Unit' ;
    rdfs:comment 'Unit of measure for water usage volume. Varies by jurisdiction and industry practice.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:waterUsageVolume rdf:type rdf:Property ;
    rdfs:label 'Water Usage Volume' ;
    rdfs:comment 'Volume of water consumed during production operations. Critical ESG metric for water-intensive activities like mining, oil/gas extraction, and irrigation.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:weatherImpactFlag rdf:type rdf:Property ;
    rdfs:label 'Weather Impact Flag' ;
    rdfs:comment 'Indicates whether production was materially affected by adverse weather conditions (drought, flood, frost, hurricane). Relevant for farmland and timber assets.' ;
    rdfs:domain ind:ProductionRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commodityExposureId rdf:type rdf:Property ;
    rdfs:label 'Commodity Exposure Id' ;
    rdfs:comment 'Unique identifier for the commodity exposure record.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naturalResourceAssetId rdf:type rdf:Property ;
    rdfs:label 'Natural Resource Asset Id' ;
    rdfs:comment 'Reference to the underlying natural resource asset (timberland, farmland, mining, energy) generating the commodity exposure.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceAsset .

ind:benchmarkCommodityIndex rdf:type rdf:Property ;
    rdfs:label 'Benchmark Commodity Index' ;
    rdfs:comment 'Reference commodity index or benchmark used to measure relative performance and price risk (e.g., Bloomberg Commodity Index, S&P GSCI, BCOM Agriculture).' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkTicker rdf:type rdf:Property ;
    rdfs:label 'Benchmark Ticker' ;
    rdfs:comment 'Bloomberg or exchange ticker symbol for the benchmark commodity index or futures contract.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commoditySubtype rdf:type rdf:Property ;
    rdfs:label 'Commodity Subtype' ;
    rdfs:comment 'Detailed subtype or grade of the commodity (e.g., WTI crude, Brent crude, hard red winter wheat, softwood lumber).' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityType rdf:type rdf:Property ;
    rdfs:label 'Commodity Type' ;
    rdfs:comment 'Type of commodity to which the fund has price exposure through natural resource holdings. [ENUM-REF-CANDIDATE: lumber|wheat|corn|soy|crude_oil|natural_gas|copper|gold|iron_ore|silver|platinum|coal|uranium|nickel|zinc|aluminum — 16 candidates stripped' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:correlationToPortfolio rdf:type rdf:Property ;
    rdfs:label 'Correlation To Portfolio' ;
    rdfs:comment 'Statistical correlation coefficient between commodity price movements and overall portfolio returns, used for diversification analysis.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionRateAnnual rdf:type rdf:Property ;
    rdfs:label 'Depletion Rate Annual' ;
    rdfs:comment 'Annual depletion rate of commodity reserves as a percentage, used for reserve life and valuation modeling.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgCarbonIntensity rdf:type rdf:Property ;
    rdfs:label 'Esg Carbon Intensity' ;
    rdfs:comment 'Carbon intensity of commodity production measured in metric tons CO2 equivalent per unit of commodity produced.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:esgWaterUsageIntensity rdf:type rdf:Property ;
    rdfs:label 'Esg Water Usage Intensity' ;
    rdfs:comment 'Water consumption intensity for commodity production measured in cubic meters per unit of commodity produced.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureClassification rdf:type rdf:Property ;
    rdfs:label 'Exposure Classification' ;
    rdfs:comment 'Classification of how the commodity exposure arises (direct production, reserves, contractual commitments, or fund investments).' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exposureDurationYears rdf:type rdf:Property ;
    rdfs:label 'Exposure Duration Years' ;
    rdfs:comment 'Expected duration of commodity price exposure in years, based on production schedules, reserve life, or contract terms.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureNotionalUsd rdf:type rdf:Property ;
    rdfs:label 'Exposure Notional Usd' ;
    rdfs:comment 'Notional value of commodity price exposure in USD, representing the market value of the underlying commodity production or reserves.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposurePercentageOfAum rdf:type rdf:Property ;
    rdfs:label 'Exposure Percentage Of Aum' ;
    rdfs:comment 'Commodity exposure expressed as a percentage of total AUM, used for portfolio concentration risk monitoring.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forwardCurveContangoBackwardation rdf:type rdf:Property ;
    rdfs:label 'Forward Curve Contango Backwardation' ;
    rdfs:comment 'Current shape of the commodity forward price curve, indicating market expectations and storage costs.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fxRateToReportingCurrency rdf:type rdf:Property ;
    rdfs:label 'Fx Rate To Reporting Currency' ;
    rdfs:comment 'Exchange rate used to convert local commodity prices to reporting currency at measurement date.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgeRatioPercentage rdf:type rdf:Property ;
    rdfs:label 'Hedge Ratio Percentage' ;
    rdfs:comment 'Percentage of commodity exposure that is hedged through derivatives or forward contracts, used for risk mitigation analysis.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:hedgingInstrumentType rdf:type rdf:Property ;
    rdfs:label 'Hedging Instrument Type' ;
    rdfs:comment 'Type of derivative instrument used to hedge commodity price risk, if any.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceSensitivityDv01 rdf:type rdf:Property ;
    rdfs:label 'Price Sensitivity Dv01' ;
    rdfs:comment 'Dollar value change in exposure for a 1% move in commodity price, used for risk analytics and stress testing.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Price Unit Of Measure' ;
    rdfs:comment 'Unit of measure for commodity pricing (e.g., per barrel, per bushel, per metric ton, per troy ounce, per MMBtu).' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionVolumeAnnual rdf:type rdf:Property ;
    rdfs:label 'Production Volume Annual' ;
    rdfs:comment 'Expected annual production volume of the commodity from the underlying natural resource asset.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityExposed rdf:type rdf:Property ;
    rdfs:label 'Quantity Exposed' ;
    rdfs:comment 'Physical quantity of commodity to which the fund is exposed through production, reserves, or contractual commitments.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Quantity Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the exposed commodity quantity (e.g., barrels, bushels, metric tons, troy ounces, cubic meters).' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:spotPricePerUnit rdf:type rdf:Property ;
    rdfs:label 'Spot Price Per Unit' ;
    rdfs:comment 'Current spot market price per unit of the commodity at the measurement date.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:varContributionUsd rdf:type rdf:Property ;
    rdfs:label 'Var Contribution Usd' ;
    rdfs:comment 'Contribution of this commodity exposure to the overall portfolio VaR, calculated at 95% confidence level.' ;
    rdfs:domain ind:CommodityExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionScheduleId rdf:type rdf:Property ;
    rdfs:label 'Depletion Schedule Id' ;
    rdfs:comment 'Unique identifier for the depletion schedule record. Primary key for asset-level depletion tracking of wasting natural resource assets.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:DepletionSchedule .

ind:reserveEstimateId rdf:type rdf:Property ;
    rdfs:label 'Reserve Estimate Id' ;
    rdfs:comment 'Foreign key linking to naturalresource.reserve_estimate. Business justification: Depletion schedules for wasting assets are calculated based on reserve estimates (units-of-production method).' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReserveEstimate .

ind:acquisitionCostCurrency rdf:type rdf:Property ;
    rdfs:label 'Acquisition Cost Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the acquisition cost amount.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:commodityPriceAssumption rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Assumption' ;
    rdfs:comment 'Long-term commodity price assumption used in reserve valuation and depletion rate calculations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeDepletionToDate rdf:type rdf:Property ;
    rdfs:label 'Cumulative Depletion To Date' ;
    rdfs:comment 'Total depletion expense recognized from acquisition date through current reporting period.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeImpairmentLoss rdf:type rdf:Property ;
    rdfs:label 'Cumulative Impairment Loss' ;
    rdfs:comment 'Total impairment losses recognized on the asset to date, reducing the carrying value below depletable base less depletion.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cumulativeProductionToDate rdf:type rdf:Property ;
    rdfs:label 'Cumulative Production To Date' ;
    rdfs:comment 'Total quantity of reserves extracted or harvested from acquisition date through current reporting period.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPeriodDepletion rdf:type rdf:Property ;
    rdfs:label 'Current Period Depletion' ;
    rdfs:comment 'Depletion expense recognized for the current reporting period based on production volume and depletion rate.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:currentPeriodProduction rdf:type rdf:Property ;
    rdfs:label 'Current Period Production' ;
    rdfs:comment 'Quantity of reserves extracted or harvested during the current reporting period.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletableBase rdf:type rdf:Property ;
    rdfs:label 'Depletable Base' ;
    rdfs:comment 'Total cost basis subject to depletion, typically acquisition cost less estimated residual land value.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionRatePerUnit rdf:type rdf:Property ;
    rdfs:label 'Depletion Rate Per Unit' ;
    rdfs:comment 'Cost per unit of production used to calculate depletion expense, computed as depletable base divided by total proven reserves.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:depletionScheduleStatus rdf:type rdf:Property ;
    rdfs:label 'Depletion Schedule Status' ;
    rdfs:comment 'Current lifecycle status of the depletion schedule reflecting asset operational state.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalReclamationReserve rdf:type rdf:Property ;
    rdfs:label 'Environmental Reclamation Reserve' ;
    rdfs:comment 'Accrued liability for future environmental reclamation and site restoration costs associated with resource extraction.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimatedDepletionCompletionDate rdf:type rdf:Property ;
    rdfs:label 'Estimated Depletion Completion Date' ;
    rdfs:comment 'Projected date when the asset will be fully depleted based on current production rates and remaining reserves.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:externalReserveEngineer rdf:type rdf:Property ;
    rdfs:label 'External Reserve Engineer' ;
    rdfs:comment 'Name of the independent third-party reserve engineer or consultant who certified the proven reserve estimates.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:impairmentIndicatorFlag rdf:type rdf:Property ;
    rdfs:label 'Impairment Indicator Flag' ;
    rdfs:comment 'Indicates whether impairment indicators have been identified requiring impairment testing under IAS 36 or FASB ASC 360.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:impairmentTestDate rdf:type rdf:Property ;
    rdfs:label 'Impairment Test Date' ;
    rdfs:comment 'Date of the most recent impairment test performed on the natural resource asset.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:lastReserveCertificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Reserve Certification Date' ;
    rdfs:comment 'Date when proven reserves were last certified by an independent reserve engineer.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:netBookValue rdf:type rdf:Property ;
    rdfs:label 'Net Book Value' ;
    rdfs:comment 'Current carrying value of the natural resource asset, calculated as depletable base less cumulative depletion to date.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:remainingReserves rdf:type rdf:Property ;
    rdfs:label 'Remaining Reserves' ;
    rdfs:comment 'Current estimate of remaining recoverable reserves after cumulative depletion, updated periodically based on reserve studies.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reserveRevisionDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Revision Date' ;
    rdfs:comment 'Date of the most recent reserve study or revision that updated proven reserve estimates.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveRevisionReason rdf:type rdf:Property ;
    rdfs:label 'Reserve Revision Reason' ;
    rdfs:comment 'Business reason for the reserve revision, such as new geological data, price changes, or regulatory updates.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:residualLandValue rdf:type rdf:Property ;
    rdfs:label 'Residual Land Value' ;
    rdfs:comment 'Estimated value of the land after resource extraction is complete, excluded from depletable base.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:responsibleInvestmentOfficer rdf:type rdf:Property ;
    rdfs:label 'Responsible Investment Officer' ;
    rdfs:comment 'Name of the investment officer responsible for managing this natural resource asset and its depletion schedule.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:scheduleName rdf:type rdf:Property ;
    rdfs:label 'Schedule Name' ;
    rdfs:comment 'Business-friendly name or label for this depletion schedule, typically including asset name and vintage year.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:taxDepletionAllowance rdf:type rdf:Property ;
    rdfs:label 'Tax Depletion Allowance' ;
    rdfs:comment 'Depletion deduction claimed for tax purposes in the current reporting period.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxDepletionMethod rdf:type rdf:Property ;
    rdfs:label 'Tax Depletion Method' ;
    rdfs:comment 'Depletion method used for tax reporting purposes, which may differ from financial reporting method.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:totalProvenReserves rdf:type rdf:Property ;
    rdfs:label 'Total Proven Reserves' ;
    rdfs:comment 'Total quantity of proven recoverable reserves at acquisition date, used as denominator in unit-of-production depletion.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:valuationModelReference rdf:type rdf:Property ;
    rdfs:label 'Valuation Model Reference' ;
    rdfs:comment 'Reference identifier for the resource-specific valuation model used for fair value measurement and impairment testing.' ;
    rdfs:domain ind:DepletionSchedule ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousEstimateReserveEstimateId rdf:type rdf:Property ;
    rdfs:label 'Previous Estimate Reserve Estimate Id' ;
    rdfs:comment 'Foreign key reference to the prior reserve estimate record that this estimate supersedes, enabling historical tracking and variance analysis.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ReserveEstimate .

ind:auditReportDate rdf:type rdf:Property ;
    rdfs:label 'Audit Report Date' ;
    rdfs:comment 'Date of the independent audit report or certification, if the reserve estimate was externally audited.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:capitalExpenditureEstimate rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Estimate' ;
    rdfs:comment 'Total estimated capital expenditure required to develop and extract the reserves, including drilling, infrastructure, equipment, and facility costs.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevelPercent rdf:type rdf:Property ;
    rdfs:label 'Confidence Level Percent' ;
    rdfs:comment 'Statistical confidence level or probability percentage associated with the reserve estimate, typically P10, P50, P90 for probabilistic assessments (e.g., 90% confidence for proven reserves).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:environmentalAdjustmentFactor rdf:type rdf:Property ;
    rdfs:label 'Environmental Adjustment Factor' ;
    rdfs:comment 'Adjustment factor applied to reserves to account for environmental constraints, protected areas, seasonal restrictions, or ESG considerations that may limit extraction.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimateIdentifier rdf:type rdf:Property ;
    rdfs:label 'Estimate Identifier' ;
    rdfs:comment 'Externally-known business identifier or report reference number for this reserve estimate, used in regulatory filings and investment committee materials.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimateStatus rdf:type rdf:Property ;
    rdfs:label 'Estimate Status' ;
    rdfs:comment 'Current lifecycle status of the reserve estimate: draft (under preparation), preliminary (initial assessment), final (approved for use), superseded (replaced by newer estimate), archived (historical record).' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedNpv rdf:type rdf:Property ;
    rdfs:label 'Estimated Npv' ;
    rdfs:comment 'Net present value of the reserves calculated using discounted cash flow (DCF) analysis, incorporating commodity price forecasts, operating costs, capital expenditures, and discount rate assumptions.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:estimationMethod rdf:type rdf:Property ;
    rdfs:label 'Estimation Method' ;
    rdfs:comment 'Technical method used to estimate reserves: deterministic (single-point), probabilistic (Monte Carlo), analogous (comparison), volumetric (geological), decline curve analysis, material balance, or reservoir simulation.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:geologicalModelVersion rdf:type rdf:Property ;
    rdfs:label 'Geological Model Version' ;
    rdfs:comment 'Version identifier of the geological or reservoir model used as the basis for the reserve estimate, enabling traceability and change management.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:grossReserves rdf:type rdf:Property ;
    rdfs:label 'Gross Reserves' ;
    rdfs:comment 'Total reserves attributable to the asset before deducting royalties, government take, or working interest adjustments. Represents 100% of the resource in place.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:independentAuditFlag rdf:type rdf:Property ;
    rdfs:label 'Independent Audit Flag' ;
    rdfs:comment 'Boolean flag indicating whether the reserve estimate was independently audited or reviewed by a third-party reserves auditor (true) or prepared internally (false).' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netReserves rdf:type rdf:Property ;
    rdfs:label 'Net Reserves' ;
    rdfs:comment 'Reserves attributable to the pension funds ownership interest after deducting royalties, government take, and adjusting for working interest or economic interest percentage.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatingCostPerUnit rdf:type rdf:Property ;
    rdfs:label 'Operating Cost Per Unit' ;
    rdfs:comment 'Estimated operating cost per unit of production (e.g., per barrel, per tonne) used in the economic evaluation, including extraction, processing, transportation, and overhead costs.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceDeckScenario rdf:type rdf:Property ;
    rdfs:label 'Price Deck Scenario' ;
    rdfs:comment 'Scenario or case used for commodity price assumptions in the reserve valuation: base case, bull case (high prices), bear case (low prices), spot prices, forward curve, or analyst consensus.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionStartDate rdf:type rdf:Property ;
    rdfs:label 'Production Start Date' ;
    rdfs:comment 'Actual or projected date when commercial production from the resource asset commenced or is expected to commence, relevant for reserve depletion scheduling.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:qualifiedPersonCredentials rdf:type rdf:Property ;
    rdfs:label 'Qualified Person Credentials' ;
    rdfs:comment 'Professional credentials and certifications of the qualified person (e.g., P.Eng., P.Geo., Chartered Engineer, SPE member), demonstrating competence to prepare reserve estimates.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:qualifiedPersonName rdf:type rdf:Property ;
    rdfs:label 'Qualified Person Name' ;
    rdfs:comment 'Name of the qualified person (QP), competent person (CP), or professional engineer who prepared or reviewed the reserve estimate, as required by regulatory standards.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recoverableQuantity rdf:type rdf:Property ;
    rdfs:label 'Recoverable Quantity' ;
    rdfs:comment 'Estimated quantity of the commodity that can be economically extracted and recovered from the resource asset, expressed in the unit of measure specified.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:recoveryFactorPercent rdf:type rdf:Property ;
    rdfs:label 'Recovery Factor Percent' ;
    rdfs:comment 'Percentage of the original resource in place that is estimated to be recoverable, reflecting extraction efficiency and technology limitations.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reportingStandard rdf:type rdf:Property ;
    rdfs:label 'Reporting Standard' ;
    rdfs:comment 'The industry standard or regulatory framework under which this reserve estimate was prepared: SPE-PRMS (petroleum), JORC (Australia mining), NI 43-101 (Canada mining), SEC (US public companies), SAMREC (South Africa), PERC (Europe).' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reserveBookingDate rdf:type rdf:Property ;
    rdfs:label 'Reserve Booking Date' ;
    rdfs:comment 'Date when the reserve estimate was formally booked or recorded in the pension funds asset register and investment accounting systems.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:reserveCategory rdf:type rdf:Property ;
    rdfs:label 'Reserve Category' ;
    rdfs:comment 'Classification of reserve confidence level per industry standards: 1P (proven), 2P (proven + probable), 3P (proven + probable + possible) for petroleum; or measured, indicated, inferred for mining.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revisionReason rdf:type rdf:Property ;
    rdfs:label 'Revision Reason' ;
    rdfs:comment 'Business reason for revising the reserve estimate: new drilling data, updated geological model, commodity price change, regulatory change, production performance, technology improvement, or annual review.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyBurdenPercent rdf:type rdf:Property ;
    rdfs:label 'Royalty Burden Percent' ;
    rdfs:comment 'Percentage of production or reserves payable as royalty to mineral rights owners, government, or other parties, reducing the net economic interest.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workingInterestPercent rdf:type rdf:Property ;
    rdfs:label 'Working Interest Percent' ;
    rdfs:comment 'Percentage ownership interest in the resource asset that entitles the pension fund to a proportionate share of production and reserves, net of royalties and government take.' ;
    rdfs:domain ind:ReserveEstimate ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:resourceValuationId rdf:type rdf:Property ;
    rdfs:label 'Resource Valuation Id' ;
    rdfs:comment 'Unique identifier for the natural resource asset valuation record.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:commodityPriceDeckId rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Deck Id' ;
    rdfs:comment 'Reference to the commodity price forecast deck used for revenue projections in the valuation model.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CommodityPriceDeck .

ind:researchFxRateId rdf:type rdf:Property ;
    rdfs:label 'Research Fx Rate Id' ;
    rdfs:comment 'Foreign key linking to research.research_fx_rate. Business justification: Currency conversion for valuation uses the chosen FX rate.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchFxRate .

ind:researchYieldCurveId rdf:type rdf:Property ;
    rdfs:label 'Research Yield Curve Id' ;
    rdfs:comment 'Foreign key linking to research.research_yield_curve. Business justification: Discounting cash flows uses the selected research yield curve.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResearchYieldCurve .

ind:appraisalFirmName rdf:type rdf:Property ;
    rdfs:label 'Appraisal Firm Name' ;
    rdfs:comment 'Name of the independent third-party appraisal firm that conducted the valuation, if applicable.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalExpenditureAssumption rdf:type rdf:Property ;
    rdfs:label 'Capital Expenditure Assumption' ;
    rdfs:comment 'Total capital expenditure forecast used in the DCF model for sustaining and growth capital.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:carbonPriceAssumption rdf:type rdf:Property ;
    rdfs:label 'Carbon Price Assumption' ;
    rdfs:comment 'Assumed carbon price per ton of CO2 equivalent used in valuation model to reflect climate transition risk.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:comparableTransactionDate rdf:type rdf:Property ;
    rdfs:label 'Comparable Transaction Date' ;
    rdfs:comment 'Date of the most recent comparable market transaction used as a valuation benchmark.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:comparableTransactionMultiple rdf:type rdf:Property ;
    rdfs:label 'Comparable Transaction Multiple' ;
    rdfs:comment 'Valuation multiple derived from comparable transactions (e.g., EV/EBITDA, price per acre, price per barrel of reserves).' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:geopoliticalRiskRating rdf:type rdf:Property ;
    rdfs:label 'Geopolitical Risk Rating' ;
    rdfs:comment 'Qualitative assessment of geopolitical risk associated with the asset location (expropriation, political instability, sanctions).' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:inflationRate rdf:type rdf:Property ;
    rdfs:label 'Inflation Rate' ;
    rdfs:comment 'Long-term inflation rate assumption applied to operating cost and revenue escalation, expressed as a decimal (e.g., 0.0250 for 2.50%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:liquidityDiscount rdf:type rdf:Property ;
    rdfs:label 'Liquidity Discount' ;
    rdfs:comment 'Discount applied to fair value to reflect illiquidity and lack of marketability of the natural resource asset, expressed as a decimal.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:productionVolumeAssumption rdf:type rdf:Property ;
    rdfs:label 'Production Volume Assumption' ;
    rdfs:comment 'Expected annual production volume used in valuation model (barrels, tons, cubic meters, board feet, bushels depending on resource type).' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:regulatoryRiskAdjustment rdf:type rdf:Property ;
    rdfs:label 'Regulatory Risk Adjustment' ;
    rdfs:comment 'Valuation discount or premium applied to reflect jurisdiction-specific regulatory risk (permitting, taxation, environmental compliance).' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:terminalValueAssumption rdf:type rdf:Property ;
    rdfs:label 'Terminal Value Assumption' ;
    rdfs:comment 'Description of terminal value methodology and assumptions used in DCF model (perpetuity growth rate, exit multiple, residual value approach).' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationAnalystName rdf:type rdf:Property ;
    rdfs:label 'Valuation Analyst Name' ;
    rdfs:comment 'Name of the internal analyst or team responsible for preparing the valuation.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationModelVersion rdf:type rdf:Property ;
    rdfs:label 'Valuation Model Version' ;
    rdfs:comment 'Version identifier of the internal valuation model or template used for this valuation.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationReviewerName rdf:type rdf:Property ;
    rdfs:label 'Valuation Reviewer Name' ;
    rdfs:comment 'Name of the senior reviewer or approver who validated the valuation.' ;
    rdfs:domain ind:ResourceValuation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:capitalEventId rdf:type rdf:Property ;
    rdfs:label 'Capital Event Id' ;
    rdfs:comment 'Unique identifier for the capital event record in the natural resource investment portfolio.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:naturalResourceInvestmentId rdf:type rdf:Property ;
    rdfs:label 'Natural Resource Investment Id' ;
    rdfs:comment 'Reference to the underlying natural resource investment (timberland, farmland, mining, energy, commodity fund) to which this capital event applies.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Investment .

ind:resourceFundCommitmentId rdf:type rdf:Property ;
    rdfs:label 'Resource Fund Commitment Id' ;
    rdfs:comment 'Foreign key linking to naturalresource.resource_fund_commitment. Business justification: Capital events (calls, distributions) for fund investments draw down or distribute against specific fund commitments.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ResourceFundCommitment .

ind:capitalRecyclingFlag rdf:type rdf:Property ;
    rdfs:label 'Capital Recycling Flag' ;
    rdfs:comment 'Indicates whether this event is part of a capital recycling provision, where distributed capital is reinvested without counting against the original commitment.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:commodityPriceReference rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Reference' ;
    rdfs:comment 'Reference commodity price index or benchmark used for valuation or distribution calculation (e.g., WTI Crude, Henry Hub Natural Gas, LME Copper).' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:depletionAdjustmentAmount rdf:type rdf:Property ;
    rdfs:label 'Depletion Adjustment Amount' ;
    rdfs:comment 'Accounting adjustment for natural resource depletion associated with this capital event, reflecting the reduction in resource reserves or asset base.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:distributionsToDate rdf:type rdf:Property ;
    rdfs:label 'Distributions To Date' ;
    rdfs:comment 'Cumulative distributions received by the Limited Partner (LP) from the natural resource investment as of this event, including this distribution if applicable.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventAmount rdf:type rdf:Property ;
    rdfs:label 'Event Amount' ;
    rdfs:comment 'Monetary value of the capital event: amount called for capital calls or amount distributed for distributions, in the fund\'s base currency.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventAmountBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Event Amount Base Currency' ;
    rdfs:comment 'Capital event amount converted to the pension fund\'s base reporting currency using the effective date foreign exchange (FX) rate.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:eventCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Event Currency Code' ;
    rdfs:comment 'Three-letter ISO 4217 currency code for the capital event amount (e.g., USD, EUR, GBP).' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eventReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Event Reference Number' ;
    rdfs:comment 'External business identifier for the capital event, typically assigned by the General Partner (GP) or fund administrator for tracking and reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exceptionNotes rdf:type rdf:Property ;
    rdfs:label 'Exception Notes' ;
    rdfs:comment 'Free-text notes documenting any exceptions, discrepancies, or special circumstances related to the capital event processing or reconciliation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundAdministratorName rdf:type rdf:Property ;
    rdfs:label 'Fund Administrator Name' ;
    rdfs:comment 'Name of the third-party fund administrator responsible for processing capital calls and distributions on behalf of the General Partner (GP).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:gpEntityName rdf:type rdf:Property ;
    rdfs:label 'Gp Entity Name' ;
    rdfs:comment 'Legal name of the General Partner (GP) or fund manager responsible for managing the natural resource investment and issuing capital event notices.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:noticeDocumentReference rdf:type rdf:Property ;
    rdfs:label 'Notice Document Reference' ;
    rdfs:comment 'Reference identifier for the capital call notice or distribution notice document issued by the General Partner (GP), stored in the document management system.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paidInCapitalToDate rdf:type rdf:Property ;
    rdfs:label 'Paid In Capital To Date' ;
    rdfs:comment 'Cumulative capital contributed by the Limited Partner (LP) to the natural resource investment as of this event, including this capital call if applicable.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:paymentInstructionReference rdf:type rdf:Property ;
    rdfs:label 'Payment Instruction Reference' ;
    rdfs:comment 'Reference number or identifier for the payment instruction associated with this capital event, used for treasury and cash management reconciliation.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:productionLinkedFlag rdf:type rdf:Property ;
    rdfs:label 'Production Linked Flag' ;
    rdfs:comment 'Indicates whether the distribution is linked to production output from the natural resource asset (e.g., timber harvest, crop yield, mineral extraction).' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:recallExpirationDate rdf:type rdf:Property ;
    rdfs:label 'Recall Expiration Date' ;
    rdfs:comment 'Date after which a recallable distribution can no longer be recalled by the General Partner (GP), typically specified in the Limited Partnership Agreement (LPA).' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:resourceAssetType rdf:type rdf:Property ;
    rdfs:label 'Resource Asset Type' ;
    rdfs:comment 'Classification of the underlying natural resource asset: timberland, farmland, mining, energy, commodity-linked fund, or specific commodity exposure. [ENUM-REF-CANDIDATE: timberland|farmland|mining|energy|commodity_fund|natural_gas|oil|metals|agriculture' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:valuationImpactAmount rdf:type rdf:Property ;
    rdfs:label 'Valuation Impact Amount' ;
    rdfs:comment 'Impact of this capital event on the Net Asset Value (NAV) of the natural resource investment, reflecting changes in fair value or carrying value.' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingTaxJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Jurisdiction' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code for the jurisdiction imposing withholding tax on the distribution (e.g., USA, CAN, GBR).' ;
    rdfs:domain ind:CapitalEvent ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:operatorAgreementId rdf:type rdf:Property ;
    rdfs:label 'Operator Agreement Id' ;
    rdfs:comment 'Unique identifier for the operator agreement record. Primary key for natural resource operating agreements, joint venture agreements, and management contracts.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:amendmentCount rdf:type rdf:Property ;
    rdfs:label 'Amendment Count' ;
    rdfs:comment 'Total number of amendments or modifications made to the operating agreement since original execution. Indicates contract stability.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:assignmentRestrictionFlag rdf:type rdf:Property ;
    rdfs:label 'Assignment Restriction Flag' ;
    rdfs:comment 'Indicates whether the agreement restricts assignment or transfer of rights and obligations without prior consent of all parties.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:capitalCallNoticeDays rdf:type rdf:Property ;
    rdfs:label 'Capital Call Notice Days' ;
    rdfs:comment 'Number of days advance notice required for capital calls or funding requests under the operating agreement. Defines liquidity planning requirements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:changeOfControlClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Change Of Control Clause Flag' ;
    rdfs:comment 'Indicates whether the agreement contains change of control provisions requiring consent or triggering termination rights upon operator ownership changes.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:confidentialityObligationFlag rdf:type rdf:Property ;
    rdfs:label 'Confidentiality Obligation Flag' ;
    rdfs:comment 'Indicates whether the agreement contains confidentiality and non-disclosure obligations binding the parties. Protects proprietary information.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:costAllocationMethod rdf:type rdf:Property ;
    rdfs:label 'Cost Allocation Method' ;
    rdfs:comment 'Method for allocating operating costs and capital expenditures among joint venture partners. Defines cost-sharing mechanics.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:defaultCurePeriodDays rdf:type rdf:Property ;
    rdfs:label 'Default Cure Period Days' ;
    rdfs:comment 'Number of days allowed for the operator to cure a default or breach before termination rights are triggered. Defines grace period for remediation.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:documentRepositoryPath rdf:type rdf:Property ;
    rdfs:label 'Document Repository Path' ;
    rdfs:comment 'File path or URI to the executed agreement document and related legal documentation in the enterprise document management system.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:environmentalComplianceStandard rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Standard' ;
    rdfs:comment 'Environmental, Social, and Governance (ESG) standards and certifications that the operator is contractually required to maintain.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:forceMajeureProvisionFlag rdf:type rdf:Property ;
    rdfs:label 'Force Majeure Provision Flag' ;
    rdfs:comment 'Indicates whether the agreement contains force majeure provisions excusing performance during extraordinary events beyond parties control.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:insuranceRequirement rdf:type rdf:Property ;
    rdfs:label 'Insurance Requirement' ;
    rdfs:comment 'Minimum insurance coverage types and limits that the operator must maintain under the agreement. Protects against operational and liability risks.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastAmendmentDate rdf:type rdf:Property ;
    rdfs:label 'Last Amendment Date' ;
    rdfs:comment 'Date of the most recent amendment or modification to the operating agreement. Tracks contract evolution over time.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:nonCompeteClauseFlag rdf:type rdf:Property ;
    rdfs:label 'Non Compete Clause Flag' ;
    rdfs:comment 'Indicates whether the agreement contains non-compete restrictions limiting the operators ability to engage in competing activities.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:operatorEntityCode rdf:type rdf:Property ;
    rdfs:label 'Operator Entity Code' ;
    rdfs:comment 'Foreign key reference to the legal entity master record for the operator or joint venture partner. Enables counterparty risk and relationship management.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:operatorOwnershipPercentage rdf:type rdf:Property ;
    rdfs:label 'Operator Ownership Percentage' ;
    rdfs:comment 'Percentage ownership or working interest held by the operator or joint venture partner. Used for revenue sharing and cost allocation calculations.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:operatorRole rdf:type rdf:Property ;
    rdfs:label 'Operator Role' ;
    rdfs:comment 'Functional role of the operator within the agreement structure. Defines operational responsibilities and decision-making authority.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:performanceFeeRate rdf:type rdf:Property ;
    rdfs:label 'Performance Fee Rate' ;
    rdfs:comment 'Performance-based fee or carried interest rate earned by the operator above a hurdle rate. Aligns operator incentives with asset performance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:revenueSharingMethod rdf:type rdf:Property ;
    rdfs:label 'Revenue Sharing Method' ;
    rdfs:comment 'Method for distributing revenue and production proceeds among joint venture partners. Defines cash flow distribution mechanics.' ;
    rdfs:domain ind:OperatorAgreement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyObligationId rdf:type rdf:Property ;
    rdfs:label 'Royalty Obligation Id' ;
    rdfs:comment 'Unique identifier for the royalty obligation record.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:RoyaltyObligation .

ind:auditRights rdf:type rdf:Property ;
    rdfs:label 'Audit Rights' ;
    rdfs:comment 'Description of the royalty holders contractual rights to audit production records, revenue calculations, and payment compliance.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:benchmarkPriceIndex rdf:type rdf:Property ;
    rdfs:label 'Benchmark Price Index' ;
    rdfs:comment 'Market price index or benchmark used to determine the royalty base value (e.g., WTI, Brent, Henry Hub, LME Copper).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleCostTypes rdf:type rdf:Property ;
    rdfs:label 'Deductible Cost Types' ;
    rdfs:comment 'Description of the types of costs that are contractually deductible from the royalty base (e.g., transportation, processing, marketing).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductibleCostsAllowed rdf:type rdf:Property ;
    rdfs:label 'Deductible Costs Allowed' ;
    rdfs:comment 'Indicates whether certain operating, transportation, or processing costs may be deducted from gross revenue before calculating the royalty base.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:environmentalComplianceRequired rdf:type rdf:Property ;
    rdfs:label 'Environmental Compliance Required' ;
    rdfs:comment 'Indicates whether the royalty agreement includes environmental compliance or ESG performance conditions that may affect payment obligations.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:escalationClause rdf:type rdf:Property ;
    rdfs:label 'Escalation Clause' ;
    rdfs:comment 'Description of any contractual escalation provisions that adjust the royalty rate or minimum payment over time (e.g., CPI-linked, production-tier-based).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgPerformanceConditions rdf:type rdf:Property ;
    rdfs:label 'Esg Performance Conditions' ;
    rdfs:comment 'Description of any ESG performance conditions or sustainability criteria linked to the royalty obligation (e.g., GHG emission targets, water usage limits).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:estimatedReservesQuantity rdf:type rdf:Property ;
    rdfs:label 'Estimated Reserves Quantity' ;
    rdfs:comment 'Estimated quantity of recoverable reserves (barrels, cubic meters, tonnes, board feet) subject to this royalty obligation, used for depletion and valuation modeling.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:fairValueEstimate rdf:type rdf:Property ;
    rdfs:label 'Fair Value Estimate' ;
    rdfs:comment 'Estimated fair value of the royalty obligation liability for financial reporting and NAV calculation purposes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:governmentJurisdiction rdf:type rdf:Property ;
    rdfs:label 'Government Jurisdiction' ;
    rdfs:comment 'ISO 3166-1 alpha-3 country code of the government jurisdiction imposing the royalty, if applicable.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:indigenousCommunityName rdf:type rdf:Property ;
    rdfs:label 'Indigenous Community Name' ;
    rdfs:comment 'Name of the indigenous community or First Nation entitled to royalty payments under treaty or land rights agreements, if applicable.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:minimumRoyaltyAmount rdf:type rdf:Property ;
    rdfs:label 'Minimum Royalty Amount' ;
    rdfs:comment 'Contractual minimum royalty payment due per period, regardless of production or revenue levels.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:obligationStatus rdf:type rdf:Property ;
    rdfs:label 'Obligation Status' ;
    rdfs:comment 'Current lifecycle status of the royalty obligation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:paymentDueDay rdf:type rdf:Property ;
    rdfs:label 'Payment Due Day' ;
    rdfs:comment 'Day of the month or period on which royalty payments are due (e.g., 15th day of the month following production period).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:priceAdjustmentFormula rdf:type rdf:Property ;
    rdfs:label 'Price Adjustment Formula' ;
    rdfs:comment 'Contractual formula or methodology for adjusting the royalty base price, including discounts, quality adjustments, or transportation deductions.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reservesUnitOfMeasure rdf:type rdf:Property ;
    rdfs:label 'Reserves Unit Of Measure' ;
    rdfs:comment 'Unit of measure for the estimated reserves quantity (e.g., barrels for oil, cubic meters for gas, tonnes for minerals, board feet for timber).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyAgreementNumber rdf:type rdf:Property ;
    rdfs:label 'Royalty Agreement Number' ;
    rdfs:comment 'External business identifier for the royalty agreement or contract governing this obligation.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyBaseType rdf:type rdf:Property ;
    rdfs:label 'Royalty Base Type' ;
    rdfs:comment 'The economic basis on which the royalty rate is applied (e.g., gross revenue, net revenue, production volume, net profits, wellhead value).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Royalty Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which royalty payments are denominated.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyHolderLei rdf:type rdf:Property ;
    rdfs:label 'Royalty Holder Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier for the royalty holder, if applicable.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyHolderName rdf:type rdf:Property ;
    rdfs:label 'Royalty Holder Name' ;
    rdfs:comment 'Legal name of the party entitled to receive royalty payments (government entity, private landowner, indigenous community, or other rights holder).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyRatePercent rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate Percent' ;
    rdfs:comment 'Percentage rate applied to the royalty base (production volume, revenue, or net profits) to calculate the royalty payment.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyType rdf:type rdf:Property ;
    rdfs:label 'Royalty Type' ;
    rdfs:comment 'Classification of the royalty obligation by legal and economic structure.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:suspensionReason rdf:type rdf:Property ;
    rdfs:label 'Suspension Reason' ;
    rdfs:comment 'Reason for suspension of the royalty obligation, if applicable (e.g., force majeure, production halt, regulatory moratorium).' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:treatyReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Treaty Reference Number' ;
    rdfs:comment 'Reference number or identifier for the treaty, land claim agreement, or indigenous rights agreement governing the royalty obligation.' ;
    rdfs:domain ind:RoyaltyObligation ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:royaltyPaymentId rdf:type rdf:Property ;
    rdfs:label 'Royalty Payment Id' ;
    rdfs:comment 'Unique identifier for the royalty payment transaction record.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:recordUpdatedByUserEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Record Updated By User Employee Id' ;
    rdfs:comment 'Reference to the user who last updated the royalty payment record.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:commodityPrice rdf:type rdf:Property ;
    rdfs:label 'Commodity Price' ;
    rdfs:comment 'Market or contract price per unit of the commodity applied to calculate gross revenue for the royalty period.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:commodityPriceCurrency rdf:type rdf:Property ;
    rdfs:label 'Commodity Price Currency' ;
    rdfs:comment 'Three-letter ISO currency code for the commodity price (e.g., USD, AUD).' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:deductionAmount rdf:type rdf:Property ;
    rdfs:label 'Deduction Amount' ;
    rdfs:comment 'Total deductions applied to the gross royalty amount, including allowable costs, transportation, or processing fees per contract terms.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossRevenueBase rdf:type rdf:Property ;
    rdfs:label 'Gross Revenue Base' ;
    rdfs:comment 'Total gross revenue calculated from production volume multiplied by commodity price, before royalty rate application.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:payeeLegalEntityCode rdf:type rdf:Property ;
    rdfs:label 'Payee Legal Entity Code' ;
    rdfs:comment 'Reference to the legal entity receiving the royalty payment (landowner, mineral rights holder, government authority).' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:paymentNumber rdf:type rdf:Property ;
    rdfs:label 'Payment Number' ;
    rdfs:comment 'Business identifier for the royalty payment, typically sequential or formatted per contract terms.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:reversalFlag rdf:type rdf:Property ;
    rdfs:label 'Reversal Flag' ;
    rdfs:comment 'Indicator of whether this royalty payment has been reversed or cancelled after initial processing.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:royaltyAmountBase rdf:type rdf:Property ;
    rdfs:label 'Royalty Amount Base' ;
    rdfs:comment 'Royalty payment amount converted to the fund\'s base reporting currency for consolidated accounting.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Royalty Amount Local' ;
    rdfs:comment 'Calculated royalty payment amount in the local currency of the natural resource asset or contract.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:royaltyRate rdf:type rdf:Property ;
    rdfs:label 'Royalty Rate' ;
    rdfs:comment 'Percentage or decimal rate applied to gross revenue to determine the royalty payment amount, as specified in the royalty agreement.' ;
    rdfs:domain ind:RoyaltyPayment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:landParcelId rdf:type rdf:Property ;
    rdfs:label 'Land Parcel Id' ;
    rdfs:comment 'Unique system identifier for the land parcel record.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:LandParcel .

ind:investmentPortfolioId rdf:type rdf:Property ;
    rdfs:label 'Investment Portfolio Id' ;
    rdfs:comment 'Identifier of the investment portfolio or fund to which the parcel is allocated.' ;
    rdfs:domain ind:Naturalresource ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Portfolio .

ind:annualPropertyTax rdf:type rdf:Property ;
    rdfs:label 'Annual Property Tax' ;
    rdfs:comment 'Annual property tax liability for the parcel in base currency, used for cash flow modeling and net operating income calculation.' ;
    rdfs:domain ind:LandParcel ;
    rdf:type owl:DatatypeProperty ;
