    rdfs:range xsd:string .

ind:dueDiligenceResponsibility rdf:type rdf:Property ;
    rdfs:label 'Due Diligence Responsibility' ;
    rdfs:comment 'Level of due diligence responsibility assigned: full operational and financial due diligence, partial support, none, or advisory role.' ;
    rdfs:domain ind:AnalystAssignment ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:icPresentationRequirement rdf:type rdf:Property ;
