ind:scenarioRequirementId rdf:type rdf:Property ;
    rdfs:label 'Scenario Requirement Id' ;
    rdfs:comment 'Unique identifier for the scenario requirement record. Primary key.' ;
    rdfs:domain ind:ScenarioRequirement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:complianceDeadline rdf:type rdf:Property ;
    rdfs:label 'Compliance Deadline' ;
    rdfs:comment 'The deadline by which this stress scenario must be executed to satisfy this specific compliance obligation. Different obligations may have different deadlines for the same scenario.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
