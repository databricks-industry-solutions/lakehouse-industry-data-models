ind:primaryPredecessorAssignmentAnalystAssignmentId rdf:type rdf:Property ;
    rdfs:label 'Primary Predecessor Assignment Analyst Assignment Id' ;
    rdfs:comment 'Identifier of the previous assignment record if this assignment is a continuation or transition from another analyst.' ;
    rdfs:domain ind:AnalystAssignment ;
