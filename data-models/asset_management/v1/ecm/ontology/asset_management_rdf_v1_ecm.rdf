    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceChange rdf:type rdf:Property ;
    rdfs:label 'Price Change' ;
    rdfs:comment 'Absolute change in price from previous close to current close.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceChangePercent rdf:type rdf:Property ;
    rdfs:label 'Price Change Percent' ;
    rdfs:comment 'Percentage change in price from previous close to current close expressed as a decimal.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:priceDate rdf:type rdf:Property ;
    rdfs:label 'Price Date' ;
    rdfs:comment 'Business date for which the price data is recorded (end-of-day).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:priceSource rdf:type rdf:Property ;
    rdfs:label 'Price Source' ;
    rdfs:comment 'Data vendor or system from which the price data was sourced (e.g., Bloomberg, FactSet, exchange feed).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:priceType rdf:type rdf:Property ;
    rdfs:label 'Price Type' ;
    rdfs:comment 'Classification of the price data quality and source authority.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitFactor rdf:type rdf:Property ;
    rdfs:label 'Split Factor' ;
    rdfs:comment 'Stock split or reverse split adjustment factor applied on the price date (e.g., 2.0 for 2-for-1 split, 0.5 for 1-for-2 reverse split).' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:totalReturnIndex rdf:type rdf:Property ;
    rdfs:label 'Total Return Index' ;
    rdfs:comment 'Cumulative total return index level assuming reinvestment of all dividends and distributions, used for performance attribution.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tradingStatus rdf:type rdf:Property ;
    rdfs:label 'Trading Status' ;
    rdfs:comment 'Status of trading activity for the security on the price date.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:turnoverValue rdf:type rdf:Property ;
    rdfs:label 'Turnover Value' ;
    rdfs:comment 'Total monetary value of shares traded during the session, calculated as volume multiplied by price.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:volume rdf:type rdf:Property ;
    rdfs:label 'Volume' ;
    rdfs:comment 'Total number of shares traded during the trading session.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:vwap rdf:type rdf:Property ;
    rdfs:label 'Vwap' ;
    rdfs:comment 'Volume-weighted average price of all trades executed during the trading session, used for execution quality assessment.' ;
    rdfs:domain ind:PriceHistory ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corporateActionId rdf:type rdf:Property ;
    rdfs:label 'Corporate Action Id' ;
    rdfs:comment 'Unique identifier for the corporate action event record.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:CorporateAction .

ind:actionStatus rdf:type rdf:Property ;
    rdfs:label 'Action Status' ;
    rdfs:comment 'Current lifecycle status of the corporate action: announced, confirmed, pending execution, executed, cancelled, or expired.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:actionType rdf:type rdf:Property ;
    rdfs:label 'Action Type' ;
    rdfs:comment 'Classification of the corporate action event: dividend, stock split, reverse split, rights issue, spin-off, merger, acquisition, delisting, name change, ticker change, or bonus issue.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:countryOfIssue rdf:type rdf:Property ;
    rdfs:label 'Country Of Issue' ;
    rdfs:comment 'Three-letter ISO 3166-1 alpha-3 country code representing the country in which the security is issued.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:corporateActionDescription rdf:type rdf:Property ;
    rdfs:label 'Corporate Action Description' ;
    rdfs:comment 'Detailed narrative description of the corporate action event, including business rationale and shareholder impact.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dividendCurrency rdf:type rdf:Property ;
    rdfs:label 'Dividend Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the dividend is denominated.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dividendType rdf:type rdf:Property ;
    rdfs:label 'Dividend Type' ;
    rdfs:comment 'Classification of dividend: ordinary (regular), special (one-time), interim (mid-year), or final (year-end).' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exDate rdf:type rdf:Property ;
    rdfs:label 'Ex Date' ;
    rdfs:comment 'Date on or after which a security trades without the right to receive the corporate action benefit; critical for determining entitlement.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:impactOnNavFlag rdf:type rdf:Property ;
    rdfs:label 'Impact On Nav Flag' ;
    rdfs:comment 'Boolean flag indicating whether this corporate action has a material impact on portfolio Net Asset Value calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:mandatoryVoluntaryFlag rdf:type rdf:Property ;
    rdfs:label 'Mandatory Voluntary Flag' ;
    rdfs:comment 'Indicates whether the corporate action is mandatory (automatic for all shareholders) or voluntary (requires shareholder election).' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:newCusip rdf:type rdf:Property ;
    rdfs:label 'New Cusip' ;
    rdfs:comment 'CUSIP assigned to the security after a corporate action that changes the security identifier.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newIsin rdf:type rdf:Property ;
    rdfs:label 'New Isin' ;
    rdfs:comment 'ISIN assigned to the security after a corporate action that changes the security identifier, such as a merger, spin-off, or name change.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newSecurityName rdf:type rdf:Property ;
    rdfs:label 'New Security Name' ;
    rdfs:comment 'New legal name of the security or issuer after a name change, merger, or acquisition.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newSedol rdf:type rdf:Property ;
    rdfs:label 'New Sedol' ;
    rdfs:comment 'SEDOL assigned to the security after a corporate action that changes the security identifier.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:newTicker rdf:type rdf:Property ;
    rdfs:label 'New Ticker' ;
    rdfs:comment 'New exchange trading symbol assigned to the security after a ticker change or corporate restructuring.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:notificationSentFlag rdf:type rdf:Property ;
    rdfs:label 'Notification Sent Flag' ;
    rdfs:comment 'Boolean flag indicating whether portfolio managers and investment teams have been notified of this corporate action.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:positionAdjustmentRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Position Adjustment Required Flag' ;
    rdfs:comment 'Boolean flag indicating whether portfolio position records must be adjusted to reflect this corporate action.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:processedTimestamp rdf:type rdf:Property ;
    rdfs:label 'Processed Timestamp' ;
    rdfs:comment 'Timestamp when the corporate action event was processed and applied to portfolio positions and accounting records.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:recordDate rdf:type rdf:Property ;
    rdfs:label 'Record Date' ;
    rdfs:comment 'Date on which shareholders must be registered on the company books to be entitled to the corporate action benefit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:rightsRatioFrom rdf:type rdf:Property ;
    rdfs:label 'Rights Ratio From' ;
    rdfs:comment 'Number of existing shares required to receive the rights entitlement; for a 1-for-5 rights issue, this value is 5.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rightsRatioTo rdf:type rdf:Property ;
    rdfs:label 'Rights Ratio To' ;
    rdfs:comment 'Number of new shares offered per the existing share entitlement; for a 1-for-5 rights issue, this value is 1.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sourceReferenceCode rdf:type rdf:Property ;
    rdfs:label 'Source Reference Code' ;
    rdfs:comment 'Unique identifier or reference number assigned to the corporate action event by the source system or data provider.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:splitRatioFrom rdf:type rdf:Property ;
    rdfs:label 'Split Ratio From' ;
    rdfs:comment 'Numerator of the stock split ratio representing the number of old shares; for a 2-for-1 split, this value is 1.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:splitRatioTo rdf:type rdf:Property ;
    rdfs:label 'Split Ratio To' ;
    rdfs:comment 'Denominator of the stock split ratio representing the number of new shares; for a 2-for-1 split, this value is 2.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:subscriptionCurrency rdf:type rdf:Property ;
    rdfs:label 'Subscription Currency' ;
    rdfs:comment 'Three-letter ISO 4217 currency code in which the subscription price is denominated.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subscriptionPrice rdf:type rdf:Property ;
    rdfs:label 'Subscription Price' ;
    rdfs:comment 'Price per share at which entitled shareholders may subscribe to new shares in a rights issue.' ;
    rdfs:domain ind:CorporateAction ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ticker rdf:type rdf:Property ;
    rdfs:label 'Ticker' ;
    rdfs:comment 'Exchange trading symbol for the security at the time of the corporate action.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxRate rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Rate' ;
    rdfs:comment 'Default withholding tax rate applied to the corporate action benefit, expressed as a decimal (e.g., 0.15 for 15%).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:corporateActionElectionId rdf:type rdf:Property ;
    rdfs:label 'Corporate Action Election Id' ;
    rdfs:comment 'Unique identifier for the corporate action election record.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:corporateEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Corporate Employee Id' ;
    rdfs:comment 'Reference to the portfolio manager who made or authorized the election decision.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:corporateTraderEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Corporate Trader Employee Id' ;
    rdfs:comment 'Reference to the trader who submitted the election instruction.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:custodianCounterpartyId rdf:type rdf:Property ;
    rdfs:label 'Custodian Counterparty Id' ;
    rdfs:comment 'Reference to the custodian bank processing the corporate action election.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Counterparty .

ind:portfolioManagerEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Portfolio Manager Employee Id' ;
    rdfs:comment 'Reference to the portfolio manager who made or authorized the election decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:accountingEntryReference rdf:type rdf:Property ;
    rdfs:label 'Accounting Entry Reference' ;
    rdfs:comment 'Reference to the accounting entry recording the financial impact of the election.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:actualQuantityProcessed rdf:type rdf:Property ;
    rdfs:label 'Actual Quantity Processed' ;
    rdfs:comment 'Actual number of shares processed after proration or partial acceptance.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:agentContactEmail rdf:type rdf:Property ;
    rdfs:label 'Agent Contact Email' ;
    rdfs:comment 'Email address of the corporate action agent for election inquiries.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:agentName rdf:type rdf:Property ;
    rdfs:label 'Agent Name' ;
    rdfs:comment 'Name of the corporate action agent or transfer agent managing the event.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cashConsiderationAmount rdf:type rdf:Property ;
    rdfs:label 'Cash Consideration Amount' ;
    rdfs:comment 'Total cash amount expected to be received for the elected quantity.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:cashConsiderationCurrency rdf:type rdf:Property ;
    rdfs:label 'Cash Consideration Currency' ;
    rdfs:comment 'Three-letter ISO currency code for cash consideration.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:considerationType rdf:type rdf:Property ;
    rdfs:label 'Consideration Type' ;
    rdfs:comment 'Type of consideration to be received in exchange for the elected shares.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:custodianReferenceNumber rdf:type rdf:Property ;
    rdfs:label 'Custodian Reference Number' ;
    rdfs:comment 'Unique reference number assigned by the custodian to this election instruction.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electedQuantity rdf:type rdf:Property ;
    rdfs:label 'Elected Quantity' ;
    rdfs:comment 'Number of shares or units for which the election is being made.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electionConfirmationTimestamp rdf:type rdf:Property ;
    rdfs:label 'Election Confirmation Timestamp' ;
    rdfs:comment 'Date and time when the election was confirmed by the custodian or agent.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:electionOptionCode rdf:type rdf:Property ;
    rdfs:label 'Election Option Code' ;
    rdfs:comment 'Code representing the specific option chosen by the fund from available alternatives.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionOptionDescription rdf:type rdf:Property ;
    rdfs:label 'Election Option Description' ;
    rdfs:comment 'Detailed description of the elected option including terms and consideration.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionPercentage rdf:type rdf:Property ;
    rdfs:label 'Election Percentage' ;
    rdfs:comment 'Percentage of eligible position being elected for participation.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:electionRationale rdf:type rdf:Property ;
    rdfs:label 'Election Rationale' ;
    rdfs:comment 'Business rationale and investment thesis supporting the election decision.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:electionSubmissionTimestamp rdf:type rdf:Property ;
    rdfs:label 'Election Submission Timestamp' ;
    rdfs:comment 'Date and time when the election instruction was submitted to the custodian or agent.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:electionType rdf:type rdf:Property ;
    rdfs:label 'Election Type' ;
    rdfs:comment 'Type of voluntary corporate action election being made.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:eligibleQuantity rdf:type rdf:Property ;
    rdfs:label 'Eligible Quantity' ;
    rdfs:comment 'Total number of shares or units eligible for participation in the corporate action.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:executionDate rdf:type rdf:Property ;
    rdfs:label 'Execution Date' ;
    rdfs:comment 'Date on which the corporate action election was executed and settled.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:investmentCommitteeApprovalRequired rdf:type rdf:Property ;
    rdfs:label 'Investment Committee Approval Required' ;
    rdfs:comment 'Indicates whether IC approval was required for this election decision.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:netCashProceeds rdf:type rdf:Property ;
    rdfs:label 'Net Cash Proceeds' ;
    rdfs:comment 'Net cash amount received after deducting withholding taxes and fees.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:prorationFactor rdf:type rdf:Property ;
    rdfs:label 'Proration Factor' ;
    rdfs:comment 'Factor applied when the corporate action is oversubscribed and elections are prorated.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:stockConsiderationIsin rdf:type rdf:Property ;
    rdfs:label 'Stock Consideration Isin' ;
    rdfs:comment 'ISIN of the security to be received as stock consideration.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockConsiderationQuantity rdf:type rdf:Property ;
    rdfs:label 'Stock Consideration Quantity' ;
    rdfs:comment 'Number of shares expected to be received as stock consideration.' ;
    rdfs:domain ind:CorporateActionElection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equityFactorExposureId rdf:type rdf:Property ;
    rdfs:label 'Equity Factor Exposure Id' ;
    rdfs:comment 'Unique identifier for the factor exposure record.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:factorModelId rdf:type rdf:Property ;
    rdfs:label 'Factor Model Id' ;
    rdfs:comment 'Reference to the factor model used for exposure calculation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Model .

ind:activeExposure rdf:type rdf:Property ;
    rdfs:label 'Active Exposure' ;
    rdfs:comment 'The difference between portfolio factor exposure and benchmark factor exposure, representing active positioning relative to benchmark.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:adjustmentReason rdf:type rdf:Property ;
    rdfs:label 'Adjustment Reason' ;
    rdfs:comment 'Explanation for any manual adjustments or overrides applied to the calculated factor exposure. Null if no adjustments made.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:betaToMarket rdf:type rdf:Property ;
    rdfs:label 'Beta To Market' ;
    rdfs:comment 'The beta coefficient representing the sensitivity of the security or portfolio to market movements. Core metric in CAPM (Capital Asset Pricing Model).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:confidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Confidence Level' ;
    rdfs:comment 'Confidence level for the factor exposure calculation, typically expressed as a percentage such as 95% or 99%.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:contributionToRisk rdf:type rdf:Property ;
    rdfs:label 'Contribution To Risk' ;
    rdfs:comment 'The contribution of this factor exposure to the overall portfolio risk, measured in percentage or basis points (bps).' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureDate rdf:type rdf:Property ;
    rdfs:label 'Exposure Date' ;
    rdfs:comment 'The date for which the factor exposure is calculated and reported.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:exposurePercentile rdf:type rdf:Property ;
    rdfs:label 'Exposure Percentile' ;
    rdfs:comment 'Percentile rank of the factor exposure relative to peer universe or historical distribution. Range 0 to 100.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureValue rdf:type rdf:Property ;
    rdfs:label 'Exposure Value' ;
    rdfs:comment 'Numeric value representing the magnitude of exposure to the factor. Standardized exposure score, typically z-score normalized.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:exposureWeight rdf:type rdf:Property ;
    rdfs:label 'Exposure Weight' ;
    rdfs:comment 'Portfolio weight applied to the security when calculating portfolio-level factor exposure. Null for security-level exposures.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factorCategory rdf:type rdf:Property ;
    rdfs:label 'Factor Category' ;
    rdfs:comment 'Classification of the factor into broad categories: style factors, industry factors, country factors, currency factors, market factors, or macroeconomic factors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorModelVersion rdf:type rdf:Property ;
    rdfs:label 'Factor Model Version' ;
    rdfs:comment 'Version identifier of the factor model used, such as Barra GEM4, USE4, EUE3, or CAPM variant.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorName rdf:type rdf:Property ;
    rdfs:label 'Factor Name' ;
    rdfs:comment 'Name of the risk factor, such as market beta, size, value, momentum, quality, low volatility, growth, leverage, liquidity, earnings yield, or sector-specific factors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:factorReturn rdf:type rdf:Property ;
    rdfs:label 'Factor Return' ;
    rdfs:comment 'The return attributed to this factor over the exposure period, expressed as a percentage or decimal.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:factorVolatility rdf:type rdf:Property ;
    rdfs:label 'Factor Volatility' ;
    rdfs:comment 'The volatility or standard deviation of the factor return, representing the risk associated with the factor itself.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:frequency rdf:type rdf:Property ;
    rdfs:label 'Frequency' ;
    rdfs:comment 'Frequency at which factor exposures are calculated and reported: daily, weekly, monthly, or quarterly.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lookbackPeriodDays rdf:type rdf:Property ;
    rdfs:label 'Lookback Period Days' ;
    rdfs:comment 'Number of days of historical data used in the factor exposure calculation, such as 60, 90, 252, or 504 days.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:marginalContributionToRisk rdf:type rdf:Property ;
    rdfs:label 'Marginal Contribution To Risk' ;
    rdfs:comment 'Marginal contribution to total portfolio risk from this factor exposure, representing the change in risk if exposure changes by one unit.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:outlierFlag rdf:type rdf:Property ;
    rdfs:label 'Outlier Flag' ;
    rdfs:comment 'Indicates whether the factor exposure value is identified as a statistical outlier requiring review or adjustment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:pValue rdf:type rdf:Property ;
    rdfs:label 'P Value' ;
    rdfs:comment 'Probability value indicating the statistical significance of the factor exposure. Values below 0.05 typically indicate significance at 95% confidence level.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:qualityScore rdf:type rdf:Property ;
    rdfs:label 'Quality Score' ;
    rdfs:comment 'Data quality score for the factor exposure calculation, ranging from 0 to 100, based on data completeness, timeliness, and model fit.' ;
    rdfs:domain ind:EquityFactorExposure ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:rSquared rdf:type rdf:Property ;
    rdfs:label 'R Squared' ;
    rdfs:comment 'Coefficient of determination indicating the proportion of variance in security returns explained by the factor model. Range 0 to 1.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:tStatistic rdf:type rdf:Property ;
    rdfs:label 'T Statistic' ;
    rdfs:comment 'Statistical t-statistic measuring the significance of the factor exposure. Values above 2 or below -2 typically indicate statistical significance.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:equitySectorClassificationId rdf:type rdf:Property ;
    rdfs:label 'Equity Sector Classification Id' ;
    rdfs:comment 'Unique identifier for the sector classification record.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:analystOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Analyst Override Flag' ;
    rdfs:comment 'Indicates whether internal investment analysts have overridden the standard classification for portfolio management purposes.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkInclusionFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Inclusion Flag' ;
    rdfs:comment 'Indicates whether this classification is used for benchmark index inclusion and sector allocation decisions.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:classificationConfidenceScore rdf:type rdf:Property ;
    rdfs:label 'Classification Confidence Score' ;
    rdfs:comment 'Confidence level or quality score assigned by the classification provider, typically 0-100 percent.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:classificationNotes rdf:type rdf:Property ;
    rdfs:label 'Classification Notes' ;
    rdfs:comment 'Free-text notes or comments regarding special considerations, edge cases, or analyst observations for this classification.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationScheme rdf:type rdf:Property ;
    rdfs:label 'Classification Scheme' ;
    rdfs:comment 'Standard classification taxonomy used for sector categorization.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationVersion rdf:type rdf:Property ;
    rdfs:label 'Classification Version' ;
    rdfs:comment 'Version or edition of the classification scheme applied.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryCode rdf:type rdf:Property ;
    rdfs:label 'Industry Code' ;
    rdfs:comment 'Third-level industry classification code within the industry group.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryGroupCode rdf:type rdf:Property ;
    rdfs:label 'Industry Group Code' ;
    rdfs:comment 'Second-level industry group classification code within the sector.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryGroupName rdf:type rdf:Property ;
    rdfs:label 'Industry Group Name' ;
    rdfs:comment 'Human-readable name of the industry group.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:industryName rdf:type rdf:Property ;
    rdfs:label 'Industry Name' ;
    rdfs:comment 'Human-readable name of the industry.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideJustification rdf:type rdf:Property ;
    rdfs:label 'Override Justification' ;
    rdfs:comment 'Business rationale provided by analysts for classification override decisions.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousSectorCode rdf:type rdf:Property ;
    rdfs:label 'Previous Sector Code' ;
    rdfs:comment 'Prior sector code before reclassification, null for initial classifications.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:previousSubIndustryCode rdf:type rdf:Property ;
    rdfs:label 'Previous Sub Industry Code' ;
    rdfs:comment 'Prior sub-industry code before reclassification, null for initial classifications.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:primaryClassificationFlag rdf:type rdf:Property ;
    rdfs:label 'Primary Classification Flag' ;
    rdfs:comment 'Indicates whether this is the primary sector classification for the security when multiple schemes are used.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:reclassificationReason rdf:type rdf:Property ;
    rdfs:label 'Reclassification Reason' ;
    rdfs:comment 'Business rationale for any change in sector classification, such as merger, business model shift, or scheme update.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenuePercentage rdf:type rdf:Property ;
    rdfs:label 'Revenue Percentage' ;
    rdfs:comment 'Percentage of company revenue derived from this sector or sub-industry, used for multi-sector companies.' ;
    rdfs:domain ind:EquitySectorClassification ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:sectorName rdf:type rdf:Property ;
    rdfs:label 'Sector Name' ;
    rdfs:comment 'Human-readable name of the top-level sector.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subIndustryCode rdf:type rdf:Property ;
    rdfs:label 'Sub Industry Code' ;
    rdfs:comment 'Fourth-level sub-industry classification code providing the most granular categorization.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:subIndustryName rdf:type rdf:Property ;
    rdfs:label 'Sub Industry Name' ;
    rdfs:comment 'Human-readable name of the sub-industry.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:securitySectorMappingId rdf:type rdf:Property ;
    rdfs:label 'Security Sector Mapping Id' ;
    rdfs:comment 'Unique identifier for the security sector mapping record.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:benchmarkAlignmentFlag rdf:type rdf:Property ;
    rdfs:label 'Benchmark Alignment Flag' ;
    rdfs:comment 'Indicates whether this classification aligns with the sector classification used in the portfolios primary benchmark index.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:benchmarkSectorCode rdf:type rdf:Property ;
    rdfs:label 'Benchmark Sector Code' ;
    rdfs:comment 'Sector code as defined by the benchmark index provider for comparison and attribution purposes.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:carbonIntensitySector rdf:type rdf:Property ;
    rdfs:label 'Carbon Intensity Sector' ;
    rdfs:comment 'Sector grouping used for greenhouse gas emissions and carbon intensity analysis.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:classificationSourceIdentifier rdf:type rdf:Property ;
    rdfs:label 'Classification Source Identifier' ;
    rdfs:comment 'Unique identifier or reference code from the classification source system.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:esgSectorClassification rdf:type rdf:Property ;
    rdfs:label 'Esg Sector Classification' ;
    rdfs:comment 'Sector classification specific to ESG analysis frameworks, which may differ from financial sector classifications.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalSectorCode rdf:type rdf:Property ;
    rdfs:label 'Internal Sector Code' ;
    rdfs:comment 'Proprietary internal sector classification code used for portfolio construction and risk management.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:internalSectorName rdf:type rdf:Property ;
    rdfs:label 'Internal Sector Name' ;
    rdfs:comment 'Human-readable name of the internal sector classification.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:lastVerificationDate rdf:type rdf:Property ;
    rdfs:label 'Last Verification Date' ;
    rdfs:comment 'Date when the sector classification was last verified or reviewed by internal teams.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:manualOverrideFlag rdf:type rdf:Property ;
    rdfs:label 'Manual Override Flag' ;
    rdfs:comment 'Indicates whether the classification was manually overridden by internal research or portfolio management teams.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:overrideByUser rdf:type rdf:Property ;
    rdfs:label 'Override By User' ;
    rdfs:comment 'Username or identifier of the analyst or portfolio manager who performed the manual override.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:overrideTimestamp rdf:type rdf:Property ;
    rdfs:label 'Override Timestamp' ;
    rdfs:comment 'Date and time when the manual override was applied.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:dateTime .

ind:regulatorySectorClassification rdf:type rdf:Property ;
    rdfs:label 'Regulatory Sector Classification' ;
    rdfs:comment 'Sector classification required for regulatory reporting to SEC, or other governing bodies.' ;
    rdfs:domain ind:SecuritySectorMapping ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:stockSelectionId rdf:type rdf:Property ;
    rdfs:label 'Stock Selection Id' ;
    rdfs:comment 'Unique identifier for the stock selection decision record.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:valuationModelId rdf:type rdf:Property ;
    rdfs:label 'Valuation Model Id' ;
    rdfs:comment 'Reference to the valuation model used to derive intrinsic value for this selection.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:ValuationModel .

ind:currentMarketPrice rdf:type rdf:Property ;
    rdfs:label 'Current Market Price' ;
    rdfs:comment 'Market price of the equity security at the time of the selection decision.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:icApprovalRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Ic Approval Required Flag' ;
    rdfs:comment 'Indicates whether this stock selection decision requires formal Investment Committee approval before implementation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:implementationStatus rdf:type rdf:Property ;
    rdfs:label 'Implementation Status' ;
    rdfs:comment 'Status of the execution and implementation of the stock selection decision into the portfolio.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:intrinsicValue rdf:type rdf:Property ;
    rdfs:label 'Intrinsic Value' ;
    rdfs:comment 'Calculated intrinsic value per share derived from the valuation model, representing fundamental fair value.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:investmentThesisSummary rdf:type rdf:Property ;
    rdfs:label 'Investment Thesis Summary' ;
    rdfs:comment 'Concise summary of the core investment thesis supporting the stock selection decision.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:recommendation rdf:type rdf:Property ;
    rdfs:label 'Recommendation' ;
    rdfs:comment 'Formal investment recommendation for the equity security relative to portfolio construction objectives.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionDecisionCode rdf:type rdf:Property ;
    rdfs:label 'Selection Decision Code' ;
    rdfs:comment 'Unique business identifier for this stock selection decision, used for external reference and audit trails.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:selectionStatus rdf:type rdf:Property ;
    rdfs:label 'Selection Status' ;
    rdfs:comment 'Current lifecycle status of the stock selection decision within the investment approval workflow.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:targetPositionValueBaseCurrency rdf:type rdf:Property ;
    rdfs:label 'Target Position Value Base Currency' ;
    rdfs:comment 'Recommended absolute position value for the equity security in the portfolios base currency.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:targetWeightPercent rdf:type rdf:Property ;
    rdfs:label 'Target Weight Percent' ;
    rdfs:comment 'Recommended portfolio weight for the equity security as a percentage of total portfolio value.' ;
    rdfs:domain ind:StockSelection ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:upsideDownsidePercent rdf:type rdf:Property ;
    rdfs:label 'Upside Downside Percent' ;
    rdfs:comment 'Expected percentage return from current market price to target price, representing potential upside or downside.' ;
    rdfs:domain ind:Equity ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:capexPercentOfRevenue rdf:type rdf:Property ;
    rdfs:label 'Capex Percent Of Revenue' ;
    rdfs:comment 'Capital expenditure as a percentage of revenue, used to estimate reinvestment needs in DCF models.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:comparableMultipleType rdf:type rdf:Property ;
    rdfs:label 'Comparable Multiple Type' ;
    rdfs:comment 'Type of valuation multiple used: EV/EBITDA, P/E, P/B, EV/Sales, PEG, or other industry-specific metric. [ENUM-REF-CANDIDATE: EV/EBITDA|P/E|P/B|EV/Sales|PEG|EV/EBIT|P/S|Dividend Yield — promote to reference product]' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:comparableMultipleValue rdf:type rdf:Property ;
    rdfs:label 'Comparable Multiple Value' ;
    rdfs:comment 'Valuation multiple derived from comparable companies or transactions, such as EV/EBITDA or P/E ratio.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:discountRatePercent rdf:type rdf:Property ;
    rdfs:label 'Discount Rate Percent' ;
    rdfs:comment 'Weighted Average Cost of Capital or required rate of return used to discount future cash flows in DCF models.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:ebitdaMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Ebitda Margin Percent' ;
    rdfs:comment 'EBITDA as a percentage of revenue, representing operational profitability assumption in the model.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:forecastPeriodYears rdf:type rdf:Property ;
    rdfs:label 'Forecast Period Years' ;
    rdfs:comment 'Number of years for which explicit cash flow or earnings forecasts are modeled before terminal value.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:intrinsicValueEstimate rdf:type rdf:Property ;
    rdfs:label 'Intrinsic Value Estimate' ;
    rdfs:comment 'Calculated fair value per share based on the valuation model methodology and assumptions.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:keyAssumptions rdf:type rdf:Property ;
    rdfs:label 'Key Assumptions' ;
    rdfs:comment 'Summary of critical assumptions underpinning the valuation model, including macroeconomic, industry, and company-specific factors.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelConfidenceLevel rdf:type rdf:Property ;
    rdfs:label 'Model Confidence Level' ;
    rdfs:comment 'Analyst assessment of confidence in the valuation model output based on data quality, assumption robustness, and market conditions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelDocumentationUrl rdf:type rdf:Property ;
    rdfs:label 'Model Documentation Url' ;
    rdfs:comment 'Link to detailed model documentation, investment memorandum, or research report supporting the valuation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelNotes rdf:type rdf:Property ;
    rdfs:label 'Model Notes' ;
    rdfs:comment 'Additional commentary, caveats, or qualitative observations from the analyst regarding the valuation model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelStatus rdf:type rdf:Property ;
    rdfs:label 'Model Status' ;
    rdfs:comment 'Current lifecycle status of the valuation model indicating whether it is actively maintained or archived.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelType rdf:type rdf:Property ;
    rdfs:label 'Model Type' ;
    rdfs:comment 'Type of valuation methodology applied: Discounted Cash Flow, Dividend Discount Model, Enterprise Value to EBITDA multiple, Price-to-Earnings relative, Sum-of-Parts, Net Asset Value-based, or other.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:modelVersion rdf:type rdf:Property ;
    rdfs:label 'Model Version' ;
    rdfs:comment 'Version identifier for the valuation model, tracking iterations and updates to methodology or assumptions.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:netMarginPercent rdf:type rdf:Property ;
    rdfs:label 'Net Margin Percent' ;
    rdfs:comment 'Net income as a percentage of revenue, representing bottom-line profitability assumption.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:peerGroupMedianMultiple rdf:type rdf:Property ;
    rdfs:label 'Peer Group Median Multiple' ;
    rdfs:comment 'Median valuation multiple of the selected peer group used for relative valuation benchmarking.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:researchTeam rdf:type rdf:Property ;
    rdfs:label 'Research Team' ;
    rdfs:comment 'Name of the internal research team or sector coverage group responsible for this valuation model.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:revenueCagrPercent rdf:type rdf:Property ;
    rdfs:label 'Revenue Cagr Percent' ;
    rdfs:comment 'Compound annual growth rate of revenue assumed over the forecast period.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:scenarioAnalysisFlag rdf:type rdf:Property ;
    rdfs:label 'Scenario Analysis Flag' ;
    rdfs:comment 'Indicates whether scenario analysis has been performed to model bull, base, and bear case valuation outcomes.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:sensitivityAnalysisFlag rdf:type rdf:Property ;
    rdfs:label 'Sensitivity Analysis Flag' ;
    rdfs:comment 'Indicates whether sensitivity analysis has been performed to assess valuation impact of key assumption changes.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:targetPriceHorizonMonths rdf:type rdf:Property ;
    rdfs:label 'Target Price Horizon Months' ;
    rdfs:comment 'Time horizon in months over which the target price is expected to be achieved.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:terminalGrowthRatePercent rdf:type rdf:Property ;
    rdfs:label 'Terminal Growth Rate Percent' ;
    rdfs:comment 'Perpetual growth rate assumption applied in the terminal value calculation for DCF models.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:workingCapitalPercentOfRevenue rdf:type rdf:Property ;
    rdfs:label 'Working Capital Percent Of Revenue' ;
    rdfs:comment 'Working capital requirement as a percentage of revenue, used to estimate cash flow adjustments.' ;
    rdfs:domain ind:ValuationModel ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:parentIssuerEquityIssuerId rdf:type rdf:Property ;
    rdfs:label 'Parent Issuer Equity Issuer Id' ;
    rdfs:comment 'Reference to the ultimate parent company issuer if this issuer is a subsidiary within a corporate group structure.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:EquityIssuer .

ind:accountingStandard rdf:type rdf:Property ;
    rdfs:label 'Accounting Standard' ;
    rdfs:comment 'The primary accounting standard framework used by the issuer for financial statement preparation and reporting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:auditorName rdf:type rdf:Property ;
    rdfs:label 'Auditor Name' ;
    rdfs:comment 'The name of the external audit firm responsible for auditing the issuers financial statements.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:ceoName rdf:type rdf:Property ;
    rdfs:label 'Ceo Name' ;
    rdfs:comment 'Full name of the current Chief Executive Officer leading the issuers executive management team.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:cfoName rdf:type rdf:Property ;
    rdfs:label 'Cfo Name' ;
    rdfs:comment 'Full name of the current Chief Financial Officer responsible for the issuers financial management and reporting.' ;
    rdfs:domain ind:EquityIssuer ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:coverageInitiationDate rdf:type rdf:Property ;
    rdfs:label 'Coverage Initiation Date' ;
    rdfs:comment 'The date on which the pension fund initiated research coverage and monitoring of this equity issuer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:coverageStatus rdf:type rdf:Property ;
    rdfs:label 'Coverage Status' ;
    rdfs:comment 'Current status of the pension funds research coverage and monitoring activity for this issuer.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingFitch rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Fitch' ;
    rdfs:comment 'The current long-term issuer credit rating assigned by Fitch Ratings agency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingMoody rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Moody' ;
    rdfs:comment 'The current long-term issuer credit rating assigned by Moodys Investors Service rating agency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:creditRatingSp rdf:type rdf:Property ;
    rdfs:label 'Credit Rating Sp' ;
    rdfs:comment 'The current long-term issuer credit rating assigned by Standard and Poors rating agency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:employeeCount rdf:type rdf:Property ;
