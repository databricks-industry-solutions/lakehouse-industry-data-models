ind:cashFlowType rdf:type rdf:Property ;
    rdfs:label 'Cash Flow Type' ;
    rdfs:comment 'Classification of the cash flow transaction indicating the nature of the movement. [ENUM-REF-CANDIDATE: capital_call|distribution|management_fee|fund_expense|organizational_expense|recallable_distribution|carried_interest|preferred_return — 8 candidates' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:preferredReturnAmount rdf:type rdf:Property ;
    rdfs:label 'Preferred Return Amount' ;
    rdfs:comment 'The portion of the distribution representing the preferred return or hurdle rate payment to limited partners.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
