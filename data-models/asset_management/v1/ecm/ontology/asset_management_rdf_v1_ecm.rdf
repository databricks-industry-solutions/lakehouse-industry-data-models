    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dividendRecordId rdf:type rdf:Property ;
    rdfs:label 'Dividend Record Id' ;
    rdfs:comment 'Unique identifier for the dividend income record.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:custodianLei rdf:type rdf:Property ;
    rdfs:label 'Custodian Lei' ;
    rdfs:comment 'ISO 17442 Legal Entity Identifier of the custodian bank that received and processed the dividend payment.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:declarationDate rdf:type rdf:Property ;
    rdfs:label 'Declaration Date' ;
    rdfs:comment 'Date on which the issuer board of directors announced the dividend payment.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:dividendCurrencyCode rdf:type rdf:Property ;
    rdfs:label 'Dividend Currency Code' ;
    rdfs:comment 'ISO 4217 three-letter currency code in which the dividend is declared and paid.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:dividendRatePerShare rdf:type rdf:Property ;
    rdfs:label 'Dividend Rate Per Share' ;
    rdfs:comment 'Declared dividend amount per share in the dividend currency.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:dividendStatus rdf:type rdf:Property ;
    rdfs:label 'Dividend Status' ;
    rdfs:comment 'Current lifecycle status of the dividend: declared by issuer, accrued in accounting, paid and received, cancelled by issuer, or pending settlement.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:exDividendDate rdf:type rdf:Property ;
    rdfs:label 'Ex Dividend Date' ;
    rdfs:comment 'First trading date on which the security trades without the dividend entitlement; positions held before this date are entitled to the dividend.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:fxRateDate rdf:type rdf:Property ;
    rdfs:label 'Fx Rate Date' ;
    rdfs:comment 'Date on which the FX rate was observed or fixed for currency conversion.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:date .

ind:grossDividendAmountBase rdf:type rdf:Property ;
    rdfs:label 'Gross Dividend Amount Base' ;
    rdfs:comment 'Total gross dividend income converted to the fund base currency before withholding taxes.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:grossDividendAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Gross Dividend Amount Local' ;
    rdfs:comment 'Total gross dividend income in the dividend currency before any withholding taxes or fees.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netDividendAmountBase rdf:type rdf:Property ;
    rdfs:label 'Net Dividend Amount Base' ;
    rdfs:comment 'Net dividend income received after withholding tax, converted to the fund base currency.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:netDividendAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Net Dividend Amount Local' ;
    rdfs:comment 'Net dividend income received after withholding tax deduction, in the dividend currency.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:quantityHeld rdf:type rdf:Property ;
    rdfs:label 'Quantity Held' ;
    rdfs:comment 'Number of shares held in the portfolio on the record date that are entitled to receive the dividend.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:reinvestmentFlag rdf:type rdf:Property ;
    rdfs:label 'Reinvestment Flag' ;
    rdfs:comment 'Indicates whether the dividend was reinvested into additional shares of the security rather than received as cash.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReclaimAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Tax Reclaim Amount Local' ;
    rdfs:comment 'Estimated or actual amount of withholding tax eligible for reclaim in the dividend currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:taxReclaimEligibleFlag rdf:type rdf:Property ;
    rdfs:label 'Tax Reclaim Eligible Flag' ;
    rdfs:comment 'Indicates whether the fund is eligible to reclaim a portion of the withheld tax under applicable tax treaties.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:taxReclaimStatus rdf:type rdf:Property ;
    rdfs:label 'Tax Reclaim Status' ;
    rdfs:comment 'Current status of the tax reclaim process: not applicable, pending initiation, submitted to tax authority, approved for payment, cash received, or rejected.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:withholdingTaxAmountBase rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount Base' ;
    rdfs:comment 'Withholding tax amount converted to the fund base currency.' ;
    rdfs:domain ind:DividendRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:withholdingTaxAmountLocal rdf:type rdf:Property ;
    rdfs:label 'Withholding Tax Amount Local' ;
    rdfs:comment 'Absolute amount of tax withheld at source in the dividend currency.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:decimal .

ind:proxyVotingRecordId rdf:type rdf:Property ;
    rdfs:label 'Proxy Voting Record Id' ;
    rdfs:comment 'Unique identifier for the proxy voting record.' ;
    rdfs:domain ind:ProxyVotingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:responsibleInvestmentAnalystEmployeeId rdf:type rdf:Property ;
    rdfs:label 'Responsible Investment Analyst Employee Id' ;
    rdfs:comment 'Reference to the responsible investment or ESG analyst who reviewed the resolution.' ;
    rdfs:domain ind:ProxyVotingRecord ;
    rdf:type owl:ObjectProperty ;
    rdfs:range ind:Employee .

ind:ballotReference rdf:type rdf:Property ;
    rdfs:label 'Ballot Reference' ;
    rdfs:comment 'Unique identifier for the ballot or resolution within the meeting.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:disclosureRequiredFlag rdf:type rdf:Property ;
    rdfs:label 'Disclosure Required Flag' ;
    rdfs:comment 'Indicates whether the vote must be disclosed publicly or to beneficiaries under regulatory or policy requirements.' ;
    rdfs:domain ind:ProxyVotingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgRelevanceFlag rdf:type rdf:Property ;
    rdfs:label 'Esg Relevance Flag' ;
    rdfs:comment 'Indicates whether the resolution has material Environmental, Social, or Governance (ESG) implications.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:esgTheme rdf:type rdf:Property ;
    rdfs:label 'Esg Theme' ;
    rdfs:comment 'Primary ESG theme associated with the resolution (e.g., Climate Change, Board Diversity, Executive Pay, Human Rights).' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:fundVoteDecision rdf:type rdf:Property ;
    rdfs:label 'Fund Vote Decision' ;
    rdfs:comment 'Actual voting decision made by the pension fund: For, Against, Abstain, Withhold, Do Not Vote, or Take No Action.' ;
    rdfs:domain ind:ProxyVotingRecord ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:managementRecommendation rdf:type rdf:Property ;
    rdfs:label 'Management Recommendation' ;
    rdfs:comment 'Voting recommendation provided by the company management: For, Against, Abstain, or No Recommendation.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:meetingCountryCode rdf:type rdf:Property ;
