    rdfs:comment 'Name of the WHODrug dictionary product/edition from which this ATC level 4 classification record was sourced.' ;
    rdfs:domain ind:WhodrugAtcLevel4 ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:level4Name rdf:type rdf:Property ;
