    rdfs:comment 'Regions or markets covered by this quote source (e.g., global, North America, EMEA, APAC). Determines applicability for regional asset valuations.' ;
    rdfs:domain ind:AssetManagement ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:string .

ind:isIndependentSource rdf:type rdf:Property ;
    rdfs:label 'Is Independent Source' ;
    rdfs:comment 'Indicates whether the source is independent from the fund manager for regulatory compliance. Required for Level 3 asset valuations.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isPrimarySource rdf:type rdf:Property ;
    rdfs:label 'Is Primary Source' ;
    rdfs:comment 'Indicates whether this is the primary (preferred) quote source for its covered asset classes. True means primary source.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:isRegulatoryApproved rdf:type rdf:Property ;
    rdfs:label 'Is Regulatory Approved' ;
    rdfs:comment 'Indicates whether this quote source has been approved by relevant regulatory bodies for use in official NAV calculations.' ;
    rdfs:domain ind:QuoteSource ;
    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:boolean .

ind:lastValidationDate rdf:type rdf:Property ;
