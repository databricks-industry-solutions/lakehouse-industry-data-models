    rdf:type owl:DatatypeProperty ;
    rdfs:range xsd:integer .

ind:carriedInterestAmount rdf:type rdf:Property ;
    rdfs:label 'Carried Interest Amount' ;
    rdfs:comment 'The portion of the distribution representing carried interest or performance allocation to the general partner.' ;
